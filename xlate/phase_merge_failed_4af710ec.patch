+fn nat_handshake_client_remote_cid_is_set(test_ctx: &mut TestTlsApiCtx) -> bool {
+    test_ctx
+        .qclient
+        .first_cnx_mut()
+        .and_then(|cnx| {
+            let path = cnx.paths.first()?;
+            let tuple = path.tuples.first()?;
