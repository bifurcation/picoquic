{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_014CdmfNDbWJYhujyr474xeE","type":"tool_result","content":"650\t        ret = picoquic_mark_datagram_ready_path(test_ctx->cnx_client, 0, 1);\n651\t        if (ret == 0) {\n652\t            ret = picoquic_mark_datagram_ready_path(test_ctx->cnx_server, 0, 1);\n653\t        }\n654\t    }\n655\t    return ret;\n656\t}\n657\t\n658\tint multipath_verify_datagram_sent(test_datagram_send_recv_ctx_t* dg_ctx, multipath_test_enum_t test_id)\n659\t{\n660\t    int ret = 0;\n661\t\n662\t    /* Verify datagrams have been received -- 3/4 will be enough */\n663\t    if (4*dg_ctx->dg_recv[0] < 3*dg_ctx->dg_target[1] ||\n664\t        4*dg_ctx->dg_recv[1] < 3*dg_ctx->dg_target[0]) {\n665\t        DBG_PRINTF(\"%s\", \"Did not receive expected datagrams: \");\n666\t        for (int i = 0; i < 2; i++) {\n667\t            DBG_PRINTF(\"dg_target[%d]=%d, dg_sent[%d]=%d, dg_recv[%d]=%d\",\n668\t                i, dg_ctx->dg_target[i], i, dg_ctx->dg_sent[i], 1 - i, dg_ctx->dg_recv[1 - i]);\n669\t            ret = -1;\n670\t        }\n671\t    }\n672\t    if (ret == 0) {\n673\t        if (test_id == multipath_test_datagram) {\n674\t            for (int i = 0; ret == 0 && i < 2; i++) {\n675\t                int min_expected = dg_ctx->dg_recv[i] / 8;\n676\t\n677\t                if (dg_ctx->nb_recv_path_0[i] < min_expected ||\n678\t                    dg_ctx->nb_recv_path_other[i] < min_expected) {\n679\t                    DBG_PRINTF(\"Datagram not balanced, %s received %d on path 0, %d on others\",\n680\t                        (i) ? \"client\" : \"server\", dg_ctx->nb_recv_path_0[i], dg_ctx->nb_recv_path_other[i]);\n681\t                    ret = -1;\n682\t                }\n683\t            }\n684\t        }\n685\t        else if (test_id == multipath_test_dg_af) {\n686\t            for (int i = 0; ret == 0 && i < 2; i++) {\n687\t                if (dg_ctx->nb_recv_path_other[i] > 0) {\n688\t                    DBG_PRINTF(\"Datagram affinity fails, %s received %d on path 0, %d on others\",\n689\t                        (i) ? \"client\" : \"server\", dg_ctx->nb_recv_path_0[i], dg_ctx->nb_recv_path_other[i]);\n690\t                    ret = -1;\n691\t                }\n692\t            }\n693\t        }\n694\t    }\n695\t    return ret;\n696\t}\n697\t\n698\tstatic int multipath_verify_all_cid_available(picoquic_cnx_t* cnx)\n699\t{\n700\t    int ret = 0;\n701\t    uint64_t unique_id_max = 0;\n702\t    picoquic_remote_cnxid_stash_t* stash = cnx->first_remote_cnxid_stash;\n703\t\n704\t    while (stash != NULL) {\n705\t        if (stash->unique_path_id > unique_id_max) {\n706\t            unique_id_max = stash->unique_path_id;\n707\t        }\n708\t        stash = stash->next_stash;\n709\t    }\n710\t    if (unique_id_max < cnx->max_path_id_local && unique_id_max < cnx->max_path_id_remote) {\n711\t        ret = -1;\n712\t    }\n713\t    return ret;\n714\t}\n715\t\n716\tint multipath_datagram_send_loop(picoquic_test_tls_api_ctx_t* test_ctx,\n717\t    test_datagram_send_recv_ctx_t* dg_ctx, uint64_t* loss_mask, uint64_t* simulated_time)\n718\t{\n719\t    int ret = 0;\n720\t    int nb_trials = 0;\n721\t    int nb_inactive = 0;\n722\t\n723\t    test_ctx->c_to_s_link->loss_mask = loss_mask;\n724\t    test_ctx->s_to_c_link->loss_mask = loss_mask;\n725\t\n726\t    while (ret == 0 && nb_trials < 16000 && nb_inactive < 512 && TEST_CLIENT_READY && TEST_SERVER_READY) {\n727\t        int was_active = 0;\n728\t        uint64_t time_out = test_datagram_next_time_ready(dg_ctx);\n729\t        nb_trials++;\n730\t\n731\t        ret = tls_api_one_sim_round(test_ctx, simulated_time, time_out, &was_active);\n732\t\n733\t        if (ret < 0) {\n734\t            break;\n735\t        }\n736\t\n737\t        if (was_active) {\n738\t            nb_inactive = 0;\n739\t        } else {\n740\t            nb_inactive++;\n741\t        }\n742\t\n743\t        /* Simulate wake up when data is ready for real time operation */\n744\t        for (int i = 0; i < 2; i++) {\n745\t            picoquic_cnx_t* cnx = (i == 0) ? test_ctx->cnx_server : test_ctx->cnx_client;\n746\t            if (!dg_ctx->is_ready[i] && test_datagram_check_ready(dg_ctx, i, *simulated_time)) {\n747\t                if (dg_ctx->test_affinity) {\n748\t                    picoquic_mark_datagram_ready_path(cnx, 0, 1);\n749\t                }\n750\t                else {\n751\t                    picoquic_mark_datagram_ready(cnx, 1);\n752\t                }\n753\t            }\n754\t        }\n755\t\n756\t        if (test_ctx->test_finished) {\n757\t            if (test_ctx->immediate_exit ||\n758\t                (picoquic_is_cnx_backlog_empty(test_ctx->cnx_client) && picoquic_is_cnx_backlog_empty(test_ctx->cnx_server))) {\n759\t                break;\n760\t            }\n761\t        }\n762\t    }\n763\t\n764\t    return ret;\n765\t}\n766\t\n767\tint multipath_test_do_keep_alive(picoquic_test_tls_api_ctx_t* test_ctx, uint64_t * simulated_time)\n768\t{\n769\t    int ret = 0;\n770\t    uint8_t ping_frame[1] = { (uint8_t)picoquic_frame_type_ping };\n771\t    int nat_test_needed = 1;\n772\t    int rounds_without_nat = 0;\n773\t\n774\t    while (ret == 0 && *simulated_time < 200000000) {\n775\t        uint64_t previous_time = *simulated_time;\n776\t\n777\t        if (nat_test_needed) {\n778\t            if (rounds_without_nat > 3) {\n779\t                /* do a nat rebinding */\n780\t                test_ctx->client_addr_natted = test_ctx->client_addr;\n781\t                test_ctx->client_addr_natted.sin_port += 7;\n782\t                test_ctx->client_use_nat = 1;\n783\t                nat_test_needed = 0;\n784\t            }\n785\t            else {\n786\t                rounds_without_nat++;\n787\t            }\n788\t        }\n789\t\n790\t        if (ret == 0) {\n791\t            ret = picoquic_queue_misc_frame(test_ctx->cnx_client, ping_frame, sizeof(ping_frame), 0, picoquic_packet_context_application);\n792\t            if (ret != 0) {\n793\t                DBG_PRINTF(\"Cannot queue ping frame, ret = 0x%x\", ret);\n794\t                break;\n795\t            }\n796\t        }\n797\t\n798\t        ret = tls_api_wait_for_timeout(test_ctx, simulated_time, 10000000);\n799\t        if (ret != 0) {\n800\t            DBG_PRINTF(\"Cannot wait 10 seconds, ret = 0x%x\", ret);\n801\t            break;\n802\t        }\n803\t\n804\t        if (!(TEST_CLIENT_READY && TEST_SERVER_READY) || *simulated_time < previous_time + 1000000) {\n805\t            DBG_PRINTF(\"Connection stalled at t=%\" PRIu64, *simulated_time);\n806\t            ret = -1;\n807\t            break;\n808\t        }\n809\t    }\n810\t    if (ret != 0) {\n811\t        DBG_PRINTF(\"Keep alive test fails at t=%\" PRIu64 \", ret = 0x%x\", *simulated_time, ret);\n812\t    }\n813\t    return ret;\n814\t}\n815\t\n816\tint multipath_test_one(uint64_t max_completion_microsec, multipath_test_enum_t test_id)\n817\t{\n818\t    uint64_t simulated_time = 0;\n819\t    uint64_t loss_mask = 0;\n820\t    picoquic_test_tls_api_ctx_t* test_ctx = NULL;\n821\t    test_datagram_send_recv_ctx_t dg_ctx = { 0 };\n822\t    picoquic_connection_id_t initial_cid = { {0x1b, 0x11, 0xc0, 4, 5, 6, 7, 8}, 8 };\n823\t    picoquic_tp_t server_parameters;\n824\t    uint64_t original_r_cid_sequence = 0;\n825\t    size_t send_buffer_size = 0;\n826\t    int ret;\n827\t\n828\t    initial_cid.id[2] = (int)test_id;\n829\t\n830\t    if (test_id == multipath_test_perf) {\n831\t        send_buffer_size = 65536;\n832\t    }\n833\t\n834\t    /* Create the context but delay initialization, so the multipath option can be set */\n835\t    ret = tls_api_init_ctx_ex2(&test_ctx, PICOQUIC_INTERNAL_TEST_VERSION_1,\n836\t        PICOQUIC_TEST_SNI, PICOQUIC_TEST_ALPN, &simulated_time, NULL, NULL, 0, 1, 0, &initial_cid,\n837\t        8, 0, send_buffer_size, 0);\n838\t\n839\t    if (ret == 0 && test_ctx == NULL) {\n840\t        ret = -1;\n841\t    }\n842\t\n843\t    if (ret == 0) {\n844\t        int is_sat_test = (test_id == multipath_test_sat_plus);\n845\t        if (is_sat_test || test_id == multipath_test_break1 || test_id == multipath_test_break2 || test_id == multipath_test_back1) {\n846\t            /* Reduce the throughput of path #0 to 1 mbps.\n847\t             * This is used to simulate an asymmetric \"satellite and landline\" scenario,\n848\t             * or to simulate a long transfer and test broken path detection or repair */\n849\t            multipath_test_sat_links(test_ctx, 0);\n850\t        }\n851\t        else if (test_id == multipath_test_perf) {\n852\t            multipath_test_perf_links(test_ctx, 0);\n853\t            picoquic_set_default_congestion_algorithm(test_ctx->qserver, picoquic_bbr_algorithm);\n854\t        }\n855\t        test_ctx->c_to_s_link->queue_delay_max = 2 * test_ctx->c_to_s_link->microsec_latency;\n856\t        test_ctx->s_to_c_link->queue_delay_max = 2 * test_ctx->s_to_c_link->microsec_latency;\n857\t\n858\t        if (test_id == multipath_test_rotation) {\n859\t            picoquic_set_default_crypto_epoch_length(test_ctx->qserver, 200);\n860\t        }\n861\t\n862\t        if (test_id == multipath_test_callback || test_id == multipath_test_quality || test_id == multipath_test_quality_server || test_id == multipath_test_stream_af) {\n863\t            multipath_init_callbacks(test_ctx, test_id);\n864\t        }\n865\t\n866\t        if (test_id == multipath_test_datagram || test_id == multipath_test_dg_af) {\n867\t            multipath_init_datagram_ctx(test_ctx, &dg_ctx);\n868\t        }\n869\t\n870\t        picoquic_set_binlog(test_ctx->qserver, \".\");\n871\t        test_ctx->qserver->use_long_log = 1;\n872\t        /* set the binary log on the client side */\n873\t        picoquic_set_binlog(test_ctx->qclient, \".\");\n874\t        test_ctx->qclient->use_long_log = 1;\n875\t        /* Set the multipath option at both client and server */\n876\t        multipath_init_params(&server_parameters, is_sat_test);\n877\t        if (test_id == multipath_test_datagram || test_id == multipath_test_dg_af) {\n878\t            server_parameters.max_datagram_frame_size = 1536;\n879\t            test_ctx->cnx_client->local_parameters.max_datagram_frame_size = 1536;\n880\t        }\n881\t        if (test_id == multipath_test_discovery) {\n882\t            server_parameters.address_discovery_mode = 1;\n883\t            test_ctx->cnx_client->local_parameters.address_discovery_mode = 3;\n884\t        }\n885\t        if (test_id == multipath_test_just_one) {\n886\t            server_parameters.initial_max_path_id = 1;\n887\t        }\n888\t\n889\t        picoquic_set_default_tp(test_ctx->qserver, &server_parameters);\n890\t        test_ctx->cnx_client->local_parameters.enable_time_stamp = 3;\n891\t\n892\t        test_ctx->cnx_client->local_parameters.initial_max_path_id = 3;\n893\t    }\n894\t\n895\t    /* establish the connection */\n896\t    if (ret == 0) {\n897\t        /* Initialize the client connection */\n898\t        picoquic_start_client_cnx(test_ctx->cnx_client);\n899\t        ret = tls_api_connection_loop(test_ctx, &loss_mask, 2 * test_ctx->s_to_c_link->microsec_latency, &simulated_time);\n900\t    }\n901\t    /* verify that multipath is negotiated on both sides */\n902\t    if (!test_ctx->cnx_client->is_multipath_enabled || !test_ctx->cnx_server->is_multipath_enabled) {\n903\t        DBG_PRINTF(\"Multipath not fully negotiated (c=%d, s=%d)\",\n904\t            test_ctx->cnx_client->is_multipath_enabled, test_ctx->cnx_server->is_multipath_enabled);\n905\t        ret = -1;\n906\t    }\n907\t    /* verify that both sides have the same vision of max path id*/\n908\t    if (test_ctx->cnx_client->max_path_id_local != test_ctx->cnx_server->max_path_id_remote ||\n909\t        test_ctx->cnx_client->max_path_id_remote != test_ctx->cnx_server->max_path_id_local) {\n910\t        DBG_PRINTF(\"No agreement on max path if (c=%u/%u, s=%u/%u)\",\n911\t            (uint32_t)test