{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01Jtj74xjukSi5tbfpgvutgi","type":"tool_result","content":"200\t    .expect(\"scenario body\");\n201\t}\n202\t\n203\t/// Run a \"long\" congestion test: connect, send at 1 Mbps for 1024 rounds,\n204\t/// multiply latency by 5, then drain to completion.\n205\t/// C: `congestion_long_test`.\n206\tfn congestion_long_test(ccalgo: &'static CongestionAlgorithm) {\n207\t    let mut simulated_time = Instant::from_ticks(0);\n208\t    let mut loss_mask: u64 = 0;\n209\t    let initial_cid =\n210\t        ConnectionId::clone_from_slice(&[0xbb, 0xcc, 0x10, 0, 0, 0, 0, 0]).expect(\"8-byte CID\");\n211\t\n212\t    let mut test_ctx = tls_api_init_ctx_ex(\n213\t        &mut simulated_time,\n214\t        Version::InternalTest1 as u32,\n215\t        None,\n216\t        Some(&initial_cid),\n217\t    )\n218\t    .expect(\"tls_api_init_ctx_ex\");\n219\t\n220\t    test_ctx.qserver.set_default_congestion_algorithm(ccalgo);\n221\t    test_ctx.cnx_client().set_congestion_algorithm(ccalgo);\n222\t\n223\t    test_ctx.c_to_s_link.jitter = 0;\n224\t    test_ctx.s_to_c_link.jitter = 0;\n225\t    test_ctx.c_to_s_link.picosec_per_byte = 8_000_000; // 1 Mbps\n226\t\n227\t    test_ctx.qserver.set_qlog(\".\").ok();\n228\t    test_ctx.qserver.use_long_log = true;\n229\t\n230\t    tls_api_one_scenario_body_connect(&mut test_ctx, &mut simulated_time, 0, 0).expect(\"connect\");\n231\t\n232\t    test_api_init_send_recv_scenario(&mut test_ctx, TEST_SCENARIO_CONGESTION)\n233\t        .expect(\"init scenario\");\n234\t\n235\t    tls_api_data_sending_loop(&mut test_ctx, &mut loss_mask, &mut simulated_time, 1024)\n236\t        .expect(\"data loop 1 (1024 rounds)\");\n237\t\n238\t    test_ctx.c_to_s_link.microsec_latency *= 5;\n239\t    test_ctx.s_to_c_link.microsec_latency *= 5;\n240\t\n241\t    tls_api_data_sending_loop(&mut test_ctx, &mut loss_mask, &mut simulated_time, 0)\n242\t        .expect(\"data loop 2 (drain)\");\n243\t\n244\t    tls_api_one_scenario_body_verify(&mut test_ctx, &mut simulated_time, 15_000_000)\n245\t        .expect(\"scenario verify\");\n246\t}\n247\t\n248\t/// Run a performance test: 10 MB download on an asymmetric link.\n249\t/// C: `performance_test_one`.\n250\tfn performance_test_one(\n251\t    max_completion_time: u64,\n252\t    mbps: u64,\n253\t    rkbps: u64,\n254\t    latency: u64,\n255\t    jitter: u64,\n256\t    buffer_size: u64,\n257\t    server_params: Option<&TransportParameters>,\n258\t) {\n259\t    let mut simulated_time = Instant::from_ticks(0x0005a138fbde8743u64);\n260\t    let picosec_per_byte_down = (1_000_000u64 * 8) / mbps;\n261\t    let picosec_per_byte_up = if rkbps == 0 {\n262\t        picosec_per_byte_down\n263\t    } else {\n264\t        (1_000_000_000u64 * 8) / rkbps\n265\t    };\n266\t    let buffer_id = (buffer_size * 16) / (latency + jitter);\n267\t    let initial_cid = ConnectionId::clone_from_slice(&[\n268\t        0xbbu8,\n269\t        0xcc,\n270\t        0,\n271\t        if rkbps > 0xff { 0xff } else { rkbps as u8 },\n272\t        if mbps > 0xff { 0xff } else { mbps as u8 },\n273\t        if latency > 2_550_000 {\n274\t            0xff\n275\t        } else {\n276\t            (latency / 10_000) as u8\n277\t        },\n278\t        if jitter > 255_000 {\n279\t            0xff\n280\t        } else {\n281\t            (jitter / 1_000) as u8\n282\t        },\n283\t        if buffer_id > 255 {\n284\t            0xff\n285\t        } else {\n286\t            buffer_id as u8\n287\t        },\n288\t    ])\n289\t    .expect(\"8-byte CID\");\n290\t\n291\t    let ccalgo = get_congestion_algorithm(\"bbr\").expect(\"bbr cc algo\");\n292\t\n293\t    let mut test_ctx = tls_api_one_scenario_init_ex(\n294\t        &mut simulated_time,\n295\t        Version::InternalTest1,\n296\t        None,\n297\t        server_params,\n298\t        Some(&initial_cid),\n299\t    )"}]},"parent_tool_use_id":null,"session_id":"dd2036ff-0dd1-48ca-b8bf-92c20dcaef2a","uuid":"a241735