th_test_back1 || test_id == multipath_test_standup ||\n985\t        test_id == multipath_test_abandon || test_id == multipath_test_tunnel || test_id == multipath_test_break_both)) {\n986\t        /* If testing a final link drop before completion, perform a \n987\t         * partial sending loop and then kill the initial link.\n988\t         * For the tunnel scenario, do the same but kill both links.\n989\t         */\n990\t        if (ret == 0) {\n991\t            uint64_t timeout = 640000;\n992\t\n993\t            ret = tls_api_wait_for_timeout(test_ctx, &simulated_time, timeout);\n994\t\n995\t            if (ret != 0)\n996\t            {\n997\t                DBG_PRINTF(\"Wait for %\" PRIu64 \"us returns %d\\n\", timeout, ret);\n998\t            }\n999\t        }\n1000\t        if (ret == 0) {\n1001\t            if (test_id == multipath_test_renew) {\n1002\t                ret = picoquic_renew_connection_id(test_ctx->cnx_client, 1);\n1003\t            }\n1004\t            else if (test_id == multipath_test_nat || test_id == multipath_test_nat_challenge) {\n1005\t                /* Change the client address */\n1006\t                test_ctx->client_addr_natted = test_ctx->client_addr;\n1007\t                test_ctx->client_addr_natted.sin_port += 7;\n1008\t                test_ctx->client_use_nat = 1;\n1009\t                if (test_id == multipath_test_nat_challenge) {\n1010\t                    test_ctx->cnx_client->path[0]->first_tuple->challenge_required = 1;\n1011\t                }\n1012\t            }\n1013\t            else if (test_id == multipath_test_abandon) {\n1014\t                /* Client abandons the path, causes it to be demoted. Server should follow suit. */\n1015\t                picoquic_abandon_path(test_ctx->cnx_client, 0, 0,\n1016\t                    simulated_time);\n1017\t            }\n1018\t            else if (test_id == multipath_test_break2) {\n1019\t                /* Trigger \"destination unreachable\" error on next socket call to link 1 */\n1020\t                multipath_test_set_unreachable(test_ctx, 1);\n1021\t            }\n1022\t            else if (test_id == multipath_test_back0 || test_id == multipath_test_break3) {\n1023\t                /* Trigger \"destination unreachable\" error on next socket call to link 0 */\n1024\t                multipath_test_set_unreachable(test_ctx, 0);\n1025\t            }\n1026\t            else if (test_id == multipath_test_tunnel) {\n1027\t                /* Break both links */\n1028\t                multipath_test_kill_links(test_ctx, 0);\n1029\t                multipath_test_kill_links(test_ctx, 1);\n1030\t            }\n1031\t            else if (test_id == multipath_test_break_both) {\n1032\t                /* Break both paths, program them to return socket errors */\n1033\t                multipath_test_set_unreachable(test_ctx, 0);\n1034\t                multipath_test_set_unreachable(test_ctx, 1);\n1035\t            } else {\n1036\t                multipath_test_kill_links(test_ctx, \n1037\t                    (test_id == multipath_test_drop_first ||\n1038\t                        test_id == multipath_test_standup) ? 0 : 1);\n1039\t            }\n1040\t        }\n1041\t    }\n1042\t    /* For the \"backup scenario\", wait a small interval, then bring the path # 1 back up\n1043\t     * For the \"tunnel\" scenario, do the same but wait 5 seconds and then restore both links.\n1044\t     */\n1045\t    if (ret == 0 && (test_id == multipath_test_back0 || test_id == multipath_test_back1 || test_id == multipath_test_tunnel)) {\n1046\t        uint64_t timeout = (test_id == multipath_test_tunnel)?5000000:1000000;\n1047\t\n1048\t        ret = tls_api_wait_for_timeout(test_ctx, &simulated_time, timeout);\n1049\t\n1050\t        if (ret != 0)\n1051\t        {\n1052\t            DBG_PRINTF(\"Wait for %\" PRIu64 \"us returns %d\\n\", timeout, ret);\n1053\t        }\n1054\t        else if (test_id == multipath_test_back0) {\n1055\t            multipath_test_set_reachable(test_ctx, 0);\n1056\t            \n1057\t            ret = picoquic_probe_new_path(test_ctx->cnx_client, (struct sockaddr*)&test_ctx->server_addr,\n1058\t                    (struct sockaddr*)&test_ctx->client_addr, simulated_time);\n1059\t            if (ret != 0) {\n1060\t                DBG_PRINTF(\"Create path on default address returns %d\\n\", ret);\n1061\t            }\n1062\t        }\n1063\t        else {\n1064\t            if (test_id == multipath_test_tunnel) {\n1065\t                multipath_test_unkill_links(test_ctx, 0, simulated_time);\n1066\t            }\n1067\t            multipath_test_unkill_links(test_ctx, 1, simulated_time);\n1068\t        }\n1069\t    }\n1070\t    /* In the \"abandon\" scenario, allow for a bit more than 1 second of delay for clearing of paths */\n1071\t    if (ret == 0 && test_id == multipath_test_abandon) {\n1072\t        uint64_t timeout = 1100000;\n1073\t\n1074\t        ret = tls_api_wait_for_timeout(test_ctx, &simulated_time, timeout);\n1075\t\n1076\t        if (ret != 0)\n1077\t        {\n1078\t            DBG_PRINTF(\"Wait for %\" PRIu64 \"us returns %d\\n\", timeout, ret);\n1079\t        }\n1080\t    }\n1081\t\n1082\t    /* In the datagram scenarios, trigger the datagram transmission */\n1083\t    if (ret == 0 && (test_id == multipath_test_datagram || test_id == multipath_test_dg_af)) {\n1084\t        ret = multipath_set_datagram_ready(test_ctx, &dg_ctx, test_id);\n1085\t    }\n1086\t\n1087\t    /* Perform a final data sending loop, this time to completion  */\n1088\t    if (ret == 0) { \n1089\t        if (test_id == multipath_test_datagram || test_id == multipath_test_dg_af) {\n1090\t            ret = multipath_datagram_send_loop(test_ctx, &dg_ctx, &loss_mask, &simulated_time);\n1091\t        }\n1092\t        else if (!test_ctx->test_finished ||\n1093\t            !picoquic_is_cnx_backlog_empty(test_ctx->cnx_client) ||\n1094\t            !picoquic_is_cnx_backlog_empty(test_ctx->cnx_server)){\n1095\t            ret = tls_api_data_sending_loop(test_ctx, &loss_mask, &simulated_time, 0);\n1096\t        }\n1097\t\n1098\t        if (ret != 0)\n1099\t        {\n1100\t            DBG_PRINTF(\"Data sending loop returns %d\\n\", ret);\n1101\t        }\n1102\t    }\n1103\t\n1104\t    if (ret == 0 && test_id == multipath_test_keep_alive) {\n1105\t        ret = multipath_test_do_keep_alive(test_ctx, &simulated_time);\n1106\t    }\n1107\t\n1108\t    /* Check that the transmission succeeded */\n1109\t    if (ret == 0) {\n1110\t        ret = tls_api_one_scenario_body_verify(test_ctx, &simulated_time, max_completion_microsec);\n1111\t    }\n1112\t\n1113\t    if (ret == 0 && (test_id == multipath_test_basic || test_id == multipath_test_just_one)) {\n1114\t        if ((ret = multipath_verify_all_cid_available(test_ctx->cnx_client)) != 0) {\n1115\t            DBG_PRINTF(\"%s\", \"Not received all CID from server\");\n1116\t        }\n1117\t        else if ((ret = multipath_verify_all_cid_available(test_ctx->cnx_server)) != 0) {\n1118\t            DBG_PRINTF(\"%s\", \"Not received all CID from client\");\n1119\t        }\n1120\t    }\n1121\t\n1122\t    if (ret == 0 && test_id == multipath_test_fail) {\n1123\t        if (test_ctx->cnx_client->nb_paths != 1 ||\n1124\t            (test_ctx->cnx_server != NULL && test_ctx->cnx_server->nb_paths != 1)) {\n1125\t            DBG_PRINTF(\"Delete failing path failed, client = %d paths, server = %d paths\\n\",\n1126\t                test_ctx->cnx_client->nb_paths,\n1127\t                (test_ctx->cnx_server == NULL) ? 0 : test_ctx->cnx_server->nb_paths);\n1128\t            ret = -1;\n1129\t        }\n1130\t    }\n1131\t\n1132\t    if (ret == 0 && test_id == multipath_test_renew) {\n1133\t        if (test_ctx->cnx_client->path[1]->first_tuple->p_remote_cnxid->sequence == original_r_cid_sequence) {\n1134\t            DBG_PRINTF(\"Remote CID on client path 1 is still %\" PRIu64 \"\\n\", original_r_cid_sequence);\n1135\t            ret = -1;\n1136\t        } else if (test_ctx->cnx_server->path[1]->first_tuple->p_remote_cnxid->sequence == original_r_cid_sequence) {\n1137\t            DBG_PRINTF(\"Remote CID on server path 1 is still %\" PRIu64 \"\\n\", original_r_cid_sequence);\n1138\t            ret = -1;\n1139\t        }\n1140\t        else if (test_ctx->cnx_server->path[1]->first_tuple->p_local_cnxid->sequence == original_r_cid_sequence) {\n1141\t            DBG_PRINTF(\"Local CID on server path 1 is still %\" PRIu64 \"\\n\", original_r_cid_sequence);\n1142\t            ret = -1;\n1143\t        }\n1144\t    }\n1145\t\n1146\t    if (ret == 0 && test_id == multipath_test_rotation) {\n1147\t        if (test_ctx->cnx_server->nb_crypto_key_rotations == 0) {\n1148\t            DBG_PRINTF(\"%s\", \"No key rotation observed.\\n\");\n1149\t            ret = -1;\n1150\t        }\n1151\t    }\n1152\t\n1153\t    if (ret == 0) {\n1154\t        uint64_t mask = 0;\n1155\t        for (int i = 0; ret == 0 && i < test_ctx->cnx_client->nb_paths; i++) {\n1156\t            if (test_ctx->cnx_client->path[i]->unique_path_id > 63) {\n1157\t                DBG_PRINTF(\"Path ID[%d] = %\" PRIu64 \", too big!\", i, test_ctx->cnx_client->path[i]->unique_path_id);\n1158\t                ret = -1;\n1159\t            }\n1160\t            else if ((mask & (1ull << test_ctx->cnx_client->path[i]->unique_path_id)) != 0) {\n1161\t                DBG_PRINTF(\"Path ID[%d] = %\" PRIu64 \", reuse!\", i, test_ctx->cnx_client->path[i]->unique_path_id);\n1162\t                ret = -1;\n1163\t            }\n1164\t            else if (test_ctx->cnx_client->path[i]->first_tuple->p_local_cnxid != NULL && test_ctx->cnx_client->path[i]->unique_path_id !=\n1165\t                test_ctx->cnx_client->path[i]->first_tuple->p_local_cnxid->path_id) {\n1166\t                DBG_PRINTF(\"Path ID[%d] = %\" PRIu64 \", vs. local CID path id: %\" PRIu64,\n1167\t                    i, test_ctx->cnx_client->path[i]->unique_path_id,\n1168\t                    i, test_ctx->cnx_client->path[i]->first_tuple->p_local_cnxid->path_id);\n1169\t                ret = -1;\n1170\t            }\n1171\t        }\n1172\t    }\n1173\t\n1174\t\n1175\t    if (ret == 0 && (test_id == multipath_test_nat || test_id == multipath_test_nat_challenge)) {\n1176\t        /* Check that the path 0 has the new address */\n1177\t        if (test_ctx->cnx_server->nb_paths < 2 ||\n1178\t            test_ctx->cnx_client->nb_paths < 2 ||\n1179\t            test_ctx->cnx_server->path[0]->unique_path_id != 0 ||\n1180\t            test_ctx->cnx_client->path[0]->unique_path_id != 0 ||\n1181\t            picoquic_compare_addr((struct sockaddr*)&test_ctx->cnx_server->path[0]->first_tuple->peer_addr,\n1182\t                (struct sockaddr*)&test_ctx->client_addr_natted) != 0) {\n1183\t            DBG_PRINTF(\"%s\", \"NAT traversal looks wrong.\\n\");\n1184\t            ret = -1;\n1185\t        }\n1186\t    }\n1187\t\n1188\t    if (ret == 0 && (test_id == multipath_test_break1 || test_id == multipath_test_break2 || test_id == multipath_test_break3 || test_id == multipath_test_abandon)) {\n1189\t        if (test_ctx->cnx_server->nb_paths != 1) {\n1190\t            DBG_PRINTF(\"After break, %d paths on server connection.\\n\", test_ctx->cnx_server->nb_paths);\n1191\t            ret = -1;\n1192\t        } else if (test_ctx->cnx_client->nb_paths != 1) {\n1193\t            DBG_PRINTF(\"After break, %d paths on client connection.\\n\", test_ctx->cnx_client->nb_paths);\n1194\t            ret = -1;\n1195\t        }\n1196\t    }\n1197\t\n1198\t    if (ret == 0 && (test_id == multipath_test_back0 || test_id == multipath_test_back1)) {\n1199\t        if (test_ctx->cnx_server->nb_paths != 2) {\n1200\t            DBG_PRINTF(\"After break and back, %d paths on server connection.\\n\", test_ctx->cnx_server->nb_paths);\n1201\t            ret = -1;\n1202\t        }\n1203\t        else if (test_ctx->cnx_client->nb_paths != 2) {\n1204\t            DBG_PRINTF(\"After break and back, %d paths on client connection.\\n\", test_ctx->cnx_client->nb_paths);\n1205\t            ret = -1;\n1206\t        }\n1207\t    }\n1208\t\n1209\t    if (ret == 0 && test_id == multipath_test_stream_af) {\n1210\t        if (test_ctx->cnx_server->nb_paths != 2) {\n1211\t            DBG_PRINTF(\"After break and back, %d paths on server connection.\\n\", test_ctx->cnx_server->nb_paths);\n1212\t            ret = -1;\n1213\t        }\n1214\t        else if (test_ctx->cnx_server->path[0]->delivered < 1400000) {\n1215\t            DBG_PRINTF(\"Not enough data delivered on server path 0 (%\" PRIu64 \").\\n\", test_ctx->cnx_server->path[0]->delivered);\n1216\t            ret = -1;\n1217\t        }\n1218\t        else if (test_ctx->cnx_server->path[1]->delivered > 600000) {\n1219\t            DBG_PRINTF(\"Too much data delivered on server path 1 (%\" PRIu64 \").\\n\",\n1220\t                test_ctx->cnx_server->path[1]->delivered);\n1221\t            ret = -1;\n1222\t        }\n1223\t    }\n1224\t\n1225\t    /* In the datagram scenarios, verify the datagram transmission */\n1226\t    if (ret == 0 && (test_id == multipath_test_datagram || test_id == multipath_test_dg_af)) {\n1227\t        ret = multipath_verify_datagram_sent(&dg_ctx, test_id);\n1228\t    }\n1229\t\n1230\t    /* In the backup scenario, verify that the flag is set\n1231\t    * correctly at the server, and that not too much data is\n1232\t    * sent on backup path.\n1233\t    */\n1234\t    if (ret == 0 && (test_id == multipath_test_backup)) {\n1235\t        if (!test_ctx->cnx_server->path[1]->path_is_backup) {\n1236\t            DBG_PRINTF(\"Backup not set on server path 1 (%d).\\n\", test_ctx->cnx_server->path[1]->path_is_backup);\n1237\t            ret = -1;\n1238\t        }\n1239\t        else if (test_ctx->cnx_server->path[1]->delivered > 50000) {\n1240\t            DBG_PRINTF(\"Too much data delivered on server path 1 (%\" PRIu64 \").\\n\", test_ctx->cnx_server->path[1]->delivered);\n1241\t            ret = -1;\n1242\t        }\n1243\t    }\n1244\t\n1245\t    if (ret == 0 && test_id == multipath_test_discovery) {\n1246\t        if (test_ctx->nb_address_observed < 2) {\n1247\t            DBG_PRINTF(\"Got % addresses observed\", test_ctx->nb_address_observed);\n1248\t            ret = -1;"}]},"parent_tool_use_id":null,"session_id":"dd2036ff-0dd1-48ca-b8bf-92c20dcaef2a","uuid":"662f8c53-fe32-481b-a553-3a1a01e1b7ae","timestamp":"2026-05-05T04:32:43.548Z","tool_use_result":{"type":"text","file":{"filePath":"/Users/richbarn/Projects/picoquic/picoquictest/multipath_test.c","content":"            else if (test_id == multipath_test_perf) {\n                multipath_test_perf_links(test_ctx, 1);\n            }\n            else if (test_id == multipath_test_fail) {\n                /* Kill link #1 in server to client direction. This will cause path challenges to fail */\n                multipath_test_kill_server_links(test_ctx, 1);\n            }\n        }\n    }\n\n    if (ret == 0) {\n        ret = picoquic_probe_new_path(test_ctx->cnx_client, (struct sockaddr*) & test_ctx->server_addr,\n            (struct sockaddr*) & test_ctx->client_addr_2, simulated_time);\n    }\n\n    /* Check that the two paths are established */\n    if (ret == 0 && test_id != multipath_test_fail) {\n        ret = wait_multipath_ready(test_ctx, &simulated_time);\n    }\n     if (ret == 0){\n        if (test_id == multipath_test_stream_af) {\n            ret = picoquic_set_stream_path_affinity(test_ctx->cnx_server, 4, 0);\n            if (ret != 0) {\n                DBG_PRINTF(\"Cannot set stream affinity, ret = %d\", ret);\n            }\n        }\n        else if (test_id == multipath_test_backup ||\n            test_id == multipath_test_standup) {\n            ret = picoquic_set_path_status(test_ctx->cnx_client, 1, picoquic_path_status_backup);\n        }\n    }\n\n    if (ret == 0 && (test_id == multipath_test_drop_first || test_id == multipath_test_drop_second ||\n        test_id == multipath_test_renew || test_id == multipath_test_nat || test_id == multipath_test_nat_challenge ||\n        test_id == multipath_test_break1 || test_id == multipath_test_break2 || test_id == multipath_test_break3 ||\n        test_id == multipath_test_back0 || test_id == multipath_test_back1 || test_id == multipath_test_standup ||\n        test_id == multipath_test_abandon || test_id == multipath_test_tunnel || test_id == multipath_test_break_both)) {\n        /* If testing a final link drop before completion, perform a \n         * partial sending loop and then kill the initial link.\n         * For the tunnel scenario, do the same but kill both links.\n         */\n        if (ret == 0) {\n            uint64_t timeout = 640000;\n\n            ret = tls_api_wait_for_timeout(test_ctx, &simulated_time, timeout);\n\n            if (ret != 0)\n            {\n                DBG_PRINTF(\"Wait for %\" PRIu64 \"us returns %d\\n\", timeout, ret);\n            }\n        }\n        if (ret == 0) {\n            if (test_id == multipath_test_renew) {\n                ret = picoquic_renew_connection_id(test_ctx->cnx_client, 1);\n            }\n            else if (test_id == multipath_test_nat || test_id == multipath_test_nat_challenge) {\n                /* Change the client address */\n                test_ctx->client_addr_natted = test_ctx->client_addr;\n                test_ctx->client_addr_natted.sin_port += 7;\n                test_ctx->client_use_nat = 1;\n                if (test_id == multipath_test_nat_challenge) {\n                    test_ctx->cnx_client->path[0]->first_tuple->challenge_required = 1;\n                }\n            }\n            else if (test_id == multipath_test_abandon) {\n                /* Client abandons the path, causes it to be demoted. Server should follow suit. */\n                picoquic_abandon_path(test_ctx->cnx_client, 0, 0,\n                    simulated_time);\n            }\n            else if (test_id == multipath_test_break2) {\n                /* Trigger \"destination unreachable\" error on next socket call to link 1 */\n                multipath_test_set_unreachable(test_ctx, 1);\n            }\n            else if (test_id == multipath_test_back0 || test_id == multipath_test_break3) {\n                /* Trigger \"destination unreachable\" error on next socket call to link 0 */\n                multipath_test_set_unreachable(test_ctx, 0);\n            }\n            else if (test_id == multipath_test_tunnel) {\n                /* Break both links */\n                multipath_test_kill_links(test_ctx, 0);\n                multipath_test_kill_links(test_ctx, 1);\n            }\n            else if (test_id == multipath_test_break_both) {\n                /* Break both paths, program them to return socket errors */\n                multipath_test_set_unreachable(test_ctx, 0);\n                multipath_test_set_unreachable(test_ctx, 1);\n            } else {\n                multipath_test_kill_links(test_ctx, \n                    (test_id == multipath_test_drop_first ||\n                        test_id == multipath_test_standup) ? 0 : 1);\n            }\n        }\n    }\n    /* For the \"backup scenario\", wait a small interval, then bring the path # 1 back up\n     * For the \"tunnel\" scenario, do the same but wait 5 seconds and then restore both links.\n     */\n    if (ret == 0 && (test_id == multipath_test_back0 || test_id == multipath_test_back1 || test_id == multipath_test_tunnel)) {\n        uint64_t timeout = (test_id == multipath_test_tunnel)?5000000:1000000;\n\n        ret = tls_api_wait_for_timeout(test_ctx, &simulated_time, timeout);\n\n        if (ret != 0)\n        {\n            DBG_PRINTF(\"Wait for %\" PRIu64 \"us returns %d\\n\", timeout, ret);\n        }\n        else if (test_id == multipath_test_back0) {\n            multipath_test_set_reachable(test_ctx, 0);\n            \n            ret = picoquic_probe_new_path(test_ctx->cnx_client, (struct sockaddr*)&test_ctx->server_addr,\n                    (struct sockaddr*)&test_ctx->client_addr, simulated_time);\n            if (ret != 0) {\n                DBG_PRINTF(\"Create path on default address returns %d\\n\", ret);\n            }\n        }\n        else {\n            if (test_id == multipath_test_tunnel) {\n                multipath_test_unkill_links(test_ctx, 0, simulated_time);\n            }\n            multipath_test_unkill_links(test_ctx, 1, simulated_time);\n        }\n    }\n    /* In the \"abandon\" scenario, allow for a bit more than 1 second of delay for clearing of paths */\n    if (ret == 0 && test_id == multipath_test_abandon) {\n        uint64_t timeout = 1100000;\n\n        ret = tls_api_wait_for_timeout(test_ctx, &simulated_time, timeout);\n\n        if (ret != 0)\n        {\n            DBG_PRINTF(\"Wait for %\" PRIu64 \"us returns %d\\n\", timeout, ret);\n        }\n    }\n\n    /* In the datagram scenarios, trigger the datagram transmission */\n    if (ret == 0 && (test_id == multipath_test_datagram || test_id == multipath_test_dg_af)) {\n        ret = multipath_set_datagram_ready(test_ctx, &dg_ctx, test_id);\n    }\n\n    /* Perform a final data sending loop, this time to completion  */\n    if (ret == 0) { \n        if (test_id == multipath_test_datagram || test_id == multipath_test_dg_af) {\n            ret = multipath_datagram_send_loop(test_ctx, &dg_ctx, &loss_mask, &simulated_time);\n        }\n        else if (!test_ctx->test_finished ||\n            !picoquic_is_cnx_backlog_empty(test_ctx->cnx_client) ||\n            !picoquic_is_cnx_backlog_empty(test_ctx->cnx_server)){\n            ret = tls_api_data_sending_loop(test_ctx, &loss_mask, &simulated_time, 0);\n        }\n\n        if (ret != 0)\n        {\n            DBG_PRINTF(\"Data sending loop returns %d\\n\", ret);\n        }\n    }\n\n    if (ret == 0 && test_id == multipath_test_keep_alive) {\n        ret = multipath_test_do_keep_alive(test_ctx, &simulated_time);\n    }\n\n    /* Check that the transmission succeeded */\n    if (ret == 0) {\n        ret = tls_api_one_scenario_body_verify(test_ctx, &simulated_time, max_completion_microsec);\n    }\n\n    if (ret == 0 && (test_id == multipath_test_basic || test_id == multipath_test_just_one)) {\n        if ((ret = multipath_verify_all_cid_available(test_ctx->cnx_client)) != 0) {\n            DBG_PRINTF(\"%s\", \"Not received all CID from server\");\n        }\n        else if ((ret = multipath_verify_all_cid_available(test_ctx->cnx_server)) != 0) {\n            DBG_PRINTF(\"%s\", \"Not received all CID from client\");\n        }\n    }\n\n    if (ret == 0 && test_id == multipath_test_fail) {\n        if (test_ctx->cnx_client->nb_paths != 1 ||\n            (test_ctx->cnx_server != NULL && test_ctx->cnx_server->nb_paths != 1)) {\n            DBG_PRINTF(\"Delete failing path failed, client = %d paths, server = %d paths\\n\",\n                test_ctx->cnx_client->nb_paths,\n                (test_ctx->cnx_server == NULL) ? 0 : test_ctx->cnx_server->nb_paths);\n            ret = -1;\n        }\n    }\n\n    if (ret == 0 && test_id == multipath_test_renew) {\n        if (test_ctx->cnx_client->path[1]->first_tuple->p_remote_cnxid->sequence == original_r_cid_sequence) {\n            DBG_PRINTF(\"Remote CID on client path 1 is still %\" PRIu64 \"\\n\", original_r_cid_sequence);\n            ret = -1;\n        } else if (test_ctx->cnx_server->path[1]->first_tuple->p_remote_cnxid->sequence == original_r_cid_sequence) {\n            DBG_PRINTF(\"Remote CID on server path 1 is still %\" PRIu64 \"\\n\", original_r_cid_sequence);\n            ret = -1;\n        }\n        else if (test_ctx->cnx_server->path[1]->first_tuple->p_local_cnxid->sequence == original_r_cid_sequence) {\n            DBG_PRINTF(\"Local CID on server path 1 is still %\" PRIu64 \"\\n\", original_r_cid_sequence);\n            ret = -1;\n        }\n    }\n\n    if (ret == 0 && test_id == multipath_test_rotation) {\n        if (test_ctx->cnx_server->nb_crypto_key_rotations == 0) {\n            DBG_PRINTF(\"%s\", \"No key rotation observed.\\n\");\n            ret = -1;\n        }\n    }\n\n    if (ret == 0) {\n        uint64_t mask = 0;\n        for (int i = 0; ret == 0 && i < test_ctx->cnx_client->nb_paths; i++) {\n            if (test_ctx->cnx_client->path[i]->unique_path_id > 63) {\n                DBG_PRINTF(\"Path ID[%d] = %\" PRIu64 \", too big!\", i, test_ctx->cnx_client->path[i]->unique_path_id);\n                ret = -1;\n            }\n            else if ((mask & (1ull << test_ctx->cnx_client->path[i]->unique_path_id)) != 0) {\n                DBG_PRINTF(\"Path ID[%d] = %\" PRIu64 \", reuse!\", i, test_ctx->cnx_client->path[i]->unique_path_id);\n                ret = -1;\n            }\n            else if (test_ctx->cnx_client->path[i]->first_tuple->p_local_cnxid != NULL && test_ctx->cnx_client->path[i]->unique_path_id !=\n                test_ctx->cnx_client->path[i]->first_tuple->p_local_cnxid->path_id) {\n                DBG_PRINTF(\"Path ID[%d] = %\" PRIu64 \", vs. local CID path id: %\" PRIu64,\n                    i, test_ctx->cnx_client->path[i]->unique_path_id,\n                    i, test_ctx->cnx_client->path[i]->first_tuple->p_local_cnxid->path_id);\n                ret = -1;\n            }\n        }\n    }\n\n\n    if (ret == 0 && (test_id == multipath_test_nat || test_id == multipath_test_nat_challenge)) {\n        /* Check that the path 0 has the new address */\n        if (test_ctx->cnx_server->nb_paths < 2 ||\n            test_ctx->cnx_client->nb_paths < 2 ||\n            test_ctx->cnx_server->path[0]->unique_path_id != 0 ||\n            test_ctx->cnx_client->path[0]->unique_path_id != 0 ||\n            picoquic_compare_addr((struct sockaddr*)&test_ctx->cnx_server->path[0]->first_tuple->peer_addr,\n                (struct sockaddr*)&test_ctx->client_addr_natted) != 0) {\n            DBG_PRINTF(\"%s\", \"NAT traversal looks wrong.\\n\");\n            ret = -1;\n        }\n    }\n\n    if (ret == 0 && (test_id == multipath_test_break1 || test_id == multipath_test_break2 || test_id == multipath_test_break3 || test_id == multipath_test_abandon)) {\n        if (test_ctx->cnx_server->nb_paths != 1) {\n            DBG_PRINTF(\"After break, %d paths on server connection.\\n\", test_ctx->cnx_server->nb_paths);\n            ret = -1;\n        } else if (test_ctx->cnx_client->nb_paths != 1) {\n            DBG_PRINTF(\"After break, %d paths on client connection.\\n\", test_ctx->cnx_client->nb_paths);\n            ret = -1;\n        }\n    }\n\n    if (ret == 0 && (test_id == multipath_test_back0 || test_id == multipath_test_back1)) {\n        if (test_ctx->cnx_server->nb_paths != 2) {\n            DBG_PRINTF(\"After break and back, %d paths on server connection.\\n\", test_ctx->cnx_server->nb_paths);\n            ret = -1;\n        }\n        else if (test_ctx->cnx_client->nb_paths != 2) {\n            DBG_PRINTF(\"After break and back, %d paths on client connection.\\n\", test_ctx->cnx_client->nb_paths);\n            ret = -1;\n        }\n    }\n\n    if (ret == 0 && test_id == multipath_test_stream_af) {\n        if (test_ctx->cnx_server->nb_paths != 2) {\n            DBG_PRINTF(\"After break and back, %d paths on server connection.\\n\", test_ctx->cnx_server->nb_paths);\n            ret = -1;\n        }\n        else if (test_ctx->cnx_server->path[0]->delivered < 1400000) {\n            DBG_PRINTF(\"Not enough data delivered on server path 0 (%\" PRIu64 \").\\n\", test_ctx->cnx_server->path[0]->delivered);\n            ret = -1;\n        }\n        else if (test_ctx->cnx_server->path[1]->delivered > 600000) {\n            DBG_PRINTF(\"Too much data delivered on server path 1 (%\" PRIu64 \").\\n\",\n                test_ctx->cnx_server->path[1]->delivered);\n            ret = -1;\n        }\n    }\n\n    /* In the datagram scenarios, verify the datagram transmission */\n    if (ret == 0 && (test_id == multipath_test_datagram || test_id == multipath_test_dg_af)) {\n        ret = multipath_verify_datagram_sent(&dg_ctx, test_id);\n    }\n\n    /* In the backup scenario, verify that the flag is set\n    * correctly at the server, and that not too much data is\n    * sent on backup path.\n    */\n    if (ret == 0 && (test_id == multipath_test_backup)) {\n        if (!test_ctx->cnx_server->path[1]->path_is_backup) {\n            DBG_PRINTF(\"Backup not set on server path 1 (%d).\\n\", test_ctx->cnx_server->path[1]->path_is_backup);\n            ret = -1;\n        }\n        else if (test_ctx->cnx_server->path[1]->delivered > 50000) {\n            DBG_PRINTF(\"Too much data delivered on server path 1 (%\" PRIu64 \").\\n\", test_ctx->cnx_server->path[1]->delivered);\n            ret = -1;\n        }\n    }\n\n    if (ret == 0 && test_id == multipath_test_discovery) {\n        if (test_ctx->nb_address_observed < 2) {\n            DBG_PRINTF(\"Got % addresses observed\", test_ctx->nb_address_observed);\n            ret = -1;","numLines":300,"startLine":949,"totalLines":2027}}}
