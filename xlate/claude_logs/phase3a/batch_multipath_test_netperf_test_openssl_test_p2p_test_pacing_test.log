test_ctx->cnx_server->path[1]->path_is_backup) {\n1236\t            DBG_PRINTF(\"Backup not set on server path 1 (%d).\\n\", test_ctx->cnx_server->path[1]->path_is_backup);\n1237\t            ret = -1;\n1238\t        }\n1239\t        else if (test_ctx->cnx_server->path[1]->delivered > 50000) {\n1240\t            DBG_PRINTF(\"Too much data delivered on server path 1 (%\" PRIu64 \").\\n\", test_ctx->cnx_server->path[1]->delivered);\n1241\t            ret = -1;\n1242\t        }\n1243\t    }\n1244\t\n1245\t    if (ret == 0 && test_id == multipath_test_discovery) {\n1246\t        if (test_ctx->nb_address_observed < 2) {\n1247\t            DBG_PRINTF(\"Got % addresses observed\", test_ctx->nb_address_observed);\n1248\t            ret = -1;\n1249\t        }\n1250\t        for (int p = 0; p < 2; p++) {\n1251\t            if (picoquic_compare_addr(\n1252\t                (struct sockaddr*)&test_ctx->cnx_client->path[p]->first_tuple->local_addr,\n1253\t                (struct sockaddr*)&test_ctx->cnx_client->path[p]->first_tuple->observed_addr) != 0) {\n1254\t                char text1[256];\n1255\t                char text2[256];\n1256\t\n1257\t                DBG_PRINTF(\"Path %d, Local: %s, observed: %s\", p,\n1258\t                    picoquic_addr_text((struct sockaddr*)&test_ctx->cnx_client->path[p]->first_tuple->local_addr, text1, sizeof(text1)),\n1259\t                    picoquic_addr_text((struct sockaddr*)&test_ctx->cnx_client->path[p]->first_tuple->observed_addr, text2, sizeof(text2)));\n1260\t                ret = -1;\n1261\t            }\n1262\t        }\n1263\t    }\n1264\t\n1265\t    if (test_id == multipath_test_break_both) {\n1266\t        /* exception: this test is supposed to fail, because both links\n1267\t        * are unreachable. */\n1268\t        if (ret == 0) {\n1269\t            ret = -1;\n1270\t        }\n1271\t        else {\n1272\t            ret = 0;\n1273\t        }\n1274\t    }\n1275\t    /* Delete the context */\n1276\t    if (test_ctx != NUL