{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01UrkbDaYZLThC7pEPVGSNqW","type":"tool_result","content":"600\t            if (stash_count >= 2) {\n601\t                break;\n602\t            }\n603\t            else if (i < 10 && stash_count < 2) {\n604\t                ret = tls_api_wait_for_timeout(test_ctx, simulated_time, 100000);\n605\t            }\n606\t        }\n607\t        if (stash_count < 2) {\n608\t            DBG_PRINTF(\"Only %d stashes of CID available\", stash_count);\n609\t            ret = -1;\n610\t        }\n611\t    }\n612\t\n613\t    return ret;\n614\t}\n615\t\n616\tvoid multipath_init_datagram_ctx(picoquic_test_tls_api_ctx_t* test_ctx, test_datagram_send_recv_ctx_t * dg_ctx)\n617\t{\n618\t    /* Initialize the datagram targets as a function of the test id */\n619\t    memset(dg_ctx, 0, sizeof(test_datagram_send_recv_ctx_t));\n620\t    dg_ctx->dg_max_size = PICOQUIC_MAX_PACKET_SIZE;\n621\t    dg_ctx->dg_target[0] = 100;\n622\t    dg_ctx->dg_target[1] = 100;\n623\t    dg_ctx->send_delay = 3000;\n624\t    /* Set the test contexts for sending and receiving datagrams */\n625\t    test_ctx->datagram_ctx = dg_ctx;\n626\t    test_ctx->datagram_recv_fn = test_datagram_recv;\n627\t    test_ctx->datagram_send_fn = test_datagram_send;\n628\t    test_ctx->datagram_ack_fn = test_datagram_ack;\n629\t    /* Enable multipath callbacks */\n630\t    picoquic_enable_path_callbacks_default(test_ctx->qserver, 1);\n631\t    picoquic_enable_path_callbacks(test_ctx->cnx_client, 1);\n632\t    /* Use the extended datagram API */\n633\t    dg_ctx->use_extended_provider_api = 1;\n634\t}\n635\t\n636\tint multipath_set_datagram_ready(picoquic_test_tls_api_ctx_t* test_ctx, test_datagram_send_recv_ctx_t* dg_ctx, multipath_test_enum_t test_id)\n637\t{\n638\t    int ret = 0;\n639\t    /* Mark datagram ready, start to send. */\n640\t    if (test_id == multipath_test_datagram) {\n641\t        /* sending on any path */\n642\t        ret = picoquic_mark_datagram_ready(test_ctx->cnx_client, 1);\n643\t        if (ret == 0) {\n644\t            ret = picoquic_mark_datagram_ready(test_ctx->cnx_server, 1);\n645\t        }\n646\t    }\n647\t    else {\n648\t        /* Only wake up path 0 */\n649\t        dg_ctx->test_affinity = 1;\n650\t        ret = picoquic_mark_datagram_ready_path(test_ctx->cnx_client, 0, 1);\n651\t        if (ret == 0) {\n652\t            ret = picoquic_mark_datagram_ready_path(test_ctx->cnx_server, 0, 1);\n653\t        }\n654\t    }\n655\t    return ret;\n656\t}\n657\t\n658\tint multipath_verify_datagram_sent(test_datagram_send_recv_ctx_t* dg_ctx, multipath_test_enum_t test_id)\n659\t{\n660\t    int ret = 0;\n661\t\n662\t    /* Verify datagrams have been received -- 3/4 will be enough */\n663\t    if (4*dg_ctx->dg_recv[0] < 3*dg_ctx->dg_target[1] ||\n664\t        4*dg_ctx->dg_recv[1] < 3*dg_ctx->dg_target[0]) {\n665\t        DBG_PRINTF(\"%s\", \"Did not receive expected datagrams: \");\n666\t        for (int i = 0; i < 2; i++) {\n667\t            DBG_PRINTF(\"dg_target[%d]=%d, dg_sent[%d]=%d, dg_recv[%d]=%d\",\n668\t                i, dg_ctx->dg_target[i], i, dg_ctx->dg_sent[i], 1 - i, dg_ctx->dg_recv[1 - i]);\n669\t            ret = -1;\n670\t        }\n671\t    }\n672\t    if (ret == 0) {\n673\t        if (test_id == multipath_test_datagram) {\n674\t            for (int i = 0; ret == 0 && i < 2; i++) {\n675\t                int min_expected = dg_ctx->dg_recv[i] / 8;\n676\t\n677\t                if (dg_ctx->nb_recv_path_0[i] < min_expected ||\n678\t                    dg_ctx->nb_recv_path_other[i] < min_expected) {\n679\t                    DBG_PRINTF(\"Datagram not balanced, %s received %d on path 0, %d on others\",\n680\t                        (i) ? \"client\" : \"server\", dg_ctx->nb_recv_path_0[i], dg_ctx->nb_recv_path_other[i]);\n681\t                    ret = -1;\n682\t                }\n683\t            }\n684\t        }\n685\t        else if (test_id == multipath_test_dg_af) {\n686\t            for (int i = 0; ret == 0 && i < 2; i++) {\n687\t                if (dg_ctx->nb_recv_path_other[i] > 0) {\n688\t                    DBG_PRINTF(\"Datagram affinity fails, %s received %d on path 0, %d on others\",\n689\t                        (i) ? \"client\" : \"server\", dg_ctx->nb_recv_path_0[i], dg_ctx->nb_recv_path_other[i]);\n690\t                    ret = -1;\n691\t                }\n692\t            }\n693\t        }\n694\t    }\n695\t    return ret;\n696\t}\n697\t\n698\tstatic int multipath_verify_all_cid_available(picoquic_cnx_t* cnx)\n699\t{\n700\t    int ret = 0;\n701\t    uint64_t unique_id_max = 0;\n702\t    picoquic_remote_cnxid_stash_t* stash = cnx->first_remote_cnxid_stash;\n703\t\n704\t    while (stash != NULL) {\n705\t        if (stash->unique_path_id > unique_id_max) {\n706\t            unique_id_max = stash->unique_path_id;\n707\t        }\n708\t        stash = stash->next_stash;\n709\t    }\n710\t    if (unique_id_max < cnx->max_path_id_local && unique_id_max < cnx->max_path_id_remote) {\n711\t        ret = -1;\n712\t    }\n713\t    return ret;\n714\t}\n715\t\n716\tint multipath_datagram_send_loop(picoquic_test_tls_api_ctx_t* test_ctx,\n717\t    test_datagram_send_recv_ctx_t* dg_ctx, uint64_t* loss_mask, uint64_t* simulated_time)\n718\t{\n719\t    int ret = 0;\n720\t    int nb_trials = 0;\n721\t    int nb_inactive = 0;\n722\t\n723\t    test_ctx->c_to_s_link->loss_mask = loss_mask;\n724\t    test_ctx->s_to_c_link->loss_mask = loss_mask;\n725\t\n726\t    while (ret == 0 && nb_trials < 16000 && nb_inactive < 512 && TEST_CLIENT_READY && TEST_SERVER_READY) {\n727\t        int was_active = 0;\n728\t        uint64_t time_out = test_datagram_next_time_ready(dg_ctx);\n729\t        nb_trials++;\n730\t\n731\t        ret = tls_api_one_sim_round(test_ctx, simulated_time, time_out, &was_active);\n732\t\n733\t        if (ret < 0) {\n734\t            break;\n735\t        }\n736\t\n737\t        if (was_active) {\n738\t            nb_inactive = 0;\n739\t        } else {\n740\t            nb_inactive++;\n741\t        }\n742\t\n743\t        /* Simulate wake up when data is ready for real time operation */\n744\t        for (int i = 0; i < 2; i++) {\n745\t            picoquic_cnx_t* cnx = (i == 0) ? test_ctx->cnx_server : test_ctx->cnx_client;\n746\t            if (!dg_ctx->is_ready[i] && test_datagram_check_ready(dg_ctx, i, *simulated_time)) {\n747\t                if (dg_ctx->test_affinity) {\n748\t                    picoquic_mark_datagram_ready_path(cnx, 0, 1);\n749\t                }\n750\t                else {\n751\t                    picoquic_mark_datagram_ready(cnx, 1);\n752\t                }\n753\t            }\n754\t        }\n755\t\n756\t        if (test_ctx->test_finished) {\n757\t            if (test_ctx->immediate_exit ||\n758\t                (picoquic_is_cnx_backlog_empty(test_ctx->cnx_client) && picoquic_is_cnx_backlog_empty(test_ctx->cnx_server))) {\n759\t                break;\n760\t            }\n761\t        }\n762\t    }\n763\t\n764\t    return ret;\n765\t}\n766\t\n767\tint multipath_test_do_keep_alive(picoquic_test_tls_api_ctx_t* test_ctx, uint64_t * simulated_time)\n768\t{\n769\t    int ret = 0;\n770\t    uint8_t ping_frame[1] = { (uint8_t)picoquic_frame_type_ping };\n771\t    int nat_test_needed = 1;\n772\t    int rounds_without_nat = 0;\n773\t\n774\t    while (ret == 0 && *simulated_time < 200000000) {\n775\t        uint64_t previous_time = *simulated_time;\n776\t\n777\t        if (nat_test_needed) {\n778\t            if (rounds_without_nat > 3) {\n779\t                /* do a nat rebinding */\n780\t                test_ctx->client_addr_natted = test_ctx->client_addr;\n781\t                test_ctx->client_addr_natted.sin_port += 7;\n782\t                test_ctx->client_use_nat = 1;\n783\t                nat_test_needed = 0;\n784\t            }\n785\t            else {\n786\t                rounds_without_nat++;\n787\t            }\n788\t        }\n789\t\n790\t        if (ret == 0) {\n791\t            ret = picoquic_queue_misc_frame(test_ctx->cnx_client, ping_frame, sizeof(ping_frame), 0, picoquic_packet_context_application);\n792\t            if (ret != 0) {\n793\t                DBG_PRINTF(\"Cannot queue ping frame, ret = 0x%x\", ret);\n794\t                break;\n795\t            }\n796\t        }\n797\t\n798\t        ret = tls_api_wait_for_timeout(test_ctx, simulated_time, 10000000);\n799\t        if (ret != 0) {\n800\t            DBG_PRINTF(\"Cannot wait 10 seconds, ret = 0x%x\", ret);\n801\t            break;\n802\t        }\n803\t\n804\t        if (!(TEST_CLIENT_READY && TEST_SERVER_READY) || *simulated_time < previous_time + 1000000) {\n805\t            DBG_PRINTF(\"Connection stalled at t=%\" PRIu64, *simulated_time);\n806\t            ret = -1;\n807\t            break;\n808\t        }\n809\t    }\n810\t    if (ret != 0) {\n811\t        DBG_PRINTF(\"Keep alive test fails at t=%\" PRIu64 \", ret = 0x%x\", *simulated_time, ret);\n812\t    }\n813\t    return ret;\n814\t}\n815\t\n816\tint multipath_test_one(uint64_t max_completion_microsec, multipath_test_enum_t test_id)\n817\t{\n818\t    uint64_t simulated_time = 0;\n819\t    uint64_t loss_mask = 0;\n820\t    picoquic_test_tls_api_ctx_t* test_ctx = NULL;\n821\t    test_datagram_send_recv_ctx_t dg_ctx = { 0 };\n822\t    picoquic_connection_id_t initial_cid = { {0x1b, 0x11, 0xc0, 4, 5, 6, 7, 8}, 8 };\n823\t    picoquic_tp_t server_parameters;\n824\t    uint64_t original_r_cid_sequence = 0;\n825\t    size_t send_buffer_size = 0;\n826\t    int ret;\n827\t\n828\t    initial_cid.id[2] = (int)test_id;\n829\t\n830\t    if (test_id == multipath_test_perf) {\n831\t        send_buffer_size = 65536;\n832\t    }\n833\t\n834\t    /* Create the context but delay initialization, so the multipath option can be set */\n835\t    ret = tls_api_init_ctx_ex2(&test_ctx, PICOQUIC_INTERNAL_TEST_VERSION_1,\n836\t        PICOQUIC_TEST_SNI, PICOQUIC_TEST_ALPN, &simulated_time, NULL, NULL, 0, 1, 0, &initial_cid,\n837\t        8, 0, send_buffer_size, 0);\n838\t\n839\t    if (ret == 0 && test_ctx == NULL) {\n840\t        ret = -1;\n841\t    }\n842\t\n843\t    if (ret == 0) {\n844\t        int is_sat_test = (test_id == multipath_test_sat_plus);\n845\t        if (is_sat_test || test_id == multipath_test_break1 || test_id == multipath_test_break2 || test_id == multipath_test_back1) {\n846\t            /* Reduce the throughput of path #0 to 1 mbps.\n847\t             * This is used to simulate an asymmetric \"satellite and landline\" scenario,\n848\t             * or to simulate a long transfer and test broken path detection or repair */\n849\t            multipath_test_sat_links(test_ctx, 0);\n850\t        }\n851\t        else if (test_id == multipath_test_perf) {\n852\t            multipath_test_perf_links(test_ctx, 0);\n853\t            picoquic_set_default_congestion_algorithm(test_ctx->qserver, picoquic_bbr_algorithm);\n854\t        }\n855\t        test_ctx->c_to_s_link->queue_delay_max = 2 * test_ctx->c_to_s_link->microsec_latency;\n856\t        test_ctx->s_to_c_link->queue_delay_max = 2 * test_ctx->s_to_c_link->microsec_latency;\n857\t\n858\t        if (test_id == multipath_test_rotation) {\n859\t            picoquic_set_default_crypto_epoch_length(test_ctx->qserver, 200);\n860\t        }\n861\t\n862\t        if (test_id == multipath_test_callback || test_id == multipath_test_quality || test_id == multipath_test_quality_server || test_id == multipath_test_stream_af) {\n863\t            multipath_init_callbacks(test_ctx, test_id);\n864\t        }\n865\t\n866\t        if (test_id == multipath_test_datagram || test_id == multipath_test_dg_af) {\n867\t            multipath_init_datagram_ctx(test_ctx, &dg_ctx);\n868\t        }\n869\t\n870\t        picoquic_set_binlog(test_ctx->qserver, \".\");\n871\t        test_ctx->qserver->use_long_log = 1;\n872\t        /* set the binary log on the client side */\n873\t        picoquic_set_binlog(test_ctx->qclient, \".\");\n874\t        test_ctx->qclient->use_long_log = 1;\n875\t        /* Set the multipath option at both client and server */\n876\t        multipath_init_params(&server_parameters, is_sat_test);\n877\t        if (test_id == multipath_test_datagram || test_id == multipath_test_dg_af) {\n878\t            server_parameters.max_datagram_frame_size = 1536;\n879\t            test_ctx->cnx_client->local_parameters.max_datagram_frame_size = 1536;\n880\t        }\n881\t        if (test_id == multipath_test_discovery) {\n882\t            server_parameters.address_discovery_mode = 1;\n883\t            test_ctx->cnx_client->local_parameters.address_discovery_mode = 3;\n884\t        }\n885\t        if (test_id == multipath_test_just_one) {\n886\t            server_parameters.initial_max_path_id = 1;\n887\t        }\n888\t\n889\t        picoquic_set_default_tp(test_ctx->qserver, &server_parameters);\n890\t        test_ctx->cnx_client->local_parameters.enable_time_stamp = 3;\n891\t\n892\t        test_ctx->cnx_client->local_parameters.initial_max_path_id = 3;\n893\t    }\n894\t\n895\t    /* establish the connection */\n896\t    if (ret == 0) {\n897\t        /* Initialize the client connection */\n898\t        picoquic_start_client_cnx(test_ctx->cnx_client);\n899\t        ret = tls_api_connection_loop(test_ctx, &loss_mask, 2 * test_ctx->s_to_c_link->microsec_latency, &simulated_time);\n900\t    }\n901\t    /* verify that multipath is negotiated on both sides */\n902\t    if (!test_ctx->cnx_client->is_multipath_enabled || !test_ctx->cnx_server->is_multipath_enabled) {\n903\t        DBG_PRINTF(\"Multipath not fully negotiated (c=%d, s=%d)\",\n904\t            test_ctx->cnx_client->is_multipath_enabled, test_ctx->cnx_server->is_multipath_enabled);\n905\t        ret = -1;\n906\t    }\n907\t    /* verify that both sides have the same vision of max path id*/\n908\t    if (test_ctx->cnx_client->max_path_id_local != test_ctx->cnx_server->max_path_id_remote ||\n909\t        test_ctx->cnx_client->max_path_id_remote != test_ctx->cnx_server->max_path_id_local) {\n910\t        DBG_PRINTF(\"No agreement on max path if (c=%u/%u, s=%u/%u)\",\n911\t            (uint32_t)test_ctx->cnx_client->max_path_id_local, (uint32_t)test_ctx->cnx_client->max_path_id_remote,\n912\t            (uint32_t)test_ctx->cnx_server->max_path_id_local, (uint32_t)test_ctx->cnx_server->max_path_id_remote);\n913\t        ret = -1;\n914\t    }\n915\t\n916\t    /* wait until the client (and thus the server) is ready */\n917\t    if (ret == 0) {\n918\t        ret = wait_client_connection_ready(test_ctx, &simulated_time);\n919\t    }\n920\t\n921\t    if (ret == 0 && test_id == multipath_test_ab1) {\n922\t        for (int i = 0; ret == 0 && i < 7; i++) {\n923\t            ret = multipath_test_abandon_cycle(test_ctx, &simulated_time);\n924\t        }\n925\t    }\n926\t\n927\t    /* Prepare to send data */\n928\t    if (ret == 0) {\n929\t        if (test_id == multipath_test_sat_plus || test_id == multipath_test_perf) {\n930\t            ret = test_api_init_send_recv_scenario(test_ctx, test_scenario_multipath_long, sizeof(test_scenario_multipath_long));\n931\t        } else {\n932\t            ret = test_api_init_send_recv_scenario(test_ctx, test_scenario_multipath, sizeof(test_scenario_multipath));\n933\t        }\n934\t\n935\t        if (ret != 0)\n936\t        {\n937\t            DBG_PRINTF(\"Init send receive scenario returns %d\\n\", ret);\n938\t        }\n939\t    }\n940\t\n941\t    /* Add the multipath links and initiate the path creation */\n942\t    if (ret == 0) {\n943\t        ret = multipath_test_add_links(test_ctx, 0);\n944\t        if (ret == 0) {\n945\t            if (test_id == multipath_test_sat_plus) {\n946\t                /* Simulate an asymmetric \"satellite and landline\" scenario */\n947\t                multipath_test_sat_links(test_ctx, 1);\n948\t            }\n949\t            else if (test_id == multipath_test_perf) {\n950\t                multipath_test_perf_links(test_ctx, 1);\n951\t            }\n952\t            else if (test_id == multipath_test_fail) {\n953\t                /* Kill link #1 in server to client direction. This will cause path challenges to fail */\n954\t                multipath_test_kill_server_links(test_ctx, 1);\n955\t            }\n956\t        }\n957\t    }\n958\t\n959\t    if (ret == 0) {\n960\t        ret = picoquic_probe_new_path(test_ctx->cnx_client, (struct sockaddr*) & test_ctx->server_addr,\n961\t            (struct sockaddr*) & test_ctx->client_addr_2, simulated_time);\n962\t    }\n963\t\n964\t    /* Check that the two paths are established */\n965\t    if (ret == 0 && test_id != multipath_test_fail) {\n966\t        ret = wait_multipath_ready(test_ctx, &simulated_time);\n967\t    }\n968\t     if (ret == 0){\n969\t        if (test_id == multipath_test_stream_af) {\n970\t            ret = picoquic_set_stream_path_affinity(test_ctx->cnx_server, 4, 0);\n971\t            if (ret != 0) {\n972\t                DBG_PRINTF(\"Cannot set stream affinity, ret = %d\", ret);\n973\t            }\n974\t        }\n975\t        else if (test_id == multipath_test_backup ||\n976\t            test_id == multipath_test_standup) {\n977\t            ret = picoquic_set_path_status(test_ctx->cnx_client, 1, picoquic_path_status_backup);\n978\t        }\n979\t    }\n980\t\n981\t    if (ret == 0 && (test_id == multipath_test_drop_first || test_id == multipath_test_drop_second ||\n982\t        test_id == multipath_test_renew || test_id == multipath_test_nat || test_id == multipath_test_nat_challenge ||\n983\t        test_id == multipath_test_break1 || test_id == multipath_test_break2 || test_id == multipath_test_break3 ||\n984\t        test_id == multipath_test_back0 || test_id == multipath_test_back1 || test_id == multipath_test_standup ||\n985\t        test_id == multipath_test_abandon || test_id == multipath_test_tunnel || test_id == multipath_test_break_both)) {\n986\t        /* If testing a final link drop before completion, perform a \n987\t         * partial sending loop and then kill the initial link.\n988\t         * For the tunnel scenario, do the same but kill both links.\n989\t         */\n990\t        if (ret == 0) {\n991\t            uint64_t timeout = 640000;\n992\t\n993\t            ret = tls_api_wait_for_timeout(test_ctx, &simulated_time, timeout);\n994\t\n995\t            if (ret != 0)\n996\t            {\n997\t                DBG_PRINTF(\"Wait for %\" PRIu64 \"us returns %d\\n\", timeout, ret);\n998\t            }\n999\t        }\n1000\t        if (ret == 0) {\n1001\t            if (test_id == multipath_test_renew) {\n1002\t                ret = picoquic_renew_connection_id(test_ctx->cnx_client, 1);\n1003\t            }\n1004\t            else if (test_id == multipath_test_nat || test_id == multipath_test_nat_challenge) {\n1005\t                /* Change the client address */\n1006\t                test_ctx->client_addr_natted = test_ctx->client_addr;\n1007\t                test_ctx->client_addr_natted.sin_port += 7;\n1008\t                test_ctx->client_use_nat = 1;\n1009\t                if (test_id == multipath_test_nat_challenge) {\n1010\t                    test_ctx->cnx_client->path[0]->first_tuple->challenge_required = 1;\n1011\t                }\n1012\t            }\n1013\t            else if (test_id == multipath_test_abandon) {\n1014\t                /* Client abandons the path, causes it to be demoted. Server should follow suit. */\n1015\t                picoquic_abandon_path(test_ctx->cnx_client, 0, 0,\n1016\t                    simulated_time);\n1017\t            }\n1018\t            else if (test_id == multipath_test_break2) {\n1019\t                /* Trigger \"destination unreachable\" error on next socket call to link 1 */\n1020\t                multipath_test_set_unreachable(test_ctx, 1);\n1021\t            }\n1022\t            else if (test_id == multipath_test_back0 || test_id == multipath_test_break3) {\n1023\t                /* Trigger \"destination unreachable\" error on next socket call to link 0 */\n1024\t                multipath_test_set_unreachable(test_ctx, 0);\n1025\t            }\n1026\t            else if (test_id == multipath_test_tunnel) {\n1027\t                /* Break both links */\n1028\t                multipath_test_kill_links(test_ctx, 0);\n1029\t                multipath_test_kill_links(test_ctx, 1);\n1030\t            }\n1031\t            else if (test_id == multipath_test_break_both) {\n1032\t                /* Break both paths, program them to return socket errors */\n1033\t                multipath_test_set_unreachable(test_ctx, 0);\n1034\t                multipath_test_set_unreachable(test_ctx, 1);\n1035\t            } else {\n1036\t                multipath_test_kill_links(test_ctx, \n1037\t                    (test_id == multipath_test_drop_first ||\n1038\t                        test_id == multipath_test_standup) ? 0 : 1);\n1039\t            }\n1040\t        }\n1041\t    }\n1042\t    /* For the \"backup scenario\", wait a small interval, then bring the path # 1 back up\n1043\t     * For the \"tunnel\" scenario, do the same but wait 5 seconds and then restore both links.\n1044\t     */\n1045\t    if (ret == 0 && (test_id == multipath_test_back0 || test_id == multipath_test_back1 || test_id == multipath_test_tunnel)) {\n1046\t        uint64_t timeout = (test_id == multipath_test_tunnel)?5000000:1000000;\n1047\t\n1048\t        ret = tls_api_wait_for_timeout(test_ctx, &simulated_time, timeout);\n1049\t\n1050\t        if (ret != 0)\n1051\t        {\n1052\t            DBG_PRINTF(\"Wait for %\" PRIu64 \"us returns %d\\n\", timeout, ret);\n1053\t        }\n1054\t        else if (test_id == multipath_test_back0) {\n1055\t            multipath_test_set_reachable(test_ctx, 0);\n1056\t            \n1057\t            ret = picoquic_probe_new_path(test_ctx->cnx_client, (struct sockaddr*)&test_ctx->server_addr,\n1058\t                    (struct sockaddr*)&test_ctx->client_addr, simulated_time);\n1059\t            if (ret != 0) {\n1060\t                DBG_PRINTF(\"Create path on default address returns %d\\n\", ret);\n1061\t            }\n1062\t        }\n1063\t        else {\n1064\t            if (test_id == multipath_test_tunnel) {\n1065\t                multipath_test_unkill_links(test_ctx, 0, simulated_time);\n1066\t            }\n1067\t            multipath_test_unkill_links(test_ctx, 1, simulated_time);\n1068\t        }\n1069\t    }\n1070\t    /* In the \"abandon\" scenario, allow for a bit more than 1 second of delay for clearing of paths */\n1071\t    if (ret == 0 && test_id == multipath_test_abandon) {\n1072\t        uint64_t timeout = 1100000;\n1073\t\n1074\t        ret = tls_api_wait_for_timeout(test_ctx, &simulated_time, timeout);\n1075\t\n1076\t        if (ret != 0)\n1077\t        {\n1078\t            DBG_PRINTF(\"Wait for %\" PRIu64 \"us returns %d\\n\", timeout, ret);\n1079\t        }\n1080\t    }\n1081\t\n1082\t    /* In the datagram scenarios, trigger the datagram transmission */\n1083\t    if (ret == 0 && (test_id == multipath_test_datagram || test_id == multipath_test_dg_af)) {\n1084\t        ret = multipath_set_datagram_ready(test_ctx, &dg_ctx, test_id);\n1085\t    }\n1086\t\n1087\t    /* Perform a final data sending loop, this time to completion  */\n1088\t    if (ret == 0) { \n1089\t        if (test_id == multipath_test_datagram || test_id == multipath_test_dg_af) {\n1090\t            ret = multipath_datagram_send_loop(test_ctx, &dg_ctx, &loss_mask, &simulated_time);\n1091\t        }\n1092\t        else if (!test_ctx->test_finished ||\n1093\t            !picoquic_is_cnx_backlog_empty(test_ctx->cnx_client) ||\n1094\t            !picoquic_is_cnx_backlog_empty(test_ctx->cnx_server)){\n1095\t            ret = tls_api_data_sending_loop(test_ctx, &loss_mask, &simulated_time, 0);\n1096\t        }\n1097\t\n1098\t        if (ret != 0)\n1099\t        {"}]},"parent_tool_use_id":null,"session_id":"dd2036ff-0dd1-48ca-b8bf-92c20dcaef2a","uuid":"74120b20-f9cc-4ba4-b0f3-70e34d1b19c3","timestamp":"2026-05-05T04:10:26.202Z","tool_use_result":{"type":"text","file":{"filePath":"/Users/richbarn/Projects/picoquic/picoquictest/multipath_test.c","content":"            if (stash_count >= 2) {\n                break;\n            }\n            else if (i < 10 && stash_count < 2) {\n                ret = tls_api_wait_for_timeout(test_ctx, simulated_time, 100000);\n            }\n        }\n        if (stash_count < 2) {\n            DBG_PRINTF(\"Only %d stashes of CID available\", stash_count);\n            ret = -1;\n        }\n    }\n\n    return ret;\n}\n\nvoid multipath_init_datagram_ctx(picoquic_test_tls_api_ctx_t* test_ctx, test_datagram_send_recv_ctx_t * dg_ctx)\n{\n    /* Initialize the datagram targets as a function of the test id */\n    memset(dg_ctx, 0, sizeof(test_datagram_send_recv_ctx_t));\n    dg_ctx->dg_max_size = PICOQUIC_MAX_PACKET_SIZE;\n    dg_ctx->dg_target[0] = 100;\n    dg_ctx->dg_target[1] = 100;\n    dg_ctx->send_delay = 3000;\n    /* Set the test contexts for sending and receiving datagrams */\n    test_ctx->datagram_ctx = dg_ctx;\n    test_ctx->datagram_recv_fn = test_datagram_recv;\n    test_ctx->datagram_send_fn = test_datagram_send;\n    test_ctx->datagram_ack_fn = test_datagram_ack;\n    /* Enable multipath callbacks */\n    picoquic_enable_path_callbacks_default(test_ctx->qserver, 1);\n    picoquic_enable_path_callbacks(test_ctx->cnx_client, 1);\n    /* Use the extended datagram API */\n    dg_ctx->use_extended_provider_api = 1;\n}\n\nint multipath_set_datagram_ready(picoquic_test_tls_api_ctx_t* test_ctx, test_datagram_send_recv_ctx_t* dg_ctx, multipath_test_enum_t test_id)\n{\n    int ret = 0;\n    /* Mark datagram ready, start to send. */\n    if (test_id == multipath_test_datagram) {\n        /* sending on any path */\n        ret = picoquic_mark_datagram_ready(test_ctx->cnx_client, 1);\n        if (ret == 0) {\n            ret = picoquic_mark_datagram_ready(test_ctx->cnx_server, 1);\n        }\n    }\n    else {\n        /* Only wake up path 0 */\n        dg_ctx->test_affinity = 1;\n        ret = picoquic_mark_datagram_ready_path(test_ctx->cnx_client, 0, 1);\n        if (ret == 0) {\n            ret = picoquic_mark_datagram_ready_path(test_ctx->cnx_server, 0, 1);\n        }\n    }\n    return ret;\n}\n\nint multipath_verify_datagram_sent(test_datagram_send_recv_ctx_t* dg_ctx, multipath_test_enum_t test_id)\n{\n    int ret = 0;\n\n    /* Verify datagrams have been received -- 3/4 will be enough */\n    if (4*dg_ctx->dg_recv[0] < 3*dg_ctx->dg_target[1] ||\n        4*dg_ctx->dg_recv[1] < 3*dg_ctx->dg_target[0]) {\n        DBG_PRINTF(\"%s\", \"Did not receive expected datagrams: \");\n        for (int i = 0; i < 2; i++) {\n            DBG_PRINTF(\"dg_target[%d]=%d, dg_sent[%d]=%d, dg_recv[%d]=%d\",\n                i, dg_ctx->dg_target[i], i, dg_ctx->dg_sent[i], 1 - i, dg_ctx->dg_recv[1 - i]);\n            ret = -1;\n        }\n    }\n    if (ret == 0) {\n        if (test_id == multipath_test_datagram) {\n            for (int i = 0; ret == 0 && i < 2; i++) {\n                int min_expected = dg_ctx->dg_recv[i] / 8;\n\n                if (dg_ctx->nb_recv_path_0[i] < min_expected ||\n                    dg_ctx->nb_recv_path_other[i] < min_expected) {\n                    DBG_PRINTF(\"Datagram not balanced, %s received %d on path 0, %d on others\",\n                        (i) ? \"client\" : \"server\", dg_ctx->nb_recv_path_0[i], dg_ctx->nb_recv_path_other[i]);\n                    ret = -1;\n                }\n            }\n        }\n        else if (test_id == multipath_test_dg_af) {\n            for (int i = 0; ret == 0 && i < 2; i++) {\n                if (dg_ctx->nb_recv_path_other[i] > 0) {\n                    DBG_PRINTF(\"Datagram affinity fails, %s received %d on path 0, %d on others\",\n                        (i) ? \"client\" : \"server\", dg_ctx->nb_recv_path_0[i], dg_ctx->nb_recv_path_other[i]);\n                    ret = -1;\n                }\n            }\n        }\n    }\n    return ret;\n}\n\nstatic int multipath_verify_all_cid_available(picoquic_cnx_t* cnx)\n{\n    int ret = 0;\n    uint64_t unique_id_max = 0;\n    picoquic_remote_cnxid_stash_t* stash = cnx->first_remote_cnxid_stash;\n\n    while (stash != NULL) {\n        if (stash->unique_path_id > unique_id_max) {\n            unique_id_max = stash->unique_path_id;\n        }\n        stash = stash->next_stash;\n    }\n    if (unique_id_max < cnx->max_path_id_local && unique_id_max < cnx->max_path_id_remote) {\n        ret = -1;\n    }\n    return ret;\n}\n\nint multipath_datagram_send_loop(picoquic_test_tls_api_ctx_t* test_ctx,\n    test_datagram_send_recv_ctx_t* dg_ctx, uint64_t* loss_mask, uint64_t* simulated_time)\n{\n    int ret = 0;\n    int nb_trials = 0;\n    int nb_inactive = 0;\n\n    test_ctx->c_to_s_link->loss_mask = loss_mask;\n    test_ctx->s_to_c_link->loss_mask = loss_mask;\n\n    while (ret == 0 && nb_trials < 16000 && nb_inactive < 512 && TEST_CLIENT_READY && TEST_SERVER_READY) {\n        int was_active = 0;\n        uint64_t time_out = test_datagram_next_time_ready(dg_ctx);\n        nb_trials++;\n\n        ret = tls_api_one_sim_round(test_ctx, simulated_time, time_out, &was_active);\n\n        if (ret < 0) {\n            break;\n        }\n\n        if (was_active) {\n            nb_inactive = 0;\n        } else {\n            nb_inactive++;\n        }\n\n        /* Simulate wake up when data is ready for real time operation */\n        for (int i = 0; i < 2; i++) {\n            picoquic_cnx_t* cnx = (i == 0) ? test_ctx->cnx_server : test_ctx->cnx_client;\n            if (!dg_ctx->is_ready[i] && test_datagram_check_ready(dg_ctx, i, *simulated_time)) {\n                if (dg_ctx->test_affinity) {\n                    picoquic_mark_datagram_ready_path(cnx, 0, 1);\n                }\n                else {\n                    picoquic_mark_datagram_ready(cnx, 1);\n                }\n            }\n        }\n\n        if (test_ctx->test_finished) {\n            if (test_ctx->immediate_exit ||\n                (picoquic_is_cnx_backlog_empty(test_ctx->cnx_client) && picoquic_is_cnx_backlog_empty(test_ctx->cnx_server))) {\n                break;\n            }\n        }\n    }\n\n    return ret;\n}\n\nint multipath_test_do_keep_alive(picoquic_test_tls_api_ctx_t* test_ctx, uint64_t * simulated_time)\n{\n    int ret = 0;\n    uint8_t ping_frame[1] = { (uint8_t)picoquic_frame_type_ping };\n    int nat_test_needed = 1;\n    int rounds_without_nat = 0;\n\n    while (ret == 0 && *simulated_time < 200000000) {\n        uint64_t previous_time = *simulated_time;\n\n        if (nat_test_needed) {\n            if (rounds_without_nat > 3) {\n                /* do a nat rebinding */\n                test_ctx->client_addr_natted = test_ctx->client_addr;\n                test_ctx->client_addr_natted.sin_port += 7;\n                test_ctx->client_use_nat = 1;\n                nat_test_needed = 0;\n            }\n            else {\n                rounds_without_nat++;\n            }\n        }\n\n        if (ret == 0) {\n            ret = picoquic_queue_misc_frame(test_ctx->cnx_client, ping_frame, sizeof(ping_frame), 0, picoquic_packet_context_application);\n            if (ret != 0) {\n                DBG_PRINTF(\"Cannot queue ping frame, ret = 0x%x\", ret);\n                break;\n            }\n        }\n\n        ret = tls_api_wait_for_timeout(test_ctx, simulated_time, 10000000);\n        if (ret != 0) {\n            DBG_PRINTF(\"Cannot wait 10 seconds, ret = 0x%x\", ret);\n            break;\n        }\n\n        if (!(TEST_CLIENT_READY && TEST_SERVER_READY) || *simulated_time < previous_time + 1000000) {\n            DBG_PRINTF(\"Connection stalled at t=%\" PRIu64, *simulated_time);\n            ret = -1;\n            break;\n        }\n    }\n    if (ret != 0) {\n        DBG_PRINTF(\"Keep alive test fails at t=%\" PRIu64 \", ret = 0x%x\", *simulated_time, ret);\n    }\n    return ret;\n}\n\nint multipath_test_one(uint64_t max_completion_microsec, multipath_test_enum_t test_id)\n{\n    uint64_t simulated_time = 0;\n    uint64_t loss_mask = 0;\n    picoquic_test_tls_api_ctx_t* test_ctx = NULL;\n    test_datagram_send_recv_ctx_t dg_ctx = { 0 };\n    picoquic_connection_id_t initial_cid = { {0x1b, 0x11, 0xc0, 4, 5, 6, 7, 8}, 8 };\n    picoquic_tp_t server_parameters;\n    uint64_t original_r_cid_sequence = 0;\n    size_t send_buffer_size = 0;\n    int ret;\n\n    initial_cid.id[2] = (int)test_id;\n\n    if (test_id == multipath_test_perf) {\n        send_buffer_size = 65536;\n    }\n\n    /* Create the context but delay initialization, so the multipath option can be set */\n    ret = tls_api_init_ctx_ex2(&test_ctx, PICOQUIC_INTERNAL_TEST_VERSION_1,\n        PICOQUIC_TEST_SNI, PICOQUIC_TEST_ALPN, &simulated_time, NULL, NULL, 0, 1, 0, &initial_cid,\n        8, 0, send_buffer_size, 0);\n\n    if (ret == 0 && test_ctx == NULL) {\n        ret = -1;\n    }\n\n    if (ret == 0) {\n        int is_sat_test = (test_id == multipath_test_sat_plus);\n        if (is_sat_test || test_id == multipath_test_break1 || test_id == multipath_test_break2 || test_id == multipath_test_back1) {\n            /* Reduce the throughput of path #0 to 1 mbps.\n             * This is used to simulate an asymmetric \"satellite and landline\" scenario,\n             * or to simulate a long transfer and test broken path detection or repair */\n            multipath_test_sat_links(test_ctx, 0);\n        }\n        else if (test_id == multipath_test_perf) {\n            multipath_test_perf_links(test_ctx, 0);\n            picoquic_set_default_congestion_algorithm(test_ctx->qserver, picoquic_bbr_algorithm);\n        }\n        test_ctx->c_to_s_link->queue_delay_max = 2 * test_ctx->c_to_s_link->microsec_latency;\n        test_ctx->s_to_c_link->queue_delay_max = 2 * test_ctx->s_to_c_link->microsec_latency;\n\n        if (test_id == multipath_test_rotation) {\n            picoquic_set_default_crypto_epoch_length(test_ctx->qserver, 200);\n        }\n\n        if (test_id == multipath_test_callback || test_id == multipath_test_quality || test_id == multipath_test_quality_server || test_id == multipath_test_stream_af) {\n            multipath_init_callbacks(test_ctx, test_id);\n        }\n\n        if (test_id == multipath_test_datagram || test_id == multipath_test_dg_af) {\n            multipath_init_datagram_ctx(test_ctx, &dg_ctx);\n        }\n\n        picoquic_set_binlog(test_ctx->qserver, \".\");\n        test_ctx->qserver->use_long_log = 1;\n        /* set the binary log on the client side */\n        picoquic_set_binlog(test_ctx->qclient, \".\");\n        test_ctx->qclient->use_long_log = 1;\n        /* Set the multipath option at both client and server */\n        multipath_init_params(&server_parameters, is_sat_test);\n        if (test_id == multipath_test_datagram || test_id == multipath_test_dg_af) {\n            server_parameters.max_datagram_frame_size = 1536;\n            test_ctx->cnx_client->local_parameters.max_datagram_frame_size = 1536;\n        }\n        if (test_id == multipath_test_discovery) {\n            server_parameters.address_discovery_mode = 1;\n            test_ctx->cnx_client->local_parameters.address_discovery_mode = 3;\n        }\n        if (test_id == multipath_test_just_one) {\n            server_parameters.initial_max_path_id = 1;\n        }\n\n        picoquic_set_default_tp(test_ctx->qserver, &server_parameters);\n        test_ctx->cnx_client->local_parameters.enable_time_stamp = 3;\n\n        test_ctx->cnx_client->local_parameters.initial_max_path_id = 3;\n    }\n\n    /* establish the connection */\n    if (ret == 0) {\n        /* Initialize the client connection */\n        picoquic_start_client_cnx(test_ctx->cnx_client);\n        ret = tls_api_connection_loop(test_ctx, &loss_mask, 2 * test_ctx->s_to_c_link->microsec_latency, &simulated_time);\n    }\n    /* verify that multipath is negotiated on both sides */\n    if (!test_ctx->cnx_client->is_multipath_enabled || !test_ctx->cnx_server->is_multipath_enabled) {\n        DBG_PRINTF(\"Multipath not fully negotiated (c=%d, s=%d)\",\n            test_ctx->cnx_client->is_multipath_enabled, test_ctx->cnx_server->is_multipath_enabled);\n        ret = -1;\n    }\n    /* verify that both sides have the same vision of max path id*/\n    if (test_ctx->cnx_client->max_path_id_local != test_ctx->cnx_server->max_path_id_remote ||\n        test_ctx->cnx_client->max_path_id_remote != test_ctx->cnx_server->max_path_id_local) {\n        DBG_PRINTF(\"No agreement on max path if (c=%u/%u, s=%u/%u)\",\n            (uint32_t)test_ctx->cnx_client->max_path_id_local, (uint32_t)test_ctx->cnx_client->max_path_id_remote,\n            (uint32_t)test_ctx->cnx_server->max_path_id_local, (uint32_t)test_ctx->cnx_server->max_path_id_remote);\n        ret = -1;\n    }\n\n    /* wait until the client (and thus the server) is ready */\n    if (ret == 0) {\n        ret = wait_client_connection_ready(test_ctx, &simulated_time);\n    }\n\n    if (ret == 0 && test_id == multipath_test_ab1) {\n        for (int i = 0; ret == 0 && i < 7; i++) {\n            ret = multipath_test_abandon_cycle(test_ctx, &simulated_time);\n        }\n    }\n\n    /* Prepare to send data */\n    if (ret == 0) {\n        if (test_id == multipath_test_sat_plus || test_id == multipath_test_perf) {\n            ret = test_api_init_send_recv_scenario(test_ctx, test_scenario_multipath_long, sizeof(test_scenario_multipath_long));\n        } else {\n            ret = test_api_init_send_recv_scenario(test_ctx, test_scenario_multipath, sizeof(test_scenario_multipath));\n        }\n\n        if (ret != 0)\n        {\n            DBG_PRINTF(\"Init send receive scenario returns %d\\n\", ret);\n        }\n    }\n\n    /* Add the multipath links and initiate the path creation */\n    if (ret == 0) {\n        ret = multipath_test_add_links(test_ctx, 0);\n        if (ret == 0) {\n            if (test_id == multipath_test_sat_plus) {\n                /* Simulate an asymmetric \"satellite and landline\" scenario */\n                multipath_test_sat_links(test_ctx, 1);\n            }\n            else if (test_id == multipath_test_perf) {\n                multipath_test_perf_links(test_ctx, 1);\n            }\n            else if (test_id == multipath_test_fail) {\n                /* Kill link #1 in server to client direction. This will cause path challenges to fail */\n                multipath_test_kill_server_links(test_ctx, 1);\n            }\n        }\n    }\n\n    if (ret == 0) {\n        ret = picoquic_probe_new_path(test_ctx->cnx_client, (struct sockaddr*) & test_ctx->server_addr,\n            (struct sockaddr*) & test_ctx->client_addr_2, simulated_time);\n    }\n\n    /* Check that the two paths are established */\n    if (ret == 0 && test_id != multipath_test_fail) {\n        ret = wait_multipath_ready(test_ctx, &simulated_time);\n    }\n     if (ret == 0){\n        if (test_id == multipath_test_stream_af) {\n            ret = picoquic_set_stream_path_affinity(test_ctx->cnx_server, 4, 0);\n            if (ret != 0) {\n                DBG_PRINTF(\"Cannot set stream affinity, ret = %d\", ret);\n            }\n        }\n        else if (test_id == multipath_test_backup ||\n            test_id == multipath_test_standup) {\n            ret = picoquic_set_path_status(test_ctx->cnx_client, 1, picoquic_path_status_backup);\n        }\n    }\n\n    if (ret == 0 && (test_id == multipath_test_drop_first || test_id == multipath_test_drop_second ||\n        test_id == multipath_test_renew || test_id == multipath_test_nat || test_id == multipath_test_nat_challenge ||\n        test_id == multipath_test_break1 || test_id == multipath_test_break2 || test_id == multipath_test_break3 ||\n        test_id == multipath_test_back0 || test_id == multipath_test_back1 || test_id == multipath_test_standup ||\n        test_id == multipath_test_abandon || test_id == multipath_test_tunnel || test_id == multipath_test_break_both)) {\n        /* If testing a final link drop before completion, perform a \n         * partial sending loop and then kill the initial link.\n         * For the tunnel scenario, do the same but kill both links.\n         */\n        if (ret == 0) {\n            uint64_t timeout = 640000;\n\n            ret = tls_api_wait_for_timeout(test_ctx, &simulated_time, timeout);\n\n            if (ret != 0)\n            {\n                DBG_PRINTF(\"Wait for %\" PRIu64 \"us returns %d\\n\", timeout, ret);\n            }\n        }\n        if (ret == 0) {\n            if (test_id == multipath_test_renew) {\n                ret = picoquic_renew_connection_id(test_ctx->cnx_client, 1);\n            }\n            else if (test_id == multipath_test_nat || test_id == multipath_test_nat_challenge) {\n                /* Change the client address */\n                test_ctx->client_addr_natted = test_ctx->client_addr;\n                test_ctx->client_addr_natted.sin_port += 7;\n                test_ctx->client_use_nat = 1;\n                if (test_id == multipath_test_nat_challenge) {\n                    test_ctx->cnx_client->path[0]->first_tuple->challenge_required = 1;\n                }\n            }\n            else if (test_id == multipath_test_abandon) {\n                /* Client abandons the path, causes it to be demoted. Server should follow suit. */\n                picoquic_abandon_path(test_ctx->cnx_client, 0, 0,\n                    simulated_time);\n            }\n            else if (test_id == multipath_test_break2) {\n                /* Trigger \"destination unreachable\" error on next socket call to link 1 */\n                multipath_test_set_unreachable(test_ctx, 1);\n            }\n            else if (test_id == multipath_test_back0 || test_id == multipath_test_break3) {\n                /* Trigger \"destination unreachable\" error on next socket call to link 0 */\n                multipath_test_set_unreachable(test_ctx, 0);\n            }\n            else if (test_id == multipath_test_tunnel) {\n                /* Break both links */\n                multipath_test_kill_links(test_ctx, 0);\n                multipath_test_kill_links(test_ctx, 1);\n            }\n            else if (test_id == multipath_test_break_both) {\n                /* Break both paths, program them to return socket errors */\n                multipath_test_set_unreachable(test_ctx, 0);\n                multipath_test_set_unreachable(test_ctx, 1);\n            } else {\n                multipath_test_kill_links(test_ctx, \n                    (test_id == multipath_test_drop_first ||\n                        test_id == multipath_test_standup) ? 0 : 1);\n            }\n        }\n    }\n    /* For the \"backup scenario\", wait a small interval, then bring the path # 1 back up\n     * For the \"tunnel\" scenario, do the same but wait 5 seconds and then restore both links.\n     */\n    if (ret == 0 && (test_id == multipath_test_back0 || test_id == multipath_test_back1 || test_id == multipath_test_tunnel)) {\n        uint64_t timeout = (test_id == multipath_test_tunnel)?5000000:1000000;\n\n        ret = tls_api_wait_for_timeout(test_ctx, &simulated_time, timeout);\n\n        if (ret != 0)\n        {\n            DBG_PRINTF(\"Wait for %\" PRIu64 \"us returns %d\\n\", timeout, ret);\n        }\n        else if (test_id == multipath_test_back0) {\n            multipath_test_set_reachable(test_ctx, 0);\n            \n            ret = picoquic_probe_new_path(test_ctx->cnx_client, (struct sockaddr*)&test_ctx->server_addr,\n                    (struct sockaddr*)&test_ctx->client_addr, simulated_time);\n            if (ret != 0) {\n                DBG_PRINTF(\"Create path on default address returns %d\\n\", ret);\n            }\n        }\n        else {\n            if (test_id == multipath_test_tunnel) {\n                multipath_test_unkill_links(test_ctx, 0, simulated_time);\n            }\n            multipath_test_unkill_links(test_ctx, 1, simulated_time);\n        }\n    }\n    /* In the \"abandon\" scenario, allow for a bit more than 1 second of delay for clearing of paths */\n    if (ret == 0 && test_id == multipath_test_abandon) {\n        uint64_t timeout = 1100000;\n\n        ret = tls_api_wait_for_timeout(test_ctx, &simulated_time, timeout);\n\n        if (ret != 0)\n        {\n            DBG_PRINTF(\"Wait for %\" PRIu64 \"us returns %d\\n\", timeout, ret);\n        }\n    }\n\n    /* In the datagram scenarios, trigger the datagram transmission */\n    if (ret == 0 && (test_id == multipath_test_datagram || test_id == multipath_test_dg_af)) {\n        ret = multipath_set_datagram_ready(test_ctx, &dg_ctx, test_id);\n    }\n\n    /* Perform a final data sending loop, this time to completion  */\n    if (ret == 0) { \n        if (test_id == multipath_test_datagram || test_id == multipath_test_dg_af) {\n            ret = multipath_datagram_send_loop(test_ctx, &dg_ctx, &loss_mask, &simulated_time);\n        }\n        else if (!test_ctx->test_finished ||\n            !picoquic_is_cnx_backlog_empty(test_ctx->cnx_client) ||\n            !picoquic_is_cnx_backlog_empty(test_ctx->cnx_server)){\n            ret = tls_api_data_sending_loop(test_ctx, &loss_mask, &simulated_time, 0);\n        }\n\n        if (ret != 0)\n        {","numLines":500,"startLine":600,"totalLines":2027}}}
