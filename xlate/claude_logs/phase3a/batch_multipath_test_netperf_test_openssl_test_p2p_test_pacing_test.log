{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01VDemihCKWF7ZZygeGQfEAx","type":"tool_result","content":"777\tpub struct Quic {\n778\t    /// Client-side TLS configuration (set when this `Quic` is\n779\t    /// being used to make outbound connections).  Replaces the C\n780\t    /// `tls_master_ctx` opaque handle for the client role.\n781\t    pub tls_client_config: Option<Box<dyn crate::tls::DynClientConfig>>,\n782\t    /// Server-side TLS configuration (set when this `Quic` is\n783\t    /// being used to accept inbound connections).\n784\t    pub tls_server_config: Option<Box<dyn crate::tls::DynServerConfig>>,\n785\t    /// Application-supplied TLS callbacks (ALPN selection, ticket\n786\t    /// store, certificate verification).  Replaces the C-style\n787\t    /// `register_*` global function-pointer registry.\n788\t    pub tls_callbacks: Option<Box<dyn crate::tls::TlsCallbacks>>,\n789\t    pub default_callback_fn: Option<Box<dyn StreamDataCallback>>,\n790\t    /// Application-supplied state forwarded to the default\n791\t    /// stream-data callback.  Opaque to the library (the C side\n792\t    /// passed it through as `void*`).  Phase 4 may push the state\n793\t    /// into the `StreamDataCallback` impl itself, at which point this\n794\t    /// field disappears.\n795\t    pub default_callback_ctx: Option<Box<dyn Any>>,\n796\t    /// State for the DCID-mask callbacks; opaque to the library.\n797\t    pub mask_ctx: Option<Box<dyn Any>>,\n798\t    pub mask_fns: Option<Box<dyn MaskOps>>,\n799\t    pub default_alpn: Option<String>,\n800\t    pub alpn_select_fn: Option<Box<dyn AlpnSelect>>,\n801\t    pub reset_seed: [u8; RESET_SECRET_SIZE],\n802\t    pub retry_seed: [u8; RETRY_SECRET_SIZE],\n803\t    // C `*mut u64 p_simulated_time` is gone -- the test simulator\n804\t    // owns its own clock and feeds the value through per-call\n805\t    // `current_time: Instant` parameters.\n806\t    /// Application-supplied cryptographically secure RNG.  Replaces\n807\t    /// the C `register_crypto_random_provider` global registry plus\n808\t    /// `Connection::crypto_random` / `crypto_uniform_random` /\n809\t    /// `seed_public_random` accessors.  Used for handshake nonces,\n810\t    /// connection IDs, retry-token integrity nonces, and so on.\n811\t    /// The application installs this at construction time;\n812\t    /// `rand::rngs::OsRng` (wrapped in a `Box`) is the canonical\n813\t    /// default.  Phase 4 may push it down to per-`Connection` if\n814\t    /// per-connection determinism is needed for tests.\n815\t    pub rng: Box<dyn rand::CryptoRng + Send>,\n816\t    pub hash_seed: [u8; 16],\n817\t    pub ticket_file_name: Option<PathBuf>,\n818\t    pub token_file_name: Option<PathBuf>,\n819\t    /// Cached session tickets (replaces the C `p_first_ticket`\n820\t    /// head + per-node `next_ticket` chain).\n821\t    pub stored_tickets: Vec<StoredTicket>,\n822\t    /// Cached retry tokens (replaces the C `p_first_token`\n823\t    /// head + per-node `next_token` chain).\n824\t    pub stored_tokens: Vec<StoredToken>,\n825\t    /// Replay-protection register for new-tokens / retry-tokens.\n826\t    /// Keyed by `token_hash`; values are tokens into the\n827\t    /// per-`Quic` `RegisteredToken` arena.  C: `token_reuse_tree`.\n828\t    pub token_reuse_tree: SplayTree<u64, RegisteredTokenToken>,\n829\t    /// Owning arena for [`RegisteredToken`] entries reachable\n830\t    /// through [`Self::token_reuse_tree`].\n831\t    pub registered_tokens: Arena<RegisteredToken>,\n832\t    pub local_connection_id_length: u8,\n833\t    pub default_stream_priority: u8,\n834\t    pub default_datagram_priority: u8,\n835\t    pub local_connection_id_ttl: u64,\n836\t    pub mtu_max: u32,\n837\t    pub padding_multiple_default: u32,\n838\t    pub padding_minsize_default: u32,\n839\t    pub sequence_hole_pseudo_period: u32,\n840\t    pub default_pmtud_policy: PmtudPolicy,\n841\t    pub default_spin_policy: SpinbitVersion,\n842\t    pub default_lossbit_policy: LossbitVersion,\n843\t    pub default_multipath_option: u32,\n844\t    pub default_handshake_timeout: Duration,\n845\t    pub crypto_epoch_length_max: u64,\n846\t    pub max_simultaneous_logs: u32,\n847\t    pub current_number_of_open_logs: u32,\n848\t    pub max_half_open_before_retry: u32,\n849\t    pub current_number_half_open: u32,\n850\t    pub current_number_connections: u32,\n851\t    pub tentative_max_number_connections: u32,\n852\t    pub max_number_connections: u32,\n853\t    pub stateless_reset_next_time: Instant,\n854\t    pub stateless_reset_min_interval: Duration,\n855\t    pub cwin_max: u64,\n856\t\n857\t    pub check_token: bool,\n858\t    pub force_check_token: bool,\n859\t    pub provide_token: bool,\n860\t    pub unconditional_cnx_id: bool,\n861\t    pub client_zero_share: bool,\n862\t    pub server_busy: bool,\n863\t    pub is_cert_store_not_empty: bool,\n864\t    pub use_long_log: bool,\n865\t    pub should_close_log: bool,\n866\t    pub enable_sslkeylog: bool,\n867\t    pub use_unique_log_names: bool,\n868\t    pub dont_coalesce_init: bool,\n869\t    pub one_way_grease_quic_bit: bool,\n870\t    /// Two-bit field in C (`unsigned int : 2`).  Stored as `u8`\n871\t    /// to preserve the value range (0..=3); access is direct.\n872\t    pub random_initial: u8,\n873\t    pub packet_train_mode: bool,\n874\t    pub use_constant_challenges: bool,\n875\t    pub use_low_memory: bool,\n876\t    pub is_preemptive_repeat_enabled: bool,\n877\t    pub default_send_receive_bdp_frame: bool,\n878\t    pub enforce_client_only: bool,\n879\t    pub test_large_server_flight: bool,\n880\t    pub is_port_blocking_disabled: bool,\n881\t    pub are_path_callbacks_enabled: bool,\n882\t    pub use_predictable_random: bool,\n883\t\n884\t    /// Stateless packets queued for send.  Replaces the C\n885\t    /// `pending_stateless_packet` head + per-packet `next_packet`\n886\t    /// chain.\n887\t    pub pending_stateless_packets: VecDeque<StatelessPacket>,\n888\t\n889\t    pub default_congestion_alg: Option<&'static CongestionAlgorithm>,\n890\t    pub default_congestion_alg_option_string: Option<String>,\n891\t\n892\t    /// Owning arena for every live [`Connection`] on this `Quic`.\n893\t    /// Every C `*mut picoquic_cnx_t` becomes a [`ConnectionToken`]\n894\t    /// indexing into here; the C `connection_list` / `connection_last` /\n895\t    /// `next_in_table` / `previous_in_table` doubly-linked list is\n896\t    /// gone — iterate the arena and sort on demand if order\n897\t    /// matters.\n898\t    pub connections: Arena<Connection>,\n899\t\n900\t    /// Per-connection wake-up scheduler keyed by `next_wake_time`.\n901\t    /// Splay-tree access locality matters here — the next-to-fire\n902\t    /// connection is usually adjacent to the one we just touched.\n903\t    /// C: `connection_wake_tree`.\n904\t    pub connection_wake_tree: SplayTree<u64, ConnectionToken>,\n905\t\n906\t    /// In-progress (currently being serviced) connection.  C:\n907\t    /// `*mut Connection` re-entrancy slot.\n908\t    pub connection_in_progress: Option<ConnectionToken>,\n909\t\n910\t    /// Lookup by local CID (each connection registers one CID per\n911\t    /// active path).  Phase 4 plan: the value type may end up as\n912\t    /// `LocalConnectionIdToken` rather than `ConnectionToken` once the\n913\t    /// per-path CID arena is wired up; a CID does not uniquely\n914\t    /// identify a connection — paths within a connection have\n915\t    /// distinct CIDs.  Stub assumes the simpler shape for now.\n916\t    pub connection_by_id: HashTable<ConnectionId, ConnectionToken>,\n917\t    /// Lookup by network 5-tuple.  Phase 4 plan: value is more\n918\t    /// likely `PathToken`, since the C side stored a `*mut Path`\n919\t    /// here (paths back-point to their connection).\n920\t    pub connection_by_net: HashTable<core::net::SocketAddr, ConnectionToken>,\n921\t    /// Lookup by initial connection ID (server only).\n922\t    pub connection_by_icid: HashTable<ConnectionId, ConnectionToken>,\n923\t    /// Lookup by stateless-reset secret.\n924\t    pub connection_by_secret: HashTable<[u8; RESET_SECRET_SIZE], ConnectionToken>,\n925\t\n926\t    /// Server-side: index of issued session tickets by ticket id."}]},"parent_tool_use_id":"toolu_01YHZo39opW2VepKc9W1cSdn","session_id":"dd2036ff-0dd1-48ca-b8bf-92c20dcaef2a","uuid":"07356a9a-ef78-4b56-9478-99a39835b545","timestamp":"2026-05-05T04:35:01.664Z"}
