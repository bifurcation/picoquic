n45\t *   packets on the link.\n46\t * - (TODO) simulating the coalesced receive by packing\n47\t *   consecutive packets in a receive folder, modulo \n48\t *   arrival time.\n49\t * - Getting statistics on the effectiveness of the\n50\t *   coalescing process.\n51\t */\n52\tint netperf_next_arrival(picoquictest_sim_link_t * link, picoquic_quic_t * quic, uint64_t simulated_time, int* was_active,\n53\t    struct sockaddr * srce_addr)\n54\t{\n55\t    /* TODO: simulate accumulating packets when queue building up at receiver. */\n56\t    int ret = 0;\n57\t\n58\t    /* If there is something to receive, do it now */\n59\t    picoquictest_sim_packet_t* packet = picoquictest_sim_link_dequeue(link, simulated_time);\n60\t\n61\t    if (packet != NULL) {\n62\t        *was_active = 1;\n63\t\n64\t        if (packet->addr_from.ss_family == 0) {\n65\t            picoquic_store_addr(&packet->addr_from, srce_addr);\n66\t        }\n67\t\n68\t        ret = picoquic_incoming_packet(quic, packet->bytes, (uint32_t)packet->length,\n69\t            (struct sockaddr*) & packet->addr_from,\n70\t            (struct sockaddr*) & packet->addr_to, 0, 0, simulated_time);\n71\t\n72\t        if (ret != 0)\n73\t        {\n74\t            /* useless test, but makes it easier to add a breakpoint under debugger */\n75\t            ret = -1;\n76\t        }\n77\t\n78\t        free(packet);\n79\t    }\n80\t\n81\t    return ret;\n82\t}\n83\t\n84\tint netperf_next_departure(picoquic_quic_t* quic, picoquictest_sim_link_t* target_link, uint64_t simulated_time, int* was_active,\n85\t    uint8_t* send_buffer, size_t send_buffer_size)\n86\t{\n87\t    int ret = 0;\n88\t    int if_index = 0;\n89\t    picoquic_connection_id_t log_cid;\n90\t    picoquic_cnx_t * last_cnx = NULL;\n91\t    picoquictest_sim_packet_t* packet = picoquictest_sim_link_create_packet();\n92\t\n93\t    if (packet == NULL) {\n94\t        ret = -1;\n95\t    }\n96\t    else  if (send_buffer == NULL) {\n97\t        ret = picoquic_prepare_next_packet(quic, simulated_time,\n98\t            packet->bytes, PICOQUIC_MAX_PACKET_SIZE, &packet->length,\n99\t            &packet->addr_to, &packet->addr_from, &if_index, &log_cid, &last_cnx);\n100\t        /* TODO: simulate losses. */\n101\t        if (packet->length > 0) {\n102\t            *was_active = 1;\n103\t            picoquictest_sim_link_submit(target_link, packet, simulated_time);\n104\t            packet = NULL;\n105\t        }\n106\t    }\n107\t    else {\n108\t        /* Try coalescing multiple packets */\n109\t        size_t send_length = 0;\n110\t        size_t send_msg_size = 0;\n111\t        size_t sent_so_far = 0;\n112\t\n113\t        ret = picoquic_prepare_next_packet_ex(quic, simulated_time,\n114\t            send_buffer, send_buffer_size, &send_length,\n115\t            &packet->addr_to, &packet->addr_from, &if_index, &log_cid, &last_cnx, &send_msg_size);\n116\t\n117\t        if (send_msg_size > PICOQUIC_MAX_PACKET_SIZE ||\n118\t            send_length > send_buffer_size) {\n119\t            ret = -1;\n120\t        }\n121\t\n122\t        while (ret == 0 && send_msg_size > 0 && sent_so_far + send_msg_size < send_length) {\n123\t            picoquictest_sim_packet_t* coal_packet = picoquictest_sim_link_create_packet();\n124\t            if (coal_packet == NULL) {\n125\t                ret = -1;\n126\t            }\n127\t            else {\n128\t                *was_active = 1;\n129\t                picoquic_store_addr(&coal_packet->addr_from, (struct sockaddr*) & packet->addr_from);\n130\t                picoquic_store_addr(&coal_packet->addr_to, (struct sockaddr*) & packet->addr_to);\n131\t                coal_packet->length = send_msg_size;\n132\t                memcpy(coal_packet->bytes, send_buffer + sent_so_far, send_msg_size);\n133\t                sent_so_far += coal_packet->length;\n134\t                picoquictest_sim_link_submit(target_link, coal_packet, simulated_time);\n135\t            }\n136\t        }\n137\t\n138\t        if (ret == 0 && sent_so_far < send_length) {\n139\t            packet->length = send_length - sent_so_far;\n140\t            *was_active = 1;\n141\t            memcpy(packet->bytes, send_buffer + sent_so_far, packet->length);\n142\t            picoquictest_sim_link_submit(target_link, packet, simulated_time);\n143\t            packet = NULL;\n144\t        }\n145\t    }\n146\t\n147\t    if (packet != NULL) {\n148\t        free(packet);\n149\t    }\n150\t\n151\t    return ret;\n152\t}\n153\t\n154\tint netperf_step(picoquic_test_tls_api_ctx_t* test_ctx, uint64_t * simulated_time, int * was_active,\n155\t    uint8_t * send_buffer, size_t send_buffer_size)\n156\t{\n157\t    int ret = 0;\n158\t    int next_action = -1;\n159\t    uint64_t next_time = UINT64_MAX;\n160\t    uint64_t action_time;\n161\t\n162\t    *was_active = 0;\n163\t\n164\t    if ((action_time = picoquictest_sim_link_next_arrival(test_ctx->s_to_c_link, next_time)) < next_time) {\n165\t        next_action = 0;\n166\t        next_time = action_time;\n167\t    }\n168\t\n169\t    if ((action_time = picoquictest_sim_link_next_arrival(test_ctx->c_to_s_link, next_time)) < next_time) {\n170\t        next_action = 1;\n171\t        next_time = action_time;\n172\t    }\n173\t\n174\t    if ((action_time = picoquic_get_next_wake_time(test_ctx->qclient, *simulated_time)) < next_time) {\n175\t        next_action = 2;\n176\t        next_time = action_time;\n177\t    }\n178\t\n179\t    if ((action_time = picoquic_get_next_wake_time(test_ctx->qserver, *simulated_time)) < next_time) {\n180\t        next_action = 3;\n181\t        next_time = action_time;\n182\t    }\n183\t\n184\t    if (next_time == UINT64_MAX) {\n185\t        /* No more action possible */\n186\t        ret = -1;\n187\t    }\n188\t    else {\n189\t        if (next_time > *simulated_time) {\n190\t            *simulated_time = next_time;\n191\t        }\n192\t\n193\t        switch (next_action) {\n194\t        case 0:\n195\t            ret = netperf_next_arrival(test_ctx->s_to_c_link, test_ctx->qclient, *simulated_time, was_active,\n196\t                (struct sockaddr *)&test_ctx->server_addr);\n197\t            break;\n198\t        case 1:\n199\t            ret = netperf_next_arrival(test_ctx->c_to_s_link, test_ctx->qserver, *simulated_time, was_active,\n200\t                (struct sockaddr*) & test_ctx->client_addr);\n201\t            if (test_ctx->cnx_server == NULL) {\n202\t                test_ctx->cnx_server = test_ctx->qserver->cnx_list;\n203\t            }\n204\t            break;\n205\t        case 2:\n206\t            ret = netperf_next_departure(test_ctx->qclient, test_ctx->c_to_s_link, *simulated_time, was_active, send_buffer, send_buffer_size);\n207\t            break;\n208\t        case 3:\n209\t            ret = netperf_next_departure(test_ctx->qserver, test_ctx->s_to_c_link, *simulated_time, was_active, send_buffer, send_buffer_size);\n210\t            break;\n211\t        default:\n212\t            ret = -1;\n213\t            break;\n214\t        }\n215\t    }\n216\t\n217\t    return ret;\n218\t}\n219\t\n220\t/* Connection loop with large packets */\n221\tint netperf_connection_loop(picoquic_test_tls_api_ctx_t* test_ctx,\n222\t    uint64_t* loss_mask, uint64_t queue_delay_max, uint64_t* simulated_time,\n223\t    uint8_t* send_buffer, size_t send_buffer_size)\n224\t{\n225\t    int ret = 0;\n226\t    int nb_trials = 0;\n227\t    int nb_inactive = 0;\n228\t\n229\t    test_ctx->c_to_s_link->loss_mask = loss_mask;\n230\t    test_ctx->s_to_c_link->loss_mask = loss_mask;\n231\t\n232\t    test_ctx->c_to_s_link->queue_delay_max = queue_delay_max;\n233\t    test_ctx->s_to_c_link->queue_delay_max = queue_delay_max;\n234\t\n235\t    while (ret == 0 && nb_trials < 1024 && nb_inactive < 512 && (!TEST_CLIENT_READY || (test_ctx->cnx_server == NULL || !TEST_SERVER_READY))) {\n236\t        int was_active = 0;\n237\t        nb_trials++;\n238\t\n239\t        ret = netperf_step(test_ctx, simulated_time, &was_active, send_buffer, send_buffer_size);\n240\t\n241\t        if (test_ctx->cnx_client->cnx_state == picoquic_state_disconnected &&\n242\t            (test_ctx->cnx_server == NULL || test_ctx->cnx_server->cnx_state == picoquic_state_disconnected)) {\n243\t            break;\n244\t        }\n245\t\n246\t        if (nb_trials == 512) {\n247\t            DBG_PRINTF(\"After %d trials, client state = %d, server state = %d\",\n248\t                nb_trials, (int)test_ctx->cnx_client->cnx_state,\n249\t                (test_ctx->cnx_server == NULL) ? -1 : test_ctx->cnx_server->cnx_state);\n250\t        }\n251\t\n252\t        if (was_active) {\n253\t            nb_inactive = 0;\n254\t        }\n255\t        else {\n256\t            nb_inactive++;\n257\t        }\n258\t    }\n259\t\n260\t    return ret;\n261\t}\n262\t\n263\tint netperf_scenario_body_connect(picoquic_test_tls_api_ctx_t* test_ctx,\n264\t    uint64_t* simulated_time, uint64_t max_data, uint64_t queue_delay_max,\n265\t    uint8_t* send_buffer, size_t send_buffer_size)\n266\t{\n267\t    uint64_t loss_mask = 0;\n268\t    int ret = picoquic_start_client_cnx(test_ctx->cnx_client);\n269\t\n270\t    if (ret != 0)\n271\t    {\n272\t        DBG_PRINTF(\"%s\", \"Could not initialize connection for the client\\n\");\n273\t    }\n274\t    else {\n275\t        ret = netperf_connection_loop(test_ctx, &loss_mask, queue_delay_max, simulated_time, send_buffer, send_buffer_size);\n276\t\n277\t        if (ret != 0)\n278\t        {\n279\t            DBG_PRINTF(\"Connection loop returns error %d\\n\", ret);\n280\t        }\n281\t    }\n282\t\n283\t    if (ret == 0 && max_data != 0) {\n284\t        test_ctx->cnx_client->maxdata_local = max_data;\n285\t        test_ctx->cnx_client->maxdata_remote = max_data;\n286\t        test_ctx->cnx_server->maxdata_local = max_data;\n287\t        test_ctx->cnx_server->maxdata_remote = max_data;\n288\t    }\n289\t\n290\t    return ret;\n291\t}\n292\t\n293\tint netperf_data_sending_loop(picoquic_test_tls_api_ctx_t* test_ctx,\n294\t    uint64_t* loss_mask, uint64_t* simulated_time, int max_trials,\n295\t    uint8_t* send_buffer, size_t send_buffer_size)\n296\t{\n297\t    int ret = 0;\n298\t    int nb_trials = 0;\n299\t    int nb_inactive = 0;\n300\t\n301\t    test_ctx->c_to_s_link->loss_mask = loss_mask;\n302\t    test_ctx->s_to_c_link->loss_mask = loss_mask;\n303\t\n304\t    if (max_trials <= 0) {\n305\t        max_trials = 4000000;\n306\t    }\n307\t\n308\t    while (ret == 0 && nb_trials < max_trials && nb_inactive < 256 && TEST_CLIENT_READY && TEST_SERVER_READY) {\n309\t        int was_active = 0;\n310\t\n311\t        nb_trials++;\n312\t\n313\t        ret = netperf_step(test_ctx, simulated_time, &was_active, send_buffer, send_buffer_size);\n314\t\n315\t        if (ret < 0)\n316\t        {\n317\t            break;\n318\t        }\n319\t\n320\t        if (was_active) {\n321\t            nb_inactive = 0;\n322\t        }\n323\t        else {\n324\t            nb_inactive++;\n325\t        }\n326\t\n327\t        if (test_ctx->test_finished) {\n328\t            if (picoquic_is_cnx_backlog_empty(test_ctx->cnx_client) && picoquic_is_cnx_backlog_empty(test_ctx->cnx_server)) {\n329\t                break;\n330\t            }\n331\t        }\n332\t    }\n333\t\n334\t    return ret; /* end of sending loop */\n335\t}\n336\t\n337\tstatic int netperf_attempt_to_close(\n338\t    picoquic_test_tls_api_ctx_t* test_ctx, uint64_t* simulated_time,\n339\t    uint8_t* send_buffer, size_t send_buffer_size)\n340\t{\n341\t    int ret = 0;\n342\t    int nb_rounds = 0;\n343\t\n344\t    ret = picoquic_close(test_ctx->cnx_client, 0);\n345\t\n346\t    if (ret == 0) {\n347\t        /* packet from client to server */\n348\t        /* Do not simulate losses there, as there is no way to correct them */\n349\t\n350\t        test_ctx->c_to_s_link->loss_mask = 0;\n351\t        test_ctx->s_to_c_link->loss_mask = 0;\n352\t\n353\t        while (ret == 0 && (test_ctx->cnx_client->cnx_state != picoquic_state_disconnected || test_ctx->cnx_server->cnx_state != picoquic_state_disconnected) && nb_rounds < 100000) {\n354\t            int was_active = 0;\n355\t            ret = netperf_step(test_ctx, simulated_time, &was_active, send_buffer, send_buffer_size);\n356\t            nb_rounds++;\n357\t        }\n358\t    }\n359\t\n360\t    if (ret == 0 && (test_ctx->cnx_client->cnx_state != picoquic_state_disconnected || test_ctx->cnx_server->cnx_state != picoquic_state_disconnected)) {\n361\t        ret = -1;\n362\t    }\n363\t\n364\t    return ret;\n365\t}\n366\t\n367\t/* Test a connection scenario, using large send buffers */\n368\tint netperf_one_scenario(test_api_stream_desc_t* scenario,\n369\t    size_t sizeof_scenario, picoquic_congestion_algorithm_t * cc_algo, size_t stream0_target,\n370\t    uint64_t init_loss_mask, uint64_t max_data, uint64_t queue_delay_max,\n371\t    uint32_t proposed_version, uint64_t max_completion_microsec,\n372\t    picoquic_tp_t* client_params, picoquic_tp_t* server_params,\n373\t    size_t send_buffer_size)\n374\t{\n375\t    uint64_t simulated_time = 0;\n376\t    uint64_t loss_mask;\n377\t    picoquic_test_tls_api_ctx_t* test_ctx = NULL;\n378\t    uint8_t* send_buffer = NULL;\n379\t\n380\t    int ret = tls_api_one_scenario_init(&test_ctx, &simulated_time,\n381\t        proposed_version, client_params, server_params);\n382\t\n383\t    if (ret == 0 && send_buffer_size > 0) {\n384\t        send_buffer = (uint8_t*)malloc(send_buffer_size);\n385\t        if (send_buffer == 0) {\n386\t            ret = -1;\n387\t        }\n388\t    }\n389\t\n390\t    if (ret == 0 && cc_algo != NULL) {\n391\t        test_ctx->qserver->padding_multiple_default = 128;\n392\t        test_ctx->qclient->padding_multiple_default = 128;\n393\t        picoquic_set_packet_train_mode(test_ctx->qserver, 1);\n394\t        picoquic_set_packet_train_mode(test_ctx->qclient, 1);\n395\t        picoquic_set_default_congestion_algorithm(test_ctx->qserver, cc_algo);\n396\t        picoquic_set_congestion_algorithm(test_ctx->cnx_client, cc_algo);\n397\t    }\n398\t\n399\t    if (ret == 0) {\n400\t        ret = netperf_scenario_body_connect(test_ctx, &simulated_time,\n401\t            max_data, queue_delay_max, send_buffer, send_buffer_size);\n402\t\n403\t        /* Prepare to send data */\n404\t        if (ret == 0) {\n405\t            test_ctx->stream0_target = stream0_target;\n406\t            loss_mask = init_loss_mask;\n407\t            ret = test_api_init_send_recv_scenario(test_ctx, scenario, sizeof_scenario);\n408\t\n409\t            if (ret != 0)\n410\t            {\n411\t                DBG_PRINTF(\"Init send receive scenario returns %d\\n\", ret);\n412\t            }\n413\t        }\n414\t\n415\t        /* Perform a data sending loop */\n416\t        if (ret == 0) {\n417\t            ret = netperf_data_sending_loop(test_ctx, &loss_mask, &simulated_time, 0, send_buffer, send_buffer_size);\n418\t\n419\t            if (ret != 0)\n420\t            {\n421\t                DBG_PRINTF(\"Data sending loop returns %d\\n\", ret);\n422\t            }\n423\t        }\n424\t\n425\t        if (ret == 0) {\n426\t            uint64_t close_time = 0;\n427\t            ret = tls_api_one_scenario_verify(test_ctx);\n428\t\n429\t            if (ret == 0) {\n430\t                if (test_ctx->cnx_server == NULL) {\n431\t                    DBG_PRINTF(\"%s\", \"Cannot check server stats\\n\");\n432\t                    ret = -1;\n433\t                }\n434\t                else if ((3* test_ctx->cnx_server->nb_trains_sent)/2 > test_ctx->cnx_server->nb_packets_sent) {\n435\t                    DBG_PRINTF(\"Datagram coalescing fails, %\" PRIu64 \" trains for %\" PRIu64 \"packets\\n\",\n436\t                        test_ctx->cnx_server->nb_trains_sent, test_ctx->cnx_server->nb_packets_sent);\n437\t                    ret = -1;\n438\t                }\n439\t                else if (20 * test_ctx->cnx_server->nb_retransmission_total > test_ctx->cnx_server->nb_packets_sent) {\n440\t                    DBG_PRINTF(\"Too many losses, %\" PRIu64 \" losses for %\" PRIu64 \"packets\\n\",\n441\t                        test_ctx->cnx_server->nb_retransmission_total, test_ctx->cnx_server->nb_packets_sent);\n442\t                    ret = -1;\n443\t\n444\t                }\n445\t            }\n446\t\n447\t            if (ret == 0) {\n448\t                close_time = simulated_time;\n449\t                netperf_attempt_to_close(test_ctx, &simulated_time, send_buffer, send_buffer_size);\n450\t                if (ret != 0)\n451\t                {\n452\t                    DBG_PRINTF(\"Attempt to close returns %d\\n\", ret);\n453\t                }\n454\t            }\n455\t\n456\t            if (ret == 0 && max_completion_microsec != 0) {\n457\t                uint64_t completion_time = close_time - test_ctx->cnx_client->start_time;\n458\t                if (completion_time > max_completion_microsec)\n459\t                {\n460\t                    DBG_PRINTF(\"Scenario completes in %llu microsec, more than %llu\\n\",\n461\t                        (unsigned long long)completion_time, (unsigned long long)max_completion_microsec);\n462\t                    ret = -1;\n463\t                }\n464\t            }\n465\t        }\n466\t    }\n467\t\n468\t    if (send_buffer != NULL) {\n469\t        free(send_buffer);\n470\t    }\n471\t\n472\t    if (test_ctx != NULL) {\n473\t        tls_api_delete_ctx(test_ctx);\n474\t        test_ctx = NULL;\n475\t    }\n476\t\n477\t    return ret;\n478\t}\n479\t\n480\tstatic test_api_stream_desc_t netperf_scenario_basic[] = {\n481\t    { 4, 0, 257, 1000000 }\n482\t};\n483\t\n484\tint netperf_basic_test(void)\n485\t{\n486\t    int ret = netperf_one_scenario(netperf_scenario_basic, sizeof(netperf_scenario_basic),\n487\t        NULL,\n488\t        0, 0, 0, 0, 0, 1000000, NULL, NULL, 10 * PICOQUIC_MAX_PACKET_SIZE);\n489\t\n490\t    return ret;\n491\t}\n492\t\n493\tint netperf_bbr_test(void)\n494\t{\n495\t    int ret = netperf_one_scenario(netperf_scenario_basic, sizeof(netperf_scenario_basic),\n496\t        picoquic_bbr_algorithm,\n497\t        0, 0, 0, 0, 0, 1000000, NULL, NULL, 10 * PICOQUIC_MAX_PACKET_SIZE);\n498\t\n499\t    return ret;\n500\t}\n501\t\n502\t\n503\t\n504\t/* Address natting stress.\n505\t * The attacker has the capability to intercept traffic and rewrite addresses.\n506\t * It waits for a client to start a connection, and then keeps changing the\n507\t * \"source IP\" that appears in the client's packets. The test verifies simply that\n508\t * the server remains functional.\n509\t */\n510\t\n511\tvoid natattack_port_rewrite(struct sockaddr_storage* addr, struct sockaddr* ref, uint16_t offset)\n512\t{\n513\t    if (addr->ss_family == AF_INET) {\n514\t        ((struct sockaddr_in*)addr)->sin_port = ((struct sockaddr_in*)ref)->sin_port + offset;\n515\t    }\n516\t    else if (addr->ss_family == AF_INET6) {\n517\t        ((struct sockaddr_in6*)addr)->sin6_port = ((struct sockaddr_in6*)ref)->sin6_port + offset;\n518\t    }\n519\t}\n520\t\n521\tint nat_attack_loop_step(picoquic_test_tls_api_ctx_t* test_ctx, uint64_t* simulated_time, int* was_active,\n522\t    uint8_t* send_buffer, size_t send_buffer_size, int nb_loops, int do_attack)\n523\t{\n524\t    int ret = 0;\n525\t    int next_action = -1;\n526\t    uint64_t next_time = UINT64_MAX;\n527\t    uint64_t action_time;\n528\t\n529\t    *was_active = 0;\n530\t\n531\t    if ((action_time = picoquictest_sim_link_next_arrival(test_ctx->s_to_c_link, next_time)) < next_time) {\n532\t        next_action = 0;\n533\t        next_time = action_time;\n534\t    }\n535\t\n536\t    if ((action_time = picoquictest_sim_link_next_arrival(test_ctx->c_to_s_link, next_time)) < next_time) {\n537\t        next_action = 1;\n538\t        next_time = action_time;\n539\t    }\n540\t\n541\t    if ((action_time = picoquic_get_next_wake_time(test_ctx->qclient, *simulated_time)) < next_time) {\n542\t        next_action = 2;\n543\t        next_time = action_time;\n544\t    }\n545\t\n546\t    if ((action_time = picoquic_get_next_wake_time(test_ctx->qserver, *simulated_time)) < next_time) {\n547\t        next_action = 3;\n548\t        next_time = action_time;\n549\t    }\n550\t\n551\t    if (next_time == UINT64_MAX) {\n552\t        /* No more action possible */\n553\t        ret = -1;\n554\t    }\n555\t    else {\n556\t        if (next_time > * simulated_time) {\n557\t            *simulated_time = next_time;\n558\t        }\n559\t\n560\t        switch (next_action) {\n561\t        case 0:\n562\t            /* rewrite destination address to client address, simulating NAT */\n563\t            if (test_ctx->s_to_c_link->first_packet != NULL && do_attack) {\n564\t                picoquic_store_addr(&test_ctx->s_to_c_link->first_packet->addr_to,\n565\t                    (struct sockaddr*) & test_ctx->client_addr);\n566\t            }\n567\t            ret = netperf_next_arrival(test_ctx->s_to_c_link, test_ctx->qclient, *simulated_time, was_active,\n568\t                (struct sockaddr*) & test_ctx->server_addr);\n569\t            break;\n570\t        case 1:\n571\t            /* Randomize client address, simulating broken NAT */\n572\t            if (test_ctx->c_to_s_link->first_packet != NULL && do_attack) {\n573\t                natattack_port_rewrite(&test_ctx->c_to_s_link->first_packet->addr_from,\n574\t                    (struct sockaddr*) & test_ctx->client_addr, (uint16_t)nb_loops);\n575\t            }\n576\t            ret = netperf_next_arrival(test_ctx->c_to_s_link, test_ctx->qserver, *simulated_time, was_active,\n577\t                (struct sockaddr*) & test_ctx->client_addr);\n578\t            if (test_ctx->cnx_server == NULL) {\n579\t                test_ctx->cnx_server = test_ctx->qserver->cnx_list;\n580\t            }\n581\t            break;\n582\t        case 2:\n583\t            ret = netperf_next_departure(test_ctx->qclient, test_ctx->c_to_s_link, *simulated_time, was_active, send_buffer, send_buffer_size);\n584\t            break;\n585\t        case 3:\n586\t            ret = netperf_next_departure(test_ctx->qserver, test_ctx->s_to_c_link, *simulated_time, was_active, send_buffer, send_buffer_size);\n587\t            break;\n588\t        default:\n589\t            ret = -1;\n590\t            break;\n591\t        }\n592\t    }\n593\t\n594\t    return ret;\n595\t}\n596\t\n597\tint nat_attack_loop(picoquic_test_tls_api_ctx_t* test_ctx, uint64_t * simulated_time, \n598\t    uint8_t * send_buffer, size_t send_buffer_size, int do_attack)\n599\t{\n600\t    int ret = 0;\n601\t    int was_active = 0;\n602\t    int nb_loops = 0;\n603\t    int nb_inactive = 0;\n604\t\n605\t    /* Run a simplified simulation */\n606\t    while (ret == 0 && test_ctx->cnx_client != NULL && test_ctx->cnx_client->cnx_state != picoquic_state_disconnected)\n607\t    {\n608\t        ret = nat_attack_loop_step(test_ctx, simulated_time, &was_active, send_buffer, send_buffer_size, nb_loops, do_attack);\n609\t        if (was_active) {\n610\t            nb_inactive = 0;\n611\t        }\n612\t        else {\n613\t            nb_inactive++;\n614\t            if (nb_inactive > 64) {\n615\t                DBG_PRINTF(\"Loop appears stuck, nb_inactive = %d\", nb_inactive);\n616\t                ret = -1;\n617\t                break;\n618\t            }\n619\t        }\n620\t        nb_loops++;\n621\t        if (nb_loops > 100000) {\n622\t            DBG_PRINTF(\"Too many loops %d\", nb_loops);\n623\t            ret = -1;\n624\t            break;\n625\t        }\n626\t        if (ret != 0) {\n627\t            break;\n628\t        }\n629\t\n630\t        if (test_ctx->test_finished) {\n631\t            if (picoquic_is_cnx_backlog_empty(test_ctx->cnx_client) && test_ctx->cnx_server != NULL &&\n632\t                picoquic_is_cnx_backlog_empty(test_ctx->cnx_server)) {\n633\t                break;\n634\t            }\n635\t        }\n636\t    }\n637\t\n638\t    return ret;\n639\t}\n640\t\n641\tstatic test_api_stream_desc_t nat_attack_scenario[] = {\n642\t    { 4, 0, 256000, 1000000 },\n643\t    { 8, 0, 256000, 1000000 },\n644\t    { 12, 0, 256000, 1000000 },\n645\t    { 16, 0, 256000, 1000000 },\n646\t    { 20, 0, 256000, 1000000 },\n647\t    { 24, 0, 256000, 1000000 },\n648\t    { 28, 0, 256000, 1000000 },\n649\t    { 32, 0, 256000, 1000000 }\n650\t};\n651\t\n652\tint nat_attack_test(void)\n653\t{\n654\t    /* Create a connection context */\n655\t    uint64_t simulated_time = 0;\n656\t    picoquic_test_tls_api_ctx_t* test_ctx = NULL;\n657\t    uint8_t* send_buffer = NULL;\n658\t    size_t send_buffer_size = PICOQUIC_MAX_PACKET_SIZE;\n659\t    int ret = tls_api_one_scenario_init(&test_ctx, &simulated_time, PICOQUIC_INTERNAL_TEST_VERSION_1, NULL, NULL);\n660\t\n661\t    if (ret == 0 && test_ctx == NULL) {\n662\t        ret = -1;\n663\t    }\n664\t\n665\t    if (ret == 0 && send_buffer_size > 0) {\n666\t        send_buffer = (uint8_t*)malloc(send_buffer_size);\n667\t        if (send_buffer == 0) {\n668\t            ret = -1;\n669\t        }\n670\t    }\n671\t\n672\t    if (ret == 0)\n673\t    {\n674\t        ret = picoquic_start_client_cnx(test_ctx->cnx_client);\n675\t    }\n676\t\n677\t    if (ret == 0) {\n678\t        ret = test_api_init_send_recv_scenario(test_ctx, nat_attack_scenario, sizeof(nat_attack_scenario));\n679\t    }\n680\t\n681\t    /* Run a simplified simulation */\n682\t    if (ret == 0) {\n683\t        ret = nat_attack_loop(test_ctx, &simulated_time, send_buffer, send_buffer_size, 1);\n684\t    }\n685\t\n686\t    /* If the client connection is still up, verify that data was properly received. */\n687\t    if (ret == 0 && test_ctx->cnx_client->cnx_state == picoquic_state_ready) {\n688\t        ret = tls_api_one_scenario_verify(test_ctx);\n689\t    }\n690\t\n691\t    if (ret == 0) {\n692\t        DBG_PRINTF(\"Exit attack loop at time %\" PRIu64 \", received %\" PRIu64 \" packets at client.\",\n693\t            simulated_time, test_ctx->cnx_client->nb_packets_received);\n694\t    }\n695\t\n696\t    if (send_buffer != NULL) {\n697\t        free(send_buffer);\n698\t    }\n699\t\n700\t    if (test_ctx != NULL) {\n701\t        tls_api_delete_ctx(test_ctx);\n702\t        test_ctx = NULL;\n703\t    }\n704\t\n705\t    return ret;\n706\t}\n707\t"}]},"parent_tool_use_id":null,"session_id":"dd2036ff-0dd1-48ca-b8bf-92c20dcaef2a","uuid":"e5911aec-dfdf-4a4d-9299-915f73d49835","timestamp":"2026-05-05T04:10:08.237Z","tool_use_result":{"type":"text","file":{"filePath":"/Users/richbarn/Projects/picoquic/picoquictest/netperf_test.c","content":"/*\n* Author: Christian Huitema\n* Copyright (c) 2020, Private Octopus, Inc.\n* All rights reserved.\n*\n* Permission to use, copy, modify, and distribute this software for any\n* purpose with or without fee is hereby granted, provided that the above\n* copyright notice and this permission notice appear in all copies.\n*\n* THIS SOFTWARE IS PROVIDED BY THE COPYRIGHT HOLDERS AND CONTRIBUTORS \"AS IS\" AND\n* ANY EXPRESS OR IMPLIED WARRANTIES, INCLUDING, BUT NOT LIMITED TO, THE IMPLIED\n* WARRANTIES OF MERCHANTABILITY AND FITNESS FOR A PARTICULAR PURPOSE ARE\n* DISCLAIMED. IN NO EVENT SHALL Private Octopus, Inc. BE LIABLE FOR ANY\n* DIRECT, INDIRECT, INCIDENTAL, SPECIAL, EXEMPLARY, OR CONSEQUENTIAL DAMAGES\n* (INCLUDING, BUT NOT LIMITED TO, PROCUREMENT OF SUBSTITUTE GOODS OR SERVICES;\n* LOSS OF USE, DATA, OR PROFITS; OR BUSINESS INTERRUPTION) HOWEVER CAUSED AND\n* ON ANY THEORY OF LIABILITY, WHETHER IN CONTRACT, STRICT LIABILITY, OR TORT\n* (INCLUDING NEGLIGENCE OR OTHERWISE) ARISING IN ANY WAY OUT OF THE USE OF THIS\n* SOFTWARE, EVEN IF ADVISED OF THE POSSIBILITY OF SUCH DAMAGE.\n*/\n\n#include <stddef.h>\n#include <stdlib.h>\n#include <string.h>\n#include <stdint.h>\n#ifdef _WINDOWS\n#include \"wincompat.h\"\n#include \"ws2ipdef.h\"\n#pragma warning(disable:4100)\n#else\n#include <signal.h>\n#endif\n#include <picotls.h>\n#include \"picoquic.h\"\n#include \"picoquic_utils.h\"\n#include \"picoquic_internal.h\"\n#include \"tls_api.h\"\n#include \"picoquictest_internal.h\"\n#include \"picoquic_bbr.h\"\n\n/* Test the coalesced Send API.\n * The simulation here involves:\n * - simulating the coalesced send implementation,\n * - filing each of the cooalesced packets as separate \n *   packets on the link.\n * - (TODO) simulating the coalesced receive by packing\n *   consecutive packets in a receive folder, modulo \n *   arrival time.\n * - Getting statistics on the effectiveness of the\n *   coalescing process.\n */\nint netperf_next_arrival(picoquictest_sim_link_t * link, picoquic_quic_t * quic, uint64_t simulated_time, int* was_active,\n    struct sockaddr * srce_addr)\n{\n    /* TODO: simulate accumulating packets when queue building up at receiver. */\n    int ret = 0;\n\n    /* If there is something to receive, do it now */\n    picoquictest_sim_packet_t* packet = picoquictest_sim_link_dequeue(link, simulated_time);\n\n    if (packet != NULL) {\n        *was_active = 1;\n\n        if (packet->addr_from.ss_family == 0) {\n            picoquic_store_addr(&packet->addr_from, srce_addr);\n        }\n\n        ret = picoquic_incoming_packet(quic, packet->bytes, (uint32_t)packet->length,\n            (struct sockaddr*) & packet->addr_from,\n            (struct sockaddr*) & packet->addr_to, 0, 0, simulated_time);\n\n        if (ret != 0)\n        {\n            /* useless test, but makes it easier to add a breakpoint under debugger */\n            ret = -1;\n        }\n\n        free(packet);\n    }\n\n    return ret;\n}\n\nint netperf_next_departure(picoquic_quic_t* quic, picoquictest_sim_link_t* target_link, uint64_t simulated_time, int* was_active,\n    uint8_t* send_buffer, size_t send_buffer_size)\n{\n    int ret = 0;\n    int if_index = 0;\n    picoquic_connection_id_t log_cid;\n    picoquic_cnx_t * last_cnx = NULL;\n    picoquictest_sim_packet_t* packet = picoquictest_sim_link_create_packet();\n\n    if (packet == NULL) {\n        ret = -1;\n    }\n    else  if (send_buffer == NULL) {\n        ret = picoquic_prepare_next_packet(quic, simulated_time,\n            packet->bytes, PICOQUIC_MAX_PACKET_SIZE, &packet->length,\n            &packet->addr_to, &packet->addr_from, &if_index, &log_cid, &last_cnx);\n        /* TODO: simulate losses. */\n        if (packet->length > 0) {\n            *was_active = 1;\n            picoquictest_sim_link_submit(target_link, packet, simulated_time);\n            packet = NULL;\n        }\n    }\n    else {\n        /* Try coalescing multiple packets */\n        size_t send_length = 0;\n        size_t send_msg_size = 0;\n        size_t sent_so_far = 0;\n\n        ret = picoquic_prepare_next_packet_ex(quic, simulated_time,\n            send_buffer, send_buffer_size, &send_length,\n            &packet->addr_to, &packet->addr_from, &if_index, &log_cid, &last_cnx, &send_msg_size);\n\n        if (send_msg_size > PICOQUIC_MAX_PACKET_SIZE ||\n            send_length > send_buffer_size) {\n            ret = -1;\n        }\n\n        while (ret == 0 && send_msg_size > 0 && sent_so_far + send_msg_size < send_length) {\n            picoquictest_sim_packet_t* coal_packet = picoquictest_sim_link_create_packet();\n            if (coal_packet == NULL) {\n                ret = -1;\n            }\n            else {\n                *was_active = 1;\n                picoquic_store_addr(&coal_packet->addr_from, (struct sockaddr*) & packet->addr_from);\n                picoquic_store_addr(&coal_packet->addr_to, (struct sockaddr*) & packet->addr_to);\n                coal_packet->length = send_msg_size;\n                memcpy(coal_packet->bytes, send_buffer + sent_so_far, send_msg_size);\n                sent_so_far += coal_packet->length;\n                picoquictest_sim_link_submit(target_link, coal_packet, simulated_time);\n            }\n        }\n\n        if (ret == 0 && sent_so_far < send_length) {\n            packet->length = send_length - sent_so_far;\n            *was_active = 1;\n            memcpy(packet->bytes, send_buffer + sent_so_far, packet->length);\n            picoquictest_sim_link_submit(target_link, packet, simulated_time);\n            packet = NULL;\n        }\n    }\n\n    if (packet != NULL) {\n        free(packet);\n    }\n\n    return ret;\n}\n\nint netperf_step(picoquic_test_tls_api_ctx_t* test_ctx, uint64_t * simulated_time, int * was_active,\n    uint8_t * send_buffer, size_t send_buffer_size)\n{\n    int ret = 0;\n    int next_action = -1;\n    uint64_t next_time = UINT64_MAX;\n    uint64_t action_time;\n\n    *was_active = 0;\n\n    if ((action_time = picoquictest_sim_link_next_arrival(test_ctx->s_to_c_link, next_time)) < next_time) {\n        next_action = 0;\n        next_time = action_time;\n    }\n\n    if ((action_time = picoquictest_sim_link_next_arrival(test_ctx->c_to_s_link, next_time)) < next_time) {\n        next_action = 1;\n        next_time = action_time;\n    }\n\n    if ((action_time = picoquic_get_next_wake_time(test_ctx->qclient, *simulated_time)) < next_time) {\n        next_action = 2;\n        next_time = action_time;\n    }\n\n    if ((action_time = picoquic_get_next_wake_time(test_ctx->qserver, *simulated_time)) < next_time) {\n        next_action = 3;\n        next_time = action_time;\n    }\n\n    if (next_time == UINT64_MAX) {\n        /* No more action possible */\n        ret = -1;\n    }\n    else {\n        if (next_time > *simulated_time) {\n            *simulated_time = next_time;\n        }\n\n        switch (next_action) {\n        case 0:\n            ret = netperf_next_arrival(test_ctx->s_to_c_link, test_ctx->qclient, *simulated_time, was_active,\n                (struct sockaddr *)&test_ctx->server_addr);\n            break;\n        case 1:\n            ret = netperf_next_arrival(test_ctx->c_to_s_link, test_ctx->qserver, *simulated_time, was_active,\n                (struct sockaddr*) & test_ctx->client_addr);\n            if (test_ctx->cnx_server == NULL) {\n                test_ctx->cnx_server = test_ctx->qserver->cnx_list;\n            }\n            break;\n        case 2:\n            ret = netperf_next_departure(test_ctx->qclient, test_ctx->c_to_s_link, *simulated_time, was_active, send_buffer, send_buffer_size);\n            break;\n        case 3:\n            ret = netperf_next_departure(test_ctx->qserver, test_ctx->s_to_c_link, *simulated_time, was_active, send_buffer, send_buffer_size);\n            break;\n        default:\n            ret = -1;\n            break;\n        }\n    }\n\n    return ret;\n}\n\n/* Connection loop with large packets */\nint netperf_connection_loop(picoquic_test_tls_api_ctx_t* test_ctx,\n    uint64_t* loss_mask, uint64_t queue_delay_max, uint64_t* simulated_time,\n    uint8_t* send_buffer, size_t send_buffer_size)\n{\n    int ret = 0;\n    int nb_trials = 0;\n    int nb_inactive = 0;\n\n    test_ctx->c_to_s_link->loss_mask = loss_mask;\n    test_ctx->s_to_c_link->loss_mask = loss_mask;\n\n    test_ctx->c_to_s_link->queue_delay_max = queue_delay_max;\n    test_ctx->s_to_c_link->queue_delay_max = queue_delay_max;\n\n    while (ret == 0 && nb_trials < 1024 && nb_inactive < 512 && (!TEST_CLIENT_READY || (test_ctx->cnx_server == NULL || !TEST_SERVER_READY))) {\n        int was_active = 0;\n        nb_trials++;\n\n        ret = netperf_step(test_ctx, simulated_time, &was_active, send_buffer, send_buffer_size);\n\n        if (test_ctx->cnx_client->cnx_state == picoquic_state_disconnected &&\n            (test_ctx->cnx_server == NULL || test_ctx->cnx_server->cnx_state == picoquic_state_disconnected)) {\n            break;\n        }\n\n        if (nb_trials == 512) {\n            DBG_PRINTF(\"After %d trials, client state = %d, server state = %d\",\n                nb_trials, (int)test_ctx->cnx_client->cnx_state,\n                (test_ctx->cnx_server == NULL) ? -1 : test_ctx->cnx_server->cnx_state);\n        }\n\n        if (was_active) {\n            nb_inactive = 0;\n        }\n        else {\n            nb_inactive++;\n        }\n    }\n\n    return ret;\n}\n\nint netperf_scenario_body_connect(picoquic_test_tls_api_ctx_t* test_ctx,\n    uint64_t* simulated_time, uint64_t max_data, uint64_t queue_delay_max,\n    uint8_t* send_buffer, size_t send_buffer_size)\n{\n    uint64_t loss_mask = 0;\n    int ret = picoquic_start_client_cnx(test_ctx->cnx_client);\n\n    if (ret != 0)\n    {\n        DBG_PRINTF(\"%s\", \"Could not initialize connection for the client\\n\");\n    }\n    else {\n        ret = netperf_connection_loop(test_ctx, &loss_mask, queue_delay_max, simulated_time, send_buffer, send_buffer_size);\n\n        if (ret != 0)\n        {\n            DBG_PRINTF(\"Connection loop returns error %d\\n\", ret);\n        }\n    }\n\n    if (ret == 0 && max_data != 0) {\n        test_ctx->cnx_client->maxdata_local = max_data;\n        test_ctx->cnx_client->maxdata_remote = max_data;\n        test_ctx->cnx_server->maxdata_local = max_data;\n        test_ctx->cnx_server->maxdata_remote = max_data;\n    }\n\n    return ret;\n}\n\nint netperf_data_sending_loop(picoquic_test_tls_api_ctx_t* test_ctx,\n    uint64_t* loss_mask, uint64_t* simulated_time, int max_trials,\n    uint8_t* send_buffer, size_t send_buffer_size)\n{\n    int ret = 0;\n    int nb_trials = 0;\n    int nb_inactive = 0;\n\n    test_ctx->c_to_s_link->loss_mask = loss_mask;\n    test_ctx->s_to_c_link->loss_mask = loss_mask;\n\n    if (max_trials <= 0) {\n        max_trials = 4000000;\n    }\n\n    while (ret == 0 && nb_trials < max_trials && nb_inactive < 256 && TEST_CLIENT_READY && TEST_SERVER_READY) {\n        int was_active = 0;\n\n        nb_trials++;\n\n        ret = netperf_step(test_ctx, simulated_time, &was_active, send_buffer, send_buffer_size);\n\n        if (ret < 0)\n        {\n            break;\n        }\n\n        if (was_active) {\n            nb_inactive = 0;\n        }\n        else {\n            nb_inactive++;\n        }\n\n        if (test_ctx->test_finished) {\n            if (picoquic_is_cnx_backlog_empty(test_ctx->cnx_client) && picoquic_is_cnx_backlog_empty(test_ctx->cnx_server)) {\n                break;\n            }\n        }\n    }\n\n    return ret; /* end of sending loop */\n}\n\nstatic int netperf_attempt_to_close(\n    picoquic_test_tls_api_ctx_t* test_ctx, uint64_t* simulated_time,\n    uint8_t* send_buffer, size_t send_buffer_size)\n{\n    int ret = 0;\n    int nb_rounds = 0;\n\n    ret = picoquic_close(test_ctx->cnx_client, 0);\n\n    if (ret == 0) {\n        /* packet from client to server */\n        /* Do not simulate losses there, as there is no way to correct them */\n\n        test_ctx->c_to_s_link->loss_mask = 0;\n        test_ctx->s_to_c_link->loss_mask = 0;\n\n        while (ret == 0 && (test_ctx->cnx_client->cnx_state != picoquic_state_disconnected || test_ctx->cnx_server->cnx_state != picoquic_state_disconnected) && nb_rounds < 100000) {\n            int was_active = 0;\n            ret = netperf_step(test_ctx, simulated_time, &was_active, send_buffer, send_buffer_size);\n            nb_rounds++;\n        }\n    }\n\n    if (ret == 0 && (test_ctx->cnx_client->cnx_state != picoquic_state_disconnected || test_ctx->cnx_server->cnx_state != picoquic_state_disconnected)) {\n        ret = -1;\n    }\n\n    return ret;\n}\n\n/* Test a connection scenario, using large send buffers */\nint netperf_one_scenario(test_api_stream_desc_t* scenario,\n    size_t sizeof_scenario, picoquic_congestion_algorithm_t * cc_algo, size_t stream0_target,\n    uint64_t init_loss_mask, uint64_t max_data, uint64_t queue_delay_max,\n    uint32_t proposed_version, uint64_t max_completion_microsec,\n    picoquic_tp_t* client_params, picoquic_tp_t* server_params,\n    size_t send_buffer_size)\n{\n    uint64_t simulated_time = 0;\n    uint64_t loss_mask;\n    picoquic_test_tls_api_ctx_t* test_ctx = NULL;\n    uint8_t* send_buffer = NULL;\n\n    int ret = tls_api_one_scenario_init(&test_ctx, &simulated_time,\n        proposed_version, client_params, server_params);\n\n    if (ret == 0 && send_buffer_size > 0) {\n        send_buffer = (uint8_t*)malloc(send_buffer_size);\n        if (send_buffer == 0) {\n            ret = -1;\n        }\n    }\n\n    if (ret == 0 && cc_algo != NULL) {\n        test_ctx->qserver->padding_multiple_default = 128;\n        test_ctx->qclient->padding_multiple_default = 128;\n        picoquic_set_packet_train_mode(test_ctx->qserver, 1);\n        picoquic_set_packet_train_mode(test_ctx->qclient, 1);\n        picoquic_set_default_congestion_algorithm(test_ctx->qserver, cc_algo);\n        picoquic_set_congestion_algorithm(test_ctx->cnx_client, cc_algo);\n    }\n\n    if (ret == 0) {\n        ret = netperf_scenario_body_connect(test_ctx, &simulated_time,\n            max_data, queue_delay_max, send_buffer, send_buffer_size);\n\n        /* Prepare to send data */\n        if (ret == 0) {\n            test_ctx->stream0_target = stream0_target;\n            loss_mask = init_loss_mask;\n            ret = test_api_init_send_recv_scenario(test_ctx, scenario, sizeof_scenario);\n\n            if (ret != 0)\n            {\n                DBG_PRINTF(\"Init send receive scenario returns %d\\n\", ret);\n            }\n        }\n\n        /* Perform a data sending loop */\n        if (ret == 0) {\n            ret = netperf_data_sending_loop(test_ctx, &loss_mask, &simulated_time, 0, send_buffer, send_buffer_size);\n\n            if (ret != 0)\n            {\n                DBG_PRINTF(\"Data sending loop returns %d\\n\", ret);\n            }\n        }\n\n        if (ret == 0) {\n            uint64_t close_time = 0;\n            ret = tls_api_one_scenario_verify(test_ctx);\n\n            if (ret == 0) {\n                if (test_ctx->cnx_server == NULL) {\n                    DBG_PRINTF(\"%s\", \"Cannot check server stats\\n\");\n                    ret = -1;\n                }\n                else if ((3* test_ctx->cnx_server->nb_trains_sent)/2 > test_ctx->cnx_server->nb_packets_sent) {\n                    DBG_PRINTF(\"Datagram coalescing fails, %\" PRIu64 \" trains for %\" PRIu64 \"packets\\n\",\n                        test_ctx->cnx_server->nb_trains_sent, test_ctx->cnx_server->nb_packets_sent);\n                    ret = -1;\n                }\n                else if (20 * test_ctx->cnx_server->nb_retransmission_total > test_ctx->cnx_server->nb_packets_sent) {\n                    DBG_PRINTF(\"Too many losses, %\" PRIu64 \" losses for %\" PRIu64 \"packets\\n\",\n                        test_ctx->cnx_server->nb_retransmission_total, test_ctx->cnx_server->nb_packets_sent);\n                    ret = -1;\n\n                }\n            }\n\n            if (ret == 0) {\n                close_time = simulated_time;\n                netperf_attempt_to_close(test_ctx, &simulated_time, send_buffer, send_buffer_size);\n                if (ret != 0)\n                {\n                    DBG_PRINTF(\"Attempt to close returns %d\\n\", ret);\n                }\n            }\n\n            if (ret == 0 && max_completion_microsec != 0) {\n                uint64_t completion_time = close_time - test_ctx->cnx_client->start_time;\n                if (completion_time > max_completion_microsec)\n                {\n                    DBG_PRINTF(\"Scenario completes in %llu microsec, more than %llu\\n\",\n                        (unsigned long long)completion_time, (unsigned long long)max_completion_microsec);\n                    ret = -1;\n                }\n            }\n        }\n    }\n\n    if (send_buffer != NULL) {\n        free(send_buffer);\n    }\n\n    if (test_ctx != NULL) {\n        tls_api_delete_ctx(test_ctx);\n        test_ctx = NULL;\n    }\n\n    return ret;\n}\n\nstatic test_api_stream_desc_t netperf_scenario_basic[] = {\n    { 4, 0, 257, 1000000 }\n};\n\nint netperf_basic_test(void)\n{\n    int ret = netperf_one_scenario(netperf_scenario_basic, sizeof(netperf_scenario_basic),\n        NULL,\n        0, 0, 0, 0, 0, 1000000, NULL, NULL, 10 * PICOQUIC_MAX_PACKET_SIZE);\n\n    return ret;\n}\n\nint netperf_bbr_test(void)\n{\n    int ret = netperf_one_scenario(netperf_scenario_basic, sizeof(netperf_scenario_basic),\n        picoquic_bbr_algorithm,\n        0, 0, 0, 0, 0, 1000000, NULL, NULL, 10 * PICOQUIC_MAX_PACKET_SIZE);\n\n    return ret;\n}\n\n\n\n/* Address natting stress.\n * The attacker has the capability to intercept traffic and rewrite addresses.\n * It waits for a client to start a connection, and then keeps changing the\n * \"source IP\" that appears in the client's packets. The test verifies simply that\n * the server remains functional.\n */\n\nvoid natattack_port_rewrite(struct sockaddr_storage* addr, struct sockaddr* ref, uint16_t offset)\n{\n    if (addr->ss_family == AF_INET) {\n        ((struct sockaddr_in*)addr)->sin_port = ((struct sockaddr_in*)ref)->sin_port + offset;\n    }\n    else if (addr->ss_family == AF_INET6) {\n        ((struct sockaddr_in6*)addr)->sin6_port = ((struct sockaddr_in6*)ref)->sin6_port + offset;\n    }\n}\n\nint nat_attack_loop_step(picoquic_test_tls_api_ctx_t* test_ctx, uint64_t* simulated_time, int* was_active,\n    uint8_t* send_buffer, size_t send_buffer_size, int nb_loops, int do_attack)\n{\n    int ret = 0;\n    int next_action = -1;\n    uint64_t next_time = UINT64_MAX;\n    uint64_t action_time;\n\n    *was_active = 0;\n\n    if ((action_time = picoquictest_sim_link_next_arrival(test_ctx->s_to_c_link, next_time)) < next_time) {\n        next_action = 0;\n        next_time = action_time;\n    }\n\n    if ((action_time = picoquictest_sim_link_next_arrival(test_ctx->c_to_s_link, next_time)) < next_time) {\n        next_action = 1;\n        next_time = action_time;\n    }\n\n    if ((action_time = picoquic_get_next_wake_time(test_ctx->qclient, *simulated_time)) < next_time) {\n        next_action = 2;\n        next_time = action_time;\n    }\n\n    if ((action_time = picoquic_get_next_wake_time(test_ctx->qserver, *simulated_time)) < next_time) {\n        next_action = 3;\n        next_time = action_time;\n    }\n\n    if (next_time == UINT64_MAX) {\n        /* No more action possible */\n        ret = -1;\n    }\n    else {\n        if (next_time > * simulated_time) {\n            *simulated_time = next_time;\n        }\n\n        switch (next_action) {\n        case 0:\n            /* rewrite destination address to client address, simulating NAT */\n            if (test_ctx->s_to_c_link->first_packet != NULL && do_attack) {\n                picoquic_store_addr(&test_ctx->s_to_c_link->first_packet->addr_to,\n                    (struct sockaddr*) & test_ctx->client_addr);\n            }\n            ret = netperf_next_arrival(test_ctx->s_to_c_link, test_ctx->qclient, *simulated_time, was_active,\n                (struct sockaddr*) & test_ctx->server_addr);\n            break;\n        case 1:\n            /* Randomize client address, simulating broken NAT */\n            if (test_ctx->c_to_s_link->first_packet != NULL && do_attack) {\n                natattack_port_rewrite(&test_ctx->c_to_s_link->first_packet->addr_from,\n                    (struct sockaddr*) & test_ctx->client_addr, (uint16_t)nb_loops);\n            }\n            ret = netperf_next_arrival(test_ctx->c_to_s_link, test_ctx->qserver, *simulated_time, was_active,\n                (struct sockaddr*) & test_ctx->client_addr);\n            if (test_ctx->cnx_server == NULL) {\n                test_ctx->cnx_server = test_ctx->qserver->cnx_list;\n            }\n            break;\n        case 2:\n            ret = netperf_next_departure(test_ctx->qclient, test_ctx->c_to_s_link, *simulated_time, was_active, send_buffer, send_buffer_size);\n            break;\n        case 3:\n            ret = netperf_next_departure(test_ctx->qserver, test_ctx->s_to_c_link, *simulated_time, was_active, send_buffer, send_buffer_size);\n            break;\n        default:\n            ret = -1;\n            break;\n        }\n    }\n\n    return ret;\n}\n\nint nat_attack_loop(picoquic_test_tls_api_ctx_t* test_ctx, uint64_t * simulated_time, \n    uint8_t * send_buffer, size_t send_buffer_size, int do_attack)\n{\n    int ret = 0;\n    int was_active = 0;\n    int nb_loops = 0;\n    int nb_inactive = 0;\n\n    /* Run a simplified simulation */\n    while (ret == 0 && test_ctx->cnx_client != NULL && test_ctx->cnx_client->cnx_state != picoquic_state_disconnected)\n    {\n        ret = nat_attack_loop_step(test_ctx, simulated_time, &was_active, send_buffer, send_buffer_size, nb_loops, do_attack);\n        if (was_active) {\n            nb_inactive = 0;\n        }\n        else {\n            nb_inactive++;\n            if (nb_inactive > 64) {\n                DBG_PRINTF(\"Loop appears stuck, nb_inactive = %d\", nb_inactive);\n                ret = -1;\n                break;\n            }\n        }\n        nb_loops++;\n        if (nb_loops > 100000) {\n            DBG_PRINTF(\"Too many loops %d\", nb_loops);\n            ret = -1;\n            break;\n        }\n        if (ret != 0) {\n            break;\n        }\n\n        if (test_ctx->test_finished) {\n            if (picoquic_is_cnx_backlog_empty(test_ctx->cnx_client) && test_ctx->cnx_server != NULL &&\n                picoquic_is_cnx_backlog_empty(test_ctx->cnx_server)) {\n                break;\n            }\n        }\n    }\n\n    return ret;\n}\n\nstatic test_api_stream_desc_t nat_attack_scenario[] = {\n    { 4, 0, 256000, 1000000 },\n    { 8, 0, 256000, 1000000 },\n    { 12, 0, 256000, 1000000 },\n    { 16, 0, 256000, 1000000 },\n    { 20, 0, 256000, 1000000 },\n    { 24, 0, 256000, 1000000 },\n    { 28, 0, 256000, 1000000 },\n    { 32, 0, 256000, 1000000 }\n};\n\nint nat_attack_test(void)\n{\n    /* Create a connection context */\n    uint64_t simulated_time = 0;\n    picoquic_test_tls_api_ctx_t* test_ctx = NULL;\n    uint8_t* send_buffer = NULL;\n    size_t send_buffer_size = PICOQUIC_MAX_PACKET_SIZE;\n    int ret = tls_api_one_scenario_init(&test_ctx, &simulated_time, PICOQUIC_INTERNAL_TEST_VERSION_1, NULL, NULL);\n\n    if (ret == 0 && test_ctx == NULL) {\n        ret = -1;\n    }\n\n    if (ret == 0 && send_buffer_size > 0) {\n        send_buffer = (uint8_t*)malloc(send_buffer_size);\n        if (send_buffer == 0) {\n            ret = -1;\n        }\n    }\n\n    if (ret == 0)\n    {\n        ret = picoquic_start_client_cnx(test_ctx->cnx_client);\n    }\n\n    if (ret == 0) {\n        ret = test_api_init_send_recv_scenario(test_ctx, nat_attack_scenario, sizeof(nat_attack_scenario));\n    }\n\n    /* Run a simplified simulation */\n    if (ret == 0) {\n        ret = nat_attack_loop(test_ctx, &simulated_time, send_buffer, send_buffer_size, 1);\n    }\n\n    /* If the client connection is still up, verify that data was properly received. */\n    if (ret == 0 && test_ctx->cnx_client->cnx_state == picoquic_state_ready) {\n        ret = tls_api_one_scenario_verify(test_ctx);\n    }\n\n    if (ret == 0) {\n        DBG_PRINTF(\"Exit attack loop at time %\" PRIu64 \", received %\" PRIu64 \" packets at client.\",\n            simulated_time, test_ctx->cnx_client->nb_packets_received);\n    }\n\n    if (send_buffer != NULL) {\n        free(send_buffer);\n    }\n\n    if (test_ctx != NULL) {\n        tls_api_delete_ctx(test_ctx);\n        test_ctx = NULL;\n    }\n\n    return ret;\n}\n","numLines":707,"startLine":1,"totalLines":707}}}
