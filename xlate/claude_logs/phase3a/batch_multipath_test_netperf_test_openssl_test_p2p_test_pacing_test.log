hole insertion at the server */\n1599\t            picoquic_set_optimistic_ack_policy(test_ctx->qserver, PICOQUIC_DEFAULT_HOLE_PERIOD);\n1600\t            /* Reset the uniform random test */\n1601\t            picoquic_public_random_seed_64(RANDOM_PUBLIC_TEST_SEED, 1);\n1602\t        }\n1603\t\n1604\t        if (test_case == monopath_test_rotation) {\n1605\t            picoquic_set_default_crypto_epoch_length(test_ctx->qserver, 200);\n1606\t        }\n1607\t\n1608\t        if (ret == 0) {\n1609\t            ret = tls_api_one_scenario_body_connect(test_ctx, &simulated_time, 0, 0);\n1610\t            if (ret != 0)\n1611\t            {\n1612\t                DBG_PRINTF(\"Connect loop returns %d\\n\", ret);\n1613\t            }\n1614\t        }\n1615\t\n1616\t        /* Prepare to send data */\n1617\t        if (ret == 0) {\n1618\t            ret = test_api_init_send_recv_scenario(test_ctx, test_scenario_multipath,\n1619\t                sizeof(test_scenario_multipath));\n1620\t\n1621\t            if (ret != 0)\n1622\t            {\n1623\t                DBG_PRINTF(\"Init send receive scenario returns %d\\n\", ret);\n1624\t            }\n1625\t        }\n1626\t\n1627\t        if (ret == 0) {\n1628\t            ret = tls_api_data_sending_loop(test_ctx, &test_ctx->loss_mask_default, &simulated_time, 0);\n1629\t\n1630\t            if (ret != 0)\n1631\t            {\n1632\t                DBG_PRINTF(\"Data sending loop returns %d\\n\", ret);\n1633\t            }\n1634\t        }\n1635\t    }\n1636\t\n1637\t    if (ret == 0 && test_case == monopath_keep_alive) {\n1638\t        max_completion_microsec = 202000000;\n1639\t        ret = multipath_test_do_keep_alive(test_ctx, &simulated_time);\n1640\t    }\n1641\t\n1642\t    if (ret == 0) {\n1643\t        ret = tls_api_one_scenario_body_verify(test_ctx, &simulated_time, max_completion_microsec);\n1644\t    }\n1645\t\n1646\t    if (ret == 0){\n1647\t        if (test_case == monopath_test_hole) {\n1648\t            if (test_ctx->c