{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_013CuiZvCYAzrAmjzrhdowYZ","type":"tool_result","content":"200\t                picoquic_compare_addr((struct sockaddr*) & old_dest, (struct sockaddr*) & test_ctx->cnx_server->path[0]->first_tuple->local_addr) == 0))){\n201\t        was_active = 0;\n202\t        nb_trials++;\n203\t\n204\t        ret = tls_api_one_sim_round(test_ctx, simulated_time, time_out, &was_active);\n205\t\n206\t        if (was_active) {\n207\t            nb_inactive = 0;\n208\t        }\n209\t        else {\n210\t            nb_inactive++;\n211\t        }\n212\t    }\n213\t\n214\t    if (ret != 0 || (test_ctx->cnx_client->cnx_state != picoquic_state_ready ||\n215\t        (picoquic_compare_addr((struct sockaddr*) & old_srce, (struct sockaddr*) & test_ctx->cnx_client->path[0]->first_tuple->local_addr) == 0 &&\n216\t            picoquic_compare_addr((struct sockaddr*) & old_dest, (struct sockaddr*) & test_ctx->cnx_client->path[0]->first_tuple->peer_addr) == 0))\n217\t        ||\n218\t        (picoquic_compare_addr((struct sockaddr *) & old_srce, (struct sockaddr*) & test_ctx->cnx_server->path[0]->first_tuple->peer_addr) == 0 &&\n219\t            picoquic_compare_addr((struct sockaddr*) & old_dest, (struct sockaddr*) & test_ctx->cnx_server->path[0]->first_tuple->local_addr) == 0)){\n220\t        DBG_PRINTF(\"Could not complete migration, client state = %d\\n\",\n221\t            test_ctx->cnx_client->cnx_state);\n222\t        ret = -1;\n223\t    }\n224\t\n225\t    return ret;\n226\t}\n227\t\n228\t\n229\t/* Controlled migration test.\n230\t * Create a basic connection.\n231\t * Run until the handshake is done.\n232\t * Start a migration.\n233\t * Verify that the transfer completes */\n234\t\n235\t#define MIGRATION_TRACE_BIN \"migration_trace.bin\"\n236\t\n237\t\n238\tstatic test_api_stream_desc_t test_scenario_multipath[] = {\n239\t    { 4, 0, 257, 1000000 },\n240\t    { 8, 4, 257, 1000000 }\n241\t};\n242\t\n243\tstatic test_api_stream_desc_t test_scenario_multipath_long[] = {\n244\t    { 4, 0, 257, 1000000 },\n245\t    { 8, 0, 257, 1000000 },\n246\t    { 12, 0, 257, 1000000 },\n247\t    { 16, 0, 257, 1000000 },\n248\t    { 20, 0, 257, 1000000 },\n249\t    { 24, 0, 257, 1000000 },\n250\t    { 28, 0, 257, 1000000 },\n251\t    { 32, 0, 257, 1000000 },\n252\t    { 36, 0, 257, 1000000 },\n253\t    { 40, 0, 257, 1000000 }\n254\t};\n255\t\n256\tint migration_test_one(int mtu_drop)\n257\t{\n258\t    uint64_t simulated_time = 0;\n259\t    uint64_t loss_mask = 0;\n260\t    uint64_t max_completion_microsec = 2100000;\n261\t    picoquic_test_tls_api_ctx_t* test_ctx = NULL;\n262\t    picoquic_connection_id_t initial_cid = { {0x1a, 0x10, 0xc0, 4, 5, 6, 7, 8}, 8 };\n263\t    int ret;\n264\t\n265\t    if (mtu_drop) {\n266\t        initial_cid.id[2] = 0xcd;\n267\t    }\n268\t    \n269\t    ret = tls_api_init_ctx_ex(&test_ctx, PICOQUIC_INTERNAL_TEST_VERSION_1,\n270\t        PICOQUIC_TEST_SNI, PICOQUIC_TEST_ALPN, &simulated_time, NULL, NULL, 0, 0, 0, &initial_cid);\n271\t\n272\t    if (mtu_drop) {\n273\t        /* The MTU drop test is specifically orientated towards verifying retransmissions,\n274\t         * which requires simulating losses */\n275\t        loss_mask |= (((uint64_t)1) << 31);\n276\t    }\n277\t\n278\t    if (ret == 0 && test_ctx == NULL) {\n279\t        ret = -1;\n280\t    }\n281\t    else {\n282\t        picoquic_set_binlog(test_ctx->qserver, \".\");\n283\t        test_ctx->qserver->use_long_log = 1;\n284\t    }\n285\t\n286\t    /* establish the connection*/\n287\t    if (ret == 0) {\n288\t        ret = tls_api_connection_loop(test_ctx, &loss_mask, 0, &simulated_time);\n289\t    }\n290\t\n291\t    /* Prepare to send data */\n292\t    if (ret == 0) {\n293\t        ret = test_api_init_send_recv_scenario(test_ctx, test_scenario_multipath, sizeof(test_scenario_multipath));\n294\t\n295\t        if (ret != 0)\n296\t        {\n297\t            DBG_PRINTF(\"Init send receive scenario returns %d\\n\", ret);\n298\t        }\n299\t    }\n300\t\n301\t    /* wait until the client (and thus the server) is ready */\n302\t    if (ret == 0) {\n303\t        ret = wait_client_connection_ready(test_ctx, &simulated_time);\n304\t    }\n305\t\n306\t    /* Add the multipath links and initiate the migration */\n307\t    if (ret == 0) {\n308\t        ret = multipath_test_add_links(test_ctx, mtu_drop);\n309\t    }\n310\t\n311\t    if (ret == 0) {\n312\t        ret = picoquic_probe_new_path(test_ctx->cnx_client, (struct sockaddr*) & test_ctx->server_addr,\n313\t            (struct sockaddr*) & test_ctx->client_addr_2, simulated_time);\n314\t    }\n315\t\n316\t    /* Check that the migration succeeds */\n317\t    if (ret == 0) {\n318\t        ret = wait_client_migration_done(test_ctx, &simulated_time);\n319\t    }\n320\t\n321\t    /* Kill the old links, so nothing more can be sent there */\n322\t    if (ret == 0) {\n323\t        multipath_test_kill_links(test_ctx, 0);\n324\t    }\n325\t\n326\t    /* Perform a data sending loop */\n327\t    if (ret == 0) {\n328\t        ret = tls_api_data_sending_loop(test_ctx, &loss_mask, &simulated_time, 0);\n329\t\n330\t        if (ret != 0)\n331\t        {\n332\t            DBG_PRINTF(\"Data sending loop returns %d\\n\", ret);\n333\t        }\n334\t    }\n335\t\n336\t    /* Check that the transmission succeeded */\n337\t    if (ret == 0) {\n338\t        ret = tls_api_one_scenario_body_verify(test_ctx, &simulated_time, max_completion_microsec);\n339\t    }\n340\t\n341\t    /* Check that the default client address on the server was migrated,\n342\t     * as well as the default source address on the client */\n343\t    if (ret == 0 && test_ctx->cnx_server == NULL) {\n344\t        /* No server connection! */\n345\t        ret = -1;\n346\t    }\n347\t\n348\t    if (ret == 0) {\n349\t        struct sockaddr* c_addr_at_server = NULL;\n350\t        struct sockaddr* c_addr_at_client = NULL;\n351\t        picoquic_get_peer_addr(test_ctx->cnx_server, &c_addr_at_server);\n352\t        picoquic_get_local_addr(test_ctx->cnx_client, &c_addr_at_client);\n353\t\n354\t        if (picoquic_compare_addr((struct sockaddr*) & test_ctx->client_addr_2, c_addr_at_server) != 0 ||\n355\t            picoquic_compare_addr((struct sockaddr*) & test_ctx->client_addr_2, c_addr_at_client) != 0) {\n356\t            /* Migration was not completed */\n357\t            ret = -1;\n358\t        }\n359\t    }\n360\t\n361\t    /* Delete the context */\n362\t    if (test_ctx != NULL) {\n363\t        tls_api_delete_ctx(test_ctx);\n364\t    }\n365\t\n366\t    return ret;\n367\t}\n368\t\n369\tint migration_controlled_test(void)\n370\t{\n371\t    return migration_test_one(0);\n372\t}\n373\t\n374\tint migration_mtu_drop_test(void)\n375\t{\n376\t    return migration_test_one(1);\n377\t}\n378\t\n379\t/*\n380\t * Test of actual multipath, by opposition to only migration.\n381\t */\n382\t\n383\tvoid multipath_init_params(picoquic_tp_t *test_parameters, int enable_time_stamp)\n384\t{\n385\t    memset(test_parameters, 0, sizeof(picoquic_tp_t));\n386\t\n387\t    picoquic_init_transport_parameters(test_parameters);\n388\t    test_parameters->initial_max_path_id = 2;\n389\t    test_parameters->enable_time_stamp = 3* enable_time_stamp;\n390\t}\n391\t\n392\t/* wait until the migration completes */\n393\tint wait_multipath_ready(picoquic_test_tls_api_ctx_t* test_ctx,\n394\t    uint64_t* simulated_time)\n395\t{\n396\t    int ret = 0;\n397\t    uint64_t time_out = *simulated_time + 4000000;\n398\t    int nb_trials = 0;\n399\t    int nb_inactive = 0;\n400\t    int was_active = 0;\n401\t    struct sockaddr_storage old_srce;\n402\t    struct sockaddr_storage old_dest;\n403\t\n404\t    /* Check the selected path */\n405\t    picoquic_store_addr(&old_srce, (struct sockaddr*) & test_ctx->cnx_client->path[0]->first_tuple->local_addr);\n406\t    picoquic_store_addr(&old_dest, (struct sockaddr*) & test_ctx->cnx_client->path[0]->first_tuple->peer_addr);\n407\t\n408\t    while (*simulated_time < time_out &&\n409\t        ret == 0 &&\n410\t        test_ctx->cnx_client->cnx_state == picoquic_state_ready &&\n411\t        nb_trials < 5000 &&\n412\t        nb_inactive < 64 &&\n413\t        (test_ctx->cnx_client->nb_paths != 2 ||\n414\t        !test_ctx->cnx_client->path[1]->first_tuple->challenge_verified ||\n415\t        (test_ctx->cnx_server == NULL || (test_ctx->cnx_server->nb_paths != 2 ||\n416\t        !test_ctx->cnx_server->path[1]->first_tuple->challenge_verified)))){\n417\t        nb_trials++;\n418\t\n419\t        ret = tls_api_one_sim_round(test_ctx, simulated_time, time_out, &was_active);\n420\t\n421\t        if (was_active) {\n422\t            nb_inactive = 0;\n423\t        }\n424\t        else {\n425\t            nb_inactive++;\n426\t        }\n427\t    }\n428\t\n429\t    if (ret == 0 && (test_ctx->cnx_client->cnx_state != picoquic_state_ready ||\n430\t        (test_ctx->cnx_client->nb_paths != 2 ||\n431\t            !test_ctx->cnx_client->path[1]->first_tuple->challenge_verified) ||\n432\t            (test_ctx->cnx_server == NULL || (test_ctx->cnx_server->nb_paths != 2 ||\n433\t                !test_ctx->cnx_server->path[1]->first_tuple->challenge_verified)))) {\n434\t        DBG_PRINTF(\"Could not establish multipath, client state = %d\\n\",\n435\t            test_ctx->cnx_client->cnx_state);\n436\t        ret = -1;\n437\t    }\n438\t\n439\t    return ret;\n440\t}\n441\t\n442\ttypedef enum {\n443\t    multipath_test_basic = 0,\n444\t    multipath_test_drop_first,\n445\t    multipath_test_drop_second,\n446\t    multipath_test_sat_plus,\n447\t    multipath_test_renew,\n448\t    multipath_test_rotation,\n449\t    multipath_test_nat,\n450\t    multipath_test_nat_challenge,\n451\t    multipath_test_break1,\n452\t    multipath_test_break2,\n453\t    multipath_test_break3,\n454\t    multipath_test_back0,\n455\t    multipath_test_back1,\n456\t    multipath_test_perf,\n457\t    multipath_test_callback,\n458\t    multipath_test_quality,\n459\t    multipath_test_quality_server,\n460\t    multipath_test_stream_af,\n461\t    multipath_test_abandon,\n462\t    multipath_test_datagram,\n463\t    multipath_test_dg_af,\n464\t    multipath_test_backup,\n465\t    multipath_test_standup,\n466\t    multipath_test_tunnel,\n467\t    multipath_test_fail,\n468\t    multipath_test_ab1,\n469\t    multipath_test_discovery,\n470\t    multipath_test_keep_alive,\n471\t    multipath_test_just_one,\n472\t    multipath_test_break_both,\n473\t} multipath_test_enum_t;\n474\t\n475\t#ifdef _WINDOWS\n476\t#define PATH_CALLBACK_TEST_REF \"picoquictest\\\\path_callback_ref.txt\"\n477\t#define PATH_QUALITY_TEST_REF \"picoquictest\\\\path_quality_ref.txt\"\n478\t#define PATH_QUALITY_SERVER_REF \"picoquictest\\\\path_quality_server_ref.txt\"\n479\t#else\n480\t#define PATH_CALLBACK_TEST_REF \"picoquictest/path_callback_ref.txt\"\n481\t#define PATH_QUALITY_TEST_REF \"picoquictest/path_quality_ref.txt\"\n482\t#define PATH_QUALITY_SERVER_REF \"picoquictest/path_quality_server_ref.txt\"\n483\t#endif\n484\t#define PATH_CALLBACK_CSV \"path_callback.csv\"\n485\t#define PATH_QUALITY_CSV \"path_quality.csv\"\n486\t#define PATH_QUALITY_SERVER \"path_quality_server.csv\"\n487\t\n488\tint multipath_init_callbacks(picoquic_test_tls_api_ctx_t* test_ctx, multipath_test_enum_t test_id)\n489\t{\n490\t    int ret = 0;\n491\t    char const* filename = (test_id == multipath_test_callback) ? PATH_CALLBACK_CSV :\n492\t        ((test_id == multipath_test_quality) ? PATH_QUALITY_CSV : PATH_QUALITY_SERVER);\n493\t    /* Open a file to log bandwidth updates and document it in context */\n494\t    test_ctx->path_events = picoquic_file_open(filename, \"w\");\n495\t    if (test_ctx->path_events == NULL) {\n496\t        DBG_PRINTF(\"Could not write file <%s>\", filename);\n497\t        ret = -1;\n498\t    }\n499\t    else {\n500\t        if (test_id == multipath_test_quality_server) {\n501\t            picoquic_enable_path_callbacks_default(test_ctx->qserver, 1);\n502\t            picoquic_default_quality_update(test_ctx->qserver, 50000, 5000);\n503\t        }\n504\t        else {\n505\t            picoquic_enable_path_callbacks(test_ctx->cnx_client, 1);\n506\t            if (test_id == multipath_test_quality) {\n507\t                picoquic_subscribe_to_quality_update(test_ctx->cnx_client, 50000, 5000);\n508\t                ret = picoquic_subscribe_to_quality_update_per_path(test_ctx->cnx_client, 0, 50000, 5000);\n509\t            }\n510\t            if (test_id == multipath_test_callback) {\n511\t                int is_already_allowed = 0;\n512\t                ret = picoquic_subscribe_new_path_allowed(test_ctx->cnx_client, &is_already_allowed);\n513\t            }\n514\t        }\n515\t        if (test_id == multipath_test_callback) {\n516\t            fprintf(test_ctx->path_events, \"Time, Path-ID, Event,\\n\");\n517\t        }\n518\t        else {\n519\t            fprintf(test_ctx->path_events, \"Time, Path-ID, Event, Pacing_rate, Receive Rate, CWIN, RTT\\n\");\n520\t        }\n521\t    }\n522\t    return ret;\n523\t}\n524\t\n525\tint multipath_verify_callbacks(multipath_test_enum_t test_id)\n526\t{\n527\t    int ret = 0;\n528\t    char file_ref[512];\n529\t    char const* filename = (test_id == multipath_test_callback) ? PATH_CALLBACK_CSV : \n530\t        ((test_id == multipath_test_quality)?PATH_QUALITY_CSV:PATH_QUALITY_SERVER);\n531\t    char const* ref_name = (test_id == multipath_test_callback) ? PATH_CALLBACK_TEST_REF : \n532\t        ((test_id == multipath_test_quality)?PATH_QUALITY_TEST_REF:PATH_QUALITY_SERVER_REF);\n533\t\n534\t    ret = picoquic_get_input_path(file_ref, sizeof(file_ref), picoquic_solution_dir, ref_name);\n535\t\n536\t    if (ret != 0) {\n537\t        DBG_PRINTF(\"Cannot set the reference file name for test id: %s.\\n\", (int)test_id);\n538\t    }\n539\t    else {\n540\t        ret = picoquic_test_compare_text_files(filename, file_ref);\n541\t    }\n542\t    return ret;\n543\t}\n544\t\n545\tstatic int multipath_test_abandon_cycle(picoquic_test_tls_api_ctx_t* test_ctx, uint64_t* simulated_time)\n546\t{\n547\t    int ret = 0;\n548\t    uint64_t deleted_id = UINT64_MAX;\n549\t    picoquic_local_cnxid_list_t* local_cnxid_list = test_ctx->cnx_client->first_local_cnxid_list;\n550\t\n551\t    while (local_cnxid_list != NULL) {\n552\t        if (!local_cnxid_list->is_demoted &&\n553\t            local_cnxid_list->unique_path_id != 0 &&\n554\t            local_cnxid_list->unique_path_id < deleted_id) {\n555\t            deleted_id = local_cnxid_list->unique_path_id;\n556\t        }\n557\t        local_cnxid_list = local_cnxid_list->next_list;\n558\t    }\n559\t    if (deleted_id == UINT64_MAX) {\n560\t        ret = -1;\n561\t    }\n562\t    else {\n563\t        ret = picoquic_abandon_path(test_ctx->cnx_client, deleted_id, 0, *simulated_time);\n564\t        if (ret != 0) {\n565\t            DBG_PRINTF(\"Could not abandon path %\" PRIu64 \", ret=%d\", deleted_id, ret);\n566\t        }\n567\t        else {\n568\t            /* wait about 250ms for the abandon to be noticed at both ends. */\n569\t            ret = tls_api_wait_for_timeout(test_ctx, simulated_time, 250000);\n570\t            if (ret != 0) {\n571\t                DBG_PRINTF(\"Issue after abandon path %\" PRIu64 \", ret = %d\", deleted_id, ret);\n572\t            }\n573\t        }\n574\t    }\n575\t    /* Verify that the deleted ID is gone. */\n576\t    if (ret == 0) {\n577\t        picoquic_local_cnxid_list_t* local_cnxid_list = test_ctx->cnx_client->first_local_cnxid_list;\n578\t\n579\t        while (local_cnxid_list != NULL) {\n580\t            if (local_cnxid_list->unique_path_id == deleted_id) {\n581\t                DBG_PRINTF(\"Deleted ID %\" PRIu64 \" is still present\", deleted_id);\n582\t                ret = -1;\n583\t                break;\n584\t            }\n585\t            local_cnxid_list = local_cnxid_list->next_list;\n586\t        }\n587\t    }\n588\t    if (ret == 0) {\n589\t        int stash_count = 0;\n590\t        /* Verify that we have enough remote path ID to continue. */\n591\t        for (int i = 0; i <= 10 && ret == 0; i++) {\n592\t            picoquic_remote_cnxid_stash_t* remote_cnxid_stash = test_ctx->cnx_client->first_remote_cnxid_stash;\n593\t\n594\t            stash_count = 0;\n595\t            while (remote_cnxid_stash != NULL) {\n596\t                stash_count++;\n597\t                remote_cnxid_stash = remote_cnxid_stash->next_stash;\n598\t            }\n599\t"}]},"parent_tool_use_id":null,"session_id":"dd2036ff-0dd1-48ca-b8bf-92c20dcaef2a","uuid":"ccf2c08e-4d6b-4dcb-8c03-e2f488ff4ec5","timestamp":"2026-05-05T04:10:21.524Z","tool_use_result":{"type":"text","file":{"filePath":"/Users/richbarn/Projects/picoquic/picoquictest/multipath_test.c","content":"                picoquic_compare_addr((struct sockaddr*) & old_dest, (struct sockaddr*) & test_ctx->cnx_server->path[0]->first_tuple->local_addr) == 0))){\n        was_active = 0;\n        nb_trials++;\n\n        ret = tls_api_one_sim_round(test_ctx, simulated_time, time_out, &was_active);\n\n        if (was_active) {\n            nb_inactive = 0;\n        }\n        else {\n            nb_inactive++;\n        }\n    }\n\n    if (ret != 0 || (test_ctx->cnx_client->cnx_state != picoquic_state_ready ||\n        (picoquic_compare_addr((struct sockaddr*) & old_srce, (struct sockaddr*) & test_ctx->cnx_client->path[0]->first_tuple->local_addr) == 0 &&\n            picoquic_compare_addr((struct sockaddr*) & old_dest, (struct sockaddr*) & test_ctx->cnx_client->path[0]->first_tuple->peer_addr) == 0))\n        ||\n        (picoquic_compare_addr((struct sockaddr *) & old_srce, (struct sockaddr*) & test_ctx->cnx_server->path[0]->first_tuple->peer_addr) == 0 &&\n            picoquic_compare_addr((struct sockaddr*) & old_dest, (struct sockaddr*) & test_ctx->cnx_server->path[0]->first_tuple->local_addr) == 0)){\n        DBG_PRINTF(\"Could not complete migration, client state = %d\\n\",\n            test_ctx->cnx_client->cnx_state);\n        ret = -1;\n    }\n\n    return ret;\n}\n\n\n/* Controlled migration test.\n * Create a basic connection.\n * Run until the handshake is done.\n * Start a migration.\n * Verify that the transfer completes */\n\n#define MIGRATION_TRACE_BIN \"migration_trace.bin\"\n\n\nstatic test_api_stream_desc_t test_scenario_multipath[] = {\n    { 4, 0, 257, 1000000 },\n    { 8, 4, 257, 1000000 }\n};\n\nstatic test_api_stream_desc_t test_scenario_multipath_long[] = {\n    { 4, 0, 257, 1000000 },\n    { 8, 0, 257, 1000000 },\n    { 12, 0, 257, 1000000 },\n    { 16, 0, 257, 1000000 },\n    { 20, 0, 257, 1000000 },\n    { 24, 0, 257, 1000000 },\n    { 28, 0, 257, 1000000 },\n    { 32, 0, 257, 1000000 },\n    { 36, 0, 257, 1000000 },\n    { 40, 0, 257, 1000000 }\n};\n\nint migration_test_one(int mtu_drop)\n{\n    uint64_t simulated_time = 0;\n    uint64_t loss_mask = 0;\n    uint64_t max_completion_microsec = 2100000;\n    picoquic_test_tls_api_ctx_t* test_ctx = NULL;\n    picoquic_connection_id_t initial_cid = { {0x1a, 0x10, 0xc0, 4, 5, 6, 7, 8}, 8 };\n    int ret;\n\n    if (mtu_drop) {\n        initial_cid.id[2] = 0xcd;\n    }\n    \n    ret = tls_api_init_ctx_ex(&test_ctx, PICOQUIC_INTERNAL_TEST_VERSION_1,\n        PICOQUIC_TEST_SNI, PICOQUIC_TEST_ALPN, &simulated_time, NULL, NULL, 0, 0, 0, &initial_cid);\n\n    if (mtu_drop) {\n        /* The MTU drop test is specifically orientated towards verifying retransmissions,\n         * which requires simulating losses */\n        loss_mask |= (((uint64_t)1) << 31);\n    }\n\n    if (ret == 0 && test_ctx == NULL) {\n        ret = -1;\n    }\n    else {\n        picoquic_set_binlog(test_ctx->qserver, \".\");\n        test_ctx->qserver->use_long_log = 1;\n    }\n\n    /* establish the connection*/\n    if (ret == 0) {\n        ret = tls_api_connection_loop(test_ctx, &loss_mask, 0, &simulated_time);\n    }\n\n    /* Prepare to send data */\n    if (ret == 0) {\n        ret = test_api_init_send_recv_scenario(test_ctx, test_scenario_multipath, sizeof(test_scenario_multipath));\n\n        if (ret != 0)\n        {\n            DBG_PRINTF(\"Init send receive scenario returns %d\\n\", ret);\n        }\n    }\n\n    /* wait until the client (and thus the server) is ready */\n    if (ret == 0) {\n        ret = wait_client_connection_ready(test_ctx, &simulated_time);\n    }\n\n    /* Add the multipath links and initiate the migration */\n    if (ret == 0) {\n        ret = multipath_test_add_links(test_ctx, mtu_drop);\n    }\n\n    if (ret == 0) {\n        ret = picoquic_probe_new_path(test_ctx->cnx_client, (struct sockaddr*) & test_ctx->server_addr,\n            (struct sockaddr*) & test_ctx->client_addr_2, simulated_time);\n    }\n\n    /* Check that the migration succeeds */\n    if (ret == 0) {\n        ret = wait_client_migration_done(test_ctx, &simulated_time);\n    }\n\n    /* Kill the old links, so nothing more can be sent there */\n    if (ret == 0) {\n        multipath_test_kill_links(test_ctx, 0);\n    }\n\n    /* Perform a data sending loop */\n    if (ret == 0) {\n        ret = tls_api_data_sending_loop(test_ctx, &loss_mask, &simulated_time, 0);\n\n        if (ret != 0)\n        {\n            DBG_PRINTF(\"Data sending loop returns %d\\n\", ret);\n        }\n    }\n\n    /* Check that the transmission succeeded */\n    if (ret == 0) {\n        ret = tls_api_one_scenario_body_verify(test_ctx, &simulated_time, max_completion_microsec);\n    }\n\n    /* Check that the default client address on the server was migrated,\n     * as well as the default source address on the client */\n    if (ret == 0 && test_ctx->cnx_server == NULL) {\n        /* No server connection! */\n        ret = -1;\n    }\n\n    if (ret == 0) {\n        struct sockaddr* c_addr_at_server = NULL;\n        struct sockaddr* c_addr_at_client = NULL;\n        picoquic_get_peer_addr(test_ctx->cnx_server, &c_addr_at_server);\n        picoquic_get_local_addr(test_ctx->cnx_client, &c_addr_at_client);\n\n        if (picoquic_compare_addr((struct sockaddr*) & test_ctx->client_addr_2, c_addr_at_server) != 0 ||\n            picoquic_compare_addr((struct sockaddr*) & test_ctx->client_addr_2, c_addr_at_client) != 0) {\n            /* Migration was not completed */\n            ret = -1;\n        }\n    }\n\n    /* Delete the context */\n    if (test_ctx != NULL) {\n        tls_api_delete_ctx(test_ctx);\n    }\n\n    return ret;\n}\n\nint migration_controlled_test(void)\n{\n    return migration_test_one(0);\n}\n\nint migration_mtu_drop_test(void)\n{\n    return migration_test_one(1);\n}\n\n/*\n * Test of actual multipath, by opposition to only migration.\n */\n\nvoid multipath_init_params(picoquic_tp_t *test_parameters, int enable_time_stamp)\n{\n    memset(test_parameters, 0, sizeof(picoquic_tp_t));\n\n    picoquic_init_transport_parameters(test_parameters);\n    test_parameters->initial_max_path_id = 2;\n    test_parameters->enable_time_stamp = 3* enable_time_stamp;\n}\n\n/* wait until the migration completes */\nint wait_multipath_ready(picoquic_test_tls_api_ctx_t* test_ctx,\n    uint64_t* simulated_time)\n{\n    int ret = 0;\n    uint64_t time_out = *simulated_time + 4000000;\n    int nb_trials = 0;\n    int nb_inactive = 0;\n    int was_active = 0;\n    struct sockaddr_storage old_srce;\n    struct sockaddr_storage old_dest;\n\n    /* Check the selected path */\n    picoquic_store_addr(&old_srce, (struct sockaddr*) & test_ctx->cnx_client->path[0]->first_tuple->local_addr);\n    picoquic_store_addr(&old_dest, (struct sockaddr*) & test_ctx->cnx_client->path[0]->first_tuple->peer_addr);\n\n    while (*simulated_time < time_out &&\n        ret == 0 &&\n        test_ctx->cnx_client->cnx_state == picoquic_state_ready &&\n        nb_trials < 5000 &&\n        nb_inactive < 64 &&\n        (test_ctx->cnx_client->nb_paths != 2 ||\n        !test_ctx->cnx_client->path[1]->first_tuple->challenge_verified ||\n        (test_ctx->cnx_server == NULL || (test_ctx->cnx_server->nb_paths != 2 ||\n        !test_ctx->cnx_server->path[1]->first_tuple->challenge_verified)))){\n        nb_trials++;\n\n        ret = tls_api_one_sim_round(test_ctx, simulated_time, time_out, &was_active);\n\n        if (was_active) {\n            nb_inactive = 0;\n        }\n        else {\n            nb_inactive++;\n        }\n    }\n\n    if (ret == 0 && (test_ctx->cnx_client->cnx_state != picoquic_state_ready ||\n        (test_ctx->cnx_client->nb_paths != 2 ||\n            !test_ctx->cnx_client->path[1]->first_tuple->challenge_verified) ||\n            (test_ctx->cnx_server == NULL || (test_ctx->cnx_server->nb_paths != 2 ||\n                !test_ctx->cnx_server->path[1]->first_tuple->challenge_verified)))) {\n        DBG_PRINTF(\"Could not establish multipath, client state = %d\\n\",\n            test_ctx->cnx_client->cnx_state);\n        ret = -1;\n    }\n\n    return ret;\n}\n\ntypedef enum {\n    multipath_test_basic = 0,\n    multipath_test_drop_first,\n    multipath_test_drop_second,\n    multipath_test_sat_plus,\n    multipath_test_renew,\n    multipath_test_rotation,\n    multipath_test_nat,\n    multipath_test_nat_challenge,\n    multipath_test_break1,\n    multipath_test_break2,\n    multipath_test_break3,\n    multipath_test_back0,\n    multipath_test_back1,\n    multipath_test_perf,\n    multipath_test_callback,\n    multipath_test_quality,\n    multipath_test_quality_server,\n    multipath_test_stream_af,\n    multipath_test_abandon,\n    multipath_test_datagram,\n    multipath_test_dg_af,\n    multipath_test_backup,\n    multipath_test_standup,\n    multipath_test_tunnel,\n    multipath_test_fail,\n    multipath_test_ab1,\n    multipath_test_discovery,\n    multipath_test_keep_alive,\n    multipath_test_just_one,\n    multipath_test_break_both,\n} multipath_test_enum_t;\n\n#ifdef _WINDOWS\n#define PATH_CALLBACK_TEST_REF \"picoquictest\\\\path_callback_ref.txt\"\n#define PATH_QUALITY_TEST_REF \"picoquictest\\\\path_quality_ref.txt\"\n#define PATH_QUALITY_SERVER_REF \"picoquictest\\\\path_quality_server_ref.txt\"\n#else\n#define PATH_CALLBACK_TEST_REF \"picoquictest/path_callback_ref.txt\"\n#define PATH_QUALITY_TEST_REF \"picoquictest/path_quality_ref.txt\"\n#define PATH_QUALITY_SERVER_REF \"picoquictest/path_quality_server_ref.txt\"\n#endif\n#define PATH_CALLBACK_CSV \"path_callback.csv\"\n#define PATH_QUALITY_CSV \"path_quality.csv\"\n#define PATH_QUALITY_SERVER \"path_quality_server.csv\"\n\nint multipath_init_callbacks(picoquic_test_tls_api_ctx_t* test_ctx, multipath_test_enum_t test_id)\n{\n    int ret = 0;\n    char const* filename = (test_id == multipath_test_callback) ? PATH_CALLBACK_CSV :\n        ((test_id == multipath_test_quality) ? PATH_QUALITY_CSV : PATH_QUALITY_SERVER);\n    /* Open a file to log bandwidth updates and document it in context */\n    test_ctx->path_events = picoquic_file_open(filename, \"w\");\n    if (test_ctx->path_events == NULL) {\n        DBG_PRINTF(\"Could not write file <%s>\", filename);\n        ret = -1;\n    }\n    else {\n        if (test_id == multipath_test_quality_server) {\n            picoquic_enable_path_callbacks_default(test_ctx->qserver, 1);\n            picoquic_default_quality_update(test_ctx->qserver, 50000, 5000);\n        }\n        else {\n            picoquic_enable_path_callbacks(test_ctx->cnx_client, 1);\n            if (test_id == multipath_test_quality) {\n                picoquic_subscribe_to_quality_update(test_ctx->cnx_client, 50000, 5000);\n                ret = picoquic_subscribe_to_quality_update_per_path(test_ctx->cnx_client, 0, 50000, 5000);\n            }\n            if (test_id == multipath_test_callback) {\n                int is_already_allowed = 0;\n                ret = picoquic_subscribe_new_path_allowed(test_ctx->cnx_client, &is_already_allowed);\n            }\n        }\n        if (test_id == multipath_test_callback) {\n            fprintf(test_ctx->path_events, \"Time, Path-ID, Event,\\n\");\n        }\n        else {\n            fprintf(test_ctx->path_events, \"Time, Path-ID, Event, Pacing_rate, Receive Rate, CWIN, RTT\\n\");\n        }\n    }\n    return ret;\n}\n\nint multipath_verify_callbacks(multipath_test_enum_t test_id)\n{\n    int ret = 0;\n    char file_ref[512];\n    char const* filename = (test_id == multipath_test_callback) ? PATH_CALLBACK_CSV : \n        ((test_id == multipath_test_quality)?PATH_QUALITY_CSV:PATH_QUALITY_SERVER);\n    char const* ref_name = (test_id == multipath_test_callback) ? PATH_CALLBACK_TEST_REF : \n        ((test_id == multipath_test_quality)?PATH_QUALITY_TEST_REF:PATH_QUALITY_SERVER_REF);\n\n    ret = picoquic_get_input_path(file_ref, sizeof(file_ref), picoquic_solution_dir, ref_name);\n\n    if (ret != 0) {\n        DBG_PRINTF(\"Cannot set the reference file name for test id: %s.\\n\", (int)test_id);\n    }\n    else {\n        ret = picoquic_test_compare_text_files(filename, file_ref);\n    }\n    return ret;\n}\n\nstatic int multipath_test_abandon_cycle(picoquic_test_tls_api_ctx_t* test_ctx, uint64_t* simulated_time)\n{\n    int ret = 0;\n    uint64_t deleted_id = UINT64_MAX;\n    picoquic_local_cnxid_list_t* local_cnxid_list = test_ctx->cnx_client->first_local_cnxid_list;\n\n    while (local_cnxid_list != NULL) {\n        if (!local_cnxid_list->is_demoted &&\n            local_cnxid_list->unique_path_id != 0 &&\n            local_cnxid_list->unique_path_id < deleted_id) {\n            deleted_id = local_cnxid_list->unique_path_id;\n        }\n        local_cnxid_list = local_cnxid_list->next_list;\n    }\n    if (deleted_id == UINT64_MAX) {\n        ret = -1;\n    }\n    else {\n        ret = picoquic_abandon_path(test_ctx->cnx_client, deleted_id, 0, *simulated_time);\n        if (ret != 0) {\n            DBG_PRINTF(\"Could not abandon path %\" PRIu64 \", ret=%d\", deleted_id, ret);\n        }\n        else {\n            /* wait about 250ms for the abandon to be noticed at both ends. */\n            ret = tls_api_wait_for_timeout(test_ctx, simulated_time, 250000);\n            if (ret != 0) {\n                DBG_PRINTF(\"Issue after abandon path %\" PRIu64 \", ret = %d\", deleted_id, ret);\n            }\n        }\n    }\n    /* Verify that the deleted ID is gone. */\n    if (ret == 0) {\n        picoquic_local_cnxid_list_t* local_cnxid_list = test_ctx->cnx_client->first_local_cnxid_list;\n\n        while (local_cnxid_list != NULL) {\n            if (local_cnxid_list->unique_path_id == deleted_id) {\n                DBG_PRINTF(\"Deleted ID %\" PRIu64 \" is still present\", deleted_id);\n                ret = -1;\n                break;\n            }\n            local_cnxid_list = local_cnxid_list->next_list;\n        }\n    }\n    if (ret == 0) {\n        int stash_count = 0;\n        /* Verify that we have enough remote path ID to continue. */\n        for (int i = 0; i <= 10 && ret == 0; i++) {\n            picoquic_remote_cnxid_stash_t* remote_cnxid_stash = test_ctx->cnx_client->first_remote_cnxid_stash;\n\n            stash_count = 0;\n            while (remote_cnxid_stash != NULL) {\n                stash_count++;\n                remote_cnxid_stash = remote_cnxid_stash->next_stash;\n            }\n","numLines":400,"startLine":200,"totalLines":2027}}}
