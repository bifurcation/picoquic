 (ret != 0) {\n537\t        DBG_PRINTF(\"Cannot set the reference file name for test id: %s.\\n\", (int)test_id);\n538\t    }\n539\t    else {\n540\t        ret = picoquic_test_compare_text_files(filename, file_ref);\n541\t    }\n542\t    return ret;\n543\t}\n544\t\n545\tstatic int multipath_test_abandon_cycle(picoquic_test_tls_api_ctx_t* test_ctx, uint64_t* simulated_time)\n546\t{\n547\t    int ret = 0;\n548\t    uint64_t deleted_id = UINT64_MAX;\n549\t    picoquic_local_cnxid_list_t* local_cnxid_list = test_ctx->cnx_client->first_local_cnxid_list;\n550\t\n551\t    while (local_cnxid_list != NULL) {\n552\t        if (!local_cnxid_list->is_demoted &&\n553\t            local_cnxid_list->unique_path_id != 0 &&\n554\t            local_cnxid_list->unique_path_id < deleted_id) {\n555\t            deleted_id = local_cnxid_list->unique_path_id;\n556\t        }\n557\t        local_cnxid_list = local_cnxid_list->next_list;\n558\t    }\n559\t    if (deleted_id == UINT64_MAX) {\n560\t        ret = -1;\n561\t    }\n562\t    else {\n563\t        ret = picoquic_abandon_path(test_ctx->cnx_client, deleted_id, 0, *simulated_time);\n564\t        if (ret != 0) {\n565\t            DBG_PRINTF(\"Could not abandon path %\" PRIu64 \", ret=%d\", deleted_id, ret);\n566\t        }\n567\t        else {\n568\t            /* wait about 250ms for the abandon to be noticed at both ends. */\n569\t            ret = tls_api_wait_for_timeout(test_ctx, simulated_time, 250000);\n570\t            if (ret != 0) {\n571\t                DBG_PRINTF(\"Issue after abandon path %\" PRIu64 \", ret = %d\", deleted_id, ret);\n572\t            }\n573\t        }\n574\t    }\n575\t    /* Verify that the deleted ID is gone. */\n576\t    if (ret == 0) {\n577\t        picoquic_local_cnxid_list_t* local_cnxid_list = test_ctx->cnx_client->first_local_cnxid_list;\n578\t\n579\t        while (local_cnxid_list != NULL) {\n580\t            if (local_cnxid_list->unique_path_id == deleted_id) {\n581\t                DBG_PRINTF(\"Deleted ID %\" PRIu64 \" is still present\", deleted_id);\n582\t                ret = -1;\n583\t                break;\n584\t            }\n585\t            local_cnxid_list = local_cnxid_list->next_list;\n586\t        }\n587\t    }\n588\t    if (ret == 0) {\n589\t        int stash_count = 0;\n590\t        /* Verify that we have enough remote path ID to continue. */\n591\t        for (int i = 0; i <= 10 && ret == 0; i++) {\n592\t            picoquic_remote_cnxid_stash_t* remote_cnxid_stash = test_ctx->cnx_client->first_remote_cnxid_stash;\n593\t\n594\t            stash_count = 0;\n595\t            while (remote_cnxid_stash != NULL) {\n596\t                stash_count++;\n597\t                remote_cnxid_stash = remote_cnxid_stash->next_stash;\n598\t            }\n599\t\n600\t            if (stash_count >= 2) {\n601\t                break;\n602\t            }\n603\t            else if (i < 10 && stash_count < 2) {\n604\t                ret = tls_api_wait_for_timeout(test_ctx, simulated_time, 100000);\n605\t            }\n606\t        }\n607\t        if (stash_count < 2) {\n608\t            DBG_PRINTF(\"Only %d stashes of CID available\", stash_count);\n609\t            ret = -1;\n610\t        }\n611\t    }\n612\t\n613\t    return ret;\n614\t}\n615\t\n616\tvoid multipath_init_datagram_ctx(picoquic_test_tls_api_ctx_t* test_ctx, test_datagram_send_recv_ctx_t * dg_ctx)\n617\t{\n618\t    /* Initialize the datagram targets as a function of the test id */\n619\t    memset(dg_ctx, 0, sizeof(test_datagram_send_recv_ctx_t));\n620\t    dg_ctx->dg_max_size = PICOQUIC_MAX_PACKET_SIZE;\n621\t    dg_ctx->dg_target[0] = 100;\n622\t    dg_ctx->dg_target[1] = 100;\n623\t    dg_ctx->send_delay = 3000;\n624\t    /* Set the test contexts for sending and receiving datagrams */\n625\t    test_ctx->datagram_ctx = dg_ctx;\n626\t    test_ctx->datagram_recv_fn = test_datagram_recv;\n627\t    test_ctx->datagram_send_fn = test_datagram_send;\n628\t    test_ctx->datagram_ack_fn = test_datagram_ack;\n629\t    /* Enable multipath callbacks */\n630\t    picoquic_enable_path_callbacks_default(test_ctx->qserver, 1);\n631\t    picoquic_enable_path_callbacks(test_ctx->cnx_client, 1);\n632\t    /* Use the extended datagram API */\n633\t    dg_ctx->use_extended_provider_api = 1;\n634\t}\n635\t\n636\tint multipath_set_datagram_ready(picoquic_test_tls_api_ctx_t* test_ctx, test_datagram_send_recv_ctx_t* dg_ctx, multipath_test_enum_t test_id)\n637\t{\n638\t    int ret = 0;\n639\t    /* Mark datagram ready, start to send. */\n640\t    if (test_id == multipath_test_datagram) {\n641\t        /* sending on any path */\n642\t        ret = picoquic_mark_datagram_ready(test_ctx->cnx_client, 1);\n643\t        if (ret == 0) {\n644\t            ret = picoquic_mark_datagram_ready(test_ctx->cnx_server, 1);\n645\t        }\n646\t    }\n647\t    else {\n648\t        /* Only wake up path 0 */\n649\t        dg_ctx->test_affinity = 1;\n650\t        ret = picoquic_mark_datagram_ready_path(test_ctx->cnx_client, 0, 1);\n651\t        if (ret == 0) {\n652\t            ret = picoquic_mark_datagram_ready_path(test_ctx->cnx_server, 0, 1);\n653\t        }\n654\t    }\n655\t    return ret;\n656\t}\n657\t\n658\tint multipath_verify_datagram_sent(test_datagram_send_recv_ctx_t* dg_ctx, multipath_test_enum_t test_id)\n659\t{\n660\t    int ret = 0;\n661\t\n662\t    /* Verify datagrams have been received -- 3/4 will be enough */\n663\t    if (4*dg_ctx->dg_recv[0] < 3*dg_ctx->dg_target[1] ||\n664\t        4*dg_ctx->dg_recv[1] < 3*dg_ctx->dg_target[0]) {\n665\t        DBG_PRINTF(\"%s\", \"Did not receive expected datagrams: \");\n666\t        for (int i = 0; i < 2; i++) {\n667\t            DBG_PRINTF(\"dg_target[%d]=%d, dg_sent[%d]=%d, dg_recv[%d]=%d\",\n668\t                i, dg_ctx->dg_target[i], i, dg_ctx->dg_sent[i], 1 - i, dg_ctx->dg_recv[1 - i]);\n669\t            ret = -1;\n670\t        }\n671\t    }\n672\t    if (ret == 0) {\n673\t        if (test_id == multipath_test_datagram) {\n674\t            for (int i = 0; ret == 0 && i < 2; i++) {\n675\t                int min_expected = dg_ctx->dg_recv[i] / 8;\n676\t\n677\t                if (dg_ctx->nb_recv_path_0[i] < min_expected ||\n678\t                    dg_ctx->nb_recv_path_other[i] < min_expected) {\n679\t                    DBG_PRINTF(\"Datagram not balanced, %s received %d on path 0, %d on others\",\n680\t                        (i) ? \"client\" : \"server\", dg_ctx->nb_recv_path_0[i], dg_ctx->nb_recv_path_other[i]);\n681\t                    ret = -1;\n682\t                }\n683\t            }\n684\t        }\n685\t        else if (test_id == multipath_test_dg_af) {\n686\t            for (int i = 0; ret == 0 && i < 2; i++) {\n687\t                if (dg_ctx->nb_recv_path_other[i] > 0) {\n688\t                    DBG_PRINTF(\"Datagram affinity fails, %s received %d on path 0, %d on others\",\n689\t                        (i) ? \"client\" : \"server\", dg_ctx->nb_recv_path_0[i], dg_ctx->nb_recv_path_other[i]);\n690\t                    ret = -1;\n691\t                }\n692\t            }\n693\t        }\n694\t    }\n695\t    return ret;\n696\t}\n697\t\n698\tstatic int multipath_verify_all_cid_available(picoquic_cnx_t* cnx)\n699\t{\n700\t    int ret = 0;\n701\t    uint64_t unique_id_max = 0;\n702\t    picoquic_remote_cnxid_stash_t* stash = cnx->first_remote_cnxid_stash;\n703\t\n704\t    while (stash != NULL) {\n705\t        if (stash->unique_path_id > unique_id_max) {\n706\t            unique_id_max = stash->unique_path_id;\n707\t        }\n708\t        stash = stash->next_stash;\n709\t    }\n710\t    if (unique_id_max < cnx->max_path_id_local && unique_id_max < cnx->max_path_id_remote) {\n711\t        ret = -1;\n712\t    }\n713\t    return ret;\n714\t}\n715\t\n716\tint multipath_datagram_send_loop(picoquic_test_tls_api_ctx_t* test_ctx,\n717\t    test_datagram_send_recv_ctx_t* dg_ctx, uint64_t* loss_mask, uint64_t* simulated_time)\n718\t{\n719\t    int ret = 0;\n720\t    int nb_trials = 0;\n721\t    int nb_inactive = 0;\n722\t\n723\t    test_ctx->c_to_s_link->loss_mask = loss_mask;\n724\t    test_ctx->s_to_c_link->loss_mask = loss_mask;\n725\t\n726\t    while (ret == 0 && nb_trials < 16000 && nb_inactive < 512 && TEST_CLIENT_READY && TEST_SERVER_READY) {\n727\t        int was_active = 0;\n728\t        uint64_t time_out = test_datagram_next_time_ready(dg_ctx);\n729\t        nb_trials++;\n730\t\n731\t        ret = tls_api_one_sim_round(test_ctx, simulated_time, time_out, &was_active);\n732\t\n733\t        if (ret < 0) {\n734\t            break;\n735\t        }\n736\t\n737\t        if (was_active) {\n738\t            nb_inactive = 0;\n739\t        } else {\n740\t            nb_inactive++;\n741\t        }\n742\t\n743\t        /* Simulate wake up when data is ready for real time operation */\n744\t        for (int i = 0; i < 2; i++) {\n745\t            picoquic_cnx_t* cnx = (i == 0) ? test_ctx->cnx_server : test_ctx->cnx_client;\n746\t            if (!dg_ctx->is_ready[i] && test_datagram_check_ready(dg_ctx, i, *simulated_time)) {\n747\t                if (dg_ctx->test_affinity) {\n748\t                    picoquic_mark_datagram_ready_path(cnx, 0, 1);\n749\t                }"}]},"parent_tool_use_id":null,"session_id":"dd2036ff-0dd1-48ca-b8bf-92c20dcaef2a","uuid":"010fdaa3-5e3b-48be-bdd1-281823c71497","timestamp":"2026-05-05T04:42:16.878Z","tool_use_result":{"type":"text","file":{"filePath":"/Users/richbarn/Projects/picoquic/picoquictest/multipath_test.c","content":"        if (test_id == multipath_test_quality_server) {\n            picoquic_enable_path_callbacks_default(test_ctx->qserver, 1);\n            picoquic_default_quality_update(test_ctx->qserver, 50000, 5000);\n        }\n        else {\n            picoquic_enable_path_callbacks(test_ctx->cnx_client, 1);\n            if (test_id == multipath_test_quality) {\n                picoquic_subscribe_to_quality_update(test_ctx->cnx_client, 50000, 5000);\n                ret = picoquic_subscribe_to_quality_update_pe