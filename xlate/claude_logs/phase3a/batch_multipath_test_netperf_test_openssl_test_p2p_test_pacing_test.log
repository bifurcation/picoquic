{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01YTpH7Xb2MGhcyt7USDzzvZ","type":"tool_result","content":"1\t//! Test cases for `picoquictest/datagram_tests.c`.\n2\t//!\n3\t//! Exercises datagram send/receive over a simulated QUIC connection.\n4\t//! Tests cover the basic path, real-time delivery with latency targets,\n5\t//! skip behaviour, loss accounting, size limits, small-datagram batching,\n6\t//! packet-per-datagram mode, wifi-spike recovery, and the too-long API.\n7\t\n8\t#![allow(non_snake_case)]\n9\t\n10\tuse crate::MAX_PACKET_SIZE;\n11\t\n12\t// ---------------------------------------------------------------------------\n13\t// Shared context type.  C: `test_datagram_send_recv_ctx_t`.\n14\t\n15\t/// Per-test state for the datagram send/receive callbacks.\n16\t/// C: `test_datagram_send_recv_ctx_t` in `picoquictest/datagram_tests.c`.\n17\t#[derive(Default)]\n18\t#[allow(dead_code)]\n19\tstruct DatagramSendRecvCtx {\n20\t    /// Maximum datagram payload the client advertises.\n21\t    dg_max_size: usize,\n22\t    /// Number of datagrams to send in each direction [client, server].\n23\t    dg_target: [u64; 2],\n24\t    dg_sent: [u64; 2],\n25\t    dg_recv: [u64; 2],\n26\t    dg_acked: [u64; 2],\n27\t    dg_nacked: [u64; 2],\n28\t    dg_spurious: [u64; 2],\n29\t    dg_latency_max: [u64; 2],\n30\t    /// Maximum acceptable one-way latency (0 = unchecked).\n31\t    dg_latency_target: [u64; 2],\n32\t    dg_number_delta_max: [u64; 2],\n33\t    dg_number_delta_target: [u64; 2],\n34\t    dg_received_last: [u64; 2],\n35\t    dg_time_ready: [u64; 2],\n36\t    /// Time at which the next datagram generation is scheduled.\n37\t    next_gen_time: [u64; 2],\n38\t    /// Interval between consecutive datagrams (µs).\n39\t    send_delay: u64,\n40\t    is_ready: [bool; 2],\n41\t    is_skipping: [bool; 2],\n42\t    /// Enable the \"skip one slot\" test path.\n43\t    do_skip_test: [bool; 2],\n44\t    /// Use the extended `provide_datagram_buffer_ex` API.\n45\t    use_extended_provider_api: bool,\n46\t    /// Restrict to one datagram per QUIC packet.\n47\t    one_datagram_per_packet: bool,\n48\t    /// Bind datagrams to path 0 only.\n49\t    test_affinity: bool,\n50\t    /// Exercise the too-long datagram rejection path.\n51\t    test_too_long: bool,\n52\t    /// Exercise a wifi-style transmission suspension.\n53\t    test_wifi: bool,\n54\t    /// If non-zero, cap each datagram at this size.\n55\t    dg_small_size: usize,\n56\t    /// Batch multiple datagrams per generation tick (0 = no batching).\n57\t    batch_size: [u64; 2],\n58\t    /// Assert client received at most this many packets (0 = unchecked).\n59\t    max_packets_received: u64,\n60\t    /// Assert simulation ends by this time in µs (0 = unchecked).\n61\t    duration_max: u64,\n62\t    /// Override the default trial limit (0 = use 2048).\n63\t    nb_trials_max: i32,\n64\t    /// Override default link latency in µs (0 = keep default).\n65\t    link_latency: u64,\n66\t    /// Override link data rate in ps/byte (0 = keep default).\n67\t    picosec_per_byte: u64,\n68\t}\n69\t\n70\t/// Run one datagram scenario end-to-end.\n71\t/// C: `datagram_test_one` in `picoquictest/datagram_tests.c`.\n72\tfn datagram_test_one(_test_id: u8, _dg_ctx: &mut DatagramSendRecvCtx, _loss_mask_init: u64) {\n73\t    todo!(\"datagram_test_one: simulation loop not yet implemented\")\n74\t}\n75\t\n76\t// ---------------------------------------------------------------------------\n77\t// Test entries.\n78\t\n79\t/// C: `datagram_test` in `picoquictest/datagram_tests.c`.\n80\t#[test]"}]},"parent_tool_use_id":null,"session_id":"dd2036ff-0dd1-48ca-b8bf-92c20dcaef2a","uuid":"62a1ec75-4514-410f-9c45-5ba084ba4f86","timestamp":"2026-05-05T04:14:35.764Z","tool_use_result":{"type":"text","file":{"filePath":"/Users/richbarn/Projects/picoquic/rs/fq/src/tests/datagram.rs","content":"//! Test cases for `picoquictest/datagram_tests.c`.\n//!\n//! Exercises datagram send/receive over a simulated QUIC connection.\n//! Tests cover the basic path, real-time delivery with latency targets,\n//! skip behaviour, loss accounting, size limits, small-datagram batching,\n//! packet-per-datagram mode, wifi-spike recovery, and the too-long API.\n\n#![allow(non_snake_case)]\n\nuse crate::MAX_PACKET_SIZE;\n\n// ---------------------------------------------------------------------------\n// Shared context type.  C: `test_datagram_send_recv_ctx_t`.\n\n/// Per-test state for the datagram send/receive callbacks.\n/// C: `test_datagram_send_recv_ctx_t` in `picoquictest/datagram_tests.c`.\n#[derive(Default)]\n#[allow(dead_code)]\nstruct DatagramSendRecvCtx {\n    /// Maximum datagram payload the client advertises.\n    dg_max_size: usize,\n    /// Number of datagrams to send in each direction [client, server].\n    dg_target: [u64; 2],\n    dg_sent: [u64; 2],\n    dg_recv: [u64; 2],\n    dg_acked: [u64; 2],\n    dg_nacked: [u64; 2],\n    dg_spurious: [u64; 2],\n    dg_latency_max: [u64; 2],\n    /// Maximum acceptable one-way latency (0 = unchecked).\n    dg_latency_target: [u64; 2],\n    dg_number_delta_max: [u64; 2],\n    dg_number_delta_target: [u64; 2],\n    dg_received_last: [u64; 2],\n    dg_time_ready: [u64; 2],\n    /// Time at which the next datagram generation is scheduled.\n    next_gen_time: [u64; 2],\n    /// Interval between consecutive datagrams (µs).\n    send_delay: u64,\n    is_ready: [bool; 2],\n    is_skipping: [bool; 2],\n    /// Enable the \"skip one slot\" test path.\n    do_skip_test: [bool; 2],\n    /// Use the extended `provide_datagram_buffer_ex` API.\n    use_extended_provider_api: bool,\n    /// Restrict to one datagram per QUIC packet.\n    one_datagram_per_packet: bool,\n    /// Bind datagrams to path 0 only.\n    test_affinity: bool,\n    /// Exercise the too-long datagram rejection path.\n    test_too_long: bool,\n    /// Exercise a wifi-style transmission suspension.\n    test_wifi: bool,\n    /// If non-zero, cap each datagram at this size.\n   