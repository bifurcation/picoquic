{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01Vr8Qm9ox1A55ofeDoHhAM7","type":"tool_result","content":"100\tstatic void multipath_test_set_reachable(picoquic_test_tls_api_ctx_t* test_ctx, int link_id)\n101\t{\n102\t    if (link_id == 0) {\n103\t        test_ctx->c_to_s_link->is_unreachable = 0;\n104\t        test_ctx->s_to_c_link->is_unreachable = 0;\n105\t    }\n106\t    else {\n107\t        test_ctx->c_to_s_link_2->is_unreachable = 0;\n108\t        test_ctx->s_to_c_link_2->is_unreachable = 0;\n109\t    }\n110\t}\n111\t\n112\tstatic void multipath_test_unkill_links(picoquic_test_tls_api_ctx_t* test_ctx, int link_id, uint64_t current_time)\n113\t{\n114\t    /* Make sure that nothing gets sent on the old links */\n115\t    if (link_id == 0) {\n116\t        test_ctx->c_to_s_link->next_send_time = current_time;\n117\t        test_ctx->c_to_s_link->is_switched_off = 0;\n118\t        test_ctx->s_to_c_link->next_send_time = current_time;\n119\t        test_ctx->s_to_c_link->is_switched_off = 1;\n120\t    }\n121\t    else {\n122\t        test_ctx->c_to_s_link_2->next_send_time = current_time;\n123\t        test_ctx->c_to_s_link_2->is_switched_off = 0;\n124\t        test_ctx->s_to_c_link_2->next_send_time = current_time;\n125\t        test_ctx->s_to_c_link_2->is_switched_off = 0;\n126\t    }\n127\t}\n128\t\n129\t/* Add the additional links for multipath scenario */\n130\tstatic void multipath_test_sat_links(picoquic_test_tls_api_ctx_t* test_ctx, int link_id)\n131\t{\n132\t    if (link_id == 0) {\n133\t        /* Use low throughput for terrestrial link. */\n134\t        test_ctx->c_to_s_link->picosec_per_byte = 8000000ull; /* Simulate 1 Mbps */\n135\t        test_ctx->s_to_c_link->picosec_per_byte = 8000000ull; /* Simulate 1 Mbps */\n136\t    }\n137\t    else {\n138\t        /* Use higher latency for satellite link */\n139\t        const uint64_t sat_latency = 300000;\n140\t\n141\t        test_ctx->c_to_s_link_2->microsec_latency = sat_latency;\n142\t        test_ctx->s_to_c_link_2->microsec_latency = sat_latency;\n143\t        test_ctx->c_to_s_link_2->queue_delay_max = 2*sat_latency;\n144\t        test_ctx->s_to_c_link_2->queue_delay_max = 2*sat_latency;\n145\t    }\n146\t}\n147\t\n148\t/* Use higher data rate for multipath perf scenario */\n149\tstatic void multipath_test_perf_links(picoquic_test_tls_api_ctx_t* test_ctx, int link_id)\n150\t{\n151\t    const uint64_t wifi_latency = 15000;\n152\t    const uint64_t lte_latency = 30000;\n153\t    const uint64_t wifi_picosec = 8000000ull / 50;\n154\t    const uint64_t lte_picosec = 8000000ull / 40;\n155\t\n156\t    if (link_id == 0) {\n157\t        test_ctx->c_to_s_link->microsec_latency = wifi_latency;\n158\t        test_ctx->s_to_c_link->microsec_latency = wifi_latency;\n159\t        test_ctx->c_to_s_link->queue_delay_max = 2 * wifi_latency;\n160\t        test_ctx->s_to_c_link->queue_delay_max = 2 * wifi_latency;\n161\t        test_ctx->c_to_s_link->picosec_per_byte = wifi_picosec;\n162\t        test_ctx->s_to_c_link->picosec_per_byte = wifi_picosec;\n163\t    }\n164\t    else {\n165\t        test_ctx->c_to_s_link_2->microsec_latency = lte_latency;\n166\t        test_ctx->s_to_c_link_2->microsec_latency = lte_latency;\n167\t        test_ctx->c_to_s_link_2->queue_delay_max = 2 * lte_latency;\n168\t        test_ctx->s_to_c_link_2->queue_delay_max = 2 * lte_latency;\n169\t        test_ctx->c_to_s_link_2->picosec_per_byte = lte_picosec;\n170\t        test_ctx->s_to_c_link_2->picosec_per_byte = lte_picosec;\n171\t    }\n172\t}\n173\t\n174\t/* wait until the migration completes */\n175\tint wait_client_migration_done(picoquic_test_tls_api_ctx_t* test_ctx,\n176\t    uint64_t* simulated_time)\n177\t{\n178\t    int ret = 0;\n179\t    uint64_t time_out = *simulated_time + 4000000;\n180\t    int nb_trials = 0;\n181\t    int nb_inactive = 0;\n182\t    int was_active = 0;\n183\t    struct sockaddr_storage old_srce;\n184\t    struct sockaddr_storage old_dest;\n185\t\n186\t    /* Check the selected path */\n187\t    picoquic_store_addr(&old_srce, (struct sockaddr*)&test_ctx->cnx_client->path[0]->first_tuple->local_addr);\n188\t    picoquic_store_addr(&old_dest, (struct sockaddr*) & test_ctx->cnx_client->path[0]->first_tuple->peer_addr);\n189\t\n190\t\n191\t    while (*simulated_time < time_out &&\n192\t        test_ctx->cnx_client->cnx_state == picoquic_state_ready &&\n193\t        nb_trials < 1024 &&\n194\t        nb_inactive < 64 &&\n195\t        ret == 0 && (\n196\t            (picoquic_compare_addr((struct sockaddr *) & old_srce, (struct sockaddr*) & test_ctx->cnx_client->path[0]->first_tuple->local_addr) == 0 &&\n197\t                picoquic_compare_addr((struct sockaddr*) & old_dest, (struct sockaddr*) & test_ctx->cnx_client->path[0]->first_tuple->peer_addr) == 0)\n198\t            ||\n199\t            (picoquic_compare_addr((struct sockaddr *) & old_srce, (struct sockaddr*) & test_ctx->cnx_server->path[0]->first_tuple->peer_addr) == 0 &&\n200\t                picoquic_compare_addr((struct sockaddr*) & old_dest, (struct sockaddr*) & test_ctx->cnx_server->path[0]->first_tuple->local_addr) == 0))){\n201\t        was_active = 0;\n202\t        nb_trials++;\n203\t\n204\t        ret = tls_api_one_sim_round(test_ctx, simulated_time, time_out, &was_active);\n205\t\n206\t        if (was_active) {\n207\t            nb_inactive = 0;\n208\t        }\n209\t        else {\n210\t            nb_inactive++;\n211\t        }\n212\t    }\n213\t\n214\t    if (ret != 0 || (test_ctx->cnx_client->cnx_state != picoquic_state_ready ||\n215\t        (picoquic_compare_addr((struct sockaddr*) & old_srce, (struct sockaddr*) & test_ctx->cnx_client->path[0]->first_tuple->local_addr) == 0 &&\n216\t            picoquic_compare_addr((struct sockaddr*) & old_dest, (struct sockaddr*) & test_ctx->cnx_client->path[0]->first_tuple->peer_addr) == 0))\n217\t        ||\n218\t        (picoquic_compare_addr((struct sockaddr *) & old_srce, (struct sockaddr*) & test_ctx->cn