own fox jumps over the lazy dog\";\n1752\t        const size_t test_input_len = strlen(test_input_str);\n1753\t        const uint8_t* test_input = (const uint8_t*)test_input_str;\n1754\t        uint8_t encrypted[256];\n1755\t        uint8_t decrypted[256];\n1756\t        size_t encrypted_length;\n1757\t        size_t decrypted_length;\n1758\t\n1759\t        for (size_t i = 0; ret == 0 &&  i < nb_paths; i++) {\n1760\t            encrypted_length = picoquic_aead_encrypt_mp(encrypted, test_input, test_input_len,\n1761\t                path_id_test[i], sequence, aad, aad_len, aead_encrypt);\n1762\t            for (size_t j = 0; ret == 0 && j < nb_paths; j++) {\n1763\t                decrypted_length = picoquic_aead_decrypt_mp(decrypted, encrypted, encrypted_length,\n1764\t                    path_id_test[j], sequence, aad, aad_len, aead_decrypt);\n1765\t                if (i != j) {\n1766\t                    if (decrypted_length <= encrypted_length) {\n1767\t                        DBG_PRINTF(\"Unexpected success, path id encode 0x%\" PRIx64 \", decode 0x%\"PRIx64\"\\n\",\n1768\t                            path_id_test[i], path_id_test[j]);\n1769\t                        ret = -1;\n1770\t                    }\n1771\t                }\n1772\t                else if (decrypted_length > encrypted_length) {\n1773\t                    DBG_PRINTF(\"Unexpected error, path id 0x%\" PRIx64 \"\\n\", path_id_test[i]);\n1774\t                    ret = -1;\n1775\t                }\n1776\t                else if (decrypted_length != test_input_len) {\n1777\t                    DBG_PRINTF(\"Length don't match, path id 0x%\" PRIx64 \", in: %zu, out %zu\\n\",\n1778\t                        path_id_test[i], test_input_len, decrypted_length);\n1779\t                    ret = -1;\n1780\t                }\n1781\t                else if (memcmp(decrypted, test_input, test_input_len) != 0) {\n1782\t                    DBG_PRINTF(\"Decoded doesn't match encoded, path id 0x%\" PRIx64 \"\\n\", 