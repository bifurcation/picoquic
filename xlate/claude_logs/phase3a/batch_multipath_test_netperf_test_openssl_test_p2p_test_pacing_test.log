uct sockaddr*) & test_ctx->cnx_client->path[0]->first_tuple->peer_addr);\n407\t\n408\t    while (*simulated_time < time_out &&\n409\t        ret == 0 &&\n410\t        test_ctx->cnx_client->cnx_state == picoquic_state_ready &&\n411\t        nb_trials < 5000 &&\n412\t        nb_inactive < 64 &&\n413\t        (test_ctx->cnx_client->nb_paths != 2 ||\n414\t        !test_ctx->cnx_client->path[1]->first_tuple->challenge_verified ||\n415\t        (test_ctx->cnx_server == NULL || (test_ctx->cnx_server->nb_paths != 2 ||\n416\t        !test_ctx->cnx_server->path[1]->first_tuple->challenge_verified)))){\n417\t        nb_trials++;\n418\t\n419\t        ret = tls_api_one_sim_round(test_ctx, simulated_time, time_out, &was_active);\n420\t\n421\t        if (was_active) {\n422\t            nb_inactive = 0;\n423\t        }\n424\t        else {\n425\t            nb_inactive++;\n426\t        }\n427\t    }\n428\t\n429\t    if (ret == 0 && (test_ctx->cnx_client->cnx_state != picoquic_state_ready ||\n430\t        (test_ctx->cnx_client->nb_paths != 2 ||\n431\t            !test_ctx->cnx_client->path[1]->first_tuple->challenge_verified) ||\n432\t            (test_ctx->cnx_server == NULL || (test_ctx->cnx_server->nb_paths != 2 ||\n433\t                !test_ctx->cnx_server->path[1]->first_tuple->challenge_verified)))) {\n434\t        DBG_PRINTF(\"Could not establish multipath, client state = %d\\n\",\n435\t            test_ctx->cnx_client->cnx_state);\n436\t        ret = -1;\n437\t    }\n438\t\n439\t    return ret;\n440\t}\n441\t\n442\ttypedef enum {\n443\t    multipath_test_basic = 0,\n444\t    multipath_test_drop_first,\n445\t    multipath_test_drop_second,\n446\t    multipath_test_sat_plus,\n447\t    multipath_test_renew,\n448\t    multipath_test_rotation,\n449\t    multipath_test_nat,\n450\t    multipath_test_nat_challenge,\n451\t    multipath_test_break1,\n452\t    multipath_test_break2,\n453\t    multipath_test_break3,\n454\t    multipath_test_back0,\n455\t    multipath_test_back1,\n456\t