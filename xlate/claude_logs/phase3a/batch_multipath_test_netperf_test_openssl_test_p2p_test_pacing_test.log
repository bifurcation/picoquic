{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_0149XbM8rURpz78HXgmzskLX","type":"tool_result","content":"1249\t        }\n1250\t        for (int p = 0; p < 2; p++) {\n1251\t            if (picoquic_compare_addr(\n1252\t                (struct sockaddr*)&test_ctx->cnx_client->path[p]->first_tuple->local_addr,\n1253\t                (struct sockaddr*)&test_ctx->cnx_client->path[p]->first_tuple->observed_addr) != 0) {\n1254\t                char text1[256];\n1255\t                char text2[256];\n1256\t\n1257\t                DBG_PRINTF(\"Path %d, Local: %s, observed: %s\", p,\n1258\t                    picoquic_addr_text((struct sockaddr*)&test_ctx->cnx_client->path[p]->first_tuple->local_addr, text1, sizeof(text1)),\n1259\t                    picoquic_addr_text((struct sockaddr*)&test_ctx->cnx_client->path[p]->first_tuple->observed_addr, text2, sizeof(text2)));\n1260\t                ret = -1;\n1261\t            }\n1262\t        }\n1263\t    }\n1264\t\n1265\t    if (test_id == multipath_test_break_both) {\n1266\t        /* exception: this test is supposed to fail, because both links\n1267\t        * are unreachable. */\n1268\t        if (ret == 0) {\n1269\t            ret = -1;\n1270\t        }\n1271\t        else {\n1272\t            ret = 0;\n1273\t        }\n1274\t    }\n1275\t    /* Delete the context */\n1276\t    if (test_ctx != NULL) {\n1277\t        tls_api_delete_ctx(test_ctx);\n1278\t    }\n1279\t\n1280\t    /* Check the multipath event logs if collected. */\n1281\t    if (ret == 0 && (test_id == multipath_test_callback || test_id == multipath_test_quality || test_id == multipath_test_quality_server)) {\n1282\t        ret = multipath_verify_callbacks(test_id);\n1283\t    }\n1284\t\n1285\t    return ret;\n1286\t}\n1287\t\n1288\t/* Basic multipath test. Set up two links in parallel, verify that both are used and that\n1289\t * the overall transmission is shorter than if only one link was used.\n1290\t */\n1291\t\n1292\tint multipath_basic_test(void)\n1293\t{\n1294\t    uint64_t max_completion_microsec = 1060000;\n1295\t\n1296\t    return multipath_test_one(max_completion_microsec, multipath_test_basic);\n1297\t}\n1298\t\n1299\t/* Multipath fail test. Same as basic, but the multipath setup is expected to fail.\n1300\t*/\n1301\t\n1302\tint multipath_fail_test(void)\n1303\t{\n1304\t    uint64_t max_completion_microsec = 2000000;\n1305\t\n1306\t    return multipath_test_one(max_completion_microsec, multipath_test_fail);\n1307\t}\n1308\t\n1309\t/* Multipath abandon path 1. Same as basic, but abandon a path before it is\n1310\t* even established. And then repeat a cycle of abandon path / wait for\n1311\t* new CID to make sure that the peer properly provisions new CID. And then\n1312\t* create a path for real and use it.\n1313\t*/\n1314\t\n1315\tint multipath_ab1_test(void)\n1316\t{\n1317\t    uint64_t max_completion_microsec = 3000000;\n1318\t\n1319\t    return multipath_test_one(max_completion_microsec, multipath_test_ab1);\n1320\t}\n1321\t\n1322\t/* Drop first multipath test. Set up two links in parallel, start using them, then\n1323\t * drop the first one of them. Check that the transmission succeeds.\n1324\t */\n1325\t\n1326\tint multipath_drop_first_test(void)\n1327\t{\n1328\t    uint64_t max_completion_microsec = 1490000;\n1329\t\n1330\t    return multipath_test_one(max_completion_microsec, multipath_test_drop_first);\n1331\t}\n1332\t\n1333\t/* Drop second multipath test. Set up two links in parallel, start using them, then\n1334\t * drop the second one of them. Check that the transmission succeeds.\n1335\t */\n1336\t\n1337\tint multipath_drop_second_test(void)\n1338\t{\n1339\t    uint64_t max_completion_microsec = 1260000;\n1340\t\n1341\t    return multipath_test_one(max_completion_microsec, multipath_test_drop_second);\n1342\t}\n1343\t\n1344\t/* Simulate the combination of a satellite link and a low latency low bandwidth\n1345\t * terrestrial link\n1346\t */\n1347\tint multipath_sat_plus_tes