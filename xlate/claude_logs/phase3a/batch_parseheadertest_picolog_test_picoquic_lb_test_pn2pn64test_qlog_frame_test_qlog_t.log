{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01SnVpdB1tf6BHf8mdrHJQFn","type":"tool_result","content":"1\t//! Tests for `picoquictest/sacktest.c` — SACK list and ACK-frame logic.\n2\t//!\n3\t//! Tests covered:\n4\t//! * [`ack_sack`]    — C `sacktest`: basic SACK-list record / query.\n5\t//! * [`ack_send`]    — C `sendacktest`: ACK-frame formatting.\n6\t//! * [`ack_loop`]    — C `sendack_loop_test`: gap/delay-triggered ACK.\n7\t//! * [`ack_range`]   — C `ackrange_test`: standalone SACK-list range ops.\n8\t//! * [`ack_disorder`]— C `ack_disorder_test`: out-of-order arrival stats.\n9\t//! * [`ack_horizon`] — C `ack_horizon_test`: horizon-delay variant.\n10\t\n11\t#![allow(non_snake_case)]\n12\t\n13\tuse crate::frames::FrameType;\n14\tuse crate::internal::{SackList, varint_decode, varint_skip};\n15\tuse crate::{ConnectionId, Duration, Instant, PacketContext, Quic, RESET_SECRET_SIZE};\n16\t\n17\tuse super::util;\n18\t\n19\t// ---------------------------------------------------------------------------\n20\t// Shared test data\n21\t\n22\tconst TEST_PNS: &[u64] = &[\n23\t    3, 4, 0, 2, 7, 8, 11, 12, 13, 17, 19, 21, 18, 16, 20, 10, 5, 6, 9, 1, 14, 15,\n24\t];\n25\t\n26\tstruct ExpectedAck {\n27\t    highest_received: u64,\n28\t    last_range: u64,\n29\t    num_blocks: u64,\n30\t}\n31\t\n32\t// expected_ack[] from C sacktest.c, in the same order as TEST_PNS.\n33\tconst EXPECTED_ACKS: &[ExpectedAck] = &[\n34\t    ExpectedAck {\n35\t        highest_received: 3,\n36\t        last_range: 0,\n37\t        num_blocks: 0,\n38\t    },\n39\t    ExpectedAck {\n40\t        highest_received: 4,\n41\t        last_range: 1,\n42\t        num_blocks: 0,\n43\t    },\n44\t    ExpectedAck {\n45\t        highest_received: 4,\n46\t        last_range: 1,\n47\t        num_blocks: 1,\n48\t    },\n49\t    ExpectedAck {\n50\t        highest_received: 4,\n51\t        last_range: 2,\n52\t        num_blocks: 1,\n53\t    },\n54\t    ExpectedAck {\n55\t        highest_received: 7,\n56\t        last_range: 0,\n57\t        num_blocks: 2,\n58\t    },\n59\t    ExpectedAck {\n60\t        highest_received: 8,\n61\t        last_range: 1,\n62\t        num_blocks: 2,\n63\t    },\n64\t    ExpectedAck {\n65\t        highest_received: 11,\n66\t        last_range: 0,\n67\t        num_blocks: 3,\n68\t    },\n69\t    ExpectedAck {\n70\t        highest_received: 12,\n71\t        last_range: 1,\n72\t        num_blocks: 2,\n73\t    },\n74\t    ExpectedAck {\n75\t        highest_received: 13,\n76\t        last_range: 2,\n77\t        num_blocks: 1,\n78\t    },\n79\t    ExpectedAck {\n80\t        highest_received: 17,\n81\t        last_range: 0,\n82\t        num_blocks: 2,\n83\t    },\n84\t    ExpectedAck {\n85\t        highest_received: 19,\n86\t        last_range: 0,\n87\t        num_blocks: 2,\n88\t    },\n89\t    ExpectedAck {\n90\t        highest_received: 21,\n91\t        last_range: 0,\n92\t        num_blocks: 3,\n93\t    },\n94\t    ExpectedAck {\n95\t        highest_received: 21,\n96\t        last_range: 0,\n97\t        num_blocks: 2,\n98\t    },\n99\t    ExpectedAck {\n100\t        highest_received: 21,\n101\t        last_range: 0,\n102\t        num_blocks: 1,\n103\t    },\n104\t    ExpectedAck {\n105\t        highest_received: 21,\n106\t        last_range: 5,\n107\t        num_blocks: 0,\n108\t    },\n109\t    ExpectedAck {\n110\t        highest_received: 21,\n111\t        last_range: 5,\n112\t        num_blocks: 1,\n113\t    },\n114\t    ExpectedAck {\n115\t        highest_received: 21,\n116\t        last_range: 5,\n117\t        num_blocks: 2,\n118\t    },\n119\t    ExpectedAck {\n120\t        highest_received: 21,\n121\t        last_range: 5,\n122\t        num_blocks: 2,\n123\t    },\n124\t    ExpectedAck {\n125\t        highest_received: 21,\n126\t        last_range: 5,\n127\t        num_blocks: 1,\n128\t    },\n129\t    ExpectedAck {\n130\t        highest_received: 21,\n131\t        last_range: 5,\n132\t        num_blocks: 1,\n133\t    },\n134\t    ExpectedAck {\n135\t        highest_received: 21,\n136\t        last_range: 5,\n137\t        num_blocks: 1,\n138\t    },\n139\t    ExpectedAck {\n140\t        highest_received: 21,\n141\t        last_range: 21,\n142\t        num_blocks: 0,\n143\t    },\n144\t];\n145\t\n146\t// ack_range[] table from C ackrange_test — (range_min, range_max) pairs.\n147\tconst ACK_RANGES: &[(u64, u64)] = &[\n148\t    (1, 1000),\n149\t    (0, 0),\n150\t    (3001, 4000),\n151\t    (4001, 5000),\n152\t    (6001, 7000),\n153\t    (5001, 6000),\n154\t    (1501, 2500),\n155\t    (501, 1500),\n156\t    (501, 7500),\n157\t];\n158\t\n159\t// ---------------------------------------------------------------------------\n160\t// Local helpers\n161\t\n162\t/// C: `ack_range_mask` in sacktest.c.\n163\tfn ack_range_mask(mask: &mut u64, mut highest: u64, range: u64) {\n164\t    for _ in 0..range {\n165\t        *mask |= 1u64 << (highest & 63);\n166\t        highest = highest.wrapping_sub(1);\n167\t    }\n168\t}\n169\t\n170\t/// Parse and validate an encoded ACK frame.  C: `basic_ack_parse` in\n171\t/// sacktest.c; translated to assert-on-failure rather than returning -1.\n172\tfn basic_ack_parse(\n173\t    bytes: &[u8],\n174\t    expected: &ExpectedAck,\n175\t    previous_mask: &mut u64,\n176\t    expected_mask: u64,\n177\t) {\n178\t    assert!(!bytes.is_empty(), \"empty ACK frame buffer\");\n179\t    assert_eq!(bytes[0], FrameType::Ack as u8, \"wrong frame type byte\");\n180\t\n181\t    let bytes_max = bytes.len();\n182\t    let mut byte_index = 1usize;\n183\t\n184\t    let mut largest = 0u64;\n185\t    let l_largest = varint_decode(&bytes[byte_index..], &mut largest);\n186\t    assert_ne!(l_largest, 0, \"varint_decode largest failed\");\n187\t    byte_index += l_largest;\n188\t\n189\t    let l_delay = varint_skip(&bytes[byte_index..]);\n190\t    assert_ne!(l_delay, 0, \"varint_skip ack_delay failed\");\n191\t    byte_index += l_delay;\n192\t\n193\t    let mut num_block = 0u64;\n194\t    let l_num_block = varint_decode(&bytes[byte_index..], &mut num_block);\n195\t    assert_ne!(l_num_block, 0, \"varint_decode num_block failed\");\n196\t    byte_index += l_num_block;\n197\t\n198\t    let mut last_range = 0u64;\n199\t    let l_last_range = varint_decode(&bytes[byte_index..], &mut last_range);\n200\t    assert_ne!(l_last_range, 0, \"varint_decode last_range failed\");\n201\t    byte_index += l_last_range;\n202\t\n203\t    assert!(\n204\t        last_range <= largest,\n205\t        \"last_range {last_range} > largest {largest}\"\n206\t    );\n207\t    let mut acked_mask = 0u64;\n208\t    ack_range_mask(&mut acked_mask, largest, last_range + 1);\n209\t    let mut gap_begin = largest.wrapping_sub(last_range).wrapping_sub(1);\n210\t\n211\t    for _ in 0..num_block {\n212\t        let mut gap = 0u64;\n213\t        let l_gap = varint_decode(&bytes[byte_index..], &mut gap);\n214\t        assert_ne!(l_gap, 0, \"varint_decode gap failed\");\n215\t        byte_index += l_gap;\n216\t        gap += 1;\n217\t\n218\t        let mut ack_range = 0u64;\n219\t        let l_range = varint_decode(&bytes[byte_index..], &mut ack_range);\n220\t        assert_ne!(l_range, 0, \"varint_decode ack_range failed\");\n221\t        byte_index += l_range;\n222\t\n223\t        assert!(gap <= gap_begin, \"gap {gap} > gap_begin {gap_begin}\");\n224\t        gap_begin -= gap;\n225\t\n226\t        assert!(\n227\t            gap_begin >= ack_range,\n228\t            \"gap_begin {gap_begin} < ack_range {ack_range}\"\n229\t        );\n230\t        ack_range += 1;\n231\t        ack_range_mask(&mut acked_mask, gap_begin, ack_range);\n232\t        gap_begin -= ack_range;\n233\t    }\n234\t\n235\t    assert_eq!(byte_index, bytes_max, \"ACK frame not fully consumed\");\n236\t    assert_eq!(largest, expected.highest_received, \"largest mismatch\");\n237\t    assert_eq!(last_range, expected.last_range, \"last_range mismatch\");\n238\t    assert_eq!(num_block, expected.num_blocks, \"num_block mismatch\");\n239\t\n240\t    acked_mask |= *previous_mask;\n241\t    assert_eq!(acked_mask, expected_mask, \"acked_mask mismatch\");\n242\t    *previous_mask = acked_mask;\n243\t}\n244\t\n245\t/// Inner body of `ack_loop` for a single (ack_gap, ack_delay_us) pair.\n246\t/// C: `sendack_loop_test_one`.\n247\tfn ack_loop_one(ack_gap: u64, ack_delay_us: u64) {\n248\t    let pc = PacketContext::Application;\n249\t    let t0 = Instant::from_ticks(0);\n250\t    let mut quic = Quic::new(\n251\t        8,\n252\t        None,\n253\t        None,\n254\t        None,\n255\t        None,\n256\t        None,\n257\t        None,\n258\t        [0u8; RESET_SECRET_SIZE],\n259\t        t0,\n260\t        None,\n261\t        None,\n262\t    )\n263\t    .expect(\"quic\");\n264\t    let cnx = quic\n265\t        .create_connection(\n266\t            ConnectionId::default(),\n267\t            ConnectionId::default(),\n268\t            None,\n269\t            t0,\n270\t            0,\n271\t            Some(util::TEST_SNI),\n272\t            Some(\"minimal\"),\n273\t            true,\n274\t        )\n275\t        .expect(\"cnx\");\n276\t\n277\t    let l_cid = cnx.create_local_connection_id(0, None, t0).expect(\"l_cid\");\n278\t\n279\t    cnx.sending_ecn_ack = false;\n280\t    cnx.ack_delay_remote = Duration::from_ticks(ack_delay_us);\n281\t    cnx.ack_gap_remote = ack_gap;\n282\t\n283\t    util::check_ack_ranges(&mut cnx.ack_ctx[pc as usize].sack_list);\n284\t\n285\t    let mut largest_received_number = 0u64;\n286\t    let mut largest_ack_number = 0u64;\n287\t    let mut largest_time_sent = 0u64;\n288\t    let mut next_wake_time = Instant::from_ticks(u64::MAX);\n289\t    let mut bytes = [0u8; 256];\n290\t\n291\t    for (i, &pn) in TEST_PNS.iter().enumerate() {\n292\t        let mut ack_sent = false;\n293\t        let mut out_of_order = false;\n294\t        let current_time_base = i as u64 * 1000;\n295\t\n296\t        assert_eq!(\n297\t            cnx.record_pn_received(pc, Some(l_cid), pn, Instant::from_ticks(current_time_base),),\n298\t            0,\n299\t            \"record_pn_received at step {i}\"\n300\t        );\n301\t\n302\t        if largest_received_number + 1 != pn {\n303\t            out_of_order = true;\n304\t        }\n305\t        cnx.set_ack_needed_on_path(\n306\t            Instant::from_ticks(current_time_base),\n307\t            pc,\n308\t            0,\n309\t            out_of_order as i32,\n310\t        );\n311\t\n312\t        util::check_ack_ranges(&mut cnx.ack_ctx[pc as usize].sack_list);\n313\t\n314\t        if largest_received_number < pn {\n315\t            largest_received_number = pn;\n316\t        }\n317\t\n318\t        for k in 0..5u64 {\n319\t            let mut more_data = 0i32;\n320\t            let current_time = current_time_base + k * 10;\n321\t\n322\t            let ack_written = if cnx.is_ack_needed(\n323\t                Instant::from_ticks(current_time),\n324\t                &mut next_wake_time,\n325\t                pc,\n326\t                0,\n327\t            ) {\n328\t                let written = util::format_ack_frame_written(\n329\t                    cnx,\n330\t                    &mut bytes,\n331\t                    &mut more_data,\n332\t                    Instant::from_ticks(current_time),\n333\t                    pc,\n334\t                    0,\n335\t                )\n336\t                .expect(\"format_ack_frame returned None unexpectedly\");\n337\t                assert_eq!(more_data, 0, \"more_data set at ({i},{k})\");\n338\t                written\n339\t            } else {\n340\t                0\n341\t            };\n342\t\n343\t            if ack_written == 0 {\n344\t                if !ack_sent {\n345\t                    assert!(\n346\t                        largest_ack_number + ack_gap >= largest_received_number,\n347\t                        \"missing ack by number at ({i},{k})\"\n348\t                    );\n349\t                    assert!(\n350\t                        largest_time_sent.wrapping_add(ack_delay_us) >= largest_time_sent,\n351\t                        \"missing ack by time at ({i},{k})\"\n352\t                    );\n353\t                }\n354\t            } else {\n355\t                assert!(!ack_sent, \"duplicate ack at ({i},{k})\");\n356\t                assert!(\n357\t                    !(largest_ack_number + ack_gap > largest_received_number\n358\t                        && largest_time_sent + ack_delay_us > current_time\n359\t                        && !out_of_order),\n360\t                    \"ack sent before time or number at ({i},{k})\"\n361\t                );\n362\t                ack_sent = true;\n363\t                largest_ack_number = largest_received_number;\n364\t                largest_time_sent = current_time;\n365\t            }\n366\t        }\n367\t    }\n368\t}\n369\t\n370\t/// Inner body shared by `ack_disorder` and `ack_horizon`.\n371\t/// C: `ack_disorder_test_one`.\n372\tfn ack_disorder_one(log_name: &str, horizon_delay: i64, range_average_max: f64) {\n373\t    const NB_RANGES: usize = 1000;\n374\t    const NB_EVEN_RANGES: usize = NB_RANGES / 2;\n375\t    const NB_ODD_RANGES: usize = NB_RANGES - NB_EVEN_RANGES;\n376\t    const LOW_LATENCY: u64 = 11_111;\n377\t    const HIGH_LATENCY: u64 = 300_000;\n378\t    const ACK_INTERVAL: u64 = 100_000;\n379\t    const PACKET_INTERVAL: u64 = 1_000;\n380\t\n381\t    struct AckItem {\n382\t        pn: u64,\n383\t        arrive_time: u64,\n384\t        ackk_time: u64,\n385\t        nb_ranges_arrive: usize,\n386\t        nb_ranges_ack: usize,\n387\t    }\n388\t\n389\t    let mut ackk_list: Vec<AckItem> = Vec::with_capacity(NB_RANGES);\n390\t    let mut i_ackk: usize = 0;\n391\t    let mut i_even_arrive: usize = 0;\n392\t    let mut i_odd_arrive: usize = 0;\n393\t    let mut t_even_arrive: u64 = LOW_LATENCY;\n394\t    let mut t_odd_arrive: u64 = PACKET_INTERVAL + HIGH_LATENCY;\n395\t\n396\t    let mut sack0 = SackList::new();\n397\t    sack0.horizon_delay = horizon_delay;\n398\t\n399\t    while i_even_arrive < NB_EVEN_RANGES || i_odd_arrive < NB_ODD_RANGES || i_ackk < ackk_list.len()\n400\t    {\n401\t        let mut next_time = u64::MAX;\n402\t        let mut i_action: i32 = -1;\n403\t\n404\t        if i_odd_arrive < NB_ODD_RANGES {\n405\t            i_action = 0;\n406\t            next_time = t_odd_arrive;\n407\t        }\n408\t        if i_even_arrive < NB_EVEN_RANGES && t_even_arrive < next_time {\n409\t            i_action = 1;\n410\t            next_time = t_even_arrive;\n411\t        }\n412\t        if i_ackk < ackk_list.len() && ackk_list[i_ackk].ackk_time < next_time {\n413\t            i_action = 2;\n414\t            next_time = ackk_list[i_ackk].ackk_time;\n415\t        }\n416\t\n417\t        match i_action {\n418\t            0 => {\n419\t                let pn = 2 * i_odd_arrive as u64 + 1;\n420\t                i_odd_arrive += 1;\n421\t                t_odd_arrive += PACKET_INTERVAL;\n422\t                sack0\n423\t                    .update(pn, pn, Instant::from_ticks(next_time))\n424\t                    .expect(\"update sack (odd)\");\n425\t                assert!(ackk_list.len() < NB_RANGES, \"ackk_list overflow\");\n426\t                let nb = sack0.size();\n427\t                ackk_list.push(AckItem {\n428\t                    pn,\n429\t                    arrive_time: next_time,\n430\t                    ackk_time: next_time + ACK_INTERVAL,\n431\t                    nb_ranges_arrive: nb,\n432\t                    nb_ranges_ack: 0,\n433\t                });\n434\t            }\n435\t            1 => {\n436\t                let pn = 2 * i_even_arrive as u64;\n437\t                i_even_arrive += 1;\n438\t                t_even_arrive += PACKET_INTERVAL;\n439\t                sack0\n440\t                    .update(pn, pn, Instant::from_ticks(next_time))\n441\t                    .expect(\"update sack (even)\");\n442\t                assert!(ackk_list.len() < NB_RANGES, \"ackk_list overflow\");\n443\t                let nb = sack0.size();\n444\t                ackk_list.push(AckItem {\n445\t                    pn,\n446\t                    arrive_time: next_time,\n447\t                    ackk_time: next_time + ACK_INTERVAL,\n448\t                    nb_ranges_arrive: nb,\n449\t                    nb_ranges_ack: 0,\n450\t                });\n451\t            }\n452\t            2 => {\n453\t                let pn = ackk_list[i_ackk].pn;\n454\t                sack0.process_ack_of_ack_range(None, pn, pn);\n455\t                ackk_list[i_ackk].nb_ranges_ack = sack0.size();\n456\t                i_ackk += 1;\n457\t            }\n458\t            _ => unreachable!(\"unexpected i_action {i_action}\"),\n459\t        }\n460\t    }\n461\t\n462\t    // Write CSV log (mirrors C picoquic_file_open / fprintf).\n463\t    {\n464\t        use std::io::Write as _;\n465\t        let mut f = std::fs::File::create(log_name).expect(\"create log file\");\n466\t        writeln!(f, \"pn,arrive_time,ackk_time,nb_ranges_arrive,nb_ranges_ack\").unwrap();\n467\t        for item in &ackk_list {\n468\t            writeln!(\n469\t                f,\n470\t                \"{}, {}, {}, {}, {}\",\n471\t                item.pn,\n472\t                item.arrive_time,\n473\t                item.ackk_time,\n474\t                item.nb_ranges_arrive,\n475\t                item.nb_ranges_ack,\n476\t            )\n477\t            .unwrap();\n478\t        }\n479\t    }\n480\t\n481\t    let sum_ranges_ack: usize = ackk_list.iter().map(|it| it.nb_ranges_ack).sum();\n482\t    let range_average = sum_ranges_ack as f64 / ackk_list.len() as f64;\n483\t    assert!(\n484\t        range_average <= range_average_max,\n485\t        \"got {range_average} ACK ranges, larger than expected {range_average_max}\"\n486\t    );\n487\t\n488\t    sack0.free();\n489\t}\n490\t\n491\t// ---------------------------------------------------------------------------\n492\t// Tests\n493\t\n494\t/// C: `sacktest` in `picoquictest/sacktest.c`.\n495\t///\n496\t/// Records packet numbers from [`TEST_PNS`] into a minimal connection's\n497\t/// SACK list, verifying after each step that `is_pn_already_received`\n498\t/// and `record_pn_received` are consistent.\n499\t#[test]\n500\tfn ack_sack() {\n501\t    let pc = PacketContext::Application;\n502\t    let t0 = Instant::from_ticks(0);\n503\t    let mut quic = Quic::new(\n504\t        8,\n505\t        None,\n506\t        None,\n507\t        None,\n508\t        None,\n509\t        None,\n510\t        None,\n511\t        [0u8; RESET_SECRET_SIZE],\n512\t        t0,\n513\t        None,\n514\t        None,\n515\t    )\n516\t    .expect(\"quic\");\n517\t\n518\t    // Phase 1: basic pn=0 case (mirrors C before the reset).\n519\t    {\n520\t        let cnx = quic\n521\t            .create_connection(\n522\t                ConnectionId::default(),\n523\t                ConnectionId::default(),\n524\t                None,\n525\t                t0,\n526\t                0,\n527\t                Some(util::TEST_SNI),\n528\t                Some(\"minimal\"),\n529\t                true,\n530\t            )\n531\t            .expect(\"cnx\");\n532\t\n533\t        let l_cid = cnx.create_local_connection_id(0, None, t0).expect(\"l_cid\");\n534\t\n535\t        assert!(\n536\t            !cnx.is_pn_already_received(pc, Some(l_cid), 0),\n537\t            \"pn 0 should not be received yet\"\n538\t        );\n539\t        assert_eq!(\n540\t            cnx.record_pn_received(pc, Some(l_cid), 0, t0),\n541\t            0,\n542\t            \"first record of pn 0 should return 0\"\n543\t        );\n544\t        assert!(\n545\t            cnx.is_pn_already_received(pc, Some(l_cid), 0),\n546\t            \"pn 0 should now be received\"\n547\t        );\n548\t        // C: picoquic_sack_list_first == 0 (min PN), == Rust last()\n549\t        assert_eq!(cnx.ack_ctx[pc as usize].sack_list.last(), 0);\n550\t        // C: picoquic_sack_list_last == 0 (max PN), == Rust first()\n551\t        assert_eq!(cnx.ack_ctx[pc as usize].sack_list.first(), 0);\n552\t        assert!(cnx.ack_ctx[pc as usize].sack_list.first_range().is_none());\n553\t    }\n554\t\n555\t    // Phase 2: fresh connection (mirrors picoquic_test_reset_minimal_cnx).\n556\t    {\n557\t        let cnx = quic\n558\t            .create_connection(\n559\t                ConnectionId::default(),\n560\t                ConnectionId::default(),\n561\t                None,\n562\t                t0,\n563\t                0,\n564\t                Some(util::TEST_SNI),\n565\t                Some(\"minimal\"),\n566\t                true,\n567\t            )\n568\t            .expect(\"cnx after reset\");\n569\t\n570\t        let l_cid = cnx\n571\t            .create_local_connection_id(0, None, t0)\n572\t            .expect(\"l_cid after reset\");\n573\t\n574\t        util::check_ack_ranges(&mut cnx.ack_ctx[pc as usize].sack_list);\n575\t\n576\t        let mut highest_seen = 0u64;\n577\t        let mut highest_seen_time = t0;\n578\t\n579\t        for (i, &pn) in TEST_PNS.iter().enumerate() {\n580\t            let current_time = Instant::from_ticks(i as u64 * 100 + 1);\n581\t\n582\t            if pn > highest_seen {\n583\t                highest_seen = pn;\n584\t                highest_seen_time = current_time;\n585\t            }\n586\t\n587\t            assert_eq!(\n588\t                cnx.record_pn_received(pc, Some(l_cid), pn, current_time),\n589\t                0,\n590\t                \"record pn {pn} at step {i}\"\n591\t            );\n592\t            util::check_ack_ranges(&mut cnx.ack_ctx[pc as usize].sack_list);\n593\t\n594\t            for &pn_j in &TEST_PNS[..=i] {\n595\t                assert!(\n596\t                    cnx.is_pn_already_received(pc, Some(l_cid), pn_j),\n597\t                    \"pn {pn_j} should be received at step {i}\"\n598\t                );\n599\t                assert_eq!(\n600\t                    cnx.record_pn_received(pc, Some(l_cid), pn_j, current_time),\n601\t                    1,\n602\t                    \"duplicate record of pn {pn_j} should return 1 at step {i}\"\n603\t                );\n604\t            }\n605\t\n606\t            for &pn_j in &TEST_PNS[i + 1..] {\n607\t                assert!(\n608\t                    !cnx.is_pn_already_received(pc, Some(l_cid), pn_j),\n609\t                    \"pn {pn_j} should not yet be received at step {i}\"\n610\t                );\n611\t            }\n612\t        }\n613\t\n614\t        // Final state: [0..21] all received, contiguous.\n615\t        // C: picoquic_sack_list_last == 21 (max) → Rust first()\n616\t        assert_eq!(cnx.ack_ctx[pc as usize].sack_list.first(), 21);\n617\t        // C: picoquic_sack_list_first == 0 (min) → Rust last()\n618\t        assert_eq!(cnx.ack_ctx[pc as usize].sack_list.last(), 0);\n619\t        assert_eq!(\n620\t            cnx.ack_ctx[pc as usize].time_stamp_largest_received,\n621\t            highest_seen_time\n622\t        );\n623\t        assert!(cnx.ack_ctx[pc as usize].sack_list.first_range().is_none());\n624\t    }\n625\t}\n626\t\n627\t/// C: `sendacktest` in `picoquictest/sacktest.c`.\n628\t///\n629\t/// Records [`TEST_PNS`] in order, formats an ACK frame after each, and\n630\t/// validates the wire encoding against [`EXPECTED_ACKS`].\n631\t#[test]\n632\tfn ack_send() {\n633\t    let pc = PacketContext::Application;\n634\t    let t0 = Instant::from_ticks(0);\n635\t    let mut quic = Quic::new(\n636\t        8,\n637\t        None,\n638\t        None,\n639\t        None,\n640\t        None,\n641\t        None,\n642\t        None,\n643\t        [0u8; RESET_SECRET_SIZE],\n644\t        t0,\n645\t        None,\n646\t        None,\n647\t    )\n648\t    .expect(\"quic\");\n649\t    let cnx = quic\n650\t        .create_connection(\n651\t            ConnectionId::default(),\n652\t            ConnectionId::default(),\n653\t            None,\n654\t            t0,\n655\t            0,\n656\t            Some(util::TEST_SNI),\n657\t            Some(\"minimal\"),\n658\t            true,\n659\t        )\n660\t        .expect(\"cnx\");\n661\t\n662\t    cnx.sending_ecn_ack = false;\n663\t    let l_cid = cnx.create_local_connection_id(0, None, t0).expect(\"l_cid\");\n664\t\n665\t    util::check_ack_ranges(&mut cnx.ack_ctx[pc as usize].sack_list);\n666\t\n667\t    let mut received_mask = 0u64;\n668\t    let mut previous_mask = 0u64;\n669\t    let mut bytes = [0u8; 256];\n670\t\n671\t    for (i, &pn) in TEST_PNS.iter().enumerate() {\n672\t        let current_time = Instant::from_ticks(i as u64 * 100);\n673\t\n674\t        assert_eq!(\n675\t            cnx.record_pn_received(pc, Some(l_cid), pn, current_time),\n676\t            0,\n677\t            \"record pn {pn} at step {i}\"\n678\t        );\n679\t        util::check_ack_ranges(&mut cnx.ack_ctx[pc as usize].sack_list);\n680\t\n681\t        let mut more_data = 0i32;\n682\t        let written = util::format_ack_frame_written(cnx, &mut bytes, &mut more_data, t0, pc, 0)\n683\t            .expect(\"format_ack_frame at step {i}\");\n684\t\n685\t        received_mask |= 1u64 << (pn & 63);\n686\t        util::check_ack_ranges(&mut cnx.ack_ctx[pc as usize].sack_list);\n687\t\n688\t        basic_ack_parse(\n689\t            &bytes[..written],\n690\t            &EXPECTED_ACKS[i],\n691\t            &mut previous_mask,\n692\t            received_mask,\n693\t        );\n694\t    }\n695\t}\n696\t\n697\t/// C: `sendack_loop_test` in `picoquictest/sacktest.c`.\n698\t///\n699\t/// Runs the gap/delay-triggered ACK loop for three (ack_gap, ack_delay)\n700\t/// combinations to verify `is_ack_needed` / `format_ack_frame` fire at\n701\t/// the right moments.\n702\t#[test]\n703\tfn ack_loop() {\n704\t    let combinations: [(u64, u64); 3] = [(0, 0), (2, 1000), (10000, 25)];\n705\t    for (ack_gap, ack_delay) in combinations {\n706\t        ack_loop_one(ack_gap, ack_delay);\n707\t    }\n708\t}\n709\t\n710\t/// C: `ackrange_test` in `picoquictest/sacktest.c`.\n711\t///\n712\t/// Inserts ranges from [`ACK_RANGES`] into a standalone SACK list,\n713\t/// checking for correct idempotency and final contiguous coverage.\n714\t#[test]\n715\tfn ack_range() {\n716\t    let t0 = Instant::from_ticks(0);\n717\t    let mut sack0 = SackList::new();\n718\t\n719\t    for (i, &(rmin, rmax)) in ACK_RANGES.iter().enumerate() {\n720\t        // C: picoquic_check_sack_list == 0 means not yet in sack.\n721\t        assert!(\n722\t            !sack0.check(rmin, rmax),\n723\t            \"range ({rmin},{rmax}) already in sack at step {i}\"\n724\t        );\n725\t        sack0.update(rmin, rmax, t0).expect(\"update sack\");\n726\t        util::check_ack_ranges(&mut sack0);\n727\t\n728\t        for &(jmin, jmax) in ACK_RANGES.iter().take(i) {\n729\t            assert!(\n730\t                sack0.check(jmin, jmax),\n731\t                \"range ({jmin},{jmax}) not in sack at step {i}\"\n732\t            );\n733\t        }\n734\t    }\n735\t\n736\t    // Final state: [0..7500] fully covered (no gaps).\n737\t    // C: picoquic_sack_list_first == 0 (min) → Rust last()\n738\t    assert_eq!(sack0.last(), 0);\n739\t    // C: picoquic_sack_list_last == 7500 (max) → Rust first()\n740\t    assert_eq!(sack0.first(), 7500);\n741\t    assert!(sack0.first_range().is_none());\n742\t\n743\t    sack0.free();\n744\t}\n745\t\n746\t/// C: `ack_disorder_test` in `picoquictest/sacktest.c`.\n747\t///\n748\t/// Simulates out-of-order arrival on two paths and verifies the average\n749\t/// number of ACK ranges stays below 133.\n750\t#[test]\n751\tfn ack_disorder() {\n752\t    ack_disorder_one(\"ack_disorder_test.csv\", 0, 133.0);\n753\t}\n754\t\n755\t/// C: `ack_horizon_test` in `picoquictest/sacktest.c`.\n756\t///\n757\t/// Same as `ack_disorder` but with a horizon delay of 1 s; the average\n758\t/// range count budget rises to 196.\n759\t#[test]\n760\tfn ack_horizon() {\n761\t    ack_disorder_one(\"ack_horizon_test.csv\", 1_000_000, 196.0);\n762\t}\n763\t"}]},"parent_tool_use_id":null,"session_id":"d6e0a846-1f78-4cd7-8562-a63ac35b77bc","uuid":"39477cfa-46ca-4331-860e-a61f37617283","timestamp":"2026-05-05T11:11:31.071Z","tool_use_result":{"type":"text","file":{"filePath":"/Users/richbarn/Projects/picoquic/rs/fq/src/tests/sacktest.rs","content":"//! Tests for `picoquictest/sacktest.c` — SACK list and ACK-frame logic.\n//!\n//! Tests covered:\n//! * [`ack_sack`]    — C `sacktest`: basic SACK-list record / query.\n//! * [`ack_send`]    — C `sendacktest`: ACK-frame formatting.\n//! * [`ack_loop`]    — C `sendack_loop_test`: gap/delay-triggered ACK.\n//! * [`ack_range`]   — C `ackrange_test`: standalone SACK-list range ops.\n//! * [`ack_disorder`]— C `ack_disorder_test`: out-of-order arrival stats.\n//! * [`ack_horizon`] — C `ack_horizon_test`: horizon-delay variant.\n\n#![allow(non_snake_case)]\n\nuse crate::frames::FrameType;\nuse crate::internal::{SackList, varint_decode, varint_skip};\nuse crate::{ConnectionId, Duration, Instant, PacketContext, Quic, RESET_SECRET_SIZE};\n\nuse super::util;\n\n// ---------------------------------------------------------------------------\n// Shared test data\n\nconst TEST_PNS: &[u64] = &[\n    3, 4, 0, 2, 7, 8, 11, 12, 13, 17, 19, 21, 18, 16, 20, 10, 5, 6, 9, 1, 14, 15,\n];\n\nstruct ExpectedAck {\n    highest_received: u64,\n    last_range: u64,\n    num_blocks: u64,\n}\n\n// expected_ack[] from C sacktest.c, in the same order as TEST_PNS.\nconst EXPECTED_ACKS: &[ExpectedAck] = &[\n    ExpectedAck {\n        highest_received: 3,\n        last_range: 0,\n        num_blocks: 0,\n    },\n    ExpectedAck {\n        highest_received: 4,\n        last_range: 1,\n        num_blocks: 0,\n    },\n    ExpectedAck {\n        highest_received: 4,\n        last_range: 1,\n        num_blocks: 1,\n    },\n    ExpectedAck {\n        highest_received: 4,\n        last_range: 2,\n        num_blocks: 1,\n    },\n    ExpectedAck {\n        highest_received: 7,\n        last_range: 0,\n        num_blocks: 2,\n    },\n    ExpectedAck {\n        highest_received: 8,\n        last_range: 1,\n        num_blocks: 2,\n    },\n    ExpectedAck {\n        highest_received: 11,\n        last_range: 0,\n        num_blocks: 3,\n    },\n    ExpectedAck {\n        highest_received: 12,\n        last_range: 1,\n        num_blocks: 2,\n    },\n    ExpectedAck {\n        highest_received: 13,\n        last_range: 2,\n        num_blocks: 1,\n    },\n    ExpectedAck {\n        highest_received: 17,\n        last_range: 0,\n        num_blocks: 2,\n    },\n    ExpectedAck {\n        highest_received: 19,\n        last_range: 0,\n        num_blocks: 2,\n    },\n    ExpectedAck {\n        highest_received: 21,\n        last_range: 0,\n        num_blocks: 3,\n    },\n    ExpectedAck {\n        highest_received: 21,\n        last_range: 0,\n        num_blocks: 2,\n    },\n    ExpectedAck {\n        highest_received: 21,\n        last_range: 0,\n        num_blocks: 1,\n    },\n    ExpectedAck {\n        highest_received: 21,\n        last_range: 5,\n        num_blocks: 0,\n    },\n    ExpectedAck {\n        highest_received: 21,\n        last_range: 5,\n        num_blocks: 1,\n    },\n    ExpectedAck {\n        highest_received: 21,\n        last_range: 5,\n        num_blocks: 2,\n    },\n    ExpectedAck {\n        highest_received: 21,\n        last_range: 5,\n        num_blocks: 2,\n    },\n    ExpectedAck {\n        highest_received: 21,\n        last_range: 5,\n        num_blocks: 1,\n    },\n    ExpectedAck {\n        highest_received: 21,\n        last_range: 5,\n        num_blocks: 1,\n    },\n    ExpectedAck {\n        highest_received: 21,\n        last_range: 5,\n        num_blocks: 1,\n    },\n    ExpectedAck {\n        highest_received: 21,\n        last_range: 21,\n        num_blocks: 0,\n    },\n];\n\n// ack_range[] table from C ackrange_test — (range_min, range_max) pairs.\nconst ACK_RANGES: &[(u64, u64)] = &[\n    (1, 1000),\n    (0, 0),\n    (3001, 4000),\n    (4001, 5000),\n    (6001, 7000),\n    (5001, 6000),\n    (1501, 2500),\n    (501, 1500),\n    (501, 7500),\n];\n\n// ---------------------------------------------------------------------------\n// Local helpers\n\n/// C: `ack_range_mask` in sacktest.c.\nfn ack_range_mask(mask: &mut u64, mut highest: u64, range: u64) {\n    for _ in 0..range {\n        *mask |= 1u64 << (highest & 63);\n        highest = highest.wrapping_sub(1);\n    }\n}\n\n/// Parse and validate an encoded ACK frame.  C: `basic_ack_parse` in\n/// sacktest.c; translated to assert-on-failure rather than returning -1.\nfn basic_ack_parse(\n    bytes: &[u8],\n    expected: &ExpectedAck,\n    previous_mask: &mut u64,\n    expected_mask: u64,\n) {\n    assert!(!bytes.is_empty(), \"empty ACK frame buffer\");\n    assert_eq!(bytes[0], FrameType::Ack as u8, \"wrong frame type byte\");\n\n    let bytes_max = bytes.len();\n    let mut byte_index = 1usize;\n\n    let mut largest = 0u64;\n    let l_largest = varint_decode(&bytes[byte_index..], &mut largest);\n    assert_ne!(l_largest, 0, \"varint_decode largest failed\");\n    byte_index += l_largest;\n\n    let l_delay = varint_skip(&bytes[byte_index..]);\n    assert_ne!(l_delay, 0, \"varint_skip ack_delay failed\");\n    byte_index += l_delay;\n\n    let mut num_block = 0u64;\n    let l_num_block = varint_decode(&bytes[byte_index..], &mut num_block);\n    assert_ne!(l_num_block, 0, \"varint_decode num_block failed\");\n    byte_index += l_num_block;\n\n    let mut last_range = 0u64;\n    let l_last_range = varint_decode(&bytes[byte_index..], &mut last_range);\n    assert_ne!(l_last_range, 0, \"varint_decode last_range failed\");\n    byte_index += l_last_range;\n\n    assert!(\n        last_range <= largest,\n        \"last_range {last_range} > largest {largest}\"\n    );\n    let mut acked_mask = 0u64;\n    ack_range_mask(&mut acked_mask, largest, last_range + 1);\n    let mut gap_begin = largest.wrapping_sub(last_range).wrapping_sub(1);\n\n    for _ in 0..num_block {\n        let mut gap = 0u64;\n        let l_gap = varint_decode(&bytes[byte_index..], &mut gap);\n        assert_ne!(l_gap, 0, \"varint_decode gap failed\");\n        byte_index += l_gap;\n        gap += 1;\n\n        let mut ack_range = 0u64;\n        let l_range = varint_decode(&bytes[byte_index..], &mut ack_range);\n        assert_ne!(l_range, 0, \"varint_decode ack_range failed\");\n        byte_index += l_range;\n\n        assert!(gap <= gap_begin, \"gap {gap} > gap_begin {gap_begin}\");\n        gap_begin -= gap;\n\n        assert!(\n            gap_begin >= ack_range,\n            \"gap_begin {gap_begin} < ack_range {ack_range}\"\n        );\n        ack_range += 1;\n        ack_range_mask(&mut acked_mask, gap_begin, ack_range);\n        gap_begin -= ack_range;\n    }\n\n    assert_eq!(byte_index, bytes_max, \"ACK frame not fully consumed\");\n    assert_eq!(largest, expected.highest_received, \"largest mismatch\");\n    assert_eq!(last_range, expected.last_range, \"last_range mismatch\");\n    assert_eq!(num_block, expected.num_blocks, \"num_block mismatch\");\n\n    acked_mask |= *previous_mask;\n    assert_eq!(acked_mask, expected_mask, \"acked_mask mismatch\");\n    *previous_mask = acked_mask;\n}\n\n/// Inner body of `ack_loop` for a single (ack_gap, ack_delay_us) pair.\n/// C: `sendack_loop_test_one`.\nfn ack_loop_one(ack_gap: u64, ack_delay_us: u64) {\n    let pc = PacketContext::Application;\n    let t0 = Instant::from_ticks(0);\n    let mut quic = Quic::new(\n        8,\n        None,\n        None,\n        None,\n        None,\n        None,\n        None,\n        [0u8; RESET_SECRET_SIZE],\n        t0,\n        None,\n        None,\n    )\n    .expect(\"quic\");\n    let cnx = quic\n        .create_connection(\n            ConnectionId::default(),\n            ConnectionId::default(),\n            None,\n            t0,\n            0,\n            Some(util::TEST_SNI),\n            Some(\"minimal\"),\n            true,\n        )\n        .expect(\"cnx\");\n\n    let l_cid = cnx.create_local_connection_id(0, None, t0).expect(\"l_cid\");\n\n    cnx.sending_ecn_ack = false;\n    cnx.ack_delay_remote = Duration::from_ticks(ack_delay_us);\n    cnx.ack_gap_remote = ack_gap;\n\n    util::check_ack_ranges(&mut cnx.ack_ctx[pc as usize].sack_list);\n\n    let mut largest_received_number = 0u64;\n    let mut largest_ack_number = 0u64;\n    let mut largest_time_sent = 0u64;\n    let mut next_wake_time = Instant::from_ticks(u64::MAX);\n    let mut bytes = [0u8; 256];\n\n    for (i, &pn) in TEST_PNS.iter().enumerate() {\n        let mut ack_sent = false;\n        let mut out_of_order = false;\n        let current_time_base = i as u64 * 1000;\n\n        assert_eq!(\n            cnx.record_pn_received(pc, Some(l_cid), pn, Instant::from_ticks(current_time_base),),\n            0,\n            \"record_pn_received at step {i}\"\n        );\n\n        if largest_received_number + 1 != pn {\n            out_of_order = true;\n        }\n        cnx.set_ack_needed_on_path(\n            Instant::from_ticks(current_time_base),\n            pc,\n            0,\n            out_of_order as i32,\n        );\n\n        util::check_ack_ranges(&mut cnx.ack_ctx[pc as usize].sack_list);\n\n        if largest_received_number < pn {\n            largest_received_number = pn;\n        }\n\n        for k in 0..5u64 {\n            let mut more_data = 0i32;\n            let current_time = current_time_base + k * 10;\n\n            let ack_written = if cnx.is_ack_needed(\n                Instant::from_ticks(current_time),\n                &mut next_wake_time,\n                pc,\n                0,\n            ) {\n                let written = util::format_ack_frame_written(\n                    cnx,\n                    &mut bytes,\n                    &mut more_data,\n                    Instant::from_ticks(current_time),\n                    pc,\n                    0,\n                )\n                .expect(\"format_ack_frame returned None unexpectedly\");\n                assert_eq!(more_data, 0, \"more_data set at ({i},{k})\");\n                written\n            } else {\n                0\n            };\n\n            if ack_written == 0 {\n                if !ack_sent {\n                    assert!(\n                        largest_ack_number + ack_gap >= largest_received_number,\n                        \"missing ack by number at ({i},{k})\"\n                    );\n                    assert!(\n                        largest_time_sent.wrapping_add(ack_delay_us) >= largest_time_sent,\n                        \"missing ack by time at ({i},{k})\"\n                    );\n                }\n            } else {\n                assert!(!ack_sent, \"duplicate ack at ({i},{k})\");\n                assert!(\n                    !(largest_ack_number + ack_gap > largest_received_number\n                        && largest_time_sent + ack_delay_us > current_time\n                        && !out_of_order),\n                    \"ack sent before time or number at ({i},{k})\"\n                );\n                ack_sent = true;\n                largest_ack_number = largest_received_number;\n                largest_time_sent = current_time;\n            }\n        }\n    }\n}\n\n/// Inner body shared by `ack_disorder` and `ack_horizon`.\n/// C: `ack_disorder_test_one`.\nfn ack_disorder_one(log_name: &str, horizon_delay: i64, range_average_max: f64) {\n    const NB_RANGES: usize = 1000;\n    const NB_EVEN_RANGES: usize = NB_RANGES / 2;\n    const NB_ODD_RANGES: usize = NB_RANGES - NB_EVEN_RANGES;\n    const LOW_LATENCY: u64 = 11_111;\n    const HIGH_LATENCY: u64 = 300_000;\n    const ACK_INTERVAL: u64 = 100_000;\n    const PACKET_INTERVAL: u64 = 1_000;\n\n    struct AckItem {\n        pn: u64,\n        arrive_time: u64,\n        ackk_time: u64,\n        nb_ranges_arrive: usize,\n        nb_ranges_ack: usize,\n    }\n\n    let mut ackk_list: Vec<AckItem> = Vec::with_capacity(NB_RANGES);\n    let mut i_ackk: usize = 0;\n    let mut i_even_arrive: usize = 0;\n    let mut i_odd_arrive: usize = 0;\n    let mut t_even_arrive: u64 = LOW_LATENCY;\n    let mut t_odd_arrive: u64 = PACKET_INTERVAL + HIGH_LATENCY;\n\n    let mut sack0 = SackList::new();\n    sack0.horizon_delay = horizon_delay;\n\n    while i_even_arrive < NB_EVEN_RANGES || i_odd_arrive < NB_ODD_RANGES || i_ackk < ackk_list.len()\n    {\n        let mut next_time = u64::MAX;\n        let mut i_action: i32 = -1;\n\n        if i_odd_arrive < NB_ODD_RANGES {\n            i_action = 0;\n            next_time = t_odd_arrive;\n        }\n        if i_even_arrive < NB_EVEN_RANGES && t_even_arrive < next_time {\n            i_action = 1;\n            next_time = t_even_arrive;\n        }\n        if i_ackk < ackk_list.len() && ackk_list[i_ackk].ackk_time < next_time {\n            i_action = 2;\n            next_time = ackk_list[i_ackk].ackk_time;\n        }\n\n        match i_action {\n            0 => {\n                let pn = 2 * i_odd_arrive as u64 + 1;\n                i_odd_arrive += 1;\n                t_odd_arrive += PACKET_INTERVAL;\n                sack0\n                    .update(pn, pn, Instant::from_ticks(next_time))\n                    .expect(\"update sack (odd)\");\n                assert!(ackk_list.len() < NB_RANGES, \"ackk_list overflow\");\n                let nb = sack0.size();\n                ackk_list.push(AckItem {\n                    pn,\n                    arrive_time: next_time,\n                    ackk_time: next_time + ACK_INTERVAL,\n                    nb_ranges_arrive: nb,\n                    nb_ranges_ack: 0,\n                });\n            }\n            1 => {\n                let pn = 2 * i_even_arrive as u64;\n                i_even_arrive += 1;\n                t_even_arrive += PACKET_INTERVAL;\n                sack0\n                    .update(pn, pn, Instant::from_ticks(next_time))\n                    .expect(\"update sack (even)\");\n                assert!(ackk_list.len() < NB_RANGES, \"ackk_list overflow\");\n                let nb = sack0.size();\n                ackk_list.push(AckItem {\n                    pn,\n                    arrive_time: next_time,\n                    ackk_time: next_time + ACK_INTERVAL,\n                    nb_ranges_arrive: nb,\n                    nb_ranges_ack: 0,\n                });\n            }\n            2 => {\n                let pn = ackk_list[i_ackk].pn;\n                sack0.process_ack_of_ack_range(None, pn, pn);\n                ackk_list[i_ackk].nb_ranges_ack = sack0.size();\n                i_ackk += 1;\n            }\n            _ => unreachable!(\"unexpected i_action {i_action}\"),\n        }\n    }\n\n    // Write CSV log (mirrors C picoquic_file_open / fprintf).\n    {\n        use std::io::Write as _;\n        let mut f = std::fs::File::create(log_name).expect(\"create log file\");\n        writeln!(f, \"pn,arrive_time,ackk_time,nb_ranges_arrive,nb_ranges_ack\").unwrap();\n        for item in &ackk_list {\n            writeln!(\n                f,\n                \"{}, {}, {}, {}, {}\",\n                item.pn,\n                item.arrive_time,\n                item.ackk_time,\n                item.nb_ranges_arrive,\n                item.nb_ranges_ack,\n            )\n            .unwrap();\n        }\n    }\n\n    let sum_ranges_ack: usize = ackk_list.iter().map(|it| it.nb_ranges_ack).sum();\n    let range_average = sum_ranges_ack as f64 / ackk_list.len() as f64;\n    assert!(\n        range_average <= range_average_max,\n        \"got {range_average} ACK ranges, larger than expected {range_average_max}\"\n    );\n\n    sack0.free();\n}\n\n// ---------------------------------------------------------------------------\n// Tests\n\n/// C: `sacktest` in `picoquictest/sacktest.c`.\n///\n/// Records packet numbers from [`TEST_PNS`] into a minimal connection's\n/// SACK list, verifying after each step that `is_pn_already_received`\n/// and `record_pn_received` are consistent.\n#[test]\nfn ack_sack() {\n    let pc = PacketContext::Application;\n    let t0 = Instant::from_ticks(0);\n    let mut quic = Quic::new(\n        8,\n        None,\n        None,\n        None,\n        None,\n        None,\n        None,\n        [0u8; RESET_SECRET_SIZE],\n        t0,\n        None,\n        None,\n    )\n    .expect(\"quic\");\n\n    // Phase 1: basic pn=0 case (mirrors C before the reset).\n    {\n        let cnx = quic\n            .create_connection(\n                ConnectionId::default(),\n                ConnectionId::default(),\n                None,\n                t0,\n                0,\n                Some(util::TEST_SNI),\n                Some(\"minimal\"),\n                true,\n            )\n            .expect(\"cnx\");\n\n        let l_cid = cnx.create_local_connection_id(0, None, t0).expect(\"l_cid\");\n\n        assert!(\n            !cnx.is_pn_already_received(pc, Some(l_cid), 0),\n            \"pn 0 should not be received yet\"\n        );\n        assert_eq!(\n            cnx.record_pn_received(pc, Some(l_cid), 0, t0),\n            0,\n            \"first record of pn 0 should return 0\"\n        );\n        assert!(\n            cnx.is_pn_already_received(pc, Some(l_cid), 0),\n            \"pn 0 should now be received\"\n        );\n        // C: picoquic_sack_list_first == 0 (min PN), == Rust last()\n        assert_eq!(cnx.ack_ctx[pc as usize].sack_list.last(), 0);\n        // C: picoquic_sack_list_last == 0 (max PN), == Rust first()\n        assert_eq!(cnx.ack_ctx[pc as usize].sack_list.first(), 0);\n        assert!(cnx.ack_ctx[pc as usize].sack_list.first_range().is_none());\n    }\n\n    // Phase 2: fresh connection (mirrors picoquic_test_reset_minimal_cnx).\n    {\n        let cnx = quic\n            .create_connection(\n                ConnectionId::default(),\n                ConnectionId::default(),\n                None,\n                t0,\n                0,\n                Some(util::TEST_SNI),\n                Some(\"minimal\"),\n                true,\n            )\n            .expect(\"cnx after reset\");\n\n        let l_cid = cnx\n            .create_local_connection_id(0, None, t0)\n            .expect(\"l_cid after reset\");\n\n        util::check_ack_ranges(&mut cnx.ack_ctx[pc as usize].sack_list);\n\n        let mut highest_seen = 0u64;\n        let mut highest_seen_time = t0;\n\n        for (i, &pn) in TEST_PNS.iter().enumerate() {\n            let current_time = Instant::from_ticks(i as u64 * 100 + 1);\n\n            if pn > highest_seen {\n                highest_seen = pn;\n                highest_seen_time = current_time;\n            }\n\n            assert_eq!(\n                cnx.record_pn_received(pc, Some(l_cid), pn, current_time),\n                0,\n                \"record pn {pn} at step {i}\"\n            );\n            util::check_ack_ranges(&mut cnx.ack_ctx[pc as usize].sack_list);\n\n            for &pn_j in &TEST_PNS[..=i] {\n                assert!(\n                    cnx.is_pn_already_received(pc, Some(l_cid), pn_j),\n                    \"pn {pn_j} should be received at step {i}\"\n                );\n                assert_eq!(\n                    cnx.record_pn_received(pc, Some(l_cid), pn_j, current_time),\n                    1,\n                    \"duplicate record of pn {pn_j} should return 1 at step {i}\"\n                );\n            }\n\n            for &pn_j in &TEST_PNS[i + 1..] {\n                assert!(\n                    !cnx.is_pn_already_received(pc, Some(l_cid), pn_j),\n                    \"pn {pn_j} should not yet be received at step {i}\"\n                );\n            }\n        }\n\n        // Final state: [0..21] all received, contiguous.\n        // C: picoquic_sack_list_last == 21 (max) → Rust first()\n        assert_eq!(cnx.ack_ctx[pc as usize].sack_list.first(), 21);\n        // C: picoquic_sack_list_first == 0 (min) → Rust last()\n        assert_eq!(cnx.ack_ctx[pc as usize].sack_list.last(), 0);\n        assert_eq!(\n            cnx.ack_ctx[pc as usize].time_stamp_largest_received,\n            highest_seen_time\n        );\n        assert!(cnx.ack_ctx[pc as usize].sack_list.first_range().is_none());\n    }\n}\n\n/// C: `sendacktest` in `picoquictest/sacktest.c`.\n///\n/// Records [`TEST_PNS`] in order, formats an ACK frame after each, and\n/// validates the wire encoding against [`EXPECTED_ACKS`].\n#[test]\nfn ack_send() {\n    let pc = PacketContext::Application;\n    let t0 = Instant::from_ticks(0);\n    let mut quic = Quic::new(\n        8,\n        None,\n        None,\n        None,\n        None,\n        None,\n        None,\n        [0u8; RESET_SECRET_SIZE],\n        t0,\n        None,\n        None,\n    )\n    .expect(\"quic\");\n    let cnx = quic\n        .create_connection(\n            ConnectionId::default(),\n            ConnectionId::default(),\n            None,\n            t0,\n            0,\n            Some(util::TEST_SNI),\n            Some(\"minimal\"),\n            true,\n        )\n        .expect(\"cnx\");\n\n    cnx.sending_ecn_ack = false;\n    let l_cid = cnx.create_local_connection_id(0, None, t0).expect(\"l_cid\");\n\n    util::check_ack_ranges(&mut cnx.ack_ctx[pc as usize].sack_list);\n\n    let mut received_mask = 0u64;\n    let mut previous_mask = 0u64;\n    let mut bytes = [0u8; 256];\n\n    for (i, &pn) in TEST_PNS.iter().enumerate() {\n        let current_time = Instant::from_ticks(i as u64 * 100);\n\n        assert_eq!(\n            cnx.record_pn_received(pc, Some(l_cid), pn, current_time),\n            0,\n            \"record pn {pn} at step {i}\"\n        );\n        util::check_ack_ranges(&mut cnx.ack_ctx[pc as usize].sack_list);\n\n        let mut more_data = 0i32;\n        let written = util::format_ack_frame_written(cnx, &mut bytes, &mut more_data, t0, pc, 0)\n            .expect(\"format_ack_frame at step {i}\");\n\n        received_mask |= 1u64 << (pn & 63);\n        util::check_ack_ranges(&mut cnx.ack_ctx[pc as usize].sack_list);\n\n        basic_ack_parse(\n            &bytes[..written],\n            &EXPECTED_ACKS[i],\n            &mut previous_mask,\n            received_mask,\n        );\n    }\n}\n\n/// C: `sendack_loop_test` in `picoquictest/sacktest.c`.\n///\n/// Runs the gap/delay-triggered ACK loop for three (ack_gap, ack_delay)\n/// combinations to verify `is_ack_needed` / `format_ack_frame` fire at\n/// the right moments.\n#[test]\nfn ack_loop() {\n    let combinations: [(u64, u64); 3] = [(0, 0), (2, 1000), (10000, 25)];\n    for (ack_gap, ack_delay) in combinations {\n        ack_loop_one(ack_gap, ack_delay);\n    }\n}\n\n/// C: `ackrange_test` in `picoquictest/sacktest.c`.\n///\n/// Inserts ranges from [`ACK_RANGES`] into a standalone SACK list,\n/// checking for correct idempotency and final contiguous coverage.\n#[test]\nfn ack_range() {\n    let t0 = Instant::from_ticks(0);\n    let mut sack0 = SackList::new();\n\n    for (i, &(rmin, rmax)) in ACK_RANGES.iter().enumerate() {\n        // C: picoquic_check_sack_list == 0 means not yet in sack.\n        assert!(\n            !sack0.check(rmin, rmax),\n            \"range ({rmin},{rmax}) already in sack at step {i}\"\n        );\n        sack0.update(rmin, rmax, t0).expect(\"update sack\");\n        util::check_ack_ranges(&mut sack0);\n\n        for &(jmin, jmax) in ACK_RANGES.iter().take(i) {\n            assert!(\n                sack0.check(jmin, jmax),\n                \"range ({jmin},{jmax}) not in sack at step {i}\"\n            );\n        }\n    }\n\n    // Final state: [0..7500] fully covered (no gaps).\n    // C: picoquic_sack_list_first == 0 (min) → Rust last()\n    assert_eq!(sack0.last(), 0);\n    // C: picoquic_sack_list_last == 7500 (max) → Rust first()\n    assert_eq!(sack0.first(), 7500);\n    assert!(sack0.first_range().is_none());\n\n    sack0.free();\n}\n\n/// C: `ack_disorder_test` in `picoquictest/sacktest.c`.\n///\n/// Simulates out-of-order arrival on two paths and verifies the average\n/// number of ACK ranges stays below 133.\n#[test]\nfn ack_disorder() {\n    ack_disorder_one(\"ack_disorder_test.csv\", 0, 133.0);\n}\n\n/// C: `ack_horizon_test` in `picoquictest/sacktest.c`.\n///\n/// Same as `ack_disorder` but with a horizon delay of 1 s; the average\n/// range count budget rises to 196.\n#[test]\nfn ack_horizon() {\n    ack_disorder_one(\"ack_horizon_test.csv\", 1_000_000, 196.0);\n}\n","numLines":763,"startLine":1,"totalLines":763}}}
