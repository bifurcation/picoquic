{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01RDt9JViVZ5RB1sEHuoVhxR","type":"tool_result","content":"198\t\n199\t/*\n200\tInitial ping test.\n201\tThe QUIC tester sends a \"ping\" frame before sending the\n202\tclient hello. The test checks what happens, whether the\n203\tserver responds properly, or at all.\n204\t*/\n205\t\n206\tint initial_ping_test(void)\n207\t{\n208\t    uint64_t simulated_time = 0;\n209\t    uint64_t loss_mask = 0;\n210\t    picoquic_test_tls_api_ctx_t* test_ctx = NULL;\n211\t    uint8_t ping_frame[1] = { 1 };\n212\t    picoquic_connection_id_t initial_cid = { {0x4e, 0x54, 0x11, 0x11, 0x11, 0x11, 0x11, 0x11}, 8 };\n213\t    int ret = tls_api_init_ctx_ex(&test_ctx, PICOQUIC_INTERNAL_TEST_VERSION_1, PICOQUIC_TEST_SNI, PICOQUIC_TEST_ALPN, &simulated_time, NULL, NULL, 0, 0, 0, &initial_cid);\n214\t\n215\t    if (ret != 0)\n216\t    {\n217\t        DBG_PRINTF(\"Could not create the QUIC test contexts for V=%x\\n\", PICOQUIC_INTERNAL_TEST_VERSION_1);\n218\t    }\n219\t    else {\n220\t        picoquic_set_qlog(test_ctx->qserver, \".\");\n221\t    }\n222\t\n223\t    /*\n224\t    Insert a ping frame at the client, pass it to the server.\n225\t    */\n226\t    if (ret == 0) {\n227\t        ret = tester_push_frame_packet(test_ctx,\n228\t            picoquic_packet_initial,\n229\t            ping_frame, sizeof(ping_frame),\n230\t            1, 0, simulated_time);\n231\t    }\n232\t\n233\t    /*\n234\t    * Finish the test\n235\t    */\n236\t    if (ret == 0) {\n237\t        ret = tls_api_connection_loop(test_ctx, &loss_mask, 0, &simulated_time);\n238\t\n239\t        if (ret != 0)\n240\t        {\n241\t            DBG_PRINTF(\"Connection loop returns %d\\n\", ret);\n242\t        }\n243\t    }\n244\t\n245\t    if (ret == 0) {\n246\t        ret = tls_api_test_with_loss_final(test_ctx, PICOQUIC_TEST_SNI, PICOQUIC_TEST_ALPN, &simulated_time);\n247\t    }\n248\t\n249\t    if (test_ctx != NULL) {\n250\t        tls_api_delete_ctx(test_ctx);\n251\t        test_ctx = NULL;\n252\t    }\n253\t\n254\t    return ret;\n255\t}\n256\t\n257\t/*\n258\tInitial ping and ack test.\n259\tThe QUIC tester sends a \"ping\" frame before sending the\n260\tclient hello. Then, it sends an initial ACK and a handshake ACK\n261\tas soon as the server hello has been received.\n262\t\n263\tThe test checks what happens, whether the\n264\tserver responds properly, or at all.\n265\t*/\n266\t\n267\tint initial_ping_ack_test(void)\n268\t{\n269\t    uint64_t simulated_time = 0;\n270\t    uint64_t loss_mask = 0;\n271\t    picoquic_test_tls_api_ctx_t* test_ctx = NULL;\n272\t    uint8_t ping_frame[1] = { 1 };\n273\t    picoquic_connection_id_t initial_cid = { {0x4e, 0x54, 0x12, 0x12, 0x12, 0x12, 0x12, 0x12}, 8 };\n274\t    int ret = tls_api_init_ctx_ex(&test_ctx, PICOQUIC_INTERNAL_TEST_VERSION_1, PICOQUIC_TEST_SNI, PICOQUIC_TEST_ALPN, &simulated_time, NULL, NULL, 0, 0, 0, &initial_cid);\n275\t\n276\t    if (ret != 0)\n277\t    {\n278\t        DBG_PRINTF(\"Could not create the QUIC test contexts for V=%x\\n\", PICOQUIC_INTERNAL_TEST_VERSION_1);\n279\t    }\n280\t    else {\n281\t        picoquic_set_qlog(test_ctx->qserver, \".\");\n282\t        test_ctx->s_to_c_link->microsec_latency = 1;\n283\t        test_ctx->c_to_s_link->microsec_latency = 1;\n284\t    }\n285\t\n286\t    /*\n287\t    Insert a ping frame at the client, pass it to the server.\n288\t    */\n289\t    if (ret == 0) {\n290\t        ret = tester_push_frame_packet(test_ctx,\n291\t            picoquic_packet_initial,\n292\t            ping_frame, sizeof(ping_frame),\n293\t            1, 1, simulated_time);\n294\t    }\n295\t\n296\t    /*\n297\t    * Wait until the server hello has been received and the handshake key has\n298\t    * been computed.\n299\t    */\n300\t    if (ret == 0) {\n301\t        ret = tester_wait_handshake_key(test_ctx, &simulated_time);\n302\t    }\n303\t\n304\t    /* Insert Initial ACK packet as specified in issue report. */\n305\t\n306\t    if (r