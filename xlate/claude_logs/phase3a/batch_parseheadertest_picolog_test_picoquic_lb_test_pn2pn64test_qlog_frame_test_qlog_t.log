{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01SwT3CcqbSxq4PYnnzFB1nB","type":"tool_result","content":"1\t/*\n2\t* Author: Christian Huitema\n3\t* Copyright (c) 2017, Private Octopus, Inc.\n4\t* All rights reserved.\n5\t*\n6\t* Permission to use, copy, modify, and distribute this software for any\n7\t* purpose with or without fee is hereby granted, provided that the above\n8\t* copyright notice and this permission notice appear in all copies.\n9\t*\n10\t* THIS SOFTWARE IS PROVIDED BY THE COPYRIGHT HOLDERS AND CONTRIBUTORS \"AS IS\" AND\n11\t* ANY EXPRESS OR IMPLIED WARRANTIES, INCLUDING, BUT NOT LIMITED TO, THE IMPLIED\n12\t* WARRANTIES OF MERCHANTABILITY AND FITNESS FOR A PARTICULAR PURPOSE ARE\n13\t* DISCLAIMED. IN NO EVENT SHALL Private Octopus, Inc. BE LIABLE FOR ANY\n14\t* DIRECT, INDIRECT, INCIDENTAL, SPECIAL, EXEMPLARY, OR CONSEQUENTIAL DAMAGES\n15\t* (INCLUDING, BUT NOT LIMITED TO, PROCUREMENT OF SUBSTITUTE GOODS OR SERVICES;\n16\t* LOSS OF USE, DATA, OR PROFITS; OR BUSINESS INTERRUPTION) HOWEVER CAUSED AND\n17\t* ON ANY THEORY OF LIABILITY, WHETHER IN CONTRACT, STRICT LIABILITY, OR TORT\n18\t* (INCLUDING NEGLIGENCE OR OTHERWISE) ARISING IN ANY WAY OUT OF THE USE OF THIS\n19\t* SOFTWARE, EVEN IF ADVISED OF THE POSSIBILITY OF SUCH DAMAGE.\n20\t*/\n21\t\n22\t/* This file contains a set of tests copied from the \"QUIC Tester\"\n23\t*/\n24\t\n25\t\n26\t#include <stdlib.h>\n27\t#include <string.h>\n28\t#include <stdint.h>\n29\t#include \"picoquic.h\"\n30\t#include \"picoquic_internal.h\"\n31\t#include \"picoquictest_internal.h\"\n32\t#include \"tls_api.h\"\n33\t#include \"picoquic_binlog.h\"\n34\t#include \"logreader.h\"\n35\t#include \"qlog.h\"\n36\t#include \"autoqlog.h\"\n37\t\n38\t/* Wait until handshake key is ready */\n39\tint tester_wait_handshake_key(picoquic_test_tls_api_ctx_t* test_ctx, uint64_t* simulated_time)\n40\t{\n41\t    int ret = 0;\n42\t    uint64_t time_out = *simulated_time + 4000000;\n43\t    int nb_trials = 0;\n44\t    int nb_inactive = 0;\n45\t    int was_active = 0;\n46\t\n47\t    while (*simulated_time < time_out &&\n48\t        nb_trials < 1024 &&\n49\t        nb_inactive < 64 &&\n50\t        ret == 0) {\n51\t        was_active = 0;\n52\t        nb_trials++;\n53\t        \n54\t        if (test_ctx->cnx_client->cnx_state >= picoquic_state_client_handshake_start &&\n55\t            test_ctx->cnx_client->crypto_context[picoquic_epoch_handshake].aead_encrypt != NULL) {\n56\t            break;\n57\t        }\n58\t\n59\t        ret = tls_api_one_sim_round(test_ctx, simulated_time, time_out, &was_active);\n60\t\n61\t        if (was_active) {\n62\t            nb_inactive = 0;\n63\t            *simulated_time += 1000;\n64\t        }\n65\t        else {\n66\t            nb_inactive++;\n67\t        }\n68\t    }\n69\t\n70\t    return ret;\n71\t}\n72\t/* Format a minimalistic ACK frame\n73\t */\n74\tsize_t tester_simple_ack_frame(uint8_t* bytes, size_t bytes_size, uint64_t last_packet_number)\n75\t{\n76\t    size_t length = 0;\n77\t    uint8_t* bytes_max = bytes + bytes_size;\n78\t    uint8_t* bytes_first = bytes;\n79\t\n80\t    if ((bytes = picoquic_frames_varint_encode(bytes, bytes_max, picoquic_frame_type_ack)) != NULL &&\n81\t        (bytes = picoquic_frames_varint_encode(bytes, bytes_max, last_packet_number)) != NULL &&\n82\t        (bytes = picoquic_frames_varint_encode(bytes, bytes_max, 0 /* ack delay */)) != NULL &&\n83\t        (bytes = picoquic_frames_varint_encode(bytes, bytes_max, 0 /* range count */)) != NULL &&\n84\t        (bytes = picoquic_frames_varint_encode(bytes, bytes_max, 0 /* first ack range */)) != NULL) {\n85\t        length = bytes - bytes_first;\n86\t    }\n87\t    return length;\n88\t}\n89\t\n90\t\n91\t/* Forcefully insert a packet in the client flow\n92\t */\n93\t\n94\tpicoquic_packet_t* tester_init_packet(picoquic_cnx_t* cnx, picoquic_packet_type_enum ptype)\n95\t{\n96\t    picoquic_packet_t* packet = picoquic_create_packet(cnx->quic);\n97\t\n98\t    if (packet != NULL) {\n99\t        packet->checksum_overhead = 16;\n100\t        packet->ptype = ptype;\n101\t        switch (ptype) {\n102\t        case picoquic_packet_initial:\n103\t            packet->pc = picoquic_packet_context_initial;\n104\t            break;\n105\t        case picoquic_packet_handshake:\n106\t            packet->pc = picoquic_packet_context_handshake;\n107\t            break;\n108\t        case picoquic_packet_0rtt_protected:\n109\t            packet->pc = picoquic_packet_context_application;\n110\t            break;\n111\t        case picoquic_packet_1rtt_protected:\n112\t            packet->pc = picoquic_packet_context_application;\n113\t            break;\n114\t        default:\n115\t            picoquic_recycle_packet(cnx->quic, packet);\n116\t            break;\n117\t        }\n118\t    }\n119\t    if (packet != NULL) {\n120\t        packet->offset = picoquic_predict_packet_header_length(cnx, ptype, &cnx->pkt_ctx[packet->pc]);\n121\t        packet->length = packet->offset;\n122\t        packet->send_path = cnx->path[0];\n123\t    }\n124\t    return (packet);\n125\t}\n126\t\n127\tvoid tester_add_frame(picoquic_packet_t* packet, uint8_t* frame, size_t frame_length)\n128\t{\n129\t    if (packet->length + frame_length < sizeof(packet->bytes)) {\n130\t        memcpy(&packet->bytes[packet->length], frame, frame_length);\n131\t        packet->length += frame_length;\n132\t    }\n133\t}\n134\t\n135\tvoid tester_finalize_packet(picoquic_cnx_t* cnx,\n136\t    picoquic_packet_t* packet, size_t length, uint64_t current_time,\n137\t    size_t* send_length,\n138\t    uint8_t* send_buffer, size_t send_buffer_max)\n139\t{\n140\t    picoquic_path_t* path_x = cnx->path[0];\n141\t    packet->length = length;\n142\t\n143\t    picoquic_finalize_and_protect_packet(cnx, packet,\n144\t        0, length, packet->offset, packet->checksum_overhead,\n145\t        send_length, send_buffer, send_buffer_max,\n146\t        path_x, current_time);\n147\t}\n148\t\n149\tint tester_push_frame_packet(picoquic_test_tls_api_ctx_t* test_ctx,\n150\t    picoquic_packet_type_enum ptype, uint8_t* frame, size_t frame_length,\n151\t    int shall_pad, int shall_queue, uint64_t current_time)\n152\t{\n153\t    int ret = 0;\n154\t    picoquic_packet_t* packet = tester_init_packet(test_ctx->cnx_client,\n155\t        ptype);\n156\t\n157\t    if (packet == NULL) {\n158\t        ret = -1;\n159\t    }\n160\t    else {\n161\t        tester_add_frame(packet, frame, frame_length);\n162\t    }\n163\t\n164\t    if (shall_pad) {\n165\t        packet->length = picoquic_pad_to_target_length(\n166\t            packet->bytes, packet->length,\n167\t            packet->send_path->send_mtu - packet->checksum_overhead);\n168\t    }\n169\t\n170\t    if (ret == 0) {\n171\t        picoquictest_sim_packet_t* sim_packet = picoquictest_sim_link_create_packet();\n172\t\n173\t        if (sim_packet != NULL) {\n174\t            uint8_t* send_buffer = sim_packet->bytes;\n175\t            size_t send_length = 0;\n176\t\n177\t            tester_finalize_packet(test_ctx->cnx_client,\n178\t                packet, packet->length, current_time,\n179\t                &send_length, send_buffer, PICOQUIC_MAX_PACKET_SIZE);\n180\t\n181\t            if (shall_queue) {\n182\t                picoquic_store_addr(&sim_packet->addr_from, (struct sockaddr*)&test_ctx->client_addr);\n183\t                picoquic_store_addr(&sim_packet->addr_to, (struct sockaddr*)&test_ctx->server_addr);\n184\t                sim_packet->ecn_mark = test_ctx->packet_ecn_default;\n185\t                sim_packet->length = send_length;\n186\t                picoquictest_sim_link_submit(test_ctx->c_to_s_link, sim_packet, current_time);\n187\t            }\n188\t            else {\n189\t                picoquic_incoming_packet(test_ctx->qserver, send_buffer, send_length,\n190\t                    (struct sockaddr*)&test_ctx->client_addr, (struct sockaddr*)&test_ctx->server_addr, 0,\n191\t                    0, current_time);\n192\t                free(sim_packet);\n193\t            }\n194\t        }\n195\t    }\n196\t    return ret;\n197\t}\n198\t\n199\t/*\n200\tInitial ping test.\n201\tThe QUIC tester sends a \"ping\" frame before sending the\n202\tclient hello. The test checks what happens, whether the\n203\tserver responds properly, or at all.\n204\t*/\n205\t\n206\tint initial_ping_test(void)\n207\t{\n208\t    uint64_t simulated_time = 0;\n209\t    uint64_t loss_mask = 0;\n210\t    picoquic_test_tls_api_ctx_t* test_ctx = NULL;\n211\t    uint8_t ping_frame[1] = { 1 };\n212\t    picoquic_connection_id_t initial_cid = { {0x4e, 0x54, 0x11, 0x11, 0x11, 0x11, 0x11, 0x11}, 8 };\n213\t    int ret = tls_api_init_ctx_ex(&test_ctx, PICOQUIC_INTERNAL_TEST_VERSION_1, PICOQUIC_TEST_SNI, PICOQUIC_TEST_ALPN, &simulated_time, NULL, NULL, 0, 0, 0, &initial_cid);\n214\t\n215\t    if (ret != 0)\n216\t    {\n217\t        DBG_PRINTF(\"Could not create the QUIC test contexts for V=%x\\n\", PICOQUIC_INTERNAL_TEST_VERSION_1);\n218\t    }\n219\t    else {\n220\t        picoquic_set_qlog(test_ctx->qserver, \".\");\n221\t    }\n222\t\n223\t    /*\n224\t    Insert a ping frame at the client, pass it to the server.\n225\t    */\n226\t    if (ret == 0) {\n227\t        ret = tester_push_frame_packet(test_ctx,\n228\t            picoquic_packet_initial,\n229\t            ping_frame, sizeof(ping_frame),\n230\t            1, 0, simulated_time);\n231\t    }\n232\t\n233\t    /*\n234\t    * Finish the test\n235\t    */\n236\t    if (ret == 0) {\n237\t        ret = tls_api_connection_loop(test_ctx, &loss_mask, 0, &simulated_time);\n238\t\n239\t        if (ret != 0)\n240\t        {\n241\t            DBG_PRINTF(\"Connection loop returns %d\\n\", ret);\n242\t        }\n243\t    }\n244\t\n245\t    if (ret == 0) {\n246\t        ret = tls_api_test_with_loss_final(test_ctx, PICOQUIC_TEST_SNI, PICOQUIC_TEST_ALPN, &simulated_time);\n247\t    }\n248\t\n249\t    if (test_ctx != NULL) {\n250\t        tls_api_delete_ctx(test_ctx);\n251\t        test_ctx = NULL;\n252\t    }\n253\t\n254\t    return ret;\n255\t}\n256\t\n257\t/*\n258\tInitial ping and ack test.\n259\tThe QUIC tester sends a \"ping\" frame before sending the\n260\tclient hello. Then, it sends an initial ACK and a handshake ACK\n261\tas soon as the server hello has been received.\n262\t\n263\tThe test checks what happens, whether the\n264\tserver responds properly, or at all.\n265\t*/\n266\t\n267\tint initial_ping_ack_test(void)\n268\t{\n269\t    uint64_t simulated_time = 0;\n270\t    uint64_t loss_mask = 0;\n271\t    picoquic_test_tls_api_ctx_t* test_ctx = NULL;\n272\t    uint8_t ping_frame[1] = { 1 };\n273\t    picoquic_connection_id_t initial_cid = { {0x4e, 0x54, 0x12, 0x12, 0x12, 0x12, 0x12, 0x12}, 8 };\n274\t    int ret = tls_api_init_ctx_ex(&test_ctx, PICOQUIC_INTERNAL_TEST_VERSION_1, PICOQUIC_TEST_SNI, PICOQUIC_TEST_ALPN, &simulated_time, NULL, NULL, 0, 0, 0, &initial_cid);\n275\t\n276\t    if (ret != 0)\n277\t    {\n278\t        DBG_PRINTF(\"Could not create the QUIC test contexts for V=%x\\n\", PICOQUIC_INTERNAL_TEST_VERSION_1);\n279\t    }\n280\t    else {\n281\t        picoquic_set_qlog(test_ctx->qserver, \".\");\n282\t        test_ctx->s_to_c_link->microsec_latency = 1;\n283\t        test_ctx->c_to_s_link->microsec_latency = 1;\n284\t    }\n285\t\n286\t    /*\n287\t    Insert a ping frame at the client, pass it to the server.\n288\t    */\n289\t    if (ret == 0) {\n290\t        ret = tester_push_frame_packet(test_ctx,\n291\t            picoquic_packet_initial,\n292\t            ping_frame, sizeof(ping_frame),\n293\t            1, 1, simulated_time);\n294\t    }\n295\t\n296\t    /*\n297\t    * Wait until the server hello has been received and the handshake key has\n298\t    * been computed.\n299\t    */\n300\t    if (ret == 0) {\n301\t        ret = tester_wait_handshake_key(test_ctx, &simulated_time);\n302\t    }\n303\t\n304\t    /* Insert Initial ACK packet as specified in issue report. */\n305\t\n306\t    if (ret == 0) {\n307\t        uint8_t ack_frame[128];\n308\t        size_t ack_frame_length = tester_simple_ack_frame(ack_frame, sizeof(ack_frame), 1);\n309\t\n310\t        ret = tester_push_frame_packet(test_ctx, picoquic_packet_initial,\n311\t            ack_frame, ack_frame_length, 1, 0, simulated_time);\n312\t    }\n313\t\n314\t    /* Insert Handshake ack packets, as specified.\n315\t     */\n316\t    if (ret == 0) {\n317\t        uint8_t ack_frame[128];\n318\t        size_t ack_frame_length = tester_simple_ack_frame(ack_frame, sizeof(ack_frame), 1);\n319\t        ret = tester_push_frame_packet(test_ctx, picoquic_packet_handshake,\n320\t            ack_frame, ack_frame_length, 0, 0, simulated_time);\n321\t    }\n322\t\n323\t    /*\n324\t    * Finish the test\n325\t    */\n326\t    if (ret == 0) {\n327\t        ret = tls_api_connection_loop(test_ctx, &loss_mask, 0, &simulated_time);\n328\t\n329\t        if (ret != 0)\n330\t        {\n331\t            DBG_PRINTF(\"Connection loop returns %d\\n\", ret);\n332\t        }\n333\t    }\n334\t\n335\t    if (ret == 0) {\n336\t        ret = tls_api_test_with_loss_final(test_ctx, PICOQUIC_TEST_SNI, PICOQUIC_TEST_ALPN, &simulated_time);\n337\t    }\n338\t\n339\t    if (test_ctx != NULL) {\n340\t        tls_api_delete_ctx(test_ctx);\n341\t        test_ctx = NULL;\n342\t    }\n343\t\n344\t    return ret;\n345\t}\n346\t"}]},"parent_tool_use_id":null,"session_id":"d6e0a846-1f78-4cd7-8562-a63ac35b77bc","uuid":"173c7119-56bb-4f34-8dd1-b4238ed77723","timestamp":"2026-05-05T11:32:23.118Z","tool_use_result":{"type":"text","file":{"filePath":"/Users/richbarn/Projects/picoquic/picoquictest/quic_tester.c","content":"/*\n* Author: Christian Huitema\n* Copyright (c) 2017, Private Octopus, Inc.\n* All rights reserved.\n*\n* Permission to use, copy, modify, and distribute this software for any\n* purpose with or without fee is hereby granted, provided that the above\n* copyright notice and this permission notice appear in all copies.\n*\n* THIS SOFTWARE IS PROVIDED BY THE COPYRIGHT HOLDERS AND CONTRIBUTORS \"AS IS\" AND\n* ANY EXPRESS OR IMPLIED WARRANTIES, INCLUDING, BUT NOT LIMITED TO, THE IMPLIED\n* WARRANTIES OF MERCHANTABILITY AND FITNESS FOR A PARTICULAR PURPOSE ARE\n* DISCLAIMED. IN NO EVENT SHALL Private Octopus, Inc. BE LIABLE FOR ANY\n* DIRECT, INDIRECT, INCIDENTAL, SPECIAL, EXEMPLARY, OR CONSEQUENTIAL DAMAGES\n* (INCLUDING, BUT NOT LIMITED TO, PROCUREMENT OF SUBSTITUTE GOODS OR SERVICES;\n* LOSS OF USE, DATA, OR PROFITS; OR BUSINESS INTERRUPTION) HOWEVER CAUSED AND\n* ON ANY THEORY OF LIABILITY, WHETHER IN CONTRACT, STRICT LIABILITY, OR TORT\n* (INCLUDING NEGLIGENCE OR OTHERWISE) ARISING IN ANY WAY OUT OF THE USE OF THIS\n* SOFTWARE, EVEN IF ADVISED OF THE POSSIBILITY OF SUCH DAMAGE.\n*/\n\n/* This file contains a set of tests copied from the \"QUIC Tester\"\n*/\n\n\n#include <stdlib.h>\n#include <string.h>\n#include <stdint.h>\n#include \"picoquic.h\"\n#include \"picoquic_internal.h\"\n#include \"picoquictest_internal.h\"\n#include \"tls_api.h\"\n#include \"picoquic_binlog.h\"\n#include \"logreader.h\"\n#include \"qlog.h\"\n#include \"autoqlog.h\"\n\n/* Wait until handshake key is ready */\nint tester_wait_handshake_key(picoquic_test_tls_api_ctx_t* test_ctx, uint64_t* simulated_time)\n{\n    int ret = 0;\n    uint64_t time_out = *simulated_time + 4000000;\n    int nb_trials = 0;\n    int nb_inactive = 0;\n    int was_active = 0;\n\n    while (*simulated_time < time_out &&\n        nb_trials < 1024 &&\n        nb_inactive < 64 &&\n        ret == 0) {\n        was_active = 0;\n        nb_trials++;\n        \n        if (test_ctx->cnx_client->cnx_state >= picoquic_state_client_handshake_start &&\n            test_ctx->cnx_client->crypto_context[picoquic_epoch_handshake].aead_encrypt != NULL) {\n            break;\n        }\n\n        ret = tls_api_one_sim_round(test_ctx, simulated_time, time_out, &was_active);\n\n        if (was_active) {\n            nb_inactive = 0;\n            *simulated_time += 1000;\n        }\n        else {\n            nb_inactive++;\n        }\n    }\n\n    return ret;\n}\n/* Format a minimalistic ACK frame\n */\nsize_t tester_simple_ack_frame(uint8_t* bytes, size_t bytes_size, uint64_t last_packet_number)\n{\n    size_t length = 0;\n    uint8_t* bytes_max = bytes + bytes_size;\n    uint8_t* bytes_first = bytes;\n\n    if ((bytes = picoquic_frames_varint_encode(bytes, bytes_max, picoquic_frame_type_ack)) != NULL &&\n        (bytes = picoquic_frames_varint_encode(bytes, bytes_max, last_packet_number)) != NULL &&\n        (bytes = picoquic_frames_varint_encode(bytes, bytes_max, 0 /* ack delay */)) != NULL &&\n        (bytes = picoquic_frames_varint_encode(bytes, bytes_max, 0 /* range count */)) != NULL &&\n        (bytes = picoquic_frames_varint_encode(bytes, bytes_max, 0 /* first ack range */)) != NULL) {\n        length = bytes - bytes_first;\n    }\n    return length;\n}\n\n\n/* Forcefully insert a packet in the client flow\n */\n\npicoquic_packet_t* tester_init_packet(picoquic_cnx_t* cnx, picoquic_packet_type_enum ptype)\n{\n    picoquic_packet_t* packet = picoquic_create_packet(cnx->quic);\n\n    if (packet != NULL) {\n        packet->checksum_overhead = 16;\n        packet->ptype = ptype;\n        switch (ptype) {\n        case picoquic_packet_initial:\n            packet->pc = picoquic_packet_context_initial;\n            break;\n        case picoquic_packet_handshake:\n            packet->pc = picoquic_packet_context_handshake;\n            break;\n        case picoquic_packet_0rtt_protected:\n            packet->pc = picoquic_packet_context_application;\n            break;\n        case picoquic_packet_1rtt_protected:\n            packet->pc = picoquic_packet_context_application;\n            break;\n        default:\n            picoquic_recycle_packet(cnx->quic, packet);\n            break;\n        }\n    }\n    if (packet != NULL) {\n        packet->offset = picoquic_predict_packet_header_length(cnx, ptype, &cnx->pkt_ctx[packet->pc]);\n        packet->length = packet->offset;\n        packet->send_path = cnx->path[0];\n    }\n    return (packet);\n}\n\nvoid tester_add_frame(picoquic_packet_t* packet, uint8_t* frame, size_t frame_length)\n{\n    if (packet->length + frame_length < sizeof(packet->bytes)) {\n        memcpy(&packet->bytes[packet->length], frame, frame_length);\n        packet->length += frame_length;\n    }\n}\n\nvoid tester_finalize_packet(picoquic_cnx_t* cnx,\n    picoquic_packet_t* packet, size_t length, uint64_t current_time,\n    size_t* send_length,\n    uint8_t* send_buffer, size_t send_buffer_max)\n{\n    picoquic_path_t* path_x = cnx->path[0];\n    packet->length = length;\n\n    picoquic_finalize_and_protect_packet(cnx, packet,\n        0, length, packet->offset, packet->checksum_overhead,\n        send_length, send_buffer, send_buffer_max,\n        path_x, current_time);\n}\n\nint tester_push_frame_packet(picoquic_test_tls_api_ctx_t* test_ctx,\n    picoquic_packet_type_enum ptype, uint8_t* frame, size_t frame_length,\n    int shall_pad, int shall_queue, uint64_t current_time)\n{\n    int ret = 0;\n    picoquic_packet_t* packet = tester_init_packet(test_ctx->cnx_client,\n        ptype);\n\n    if (packet == NULL) {\n        ret = -1;\n    }\n    else {\n        tester_add_frame(packet, frame, frame_length);\n    }\n\n    if (shall_pad) {\n        packet->length = picoquic_pad_to_target_length(\n            packet->bytes, packet->length,\n            packet->send_path->send_mtu - packet->checksum_overhead);\n    }\n\n    if (ret == 0) {\n        picoquictest_sim_packet_t* sim_packet = picoquictest_sim_link_create_packet();\n\n        if (sim_packet != NULL) {\n            uint8_t* send_buffer = sim_packet->bytes;\n            size_t send_length = 0;\n\n            tester_finalize_packet(test_ctx->cnx_client,\n                packet, packet->length, current_time,\n                &send_length, send_buffer, PICOQUIC_MAX_PACKET_SIZE);\n\n            if (shall_queue) {\n                picoquic_store_addr(&sim_packet->addr_from, (struct sockaddr*)&test_ctx->client_addr);\n                picoquic_store_addr(&sim_packet->addr_to, (struct sockaddr*)&test_ctx->server_addr);\n                sim_packet->ecn_mark = test_ctx->packet_ecn_default;\n                sim_packet->length = send_length;\n                picoquictest_sim_link_submit(test_ctx->c_to_s_link, sim_packet, current_time);\n            }\n            else {\n                picoquic_incoming_packet(test_ctx->qserver, send_buffer, send_length,\n                    (struct sockaddr*)&test_ctx->client_addr, (struct sockaddr*)&test_ctx->server_addr, 0,\n                    0, current_time);\n                free(sim_packet);\n            }\n        }\n    }\n    return ret;\n}\n\n/*\nInitial ping test.\nThe QUIC tester sends a \"ping\" frame before sending the\nclient hello. The test checks what happens, whether the\nserver responds properly, or at all.\n*/\n\nint initial_ping_test(void)\n{\n    uint64_t simulated_time = 0;\n    uint64_t loss_mask = 0;\n    picoquic_test_tls_api_ctx_t* test_ctx = NULL;\n    uint8_t ping_frame[1] = { 1 };\n    picoquic_connection_id_t initial_cid = { {0x4e, 0x54, 0x11, 0x11, 0x11, 0x11, 0x11, 0x11}, 8 };\n    int ret = tls_api_init_ctx_ex(&test_ctx, PICOQUIC_INTERNAL_TEST_VERSION_1, PICOQUIC_TEST_SNI, PICOQUIC_TEST_ALPN, &simulated_time, NULL, NULL, 0, 0, 0, &initial_cid);\n\n    if (ret != 0)\n    {\n        DBG_PRINTF(\"Could not create the QUIC test contexts for V=%x\\n\", PICOQUIC_INTERNAL_TEST_VERSION_1);\n    }\n    else {\n        picoquic_set_qlog(test_ctx->qserver, \".\");\n    }\n\n    /*\n    Insert a ping frame at the client, pass it to the server.\n    */\n    if (ret == 0) {\n        ret = tester_push_frame_packet(test_ctx,\n            picoquic_packet_initial,\n            ping_frame, sizeof(ping_frame),\n            1, 0, simulated_time);\n    }\n\n    /*\n    * Finish the test\n    */\n    if (ret == 0) {\n        ret = tls_api_connection_loop(test_ctx, &loss_mask, 0, &simulated_time);\n\n        if (ret != 0)\n        {\n            DBG_PRINTF(\"Connection loop returns %d\\n\", ret);\n        }\n    }\n\n    if (ret == 0) {\n        ret = tls_api_test_with_loss_final(test_ctx, PICOQUIC_TEST_SNI, PICOQUIC_TEST_ALPN, &simulated_time);\n    }\n\n    if (test_ctx != NULL) {\n        tls_api_delete_ctx(test_ctx);\n        test_ctx = NULL;\n    }\n\n    return ret;\n}\n\n/*\nInitial ping and ack test.\nThe QUIC tester sends a \"ping\" frame before sending the\nclient hello. Then, it sends an initial ACK and a handshake ACK\nas soon as the server hello has been received.\n\nThe test checks what happens, whether the\nserver responds properly, or at all.\n*/\n\nint initial_ping_ack_test(void)\n{\n    uint64_t simulated_time = 0;\n    uint64_t loss_mask = 0;\n    picoquic_test_tls_api_ctx_t* test_ctx = NULL;\n    uint8_t ping_frame[1] = { 1 };\n    picoquic_connection_id_t initial_cid = { {0x4e, 0x54, 0x12, 0x12, 0x12, 0x12, 0x12, 0x12}, 8 };\n    int ret = tls_api_init_ctx_ex(&test_ctx, PICOQUIC_INTERNAL_TEST_VERSION_1, PICOQUIC_TEST_SNI, PICOQUIC_TEST_ALPN, &simulated_time, NULL, NULL, 0, 0, 0, &initial_cid);\n\n    if (ret != 0)\n    {\n        DBG_PRINTF(\"Could not create the QUIC test contexts for V=%x\\n\", PICOQUIC_INTERNAL_TEST_VERSION_1);\n    }\n    else {\n        picoquic_set_qlog(test_ctx->qserver, \".\");\n        test_ctx->s_to_c_link->microsec_latency = 1;\n        test_ctx->c_to_s_link->microsec_latency = 1;\n    }\n\n    /*\n    Insert a ping frame at the client, pass it to the server.\n    */\n    if (ret == 0) {\n        ret = tester_push_frame_packet(test_ctx,\n            picoquic_packet_initial,\n            ping_frame, sizeof(ping_frame),\n            1, 1, simulated_time);\n    }\n\n    /*\n    * Wait until the server hello has been received and the handshake key has\n    * been computed.\n    */\n    if (ret == 0) {\n        ret = tester_wait_handshake_key(test_ctx, &simulated_time);\n    }\n\n    /* Insert Initial ACK packet as specified in issue report. */\n\n    if (ret == 0) {\n        uint8_t ack_frame[128];\n        size_t ack_frame_length = tester_simple_ack_frame(ack_frame, sizeof(ack_frame), 1);\n\n        ret = tester_push_frame_packet(test_ctx, picoquic_packet_initial,\n            ack_frame, ack_frame_length, 1, 0, simulated_time);\n    }\n\n    /* Insert Handshake ack packets, as specified.\n     */\n    if (ret == 0) {\n        uint8_t ack_frame[128];\n        size_t ack_frame_length = tester_simple_ack_frame(ack_frame, sizeof(ack_frame), 1);\n        ret = tester_push_frame_packet(test_ctx, picoquic_packet_handshake,\n            ack_frame, ack_frame_length, 0, 0, simulated_time);\n    }\n\n    /*\n    * Finish the test\n    */\n    if (ret == 0) {\n        ret = tls_api_connection_loop(test_ctx, &loss_mask, 0, &simulated_time);\n\n        if (ret != 0)\n        {\n            DBG_PRINTF(\"Connection loop returns %d\\n\", ret);\n        }\n    }\n\n    if (ret == 0) {\n        ret = tls_api_test_with_loss_final(test_ctx, PICOQUIC_TEST_SNI, PICOQUIC_TEST_ALPN, &simulated_time);\n    }\n\n    if (test_ctx != NULL) {\n        tls_api_delete_ctx(test_ctx);\n        test_ctx = NULL;\n    }\n\n    return ret;\n}\n","numLines":346,"startLine":1,"totalLines":346}}}
