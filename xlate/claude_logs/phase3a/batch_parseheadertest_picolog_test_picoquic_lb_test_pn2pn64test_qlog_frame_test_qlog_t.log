ncer test I'd initialize it with mostly `None` values and zero for the timestamp since `Instant` is likely measured in microseconds.","signature":""}],"stop_reason":null,"stop_sequence":null,"stop_details":null,"usage":{"input_tokens":1,"cache_creation_input_tokens":2065,"cache_read_input_tokens":88145,"cache_creation":{"ephemeral_5m_input_tokens":0,"ephemeral_1h_input_tokens":2065},"output_tokens":8,"service_tier":"standard","inference_geo":"not_available"},"diagnostics":null,"context_management":null},"parent_tool_use_id":null,"session_id":"d6e0a846-1f78-4cd7-8562-a63ac35b77bc","uuid":"7e221114-66ef-45fc-bb04-8c19e88baaa3"}
