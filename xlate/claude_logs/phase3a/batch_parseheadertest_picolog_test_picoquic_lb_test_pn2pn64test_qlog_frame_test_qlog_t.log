g AES contexts mutate cipher state in place.  `quic`\n168\t    /// is read for `local_connection_id_length`; the unused `connection_id_local` /\n169\t    /// `connection_id_remote` parameters of the C signature are dropped\n170\t    /// here and reintroduced (if needed) by the\n171\t    /// [`crate::ConnectionIdCallback`] adapter.\n172\t    pub fn generate(&mut self, _quic: &Quic, _nonce: &ConnectionId) -> ConnectionId {\n173\t        todo!()\n174\t    }\n175\t\n176\t    /// Decode the server ID embedded in `connection_id`.  Returns `None`\n177\t    /// when the CID length doesn't match `self.connection_id_length`\n178\t    /// or when `self.method` is unrecognised; the C sentinel\n179\t    /// `UINT64_MAX` is folded into `Option`.\n180\t    /// C: `lb_compat_cid_verify`.\n181\t    ///\n182\t    /// `&mut self` because the underlying AES contexts mutate\n183\t    /// cipher state in place.\n184\t    pub fn verify(&mut self, _cnx_id: &ConnectionId) -> Option<u64> {\n185\t        todo!()\n186\t    }\n187\t}\n188\t\n189\timpl Quic {\n190\t    /// Apply `lb_config` to `self`, installing a [`ConnectionIdContext`]\n191\t    /// as the connection-ID callback context.\n192\t    /// C: `lb_compat_cid_config`.\n193\t    ///\n194\t    /// Returns `Err` when `self` already has a different CID\n195\t    /// callback configured, when the requested CID length doesn't\n196\t    /// fit the chosen method, or when the AES context allocation\n197\t    /// fails.\n198\t    pub fn set_lb_cid_config(&mut self, _lb_config: &Config) -> Result<(), Error> {\n199\t        todo!()\n200\t    }\n201\t\n202\t    /// Tear down the [`ConnectionIdContext`] previously installed by\n203\t    /// [`Quic::set_lb_cid_config`], releasing the AES-ECB\n204\t    /// encryption contexts and clearing the callback slot on\n205\t    /// `self`.  No-op when no LB CID context is installed.\n206\t    /// C: `lb_compat_cid_config_free`.\n207\t    pub fn clear_lb_cid_config(&mut self) {\n208\t        todo!()\n209\t  