tion of this link-state segment in microseconds.  C: `duration`.\n843\t    pub duration: u64,\n844\t    /// Uplink bandwidth (bits per second).  C: `bits_per_second_up`.\n845\t    pub bits_per_second_up: u64,\n846\t    /// Downlink bandwidth (bits per second).  C: `bits_per_second_down`.\n847\t    pub bits_per_second_down: u64,\n848\t    /// One-way latency (microseconds).  C: `microsec_latency`.\n849\t    pub microsec_latency: u64,\n850\t}\n851\t\n852\t/// Run a full scenario with optional time-varying link states.\n853\t/// Extends [`tls_api_one_scenario_body`] with a link-state list for\n854\t/// bandwidth/latency variation during the test.\n855\t/// C: `tls_api_one_scenario_body_ex`.\n856\t#[allow(clippy::too_many_arguments)]\n857\tpub fn tls_api_one_scenario_body_ex(\n858\t    _test_ctx: &mut TestTlsApiCtx,\n859\t    _simulated_time: &mut Instant,\n860\t    _scenario: &[TestApiStreamDesc],\n861\t    _stream0_target: usize,\n862\t    _init_loss_mask: u64,\n863\t    _max_data: u64,\n864\t    _queue_delay_max: u64,\n865\t    _max_completion_microsec: u64,\n866\t    _link_states: &[VaryLinkSpec],\n867\t) -> crate::Result<()> {\n868\t    todo!()\n869\t}\n870\t\n871\t/// Compare two text files byte-for-byte; return `Err` if they differ.\n872\t/// C: `picoquic_test_compare_text_files`.\n873\tpub fn compare_text_files(_file1: &str, _file2: &str) -> crate::Result<()> {\n874\t    todo!()\n875\t}\n876\t\n877\t/// Create a minimal QUIC context + connection pair for unit testing,\n878\t/// seeding `simulated_time`.\n879\t/// C: `picoquic_test_set_minimal_cnx_with_time`.\n880\t///\n881\t/// Returns the quic context; the connection is owned by and reachable\n882\t/// through the context.\n883\tpub fn test_set_minimal_cnx_with_time(_simulated_time: &mut Instant) -> crate::Result<Box<Quic>> {\n884\t    todo!()\n885\t}\n886\t\n887\t// ---------------------------------------------------------------------------\n888\t// Zero-RTT test helpers.\n889\t\n890\t/// Parameters for a zero