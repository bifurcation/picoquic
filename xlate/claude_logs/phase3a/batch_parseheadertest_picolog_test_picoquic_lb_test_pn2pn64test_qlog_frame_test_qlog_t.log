xy hooks are skipped.\npub trait MaskOps {\n    /// C: `mask_intercept_fn`.\n    fn intercept(\n        &self,\n        quic: &mut Quic,\n        mask_ctx: Option<&mut dyn Any>,\n        current_time: Instant,\n        send_buffer: &mut [u8],\n        send_length: &mut usize,\n        send_msg_size: &mut usize,\n        p_addr_to: &mut Option<SocketAddr>,\n        p_addr_from: &mut Option<SocketAddr>,\n        if_index: &mut i32,\n    ) -> i32;\n\n    /// C: `mask_redirect_fn`.\n    fn redirect(\n        &self,\n        mask_ctx: Option<&mut dyn Any>,\n        bytes: &[u8],\n        packet_length: usize,\n        addr_from: Option<&SocketAddr>,\n        consumed: &mut usize,\n    ) -> i32;\n}\n\n#[cfg(test)]\nmod test {}\n","structuredPatch":[{"oldStart":4094,"oldLines":5,"newStart":4094,"newLines":195,"lines":["     ) -> i32;"," }"," ","+// ---------------------------------------------------------------------------","+// PacketHeader default constructor.","+","+impl Default for PacketHeader {","+    fn default() -> Self {","+        todo!()","+    }","+}","+","+// ---------------------------------------------------------------------------","+// Index-based packet-header helpers (avoid borrow conflicts in tests).","+","+impl Connection {","+    /// Like [`predict_packet_header_length`] but selects the packet context by","+    /// enum value instead of taking a `&mut PacketContextState`.  This avoids the","+    /// split-borrow problem in tests that hold `&mut Connection` while computing","+    /// the header length.","+    pub fn predict_packet_header_length_for_pc(","+        &mut self,","+        _packet_type: PacketType,","+        _pc: PacketContext,","+    ) -> usize {","+        todo!()","+    }","+","+    /// Like [`create_packet_header`] but addresses the path and tuple by index","+    /// instead of by `&mut` reference.  This avoids the split-borrow problem","+    /// that arises when the path and tuple live inside `&mut self`.","+    #[allow(clippy::too_ma