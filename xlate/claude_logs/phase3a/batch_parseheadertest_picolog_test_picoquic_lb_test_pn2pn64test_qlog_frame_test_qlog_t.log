{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01MMk4ACpzeLEtjSdgn7z5UV","type":"tool_result","content":"80\tpub mod utils;\n81\t\n82\t// Re-export the TP shapes from the public crate root for backwards\n83\t// compatibility with callers that already wrote `crate::TransportParameters`.\n84\tpub use tp::{PreferredAddress, TransportParameter, TransportParameters, VersionNegotiation};\n85\t\n86\tuse core::net::SocketAddr;\n87\t\n88\t// ---------------------------------------------------------------------------\n89\t// Version string and error class.\n90\t//\n91\t// Error values come straight from `#define` and would naturally be\n92\t// untyped in C; in Rust we commit to `u64` because the application\n93\t// API takes them as `uint64_t error_code` parameters and returns\n94\t// them in `get_local_error` etc.\n95\t\n96\t/// Library version string.  C: `VERSION`.\n97\tpub const VERSION: &str = \"1.1.48.0\";\n98\t\n99\t/// Crate-level error type for fallible operations.\n100\t///\n101\t/// Phase 1 stubs return `Result<T, Error>` even though the\n102\t/// `todo!()` bodies don't yet decide which variant to produce —\n103\t/// Phase 3 will fill that in based on the C control flow.  The\n104\t/// initial variant set covers the broad failure shapes; Phase 3\n105\t/// can add more as needed.  Marked `#[non_exhaustive]` so adding\n106\t/// variants later isn't a breaking change.\n107\t#[derive(Debug, Clone, Copy, PartialEq, Eq)]\n108\t#[non_exhaustive]\n109\tpub enum Error {\n110\t    /// Catch-all placeholder for paths Phase 1 has not yet\n111\t    /// distinguished.  Phase 3 should narrow these.\n112\t    Generic,\n113\t    /// Allocation failed.\n114\t    Memory,\n115\t    /// Caller supplied an invalid argument.\n116\t    InvalidArgument,\n117\t    /// A buffer the caller supplied was too small.\n118\t    BufferTooSmall,\n119\t    /// Caller-supplied file does not exist.\n120\t    NoSuchFile,\n121\t    /// Caller-supplied file was malformed.\n122\t    InvalidFile,\n123\t    /// Connection has been disconnected.\n124\t    Disconnected,\n125\t    /// Connection state didn't permit the requested operation.\n126\t    InvalidState,\n127\t    /// Operation produced or received a malformed QUIC frame.\n128\t    InvalidFrame,\n129\t    /// TLS / crypto error.\n130\t    Tls,\n131\t    /// Other QUIC protocol error; the wrapped value is the\n132\t    /// numeric `ERROR_*` code defined in this module.\n133\t    Protocol(u64),\n134\t}\n135\t\n136\timpl core::fmt::Display for Error {\n137\t    fn fmt(&self, f: &mut core::fmt::Formatter<'_>) -> core::fmt::Result {\n138\t        write!(f, \"{:?}\", self)\n139\t    }\n140\t}\n141\t\n142\timpl core::error::Error for Error {}\n143\t\n144\t/// Crate-wide `Result` alias defaulting the error type to [`Error`].\n145\tpub type Result<T, E = Error> = core::result::Result<T, E>;\n146\t\n147\t/// Wall-clock instant in microseconds since some application-defined\n148\t/// epoch.  Replaces the C `uint64_t current_time` parameter that\n149\t/// threads through every API call needing \"now\".  The type is\n150\t/// `Copy`, supports arithmetic with [`Duration`], and converts to\n151\t/// `u64` cheaply via `.ticks()` when crossing wire boundaries.\n152\t///\n153\t/// Phase 2 decision: per-call `current_time: Instant` parameters\n154\t/// stay (matches the C source's design — caller decides what time\n155\t/// it is).  No `Clock` trait at the library level; applications\n156\t/// can build a clock-injecting wrapper around the calls if they\n157\t/// want that style.\n158\tpub type Instant = fugit::Instant<u64, 1, 1_000_000>;\n159\t\n160\t/// Duration in microseconds.  Companion to [`Instant`].  Use for\n161\t/// timeouts, RTTs, jitter, etc.  In the C source these are bare\n162\t/// `uint64_t` values labelled by context (`idle_timeout`,\n163\t/// `microsec_latency`, …); the typed alias makes the unit explicit.\n164\tpub type Duration = fugit::Duration<u64, 1, 1_000_000>;\n165\t\n166\t// Error codes (picoquic-internal `ERROR_*` and protocol-defined\n167\t// `TRANSPORT_*` / TLS-alert) live as enums in [`crate::errors`].\n168\tpub use errors::{InternalError, TransportError};\n169\t\n170\t// ---------------------------------------------------------------------------\n171\t// Packet sizes and miscellaneous constants.\n172\t\n173\tpub const MAX_PACKET_SIZE: usize = 1536;\n174\tpub const INITIAL_MTU_IPV4: usize = 1252;\n175\tpub const INITIAL_MTU_IPV6: usize = 1232;\n176\tpub const RESET_SECRET_SIZE: usize = 16;\n177\tpub const RESET_PACKET_PAD_SIZE: usize = 23;\n178\tpub const RESET_PACKET_MIN_SIZE: usize = RESET_PACKET_PAD_SIZE + RESET_SECRET_SIZE;\n179\tpub const MAX_CRYPTO_BUFFER_GAP: usize = 16384;\n180\t\n181\tpub const LOG_PACKET_MAX_SEQUENCE: u32 = 100;\n182\t\n183\t/// First 4 bytes of `SHA256(\"QUIC Masque\")`.  Used as a sentinel\n184\t/// interface index where no real OS interface is meaningful.\n185\tpub const RESERVED_IF_INDEX: u32 = 0x09cb8ed3;\n186\t\n187\t// TLS cipher-suite identifiers (IANA).\n188\tpub const AES_128_GCM_SHA256: u16 = 0x1301;\n189\tpub const AES_256_GCM_SHA384: u16 = 0x1302;\n190\tpub const CHACHA20_POLY1305_SHA256: u16 = 0x1303;\n191\t\n192\tpub const GROUP_SECP256R1: u16 = 23;\n193\t\n194\t// ECN code points for the IP header `tos` byte.\n195\tpub const ECN_ECT_0: u8 = 0x02;\n196\tpub const ECN_ECT_1: u8 = 0x01;\n197\tpub const ECN_CE: u8 = 0x03;\n198\t\n199\t/// C macro `FOURCC(a, b, c, d)`.  Produces a 32-bit code from four\n200\t/// bytes in little-endian order.\n201\tpub const fn fourcc(a: u8, b: u8, c: u8, d: u8) -> u32 {\n202\t    u32::from_le_bytes([a, b, c, d])\n203\t}\n204\t\n205\t// ---------------------------------------------------------------------------\n206\t// Connection state.\n207\t\n208\t/// Connection-state machine, listing the QUIC connection states a\n209\t/// `Connection` walks through from initial handshake to teardown.\n210\t/// Discriminants follow the declaration order of the C `state_enum`.\n211\t#[derive(Debug, Copy, Clone, PartialEq, Eq, PartialOrd, Ord)]\n212\tpub enum State {\n213\t    ClientInit,\n214\t    ClientInitSent,\n215\t    ClientRenegotiate,\n216\t    ClientRetryReceived,\n217\t    ClientInitResent,\n218\t    ServerInit,\n219\t    ServerHandshake,\n220\t    ClientHandshakeStart,\n221\t    HandshakeFailure,\n222\t    HandshakeFailureResend,\n223\t    ClientAlmostReady,\n224\t    ServerFalseStart,\n225\t    ServerAlmostReady,\n226\t    ClientReadyStart,\n227\t    Ready,\n228\t    Disconnecting,\n229\t    ClosingReceived,"}]},"parent_tool_use_id":null,"session_id":"d6e0a846-1f78-4cd7-8562-a63ac35b77bc","uuid":"9b030a33-4adb-468a-8667-d56e5a6ac908","timestamp":"2026-05-05T11:19:08.240Z","tool_use_result":{"type":"text","file":{"filePath":"/Users/richbarn/Projects/picoquic/rs/fq/src/lib.rs","content":"pub mod utils;\n\n// Re-export the TP shapes from the public crate root for backwards\n// compatibility with callers that already wrote `crate::TransportParameters`.\npub use tp::{PreferredAddress, TransportParameter, TransportParameters, VersionNegotiation};\n\nuse core::net::SocketAddr;\n\n// ---------------------------------------------------------------------------\n// Version string and error class.\n//\n// Error values come straight from `#define` and would naturally be\n// untyped in C; in Rust we commit to `u64` because the application\n// API takes them as `uint64_t error_code` parameters and returns\n// them in `get_local_error` etc.\n\n/// Library version string.  C: `VERSION`.\npub const VERSION: &str = \"1.1.48.0\";\n\n/// Crate-level error type for fallible operations.\n///\n/// Phase 1 stubs return `Result<T, Error>` even though the\n/// `todo!()` bodies don't yet decide which variant to produce —\n/// Phase 3 will fill that in based on the C control flow.  The\n/// initial variant set covers the broad failure shapes; Phase 3\n/// can add more as needed.  Marked `#[non_exhaustive]` so adding\n/// variants later isn't a breaking change.\n#[derive(Debug, Clone, Copy, PartialEq, Eq)]\n#[non_exhaustive]\npub enum Error {\n    /// Catch-all placeholder for paths Phase 1 has not yet\n    /// distinguished.  Phase 3 should narrow these.\n    Generic,\n    /// Allocation failed.\n    Memory,\n    /// Caller supplied an invalid argument.\n    InvalidArgument,\n    /// A buffer the caller supplied was too small.\n    BufferTooSmall,\n    /// Caller-supplied file does not exist.\n    NoSuchFile,\n    /// Caller-supplied file was malformed.\n    InvalidFile,\n    /// Connection has been disconnected.\n    Disconnected,\n    /// Connection state didn't permit the requested operation.\n    InvalidState,\n    /// Operation produced or received a malformed QUIC frame.\n    InvalidFrame,\n    /// TLS / crypto error.\n    Tls,\n    /// Other QUIC protocol error; the wrapped value is the\n    /// numeric `ERROR_*` code defined in this module.\n    Protocol(u64),\n}\n\nimpl core::fmt::Display for Error {\n    fn fmt(&self, f: &mut core::fmt::Formatter<'_>) -> core::fmt::Result {\n        write!(f, \"{:?}\", self)\n    }\n}\n\nimpl core::error::Error for Error {}\n\n/// Crate-wide `Result` alias defaulting the error type to [`Error`].\npub type Result<T, E = Error> = core::result::Result<T, E>;\n\n/// Wall-clock instant in microseconds since some application-defined\n/// epoch.  Replaces the C `uint64_t current_time` parameter that\n/// threads through every API call needing \"now\".  The type is\n/// `Copy`, supports arithmetic with [`Duration`], and converts to\n/// `u64` cheaply via `.ticks()` when crossing wire boundaries.\n///\n/// Phase 2 decision: per-call `current_time: Instant` parameters\n/// stay (matches the C source's design — caller decides what time\n/// it is).  No `Clock` trait at the library level; applications\n/// can build a clock-injecting wrapper around the calls if they\n/// want that style.\npub type Instant = fugit::Instant<u64, 1, 1_000_000>;\n\n/// Duration in microseconds.  Companion to [`Instant`].  Use for\n/// timeouts, RTTs, jitter, etc.  In the C source these are bare\n/// `uint64_t` values labelled by context (`idle_timeout`,\n/// `microsec_latency`, …); the typed alias makes the unit explicit.\npub type Duration = fugit::Duration<u64, 1, 1_000_000>;\n\n// Error codes (picoquic-internal `ERROR_*` and protocol-defined\n// `TRANSPORT_*` / TLS-alert) live as enums in [`crate::errors`].\npub use errors::{InternalError, TransportError};\n\n// ---------------------------------------------------------------------------\n// Packet sizes and miscellaneous constants.\n\npub const MAX_PACKET_SIZE: usize = 1536;\npub const INITIAL_MTU_IPV4: usize = 1252;\npub const INITIAL_MTU_IPV6: usize = 1232;\npub const RESET_SECRET_SIZE: usize = 16;\npub const RESET_PACKET_PAD_SIZE: usize = 23;\npub const RESET_PACKET_MIN_SIZE: usize = RESET_PACKET_PAD_SIZE + RESET_SECRET_SIZE;\npub const MAX_CRYPTO_BUFFER_GAP: usize = 16384;\n\npub const LOG_PACKET_MAX_SEQUENCE: u32 = 100;\n\n/// First 4 bytes of `SHA256(\"QUIC Masque\")`.  Used as a sentinel\n/// interface index where no real OS interface is meaningful.\npub const RESERVED_IF_INDEX: u32 = 0x09cb8ed3;\n\n// TLS cipher-suite identifiers (IANA).\npub const AES_128_GCM_SHA256: u16 = 0x1301;\npub const AES_256_GCM_SHA384: u16 = 0x1302;\npub const CHACHA20_POLY1305_SHA256: u16 = 0x1303;\n\npub const GROUP_SECP256R1: u16 = 23;\n\n// ECN code points for the IP header `tos` byte.\npub const ECN_ECT_0: u8 = 0x02;\npub const ECN_ECT_1: u8 = 0x01;\npub const ECN_CE: u8 = 0x03;\n\n/// C macro `FOURCC(a, b, c, d)`.  Produces a 32-bit code from four\n/// bytes in little-endian order.\npub const fn fourcc(a: u8, b: u8, c: u8, d: u8) -> u32 {\n    u32::from_le_bytes([a, b, c, d])\n}\n\n// ---------------------------------------------------------------------------\n// Connection state.\n\n/// Connection-state machine, listing the QUIC connection states a\n/// `Connection` walks through from initial handshake to teardown.\n/// Discrimi