picoquic_connection_id_t result;\n928\t\n929\t    /* Configure the policy */\n930\t    ret = picoquic_lb_compat_cid_config(quic, config);\n931\t\n932\t    if (ret != 0) {\n933\t        DBG_PRINTF(\"CID test #%d fails, could not configure the context.\\n\", test_id);\n934\t    }\n935\t    else {\n936\t        /* Create a CID. */\n937\t        result = *init_cid;\n938\t\n939\t        if (quic->cnx_id_callback_fn) {\n940\t            quic->cnx_id_callback_fn(quic, picoquic_null_connection_id, picoquic_null_connection_id,\n941\t                quic->cnx_id_callback_ctx, &result);\n942\t        }\n943\t\n944\t        if (picoquic_compare_connection_id(&result, target_cid) != 0) {\n945\t            DBG_PRINTF(\"CID test #%d fails, result does not match.\\n\", test_id);\n946\t            ret = -1;\n947\t        }\n948\t        else {\n949\t            uint64_t server_id64 = picoquic_lb_compat_cid_verify(quic->cnx_id_callback_ctx, &result);\n950\t\n951\t            if (server_id64 != config->server_id64) {\n952\t                DBG_PRINTF(\"CID test #%d fails, server id decode to %\" PRIu64 \" instead of %\" PRIu64,\n953\t                    test_id, server_id64, config->server_id64);\n954\t                ret = -1;\n955\t            }\n956\t        }\n957\t    }\n958\t\n959\t    /* Free the configured policy */\n960\t    picoquic_lb_compat_cid_config_free(quic);\n961\t\n962\t    return ret;\n963\t}\n964\t\n965\t\n966\tint cid_for_lb_test(void)\n967\t{\n968\t    int ret = 0;\n969\t    uint64_t simulated_time = 0;\n970\t    picoquic_quic_t* quic = picoquic_create(8, NULL, NULL, NULL, NULL, NULL,\n971\t        NULL, NULL, NULL, NULL, simulated_time,\n972\t        &simulated_time, NULL, NULL, 0);\n973\t\n974\t    if (quic == NULL) {\n975\t        DBG_PRINTF(\"%s\", \"Could not create the quic context.\");\n976\t    }\n977\t    else {\n978\t        for (int i = 0; i < NB_LB_CONFIG_TEST && ret == 0; i++) {\n979\t            ret = cid_for_lb_test_one(quic, i, &cid_for_lb_test_con