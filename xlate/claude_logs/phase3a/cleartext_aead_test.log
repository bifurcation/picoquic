oquic_packet_header));\n43\t    ph->dest_cnx_id = cnx_id;\n44\t    ph->srce_cnx_id = picoquic_null_connection_id;\n45\t    ph->pn = pn;\n46\t    ph->pn64 = pn;\n47\t    ph->vn = vn;\n48\t    ph->ptype = ptype;\n49\t    ph->offset = 17;\n50\t    ph->pnmask = 0xFFFFFFFF00000000ull;\n51\t    ph->version_index = picoquic_get_version_index(ph->vn);\n52\t}\n53\t\n54\tvoid cleartext_aead_init_packet(picoquic_packet_header* ph,\n55\t    uint8_t* cleartext, size_t target)\n56\t{\n57\t    size_t byte_index = 0;\n58\t    uint64_t seed = picoquic_val64_connection_id(ph->dest_cnx_id);\n59\t\n60\t    seed ^= ph->pn;\n61\t\n62\t    /* Serialize the header */\n63\t    cleartext[byte_index++] = 0x80 | ((uint8_t)ph->ptype);\n64\t    picoformat_32(&cleartext[byte_index], ph->vn);\n65\t    byte_index += 4;\n66\t    byte_index += picoquic_format_connection_id(&cleartext[byte_index], 1526 - byte_index, ph->dest_cnx_id);\n67\t    byte_index += picoquic_format_connection_id(&cleartext[byte_index], 1526 - byte_index, ph->srce_cnx_id);\n68\t    ph->pn_offset = (uint32_t)byte_index;\n69\t    picoformat_32(&cleartext[byte_index], ph->pn);\n70\t    byte_index += 4;\n71\t    /* Add some silly content */\n72\t    while (byte_index < target) {\n73\t        seed *= 101;\n74\t        cleartext[byte_index++] = (uint8_t)seed & 255;\n75\t    }\n76\t}\n77\t\n78\tint cleartext_aead_test(void)\n79\t{\n80\t    int ret = 0;\n81\t    uint8_t clear_text[1536];\n82\t    uint8_t incoming[1536];\n83\t    uint32_t seqnum = 0xdeadbeef;\n84\t    size_t clear_length = 1200;\n85\t    size_t encoded_length;\n86\t    size_t decoded_length;\n87\t    picoquic_packet_header ph_init;\n88\t    struct sockaddr_in test_addr_c, test_addr_s;\n89\t    picoquic_cnx_t* cnx_client = NULL;\n90\t    picoquic_cnx_t* cnx_server = NULL;\n91\t    picoquic_quic_t* qclient = NULL;\n92\t    picoquic_quic_t* qserver = NULL;\n93\t    char test_server_cert_file[512];\n94\t    char test_server_key_file[512];\n95\t    char test_server_cert_store_file[512];\n96\t\n97\t    ret = picoquic_get_input_path(test_server_cert_file, sizeof(test_server_cert_file), picoquic_solution_dir, PICOQUIC_TEST_FILE_SERVER_CERT);\n98\t\n99\t    if (ret == 0) {\n100\t        ret = picoquic_get_input_path(test_server_key_file, sizeof(test_server_key_file), picoquic_solution_dir, PICOQUIC_TEST_FILE_SERVER_KEY);\n101\t    }\n102\t\n103\t    if (ret == 0) {\n104\t        ret = picoquic_get_input_path(test_server_cert_store_file, sizeof(test_server_cert_store_file), picoquic_solution_dir, PICOQUIC_TEST_FILE_CERT_STORE);\n105\t    }\n106\t\n107\t    if (ret != 0) {\n108\t        DBG_PRINTF(\"%s\", \"Cannot set the cert, key or store file names.\\n\");\n109\t    }\n110\t    else {\n111\t\n112\t        qclient = picoquic_create(8, NULL, NULL, NULL, NULL, NULL, NULL,\n113\t            NULL, NULL, NULL, 0, NULL, NULL, NULL, 0);\n114\t        qserver = picoquic_create(8,\n115\t            test_server_cert_file, test_server_key_file, test_server_cert_store_file,\n116\t            \"test\", NULL, NULL, NULL, NULL, NULL, 0, NULL, NULL, NULL, 0);\n117\t\n118\t        if (qclient == NULL || qserver == NULL) {\n119\t            DBG_PRINTF(\"%s\", \"Could not create Quic contexts.\\n\");\n120\t            ret = -1;\n121\t        }\n122\t    }\n123\t\n124\t    if (ret == 0) {\n125\t        memset(&test_addr_c, 0, sizeof(struct sockaddr_in));\n126\t        test_addr_c.sin_family = AF_INET;\n127\t        memcpy(&test_addr_c.sin_addr, addr1, 4);\n128\t        test_addr_c.sin_port = 12345;\n129\t\n130\t        cnx_client = picoquic_create_cnx(qclient, picoquic_null_connection_id, picoquic_null_connection_id,\n131\t            (struct sockaddr*)&test_addr_c, 0, 0, NULL, NULL, 1);\n132\t        if (cnx_client == NULL) {\n133\t            DBG_PRINTF(\"%s\", \"Could not create client connection context.\\n\");\n134\t            ret = -1;\n135\t        }\n136\t    }\n137\t\n138\t    if (ret == 0) {\n139\t\n140\t        memset(&test_addr_s, 0, sizeof(struct sockaddr_in));\n141\t        test_addr_s.sin_family = AF_INET;\n142\t        memcpy(&test_addr_s.sin_addr, addr2, 4);\n143\t        test_addr_s.sin_port = 4433;\n144\t\n145\t        cnx_server = picoquic_create_cnx(qserver, cnx_client->initial_cnxid, cnx_client->initial_cnxid,\n146\t            (struct sockaddr*)&test_addr_s, 0,\n147\t            cnx_client->proposed_version, NULL, NULL, 0);\n148\t\n149\t        if (cnx_server == NULL) {\n150\t            DBG_PRINTF(\"%s\", \"Could not create server connection context.\\n\");\n151\t            ret = -1;\n152\t        } else if (picoquic_compare_connection_id(&cnx_client->initial_cnxid, &cnx_server->initial_cnxid) != 0) {\n153\t            DBG_PRINTF(\"Server Cnx-ID= %llx, differs from Client Cnx-ID = %llx\\n\",\n154\t                (unsigned long long) picoquic_val64_connection_id(cnx_client->initial_cnxid),\n155\t                (unsigned long long) picoquic_val64_connection_id(cnx_server->initial_cnxid));\n156\t            ret = -1;\n157\t        }\n158\t#if 0\n159\t        /* TODO: find replacement for this test */\n160\t        else if (picoquic_compare_cleartext_aead_contexts(cnx_client, cnx_server) != 0 ||\n161\t            picoquic_compare_cleartext_aead_contexts(cnx_server, cnx_client) != 0) {\n162\t            DBG_PRINTF(\"%s\", \"Cleartext encryption contexts no not match.\\n\");\n163\t            ret = -1;\n164\t        }\n165\t#endif\n166\t    }\n167\t\n168\t    /* Create a packet from client to server, encrypt, decrypt */\n169\t    if (ret == 0) {\n170\t        cleartext_aead_packet_init_header(&ph_init,\n171\t            cnx_client->initial_cnxid, seqnum, cnx_client->proposed_version,\n172\t            picoquic_packet_initial);\n173\t        cleartext_aead_init_packet(&ph_init, clear_text, clear_length);\n174\t\n175\t        /* AEAD Encrypt, to the send buffer */\n176\t        memcpy(incoming, clear_text, ph_init.offset);\n177\t        encoded_length = picoquic_aead_encrypt_generic(incoming + ph_init.offset,\n178\t            clear_text + ph_init.offset, clear_length - ph_init.offset,\n179\t            seqnum, incoming, ph_init.offset, cnx_client->crypto_context[0].aead_encrypt);\n180\t        encoded_length += ph_init.offset;\n181\t\n182\t        /* AEAD Decrypt */\n183\t        decoded_length = picoquic_aead_decrypt_generic(incoming + ph_init.offset,\n184\t            incoming + ph_init.offset, encoded_length - ph_init.offset, seqnum,\n185\t            incoming, ph_init.offset, cnx_server->crypto_context[0].aead_decrypt);\n186\t        decoded_length += ph_init.offset;\n187\t\n188\t        if (decoded_length != clear_length) {\n189\t            DBG_PRINTF(\"Decoded length (%d) does not match clear lenth (%d).\\n\", (int)decoded_length, (int)clear_length);\n190\t            ret = -1;\n191\t        } else if (memcmp(incoming, clear_text, clear_length) != 0) {\n192\t            DBG_PRINTF(\"%s\", \"Decoded message not match clear length.\\n\");\n193\t            ret = 1;\n194\t        }\n195\t    }\n196\t\n197\t    if (cnx_client != NULL) {\n198\t        picoquic_delete_cnx(cnx_client);\n199\t    }\n200\t"}]},"parent_tool_use_id":null,"session_id":"0fe661b3-3da3-4093-b2dc-59d86edd2999","uuid":"02b4c9c2-cb4c-4722-9635-4b81f6d0c701","timestamp":"2026-05-04T21:46:59.589Z","tool_use_result":{"type":"text","file":{"filePath":"/Users/richbarn/Projects/picoquic/picoquictest/cleartext_aead_test.c","content":"/*\n* Author: Christian Huitema\n* Copyright (c) 2017, Private Octopus, Inc.\n* All rights reserved.\n*\n* Permission to use, copy, modify, and distribute this software for any\n* purpose with or without fee is hereby granted, provided that the above\n* copyright notice and this permission notice appear in all copies.\n*\n* THIS SOFTWARE IS PROVIDED BY THE COPYRIGHT HOLDERS AND CONTRIBUTORS \"AS IS\" AND\n* ANY EXPRESS OR IMPLIED WARRANTIES, INCLUDING, BUT NOT LIMITED TO, THE IMPLIED\n* WARRANTIES OF MERCHANTABILITY AND FITNESS FOR A PARTICULAR PURPOSE ARE\n* DISCLAIMED. IN NO EVENT SHALL Private Octopus, Inc. BE LIABLE FOR ANY\n* DIRECT, INDIRECT, INCIDENTAL, SPECIAL, EXEMPLARY, OR CONSEQUENTIAL DAMAGES\n* (INCLUDING, BUT NOT LIMITED TO, PROCUREMENT OF SUBSTITUTE GOODS OR SERVICES;\n* LOSS OF USE, DATA, OR PROFITS; OR BUSINESS INTERRUPTION) HOWEVER CAUSED AND\n* ON ANY THEORY OF LIABILITY, WHETHER IN CONTRACT, STRICT LIABILITY, OR TORT\n* (INCLUDING NEGLIGENCE OR OTHERWISE) ARISING IN ANY WAY OUT OF THE USE OF THIS\n* SOFTWARE, EVEN IF ADVISED OF THE POSSIBILITY OF SUCH DAMAGE.\n*/\n\n#ifdef _WINDOWS\n#include \"wincompat.h\"\n#endif\n#include \"picoquic_internal.h\"\n#include \"tls_api.h\"\n#include \"picoquic_utils.h\"\n#ifdef _WINDOWS\n#pragma warning(disable:4204)\n#endif\n#include \"picotls.h\"\n#include \"picoquic_lb.h\"\n#include <string.h>\n#include \"picoquictest_internal.h\"\n\nstatic uint8_t const addr1[4] = { 10, 0, 0, 1 };\nstatic uint8_t const addr2[4] = { 10, 0, 0, 2 };\n\nvoid cleartext_aead_packet_init_header(picoquic_packet_header* ph,\n    picoquic_connection_id_t cnx_id, uint32_t pn, uint32_t vn, picoquic_packet_type_enum ptype)\n{\n    memset(ph, 0, sizeof(picoquic_packet_header));\n    ph->dest_cnx_id = cnx_id;\n    ph->srce_cnx_id = picoquic_null_connection_id;\n    ph->pn = pn;\n    ph->pn64 = pn;\n    ph->vn = vn;\n    ph->ptype = ptype;\n    ph->offset = 17;\n    ph->pnmask = 0xFFFFFFFF00000000ull;\n    ph->version_index = picoquic_get_version_index(ph->vn);\n}\n\nvoid cleartext_aead_init_packet(picoquic_packet_header* ph,\n    uint8_t* cleartext, size_t target)\n{\n    size_t byte_index = 0;\n    uint64_t seed = picoquic_val64_connection_id(ph->dest_cnx_id);\n\n    seed ^= ph->pn;\n\n    /* Serialize the header */\n    cleartext[byte_index++] = 0x80 | ((uint8_t)ph->ptype);\n    picoformat_32(&cleartext[byte_index], ph->vn);\n    byte_index += 4;\n    byte_index += picoquic_format_connection_id(&cleartext[byte_index], 1526 - byte_index, ph->dest_cnx_id);\n    byte_index += picoquic_format_connection_id(&cleartext[byte_index], 1526 - byte_index, ph->srce_cnx_id);\n    ph->pn_offset = (uint32_t)byte_index;\n    picoformat_32(&cleartext[byte_index], ph->pn);\n    byte_index += 4;\n    /* Add some silly content */\n    while (byte_index < target) {\n        seed *= 101;\n        cleartext[byte_index++] = (uint8_t)seed & 255;\n    }\n}\n\nint cleartext_aead_test(void)\n{\n    int ret = 0;\n    uint8_t clear_text[1536];\n    uint8_t incoming[1536];\n    uint32_t seqnum = 0xdeadbeef;\n    size_t clear_length = 1200;\n    size_t encoded_length;\n    size_t decoded_length;\n    picoquic_packet_header ph_init;\n    struct sockaddr_in test_addr_c, test_addr_s;\n    picoquic_cnx_t* cnx_client = NULL;\n    picoquic_cnx_t* cnx_server = NULL;\n    picoquic_quic_t* qclient = NULL;\n    picoquic_quic_t* qserver = NULL;\n    char test_server_cert_file[512];\n    char test_server_key_file[512];\n    char test_server_cert_store_file[512];\n\n    ret = picoquic_get_input_path(test_server_cert_file, sizeof(test_server_cert_file), picoquic_solution_dir, PICOQUIC_TEST_FILE_SERVER_CERT);\n\n    if (ret == 0) {\n        ret = picoquic_get_input_path(test_server_key_file, sizeof(test_server_key_file), picoquic_solution_dir, PICOQUIC_TEST_FILE_SERVER_KEY);\n    }\n\n    if (ret == 0) {\n        ret = picoquic_get_input_path(test_server_cert_store_file, sizeof(test_server_cert_store_file), picoquic_solution_dir, PICOQUIC_TEST_FILE_CERT_STORE);\n    }\n\n    if (ret != 0) {\n        DBG_PRINTF(\"%s\", \"Cannot set the cert, key or store file names.\\n\");\n    }\n    else {\n\n        qclient = picoquic_create(8, NULL, NULL, NULL, NULL, NULL, NULL,\n            NULL, NULL, NULL, 0, NULL, NULL, NULL, 0);\n        qserver = picoquic_create(8,\n            test_server_cert_file, test_server_key_file, test_server_cert_store_file,\n            \"test\", NULL, NULL, NULL, NULL, NULL, 0, NULL, NULL, NULL, 0);\n\n        if (qclient == NULL || qserver == NULL) {\n            DBG_PRINTF(\"%s\", \"Could not create Quic contexts.\\n\");\n            ret = -1;\n        }\n    }\n\n    if (ret == 0) {\n        memset(&test_addr_c, 0, sizeof(struct sockaddr_in));\n        test_addr_c.sin_family = AF_INET;\n        memcpy(&test_addr_c.sin_addr, addr1, 4);\n        test_addr_c.sin_port = 12345;\n\n        cnx_client = picoquic_create_cnx(qclient, picoquic_null_connection_id, picoquic_null_connection_id,\n            (struct sockaddr*)&test_addr_c, 0, 0, NULL, NULL, 1);\n        if (cnx_client == NULL) {\n            DBG_PRINTF(\"%s\", \"Could not create client connection context.\\n\");\n            ret = -1;\n        }\n    }\n\n    if (ret == 0) {\n\n        memset(&test_addr_s, 0, sizeof(struct sockaddr_in));\n        test_addr_s.sin_family = AF_INET;\n        memcpy(&test_addr_s.sin_addr, addr2, 4);\n        test_addr_s.sin_port = 4433;\n\n        cnx_server = picoquic_create_cnx(qserver, cnx_client->initial_cnxid, cnx_client->initial_cnxid,\n            (struct sockaddr*)&test_addr_s, 0,\n            cnx_client->proposed_version, NULL, NULL, 0);\n\n        if (cnx_server == NULL) {\n            DBG_PRINTF(\"%s\", \"Could not create server connection context.\\n\");\n            ret = -1;\n        } else if (picoquic_compare_connection_id(&cnx_client->initial_cnxid, &cnx_server->initial_cnxid) != 0) {\n            DBG_PRINTF(\"Server Cnx-ID= %llx, differs from Client Cnx-ID = %llx\\n\",\n                (unsigned long long) picoquic_val64_connection_id(cnx_client->initial_cnxid),\n                (unsigned long long) picoquic_val64_connection_id(cnx_server->initial_cnxid));\n            ret = -1;\n        }\n#if 0\n        /* TODO: find replacement for this test */\n        else if (picoquic_compare_cleartext_aead_contexts(cnx_client, cnx_server) != 0 ||\n            picoquic_compare_cleartext_aead_contexts(cnx_server, cnx_client) != 0) {\n            DBG_PRINTF(\"%s\", \"Cleartext encryption contexts no not match.\\n\");\n            ret = -1;\n        }\n#endif\n    }\n\n    /* Create a packet from client to server, encrypt, decrypt */\n    if (ret == 0) {\n        cleartext_aead_packet_init_header(&ph_init,\n            cnx_client->initial_cnxid, seqnum, cnx_client->proposed_version,\n            picoquic_packet_initial);\n        cleartext_aead_init_packet(&ph_init, clear_text, clear_length);\n\n        /* AEAD Encrypt, to the send buffer */\n        memcpy(incoming, clear_text, ph_init.offset);\n        encoded_length = picoquic_aead_encrypt_generic(incoming + ph_init.offset,\n            clear_text + ph_init.offset, clear_length - ph_init.offset,\n            seqnum, incoming, ph_init.offset, cnx_client->crypto_context[0].aead_encrypt);\n        encoded_length += ph_init.offset;\n\n        /* AEAD Decrypt */\n        decoded_length = picoquic_aead_decrypt_generic(incoming + ph_init.offset,\n            incoming + ph_init.offset, encoded_length - ph_init.offset, seqnum,\n            incoming, ph_init.offset, cnx_server->crypto_context[0].aead_decrypt);\n        decoded_length += ph_init.offset;\n\n        if (decoded_length != clear_length) {\n            DBG_PRINTF(\"Decoded length (%d) does not match clear lenth (%d).\\n\", (int)decoded_length, (int)clear_length);\n            ret = -1;\n        } else if (memcmp(incoming, clear_text, clear_length) != 0) {\n            DBG_PRINTF(\"%s\", \"Decoded message not match clear length.\\n\");\n            ret = 1;\n        }\n    }\n\n    if (cnx_client != NULL) {\n        picoquic_delete_cnx(cnx_client);\n    }\n","numLines":200,"startLine":1,"totalLines":1367}}}
