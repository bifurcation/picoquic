          .expect(\"server pn_enc\"),\n        cnx_client.crypto_context[0]\n            .pn_dec\n            .as_deref()\n            .expect(\"client pn_dec\"),\n        &sample_2,\n    );"},"caller":{"type":"direct"}}],"stop_reason":null,"stop_sequence":null,"stop_details":null,"usage":{"input_tokens":1,"cache_creation_input_tokens":603,"cache_read_input_tokens":30613,"cache_creation":{"ephemeral_5m_input_tokens":0,"ephemeral_1h_input_tokens":603},"output_tokens":1,"service_tier":"standard","inference_geo":"not_available"},"diagnostics":null,"context_management":null},"parent_tool_use_id":null,"session_id":"0fe661b3-3da3-4093-b2dc-59d86edd2999","uuid":"4d4d68b5-c973-4621-bc90-b5b5a89c6c63"}
