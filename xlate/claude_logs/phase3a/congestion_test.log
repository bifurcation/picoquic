, 1000000 },\n45\t    { 16, 12, 257, 1000000 }\n46\t};\n47\t\n48\tstatic test_api_stream_desc_t test_scenario_10mb[] = {\n49\t    { 4, 0, 257, 1000000 },\n50\t    { 8, 0, 257, 1000000 },\n51\t    { 12, 0, 257, 1000000 },\n52\t    { 16, 0, 257, 1000000 },\n53\t    { 20, 0, 257, 1000000 },\n54\t    { 24, 0, 257, 1000000 },\n55\t    { 28, 0, 257, 1000000 },\n56\t    { 32, 0, 257, 1000000 },\n57\t    { 36, 0, 257, 1000000 },\n58\t    { 40, 0, 257, 1000000 }\n59\t};\n60\t\n61\tstatic test_api_stream_desc_t test_scenario_very_long[] = {\n62\t    { 4, 0, 257, 1000000 }\n63\t};\n64\t\n65\t\n66\tstatic char const* ticket_file_name = \"resume_tests_tickets.bin\";\n67\t\n68\tstatic int congestion_control_test(picoquic_congestion_algorithm_t* ccalgo, uint64_t max_completion_time, uint64_t jitter, uint8_t jitter_id)\n69\t{\n70\t    uint64_t simulated_time = 0;\n71\t    picoquic_test_tls_api_ctx_t* test_ctx = NULL;\n72\t    picoquic_connection_id_t initial_cid = { {0xcc, 0xcc, 0, 0, 0, 0, 0, 0}, 8 };\n73\t    int ret;\n74\t\n75\t    initial_cid.id[2] = ccalgo->congestion_algorithm_number;\n76\t    initial_cid.id[3] = jitter_id;\n77\t\n78\t    ret = tls_api_init_ctx_ex(&test_ctx, PICOQUIC_INTERNAL_TEST_VERSION_1, PICOQUIC_TEST_SNI, PICOQUIC_TEST_ALPN, &simulated_time, NULL, NULL, 0, 1, 0, &initial_cid);\n79\t\n80\t    if (ret == 0 && test_ctx == NULL) {\n81\t        ret = -1;\n82\t    }\n83\t\n84\t    /* Set the congestion algorithm to specified value. Also, request a packet trace */\n85\t    if (ret == 0) {\n86\t\n87\t        picoquic_set_default_congestion_algorithm(test_ctx->qserver, ccalgo);\n88\t        picoquic_set_congestion_algorithm(test_ctx->cnx_client, ccalgo);\n89\t\n90\t        test_ctx->c_to_s_link->jitter = jitter;\n91\t        test_ctx->s_to_c_link->jitter = jitter;\n92\t\n93\t        picoquic_set_qlog(test_ctx->qserver, \".\");\n94\t\n95\t        ret = tls_api_one_scenario_body(test_ctx, &simulated_time,\n96\t            test_scenario_congestion, sizeof(test_scenario_congestion), 0, 0, 0, 20000 + 2 * jitter, max_completion_time);\n97\t    }\n98\t\n99\t    /* Free the resource, which will close the log file.\n100\t     */\n101\t\n102\t    if (test_ctx != NULL) {\n103\t        tls_api_delete_ctx(test_ctx);\n104\t        test_ctx = NULL;\n105\t    }\n106\t\n107\t    return ret;\n108\t}\n109\t\n110\tint cubic_test(void)\n111\t{\n112\t    return congestion_control_test(picoquic_cubic_algorithm, 3500000, 0, 0);\n113\t}\n114\t\n115\tint cubic_jitter_test(void)\n116\t{\n117\t    return congestion_control_test(picoquic_cubic_algorithm, 3550000, 5000, 5);\n118\t}\n119\t\n120\tint c4_test(void)\n121\t{\n122\t    return congestion_control_test(c4_algorithm, 3600000, 0, 0);\n123\t}\n124\t\n125\tint c4_jitter_test(void)\n126\t{\n127\t    return congestion_control_test(c4_algorithm, 3650000, 5000, 5);\n128\t}\n129\t\n130\tint fastcc_test(void)\n131\t{\n132\t    return congestion_control_test(picoquic_fastcc_algorithm, 3700000, 0, 0);\n133\t}\n134\t\n135\tint fastcc_jitter_test(void)\n136\t{\n137\t    return congestion_control_test(picoquic_fastcc_algorithm, 4050000, 5000, 5);\n138\t}\n139\t\n140\tint bbr_test(void)\n141\t{\n142\t    return congestion_control_test(picoquic_bbr_algorithm, 3500000, 0, 0);\n143\t}\n144\t\n145\tint bbr_jitter_test(void)\n146\t{\n147\t    return congestion_control_test(picoquic_bbr_algorithm, 3600000, 5000, 5);\n148\t}\n149\t\n150\tstatic int congestion_long_test(picoquic_congestion_algorithm_t* ccalgo)\n151\t{\n152\t    uint64_t simulated_time = 0;\n153\t    uint64_t loss_mask = 0;\n154\t    picoquic_test_tls_api_ctx_t* test_ctx = NULL;\n155\t    picoquic_connection_id_t initial_cid = { {0xbb, 0xcc, 0x10, 0, 0, 0, 0, 0}, 8 };\n156\t    int ret;\n157\t\n158\t\n159\t    ret = tls_api_init_ctx_ex(&test_ctx, PICOQUIC_INTERNAL_TEST_VERSION_1, PICOQUIC_TEST_SNI, PICOQUIC_TEST_ALPN, &simulated_time, NULL, NULL, 0, 1, 0, &initial_cid);\n160\t\n161\t    if (ret == 0 && test_ctx == NULL) {\n162\t        ret = -1;\n163\t    }\n164\t\n165\t    /* Set the congestion algorithm to specified value. Also, request a packet trace */\n166\t    if (ret == 0) {\n167\t        picoquic_set_default_congestion_algorithm(test_ctx->qserver, ccalgo);\n168\t        picoquic_set_congestion_algorithm(test_ctx->cnx_client, ccalgo);\n169\t\n170\t\n171\t        test_ctx->c_to_s_link->jitter = 0;\n172\t        test_ctx->s_to_c_link->jitter = 0;\n173\t        test_ctx->c_to_s_link->picosec_per_byte = 8000000; /* Simulate 1 Mbps */\n174\t\n175\t        picoquic_set_qlog(test_ctx->qserver, \".\");\n176\t        test_ctx->qserver->use_long_log = 1;\n177\t\n178\t        ret = tls_api_one_scenario_body_connect(test_ctx, &simulated_time, 0, 0);\n179\t        if (ret != 0)\n180\t        {\n181\t            DBG_PRINTF(\"Connection loop returns %d\\n\", ret);\n182\t        }\n183\t    }\n184\t\n185\t    /* Prepare to send data */\n186\t    if (ret == 0) {\n187\t        ret = test_api_init_send_recv_scenario(test_ctx, test_scenario_congestion, sizeof(test_scenario_congestion));\n188\t\n189\t        if (ret != 0)\n190\t        {\n191\t            DBG_PRINTF(\"Init send receive scenario returns %d\\n\", ret);\n192\t        }\n193\t    }\n194\t\n195\t    /* Run a data sending loop for 1024 rounds, causing BBR to detect a low RTT */\n196\t    if (ret == 0) {\n197\t        ret = tls_api_data_sending_loop(test_ctx, &loss_mask, &simulated_time, 1024);\n198\t\n199\t        if (ret != 0)\n200\t        {\n201\t            DBG_PRINTF(\"Data sending loop returns %d\\n\", ret);\n202\t        }\n203\t    }\n204\t\n205\t    /* Increase the RTT from the previous value, which will cause the bandwidth to drop unless RTT is reset  */\n206\t    if (ret == 0) {\n207\t        test_ctx->c_to_s_link->microsec_latency = 5 * test_ctx->c_to_s_link->microsec_latency;\n208\t        test_ctx->s_to_c_link->microsec_latency = 5 * test_ctx->s_to_c_link->microsec_latency;\n209\t    }\n210\t\n211\t\n212\t    /* Perform a data sending loop */\n213\t    if (ret == 0) {\n214\t        ret = tls_api_data_sending_loop(test_ctx, &loss_mask, &simulated_time, 0);\n215\t\n216\t        if (ret != 0)\n217\t        {\n218\t            DBG_PRINTF(\"Data sending loop returns %d\\n\", ret);\n219\t        }\n220\t    }\n221\t\n222\t    if (ret == 0) {\n223\t        ret = tls_api_one_scenario_body_verify(test_ctx, &simulated_time, 15000000);\n224\t    }\n225\t\n226\t    /* Free the resource, which will close the log file. */\n227\t\n228\t    if (test_ctx != NULL) {\n229\t        tls_api_delete_ctx(test_ctx);\n230\t        test_ctx = NULL;\n231\t    }\n232\t\n233\t    return ret;\n234\t}\n235\t\n236\tint bbr_long_test(void)\n237\t{\n238\t    return congestion_long_test(picoquic_bbr_algorithm);\n239\t}\n240\t\n241\tint c4_long_test(void)\n242\t{\n243\t    return congestion_long_test(c4_algorithm);\n244\t}\n245\t\n246\tint bbr1_test(void)\n247\t{\n248\t    return congestion_control_test(picoquic_bbr1_algorithm, 3600000, 0, 0);\n249\t}\n250\t\n251\tint bbr1_long_test(void)\n252\t{\n253\t    return congestion_long_test(picoquic_bbr1_algorithm);\n254\t}\n255\t\n256\t/* Performance test.\n257\t * Check a variety of challenging scenarios\n258\t */\n259\t\n260\tint performance_test_one(uint64_t max_completion_time, uint64_t mbps, uint64_t rkbps, uint64_t latency,\n261\t    uint64_t jitter, uint64_t buffer_size, picoquic_tp_t* server_parameters)\n262\t{\n263\t    uint64_t simulated_time = 0x0005a138fbde8743; /* Init to non zero time to test handling of time in cc algorithm */\n264\t    uint64_t picoseq_per_byte_100 = (1000000ull * 8) / mbps;\n265\t    uint64_t picoseq_per_byte_return = (rkbps == 0) ? picoseq_per_byte_100 : (1000000000ull * 8) / rkbps;\n266\t    picoquic_connection_id_t initial_cid = { {0xbb, 0xcc, 0, 0, 0, 0, 0, 0}, 8 };\n267\t    picoquic_test_tls_api_ctx_t* test_ctx = NULL;\n268\t    picoquic_congestion_algorithm_t* ccalgo = picoquic_bbr_algorithm;\n269\t    uint64_t buffer_id = (buffer_size * 16) / (latency + jitter);\n270\t    int ret = 0;\n271\t\n272\t\n273\t    initial_cid.id[3] = (rkbps > 0xff) ? 0xff : (uint8_t)rkbps;\n274\t    initial_cid.id[4] = (mbps > 0xff) ? 0xff : (uint8_t)mbps;\n275\t    initial_cid.id[5] = (latency > 2550000) ? 0xff : (uint8_t)(latency / 10000);\n276\t    initial_cid.id[6] = (jitter > 255000) ? 0xff : (uint8_t)(jitter / 1000);\n277\t    initial_cid.id[7] = (buffer_id > 255) ? 0xff : (uint8_t)buffer_id;\n278\t\n279\t    ret = tls_api_one_scenario_init_ex(&test_ctx, &simulated_time, PICOQUIC_INTERNAL_TEST_VERSION_1, NULL, server_parameters, &initial_cid);\n280\t\n281\t    if (ret == 0 && test_ctx == NULL) {\n282\t        ret = -1;\n283\t    }\n284\t\n285\t    if (ret == 0) {\n286\t        picoquic_set_default_congestion_algorithm(test_ctx->qserver, ccalgo);\n287\t        picoquic_set_congestion_algorithm(test_ctx->cnx_client, ccalgo);\n288\t        test_ctx->qserver->use_long_log = 1;\n289\t\n290\t        picoquic_set_qlog(test_ctx->qserver, \".\");\n291\t        picoquic_set_qlog(test_ctx->qclient, \".\");\n292\t\n293\t        test_ctx->c_to_s_link->jitter = jitter;\n294\t        test_ctx->c_to_s_link->microsec_latency = latency;\n295\t        test_ctx->c_to_s_link->picosec_per_byte = picoseq_per_byte_return;\n296\t        test_ctx->s_to_c_link->microsec_latency = latency;\n297\t        test_ctx->s_to_c_link->picosec_per_byte = picoseq_per_byte_100;\n298\t        test_ctx->s_to_c_link->jitter = jitter;\n299\t\n300\t        if (ret == 0) {\n301\t            ret = tls_api_one_scenario_body(test_ctx, &simulated_time, test_scenario_10mb, sizeof(test_scenario_10mb), 0, 0, 0, buffer_size, max_completion_time);\n302\t        }\n303\t    }\n304\t\n305\t    /* Free the resource, which will close the log file.\n306\t     */\n307\t\n308\t    if (test_ctx != NULL) {\n309\t        tls_api_delete_ctx(test_ctx);\n310\t        test_ctx = NULL;\n311\t    }\n312\t\n313\t    return ret;\n314\t}\n315\t\n316\tint performance_test(uint64_t max_completion_time, uint64_t mbps, uint64_t latency, uint64_t jitter, uint64_t buffer_size)\n317\t{\n318\t    return performance_test_one(max_completion_time, mbps, 0, latency, jitter, buffer_size, NULL);\n319\t}\n320\t\n321\t/* BBR Performance test.\n322\t * Verify that 10 MB can be downloaded in less than 1 second on a 100 mbps link.\n323\t */\n324\t\n325\tint bbr_performance_test(void)\n326\t{\n327\t    uint64_t max_completion_time = 1050000;\n328\t    uint64_t latency = 10000;\n329\t    uint64_t jitter = 3000;\n330\t    uint64_t buffer = 2 * (latency + jitter);\n331\t    uint64_t mbps = 100;\n332\t\n333\t    int ret = performance_test(max_completion_time, mbps, latency, jitter, buffer);\n334\t\n335\t    return ret;\n336\t}\n337\t\n338\t/* BBR Performance test on a slow long link\n339\t * Verify that 10 MB can be downloaded in less than 100 seconds on a 1 mbps link.\n340\t */\n341\t\n342\tint bbr_slow_long_test(void)\n343\t{\n344\t    uint64_t max_completion_time = 81000000;\n345\t    uint64_t latency = 300000;\n346\t    uint64_t jitter = 3000;\n347\t    uint64_t buffer = 2 * (latency + jitter);\n348\t    uint64_t mbps = 1;\n349\t\n350\t    int ret = performance_test(max_completion_time, mbps, latency, jitter, buffer);\n351\t\n352\t    return ret;\n353\t}\n354\t\n355\t/* BBR Performance test on a pathological long link, with 2 seconds RTT\n356\t * Verify that 10 MB can be downloaded in less than 128 seconds on a 1 mbps link.\n357\t */\n358\t\n359\tint bbr_one_second_test(void)\n360\t{\n361\t    uint64_t max_completion_time = 90000000;\n362\t    uint64_t latency = 1000000;\n363\t    uint64_t jitter = 3000;\n364\t    uint64_t buffer = 2 * (latency + jitter);\n365\t    uint64_t mbps = 1;\n366\t\n367\t    int ret = performance_test(max_completion_time, mbps, latency, jitter, buffer);\n368\t\n369\t    return ret;\n370\t}\n371\t\n372\t\n373\t/* AWS like performance test\n374\t * Verify that 10MB can be downloaded very fast on a low latency Gbps link. */\n375\tint gbps_performance_test(void)\n376\t{\n377\t    uint64_t max_completion_time = 250000;\n378\t    uint64_t latency = 4000;\n379\t    uint64_t jitter = 2000;\n380\t    uint64_t buffer = 2 * (latency + jitter);\n381\t    uint64_t mbps = 1000;\n382\t\n383\t    int ret = performance_test(max_completion_time, mbps, latency, jitter, buffer);\n384\t\n385\t    return ret;\n386\t}\n387\t\n388\t\n389\t/* Asymmetric test.\n390\t * Verify that 10MB can be downloaded reasonably fast on a low latency 10Mbps link with 100kbps return path\n391\t * The buffer size is set to a high value, which allows queues to grow and delays to build up. In theory,\n392\t * BBR should minimize these queues, but the test verifies that it actually does.\n393\t */\n394\tint bbr_asym100_test(void)\n395\t{\n396\t    uint64_t max_completion_time = 8500000;\n397\t    uint64_t latency = 1000;\n398\t    uint64_t jitter = 750;\n399\t    uint64_t buffer = 50000;\n400\t    uint64_t mbps = 10;\n401\t    uint64_t kbps = 100;\n402\t\n403\t    int ret = performance_test_one(max_completion_time, mbps, kbps, latency, jitter, buffer, NULL);\n404\t\n405\t    return ret;\n406\t}\n407\t\n408\t/* Asymmetric test, no delay.\n409\t * Variant in which the negotiation of delayed ACK is disabled.\n410\t */\n411\tint bbr_asym100_nodelay_test(void)\n412\t{\n413\t    uint64_t max_completion_time = 8500000;\n414\t    uint64_t latency = 1000;\n415\t    uint64_t jitter = 750;\n416\t    uint64_t buffer = 50000;\n417\t    uint64_t mbps = 10;\n418\t    uint64_t kbps = 100;\n419\t    picoquic_tp_t server_parameters;\n420\t\n421\t    memset(&server_parameters, 0, sizeof(picoquic_tp_t));\n422\t    picoquic_init_transport_parameters(&server_parameters);\n423\t    server_parameters.min_ack_delay = 0;\n424\t\n425\t    int ret = performance_test_one(max_completion_time, mbps, kbps, latency, jitter, buffer,\n426\t        &server_parameters);\n427\t\n428\t    return ret;\n429\t}\n430\t\n431\t/* Asymmetric test.\n432\t * Variant using 400 kbps return path and a 40 Mbps link\n433\t */\n434\tint bbr_asym400_test(void)\n435\t{\n436\t    uint64_t max_completion_time = 2350000;\n437\t    uint64_t latency = 1000;\n438\t    uint64_t jitter = 750;\n439\t    uint64_t buffer = 50000;\n440\t    uint64_t mbps = 40;\n441\t    uint64_t kbps = 400;\n442\t\n443\t    int ret = performance_test_one(max_completion_time, mbps, kbps, latency, jitter, buffer, NULL);\n444\t\n445\t    return ret;\n446\t}\n447\t\n448\t/* Tests of BDP option.\n449\t * = Verify that a download works faster with BDP option enabled\n450\t * = Verify that the BDP option is not validated if the min rtt changes\n451\t * - Verify that the BDP option is not validated if the IP address changes\n452\t * - Verify that the BDP option is not validated if the delay is too long\n453\t */\n454\t\n455\ttypedef enum {\n456\t    bdp_test_option_none = 0,\n457\t    bdp_test_option_basic,\n458\t    bdp_test_option_rtt,\n459\t    bdp_test_option_ip,\n460\t    bdp_test_option_delay,\n461\t    bdp_test_option_reno,\n462\t    bdp_test_option_cubic,\n463\t    bdp_test_option_short,\n464\t    bdp_test_option_short_lo,\n465\t    bdp_test_option_short_hi,\n466\t    bdp_test_option_bbr1\n467\t} bdp_test_option_enum;\n468\t\n469\tint bdp_option_test_one(bdp_test_option_enum bdp_test_option)\n470\t{\n471\t    uint64_t simulated_time = 0;\n472\t    picoquic_test_tls_api_ctx_t* test_ctx = NULL;\n473\t    char const* sni = PICOQUIC_TEST_SNI;\n474\t    char const* alpn = PICOQUIC_TEST_ALPN;\n475\t    uint32_t proposed_version = 0;\n476\t    uint64_t max_completion_time = 6800000;\n477\t    uint64_t latency = 300000ull;\n478\t    uint64_t buffer_size = 2 * latency;\n479\t    picoquic_connection_id_t initial_cid = { {0xbd, 0x80, 0, 0, 0, 0, 0, 0}, 8 };\n480\t    picoquic_congestion_algorithm_t* ccalgo = picoquic_bbr_algorithm;\n481\t    picoquic_tp_t server_parameters;\n482\t    picoquic_tp_t client_parameters;\n483\t\n484\t    int ret = 0;\n485\t\n486\t    /* Initialize an empty ticket store */\n487\t    ret = picoquic_save_tickets(NULL, simulated_time, ticket_file_name);\n488\t\n489\t    for (int i = 0; ret == 0 && i < 2; i++) {\n490\t        /* If testing delay, insert a delay before the second connection attempt */\n491\t        if (i == 1 && bdp_test_option == bdp_test_option_delay) {\n492\t            simulated_time += 48ull * 3600ull * 1000000ull;\n493\t        }\n494\t        initial_cid.id[2] = i;\n495\t        initial_cid.id[3] = (uint8_t)bdp_test_option;\n496\t        /* Set up the context, while setting the ticket store parameter for the client */\n497\t        ret = tls_api_init_ctx_ex(&test_ctx,\n498\t            (i == 0) ? 0 : proposed_version, sni, alpn, &simulated_time, ticket_file_name, NULL, 0, 1, 0, &initial_cid);\n499\t        /* Set the various parameters */\n500\t        if (ret == 0) {\n501\t            test_ctx->c_to_s_link->microsec_latency = latency;\n502\t            test_ctx->s_to_c_link->microsec_latency = latency;\n503\t            test_ctx->c_to_s_link->picosec_per_byte = (1000000ull * 8) / 20;\n504\t            test_ctx->s_to_c_link->picosec_per_byte = (1000000ull * 8) / 20;\n505\t\n506\t            if (bdp_test_option == bdp_test_option_short ||\n507\t                bdp_test_option == bdp_test_option_short_lo ||\n508\t                bdp_test_option == bdp_test_option_short_hi) {\n509\t                /* Test that the BDP option also works well if delay < 250 ms */\n510\t                max_completion_time = 4500000;\n511\t                test_ctx->c_to_s_link->microsec_latency = 100000ull;\n512\t                test_ctx->s_to_c_link->microsec_latency = 100000ull;\n513\t                buffer_size = 2 * test_ctx->c_to_s_link->microsec_latency;\n514\t                if (i == 0) {\n515\t                    if (bdp_test_option == bdp_test_option_short_lo) {\n516\t                        test_ctx->c_to_s_link->picosec_per_byte *= 2;\n517\t                        test_ctx->s_to_c_link->picosec_per_byte *= 2;\n518\t                    }\n519\t                    else if (bdp_test_option == bdp_test_option_short_hi) {\n520\t                        test_ctx->c_to_s_link->picosec_per_byte /= 2;\n521\t                        test_ctx->s_to_c_link->picosec_per_byte /= 2;\n522\t                    }\n523\t                }\n524\t                else if (i == 1 && bdp_test_option == bdp_test_option_short_lo) {\n525\t                    max_completion_time = 4650000;\n526\t                }\n527\t            }\n528\t            else if (i > 0) {\n529\t                switch (bdp_test_option) {\n530\t                case bdp_test_option_none:\n531\t                    break;\n532\t                case bdp_test_option_basic:\n533\t                    max_completion_time = 5900000;\n534\t                    break;\n535\t                case bdp_test_option_rtt:\n536\t                    max_completion_time = 4610000;\n537\t                    test_ctx->c_to_s_link->microsec_latency = 50000ull;\n538\t                    test_ctx->s_to_c_link->microsec_latency = 50000ull;\n539\t                    buffer_size = 2 * test_ctx->c_to_s_link->microsec_latency;\n540\t                    break;\n541\t                case bdp_test_option_ip:\n542\t                    picoquic_set_test_address(&test_ctx->client_addr, 0x08080808, 2345);\n543\t                    max_completion_time = 9000000;\n544\t                    break;\n545\t                case bdp_test_option_delay:\n546\t                    max_completion_time = 8000000;\n547\t                    break;\n548\t                case bdp_test_option_reno:\n549\t                    max_completion_time = 6750000;\n550\t                    break;\n551\t                default:\n552\t                    break;\n553\t                }\n554\t            }\n555\t            if (bdp_test_option == bdp_test_option_reno) {\n556\t                ccalgo = picoquic_newreno_algorithm;\n557\t            }\n558\t            else if (bdp_test_option == bdp_test_option_cubic) {\n559\t                ccalgo = picoquic_cubic_algorithm;\n560\t                max_completion_time = 10000000;\n561\t            }\n562\t            else if (bdp_test_option == bdp_test_option_bbr1) {\n563\t                ccalgo = picoquic_bbr1_algorithm;\n564\t            }\n565\t            picoquic_set_default_congestion_algorithm(test_ctx->qserver, ccalgo);\n566\t            picoquic_set_congestion_algorithm(test_ctx->cnx_client, ccalgo);\n567\t            picoquic_set_default_bdp_frame_option(test_ctx->qclient, 1);\n568\t            picoquic_set_default_bdp_frame_option(test_ctx->qserver, 1);\n569\t            test_ctx->qserver->use_long_log = 1;\n570\t            picoquic_set_qlog(test_ctx->qserver, \".\");\n571\t            /* Set parameters */\n572\t            picoquic_init_transport_parameters(&server_parameters);\n573\t            picoquic_init_transport_parameters(&client_parameters);\n574\t            server_parameters.enable_bdp_frame = 1;\n575\t            client_parameters.enable_bdp_frame = 1;\n576\t            client_parameters.initial_max_stream_data_bidi_remote = 1000000;\n577\t            client_parameters.initial_max_data = 10000000;\n578\t            picoquic_set_transport_parameters(test_ctx->cnx_client, &client_parameters);\n579\t            ret = picoquic_set_default_tp(test_ctx->qserver, &server_parameters);\n580\t\n581\t            if (ret == 0) {\n582\t                ret = tls_api_one_scenario_body(test_ctx, &simulated_time, test_scenario_10mb, sizeof(test_scenario_10mb), 0, 0, 0, buffer_size,\n583\t                    (i == 0) ? 0 : max_completion_time);\n584\t            }\n585\t\n586\t            /* Verify that the BDP option was set and processed */\n587\t            if (ret == 0) {\n588\t                if (i == 1 && test_ctx->cnx_client->nb_zero_rtt_acked == 0 && bdp_test_option != bdp_test_option_delay) {\n589\t                    DBG_PRINTF(\"BDP RTT test (bdp test: %d), cnx %d, no zero RTT data acked.\\n\",\n590\t                        bdp_test_option, i);\n591\t                    ret = -1;\n592\t                }\n593\t                if (!test_ctx->cnx_client->send_receive_bdp_frame) {\n594\t                    DBG_PRINTF(\"BDP RTT test (bdp test: %d), cnx %d, bdp option not negotiated on client.\\n\",\n595\t                        bdp_test_option, i);\n596\t                    ret = -1;\n597\t                }\n598\t                if (!test_ctx->cnx_server->send_receive_bdp_frame) {\n599\t                    DBG_PRINTF(\"BDP RTT test (bdp test: %d), cnx %d, bdp option not negotiated on server.\\n\",\n600\t                        bdp_test_option, i);\n601\t                    ret = -1;\n602\t                }\n603\t                if (ret == 0 && i == 1) {\n604\t                    if (test_ctx->cnx_server->nb_retransmission_total * 10 >\n605\t                        test_ctx->cnx_server->nb_packets_sent &&\n606\t                        bdp_test_option != bdp_test_option_cubic &&\n607\t                        bdp_test_option != bdp_test_option_delay &&\n608\t                        bdp_test_option != bdp_test_option_ip) {\n609\t                        DBG_PRINTF(\"BDP RTT test (bdp test: %d), cnx %d, too many losses, %\"PRIu64\"/%\"PRIu64\".\\n\",\n610\t                            bdp_test_option, i, test_ctx->cnx_server->nb_retransmission_total,\n611\t                            test_ctx->cnx_server->nb_packets_sent);\n612\t                        ret = -1;\n613\t\n614\t                    }\n615\t                    /* Verify bdp test option was executed */\n616\t                    if (!test_ctx->cnx_client->path[0]->is_bdp_sent) {\n617\t                        DBG_PRINTF(\"BDP RTT test (bdp test: %d), cnx %d, bdp frame not sent by client.\\n\",\n618\t                            bdp_test_option, i);\n619\t                        ret = -1;\n620\t                    }\n621\t                    else if (bdp_test_option == bdp_test_option_basic ||\n622\t                        bdp_test_option == bdp_test_option_reno ||\n623\t                        bdp_test_option == bdp_test_option_short ||\n624\t                        bdp_test_option == bdp_test_option_short_hi ||\n625\t                        bdp_test_option == bdp_test_option_short_lo ||\n626\t                        bdp_test_option == bdp_test_option_cubic ||\n627\t                        bdp_test_option == bdp_test_option_bbr1) {\n628\t                        if (!test_ctx->cnx_server->cwin_notified_from_seed) {\n629\t                            DBG_PRINTF(\"BDP RTT test (bdp test: %d), cnx %d, cwin not seed on server.\\n\",\n630\t                                bdp_test_option, i);\n631\t                            ret = -1;\n632\t                        }\n633\t                    }\n634\t                    else if (test_ctx->cnx_server->cwin_notified_from_seed) {\n635\t                        DBG_PRINTF(\"BDP RTT test (bdp test: %d), cnx %d, unexpected cwin seed on server.\\n\",\n636\t                            bdp_test_option, i);\n637\t                        ret = -1;\n638\t                    }\n639\t                }\n640\t            }\n641\t\n642\t            /* Save the session tickets */\n643\t            if (ret == 0) {\n644\t                if (test_ctx->qclient->p_first_ticket == NULL) {\n645\t                    DBG_PRINTF(\"BDP RTT test (bdp option: %d), cnx %d, no ticket received.\\n\",\n646\t                        bdp_test_option, i);\n647\t                    ret = -1;\n648\t                }\n649\t                else {\n650\t                    ret = picoquic_save_tickets(test_ctx->qclient->p_first_ticket, simulated_time, ticket_file_name);\n651\t                    if (ret != 0) {\n652\t                        DBG_PRINTF(\"Zero RTT test (bdp test option: %d), cnx %d, ticket save error (0x%x).\\n\",\n653\t                            bdp_test_option, i, ret);\n654\t                    }\n655\t                }\n656\t            }\n657\t\n658\t            /* Free the resource, which will close the log file. */\n659\t            if (test_ctx != NULL) {\n660\t                tls_api_delete_ctx(test_ctx);\n661\t                test_ctx = NULL;\n662\t            }\n663\t        }\n664\t    }\n665\t\n666\t    return ret;\n667\t}\n668\t\n669\tint bdp_basic_test(void)\n670\t{\n671\t    return bdp_option_test_one(bdp_test_option_basic);\n672\t}\n673\t\n674\tint bdp_rtt_test(void)\n675\t{\n676\t    /* TODO: this test succeeds for the wrong reason.\n677\t    * The goal of the test is to verify that the BDP is NOT set\n678\t    * if the RTT on the second connection does not match the RTT\n679\t    * on the first one. The test does that, but only because the\n680\t    * second connection's RTT is lower than BBRLongRttThreshold,\n681\t    * thus uses regular BBR startup, in which the BDP option is\n682\t    * not implemented.\n683\t     */\n684\t    return bdp_option_test_one(bdp_test_option_rtt);\n685\t}\n686\t\n687\tint bdp_ip_test(void)\n688\t{\n689\t    return bdp_option_test_one(bdp_test_option_ip);\n690\t}\n691\t\n692\tint bdp_delay_test(void)\n693\t{\n694\t    return bdp_option_test_one(bdp_test_option_delay);\n695\t}\n696\t\n697\tint bdp_reno_test(void)\n698\t{\n699\t    return bdp_option_test_one(bdp_test_option_reno);\n700\t}\n701\t\n702\tint bdp_short_test(void)\n703\t{\n704\t    return bdp_option_test_one(bdp_test_option_short);\n705\t}\n706\t\n707\tint bdp_short_hi_test(void)\n708\t{\n709\t    return bdp_option_test_one(bdp_test_option_short_hi);\n710\t}\n711\t\n712\tint bdp_short_lo_test(void)\n713\t{\n714\t    return bdp_option_test_one(bdp_test_option_short_lo);\n715\t}\n716\t\n717\t#if defined(_WINDOWS) && !defined(_WINDOWS64)\n718\tint bdp_cubic_test(void)\n719\t{\n720\t    /* We do not run this test in Win32 builds. */\n721\t    return 0;\n722\t}\n723\t#else\n724\tint bdp_cubic_test(void)\n725\t{\n726\t    return bdp_option_test_one(bdp_test_option_cubic);\n727\t}\n728\t#endif\n729\t\n730\tint bdp_bbr1_test(void)\n731\t{\n732\t    return bdp_option_test_one(bdp_test_option_bbr1);\n733\t}\n734\t\n735\t/*\n736\t * The \"blackhole\" test simulates a link breakage of 2 seconds, during which all packets\n737\t * are lost. The connection is expected to survive the blackhole, and then recover.\n738\t*/\n739\t\n740\tstatic int blackhole_test_one(picoquic_congestion_algorithm_t* ccalgo, uint64_t max_completion_time, uint64_t jitter)\n741\t{\n742\t    uint64_t simulated_time = 0;\n743\t    uint64_t latency = 15000;\n744\t    uint64_t picoseq_per_byte_10 = (1000000ull * 8) / 10;\n745\t    picoquic_test_tls_api_ctx_t* test_ctx = NULL;\n746\t    picoquic_connection_id_t initial_cid = { {0xb1, 0xac, 2, 3, 4, 5, 6, 7}, 8 };\n747\t    int ret = 0;\n748\t\n749\t    initial_cid.id[2] = ccalgo->congestion_algorithm_number;\n750\t\n751\t    ret = tls_api_init_ctx_ex(&test_ctx, PICOQUIC_INTERNAL_TEST_VERSION_1, PICOQUIC_TEST_SNI, PICOQUIC_TEST_ALPN, &simulated_time, NULL, NULL, 0, 1, 0, &initial_cid);\n752\t\n753\t    if (ret == 0 && test_ctx == NULL) {\n754\t        ret = -1;\n755\t    }\n756\t\n757\t    /* Simulate 10 ms link, 15ms latency, 2 seconds blackhole */\n758\t    if (ret == 0) {\n759\t        picoquic_set_default_congestion_algorithm(test_ctx->qserver, ccalgo);\n760\t        picoquic_set_congestion_algorithm(test_ctx->cnx_client, ccalgo);\n761\t\n762\t        test_ctx->c_to_s_link->jitter = jitter;\n763\t        test_ctx->c_to_s_link->microsec_latency = latency;\n764\t        test_ctx->c_to_s_link->picosec_per_byte = picoseq_per_byte_10;\n765\t        test_ctx->s_to_c_link->microsec_latency = latency;\n766\t        test_ctx->s_to_c_link->picosec_per_byte = picoseq_per_byte_10;\n767\t        test_ctx->s_to_c_link->jitter = jitter;\n768\t        test_ctx->blackhole_end = 7000000;\n769\t        test_ctx->blackhole_start = 5000000;\n770\t\n771\t\n772\t        picoquic_set_qlog(test_ctx->qserver, \".\");\n773\t\n774\t        if (ret == 0) {\n775\t            ret = tls_api_one_scenario_body(test_ctx, &simulated_time, test_scenario_10mb, sizeof(test_scenario_10mb), 0, 0, 0, 2 * latency, max_completion_time);\n776\t        }\n777\t    }\n778\t\n779\t    if (test_ctx != NULL) {\n780\t        tls_api_delete_ctx(test_ctx);\n781\t        test_ctx = NULL;\n782\t    }\n783\t\n784\t    return ret;\n785\t}\n786\t\n787\tint blackhole_test(void)\n788\t{\n789\t    int ret = blackhole_test_one(picoquic_bbr_algorithm, 15000000, 0);\n790\t\n791\t    return ret;\n792\t}\n793\t\n794\t/*\n795\t* Application limited test.\n796\t* The application is set to limit the max data values to stay lower than a set flow control window.\n797\t* We verify that in these scenario the CWIN does not grow too much above the flow control window.\n798\t*/\n799\t#define APP_LIMIT_TRACE_QLOG \"acc1020304050607.server.qlog\"\n800\t\n801\tint app_limit_cc_test_one(\n802\t    picoquic_congestion_algorithm_t* ccalgo, uint64_t max_completion_time)\n803\t{\n804\t    uint64_t simulated_time = 0;\n805\t    uint64_t latency = 300000;\n806\t    uint64_t picoseq_per_byte_1 = (1000000ull * 8) / 1;\n807\t    picoquic_test_tls_api_ctx_t* test_ctx = NULL;\n808\t    picoquic_tp_t client_parameters;\n809\t    uint64_t cwin_limit = 120000;\n810\t    picoquic_connection_id_t initial_cid = { {0xac, 0xc1, 2, 3, 4, 5, 6, 7}, 8 };\n811\t    int ret = 0;\n812\t\n813\t    (void)picoquic_file_delete(APP_LIMIT_TRACE_QLOG, NULL);\n814\t\n815\t    memset(&client_parameters, 0, sizeof(picoquic_tp_t));\n816\t    picoquic_init_transport_parameters(&client_parameters);\n817\t    client_parameters.initial_max_data = 40000;\n818\t\n819\t    ret = tls_api_one_scenario_init_ex(&test_ctx, &simulated_time, PICOQUIC_INTERNAL_TEST_VERSION_1, &client_parameters,\n820\t        NULL, &initial_cid);\n821\t\n822\t    if (ret == 0 && test_ctx == NULL) {\n823\t        ret = -1;\n824\t    }\n825\t\n826\t    if (ret == 0) {\n827\t\n828\t        picoquic_set_default_congestion_algorithm(test_ctx->qserver, ccalgo);\n829\t        picoquic_set_congestion_algorithm(test_ctx->cnx_client, ccalgo);\n830\t        picoquic_set_qlog(test_ctx->qserver, \".\");\n831\t        test_ctx->qserver->use_long_log = 1;\n832\t        picoquic_set_max_data_control(test_ctx->qclient, client_parameters.initial_max_data);\n833\t\n834\t        test_ctx->c_to_s_link->jitter = 0;\n835\t        test_ctx->c_to_s_link->microsec_latency = latency;\n836\t        test_ctx->c_to_s_link->picosec_per_byte = picoseq_per_byte_1;\n837\t        test_ctx->s_to_c_link->microsec_latency = latency;\n838\t        test_ctx->s_to_c_link->picosec_per_byte = picoseq_per_byte_1;\n839\t        test_ctx->s_to_c_link->jitter = 0;\n840\t\n841\t        if (ret == 0) {\n842\t            ret = tls_api_one_scenario_body(test_ctx, &simulated_time,\n843\t                test_scenario_very_long, sizeof(test_scenario_very_long), 0, 0, 0, 2 * latency, max_completion_time);\n844\t        }\n845\t    }\n846\t\n847\t    /* Free the resource, which will close the log file.\n848\t     */\n849\t\n850\t    if (test_ctx != NULL) {\n851\t        tls_api_delete_ctx(test_ctx);\n852\t        test_ctx = NULL;\n853\t    }\n854\t\n855\t\n856\t    /* Get the max bytes in flight from QLOG file, and check it is under the limit */\n857\t    if (ret == 0) {\n858\t        uint64_t bytes_in_flight_max;\n859\t        ret = picoquic_check_bytes_in_flight(APP_LIMIT_TRACE_QLOG, &bytes_in_flight_max);\n860\t        if (ret == 0 && bytes_in_flight_max > cwin_limit) {\n861\t            DBG_PRINTF(\"MAX In Flight = %\" PRIu64 \", larger than %\" PRIu64, bytes_in_flight_max, cwin_limit);\n862\t            ret = -1;\n863\t        }\n864\t    }\n865\t\n866\t    return ret;\n867\t}\n868\t\n869\tint app_limit_cc_test(void)\n870\t{\n871\t    picoquic_congestion_algorithm_t* ccalgos[] = {\n872\t        picoquic_newreno_algorithm,\n873\t        picoquic_cubic_algorithm,\n874\t        picoquic_dcubic_algorithm,\n875\t        picoquic_bbr_algorithm,\n876\t        picoquic_fastcc_algorithm,\n877\t        picoquic_bbr1_algorithm\n878\t    };\n879\t    uint64_t max_completion_times[] = {\n880\t        22000000,\n881\t        23500000,\n882\t        22000000,\n883\t        21000000,\n884\t        25000000,\n885\t        25000000\n886\t    };\n887\t    int ret = 0;\n888\t\n889\t    for (size_t i = 0; i < sizeof(ccalgos) / sizeof(picoquic_congestion_algorithm_t*); i++) {\n890\t        ret = app_limit_cc_test_one(ccalgos[i], max_completion_times[i]);\n891\t        if (ret != 0) {\n892\t            DBG_PRINTF(\"Appplication limited congestion test fails for <%s>\", ccalgos[i]->congestion_algorithm_id);\n893\t            break;\n894\t        }\n895\t    }\n896\t\n897\t    return ret;\n898\t}\n899\t\n900\t/* Test the effectiveness of the CWIN MAX option\n901\t */\n902\t\n903\t#define CWIN_MAX_TRACE_QLOG \"c9149a0102030405.server.qlog\"\n904\t\n905\tint picoquic_check_bytes_in_flight(char const * qlog_file, uint64_t* max_bytes_in_flight)\n906\t{\n907\t    int ret = 0;\n908\t    FILE* F = picoquic_file_open(qlog_file, \"r\");\n909\t\n910\t    if (F == NULL) {\n911\t        DBG_PRINTF(\"Cannot open <%s>\", qlog_file);\n912\t        ret = -1;\n913\t    }\n914\t    else {\n915\t        *max_bytes_in_flight = 0;\n916\t        while (ret == 0 && F != NULL) {\n917\t            char buffer[512];\n918\t            int c_index = 0;\n919\t            if (fgets(buffer, 512, F) == NULL) {\n920\t                break;\n921\t            }\n922\t            /* Look for bytes_in_flight property */\n923\t            while (buffer[c_index] != 0 && (\n924\t                buffer[c_index] != '\\\"' ||\n925\t                strcmp(\"\\\"bytes_in_flight\\\":\", &buffer[c_index]) != 0)) {\n926\t                c_index++;\n927\t            }\n928\t            if (buffer[c_index] != 0) {\n929\t                uint64_t bytes_in_flight = 0;\n930\t                while (buffer[c_index] != 0 && buffer[c_index] != ':') {\n931\t                    c_index++;\n932\t                }\n933\t                while (buffer[c_index] != 0 && (buffer[c_index] < '0' || buffer[c_index] > '9')) {\n934\t                    c_index++;\n935\t                }\n936\t                while (buffer[c_index] >= '0' && buffer[c_index] <= '9') {\n937\t                    bytes_in_flight *= 10;\n938\t                    bytes_in_flight += (uint64_t)buffer[c_index] - '0';\n939\t                    c_index++;\n940\t                }\n941\t                if (bytes_in_flight > *max_bytes_in_flight) {\n942\t                    *max_bytes_in_flight = bytes_in_flight;\n943\t                }\n944\t            }\n945\t        }\n946\t        picoquic_file_close(F);\n947\t    }\n948\t    return ret;\n949\t}\n950\t\n951\tint cwin_max_test_one(\n952\t    picoquic_congestion_algorithm_t* ccalgo, uint64_t cwin_limit, uint64_t max_completion_time)\n953\t{\n954\t    uint64_t simulated_time = 0;\n955\t    uint64_t latency = 300000;\n956\t    uint64_t picoseq_per_byte_1 = (1000000ull * 8) / 100;\n957\t    picoquic_test_tls_api_ctx_t* test_ctx = NULL;\n958\t    picoquic_tp_t client_parameters;\n959\t    picoquic_connection_id_t initial_cid = { {0xc9, 0x14, 0x9a, 1, 2, 3, 4, 5}, 8 };\n960\t    int ret = 0;\n961\t\n962\t    (void)picoquic_file_delete(CWIN_MAX_TRACE_QLOG, NULL);\n963\t\n964\t    memset(&client_parameters, 0, sizeof(picoquic_tp_t));\n965\t    picoquic_init_transport_parameters(&client_parameters);\n966\t\n967\t    ret = tls_api_one_scenario_init_ex(&test_ctx, &simulated_time, PICOQUIC_INTERNAL_TEST_VERSION_1, &client_parameters,\n968\t        NULL, &initial_cid);\n969\t\n970\t    if (ret == 0 && test_ctx == NULL) {\n971\t        ret = -1;\n972\t    }\n973\t\n974\t    if (ret == 0) {\n975\t        picoquic_set_default_congestion_algorithm(test_ctx->qserver, ccalgo);\n976\t        picoquic_set_congestion_algorithm(test_ctx->cnx_client, ccalgo);\n977\t        picoquic_set_cwin_max(test_ctx->qserver, 0x10000);\n978\t        picoquic_set_qlog(test_ctx->qserver, \".\");\n979\t        test_ctx->qserver->use_long_log = 1;\n980\t        picoquic_set_max_data_control(test_ctx->qclient, client_parameters.initial_max_data);\n981\t\n982\t        test_ctx->c_to_s_link->jitter = 0;\n983\t        test_ctx->c_to_s_link->microsec_latency = latency;\n984\t        test_ctx->c_to_s_link->picosec_per_byte = picoseq_per_byte_1;\n985\t        test_ctx->s_to_c_link->microsec_latency = latency;\n986\t        test_ctx->s_to_c_link->picosec_per_byte = picoseq_per_byte_1;\n987\t        test_ctx->s_to_c_link->jitter = 0;\n988\t\n989\t        if (ret == 0) {\n990\t            ret = tls_api_one_scenario_body(test_ctx, &simulated_time,\n991\t                test_scenario_very_long, sizeof(test_scenario_very_long), 0, 0, 0, 2 * latency, max_completion_time);\n992\t        }\n993\t    }\n994\t\n995\t    /* Free the resource, which will close the log file.\n996\t    */\n997\t\n998\t    if (test_ctx != NULL) {\n999\t        tls_api_delete_ctx(test_ctx);\n1000\t        test_ctx = NULL;\n1001\t    }\n1002\t\n1003\t    /* Get the max bytes in flight from QLOG file, and check it is under the limit */\n1004\t    if (ret == 0) {\n1005\t        uint64_t bytes_in_flight_max;\n1006\t        ret = picoquic_check_bytes_in_flight(CWIN_MAX_TRACE_QLOG, &bytes_in_flight_max);\n1007\t        if (ret == 0 && bytes_in_flight_max > cwin_limit) {\n1008\t            DBG_PRINTF(\"MAX In Flight = %\" PRIu64 \", larger than %\" PRIu64, bytes_in_flight_max, cwin_limit);\n1009\t            ret = -1;\n1010\t        }\n1011\t    }\n1012\t\n1013\t    return ret;\n1014\t}\n1015\t\n1016\tint cwin_max_test(void)\n1017\t{\n1018\t    picoquic_congestion_algorithm_t* ccalgos[] = {\n1019\t        picoquic_newreno_algorithm,\n1020\t        picoquic_cubic_algorithm,\n1021\t        picoquic_dcubic_algorithm,\n1022\t        picoquic_bbr_algorithm,\n1023\t        picoquic_fastcc_algorithm,\n1024\t        picoquic_bbr1_algorithm\n1025\t    };\n1026\t    uint64_t max_completion_times[] = {\n1027\t        11000000,\n1028\t        11000000,\n1029\t        11000000,\n1030\t        11000000,\n1031\t        12100000,\n1032\t        11000000\n1033\t    };\n1034\t    int ret = 0;\n1035\t\n1036\t    for (size_t i = 0; i < sizeof(ccalgos) / sizeof(picoquic_congestion_algorithm_t*); i++) {\n1037\t        ret = cwin_max_test_one(ccalgos[i], 68000, max_completion_times[i]);\n1038\t        if (ret != 0) {\n1039\t            DBG_PRINTF(\"CWIN Max test fails for <%s>\", ccalgos[i]->congestion_algorithm_id);\n1040\t            break;\n1041\t        }\n1042\t    }\n1043\t\n1044\t    return ret;\n1045\t}\n1046\t"}]},"parent_tool_use_id":null,"session_id":"e83c2219-e7e2-4ba6-943d-0a43ed90478f","uuid":"0eedb7a3-c7f4-427c-acb5-677fa491cec5","timestamp":"2026-05-04T22:59:12.356Z","tool_use_result":{"type":"text","file":{"filePath":"/Users/richbarn/Projects/picoquic/picoquictest/congestion_test.c","content":"/*\n* Author: Christian Huitema\n* Copyright (c) 2017, Private Octopus, Inc.\n* All rights reserved.\n*\n* Permission to use, copy, modify, and distribute this software for any\n* purpose with or without fee is hereby granted, provided that the above\n* copyright notice and this permission notice appear in all copies.\n*\n* THIS SOFTWARE IS PROVIDED BY THE COPYRIGHT HOLDERS AND CONTRIBUTORS \"AS IS\" AND\n* ANY EXPRESS OR IMPLIED WARRANTIES, INCLUDING, BUT NOT LIMITED TO, THE IMPLIED\n* WARRANTIES OF MERCHANTABILITY AND FITNESS FOR A PARTICULAR PURPOSE ARE\n* DISCLAIMED. IN NO EVENT SHALL Private Octopus, Inc. BE LIABLE FOR ANY\n* DIRECT, INDIRECT, INCIDENTAL, SPECIAL, EXEMPLARY, OR CONSEQUENTIAL DAMAGES\n* (INCLUDING, BUT NOT LIMITED TO, PROCUREMENT OF SUBSTITUTE GOODS OR SERVICES;\n* LOSS OF USE, DATA, OR PROFITS; OR BUSINESS INTERRUPTION) HOWEVER CAUSED AND\n* ON ANY THEORY OF LIABILITY, WHETHER IN CONTRACT, STRICT LIABILITY, OR TORT\n* (INCLUDING NEGLIGENCE OR OTHERWISE) ARISING IN ANY WAY OUT OF THE USE OF THIS\n* SOFTWARE, EVEN IF ADVISED OF THE POSSIBILITY OF SUCH DAMAGE.\n*/\n\n#include \"tls_api.h\"\n#include \"picoquic_internal.h\"\n#include \"picoquictest_internal.h\"\n#include <stdlib.h>\n#include <string.h>\n\n#include \"logreader.h\"\n#include \"autoqlog.h\"\n#include \"picoquic_logger.h\"\n#include \"qlog.h\"\n\n#include \"picoquic_newreno.h\"\n#include \"picoquic_cubic.h\"\n#include \"picoquic_bbr.h\"\n#include \"picoquic_bbr1.h\"\n#include \"picoquic_fastcc.h\"\n#include \"picoquic_prague.h\"\n#include \"picoquic_c4.h\"\n\nstatic test_api_stream_desc_t test_scenario_congestion[] = {\n    { 4, 0, 257, 1000000 },\n    { 8, 4, 257, 1000000 },\n    { 12, 8, 257, 1000000 },\n    { 16, 12, 257, 1000000 }\n};\n\nstatic test_api_stream_desc_t test_scenario_10mb[] = {\n    { 4, 0, 257, 1000000 },\n    { 8, 0, 257, 1000000 },\n    { 12, 0, 257, 1000000 },\n    { 16, 0, 257, 1000000 },\n    { 20, 0, 257, 1000000 },\n    { 24, 0, 257, 1000000 },\n    { 28, 0, 257, 1000000 },\n    { 32, 0, 257, 1000000 },\n    { 36, 0, 257, 1000000 },\n    { 40, 0, 257, 1000000 }\n};\n\nstatic test_api_stream_desc_t test_scenario_very_long[] = {\n    { 4, 0, 257, 1000000 }\n};\n\n\nstatic char const* ticket_file_name = \"resume_tests_tickets.bin\";\n\nstatic int congestion_control_test(picoquic_congestion_algorithm_t* ccalgo, uint64_t max_completion_time, uint64_t jitter, uint8_t jitter_id)\n{\n    uint64_t simulated_time = 0;\n    picoquic_test_tls_api_ctx_t* test_ctx = NULL;\n    picoquic_connection_id_t initial_cid = { {0xcc, 0xcc, 0, 0, 0, 0, 0, 0}, 8 };\n    int ret;\n\n    initial_cid.id[2] = ccalgo->congestion_algorithm_number;\n    initial_cid.id[3] = jitter_id;\n\n    ret = tls_api_init_ctx_ex(&test_ctx, PICOQUIC_INTERNAL_TEST_VERSION_1, PICOQUIC_TEST_SNI, PICOQUIC_TEST_ALPN, &simulated_time, NULL, NULL, 0, 1, 0, &initial_cid);\n\n    if (ret == 0 && test_ctx == NULL) {\n        ret = -1;\n    }\n\n    /* Set the congestion algorithm to specified value. Also, request a packet trace */\n    if (ret == 0) {\n\n        picoquic_set_default_congestion_algorithm(test_ctx->qserver, ccalgo);\n        picoquic_set_congestion_algorithm(test_ctx->cnx_client, ccalgo);\n\n        test_ctx->c_to_s_link->jitter = jitter;\n        test_ctx->s_to_c_link->jitter = jitter;\n\n        picoquic_set_qlog(test_ctx->qserver, \".\");\n\n        ret = tls_api_one_scenario_body(test_ctx, &simulated_time,\n            test_scenario_congestion, sizeof(test_scenario_congestion), 0, 0, 0, 20000 + 2 * jitter, max_completion_time);\n    }\n\n    /* Free the resource, which will close the log file.\n     */\n\n    if (test_ctx != NULL) {\n        tls_api_delete_ctx(test_ctx);\n        test_ctx = NULL;\n    }\n\n    return ret;\n}\n\nint cubic_test(void)\n{\n    return congestion_control_test(picoquic_cubic_algorithm, 3500000, 0, 0);\n}\n\nint cubic_jitter_test(void)\n{\n    return congestion_control_test(picoquic_cubic_algorithm, 3550000, 5000, 5);\n}\n\nint c4_test(void)\n{\n    return congestion_control_test(c4_algorithm, 3600000, 0, 0);\n}\n\nint c4_jitter_test(void)\n{\n    return congestion_control_test(c4_algorithm, 3650000, 5000, 5);\n}\n\nint fastcc_test(void)\n{\n    return congestion_control_test(picoquic_fastcc_algorithm, 3700000, 0, 0);\n}\n\nint fastcc_jitter_test(void)\n{\n    return congestion_control_test(picoquic_fastcc_algorithm, 4050000, 5000, 5);\n}\n\nint bbr_test(void)\n{\n    return congestion_control_test(picoquic_bbr_algorithm, 3500000, 0, 0);\n}\n\nint bbr_jitter_test(void)\n{\n    return congestion_control_test(picoquic_bbr_algorithm, 3600000, 5000, 5);\n}\n\nstatic int congestion_long_test(picoquic_congestion_algorithm_t* ccalgo)\n{\n    uint64_t simulated_time = 0;\n    uint64_t loss_mask = 0;\n    picoquic_test_tls_api_ctx_t* test_ctx = NULL;\n    picoquic_connection_id_t initial_cid = { {0xbb, 0xcc, 0x10, 0, 0, 0, 0, 0}, 8 };\n    int ret;\n\n\n    ret = tls_api_init_ctx_ex(&test_ctx, PICOQUIC_INTERNAL_TEST_VERSION_1, PICOQUIC_TEST_SNI, PICOQUIC_TEST_ALPN, &simulated_time, NULL, NULL, 0, 1, 0, &initial_cid);\n\n    if (ret == 0 && test_ctx == NULL) {\n        ret = -1;\n    }\n\n    /* Set the congestion algorithm to specified value. Also, request a packet trace */\n    if (ret == 0) {\n        picoquic_set_default_congestion_algorithm(test_ctx->qserver, ccalgo);\n        picoquic_set_congestion_algorithm(test_ctx->cnx_client, ccalgo);\n\n\n        test_ctx->c_to_s_link->jitter = 0;\n        test_ctx->s_to_c_link->jitter = 0;\n        test_ctx->c_to_s_link->picosec_per_byte = 8000000; /* Simulate 1 Mbps */\n\n        picoquic_set_qlog(test_ctx->qserver, \".\");\n        test_ctx->qserver->use_long_log = 1;\n\n        ret = tls_api_one_scenario_body_connect(test_ctx, &simulated_time, 0, 0);\n        if (ret != 0)\n        {\n            DBG_PRINTF(\"Connection loop returns %d\\n\", ret);\n        }\n    }\n\n    /* Prepare to send data */\n    if (ret == 0) {\n        ret = test_api_init_send_recv_scenario(test_ctx, test_scenario_congestion, sizeof(test_scenario_congestion));\n\n        if (ret != 0)\n        {\n            DBG_PRINTF(\"Init send receive scenario returns %d\\n\", ret);\n        }\n    }\n\n    /* Run a data sending loop for 1024 rounds, causing BBR to detect a low RTT */\n    if (ret == 0) {\n        ret = tls_api_data_sending_loop(test_ctx, &loss_mask, &simulated_time, 1024);\n\n        if (ret != 0)\n        {\n            DBG_PRINTF(\"Data sending loop returns %d\\n\", ret);\n        }\n    }\n\n    /* Increase the RTT from the previous value, which will cause the bandwidth to drop unless RTT is reset  */\n    if (ret == 0) {\n        test_ctx->c_to_s_link->microsec_latency = 5 * test_ctx->c_to_s_link->microsec_latency;\n        test_ctx->s_to_c_link->microsec_latency = 5 * test_ctx->s_to_c_link->microsec_latency;\n    }\n\n\n    /* Perform a data sending loop */\n    if (ret == 0) {\n        ret = tls_api_data_sending_loop(test_ctx, &loss_mask, &simulated_time, 0);\n\n        if (ret != 0)\n        {\n            DBG_PRINTF(\"Data sending loop returns %d\\n\", ret);\n        }\n    }\n\n    if (ret == 0) {\n        ret = tls_api_one_scenario_body_verify(test_ctx, &simulated_time, 15000000);\n    }\n\n    /* Free the resource, which will close the log file. */\n\n    if (test_ctx != NULL) {\n        tls_api_delete_ctx(test_ctx);\n        test_ctx = NULL;\n    }\n\n    return ret;\n}\n\nint bbr_long_test(void)\n{\n    return congestion_long_test(picoquic_bbr_algorithm);\n}\n\nint c4_long_test(void)\n{\n    return congestion_long_test(c4_algorithm);\n}\n\nint bbr1_test(void)\n{\n    return congestion_control_test(picoquic_bbr1_algorithm, 3600000, 0, 0);\n}\n\nint bbr1_long_test(void)\n{\n    return congestion_long_test(picoquic_bbr1_algorithm);\n}\n\n/* Performance test.\n * Check a variety of challenging scenarios\n */\n\nint performance_test_one(uint64_t max_completion_time, uint64_t mbps, uint64_t rkbps, uint64_t latency,\n    uint64_t jitter, uint64_t buffer_size, picoquic_tp_t* server_parameters)\n{\n    uint64_t simulated_time = 0x0005a138fbde8743; /* Init to non zero time to test handling of time in cc algorithm */\n    uint64_t picoseq_per_byte_100 = (1000000ull * 8) / mbps;\n    uint64_t picoseq_per_byte_return = (rkbps == 0) ? picoseq_per_byte_100 : (1000000000ull * 8) / rkbps;\n    picoquic_connection_id_t initial_cid = { {0xbb, 0xcc, 0, 0, 0, 0, 0, 0}, 8 };\n    picoquic_test_tls_api_ctx_t* test_ctx = NULL;\n    picoquic_congestion_algorithm_t* ccalgo = picoquic_bbr_algorithm;\n    uint64_t buffer_id = (buffer_size * 16) / (latency + jitter);\n    int ret = 0;\n\n\n    initial_cid.id[3] = (rkbps > 0xff) ? 0xff : (uint8_t)rkbps;\n    initial_cid.id[4] = (mbps > 0xff) ? 0xff : (uint8_t)mbps;\n    initial_cid.id[5] = (latency > 2550000) ? 0xff : (uint8_t)(latency / 10000);\n    initial_cid.id[6] = (jitter > 255000) ? 0xff : (uint8_t)(jitter / 1000);\n    initial_cid.id[7] = (buffer_id > 255) ? 0xff : (uint8_t)buffer_id;\n\n    ret = tls_api_one_scenario_init_ex(&test_ctx, &simulated_time, PICOQUIC_INTERNAL_TEST_VERSION_1, NULL, server_parameters, &initial_cid);\n\n    if (ret == 0 && test_ctx == NULL) {\n        ret = -1;\n    }\n\n    if (ret == 0) {\n        picoquic_set_default_congestion_algorithm(test_ctx->qserver, ccalgo);\n        picoquic_set_congestion_algorithm(test_ctx->cnx_client, ccalgo);\n        test_ctx->qserver->use_long_log = 1;\n\n        picoquic_set_qlog(test_ctx->qserver, \".\");\n        picoquic_set_qlog(test_ctx->qclient, \".\");\n\n        test_ctx->c_to_s_link->jitter = jitter;\n        test_ctx->c_to_s_link->microsec_latency = latency;\n        test_ctx->c_to_s_link->picosec_per_byte = picoseq_per_byte_return;\n        test_ctx->s_to_c_link->microsec_latency = latency;\n        test_ctx->s_to_c_link->picosec_per_byte = picoseq_per_byte_100;\n        test_ctx->s_to_c_link->jitter = jitter;\n\n        if (ret == 0) {\n            ret = tls_api_one_scenario_body(test_ctx, &simulated_time, test_scenario_10mb, sizeof(test_scenario_10mb), 0, 0, 0, buffer_size, max_completion_time);\n        }\n    }\n\n    /* Free the resource, which will close the log file.\n     */\n\n    if (test_ctx != NULL) {\n        tls_api_delete_ctx(test_ctx);\n        test_ctx = NULL;\n    }\n\n    return ret;\n}\n\nint performance_test(uint64_t max_completion_time, uint64_t mbps, uint64_t latency, uint64_t jitter, uint64_t buffer_size)\n{\n    return performance_test_one(max_completion_time, mbps, 0, latency, jitter, buffer_size, NULL);\n}\n\n/* BBR Performance test.\n * Verify that 10 MB can be downloaded in less than 1 second on a 100 mbps link.\n */\n\nint bbr_performance_test(void)\n{\n    uint64_t max_completion_time = 1050000;\n    uint64_t latency = 10000;\n    uint64_t jitter = 3000;\n    uint64_t buffer = 2 * (latency + jitter);\n    uint64_t mbps = 100;\n\n    int ret = performance_test(max_completion_time, mbps, latency, jitter, buffer);\n\n    return ret;\n}\n\n/* BBR Performance test on a slow long link\n * Verify that 10 MB can be downloaded in less than 100 seconds on a 1 mbps link.\n */\n\nint bbr_slow_long_test(void)\n{\n    uint64_t max_completion_time = 81000000;\n    uint64_t latency = 300000;\n    uint64_t jitter = 3000;\n    uint64_t buffer = 2 * (latency + jitter);\n    uint64_t mbps = 1;\n\n    int ret = performance_test(max_completion_time, mbps, latency, jitter, buffer);\n\n    return ret;\n}\n\n/* BBR Performance test on a pathological long link, with 2 seconds RTT\n * Verify that 10 MB can be downloaded in less than 128 seconds on a 1 mbps link.\n */\n\nint bbr_one_second_test(void)\n{\n    uint64_t max_completion_time = 90000000;\n    uint64_t latency = 1000000;\n    uint64_t jitter = 3000;\n    uint64_t buffer = 2 * (latency + jitter);\n    uint64_t mbps = 1;\n\n    int ret = performance_test(max_completion_time, mbps, latency, jitter, buffer);\n\n    return ret;\n}\n\n\n/* AWS like performance test\n * Verify that 10MB can be downloaded very fast on a low latency Gbps link. */\nint gbps_performance_test(void)\n{\n    uint64_t max_completion_time = 250000;\n    uint64_t latency = 4000;\n    uint64_t jitter = 2000;\n    uint64_t buffer = 2 * (latency + jitter);\n    uint64_t mbps = 1000;\n\n    int ret = performance_test(max_completion_time, mbps, latency, jitter, buffer);\n\n    return ret;\n}\n\n\n/* Asymmetric test.\n * Verify that 10MB can be downloaded reasonably fast on a low latency 10Mbps link with 100kbps return path\n * The buffer size is set to a high value, which allows queues to grow and delays to build up. In theory,\n * BBR should minimize these queues, but the test verifies that it actually does.\n */\nint bbr_asym100_test(void)\n{\n    uint64_t max_completion_time = 8500000;\n    uint64_t latency = 1000;\n    uint64_t jitter = 750;\n    uint64_t buffer = 50000;\n    uint64_t mbps = 10;\n    uint64_t kbps = 100;\n\n    int ret = performance_test_one(max_completion_time, mbps, kbps, latency, jitter, buffer, NULL);\n\n    return ret;\n}\n\n/* Asymmetric test, no delay.\n * Variant in which the negotiation of delayed ACK is disabled.\n */\nint bbr_asym100_nodelay_test(void)\n{\n    uint64_t max_completion_time = 8500000;\n    uint64_t latency = 1000;\n    uint64_t jitter = 750;\n    uint64_t buffer = 50000;\n    uint64_t mbps = 10;\n    uint64_t kbps = 100;\n    picoquic_tp_t server_parameters;\n\n    memset(&server_parameters, 0, sizeof(picoquic_tp_t));\n    picoquic_init_transport_parameters(&server_parameters);\n    server_parameters.min_ack_delay = 0;\n\n    int ret = performance_test_one(max_completion_time, mbps, kbps, latency, jitter, buffer,\n        &server_parameters);\n\n    return ret;\n}\n\n/* Asymmetric test.\n * Variant using 400 kbps return path and a 40 Mbps link\n */\nint bbr_asym400_test(void)\n{\n    uint64_t max_completion_time = 2350000;\n    uint64_t latency = 1000;\n    uint64_t jitter = 750;\n    uint64_t buffer = 50000;\n    uint64_t mbps = 40;\n    uint64_t kbps = 400;\n\n    int ret = performance_test_one(max_completion_time, mbps, kbps, latency, jitter, buffer, NULL);\n\n    return ret;\n}\n\n/* Tests of BDP option.\n * = Verify that a download works faster with BDP option enabled\n * = Verify that the BDP option is not validated if the min rtt changes\n * - Verify that the BDP option is not validated if the IP address changes\n * - Verify that the BDP option is not validated if the delay is too long\n */\n\ntypedef enum {\n    bdp_test_option_none = 0,\n    bdp_test_option_basic,\n    bdp_test_option_rtt,\n    bdp_test_option_ip,\n    bdp_test_option_delay,\n    bdp_test_option_reno,\n    bdp_test_option_cubic,\n    bdp_test_option_short,\n    bdp_test_option_short_lo,\n    bdp_test_option_short_hi,\n    bdp_test_option_bbr1\n} bdp_test_option_enum;\n\nint bdp_option_test_one(bdp_test_option_enum bdp_test_option)\n{\n    uint64_t simulated_time = 0;\n    picoquic_test_tls_api_ctx_t* test_ctx = NULL;\n    char const* sni = PICOQUIC_TEST_SNI;\n    char const* alpn = PICOQUIC_TEST_ALPN;\n    uint32_t proposed_version = 0;\n    uint64_t max_completion_time = 6800000;\n    uint64_t latency = 300000ull;\n    uint64_t buffer_size = 2 * latency;\n    picoquic_connection_id_t initial_cid = { {0xbd, 0x80, 0, 0, 0, 0, 0, 0}, 8 };\n    picoquic_congestion_algorithm_t* ccalgo = picoquic_bbr_algorithm;\n    picoquic_tp_t server_parameters;\n    picoquic_tp_t client_parameters;\n\n    int ret = 0;\n\n    /* Initialize an empty ticket store */\n    ret = picoquic_save_tickets(NULL, simulated_time, ticket_file_name);\n\n    for (int i = 0; ret == 0 && i < 2; i++) {\n        /* If testing delay, insert a delay before the second connection attempt */\n        if (i == 1 && bdp_test_option == bdp_test_option_delay) {\n            simulated_time += 48ull * 3600ull * 1000000ull;\n        }\n        initial_cid.id[2] = i;\n        initial_cid.id[3] = (uint8_t)bdp_test_option;\n        /* Set up the context, while setting the ticket store parameter for the client */\n        ret = tls_api_init_ctx_ex(&test_ctx,\n            (i == 0) ? 0 : proposed_version, sni, alpn, &simulated_time, ticket_file_name, NULL, 0, 1, 0, &initial_cid);\n        /* Set the various parameters */\n        if (ret == 0) {\n            test_ctx->c_to_s_link->microsec_latency = latency;\n            test_ctx->s_to_c_link->microsec_latency = latency;\n            test_ctx->c_to_s_link->picosec_per_byte = (1000000ull * 8) / 20;\n            test_ctx->s_to_c_link->picosec_per_byte = (1000000ull * 8) / 20;\n\n            if (bdp_test_option == bdp_test_option_short ||\n                bdp_test_option == bdp_test_option_short_lo ||\n                bdp_test_option == bdp_test_option_short_hi) {\n                /* Test that the BDP option also works well if delay < 250 ms */\n                max_completion_time = 4500000;\n                test_ctx->c_to_s_link->microsec_latency = 100000ull;\n                test_ctx->s_to_c_link->microsec_latency = 100000ull;\n                buffer_size = 2 * test_ctx->c_to_s_link->microsec_latency;\n                if (i == 0) {\n                    if (bdp_test_option == bdp_test_option_short_lo) {\n                        test_ctx->c_to_s_link->picosec_per_byte *= 2;\n                        test_ctx->s_to_c_link->picosec_per_byte *= 2;\n                    }\n                    else if (bdp_test_option == bdp_test_option_short_hi) {\n                        test_ctx->c_to_s_link->picosec_per_byte /= 2;\n                        test_ctx->s_to_c_link->picosec_per_byte /= 2;\n                    }\n                }\n                else if (i == 1 && bdp_test_option == bdp_test_option_short_lo) {\n                    max_completion_time = 4650000;\n                }\n            }\n            else if (i > 0) {\n                switch (bdp_test_option) {\n                case bdp_test_option_none:\n                    break;\n                case bdp_test_option_basic:\n                    max_completion_time = 5900000;\n                    break;\n                case bdp_test_option_rtt:\n                    max_completion_time = 4610000;\n                    test_ctx->c_to_s_link->microsec_latency = 50000ull;\n                    test_ctx->s_to_c_link->microsec_latency = 50000ull;\n                    buffer_size = 2 * test_ctx->c_to_s_link->microsec_latency;\n                    break;\n                case bdp_test_option_ip:\n                    picoquic_set_test_address(&test_ctx->client_addr, 0x08080808, 2345);\n                    max_completion_time = 9000000;\n                    break;\n                case bdp_test_option_delay:\n                    max_completion_time = 8000000;\n                    break;\n                case bdp_test_option_reno:\n                    max_completion_time = 6750000;\n                    break;\n                default:\n                    break;\n                }\n            }\n            if (bdp_test_option == bdp_test_option_reno) {\n                ccalgo = picoquic_newreno_algorithm;\n            }\n            else if (bdp_test_option == bdp_test_option_cubic) {\n                ccalgo = picoquic_cubic_algorithm;\n                max_completion_time = 10000000;\n            }\n            else if (bdp_test_option == bdp_test_option_bbr1) {\n                ccalgo = picoquic_bbr1_algorithm;\n            }\n            picoquic_set_default_congestion_algorithm(test_ctx->qserver, ccalgo);\n            picoquic_set_congestion_algorithm(test_ctx->cnx_client, ccalgo);\n            picoquic_set_default_bdp_frame_option(test_ctx->qclient, 1);\n            picoquic_set_default_bdp_frame_option(test_ctx->qserver, 1);\n            test_ctx->qserver->use_long_log = 1;\n            picoquic_set_qlog(test_ctx->qserver, \".\");\n            /* Set parameters */\n            picoquic_init_transport_parameters(&server_parameters);\n            picoquic_init_transport_parameters(&client_parameters);\n            server_parameters.enable_bdp_frame = 1;\n            client_parameters.enable_bdp_frame = 1;\n            client_parameters.initial_max_stream_data_bidi_remote = 1000000;\n            client_parameters.initial_max_data = 10000000;\n            picoquic_set_transport_parameters(test_ctx->cnx_client, &client_parameters);\n            ret = picoquic_set_default_tp(test_ctx->qserver, &server_parameters);\n\n            if (ret == 0) {\n                ret = tls_api_one_scenario_body(test_ctx, &simulated_time, test_scenario_10mb, sizeof(test_scenario_10mb), 0, 0, 0, buffer_size,\n                    (i == 0) ? 0 : max_completion_time);\n            }\n\n            /* Verify that the BDP option was set and processed */\n            if (ret == 0) {\n                if (i == 1 && test_ctx->cnx_client->nb_zero_rtt_acked == 0 && bdp_test_option != bdp_test_option_delay) {\n                    DBG_PRINTF(\"BDP RTT test (bdp test: %d), cnx %d, no zero RTT data acked.\\n\",\n                        bdp_test_option, i);\n                    ret = -1;\n                }\n                if (!test_ctx->cnx_client->send_receive_bdp_frame) {\n                    DBG_PRINTF(\"BDP RTT test (bdp test: %d), cnx %d, bdp option not negotiated on client.\\n\",\n                        bdp_test_option, i);\n                    ret = -1;\n                }\n                if (!test_ctx->cnx_server->send_receive_bdp_frame) {\n                    DBG_PRINTF(\"BDP RTT test (bdp test: %d), cnx %d, bdp option not negotiated on server.\\n\",\n                        bdp_test_option, i);\n                    ret = -1;\n                }\n                if (ret == 0 && i == 1) {\n                    if (test_ctx->cnx_server->nb_retransmission_total * 10 >\n                        test_ctx->cnx_server->nb_packets_sent &&\n                        bdp_test_option != bdp_test_option_cubic &&\n                        bdp_test_option != bdp_test_option_delay &&\n                        bdp_test_option != bdp_test_option_ip) {\n                        DBG_PRINTF(\"BDP RTT test (bdp test: %d), cnx %d, too many losses, %\"PRIu64\"/%\"PRIu64\".\\n\",\n                            bdp_test_option, i, test_ctx->cnx_server->nb_retransmission_total,\n                            test_ctx->cnx_server->nb_packets_sent);\n                        ret = -1;\n\n                    }\n                    /* Verify bdp test option was executed */\n                    if (!test_ctx->cnx_client->path[0]->is_bdp_sent) {\n                        DBG_PRINTF(\"BDP RTT test (bdp test: %d), cnx %d, bdp frame not sent by client.\\n\",\n                            bdp_test_option, i);\n                        ret = -1;\n                    }\n                    else if (bdp_test_option == bdp_test_option_basic ||\n                        bdp_test_option == bdp_test_option_reno ||\n                        bdp_test_option == bdp_test_option_short ||\n                        bdp_test_option == bdp_test_option_short_hi ||\n                        bdp_test_option == bdp_test_option_short_lo ||\n                        bdp_test_option == bdp_test_option_cubic ||\n                        bdp_test_option == bdp_test_option_bbr1) {\n                        if (!test_ctx->cnx_server->cwin_notified_from_seed) {\n                            DBG_PRINTF(\"BDP RTT test (bdp test: %d), cnx %d, cwin not seed on server.\\n\",\n                                bdp_test_option, i);\n                            ret = -1;\n                        }\n                    }\n                    else if (test_ctx->cnx_server->cwin_notified_from_seed) {\n                        DBG_PRINTF(\"BDP RTT test (bdp test: %d), cnx %d, unexpected cwin seed on server.\\n\",\n                            bdp_test_option, i);\n                        ret = -1;\n                    }\n                }\n            }\n\n            /* Save the session tickets */\n            if (ret == 0) {\n                if (test_ctx->qclient->p_first_ticket == NULL) {\n                    DBG_PRINTF(\"BDP RTT test (bdp option: %d), cnx %d, no ticket received.\\n\",\n                        bdp_test_option, i);\n                    ret = -1;\n                }\n                else {\n                    ret = picoquic_save_tickets(test_ctx->qclient->p_first_ticket, simulated_time, ticket_file_name);\n                    if (ret != 0) {\n                        DBG_PRINTF(\"Zero RTT test (bdp test option: %d), cnx %d, ticket save error (0x%x).\\n\",\n                            bdp_test_option, i, ret);\n                    }\n                }\n            }\n\n            /* Free the resource, which will close the log file. */\n            if (test_ctx != NULL) {\n                tls_api_delete_ctx(test_ctx);\n                test_ctx = NULL;\n            }\n        }\n    }\n\n    return ret;\n}\n\nint bdp_basic_test(void)\n{\n    return bdp_option_test_one(bdp_test_option_basic);\n}\n\nint bdp_rtt_test(void)\n{\n    /* TODO: this test succeeds for the wrong reason.\n    * The goal of the test is to verify that the BDP is NOT set\n    * if the RTT on the second connection does not match the RTT\n    * on the first one. The test does that, but only because the\n    * second connection's RTT is lower than BBRLongRttThreshold,\n    * thus uses regular BBR startup, in which the BDP option is\n    * not implemented.\n     */\n    return bdp_option_test_one(bdp_test_option_rtt);\n}\n\nint bdp_ip_test(void)\n{\n    return bdp_option_test_one(bdp_test_option_ip);\n}\n\nint bdp_delay_test(void)\n{\n    return bdp_option_test_one(bdp_test_option_delay);\n}\n\nint bdp_reno_test(void)\n{\n    return bdp_option_test_one(bdp_test_option_reno);\n}\n\nint bdp_short_test(void)\n{\n    return bdp_option_test_one(bdp_test_option_short);\n}\n\nint bdp_short_hi_test(void)\n{\n    return bdp_option_test_one(bdp_test_option_short_hi);\n}\n\nint bdp_short_lo_test(void)\n{\n    return bdp_option_test_one(bdp_test_option_short_lo);\n}\n\n#if defined(_WINDOWS) && !defined(_WINDOWS64)\nint bdp_cubic_test(void)\n{\n    /* We do not run this test in Win32 builds. */\n    return 0;\n}\n#else\nint bdp_cubic_test(void)\n{\n    return bdp_option_test_one(bdp_test_option_cubic);\n}\n#endif\n\nint bdp_bbr1_test(void)\n{\n    return bdp_option_test_one(bdp_test_option_bbr1);\n}\n\n/*\n * The \"blackhole\" test simulates a link breakage of 2 seconds, during which all packets\n * are lost. The connection is expected to survive the blackhole, and then recover.\n*/\n\nstatic int blackhole_test_one(picoquic_congestion_algorithm_t* ccalgo, uint64_t max_completion_time, uint64_t jitter)\n{\n    uint64_t simulated_time = 0;\n    uint64_t latency = 15000;\n    uint64_t picoseq_per_byte_10 = (1000000ull * 8) / 10;\n    picoquic_test_tls_api_ctx_t* test_ctx = NULL;\n    picoquic_connection_id_t initial_cid = { {0xb1, 0xac, 2, 3, 4, 5, 6, 7}, 8 };\n    int ret = 0;\n\n    initial_cid.id[2] = ccalgo->congestion_algorithm_number;\n\n    ret = tls_api_init_ctx_ex(&test_ctx, PICOQUIC_INTERNAL_TEST_VERSION_1, PICOQUIC_TEST_SNI, PICOQUIC_TEST_ALPN, &simulated_time, NULL, NULL, 0, 1, 0, &initial_cid);\n\n    if (ret == 0 && test_ctx == NULL) {\n        ret = -1;\n    }\n\n    /* Simulate 10 ms link, 15ms latency, 2 seconds blackhole */\n    if (ret == 0) {\n        picoquic_set_default_congestion_algorithm(test_ctx->qserver, ccalgo);\n        picoquic_set_congestion_algorithm(test_ctx->cnx_client, ccalgo);\n\n        test_ctx->c_to_s_link->jitter = jitter;\n        test_ctx->c_to_s_link->microsec_latency = latency;\n        test_ctx->c_to_s_link->picosec_per_byte = picoseq_per_byte_10;\n        test_ctx->s_to_c_link->microsec_latency = latency;\n        test_ctx->s_to_c_link->picosec_per_byte = picoseq_per_byte_10;\n        test_ctx->s_to_c_link->jitter = jitter;\n        test_ctx->blackhole_end = 7000000;\n        test_ctx->blackhole_start = 5000000;\n\n\n        picoquic_set_qlog(test_ctx->qserver, \".\");\n\n        if (ret == 0) {\n            ret = tls_api_one_scenario_body(test_ctx, &simulated_time, test_scenario_10mb, sizeof(test_scenario_10mb), 0, 0, 0, 2 * latency, max_completion_time);\n        }\n    }\n\n    if (test_ctx != NULL) {\n        tls_api_delete_ctx(test_ctx);\n        test_ctx = NULL;\n    }\n\n    return ret;\n}\n\nint blackhole_test(void)\n{\n    int ret = blackhole_test_one(picoquic_bbr_algorithm, 15000000, 0);\n\n    return ret;\n}\n\n/*\n* Application limited test.\n* The application is set to limit the max data values to stay lower than a set flow control window.\n* We verify that in these scenario the CWIN does not grow too much above the flow control window.\n*/\n#define APP_LIMIT_TRACE_QLOG \"acc1020304050607.server.qlog\"\n\nint app_limit_cc_test_one(\n    picoquic_congestion_algorithm_t* ccalgo, uint64_t max_completion_time)\n{\n    uint64_t simulated_time = 0;\n    uint64_t latency = 300000;\n    uint64_t picoseq_per_byte_1 = (1000000ull * 8) / 1;\n    picoquic_test_tls_api_ctx_t* test_ctx = NULL;\n    picoquic_tp_t client_parameters;\n    uint64_t cwin_limit = 120000;\n    picoquic_connection_id_t initial_cid = { {0xac, 0xc1, 2, 3, 4, 5, 6, 7}, 8 };\n    int ret = 0;\n\n    (void)picoquic_file_delete(APP_LIMIT_TRACE_QLOG, NULL);\n\n    memset(&client_parameters, 0, sizeof(picoquic_tp_t));\n    picoquic_init_transport_parameters(&client_parameters);\n    client_parameters.initial_max_data = 40000;\n\n    ret = tls_api_one_scenario_init_ex(&test_ctx, &simulated_time, PICOQUIC_INTERNAL_TEST_VERSION_1, &client_parameters,\n        NULL, &initial_cid);\n\n    if (ret == 0 && test_ctx == NULL) {\n        ret = -1;\n    }\n\n    if (ret == 0) {\n\n        picoquic_set_default_congestion_algorithm(test_ctx->qserver, ccalgo);\n        picoquic_set_congestion_algorithm(test_ctx->cnx_client, ccalgo);\n        picoquic_set_qlog(test_ctx->qserver, \".\");\n        test_ctx->qserver->use_long_log = 1;\n        picoquic_set_max_data_control(test_ctx->qclient, client_parameters.initial_max_data);\n\n        test_ctx->c_to_s_link->jitter = 0;\n        test_ctx->c_to_s_link->microsec_latency = latency;\n        test_ctx->c_to_s_link->picosec_per_byte = picoseq_per_byte_1;\n        test_ctx->s_to_c_link->microsec_latency = latency;\n        test_ctx->s_to_c_link->picosec_per_byte = picoseq_per_byte_1;\n        test_ctx->s_to_c_link->jitter = 0;\n\n        if (ret == 0) {\n            ret = tls_api_one_scenario_body(test_ctx, &simulated_time,\n                test_scenario_very_long, sizeof(test_scenario_very_long), 0, 0, 0, 2 * latency, max_completion_time);\n        }\n    }\n\n    /* Free the resource, which will close the log file.\n     */\n\n    if (test_ctx != NULL) {\n        tls_api_delete_ctx(test_ctx);\n        test_ctx = NULL;\n    }\n\n\n    /* Get the max bytes in flight from QLOG file, and check it is under the limit */\n    if (ret == 0) {\n        uint64_t bytes_in_flight_max;\n        ret = picoquic_check_bytes_in_flight(APP_LIMIT_TRACE_QLOG, &bytes_in_flight_max);\n        if (ret == 0 && bytes_in_flight_max > cwin_limit) {\n            DBG_PRINTF(\"MAX In Flight = %\" PRIu64 \", larger than %\" PRIu64, bytes_in_flight_max, cwin_limit);\n            ret = -1;\n        }\n    }\n\n    return ret;\n}\n\nint app_limit_cc_test(void)\n{\n    picoquic_congestion_algorithm_t* ccalgos[] = {\n        picoquic_newreno_algorithm,\n        picoquic_cubic_algorithm,\n        picoquic_dcubic_algorithm,\n        picoquic_bbr_algorithm,\n        picoquic_fastcc_algorithm,\n        picoquic_bbr1_algorithm\n    };\n    uint64_t max_completion_times[] = {\n        22000000,\n        23500000,\n        22000000,\n        21000000,\n        25000000,\n        25000000\n    };\n    int ret = 0;\n\n    for (size_t i = 0; i < sizeof(ccalgos) / sizeof(picoquic_congestion_algorithm_t*); i++) {\n        ret = app_limit_cc_test_one(ccalgos[i], max_completion_times[i]);\n        if (ret != 0) {\n            DBG_PRINTF(\"Appplication limited congestion test fails for <%s>\", ccalgos[i]->congestion_algorithm_id);\n            break;\n        }\n    }\n\n    return ret;\n}\n\n/* Test the effectiveness of the CWIN MAX option\n */\n\n#define CWIN_MAX_TRACE_QLOG \"c9149a0102030405.server.qlog\"\n\nint picoquic_check_bytes_in_flight(char const * qlog_file, uint64_t* max_bytes_in_flight)\n{\n    int ret = 0;\n    FILE* F = picoquic_file_open(qlog_file, \"r\");\n\n    if (F == NULL) {\n        DBG_PRINTF(\"Cannot open <%s>\", qlog_file);\n        ret = -1;\n    }\n    else {\n        *max_bytes_in_flight = 0;\n        while (ret == 0 && F != NULL) {\n            char buffer[512];\n            int c_index = 0;\n            if (fgets(buffer, 512, F) == NULL) {\n                break;\n            }\n            /* Look for bytes_in_flight property */\n            while (buffer[c_index] != 0 && (\n                buffer[c_index] != '\\\"' ||\n                strcmp(\"\\\"bytes_in_flight\\\":\", &buffer[c_index]) != 0)) {\n                c_index++;\n            }\n            if (buffer[c_index] != 0) {\n                uint64_t bytes_in_flight = 0;\n                while (buffer[c_index] != 0 && buffer[c_index] != ':') {\n                    c_index++;\n                }\n                while (buffer[c_index] != 0 && (buffer[c_index] < '0' || buffer[c_index] > '9')) {\n                    c_index++;\n                }\n                while (buffer[c_index] >= '0' && buffer[c_index] <= '9') {\n                    bytes_in_flight *= 10;\n                    bytes_in_flight += (uint64_t)buffer[c_index] - '0';\n                    c_index++;\n                }\n                if (bytes_in_flight > *max_bytes_in_flight) {\n                    *max_bytes_in_flight = bytes_in_flight;\n                }\n            }\n        }\n        picoquic_file_close(F);\n    }\n    return ret;\n}\n\nint cwin_max_test_one(\n    picoquic_congestion_algorithm_t* ccalgo, uint64_t cwin_limit, uint64_t max_completion_time)\n{\n    uint64_t simulated_time = 0;\n    uint64_t latency = 300000;\n    uint64_t picoseq_per_byte_1 = (1000000ull * 8) / 100;\n    picoquic_test_tls_api_ctx_t* test_ctx = NULL;\n    picoquic_tp_t client_parameters;\n    picoquic_connection_id_t initial_cid = { {0xc9, 0x14, 0x9a, 1, 2, 3, 4, 5}, 8 };\n    int ret = 0;\n\n    (void)picoquic_file_delete(CWIN_MAX_TRACE_QLOG, NULL);\n\n    memset(&client_parameters, 0, sizeof(picoquic_tp_t));\n    picoquic_init_transport_parameters(&client_parameters);\n\n    ret = tls_api_one_scenario_init_ex(&test_ctx, &simulated_time, PICOQUIC_INTERNAL_TEST_VERSION_1, &client_parameters,\n        NULL, &initial_cid);\n\n    if (ret == 0 && test_ctx == NULL) {\n        ret = -1;\n    }\n\n    if (ret == 0) {\n        picoquic_set_default_congestion_algorithm(test_ctx->qserver, ccalgo);\n        picoquic_set_congestion_algorithm(test_ctx->cnx_client, ccalgo);\n        picoquic_set_cwin_max(test_ctx->qserver, 0x10000);\n        picoquic_set_qlog(test_ctx->qserver, \".\");\n        test_ctx->qserver->use_long_log = 1;\n        picoquic_set_max_data_control(test_ctx->qclient, client_parameters.initial_max_data);\n\n        test_ctx->c_to_s_link->jitter = 0;\n        test_ctx->c_to_s_link->microsec_latency = latency;\n        test_ctx->c_to_s_link->picosec_per_byte = picoseq_per_byte_1;\n        test_ctx->s_to_c_link->microsec_latency = latency;\n        test_ctx->s_to_c_link->picosec_per_byte = picoseq_per_byte_1;\n        test_ctx->s_to_c_link->jitter = 0;\n\n        if (ret == 0) {\n            ret = tls_api_one_scenario_body(test_ctx, &simulated_time,\n                test_scenario_very_long, sizeof(test_scenario_very_long), 0, 0, 0, 2 * latency, max_completion_time);\n        }\n    }\n\n    /* Free the resource, which will close the log file.\n    */\n\n    if (test_ctx != NULL) {\n        tls_api_delete_ctx(test_ctx);\n        test_ctx = NULL;\n    }\n\n    /* Get the max bytes in flight from QLOG file, and check it is under the limit */\n    if (ret == 0) {\n        uint64_t bytes_in_flight_max;\n        ret = picoquic_check_bytes_in_flight(CWIN_MAX_TRACE_QLOG, &bytes_in_flight_max);\n        if (ret == 0 && bytes_in_flight_max > cwin_limit) {\n            DBG_PRINTF(\"MAX In Flight = %\" PRIu64 \", larger than %\" PRIu64, bytes_in_flight_max, cwin_limit);\n            ret = -1;\n        }\n    }\n\n    return ret;\n}\n\nint cwin_max_test(void)\n{\n    picoquic_congestion_algorithm_t* ccalgos[] = {\n        picoquic_newreno_algorithm,\n        picoquic_cubic_algorithm,\n        picoquic_dcubic_algorithm,\n        picoquic_bbr_algorithm,\n        picoquic_fastcc_algorithm,\n        picoquic_bbr1_algorithm\n    };\n    uint64_t max_completion_times[] = {\n        11000000,\n        11000000,\n        11000000,\n        11000000,\n        12100000,\n        11000000\n    };\n    int ret = 0;\n\n    for (size_t i = 0; i < sizeof(ccalgos) / sizeof(picoquic_congestion_algorithm_t*); i++) {\n        ret = cwin_max_test_one(ccalgos[i], 68000, max_completion_times[i]);\n        if (ret != 0) {\n            DBG_PRINTF(\"CWIN Max test fails for <%s>\", ccalgos[i]->congestion_algorithm_id);\n            break;\n        }\n    }\n\n    return ret;\n}\n","numLines":1046,"startLine":1,"totalLines":1046}}}
