\t        DBG_PRINTF(\"%s\", \"first byteread_skip_vint failed on 9 byte buffer\\n\");\n517\t        ret = -1;\n518\t    }\n519\t\n520\t    if (byteread_skip_vint(s9) == 0) {\n521\t        DBG_PRINTF(\"%s\", \"second byteread_skip_vint didn't fail on 9 byte buffer\\n\");\n522\t        ret = -1;\n523\t    }\n524\t\n525\t    if (byteread_skip_vint(s9) == 0) {\n526\t        DBG_PRINTF(\"%s\", \"third byteread_skip_vint didn't fail on 9 byte buffer\\n\");\n527\t        ret = -1;\n528\t    }\n529\t\n530\t    bytestream_reset(s9);\n531\t\n532\t    if (byteread_buffer(s9, buf, sizeof(buf)) != 0) {\n533\t        DBG_PRINTF(\"%s\", \"byteread_buffer of 8 bytes failed on 9 byte buffer\\n\");\n534\t        ret = -1;\n535\t    }\n536\t\n537\t    if (byteread_buffer(s9, buf, sizeof(buf)) == 0) {\n538\t        DBG_PRINTF(\"%s\", \"byteread_buffer of 8 bytes didn't fail on 9 byte buffer\\n\");\n539\t        ret = -1;\n540\t    }\n541\t\n542\t    /* Also expect that no other, smaller read call succeeds */\n543\t    if (byteread_int8(s9, &i8) == 0) {\n544\t        DBG_PRINTF(\"%s\", \"byteread_int8 didn't fail after read failure\\n\");\n545\t        ret = -1;\n546\t    }\n547\t\n548\t    bytestream_reset(s9);\n549\t\n550\t    if (byteskip_cid(s9) == 0) {\n551\t        DBG_PRINTF(\"%s\", \"byteskip_cid didn't fail\\n\");\n552\t        ret = -1;\n553\t    }\n554\t\n555\t    bytestream_reset(s9);\n556\t\n557\t    if (byteread_cid(s9, &cid) == 0) {\n558\t        DBG_PRINTF(\"%s\", \"byteread_cid didn't fail\\n\");\n559\t        ret = -1;\n560\t    }\n561\t\n562\t    const uint8_t long_cid[PICOQUIC_CONNECTION_ID_MAX_SIZE + 2] = { PICOQUIC_CONNECTION_ID_MAX_SIZE + 1 };\n563\t    bytestream cid_stream;\n564\t    bytestream * scid = bytestream_ref_init(&cid_stream, long_cid, sizeof(long_cid));\n565\t\n566\t    if (byteread_cid(scid, &cid) == 0) {\n567\t        DBG_PRINTF(\"%s\", \"byteread_cid() of oversized cid didn't fail\\n\");\n568\t        ret = -1;\n569\t    }\n570\t\n571\t    bytestream_reset(s9);\n572\t\n573\t    if (byteskip_cstr(s9) == 0) {\n574\t        DBG_PRINTF(\"%s\", \"byteskip_cstr() over byte stream limit didn't fail\\n\");\n575\t        ret = -1;\n576\t    }\n577\t\n578\t    bytestream_reset(s9);\n579\t\n580\t    if (byteread_cstr(s9, str, 0x100) == 0) {\n581\t        DBG_PRINTF(\"%s\", \"byteread_cstr(len=0x100) over byte stream limit didn't fail\\n\");\n582\t        ret = -1;\n583\t    }\n584\t\n585\t    const uint8_t short_str[] = { 0x02, 0x00, 0x00 };\n586\t    bytestream cstr_stream;\n587\t    bytestream * sstr = bytestream_ref_init(&cstr_stream, short_str, sizeof(short_str));\n588\t\n589\t    if (byteread_cstr(sstr, str, 1) == 0) {\n590\t        DBG_PRINTF(\"%s\", \"byteread_cstr(len=1) of 2 character string didn't fail\\n\");\n591\t        ret = -1;\n592\t    }\n593\t\n594\t    const uint8_t empty_str[] = { 0x00 };\n595\t    bytestream * s0 = bytestream_ref_init(&stream, empty_str, sizeof(empty_str));\n596\t\n597\t    bytestream_reset(s0);\n598\t\n599\t    if (byteread_cstr(s0, str, 0) == 0) {\n600\t        DBG_PRINTF(\"%s\", \"byteread_cstr(len=0) didn't fail\\n\");\n601\t        ret = -1;\n602\t    }\n603\t\n604\t    bytestream_reset(s0);\n605\t\n606\t    if (byteread_cstr(s0, str, 1) != 0) {\n607\t        DBG_PRINTF(\"%s\", \"byteread_cstr(len=1) failed\\n\");\n608\t        ret = -1;\n609\t    }\n610\t\n611\t    free(heap);\n612\t    return ret;\n613\t}\n614\t\n615\ttypedef struct st_picoquic_val_len {\n616\t    uint64_t val;\n617\t    size_t len;\n618\t} picoquic_val_len;\n619\t\n620\tint bytestream_test_vint(void)\n621\t{\n622\t    int ret = 0;\n623\t\n624\t    static const picoquic_val_len values[] = {\n625\t        { 0, 1 },\n626\t        { 10, 1 },\n627\t        { 100, 2 },\n628\t        { 1000, 2 },\n629\t        { 10000, 2 },\n630\t        { 100000, 4 },\n631\t        { 10000000, 4 },\n632\t        { 1000000000, 4 },\n633\t        { 100000000000, 8 },\n634\t        { 1000000000000000, 8 },\n635\t        { 0x3f, 1 },