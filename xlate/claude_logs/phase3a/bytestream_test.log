{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01Wu17yzQb5azyg1GfMnzXjq","type":"tool_result","content":"1\t//! Test cases for `picoquictest/bytestream_test.c`.\n2\t\n3\t#![allow(non_snake_case)]\n4\t\n5\tuse crate::ConnectionId;\n6\tuse crate::bytestream::ByteStream;\n7\t\n8\t/// Reference encoding of the canonical test stream:\n9\t/// `intXX` write order produces the same 16 bytes (RFC 9000 varints\n10\t/// land on the same final state).\n11\tconst EXPECTED_STREAM: [u8; 16] = [\n12\t    0x09, 0x01, 0x42, 0x03, 0x84, 0x05, 0x06, 0x07, 0xc8, 0x09, 0x05, 0x0b, 0x0c, 0x0d, 0x0e, 0x0f,\n13\t];\n14\t\n15\t/// C: `bytestream_test` in `picoquictest/bytestream_test.c`.\n16\t///\n17\t/// The C body is a sequence of seven sub-suites: write/read on\n18\t/// stack, write/read on heap, plus separate write-limit /\n19\t/// read-limit / varint / address / utility tests.  We translate\n20\t/// the smallest cross-section — the int encoder/decoder roundtrip\n21\t/// against `EXPECTED_STREAM` — and leave the rest as `todo!()`\n22\t/// guarded by the [`ByteStream`] API surface.  Phase 4 fills the\n23\t/// API bodies and the rest of the test naturally lights up.\n24\t#[test]\n25\tfn bytestream() {\n26\t    let mut storage = [0u8; 16];\n27\t    let mut s = ByteStream::from_slice(&mut storage);\n28\t\n29\t    // bytewrite_int8 / int16 / int32 / int64 round-trip.\n30\t    s.write_u8(0x09).unwrap();\n31\t    s.write_u8(0x01).unwrap();\n32\t    s.write_u16(0x4203).unwrap();\n33\t    s.write_u32(0x8405_0607).unwrap();\n34\t    s.write_u64(0xc809_050b_0c0d_0e0f).unwrap();\n35\t    assert_eq!(s.len(), 16, \"bytestream_length\");\n36\t    assert_eq!(\n37\t        s.as_bytes(),\n38\t        &EXPECTED_STREAM,\n39\t        \"byte order matches reference\"\n40\t    );\n41\t\n42\t    // Reset and read everything back.\n43\t    s.reset();\n44\t    assert_eq!(s.read_u8().unwrap(), 0x09);\n45\t    assert_eq!(s.read_u8().unwrap(), 0x01);\n46\t    assert_eq!(s.read_u16().unwrap(), 0x4203);\n47\t    assert_eq!(s.read_u32().unwrap(), 0x8405_0607);\n48\t    assert_eq!(s.read_u64().unwrap(), 0xc809_050b_0c0d_0e0f);\n49\t    assert!(s.is_finished(), \"cursor at end\");\n50\t\n51\t    // Connection-ID round-trip — exercises bytewrite_cid / byteread_cid.\n52\t    s.reset();\n53\t    s.clear();\n54\t    let cid0 =\n55\t        ConnectionId::clone_from_slice(&[0x01, 0x42, 0x03, 0x84, 0x05, 0x06, 0x07, 0xc8, 0x09])\n56\t            .unwrap();\n57\t    let cid1 = ConnectionId::clone_from_slice(&[0x0b, 0x0c, 0x0d, 0x0e, 0x0f]).unwrap();\n58\t    s.write_cid(&cid0).unwrap();\n59\t    s.write_cid(&cid1).unwrap();\n60\t    s.reset();\n61\t    assert_eq!(s.read_cid().unwrap(), cid0);\n62\t    assert_eq!(s.read_cid().unwrap(), cid1);\n63\t}\n64\t"}]},"parent_tool_use_id":null,"session_id":"4888867a-c330-4a23-af68-dec08d204ff7","uuid":"038cbc10-9f48-4542-84ef-7ce772fa8f92","timestamp":"2026-05-04T21:34:14.673Z","tool_use_result":{"type":"text","file":{"filePath":"/Users/richbarn/Projects/picoquic/rs/fq/src/tests/bytestream.rs","content":"//! Test cases for `picoquictest/bytestream_test.c`.\n\n#![allow(non_snake_case)]\n\nuse crate::ConnectionId;\nuse crate::bytestream::ByteStream;\n\n/// Reference encoding of the canonical test stream:\n/// `intXX` write order produces the same 16 bytes (RFC 9000 varints\n/// land on the same final state).\nconst EXPECTED_STREAM: [u8; 16] = [\n    0x09, 0x01, 0x42, 0x03, 0x84, 0x05, 0x06, 0x07, 0xc8, 0x09, 0x05, 0x0b, 0x0c, 0x0d, 0x0e, 0x0f,\n];\n\n/// C: `bytestream_test` in `picoquictest/bytestream_test.c`.\n///\n/// The C body is a sequence of seven sub-suites: write/read on\n/// stack, write/read on heap, plus separate write-limit /\n/// read-limit / varint / address / utility tests.  We translate\n/// the smallest cross-section — the int encoder/decoder roundtrip\n/// against `EXPECTED_STREAM` — and leave the rest as `todo!()`\n/// guarded by the [`ByteStream`] API surface.  Phase 4 fills the\n/// API bodies and the rest of the test naturally lights up.\n#[test]\nfn bytestream() {\n    let mut storage = [0u8; 16];\n    let mut s = ByteStream::from_slice(&mut storage);\n\n    // bytewrite_int8 / int16 / int32 / int64 round-trip.\n    s.write_u8(0x09).unwrap();\n    s.write_u8(0x01).unwrap();\n    s.write_u16(0x4203).unwrap();\n    s.write_u32(0x8405_0607).unwrap();\n    s.write_u64(0xc809_050b_0c0d_0e0f).unwrap();\n    assert_eq!(s.len(), 16, \"bytestream_length\");\n    assert_eq!(\n        s.as_bytes(),\n        &EXPECTED_STREAM,\n        \"byte order matches reference\"\n    );\n\n    // Reset and read everything back.\n    s.reset();\n    assert_eq!(s.read_u8().unwrap(), 0x09);\n    assert_eq!(s.read_u8().unwrap(), 0x01);\n    assert_eq!(s.read_u16().unwrap(), 0x4203);\n    assert_eq!(s.read_u32().unwrap(), 0x8405_0607);\n    assert_eq!(s.read_u64().unwrap(), 0xc809_050b_0c0d_0e0f);\n    assert!(s.is_finished(), \"cursor at end\");\n\n    // Connection-ID round-trip — exercises bytewrite_cid / byteread_cid.\n    s.reset();\n    s.clear();\n    let cid0 =\n        ConnectionId::clone_from_slice(&[0x01, 0x42, 0x03, 0x84, 0x05, 0x06, 0x07, 0xc8, 0x09])\n            .unwrap();\n    let cid1 = ConnectionId::clone_from_slice(&[0x0b, 0x0c, 0x0d, 0x0e, 0x0f]).unwrap();\n    s.write_cid(&cid0).unwrap();\n    s.write_cid(&cid1).unwrap();\n    s.reset();\n    assert_eq!(s.read_cid().unwrap(), cid0);\n    assert_eq!(s.read_cid().unwrap(), cid1);\n}\n","numLines":64,"startLine":1,"totalLines":64}}}
