{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01R3DXdLvV2r6LKRBugFvLQ8","type":"tool_result","content":"1\t/*\n2\t* Author: Christian Huitema\n3\t* Copyright (c) 2023, Private Octopus, Inc.\n4\t* All rights reserved.\n5\t*\n6\t* Permission to use, copy, modify, and distribute this software for any\n7\t* purpose with or without fee is hereby granted, provided that the above\n8\t* copyright notice and this permission notice appear in all copies.\n9\t*\n10\t* THIS SOFTWARE IS PROVIDED BY THE COPYRIGHT HOLDERS AND CONTRIBUTORS \"AS IS\" AND\n11\t* ANY EXPRESS OR IMPLIED WARRANTIES, INCLUDING, BUT NOT LIMITED TO, THE IMPLIED\n12\t* WARRANTIES OF MERCHANTABILITY AND FITNESS FOR A PARTICULAR PURPOSE ARE\n13\t* DISCLAIMED. IN NO EVENT SHALL Private Octopus, Inc. BE LIABLE FOR ANY\n14\t* DIRECT, INDIRECT, INCIDENTAL, SPECIAL, EXEMPLARY, OR CONSEQUENTIAL DAMAGES\n15\t* (INCLUDING, BUT NOT LIMITED TO, PROCUREMENT OF SUBSTITUTE GOODS OR SERVICES;\n16\t* LOSS OF USE, DATA, OR PROFITS; OR BUSINESS INTERRUPTION) HOWEVER CAUSED AND\n17\t* ON ANY THEORY OF LIABILITY, WHETHER IN CONTRACT, STRICT LIABILITY, OR TORT\n18\t* (INCLUDING NEGLIGENCE OR OTHERWISE) ARISING IN ANY WAY OUT OF THE USE OF THIS\n19\t* SOFTWARE, EVEN IF ADVISED OF THE POSSIBILITY OF SUCH DAMAGE.\n20\t*/\n21\t\n22\t#include <stdlib.h>\n23\t#include <string.h>\n24\t#include <inttypes.h>\n25\t#include \"picoquic.h\"\n26\t#include \"picoquic_internal.h\"\n27\t#include \"picoquictest_internal.h\"\n28\t#include \"tls_api.h\"\n29\t#include \"autoqlog.h\"\n30\t#include \"logreader.h\"\n31\t#include \"qlog.h\"\n32\t#include \"picoquic_newreno.h\"\n33\t#include \"picoquic_cubic.h\"\n34\t#include \"picoquic_bbr.h\"\n35\t#include \"picoquic_bbr1.h\"\n36\t#include \"picoquic_fastcc.h\"\n37\t\n38\t/* Add a series of tests to study the behavior of rate limited\n39\t* clients, such as those sending at a sustained rate lower\n40\t* than the link capacity. We want to test several bug reports\n41\t* showing the following possible issues:\n42\t* \n43\t* - Initial window growing higher than expected, due to congestion\n44\t*   control never exiting slow start;\n45\t* - Congestion window growing higher than expected, due to increased\n46\t*   window in congestion avoidance phase;\n47\t* - Pacing rate growing higher than the available bandwidth;\n48\t* - Preemptive repeat getting confused when packets contain data from\n49\t*   both finished and unfinished streams.\n50\t* \n51\t* We need to engineer a server that provides two kinds of streams:\n52\t* - a steady \"control\" stream at a specified fixed rate, sending\n53\t*   data frames smaller than the MTU so we will have multiple\n54\t*   streams in a packet. That stream will have higher priority\n55\t*   than the other streams.\n56\t* - in start-up and preemptive tests, a second data stream that\n57\t*   forces the end of slow start and tests preemtive repeat.\n58\t* - in congestion avoidance tests, a third data stream that\n59\t*   tests for over-large congestion windows.\n60\t* \n61\t* The loop will include monitoring of pacing rate, congestion\n62\t* window and rtt. We want to run these tests with a variety of congestion\n63\t* controls. \n64\t*/\n65\t\n66\t#define APP_LIMITED_TEST_ALPN \"app_limited_test\"\n67\t#define APP_LIMITED_ERROR_INTERNAL 1\n68\t\n69\ttypedef struct st_app_limited_test_config_t {\n70\t    uint8_t test_id;\n71\t    picoquic_congestion_algorithm_t* ccalgo;\n72\t    int do_preemptive_repeat;\n73\t    size_t stream_0_packet_size;\n74\t    size_t stream_0_packet_interval;\n75\t    uint64_t data_stream_size;\n76\t    uint64_t time_to_stream[3];\n77\t    uint64_t loss_mask;\n78\t    uint64_t completion_target;\n79\t    uint64_t rtt_max;\n80\t    uint64_t cwin_max;\n81\t    uint64_t data_rate_max;\n82\t    uint64_t nb_losses_max;\n83\t} app_limited_test_config_t;\n84\t\n85\ttypedef struct st_app_limited_stream_ctx_t {\n86\t    uint64_t stream_id; /* ID for the test streams */\n87\t    size_t data_size; /* How much data to send on each stream */\n88\t    size_t octets_sent; /* Octets sent by server on each stream */\n89\t    size_t octets_recv; /* Octets received by slient on each stream */\n90\t    int fin_received;\n91\t    int is_fin_sent;\n92\t    int rank;\n93\t} app_limited_stream_ctx_t;\n94\t\n95\ttypedef struct st_app_limited_cnx_ctx_t {\n96\t    picoquic_cnx_t* cnx;\n97\t    int is_server;\n98\t    app_limited_stream_ctx_t stream_ctx[3];\n99\t    struct st_app_limited_ctx_t* al_ctx;\n100\t} app_limited_cnx_ctx_t;\n101\t\n102\ttypedef struct st_app_limited_ctx_t {\n103\t    uint64_t simulated_time;\n104\t    uint64_t loss_mask;\n105\t    uint64_t stream0_next_time;\n106\t    uint64_t stream0_bytes_sent_this_packet;\n107\t    int nb_client_streams_completed;\n108\t    uint64_t last_interaction_time;\n109\t    uint64_t rtt_max;\n110\t    uint64_t cwin_max;\n111\t    uint64_t data_rate_max;\n112\t    app_limited_cnx_ctx_t client_cnx_ctx;\n113\t    app_limited_cnx_ctx_t server_cnx_ctx;\n114\t    app_limited_test_config_t* config;\n115\t} app_limited_ctx_t;\n116\t\n117\tapp_limited_cnx_ctx_t* app_limited_initialize_cnx_context(app_limited_ctx_t* callback_ctx,  picoquic_cnx_t* cnx, int is_server )\n118\t{\n119\t    app_limited_cnx_ctx_t* cnx_ctx = NULL;\n120\t\n121\t    if (is_server) {\n122\t        cnx_ctx = &callback_ctx->server_cnx_ctx;\n123\t    }\n124\t    else {\n125\t        cnx_ctx = &callback_ctx->client_cnx_ctx;\n126\t    }\n127\t\n128\t    cnx_ctx->cnx = cnx;\n129\t\n130\t    return cnx_ctx;\n131\t}\n132\t\n133\tapp_limited_stream_ctx_t * app_limited_find_or_create_stream(uint64_t stream_id, app_limited_cnx_ctx_t * cnx_ctx)\n134\t{\n135\t    app_limited_stream_ctx_t* stream_ctx = NULL;\n136\t\n137\t    for (int i = 0; i < 3; i++) {\n138\t        if (stream_id == cnx_ctx->stream_ctx[i].stream_id ||\n139\t            cnx_ctx->stream_ctx[i].stream_id == UINT64_MAX) {\n140\t            stream_ctx = &cnx_ctx->stream_ctx[i];\n141\t            stream_ctx->stream_id = stream_id;\n142\t            stream_ctx->rank = i;\n143\t            break;\n144\t        }\n145\t    }\n146\t    return stream_ctx;\n147\t}\n148\t\n149\tint app_limited_receive_stream_data(app_limited_cnx_ctx_t* cnx_ctx,\n150\t    app_limited_stream_ctx_t* stream_ctx, uint8_t* bytes, size_t length, int is_fin)\n151\t{\n152\t    int ret = 0;\n153\t    if (is_fin && stream_ctx->fin_received) {\n154\t        ret = -1;\n155\t    }\n156\t    else {\n157\t        for (size_t i = 0; i < length; i++) {\n158\t            uint8_t b = bytes[i];\n159\t            if (b == (uint8_t)(stream_ctx->octets_recv & 0xff)) {\n160\t                stream_ctx->octets_recv++;\n161\t            }\n162\t            else {\n163\t                ret = -1;\n164\t                break;\n165\t            }\n166\t        }\n167\t        if (stream_ctx->octets_recv > stream_ctx->data_size) {\n168\t            ret = -1;\n169\t        }\n170\t        else if (is_fin) {\n171\t            cnx_ctx->al_ctx->nb_client_streams_completed += 1;\n172\t            stream_ctx->fin_received = 1;\n173\t            if (stream_ctx->octets_recv != stream_ctx->data_size) {\n174\t                ret = -1;\n175\t            }\n176\t        }\n177\t    }\n178\t\n179\t    return ret;\n180\t}\n181\t\n182\tvoid app_limited_prepare_to_send_on_stream(app_limited_cnx_ctx_t* cnx_ctx,\n183\t    app_limited_stream_ctx_t* stream_ctx, uint8_t* context, size_t length, uint64_t simulated_time)\n184\t{\n185\t    uint64_t available = stream_ctx->data_size - stream_ctx->octets_sent;\n186\t    int is_fin = 0;\n187\t    int is_still_active = 1;\n188\t    uint8_t* buffer = NULL;\n189\t\n190\t    /* Compute how much to send */\n191\t    if (stream_ctx->rank == 0) {\n192\t        /* Implement here the rate pacing of stream 0. */\n193\t        if (length > (cnx_ctx->al_ctx->config->stream_0_packet_size - cnx_ctx->al_ctx->stream0_bytes_sent_this_packet)) {\n194\t            /* cannot only send as much as the packet indicates */\n195\t            available = cnx_ctx->al_ctx->config->stream_0_packet_size - cnx_ctx->al_ctx->stream0_bytes_sent_this_packet;\n196\t        } else {\n197\t            available = length;\n198\t        }\n199\t\n200\t        cnx_ctx->al_ctx->stream0_bytes_sent_this_packet += (size_t)available;\n201\t        if (cnx_ctx->al_ctx->stream0_bytes_sent_this_packet >= cnx_ctx->al_ctx->config->stream_0_packet_size){\n202\t            /* the whole packet was scheduled */\n203\t            cnx_ctx->al_ctx->stream0_bytes_sent_this_packet = 0;\n204\t            cnx_ctx->al_ctx->stream0_next_time += cnx_ctx->al_ctx->config->stream_0_packet_interval;\n205\t            if (simulated_time < cnx_ctx->al_ctx->stream0_next_time) {\n206\t                is_still_active = 0;\n207\t            }\n208\t        }\n209\t    }\n210\t    else if (available > length) {\n211\t        available = length;\n212\t    }\n213\t\n214\t    if (available + stream_ctx->octets_sent >= stream_ctx->data_size) {\n215\t        is_fin = 1;\n216\t    }\n217\t\n218\t    buffer = (uint8_t*)picoquic_provide_stream_data_buffer(context, (size_t)available, is_fin, is_still_active);\n219\t    if (buffer != NULL) {\n220\t        stream_ctx->is_fin_sent = is_fin;\n221\t        /* fill the bytes */\n222\t        for (size_t i = 0; i < (size_t)available; i++) {\n223\t            uint8_t b = (uint8_t)(stream_ctx->octets_sent & 0xff);\n224\t            buffer[i] = b;\n225\t            stream_ctx->octets_sent++;\n226\t        }\n227\t    }\n228\t}\n229\t\n230\t /* Callback from Quic\n231\t */\n232\tint app_limited_callback(picoquic_cnx_t* cnx,\n233\t    uint64_t stream_id, uint8_t* bytes, size_t length,\n234\t    picoquic_call_back_event_t fin_or_event, void* callback_ctx, void* v_stream_ctx)\n235\t{\n236\t\n237\t    int ret = 0;\n238\t    app_limited_cnx_ctx_t* cnx_ctx = (app_limited_cnx_ctx_t*)callback_ctx;\n239\t    app_limited_stream_ctx_t* stream_ctx = (app_limited_stream_ctx_t*)v_stream_ctx;\n240\t\n241\t    /* If this is the first reference to the connection, the application context is set\n242\t    * to the default value defined for the server. This default value contains the pointer\n243\t    * to the global context in which streams and roles are defined.\n244\t    */\n245\t    if (callback_ctx == NULL || callback_ctx == picoquic_get_default_callback_context(picoquic_get_quic_ctx(cnx))) {\n246\t        if (fin_or_event == picoquic_callback_close) {\n247\t            picoquic_set_callback(cnx, NULL, NULL);\n248\t            return 0;\n249\t        }\n250\t        else {\n251\t            cnx_ctx = app_limited_initialize_cnx_context((app_limited_ctx_t*)callback_ctx, cnx, 1);\n252\t            if (cnx_ctx == NULL) {\n253\t                /* cannot handle the connection */\n254\t                picoquic_close(cnx, PICOQUIC_ERROR_MEMORY);\n255\t                return -1;\n256\t            }\n257\t            else {\n258\t                cnx_ctx->is_server = 1;\n259\t                picoquic_set_callback(cnx, app_limited_callback, cnx_ctx);\n260\t            }\n261\t        }\n262\t    }\n263\t\n264\t    if (ret == 0) {\n265\t        switch (fin_or_event) {\n266\t        case picoquic_callback_stream_data:\n267\t        case picoquic_callback_stream_fin:\n268\t            /* Data arrival on stream #x, maybe with fin mark */\n269\t            if (stream_ctx == NULL) {\n270\t                /* Retrieve, or create and initialize stream context */\n271\t                stream_ctx = app_limited_find_or_create_stream(stream_id, cnx_ctx);\n272\t            }\n273\t\n274\t            if (stream_ctx == NULL) {\n275\t                /* Internal error */\n276\t                (void)picoquic_reset_stream(cnx, stream_id, APP_LIMITED_ERROR_INTERNAL);\n277\t                ret = -1;\n278\t            }\n279\t            else if (cnx_ctx->is_server) {\n280\t                ret = -1;\n281\t            } else {\n282\t                ret = app_limited_receive_stream_data(cnx_ctx, stream_ctx, bytes, length, (fin_or_event == picoquic_callback_stream_fin));\n283\t            }\n284\t            break;\n285\t        case picoquic_callback_prepare_to_send:\n286\t            /* Active sending API */\n287\t            if (stream_ctx == NULL) {\n288\t                /* This should never happen */\n289\t                picoquic_log_app_message(cnx, \"app_limited callback returns %d, event %d\", ret, fin_or_event);\n290\t                DBG_PRINTF(\"Prepare to send on NULL context, steam: %\" PRIu64, stream_id);\n291\t                ret = -1;\n292\t            }\n293\t            else {\n294\t                app_limited_prepare_to_send_on_stream(cnx_ctx, stream_ctx, bytes, length, cnx_ctx->al_ctx->simulated_time);\n295\t            }\n296\t            break;\n297\t        case picoquic_callback_datagram:\n298\t        case picoquic_callback_prepare_datagram:\n299\t            /* not expected */\n300\t            ret = -1;\n301\t            break;\n302\t        case picoquic_callback_stream_reset: /* Client reset stream #x */\n303\t        case picoquic_callback_stop_sending: /* Client asks server to reset stream #x */\n304\t                                             /* TODO: react to abandon stream, etc. */\n305\t            break;\n306\t        case picoquic_callback_stateless_reset: /* Received an error message */\n307\t        case picoquic_callback_close: /* Received connection close */\n308\t        case picoquic_callback_application_close: /* Received application close */\n309\t                                                  /* Remove the connection from the context, and then delete it */\n310\t            cnx_ctx->cnx = NULL;\n311\t            picoquic_set_callback(cnx, NULL, NULL);\n312\t            break;\n313\t        case picoquic_callback_version_negotiation:\n314\t            /* The server should never receive a version negotiation response */\n315\t            break;\n316\t        case picoquic_callback_stream_gap:\n317\t            /* This callback is never used. */\n318\t            break;\n319\t        case picoquic_callback_almost_ready:\n320\t        case picoquic_callback_ready:\n321\t            /* should mark the first stream as ready, create it if necessary */\n322\t            break;\n323\t        case picoquic_callback_datagram_acked:\n324\t            /* Ack for packet carrying datagram-object received from peer */\n325\t        case picoquic_callback_datagram_lost:\n326\t            /* Packet carrying datagram-object probably lost */\n327\t        case picoquic_callback_datagram_spurious:\n328\t            /* Packet carrying datagram-object was not really lost */\n329\t            break;\n330\t        case picoquic_callback_pacing_changed:\n331\t            /* Notification of rate change from congestion controller */\n332\t            break;\n333\t        default:\n334\t            /* unexpected */\n335\t            break;\n336\t        }\n337\t    }\n338\t\n339\t    if (ret != 0) {\n340\t        picoquic_log_app_message(cnx, \"app_limited callback returns %d, event %d\", ret, fin_or_event);\n341\t        DBG_PRINTF(\"app_limited callback returns %d, event %d\", ret, fin_or_event);\n342\t    }\n343\t\n344\t    return ret;\n345\t}\n346\t\n347\tvoid app_limited_initialize_context(app_limited_ctx_t* al_ctx, app_limited_test_config_t* config)\n348\t{\n349\t    memset(al_ctx, 0, sizeof(app_limited_ctx_t));\n350\t    for (int i = 0; i < 3; i++) {\n351\t        uint64_t data_size = (i != 0) ? config->data_stream_size : ((config->time_to_stream[2] + 1000000) * config->stream_0_packet_size) / config->stream_0_packet_interval;\n352\t        al_ctx->client_cnx_ctx.stream_ctx[i].stream_id = UINT64_MAX;\n353\t        al_ctx->client_cnx_ctx.stream_ctx[i].data_size = (size_t)data_size;\n354\t        al_ctx->client_cnx_ctx.stream_ctx[i].rank = i;\n355\t        al_ctx->server_cnx_ctx.stream_ctx[i].stream_id = UINT64_MAX;\n356\t        al_ctx->server_cnx_ctx.stream_ctx[i].data_size = (size_t)data_size;\n357\t        al_ctx->server_cnx_ctx.stream_ctx[i].rank = i;\n358\t    }\n359\t    al_ctx->client_cnx_ctx.al_ctx = al_ctx;\n360\t    al_ctx->server_cnx_ctx.al_ctx = al_ctx;\n361\t    al_ctx->loss_mask = config->loss_mask;\n362\t    al_ctx->config = config;\n363\t}\n364\t\n365\t/* app_limited_get_timeout:\n366\t * If time above connection 2, start connection 2\n367\t *     else timeout = connection 2\n368\t * If time above connection 1, start connection 1\n369\t *     else timeout = connection 1\n370\t * If time above next interval,\n371\t *     mark connection 0 active\n372\t *     else timeout = next interval\n373\t * If nothing in particular to do, timeout = 0\n374\t * \n375\t */\n376\tint app_limited_get_timeout(app_limited_ctx_t* al_ctx, uint64_t simulated_time, uint64_t * timeout)\n377\t{\n378\t    int ret = 0;\n379\t    \n380\t    *timeout = 0;\n381\t\n382\t    if (al_ctx->server_cnx_ctx.cnx != NULL) {\n383\t        for (int i = 0; i < 3; i++) {\n384\t            if (al_ctx->server_cnx_ctx.stream_ctx[i].stream_id == UINT64_MAX) {\n385\t                if (simulated_time >= al_ctx->config->time_to_stream[i]) {\n386\t                    uint64_t stream_id = picoquic_get_next_local_stream_id(al_ctx->server_cnx_ctx.cnx, 1);\n387\t                    al_ctx->server_cnx_ctx.stream_ctx[i].stream_id = stream_id;\n388\t                    ret = picoquic_mark_active_stream(al_ctx->server_cnx_ctx.cnx, stream_id, 1,\n389\t                        (void*)&al_ctx->server_cnx_ctx.stream_ctx[i]);\n390\t                    if (i == 0) {\n391\t                        al_ctx->stream0_next_time = simulated_time;\n392\t                    }\n393\t                }\n394\t                else {\n395\t                    *timeout = al_ctx->config->time_to_stream[i];\n396\t                }\n397\t                break;\n398\t            }\n399\t        }\n400\t\n401\t        if (ret == 0) {\n402\t            if (al_ctx->server_cnx_ctx.stream_ctx[0].stream_id != UINT64_MAX) {\n403\t                if (simulated_time < al_ctx->stream0_next_time) {\n404\t                    if (*timeout == 0 || al_ctx->stream0_next_time < *timeout) {\n405\t                        *timeout = al_ctx->stream0_next_time;\n406\t                    }\n407\t                }\n408\t                else if (!al_ctx->server_cnx_ctx.stream_ctx[0].is_fin_sent) {\n409\t                    picoquic_mark_active_stream(al_ctx->server_cnx_ctx.cnx,\n410\t                        al_ctx->server_cnx_ctx.stream_ctx[0].stream_id, 1,\n411\t                        (void*)&al_ctx->server_cnx_ctx.stream_ctx[0]);\n412\t                }\n413\t            }\n414\t        }\n415\t    }\n416\t\n417\t    return ret;\n418\t}\n419\t\n420\tvoid app_limited_monitor(app_limited_ctx_t* al_ctx)\n421\t{\n422\t    if (al_ctx->server_cnx_ctx.cnx != NULL) {\n423\t        picoquic_path_t* path_x = al_ctx->server_cnx_ctx.cnx->path[0];\n424\t\n425\t        if (path_x->rtt_max > al_ctx->rtt_max) {\n426\t            al_ctx->rtt_max = path_x->rtt_max;\n427\t        }\n428\t        if (path_x->cwin > al_ctx->cwin_max) {\n429\t            al_ctx->cwin_max = path_x->cwin;\n430\t        }\n431\t        if (path_x->pacing.rate > al_ctx->data_rate_max) {\n432\t            al_ctx->data_rate_max = path_x->pacing.rate;\n433\t        }\n434\t    }\n435\t}\n436\t\n437\tstatic int app_limited_test_one(app_limited_test_config_t * config)\n438\t{\n439\t    uint64_t time_out;\n440\t    int nb_trials = 0;\n441\t    int was_active = 0;\n442\t    uint64_t picosec_per_byte = (1000000ull * 8) / 10;\n443\t    uint64_t queue_delay_max = 40000;\n444\t    picoquic_test_tls_api_ctx_t* test_ctx = NULL;\n445\t    app_limited_ctx_t al_ctx;\n446\t    picoquic_connection_id_t initial_cid = { {0xab, 0xbl, 0x1b, 0x17, 0xed, 0, 0, 0}, 8 };\n447\t    int ret = 0;\n448\t\n449\t    app_limited_initialize_context(&al_ctx, config);\n450\t    initial_cid.id[7] = config->test_id;\n451\t\n452\t    if (ret == 0) {\n453\t        ret = tls_api_init_ctx_ex2(&test_ctx,\n454\t            PICOQUIC_INTERNAL_TEST_VERSION_1,\n455\t            PICOQUIC_TEST_SNI, APP_LIMITED_TEST_ALPN, &al_ctx.simulated_time, NULL, NULL, 0, 1, 0, &initial_cid, 8, 0, 0, 0);\n456\t\n457\t        if (ret == 0) {\n458\t            al_ctx.client_cnx_ctx.cnx = test_ctx->cnx_client;\n459\t\n460\t            picoquic_set_default_congestion_algorithm(test_ctx->qserver, config->ccalgo);\n461\t            picoquic_set_congestion_algorithm(test_ctx->cnx_client, config->ccalgo);\n462\t\n463\t            picoquic_set_qlog(test_ctx->qserver, \".\");\n464\t            test_ctx->qserver->use_long_log = 1;\n465\t            picoquic_set_qlog(test_ctx->qclient, \".\");\n466\t            if (config->do_preemptive_repeat) {\n467\t                picoquic_set_preemptive_repeat_policy(test_ctx->qserver, 1);\n468\t                picoquic_set_preemptive_repeat_per_cnx(test_ctx->cnx_client, 1);\n469\t            }\n470\t            test_ctx->s_to_c_link->picosec_per_byte = picosec_per_byte;\n471\t            test_ctx->c_to_s_link->picosec_per_byte = picosec_per_byte;\n472\t        }\n473\t    }\n474\t\n475\t    /* The default procedure creates connections using the test callback.\n476\t    * We want to replace that by the demo client callback */\n477\t\n478\t    if (ret == 0) {\n479\t        /* TODO: proper call back context */\n480\t        picoquic_set_default_callback(test_ctx->qserver, app_limited_callback, &al_ctx);\n481\t        picoquic_set_callback(test_ctx->cnx_client, app_limited_callback, &al_ctx.client_cnx_ctx);\n482\t        if (ret == 0) {\n483\t            ret = picoquic_start_client_cnx(test_ctx->cnx_client);\n484\t        }\n485\t    }\n486\t\n487\t    if (ret == 0) {\n488\t        ret = tls_api_connection_loop(test_ctx, &al_ctx.loss_mask, queue_delay_max, &al_ctx.simulated_time);\n489\t    }\n490\t\n491\t    while (ret == 0 && picoquic_get_cnx_state(test_ctx->cnx_client) != picoquic_state_disconnected) {\n492\t        /* Look at the timeout. Set it to the next wake up time if needed. */\n493\t        if ((ret = app_limited_get_timeout(&al_ctx, al_ctx.simulated_time, &time_out)) != 0) {\n494\t            break;\n495\t        }\n496\t\n497\t        /* Progress. */\n498\t        if ((ret = tls_api_one_sim_round(test_ctx, &al_ctx.simulated_time, time_out, &was_active)) != 0) {\n499\t            break;\n500\t        }\n501\t\n502\t        if (picoquic_is_cnx_backlog_empty(test_ctx->cnx_client) &&\n503\t            al_ctx.nb_client_streams_completed >= 3 &&\n504\t            picoquic_get_cnx_state(test_ctx->cnx_client) < picoquic_state_disconnecting) {\n505\t            ret = picoquic_close(test_ctx->cnx_client, 0);\n506\t        }\n507\t\n508\t        /* monitor cwin, rate max, etc. */\n509\t        app_limited_monitor(&al_ctx);\n510\t\n511\t        if (++nb_trials > 1000000) {\n512\t            ret = -1;\n513\t            break;\n514\t        }\n515\t    }\n516\t\n517\t    if (ret == 0 && config->completion_target != 0) {\n518\t        if (al_ctx.simulated_time > config->completion_target) {\n519\t            DBG_PRINTF(\"Test uses %llu microsec instead of %llu\", al_ctx.simulated_time, config->completion_target);\n520\t            ret = -1;\n521\t        }\n522\t    }\n523\t\n524\t    if (ret == 0 && test_ctx->qclient->nb_data_nodes_allocated > test_ctx->qclient->nb_data_nodes_in_pool) {\n525\t        ret = -1;\n526\t    }\n527\t    else if (ret == 0 && test_ctx->qserver->nb_data_nodes_allocated > test_ctx->qserver->nb_data_nodes_in_pool) {\n528\t        ret = -1;\n529\t    }\n530\t\n531\t    if (ret == 0) {\n532\t        /* check CWIN, losses, etc againt targets */\n533\t        if (al_ctx.rtt_max > config->rtt_max) {\n534\t            DBG_PRINTF(\"Max RTT %llu microsec instead of %llu\", al_ctx.rtt_max, config->rtt_max);\n535\t            ret = -1;\n536\t        }\n537\t\n538\t        if (al_ctx.cwin_max > config->cwin_max) {\n539\t            DBG_PRINTF(\"Max CWIN %llu instead of %llu\", al_ctx.cwin_max, config->cwin_max);\n540\t            ret = -1;\n541\t        }\n542\t\n543\t        if (al_ctx.data_rate_max > config->data_rate_max) {\n544\t            DBG_PRINTF(\"Data rate max %llu instead of %llu\", al_ctx.data_rate_max, config->data_rate_max);\n545\t            ret = -1;\n546\t        }\n547\t\n548\t        if (test_ctx->cnx_server != NULL && test_ctx->cnx_server->nb_retransmission_total > config->nb_losses_max) {\n549\t            DBG_PRINTF(\"Nb retransmission %llu instead of %llu\", test_ctx->cnx_server->nb_retransmission_total, config->nb_losses_max);\n550\t            ret = -1;\n551\t        }\n552\t    }\n553\t\n554\t    if (test_ctx != NULL) {\n555\t        tls_api_delete_ctx(test_ctx);\n556\t        test_ctx = NULL;\n557\t    }\n558\t\n559\t    return ret;\n560\t}\n561\t\n562\tstatic void app_limited_config_set_default( app_limited_test_config_t* config, uint8_t test_id)\n563\t{\n564\t    memset(config, 0, sizeof(app_limited_test_config_t));\n565\t    config->test_id = test_id;\n566\t    config->ccalgo = picoquic_newreno_algorithm;\n567\t    config->stream_0_packet_size = 511;\n568\t    config->stream_0_packet_interval = 800;\n569\t    config->data_stream_size = 1000000;\n570\t    config->time_to_stream[0] = 0;\n571\t    config->time_to_stream[1] = 2500000;\n572\t    config->time_to_stream[2] = 7500000;\n573\t    config->completion_target = 12000000;\n574\t    config->rtt_max = 62000;\n575\t    config->cwin_max = 100000;\n576\t    config->data_rate_max = 4000000;\n577\t    config->nb_losses_max = 10;\n578\t}\n579\t\n580\tint app_limited_reno_test(void)\n581\t{\n582\t    app_limited_test_config_t config;\n583\t    app_limited_config_set_default(&config, 1);\n584\t    config.ccalgo = picoquic_newreno_algorithm;\n585\t\n586\t    return app_limited_test_one(&config);\n587\t}\n588\t\n589\tint app_limited_cubic_test(void)\n590\t{\n591\t    app_limited_test_config_t config;\n592\t    app_limited_config_set_default(&config, 2);\n593\t    config.ccalgo = picoquic_cubic_algorithm;\n594\t    config.nb_losses_max = 64;\n595\t    config.data_rate_max = 4013000;\n596\t\n597\t    return app_limited_test_one(&config);\n598\t}\n599\t\n600\tint app_limited_bbr_test(void)\n601\t{\n602\t    app_limited_test_config_t config;\n603\t    app_limited_config_set_default(&config, 3);\n604\t    config.ccalgo = picoquic_bbr_algorithm;\n605\t\n606\t    return app_limited_test_one(&config);\n607\t}\n608\t\n609\tint app_limited_rpr_test(void)\n610\t{\n611\t    app_limited_test_config_t config;\n612\t    app_limited_config_set_default(&config, 4);\n613\t    config.ccalgo = picoquic_cubic_algorithm;\n614\t    config.do_preemptive_repeat = 1;\n615\t    config.loss_mask = 0x1482481224818214ull;\n616\t    config.completion_target = 47200000;\n617\t    config.nb_losses_max = 1980;\n618\t    config.rtt_max = 275000;\n619\t\n620\t    return app_limited_test_one(&config);\n621\t}\n622\t\n623\t#if 0\n624\tint app_limited_safe_test(void)\n625\t{\n626\t    app_limited_test_config_t config;\n627\t    app_limited_config_set_default(&config, 5);\n628\t    config.ccalgo = picoquic_cubic_algorithm;\n629\t    config.max_completion_time = 5100000;\n630\t    config.nb_losses_max = 1;\n631\t    config.flow_control_max = 57344;\n632\t\n633\t    return app_limited_test_one(&config);\n634\t}\n635\t#endif\n636\t"}]},"parent_tool_use_id":null,"session_id":"b2f5f784-a6db-4c71-b3d0-86f74527db79","uuid":"9f6f3e56-d9b2-4fd8-ae3e-62dc552ed15a","timestamp":"2026-05-04T21:21:45.656Z","tool_use_result":{"type":"text","file":{"filePath":"/Users/richbarn/Projects/picoquic/picoquictest/app_limited.c","content":"/*\n* Author: Christian Huitema\n* Copyright (c) 2023, Private Octopus, Inc.\n* All rights reserved.\n*\n* Permission to use, copy, modify, and distribute this software for any\n* purpose with or without fee is hereby granted, provided that the above\n* copyright notice and this permission notice appear in all copies.\n*\n* THIS SOFTWARE IS PROVIDED BY THE COPYRIGHT HOLDERS AND CONTRIBUTORS \"AS IS\" AND\n* ANY EXPRESS OR IMPLIED WARRANTIES, INCLUDING, BUT NOT LIMITED TO, THE IMPLIED\n* WARRANTIES OF MERCHANTABILITY AND FITNESS FOR A PARTICULAR PURPOSE ARE\n* DISCLAIMED. IN NO EVENT SHALL Private Octopus, Inc. BE LIABLE FOR ANY\n* DIRECT, INDIRECT, INCIDENTAL, SPECIAL, EXEMPLARY, OR CONSEQUENTIAL DAMAGES\n* (INCLUDING, BUT NOT LIMITED TO, PROCUREMENT OF SUBSTITUTE GOODS OR SERVICES;\n* LOSS OF USE, DATA, OR PROFITS; OR BUSINESS INTERRUPTION) HOWEVER CAUSED AND\n* ON ANY THEORY OF LIABILITY, WHETHER IN CONTRACT, STRICT LIABILITY, OR TORT\n* (INCLUDING NEGLIGENCE OR OTHERWISE) ARISING IN ANY WAY OUT OF THE USE OF THIS\n* SOFTWARE, EVEN IF ADVISED OF THE POSSIBILITY OF SUCH DAMAGE.\n*/\n\n#include <stdlib.h>\n#include <string.h>\n#include <inttypes.h>\n#include \"picoquic.h\"\n#include \"picoquic_internal.h\"\n#include \"picoquictest_internal.h\"\n#include \"tls_api.h\"\n#include \"autoqlog.h\"\n#include \"logreader.h\"\n#include \"qlog.h\"\n#include \"picoquic_newreno.h\"\n#include \"picoquic_cubic.h\"\n#include \"picoquic_bbr.h\"\n#include \"picoquic_bbr1.h\"\n#include \"picoquic_fastcc.h\"\n\n/* Add a series of tests to study the behavior of rate limited\n* clients, such as those sending at a sustained rate lower\n* than the link capacity. We want to test several bug reports\n* showing the following possible issues:\n* \n* - Initial window growing higher than expected, due to congestion\n*   control never exiting slow start;\n* - Congestion window growing higher than expected, due to increased\n*   window in congestion avoidance phase;\n* - Pacing rate growing higher than the available bandwidth;\n* - Preemptive repeat getting confused when packets contain data from\n*   both finished and unfinished streams.\n* \n* We need to engineer a server that provides two kinds of streams:\n* - a steady \"control\" stream at a specified fixed rate, sending\n*   data frames smaller than the MTU so we will have multiple\n*   streams in a packet. That stream will have higher priority\n*   than the other streams.\n* - in start-up and preemptive tests, a second data stream that\n*   forces the end of slow start and tests preemtive repeat.\n* - in congestion avoidance tests, a third data stream that\n*   tests for over-large congestion windows.\n* \n* The loop will include monitoring of pacing rate, congestion\n* window and rtt. We want to run these tests with a variety of congestion\n* controls. \n*/\n\n#define APP_LIMITED_TEST_ALPN \"app_limited_test\"\n#define APP_LIMITED_ERROR_INTERNAL 1\n\ntypedef struct st_app_limited_test_config_t {\n    uint8_t test_id;\n    picoquic_congestion_algorithm_t* ccalgo;\n    int do_preemptive_repeat;\n    size_t stream_0_packet_size;\n    size_t stream_0_packet_interval;\n    uint64_t data_stream_size;\n    uint64_t time_to_stream[3];\n    uint64_t loss_mask;\n    uint64_t completion_target;\n    uint64_t rtt_max;\n    uint64_t cwin_max;\n    uint64_t data_rate_max;\n    uint64_t nb_losses_max;\n} app_limited_test_config_t;\n\ntypedef struct st_app_limited_stream_ctx_t {\n    uint64_t stream_id; /* ID for the test streams */\n    size_t data_size; /* How much data to send on each stream */\n    size_t octets_sent; /* Octets sent by server on each stream */\n    size_t octets_recv; /* Octets received by slient on each stream */\n    int fin_received;\n    int is_fin_sent;\n    int rank;\n} app_limited_stream_ctx_t;\n\ntypedef struct st_app_limited_cnx_ctx_t {\n    picoquic_cnx_t* cnx;\n    int is_server;\n    app_limited_stream_ctx_t stream_ctx[3];\n    struct st_app_limited_ctx_t* al_ctx;\n} app_limited_cnx_ctx_t;\n\ntypedef struct st_app_limited_ctx_t {\n    uint64_t simulated_time;\n    uint64_t loss_mask;\n    uint64_t stream0_next_time;\n    uint64_t stream0_bytes_sent_this_packet;\n    int nb_client_streams_completed;\n    uint64_t last_interaction_time;\n    uint64_t rtt_max;\n    uint64_t cwin_max;\n    uint64_t data_rate_max;\n    app_limited_cnx_ctx_t client_cnx_ctx;\n    app_limited_cnx_ctx_t server_cnx_ctx;\n    app_limited_test_config_t* config;\n} app_limited_ctx_t;\n\napp_limited_cnx_ctx_t* app_limited_initialize_cnx_context(app_limited_ctx_t* callback_ctx,  picoquic_cnx_t* cnx, int is_server )\n{\n    app_limited_cnx_ctx_t* cnx_ctx = NULL;\n\n    if (is_server) {\n        cnx_ctx = &callback_ctx->server_cnx_ctx;\n    }\n    else {\n        cnx_ctx = &callback_ctx->client_cnx_ctx;\n    }\n\n    cnx_ctx->cnx = cnx;\n\n    return cnx_ctx;\n}\n\napp_limited_stream_ctx_t * app_limited_find_or_create_stream(uint64_t stream_id, app_limited_cnx_ctx_t * cnx_ctx)\n{\n    app_limited_stream_ctx_t* stream_ctx = NULL;\n\n    for (int i = 0; i < 3; i++) {\n        if (stream_id == cnx_ctx->stream_ctx[i].stream_id ||\n            cnx_ctx->stream_ctx[i].stream_id == UINT64_MAX) {\n            stream_ctx = &cnx_ctx->stream_ctx[i];\n            stream_ctx->stream_id = stream_id;\n            stream_ctx->rank = i;\n            break;\n        }\n    }\n    return stream_ctx;\n}\n\nint app_limited_receive_stream_data(app_limited_cnx_ctx_t* cnx_ctx,\n    app_limited_stream_ctx_t* stream_ctx, uint8_t* bytes, size_t length, int is_fin)\n{\n    int ret = 0;\n    if (is_fin && stream_ctx->fin_received) {\n        ret = -1;\n    }\n    else {\n        for (size_t i = 0; i < length; i++) {\n            uint8_t b = bytes[i];\n            if (b == (uint8_t)(stream_ctx->octets_recv & 0xff)) {\n                stream_ctx->octets_recv++;\n            }\n            else {\n                ret = -1;\n                break;\n            }\n        }\n        if (stream_ctx->octets_recv > stream_ctx->data_size) {\n            ret = -1;\n        }\n        else if (is_fin) {\n            cnx_ctx->al_ctx->nb_client_streams_completed += 1;\n            stream_ctx->fin_received = 1;\n            if (stream_ctx->octets_recv != stream_ctx->data_size) {\n                ret = -1;\n            }\n        }\n    }\n\n    return ret;\n}\n\nvoid app_limited_prepare_to_send_on_stream(app_limited_cnx_ctx_t* cnx_ctx,\n    app_limited_stream_ctx_t* stream_ctx, uint8_t* context, size_t length, uint64_t simulated_time)\n{\n    uint64_t available = stream_ctx->data_size - stream_ctx->octets_sent;\n    int is_fin = 0;\n    int is_still_active = 1;\n    uint8_t* buffer = NULL;\n\n    /* Compute how much to send */\n    if (stream_ctx->rank == 0) {\n        /* Implement here the rate pacing of stream 0. */\n        if (length > (cnx_ctx->al_ctx->config->stream_0_packet_size - cnx_ctx->al_ctx->stream0_bytes_sent_this_packet)) {\n            /* cannot only send as much as the packet indicates */\n            available = cnx_ctx->al_ctx->config->stream_0_packet_size - cnx_ctx->al_ctx->stream0_bytes_sent_this_packet;\n        } else {\n            available = length;\n        }\n\n        cnx_ctx->al_ctx->stream0_bytes_sent_this_packet += (size_t)available;\n        if (cnx_ctx->al_ctx->stream0_bytes_sent_this_packet >= cnx_ctx->al_ctx->config->stream_0_packet_size){\n            /* the whole packet was scheduled */\n            cnx_ctx->al_ctx->stream0_bytes_sent_this_packet = 0;\n            cnx_ctx->al_ctx->stream0_next_time += cnx_ctx->al_ctx->config->stream_0_packet_interval;\n            if (simulated_time < cnx_ctx->al_ctx->stream0_next_time) {\n                is_still_active = 0;\n            }\n        }\n    }\n    else if (available > length) {\n        available = length;\n    }\n\n    if (available + stream_ctx->octets_sent >= stream_ctx->data_size) {\n        is_fin = 1;\n    }\n\n    buffer = (uint8_t*)picoquic_provide_stream_data_buffer(context, (size_t)available, is_fin, is_still_active);\n    if (buffer != NULL) {\n        stream_ctx->is_fin_sent = is_fin;\n        /* fill the bytes */\n        for (size_t i = 0; i < (size_t)available; i++) {\n            uint8_t b = (uint8_t)(stream_ctx->octets_sent & 0xff);\n            buffer[i] = b;\n            stream_ctx->octets_sent++;\n        }\n    }\n}\n\n /* Callback from Quic\n */\nint app_limited_callback(picoquic_cnx_t* cnx,\n    uint64_t stream_id, uint8_t* bytes, size_t length,\n    picoquic_call_back_event_t fin_or_event, void* callback_ctx, void* v_stream_ctx)\n{\n\n    int ret = 0;\n    app_limited_cnx_ctx_t* cnx_ctx = (app_limited_cnx_ctx_t*)callback_ctx;\n    app_limited_stream_ctx_t* stream_ctx = (app_limited_stream_ctx_t*)v_stream_ctx;\n\n    /* If this is the first reference to the connection, the application context is set\n    * to the default value defined for the server. This default value contains the pointer\n    * to the global context in which streams and roles are defined.\n    */\n    if (callback_ctx == NULL || callback_ctx == picoquic_get_default_callback_context(picoquic_get_quic_ctx(cnx))) {\n        if (fin_or_event == picoquic_callback_close) {\n            picoquic_set_callback(cnx, NULL, NULL);\n            return 0;\n        }\n        else {\n            cnx_ctx = app_limited_initialize_cnx_context((app_limited_ctx_t*)callback_ctx, cnx, 1);\n            if (cnx_ctx == NULL) {\n                /* cannot handle the connection */\n                picoquic_close(cnx, PICOQUIC_ERROR_MEMORY);\n                return -1;\n            }\n            else {\n                cnx_ctx->is_server = 1;\n                picoquic_set_callback(cnx, app_limited_callback, cnx_ctx);\n            }\n        }\n    }\n\n    if (ret == 0) {\n        switch (fin_or_event) {\n        case picoquic_callback_stream_data:\n        case picoquic_callback_stream_fin:\n            /* Data arrival on stream #x, maybe with fin mark */\n            if (stream_ctx == NULL) {\n                /* Retrieve, or create and initialize stream context */\n                stream_ctx = app_limited_find_or_create_stream(stream_id, cnx_ctx);\n            }\n\n            if (stream_ctx == NULL) {\n                /* Internal error */\n                (void)picoquic_reset_stream(cnx, stream_id, APP_LIMITED_ERROR_INTERNAL);\n                ret = -1;\n            }\n            else if (cnx_ctx->is_server) {\n                ret = -1;\n            } else {\n                ret = app_limited_receive_stream_data(cnx_ctx, stream_ctx, bytes, length, (fin_or_event == picoquic_callback_stream_fin));\n            }\n            break;\n        case picoquic_callback_prepare_to_send:\n            /* Active sending API */\n            if (stream_ctx == NULL) {\n                /* This should never happen */\n                picoquic_log_app_message(cnx, \"app_limited callback returns %d, event %d\", ret, fin_or_event);\n                DBG_PRINTF(\"Prepare to send on NULL context, steam: %\" PRIu64, stream_id);\n                ret = -1;\n            }\n            else {\n                app_limited_prepare_to_send_on_stream(cnx_ctx, stream_ctx, bytes, length, cnx_ctx->al_ctx->simulated_time);\n            }\n            break;\n        case picoquic_callback_datagram:\n        case picoquic_callback_prepare_datagram:\n            /* not expected */\n            ret = -1;\n            break;\n        case picoquic_callback_stream_reset: /* Client reset stream #x */\n        case picoquic_callback_stop_sending: /* Client asks server to reset stream #x */\n                                             /* TODO: react to abandon stream, etc. */\n            break;\n        case picoquic_callback_stateless_reset: /* Received an error message */\n        case picoquic_callback_close: /* Received connection close */\n        case picoquic_callback_application_close: /* Received application close */\n                                                  /* Remove the connection from the context, and then delete it */\n            cnx_ctx->cnx = NULL;\n            picoquic_set_callback(cnx, NULL, NULL);\n            break;\n        case picoquic_callback_version_negotiation:\n            /* The server should never receive a version negotiation response */\n            break;\n        case picoquic_callback_stream_gap:\n            /* This callback is never used. */\n            break;\n        case picoquic_callback_almost_ready:\n        case picoquic_callback_ready:\n            /* should mark the first stream as ready, create it if necessary */\n            break;\n        case picoquic_callback_datagram_acked:\n            /* Ack for packet carrying datagram-object received from peer */\n        case picoquic_callback_datagram_lost:\n            /* Packet carrying datagram-object probably lost */\n        case picoquic_callback_datagram_spurious:\n            /* Packet carrying datagram-object was not really lost */\n            break;\n        case picoquic_callback_pacing_changed:\n            /* Notification of rate change from congestion controller */\n            break;\n        default:\n            /* unexpected */\n            break;\n        }\n    }\n\n    if (ret != 0) {\n        picoquic_log_app_message(cnx, \"app_limited callback returns %d, event %d\", ret, fin_or_event);\n        DBG_PRINTF(\"app_limited callback returns %d, event %d\", ret, fin_or_event);\n    }\n\n    return ret;\n}\n\nvoid app_limited_initialize_context(app_limited_ctx_t* al_ctx, app_limited_test_config_t* config)\n{\n    memset(al_ctx, 0, sizeof(app_limited_ctx_t));\n    for (int i = 0; i < 3; i++) {\n        uint64_t data_size = (i != 0) ? config->data_stream_size : ((config->time_to_stream[2] + 1000000) * config->stream_0_packet_size) / config->stream_0_packet_interval;\n        al_ctx->client_cnx_ctx.stream_ctx[i].stream_id = UINT64_MAX;\n        al_ctx->client_cnx_ctx.stream_ctx[i].data_size = (size_t)data_size;\n        al_ctx->client_cnx_ctx.stream_ctx[i].rank = i;\n        al_ctx->server_cnx_ctx.stream_ctx[i].stream_id = UINT64_MAX;\n        al_ctx->server_cnx_ctx.stream_ctx[i].data_size = (size_t)data_size;\n        al_ctx->server_cnx_ctx.stream_ctx[i].rank = i;\n    }\n    al_ctx->client_cnx_ctx.al_ctx = al_ctx;\n    al_ctx->server_cnx_ctx.al_ctx = al_ctx;\n    al_ctx->loss_mask = config->loss_mask;\n    al_ctx->config = config;\n}\n\n/* app_limited_get_timeout:\n * If time above connection 2, start connection 2\n *     else timeout = connection 2\n * If time above connection 1, start connection 1\n *     else timeout = connection 1\n * If time above next interval,\n *     mark connection 0 active\n *     else timeout = next interval\n * If nothing in particular to do, timeout = 0\n * \n */\nint app_limited_get_timeout(app_limited_ctx_t* al_ctx, uint64_t simulated_time, uint64_t * timeout)\n{\n    int ret = 0;\n    \n    *timeout = 0;\n\n    if (al_ctx->server_cnx_ctx.cnx != NULL) {\n        for (int i = 0; i < 3; i++) {\n            if (al_ctx->server_cnx_ctx.stream_ctx[i].stream_id == UINT64_MAX) {\n                if (simulated_time >= al_ctx->config->time_to_stream[i]) {\n                    uint64_t stream_id = picoquic_get_next_local_stream_id(al_ctx->server_cnx_ctx.cnx, 1);\n                    al_ctx->server_cnx_ctx.stream_ctx[i].stream_id = stream_id;\n                    ret = picoquic_mark_active_stream(al_ctx->server_cnx_ctx.cnx, stream_id, 1,\n                        (void*)&al_ctx->server_cnx_ctx.stream_ctx[i]);\n                    if (i == 0) {\n                        al_ctx->stream0_next_time = simulated_time;\n                    }\n                }\n                else {\n                    *timeout = al_ctx->config->time_to_stream[i];\n                }\n                break;\n            }\n        }\n\n        if (ret == 0) {\n            if (al_ctx->server_cnx_ctx.stream_ctx[0].stream_id != UINT64_MAX) {\n                if (simulated_time < al_ctx->stream0_next_time) {\n                    if (*timeout == 0 || al_ctx->stream0_next_time < *timeout) {\n                        *timeout = al_ctx->stream0_next_time;\n                    }\n                }\n                else if (!al_ctx->server_cnx_ctx.stream_ctx[0].is_fin_sent) {\n                    picoquic_mark_active_stream(al_ctx->server_cnx_ctx.cnx,\n                        al_ctx->server_cnx_ctx.stream_ctx[0].stream_id, 1,\n                        (void*)&al_ctx->server_cnx_ctx.stream_ctx[0]);\n                }\n            }\n        }\n    }\n\n    return ret;\n}\n\nvoid app_limited_monitor(app_limited_ctx_t* al_ctx)\n{\n    if (al_ctx->server_cnx_ctx.cnx != NULL) {\n        picoquic_path_t* path_x = al_ctx->server_cnx_ctx.cnx->path[0];\n\n        if (path_x->rtt_max > al_ctx->rtt_max) {\n            al_ctx->rtt_max = path_x->rtt_max;\n        }\n        if (path_x->cwin > al_ctx->cwin_max) {\n            al_ctx->cwin_max = path_x->cwin;\n        }\n        if (path_x->pacing.rate > al_ctx->data_rate_max) {\n            al_ctx->data_rate_max = path_x->pacing.rate;\n        }\n    }\n}\n\nstatic int app_limited_test_one(app_limited_test_config_t * config)\n{\n    uint64_t time_out;\n    int nb_trials = 0;\n    int was_active = 0;\n    uint64_t picosec_per_byte = (1000000ull * 8) / 10;\n    uint64_t queue_delay_max = 40000;\n    picoquic_test_tls_api_ctx_t* test_ctx = NULL;\n    app_limited_ctx_t al_ctx;\n    picoquic_connection_id_t initial_cid = { {0xab, 0xbl, 0x1b, 0x17, 0xed, 0, 0, 0}, 8 };\n    int ret = 0;\n\n    app_limited_initialize_context(&al_ctx, config);\n    initial_cid.id[7] = config->test_id;\n\n    if (ret == 0) {\n        ret = tls_api_init_ctx_ex2(&test_ctx,\n            PICOQUIC_INTERNAL_TEST_VERSION_1,\n            PICOQUIC_TEST_SNI, APP_LIMITED_TEST_ALPN, &al_ctx.simulated_time, NULL, NULL, 0, 1, 0, &initial_cid, 8, 0, 0, 0);\n\n        if (ret == 0) {\n            al_ctx.client_cnx_ctx.cnx = test_ctx->cnx_client;\n\n            picoquic_set_default_congestion_algorithm(test_ctx->qserver, config->ccalgo);\n            picoquic_set_congestion_algorithm(test_ctx->cnx_client, config->ccalgo);\n\n            picoquic_set_qlog(test_ctx->qserver, \".\");\n            test_ctx->qserver->use_long_log = 1;\n            picoquic_set_qlog(test_ctx->qclient, \".\");\n            if (config->do_preemptive_repeat) {\n                picoquic_set_preemptive_repeat_policy(test_ctx->qserver, 1);\n                picoquic_set_preemptive_repeat_per_cnx(test_ctx->cnx_client, 1);\n            }\n            test_ctx->s_to_c_link->picosec_per_byte = picosec_per_byte;\n            test_ctx->c_to_s_link->picosec_per_byte = picosec_per_byte;\n        }\n    }\n\n    /* The default procedure creates connections using the test callback.\n    * We want to replace that by the demo client callback */\n\n    if (ret == 0) {\n        /* TODO: proper call back context */\n        picoquic_set_default_callback(test_ctx->qserver, app_limited_callback, &al_ctx);\n        picoquic_set_callback(test_ctx->cnx_client, app_limited_callback, &al_ctx.client_cnx_ctx);\n        if (ret == 0) {\n            ret = picoquic_start_client_cnx(test_ctx->cnx_client);\n        }\n    }\n\n    if (ret == 0) {\n        ret = tls_api_connection_loop(test_ctx, &al_ctx.loss_mask, queue_delay_max, &al_ctx.simulated_time);\n    }\n\n    while (ret == 0 && picoquic_get_cnx_state(test_ctx->cnx_client) != picoquic_state_disconnected) {\n        /* Look at the timeout. Set it to the next wake up time if needed. */\n        if ((ret = app_limited_get_timeout(&al_ctx, al_ctx.simulated_time, &time_out)) != 0) {\n            break;\n        }\n\n        /* Progress. */\n        if ((ret = tls_api_one_sim_round(test_ctx, &al_ctx.simulated_time, time_out, &was_active)) != 0) {\n            break;\n        }\n\n        if (picoquic_is_cnx_backlog_empty(test_ctx->cnx_client) &&\n            al_ctx.nb_client_streams_completed >= 3 &&\n            picoquic_get_cnx_state(test_ctx->cnx_client) < picoquic_state_disconnecting) {\n            ret = picoquic_close(test_ctx->cnx_client, 0);\n        }\n\n        /* monitor cwin, rate max, etc. */\n        app_limited_monitor(&al_ctx);\n\n        if (++nb_trials > 1000000) {\n            ret = -1;\n            break;\n        }\n    }\n\n    if (ret == 0 && config->completion_target != 0) {\n        if (al_ctx.simulated_time > config->completion_target) {\n            DBG_PRINTF(\"Test uses %llu microsec instead of %llu\", al_ctx.simulated_time, config->completion_target);\n            ret = -1;\n        }\n    }\n\n    if (ret == 0 && test_ctx->qclient->nb_data_nodes_allocated > test_ctx->qclient->nb_data_nodes_in_pool) {\n        ret = -1;\n    }\n    else if (ret == 0 && test_ctx->qserver->nb_data_nodes_allocated > test_ctx->qserver->nb_data_nodes_in_pool) {\n        ret = -1;\n    }\n\n    if (ret == 0) {\n        /* check CWIN, losses, etc againt targets */\n        if (al_ctx.rtt_max > config->rtt_max) {\n            DBG_PRINTF(\"Max RTT %llu microsec instead of %llu\", al_ctx.rtt_max, config->rtt_max);\n            ret = -1;\n        }\n\n        if (al_ctx.cwin_max > config->cwin_max) {\n            DBG_PRINTF(\"Max CWIN %llu instead of %llu\", al_ctx.cwin_max, config->cwin_max);\n            ret = -1;\n        }\n\n        if (al_ctx.data_rate_max > config->data_rate_max) {\n            DBG_PRINTF(\"Data rate max %llu instead of %llu\", al_ctx.data_rate_max, config->data_rate_max);\n            ret = -1;\n        }\n\n        if (test_ctx->cnx_server != NULL && test_ctx->cnx_server->nb_retransmission_total > config->nb_losses_max) {\n            DBG_PRINTF(\"Nb retransmission %llu instead of %llu\", test_ctx->cnx_server->nb_retransmission_total, config->nb_losses_max);\n            ret = -1;\n        }\n    }\n\n    if (test_ctx != NULL) {\n        tls_api_delete_ctx(test_ctx);\n        test_ctx = NULL;\n    }\n\n    return ret;\n}\n\nstatic void app_limited_config_set_default( app_limited_test_config_t* config, uint8_t test_id)\n{\n    memset(config, 0, sizeof(app_limited_test_config_t));\n    config->test_id = test_id;\n    config->ccalgo = picoquic_newreno_algorithm;\n    config->stream_0_packet_size = 511;\n    config->stream_0_packet_interval = 800;\n    config->data_stream_size = 1000000;\n    config->time_to_stream[0] = 0;\n    config->time_to_stream[1] = 2500000;\n    config->time_to_stream[2] = 7500000;\n    config->completion_target = 12000000;\n    config->rtt_max = 62000;\n    config->cwin_max = 100000;\n    config->data_rate_max = 4000000;\n    config->nb_losses_max = 10;\n}\n\nint app_limited_reno_test(void)\n{\n    app_limited_test_config_t config;\n    app_limited_config_set_default(&config, 1);\n    config.ccalgo = picoquic_newreno_algorithm;\n\n    return app_limited_test_one(&config);\n}\n\nint app_limited_cubic_test(void)\n{\n    app_limited_test_config_t config;\n    app_limited_config_set_default(&config, 2);\n    config.ccalgo = picoquic_cubic_algorithm;\n    config.nb_losses_max = 64;\n    config.data_rate_max = 4013000;\n\n    return app_limited_test_one(&config);\n}\n\nint app_limited_bbr_test(void)\n{\n    app_limited_test_config_t config;\n    app_limited_config_set_default(&config, 3);\n    config.ccalgo = picoquic_bbr_algorithm;\n\n    return app_limited_test_one(&config);\n}\n\nint app_limited_rpr_test(void)\n{\n    app_limited_test_config_t config;\n    app_limited_config_set_default(&config, 4);\n    config.ccalgo = picoquic_cubic_algorithm;\n    config.do_preemptive_repeat = 1;\n    config.loss_mask = 0x1482481224818214ull;\n    config.completion_target = 47200000;\n    config.nb_losses_max = 1980;\n    config.rtt_max = 275000;\n\n    return app_limited_test_one(&config);\n}\n\n#if 0\nint app_limited_safe_test(void)\n{\n    app_limited_test_config_t config;\n    app_limited_config_set_default(&config, 5);\n    config.ccalgo = picoquic_cubic_algorithm;\n    config.max_completion_time = 5100000;\n    config.nb_losses_max = 1;\n    config.flow_control_max = 57344;\n\n    return app_limited_test_one(&config);\n}\n#endif\n","numLines":636,"startLine":1,"totalLines":636}}}
