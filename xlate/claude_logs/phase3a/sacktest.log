{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01XQYQunfFVF3HB7ZUjwmdkE","type":"tool_result","content":"1\t/*\n2\t* Author: Christian Huitema\n3\t* Copyright (c) 2017, Private Octopus, Inc.\n4\t* All rights reserved.\n5\t*\n6\t* Permission to use, copy, modify, and distribute this software for any\n7\t* purpose with or without fee is hereby granted, provided that the above\n8\t* copyright notice and this permission notice appear in all copies.\n9\t*\n10\t* THIS SOFTWARE IS PROVIDED BY THE COPYRIGHT HOLDERS AND CONTRIBUTORS \"AS IS\" AND\n11\t* ANY EXPRESS OR IMPLIED WARRANTIES, INCLUDING, BUT NOT LIMITED TO, THE IMPLIED\n12\t* WARRANTIES OF MERCHANTABILITY AND FITNESS FOR A PARTICULAR PURPOSE ARE\n13\t* DISCLAIMED. IN NO EVENT SHALL Private Octopus, Inc. BE LIABLE FOR ANY\n14\t* DIRECT, INDIRECT, INCIDENTAL, SPECIAL, EXEMPLARY, OR CONSEQUENTIAL DAMAGES\n15\t* (INCLUDING, BUT NOT LIMITED TO, PROCUREMENT OF SUBSTITUTE GOODS OR SERVICES;\n16\t* LOSS OF USE, DATA, OR PROFITS; OR BUSINESS INTERRUPTION) HOWEVER CAUSED AND\n17\t* ON ANY THEORY OF LIABILITY, WHETHER IN CONTRACT, STRICT LIABILITY, OR TORT\n18\t* (INCLUDING NEGLIGENCE OR OTHERWISE) ARISING IN ANY WAY OUT OF THE USE OF THIS\n19\t* SOFTWARE, EVEN IF ADVISED OF THE POSSIBILITY OF SUCH DAMAGE.\n20\t*/\n21\t\n22\t#include \"picoquic_internal.h\"\n23\t#include <stdlib.h>\n24\t#include <string.h>\n25\t\n26\t/* Utility function to set minimal quic and cnx contexts\n27\t */\n28\tint picoquic_test_set_minimal_cnx_with_time(picoquic_quic_t** quic, picoquic_cnx_t** cnx, uint64_t * simulated_time)\n29\t{\n30\t    *cnx = NULL;\n31\t    *quic = picoquic_create(8, NULL, NULL, NULL, NULL, NULL,\n32\t        NULL, NULL, NULL, NULL, 0, simulated_time, NULL, NULL, 0);\n33\t    if (*quic != NULL) {\n34\t        *cnx = picoquic_create_cnx(*quic,\n35\t            picoquic_null_connection_id,\n36\t            picoquic_null_connection_id,\n37\t            NULL, 0,\n38\t            0, PICOQUIC_TEST_SNI, \"minimal\", 1);\n39\t        if (*cnx == NULL) {\n40\t            picoquic_free(*quic);\n41\t            *quic = NULL;\n42\t        }\n43\t    }\n44\t    return (*quic == NULL || *cnx == NULL);\n45\t}\n46\t\n47\tint picoquic_test_set_minimal_cnx(picoquic_quic_t** quic, picoquic_cnx_t** cnx)\n48\t{\n49\t    return picoquic_test_set_minimal_cnx_with_time(quic, cnx, NULL);\n50\t}\n51\t\n52\tint picoquic_test_reset_minimal_cnx(picoquic_quic_t* quic, picoquic_cnx_t** cnx)\n53\t{\n54\t    if (*cnx != NULL) {\n55\t        picoquic_delete_cnx(*cnx);\n56\t    }\n57\t    *cnx = picoquic_create_cnx(quic,\n58\t        picoquic_null_connection_id,\n59\t        picoquic_null_connection_id,\n60\t        NULL, 0,\n61\t        0, PICOQUIC_TEST_SNI, \"minimal\", 1);\n62\t    return (*cnx == NULL) ? -1 : 0;\n63\t}\n64\t\n65\tvoid picoquic_test_delete_minimal_cnx(picoquic_quic_t** quic, picoquic_cnx_t** cnx)\n66\t{\n67\t    if (*cnx != NULL) {\n68\t        picoquic_delete_cnx(*cnx);\n69\t        *cnx = NULL;\n70\t    }\n71\t    if (*quic != NULL) {\n72\t        picoquic_free(*quic);\n73\t        *quic = NULL;\n74\t    }\n75\t}\n76\t/*\n77\t * Test of the SACK functionality\n78\t */\n79\t\n80\tstatic const uint64_t test_pn64[] = {\n81\t    3, 4, 0, 2, 7, 8, 11, 12, 13, 17, 19, 21, 18, 16, 20, 10, 5, 6, 9, 1, 14, 15\n82\t};\n83\t\n84\tstatic const size_t nb_test_pn64 = sizeof(test_pn64) / sizeof(uint64_t);\n85\t\n86\tstruct expected_ack_t {\n87\t    uint64_t highest_received;\n88\t    uint64_t last_range;\n89\t    uint8_t num_blocks;\n90\t};\n91\t\n92\tstatic struct expected_ack_t expected_ack[] = {\n93\t    { 3, 0, 0 },\n94\t    { 4, 1, 0 },\n95\t    { 4, 1, 1 },\n96\t    { 4, 2, 1 },\n97\t    { 7, 0, 2 },\n98\t    { 8, 1, 2 },\n99\t    { 11, 0, 3 },\n100\t    { 12, 1, 2 },\n101\t    { 13, 2, 1 },\n102\t    { 17, 0, 2 },\n103\t    { 19, 0, 2 },\n104\t    { 21, 0, 3 },\n105\t    { 21, 0, 2 },\n106\t    { 21, 0, 1 },\n107\t    { 21, 5, 0 },\n108\t    { 21, 5, 1 },\n109\t    { 21, 5, 2 },\n110\t    { 21, 5, 2 },\n111\t    { 21, 5, 1 },\n112\t    { 21, 5, 1 },\n113\t    { 21, 5, 1 },\n114\t    { 21, 21, 0 }\n115\t};\n116\t\n117\t\n118\tint check_ack_ranges(picoquic_sack_list_t* sack_list)\n119\t{\n120\t    int ret = 0;\n121\t\n122\t    for (int r = 0; r < 2; r++) {\n123\t        int range_sum[PICOQUIC_MAX_ACK_RANGE_REPEAT] = { 0 };\n124\t        picoquic_sack_item_t* sack = picoquic_sack_first_item(sack_list);\n125\t\n126\t        while (sack != NULL) {\n127\t            if (sack->nb_times_sent[r] < 0) {\n128\t                ret = -1;\n129\t                break;\n130\t            }\n131\t            else if (sack->nb_times_sent[r] < PICOQUIC_MAX_ACK_RANGE_REPEAT) {\n132\t                range_sum[sack->nb_times_sent[r]] += 1;\n133\t            }\n134\t            sack = picoquic_sack_next_item(sack);\n135\t        }\n136\t\n137\t        for (int i = 0; ret == 0 && i < PICOQUIC_MAX_ACK_RANGE_REPEAT; i++) {\n138\t            if (sack_list->rc[r].range_counts[i] != range_sum[i]) {\n139\t                ret = -1;\n140\t            }\n141\t        }\n142\t    }\n143\t    return ret;\n144\t}\n145\t\n146\t\n147\tint sacktest(void)\n148\t{\n149\t    int ret = 0;\n150\t    picoquic_cnx_t *cnx;\n151\t    picoquic_quic_t* quic;\n152\t    uint64_t current_time = 0;\n153\t    uint64_t highest_seen = 0;\n154\t    uint64_t highest_seen_time = 0;\n155\t    picoquic_packet_context_enum pc = 0;\n156\t\n157\t    if (picoquic_test_set_minimal_cnx(&quic, &cnx) != 0) {\n158\t        return -1;\n159\t    }\n160\t\n161\t    if (picoquic_create_local_cnxid(cnx, 0, NULL, 0) == NULL) {\n162\t        return -1;\n163\t    }\n164\t\n165\t    /* Do a basic test with packet zero */\n166\t    if (picoquic_is_pn_already_received(cnx, pc,\n167\t        cnx->first_local_cnxid_list->local_cnxid_first, 0) != 0) {\n168\t        ret = -1;\n169\t    }\n170\t    else if (picoquic_record_pn_received(cnx, pc, cnx->first_local_cnxid_list->local_cnxid_first,\n171\t        0, current_time) != 0) {\n172\t        ret = -1;\n173\t    }\n174\t    else if (picoquic_is_pn_already_received(cnx, pc,\n175\t        cnx->first_local_cnxid_list->local_cnxid_first, 0) == 0) {\n176\t        ret = -1;\n177\t    }\n178\t    else if (picoquic_sack_list_first(&cnx->ack_ctx[pc].sack_list) != 0 ||\n179\t        picoquic_sack_list_last(&cnx->ack_ctx[pc].sack_list) != 0 ||\n180\t        picoquic_sack_list_first_range(&cnx->ack_ctx[pc].sack_list) != NULL) {\n181\t        ret = -1;\n182\t    }\n183\t    else {\n184\t        /* reset for the next test */\n185\t        picoquic_test_reset_minimal_cnx(quic, &cnx);\n186\t    }\n187\t\n188\t    if (ret == 0) {\n189\t        ret = check_ack_ranges(&cnx->ack_ctx[pc].sack_list);\n190\t    }\n191\t\n192\t    for (size_t i = 0; ret == 0 && i < nb_test_pn64; i++) {\n193\t        current_time = ((uint64_t)i) * 100 + 1;\n194\t\n195\t        if (test_pn64[i] > highest_seen) {\n196\t            highest_seen = test_pn64[i];\n197\t            highest_seen_time = current_time;\n198\t        }\n199\t\n200\t        if (picoquic_record_pn_received(cnx, pc, cnx->first_local_cnxid_list->local_cnxid_first, test_pn64[i], current_time) != 0) {\n201\t            ret = -1;\n202\t        }\n203\t\n204\t        if (ret == 0) {\n205\t            ret = check_ack_ranges(&cnx->ack_ctx[pc].sack_list);\n206\t        }\n207\t\n208\t        for (size_t j = 0; ret == 0 && j <= i; j++) {\n209\t            if (picoquic_is_pn_already_received(cnx, pc,\n210\t                cnx->first_local_cnxid_list->local_cnxid_first, test_pn64[j]) == 0) {\n211\t                ret = -1;\n212\t            }\n213\t\n214\t            if (picoquic_record_pn_received(cnx, pc, cnx->first_local_cnxid_list->local_cnxid_first, test_pn64[j], current_time) != 1) {\n215\t                ret = -1;\n216\t            }\n217\t        }\n218\t\n219\t        for (size_t j = i + 1; ret == 0 && j < nb_test_pn64; j++) {\n220\t            if (picoquic_is_pn_already_received(cnx, pc,\n221\t                cnx->first_local_cnxid_list->local_cnxid_first, test_pn64[j]) != 0) {\n222\t                ret = -1;\n223\t            }\n224\t        }\n225\t    }\n226\t\n227\t    if (ret == 0) {\n228\t        if (picoquic_sack_list_last(&cnx->ack_ctx[pc].sack_list) != 21 ||\n229\t            picoquic_sack_list_first(&cnx->ack_ctx[pc].sack_list) != 0 ||\n230\t            cnx->ack_ctx[pc].time_stamp_largest_received != highest_seen_time ||\n231\t            picoquic_sack_list_first_range(&cnx->ack_ctx[pc].sack_list) != NULL) {\n232\t            ret = -1;\n233\t        }\n234\t    }\n235\t\n236\t    /* Free the sack lists*/\n237\t    picoquic_test_delete_minimal_cnx(&quic, &cnx);\n238\t\n239\t    return ret;\n240\t}\n241\t\n242\tstatic void ack_range_mask(uint64_t* mask, uint64_t highest, uint64_t range)\n243\t{\n244\t    for (uint64_t i = 0; i < range; i++) {\n245\t        *mask |= 1ull << (highest & 63);\n246\t        highest--;\n247\t    }\n248\t}\n249\t\n250\tstatic int basic_ack_parse(uint8_t* bytes, size_t bytes_max,\n251\t    struct expected_ack_t* expected_ack, uint64_t * previous_mask, uint64_t expected_mask)\n252\t{\n253\t    int ret = 0;\n254\t    size_t byte_index = 1;\n255\t    uint8_t first_byte = bytes[0];\n256\t    uint64_t num_block = 0;\n257\t    uint64_t largest = 0;\n258\t    uint64_t last_range = 0;\n259\t    uint64_t ack_range = 0;\n260\t    uint64_t acked_mask = 0;\n261\t    uint64_t gap_begin = 0;\n262\t    size_t l_largest = 0;\n263\t    size_t l_delay = 0;\n264\t    size_t l_num_block = 0;\n265\t    size_t l_last_range = 0;\n266\t\n267\t    if (first_byte != picoquic_frame_type_ack) {\n268\t        ret = -1;\n269\t    } else {\n270\t        /* Largest */\n271\t        if (byte_index < bytes_max) {\n272\t            l_largest = picoquic_varint_decode(bytes + byte_index, bytes_max - byte_index, &largest);\n273\t            byte_index += l_largest;\n274\t        }\n275\t\n276\t        /* ACK delay */\n277\t        if (byte_index < bytes_max) {\n278\t            l_delay = picoquic_varint_skip(bytes + byte_index);\n279\t            byte_index += l_delay;\n280\t        }\n281\t\n282\t        /* Num blocks */\n283\t        if (byte_index < bytes_max) {\n284\t            l_num_block = picoquic_varint_decode(bytes + byte_index, bytes_max - byte_index, &num_block);\n285\t            byte_index += l_num_block;\n286\t        }\n287\t\n288\t        /* last range */\n289\t        if (byte_index < bytes_max) {\n290\t            l_last_range = picoquic_varint_decode(bytes + byte_index, bytes_max - byte_index, &last_range);\n291\t            byte_index += l_last_range;\n292\t        }\n293\t\n294\t        if (l_largest == 0 || l_delay == 0 || l_num_block == 0 || l_last_range == 0 || byte_index > bytes_max) {\n295\t            ret = -1;\n296\t        } else {\n297\t            if (last_range <= largest) {\n298\t                ack_range_mask(&acked_mask, largest, last_range + 1);\n299\t                gap_begin = largest - last_range - 1;\n300\t            } else {\n301\t                ret = -1;\n302\t            }\n303\t\n304\t            for (uint64_t i = 0; ret == 0 && i < num_block; i++) {\n305\t                size_t l_gap = 0;\n306\t                size_t l_range = 0;\n307\t                uint64_t gap = 0;\n308\t\n309\t                /* Decode the gap */\n310\t                if (byte_index < bytes_max) {\n311\t                    l_gap = picoquic_varint_decode(bytes + byte_index, bytes_max - byte_index, &gap);\n312\t                    byte_index += l_gap;\n313\t                    gap += 1;\n314\t                }\n315\t                /* decode the range */\n316\t                if (byte_index < bytes_max) {\n317\t                    l_range = picoquic_varint_decode(bytes + byte_index, bytes_max - byte_index, &ack_range);\n318\t                    byte_index += l_range;\n319\t                }\n320\t                if (l_gap == 0 || l_range == 0) {\n321\t                    ret = -1;\n322\t                } else if (gap > gap_begin) {\n323\t                    ret = -1;\n324\t                } else {\n325\t                    gap_begin -= gap;\n326\t\n327\t                    if (gap_begin >= ack_range) {\n328\t                        /* mark the range as received */\n329\t                        ack_range_mask(&acked_mask, gap_begin, ++ack_range);\n330\t\n331\t                        /* start of next gap */\n332\t                        gap_begin -= ack_range;\n333\t                    } else {\n334\t                        ret = -1;\n335\t                    }\n336\t                }\n337\t            }\n338\t        }\n339\t\n340\t        if (ret == 0) {\n341\t            if (byte_index != bytes_max) {\n342\t                ret = -1;\n343\t            }\n344\t        }\n345\t\n346\t        if (ret == 0) {\n347\t            if (largest != expected_ack->highest_received || last_range != expected_ack->last_range || num_block != expected_ack->num_blocks) {\n348\t                ret = -1;\n349\t            }\n350\t        }\n351\t\n352\t        if (ret == 0) {\n353\t            acked_mask |= *previous_mask;\n354\t            if (acked_mask != expected_mask) {\n355\t                ret = -1;\n356\t            }\n357\t            *previous_mask = acked_mask;\n358\t        }\n359\t    }\n360\t\n361\t    return ret;\n362\t}\n363\t\n364\t\n365\tint sendacktest(void)\n366\t{\n367\t    int ret = 0;\n368\t    picoquic_quic_t* quic;\n369\t    picoquic_cnx_t * cnx;\n370\t    uint64_t current_time;\n371\t    uint64_t received_mask = 0;\n372\t    uint64_t previous_mask = 0;\n373\t    uint8_t bytes[256];\n374\t    picoquic_packet_context_enum pc = 0;\n375\t\n376\t    if (picoquic_test_set_minimal_cnx(&quic, &cnx) != 0) {\n377\t        return -1;\n378\t    }\n379\t    cnx->sending_ecn_ack = 0; /* don't write an ack_ecn frame */\n380\t    \n381\t    if (check_ack_ranges(&cnx->ack_ctx[pc].sack_list) != 0) {\n382\t        ret = -1;\n383\t    }\n384\t\n385\t    for (size_t i = 0; ret == 0 && i < nb_test_pn64; i++) {\n386\t        current_time = ((uint64_t)i) * 100;\n387\t\n388\t        if (picoquic_record_pn_received(cnx, pc, cnx->first_local_cnxid_list->local_cnxid_first, test_pn64[i], current_time) != 0) {\n389\t            ret = -1;\n390\t        }\n391\t\n392\t        if (check_ack_ranges(&cnx->ack_ctx[pc].sack_list) != 0) {\n393\t            ret = -1;\n394\t        }\n395\t\n396\t        if (ret == 0) {\n397\t            int more_data = 0;\n398\t            uint8_t* bytes_next = picoquic_format_ack_frame(cnx, bytes, bytes + sizeof(bytes), &more_data, 0, pc, 0);\n399\t\n400\t            received_mask |= 1ull << (test_pn64[i] & 63);\n401\t\n402\t            if (check_ack_ranges(&cnx->ack_ctx[pc].sack_list) != 0) {\n403\t                ret = -1;\n404\t            }\n405\t\n406\t            if (ret == 0) {\n407\t                ret = basic_ack_parse(bytes, bytes_next - bytes, &expected_ack[i], &previous_mask, received_mask);\n408\t            }\n409\t\n410\t            if (ret != 0) {\n411\t                ret = -1; /* useless code, but helps with checkpointing */\n412\t            }\n413\t        }\n414\t    }\n415\t\n416\t    picoquic_test_delete_minimal_cnx(&quic, &cnx);\n417\t\n418\t    return ret;\n419\t}\n420\t\n421\tint sendack_loop_test_one(uint64_t ack_gap, uint64_t ack_delay)\n422\t{\n423\t    int ret = 0;\n424\t    picoquic_cnx_t * cnx;\n425\t    picoquic_quic_t * quic;\n426\t    uint64_t current_time;\n427\t    uint64_t next_ack_time = UINT64_MAX;\n428\t    uint64_t largest_received_number = 0;\n429\t    uint64_t largest_ack_number = 0;\n430\t    uint64_t largest_time_sent = 0;\n431\t    uint8_t bytes[256];\n432\t    picoquic_packet_context_enum pc = 0;\n433\t\n434\t    if (picoquic_test_set_minimal_cnx(&quic, &cnx) != 0) {\n435\t        return -1;\n436\t    }\n437\t\n438\t    if (picoquic_create_local_cnxid(cnx, 0, NULL, 0) == NULL) {\n439\t        return -1;\n440\t    }\n441\t\n442\t    //picoquic_sack_list_init(&cnx->ack_ctx[pc].sack_list);\n443\t    cnx->sending_ecn_ack = 0; /* don't write an ack_ecn frame */\n444\t    cnx->ack_delay_remote = ack_delay;\n445\t    cnx->ack_gap_remote = ack_gap;\n446\t\n447\t    if (check_ack_ranges(&cnx->ack_ctx[pc].sack_list) != 0) {\n448\t        ret = -1;\n449\t    }\n450\t\n451\t    for (size_t i = 0; ret == 0 && i < nb_test_pn64; i++) {\n452\t        int ack_sent = 0;\n453\t        int out_of_order = 0;\n454\t        current_time = ((uint64_t)i) * 1000;\n455\t\n456\t        if (picoquic_record_pn_received(cnx, pc, cnx->first_local_cnxid_list->local_cnxid_first, test_pn64[i], current_time) != 0) {\n457\t            ret = -1;\n458\t        }\n459\t        else {\n460\t            if (largest_received_number + 1 != test_pn64[i]) {\n461\t                out_of_order = 1;\n462\t            }\n463\t            picoquic_set_ack_needed(cnx, current_time, pc, cnx->path[0], out_of_order);\n464\t            if (next_ack_time > current_time + ack_delay) {\n465\t                next_ack_time = current_time + ack_delay;\n466\t            }\n467\t            if (largest_received_number < test_pn64[i]) {\n468\t                largest_received_number = test_pn64[i];\n469\t            }\n470\t\n471\t            if (check_ack_ranges(&cnx->ack_ctx[pc].sack_list) != 0) {\n472\t                ret = -1;\n473\t            }\n474\t        }\n475\t\n476\t        for (int k=0; ret == 0 && k < 5; k++){\n477\t            int more_data = 0;\n478\t            uint8_t* bytes_next = bytes;\n479\t            uint64_t next_wake_time = UINT64_MAX;\n480\t            size_t ack_length = 0;\n481\t\n482\t            current_time = ((uint64_t)i) * 1000 + ((uint64_t)k)*10;\n483\t            \n484\t            if (picoquic_is_ack_needed(cnx, current_time, &next_wake_time, pc, 0)) {\n485\t                bytes_next = picoquic_format_ack_frame(cnx, bytes_next, bytes + sizeof(bytes), &more_data,\n486\t                    current_time, pc, 0);\n487\t\n488\t                if (bytes_next == NULL) {\n489\t                    /* unexpected! */\n490\t                    ret = -1;\n491\t                }\n492\t                else if (more_data) {\n493\t                    /* unexpected */\n494\t                    ret = -1;\n495\t                }\n496\t                else {\n497\t                    ack_length = bytes_next - bytes;\n498\t                }\n499\t            }\n500\t            \n501\t            if (ret == 0) {\n502\t                if (ack_length == 0) {\n503\t                    if (!ack_sent) {\n504\t                        if (largest_ack_number + ack_gap < largest_received_number) {\n505\t                            DBG_PRINTF(\"Ack loop (%d,%d), missing ack by number\", i, k);\n506\t                            ret = -1;\n507\t                        }\n508\t                        else if (largest_time_sent + ack_delay < largest_time_sent) {\n509\t                            DBG_PRINTF(\"Ack loop (%d,%d), missing ack by time\", i, k);\n510\t                            ret = -1;\n511\t                        }\n512\t                    }\n513\t                }\n514\t                else {\n515\t                    if (ack_sent) {\n516\t                        DBG_PRINTF(\"Ack loop (%d,%d), duplicate ack\", i, k);\n517\t                        ret = -1;\n518\t                    }\n519\t                    else if (largest_ack_number + ack_gap > largest_received_number &&\n520\t                        largest_time_sent + ack_delay > current_time &&\n521\t                        !out_of_order) {\n522\t                        DBG_PRINTF(\"Ack loop (%d,%d), sent before time or number\", i, k);\n523\t                        ret = -1;\n524\t                    } else {\n525\t                        ack_sent = 1;\n526\t                        largest_ack_number = largest_received_number;\n527\t                        largest_time_sent = current_time;\n528\t                    }\n529\t                }\n530\t            }\n531\t        }\n532\t    }\n533\t\n534\t    picoquic_test_delete_minimal_cnx(&quic, &cnx);\n535\t\n536\t    return ret;\n537\t}\n538\t\n539\tint sendack_loop_test(void)\n540\t{\n541\t    int ret;\n542\t    uint64_t ack_gap[3] = { 0, 2, 10000 };\n543\t    uint64_t ack_delay[3] = { 0, 1000, 25 };\n544\t\n545\t    for (int i = 0; i < 3; i++) {\n546\t        if ((ret = sendack_loop_test_one(ack_gap[i], ack_delay[i])) != 0) {\n547\t            DBG_PRINTF(\"ack loop test (%\" PRIu64\", %\" PRIu64\") fails\", ack_gap[i], ack_delay[i]);\n548\t        }\n549\t    }\n550\t    return ret;\n551\t}\n552\t\n553\ttypedef struct st_test_ack_range_t {\n554\t    uint64_t range_min;\n555\t    uint64_t range_max;\n556\t} test_ack_range_t;\n557\t\n558\tstatic const test_ack_range_t ack_range[] = {\n559\t    { 1, 1000 },\n560\t    { 0, 0 },\n561\t    { 3001, 4000 },\n562\t    { 4001, 5000 },\n563\t    { 6001, 7000 },\n564\t    { 5001, 6000 },\n565\t    { 1501, 2500 },\n566\t    { 501, 1500 },\n567\t    { 501, 7500 }\n568\t};\n569\t\n570\tstatic const size_t nb_ack_range = sizeof(ack_range) / sizeof(test_ack_range_t);\n571\t\n572\tint ackrange_test(void)\n573\t{\n574\t    int ret = 0;\n575\t    picoquic_sack_list_t sack0;\n576\t\n577\t    picoquic_sack_list_init(&sack0);\n578\t\n579\t    for (size_t i = 0; ret == 0 && i < nb_ack_range; i++) {\n580\t        ret = picoquic_check_sack_list(&sack0,\n581\t            ack_range[i].range_min, ack_range[i].range_max);\n582\t\n583\t        if (ret == 0) {\n584\t            ret = picoquic_update_sack_list(&sack0,\n585\t                ack_range[i].range_min, ack_range[i].range_max, 0);\n586\t        }\n587\t\n588\t        if (ret == 0) {\n589\t            ret = check_ack_ranges(&sack0);\n590\t        }\n591\t\n592\t        for (size_t j = 0; j < i; j++) {\n593\t            if (picoquic_check_sack_list(&sack0,\n594\t                    ack_range[j].range_min, ack_range[j].range_max)\n595\t                == 0) {\n596\t                ret = -1;\n597\t                break;\n598\t            }\n599\t        }\n600\t\n601\t        if (ret != 0) {\n602\t            break;\n603\t        }\n604\t    }\n605\t\n606\t    if (ret == 0 && picoquic_sack_list_first(&sack0) != 0) {\n607\t        ret = -1;\n608\t    }\n609\t\n610\t    if (ret == 0 && picoquic_sack_list_last(&sack0)!= 7500) {\n611\t        ret = -1;\n612\t    }\n613\t\n614\t    if (ret == 0 && picoquic_sack_list_first_range(&sack0) != NULL) {\n615\t        ret = -1;\n616\t    }\n617\t\n618\t    picoquic_sack_list_free(&sack0);\n619\t\n620\t    return ret;\n621\t}\n622\t\n623\t\n624\t/* Examine what happens when the packets are received in disorder. In this test, even packets (0, 2..)\n625\t * are received through a high latency path, odd packets (1..3) through a low latency path, and the\n626\t * ack-of-ack is sent after 32 packets are received. The goal is to verify that ack ranges are\n627\t * retained long enough to allow for coalescing. We measure the maximum nimber of ack ranges in the mix.\n628\t * \n629\t * The \"horizon\" variant studies what happens when setting an \"horizon\" under which ack ranges shall\n630\t * be kept, in order to allow merging of ranges.\n631\t */\n632\t\n633\t#define ACK_DISORDER_LOG \"ack_disorder_test.csv\"\n634\t#define ACK_HORIZON_LOG \"ack_horizon_test.csv\"\n635\t\n636\ttypedef struct st_ack_disorder_ackk_t {\n637\t    uint64_t pn;\n638\t    uint64_t arrive_time;\n639\t    uint64_t ackk_time;\n640\t    size_t nb_ranges_arrive;\n641\t    size_t nb_ranges_ack;\n642\t    size_t nb_acked;\n643\t} ack_disorder_ackk_t;\n644\t\n645\tint ack_disorder_receive_pn(picoquic_sack_list_t * sack0,\n646\t    uint64_t pn, uint64_t next_time, uint64_t ack_interval,\n647\t    size_t * nb_ackk, size_t nb_ranges, ack_disorder_ackk_t* ackk_list)\n648\t{\n649\t    int ret = 0;\n650\t\n651\t    if (picoquic_update_sack_list(sack0, pn, pn, next_time) != 0) {\n652\t        ret = -1;\n653\t    }\n654\t    else if (*nb_ackk >= nb_ranges){\n655\t        ret = -1;\n656\t    }\n657\t    else {\n658\t        ackk_list[*nb_ackk].pn = pn;\n659\t        ackk_list[*nb_ackk].arrive_time = next_time;\n660\t        ackk_list[*nb_ackk].ackk_time = next_time + ack_interval;\n661\t        ackk_list[*nb_ackk].nb_ranges_arrive = picoquic_sack_list_size(sack0);\n662\t        ackk_list[*nb_ackk].nb_ranges_ack = 0;\n663\t        *nb_ackk += 1;\n664\t    }\n665\t    return ret;\n666\t}\n667\t\n668\tint ack_disorder_test_one(char const * log_name, int64_t horizon_delay, double range_average_max)\n669\t{\n670\t    size_t const nb_ranges = 1000;\n671\t    size_t const nb_even_ranges = nb_ranges / 2;\n672\t    size_t const nb_odd_ranges = nb_ranges - nb_even_ranges;\n673\t    uint64_t const low_latency = 11111;\n674\t    uint64_t const high_latency = 300000;\n675\t    uint64_t const ack_interval = 100000;\n676\t    uint64_t const packet_interval = 1000;\n677\t    ack_disorder_ackk_t* ackk_list = (ack_disorder_ackk_t*)malloc(nb_ranges * sizeof(ack_disorder_ackk_t));\n678\t    size_t nb_ackk = 0;\n679\t    size_t i_ackk = 0;\n680\t    size_t i_even_arrive = 0;\n681\t    size_t i_odd_arrive = 0;\n682\t    uint64_t t_even_arrive = low_latency;\n683\t    uint64_t t_odd_arrive = packet_interval + high_latency;\n684\t    uint64_t pn;\n685\t    int ret = 0;\n686\t    picoquic_sack_list_t sack0;\n687\t\n688\t    /* Initialize the test sack list */\n689\t    if (ackk_list == NULL) {\n690\t        ret = -1;\n691\t    } \n692\t    else {\n693\t        picoquic_sack_list_init(&sack0);\n694\t    }\n695\t\n696\t    sack0.horizon_delay = horizon_delay;\n697\t\n698\t    /* Run a loop to simulate arrival of packets and ack of ack */\n699\t    while (ret == 0 && (i_even_arrive < nb_even_ranges || i_odd_arrive < nb_odd_ranges || i_ackk < nb_ackk)) {\n700\t        uint64_t next_time = UINT64_MAX;\n701\t        int i_action = -1; /* by default do odd arrival */\n702\t\n703\t        if (i_odd_arrive < nb_odd_ranges) {\n704\t            i_action = 0;\n705\t            next_time = t_odd_arrive;\n706\t        }\n707\t\n708\t        if (i_even_arrive < nb_even_ranges && t_even_arrive < next_time) {\n709\t            i_action = 1;\n710\t            next_time = t_even_arrive;\n711\t        }\n712\t\n713\t        if (i_ackk < nb_ackk && ackk_list[i_ackk].ackk_time < next_time) {\n714\t            i_action = 2;\n715\t            next_time = ackk_list[i_ackk].ackk_time;\n716\t        }\n717\t\n718\t        switch (i_action) {\n719\t        case 0: /* arrival on odd path */\n720\t            pn = 2 * i_odd_arrive + 1;\n721\t            i_odd_arrive++;\n722\t            t_odd_arrive += packet_interval;\n723\t            if (ack_disorder_receive_pn(&sack0, pn, next_time, ack_interval, &nb_ackk, nb_ranges, ackk_list) != 0) {\n724\t                ret = -1;\n725\t            }\n726\t            break;\n727\t        case 1: /* arrival on even path */\n728\t            pn = 2 * i_even_arrive;\n729\t            i_even_arrive++;\n730\t            t_even_arrive += packet_interval;\n731\t            if (ack_disorder_receive_pn(&sack0, pn, next_time, ack_interval, &nb_ackk, nb_ranges, ackk_list) != 0) {\n732\t                ret = -1;\n733\t            }\n734\t            break;\n735\t        case 2: /* ack of ack */\n736\t            (void)picoquic_process_ack_of_ack_range(&sack0, NULL, ackk_list[i_ackk].pn, ackk_list[i_ackk].pn);\n737\t            ackk_list[i_ackk].nb_ranges_ack = picoquic_sack_list_size(&sack0);\n738\t            i_ackk++;\n739\t            break;\n740\t        }\n741\t    }\n742\t\n743\t\n744\t    if (ret == 0) {\n745\t        FILE* F = picoquic_file_open(log_name, \"w\");\n746\t\n747\t        if (F == NULL) {\n748\t            ret = -1;\n749\t        }\n750\t        else {\n751\t            fprintf(F, \"pn,arrive_time,ackk_time,nb_ranges_arrive,nb_ranges_ack\\n\");\n752\t            for (size_t i = 0; i < nb_ackk; i++) {\n753\t                (void)fprintf(F, \"%\"PRIu64 \", %\"PRIu64 \", %\"PRIu64 \", %zu, %zu\\n\",\n754\t                    ackk_list[i].pn, ackk_list[i].arrive_time, ackk_list[i].ackk_time,\n755\t                    ackk_list[i].nb_ranges_arrive, ackk_list[i].nb_ranges_ack);\n756\t            }\n757\t            (void) picoquic_file_close(F);\n758\t        }\n759\t    }\n760\t\n761\t    if (ret == 0) {\n762\t        /* Compute average number of ACK frames at ACK time */\n763\t        uint64_t sum_ranges_ack = 0;\n764\t        double range_average;\n765\t        for (size_t i = 0; i < nb_ackk; i++) {\n766\t            sum_ranges_ack += ackk_list[i].nb_ranges_ack;\n767\t        }\n768\t        range_average = (double)sum_ranges_ack / (double)nb_ackk;\n769\t        if (range_average > range_average_max) {\n770\t            DBG_PRINTF(\"Got %f ranges, larger than expected %f\", range_average, range_average_max);\n771\t            ret = -1;\n772\t        }\n773\t    }\n774\t\n775\t    if (ackk_list != NULL) {\n776\t        free(ackk_list);\n777\t    }\n778\t\n779\t    picoquic_sack_list_free(&sack0);\n780\t\n781\t    return ret;\n782\t}\n783\t\n784\tint ack_disorder_test(void)\n785\t{\n786\t    int ret = ack_disorder_test_one(ACK_DISORDER_LOG, 0, 133.0);\n787\t    return ret;\n788\t}\n789\t\n790\tint ack_horizon_test(void)\n791\t{\n792\t    int ret = ack_disorder_test_one(ACK_HORIZON_LOG, 1000000, 196.0);\n793\t    return ret;\n794\t}\n795\t"}]},"parent_tool_use_id":null,"session_id":"c7c7e82c-a907-4d1f-a2c6-fbe9ac637b5e","uuid":"d8724e9d-0c10-4c13-83d9-d4d19559d4a5","timestamp":"2026-05-04T18:25:23.545Z","tool_use_result":{"type":"text","file":{"filePath":"/Users/richbarn/Projects/picoquic/picoquictest/sacktest.c","content":"/*\n* Author: Christian Huitema\n* Copyright (c) 2017, Private Octopus, Inc.\n* All rights reserved.\n*\n* Permission to use, copy, modify, and distribute this software for any\n* purpose with or without fee is hereby granted, provided that the above\n* copyright notice and this permission notice appear in all copies.\n*\n* THIS SOFTWARE IS PROVIDED BY THE COPYRIGHT HOLDERS AND CONTRIBUTORS \"AS IS\" AND\n* ANY EXPRESS OR IMPLIED WARRANTIES, INCLUDING, BUT NOT LIMITED TO, THE IMPLIED\n* WARRANTIES OF MERCHANTABILITY AND FITNESS FOR A PARTICULAR PURPOSE ARE\n* DISCLAIMED. IN NO EVENT SHALL Private Octopus, Inc. BE LIABLE FOR ANY\n* DIRECT, INDIRECT, INCIDENTAL, SPECIAL, EXEMPLARY, OR CONSEQUENTIAL DAMAGES\n* (INCLUDING, BUT NOT LIMITED TO, PROCUREMENT OF SUBSTITUTE GOODS OR SERVICES;\n* LOSS OF USE, DATA, OR PROFITS; OR BUSINESS INTERRUPTION) HOWEVER CAUSED AND\n* ON ANY THEORY OF LIABILITY, WHETHER IN CONTRACT, STRICT LIABILITY, OR TORT\n* (INCLUDING NEGLIGENCE OR OTHERWISE) ARISING IN ANY WAY OUT OF THE USE OF THIS\n* SOFTWARE, EVEN IF ADVISED OF THE POSSIBILITY OF SUCH DAMAGE.\n*/\n\n#include \"picoquic_internal.h\"\n#include <stdlib.h>\n#include <string.h>\n\n/* Utility function to set minimal quic and cnx contexts\n */\nint picoquic_test_set_minimal_cnx_with_time(picoquic_quic_t** quic, picoquic_cnx_t** cnx, uint64_t * simulated_time)\n{\n    *cnx = NULL;\n    *quic = picoquic_create(8, NULL, NULL, NULL, NULL, NULL,\n        NULL, NULL, NULL, NULL, 0, simulated_time, NULL, NULL, 0);\n    if (*quic != NULL) {\n        *cnx = picoquic_create_cnx(*quic,\n            picoquic_null_connection_id,\n            picoquic_null_connection_id,\n            NULL, 0,\n            0, PICOQUIC_TEST_SNI, \"minimal\", 1);\n        if (*cnx == NULL) {\n            picoquic_free(*quic);\n            *quic = NULL;\n        }\n    }\n    return (*quic == NULL || *cnx == NULL);\n}\n\nint picoquic_test_set_minimal_cnx(picoquic_quic_t** quic, picoquic_cnx_t** cnx)\n{\n    return picoquic_test_set_minimal_cnx_with_time(quic, cnx, NULL);\n}\n\nint picoquic_test_reset_minimal_cnx(picoquic_quic_t* quic, picoquic_cnx_t** cnx)\n{\n    if (*cnx != NULL) {\n        picoquic_delete_cnx(*cnx);\n    }\n    *cnx = picoquic_create_cnx(quic,\n        picoquic_null_connection_id,\n        picoquic_null_connection_id,\n        NULL, 0,\n        0, PICOQUIC_TEST_SNI, \"minimal\", 1);\n    return (*cnx == NULL) ? -1 : 0;\n}\n\nvoid picoquic_test_delete_minimal_cnx(picoquic_quic_t** quic, picoquic_cnx_t** cnx)\n{\n    if (*cnx != NULL) {\n        picoquic_delete_cnx(*cnx);\n        *cnx = NULL;\n    }\n    if (*quic != NULL) {\n        picoquic_free(*quic);\n        *quic = NULL;\n    }\n}\n/*\n * Test of the SACK functionality\n */\n\nstatic const uint64_t test_pn64[] = {\n    3, 4, 0, 2, 7, 8, 11, 12, 13, 17, 19, 21, 18, 16, 20, 10, 5, 6, 9, 1, 14, 15\n};\n\nstatic const size_t nb_test_pn64 = sizeof(test_pn64) / sizeof(uint64_t);\n\nstruct expected_ack_t {\n    uint64_t highest_received;\n    uint64_t last_range;\n    uint8_t num_blocks;\n};\n\nstatic struct expected_ack_t expected_ack[] = {\n    { 3, 0, 0 },\n    { 4, 1, 0 },\n    { 4, 1, 1 },\n    { 4, 2, 1 },\n    { 7, 0, 2 },\n    { 8, 1, 2 },\n    { 11, 0, 3 },\n    { 12, 1, 2 },\n    { 13, 2, 1 },\n    { 17, 0, 2 },\n    { 19, 0, 2 },\n    { 21, 0, 3 },\n    { 21, 0, 2 },\n    { 21, 0, 1 },\n    { 21, 5, 0 },\n    { 21, 5, 1 },\n    { 21, 5, 2 },\n    { 21, 5, 2 },\n    { 21, 5, 1 },\n    { 21, 5, 1 },\n    { 21, 5, 1 },\n    { 21, 21, 0 }\n};\n\n\nint check_ack_ranges(picoquic_sack_list_t* sack_list)\n{\n    int ret = 0;\n\n    for (int r = 0; r < 2; r++) {\n        int range_sum[PICOQUIC_MAX_ACK_RANGE_REPEAT] = { 0 };\n        picoquic_sack_item_t* sack = picoquic_sack_first_item(sack_list);\n\n        while (sack != NULL) {\n            if (sack->nb_times_sent[r] < 0) {\n                ret = -1;\n                break;\n            }\n            else if (sack->nb_times_sent[r] < PICOQUIC_MAX_ACK_RANGE_REPEAT) {\n                range_sum[sack->nb_times_sent[r]] += 1;\n            }\n            sack = picoquic_sack_next_item(sack);\n        }\n\n        for (int i = 0; ret == 0 && i < PICOQUIC_MAX_ACK_RANGE_REPEAT; i++) {\n            if (sack_list->rc[r].range_counts[i] != range_sum[i]) {\n                ret = -1;\n            }\n        }\n    }\n    return ret;\n}\n\n\nint sacktest(void)\n{\n    int ret = 0;\n    picoquic_cnx_t *cnx;\n    picoquic_quic_t* quic;\n    uint64_t current_time = 0;\n    uint64_t highest_seen = 0;\n    uint64_t highest_seen_time = 0;\n    picoquic_packet_context_enum pc = 0;\n\n    if (picoquic_test_set_minimal_cnx(&quic, &cnx) != 0) {\n        return -1;\n    }\n\n    if (picoquic_create_local_cnxid(cnx, 0, NULL, 0) == NULL) {\n        return -1;\n    }\n\n    /* Do a basic test with packet zero */\n    if (picoquic_is_pn_already_received(cnx, pc,\n        cnx->first_local_cnxid_list->local_cnxid_first, 0) != 0) {\n        ret = -1;\n    }\n    else if (picoquic_record_pn_received(cnx, pc, cnx->first_local_cnxid_list->local_cnxid_first,\n        0, current_time) != 0) {\n        ret = -1;\n    }\n    else if (picoquic_is_pn_already_received(cnx, pc,\n        cnx->first_local_cnxid_list->local_cnxid_first, 0) == 0) {\n        ret = -1;\n    }\n    else if (picoquic_sack_list_first(&cnx->ack_ctx[pc].sack_list) != 0 ||\n        picoquic_sack_list_last(&cnx->ack_ctx[pc].sack_list) != 0 ||\n        picoquic_sack_list_first_range(&cnx->ack_ctx[pc].sack_list) != NULL) {\n        ret = -1;\n    }\n    else {\n        /* reset for the next test */\n        picoquic_test_reset_minimal_cnx(quic, &cnx);\n    }\n\n    if (ret == 0) {\n        ret = check_ack_ranges(&cnx->ack_ctx[pc].sack_list);\n    }\n\n    for (size_t i = 0; ret == 0 && i < nb_test_pn64; i++) {\n        current_time = ((uint64_t)i) * 100 + 1;\n\n        if (test_pn64[i] > highest_seen) {\n            highest_seen = test_pn64[i];\n            highest_seen_time = current_time;\n        }\n\n        if (picoquic_record_pn_received(cnx, pc, cnx->first_local_cnxid_list->local_cnxid_first, test_pn64[i], current_time) != 0) {\n            ret = -1;\n        }\n\n        if (ret == 0) {\n            ret = check_ack_ranges(&cnx->ack_ctx[pc].sack_list);\n        }\n\n        for (size_t j = 0; ret == 0 && j <= i; j++) {\n            if (picoquic_is_pn_already_received(cnx, pc,\n                cnx->first_local_cnxid_list->local_cnxid_first, test_pn64[j]) == 0) {\n                ret = -1;\n            }\n\n            if (picoquic_record_pn_received(cnx, pc, cnx->first_local_cnxid_list->local_cnxid_first, test_pn64[j], current_time) != 1) {\n                ret = -1;\n            }\n        }\n\n        for (size_t j = i + 1; ret == 0 && j < nb_test_pn64; j++) {\n            if (picoquic_is_pn_already_received(cnx, pc,\n                cnx->first_local_cnxid_list->local_cnxid_first, test_pn64[j]) != 0) {\n                ret = -1;\n            }\n        }\n    }\n\n    if (ret == 0) {\n        if (picoquic_sack_list_last(&cnx->ack_ctx[pc].sack_list) != 21 ||\n            picoquic_sack_list_first(&cnx->ack_ctx[pc].sack_list) != 0 ||\n            cnx->ack_ctx[pc].time_stamp_largest_received != highest_seen_time ||\n            picoquic_sack_list_first_range(&cnx->ack_ctx[pc].sack_list) != NULL) {\n            ret = -1;\n        }\n    }\n\n    /* Free the sack lists*/\n    picoquic_test_delete_minimal_cnx(&quic, &cnx);\n\n    return ret;\n}\n\nstatic void ack_range_mask(uint64_t* mask, uint64_t highest, uint64_t range)\n{\n    for (uint64_t i = 0; i < range; i++) {\n        *mask |= 1ull << (highest & 63);\n        highest--;\n    }\n}\n\nstatic int basic_ack_parse(uint8_t* bytes, size_t bytes_max,\n    struct expected_ack_t* expected_ack, uint64_t * previous_mask, uint64_t expected_mask)\n{\n    int ret = 0;\n    size_t byte_index = 1;\n    uint8_t first_byte = bytes[0];\n    uint64_t num_block = 0;\n    uint64_t largest = 0;\n    uint64_t last_range = 0;\n    uint64_t ack_range = 0;\n    uint64_t acked_mask = 0;\n    uint64_t gap_begin = 0;\n    size_t l_largest = 0;\n    size_t l_delay = 0;\n    size_t l_num_block = 0;\n    size_t l_last_range = 0;\n\n    if (first_byte != picoquic_frame_type_ack) {\n        ret = -1;\n    } else {\n        /* Largest */\n        if (byte_index < bytes_max) {\n            l_largest = picoquic_varint_decode(bytes + byte_index, bytes_max - byte_index, &largest);\n            byte_index += l_largest;\n        }\n\n        /* ACK delay */\n        if (byte_index < bytes_max) {\n            l_delay = picoquic_varint_skip(bytes + byte_index);\n            byte_index += l_delay;\n        }\n\n        /* Num blocks */\n        if (byte_index < bytes_max) {\n            l_num_block = picoquic_varint_decode(bytes + byte_index, bytes_max - byte_index, &num_block);\n            byte_index += l_num_block;\n        }\n\n        /* last range */\n        if (byte_index < bytes_max) {\n            l_last_range = picoquic_varint_decode(bytes + byte_index, bytes_max - byte_index, &last_range);\n            byte_index += l_last_range;\n        }\n\n        if (l_largest == 0 || l_delay == 0 || l_num_block == 0 || l_last_range == 0 || byte_index > bytes_max) {\n            ret = -1;\n        } else {\n            if (last_range <= largest) {\n                ack_range_mask(&acked_mask, largest, last_range + 1);\n                gap_begin = largest - last_range - 1;\n            } else {\n                ret = -1;\n            }\n\n            for (uint64_t i = 0; ret == 0 && i < num_block; i++) {\n                size_t l_gap = 0;\n                size_t l_range = 0;\n                uint64_t gap = 0;\n\n                /* Decode the gap */\n                if (byte_index < bytes_max) {\n                    l_gap = picoquic_varint_decode(bytes + byte_index, bytes_max - byte_index, &gap);\n                    byte_index += l_gap;\n                    gap += 1;\n                }\n                /* decode the range */\n                if (byte_index < bytes_max) {\n                    l_range = picoquic_varint_decode(bytes + byte_index, bytes_max - byte_index, &ack_range);\n                    byte_index += l_range;\n                }\n                if (l_gap == 0 || l_range == 0) {\n                    ret = -1;\n                } else if (gap > gap_begin) {\n                    ret = -1;\n                } else {\n                    gap_begin -= gap;\n\n                    if (gap_begin >= ack_range) {\n                        /* mark the range as received */\n                        ack_range_mask(&acked_mask, gap_begin, ++ack_range);\n\n                        /* start of next gap */\n                        gap_begin -= ack_range;\n                    } else {\n                        ret = -1;\n                    }\n                }\n            }\n        }\n\n        if (ret == 0) {\n            if (byte_index != bytes_max) {\n                ret = -1;\n            }\n        }\n\n        if (ret == 0) {\n            if (largest != expected_ack->highest_received || last_range != expected_ack->last_range || num_block != expected_ack->num_blocks) {\n                ret = -1;\n            }\n        }\n\n        if (ret == 0) {\n            acked_mask |= *previous_mask;\n            if (acked_mask != expected_mask) {\n                ret = -1;\n            }\n            *previous_mask = acked_mask;\n        }\n    }\n\n    return ret;\n}\n\n\nint sendacktest(void)\n{\n    int ret = 0;\n    picoquic_quic_t* quic;\n    picoquic_cnx_t * cnx;\n    uint64_t current_time;\n    uint64_t received_mask = 0;\n    uint64_t previous_mask = 0;\n    uint8_t bytes[256];\n    picoquic_packet_context_enum pc = 0;\n\n    if (picoquic_test_set_minimal_cnx(&quic, &cnx) != 0) {\n        return -1;\n    }\n    cnx->sending_ecn_ack = 0; /* don't write an ack_ecn frame */\n    \n    if (check_ack_ranges(&cnx->ack_ctx[pc].sack_list) != 0) {\n        ret = -1;\n    }\n\n    for (size_t i = 0; ret == 0 && i < nb_test_pn64; i++) {\n        current_time = ((uint64_t)i) * 100;\n\n        if (picoquic_record_pn_received(cnx, pc, cnx->first_local_cnxid_list->local_cnxid_first, test_pn64[i], current_time) != 0) {\n            ret = -1;\n        }\n\n        if (check_ack_ranges(&cnx->ack_ctx[pc].sack_list) != 0) {\n            ret = -1;\n        }\n\n        if (ret == 0) {\n            int more_data = 0;\n            uint8_t* bytes_next = picoquic_format_ack_frame(cnx, bytes, bytes + sizeof(bytes), &more_data, 0, pc, 0);\n\n            received_mask |= 1ull << (test_pn64[i] & 63);\n\n            if (check_ack_ranges(&cnx->ack_ctx[pc].sack_list) != 0) {\n                ret = -1;\n            }\n\n            if (ret == 0) {\n                ret = basic_ack_parse(bytes, bytes_next - bytes, &expected_ack[i], &previous_mask, received_mask);\n            }\n\n            if (ret != 0) {\n                ret = -1; /* useless code, but helps with checkpointing */\n            }\n        }\n    }\n\n    picoquic_test_delete_minimal_cnx(&quic, &cnx);\n\n    return ret;\n}\n\nint sendack_loop_test_one(uint64_t ack_gap, uint64_t ack_delay)\n{\n    int ret = 0;\n    picoquic_cnx_t * cnx;\n    picoquic_quic_t * quic;\n    uint64_t current_time;\n    uint64_t next_ack_time = UINT64_MAX;\n    uint64_t largest_received_number = 0;\n    uint64_t largest_ack_number = 0;\n    uint64_t largest_time_sent = 0;\n    uint8_t bytes[256];\n    picoquic_packet_context_enum pc = 0;\n\n    if (picoquic_test_set_minimal_cnx(&quic, &cnx) != 0) {\n        return -1;\n    }\n\n    if (picoquic_create_local_cnxid(cnx, 0, NULL, 0) == NULL) {\n        return -1;\n    }\n\n    //picoquic_sack_list_init(&cnx->ack_ctx[pc].sack_list);\n    cnx->sending_ecn_ack = 0; /* don't write an ack_ecn frame */\n    cnx->ack_delay_remote = ack_delay;\n    cnx->ack_gap_remote = ack_gap;\n\n    if (check_ack_ranges(&cnx->ack_ctx[pc].sack_list) != 0) {\n        ret = -1;\n    }\n\n    for (size_t i = 0; ret == 0 && i < nb_test_pn64; i++) {\n        int ack_sent = 0;\n        int out_of_order = 0;\n        current_time = ((uint64_t)i) * 1000;\n\n        if (picoquic_record_pn_received(cnx, pc, cnx->first_local_cnxid_list->local_cnxid_first, test_pn64[i], current_time) != 0) {\n            ret = -1;\n        }\n        else {\n            if (largest_received_number + 1 != test_pn64[i]) {\n                out_of_order = 1;\n            }\n            picoquic_set_ack_needed(cnx, current_time, pc, cnx->path[0], out_of_order);\n            if (next_ack_time > current_time + ack_delay) {\n                next_ack_time = current_time + ack_delay;\n            }\n            if (largest_received_number < test_pn64[i]) {\n                largest_received_number = test_pn64[i];\n            }\n\n            if (check_ack_ranges(&cnx->ack_ctx[pc].sack_list) != 0) {\n                ret = -1;\n            }\n        }\n\n        for (int k=0; ret == 0 && k < 5; k++){\n            int more_data = 0;\n            uint8_t* bytes_next = bytes;\n            uint64_t next_wake_time = UINT64_MAX;\n            size_t ack_length = 0;\n\n            current_time = ((uint64_t)i) * 1000 + ((uint64_t)k)*10;\n            \n            if (picoquic_is_ack_needed(cnx, current_time, &next_wake_time, pc, 0)) {\n                bytes_next = picoquic_format_ack_frame(cnx, bytes_next, bytes + sizeof(bytes), &more_data,\n                    current_time, pc, 0);\n\n                if (bytes_next == NULL) {\n                    /* unexpected! */\n                    ret = -1;\n                }\n                else if (more_data) {\n                    /* unexpected */\n                    ret = -1;\n                }\n                else {\n                    ack_length = bytes_next - bytes;\n                }\n            }\n            \n            if (ret == 0) {\n                if (ack_length == 0) {\n                    if (!ack_sent) {\n                        if (largest_ack_number + ack_gap < largest_received_number) {\n                            DBG_PRINTF(\"Ack loop (%d,%d), missing ack by number\", i, k);\n                            ret = -1;\n                        }\n                        else if (largest_time_sent + ack_delay < largest_time_sent) {\n                            DBG_PRINTF(\"Ack loop (%d,%d), missing ack by time\", i, k);\n                            ret = -1;\n                        }\n                    }\n                }\n                else {\n                    if (ack_sent) {\n                        DBG_PRINTF(\"Ack loop (%d,%d), duplicate ack\", i, k);\n                        ret = -1;\n                    }\n                    else if (largest_ack_number + ack_gap > largest_received_number &&\n                        largest_time_sent + ack_delay > current_time &&\n                        !out_of_order) {\n                        DBG_PRINTF(\"Ack loop (%d,%d), sent before time or number\", i, k);\n                        ret = -1;\n                    } else {\n                        ack_sent = 1;\n                        largest_ack_number = largest_received_number;\n                        largest_time_sent = current_time;\n                    }\n                }\n            }\n        }\n    }\n\n    picoquic_test_delete_minimal_cnx(&quic, &cnx);\n\n    return ret;\n}\n\nint sendack_loop_test(void)\n{\n    int ret;\n    uint64_t ack_gap[3] = { 0, 2, 10000 };\n    uint64_t ack_delay[3] = { 0, 1000, 25 };\n\n    for (int i = 0; i < 3; i++) {\n        if ((ret = sendack_loop_test_one(ack_gap[i], ack_delay[i])) != 0) {\n            DBG_PRINTF(\"ack loop test (%\" PRIu64\", %\" PRIu64\") fails\", ack_gap[i], ack_delay[i]);\n        }\n    }\n    return ret;\n}\n\ntypedef struct st_test_ack_range_t {\n    uint64_t range_min;\n    uint64_t range_max;\n} test_ack_range_t;\n\nstatic const test_ack_range_t ack_range[] = {\n    { 1, 1000 },\n    { 0, 0 },\n    { 3001, 4000 },\n    { 4001, 5000 },\n    { 6001, 7000 },\n    { 5001, 6000 },\n    { 1501, 2500 },\n    { 501, 1500 },\n    { 501, 7500 }\n};\n\nstatic const size_t nb_ack_range = sizeof(ack_range) / sizeof(test_ack_range_t);\n\nint ackrange_test(void)\n{\n    int ret = 0;\n    picoquic_sack_list_t sack0;\n\n    picoquic_sack_list_init(&sack0);\n\n    for (size_t i = 0; ret == 0 && i < nb_ack_range; i++) {\n        ret = picoquic_check_sack_list(&sack0,\n            ack_range[i].range_min, ack_range[i].range_max);\n\n        if (ret == 0) {\n            ret = picoquic_update_sack_list(&sack0,\n                ack_range[i].range_min, ack_range[i].range_max, 0);\n        }\n\n        if (ret == 0) {\n            ret = check_ack_ranges(&sack0);\n        }\n\n        for (size_t j = 0; j < i; j++) {\n            if (picoquic_check_sack_list(&sack0,\n                    ack_range[j].range_min, ack_range[j].range_max)\n                == 0) {\n                ret = -1;\n                break;\n            }\n        }\n\n        if (ret != 0) {\n            break;\n        }\n    }\n\n    if (ret == 0 && picoquic_sack_list_first(&sack0) != 0) {\n        ret = -1;\n    }\n\n    if (ret == 0 && picoquic_sack_list_last(&sack0)!= 7500) {\n        ret = -1;\n    }\n\n    if (ret == 0 && picoquic_sack_list_first_range(&sack0) != NULL) {\n        ret = -1;\n    }\n\n    picoquic_sack_list_free(&sack0);\n\n    return ret;\n}\n\n\n/* Examine what happens when the packets are received in disorder. In this test, even packets (0, 2..)\n * are received through a high latency path, odd packets (1..3) through a low latency path, and the\n * ack-of-ack is sent after 32 packets are received. The goal is to verify that ack ranges are\n * retained long enough to allow for coalescing. We measure the maximum nimber of ack ranges in the mix.\n * \n * The \"horizon\" variant studies what happens when setting an \"horizon\" under which ack ranges shall\n * be kept, in order to allow merging of ranges.\n */\n\n#define ACK_DISORDER_LOG \"ack_disorder_test.csv\"\n#define ACK_HORIZON_LOG \"ack_horizon_test.csv\"\n\ntypedef struct st_ack_disorder_ackk_t {\n    uint64_t pn;\n    uint64_t arrive_time;\n    uint64_t ackk_time;\n    size_t nb_ranges_arrive;\n    size_t nb_ranges_ack;\n    size_t nb_acked;\n} ack_disorder_ackk_t;\n\nint ack_disorder_receive_pn(picoquic_sack_list_t * sack0,\n    uint64_t pn, uint64_t next_time, uint64_t ack_interval,\n    size_t * nb_ackk, size_t nb_ranges, ack_disorder_ackk_t* ackk_list)\n{\n    int ret = 0;\n\n    if (picoquic_update_sack_list(sack0, pn, pn, next_time) != 0) {\n        ret = -1;\n    }\n    else if (*nb_ackk >= nb_ranges){\n        ret = -1;\n    }\n    else {\n        ackk_list[*nb_ackk].pn = pn;\n        ackk_list[*nb_ackk].arrive_time = next_time;\n        ackk_list[*nb_ackk].ackk_time = next_time + ack_interval;\n        ackk_list[*nb_ackk].nb_ranges_arrive = picoquic_sack_list_size(sack0);\n        ackk_list[*nb_ackk].nb_ranges_ack = 0;\n        *nb_ackk += 1;\n    }\n    return ret;\n}\n\nint ack_disorder_test_one(char const * log_name, int64_t horizon_delay, double range_average_max)\n{\n    size_t const nb_ranges = 1000;\n    size_t const nb_even_ranges = nb_ranges / 2;\n    size_t const nb_odd_ranges = nb_ranges - nb_even_ranges;\n    uint64_t const low_latency = 11111;\n    uint64_t const high_latency = 300000;\n    uint64_t const ack_interval = 100000;\n    uint64_t const packet_interval = 1000;\n    ack_disorder_ackk_t* ackk_list = (ack_disorder_ackk_t*)malloc(nb_ranges * sizeof(ack_disorder_ackk_t));\n    size_t nb_ackk = 0;\n    size_t i_ackk = 0;\n    size_t i_even_arrive = 0;\n    size_t i_odd_arrive = 0;\n    uint64_t t_even_arrive = low_latency;\n    uint64_t t_odd_arrive = packet_interval + high_latency;\n    uint64_t pn;\n    int ret = 0;\n    picoquic_sack_list_t sack0;\n\n    /* Initialize the test sack list */\n    if (ackk_list == NULL) {\n        ret = -1;\n    } \n    else {\n        picoquic_sack_list_init(&sack0);\n    }\n\n    sack0.horizon_delay = horizon_delay;\n\n    /* Run a loop to simulate arrival of packets and ack of ack */\n    while (ret == 0 && (i_even_arrive < nb_even_ranges || i_odd_arrive < nb_odd_ranges || i_ackk < nb_ackk)) {\n        uint64_t next_time = UINT64_MAX;\n        int i_action = -1; /* by default do odd arrival */\n\n        if (i_odd_arrive < nb_odd_ranges) {\n            i_action = 0;\n            next_time = t_odd_arrive;\n        }\n\n        if (i_even_arrive < nb_even_ranges && t_even_arrive < next_time) {\n            i_action = 1;\n            next_time = t_even_arrive;\n        }\n\n        if (i_ackk < nb_ackk && ackk_list[i_ackk].ackk_time < next_time) {\n            i_action = 2;\n            next_time = ackk_list[i_ackk].ackk_time;\n        }\n\n        switch (i_action) {\n        case 0: /* arrival on odd path */\n            pn = 2 * i_odd_arrive + 1;\n            i_odd_arrive++;\n            t_odd_arrive += packet_interval;\n            if (ack_disorder_receive_pn(&sack0, pn, next_time, ack_interval, &nb_ackk, nb_ranges, ackk_list) != 0) {\n                ret = -1;\n            }\n            break;\n        case 1: /* arrival on even path */\n            pn = 2 * i_even_arrive;\n            i_even_arrive++;\n            t_even_arrive += packet_interval;\n            if (ack_disorder_receive_pn(&sack0, pn, next_time, ack_interval, &nb_ackk, nb_ranges, ackk_list) != 0) {\n                ret = -1;\n            }\n            break;\n        case 2: /* ack of ack */\n            (void)picoquic_process_ack_of_ack_range(&sack0, NULL, ackk_list[i_ackk].pn, ackk_list[i_ackk].pn);\n            ackk_list[i_ackk].nb_ranges_ack = picoquic_sack_list_size(&sack0);\n            i_ackk++;\n            break;\n        }\n    }\n\n\n    if (ret == 0) {\n        FILE* F = picoquic_file_open(log_name, \"w\");\n\n        if (F == NULL) {\n            ret = -1;\n        }\n        else {\n            fprintf(F, \"pn,arrive_time,ackk_time,nb_ranges_arrive,nb_ranges_ack\\n\");\n            for (size_t i = 0; i < nb_ackk; i++) {\n                (void)fprintf(F, \"%\"PRIu64 \", %\"PRIu64 \", %\"PRIu64 \", %zu, %zu\\n\",\n                    ackk_list[i].pn, ackk_list[i].arrive_time, ackk_list[i].ackk_time,\n                    ackk_list[i].nb_ranges_arrive, ackk_list[i].nb_ranges_ack);\n            }\n            (void) picoquic_file_close(F);\n        }\n    }\n\n    if (ret == 0) {\n        /* Compute average number of ACK frames at ACK time */\n        uint64_t sum_ranges_ack = 0;\n        double range_average;\n        for (size_t i = 0; i < nb_ackk; i++) {\n            sum_ranges_ack += ackk_list[i].nb_ranges_ack;\n        }\n        range_average = (double)sum_ranges_ack / (double)nb_ackk;\n        if (range_average > range_average_max) {\n            DBG_PRINTF(\"Got %f ranges, larger than expected %f\", range_average, range_average_max);\n            ret = -1;\n        }\n    }\n\n    if (ackk_list != NULL) {\n        free(ackk_list);\n    }\n\n    picoquic_sack_list_free(&sack0);\n\n    return ret;\n}\n\nint ack_disorder_test(void)\n{\n    int ret = ack_disorder_test_one(ACK_DISORDER_LOG, 0, 133.0);\n    return ret;\n}\n\nint ack_horizon_test(void)\n{\n    int ret = ack_disorder_test_one(ACK_HORIZON_LOG, 1000000, 196.0);\n    return ret;\n}\n","numLines":795,"startLine":1,"totalLines":795}}}
