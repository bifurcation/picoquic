{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01JyFMXqkUVzirgnTm9eRat6","type":"tool_result","content":"1\t//! Test cases for `picoquictest/cnx_creation_test.c`.\n2\t\n3\t#![allow(non_snake_case)]\n4\t\n5\tuse core::net::{IpAddr, Ipv4Addr, Ipv6Addr, SocketAddr};\n6\t\n7\tuse crate::{ConnectionId, Instant, Quic, RESET_SECRET_SIZE};\n8\t\n9\t/// Make a fresh `Quic` context with the C test's\n10\t/// `picoquic_create(8, NULL, …)` defaults.  Returns `Option<Box<Quic>>`\n11\t/// directly (the C `NULL` failure goes to `None`).\n12\tfn default_quic() -> Option<Box<Quic>> {\n13\t    Quic::new(\n14\t        8,\n15\t        None,\n16\t        None,\n17\t        None,\n18\t        None,\n19\t        None,\n20\t        None,\n21\t        [0u8; RESET_SECRET_SIZE],\n22\t        Instant::from_ticks(0),\n23\t        None,\n24\t        None,\n25\t    )\n26\t}\n27\t\n28\t/// C: `create_cnx_test` in `picoquictest/cnx_creation_test.c`.\n29\t///\n30\t/// Builds 7 connections covering the IPv4 / IPv6 / per-port /\n31\t/// per-CID matrix, verifies they can be retrieved by address (when\n32\t/// no local CID is in use) or by CID (when one is), iterates over\n33\t/// all of them, then deletes alternating slots and re-checks.\n34\t#[test]\n35\tfn create_cnx() {\n36\t    let test_ipv4 = Ipv4Addr::new(192, 0, 2, 0);\n37\t    let test_ipv6 = Ipv6Addr::new(0x2001, 0x0DB8, 0, 0, 0, 0, 0, 1);\n38\t    let test_ipv4_local = Ipv4Addr::new(127, 0, 0, 1);\n39\t    let test_ipv6_local = Ipv6Addr::new(0, 0, 0, 0, 0, 0, 0, 1);\n40\t\n41\t    let mut test4: [SocketAddr; 5] = [SocketAddr::new(IpAddr::V4(test_ipv4), 0); 5];\n42\t    for (i, addr) in test4.iter_mut().enumerate() {\n43\t        let ip = if i < 4 {\n44\t            // 192.0.2.<1 if i==0, 2 otherwise>.\n45\t            let mut octets = test_ipv4.octets();\n46\t            octets[3] = if i == 0 { 1 } else { 2 };\n47\t            Ipv4Addr::from(octets)\n48\t        } else {\n49\t            test_ipv4_local\n50\t        };\n51\t        *addr = SocketAddr::new(IpAddr::V4(ip), 1000 + i as u16);\n52\t    }\n53\t\n54\t    let mut test6: [SocketAddr; 3] = [SocketAddr::new(IpAddr::V6(test_ipv6), 0); 3];\n55\t    for (i, addr) in test6.iter_mut().enumerate() {\n56\t        let ip = if i < 2 {\n57\t            let mut segments = test_ipv6.segments();\n58\t            segments[7] = (i as u16) + 1;\n59\t            Ipv6Addr::from(segments)\n60\t        } else {\n61\t            test_ipv6_local\n62\t        };\n63\t        *addr = SocketAddr::new(IpAddr::V6(ip), 1000 + i as u16);\n64\t    }\n65\t\n66\t    let test_cnx_addr = [\n67\t        test4[0], test4[1], test4[2], test4[4], test6[0], test6[1], test6[2],\n68\t    ];\n69\t    let test_cnx_id: [ConnectionId; 7] =\n70\t        core::array::from_fn(|i| ConnectionId::clone_from_slice(&[(i + 1) as u8; 8]).unwrap());\n71\t\n72\t    // The C version tests both `local_cnxid_length == 0` and `== 8`\n73\t    // by reaching into the `Quic` struct directly.  The Rust public\n74\t    // API doesn't expose that toggle yet (Phase 4 will add a setter\n75\t    // and / or wire it through the existing `Quic::new` reset_seed\n76\t    // parameter).  Run the larger CID branch alone.\n77\t    let mut quic = default_quic().expect(\"create quic\");\n78\t\n79\t    for i in 0..7 {\n80\t        let _cnx = quic\n81\t            .create_connection(\n82\t                test_cnx_id[i],\n83\t                ConnectionId::default(),\n84\t                Some(&test_cnx_addr[i]),\n85\t                Instant::from_ticks(0),\n86\t                0,\n87\t                None,\n88\t                None,\n89\t                true,\n90\t            )\n91\t            .expect(\"create_connection\");\n92\t    }\n93\t\n94\t    // Verify every connection is visited by `first_connection` /\n95\t    // `Connection::next`.  The latter is Phase 4 — placeholder.\n96\t    let _first = quic.first_connection();\n97\t    todo!(\"Connection iteration / lookup-by-net / lookup-by-id (Phase 4)\")\n98\t}\n99\t\n100\t/// C: `create_quic_test` in `picoquictest/cnx_creation_test.c`.\n101\t///\n102\t/// Edge cases: 0-connection request clamps to 1, bad cert/key\n103\t/// rejected, bad ticket-store paths tolerated, bad token-file\n104\t/// paths fail gracefully, NULL transport-parameters resets to\n105\t/// defaults.\n106\t#[test]\n107\tfn create_quic() {\n108\t    // 0 connections clamps to 1 (C: `quic->max_number_connections == 1`).\n109\t    let _quic = Quic::new(\n110\t        0,\n111\t        None,\n112\t        None,\n113\t        None,\n114\t        None,\n115\t        None,\n116\t        None,\n117\t        [0u8; RESET_SECRET_SIZE],\n118\t        Instant::from_ticks(0),\n119\t        None,\n120\t        None,\n121\t    )\n122\t    .expect(\"0-connection should still create a context (clamped to 1)\");\n123\t\n124\t    // Bad cert / key paths must reject context creation.\n125\t    let bad_file = \"no_such_file_should_exist.pem\";\n126\t    assert!(\n127\t        Quic::new(\n128\t            8,\n129\t            Some(bad_file),\n130\t            None,\n131\t            None,\n132\t            None,\n133\t            None,\n134\t            None,\n135\t            [0u8; RESET_SECRET_SIZE],\n136\t            Instant::from_ticks(0),\n137\t            None,\n138\t            None,\n139\t        )\n140\t        .is_none(),\n141\t        \"bad cert path must fail\"\n142\t    );\n143\t\n144\t    // Default-TP override with `None` should reset to defaults.\n145\t    let mut quic = default_quic().expect(\"create quic\");\n146\t    quic.set_default_tp(&crate::TransportParameters::default())\n147\t        .expect(\"set_default_tp\");\n148\t}\n149\t"}]},"parent_tool_use_id":null,"session_id":"c7c7e82c-a907-4d1f-a2c6-fbe9ac637b5e","uuid":"802f686e-d36c-4a26-b949-14730b913ed0","timestamp":"2026-05-04T18:40:18.266Z","tool_use_result":{"type":"text","file":{"filePath":"/Users/richbarn/Projects/picoquic/rs/fq/src/tests/cnx_creation.rs","content":"//! Test cases for `picoquictest/cnx_creation_test.c`.\n\n#![allow(non_snake_case)]\n\nuse core::net::{IpAddr, Ipv4Addr, Ipv6Addr, SocketAddr};\n\nuse crate::{ConnectionId, Instant, Quic, RESET_SECRET_SIZE};\n\n/// Make a fresh `Quic` context with the C test's\n/// `picoquic_create(8, NULL, …)` defaults.  Returns `Option<Box<Quic>>`\n/// directly (the C `NULL` failure goes to `None`).\nfn default_quic() -> Option<Box<Quic>> {\n    Quic::new(\n        8,\n        None,\n        None,\n        None,\n        None,\n        None,\n        None,\n        [0u8; RESET_SECRET_SIZE],\n        Instant::from_ticks(0),\n        None,\n        None,\n    )\n}\n\n/// C: `create_cnx_test` in `picoquictest/cnx_creation_test.c`.\n///\n/// Builds 7 connections covering the IPv4 / IPv6 / per-port /\n/// per-CID matrix, verifies they can be retrieved by address (when\n/// no local CID is in use) or by CID (when one is), iterates over\n/// all of them, then deletes alternating slots and re-checks.\n#[test]\nfn create_cnx() {\n    let test_ipv4 = Ipv4Addr::new(192, 0, 2, 0);\n    let test_ipv6 = Ipv6Addr::new(0x2001, 0x0DB8, 0, 0, 0, 0, 0, 1);\n    let test_ipv4_local = Ipv4Addr::new(127, 0, 0, 1);\n    let test_ipv6_local = Ipv6Addr::new(0, 0, 0, 0, 0, 0, 0, 1);\n\n    let mut test4: [SocketAddr; 5] = [SocketAddr::new(IpAddr::V4(test_ipv4), 0); 5];\n    for (i, addr) in test4.iter_mut().enumerate() {\n        let ip = if i < 4 {\n            // 192.0.2.<1 if i==0, 2 otherwise>.\n            let mut octets = test_ipv4.octets();\n            octets[3] = if i == 0 { 1 } else { 2 };\n            Ipv4Addr::from(octets)\n        } else {\n            test_ipv4_local\n        };\n        *addr = SocketAddr::new(IpAddr::V4(ip), 1000 + i as u16);\n    }\n\n    let mut test6: [SocketAddr; 3] = [SocketAddr::new(IpAddr::V6(test_ipv6), 0); 3];\n    for (i, addr) in test6.iter_mut().enumerate() {\n        let ip = if i < 2 {\n            let mut segments = test_ipv6.segments();\n            segments[7] = (i as u16) + 1;\n            Ipv6Addr::from(segments)\n        } else {\n            test_ipv6_local\n        };\n        *addr = SocketAddr::new(IpAddr::V6(ip), 1000 + i as u16);\n    }\n\n    let test_cnx_addr = [\n        test4[0], test4[1], test4[2], test4[4], test6[0], test6[1], test6[2],\n    ];\n    let test_cnx_id: [ConnectionId; 7] =\n        core::array::from_fn(|i| ConnectionId::clone_from_slice(&[(i + 1) as u8; 8]).unwrap());\n\n    // The C version tests both `local_cnxid_length == 0` and `== 8`\n    // by reaching into the `Quic` struct directly.  The Rust public\n    // API doesn't expose that toggle yet (Phase 4 will add a setter\n    // and / or wire it through the existing `Quic::new` reset_seed\n    // parameter).  Run the larger CID branch alone.\n    let mut quic = default_quic().expect(\"create quic\");\n\n    for i in 0..7 {\n        let _cnx = quic\n            .create_connection(\n                test_cnx_id[i],\n                ConnectionId::default(),\n                Some(&test_cnx_addr[i]),\n                Instant::from_ticks(0),\n                0,\n                None,\n                None,\n                true,\n            )\n            .expect(\"create_connection\");\n    }\n\n    // Verify every connection is visited by `first_connection` /\n    // `Connection::next`.  The latter is Phase 4 — placeholder.\n    let _first = quic.first_connection();\n    todo!(\"Connection iteration / lookup-by-net / lookup-by-id (Phase 4)\")\n}\n\n/// C: `create_quic_test` in `picoquictest/cnx_creation_test.c`.\n///\n/// Edge cases: 0-connection request clamps to 1, bad cert/key\n/// rejected, bad ticket-store paths tolerated, bad token-file\n/// paths fail gracefully, NULL transport-parameters resets to\n/// defaults.\n#[test]\nfn create_quic() {\n    // 0 connections clamps to 1 (C: `quic->max_number_connections == 1`).\n    let _quic = Quic::new(\n        0,\n        None,\n        None,\n        None,\n        None,\n        None,\n        None,\n        [0u8; RESET_SECRET_SIZE],\n        Instant::from_ticks(0),\n        None,\n        None,\n    )\n    .expect(\"0-connection should still create a context (clamped to 1)\");\n\n    // Bad cert / key paths must reject context creation.\n    let bad_file = \"no_such_file_should_exist.pem\";\n    assert!(\n        Quic::new(\n            8,\n            Some(bad_file),\n            None,\n            None,\n            None,\n            None,\n            None,\n            [0u8; RESET_SECRET_SIZE],\n            Instant::from_ticks(0),\n            None,\n            None,\n        )\n        .is_none(),\n        \"bad cert path must fail\"\n    );\n\n    // Default-TP override with `None` should reset to defaults.\n    let mut quic = default_quic().expect(\"create quic\");\n    quic.set_default_tp(&crate::TransportParameters::default())\n        .expect(\"set_default_tp\");\n}\n","numLines":149,"startLine":1,"totalLines":149}}}
