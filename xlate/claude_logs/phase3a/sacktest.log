{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01RNNreEnJ63KKqDvozuHR9H","type":"tool_result","content":"1\t//! Test-only utilities split out of [`crate::utils`].\n2\t//!\n3\t//! Contents:\n4\t//!\n5\t//! * **Deterministic test RNG** (`test_random`, `test_random_bytes`,\n6\t//!   `test_uniform_random`, `test_gauss_random`,\n7\t//!   `test_poisson_random`) — picoquic uses these to make\n8\t//!   simulator runs reproducible.  The production RNG\n9\t//!   (`crate::utils::uniform_random`) stays in `utils.rs`.\n10\t//!\n11\t//! * **Network simulator** (`TestSimPacket`, `TestSimLink`,\n12\t//!   `TestAqm`, `JitterMode`) — the in-process sim-link used by\n13\t//!   the test suite to exercise the QUIC stack without real sockets.\n14\t//!   The C bodies live in `picoquictest/sim_link.c`.\n15\t//!\n16\t//! * **Test-fixture certificate / SNI constants** — paths to PEM\n17\t//!   files baked into the test tree (`certs/...`).\n18\t//!\n19\t//! All `pub` items in this module ride on the parent's\n20\t//! `#[cfg(test)]` gate, so they don't bloat the production build.\n21\t\n22\tuse core::net::SocketAddr;\n23\t\n24\tuse crate::Instant;\n25\tuse crate::MAX_PACKET_SIZE;\n26\t\n27\t// ---------------------------------------------------------------------------\n28\t// Deterministic test RNG.\n29\t//\n30\t// The production `uniform_random` reads from the platform RNG\n31\t// (and stays in `crate::utils`).  These deterministic helpers\n32\t// thread their state through the explicit `&mut u64` context\n33\t// so simulator runs reproduce bit-for-bit.\n34\t\n35\t/// Deterministic test RNG: advance the 64-bit context and return\n36\t/// the new value.  C: `uint64_t test_random(uint64_t*\n37\t/// random_context)`.\n38\tpub fn test_random(_random_context: &mut u64) -> u64 {\n39\t    todo!()\n40\t}\n41\t\n42\t/// Fill `bytes` with deterministic test RNG output.  C:\n43\t/// `void test_random_bytes(uint64_t* random_context,\n44\t/// uint8_t* bytes, size_t bytes_max)` — `bytes_max` folds into the\n45\t/// slice length.\n46\tpub fn test_random_bytes(_random_context: &mut u64, _bytes: &mut [u8]) {\n47\t    todo!()\n48\t}\n49\t\n50\t/// Uniform test RNG in `[0, rnd_max)`.  C:\n51\t/// `test_uniform_random`.\n52\tpub fn test_uniform_random(_random_context: &mut u64, _rnd_max: u64) -> u64 {\n53\t    todo!()\n54\t}\n55\t\n56\t/// Gaussian-distributed test RNG (variance 1, mean 0).  C:\n57\t/// `double test_gauss_random(uint64_t* random_context)`.\n58\tpub fn test_gauss_random(_random_context: &mut u64) -> f64 {\n59\t    todo!()\n60\t}\n61\t\n62\t/// Poisson-distributed test RNG.  C:\n63\t/// `uint64_t test_poisson_random(uint64_t*, uint64_t)`\n64\t/// where the second argument is `(uint64_t)(exp(-lambda) * 0x40000000)`.\n65\tpub fn test_poisson_random(_random_context: &mut u64, _exp_minus_lambda_2_30: u64) -> u64 {\n66\t    todo!()\n67\t}\n68\t\n69\t// ---------------------------------------------------------------------------\n70\t// Network simulator (sim_link).\n71\t\n72\t/// One simulated packet flowing through a sim link.  C:\n73\t/// `picoquictest_sim_packet_t`.\n74\t///\n75\t/// Pointer-shape choices:\n76\t///\n77\t/// * Packets live in `TestSimLink.packets: VecDeque<TestSimPacket>`\n78\t///   (and `tests::dualq::DualqQueue.packets` for the AQM); the C\n79\t///   `next_packet` intrusive chain is gone.\n80\t/// * The two `sockaddr_storage` fields fold into\n81\t///   `Option<SocketAddr>` (the C zero-initialised storage maps to\n82\t///   `None`).\n83\t/// * The flexible-array-style `bytes` is a fixed\n84\t///   `[u8; MAX_PACKET_SIZE]` because the C struct\n85\t///   declares it inline at that exact size.\n86\tpub struct TestSimPacket {\n87\t    pub arrival_time: Instant,\n88\t    pub length: usize,\n89\t    pub addr_from: Option<SocketAddr>,\n90\t    pub addr_to: Option<SocketAddr>,\n91\t    pub ecn_mark: u8,\n92\t    pub bytes: [u8; MAX_PACKET_SIZE],\n93\t}\n94\t\n95\timpl TestSimPacket {\n96\t    /// Allocate a fresh, empty packet.  C:\n97\t    /// `picoquictest_sim_link_create_packet`.\n98\t    pub fn create() -> Result<Self, crate::Error> {\n99\t        todo!()\n100\t    }\n101\t}\n102\t\n103\t/// Active queue management vtable.  C: the `picoquictest_aqm_t`\n104\t/// struct of function pointers — folded into a single trait per\n105\t/// the Phase 1 rule on function pointers.  The `self` parameter\n106\t/// of each C method becomes the implicit `&mut self`; the\n107\t/// `picoquictest_sim_link_t*` link pointer stays explicit because\n108\t/// the AQM lives inside the link (taking the link by `&mut` in\n109\t/// each call would conflict with the `&mut self` borrow).  Phase 4\n110\t/// will resolve the borrow with a take-replace pattern.\n111\tpub trait TestAqm {\n112\t    /// Submit a packet to the AQM.  C: `submit`.\n113\t    fn submit(&mut self, link: &mut TestSimLink, packet: TestSimPacket, current_time: Instant);\n114\t\n115\t    /// Reset the AQM state at `current_time`.  C: `reset`.\n116\t    fn reset(&mut self, link: &mut TestSimLink, current_time: Instant);\n117\t\n118\t    /// Release any resources held by the AQM, e.g. when the link\n119\t    /// is being torn down.  C: `release`.\n120\t    fn release(&mut self, link: &mut TestSimLink);\n121\t\n122\t    /// Whether the AQM has at least one pending packet ready to\n123\t    /// admit.  C: `has_pending` returning a 0/1 flag, mapped to\n124\t    /// `bool`.\n125\t    fn has_pending(&mut self) -> bool;\n126\t\n127\t    /// Move any AQM-pending packets onto the link's main queue.\n128\t    /// C: `admit_pending`.\n129\t    fn admit_pending(&mut self, link: &mut TestSimLink, current_time: Instant);\n130\t}\n131\t\n132\t/// Jitter model used by the sim link.  C: `picoquic_jitter_mode`.\n133\t#[derive(Debug, Copy, Clone, PartialEq, Eq, Default)]\n134\tpub enum JitterMode {\n135\t    /// Gaussian jitter.  C: `jitter_gauss`.\n136\t    #[default]\n137\t    Gauss = 0,\n138\t    /// Wi-Fi-style jitter.  C: `jitter_wifi`.\n139\t    Wifi = 1,\n140\t}\n141\t\n142\t/// One simulated network link with an embedded queue plus AQM\n143\t/// hook.  C: `picoquictest_sim_link_t`.\n144\t///\n145\t/// Pointer-shape choices, derived from the bodies in\n146\t/// `picoquictest/sim_link.c`:\n147\t///\n148\t/// * `packets` replaces the C `first_packet` / `last_packet`\n149\t///   doubly-linked list head pair plus the per-`TestSimPacket`\n150\t///   `next_packet` chain.\n151\t/// * `loss_mask` — the C field was `*mut u64`, an externally-owned\n152\t///   error mask the link reads on every enqueue.  In the Rust port\n153\t///   the link owns its own copy: tests `&mut link.loss_mask` to\n154\t///   shift the mask between operations.  `None` matches the C\n155\t///   `NULL` sentinel.\n156\t/// * `aqm_state` becomes `Option<Box<dyn TestAqm>>` —\n157\t///   `None` matches the C `NULL` (no AQM installed).\n158\t/// * `is_switched_off` / `is_unreachable` / `is_suspended` were\n159\t///   `int` flags in C; promoted to `bool`.\n160\tpub struct TestSimLink {\n161\t    pub next_send_time: Instant,\n162\t    pub queue_time: Instant,\n163\t    pub resume_time: Instant,\n164\t    pub queue_delay_max: u64,\n165\t    pub picosec_per_byte: u64,\n166\t    pub microsec_latency: u64,\n167\t    pub packets_dropped: u64,\n168\t    pub packets_sent: u64,\n169\t    pub jitter: u64,\n170\t    pub jitter_mode: JitterMode,\n171\t    pub jitter_seed: u64,\n172\t    pub path_mtu: usize,\n173\t    /// Packets in flight on this link.  FIFO; the head is the\n174\t    /// next packet to deliver.\n175\t    pub packets: std::collections::VecDeque<TestSimPacket>,\n176\t    /// 64-bit error mask used in unit tests.  `None` ↔ \"no mask\".\n177\t    pub loss_mask: Option<u64>,\n178\t    pub nb_loss_in_burst: u64,\n179\t    pub packets_between_losses: u64,\n180\t    pub packets_sent_next_burst: u64,\n181\t    pub nb_losses_this_burst: u64,\n182\t    pub end_of_burst_time: Instant,\n183\t    pub aqm_state: Option<Box<dyn TestAqm>>,\n184\t    pub is_switched_off: bool,\n185\t    pub is_unreachable: bool,\n186\t    pub is_suspended: bool,\n187\t}\n188\t\n189\timpl TestSimLink {\n190\t    /// Create a sim link at `current_time`, with the given data\n191\t    /// rate (in gigabits per second) and one-way latency (in\n192\t    /// microseconds).  C: `picoquictest_sim_link_create`.\n193\t    ///\n194\t    /// `loss_mask` is the test's 64-bit error mask; `None` matches\n195\t    /// the C `NULL` (no mask).\n196\t    pub fn create(\n197\t        _data_rate_in_gbps: f64,\n198\t        _microsec_latency: u64,\n199\t        _loss_mask: Option<u64>,\n200\t        _queue_delay_max: u64,\n201\t        _current_time: Instant,\n202\t    ) -> Result<Self, crate::Error> {\n203\t        todo!()\n204\t    }\n205\t\n206\t    // C: `picoquictest_sim_link_delete`.  Dropped from the Rust\n207\t    // API: `Box<TestSimLink>` going out of scope will free the\n208\t    // link and its queued packets via Drop in Phase 4.\n209\t\n210\t    /// Time at which the next packet will arrive (or `current_time`\n211\t    /// if the queue is empty).  C:\n212\t    /// `picoquictest_sim_link_next_arrival`.\n213\t    pub fn next_arrival(&mut self, _current_time: Instant) -> u64 {\n214\t        todo!()\n215\t    }\n216\t\n217\t    /// Drain any AQM-pending packets onto the main queue at\n218\t    /// `current_time`.  C: `picoquictest_sim_link_admit_pending`.\n219\t    pub fn admit_pending(&mut self, _current_time: Instant) {\n220\t        todo!()\n221\t    }\n222\t\n223\t    /// Time at which the AQM will admit its next packet (or\n224\t    /// `next_time` if nothing is pending).  C:\n225\t    /// `picoquictest_sim_link_next_admission`.\n226\t    pub fn next_admission(&mut self, _current_time: Instant, _next_time: Instant) -> u64 {\n227\t        todo!()\n228\t    }\n229\t\n230\t    /// Pop the next-due packet, if any.  C:\n231\t    /// `picoquictest_sim_link_dequeue` returning `NULL` when\n232\t    /// nothing is ready, mapped to `Option<TestSimPacket>`.\n233\t    pub fn dequeue(&mut self, _current_time: Instant) -> Option<TestSimPacket> {\n234\t        todo!()\n235\t    }\n236\t\n237\t    /// Submit a packet to the queue with normal AQM processing and\n238\t    /// length check.  C: `picoquictest_sim_link_submit`.  Takes\n239\t    /// ownership of the packet — the link is responsible for\n240\t    /// either freeing it (drop) or returning it via\n241\t    /// [`TestSimLink::dequeue`].\n242\t    pub fn submit(&mut self, _packet: TestSimPacket, _current_time: Instant) {\n243\t        todo!()\n244\t    }\n245\t\n246\t    /// Submit a packet straight to the latency queue, bypassing the\n247\t    /// AQM.  When `should_drop` is `true` the packet is dropped\n248\t    /// instead of queued (and freed by the function).  C:\n249\t    /// `picoquictest_sim_link_enqueue` with the C `int\n250\t    /// should_drop` promoted to `bool`.\n251\t    pub fn enqueue(&mut self, _packet: TestSimPacket, _current_time: Instant, _should_drop: bool) {\n252\t        todo!()\n253\t    }\n254\t\n255\t    /// Compute the transmission time of `packet` (a function of\n256\t    /// the link's data rate and the packet length).  C:\n257\t    /// `picoquictest_sim_link_transmit_time`.\n258\t    pub fn transmit_time(&mut self, _packet: &TestSimPacket) -> u64 {\n259\t        todo!()\n260\t    }\n261\t\n262\t    /// Queueing delay of the next packet at `current_time`.  C:\n263\t    /// `picoquictest_sim_link_queue_delay`.\n264\t    pub fn queue_delay(&mut self, _current_time: Instant) -> u64 {\n265\t        todo!()\n266\t    }\n267\t\n268\t    /// Simulate a transmission interruption until\n269\t    /// `time_end_of_interval`.  When `simulate_receive` is `true`\n270\t    /// the link suspends *reception* (pending packets are\n271\t    /// delivered at the end of the interval); when `false` it\n272\t    /// suspends transmission (packets are queued as if transmitted\n273\t    /// in sequence after the interval).  C:\n274\t    /// `picoquic_test_simlink_suspend` with the C `int\n275\t    /// simulate_receive` promoted to `bool`.\n276\t    pub fn suspend(&mut self, _time_end_of_interval: Instant, _simulate_receive: bool) {\n277\t        todo!()\n278\t    }\n279\t}\n280\t\n281\t// ---------------------------------------------------------------------------\n282\t// SNI / certificate paths used by the test suite.  Linux/macOS\n283\t// layout only; `_WINDOWS` paths are dropped per the v1 scope.\n284\t\n285\t/// Default SNI string for the test fixtures.\n286\tpub const TEST_SNI: &str = \"test.example.com\";\n287\t\n288\tpub const TEST_FILE_SERVER_CERT: &str = \"certs/cert.pem\";\n289\tpub const TEST_FILE_SERVER_BAD_CERT: &str = \"certs/badcert.pem\";\n290\tpub const TEST_FILE_SERVER_KEY: &str = \"certs/key.pem\";\n291\tpub const TEST_FILE_CERT_STORE: &str = \"certs/test-ca.crt\";\n292\tpub const TEST_FILE_SERVER_CERT_ECDSA: &str = \"certs/ecdsa/cert.pem\";\n293\tpub const TEST_FILE_SERVER_KEY_ECDSA: &str = \"certs/ecdsa/key.pem\";\n294\tpub const TEST_ECH_PUB_KEY: &str = \"certs/ech/public.pem\";\n295\tpub const TEST_ECH_PRIVATE_KEY: &str = \"certs/ech/private.pem\";\n296\tpub const TEST_ECH_CONFIG: &str = \"certs/ech/ech_config.txt\";\n297\tpub const TEST_ECH_CERT: &str = \"certs/ech/ech_cert.pem\";\n298\tpub const TEST_ECH_RR_REF: &str = \"certs/ech/ech_rr.txt\";\n299\tpub const TEST_ECH_CONFIG_REF: &str = \"certs/ech/ech_config.txt\";\n300\tpub const TEST_FILE_SERVER_CERT_RSA: &str = \"certs/rsa/cert.pem\";\n301\tpub const TEST_FILE_SERVER_KEY_RSA: &str = \"certs/rsa/key.pem\";\n302\tpub const TEST_FILE_SERVER_CERT_ED25519: &str = \"certs/mtls_ed25519/server.crt\";\n303\tpub const TEST_FILE_SERVER_KEY_ED25519: &str = \"certs/mtls_ed25519/server.key\";\n304\tpub const TEST_FILE_CLIENT_CERT_ED25519: &str = \"certs/mtls_ed25519/client.crt\";\n305\tpub const TEST_FILE_CLIENT_KEY_ED25519: &str = \"certs/mtls_ed25519/client.key\";\n306\tpub const TEST_FILE_CERT_STORE_ED25519: &str = \"certs/mtls_ed25519/ca.crt\";\n307\t"}]},"parent_tool_use_id":null,"session_id":"c7c7e82c-a907-4d1f-a2c6-fbe9ac637b5e","uuid":"4322256f-f4a8-4256-b2ec-5280906dc956","timestamp":"2026-05-04T18:25:27.199Z","tool_use_result":{"type":"text","file":{"filePath":"/Users/richbarn/Projects/picoquic/rs/fq/src/tests/util.rs","content":"//! Test-only utilities split out of [`crate::utils`].\n//!\n//! Contents:\n//!\n//! * **Deterministic test RNG** (`test_random`, `test_random_bytes`,\n//!   `test_uniform_random`, `test_gauss_random`,\n//!   `test_poisson_random`) — picoquic uses these to make\n//!   simulator runs reproducible.  The production RNG\n//!   (`crate::utils::uniform_random`) stays in `utils.rs`.\n//!\n//! * **Network simulator** (`TestSimPacket`, `TestSimLink`,\n//!   `TestAqm`, `JitterMode`) — the in-process sim-link used by\n//!   the test suite to exercise the QUIC stack without real sockets.\n//!   The C bodies live in `picoquictest/sim_link.c`.\n//!\n//! * **Test-fixture certificate / SNI constants** — paths to PEM\n//!   files baked into the test tree (`certs/...`).\n//!\n//! All `pub` items in this module ride on the parent's\n//! `#[cfg(test)]` gate, so they don't bloat the production build.\n\nuse core::net::SocketAddr;\n\nuse crate::Instant;\nuse crate::MAX_PACKET_SIZE;\n\n// ---------------------------------------------------------------------------\n// Deterministic test RNG.\n//\n// The production `uniform_random` reads from the platform RNG\n// (and stays in `crate::utils`).  These deterministic helpers\n// thread their state through the explicit `&mut u64` context\n// so simulator runs reproduce bit-for-bit.\n\n/// Deterministic test RNG: advance the 64-bit context and return\n/// the new value.  C: `uint64_t test_random(uint64_t*\n/// random_context)`.\npub fn test_random(_random_context: &mut u64) -> u64 {\n    todo!()\n}\n\n/// Fill `bytes` with deterministic test RNG output.  C:\n/// `void test_random_bytes(uint64_t* random_context,\n/// uint8_t* bytes, size_t bytes_max)` — `bytes_max` folds into the\n/// slice length.\npub fn test_random_bytes(_random_context: &mut u64, _bytes: &mut [u8]) {\n    todo!()\n}\n\n/// Uniform test RNG in `[0, rnd_max)`.  C:\n/// `test_uniform_random`.\npub fn test_uniform_random(_random_context: &mut u64, _rnd_max: u64) -> u64 {\n    todo!()\n}\n\n/// Gaussian-distributed test RNG (variance 1, mean 0).  C:\n/// `double test_gauss_random(uint64_t* random_context)`.\npub fn test_gauss_random(_random_context: &mut u64) -> f64 {\n    todo!()\n}\n\n/// Poisson-distributed test RNG.  C:\n/// `uint64_t test_poisson_random(uint64_t*, uint64_t)`\n/// where the second argument is `(uint64_t)(exp(-lambda) * 0x40000000)`.\npub fn test_poisson_random(_random_context: &mut u64, _exp_minus_lambda_2_30: u64) -> u64 {\n    todo!()\n}\n\n// ---------------------------------------------------------------------------\n// Network simulator (sim_link).\n\n/// One simulated packet flowing through a sim link.  C:\n/// `picoquictest_sim_packet_t`.\n///\n/// Pointer-shape choices:\n///\n/// * Packets live in `TestSimLink.packets: VecDeque<TestSimPacket>`\n///   (and `tests::dualq::DualqQueue.packets` for the AQM); the C\n///   `next_packet` intrusive chain is gone.\n/// * The two `sockaddr_storage` fields fold into\n///   `Option<SocketAddr>` (the C zero-initialised storage maps to\n///   `None`).\n/// * The flexible-array-style `bytes` is a fixed\n///   `[u8; MAX_PACKET_SIZE]` because the C struct\n///   declares it inline at that exact size.\npub struct TestSimPacket {\n    pub arrival_time: Instant,\n    pub length: usize,\n    pub addr_from: Option<SocketAddr>,\n    pub addr_to: Option<SocketAddr>,\n    pub ecn_mark: u8,\n    pub bytes: [u8; MAX_PACKET_SIZE],\n}\n\nimpl TestSimPacket {\n    /// Allocate a fresh, empty packet.  C:\n    /// `picoquictest_sim_link_create_packet`.\n    pub fn create() -> Result<Self, crate::Error> {\n        todo!()\n    }\n}\n\n/// Active queue management vtable.  C: the `picoquictest_aqm_t`\n/// struct of function pointers — folded into a single trait per\n/// the Phase 1 rule on function pointers.  The `self` parameter\n/// of each C method becomes the implicit `&mut self`; the\n/// `picoquictest_sim_link_t*` link pointer stays explicit because\n/// the AQM lives inside the link (taking the link by `&mut` in\n/// each call would conflict with the `&mut self` borrow).  Phase 4\n/// will resolve the borrow with a take-replace pattern.\npub trait TestAqm {\n    /// Submit a packet to the AQM.  C: `submit`.\n    fn submit(&mut self, link: &mut TestSimLink, packet: TestSimPacket, current_time: Instant);\n\n    /// Reset the AQM state at `current_time`.  C: `reset`.\n    fn reset(&mut self, link: &mut TestSimLink, current_time: Instant);\n\n    /// Release any resources held by the AQM, e.g. when the link\n    /// is being torn down.  C: `release`.\n    fn release(&mut self, link: &mut TestSimLink);\n\n    /// Whether the AQM has at least one pending packet ready to\n    /// admit.  C: `has_pending` returning a 0/1 flag, mapped to\n    /// `bool`.\n    fn has_pending(&mut self) -> bool;\n\n    /// Move any AQM-pending packets onto the link's main queue.\n    /// C: `admit_pending`.\n    fn admit_pending(&mut self, link: &mut TestSimLink, current_time: Instant);\n}\n\n/// Jitter model used by the sim link.  C: `picoquic_jitter_mode`.\n#[derive(Debug, Copy, Clone, PartialEq, Eq, Default)]\npub enum JitterMode {\n    /// Gaussian jitter.  C: `jitter_gauss`.\n    #[default]\n    Gauss = 0,\n    /// Wi-Fi-style jitter.  C: `jitter_wifi`.\n    Wifi = 1,\n}\n\n/// One simulated network link with an embedded queue plus AQM\n/// hook.  C: `picoquictest_sim_link_t`.\n///\n/// Pointer-shape choices, derived from the bodies in\n/// `picoquictest/sim_link.c`:\n///\n/// * `packets` replaces the C `first_packet` / `last_packet`\n///   doubly-linked list head pair plus the per-`TestSimPacket`\n///   `next_packet` chain.\n/// * `loss_mask` — the C field was `*mut u64`, an externally-owned\n///   error mask the link reads on every enqueue.  In the Rust port\n///   the link owns its own copy: tests `&mut link.loss_mask` to\n///   shift the mask between operations.  `None` matches the C\n///   `NULL` sentinel.\n/// * `aqm_state` becomes `Option<Box<dyn TestAqm>>` —\n///   `None` matches the C `NULL` (no AQM installed).\n/// * `is_switched_off` / `is_unreachable` / `is_suspended` were\n///   `int` flags in C; promoted to `bool`.\npub struct TestSimLink {\n    pub next_send_time: Instant,\n    pub queue_time: Instant,\n    pub resume_time: Instant,\n    pub queue_delay_max: u64,\n    pub picosec_per_byte: u64,\n    pub microsec_latency: u64,\n    pub packets_dropped: u64,\n    pub packets_sent: u64,\n    pub jitter: u64,\n    pub jitter_mode: JitterMode,\n    pub jitter_seed: u64,\n    pub path_mtu: usize,\n    /// Packets in flight on this link.  FIFO; the head is the\n    /// next packet to deliver.\n    pub packets: std::collections::VecDeque<TestSimPacket>,\n    /// 64-bit error mask used in unit tests.  `None` ↔ \"no mask\".\n    pub loss_mask: Option<u64>,\n    pub nb_loss_in_burst: u64,\n    pub packets_between_losses: u64,\n    pub packets_sent_next_burst: u64,\n    pub nb_losses_this_burst: u64,\n    pub end_of_burst_time: Instant,\n    pub aqm_state: Option<Box<dyn TestAqm>>,\n    pub is_switched_off: bool,\n    pub is_unreachable: bool,\n    pub is_suspended: bool,\n}\n\nimpl TestSimLink {\n    /// Create a sim link at `current_time`, with the given data\n    /// rate (in gigabits per second) and one-way latency (in\n    /// microseconds).  C: `picoquictest_sim_link_create`.\n    ///\n    /// `loss_mask` is the test's 64-bit error mask; `None` matches\n    /// the C `NULL` (no mask).\n    pub fn create(\n        _data_rate_in_gbps: f64,\n        _microsec_latency: u64,\n        _loss_mask: Option<u64>,\n        _queue_delay_max: u64,\n        _current_time: Instant,\n    ) -> Result<Self, crate::Error> {\n        todo!()\n    }\n\n    // C: `picoquictest_sim_link_delete`.  Dropped from the Rust\n    // API: `Box<TestSimLink>` going out of scope will free the\n    // link and its queued packets via Drop in Phase 4.\n\n    /// Time at which the next packet will arrive (or `current_time`\n    /// if the queue is empty).  C:\n    /// `picoquictest_sim_link_next_arrival`.\n    pub fn next_arrival(&mut self, _current_time: Instant) -> u64 {\n        todo!()\n    }\n\n    /// Drain any AQM-pending packets onto the main queue at\n    /// `current_time`.  C: `picoquictest_sim_link_admit_pending`.\n    pub fn admit_pending(&mut self, _current_time: Instant) {\n        todo!()\n    }\n\n    /// Time at which the AQM will admit its next packet (or\n    /// `next_time` if nothing is pending).  C:\n    /// `picoquictest_sim_link_next_admission`.\n    pub fn next_admission(&mut self, _current_time: Instant, _next_time: Instant) -> u64 {\n        todo!()\n    }\n\n    /// Pop the next-due packet, if any.  C:\n    /// `picoquictest_sim_link_dequeue` returning `NULL` when\n    /// nothing is ready, mapped to `Option<TestSimPacket>`.\n    pub fn dequeue(&mut self, _current_time: Instant) -> Option<TestSimPacket> {\n        todo!()\n    }\n\n    /// Submit a packet to the queue with normal AQM processing and\n    /// length check.  C: `picoquictest_sim_link_submit`.  Takes\n    /// ownership of the packet — the link is responsible for\n    /// either freeing it (drop) or returning it via\n    /// [`TestSimLink::dequeue`].\n    pub fn submit(&mut self, _packet: TestSimPacket, _current_time: Instant) {\n        todo!()\n    }\n\n    /// Submit a packet straight to the latency queue, bypassing the\n    /// AQM.  When `should_drop` is `true` the packet is dropped\n    /// instead of queued (and freed by the function).  C:\n    /// `picoquictest_sim_link_enqueue` with the C `int\n    /// should_drop` promoted to `bool`.\n    pub fn enqueue(&mut self, _packet: TestSimPacket, _current_time: Instant, _should_drop: bool) {\n        todo!()\n    