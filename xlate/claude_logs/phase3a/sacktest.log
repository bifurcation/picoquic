n create_misc_frame(\n    _bytes: &[u8],\n    _is_pure_ack: bool,\n    _pc: PacketContext,\n) -> Result<MiscFrameHeader, crate::Error> {\n    todo!()\n}\n\nimpl Connection {\n    pub fn process_version_upgrade(\n        &mut self,\n        _old_version_index: i32,\n        _new_version_index: i32,\n    ) -> i32 {\n        todo!()\n    }\n}\n\n// ---------------------------------------------------------------------------\n// mask proxy hooks (function-pointer pair → trait).\n\n/// Trait covering the C `mask_fns_t` struct's two function\n/// pointers.  Implemented by the `mask` proxy module when\n/// linked; otherwise `mask_fns` on the QUIC context is\n/// `None` and the proxy hooks are skipped.\npub trait MaskOps {\n    /// C: `mask_intercept_fn`.\n    fn intercept(\n        &self,\n        quic: &mut Quic,\n        mask_ctx: Option<&mut dyn Any>,\n        current_time: Instant,\n        send_buffer: &mut [u8],\n        send_length: &mut usize,\n        send_msg_size: &mut usize,\n        p_addr_to: &mut Option<SocketAddr>,\n        p_addr_from: &mut Option<SocketAddr>,\n        if_index: &mut i32,\n    ) -> i32;\n\n    /// C: `mask_redirect_fn`.\n    fn redirect(\n        &self,\n        mask_ctx: Option<&mut dyn Any>,\n        bytes: &[u8],\n        packet_length: usize,\n        addr_from: Option<&SocketAddr>,\n        consumed: &mut usize,\n    ) -> i32;\n}\n\n#[cfg(test)]\nmod test {}\n","structuredPatch":[{"oldStart":2924,"oldLines":6,"newStart":2924,"newLines":12,"lines":["     }"," }"," ","+impl Default for SackList {","+    fn default() -> Self {","+        Self::new()","+    }","+}","+"," impl SackList {","     /// Highest packet number currently sacked.","     pub fn first(&self) -> u64 {"]}],"userModified":false,"replaceAll":false}}
