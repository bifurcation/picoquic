{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01UxGrQtHK6VjRSWBvLwyY89","type":"tool_result","content":"1\t[package]\n2\tname = \"fq\"\n3\tversion = \"0.1.0\"\n4\tedition = \"2024\"\n5\t\n6\t[features]\n7\tdefault = []\n8\t# Each backend lives behind its own feature so a binary only pays\n9\t# for the implementations it actually links.  See `src/sys/`.\n10\tsys-picotls = []\n11\tsys-openssl = [\"dep:openssl\"]\n12\t\n13\t[dependencies]\n14\tfugit = { version = \"0.3\", default-features = false }\n15\trand = { version = \"0.9\", default-features = false }\n16\trand_core = { version = \"0.9\", default-features = false }\n17\t\n18\t# Rust Crypto trait crates (no implementations -- those come from\n19\t# the active TLS backend's crypto layer, except for header\n20\t# protection which we implement ourselves).\n21\taead = { version = \"0.5\", default-features = false }\n22\tcipher = { version = \"0.4\", default-features = false }\n23\tdigest = { version = \"0.10\", default-features = false }\n24\t\n25\t# Concrete cipher implementations used by header protection\n26\t# (QUIC packet-number encryption is QUIC logic, not TLS).\n27\taes = { version = \"0.8\", default-features = false }\n28\tchacha20 = { version = \"0.9\", default-features = false }\n29\t\n30\t# UDP socket abstraction.  std-only.\n31\tsocket2 = { version = \"0.5\", default-features = false, features = [\"all\"] }\n32\t\n33\t# Optional backend implementations (gated by `sys-*` features).\n34\topenssl = { version = \"0.10\", optional = true }\n35\t"}]},"parent_tool_use_id":null,"session_id":"513641af-66d9-4e8b-98cd-e59b8e6a1fb7","uuid":"8a5d1de0-cf4e-4e74-9d39-88764d7946c4","timestamp":"2026-05-04T22:30:23.007Z","tool_use_result":{"type":"text","file":{"filePath":"/Users/richbarn/Projects/picoquic/rs/fq/Cargo.toml","content":"[package]\nname = \"fq\"\nversion = \"0.1.0\"\nedition = \"2024\"\n\n[features]\ndefault = []\n# Each backend lives behind its own feature so a binary only pays\n# for the implementations it actually links.  See `src/sys/`.\nsys-picotls = []\nsys-openssl = [\"dep:openssl\"]\n\n[dependencies]\nfugit = { version = \"0.3\", default-features = false }\nrand = { version = \"0.9\", default-features = false }\nrand_core = { version = \"0.9\", default-features = false }\n\n# Rust Crypto trait crates (no implementations -- those come from\n# the active TLS backend's crypto layer, except for header\n# protection which we implement ourselves).\naead = { version = \"0.5\", default-features = false }\ncipher = { version = \"0.4\", default-features = false }\ndigest = { version = \"0.10\", default-features = false }\n\n# Concrete cipher implementations used by header protection\n# (QUIC packet-number encryption is QUIC logic, not TLS).\naes = { version = \"0.8\", default-features = false }\nchacha20 = { version = \"0.9\", default-features = false }\n\n# UDP socket abstraction.  std-only.\nsocket2 = { version = \"0.5\", default-features = false, features = [\"all\"] }\n\n# Optional backend implementations (gated by `sys-*` features).\nopenssl = { version = \"0.10\", optional = true }\n","numLines":35,"startLine":1,"totalLines":35}}}
