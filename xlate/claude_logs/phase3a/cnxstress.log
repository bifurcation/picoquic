{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01Cq87x9mj9bjExXAKZ7fuKJ","type":"tool_result","content":"1\t/*\n2\t* Author: Christian Huitema\n3\t* Copyright (c) 2020, Private Octopus, Inc.\n4\t* All rights reserved.\n5\t*\n6\t* Permission to use, copy, modify, and distribute this software for any\n7\t* purpose with or without fee is hereby granted, provided that the above\n8\t* copyright notice and this permission notice appear in all copies.\n9\t*\n10\t* THIS SOFTWARE IS PROVIDED BY THE COPYRIGHT HOLDERS AND CONTRIBUTORS \"AS IS\" AND\n11\t* ANY EXPRESS OR IMPLIED WARRANTIES, INCLUDING, BUT NOT LIMITED TO, THE IMPLIED\n12\t* WARRANTIES OF MERCHANTABILITY AND FITNESS FOR A PARTICULAR PURPOSE ARE\n13\t* DISCLAIMED. IN NO EVENT SHALL Private Octopus, Inc. BE LIABLE FOR ANY\n14\t* DIRECT, INDIRECT, INCIDENTAL, SPECIAL, EXEMPLARY, OR CONSEQUENTIAL DAMAGES\n15\t* (INCLUDING, BUT NOT LIMITED TO, PROCUREMENT OF SUBSTITUTE GOODS OR SERVICES;\n16\t* LOSS OF USE, DATA, OR PROFITS; OR BUSINESS INTERRUPTION) HOWEVER CAUSED AND\n17\t* ON ANY THEORY OF LIABILITY, WHETHER IN CONTRACT, STRICT LIABILITY, OR TORT\n18\t* (INCLUDING NEGLIGENCE OR OTHERWISE) ARISING IN ANY WAY OUT OF THE USE OF THIS\n19\t* SOFTWARE, EVEN IF ADVISED OF THE POSSIBILITY OF SUCH DAMAGE.\n20\t*/\n21\t\n22\t#include <stddef.h>\n23\t#include <stdlib.h>\n24\t#include <string.h>\n25\t#ifdef _WINDOWS\n26\t#include \"wincompat.h\"\n27\t#include \"ws2ipdef.h\"\n28\t#pragma warning(disable:4204)\n29\t#else\n30\t#include <signal.h>\n31\t#endif\n32\t#include <picotls.h>\n33\t#include \"picoquic_utils.h\"\n34\t#include \"picoquic_internal.h\"\n35\t#include \"tls_api.h\"\n36\t#include \"picoquictest_internal.h\"\n37\t#define CNX_STRESS_ALPN \"cnxstress\"\n38\t\n39\ttypedef struct st_cnx_stress_stream_ctx_t {\n40\t    /* For receive streams, just look at the first 16 bytes,\n41\t     * ignore the following until everything is received \n42\t     * For send streams, send the first bytes, followed by\n43\t     * random or fixed data up to message size. */\n44\t    struct st_cnx_stress_stream_ctx_t* previous_stream;\n45\t    struct st_cnx_stress_stream_ctx_t* next_stream;\n46\t    uint64_t stream_id;\n47\t    uint64_t send_time;\n48\t    uint64_t nb_bytes_expected;\n49\t    uint64_t nb_bytes_received;\n50\t    uint64_t nb_bytes_sent;\n51\t} cnx_stress_stream_ctx_t;\n52\t\n53\ttypedef struct st_cnx_stress_callback_ctx_t {\n54\t    struct st_cnx_stress_ctx_t* stress_ctx;\n55\t    picoquic_cnx_t* cnx;\n56\t    uint64_t next_stream_send;\n57\t    int mode;\n58\t    int rank;\n59\t    cnx_stress_stream_ctx_t* first_stream;\n60\t    cnx_stress_stream_ctx_t* last_stream;\n61\t} cnx_stress_callback_ctx_t;\n62\t\n63\ttypedef enum {\n64\t    cnx_stress_event_none = 0,\n65\t    cnx_stress_event_new_message,\n66\t    cnx_stress_event_client_creation,\n67\t    cnx_stress_event_client_removal,\n68\t    cnx_stress_event_client_arrival,\n69\t    cnx_stress_event_client_prepare,\n70\t    cnx_stress_event_server_arrival,\n71\t    cnx_stress_event_server_prepare\n72\t} cnx_stress_event_enum;\n73\t\n74\ttypedef struct st_cnx_stress_ctx_t {\n75\t    uint64_t simulated_time;\n76\t    uint64_t random_ctx;\n77\t    picoquic_quic_t* qserver;\n78\t    picoquic_quic_t* qclient;\n79\t    struct sockaddr_in server_addr;\n80\t    struct sockaddr_in client_addr;\n81\t    picoquictest_sim_link_t* link_to_clients;\n82\t    picoquictest_sim_link_t* link_to_server;\n83\t    int is_limit_test;\n84\t    int limit_test_got_server_busy;\n85\t    int nb_clients;\n86\t    int nb_servers;\n87\t    int nb_client_target;\n88\t    int nb_clients_deleted;\n89\t    uint64_t client_creation_interval;\n90\t    uint64_t next_client_creation_time;\n91\t    uint64_t client_deletion_interval;\n92\t    uint64_t next_client_deletion_time;\n93\t    uint64_t message_creation_interval;\n94\t    uint64_t next_message_creation_time;\n95\t    /* Statistics on message arrival delay */\n96\t    int nb_messages_target;\n97\t    size_t message_size;\n98\t    int nb_messages_sent;\n99\t    int nb_messages_errors;\n100\t    int nb_messages_received;\n101\t    int64_t sum_message_delays;\n102\t    double sum_square_message_delays;\n103\t    int64_t message_delay_min;\n104\t    int64_t message_delay_max;\n105\t    /* The array of client and server contexts are created with size \"nb_client target\"\n106\t     * during the initialization of the test. The variables nb_clients and nb_servers\n107\t     * hold the number of clients and servers actually created. */\n108\t    cnx_stress_callback_ctx_t** c_ctx;\n109\t    cnx_stress_callback_ctx_t** s_ctx;\n110\t    cnx_stress_callback_ctx_t* default_ctx;\n111\t} cnx_stress_ctx_t;\n112\t\n113\t#if 0\n114\t/*\n115\t * Portable abort call, should work on Linux and Windows.\n116\t * We deliberately do not call the ASSERT macros, becuse these\n117\t * macros can be made no-op if compiled with NDEBUG\n118\t */\n119\t\n120\tstatic int stress_debug_break(int break_if_fuzzing)\n121\t{\n122\t    if (picoquic_fuzz_in_progress == 0 || break_if_fuzzing) {\n123\t#ifdef _WINDOWS\n124\t        DebugBreak();\n125\t#else\n126\t        raise(SIGTRAP);\n127\t#endif\n128\t        return -1;\n129\t    }\n130\t\n131\t    return 0;\n132\t}\n133\t#endif\n134\t\n135\t/* Callback context and protocol handling.\n136\t * Nothing really special here? For message sending, assume short messages,\n137\t * just use the write and forget API. For message receiving, process to\n138\t * parse the message protocol in real time.\n139\t * Stream context for receive: created when first data arrives on the stream.\n140\t * Context accumulate the message ID from the first 8 bytes, then ignores the\n141\t * rest of the data.\n142\t */\n143\tcnx_stress_stream_ctx_t* cnx_stress_create_stream_context(\n144\t    cnx_stress_callback_ctx_t* cnx_ctx,\n145\t    uint64_t stream_id) {\n146\t    cnx_stress_stream_ctx_t* stream_ctx = (cnx_stress_stream_ctx_t*)malloc(sizeof(cnx_stress_stream_ctx_t));\n147\t    if (stream_ctx != NULL) {\n148\t        memset(stream_ctx, 0, sizeof(cnx_stress_stream_ctx_t));\n149\t        if (cnx_ctx->last_stream == NULL) {\n150\t            cnx_ctx->first_stream = stream_ctx;\n151\t        }\n152\t        else {\n153\t            stream_ctx->previous_stream = cnx_ctx->last_stream;\n154\t            cnx_ctx->last_stream->next_stream = stream_ctx;\n155\t        }\n156\t        cnx_ctx->last_stream = stream_ctx;\n157\t        stream_ctx->stream_id = stream_id;\n158\t    }\n159\t    return stream_ctx;\n160\t}\n161\t\n162\tvoid cnx_stress_delete_stream_context(\n163\t    cnx_stress_callback_ctx_t* cnx_ctx, cnx_stress_stream_ctx_t* stream_ctx) {\n164\t    if (stream_ctx != NULL) {\n165\t        /* Unchain the stream context */\n166\t        if (stream_ctx == cnx_ctx->first_stream) {\n167\t            cnx_ctx->first_stream = stream_ctx->next_stream;\n168\t        }\n169\t        else {\n170\t            stream_ctx->previous_stream->next_stream = stream_ctx->next_stream;\n171\t        }\n172\t        if (stream_ctx == cnx_ctx->last_stream) {\n173\t            cnx_ctx->last_stream = stream_ctx->previous_stream;\n174\t        }\n175\t        else {\n176\t            stream_ctx->next_stream->previous_stream = stream_ctx->previous_stream;\n177\t        }\n178\t        /* Remove from connection context */\n179\t        picoquic_unlink_app_stream_ctx(cnx_ctx->cnx, stream_ctx->stream_id);\n180\t        /* Release the memory */\n181\t        memset(stream_ctx, 0, sizeof(cnx_stress_stream_ctx_t));\n182\t        free(stream_ctx);\n183\t    }\n184\t}\n185\t\n186\tcnx_stress_callback_ctx_t* cnx_stress_callback_create_context(cnx_stress_ctx_t * stress_ctx,\n187\t    picoquic_cnx_t* cnx, int mode) {\n188\t    cnx_stress_callback_ctx_t* cnx_ctx = (cnx_stress_callback_ctx_t*)malloc(sizeof(cnx_stress_callback_ctx_t));\n189\t    if (cnx_ctx != NULL) {\n190\t        memset(cnx_ctx, 0, sizeof(cnx_stress_callback_ctx_t));\n191\t        cnx_ctx->stress_ctx = stress_ctx;\n192\t        cnx_ctx->cnx = cnx;\n193\t        cnx_ctx->mode = mode;\n194\t        if (mode == 0) {\n195\t            stress_ctx->c_ctx[stress_ctx->nb_clients] = cnx_ctx;\n196\t            cnx_ctx->rank = stress_ctx->nb_clients;\n197\t            stress_ctx->nb_clients += 1;\n198\t        } else if (mode == 1) {\n199\t            cnx_ctx->stress_ctx->s_ctx[cnx_ctx->stress_ctx->nb_servers] = cnx_ctx;\n200\t            cnx_ctx->rank = cnx_ctx->stress_ctx->nb_servers;\n201\t            cnx_ctx->stress_ctx->nb_servers += 1;\n202\t        }\n203\t        else {\n204\t            /* Pseudo context, used for setting default context on server */\n205\t        }\n206\t    }\n207\t    return cnx_ctx;\n208\t}\n209\t\n210\tvoid cnx_stress_callback_delete_context(cnx_stress_callback_ctx_t* cnx_ctx) {\n211\t    if (cnx_ctx->mode == 0) {\n212\t        if (cnx_ctx->stress_ctx->is_limit_test &&\n213\t            cnx_ctx->rank == cnx_ctx->stress_ctx->nb_client_target - 1 &&\n214\t            cnx_ctx->cnx->cnx_state == picoquic_state_disconnected &&\n215\t            cnx_ctx->cnx->remote_error == PICOQUIC_TRANSPORT_SERVER_BUSY) {\n216\t            /* This test verifies that the limit test is successful */\n217\t            cnx_ctx->stress_ctx->limit_test_got_server_busy = 1;\n218\t        }\n219\t        cnx_ctx->stress_ctx->c_ctx[cnx_ctx->rank] = NULL;\n220\t    }\n221\t    else if (cnx_ctx->mode == 1) {\n222\t        cnx_ctx->stress_ctx->s_ctx[cnx_ctx->rank] = NULL;\n223\t    }\n224\t    while (cnx_ctx->first_stream != NULL) {\n225\t        cnx_stress_delete_stream_context(cnx_ctx, cnx_ctx->last_stream);\n226\t    }\n227\t    memset(cnx_ctx, 0, sizeof(cnx_stress_callback_ctx_t));\n228\t    free(cnx_ctx);\n229\t}\n230\t\n231\tint cnx_stress_callback_data(cnx_stress_callback_ctx_t* cnx_ctx,\n232\t    cnx_stress_stream_ctx_t* stream_ctx, uint64_t stream_id, uint8_t* bytes, size_t length,\n233\t    picoquic_call_back_event_t fin_or_event)\n234\t{\n235\t    int ret = 0;\n236\t    /* If this is the first reference to the stream, create a context */\n237\t    if (stream_ctx == NULL) {\n238\t        stream_ctx = cnx_stress_create_stream_context(cnx_ctx, stream_id);\n239\t        if (stream_ctx == NULL) {\n240\t            ret = -1;\n241\t        }\n242\t        else {\n243\t            ret = picoquic_set_app_stream_ctx(cnx_ctx->cnx, stream_id, stream_ctx);\n244\t        }\n245\t    }\n246\t\n247\t    if (ret == 0) {\n248\t        /* Handle arrival of data on the stream: decode stream header if not yet received. */\n249\t        while (length > 0 && stream_ctx->nb_bytes_received < 8) {\n250\t            stream_ctx->send_time <<= 8;\n251\t            stream_ctx->send_time += *bytes;\n252\t            bytes++;\n253\t            length--;\n254\t            stream_ctx->nb_bytes_received++;\n255\t        }\n256\t        while (length > 0 && stream_ctx->nb_bytes_received < 16) {\n257\t            stream_ctx->nb_bytes_expected <<= 8;\n258\t            stream_ctx->nb_bytes_expected += *bytes;\n259\t            bytes++;\n260\t            length--;\n261\t            stream_ctx->nb_bytes_received++;\n262\t        }\n263\t        if (length > 0) {\n264\t            stream_ctx->nb_bytes_received += length;\n265\t        }\n266\t        /* On FIN or RESET, terminate the stream */\n267\t        if (fin_or_event == picoquic_callback_stream_fin) {\n268\t            /* If FIN received: if not enough data, record an error. Else,\n269\t             * accumulate the statistics. */\n270\t            cnx_stress_ctx_t* stress_ctx = cnx_ctx->stress_ctx;\n271\t            if (stream_ctx->nb_bytes_received < 16 ||\n272\t                stream_ctx->nb_bytes_received < stream_ctx->nb_bytes_expected) {\n273\t                /* Receive error */\n274\t                stress_ctx->nb_messages_errors++;\n275\t            }\n276\t            else {\n277\t                uint64_t time_now = picoquic_get_quic_time(cnx_ctx->cnx->quic);\n278\t                int64_t delta_t = time_now - stream_ctx->send_time;\n279\t                stress_ctx->nb_messages_received++;\n280\t                stress_ctx->sum_message_delays += delta_t;\n281\t                stress_ctx->sum_square_message_delays += ((double)delta_t) * ((double)delta_t);\n282\t                if (delta_t > stress_ctx->message_delay_max) {\n283\t                    stress_ctx->message_delay_max = delta_t;\n284\t                }\n285\t                if (delta_t < stress_ctx->message_delay_min) {\n286\t                    if (delta_t < 10000) {\n287\t                        DBG_PRINTF(\"Unexpected message delay; %d\", (int)delta_t);\n288\t                    }\n289\t                    stress_ctx->message_delay_min = delta_t;\n290\t                }\n291\t            }\n292\t            /* Delete the stream context */\n293\t            cnx_stress_delete_stream_context(cnx_ctx, stream_ctx);\n294\t        }\n295\t    }\n296\t\n297\t    return ret;\n298\t}\n299\t\n300\tint cnx_stress_callback_prepare_to_send(cnx_stress_callback_ctx_t* cnx_ctx,\n301\t    cnx_stress_stream_ctx_t* stream_ctx, uint64_t UNUSED(stream_id),\n302\t    void* context, size_t length)\n303\t{\n304\t    int ret = 0;\n305\t    size_t data_length = length;\n306\t    uint8_t* buffer;\n307\t    int is_fin = 0;\n308\t#ifdef _WINDOWS\n309\t    UNREFERENCED_PARAMETER(stream_id);\n310\t#endif\n311\t    /* Compute the number of bytes that can be sent */\n312\t    if (stream_ctx->nb_bytes_sent + data_length >= stream_ctx->nb_bytes_expected) {\n313\t        data_length = (size_t)(stream_ctx->nb_bytes_expected - stream_ctx->nb_bytes_sent);\n314\t        is_fin = 1;\n315\t    }\n316\t    buffer = picoquic_provide_stream_data_buffer(context, data_length, is_fin, !is_fin);\n317\t    \n318\t    if (buffer != NULL) {\n319\t        /* If the first 16 bytes have not been sent yet, send the header */\n320\t        while (data_length > 0 && stream_ctx->nb_bytes_sent < 8) {\n321\t            *buffer = (uint8_t)((stream_ctx->send_time >> (8 * (7 - stream_ctx->nb_bytes_sent))) & 0xff);\n322\t            buffer++; \n323\t            stream_ctx->nb_bytes_sent++;\n324\t            data_length--;\n325\t        }\n326\t        while (data_length > 0 && stream_ctx->nb_bytes_sent < 16) {\n327\t            *buffer = (uint8_t)((stream_ctx->nb_bytes_expected >> (8 * (15 - stream_ctx->nb_bytes_sent))) & 0xff);\n328\t            buffer++;\n329\t            stream_ctx->nb_bytes_sent++;\n330\t            data_length--;\n331\t        }\n332\t        /* Fill the reminder with data */\n333\t        if (data_length > 0) {\n334\t            memset(buffer, 'z', data_length);\n335\t        }\n336\t\n337\t        if (is_fin) {\n338\t            /* delete the stream context */\n339\t            cnx_stress_delete_stream_context(cnx_ctx, stream_ctx);\n340\t        }\n341\t    }\n342\t    else {\n343\t        ret = -1;\n344\t    }\n345\t\n346\t    return ret;\n347\t}\n348\t\n349\tint cnx_stress_callback(picoquic_cnx_t* cnx,\n350\t    uint64_t stream_id, uint8_t* bytes, size_t length,\n351\t    picoquic_call_back_event_t fin_or_event, void* callback_ctx, void* v_stream_ctx)\n352\t{\n353\t    int ret = 0;\n354\t    cnx_stress_callback_ctx_t* cnx_ctx = (cnx_stress_callback_ctx_t*)callback_ctx;\n355\t    cnx_stress_stream_ctx_t* stream_ctx = (cnx_stress_stream_ctx_t*)v_stream_ctx;\n356\t\n357\t    if (cnx_ctx == NULL) {\n358\t        /* Unexpected error: for the clients the contexts are created by the\n359\t         * application before starting the connection. For the server, the\n360\t         * connections are created with a default context */\n361\t        picoquic_close(cnx, PICOQUIC_TRANSPORT_INTERNAL_ERROR);\n362\t        return -1;\n363\t    }\n364\t    else if (cnx_ctx->cnx == NULL) {\n365\t        if (fin_or_event == picoquic_callback_stateless_reset ||\n366\t            fin_or_event == picoquic_callback_close ||\n367\t            fin_or_event == picoquic_callback_application_close) {\n368\t            /* Nothing to do */\n369\t            return 0;\n370\t        }\n371\t        else {\n372\t            /* In the case of server connections, the connection is NULL for the\n373\t             * default context. It should be initialized with a proper context */\n374\t            cnx_ctx = cnx_stress_callback_create_context(cnx_ctx->stress_ctx, cnx, 1);\n375\t            if (cnx_ctx == NULL) {\n376\t                /* cannot handle the connection */\n377\t                picoquic_close(cnx, PICOQUIC_TRANSPORT_INTERNAL_ERROR);\n378\t                return -1;\n379\t            }\n380\t            else {\n381\t                picoquic_set_callback(cnx, cnx_stress_callback, cnx_ctx);\n382\t            }\n383\t        }\n384\t    }\n385\t    else if (cnx_ctx->cnx != cnx) {\n386\t        DBG_PRINTF(\"%s\", \"Invalid connection context!\");\n387\t        ret = -1;\n388\t    }\n389\t\n390\t    switch (fin_or_event) {\n391\t    case picoquic_callback_stream_data:\n392\t    case picoquic_callback_stream_fin:\n393\t        /* Data arrival on stream #x, maybe with fin mark */\n394\t        ret = cnx_stress_callback_data(cnx_ctx, stream_ctx, stream_id, bytes, length, fin_or_event);\n395\t        break;\n396\t    case picoquic_callback_stream_reset: \n397\t        /* Sender reset stream, abandon transmission */\n398\t        if (stream_ctx != NULL) {\n399\t            /* Mark the stream as abandoned before full transmission */\n400\t            cnx_ctx->stress_ctx->nb_messages_errors += 1;\n401\t            /* delete the stream context */\n402\t            cnx_stress_delete_stream_context(cnx_ctx, stream_ctx);\n403\t        }\n404\t        break;\n405\t    case picoquic_callback_stop_sending: /* Client asks server to reset stream #x */\n406\t        /* TODO: probably no need for this in the test application. */\n407\t        break;\n408\t    case picoquic_callback_stateless_reset:\n409\t    case picoquic_callback_close: /* Received connection close */\n410\t    case picoquic_callback_application_close: /* Received application close */\n411\t        cnx_stress_callback_delete_context(cnx_ctx);\n412\t        picoquic_set_callback(cnx, NULL, NULL);\n413\t        break;\n414\t    case picoquic_callback_stream_gap:\n415\t        /* Gap indication, when unreliable streams are supported */\n416\t        /* Should trigger a failure */\n417\t        break;\n418\t    case picoquic_callback_prepare_to_send:\n419\t        ret = cnx_stress_callback_prepare_to_send(cnx_ctx, stream_ctx, stream_id, (void*)bytes, length);\n420\t        break;\n421\t    case picoquic_callback_almost_ready:\n422\t    case picoquic_callback_ready:\n423\t        break;\n424\t    case picoquic_callback_datagram:/* No datagram support */\n425\t        break;\n426\t    case picoquic_callback_version_negotiation:\n427\t        break;\n428\t    case picoquic_callback_request_alpn_list: /* Provide the list of supported ALPN */\n429\t    case picoquic_callback_set_alpn: /* Set ALPN to negotiated value */\n430\t        break;\n431\t    default:\n432\t        /* unexpected */\n433\t        break;\n434\t    }\n435\t\n436\t    return ret;\n437\t}\n438\t\n439\t/* Handling of data messages.\n440\t * The simulation generates messages at specified intervals, in turn from\n441\t * the server and from the client. For each message, the simulation\n442\t * picks a target connection from the connections already established.\n443\t * This requires being able to select a connection context at random\n444\t * from those established on the client side or the server side.\n445\t * We need a structure for that, so we can retrieve the connection context,\n446\t * with the following constraints:\n447\t * 1) Light weigth\n448\t * 2) Synchronized with creation and deletion of contexts at clients or server.\n449\t * The synchronization will be achieved through the per connection callback\n450\t * mechanism. The callback context holds the index of the connection in the\n451\t * array. It is initialized on the client side when the connection is\n452\t * created, and on the server side when the connection context is created.\n453\t * It is deleted and the pointer set to null when the \"end of connection\"\n454\t * callback is received.\n455\t * We need to monitor the transmission delay of messages, in simulation time.\n456\t * For that, we encode the sending time in the message, and retrieve it when\n457\t * the message is received.\n458\t * Each message is sent on its own one-way stream, delineated by the end of\n459\t * stream mechanism. The connection parameters set these \"allowed stream\"\n460\t * parameters to a large enough value to not cause flow control issues.\n461\t * To do: should we keep an array of message departure and arrival times for\n462\t * fine grain statistics, is it enough to compute min, max, average and stdev?\n463\t */\n464\t\n465\tcnx_stress_callback_ctx_t * cnx_stress_cnx_from_rank(\n466\t    int msg_num, int nb_ctx, cnx_stress_callback_ctx_t** v_ctx)\n467\t{\n468\t    int nb_trials = 0;\n469\t    int rank = msg_num % nb_ctx;\n470\t    cnx_stress_callback_ctx_t* cnx_ctx = v_ctx[rank];\n471\t    while ((cnx_ctx == NULL || cnx_ctx->cnx == NULL) && nb_trials < nb_ctx) {\n472\t        rank = (rank + 1) % nb_ctx;\n473\t        cnx_ctx = v_ctx[rank];\n474\t        nb_trials++;\n475\t    }\n476\t    return cnx_ctx;\n477\t}\n478\t\n479\tint cnx_stress_initiate_message(cnx_stress_ctx_t* stress_ctx)\n480\t{\n481\t    /* Client or server? */\n482\t    int ret = 0;\n483\t    cnx_stress_callback_ctx_t* cnx_ctx;\n484\t\n485\t    stress_ctx->nb_messages_sent += 1;\n486\t    cnx_ctx = ((stress_ctx->nb_messages_sent & 1) != 0) ?\n487\t        cnx_stress_cnx_from_rank(stress_ctx->nb_messages_sent,\n488\t            stress_ctx->nb_clients, stress_ctx->c_ctx):\n489\t        cnx_stress_cnx_from_rank(stress_ctx->nb_messages_sent,\n490\t            stress_ctx->nb_servers, stress_ctx->s_ctx);\n491\t    if (cnx_ctx == NULL) {\n492\t        ret = -1;\n493\t    }\n494\t    else {\n495\t        uint64_t stream_id = picoquic_get_next_local_stream_id(cnx_ctx->cnx, 1);\n496\t        cnx_stress_stream_ctx_t* stream_ctx = cnx_stress_create_stream_context(cnx_ctx, stream_id);\n497\t        if (stream_ctx == NULL) {\n498\t            ret = -1;\n499\t        }\n500\t        else {\n501\t            stream_ctx->send_time = stress_ctx->simulated_time;\n502\t            stream_ctx->nb_bytes_expected = stress_ctx->message_size;\n503\t\n504\t            ret = picoquic_mark_active_stream(cnx_ctx->cnx, stream_id, 1, stream_ctx);\n505\t        }\n506\t    }\n507\t    return ret;\n508\t}\n509\t\n510\tint cnx_stress_create_client_cnx(cnx_stress_ctx_t* stress_ctx)\n511\t{\n512\t    int ret = 0;\n513\t    picoquic_cnx_t* cnx = picoquic_create_cnx(\n514\t        stress_ctx->qclient, picoquic_null_connection_id, picoquic_null_connection_id,\n515\t        (struct sockaddr*) & stress_ctx->server_addr, stress_ctx->simulated_time, 0,\n516\t        PICOQUIC_TEST_SNI, CNX_STRESS_ALPN, 1);\n517\t    if (cnx == NULL) {\n518\t        ret = -1;\n519\t    }\n520\t    else {\n521\t        /* Create the context and register it in cnx  stress context */\n522\t        cnx_stress_callback_ctx_t* cnx_ctx = cnx_stress_callback_create_context(\n523\t            stress_ctx, cnx, 0);\n524\t        if (cnx_ctx == NULL) {\n525\t            picoquic_delete_cnx(cnx);\n526\t            ret = -1;\n527\t        }\n528\t        else {\n529\t            /* Set callback */\n530\t            picoquic_set_callback(cnx, cnx_stress_callback, cnx_ctx);\n531\t            /* Set keep alive to default value based on timeout. */\n532\t            picoquic_enable_keep_alive(cnx, 0);\n533\t            /* start the connection */\n534\t            ret = picoquic_start_client_cnx(cnx);\n535\t        }\n536\t    }\n537\t    return ret;\n538\t}\n539\t\n540\tint cnx_stress_close_one_connection(cnx_stress_ctx_t* stress_ctx)\n541\t{\n542\t    /* TODO: consider closing the connections in a random order. */\n543\t    int ret = 0;\n544\t    int rank;\n545\t\n546\t    stress_ctx->nb_clients_deleted++;\n547\t    rank = stress_ctx->nb_clients - stress_ctx->nb_clients_deleted;\n548\t\n549\t    if (stress_ctx->c_ctx[rank] != NULL) {\n550\t        ret = picoquic_close(stress_ctx->c_ctx[rank]->cnx, 0);\n551\t    }\n552\t\n553\t    return ret;\n554\t}\n555\t\n556\tint cnx_stress_link_arrival(picoquic_quic_t * quic, picoquictest_sim_link_t * link, \n557\t    uint64_t current_time)\n558\t{\n559\t    int ret = 0;\n560\t    picoquictest_sim_packet_t* packet =\n561\t        picoquictest_sim_link_dequeue(link, current_time);\n562\t\n563\t    if (packet != NULL) {\n564\t        ret = picoquic_incoming_packet(quic, packet->bytes,\n565\t            (uint32_t)packet->length,\n566\t            (struct sockaddr*) & packet->addr_from,\n567\t            (struct sockaddr*) & packet->addr_to, 0, 0, current_time);\n568\t        free(packet);\n569\t    }\n570\t    return ret;\n571\t}\n572\t\n573\tint cnx_stress_prepare(picoquic_quic_t* quic, picoquictest_sim_link_t* link,\n574\t    struct sockaddr * default_source, uint64_t current_time)\n575\t{\n576\t    int ret = 0;\n577\t    picoquictest_sim_packet_t* packet = picoquictest_sim_link_create_packet();\n578\t\n579\t    if (packet == NULL) {\n580\t        ret = -1;\n581\t    } else {\n582\t        picoquic_connection_id_t log_cid;\n583\t        picoquic_cnx_t* last_cnx;\n584\t        int if_index = 0;\n585\t\n586\t        ret = picoquic_prepare_next_packet(quic, current_time, packet->bytes, \n587\t            PICOQUIC_MAX_PACKET_SIZE, &packet->length,\n588\t            &packet->addr_to, &packet->addr_from, &if_index, &log_cid, &last_cnx);\n589\t\n590\t        if (ret == 0 && packet->length > 0) {\n591\t            if (packet->addr_from.ss_family == AF_UNSPEC) {\n592\t                picoquic_store_addr(&packet->addr_from, default_source);\n593\t            }\n594\t            picoquictest_sim_link_submit(link, packet, current_time);\n595\t        }\n596\t        else {\n597\t            free(packet);\n598\t        }\n599\t    }\n600\t    return ret;\n601\t}\n602\t\n603\t/* Loop -- manage arrival of clients, traffic, messages, etc. */\n604\tint cnx_stress_loop_step(cnx_stress_ctx_t * stress_ctx)\n605\t{\n606\t    int ret = 0;\n607\t    cnx_stress_event_enum next_event = cnx_stress_event_none;\n608\t    uint64_t next_time = UINT64_MAX;\n609\t\n610\t    /* Is it time to inject a message ? */\n611\t    if (stress_ctx->next_message_creation_time < next_time) {\n612\t        next_event = cnx_stress_event_new_message;\n613\t        next_time = stress_ctx->next_message_creation_time;\n614\t    }\n615\t    /* Is it time to inject a new connection? */\n616\t    if (stress_ctx->next_client_creation_time < next_time) {\n617\t        next_event = cnx_stress_event_client_creation;\n618\t        next_time = stress_ctx->next_client_creation_time;\n619\t    }\n620\t    /* Is it time to delete a connection? */\n621\t    if (stress_ctx->next_client_deletion_time < next_time) {\n622\t        next_event = cnx_stress_event_client_removal;\n623\t        next_time = stress_ctx->next_client_deletion_time;\n624\t    }\n625\t    /* Is it time for client message arrival? */\n626\t    if (stress_ctx->link_to_clients->first_packet != NULL &&\n627\t        stress_ctx->link_to_clients->first_packet->arrival_time < next_time) {\n628\t        next_event = cnx_stress_event_client_arrival;\n629\t        next_time = stress_ctx->link_to_clients->first_packet->arrival_time;\n630\t    }\n631\t    /* Is it time for client message preparation? */\n632\t    if (picoquic_get_next_wake_time(stress_ctx->qclient, stress_ctx->simulated_time) < next_time) {\n633\t        next_event = cnx_stress_event_client_prepare;\n634\t        next_time = picoquic_get_next_wake_time(stress_ctx->qclient, stress_ctx->simulated_time);\n635\t    }\n636\t    /* Is it time for server message arrival? */\n637\t    if (stress_ctx->link_to_server->first_packet != NULL && \n638\t        stress_ctx->link_to_server->first_packet->arrival_time < next_time) {\n639\t        next_event = cnx_stress_event_server_arrival;\n640\t        next_time = stress_ctx->link_to_server->first_packet->arrival_time;\n641\t    }\n642\t    /* Is it time for server message preparation? */\n643\t    if (picoquic_get_next_wake_time(stress_ctx->qserver, stress_ctx->simulated_time) < next_time) {\n644\t        next_event = cnx_stress_event_server_prepare;\n645\t        next_time = picoquic_get_next_wake_time(stress_ctx->qserver, stress_ctx->simulated_time);\n646\t    }\n647\t    /* Update the simulation time based on next time */\n648\t    if (next_time > stress_ctx->simulated_time) {\n649\t        stress_ctx->simulated_time = next_time;\n650\t    }\n651\t    /* TODO: Execute the selected action */\n652\t    switch (next_event) {\n653\t    case cnx_stress_event_new_message:\n654\t        ret = cnx_stress_initiate_message(stress_ctx);\n655\t        if (stress_ctx->nb_messages_sent >= stress_ctx->nb_messages_target) {\n656\t            stress_ctx->next_message_creation_time = UINT64_MAX;\n657\t        }\n658\t        else {\n659\t            stress_ctx->next_message_creation_time += stress_ctx->message_creation_interval;\n660\t        }\n661\t        break;\n662\t    case cnx_stress_event_client_creation:\n663\t        ret = cnx_stress_create_client_cnx(stress_ctx);\n664\t        /* Prep the next connection time. */\n665\t        if (stress_ctx->nb_clients >= stress_ctx->nb_client_target) {\n666\t            stress_ctx->next_client_creation_time = UINT64_MAX;\n667\t        }\n668\t        else {\n669\t            stress_ctx->next_client_creation_time += stress_ctx->client_creation_interval;\n670\t        }\n671\t        break;\n672\t    case cnx_stress_event_client_removal:\n673\t        ret = cnx_stress_close_one_connection(stress_ctx);\n674\t        if (stress_ctx->nb_clients_deleted >= stress_ctx->nb_clients) {\n675\t            stress_ctx->next_client_deletion_time = UINT64_MAX;\n676\t        }\n677\t        else {\n678\t            stress_ctx->next_client_deletion_time += stress_ctx->client_deletion_interval;\n679\t        }\n680\t        break;\n681\t    case cnx_stress_event_client_arrival:\n682\t        /* If there is something to receive on the client , do it now */\n683\t        ret = cnx_stress_link_arrival(stress_ctx->qclient,\n684\t            stress_ctx->link_to_clients, stress_ctx->simulated_time);\n685\t        break;\n686\t    case cnx_stress_event_client_prepare:\n687\t        /* If a client packet is ready to send, send it. */\n688\t        ret = cnx_stress_prepare(stress_ctx->qclient, stress_ctx->link_to_server,\n689\t            (struct sockaddr *)&stress_ctx->client_addr, stress_ctx->simulated_time);\n690\t        break;\n691\t    case cnx_stress_event_server_arrival:\n692\t        /* If there is something to receive on the client , do it now */\n693\t        ret = cnx_stress_link_arrival(stress_ctx->qserver,\n694\t            stress_ctx->link_to_server, stress_ctx->simulated_time);\n695\t        break;\n696\t    case cnx_stress_event_server_prepare:\n697\t        /* If a client packet is ready to send, send it. */\n698\t        ret = cnx_stress_prepare(stress_ctx->qserver, stress_ctx->link_to_clients,\n699\t            (struct sockaddr*) & stress_ctx->server_addr, stress_ctx->simulated_time);\n700\t        break;\n701\t    default:\n702\t        ret = -1;\n703\t        break;\n704\t    }\n705\t\n706\t    return ret;\n707\t}\n708\t\n709\t/* Connection stress:\n710\t *\n711\t *  Create a QUIC context for the server\n712\t *  Create a QUIC context for the client\n713\t *  Create simulated links from client to server and vice-versa\n714\t *  In a loop, until the desired number of connections is obtained\n715\t *      Create a new connection on the client\n716\t *      Queue a first message on that client connection\n717\t *      Run the simulated send/receive loop for a small number of iterations\n718\t *   Once all clients are created\n719\t *       Run the simulation until the desired time interval has passed\n720\t *  In a loop, close each of the connections\n721\t *\n722\t * All that while getting statistics on:\n723\t *\n724\t *   The simulated connection establishment delays\n725\t *   The simulated message delays from injection to delivery\n726\t *   Whether undesirable events occur, e.g., loss of connections\n727\t *   The \"real time\" required to run the test for the simulated time\n728\t *\n729\t */\n730\t\n731\t/* Set transport parameters to adequate value for cnx stress */\n732\tint cnx_stress_set_default_tp(picoquic_quic_t* quic)\n733\t{\n734\t    int ret = 0;\n735\t    picoquic_tp_t tp;\n736\t    memset(&tp, 0, sizeof(picoquic_tp_t));\n737\t    /* This is a server context. The \"remote\" bidi streams are those\n738\t        * initiated by the client, and should be authorized to send\n739\t        * a 64K-1 packet */\n740\t    tp.initial_max_stream_data_bidi_local = 0;\n741\t    tp.initial_max_stream_data_bidi_remote = 0;\n742\t    tp.initial_max_stream_id_bidir = 0;\n743\t    tp.initial_max_stream_data_uni = 0x20000;\n744\t    tp.initial_max_stream_id_unidir = 64;\n745\t    tp.initial_max_data = 0x20000;\n746\t    tp.max_idle_timeout = 60000;\n747\t    tp.max_packet_size = PICOQUIC_MAX_PACKET_SIZE;\n748\t    tp.max_ack_delay = 10000;\n749\t    tp.active_connection_id_limit = 3;\n750\t    tp.ack_delay_exponent = 3;\n751\t    tp.migration_disabled = 0;\n752\t    ret = picoquic_set_default_tp(quic, &tp);\n753\t    return ret;\n754\t}\n755\t\n756\tvoid cnx_stress_delete_ctx(cnx_stress_ctx_t* stress_ctx)\n757\t{\n758\t    if (stress_ctx->link_to_clients != NULL) {\n759\t        picoquictest_sim_link_delete(stress_ctx->link_to_clients);\n760\t        stress_ctx->link_to_clients = NULL;\n761\t    }\n762\t\n763\t    if (stress_ctx->link_to_server != NULL) {\n764\t        picoquictest_sim_link_delete(stress_ctx->link_to_server);\n765\t        stress_ctx->link_to_server = NULL;\n766\t    }\n767\t\n768\t    if (stress_ctx->qserver != NULL) {\n769\t        picoquic_free(stress_ctx->qserver);\n770\t        stress_ctx->qserver = NULL;\n771\t    }\n772\t\n773\t    if (stress_ctx->qclient != NULL) {\n774\t        picoquic_free(stress_ctx->qclient);\n775\t        stress_ctx->qclient = NULL;\n776\t    }\n777\t\n778\t    if (stress_ctx->default_ctx != NULL) {\n779\t        free(stress_ctx->default_ctx);\n780\t        stress_ctx->default_ctx = NULL;\n781\t    }\n782\t\n783\t    if (stress_ctx->c_ctx != NULL) {\n784\t        for (int i = 0; i < stress_ctx->nb_clients; i++) {\n785\t            if (stress_ctx->c_ctx[i] != NULL) {\n786\t                cnx_stress_callback_delete_context(stress_ctx->c_ctx[i]);\n787\t            }\n788\t        }\n789\t        free(stress_ctx->c_ctx);\n790\t        stress_ctx->c_ctx = NULL;\n791\t    }\n792\t\n793\t    if (stress_ctx->s_ctx != NULL) {\n794\t        for (int i = 0; i < stress_ctx->nb_servers; i++) {\n795\t            if (stress_ctx->s_ctx[i] != NULL) {\n796\t                cnx_stress_callback_delete_context(stress_ctx->s_ctx[i]);\n797\t            }\n798\t        }\n799\t        free(stress_ctx->s_ctx);\n800\t        stress_ctx->s_ctx = NULL;\n801\t    }\n802\t\n803\t    free(stress_ctx);\n804\t}\n805\t\n806\tcnx_stress_ctx_t* cnx_stress_create_ctx(uint64_t duration, int nb_clients, int limit_test) \n807\t{\n808\t    cnx_stress_ctx_t* stress_ctx = (cnx_stress_ctx_t*)malloc(sizeof(cnx_stress_ctx_t));\n809\t\n810\t    if (stress_ctx != NULL) {\n811\t        int ret = 0;\n812\t\n813\t        memset(stress_ctx, 0, sizeof(cnx_stress_ctx_t));\n814\t        /* The random seed depends only on initialization parameters */\n815\t        stress_ctx->random_ctx = 0xBabaC001BaddBab1ull;\n816\t        stress_ctx->random_ctx ^= duration;\n817\t        (void)picoquic_test_random(&stress_ctx->random_ctx);\n818\t        stress_ctx->random_ctx ^= (uint64_t)nb_clients;\n819\t        (void)picoquic_test_random(&stress_ctx->random_ctx);\n820\t\n821\t        /* Document addresses for the simulation */\n822\t        picoquic_set_test_address(&stress_ctx->client_addr, 0x08080808, 12345);\n823\t        picoquic_set_test_address(&stress_ctx->server_addr, 0x01010101, 4433);\n824\t\n825\t        /* Set and verify the simulation intervals */\n826\t        stress_ctx->nb_client_target = nb_clients;\n827\t        stress_ctx->client_creation_interval = 2000;\n828\t        stress_ctx->next_client_creation_time = 0;\n829\t        stress_ctx->client_deletion_interval = 100;\n830\t        if ((stress_ctx->client_creation_interval + stress_ctx->client_deletion_interval) * nb_clients\n831\t            > duration) {\n832\t            ret = -1;\n833\t        }\n834\t        else {\n835\t            stress_ctx->next_client_deletion_time = duration -\n836\t                stress_ctx->client_deletion_interval * nb_clients;\n837\t            stress_ctx->nb_messages_target = (nb_clients > 20000) ? 20000 : nb_clients;\n838\t            stress_ctx->message_size = 1024;\n839\t            stress_ctx->message_delay_min = INT64_MAX;\n840\t            stress_ctx->message_creation_interval = stress_ctx->next_client_deletion_time /\n841\t                ((uint64_t)3 * stress_ctx->nb_messages_target);\n842\t            stress_ctx->next_message_creation_time = stress_ctx->next_client_deletion_time / 3;\n843\t            if (stress_ctx->message_creation_interval <= 0) {\n844\t                ret = -1;\n845\t            }\n846\t            else {\n847\t                stress_ctx->c_ctx = (cnx_stress_callback_ctx_t**)malloc(\n848\t                    sizeof(cnx_stress_callback_ctx_t*) * (nb_clients + limit_test));\n849\t                if (stress_ctx->c_ctx != NULL) {\n850\t                    memset(stress_ctx->c_ctx, 0, \n851\t                        sizeof(cnx_stress_callback_ctx_t*) * (nb_clients + limit_test));\n852\t                }\n853\t                stress_ctx->s_ctx = (cnx_stress_callback_ctx_t**)malloc(\n854\t                    sizeof(cnx_stress_callback_ctx_t*) * (nb_clients + limit_test));\n855\t                if (stress_ctx->s_ctx != NULL) {\n856\t                    memset(stress_ctx->s_ctx, 0, sizeof(cnx_stress_callback_ctx_t*) * (nb_clients + limit_test));\n857\t                }\n858\t                stress_ctx->default_ctx = cnx_stress_callback_create_context(stress_ctx, NULL, 2);\n859\t                if (stress_ctx->s_ctx == NULL || stress_ctx->c_ctx == NULL || stress_ctx->default_ctx == NULL) {\n860\t                    ret = -1;\n861\t                }\n862\t                else {\n863\t                    char test_server_cert_file[512];\n864\t                    char test_server_key_file[512];\n865\t\n866\t                    ret = picoquic_get_input_path(test_server_cert_file, sizeof(test_server_cert_file), picoquic_solution_dir, PICOQUIC_TEST_FILE_SERVER_CERT);\n867\t\n868\t                    if (ret == 0) {\n869\t                        ret = picoquic_get_input_path(test_server_key_file, sizeof(test_server_key_file), picoquic_solution_dir, PICOQUIC_TEST_FILE_SERVER_KEY);\n870\t                    }\n871\t                    if (ret == 0) {\n872\t                        stress_ctx->qclient = picoquic_create((nb_clients + limit_test), NULL, NULL,\n873\t                            NULL, CNX_STRESS_ALPN, NULL, NULL, NULL, NULL,\n874\t                            NULL, stress_ctx->simulated_time, &stress_ctx->simulated_time,\n875\t                            NULL, NULL, 0);\n876\t                        stress_ctx->qserver = picoquic_create(nb_clients, test_server_cert_file, test_server_key_file,\n877\t                            NULL, CNX_STRESS_ALPN, cnx_stress_callback, stress_ctx->default_ctx, NULL, NULL,\n878\t                            NULL, stress_ctx->simulated_time, &stress_ctx->simulated_time,\n879\t                            NULL, NULL, 0);\n880\t                        stress_ctx->link_to_clients = picoquictest_sim_link_create(1.0,\n881\t                            10000, NULL, 20000, 0);\n882\t                        stress_ctx->link_to_server = picoquictest_sim_link_create(1.0,\n883\t                            10000, NULL, 20000, 0);\n884\t                        if (stress_ctx->qclient == NULL || stress_ctx->qserver == NULL ||\n885\t                            stress_ctx->link_to_clients == NULL || stress_ctx->link_to_server == NULL) {\n886\t                            ret = -1;\n887\t                        }\n888\t                        else {\n889\t                            ret = picoquic_set_low_memory_mode(stress_ctx->qclient, 1);\n890\t                            if (ret == 0) {\n891\t                                ret = picoquic_set_low_memory_mode(stress_ctx->qserver, 1);\n892\t                            }\n893\t                            if (ret == 0) {\n894\t                                ret = cnx_stress_set_default_tp(stress_ctx->qclient);\n895\t                            }\n896\t                            if (ret == 0) {\n897\t                                ret = cnx_stress_set_default_tp(stress_ctx->qserver);\n898\t                            }\n899\t                        }\n900\t                    }\n901\t                }\n902\t            }\n903\t        }\n904\t\n905\t        if (ret != 0) {\n906\t            cnx_stress_delete_ctx(stress_ctx);\n907\t            stress_ctx = NULL;\n908\t        }\n909\t    }\n910\t    return stress_ctx;\n911\t}\n912\t\n913\tint cnx_stress_do_test(uint64_t duration, int nb_clients, int do_report)\n914\t{\n915\t    int ret = 0;\n916\t    cnx_stress_ctx_t* stress_ctx = cnx_stress_create_ctx(duration, nb_clients, 0);\n917\t\n918\t    if (stress_ctx != NULL) {\n919\t        uint64_t wall_time_start = picoquic_current_time();\n920\t\n921\t        /* loop until time exhausted */\n922\t        while (ret == 0 && stress_ctx->simulated_time < duration) {\n923\t            ret = cnx_stress_loop_step(stress_ctx);\n924\t        }\n925\t\n926\t        if (ret == 0) {\n927\t            uint64_t wall_time_end = picoquic_current_time();\n928\t            uint64_t wall_time_elapsed = wall_time_end - wall_time_start;\n929\t\n930\t            if (wall_time_elapsed > stress_ctx->simulated_time) {\n931\t                DBG_PRINTF(\"Simulating %\" PRIu64 \" in %\" PRIu64, \n932\t                    stress_ctx->simulated_time, wall_time_elapsed);\n933\t                ret = -1;\n934\t            }\n935\t            else if (stress_ctx->nb_clients != stress_ctx->nb_client_target ||\n936\t                stress_ctx->nb_servers != stress_ctx->nb_client_target) {\n937\t                DBG_PRINTF(\"Expected %d connections, got %d (client) and %d (server)\",\n938\t                    stress_ctx->nb_client_target, stress_ctx->nb_clients, stress_ctx->nb_servers);\n939\t                ret = -1;\n940\t            }\n941\t            else if (stress_ctx->nb_messages_received != stress_ctx->nb_messages_target) {\n942\t                DBG_PRINTF(\"Expected %d messages, sent %d, received %d\",\n943\t                    stress_ctx->nb_messages_target, \n944\t                    stress_ctx->nb_messages_sent, stress_ctx->nb_messages_received);\n945\t                ret = -1;\n946\t            }\n947\t            else if (do_report) {\n948\t                double msg_avg_delay = (stress_ctx->nb_messages_target > 0) ?\n949\t                    (double)stress_ctx->sum_message_delays / (double)stress_ctx->nb_messages_target : 0;\n950\t                msg_avg_delay /= 1000000.0;\n951\t                fprintf(stdout, \"Many connection stress (cnx_stress) succeeds:\\n\");\n952\t                fprintf(stdout, \"Processed %d connections for %fs (simulated) in %fs (wall time).\\n\",\n953\t                    stress_ctx->nb_client_target,\n954\t                    ((double)stress_ctx->simulated_time)/1000000.0,\n955\t                    ((double)wall_time_elapsed)/1000000.0);\n956\t                fprintf(stdout, \"Processed %d messages, delays min/avg/max= %fs, %fs, %fs.\\n\",\n957\t                    stress_ctx->nb_messages_target, ((double)stress_ctx->message_delay_min)/ 1000000.0,\n958\t                    msg_avg_delay, ((double)stress_ctx->message_delay_max)/ 1000000.0);\n959\t            }\n960\t        }\n961\t\n962\t        cnx_stress_delete_ctx(stress_ctx);\n963\t    }\n964\t    return ret;\n965\t}\n966\t\n967\t/* The unit test entry point executes the cnx stress test with a \n968\t * small duration and a small number of clients, the goal being to check that\n969\t * the cnx stress code actually works. */\n970\tint cnx_stress_unit_test(void)\n971\t{\n972\t    return cnx_stress_do_test(120000000, 100, 0);\n973\t}\n974\t\n975\t/*Connection limit\n976\t * Test that if one attempts to create more than the set limit of\n977\t * connections, it fails. This is complementary to the cnx_stress\n978\t * test, which verifies that if one creates exactly the \"limit\" number of connections, \n979\t * they all succeed.\n980\t */\n981\tint cnx_limit_test(void)\n982\t{\n983\t    int ret = 0;\n984\t    int nb_clients = 4;\n985\t    uint64_t duration = 120000000;\n986\t    cnx_stress_ctx_t* stress_ctx = cnx_stress_create_ctx(duration, nb_clients, 1);\n987\t\n988\t    if (stress_ctx == NULL) {\n989\t        ret = -1;\n990\t    }\n991\t\n992\t    if (stress_ctx != NULL) {\n993\t        int is_done = 0;\n994\t\n995\t        /* loop until time exhausted or all created */\n996\t        while (ret == 0 && stress_ctx->simulated_time < duration && !is_done) {\n997\t            ret = cnx_stress_loop_step(stress_ctx);\n998\t            if (stress_ctx->nb_clients == nb_clients &&\n999\t                stress_ctx->nb_servers == nb_clients) {\n1000\t                is_done = 1;\n1001\t                for (int c = 0; c < nb_clients; c++) {\n1002\t                    if (stress_ctx->c_ctx[c] == NULL ||\n1003\t                        stress_ctx->c_ctx[c]->cnx == NULL ||\n1004\t                        stress_ctx->c_ctx[c]->cnx->cnx_state <\n1005\t                        picoquic_state_client_almost_ready) {\n1006\t                        is_done = 0;\n1007\t                        break;\n1008\t                    }\n1009\t                }\n1010\t            }\n1011\t        }\n1012\t        if (!is_done) {\n1013\t            ret = -1;\n1014\t        }\n1015\t\n1016\t        if (ret == 0) {\n1017\t            /* Try creating one more client. Loop until time exhausted or\n1018\t             * verify new client refused because server busy */\n1019\t\n1020\t            stress_ctx->is_limit_test = 1;\n1021\t            stress_ctx->next_client_creation_time = stress_ctx->simulated_time;\n1022\t            stress_ctx->nb_client_target++;\n1023\t            while (ret == 0 && stress_ctx->simulated_time < duration &&\n1024\t                !stress_ctx->limit_test_got_server_busy) {\n1025\t                ret = cnx_stress_loop_step(stress_ctx);\n1026\t            }\n1027\t            if (!stress_ctx->limit_test_got_server_busy) {\n1028\t                ret = -1;\n1029\t            }\n1030\t        }\n1031\t\n1032\t        cnx_stress_delete_ctx(stress_ctx);\n1033\t    }\n1034\t\n1035\t    return ret;\n1036\t}\n1037\t"}]},"parent_tool_use_id":null,"session_id":"513641af-66d9-4e8b-98cd-e59b8e6a1fb7","uuid":"3650bda8-c406-4b97-809b-514ea4226fe5","timestamp":"2026-05-04T22:22:14.749Z","tool_use_result":{"type":"text","file":{"filePath":"/Users/richbarn/Projects/picoquic/picoquictest/cnxstress.c","content":"/*\n* Author: Christian Huitema\n* Copyright (c) 2020, Private Octopus, Inc.\n* All rights reserved.\n*\n* Permission to use, copy, modify, and distribute this software for any\n* purpose with or without fee is hereby granted, provided that the above\n* copyright notice and this permission notice appear in all copies.\n*\n* THIS SOFTWARE IS PROVIDED BY THE COPYRIGHT HOLDERS AND CONTRIBUTORS \"AS IS\" AND\n* ANY EXPRESS OR IMPLIED WARRANTIES, INCLUDING, BUT NOT LIMITED TO, THE IMPLIED\n* WARRANTIES OF MERCHANTABILITY AND FITNESS FOR A PARTICULAR PURPOSE ARE\n* DISCLAIMED. IN NO EVENT SHALL Private Octopus, Inc. BE LIABLE FOR ANY\n* DIRECT, INDIRECT, INCIDENTAL, SPECIAL, EXEMPLARY, OR CONSEQUENTIAL DAMAGES\n* (INCLUDING, BUT NOT LIMITED TO, PROCUREMENT OF SUBSTITUTE GOODS OR SERVICES;\n* LOSS OF USE, DATA, OR PROFITS; OR BUSINESS INTERRUPTION) HOWEVER CAUSED AND\n* ON ANY THEORY OF LIABILITY, WHETHER IN CONTRACT, STRICT LIABILITY, OR TORT\n* (INCLUDING NEGLIGENCE OR OTHERWISE) ARISING IN ANY WAY OUT OF THE USE OF THIS\n* SOFTWARE, EVEN IF ADVISED OF THE POSSIBILITY OF SUCH DAMAGE.\n*/\n\n#include <stddef.h>\n#include <stdlib.h>\n#include <string.h>\n#ifdef _WINDOWS\n#include \"wincompat.h\"\n#include \"ws2ipdef.h\"\n#pragma warning(disable:4204)\n#else\n#include <signal.h>\n#endif\n#include <picotls.h>\n#include \"picoquic_utils.h\"\n#include \"picoquic_internal.h\"\n#include \"tls_api.h\"\n#include \"picoquictest_internal.h\"\n#define CNX_STRESS_ALPN \"cnxstress\"\n\ntypedef struct st_cnx_stress_stream_ctx_t {\n    /* For receive streams, just look at the first 16 bytes,\n     * ignore the following until everything is received \n     * For send streams, send the first bytes, followed by\n     * random or fixed data up to message size. */\n    struct st_cnx_stress_stream_ctx_t* previous_stream;\n    struct st_cnx_stress_stream_ctx_t* next_stream;\n    uint64_t stream_id;\n    uint64_t send_time;\n    uint64_t nb_bytes_expected;\n    uint64_t nb_bytes_received;\n    uint64_t nb_bytes_sent;\n} cnx_stress_stream_ctx_t;\n\ntypedef struct st_cnx_stress_callback_ctx_t {\n    struct st_cnx_stress_ctx_t* stress_ctx;\n    picoquic_cnx_t* cnx;\n    uint64_t next_stream_send;\n    int mode;\n    int rank;\n    cnx_stress_stream_ctx_t* first_stream;\n    cnx_stress_stream_ctx_t* last_stream;\n} cnx_stress_callback_ctx_t;\n\ntypedef enum {\n    cnx_stress_event_none = 0,\n    cnx_stress_event_new_message,\n    cnx_stress_event_client_creation,\n    cnx_stress_event_client_removal,\n    cnx_stress_event_client_arrival,\n    cnx_stress_event_client_prepare,\n    cnx_stress_event_server_arrival,\n    cnx_stress_event_server_prepare\n} cnx_stress_event_enum;\n\ntypedef struct st_cnx_stress_ctx_t {\n    uint64_t simulated_time;\n    uint64_t random_ctx;\n    picoquic_quic_t* qserver;\n    picoquic_quic_t* qclient;\n    struct sockaddr_in server_addr;\n    struct sockaddr_in client_addr;\n    picoquictest_sim_link_t* link_to_clients;\n    picoquictest_sim_link_t* link_to_server;\n    int is_limit_test;\n    int limit_test_got_server_busy;\n    int nb_clients;\n    int nb_servers;\n    int nb_client_target;\n    int nb_clients_deleted;\n    uint64_t client_creation_interval;\n    uint64_t next_client_creation_time;\n    uint64_t client_deletion_interval;\n    uint64_t next_client_deletion_time;\n    uint64_t message_creation_interval;\n    uint64_t next_message_creation_time;\n    /* Statistics on message arrival delay */\n    int nb_messages_target;\n    size_t message_size;\n    int nb_messages_sent;\n    int nb_messages_errors;\n    int nb_messages_received;\n    int64_t sum_message_delays;\n    double sum_square_message_delays;\n    int64_t message_delay_min;\n    int64_t message_delay_max;\n    /* The array of client and server contexts are created with size \"nb_client target\"\n     * during the initialization of the test. The variables nb_clients and nb_servers\n     * hold the number of clients and servers actually created. */\n    cnx_stress_callback_ctx_t** c_ctx;\n    cnx_stress_callback_ctx_t** s_ctx;\n    cnx_stress_callback_ctx_t* default_ctx;\n} cnx_stress_ctx_t;\n\n#if 0\n/*\n * Portable abort call, should work on Linux and Windows.\n * We deliberately do not call the ASSERT macros, becuse these\n * macros can be made no-op if compiled with NDEBUG\n */\n\nstatic int stress_debug_break(int break_if_fuzzing)\n{\n    if (picoquic_fuzz_in_progress == 0 || break_if_fuzzing) {\n#ifdef _WINDOWS\n        DebugBreak();\n#else\n        raise(SIGTRAP);\n#endif\n        return -1;\n    }\n\n    return 0;\n}\n#endif\n\n/* Callback context and protocol handling.\n * Nothing really special here? For message sending, assume short messages,\n * just use the write and forget API. For message receiving, process to\n * parse the message protocol in real time.\n * Stream context for receive: created when first data arrives on the stream.\n * Context accumulate the message ID from the first 8 bytes, then ignores the\n * rest of the data.\n */\ncnx_stress_stream_ctx_t* cnx_stress_create_stream_context(\n    cnx_stress_callback_ctx_t* cnx_ctx,\n    uint64_t stream_id) {\n    cnx_stress_stream_ctx_t* stream_ctx = (cnx_stress_stream_ctx_t*)malloc(sizeof(cnx_stress_stream_ctx_t));\n    if (stream_ctx != NULL) {\n        memset(stream_ctx, 0, sizeof(cnx_stress_stream_ctx_t));\n        if (cnx_ctx->last_stream == NULL) {\n            cnx_ctx->first_stream = stream_ctx;\n        }\n        else {\n            stream_ctx->previous_stream = cnx_ctx->last_stream;\n            cnx_ctx->last_stream->next_stream = stream_ctx;\n        }\n        cnx_ctx->last_stream = stream_ctx;\n        stream_ctx->stream_id = stream_id;\n    }\n    return stream_ctx;\n}\n\nvoid cnx_stress_delete_stream_context(\n    cnx_stress_callback_ctx_t* cnx_ctx, cnx_stress_stream_ctx_t* stream_ctx) {\n    if (stream_ctx != NULL) {\n        /* Unchain the stream context */\n        if (stream_ctx == cnx_ctx->first_stream) {\n            cnx_ctx->first_stream = stream_ctx->next_stream;\n        }\n        else {\n            stream_ctx->previous_stream->next_stream = stream_ctx->next_stream;\n        }\n        if (stream_ctx == cnx_ctx->last_stream) {\n            cnx_ctx->last_stream = stream_ctx->previous_stream;\n        }\n        else {\n            stream_ctx->next_stream->previous_stream = stream_ctx->previous_stream;\n        }\n        /* Remove from connection context */\n        picoquic_unlink_app_stream_ctx(cnx_ctx->cnx, stream_ctx->stream_id);\n        /* Release the memory */\n        memset(stream_ctx, 0, sizeof(cnx_stress_stream_ctx_t));\n        free(stream_ctx);\n    }\n}\n\ncnx_stress_callback_ctx_t* cnx_stress_callback_create_context(cnx_stress_ctx_t * stress_ctx,\n    picoquic_cnx_t* cnx, int mode) {\n    cnx_stress_callback_ctx_t* cnx_ctx = (cnx_stress_callback_ctx_t*)malloc(sizeof(cnx_stress_callback_ctx_t));\n    if (cnx_ctx != NULL) {\n        memset(cnx_ctx, 0, sizeof(cnx_stress_callback_ctx_t));\n        cnx_ctx->stress_ctx = stress_ctx;\n        cnx_ctx->cnx = cnx;\n        cnx_ctx->mode = mode;\n        if (mode == 0) {\n            stress_ctx->c_ctx[stress_ctx->nb_clients] = cnx_ctx;\n            cnx_ctx->rank = stress_ctx->nb_clients;\n            stress_ctx->nb_clients += 1;\n        } else if (mode == 1) {\n            cnx_ctx->stress_ctx->s_ctx[cnx_ctx->stress_ctx->nb_servers] = cnx_ctx;\n            cnx_ctx->rank = cnx_ctx->stress_ctx->nb_servers;\n            cnx_ctx->stress_ctx->nb_servers += 1;\n        }\n        else {\n            /* Pseudo context, used for setting default context on server */\n        }\n    }\n    return cnx_ctx;\n}\n\nvoid cnx_stress_callback_delete_context(cnx_stress_callback_ctx_t* cnx_ctx) {\n    if (cnx_ctx->mode == 0) {\n        if (cnx_ctx->stress_ctx->is_limit_test &&\n            cnx_ctx->rank == cnx_ctx->stress_ctx->nb_client_target - 1 &&\n            cnx_ctx->cnx->cnx_state == picoquic_state_disconnected &&\n            cnx_ctx->cnx->remote_error == PICOQUIC_TRANSPORT_SERVER_BUSY) {\n            /* This test verifies that the limit test is successful */\n            cnx_ctx->stress_ctx->limit_test_got_server_busy = 1;\n        }\n        cnx_ctx->stress_ctx->c_ctx[cnx_ctx->rank] = NULL;\n    }\n    else if (cnx_ctx->mode == 1) {\n        cnx_ctx->stress_ctx->s_ctx[cnx_ctx->rank] = NULL;\n    }\n    while (cnx_ctx->first_stream != NULL) {\n        cnx_stress_delete_stream_context(cnx_ctx, cnx_ctx->last_stream);\n    }\n    memset(cnx_ctx, 0, sizeof(cnx_stress_callback_ctx_t));\n    free(cnx_ctx);\n}\n\nint cnx_stress_callback_data(cnx_stress_callback_ctx_t* cnx_ctx,\n    cnx_stress_stream_ctx_t* stream_ctx, uint64_t stream_id, uint8_t* bytes, size_t length,\n    picoquic_call_back_event_t fin_or_event)\n{\n    int ret = 0;\n    /* If this is the first reference to the stream, create a context */\n    if (stream_ctx == NULL) {\n        stream_ctx = cnx_stress_create_stream_context(cnx_ctx, stream_id);\n        if (stream_ctx == NULL) {\n            ret = -1;\n        }\n        else {\n            ret = picoquic_set_app_stream_ctx(cnx_ctx->cnx, stream_id, stream_ctx);\n        }\n    }\n\n    if (ret == 0) {\n        /* Handle arrival of data on the stream: decode stream header if not yet received. */\n        while (length > 0 && stream_ctx->nb_bytes_received < 8) {\n            stream_ctx->send_time <<= 8;\n            stream_ctx->send_time += *bytes;\n            bytes++;\n            length--;\n            stream_ctx->nb_bytes_received++;\n        }\n        while (length > 0 && stream_ctx->nb_bytes_received < 16) {\n            stream_ctx->nb_bytes_expected <<= 8;\n            stream_ctx->nb_bytes_expected += *bytes;\n            bytes++;\n            length--;\n            stream_ctx->nb_bytes_received++;\n        }\n        if (length > 0) {\n            stream_ctx->nb_bytes_received += length;\n        }\n        /* On FIN or RESET, terminate the stream */\n        if (fin_or_event == picoquic_callback_stream_fin) {\n            /* If FIN received: if not enough data, record an error. Else,\n             * accumulate the statistics. */\n            cnx_stress_ctx_t* stress_ctx = cnx_ctx->stress_ctx;\n            if (stream_ctx->nb_bytes_received < 16 ||\n                stream_ctx->nb_bytes_received < stream_ctx->nb_bytes_expected) {\n                /* Receive error */\n                stress_ctx->nb_messages_errors++;\n            }\n            else {\n                uint64_t time_now = picoquic_get_quic_time(cnx_ctx->cnx->quic);\n                int64_t delta_t = time_now - stream_ctx->send_time;\n                stress_ctx->nb_messages_received++;\n                stress_ctx->sum_message_delays += delta_t;\n                stress_ctx->sum_square_message_delays += ((double)delta_t) * ((double)delta_t);\n                if (delta_t > stress_ctx->message_delay_max) {\n                    stress_ctx->message_delay_max = delta_t;\n                }\n                if (delta_t < stress_ctx->message_delay_min) {\n                    if (delta_t < 10000) {\n                        DBG_PRINTF(\"Unexpected message delay; %d\", (int)delta_t);\n                    }\n                    stress_ctx->message_delay_min = delta_t;\n                }\n            }\n            /* Delete the stream context */\n            cnx_stress_delete_stream_context(cnx_ctx, stream_ctx);\n        }\n    }\n\n    return ret;\n}\n\nint cnx_stress_callback_prepare_to_send(cnx_stress_callback_ctx_t* cnx_ctx,\n    cnx_stress_stream_ctx_t* stream_ctx, uint64_t UNUSED(stream_id),\n    void* context, size_t length)\n{\n    int ret = 0;\n    size_t data_length = length;\n    uint8_t* buffer;\n    int is_fin = 0;\n#ifdef _WINDOWS\n    UNREFERENCED_PARAMETER(stream_id);\n#endif\n    /* Compute the number of bytes that can be sent */\n    if (stream_ctx->nb_bytes_sent + data_length >= stream_ctx->nb_bytes_expected) {\n        data_length = (size_t)(stream_ctx->nb_bytes_expected - stream_ctx->nb_bytes_sent);\n        is_fin = 1;\n    }\n    buffer = picoquic_provide_stream_data_buffer(context, data_length, is_fin, !is_fin);\n    \n    if (buffer != NULL) {\n        /* If the first 16 bytes have not been sent yet, send the header */\n        while (data_length > 0 && stream_ctx->nb_bytes_sent < 8) {\n            *buffer = (uint8_t)((stream_ctx->send_time >> (8 * (7 - stream_ctx->nb_bytes_sent))) & 0xff);\n            buffer++; \n            stream_ctx->nb_bytes_sent++;\n            data_length--;\n        }\n        while (data_length > 0 && stream_ctx->nb_bytes_sent < 16) {\n            *buffer = (uint8_t)((stream_ctx->nb_bytes_expected >> (8 * (15 - stream_ctx->nb_bytes_sent))) & 0xff);\n            buffer++;\n            stream_ctx->nb_bytes_sent++;\n            data_length--;\n        }\n        /* Fill the reminder with data */\n        if (data_length > 0) {\n            memset(buffer, 'z', data_length);\n        }\n\n        if (is_fin) {\n            /* delete the stream context */\n            cnx_stress_delete_stream_context(cnx_ctx, stream_ctx);\n        }\n    }\n    else {\n        ret = -1;\n    }\n\n    return ret;\n}\n\nint cnx_stress_callback(picoquic_cnx_t* cnx,\n    uint64_t stream_id, uint8_t* bytes, size_t length,\n    picoquic_call_back_event_t fin_or_event, void* callback_ctx, void* v_stream_ctx)\n{\n    int ret = 0;\n    cnx_stress_callback_ctx_t* cnx_ctx = (cnx_stress_callback_ctx_t*)callback_ctx;\n    cnx_stress_stream_ctx_t* stream_ctx = (cnx_stress_stream_ctx_t*)v_stream_ctx;\n\n    if (cnx_ctx == NULL) {\n        /* Unexpected error: for the clients the contexts are created by the\n         * application before starting the connection. For the server, the\n         * connections are created with a default context */\n        picoquic_close(cnx, PICOQUIC_TRANSPORT_INTERNAL_ERROR);\n        return -1;\n    }\n    else if (cnx_ctx->cnx == NULL) {\n        if (fin_or_event == picoquic_callback_stateless_reset ||\n            fin_or_event == picoquic_callback_close ||\n            fin_or_event == picoquic_callback_application_close) {\n            /* Nothing to do */\n            return 0;\n        }\n        else {\n            /* In the case of server connections, the connection is NULL for the\n             * default context. It should be initialized with a proper context */\n            cnx_ctx = cnx_stress_callback_create_context(cnx_ctx->stress_ctx, cnx, 1);\n            if (cnx_ctx == NULL) {\n                /* cannot handle the connection */\n                picoquic_close(cnx, PICOQUIC_TRANSPORT_INTERNAL_ERROR);\n                return -1;\n            }\n            else {\n                picoquic_set_callback(cnx, cnx_stress_callback, cnx_ctx);\n            }\n        }\n    }\n    else if (cnx_ctx->cnx != cnx) {\n        DBG_PRINTF(\"%s\", \"Invalid connection context!\");\n        ret = -1;\n    }\n\n    switch (fin_or_event) {\n    case picoquic_callback_stream_data:\n    case picoquic_callback_stream_fin:\n        /* Data arrival on stream #x, maybe with fin mark */\n        ret = cnx_stress_callback_data(cnx_ctx, stream_ctx, stream_id, bytes, length, fin_or_event);\n        break;\n    case picoquic_callback_stream_reset: \n        /* Sender reset stream, abandon transmission */\n        if (stream_ctx != NULL) {\n            /* Mark the stream as abandoned before full transmission */\n            cnx_ctx->stress_ctx->nb_messages_errors += 1;\n            /* delete the stream context */\n            cnx_stress_delete_stream_context(cnx_ctx, stream_ctx);\n        }\n        break;\n    case picoquic_callback_stop_sending: /* Client asks server to reset stream #x */\n        /* TODO: probably no need for this in the test application. */\n        break;\n    case picoquic_callback_stateless_reset:\n    case picoquic_callback_close: /* Received connection close */\n    case picoquic_callback_application_close: /* Received application close */\n        cnx_stress_callback_delete_context(cnx_ctx);\n        picoquic_set_callback(cnx, NULL, NULL);\n        break;\n    case picoquic_callback_stream_gap:\n        /* Gap indication, when unreliable streams are supported */\n        /* Should trigger a failure */\n        break;\n    case picoquic_callback_prepare_to_send:\n        ret = cnx_stress_callback_prepare_to_send(cnx_ctx, stream_ctx, stream_id, (void*)bytes, length);\n        break;\n    case picoquic_callback_almost_ready:\n    case picoquic_callback_ready:\n        break;\n    case picoquic_callback_datagram:/* No datagram support */\n        break;\n    case picoquic_callback_version_negotiation:\n        break;\n    case picoquic_callback_request_alpn_list: /* Provide the list of supported ALPN */\n    case picoquic_callback_set_alpn: /* Set ALPN to negotiated value */\n        break;\n    default:\n        /* unexpected */\n        break;\n    }\n\n    return ret;\n}\n\n/* Handling of data messages.\n * The simulation generates messages at specified intervals, in turn from\n * the server and from the client. For each message, the simulation\n * picks a target connection from the connections already established.\n * This requires being able to select a connection context at random\n * from those established on the client side or the server side.\n * We need a structure for that, so we can retrieve the connection context,\n * with the following constraints:\n * 1) Light weigth\n * 2) Synchronized with creation and deletion of contexts at clients or server.\n * The synchronization will be achieved through the per connection callback\n * mechanism. The callback context holds the index of the connection in the\n * array. It is initialized on the client side when the connection is\n * created, and on the server side when the connection context is created.\n * It is deleted and the pointer set to null when the \"end of connection\"\n * callback is received.\n * We need to monitor the transmission delay of messages, in simulation time.\n * For that, we encode the sending time in the message, and retrieve it when\n * the message is received.\n * Each message is sent on its own one-way stream, delineated by the end of\n * stream mechanism. The connection parameters set these \"allowed stream\"\n * parameters to a large enough value to not cause flow control issues.\n * To do: should we keep an array of message departure and arrival times for\n * fine grain statistics, is it enough to compute min, max, average and stdev?\n */\n\ncnx_stress_callback_ctx_t * cnx_stress_cnx_from_rank(\n    int msg_num, int nb_ctx, cnx_stress_callback_ctx_t** v_ctx)\n{\n    int nb_trials = 0;\n    int rank = msg_num % nb_ctx;\n    cnx_stress_callback_ctx_t* cnx_ctx = v_ctx[rank];\n    while ((cnx_ctx == NULL || cnx_ctx->cnx == NULL) && nb_trials < nb_ctx) {\n        rank = (rank + 1) % nb_ctx;\n        cnx_ctx = v_ctx[rank];\n        nb_trials++;\n    }\n    return cnx_ctx;\n}\n\nint cnx_stress_initiate_message(cnx_stress_ctx_t* stress_ctx)\n{\n    /* Client or server? */\n    int ret = 0;\n    cnx_stress_callback_ctx_t* cnx_ctx;\n\n    stress_ctx->nb_messages_sent += 1;\n    cnx_ctx = ((stress_ctx->nb_messages_sent & 1) != 0) ?\n        cnx_stress_cnx_from_rank(stress_ctx->nb_messages_sent,\n            stress_ctx->nb_clients, stress_ctx->c_ctx):\n        cnx_stress_cnx_from_rank(stress_ctx->nb_messages_sent,\n            stress_ctx->nb_servers, stress_ctx->s_ctx);\n    if (cnx_ctx == NULL) {\n        ret = -1;\n    }\n    else {\n        uint64_t stream_id = picoquic_get_next_local_stream_id(cnx_ctx->cnx, 1);\n        cnx_stress_stream_ctx_t* stream_ctx = cnx_stress_create_stream_context(cnx_ctx, stream_id);\n        if (stream_ctx == NULL) {\n            ret = -1;\n        }\n        else {\n            stream_ctx->send_time = stress_ctx->simulated_time;\n            stream_ctx->nb_bytes_expected = stress_ctx->message_size;\n\n            ret = picoquic_mark_active_stream(cnx_ctx->cnx, stream_id, 1, stream_ctx);\n        }\n    }\n    return ret;\n}\n\nint cnx_stress_create_client_cnx(cnx_stress_ctx_t* stress_ctx)\n{\n    int ret = 0;\n    picoquic_cnx_t* cnx = picoquic_create_cnx(\n        stress_ctx->qclient, picoquic_null_connection_id, picoquic_null_connection_id,\n        (struct sockaddr*) & stress_ctx->server_addr, stress_ctx->simulated_time, 0,\n        PICOQUIC_TEST_SNI, CNX_STRESS_ALPN, 1);\n    if (cnx == NULL) {\n        ret = -1;\n    }\n    else {\n        /* Create the context and register it in cnx  stress context */\n        cnx_stress_callback_ctx_t* cnx_ctx = cnx_stress_callback_create_context(\n            stress_ctx, cnx, 0);\n        if (cnx_ctx == NULL) {\n            picoquic_delete_cnx(cnx);\n            ret = -1;\n        }\n        else {\n            /* Set callback */\n            picoquic_set_callback(cnx, cnx_stress_callback, cnx_ctx);\n            /* Set keep alive to default value based on timeout. */\n            picoquic_enable_keep_alive(cnx, 0);\n            /* start the connection */\n            ret = picoquic_start_client_cnx(cnx);\n        }\n    }\n    return ret;\n}\n\nint cnx_stress_close_one_connection(cnx_stress_ctx_t* stress_ctx)\n{\n    /* TODO: consider closing the connections in a random order. */\n    int ret = 0;\n    int rank;\n\n    stress_ctx->nb_clients_deleted++;\n    rank = stress_ctx->nb_clients - stress_ctx->nb_clients_deleted;\n\n    if (stress_ctx->c_ctx[rank] != NULL) {\n        ret = picoquic_close(stress_ctx->c_ctx[rank]->cnx, 0);\n    }\n\n    return ret;\n}\n\nint cnx_stress_link_arrival(picoquic_quic_t * quic, picoquictest_sim_link_t * link, \n    uint64_t current_time)\n{\n    int ret = 0;\n    picoquictest_sim_packet_t* packet =\n        picoquictest_sim_link_dequeue(link, current_time);\n\n    if (packet != NULL) {\n        ret = picoquic_incoming_packet(quic, packet->bytes,\n            (uint32_t)packet->length,\n            (struct sockaddr*) & packet->addr_from,\n            (struct sockaddr*) & packet->addr_to, 0, 0, current_time);\n        free(packet);\n    }\n    return ret;\n}\n\nint cnx_stress_prepare(picoquic_quic_t* quic, picoquictest_sim_link_t* link,\n    struct sockaddr * default_source, uint64_t current_time)\n{\n    int ret = 0;\n    picoquictest_sim_packet_t* packet = picoquictest_sim_link_create_packet();\n\n    if (packet == NULL) {\n        ret = -1;\n    } else {\n        picoquic_connection_id_t log_cid;\n        picoquic_cnx_t* last_cnx;\n        int if_index = 0;\n\n        ret = picoquic_prepare_next_packet(quic, current_time, packet->bytes, \n            PICOQUIC_MAX_PACKET_SIZE, &packet->length,\n            &packet->addr_to, &packet->addr_from, &if_index, &log_cid, &last_cnx);\n\n        if (ret == 0 && packet->length > 0) {\n            if (packet->addr_from.ss_family == AF_UNSPEC) {\n                picoquic_store_addr(&packet->addr_from, default_source);\n            }\n            picoquictest_sim_link_submit(link, packet, current_time);\n        }\n        else {\n            free(packet);\n        }\n    }\n    return ret;\n}\n\n/* Loop -- manage arrival of clients, traffic, messages, etc. */\nint cnx_stress_loop_step(cnx_stress_ctx_t * stress_ctx)\n{\n    int ret = 0;\n    cnx_stress_event_enum next_event = cnx_stress_event_none;\n    uint64_t next_time = UINT64_MAX;\n\n    /* Is it time to inject a message ? */\n    if (stress_ctx->next_message_creation_time < next_time) {\n        next_event = cnx_stress_event_new_message;\n        next_time = stress_ctx->next_message_creation_time;\n    }\n    /* Is it time to inject a new connection? */\n    if (stress_ctx->next_client_creation_time < next_time) {\n        next_event = cnx_stress_event_client_creation;\n        next_time = stress_ctx->next_client_creation_time;\n    }\n    /* Is it time to delete a connection? */\n    if (stress_ctx->next_client_deletion_time < next_time) {\n        next_event = cnx_stress_event_client_removal;\n        next_time = stress_ctx->next_client_deletion_time;\n    }\n    /* Is it time for client message arrival? */\n    if (stress_ctx->link_to_clients->first_packet != NULL &&\n        stress_ctx->link_to_clients->first_packet->arrival_time < next_time) {\n        next_event = cnx_stress_event_client_arrival;\n        next_time = stress_ctx->link_to_clients->first_packet->arrival_time;\n    }\n    /* Is it time for client message preparation? */\n    if (picoquic_get_next_wake_time(stress_ctx->qclient, stress_ctx->simulated_time) < next_time) {\n        next_event = cnx_stress_event_client_prepare;\n        next_time = picoquic_get_next_wake_time(stress_ctx->qclient, stress_ctx->simulated_time);\n    }\n    /* Is it time for server message arrival? */\n    if (stress_ctx->link_to_server->first_packet != NULL && \n        stress_ctx->link_to_server->first_packet->arrival_time < next_time) {\n        next_event = cnx_stress_event_server_arrival;\n        next_time = stress_ctx->link_to_server->first_packet->arrival_time;\n    }\n    /* Is it time for server message preparation? */\n    if (picoquic_get_next_wake_time(stress_ctx->qserver, stress_ctx->simulated_time) < next_time) {\n        next_event = cnx_stress_event_server_prepare;\n        next_time = picoquic_get_next_wake_time(stress_ctx->qserver, stress_ctx->simulated_time);\n    }\n    /* Update the simulation time based on next time */\n    if (next_time > stress_ctx->simulated_time) {\n        stress_ctx->simulated_time = next_time;\n    }\n    /* TODO: Execute the selected action */\n    switch (next_event) {\n    case cnx_stress_event_new_message:\n        ret = cnx_stress_initiate_message(stress_ctx);\n        if (stress_ctx->nb_messages_sent >= stress_ctx->nb_messages_target) {\n            stress_ctx->next_message_creation_time = UINT64_MAX;\n        }\n        else {\n            stress_ctx->next_message_creation_time += stress_ctx->message_creation_interval;\n        }\n        break;\n    case cnx_stress_event_client_creation:\n        ret = cnx_stress_create_client_cnx(stress_ctx);\n        /* Prep the next connection time. */\n        if (stress_ctx->nb_clients >= stress_ctx->nb_client_target) {\n            stress_ctx->next_client_creation_time = UINT64_MAX;\n        }\n        else {\n            stress_ctx->next_client_creation_time += stress_ctx->client_creation_interval;\n        }\n        break;\n    case cnx_stress_event_client_removal:\n        ret = cnx_stress_close_one_connection(stress_ctx);\n        if (stress_ctx->nb_clients_deleted >= stress_ctx->nb_clients) {\n            stress_ctx->next_client_deletion_time = UINT64_MAX;\n        }\n        else {\n            stress_ctx->next_client_deletion_time += stress_ctx->client_deletion_interval;\n        }\n        break;\n    case cnx_stress_event_client_arrival:\n        /* If there is something to receive on the client , do it now */\n        ret = cnx_stress_link_arrival(stress_ctx->qclient,\n            stress_ctx->link_to_clients, stress_ctx->simulated_time);\n        break;\n    case cnx_stress_event_client_prepare:\n        /* If a client packet is ready to send, send it. */\n        ret = cnx_stress_prepare(stress_ctx->qclient, stress_ctx->link_to_server,\n            (struct sockaddr *)&stress_ctx->client_addr, stress_ctx->simulated_time);\n        break;\n    case cnx_stress_event_server_arrival:\n        /* If there is something to receive on the client , do it now */\n        ret = cnx_stress_link_arrival(stress_ctx->qserver,\n            stress_ctx->link_to_server, stress_ctx->simulated_time);\n        break;\n    case cnx_stress_event_server_prepare:\n        /* If a client packet is ready to send, send it. */\n        ret = cnx_stress_prepare(stress_ctx->qserver, stress_ctx->link_to_clients,\n            (struct sockaddr*) & stress_ctx->server_addr, stress_ctx->simulated_time);\n        break;\n    default:\n        ret = -1;\n        break;\n    }\n\n    return ret;\n}\n\n/* Connection stress:\n *\n *  Create a QUIC context for the server\n *  Create a QUIC context for the client\n *  Create simulated links from client to server and vice-versa\n *  In a loop, until the desired number of connections is obtained\n *      Create a new connection on the client\n *      Queue a first message on that client connection\n *      Run the simulated send/receive loop for a small number of iterations\n *   Once all clients are created\n *       Run the simulation until the desired time interval has passed\n *  In a loop, close each of the connections\n *\n * All that while getting statistics on:\n *\n *   The simulated connection establishment delays\n *   The simulated message delays from injection to delivery\n *   Whether undesirable events occur, e.g., loss of connections\n *   The \"real time\" required to run the test for the simulated time\n *\n */\n\n/* Set transport parameters to adequate value for cnx stress */\nint cnx_stress_set_default_tp(picoquic_quic_t* quic)\n{\n    int ret = 0;\n    picoquic_tp_t tp;\n    memset(&tp, 0, sizeof(picoquic_tp_t));\n    /* This is a server context. The \"remote\" bidi streams are those\n        * initiated by the client, and should be authorized to send\n        * a 64K-1 packet */\n    tp.initial_max_stream_data_bidi_local = 0;\n    tp.initial_max_stream_data_bidi_remote = 0;\n    tp.initial_max_stream_id_bidir = 0;\n    tp.initial_max_stream_data_uni = 0x20000;\n    tp.initial_max_stream_id_unidir = 64;\n    tp.initial_max_data = 0x20000;\n    tp.max_idle_timeout = 60000;\n    tp.max_packet_size = PICOQUIC_MAX_PACKET_SIZE;\n    tp.max_ack_delay = 10000;\n    tp.active_connection_id_limit = 3;\n    tp.ack_delay_exponent = 3;\n    tp.migration_disabled = 0;\n    ret = picoquic_set_default_tp(quic, &tp);\n    return ret;\n}\n\nvoid cnx_stress_delete_ctx(cnx_stress_ctx_t* stress_ctx)\n{\n    if (stress_ctx->link_to_clients != NULL) {\n        picoquictest_sim_link_delete(stress_ctx->link_to_clients);\n        stress_ctx->link_to_clients = NULL;\n    }\n\n    if (stress_ctx->link_to_server != NULL) {\n        picoquictest_sim_link_delete(stress_ctx->link_to_server);\n        stress_ctx->link_to_server = NULL;\n    }\n\n    if (stress_ctx->qserver != NULL) {\n        picoquic_free(stress_ctx->qserver);\n        stress_ctx->qserver = NULL;\n    }\n\n    if (stress_ctx->qclient != NULL) {\n        picoquic_free(stress_ctx->qclient);\n        stress_ctx->qclient = NULL;\n    }\n\n    if (stress_ctx->default_ctx != NULL) {\n        free(stress_ctx->default_ctx);\n        stress_ctx->default_ctx = NULL;\n    }\n\n    if (stress_ctx->c_ctx != NULL) {\n        for (int i = 0; i < stress_ctx->nb_clients; i++) {\n            if (stress_ctx->c_ctx[i] != NULL) {\n                cnx_stress_callback_delete_context(stress_ctx->c_ctx[i]);\n            }\n        }\n        free(stress_ctx->c_ctx);\n        stress_ctx->c_ctx = NULL;\n    }\n\n    if (stress_ctx->s_ctx != NULL) {\n        for (int i = 0; i < stress_ctx->nb_servers; i++) {\n            if (stress_ctx->s_ctx[i] != NULL) {\n                cnx_stress_callback_delete_context(stress_ctx->s_ctx[i]);\n            }\n        }\n        free(stress_ctx->s_ctx);\n        stress_ctx->s_ctx = NULL;\n    }\n\n    free(stress_ctx);\n}\n\ncnx_stress_ctx_t* cnx_stress_create_ctx(uint64_t duration, int nb_clients, int limit_test) \n{\n    cnx_stress_ctx_t* stress_ctx = (cnx_stress_ctx_t*)malloc(sizeof(cnx_stress_ctx_t));\n\n    if (stress_ctx != NULL) {\n        int ret = 0;\n\n        memset(stress_ctx, 0, sizeof(cnx_stress_ctx_t));\n        /* The random seed depends only on initialization parameters */\n        stress_ctx->random_ctx = 0xBabaC001BaddBab1ull;\n        stress_ctx->random_ctx ^= duration;\n        (void)picoquic_test_random(&stress_ctx->random_ctx);\n        stress_ctx->random_ctx ^= (uint64_t)nb_clients;\n        (void)picoquic_test_random(&stress_ctx->random_ctx);\n\n        /* Document addresses for the simulation */\n        picoquic_set_test_address(&stress_ctx->client_addr, 0x08080808, 12345);\n        picoquic_set_test_address(&stress_ctx->server_addr, 0x01010101, 4433);\n\n        /* Set and verify the simulation intervals */\n        stress_ctx->nb_client_target = nb_clients;\n        stress_ctx->client_creation_interval = 2000;\n        stress_ctx->next_client_creation_time = 0;\n        stress_ctx->client_deletion_interval = 100;\n        if ((stress_ctx->client_creation_interval + stress_ctx->client_deletion_interval) * nb_clients\n            > duration) {\n            ret = -1;\n        }\n        else {\n            stress_ctx->next_client_deletion_time = duration -\n                stress_ctx->client_deletion_interval * nb_clients;\n            stress_ctx->nb_messages_target = (nb_clients > 20000) ? 20000 : nb_clients;\n            stress_ctx->message_size = 1024;\n            stress_ctx->message_delay_min = INT64_MAX;\n            stress_ctx->message_creation_interval = stress_ctx->next_client_deletion_time /\n                ((uint64_t)3 * stress_ctx->nb_messages_target);\n            stress_ctx->next_message_creation_time = stress_ctx->next_client_deletion_time / 3;\n            if (stress_ctx->message_creation_interval <= 0) {\n                ret = -1;\n            }\n            else {\n                stress_ctx->c_ctx = (cnx_stress_callback_ctx_t**)malloc(\n                    sizeof(cnx_stress_callback_ctx_t*) * (nb_clients + limit_test));\n                if (stress_ctx->c_ctx != NULL) {\n                    memset(stress_ctx->c_ctx, 0, \n                        sizeof(cnx_stress_callback_ctx_t*) * (nb_clients + limit_test));\n                }\n                stress_ctx->s_ctx = (cnx_stress_callback_ctx_t**)malloc(\n                    sizeof(cnx_stress_callback_ctx_t*) * (nb_clients + limit_test));\n                if (stress_ctx->s_ctx != NULL) {\n                    memset(stress_ctx->s_ctx, 0, sizeof(cnx_stress_callback_ctx_t*) * (nb_clients + limit_test));\n                }\n                stress_ctx->default_ctx = cnx_stress_callback_create_context(stress_ctx, NULL, 2);\n                if (stress_ctx->s_ctx == NULL || stress_ctx->c_ctx == NULL || stress_ctx->default_ctx == NULL) {\n                    ret = -1;\n                }\n                else {\n                    char test_server_cert_file[512];\n                    char test_server_key_file[512];\n\n                    ret = picoquic_get_input_path(test_server_cert_file, sizeof(test_server_cert_file), picoquic_solution_dir, PICOQUIC_TEST_FILE_SERVER_CERT);\n\n                    if (ret == 0) {\n                        ret = picoquic_get_input_path(test_server_key_file, sizeof(test_server_key_file), picoquic_solution_dir, PICOQUIC_TEST_FILE_SERVER_KEY);\n                    }\n                    if (ret == 0) {\n                        stress_ctx->qclient = picoquic_create((nb_clients + limit_test), NULL, NULL,\n                            NULL, CNX_STRESS_ALPN, NULL, NULL, NULL, NULL,\n                            NULL, stress_ctx->simulated_time, &stress_ctx->simulated_time,\n                            NULL, NULL, 0);\n                        stress_ctx->qserver = picoquic_create(nb_clients, test_server_cert_file, test_server_key_file,\n                            NULL, CNX_STRESS_ALPN, cnx_stress_callback, stress_ctx->default_ctx, NULL, NULL,\n                            NULL, stress_ctx->simulated_time, &stress_ctx->simulated_time,\n                            NULL, NULL, 0);\n                        stress_ctx->link_to_clients = picoquictest_sim_link_create(1.0,\n                            10000, NULL, 20000, 0);\n                        stress_ctx->link_to_server = picoquictest_sim_link_create(1.0,\n                            10000, NULL, 20000, 0);\n                        if (stress_ctx->qclient == NULL || stress_ctx->qserver == NULL ||\n                            stress_ctx->link_to_clients == NULL || stress_ctx->link_to_server == NULL) {\n                            ret = -1;\n                        }\n                        else {\n                            ret = picoquic_set_low_memory_mode(stress_ctx->qclient, 1);\n                            if (ret == 0) {\n                                ret = picoquic_set_low_memory_mode(stress_ctx->qserver, 1);\n                            }\n                            if (ret == 0) {\n                                ret = cnx_stress_set_default_tp(stress_ctx->qclient);\n                            }\n                            if (ret == 0) {\n                                ret = cnx_stress_set_default_tp(stress_ctx->qserver);\n                            }\n                        }\n                    }\n                }\n            }\n        }\n\n        if (ret != 0) {\n            cnx_stress_delete_ctx(stress_ctx);\n            stress_ctx = NULL;\n        }\n    }\n    return stress_ctx;\n}\n\nint cnx_stress_do_test(uint64_t duration, int nb_clients, int do_report)\n{\n    int ret = 0;\n    cnx_stress_ctx_t* stress_ctx = cnx_stress_create_ctx(duration, nb_clients, 0);\n\n    if (stress_ctx != NULL) {\n        uint64_t wall_time_start = picoquic_current_time();\n\n        /* loop until time exhausted */\n        while (ret == 0 && stress_ctx->simulated_time < duration) {\n            ret = cnx_stress_loop_step(stress_ctx);\n        }\n\n        if (ret == 0) {\n            uint64_t wall_time_end = picoquic_current_time();\n            uint64_t wall_time_elapsed = wall_time_end - wall_time_start;\n\n            if (wall_time_elapsed > stress_ctx->simulated_time) {\n                DBG_PRINTF(\"Simulating %\" PRIu64 \" in %\" PRIu64, \n                    stress_ctx->simulated_time, wall_time_elapsed);\n                ret = -1;\n            }\n            else if (stress_ctx->nb_clients != stress_ctx->nb_client_target ||\n                stress_ctx->nb_servers != stress_ctx->nb_client_target) {\n                DBG_PRINTF(\"Expected %d connections, got %d (client) and %d (server)\",\n                    stress_ctx->nb_client_target, stress_ctx->nb_clients, stress_ctx->nb_servers);\n                ret = -1;\n            }\n            else if (stress_ctx->nb_messages_received != stress_ctx->nb_messages_target) {\n                DBG_PRINTF(\"Expected %d messages, sent %d, received %d\",\n                    stress_ctx->nb_messages_target, \n                    stress_ctx->nb_messages_sent, stress_ctx->nb_messages_received);\n                ret = -1;\n            }\n            else if (do_report) {\n                double msg_avg_delay = (stress_ctx->nb_messages_target > 0) ?\n                    (double)stress_ctx->sum_message_delays / (double)stress_ctx->nb_messages_target : 0;\n                msg_avg_delay /= 1000000.0;\n                fprintf(stdout, \"Many connection stress (cnx_stress) succeeds:\\n\");\n                fprintf(stdout, \"Processed %d connections for %fs (simulated) in %fs (wall time).\\n\",\n                    stress_ctx->nb_client_target,\n                    ((double)stress_ctx->simulated_time)/1000000.0,\n                    ((double)wall_time_elapsed)/1000000.0);\n                fprintf(stdout, \"Processed %d messages, delays min/avg/max= %fs, %fs, %fs.\\n\",\n                    stress_ctx->nb_messages_target, ((double)stress_ctx->message_delay_min)/ 1000000.0,\n                    msg_avg_delay, ((double)stress_ctx->message_delay_max)/ 1000000.0);\n            }\n        }\n\n        cnx_stress_delete_ctx(stress_ctx);\n    }\n    return ret;\n}\n\n/* The unit test entry point executes the cnx stress test with a \n * small duration and a small number of clients, the goal being to check that\n * the cnx stress code actually works. */\nint cnx_stress_unit_test(void)\n{\n    return cnx_stress_do_test(120000000, 100, 0);\n}\n\n/*Connection limit\n * Test that if one attempts to create more than the set limit of\n * connections, it fails. This is complementary to the cnx_stress\n * test, which verifies that if one creates exactly the \"limit\" number of connections, \n * they all succeed.\n */\nint cnx_limit_test(void)\n{\n    int ret = 0;\n    int nb_clients = 4;\n    uint64_t duration = 120000000;\n    cnx_stress_ctx_t* stress_ctx = cnx_stress_create_ctx(duration, nb_clients, 1);\n\n    if (stress_ctx == NULL) {\n        ret = -1;\n    }\n\n    if (stress_ctx != NULL) {\n        int is_done = 0;\n\n        /* loop until time exhausted or all created */\n        while (ret == 0 && stress_ctx->simulated_time < duration && !is_done) {\n            ret = cnx_stress_loop_step(stress_ctx);\n            if (stress_ctx->nb_clients == nb_clients &&\n                stress_ctx->nb_servers == nb_clients) {\n                is_done = 1;\n                for (int c = 0; c < nb_clients; c++) {\n                    if (stress_ctx->c_ctx[c] == NULL ||\n                        stress_ctx->c_ctx[c]->cnx == NULL ||\n                        stress_ctx->c_ctx[c]->cnx->cnx_state <\n                        picoquic_state_client_almost_ready) {\n                        is_done = 0;\n                        break;\n                    }\n                }\n            }\n        }\n        if (!is_done) {\n            ret = -1;\n        }\n\n        if (ret == 0) {\n            /* Try creating one more client. Loop until time exhausted or\n             * verify new client refused because server busy */\n\n            stress_ctx->is_limit_test = 1;\n            stress_ctx->next_client_creation_time = stress_ctx->simulated_time;\n            stress_ctx->nb_client_target++;\n            while (ret == 0 && stress_ctx->simulated_time < duration &&\n                !stress_ctx->limit_test_got_server_busy) {\n                ret = cnx_stress_loop_step(stress_ctx);\n            }\n            if (!stress_ctx->limit_test_got_server_busy) {\n                ret = -1;\n            }\n        }\n\n        cnx_stress_delete_ctx(stress_ctx);\n    }\n\n    return ret;\n}\n","numLines":1037,"startLine":1,"totalLines":1037}}}
