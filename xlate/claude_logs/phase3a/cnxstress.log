{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01GPFGbfuqi4eDe8EexBTeiv","type":"tool_result","content":"80\t}\n81\t\n82\t/// C: `nb_tp_0rtt`.  Number of variants in\n83\t/// [`TransportParameter0RttKind`].\n84\tpub const NB_TP_0RTT: usize = 10;\n85\t\n86\t// ---------------------------------------------------------------------------\n87\t// Preferred-address TP value.\n88\t\n89\t/// Server's preferred address advertised in transport parameters.\n90\t/// At most one IPv4 and at most one IPv6 endpoint may be present;\n91\t/// each socket address (the C `ipvNAddress[]` + `ipvNPort` pair)\n92\t/// folds into an `Option<SocketAddr>`.  C: `TpPreferredAddress`.\n93\t#[derive(Debug, Default, Copy, Clone)]\n94\tpub struct PreferredAddress {\n95\t    /// IPv4 address + port, if the server advertised one.\n96\t    pub v4: Option<SocketAddr>,\n97\t    /// IPv6 address + port, if the server advertised one.\n98\t    pub v6: Option<SocketAddr>,\n99\t    pub connection_id: ConnectionId,\n100\t    pub stateless_reset_token: [u8; 16],\n101\t}\n102\t\n103\t// ---------------------------------------------------------------------------\n104\t// Version-negotiation TP value.\n105\t\n106\t/// Version-negotiation TP payload.  C: `TpVersionNegotiation`.\n107\t/// The C `nb_received` / `nb_supported` length fields disappear\n108\t/// (the `Vec`s carry their lengths).\n109\t#[derive(Debug, Default, Clone)]\n110\tpub struct VersionNegotiation {\n111\t    /// Version found in TP, should match envelope.\n112\t    pub current: u32,\n113\t    /// Version that triggered a previous version negotiation.\n114\t    pub previous: u32,\n115\t    /// Versions received in a prior VN packet (client side only).\n116\t    pub received: Vec<u32>,\n117\t    /// Compatible versions supported by the peer (client side only).\n118\t    pub supported: Vec<u32>,\n119\t}\n120\t\n121\t// ---------------------------------------------------------------------------\n122\t// Aggregate.\n123\t\n124\t/// Full set of QUIC transport parameters carried during the\n125\t/// handshake.  C: `TransportParameters`.\n126\t///\n127\t/// `migration_disabled`, `do_grease_quic_bit`, `enable_bdp_frame`,\n128\t/// `is_reset_stream_at_enabled` were `unsigned int` Booleans in C;\n129\t/// promoted to `bool`.  `enable_loss_bit`, `enable_time_stamp`,\n130\t/// `address_discovery_mode` are kept as integers because callers\n131\t/// inspect the low bits separately (\"want / can\" flags).\n132\t#[derive(Debug, Clone)]\n133\tpub struct TransportParameters {\n134\t    pub initial_max_stream_data_bidi_local: u64,\n135\t    pub initial_max_stream_data_bidi_remote: u64,\n136\t    pub initial_max_stream_data_uni: u64,\n137\t    pub initial_max_data: u64,\n138\t    pub initial_max_stream_id_bidir: u64,\n139\t    pub initial_max_stream_id_unidir: u64,\n140\t    pub max_idle_timeout: Duration,\n141\t    pub max_packet_size: u32,\n142\t    pub max_ack_delay: u32,\n143\t    pub active_connection_id_limit: u32,\n144\t    pub ack_delay_exponent: u8,\n145\t    pub migration_disabled: bool,\n146\t    pub preferred_address: PreferredAddress,\n147\t    pub max_datagram_frame_size: u32,\n148\t    pub enable_loss_bit: i32,\n149\t    /// `(x & 1)` want, `(x & 2)` can.\n150\t    pub enable_time_stamp: i32,\n151\t    pub min_ack_delay: Duration,\n152\t    pub do_grease_quic_bit: bool,\n153\t    pub version_negotiation: VersionNegotiation,\n154\t    pub enable_bdp_frame: bool,\n155\t    pub initial_max_path_id: u64,\n156\t    /// `0`=none, `1`=provide-only, `2`=receive-only, `3`=both.\n157\t    pub address_discovery_mode: i32,\n158\t    pub is_reset_stream_at_enabled: bool,\n159\t}"}]},"parent_tool_use_id":null,"session_id":"513641af-66d9-4e8b-98cd-e59b8e6a1fb7","uuid":"d671cb2e-5f6e-4a62-9ddd-9779dafc5be1","timestamp":"2026-05-04T22:31:34.778Z","tool_use_result":{"type":"text","file":{"filePath":"/Users/richbarn/Projects/picoquic/rs/fq/src/tp.rs","content":"}\n\n/// C: `nb_tp_0rtt`.  Number of variants