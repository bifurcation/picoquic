len(),\n        \"sack list length mismatch: expected {} ranges\",\n        expected.len()\n    );\n}\n\n/// C: `ack_of_ack_test` in `picoquictest/ack_of_ack_test.c`.\n#[test]\nfn ack_of_ack() {\n    for case in CASES {\n        let mut sack_list = SackList::new();\n        fill_sack_list(&mut sack_list, case.initial);\n\n        let mut ack_buf = [0u8; 1024];\n        let ack_length = build_test_ack(case.ack, &mut ack_buf);\n        let mut consumed = 0usize;\n        let ret =\n            sack_list.process_ack_of_ack_frame(&mut ack_buf, ack_length, &mut consumed, 0);\n        assert_eq!(\n            ret,\n            0,\n            \"process_ack_of_ack_frame failed for case '{}'\",\n            case.name\n        );\n\n        cmp_sack_list(&mut sack_list, case.result);\n    }\n}\n","structuredPatch":[{"oldStart":1,"oldLines":14,"newStart":1,"newLines":124,"lines":["-//! Test cases for `picoquictest/ack_of_ack*.c` (auto-stubbed).","+//! Test cases for `picoquictest/ack_of_ack_test.c`."," //!","-//! Generated by `scripts/phase3.py` from","-//! `picoquic_t/picoquic_t.c`'s `test_table[]`.  Each stub","-//! corresponds to one C test entry; bodies are `todo!()`","-//! until the body-translation pass lands.","+//! Exercises the ACK-of-ACK pruning logic: after the peer acknowledges an","+//! ACK frame, ranges that were fully covered by that ACK are removed from","+//! the local SACK list.  Three scenarios are tested — a simple tail trim,","+//! a two-range prune, and a no-op case where the ACK only partially covers","+//! a range."," "," #![allow(non_snake_case)]"," ","+use crate::frames::FrameType;","+use crate::internal::{SackList, varint_encode};","+use crate::Instant;","+","+/// One ACK-of-ACK test scenario.","+struct AoaCase {","+    name: &'static str,","+    /// Initial SACK ranges to load, ordered largest-first.","+    initial: &'static [(u64, u64)],","+    /// Ranges encoded into the ACK frame, ordered largest-first.","+    ack: &'static [(u64, u64)],","+    