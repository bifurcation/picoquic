{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01Gb85jxjLtYvYmBDDQpBJMz","type":"tool_result","content":"1\t/*\n2\t* Author: Christian Huitema\n3\t* Copyright (c) 2017, Private Octopus, Inc.\n4\t* All rights reserved.\n5\t*\n6\t* Permission to use, copy, modify, and distribute this software for any\n7\t* purpose with or without fee is hereby granted, provided that the above\n8\t* copyright notice and this permission notice appear in all copies.\n9\t*\n10\t* THIS SOFTWARE IS PROVIDED BY THE COPYRIGHT HOLDERS AND CONTRIBUTORS \"AS IS\" AND\n11\t* ANY EXPRESS OR IMPLIED WARRANTIES, INCLUDING, BUT NOT LIMITED TO, THE IMPLIED\n12\t* WARRANTIES OF MERCHANTABILITY AND FITNESS FOR A PARTICULAR PURPOSE ARE\n13\t* DISCLAIMED. IN NO EVENT SHALL Private Octopus, Inc. BE LIABLE FOR ANY\n14\t* DIRECT, INDIRECT, INCIDENTAL, SPECIAL, EXEMPLARY, OR CONSEQUENTIAL DAMAGES\n15\t* (INCLUDING, BUT NOT LIMITED TO, PROCUREMENT OF SUBSTITUTE GOODS OR SERVICES;\n16\t* LOSS OF USE, DATA, OR PROFITS; OR BUSINESS INTERRUPTION) HOWEVER CAUSED AND\n17\t* ON ANY THEORY OF LIABILITY, WHETHER IN CONTRACT, STRICT LIABILITY, OR TORT\n18\t* (INCLUDING NEGLIGENCE OR OTHERWISE) ARISING IN ANY WAY OUT OF THE USE OF THIS\n19\t* SOFTWARE, EVEN IF ADVISED OF THE POSSIBILITY OF SUCH DAMAGE.\n20\t*/\n21\t\n22\t#include \"picoquic_internal.h\"\n23\t#include <stdlib.h>\n24\t\n25\t/*\n26\t * The purpose of the ACK of ACK logic is to prune the sack list from blocks that\n27\t * have already been notified to the peer, in an ACK that the peer has acknowledged.\n28\t *\n29\t * Suppose the simplest case: ACK list says \"1-9\", previous ACK was saying \"1-8\", \n30\t * ACK list will now be saying \"9-9\".\n31\t *\n32\t * More complex case: ACK list says \"1-3\",\"5-6\", \"8-9\". ACK says \"1-3\", \"5-6\", new list\n33\t * should say \"0-9\".\n34\t *\n35\t * Special case: ACK list says \"1-6\",\"8-9\", ACK says \"1-3\", \"5-6\", new list should say?\n36\t * (Probably \"1-6\",\"8-9\").\n37\t *\n38\t * Note that there is little concern about leaving holes -- they are unlikely to\n39\t * be filled later. But we don't want to create extra fragmentation. Sack ranges \n40\t * should only be pruned if there is an exact match, or if the ack range matched the\n41\t * tail of the \"largest\" range.\n42\t */\n43\t\n44\ttypedef struct st_test_ack_range_t {\n45\t    uint64_t start_of_sack_range;\n46\t    uint64_t end_of_sack_range;\n47\t} test_ack_range_t;\n48\t\n49\tstatic const test_ack_range_t test_range_in_1[] = {\n50\t    { 1, 9 }\n51\t};\n52\t\n53\tstatic const test_ack_range_t test_range_ack_1[] = {\n54\t    { 1, 8 }\n55\t};\n56\t\n57\tstatic const test_ack_range_t test_range_res_1[] = {\n58\t    { 9, 9 }\n59\t};\n60\t\n61\tstatic const test_ack_range_t test_range_in_2[] = {\n62\t    { 8, 9 }, { 5, 6 }, { 1, 3 },\n63\t};\n64\t\n65\tstatic const test_ack_range_t test_range_ack_2[] = {\n66\t    { 5, 6 }, { 1, 3 },\n67\t};\n68\t\n69\tstatic const test_ack_range_t test_range_res_2[] = {\n70\t    { 8, 9 }\n71\t};\n72\t\n73\tstatic const test_ack_range_t test_range_in_3[] = {\n74\t    { 8, 9 }, { 1, 6 }\n75\t};\n76\t\n77\tstatic const test_ack_range_t test_range_ack_3[] = {\n78\t    { 5, 6 }, { 1, 3 }\n79\t};\n80\t\n81\tstatic const test_ack_range_t test_range_res_3[] = {\n82\t    { 8, 9 }, { 1, 6 }\n83\t};\n84\t\n85\ttypedef struct st_test_ack_of_ack_t {\n86\t    char const* test_name;\n87\t    test_ack_range_t const* initial;\n88\t    size_t nb_initial;\n89\t    test_ack_range_t const* ack;\n90\t    size_t nb_ack;\n91\t    test_ack_range_t const* result;\n92\t    size_t nb_result;\n93\t} test_ack_of_ack_t;\n94\t\n95\tstatic const test_ack_of_ack_t test_ack_of_ack_list[] = {\n96\t    { \"simple\",\n97\t        test_range_in_1, sizeof(test_range_in_1) / sizeof(test_ack_range_t),\n98\t        test_range_ack_1, sizeof(test_range_ack_1) / sizeof(test_ack_range_t),\n99\t        test_range_res_1, sizeof(test_range_res_1) / sizeof(test_ack_range_t)},\n100\t    { \"two ranges\",\n101\t        test_range_in_2, sizeof(test_range_in_2) / sizeof(test_ack_range_t),\n102\t        test_range_ack_2, sizeof(test_range_ack_2) / sizeof(test_ack_range_t),\n103\t        test_range_res_2, sizeof(test_range_res_2) / sizeof(test_ack_range_t)},\n104\t    { \"no op\",\n105\t        test_range_in_3, sizeof(test_range_in_3) / sizeof(test_ack_range_t),\n106\t        test_range_ack_3, sizeof(test_range_ack_3) / sizeof(test_ack_range_t),\n107\t        test_range_res_3, sizeof(test_range_res_3) / sizeof(test_ack_range_t)}\n108\t};\n109\t\n110\t/*\n111\t * Fill a structured SACK list from a test range \n112\t */\n113\t\n114\tstatic int fill_test_sack_list(picoquic_sack_list_t* sack_list,\n115\t    test_ack_range_t const* ranges, size_t nb_ranges)\n116\t{\n117\t    int ret = 0;\n118\t    for (size_t i = 0; ret == 0 &&  i < nb_ranges; i++) {\n119\t        ret = picoquic_sack_insert_item(sack_list, ranges[i].start_of_sack_range, ranges[i].end_of_sack_range, 0);\n120\t    }\n121\t    return ret;\n122\t}\n123\t\n124\t/*\n125\t * Compare a structured list to a test range\n126\t */\n127\t\n128\tstatic int cmp_test_sack_list(picoquic_sack_list_t* sack_list,\n129\t    test_ack_range_t const* ranges, size_t nb_ranges)\n130\t{\n131\t    size_t nb_compared = 0;\n132\t    picoquic_sack_item_t* sack_head = picoquic_sack_last_item(sack_list);\n133\t    picoquic_sack_item_t* next = sack_head;\n134\t\n135\t    for (size_t i = 0; i < nb_ranges; i++) {\n136\t        if (next->start_of_sack_range != ranges[i].start_of_sack_range || next->end_of_sack_range != ranges[i].end_of_sack_range) {\n137\t            break;\n138\t        }\n139\t\n140\t        nb_compared++;\n141\t\n142\t        next = picoquic_sack_previous_item(next);\n143\t\n144\t        if (next == NULL) {\n145\t            break;\n146\t        }\n147\t    }\n148\t\n149\t    return (next == NULL && nb_compared == nb_ranges) ? 0 : -1;\n150\t}\n151\t\n152\tstatic size_t build_test_ack(test_ack_range_t const* ranges, size_t nb_ranges,\n153\t    uint8_t* bytes, size_t bytes_max)\n154\t{\n155\t    size_t byte_index = 0;\n156\t    uint64_t ack_range = 0;\n157\t\n158\t    /* Encode the first byte */\n159\t    bytes[byte_index++] = picoquic_frame_type_ack;\n160\t    /* Encode the largest seen */\n161\t    byte_index += picoquic_varint_encode(bytes + byte_index, bytes_max - byte_index, ranges[0].end_of_sack_range);\n162\t    /* Set the ACK delay to zero for these tests */\n163\t    byte_index += picoquic_varint_encode(bytes + byte_index, bytes_max - byte_index, 0);\n164\t    /* Encode the number of blocks -- assume nb_ranges always lower than 64 */\n165\t    bytes[byte_index++] = (uint8_t)(nb_ranges - 1);\n166\t    /* Encode the size of the first ack range */\n167\t    ack_range = ranges[0].end_of_sack_range - ranges[0].start_of_sack_range;\n168\t    byte_index += picoquic_varint_encode(bytes + byte_index, bytes_max - byte_index, ack_range);\n169\t    /* Encode each of the ack block items */\n170\t    for (size_t i = 1; i < nb_ranges && byte_index + 5 < bytes_max; i++) {\n171\t        uint64_t gap = ranges[i - 1].start_of_sack_range - ranges[i].end_of_sack_range - 2;\n172\t        byte_index += picoquic_varint_encode(bytes + byte_index, bytes_max - byte_index, gap);\n173\t        ack_range = ranges[i].end_of_sack_range - ranges[i].start_of_sack_range;\n174\t        byte_index += picoquic_varint_encode(bytes + byte_index, bytes_max - byte_index, ack_range);\n175\t    }\n176\t    return byte_index;\n177\t}\n178\t\n179\t/*\n180\t * Single sample test.\n181\t */\n182\tstatic int ack_of_ack_do_one_test(test_ack_of_ack_t const* sample)\n183\t{\n184\t    int ret = 0;\n185\t    picoquic_sack_list_t sack_list;\n186\t    uint8_t ack[1024];\n187\t    size_t consumed;\n188\t\n189\t    picoquic_sack_list_init(&sack_list);\n190\t\n191\t    if (ret == 0) {\n192\t        ret = fill_test_sack_list(&sack_list, sample->initial, sample->nb_initial);\n193\t    }\n194\t\n195\t    if (ret == 0) {\n196\t        size_t ack_length = build_test_ack(sample->ack, sample->nb_ack, ack, sizeof(ack));\n197\t        ret = picoquic_process_ack_of_ack_frame(&sack_list, ack, ack_length, &consumed, 0);\n198\t    }\n199\t\n200\t    if (ret == 0) {\n201\t        ret = cmp_test_sack_list(&sack_list, sample->result, sample->nb_result);\n202\t    }\n203\t    else {\n204\t        DBG_PRINTF(\"ack of ack, ret=%d\", ret);\n205\t    }\n206\t\n207\t    picoquic_sack_list_free(&sack_list);\n208\t\n209\t    return ret;\n210\t}\n211\t\n212\t/*\n213\t * Perform the whole set of range tests \n214\t */\n215\t\n216\tint ack_of_ack_test(void)\n217\t{\n218\t    int ret = 0;\n219\t\n220\t    for (size_t i = 0; i < sizeof(test_ack_of_ack_list) / sizeof(test_ack_of_ack_t); i++) {\n221\t        ret = ack_of_ack_do_one_test(&test_ack_of_ack_list[i]);\n222\t\n223\t        if (ret != 0) {\n224\t            break;\n225\t        }\n226\t    }\n227\t\n228\t    return ret;\n229\t}\n230\t"}]},"parent_tool_use_id":null,"session_id":"8a9a3798-407c-44dd-bea5-73c13239daf7","uuid":"892049a8-55d6-45f3-a2c1-1dc54b3262e8","timestamp":"2026-05-04T19:02:48.502Z","tool_use_result":{"type":"text","file":{"filePath":"/Users/richbarn/Projects/picoquic/picoquictest/ack_of_ack_test.c","content":"/*\n* Author: Christian Huitema\n* Copyright (c) 2017, Private Octopus, Inc.\n* All rights reserved.\n*\n* Permission to use, copy, modify, and distribute this software for any\n* purpose with or without fee is hereby granted, provided that the above\n* copyright notice and this permission notice appear in all copies.\n*\n* THIS SOFTWARE IS PROVIDED BY THE COPYRIGHT HOLDERS AND CONTRIBUTORS \"AS IS\" AND\n* ANY EXPRESS OR IMPLIED WARRANTIES, INCLUDING, BUT NOT LIMITED TO, THE IMPLIED\n* WARRANTIES OF MERCHANTABILITY AND FITNESS FOR A PARTICULAR PURPOSE ARE\n* DISCLAIMED. IN NO EVENT SHALL Private Octopus, Inc. BE LIABLE FOR ANY\n* DIRECT, INDIRECT, INCIDENTAL, SPECIAL, EXEMPLARY, OR CONSEQUENTIAL DAMAGES\n* (INCLUDING, BUT NOT LIMITED TO, PROCUREMENT OF SUBSTITUTE GOODS OR SERVICES;\n* LOSS OF USE, DATA, OR PROFITS; OR BUSINESS INTERRUPTION) HOWEVER CAUSED AND\n* ON ANY THEORY OF LIABILITY, WHETHER IN CONTRACT, STRICT LIABILITY, OR TORT\n* (INCLUDING NEGLIGENCE OR OTHERWISE) ARISING IN ANY WAY OUT OF THE USE OF THIS\n* SOFTWARE, EVEN IF ADVISED OF THE POSSIBILITY OF SUCH DAMAGE.\n*/\n\n#include \"picoquic_internal.h\"\n#include <stdlib.h>\n\n/*\n * The purpose of the ACK of ACK logic is to prune the sack list from blocks that\n * have already been notified to the peer, in an ACK that the peer has acknowledged.\n *\n * Suppose the simplest case: ACK list says \"1-9\", previous ACK was saying \"1-8\", \n * ACK list will now be saying \"9-9\".\n *\n * More complex case: ACK list says \"1-3\",\"5-6\", \"8-9\". ACK says \"1-3\", \"5-6\", new list\n * should say \"0-9\".\n *\n * Special case: ACK list says \"1-6\",\"8-9\", ACK says \"1-3\", \"5-6\", new list should say?\n * (Probably \"1-6\",\"8-9\").\n *\n * Note that there is little concern about leaving holes -- they are unlikely to\n * be filled later. But we don't want to create extra fragmentation. Sack ranges \n * should only be pruned if there is an exact match, or if the ack range matched the\n * tail of the \"largest\" range.\n */\n\ntypedef struct st_test_ack_range_t {\n    uint64_t start_of_sack_range;\n    uint64_t end_of_sack_range;\n} test_ack_range_t;\n\nstatic const test_ack_range_t test_range_in_1[] = {\n    { 1, 9 }\n};\n\nstatic const test_ack_range_t test_range_ack_1[] = {\n    { 1, 8 }\n};\n\nstatic const test_ack_range_t test_range_res_1[] = {\n    { 9, 9 }\n};\n\nstatic const test_ack_range_t test_range_in_2[] = {\n    { 8, 9 }, { 5, 6 }, { 1, 3 },\n};\n\nstatic const test_ack_range_t test_range_ack_2[] = {\n    { 5, 6 }, { 1, 3 },\n};\n\nstatic const test_ack_range_t test_range_res_2[] = {\n    { 8, 9 }\n};\n\nstatic const test_ack_range_t test_range_in_3[] = {\n    { 8, 9 }, { 1, 6 }\n};\n\nstatic const test_ack_range_t test_range_ack_3[] = {\n    { 5, 6 }, { 1, 3 }\n};\n\nstatic const test_ack_range_t test_range_res_3[] = {\n    { 8, 9 }, { 1, 6 }\n};\n\ntypedef struct st_test_ack_of_ack_t {\n    char const* test_name;\n    test_ack_range_t const* initial;\n    size_t nb_initial;\n    test_ack_range_t const* ack;\n    size_t nb_ack;\n    test_ack_range_t const* result;\n    size_t nb_result;\n} test_ack_of_ack_t;\n\nstatic const test_ack_of_ack_t test_ack_of_ack_list[] = {\n    { \"simple\",\n        test_range_in_1, sizeof(test_range_in_1) / sizeof(test_ack_range_t),\n        test_range_ack_1, sizeof(test_range_ack_1) / sizeof(test_ack_range_t),\n        test_range_res_1, sizeof(test_range_res_1) / sizeof(test_ack_range_t)},\n    { \"two ranges\",\n        test_range_in_2, sizeof(test_range_in_2) / sizeof(test_ack_range_t),\n        test_range_ack_2, sizeof(test_range_ack_2) / sizeof(test_ack_range_t),\n        test_range_res_2, sizeof(test_range_res_2) / sizeof(test_ack_range_t)},\n    { \"no op\",\n        test_range_in_3, sizeof(test_range_in_3) / sizeof(test_ack_range_t),\n        test_range_ack_3, sizeof(test_range_ack_3) / sizeof(test_ack_range_t),\n        test_range_res_3, sizeof(test_range_res_3) / sizeof(test_ack_range_t)}\n};\n\n/*\n * Fill a structured SACK list from a test range \n */\n\nstatic int fill_test_sack_list(picoquic_sack_list_t* sack_list,\n    test_ack_range_t const* ranges, size_t nb_ranges)\n{\n    int ret = 0;\n    for (size_t i = 0; ret == 0 &&  i < nb_ranges; i++) {\n        ret = picoquic_sack_insert_item(sack_list, ranges[i].start_of_sack_range, ranges[i].end_of_sack_range, 0);\n    }\n    return ret;\n}\n\n/*\n * Compare a structured list to a test range\n */\n\nstatic int cmp_test_sack_list(picoquic_sack_list_t* sack_list,\n    test_ack_range_t const* ranges, size_t nb_ranges)\n{\n    size_t nb_compared = 0;\n    picoquic_sack_item_t* sack_head = picoquic_sack_last_item(sack_list);\n    picoquic_sack_item_t* next = sack_head;\n\n    for (size_t i = 0; i < nb_ranges; i++) {\n        if (next->start_of_sack_range != ranges[i].start_of_sack_range || next->end_of_sack_range != ranges[i].end_of_sack_range) {\n            break;\n        }\n\n        nb_compared++;\n\n        next = picoquic_sack_previous_item(next);\n\n        if (next == NULL) {\n            break;\n        }\n    }\n\n    return (next == NULL && nb_compared == nb_ranges) ? 0 : -1;\n}\n\nstatic size_t build_test_ack(test_ack_range_t const* ranges, size_t nb_ranges,\n    uint8_t* bytes, size_t bytes_max)\n{\n    size_t byte_index = 0;\n    uint64_t ack_range = 0;\n\n    /* Encode the first byte */\n    bytes[byte_index++] = picoquic_frame_type_ack;\n    /* Encode the largest seen */\n    byte_index += picoquic_varint_encode(bytes + byte_index, bytes_max - byte_index, ranges[0].end_of_sack_range);\n    /* Set the ACK delay to zero for these tests */\n    byte_index += picoquic_varint_encode(bytes + byte_index, bytes_max - byte_index, 0);\n    /* Encode the number of blocks -- assume nb_ranges always lower than 64 */\n    bytes[byte_index++] = (uint8_t)(nb_ranges - 1);\n    /* Encode the size of the first ack range */\n    ack_range = ranges[0].end_of_sack_range - ranges[0].start_of_sack_range;\n    byte_index += picoquic_varint_encode(bytes + byte_index, bytes_max - byte_index, ack_range);\n    /* Encode each of the ack block items */\n    for (size_t i = 1; i < nb_ranges && byte_index + 5 < bytes_max; i++) {\n        uint64_t gap = ranges[i - 1].start_of_sack_range - ranges[i].end_of_sack_range - 2;\n        byte_index += picoquic_varint_encode(bytes + byte_index, bytes_max - byte_index, gap);\n        ack_range = ranges[i].end_of_sack_range - ranges[i].start_of_sack_range;\n        byte_index += picoquic_varint_encode(bytes + byte_index, bytes_max - byte_index, ack_range);\n    }\n    return byte_index;\n}\n\n/*\n * Single sample test.\n */\nstatic int ack_of_ack_do_one_test(test_ack_of_ack_t const* sample)\n{\n    int ret = 0;\n    picoquic_sack_list_t sack_list;\n    uint8_t ack[1024];\n    size_t consumed;\n\n    picoquic_sack_list_init(&sack_list);\n\n    if (ret == 0) {\n        ret = fill_test_sack_list(&sack_list, sample->initial, sample->nb_initial);\n    }\n\n    if (ret == 0) {\n        size_t ack_length = build_test_ack(sample->ack, sample->nb_ack, ack, sizeof(ack));\n        ret = picoquic_process_ack_of_ack_frame(&sack_list, ack, ack_length, &consumed, 0);\n    }\n\n    if (ret == 0) {\n        ret = cmp_test_sack_list(&sack_list, sample->result, sample->nb_result);\n    }\n    else {\n        DBG_PRINTF(\"ack of ack, ret=%d\", ret);\n    }\n\n    picoquic_sack_list_free(&sack_list);\n\n    return ret;\n}\n\n/*\n * Perform the whole set of range tests \n */\n\nint ack_of_ack_test(void)\n{\n    int ret = 0;\n\n    for (size_t i = 0; i < sizeof(test_ack_of_ack_list) / sizeof(test_ack_of_ack_t); i++) {\n        ret = ack_of_ack_do_one_test(&test_ack_of_ack_list[i]);\n\n        if (ret != 0) {\n            break;\n        }\n    }\n\n    return ret;\n}\n","numLines":230,"startLine":1,"totalLines":230}}}
