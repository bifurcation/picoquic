is a fixed\n90\t///   `[u8; MAX_PACKET_SIZE]` because the C struct\n91\t///   declares it inline at that exact size.\n92\tpub struct TestSimPacket {\n93\t    pub arrival_time: Instant,\n94\t    pub length: usize,\n95\t    pub addr_from: Option<SocketAddr>,\n96\t    pub addr_to: Option<SocketAddr>,\n97\t    pub ecn_mark: u8,\n98\t    pub bytes: [u8; MAX_PACKET_SIZE],\n99\t}\n100\t\n101\timpl TestSimPacket {\n102\t    /// Allocate a fresh, empty packet.  C:\n103\t    /// `picoquictest_sim_link_create_packet`.\n104\t    pub fn create() -> Result<Self, crate::Error> {\n105\t        todo!()\n106\t    }\n107\t}\n108\t\n109\t/// Active queue management vtable.  C: the `picoquictest_aqm_t`\n110\t/// struct of function pointers — folded into a single trait per\n111\t/// the Phase 1 rule on function pointers.  The `self` parameter\n112\t/// of each C method becomes the implicit `&mut self`; the\n113\t/// `picoquictest_sim_link_t*` link pointer stays explicit because\n114\t/// the AQM lives inside the link (taking the link by `&mut` in\n115\t/// each call would conflict with the `&mut self` borrow).  Phase 4\n116\t/// will resolve the borrow with a take-replace pattern.\n117\tpub trait TestAqm {\n118\t    /// Submit a packet to the AQM.  C: `submit`.\n119\t    fn submit(&mut self, link: &mut TestSimLink, packet: TestSimPacket, current_time: Instant);\n120\t\n121\t    /// Reset the AQM state at `current_time`.  C: `reset`.\n122\t    fn reset(&mut self, link: &mut TestSimLink, current_time: Instant);\n123\t\n124\t    /// Release any resources held by the AQM, e.g. when the link\n125\t    /// is being torn down.  C: `release`.\n126\t    fn release(&mut self, link: &mut TestSimLink);\n127\t\n128\t    /// Whether the AQM has at least one pending packet ready to\n129\t    /// admit.  C: `has_pending` returning a 0/1 flag, mapped to\n130\t    /// `bool`.\n131\t    fn has_pending(&mut self) -> bool;\n132\t\n133\t    /// Move any AQM-pending packets onto the link's main queue.\n134\t    /// C: `admit_pending`.\n135\t    fn admit_pending(&mut self, link: &mut TestSimLink, current_time: Instant);\n136\t}\n137\t\n138\t/// Jitter model used by the sim link.  C: `picoquic_jitter_mode`.\n139\t#[derive(Debug, Copy, Clone, PartialEq, Eq, Default)]\n140\tpub enum JitterMode {\n141\t    /// Gaussian jitter.  C: `jitter_gauss`.\n142\t    #[default]\n143\t    Gauss = 0,\n144\t    /// Wi-Fi-style jitter.  C: `jitter_wifi`.\n145\t    Wifi = 1,\n146\t}\n147\t\n148\t/// One simulated network link with an embedded queue plus AQM\n149\t/// hook.  C: `picoquictest_sim_link_t`.\n150\t///\n151\t/// Pointer-shape choices, derived from the bodies in\n152\t/// `picoquictest/sim_link.c`:\n153\t///\n154\t/// * `packets` replaces the C `first_packet` / `last_packet`\n155\t///   doubly-linked list head pair plus the per-`TestSimPacket`\n156\t///   `next_packet` chain.\n157\t/// * `loss_mask` — the C field was `*mut u64`, an externally-owned\n158\t///   error mask the link reads on every enqueue.  In the Rust port\n159\t///   the link owns its own copy: tests `&mut link.loss_mask` to\n160\t///   shift the mask between operations.  `None` matches the C\n161\t///   `NULL` sentinel.\n162\t/// * `aqm_state` becomes `Option<Box<dyn TestAqm>>` —\n163\t///   `None` matches the C `NULL` (no AQM installed).\n164\t/// * `is_switched_off` / `is_unreachable` / `is_suspended` were\n165\t///   `int` flags in C; promoted to `bool`.\n166\tpub struct TestSimLink {\n167\t    pub next_send_time: Instant,\n168\t    pub queue_time: Instant,\n169\t    pub resume_time: Instant,\n170\t    pub queue_delay_max: u64,\n171\t    pub picosec_per_byte: u64,\n172\t    pub microsec_latency: u64,\n173\t    pub packets_dropped: u64,\n174\t    pub packets_sent: u64,\n175\t    pub jitter: u64,\n176\t    pub jitter_mode: JitterMode,\n177\t    pub jitter_seed: u64,\n178\t    pub path_mtu: usize,\n179\t    /// Packets in flight on this link.  FIFO; the head is the\n180\t    /// next packet to deliver.\n181\t    pub packets: std::collections::VecDeque<TestSimPacket>,\n182\t    /// 64-bit error mask used in unit tests.  `None` ↔ \"no mask\".\n183\t    pub loss_mask: Option<u64>,\n184\t    pub nb_loss_in_burst: u64,\n185\t    pub packets_between_losses: u64,\n186\t    pub packets_sent_next_burst: u64,\n187\t    pub nb_losses_this_burst: u64,\n188\t    pub end_of_burst_time: Instant,\n189\t    pub aqm_state: Option<Box<dyn TestAqm>>,\n190\t    pub is_switched_off: bool,\n191\t    pub is_unreachable: bool,\n192\t    pub is_suspended: bool,\n193\t}\n194\t\n195\timpl TestSimLink {\n196\t    /// Create a sim link at `current_time`, with the given data\n197\t    /// rate (in gigabits per second) and one-way latency (in\n198\t    /// microseconds).  C: `picoquictest_sim_link_create`.\n199\t    ///\n200\t    /// `loss_mask` is the test's 64-bit error mask; `None` matches\n201\t    /// the C `NULL` (no mask).\n202\t    pub fn create(\n203\t        _data_rate_in_gbps: f64,\n204\t        _microsec_latency: u64,\n205\t        _loss_mask: Option<u64>,\n206\t        _queue_delay_max: u64,\n207\t        _current_time: Instant,\n208\t    ) -> Result<Self, crate::Error> {\n209\t        todo!()\n210\t    }\n211\t\n212\t    // C: `picoquictest_sim_link_delete`.  Dropped from the Rust\n213\t    // API: `Box<TestSimLink>` going out of scope will free the\n214\t    // link and its queued packets via Drop in Phase 4.\n215\t\n216\t    /// Time at which the next packet will arrive (or `current_time`\n217\t    /// if the queue is empty).  C:\n218\t    /// `picoquictest_sim_link_next_arrival`.\n219\t    pub fn next_arrival(&mut self, _current_time: Instant) -> u64 {\n220\t        todo!()\n221\t    }\n222\t\n223\t    /// Drain any AQM-pending packets onto the main queue at\n224\t    /// `current_time`.  C: `picoquictest_sim_link_admit_pending`.\n225\t    pub fn admit_pending(&mut self, _current_time: Instant) {\n226\t        todo!()\n227\t    }\n228\t\n229\t    /// Time at which the AQM will admit its next packet (or\n230\t    /// `next_time` if nothing is pending).  C:\n231\t    /// `picoquictest_sim_link_next_admission`.\n232\t    pub fn next_admission(&mut self, _current_time: Instant, _next_time: Instant) -> u64 {\n233\t        todo!()\n234\t    }\n235\t\n236\t    /// Pop the next-due packet, if any.  C:\n237\t    /// `picoquictest_sim_link_dequeue` returning `NULL` when\n238\t    /// nothing is ready, mapped to `Option<TestSimPacket>`.\n239\t    pub fn dequeue(&mut self, _current_time: Instant) -> Option<TestSimPacket> {\n240\t        todo!()\n241\t    }\n242\t\n243\t    /// Submit a packet to the queue with normal AQM processing and\n244\t    /// length check.  C: `picoquictest_sim_link_submit`.  Takes\n245\t    /// ownership of the packet — the link is responsible for\n246\t    /// either freeing it (drop) or returning it via\n247\t    /// [`TestSimLink::dequeue`].\n248\t    pub fn submit(&mut self, _packet: TestSimPacket, _current_time: Instant) {\n249\t        todo!()\n250\t    }\n251\t\n252\t    /// Submit a packet straight to the latency queue, bypassing the\n253\t    /// AQM.  When `should_drop` is `true` the packet is dropped\n254\t    /// instead of queued (and freed by the function).  C:\n255\t    /// `picoquictest_sim_link_enqueue` with the C `int\n256\t    /// should_drop` promoted to `bool`.\n257\t    pub fn enqueue(&mut self, _packet: TestSimPacket, _current_time: Instant, _should_drop: bool) {\n258\t        todo!()\n259\t    }\n260\t\n261\t    /// Compute the transmission time of `packet` (a function of\n262\t    /// the link's data rate and the packet length).  C:\n263\t    /// `picoquictest_sim_link_transmit_time`.\n264\t    pub fn transmit_time(&mut self, _packet: &TestSimPacket) -> u64 {\n265\t        todo!()\n266\t    }\n267\t\n268\t    /// Queueing delay of the next packet at `current_time`.  C:\n269\t    /// `picoquictest_sim_link_queue_delay`.\n270\t    pub fn queue_delay(&mut self, _current_time: Instant) -> u64 {\n271\t        todo!()\n272\t    }\n273\t\n274\t    /// Simulate a transmission interruption until\n275\t    /// `time_end_of_interval`.  When `simulate_receive` is `true`\n276\t    /// the link suspends *reception* (pending packets are\n277\t    /// delivered at the end of the interval); when `false` it\n278\t    /// suspends transmission (packets are queued as if transmitted\n279\t    /// in sequence after the interval).  C:\n280\t    /// `picoquic_test_simlink_suspend` with the C `int\n281\t    /// simulate_receive` promoted to `bool`.\n282\t    pub fn suspend(&mut self, _time_end_of_interval: Instant, _simulate_receive: bool) {\n283\t        todo!()\n284\t    }\n285\t}\n286\t\n287\t// ---------------------------------------------------------------------------\n288\t// Sack / ACK-frame test helpers.\n289\t\n290\t/// Verify that every per-range send counter in `sack_list` is consistent\n291\t/// with the summary stored in `sack_list.rc`.  C: `check_ack_ranges` in\n292\t/// `picoquictest/sacktest.c`.\n293\tpub fn check_ack_ranges(sack_list: &mut SackList) {\n294\t    for r in 0..2usize {\n295\t        let mut range_sum = [0i32; MAX_ACK_RANGE_REPEAT];\n296\t        let mut tok = sack_list.first_item();\n297\t        while let Some(t) = tok {\n298\t            let nb = sack_list\n299\t                .sack_items\n300\t                .get(t)\n301\t                .expect(\"sack item token valid\")\n302\t                .nb_times_sent[r];\n303\t            assert!(nb >= 0, \"nb_times_sent[{r}] < 0\");\n304\t            let idx = nb as usize;\n305\t            if idx < MAX_ACK_RANGE_REPEAT {\n306\t                range_sum[idx] += 1;\n307\t            }\n308\t            tok = sack_list.sack_next_item(t);\n309\t        }\n310\t        for (i, &expected) in range_sum.iter().enumerate() {\n311\t            assert_eq!(\n312\t                sack_list.rc[r].range_counts[i], expected,\n313\t                \"rc[{r}].range_counts[{i}] mismatch\",\n314\t            );\n315\t        }\n316\t    }\n317\t}\n318\t\n319\t/// Write an ACK frame into `bytes` and return the number of bytes written.\n320\t/// `None` maps to a test failure; `Some(0)` can't occur for a valid ACK.\n321\t/// Wraps [`crate::internal::format_ack_frame`] to avoid lifetime tangle.\n322\tpub fn format_ack_frame_written(\n323\t    connection: &mut Connection,\n324\t    bytes: &mut [u8],\n325\t    more_data: &mut i32,\n326\t    current_time: Instant,\n327\t    pc: PacketContext,\n328\t    is_opportunistic: i32,\n329\t) -> Option<usize> {\n330\t    let total = bytes.len();\n331\t    format_ack_frame(\n332\t        connection,\n333\t        bytes,\n334\t        more_data,\n335\t        current_time,\n336\t        pc,\n337\t        is_opportunistic,\n338\t    )\n339\t    .map(|r| total - r.len())\n340\t}\n341\t\n342\t// ---------------------------------------------------------------------------\n343\t// TLS API test context — translation of `picoquic_test_tls_api_ctx_t`\n344\t// and the helpers from `picoquictest/picoquictest_internal.h`.\n345\t\n346\t/// One stream scenario descriptor.  C: `test_api_stream_desc_t`.\n347\tpub struct TestApiStreamDesc {\n348\t    /// `stream_id` in C.\n349\t    pub stream_id: u64,\n350\t    /// `previous_stream_id` in C.\n351\t    pub previous_stream_id: u64,\n352\t    /// Query (client→server) payload length.\n353\t    pub q_len: usize,\n354\t    /// Response (server→client) payload length.\n355\t    pub r_len: usize,\n356\t}\n357\t\n358\t/// Combined TLS-API test context holding two QUIC contexts, their\n359\t/// two sim-links, and the addresses/callbacks baked in by the C\n360\t/// initialiser helpers.  C: `picoquic_test_tls_api_ctx_t`.\n361\t///\n362\t/// Ownership notes:\n363\t/// * `qclient` and `qserver` own the QUIC contexts.\n364\t/// * `cnx_client` and `cnx_server` are connection handles that live\n365\t///   *inside* their respective QUIC contexts; they are surfaced via\n366\t///   the [`cnx_client`][`TestTlsApiCtx::cnx_client`] /\n367\t///   [`cnx_server`][`TestTlsApiCtx::cnx_server`] methods (Phase 4\n368\t///   will wire these into real accessor paths).\n369\t/// * The sim-links are owned here and mutably shared with the\n370\t///   simulation loop.\n371\tpub struct TestTlsApiCtx {\n372\t    pub qclient: Box<Quic>,\n373\t    pub qserver: Box<Quic>,\n374\t    pub c_to_s_link: Box<TestSimLink>,\n375\t    pub s_to_c_link: Box<TestSimLink>,\n376\t}\n377\t\n378\timpl TestTlsApiCtx {\n379\t    /// Mutable reference to the client connection.\n380\t    /// C: `test_ctx->cnx_client`.\n381\t    pub fn cnx_client(&mut self) -> &mut Connection {\n382\t        todo!()\n383\t    }\n384\t\n385\t    /// Mutable reference to the server-side connection that was\n386\t    /// accepted in response to the client.\n387\t    /// C: `test_ctx->cnx_server`.\n388\t    pub fn cnx_server(&mut self) -> &mut Connection {\n389\t        todo!()\n390\t    }\n391\t}\n392\t\n393\t/// Initialise a TLS-API test context with the `_ex` variant that\n394\t/// accepts an explicit initial CID.\n395\t/// C: `tls_api_one_scenario_init_ex`.\n396\tpub fn tls_api_one_scenario_init_ex(\n397\t    _simulated_time: &mut Instant,\n398\t    _proposed_version: Version,\n399\t    _client_params: Option<&TransportParameters>,\n400\t    _server_params: Option<&TransportParameters>,\n401\t    _initial_cid: Option<&ConnectionId>,\n402\t) -> Option<Box<TestTlsApiCtx>> {\n403\t    todo!()\n404\t}\n405\t\n406\t/// Drive the TLS handshake to completion.\n407\t/// C: `tls_api_connection_loop`.\n408\tpub fn tls_api_connection_loop(\n409\t    _test_ctx: &mut TestTlsApiCtx,\n410\t    _loss_mask: &mut u64,\n411\t    _queue_delay_max: u64,\n412\t    _simulated_time: &mut Instant,\n413\t) -> crate::Result<()> {\n414\t    todo!()\n415\t}\n416\t\n417\t/// Spin the simulator until the client connection reaches the ready\n418\t/// state.  C: `wait_client_connection_ready`.\n419\tpub fn wait_client_connection_ready(\n420\t    _test_ctx: &mut TestTlsApiCtx,\n421\t    _simulated_time: &mut Instant,\n422\t) -> crate::Result<()> {\n423\t    todo!()\n424\t}\n425\t\n426\t/// Register the stream scenario on the test context so that the\n427\t/// send/receive loop will drive those streams.\n428\t/// C: `test_api_init_send_recv_scenario`.\n429\tpub fn test_api_init_send_recv_scenario(\n430\t    _test_ctx: &mut TestTlsApiCtx,\n431\t    _scenario: &[TestApiStreamDesc],\n432\t) -> crate::Result<()> {\n433\t    todo!()\n434\t}\n435\t\n436\t/// Drive data delivery until all streams in the scenario are done.\n437\t/// C: `tls_api_data_sending_loop`.\n438\tpub fn tls_api_data_sending_loop(\n439\t    _test_ctx: &mut TestTlsApiCtx,\n440\t    _loss_mask: &mut u64,\n441\t    _simulated_time: &mut Instant,\n442\t    _max_trials: i32,\n443\t) -> crate::Result<()> {\n444\t    todo!()\n445\t}\n446\t\n447\t/// Assert that all scenario streams completed and that the wall-clock\n448\t/// time did not exceed `max_completion_microsec` (0 = unconstrained).\n449\t/// C: `tls_api_one_scenario_body_verify`.\n450\tpub fn tls_api_one_scenario_body_verify(\n451\t    _test_ctx: &mut TestTlsApiCtx,\n452\t    _simulated_time: &mut Instant,\n453\t    _max_completion_microsec: u64,\n454\t) -> crate::Result<()> {\n455\t    todo!()\n456\t}\n457\t\n458\t// ---------------------------------------------------------------------------\n459\t// SNI / certificate paths used by the test suite.  Linux/macOS\n460\t// layout only; `_WINDOWS` paths are dropped per the v1 scope.\n461\t\n462\t/// Default SNI string for the test fixtures.\n463\tpub const TEST_SNI: &str = \"test.example.com\";\n464\t\n465\tpub const TEST_FILE_SERVER_CERT: &str = \"certs/cert.pem\";\n466\tpub const TEST_FILE_SERVER_BAD_CERT: &str = \"certs/badcert.pem\";\n467\tpub const TEST_FILE_SERVER_KEY: &str = \"certs/key.pem\";\n468\tpub const TEST_FILE_CERT_STORE: &str = \"certs/test-ca.crt\";\n469\tpub const TEST_FILE_SERVER_CERT_ECDSA: &str = \"certs/ecdsa/cert.pem\";\n470\tpub const TEST_FILE_SERVER_KEY_ECDSA: &str = \"certs/ecdsa/key.pem\";\n471\tpub const TEST_ECH_PUB_KEY: &str = \"certs/ech/public.pem\";\n472\tpub const TEST_ECH_PRIVATE_KEY: &str = \"certs/ech/private.pem\";\n473\tpub const TEST_ECH_CONFIG: &str = \"certs/ech/ech_config.txt\";\n474\tpub const TEST_ECH_CERT: &str = \"certs/ech/ech_cert.pem\";\n475\tpub const TEST_ECH_RR_REF: &str = \"certs/ech/ech_rr.txt\";\n476\tpub const TEST_ECH_CONFIG_REF: &str = \"certs/ech/ech_config.txt\";\n477\tpub const TEST_FILE_SERVER_CERT_RSA: &str = \"certs/rsa/cert.pem\";\n478\tpub const TEST_FILE_SERVER_KEY_RSA: &str = \"certs/rsa/key.pem\";\n479\tpub const TEST_FILE_SERVER_CERT_ED25519: &str = \"certs/mtls_ed25519/server.crt\";\n480\t\n481\t// ---------------------------------------------------------------------------\n482\t// Single-step simulator.\n483\t\n484\t/// Advance the simulation by one round, respecting `time_out` as the earliest\n485\t/// wake-up.  `was_active` is set to `true` when at least one packet was\n486\t/// processed.  C: `tls_api_one_sim_round`.\n487\tpub fn tls_api_one_sim_round(\n488\t    _test_ctx: &mut TestTlsApiCtx,\n489\t    _simulated_time: &mut Instant,\n490\t    _time_out: Instant,\n491\t    _was_active: &mut bool,\n492\t) -> crate::Result<()> {\n493\t    todo!()\n494\t}\n495\tpub const TEST_FILE_SERVER_KEY_ED25519: &str = \"certs/mtls_ed25519/server.key\";\n496\tpub const TEST_FILE_CLIENT_CERT_ED25519: &str = \"certs/mtls_ed25519/client.crt\";\n497\tpub const TEST_FILE_CLIENT_KEY_ED25519: &str = \"certs/mtls_ed25519/client.key\";\n498\tpub const TEST_FILE_CERT_STORE_ED25519: &str = \"certs/mtls_ed25519/ca.crt\";\n499\t"}]},"parent_tool_use_id":null,"session_id":"0475766a-7894-486d-a1cd-6ee58011c368","uuid":"664e7cf4-4bf0-40e4-be95-aad523ca4578","timestamp":"2026-05-04T21:41:21.251Z","tool_use_result":{"type":"text","file":{"filePath":"/Users/richbarn/Projects/picoquic/rs/fq/src/tests/util.rs","content":"//! Test-only utilities split out of [`crate::utils`].\n//!\n//! Contents:\n//!\n//! * **Deterministic test RNG** (`test_random`, `test_random_bytes`,\n//!   `test_uniform_random`, `test_gauss_random`,\n//!   `test_poisson_random`) — picoquic uses these to make\n//!   simulator runs reproducible.  The production RNG\n//!   (`crate::utils::uniform_random`) stays in `utils.rs`.\n//!\n//! * **Network simulator** (`TestSimPacket`, `TestSimLink`,\n//!   `TestAqm`, `JitterMode`) — the in-process sim-link used by\n//!   the test suite to exercise the QUIC stack without real sockets.\n//!   The C bodies live in `picoquictest/sim_link.c`.\n//!\n//! * **TLS API test context** (`TestTlsApiCtx`, `TestApiStreamDesc`,\n//!   `tls_api_one_scenario_init_ex`, etc.) — translation of the\n//!   `picoquic_test_tls_api_ctx_t` infrastructure and the helpers\n//!   declared in `picoquictest/picoquictest_internal.h`.\n//!\n//! * **Test-fixture certificate / SNI constants** — paths to PEM\n//!   files baked into the test tree (`certs/...`).\n//!\n//! All `pub` items in this module ride on the parent's\n//! `#[cfg(test)]` gate, so they don't bloat the production build.\n\nuse core::net::SocketAddr;\n\nuse crate::internal::{Connection, MAX_ACK_RANGE_REPEAT, SackList, Version, format_ack_frame};\nuse crate::tp::TransportParameters;\nuse crate::{ConnectionId, Instant, MAX_PACKET_SIZE, PacketContext, Quic};\n\n// ---------------------------------------------------------------------------\n// Deterministic test RNG.\n//\n// The production `uniform_random` reads from the platform RNG\n// (and stays in `crate::utils`).  These deterministic helpers\n// thread their state through the explicit `&mut u64` context\n// so simulator runs reproduce bit-for-bit.\n\n/// Deterministic test RNG: advance the 64-bit context and return\n/// the new value.  C: `uint64_t test_random(uint64_t*\n/// random_context)`.\npub fn test_random(_random_context: &mut u64) -> u64 {\n    todo!()\n}\n\n/// Fill `bytes` with deterministic test RNG output.  C:\n/// `void test_random_bytes(uint64_t* random_context,\n/// uint8_t* bytes, size_t bytes_max)` — `bytes_max` folds into the\n/// slice length.\npub fn test_random_bytes(_random_context: &mut u64, _bytes: &mut [u8]) {\n    todo!()\n}\n\n/// Uniform test RNG in `[0, rnd_max)`.  C:\n/// `test_uniform_random`.\npub fn test_uniform_random(_random_context: &mut u64, _rnd_max: u64) -> u64 {\n    todo!()\n}\n\n/// Gaussian-distributed test RNG (variance 1, mean 0).  C:\n/// `double test_gauss_random(uint64_t* random_context)`.\npub fn test_gauss_random(_random_context: &mut u64) -> f64 {\n    todo!()\n}\n\n/// Poisson-distributed test RNG.  C:\n/// `uint64_t test_poisson_random(uint64_t*, uint64_t)`\n/// where the second argument is `(uint64_t)(exp(-lambda) * 0x40000000)`.\npub fn test_poisson_random(_random_context: &mut u64, _exp_minus_lambda_2_30: u64) -> u64 {\n    todo!()\n}\n\n// ---------------------------------------------------------------------------\n// Network simulator (sim_link).\n\n/// One simulated packet flowing through a sim link.  C:\n/// `picoquictest_sim_packet_t`.\n///\n/// Pointer-shape choices:\n///\n/// * Packets live in `TestSimLink.packets: VecDeque<TestSimPacket>`\n///   (and `tests::dualq::DualqQueue.packets` for the AQM); the C\n///   `next_packet` intrusive chain is gone.\n/// * The two `sockaddr_storage` fields fold into\n///   `Option<SocketAddr>` (the C zero-initialised storage maps to\n///   `None`).\n/// * The flexible-array-style `bytes` is a fixed\n///   `[u8; MAX_PACKET_SIZE]` because the C struct\n///   declares it inline at that exact size.\npub struct TestSimPacket {\n    pub arrival_time: Instant,\n    pub length: usize,\n    pub addr_from: Option<SocketAddr>,\n    pub addr_to: Option<SocketAddr>,\n    pub ecn_mark: u8,\n    pub bytes: [u8; MAX_PACKET_SIZE],\n}\n\nimpl TestSimPacket {\n    /// Allocate a fresh, empty packet.  C:\n    /// `picoquictest_sim_link_create_packet`.\n    pub fn create() -> Result<Self, crate::Error> {\n        todo!()\n    }\n}\n\n/// Active queue management vtable.  C: the `picoquictest_aqm_t`\n/// struct of function pointers — folded into a single trait per\n/// the Phase 1 rule on function pointers.  The `self` parameter\n/// of each C method becomes the implicit `&mut self`; the\n/// `picoquictest_sim_link_t*` link pointer stays explicit because\n/// the AQM lives inside the link (taking the link by `&mut` in\n/// each call would conflict with the `&mut self` borrow).  Phase 4\n/// will resolve the borrow with a take-replace pattern.\npub trait TestAqm {\n    /// Submit a packet to the AQM.  C: `submit`.\n    fn submit(&mut self, link: &mut TestSimLink, packet: TestSimPacket, current_time: Instant);\n\n    /// Reset the AQM state at `current_time`.  C: `reset`.\n    fn reset(&mut self, link: &mut TestSimLink, current_time: Instant);\n\n    /// Release any resources held by the AQM, e.g. when the link\n    /// is being torn down.  C: `release`.\n    fn release(&mut self, link: &mut TestSimLink);\n\n    /// Whether the AQM has at least one pending packet ready to\n    /// admit.  C: `has_pending` returning a 0/1 flag, mapped to\n    /// `bool`.\n    fn has_pending(&mut self) -> bool;\n\n    /// Move any AQM-pending packets onto the link's main queue.\n    /// C: `admit_pending`.\n    fn admit_pending(&mut self, link: &mut TestSimLink, current_time: Instant);\n}\n\n/// Jitter model used by the sim link.  C: `picoquic_jitter_mode`.\n#[derive(Debug, Copy, Clone, PartialEq, Eq, Default)]\npub enum JitterMode {\n    /// Gaussian jitter.  C: `jitter_gauss`.\n    #[default]\n    Gauss = 0,\n    /// Wi-Fi-style jitter.  C: `jitter_wifi`.\n    Wifi = 1,\n}\n\n/// One simulated network link with an embedded queue plus AQM\n/// hook.  C: `picoquictest_sim_link_t`.\n///\n/// Pointer-shape choices, derived from the bodies in\n/// `picoquictest/sim_link.c`:\n///\n/// * `packets` replaces the C `first_packet` / `last_packet`\n///   doubly-linked list head pair plus the per-`TestSimPacket`\n///   `next_packet` chain.\n/// * `loss_mask` — the C field was `*mut u64`, an externally-owned\n///   error mask the link reads on every enqueue.  In the Rust port\n///   the link owns its own copy: tests `&mut link.loss_mask` to\n///   shift the mask between operations.  `None` matches the C\n///   `NULL` sentinel.\n/// * `aqm_state` becomes `Option<Box<dyn TestAqm>>` —\n///   `None` matches the C `NULL` (no AQM installed).\n/// * `is_switched_off` / `is_unreachable` / `is_suspended` were\n///   `int` flags in C; promoted to `bool`.\npub struct TestSimLink {\n    pub next_send_time: Instant,\n    pub queue_time: Instant,\n    pub resume_time: Instant,\n    pub queue_delay_max: u64,\n    pub picosec_per_byte: u64,\n    pub microsec_latency: u64,\n    pub packets_dropped: u64,\n    pub packets_sent: u64,\n    pub jitter: u64,\n    pub jitter_mode: JitterMode,\n    pub jitter_seed: u64,\n    pub path_mtu: usize,\n    /// Packets in flight on this link.  FIFO; the head is the\n    /// next packet to deliver.\n    pub packets: std::collections::VecDeque<TestSimPacket>,\n    /// 64-bit error mask used in unit tests.  `None` ↔ \"no mask\".\n    pub loss_mask: Option<u64>,\n    pub nb_loss_in_burst: u64,\n    pub packets_between_losses: u64,\n    pub packets_sent_next_burst: u64,\n    pub nb_losses_this_burst: u64,\n    pub end_of_burst_time: Instant,\n    pub aqm_state: Option<Box<dyn TestAqm>>,\n    pub is_switched_off: bool,\n    pub is_unreachable: bool,\n    pub is_suspended: bool,\n}\n\nimpl TestSimLink {\n    /// Create a sim link at `current_time`, with the given data\n    /// rate (in gigabits per second) and one-way latency (in\n    /// microseconds).  C: `picoquictest_sim_link_create`.\n    ///\n    /// `loss_mask` is the test's 64-bit error mask; `None` matches\n    /// the C `NULL` (no mask).\n    pub fn create(\n        _data_rate_in_gbps: f64,\n        _microsec_latency: u64,\n        _loss_mask: Option<u64>,\n        _queue_delay_max: u64,\n        _current_time: Instant,\n    ) -> Result<Self, crate::Error> {\n        todo!()\n    }\n\n    // C: `picoquictest_sim_link_delete`.  Dropped from the Rust\n    // API: `Box<TestSimLink>` going out of scope will free the\n    // link and its queued packets via Drop in Phase 4.\n\n    /// Time at which the next packet will arrive (or `current_time`\n    /// if the queue is empty).  C:\n    /// `picoquictest_sim_link_next_arrival`.\n    pub fn next_arrival(&mut self, _current_time: Instant) -> u64 {\n        todo!()\n    }\n\n    /// Drain any AQM-pending packets onto the main queue at\n    /// `current_time`.  C: `picoquictest_sim_link_admit_pending`.\n    pub fn admit_pending(&mut self, _current_time: Instant) {\n        todo!()\n    }\n\n    /// Time at which the AQM will admit its next packet (or\n    /// `next_time` if nothing is pending).  C:\n    /// `picoquictest_sim_link_next_admission`.\n    pub fn next_admission(&mut self, _current_time: Instant, _next_time: Instant) -> u64 {\n        todo!()\n    }\n\n    /// Pop the next-due packet, if any.  C:\n    /// `picoquictest_sim_link_dequeue` returning `NULL` when\n    /// nothing is ready, mapped to `Option<TestSimPacket>`.\n    pub fn dequeue(&mut self, _current_time: Instant) -> Option<TestSimPacket> {\n        todo!()\n    }\n\n    /// Submit a packet to the queue with normal AQM processing and\n    /// length check.  C: `picoquictest_sim_link_submit`.  Takes\n    /// ownership of the packet — the link is responsible for\n    /// either freeing it (drop) or returning it via\n    /// [`TestSimLink::dequeue`].\n    pub fn submit(&mut self, _packet: TestSimPacket, _current_time: Instant) {\n        todo!()\n    }\n\n    /// Submit a packet straight to the latency queue, bypassing the\n    /// AQM.  When `should_drop` is `true` the packet is dropped\n    /// instead of queued (and freed by the function).  C:\n    /// `picoquictest_sim_link_enqueue` with the C `int\n    /// should_drop` promoted to `bool`.\n    pub fn enqueue(&mut self, _packet: TestSimPacket, _current_time: Instant, _