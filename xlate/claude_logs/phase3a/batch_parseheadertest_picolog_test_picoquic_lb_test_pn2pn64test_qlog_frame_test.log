,\n    { 0xDEADBE6F, 0xFFFFFFFFFFFFFF00ull, 0xEF, 0xDEADBEEFull },\n    { 0xDEADBE6E, 0xFFFFFFFFFFFFFF00ull, 0xEF, 0xDEADBDEFull },\n    { 0xDEADBEEF, 0xFFFFFFFFC0000000ull, 0x1EADBEF0, 0xDEADBEF0 },\n    { 0xDEADBEEF, 0xFFFFFFFFC0000000ull, 0x1EADBEEF, 0xDEADBEEF },\n    { 0xDEADBEEF, 0xFFFFFFFFC0000000ull, 0x1EADBEEE, 0xDEADBEEE },\n    { 0xDEADBEEF, 0xFFFFFFFFC0000000ull, 0, 0xC0000000ull },\n    { 0xDEADBEEF, 0xFFFFFFFFC0000000ull, 1, 0xC0000001ull },\n    { 0xDEADBEEF, 0xFFFFFFFFC0000000ull, 0x10000000, 0xD0000000ull },\n    { 0x5EADBEEF, 0xFFFFFFFFC0000000ull, 0x1EADBEEF, 0x5EADBEEFull },\n    { 0x15EADBEEF, 0xFFFFFFFFC0000000ull, 0x1EADBEEF, 0x15EADBEEFull }\n};\n\nstatic const size_t nb_test_entries = sizeof(test_entries) / sizeof(struct _pn2pn64test_entry);\n\nint pn2pn64test(void)\n{\n    int ret = 0;\n\n    for (size_t i = 0; i < nb_test_entries; i++) {\n        uint64_t pn64 = picoquic_get_packet_number64(\n            test_entries[i].highest,\n            test_entries[i].mask,\n            test_entries[i].pn);\n\n        if (pn64 != test_entries[i].expected) {\n            ret = -1;\n        }\n    }\n\n    return ret;\n}\n","numLines":90,"startLine":1,"totalLines":90}}}
