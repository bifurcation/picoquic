c_file_open(log_test_input, \"rb\")) == NULL) {\n96\t            ret = -1;\n97\t        }\n98\t    }\n99\t    if (ret == 0) {\n100\t        ret = picoquic_get_input_path(svg_template, sizeof(svg_template), picoquic_solution_dir, PICOLOG_SVG_TEMPLATE);\n101\t        if (ret == 0) {\n102\t            if ((appctx.f_template = picoquic_file_open(svg_template, \"r\")) == NULL) {\n103\t                ret = -1;\n104\t            }\n105\t        }\n106\t    }\n107\t\n108\t    if (ret == 0) {\n109\t        cids = cidset_create();\n110\t        if (cids == NULL) {\n111\t            ret = -1;\n112\t        }\n113\t        else {\n114\t            binlog_list_cids(appctx.f_binlog, cids);\n115\t            if (cids->count == 0) {\n116\t                ret = -1;\n117\t            }\n118\t        }\n119\t    }\n120\t    \n121\t    if (ret == 0) {\n122\t        FILE* cid_prints;\n123\t        if ((cid_prints = picoquic_file_open(CIDSET_OUTPUT, \"w\")) == NULL) {\n124\t            ret = -1;\n125\t        }\n126\t        else {\n127\t            cidset_print(cid_prints, cids);\n128\t            (void)picoquic_file_close(cid_prints);\n129\t        }\n130\t    }\n131\t\n132\t    if (ret == 0) {\n133\t        picoquic_connection_id_t cid_test = { {11, 12, 13, 14, 15, 16, 17, 18}, 8 };\n134\t\n135\t        if (cidset_has_cid(cids, &cid_test)) {\n136\t            ret = -1;\n137\t        }\n138\t    }\n139\t\n140\t    if (ret == 0) {\n141\t        ret = cidset_iterate(cids, test_convert_svg, &appctx);\n142\t    }\n143\t\n144\t    (void)picoquic_file_close(appctx.f_binlog);\n145\t    (void)picoquic_file_close(appctx.f_template);\n146\t    if (cids != NULL) {\n147\t        (void)cidset_delete(cids);\n148\t    }\n149\t    /* compare the log file to the expected value */\n150\t    if (ret == 0)\n151\t    {\n152\t        char svglog_ref[512];\n153\t\n154\t        ret = picoquic_get_input_path(svglog_ref, sizeof(svglog_ref), picoquic_solution_dir, SVG_LOG_REF);\n155\t\n156\t        if (ret != 0