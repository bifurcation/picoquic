{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01YJG8cVEb8Fxs47hTMqq2Ac","type":"tool_result","content":"800\t\n801\t    if (ret != 0) {\n802\t        DBG_PRINTF(\"%s\", \"Cannot set the cert, key or store file names.\\n\");\n803\t    }\n804\t    else {\n805\t        qclient = picoquic_create(8, NULL, NULL, NULL, NULL, NULL, NULL,\n806\t            NULL, NULL, NULL, 0, NULL, NULL, NULL, 0);\n807\t        qserver = picoquic_create(8,\n808\t            test_server_cert_file, test_server_key_file, test_server_cert_store_file,\n809\t            \"test\", NULL, NULL, NULL, NULL, NULL, 0, NULL, NULL, NULL, 0);\n810\t        if (qclient == NULL || qserver == NULL) {\n811\t            DBG_PRINTF(\"%s\", \"Could not create Quic contexts.\\n\");\n812\t            ret = -1;\n813\t        }\n814\t    }\n815\t\n816\t    if (ret == 0) {\n817\t        memset(&test_addr_c, 0, sizeof(struct sockaddr_in));\n818\t        test_addr_c.sin_family = AF_INET;\n819\t        memcpy(&test_addr_c.sin_addr, addr1, 4);\n820\t        test_addr_c.sin_port = 12345;\n821\t\n822\t        cnx_client = picoquic_create_cnx(qclient, picoquic_null_connection_id, picoquic_null_connection_id,\n823\t            (struct sockaddr*)&test_addr_c, 0, 0, NULL, PICOQUIC_TEST_ALPN, 1);\n824\t        if (cnx_client == NULL) {\n825\t            DBG_PRINTF(\"%s\", \"Could not create client connection context.\\n\");\n826\t            ret = -1;\n827\t        }\n828\t        else {\n829\t            ret = picoquic_start_client_cnx(cnx_client);\n830\t        }\n831\t    }\n832\t\n833\t    /* Test with a series of packets */\n834\t    /* First, client initial */\n835\t    if (ret == 0) {\n836\t        ret = test_packet_encrypt_one(\n837\t            (struct sockaddr *) &test_addr_c,\n838\t            cnx_client, qserver, NULL, picoquic_packet_initial, 1256);\n839\t    }\n840\t    /* If that work, update the connection context */\n841\t    if (ret == 0) {\n842\t        cnx_server = qserver->cnx_list;\n843\t        if (cnx_server == NULL) {\n844\t            DBG_PRINTF(\"%s\", \"Did not create the server connection context.\\n\");\n845\t            ret = -1;\n846\t        } else {\n847\t            /* Set the remote context ID for the client */\n848\t            cnx_client->path[0]->first_tuple->p_remote_cnxid->cnx_id = cnx_server->path[0]->first_tuple->p_local_cnxid->cnx_id;\n849\t        }\n850\t    }\n851\t\n852\t    prefix_label = picoquic_supported_versions[cnx_client->version_index].tls_prefix_label;\n853\t\n854\t    /* Try handshake packet from client */\n855\t    if (ret == 0) {\n856\t        cnx_client->crypto_context[2].aead_encrypt = picoquic_setup_test_aead_context(1, test_handshake_secret, prefix_label);\n857\t        cnx_server->crypto_context[2].aead_decrypt = picoquic_setup_test_aead_context(0, test_handshake_secret, prefix_label);\n858\t        cnx_client->crypto_context[2].pn_enc = picoquic_pn_enc_create_for_test(test_handshake_secret, prefix_label);\n859\t        cnx_server->crypto_context[2].pn_dec = picoquic_pn_enc_create_for_test(test_handshake_secret, prefix_label);\n860\t        ret = test_packet_encrypt_one(\n861\t            (struct sockaddr *) &test_addr_c,\n862\t            cnx_client, qserver, cnx_server, picoquic_packet_handshake, 1256);\n863\t    }\n864\t\n865\t    /* Now try a zero RTT packet */\n866\t    if (ret == 0) {\n867\t        cnx_client->crypto_context[1].aead_encrypt = picoquic_setup_test_aead_context(1, test_0rtt_secret, prefix_label);\n868\t        cnx_server->crypto_context[1].aead_decrypt = picoquic_setup_test_aead_context(0, test_0rtt_secret, prefix_label);\n869\t        cnx_client->crypto_context[1].pn_enc = picoquic_pn_enc_create_for_test(test_0rtt_secret, prefix_label);\n870\t        cnx_server->crypto_context[1].pn_dec = picoquic_pn_enc_create_for_test(test_0rtt_secret, prefix_label);\n871\t\n872\t        /* Use a null connection ID to trigger use of initial ID */\n873\t        cnx_client->path[0]->first_tuple->p_remote_cnxid->cnx_id = picoquic_null_connection_id;\n874\t\n875\t        ret = test_packet_encrypt_one(\n876\t            (struct sockaddr *) &test_addr_c,\n877\t            cnx_client, qserver, cnx_server, picoquic_packet_0rtt_protected, 256);\n878\t\n879\t\n880\t        /* Set the remote context ID for the next test  */\n881\t        cnx_client->path[0]->first_tuple->p_remote_cnxid->cnx_id = cnx_server->path[0]->first_tuple->p_local_cnxid->cnx_id;\n882\t    }\n883\t\n884\t    /* And try a 1 RTT packet */\n885\t    if (ret == 0) {\n886\t        cnx_client->crypto_context[3].aead_encrypt = picoquic_setup_test_aead_context(1, test_1rtt_secret, prefix_label);\n887\t        cnx_server->crypto_context[3].aead_decrypt = picoquic_setup_test_aead_context(0, test_1rtt_secret, prefix_label);\n888\t        cnx_client->crypto_context[3].pn_enc = picoquic_pn_enc_create_for_test(test_1rtt_secret, prefix_label);\n889\t        cnx_server->crypto_context[3].pn_dec = picoquic_pn_enc_create_for_test(test_1rtt_secret, prefix_label);\n890\t\n891\t        ret = test_packet_encrypt_one(\n892\t            (struct sockaddr *) &test_addr_c,\n893\t            cnx_client, qserver, cnx_server, picoquic_packet_1rtt_protected, 1024);\n894\t    }\n895\t\n896\t    if (cnx_client != NULL) {\n897\t        picoquic_delete_cnx(cnx_client);\n898\t    }\n899\t\n900\t    if (qclient != NULL) {\n901\t        picoquic_free(qclient);\n902\t    }\n903\t\n904\t    if (qserver != NULL) {\n905\t        picoquic_free(qserver);\n906\t    }\n907\t\n908\t    return ret;\n909\t}\n910\t\n911\t/* Tests of potentially challenging initial packets. \n912\t * The test passes if the packet is accepted and the\n913\t * connection is created.\n914\t */\n915\t\n916\tint packet_initial_dec_one(\n917\t    uint8_t* bytes,\n918\t    size_t packet_length)\n919\t{\n920\t    int ret = 0;\n921\t    struct sockaddr_in test_addr_c;\n922\t    struct sockaddr_in test_addr_s;\n923\t    picoquic_quic_t* qserver = NULL;\n924\t    picoquic_cnx_t* new_cnx = NULL;\n925\t    char test_server_cert_file[512];\n926\t    char test_server_key_file[512];\n927\t    char test_server_cert_store_file[512];\n928\t\n929\t    picoquic_set_test_address(&test_addr_c, 0xabcd, 12345);\n930\t    picoquic_set_test_address(&test_addr_s, 0xa001, 443);\n931\t\n932\t    ret = picoquic_get_input_path(test_server_cert_file, sizeof(test_server_cert_file), picoquic_solution_dir, PICOQUIC_TEST_FILE_SERVER_CERT);\n933\t\n934\t    if (ret == 0) {\n935\t        ret = picoquic_get_input_path(test_server_key_file, sizeof(test_server_key_file), picoquic_solution_dir, PICOQUIC_TEST_FILE_SERVER_KEY);\n936\t    }\n937\t\n938\t    if (ret == 0) {\n939\t        ret = picoquic_get_input_path(test_server_cert_store_file, sizeof(test_server_cert_store_file), picoquic_solution_dir, PICOQUIC_TEST_FILE_CERT_STORE);\n940\t    }\n941\t\n942\t    if (ret != 0) {\n943\t        DBG_PRINTF(\"%s\", \"Cannot set the cert, key or store file names.\\n\");\n944\t    }\n945\t    else {\n946\t        qserver = picoquic_create(8,\n947\t            test_server_cert_file, test_server_key_file, test_server_cert_store_file,\n948\t            \"h3\", NULL, NULL, NULL, NULL, NULL, 0, NULL, NULL, NULL, 0);\n949\t        if (qserver == NULL) {\n950\t            DBG_PRINTF(\"%s\", \"Could not create Quic context.\\n\");\n951\t            ret = -1;\n952\t        }\n953\t    }\n954\t\n955\t    if (ret == 0) {\n956\t        ret = picoquic_incoming_packet_ex(qserver, bytes, packet_length,\n957\t            (struct sockaddr*)&test_addr_c, (struct sockaddr*)&test_addr_s, 0,\n958\t            0, &new_cnx, 0);\n959\t        if (ret != 0) {\n960\t            DBG_PRINTF(\"Incoming returns ret=0x%x\", ret);\n961\t        }\n962\t        else if (new_cnx == NULL) {\n963\t            ret = -1;\n964\t            DBG_PRINTF(\"No connection created ret=0x%x\", ret);\n965\t        }\n966\t    }\n967\t\n968\t    if (qserver != NULL) {\n969\t        picoquic_free(qserver);\n970\t    }\n971\t\n972\t    return ret;\n973\t}\n974\t\n975\tint incoming_initial_test(void)\n976\t{\n977\t    int ret = packet_initial_dec_one(packet_intel_bug, sizeof(packet_intel_bug));\n978\t\n979\t    return ret;\n980\t}\n981\t\n982\t/* Header length test. verify that the header length prediction\n983\t * matches the actual length of the encoding.\n984\t * Loop through a set of variables: state of connection, type of packet,\n985\t * sequence number, last packet not acknowledged.\n986\t */\n987\t\n988\ttypedef struct st_header_length_case_t {\n989\t    int is_client;\n990\t    int i_cid_length;\n991\t    int local_cid_length;\n992\t    int remote_cid_length;\n993\t    picoquic_packet_type_enum ptype;\n994\t    uint64_t sequence;\n995\t    uint64_t sequence_unack;\n996\t    uint64_t sequence_unack_after;\n997\t} header_length_case_t;\n998\t\n999\tstatic header_length_case_t header_length_case[] = {\n1000\t    { 0, 8, 8, 8, picoquic_packet_initial, 0, UINT64_MAX, UINT64_MAX },\n1001\t    { 0, 8, 8, 16, picoquic_packet_initial, 0, UINT64_MAX, UINT64_MAX },\n1002\t    { 0, 16, 8, 4, picoquic_packet_initial, 0, UINT64_MAX, UINT64_MAX },\n1003\t    { 0, 16, 8, 0, picoquic_packet_initial, 0, UINT64_MAX, UINT64_MAX },\n1004\t    { 0, 16, 0, 0, picoquic_packet_initial, 0, UINT64_MAX, UINT64_MAX },\n1005\t    { 0, 8, 8, 8, picoquic_packet_handshake, 0, UINT64_MAX, UINT64_MAX },\n1006\t    { 0, 8, 8, 16, picoquic_packet_handshake, 0, UINT64_MAX, UINT64_MAX },\n1007\t    { 0, 16, 8, 4, picoquic_packet_handshake, 0, UINT64_MAX, UINT64_MAX },\n1008\t    { 0, 16, 8, 0, picoquic_packet_handshake, 0, UINT64_MAX, UINT64_MAX },\n1009\t    { 0, 16, 0, 0, picoquic_packet_handshake, 0, UINT64_MAX, UINT64_MAX },\n1010\t    { 0, 8, 8, 8, picoquic_packet_1rtt_protected, 0, UINT64_MAX, UINT64_MAX },\n1011\t    { 0, 8, 8, 16, picoquic_packet_1rtt_protected, 0, UINT64_MAX, UINT64_MAX },\n1012\t    { 0, 16, 8, 4, picoquic_packet_1rtt_protected, 0, UINT64_MAX, UINT64_MAX },\n1013\t    { 0, 16, 8, 0, picoquic_packet_1rtt_protected, 0, UINT64_MAX, UINT64_MAX },\n1014\t    { 0, 16, 0, 0, picoquic_packet_1rtt_protected, 0, UINT64_MAX, UINT64_MAX },\n1015\t    { 0, 8, 0, 0, picoquic_packet_1rtt_protected, 0, UINT64_MAX, UINT64_MAX },\n1016\t    { 0, 16, 8, 4, picoquic_packet_1rtt_protected, 63, UINT64_MAX, UINT64_MAX },\n1017\t    { 0, 16, 8, 4, picoquic_packet_1rtt_protected, 64, UINT64_MAX, UINT64_MAX },\n1018\t    { 0, 16, 8, 4, picoquic_packet_1rtt_protected, 255, UINT64_MAX, UINT64_MAX },\n1019\t    { 0, 16, 8, 4, picoquic_packet_1rtt_protected, 0xffff, UINT64_MAX, UINT64_MAX },\n1020\t    { 0, 16, 8, 4, picoquic_packet_1rtt_protected, 0xffffff, UINT64_MAX, UINT64_MAX },\n1021\t    { 0, 16, 8, 4, picoquic_packet_1rtt_protected, 0xffffffff, UINT64_MAX, UINT64_MAX },\n1022\t    { 0, 16, 8, 4, picoquic_packet_1rtt_protected, 0xffffffffffull, UINT64_MAX, UINT64_MAX },\n1023\t    { 0, 16, 8, 4, picoquic_packet_1rtt_protected, 0xffffffff, 0xffffff00, 0xfffffffe },\n1024\t    { 0, 16, 8, 4, picoquic_packet_1rtt_protected, 0xffffffff, 0xffffff00, UINT64_MAX },\n1025\t    { 0, 16, 8, 4, picoquic_packet_handshake, 0xffffffff, 0xffffff00, 0xfffffffe },\n1026\t    { 0, 16, 8, 4, picoquic_packet_handshake, 0xffffffff, 0xffffff00, UINT64_MAX },\n1027\t    { 0, 16, 8, 4, picoquic_packet_initial, 0xffffffff, 0xffffff00, 0xfffffffe },\n1028\t    { 0, 16, 8, 4, picoquic_packet_initial, 0xffffffff, 0xffffff00, UINT64_MAX },\n1029\t    { 1, 8, 8, 8, picoquic_packet_initial, 0, UINT64_MAX, UINT64_MAX },\n1030\t    { 1, 8, 8, 16, picoquic_packet_initial, 0, UINT64_MAX, UINT64_MAX },\n1031\t    { 1, 16, 8, 4, picoquic_packet_initial, 0, UINT64_MAX, UINT64_MAX },\n1032\t    { 1, 16, 8, 0, picoquic_packet_initial, 0, UINT64_MAX, UINT64_MAX },\n1033\t    { 1, 16, 0, 0, picoquic_packet_initial, 0, UINT64_MAX, UINT64_MAX },\n1034\t    { 1, 8, 8, 8, picoquic_packet_0rtt_protected, 0, UINT64_MAX, UINT64_MAX },\n1035\t    { 1, 8, 8, 16, picoquic_packet_0rtt_protected, 0, UINT64_MAX, UINT64_MAX },\n1036\t    { 1, 16, 8, 4, picoquic_packet_0rtt_protected, 0, UINT64_MAX, UINT64_MAX },\n1037\t    { 1, 16, 8, 0, picoquic_packet_0rtt_protected, 0, UINT64_MAX, UINT64_MAX },\n1038\t    { 1, 16, 0, 0, picoquic_packet_0rtt_protected, 0, UINT64_MAX, UINT64_MAX },\n1039\t    { 1, 8, 8, 8, picoquic_packet_handshake, 0, UINT64_MAX, UINT64_MAX },\n1040\t    { 1, 8, 8, 16, picoquic_packet_handshake, 0, UINT64_MAX, UINT64_MAX },\n1041\t    { 1, 16, 8, 4, picoquic_packet_handshake, 0, UINT64_MAX, UINT64_MAX },\n1042\t    { 1, 16, 8, 0, picoquic_packet_handshake, 0, UINT64_MAX, UINT64_MAX },\n1043\t    { 1, 16, 0, 0, picoquic_packet_handshake, 0, UINT64_MAX, UINT64_MAX },\n1044\t    { 1, 16, 8, 4, picoquic_packet_handshake, 0xffffffff, 0xffffff00, 0xfffffffe },\n1045\t    { 1, 16, 8, 4, picoquic_packet_handshake, 0xffffffff, 0xffffff00, UINT64_MAX },\n1046\t    { 1, 16, 8, 4, picoquic_packet_initial, 0xffffffff, 0xffffff00, 0xfffffffe },\n1047\t    { 1, 16, 8, 4, picoquic_packet_initial, 0xffffffff, 0xffffff00, UINT64_MAX },\n1048\t    { 1, 8, 8, 8, picoquic_packet_1rtt_protected, 0, UINT64_MAX, UINT64_MAX },\n1049\t    { 1, 16, 8, 4, picoquic_packet_1rtt_protected, 255, UINT64_MAX, UINT64_MAX },\n1050\t    { 1, 16, 8, 4, picoquic_packet_1rtt_protected, 0xffff, UINT64_MAX, UINT64_MAX },\n1051\t    { 1, 16, 8, 4, picoquic_packet_1rtt_protected, 0xffffff, UINT64_MAX, UINT64_MAX },\n1052\t    { 1, 16, 8, 4, picoquic_packet_1rtt_protected, 0xffffffff, UINT64_MAX, UINT64_MAX },\n1053\t    { 1, 16, 8, 4, picoquic_packet_1rtt_protected, 0xffffffffffull, UINT64_MAX, UINT64_MAX },\n1054\t    { 1, 16, 8, 4, picoquic_packet_1rtt_protected, 0xffffffff, 0xffffff00, 0xfffffffe },\n1055\t    { 1, 16, 8, 4, picoquic_packet_1rtt_protected, 0xffffffff, 0xffffff00, UINT64_MAX }\n1056\t};\n1057\t\n1058\tstatic size_t nb_header_length_cases = sizeof(header_length_case) / sizeof(header_length_case_t);\n1059\t\n1060\tstatic int header_length_test_set_queue(picoquic_cnx_t* cnx, header_length_case_t* hlc,\n1061\t    uint64_t unack, picoquic_packet_context_enum pc, picoquic_packet_context_t* pkt_ctx, uint64_t simulated_time)\n1062\t{\n1063\t    int ret = 0;\n1064\t    pkt_ctx->send_sequence = hlc->sequence;\n1065\t\n1066\t    if (unack != UINT64_MAX) {\n1067\t        picoquic_packet_t* packet = picoquic_create_packet(cnx->quic);\n1068\t        if (packet == NULL) {\n1069\t            ret = -1;\n1070\t        }\n1071\t        else {\n1072\t            packet->ptype = hlc->ptype;\n1073\t            packet->sequence_number = unack;\n1074\t            packet->length = PICOQUIC_MAX_PACKET_SIZE;\n1075\t            packet->pc = pc;\n1076\t            picoquic_queue_for_retransmit(cnx, cnx->path[0], packet, packet->length, simulated_time);\n1077\t        }\n1078\t    }\n1079\t    return ret;\n1080\t}\n1081\t\n1082\tstatic int header_length_test_one(header_length_case_t * hlc)\n1083\t{\n1084\t    int ret = 0;\n1085\t    char test_server_cert_file[512];\n1086\t    char test_server_key_file[512];\n1087\t    char test_server_cert_store_file[512];\n1088\t    uint64_t simulated_time = 0;\n1089\t    picoquic_quic_t* quic = NULL;\n1090\t    picoquic_cnx_t* cnx = NULL;\n1091\t    picoquic_connection_id_t i_cid;\n1092\t    picoquic_connection_id_t r_cid;\n1093\t    struct sockaddr_in addr_to;\n1094\t    picoquic_packet_context_enum pc = 0;\n1095\t    picoquic_packet_context_t* pkt_ctx = NULL;\n1096\t    size_t predicted_length = 0;\n1097\t    size_t header_length = 0;\n1098\t    size_t pn_offset;\n1099\t    size_t pn_length;\n1100\t    uint8_t buffer[PICOQUIC_MAX_PACKET_SIZE];\n1101\t\n1102\t    /* Create the remote address */\n1103\t    picoquic_set_test_address(&addr_to, 0xabcd, 12345);\n1104\t    /* Set cid to required value */\n1105\t    memset(i_cid.id, 0x11, 20);\n1106\t    memset(r_cid.id, 0xdd, 20);\n1107\t    i_cid.id_len = hlc->i_cid_length;\n1108\t    r_cid.id_len = hlc->remote_cid_length;\n1109\t\n1110\t    /* Create the quic context */\n1111\t    ret = picoquic_get_input_path(test_server_cert_file, sizeof(test_server_cert_file), picoquic_solution_dir, PICOQUIC_TEST_FILE_SERVER_CERT);\n1112\t    if (ret == 0) {\n1113\t        ret = picoquic_get_input_path(test_server_key_file, sizeof(test_server_key_file), picoquic_solution_dir, PICOQUIC_TEST_FILE_SERVER_KEY);\n1114\t    }\n1115\t    if (ret == 0) {\n1116\t        ret = picoquic_get_input_path(test_server_cert_store_file, sizeof(test_server_cert_store_file), picoquic_solution_dir, PICOQUIC_TEST_FILE_CERT_STORE);\n1117\t    }\n1118\t    if (ret != 0) {\n1119\t        DBG_PRINTF(\"%s\", \"Cannot set the cert, key or store file names.\\n\");\n1120\t    }\n1121\t    else {\n1122\t        quic = picoquic_create(8,\n1123\t            test_server_cert_file, test_server_key_file, test_server_cert_store_file,\n1124\t            \"h3\", NULL, NULL, NULL, NULL, NULL, 0, &simulated_time, NULL, NULL, 0);\n1125\t        if (quic == NULL) {\n1126\t            DBG_PRINTF(\"%s\", \"Could not create Quic context.\\n\");\n1127\t            ret = -1;\n1128\t        }\n1129\t        else {\n1130\t            quic->local_cnxid_length = hlc->local_cid_length;\n1131\t        }\n1132\t    }\n1133\t\n1134\t    /* Create a connection with desired characteristics */\n1135\t    if (ret == 0) {\n1136\t        cnx = picoquic_create_cnx(quic, i_cid, r_cid, (struct sockaddr*)&addr_to, 0, 0, \"test\", \"h3\", hlc->is_client);\n1137\t        if (cnx == NULL) {\n1138\t            ret = -1;\n1139\t        }\n1140\t        else {\n1141\t            /* Find the required packet context and initialize the sequence and retransmit or retransmitted queue */\n1142\t            /* TODO: add option for trying packet type retry */\n1143\t            if (hlc->ptype == picoquic_packet_initial) {\n1144\t                pc = picoquic_packet_context_initial;\n1145\t                pkt_ctx = &cnx->pkt_ctx[picoquic_packet_context_initial];\n1146\t            }\n1147\t            else if (hlc->ptype == picoquic_packet_handshake) {\n1148\t                pc = picoquic_packet_context_handshake;\n1149\t                pkt_ctx = &cnx->pkt_ctx[picoquic_packet_context_handshake];\n1150\t            }\n1151\t            else if (hlc->ptype == picoquic_packet_0rtt_protected || hlc->ptype == picoquic_packet_1rtt_protected) {\n1152\t                pc = picoquic_packet_context_application;\n1153\t                pkt_ctx = &cnx->pkt_ctx[picoquic_packet_context_application];\n1154\t            }\n1155\t            if (pkt_ctx != NULL) {\n1156\t                pkt_ctx->send_sequence = hlc->sequence;\n1157\t\n1158\t                if (hlc->sequence_unack != UINT64_MAX) {\n1159\t                    ret = header_length_test_set_queue(cnx, hlc, hlc->sequence_unack, pc, pkt_ctx, simulated_time);\n1160\t                }\n1161\t            }\n1162\t        }\n1163\t    }\n1164\t\n1165\t    if (ret == 0) {\n1166\t        /* Compute the predicted length */\n1167\t        predicted_length = picoquic_predict_packet_header_length(cnx, hlc->ptype, pkt_ctx);\n1168\t        /* Reset the retransmit queue to simulate unack */\n1169\t        if (hlc->sequence_unack != hlc->sequence_unack_after) {\n1170\t            if (hlc->sequence_unack != UINT64_MAX) {\n1171\t                picoquic_dequeue_retransmit_packet(cnx, pkt_ctx, pkt_ctx->pending_first, 1, 0);\n1172\t            }\n1173\t            if (hlc->sequence_unack_after != UINT64_MAX) {\n1174\t                ret = header_length_test_set_queue(cnx, hlc, hlc->sequence_unack_after, pc, pkt_ctx, simulated_time);\n1175\t            }\n1176\t        }\n1177\t    }\n1178\t    if (ret == 0) {\n1179\t        /* Compute the header length */\n1180\t        header_length = picoquic_create_packet_header(cnx, hlc->ptype,\n1181\t            hlc->sequence, cnx->path[0], cnx->path[0]->first_tuple, predicted_length, buffer, &pn_offset, &pn_length);\n1182\t        /* Check the results */\n1183\t        if (header_length != predicted_length) {\n1184\t            DBG_PRINTF(\"Error, predicted header length %zu, actual %zu\", header_length, predicted_length);\n1185\t            ret = -1;\n1186\t        }\n1187\t        else if (pn_length == 0 || pn_length > 4) {\n1188\t            DBG_PRINTF(\"Error, invalid PN length %zu\", pn_length);\n1189\t            ret = -1;\n1190\t        }\n1191\t        else if (pn_length + pn_offset != header_length) {\n1192\t            DBG_PRINTF(\"Error, PN offset %zu + %zu != header_length %zu\", pn_offset, pn_length, header_length);\n1193\t            ret = -1;\n1194\t        }\n1195\t    }\n1196\t\n1197\t\n1198\t    if (quic != NULL) {\n1199\t        picoquic_free(quic);"}]},"parent_tool_use_id":null,"session_id":"4dc870de-e938-4c75-83bb-2bc85323ae97","uuid":"b8aa6abd-b1fc-46f9-870f-6c4666bb9f3e","timestamp":"2026-05-05T05:26:43.978Z","tool_use_result":{"type":"text","file":{"filePath":"/Users/richbarn/Projects/picoquic/picoquictest/parseheadertest.c","content":"\n    if (ret != 0) {\n        DBG_PRINTF(\"%s\", \"Cannot set the cert, key or store file names.\\n\");\n    }\n    else {\n        qclient = picoquic_create(8, NULL, NULL, NULL, NULL, NULL, NULL,\n            NULL, NULL, NULL, 0, NULL, NULL, NULL, 0);\n        qserver = picoquic_create(8,\n            test_server_cert_file, test_server_key_file, test_server_cert_store_file,\n            \"test\", NULL, NULL, NULL, NULL, NULL, 0, NULL, NULL, NULL, 0);\n        if (qclient == NULL || qserver == NULL) {\n            DBG_PRINTF(\"%s\", \"Could not create Quic contexts.\\n\");\n            ret = -1;\n        }\n    }\n\n    if (ret == 0) {\n        memset(&test_addr_c, 0, sizeof(struct sockaddr_in));\n        test_addr_c.sin_family = AF_INET;\n        memcpy(&test_addr_c.sin_addr, addr1, 4);\n        test_addr_c.sin_port = 12345;\n\n        cnx_client = picoquic_create_cnx(qclient, picoquic_null_connection_id, picoquic_null_connection_id,\n            (struct sockaddr*)&test_addr_c, 0, 0, NULL, PICOQUIC_TEST_ALPN, 1);\n        if (cnx_client == NULL) {\n            DBG_PRINTF(\"%s\", \"Could not create client connection context.\\n\");\n            ret = -1;\n        }\n        else {\n            ret = picoquic_start_client_cnx(cnx_client);\n        }\n    }\n\n    /* Test with a series of packets */\n    /* First, client initial */\n    if (ret == 0) {\n        ret = test_packet_encrypt_one(\n            (struct sockaddr *) &test_addr_c,\n            cnx_client, qserver, NULL, picoquic_packet_initial, 1256);\n    }\n    /* If that work, update the connection context */\n    if (ret == 0) {\n        cnx_server = qserver->cnx_list;\n        if (cnx_server == NULL) {\n            DBG_PRINTF(\"%s\", \"Did not create the server connection context.\\n\");\n            ret = -1;\n        } else {\n            /* Set the remote context ID for the client */\n            cnx_client->path[0]->first_tuple->p_remote_cnxid->cnx_id = cnx_server->path[0]->first_tuple->p_local_cnxid->cnx_id;\n        }\n    }\n\n    prefix_label = picoquic_supported_versions[cnx_client->version_index].tls_prefix_label;\n\n    /* Try handshake packet from client */\n    if (ret == 0) {\n        cnx_client->crypto_context[2].aead_encrypt = picoquic_setup_test_aead_context(1, test_handshake_secret, prefix_label);\n        cnx_server->crypto_context[2].aead_decrypt = picoquic_setup_test_aead_context(0, test_handshake_secret, prefix_label);\n        cnx_client->crypto_context[2].pn_enc = picoquic_pn_enc_create_for_test(test_handshake_secret, prefix_label);\n        cnx_server->crypto_context[2].pn_dec = picoquic_pn_enc_create_for_test(test_handshake_secret, prefix_label);\n        ret = test_packet_encrypt_one(\n            (struct sockaddr *) &test_addr_c,\n            cnx_client, qserver, cnx_server, picoquic_packet_handshake, 1256);\n    }\n\n    /* Now try a zero RTT packet */\n    if (ret == 0) {\n        cnx_client->crypto_context[1].aead_encrypt = picoquic_setup_test_aead_context(1, test_0rtt_secret, prefix_label);\n        cnx_server->crypto_context[1].aead_decrypt = picoquic_setup_test_aead_context(0, test_0rtt_secret, prefix_label);\n        cnx_client->crypto_context[1].pn_enc = picoquic_pn_enc_create_for_test(test_0rtt_secret, prefix_label);\n        cnx_server->crypto_context[1].pn_dec = picoquic_pn_enc_create_for_test(test_0rtt_secret, prefix_label);\n\n        /* Use a null connection ID to trigger use of initial ID */\n        cnx_client->path[0]->first_tuple->p_remote_cnxid->cnx_id = picoquic_null_connection_id;\n\n        ret = test_packet_encrypt_one(\n            (struct sockaddr *) &test_addr_c,\n            cnx_client, qserver, cnx_server, picoquic_packet_0rtt_protected, 256);\n\n\n        /* Set the remote context ID for the next test  */\n        cnx_client->path[0]->first_tuple->p_remote_cnxid->cnx_id = cnx_server->path[0]->first_tuple->p_local_cnxid->cnx_id;\n    }\n\n    /* And try a 1 RTT packet */\n    if (ret == 0) {\n        cnx_client->crypto_context[3].aead_encrypt = picoquic_setup_test_aead_context(1, test_1rtt_secret, prefix_label);\n        cnx_server->crypto_context[3].aead_decrypt = picoquic_setup_test_aead_context(0, test_1rtt_secret, prefix_label);\n        cnx_client->crypto_context[3].pn_enc = picoquic_pn_enc_create_for_test(test_1rtt_secret, prefix_label);\n        cnx_server->crypto_context[3].pn_dec = picoquic_pn_enc_create_for_test(test_1rtt_secret, prefix_label);\n\n        ret = test_packet_encrypt_one(\n            (struct sockaddr *) &test_addr_c,\n            cnx_client, qserver, cnx_server, picoquic_packet_1rtt_protected, 1024);\n    }\n\n    if (cnx_client != NULL) {\n        picoquic_delete_cnx(cnx_client);\n    }\n\n    if (qclient != NULL) {\n        picoquic_free(qclient);\n    }\n\n    if (qserver != NULL) {\n        picoquic_free(qserver);\n    }\n\n    return ret;\n}\n\n/* Tests of potentially challenging initial packets. \n * The test passes if the packet is accepted and the\n * connection is created.\n */\n\nint packet_initial_dec_one(\n    uint8_t* bytes,\n    size_t packet_length)\n{\n    int ret = 0;\n    struct sockaddr_in test_addr_c;\n    struct sockaddr_in test_addr_s;\n    picoquic_quic_t* qserver = NULL;\n    picoquic_cnx_t* new_cnx = NULL;\n    char test_server_cert_file[512];\n    char test_server_key_file[512];\n    char test_server_cert_store_file[512];\n\n    picoquic_set_test_address(&test_addr_c, 0xabcd, 12345);\n    picoquic_set_test_address(&test_addr_s, 0xa001, 443);\n\n    ret = picoquic_get_input_path(test_server_cert_file, sizeof(test_server_cert_file), picoquic_solution_dir, PICOQUIC_TEST_FILE_SERVER_CERT);\n\n    if (ret == 0) {\n        ret = picoquic_get_input_path(test_server_key_file, sizeof(test_server_key_file), picoquic_solution_dir, PICOQUIC_TEST_FILE_SERVER_KEY);\n    }\n\n    if (ret == 0) {\n        ret = picoquic_get_input_path(test_server_cert_store_file, sizeof(test_server_cert_store_file), picoquic_solution_dir, PICOQUIC_TEST_FILE_CERT_STORE);\n    }\n\n    if (ret != 0) {\n        DBG_PRINTF(\"%s\", \"Cannot set the cert, key or store file names.\\n\");\n    }\n    else {\n        qserver = picoquic_create(8,\n            test_server_cert_file, test_server_key_file, test_server_cert_store_file,\n            \"h3\", NULL, NULL, NULL, NULL, NULL, 0, NULL, NULL, NULL, 0);\n        if (qserver == NULL) {\n            DBG_PRINTF(\"%s\", \"Could not create Quic context.\\n\");\n            ret = -1;\n        }\n    }\n\n    if (ret == 0) {\n        ret = picoquic_incoming_packet_ex(qserver, bytes, packet_length,\n            (struct sockaddr*)&test_addr_c, (struct sockaddr*)&test_addr_s, 0,\n            0, &new_cnx, 0);\n        if (ret != 0) {\n            DBG_PRINTF(\"Incoming returns ret=0x%x\", ret);\n        }\n        else if (new_cnx == NULL) {\n            ret = -1;\n            DBG_PRINTF(\"No connection created ret=0x%x\", ret);\n        }\n    }\n\n    if (qserver != NULL) {\n        picoquic_free(qserver);\n    }\n\n    return ret;\n}\n\nint incoming_initial_test(void)\n{\n    int ret = packet_initial_dec_one(packet_intel_bug, sizeof(packet_intel_bug));\n\n    return ret;\n}\n\n/* Header length test. verify that the header length prediction\n * matches the actual length of the encoding.\n * Loop through a set of variables: state of connection, type of packet,\n * sequence number, last packet not acknowledged.\n */\n\ntypedef struct st_header_length_case_t {\n    int is_client;\n    int i_cid_length;\n    int local_cid_length;\n    int remote_cid_length;\n    picoquic_packet_type_enum ptype;\n    uint64_t sequence;\n    uint64_t sequence_unack;\n    uint64_t sequence_unack_after;\n} header_length_case_t;\n\nstatic header_length_case_t header_length_case[] = {\n    { 0, 8, 8, 8, picoquic_packet_initial, 0, UINT64_MAX, UINT64_MAX },\n    { 0, 8, 8, 16, picoquic_packet_initial, 0, UINT64_MAX, UINT64_MAX },\n    { 0, 16, 8, 4, picoquic_packet_initial, 0, UINT64_MAX, UINT64_MAX },\n    { 0, 16, 8, 0, picoquic_packet_initial, 0, UINT64_MAX, UINT64_MAX },\n    { 0, 16, 0, 0, picoquic_packet_initial, 0, UINT64_MAX, UINT64_MAX },\n    { 0, 8, 8, 8, picoquic_packet_handshake, 0, UINT64_MAX, UINT64_MAX },\n    { 0, 8, 8, 16, picoquic_packet_handshake, 0, UINT64_MAX, UINT64_MAX },\n    { 0, 16, 8, 4, picoquic_packet_handshake, 0, UINT64_MAX, UINT64_MAX },\n    { 0, 16, 8, 0, picoquic_packet_handshake, 0, UINT64_MAX, UINT64_MAX },\n    { 0, 16, 0, 0, picoquic_packet_handshake, 0, UINT64_MAX, UINT64_MAX },\n    { 0, 8, 8, 8, picoquic_packet_1rtt_protected, 0, UINT64_MAX, UINT64_MAX },\n    { 0, 8, 8, 16, picoquic_packet_1rtt_protected, 0, UINT64_MAX, UINT64_MAX },\n    { 0, 16, 8, 4, picoquic_packet_1rtt_protected, 0, UINT64_MAX, UINT64_MAX },\n    { 0, 16, 8, 0, picoquic_packet_1rtt_protected, 0, UINT64_MAX, UINT64_MAX },\n    { 0, 16, 0, 0, picoquic_packet_1rtt_protected, 0, UINT64_MAX, UINT64_MAX },\n    { 0, 8, 0, 0, picoquic_packet_1rtt_protected, 0, UINT64_MAX, UINT64_MAX },\n    { 0, 16, 8, 4, picoquic_packet_1rtt_protected, 63, UINT64_MAX, UINT64_MAX },\n    { 0, 16, 8, 4, picoquic_packet_1rtt_protected, 64, UINT64_MAX, UINT64_MAX },\n    { 0, 16, 8, 4, picoquic_packet_1rtt_protected, 255, UINT64_MAX, UINT64_MAX },\n    { 0, 16, 8, 4, picoquic_packet_1rtt_protected, 0xffff, UINT64_MAX, UINT64_MAX },\n    { 0, 16, 8, 4, picoquic_packet_1rtt_protected, 0xffffff, UINT64_MAX, UINT64_MAX },\n    { 0, 16, 8, 4, picoquic_packet_1rtt_protected, 0xffffffff, UINT64_MAX, UINT64_MAX },\n    { 0, 16, 8, 4, picoquic_packet_1rtt_protected, 0xffffffffffull, UINT64_MAX, UINT64_MAX },\n    { 0, 16, 8, 4, picoquic_packet_1rtt_protected, 0xffffffff, 0xffffff00, 0xfffffffe },\n    { 0, 16, 8, 4, picoquic_packet_1rtt_protected, 0xffffffff, 0xffffff00, UINT64_MAX },\n    { 0, 16, 8, 4, picoquic_packet_handshake, 0xffffffff, 0xffffff00, 0xfffffffe },\n    { 0, 16, 8, 4, picoquic_packet_handshake, 0xffffffff, 0xffffff00, UINT64_MAX },\n    { 0, 16, 8, 4, picoquic_packet_initial, 0xffffffff, 0xffffff00, 0xfffffffe },\n    { 0, 16, 8, 4, picoquic_packet_initial, 0xffffffff, 0xffffff00, UINT64_MAX },\n    { 1, 8, 8, 8, picoquic_packet_initial, 0, UINT64_MAX, UINT64_MAX },\n    { 1, 8, 8, 16, picoquic_packet_initial, 0, UINT64_MAX, UINT64_MAX },\n    { 1, 16, 8, 4, picoquic_packet_initial, 0, UINT64_MAX, UINT64_MAX },\n    { 1, 16, 8, 0, picoquic_packet_initial, 0, UINT64_MAX, UINT64_MAX },\n    { 1, 16, 0, 0, picoquic_packet_initial, 0, UINT64_MAX, UINT64_MAX },\n    { 1, 8, 8, 8, picoquic_packet_0rtt_protected, 0, UINT64_MAX, UINT64_MAX },\n    { 1, 8, 8, 16, picoquic_packet_0rtt_protected, 0, UINT64_MAX, UINT64_MAX },\n    { 1, 16, 8, 4, picoquic_packet_0rtt_protected, 0, UINT64_MAX, UINT64_MAX },\n    { 1, 16, 8, 0, picoquic_packet_0rtt_protected, 0, UINT64_MAX, UINT64_MAX },\n    { 1, 16, 0, 0, picoquic_packet_0rtt_protected, 0, UINT64_MAX, UINT64_MAX },\n    { 1, 8, 8, 8, picoquic_packet_handshake, 0, UINT64_MAX, UINT64_MAX },\n    { 1, 8, 8, 16, picoquic_packet_handshake, 0, UINT64_MAX, UINT64_MAX },\n    { 1, 16, 8, 4, picoquic_packet_handshake, 0, UINT64_MAX, UINT64_MAX },\n    { 1, 16, 8, 0, picoquic_packet_handshake, 0, UINT64_MAX, UINT64_MAX },\n    { 1, 16, 0, 0, picoquic_packet_handshake, 0, UINT64_MAX, UINT64_MAX },\n    { 1, 16, 8, 4, picoquic_packet_handshake, 0xffffffff, 0xffffff00, 0xfffffffe },\n    { 1, 16, 8, 4, picoquic_packet_handshake, 0xffffffff, 0xffffff00, UINT64_MAX },\n    { 1, 16, 8, 4, picoquic_packet_initial, 0xffffffff, 0xffffff00, 0xfffffffe },\n    { 1, 16, 8, 4, picoquic_packet_initial, 0xffffffff, 0xffffff00, UINT64_MAX },\n    { 1, 8, 8, 8, picoquic_packet_1rtt_protected, 0, UINT64_MAX, UINT64_MAX },\n    { 1, 16, 8, 4, picoquic_packet_1rtt_protected, 255, UINT64_MAX, UINT64_MAX },\n    { 1, 16, 8, 4, picoquic_packet_1rtt_protected, 0xffff, UINT64_MAX, UINT64_MAX },\n    { 1, 16, 8, 4, picoquic_packet_1rtt_protected, 0xffffff, UINT64_MAX, UINT64_MAX },\n    { 1, 16, 8, 4, picoquic_packet_1rtt_protected, 0xffffffff, UINT64_MAX, UINT64_MAX },\n    { 1, 16, 8, 4, picoquic_packet_1rtt_protected, 0xffffffffffull, UINT64_MAX, UINT64_MAX },\n    { 1, 16, 8, 4, picoquic_packet_1rtt_protected, 0xffffffff, 0xffffff00, 0xfffffffe },\n    { 1, 16, 8, 4, picoquic_packet_1rtt_protected, 0xffffffff, 0xffffff00, UINT64_MAX }\n};\n\nstatic size_t nb_header_length_cases = sizeof(header_length_case) / sizeof(header_length_case_t);\n\nstatic int header_length_test_set_queue(picoquic_cnx_t* cnx, header_length_case_t* hlc,\n    uint64_t unack, picoquic_packet_context_enum pc, picoquic_packet_context_t* pkt_ctx, uint64_t simulated_time)\n{\n    int ret = 0;\n    pkt_ctx->send_sequence = hlc->sequence;\n\n    if (unack != UINT64_MAX) {\n        picoquic_packet_t* packet = picoquic_create_packet(cnx->quic);\n        if (packet == NULL) {\n            ret = -1;\n        }\n        else {\n            packet->ptype = hlc->ptype;\n            packet->sequence_number = unack;\n            packet->length = PICOQUIC_MAX_PACKET_SIZE;\n            packet->pc = pc;\n            picoquic_queue_for_retransmit(cnx, cnx->path[0], packet, packet->length, simulated_time);\n        }\n    }\n    return ret;\n}\n\nstatic int header_length_test_one(header_length_case_t * hlc)\n{\n    int ret = 0;\n    char test_server_cert_file[512];\n    char test_server_key_file[512];\n    char test_server_cert_store_file[512];\n    uint64_t simulated_time = 0;\n    picoquic_quic_t* quic = NULL;\n    picoquic_cnx_t* cnx = NULL;\n    picoquic_connection_id_t i_cid;\n    picoquic_connection_id_t r_cid;\n    struct sockaddr_in addr_to;\n    picoquic_packet_context_enum pc = 0;\n    picoquic_packet_context_t* pkt_ctx = NULL;\n    size_t predicted_length = 0;\n    size_t header_length = 0;\n    size_t pn_offset;\n    size_t pn_length;\n    uint8_t buffer[PICOQUIC_MAX_PACKET_SIZE];\n\n    /* Create the remote address */\n    picoquic_set_test_address(&addr_to, 0xabcd, 12345);\n    /* Set cid to required value */\n    memset(i_cid.id, 0x11, 20);\n    memset(r_cid.id, 0xdd, 20);\n    i_cid.id_len = hlc->i_cid_length;\n    r_cid.id_len = hlc->remote_cid_length;\n\n    /* Create the quic context */\n    ret = picoquic_get_input_path(test_server_cert_file, sizeof(test_server_cert_file), picoquic_solution_dir, PICOQUIC_TEST_FILE_SERVER_CERT);\n    if (ret == 0) {\n        ret = picoquic_get_input_path(test_server_key_file, sizeof(test_server_key_file), picoquic_solution_dir, PICOQUIC_TEST_FILE_SERVER_KEY);\n    }\n    if (ret == 0) {\n        ret = picoquic_get_input_path(test_server_cert_store_file, sizeof(test_server_cert_store_file), picoquic_solution_dir, PICOQUIC_TEST_FILE_CERT_STORE);\n    }\n    if (ret != 0) {\n        DBG_PRINTF(\"%s\", \"Cannot set the cert, key or store file names.\\n\");\n    }\n    else {\n        quic = picoquic_create(8,\n            test_server_cert_file, test_server_key_file, test_server_cert_store_file,\n            \"h3\", NULL, NULL, NULL, NULL, NULL, 0, &simulated_time, NULL, NULL, 0);\n        if (quic == NULL) {\n            DBG_PRINTF(\"%s\", \"Could not create Quic context.\\n\");\n            ret = -1;\n        }\n        else {\n            quic->local_cnxid_length = hlc->local_cid_length;\n        }\n    }\n\n    /* Create a connection with desired characteristics */\n    if (ret == 0) {\n        cnx = picoquic_create_cnx(quic, i_cid, r_cid, (struct sockaddr*)&addr_to, 0, 0, \"test\", \"h3\", hlc->is_client);\n        if (cnx == NULL) {\n            ret = -1;\n        }\n        else {\n            /* Find the required packet context and initialize the sequence and retransmit or retransmitted queue */\n            /* TODO: add option for trying packet type retry */\n            if (hlc->ptype == picoquic_packet_initial) {\n                pc = picoquic_packet_context_initial;\n                pkt_ctx = &cnx->pkt_ctx[picoquic_packet_context_initial];\n            }\n            else if (hlc->ptype == picoquic_packet_handshake) {\n                pc = picoquic_packet_context_handshake;\n                pkt_ctx = &cnx->pkt_ctx[picoquic_packet_context_handshake];\n            }\n            else if (hlc->ptype == picoquic_packet_0rtt_protected || hlc->ptype == picoquic_packet_1rtt_protected) {\n                pc = picoquic_packet_context_application;\n                pkt_ctx = &cnx->pkt_ctx[picoquic_packet_context_application];\n            }\n            if (pkt_ctx != NULL) {\n                pkt_ctx->send_sequence = hlc->sequence;\n\n                if (hlc->sequence_unack != UINT64_MAX) {\n                    ret = header_length_test_set_queue(cnx, hlc, hlc->sequence_unack, pc, pkt_ctx, simulated_time);\n                }\n            }\n        }\n    }\n\n    if (ret == 0) {\n        /* Compute the predicted length */\n        predicted_length = picoquic_predict_packet_header_length(cnx, hlc->ptype, pkt_ctx);\n        /* Reset the retransmit queue to simulate unack */\n        if (hlc->sequence_unack != hlc->sequence_unack_after) {\n            if (hlc->sequence_unack != UINT64_MAX) {\n                picoquic_dequeue_retransmit_packet(cnx, pkt_ctx, pkt_ctx->pending_first, 1, 0);\n            }\n            if (hlc->sequence_unack_after != UINT64_MAX) {\n                ret = header_length_test_set_queue(cnx, hlc, hlc->sequence_unack_after, pc, pkt_ctx, simulated_time);\n            }\n        }\n    }\n    if (ret == 0) {\n        /* Compute the header length */\n        header_length = picoquic_create_packet_header(cnx, hlc->ptype,\n            hlc->sequence, cnx->path[0], cnx->path[0]->first_tuple, predicted_length, buffer, &pn_offset, &pn_length);\n        /* Check the results */\n        if (header_length != predicted_length) {\n            DBG_PRINTF(\"Error, predicted header length %zu, actual %zu\", header_length, predicted_length);\n            ret = -1;\n        }\n        else if (pn_length == 0 || pn_length > 4) {\n            DBG_PRINTF(\"Error, invalid PN length %zu\", pn_length);\n            ret = -1;\n        }\n        else if (pn_length + pn_offset != header_length) {\n            DBG_PRINTF(\"Error, PN offset %zu + %zu != header_length %zu\", pn_offset, pn_length, header_length);\n            ret = -1;\n        }\n    }\n\n\n    if (quic != NULL) {\n        picoquic_free(quic);","numLines":400,"startLine":800,"totalLines":1217}}}
