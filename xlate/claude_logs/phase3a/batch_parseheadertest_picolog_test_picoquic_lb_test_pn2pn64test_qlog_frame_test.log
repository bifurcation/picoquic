entries[i].ph->pc) {\n539\t            ret = -1;\n540\t        } else if (ph.key_phase != test_entries[i].ph->key_phase) {\n541\t            ret = -1;\n542\t        }\n543\t    }\n544\t\n545\t    if (ret == 0) {\n546\t        quic->local_cnxid_length = 8;\n547\t    }\n548\t\n549\t    for (size_t i = 0; ret == 0 && i < nb_test_entries; i++) {\n550\t        size_t header_length;\n551\t        size_t pn_offset;\n552\t        size_t pn_length;\n553\t\n554\t        if (test_entries[i].decode_test_only) {\n555\t            continue;\n556\t        }\n557\t\n558\t        pcnx = (i < 3) ? NULL : cnx_10;\n559\t        memset(packet, 0xcc, sizeof(packet));\n560\t        /* Prepare the header inside the packet */\n561\t        if (i < 2) {\n562\t            cnx_10->path[0]->first_tuple->p_remote_cnxid->cnx_id = picoquic_null_connection_id;\n563\t        }\n564\t        else {\n565\t            cnx_10->path[0]->first_tuple->p_remote_cnxid->cnx_id = test_cnxid_r10;\n566\t        }\n567\t        header_length = picoquic_create_packet_header(cnx_10, test_entries[i].ph->ptype,\n568\t            test_entries[i].ph->pn, cnx_10->path[0], cnx_10->path[0]->first_tuple, 0, packet, &pn_offset, &pn_length);\n569\t        picoquic_update_payload_length(packet, pn_offset, pn_offset, pn_offset +\n570\t            test_entries[i].ph->payload_length);\n571\t        \n572\t        if ( pn_offset != test_entries[i].ph->pn_offset) {\n573\t           ret = -1;\n574\t        }\n575\t        \n576\t        if (memcmp(packet, test_entries[i].packet, header_length) != 0)\n577\t        {\n578\t            ret = -1;\n579\t        }\n580\t    }\n581\t\n582\t    if (quic != NULL) {\n583\t        picoquic_free(quic);\n584\t    }\n585\t\n586\t    return ret;\n587\t}\n588\t\n589\t\n590\t/* Test a range of variations of packet encryption and decryption */\n591\tint test_packet_decrypt_one(\n592\t    picoquic_quic_t* q_server,\n593\t    uint8_t * send_buffer,\n594\t    size_t send_length,\n595\t    size_t packet_length,\n596\t    struct sockaddr * addr_from,\n597\t    picoquic_cnx_t* cnx_target,\n598\t    picoquic_packet_header * expected_ph,\n599\t    int expected_return\n600\t)\n601\t{\n602\t    int ret = 0;\n603\t    int decoding_return;\n604\t    uint64_t current_time = 0;\n605\t    picoquic_packet_header received_ph;\n606\t    picoquic_cnx_t* server_cnx = NULL;\n607\t    size_t consumed = 0;\n608\t    int new_context_created = 0;\n609\t    uint64_t simulated_time = 0;\n610\t    picoquic_stream_data_node_t* decrypted_data = NULL;\n611\t    picoquic_quic_t* quic = picoquic_create(8, NULL, NULL, NULL, NULL, NULL,\n612\t        NULL, NULL, NULL, NULL, simulated_time,\n613\t        &simulated_time, NULL, NULL, 0);\n614\t\n615\t    if (quic == NULL) {\n616\t        ret = -1;\n617\t    }\n618\t    else {\n619\t        decrypted_data = picoquic_stream_data_node_alloc(quic);\n620\t        if (decrypted_data == NULL) {\n621\t            ret = -1;\n622\t        }\n623\t    }\n624\t\n625\t    /* Decrypt the packet */\n626\t    decoding_return = picoquic_parse_header_and_decrypt(q_server,\n627\t        send_buffer, send_length, packet_length,\n628\t        addr_from,\n629\t        current_time,\n630\t        decrypted_data,\n631\t        &received_ph, &server_cnx,\n632\t        &consumed, &new_context_created);\n633\t\n634\t    /* verify that decryption matches original value */\n635\t    if (decoding_return != expected_return) {\n636\t        DBG_PRINTF(\"Return %x instead of %x.\\n\", decoding_return, expected_return);\n637\t        ret = -1;\n638\t    } else if (cnx_target != NULL && server_cnx != cnx_target) {\n639\t        DBG_PRINTF(\"%s\", \"Could not retrieve the connection\\n\");\n640\t        ret = -1;\n641\t    }\n642\t    else if (received_ph.ptype != expected_ph->ptype) {\n643\t        DBG_PRINTF(\"PTYPE %x instead of %x.\\n\", received_ph.ptype, expected_ph->ptype);\n644\t        ret = -1;\n645\t    }\n646\t    else if (received_ph.offset != expected_ph->offset) {\n6