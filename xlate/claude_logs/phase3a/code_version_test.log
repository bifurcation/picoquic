{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01Ah1DcVpE6AFvYjH2ZaEHaU","type":"tool_result","content":"1\t/*\n2\t* Author: Christian Huitema\n3\t* Copyright (c) 2023, Private Octopus, Inc.\n4\t* All rights reserved.\n5\t*\n6\t* Permission to use, copy, modify, and distribute this software for any\n7\t* purpose with or without fee is hereby granted, provided that the above\n8\t* copyright notice and this permission notice appear in all copies.\n9\t*\n10\t* THIS SOFTWARE IS PROVIDED BY THE COPYRIGHT HOLDERS AND CONTRIBUTORS \"AS IS\" AND\n11\t* ANY EXPRESS OR IMPLIED WARRANTIES, INCLUDING, BUT NOT LIMITED TO, THE IMPLIED\n12\t* WARRANTIES OF MERCHANTABILITY AND FITNESS FOR A PARTICULAR PURPOSE ARE\n13\t* DISCLAIMED. IN NO EVENT SHALL Private Octopus, Inc. BE LIABLE FOR ANY\n14\t* DIRECT, INDIRECT, INCIDENTAL, SPECIAL, EXEMPLARY, OR CONSEQUENTIAL DAMAGES\n15\t* (INCLUDING, BUT NOT LIMITED TO, PROCUREMENT OF SUBSTITUTE GOODS OR SERVICES;\n16\t* LOSS OF USE, DATA, OR PROFITS; OR BUSINESS INTERRUPTION) HOWEVER CAUSED AND\n17\t* ON ANY THEORY OF LIABILITY, WHETHER IN CONTRACT, STRICT LIABILITY, OR TORT\n18\t* (INCLUDING NEGLIGENCE OR OTHERWISE) ARISING IN ANY WAY OUT OF THE USE OF THIS\n19\t* SOFTWARE, EVEN IF ADVISED OF THE POSSIBILITY OF SUCH DAMAGE.\n20\t*/\n21\t\n22\t#include <string.h>\n23\t#include \"picoquic.h\"\n24\t#include \"picoquic_utils.h\"\n25\t\n26\tstatic char* skip_blank(char* line)\n27\t{\n28\t    char* x = line;\n29\t    while (*x != 0 && (*x == ' ' || *x == '\\t')) {\n30\t        x++;\n31\t    }\n32\t    return(x);\n33\t}\n34\t\n35\tstatic int starts_with(char* line, const char* text, size_t text_len, size_t* offset)\n36\t{\n37\t    int ret = -1;\n38\t    char* x = skip_blank(line);\n39\t\n40\t    if (x != NULL && strlen(x) >= text_len && memcmp(x, text, text_len) == 0) {\n41\t        ret = 0;\n42\t        *offset = (x - line);\n43\t    }\n44\t\n45\t    return(ret);\n46\t}\n47\t\n48\tint code_version_test(void)\n49\t{\n50\t    char cmake_file[512];\n51\t    int ret = picoquic_get_input_path(cmake_file, sizeof(cmake_file), picoquic_solution_dir, \"CMakeLists.txt\");\n52\t\n53\t    if (ret >= 0) {\n54\t        int last_err = 0;\n55\t        FILE* F = picoquic_file_open_ex(cmake_file, \"r\", &last_err);\n56\t\n57\t        ret = -1; /* will be set to zero if successful */\n58\t\n59\t        if (F == NULL) {\n60\t            DBG_PRINTF(\"Cannot open <%s> error %d(0x%x)\", cmake_file, last_err, last_err);\n61\t        }\n62\t        else {\n63\t            char line[512];\n64\t            char const* project = \"project(picoquic\";\n65\t            size_t project_len = strlen(project);\n66\t            char const* version = \"VERSION\";\n67\t            size_t version_len = strlen(version);\n68\t\n69\t            size_t offset;\n70\t\n71\t            while (fgets(line, sizeof(line), F) != NULL) {\n72\t                /* find line that include \"project(picoquic\" */\n73\t                if (starts_with(line, project, project_len, &offset) == 0) {\n74\t                    /* get next line, which should include <space>VERSION<space>x.y.z.t */\n75\t                    if (fgets(line, sizeof(line), F) != NULL &&\n76\t                        starts_with(line, version, version_len, &offset) == 0) {\n77\t                        char* x = skip_blank(&line[offset + version_len]);\n78\t                        size_t x_len = strlen(x);\n79\t                        const char* v = PICOQUIC_VERSION;\n80\t                        size_t v_len = strlen(v);\n81\t                        if (x_len >= v_len && memcmp(x, v, v_len) == 0) {\n82\t                            char* y = x + v_len;\n83\t                            if (*y == ' ' || *y == '\\t' || *y == '\\r' || *y == '\\n') {\n84\t                                ret = 0;\n85\t                            }\n86\t                        }\n87\t                    }\n88\t                    /* Extract the version string. */\n89\t                    /* compare to version in picoquic.h */\n90\t                    break;\n91\t                }\n92\t            }\n93\t        }\n94\t    }\n95\t\n96\t    return ret;\n97\t}\n98\t"}]},"parent_tool_use_id":null,"session_id":"32591064-9639-4381-9e05-bc6e424efeca","uuid":"ff53896d-a3fd-4952-a1bb-23cd2bfb7b6e","timestamp":"2026-05-04T22:38:28.091Z","tool_use_result":{"type":"text","file":{"filePath":"/Users/richbarn/Projects/picoquic/picoquictest/code_version_test.c","content":"/*\n* Author: Christian Huitema\n* Copyright (c) 2023, Private Octopus, Inc.\n* All rights reserved.\n*\n* Permission to use, copy, modify, and distribute this software for any\n* purpose with or without fee is hereby granted, provided that the above\n* copyright notice and this permission notice appear in all copies.\n*\n* THIS SOFTWARE IS PROVIDED BY THE COPYRIGHT HOLDERS AND CONTRIBUTORS \"AS IS\" AND\n* ANY EXPRESS OR IMPLIED WARRANTIES, INCLUDING, BUT NOT LIMITED TO, THE IMPLIED\n* WARRANTIES OF MERCHANTABILITY AND FITNESS FOR A PARTICULAR PURPOSE ARE\n* DISCLAIMED. IN NO EVENT SHALL Private Octopus, Inc. BE LIABLE FOR ANY\n* DIRECT, INDIRECT, INCIDENTAL, SPECIAL, EXEMPLARY, OR CONSEQUENTIAL DAMAGES\n* (INCLUDING, BUT NOT LIMITED TO, PROCUREMENT OF SUBSTITUTE GOODS OR SERVICES;\n* LOSS OF USE, DATA, OR PROFITS; OR BUSINESS INTERRUPTION) HOWEVER CAUSED AND\n* ON ANY THEORY OF LIABILITY, WHETHER IN CONTRACT, STRICT LIABILITY, OR TORT\n* (INCLUDING NEGLIGENCE OR OTHERWISE) ARISING IN ANY WAY OUT OF THE USE OF THIS\n* SOFTWARE, EVEN IF ADVISED OF THE POSSIBILITY OF SUCH DAMAGE.\n*/\n\n#include <string.h>\n#include \"picoquic.h\"\n#include \"picoquic_utils.h\"\n\nstatic char* skip_blank(char* line)\n{\n    char* x = line;\n    while (*x != 0 && (*x == ' ' || *x == '\\t')) {\n        x++;\n    }\n    return(x);\n}\n\nstatic int starts_with(char* line, const char* text, size_t text_len, size_t* offset)\n{\n    int ret = -1;\n    char* x = skip_blank(line);\n\n    if (x != NULL && strlen(x) >= text_len && memcmp(x, text, text_len) == 0) {\n        ret = 0;\n        *offset = (x - line);\n    }\n\n    return(ret);\n}\n\nint code_version_test(void)\n{\n    char cmake_file[512];\n    int ret = picoquic_get_input_path(cmake_file, sizeof(cmake_file), picoquic_solution_dir, \"CMakeLists.txt\");\n\n    if (ret >= 0) {\n        int last_err = 0;\n        FILE* F = picoquic_file_open_ex(cmake_file, \"r\", &last_err);\n\n        ret = -1; /* will be set to zero if successful */\n\n        if (F == NULL) {\n            DBG_PRINTF(\"Cannot open <%s> error %d(0x%x)\", cmake_file, last_err, last_err);\n        }\n        else {\n            char line[512];\n            char const* project = \"project(picoquic\";\n            size_t project_len = strlen(project);\n            char const* version = \"VERSION\";\n            size_t version_len = strlen(version);\n\n            size_t offset;\n\n            while (fgets(line, sizeof(line), F) != NULL) {\n                /* find line that include \"project(picoquic\" */\n                if (starts_with(line, project, project_len, &offset) == 0) {\n                    /* get next line, which should include <space>VERSION<space>x.y.z.t */\n                    if (fgets(line, sizeof(line), F) != NULL &&\n                        starts_with(line, version, version_len, &offset) == 0) {\n                        char* x = skip_blank(&line[offset + version_len]);\n                        size_t x_len = strlen(x);\n                        const char* v = PICOQUIC_VERSION;\n                        size_t v_len = strlen(v);\n                        if (x_len >= v_len && memcmp(x, v, v_len) == 0) {\n                            char* y = x + v_len;\n                            if (*y == ' ' || *y == '\\t' || *y == '\\r' || *y == '\\n') {\n                                ret = 0;\n                            }\n                        }\n                    }\n                    /* Extract the version string. */\n                    /* compare to version in picoquic.h */\n                    break;\n                }\n            }\n        }\n    }\n\n    return ret;\n}\n","numLines":98,"startLine":1,"totalLines":98}}}
