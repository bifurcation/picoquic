{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01EZ8bSsii2L6R9b5sJrr9sw","type":"tool_result","content":"10000\t\n10001\t    picoquic_init_transport_parameters(&server_parameters);\n10002\t\n10003\t    /* Create an alternate IP address, and use it as preferred address */\n10004\t    server_parameters.preferred_address.is_defined = 1;\n10005\t    memcpy(server_parameters.preferred_address.ipv4Address, &server_preferred.sin_addr, 4);\n10006\t    /* The preferred address TP carries the port in \"host\" order. */\n10007\t    server_parameters.preferred_address.ipv4Port = ntohs(server_preferred.sin_port);\n10008\t    server_parameters.migration_disabled = migration_disabled;\n10009\t\n10010\t    ret = tls_api_one_scenario_init_ex(&test_ctx, &simulated_time, PICOQUIC_INTERNAL_TEST_VERSION_1,\n10011\t        NULL, &server_parameters, NULL);\n10012\t\n10013\t\n10014\t    if (ret == 0) {\n10015\t        /* Run a basic test scenario */\n10016\t\n10017\t        ret = tls_api_one_scenario_body(test_ctx, &simulated_time,\n10018\t            test_scenario_very_long, sizeof(test_scenario_very_long), 0, 0, 0, 0, 1500000);\n10019\t    }\n10020\t\n10021\t    /* Verify that the client and server have both migrated to using the preferred address */\n10022\t    if (ret == 0 && picoquic_compare_addr((struct sockaddr*)&server_preferred,\n10023\t        (struct sockaddr*)&test_ctx->cnx_client->path[0]->first_tuple->peer_addr) != 0) {\n10024\t        DBG_PRINTF(\"%s\", \"Server address at client not updated\\n\");\n10025\t        ret = -1;\n10026\t    }\n10027\t\n10028\t    if (ret == 0 && test_ctx->cnx_server != NULL &&\n10029\t        picoquic_compare_addr((struct sockaddr*)&server_preferred,\n10030\t        (struct sockaddr*)&test_ctx->cnx_server->path[0]->first_tuple->local_addr) != 0) {\n10031\t        DBG_PRINTF(\"%s\", \"Server address not promoted\\n\");\n10032\t        ret = -1;\n10033\t    }\n10034\t\n10035\t    /* verify that both have migrated to a new CID */\n10036\t    if (ret == 0 && !cid_zero && \n10037\t        (test_ctx->cnx_client->path[0]->first_tuple->p_local_cnxid == NULL || \n10038\t            test_ctx->cnx_client->path[0]->first_tuple->p_local_cnxid->sequence == 0)){\n10039\t        DBG_PRINTF(\"%s\", \"Client CID not updated\\n\");\n10040\t        ret = -1;\n10041\t    }\n10042\t\n10043\t    if (ret == 0 && test_ctx->cnx_server != NULL &&\n10044\t        (test_ctx->cnx_server->path[0]->first_tuple->p_local_cnxid == NULL ||\n10045\t            test_ctx->cnx_server->path[0]->first_tuple->p_local_cnxid->sequence == 0)) {\n10046\t        DBG_PRINTF(\"%s\", \"Server CID not updated\\n\");\n10047\t        ret = -1;\n10048\t    }\n10049\t\n10050\t    /* verify that migrations are now authorized */\n10051\t    if (ret == 0 && test_ctx->cnx_server != NULL && test_ctx->cnx_client->remote_parameters.migration_disabled) {\n10052\t        DBG_PRINTF(\"%s\", \"Migration blocked on client\\n\");\n10053\t        ret = -1;\n10054\t    }\n10055\t\n10056\t    if (ret == 0 && test_ctx->cnx_server != NULL && test_ctx->cnx_server->local_parameters.migration_disabled) {\n10057\t        DBG_PRINTF(\"%s\", \"Migration blocked on server\\n\");\n10058\t        ret = -1;\n10059\t    }\n10060\t\n10061\t    /* And then free the resource\n10062\t     */\n10063\t\n10064\t    if (test_ctx != NULL) {\n10065\t        tls_api_delete_ctx(test_ctx);\n10066\t        test_ctx = NULL;\n10067\t    }\n10068\t\n10069\t    return ret;\n10070\t}\n10071\t\n10072\tint preferred_address_test(void)\n10073\t{\n10074\t    return preferred_address_test_one(0, 0);\n10075\t}\n10076\t\n10077\tint preferred_address_dis_mig_test(void)\n10078\t{\n10079\t    return preferred_address_test_one(1, 0);\n10080\t}\n10081\t\n10082\tint preferred_address_zero_test(void)\n10083\t{\n10084\t    /* test with zero length client cid */\n10085\t    return preferred_address_test_one(0, 1);\n10086\t}\n10087\t\n10088\t/* Test that the random public generation behaves in expected ways */\n10089\tint random_public_tester_test(void)\n10090\t{\n10091\t#define RANDOM_PUBLIC_TEST_CONST 11\n10092\t#define RANDOM_PUBLIC_TEST_ROUNDS 100\n10093\t#define RANDOM_PUBLIC_CHI_SQUARE 18.31 /* Fail if significance of bias < P = 0.05 */\n10094\t    int ret = 0;\n10095\t    int r_count[RANDOM_PUBLIC_TEST_CONST];\n10096\t\n10097\t    picoquic_public_random_seed_64(RANDOM_PUBLIC_TEST_SEED, 1);\n10098\t\n10099\t    memset(r_count, 0, sizeof(r_count));\n10100\t\n10101\t    for (int i = 0; i < RANDOM_PUBLIC_TEST_CONST*RANDOM_PUBLIC_TEST_ROUNDS; i++) {\n10102\t        uint64_t x = picoquic_public_uniform_random(RANDOM_PUBLIC_TEST_CONST);\n10103\t\n10104\t        if (x >= RANDOM_PUBLIC_TEST_CONST) {\n10105\t            DBG_PRINTF(\"Value %d >= %d\\n\", x, RANDOM_PUBLIC_TEST_CONST);\n10106\t            ret = -1;\n10107\t            break;\n10108\t        }\n10109\t        else {\n10110\t            r_count[x] += 1;\n10111\t        }\n10112\t    }\n10113\t\n10114\t    if (ret == 0) {\n10115\t        double chi_squared = 0;\n10116\t\n10117\t        for (int i = 0; i < RANDOM_PUBLIC_TEST_CONST; i++) {\n10118\t            double delta = ((double)RANDOM_PUBLIC_TEST_ROUNDS - r_count[i]);\n10119\t            double d2 = delta * delta;\n10120\t            d2 /= ((double)RANDOM_PUBLIC_TEST_ROUNDS);\n10121\t            chi_squared += d2;\n10122\t        }\n10123\t\n10124\t        if (chi_squared > RANDOM_PUBLIC_CHI_SQUARE) {\n10125\t            DBG_PRINTF(\"Chi2 = %f, larger than %f\\n\", chi_squared, RANDOM_PUBLIC_CHI_SQUARE);\n10126\t            ret = -1;\n10127\t        }\n10128\t    }\n10129\t\n10130\t    return ret;\n10131\t}\n10132\t\n10133\t/*\n10134\t * Test a simple download work if the server has set the connection\n10135\t * diabled parameter.\n10136\t */\n10137\t\n10138\tint migration_disabled_test(void)\n10139\t{\n10140\t    uint64_t simulated_time = 0;\n10141\t    picoquic_test_tls_api_ctx_t* test_ctx = NULL;\n10142\t    int ret = tls_api_init_ctx(&test_ctx, PICOQUIC_INTERNAL_TEST_VERSION_1, PICOQUIC_TEST_SNI, PICOQUIC_TEST_ALPN, &simulated_time, NULL, NULL, 0, 1, 0);\n10143\t\n10144\t    if (ret == 0 && test_ctx == NULL) {\n10145\t        ret = -1;\n10146\t    }\n10147\t\n10148\t    /* Set the migration_disabled flag in the server parameter\n10149\t     */\n10150\t    if (ret == 0) {\n10151\t        test_ctx->qserver->default_tp.migration_disabled = 1;\n10152\t\n10153\t        /* Run a basic test scenario\n10154\t         */\n10155\t\n10156\t        ret = tls_api_one_scenario_body(test_ctx, &simulated_time,\n10157\t            test_scenario_q_and_r, sizeof(test_scenario_q_and_r), 0, 0, 0, 0, 250000);\n10158\t    }\n10159\t\n10160\t    /* verify that the migration was properly noticed as disabled. */\n10161\t    if (ret == 0 && test_ctx->cnx_client != NULL &&\n10162\t        !test_ctx->cnx_client->remote_parameters.migration_disabled) {\n10163\t        DBG_PRINTF(\"%s\", \"Migration not disabled on client\\n\");\n10164\t        ret = -1;\n10165\t    }\n10166\t\n10167\t    if (test_ctx != NULL) {\n10168\t        tls_api_delete_ctx(test_ctx);\n10169\t        test_ctx = NULL;\n10170\t    }\n10171\t\n10172\t    return ret;\n10173\t}\n10174\t\n10175\t/*\n10176\t * Test whether connections can be established when the client hello is larger than a \n10177\t * single packet. This is done by adding a \"padding\" transport parameter.\n10178\t */\n10179\t\n10180\tint large_client_hello_test(void)\n10181\t{\n10182\t    uint64_t simulated_time = 0;\n10183\t    picoquic_test_tls_api_ctx_t* test_ctx = NULL;\n10184\t    int ret = tls_api_init_ctx(&test_ctx, PICOQUIC_INTERNAL_TEST_VERSION_1, PICOQUIC_TEST_SNI, PICOQUIC_TEST_ALPN, &simulated_time, NULL, NULL, 0, 1, 0);\n10185\t\n10186\t    if (ret == 0 && test_ctx == NULL) {\n10187\t        ret = -1;\n10188\t    }\n10189\t\n10190\t    /* Set the test large hello flag in the client connection\n10191\t     */\n10192\t    if (ret == 0) {\n10193\t        test_ctx->cnx_client->test_large_chello = 1;\n10194\t\n10195\t        /* Run a basic test scenario\n10196\t         */\n10197\t\n10198\t        ret = tls_api_one_scenario_body(test_ctx, &simulated_time,\n10199\t            test_scenario_q_and_r, sizeof(test_scenario_q_and_r), 0, 0, 0, 0, 250000);\n10200\t    }\n10201\t\n10202\t    /* Verify that there is no spurious retransmission */\n10203\t    if (ret == 0) {\n10204\t        if (test_ctx->cnx_server == NULL || test_ctx->cnx_server->nb_retransmission_total > 0) {\n10205\t            DBG_PRINTF(\"Unexpected, server retransmitted %\" PRIu64 \" packets\", \n10206\t                (test_ctx->cnx_server == NULL)? UINT64_MAX:test_ctx->cnx_server->nb_retransmission_total);\n10207\t            ret = -1;\n10208\t        }\n10209\t        else if (test_ctx->cnx_client->nb_retransmission_total > 0) {\n10210\t            DBG_PRINTF(\"Unexpected, client retransmitted %\" PRIu64 \" packets\", test_ctx->cnx_client->nb_retransmission_total);\n10211\t            ret = -1;\n10212\t        }\n10213\t    }\n10214\t\n10215\t    /* And then free the resource\n10216\t     */\n10217\t\n10218\t    if (test_ctx != NULL) {\n10219\t        tls_api_delete_ctx(test_ctx);\n10220\t        test_ctx = NULL;\n10221\t    }\n10222\t\n10223\t    return ret;\n10224\t}\n10225\t\n10226\t/* DDOS Amplification Mitigation test\n10227\t *\n10228\t * In this test, the client sends a first packet (client hello) and then disappears.\n10229\t * This simulates an attempts to use the Quic server as an amplifier in a DDOS attack.\n10230\t * We want to verify that the server does not send out more than 3 times the amount\n10231\t * of data sent by the client.\n10232\t */\n10233\t\n10234\tint ddos_amplification_test_one(int use_0rtt, int do_8k)\n10235\t{\n10236\t    uint64_t simulated_time = 0;\n10237\t    uint64_t loss_mask = 0;\n10238\t    picoquic_test_tls_api_ctx_t* test_ctx = NULL;\n10239\t    uint32_t proposed_version = PICOQUIC_INTEROP_VERSION_LATEST;\n10240\t    int ret; \n10241\t    picoquictest_sim_packet_t* packet = picoquictest_sim_link_create_packet();\n10242\t    size_t data_sent_by_client = 0;\n10243\t    size_t data_sent_by_server = 0;\n10244\t    int nb_server_packets = 0;\n10245\t    int nb_loops = 0;\n10246\t    int nb_inactive = 0;\n10247\t\n10248\t    ret = picoquic_save_tickets(NULL, simulated_time, ticket_file_name);\n10249\t\n10250\t    if (ret == 0) {\n10251\t        ret = tls_api_init_ctx(&test_ctx, proposed_version, PICOQUIC_TEST_SNI, PICOQUIC_TEST_ALPN, &simulated_time,\n10252\t            ticket_file_name, NULL, 0, 0, 0);\n10253\t    }\n10254\t\n10255\t    if (ret != 0 || packet == NULL)\n10256\t    {\n10257\t        DBG_PRINTF(\"Could not create the QUIC test contexts for V=%x\\n\", proposed_version);\n10258\t        ret = -1;\n10259\t    }\n10260\t\n10261\t    if (ret == 0 && do_8k) {\n10262\t        test_ctx->qserver->test_large_server_flight = 1;\n10263\t    }\n10264\t\n10265\t    if (ret == 0 && use_0rtt) {\n10266\t        /* Complete a first connection in order to obtain ticket and token for the client. */\n10267\t        if (ret == 0) {\n10268\t            ret = test_api_init_send_recv_scenario(test_ctx, test_scenario_q_and_r5000, sizeof(test_scenario_q_and_r5000));\n10269\t        }\n10270\t\n10271\t        if (ret == 0) {\n10272\t            ret = tls_api_connection_loop(test_ctx, &loss_mask, 0, &simulated_time);\n10273\t\n10274\t            if (ret != 0) {\n10275\t                DBG_PRINTF(\"%\", \"Ticket grabbing connection failed\\n\");\n10276\t            }\n10277\t        }\n10278\t\n10279\t        if (ret == 0) {\n10280\t            /* Before closing, wait for the session ticket to arrive */\n10281\t            ret = session_resume_wait_for_ticket(test_ctx, &simulated_time);\n10282\t\n10283\t            /* Verify that the client has obtained a ticket */\n10284\t            if (ret != 0 || test_ctx->qclient->p_first_ticket == NULL) {\n10285\t                DBG_PRINTF(\"%s\", \"No resumption ticket obtained.\\n\");\n10286\t                ret = -1;\n10287\t            }\n10288\t        }\n10289\t\n10290\t        /* Delete this client connection and create a new one. */\n10291\t        if (ret == 0) {\n10292\t            /* Delete the old server connection */\n10293\t            picoquic_delete_cnx(test_ctx->cnx_server);\n10294\t            /* Delete the old client connection */\n10295\t            picoquic_delete_cnx(test_ctx->cnx_client);\n10296\t            for (size_t i = 0; i < test_ctx->nb_test_streams; i++) {\n10297\t                 test_api_delete_test_stream(&test_ctx->test_stream[i]);\n10298\t            }\n10299\t            /* re-create a client connection, this time picking up the required connection ID */\n10300\t            test_ctx->cnx_client = picoquic_create_cnx(test_ctx->qclient,\n10301\t                picoquic_null_connection_id, picoquic_null_connection_id,\n10302\t                (struct sockaddr*) & test_ctx->server_addr, 0,\n10303\t                PICOQUIC_INTEROP_VERSION_LATEST, PICOQUIC_TEST_SNI, PICOQUIC_TEST_ALPN, 1);\n10304\t            if (test_ctx->cnx_client == NULL) {\n10305\t                DBG_PRINTF(\"Could not create the second connection for version =  %08x\\n\", proposed_version);\n10306\t                ret = -1;\n10307\t            }\n10308\t            else {\n10309\t                ret = picoquic_start_client_cnx(test_ctx->cnx_client);\n10310\t            }\n10311\t        }\n10312\t\n10313\t        /* Set a scenario for sending packets from the server  */\n10314\t        if (ret == 0) {\n10315\t            ret = test_api_init_send_recv_scenario(test_ctx, test_scenario_q_and_r5000, sizeof(test_scenario_q_and_r5000));\n10316\t        }\n10317\t    }\n10318\t\n10319\t    if (ret == 0) {\n10320\t        /* Prepare a first packet from the client to the server */\n10321\t        {\n10322\t            ret = picoquic_prepare_packet(test_ctx->cnx_client, simulated_time,\n10323\t                packet->bytes, PICOQUIC_MAX_PACKET_SIZE, &packet->length,\n10324\t                &packet->addr_to, &packet->addr_from, NULL);\n10325\t        }\n10326\t\n10327\t        if (packet->length == 0) {\n10328\t            ret = PICOQUIC_ERROR_UNEXPECTED_ERROR;\n10329\t        }\n10330\t        if (ret != 0 )\n10331\t        {\n10332\t            DBG_PRINTF(\"Could not create first client packet, ret=%x\\n\", ret);\n10333\t        }\n10334\t        else {\n10335\t            data_sent_by_client += packet->length;\n10336\t            picoquic_store_addr(&packet->addr_from, (struct sockaddr*)&test_ctx->client_addr);\n10337\t\n10338\t            ret = picoquic_incoming_packet(test_ctx->qserver, packet->bytes, (uint32_t)packet->length,\n10339\t                (struct sockaddr*) & packet->addr_from,\n10340\t                (struct sockaddr*) & packet->addr_to, 0, test_ctx->recv_ecn_server,\n10341\t                simulated_time);\n10342\t\n10343\t            if (ret == 0) {\n10344\t                picoquic_cnx_t* next = test_ctx->qserver->cnx_list;\n10345\t\n10346\t                while (next != NULL && picoquic_compare_connection_id(&next->initial_cnxid, &test_ctx->cnx_client->initial_cnxid) != 0) {\n10347\t                    next = next->next_in_table;\n10348\t                }\n10349\t\n10350\t                if (next != NULL) {\n10351\t                    test_ctx->cnx_server = next;\n10352\t                } else {\n10353\t                    ret = -1;\n10354\t                    DBG_PRINTF(\"Could not create server side connection, ret = %d\\n\", ret);\n10355\t                }\n10356\t            }\n10357\t        }\n10358\t    }\n10359\t\n10360\t    while (ret == 0 && test_ctx->cnx_server != NULL && test_ctx->cnx_server->cnx_state != picoquic_state_disconnected && nb_loops < 1024 && nb_inactive < 256) {\n10361\t        /* Update the time to the next server time */\n10362\t        simulated_time = test_ctx->cnx_server->next_wake_time;\n10363\t        packet->length = 0;\n10364\t        nb_loops++;\n10365\t\n10366\t        ret = picoquic_prepare_packet(test_ctx->cnx_server, simulated_time,\n10367\t            packet->bytes, PICOQUIC_MAX_PACKET_SIZE, &packet->length,\n10368\t            &packet->addr_to, &packet->addr_from, NULL);\n10369\t\n10370\t        if (ret == PICOQUIC_ERROR_DISCONNECTED) {\n10371\t            ret = 0;\n10372\t        }\n10373\t\n10374\t        if (ret != 0)\n10375\t        {\n10376\t            DBG_PRINTF(\"Could not create server packet, ret=%x\\n\", ret);\n10377\t        }\n10378\t        else if (packet->length > 0) {\n10379\t            data_sent_by_server += packet->length;\n10380\t            nb_server_packets++;\n10381\t            nb_inactive = 0;\n10382\t        }\n10383\t        else {\n10384\t            nb_inactive++;\n10385\t        }\n10386\t    }\n10387\t\n10388\t    if (ret == 0 && test_ctx->cnx_server != NULL && test_ctx->cnx_server->cnx_state != picoquic_state_disconnected) {\n10389\t        DBG_PRINTF(\"Simulation was looping, closed before termination, loops: %d, inactive: %d\\n\", nb_loops, nb_inactive);\n10390\t        ret = -1;\n10391\t    }\n10392\t\n10393\t    if (ret == 0 && data_sent_by_server > 3*data_sent_by_client) {\n10394\t        DBG_PRINTF(\"Client sent %d bytes, server sent >3x more, %d bytes, %d packets\\n\", (int)data_sent_by_client, (int)data_sent_by_server, nb_server_packets);\n10395\t        ret = -1;\n10396\t    }\n10397\t\n10398\t    if (test_ctx != NULL) {\n10399\t        tls_api_delete_ctx(test_ctx);\n10400\t        test_ctx = NULL;\n10401\t    }\n10402\t\n10403\t    if (packet != NULL) {\n10404\t        free(packet);\n10405\t    }\n10406\t\n10407\t    return ret;\n10408\t}\n10409\t\n10410\tint ddos_amplification_test(void)\n10411\t{\n10412\t    return ddos_amplification_test_one(0, 0);\n10413\t}\n10414\t\n10415\tint ddos_amplification_0rtt_test(void)\n10416\t{\n10417\t    return ddos_amplification_test_one(1, 0);\n10418\t}\n10419\t\n10420\tint ddos_amplification_8k_test(void)\n10421\t{\n10422\t    return ddos_amplification_test_one(0, 1);\n10423\t}\n10424\t\n10425\t/* Verify that the code operates correctly when the ack frequency extension is not used\n10426\t */\n10427\t\n10428\tint no_ack_frequency_test(void)\n10429\t{\n10430\t    int ret = 0;\n10431\t    picoquic_tp_t client_parameters;\n10432\t    picoquic_tp_t server_parameters;\n10433\t\n10434\t    for (int i = 1; ret == 0 && i <= 3; i++) {\n10435\t        memset(&client_parameters, 0, sizeof(picoquic_tp_t));\n10436\t        memset(&server_parameters, 0, sizeof(picoquic_tp_t));\n10437\t        picoquic_init_transport_parameters(&client_parameters);\n10438\t        picoquic_init_transport_parameters(&server_parameters);\n10439\t\n10440\t        client_parameters.min_ack_delay = (i & 1) ? 0 : 1000;\n10441\t        server_parameters.enable_loss_bit = (1 - ((i > 1) & 1));\n10442\t\n10443\t        ret = tls_api_one_scenario_test(test_scenario_very_long, sizeof(test_scenario_very_long), 0, 128, 0, 0, 0, 2000000, &client_parameters, &server_parameters);\n10444\t        if (ret != 0) {\n10445\t            DBG_PRINTF(\"No min ack delay test fails for client: %d, server: %d, ret = %d\", i & 1, i >> 1, ret);\n10446\t        }\n10447\t    }\n10448\t\n10449\t    return ret;\n10450\t}\n10451\t\n10452\t/* Check that a connection does fail in a reasonable time after a transmission\n10453\t * drops.\n10454\t */\n10455\t\n10456\tstatic int connection_drop_test_one(picoquic_state_enum target_client_state, picoquic_state_enum target_server_state, int target_is_client)\n10457\t{\n10458\t    uint64_t simulated_time = 0;\n10459\t    uint64_t target_time = PICOQUIC_MICROSEC_HANDSHAKE_MAX;\n10460\t    const char* target_name = (target_is_client) ? \"client\" : \"server\";\n10461\t    picoquic_cnx_t* target_cnx = NULL;\n10462\t\n10463\t    picoquic_test_tls_api_ctx_t* test_ctx = NULL;\n10464\t    int ret = tls_api_init_ctx(&test_ctx, 0, PICOQUIC_TEST_SNI, PICOQUIC_TEST_ALPN, &simulated_time, NULL, NULL, 0, 0, 0);\n10465\t\n10466\t    if (ret == 0) {\n10467\t        int nb_trials = 0;\n10468\t        int nb_inactive = 0;\n10469\t\n10470\t        while (ret == 0 && nb_trials < 1024 && nb_inactive < 512 && (!TEST_CLIENT_READY || (test_ctx->cnx_server == NULL || !TEST_SERVER_READY))) {\n10471\t            int was_active = 0;\n10472\t            nb_trials++;\n10473\t\n10474\t            ret = tls_api_one_sim_round(test_ctx, &simulated_time, 0, &was_active);\n10475\t\n10476\t            if (test_ctx->cnx_client->cnx_state == picoquic_state_disconnected &&\n10477\t                (test_ctx->cnx_server == NULL || test_ctx->cnx_server->cnx_state == picoquic_state_disconnected)) {\n10478\t                break;\n10479\t            }\n10480\t\n10481\t            if (test_ctx->cnx_client->cnx_state >= target_client_state ||\n10482\t                (test_ctx->cnx_server != NULL && test_ctx->cnx_server->cnx_state >= target_server_state)) {\n10483\t                break;\n10484\t            }\n10485\t        }\n10486\t    }\n10487\t\n10488\t    if (ret == 0) {\n10489\t        target_cnx = (target_is_client) ? test_ctx->cnx_client : test_ctx->cnx_server;\n10490\t\n10491\t        if (target_cnx == NULL) {\n10492\t            DBG_PRINTF(\"Target connection (%s) already dropped\", target_name);\n10493\t            ret = -1;\n10494\t        }\n10495\t        else if (target_cnx->cnx_state >= picoquic_state_ready) {\n10496\t            DBG_PRINTF(\"Target connection (%s) already ready\", target_name);\n10497\t            ret = -1;\n10498\t        }\n10499\t    }\n10500\t\n10501\t    if (ret == 0) {\n10502\t        int nb_trials = 0;\n10503\t        int nb_inactive = 0;\n10504\t        int disconnected_in_time = 0;\n10505\t\n10506\t        while (ret == 0 && nb_trials < 1024 && nb_inactive < 512) {\n10507\t            struct sockaddr_storage a_from;\n10508\t            struct sockaddr_storage a_to;\n10509\t            int if_index;\n10510\t            uint8_t packet[PICOQUIC_MAX_PACKET_SIZE];\n10511\t            size_t length = 0;\n10512\t\n10513\t            if (target_cnx->next_wake_time > simulated_time) {\n10514\t                simulated_time = target_cnx->next_wake_time;\n10515\t            }\n10516\t\n10517\t            if (simulated_time > target_time + target_cnx->start_time) {\n10518\t                break;\n10519\t            }\n10520\t\n10521\t            ret = picoquic_prepare_packet(target_cnx, simulated_time, packet, PICOQUIC_MAX_PACKET_SIZE,\n10522\t                &length, &a_to, &a_from, &if_index);\n10523\t\n10524\t            if (ret == PICOQUIC_ERROR_DISCONNECTED) {\n10525\t                ret = 0;\n10526\t            }\n10527\t\n10528\t            if (target_cnx->cnx_state == picoquic_state_disconnected) {\n10529\t                disconnected_in_time = 1;\n10530\t                break;\n10531\t            }\n10532\t        }\n10533\t\n10534\t        if (ret == 0 && !disconnected_in_time) {\n10535\t            DBG_PRINTF(\"Connection not disconnected after %lld microsec\", simulated_time);\n10536\t            ret = -1;\n10537\t        }\n10538\t    }\n10539\t\n10540\t    if (test_ctx != NULL) {\n10541\t        tls_api_delete_ctx(test_ctx);\n10542\t        test_ctx = NULL;\n10543\t    }\n10544\t\n10545\t    return ret;\n10546\t}\n10547\t\n10548\tint connection_drop_test(void)\n10549\t{\n10550\t    int ret = 0;\n10551\t    picoquic_state_enum target_state[9] = {\n10552\t        picoquic_state_client_init_sent,\n10553\t        picoquic_state_client_renegotiate,\n10554\t        picoquic_state_client_init_resent,\n10555\t        picoquic_state_server_init,\n10556\t        picoquic_state_server_handshake,\n10557\t        picoquic_state_client_handshake_start,\n10558\t        picoquic_state_server_false_start,\n10559\t        picoquic_state_server_almost_ready,\n10560\t        picoquic_state_client_almost_ready\n10561\t    };\n10562\t    int target_is_client[9] = {\n10563\t        1, 1, 1, 0, 0, 1, 0, 0, 1 };\n10564\t\n10565\t    for (int i = 0; ret == 0 && i < 9; i++) {\n10566\t        picoquic_state_enum c_state = (target_is_client[i]) ? target_state[i] : picoquic_state_ready;\n10567\t        picoquic_state_enum s_state = (target_is_client[i]) ? picoquic_state_ready : target_state[i];\n10568\t\n10569\t        ret = connection_drop_test_one(c_state, s_state, target_is_client[i]);\n10570\t        if (ret == -1) {\n10571\t            DBG_PRINTF(\"connection drop test %d fails\", i);\n10572\t        }\n10573\t    }\n10574\t\n10575\t    return ret;\n10576\t}\n10577\t\n10578\t/* testing the pacing rate update function and the congestion\n10579\t * control parameter assessors.\n10580\t */\n10581\t\n10582\t#ifdef _WINDOWS\n10583\t#define PACING_RATE_TEST_REF \"picoquictest\\\\pacing_rate_ref.txt\"\n10584\t#else\n10585\t#define PACING_RATE_TEST_REF \"picoquictest/pacing_rate_ref.txt\"\n10586\t#endif\n10587\t#define PACING_RATE_CSV \"pacing_rate.csv\"\n10588\t\n10589\t\n10590\tint pacing_update_test(void)\n10591\t{\n10592\t    uint64_t simulated_time = 0;\n10593\t\n10594\t    picoquic_test_tls_api_ctx_t* test_ctx = NULL;\n10595\t    int ret = tls_api_init_ctx(&test_ctx, PICOQUIC_INTERNAL_TEST_VERSION_1, PICOQUIC_TEST_SNI, PICOQUIC_TEST_ALPN, &simulated_time, NULL, NULL, 0, 1, 0);\n10596\t\n10597\t    if (ret == 0 && test_ctx == NULL) {\n10598\t        ret = -1;\n10599\t    }\n10600\t    if (ret == 0) {\n10601\t        /* Open a file to log bandwidth updates and document it in context */\n10602\t        test_ctx->bw_update = picoquic_file_open(PACING_RATE_CSV, \"w\");\n10603\t        if (test_ctx->bw_update == NULL) {\n10604\t            DBG_PRINTF(\"Could not write file <%s>\", PACING_RATE_CSV);\n10605\t            ret = -1;\n10606\t        }\n10607\t        else {\n10608\t            fprintf(test_ctx->bw_update, \"Time, Pacing_rate_CB, Pacing_rate, CWIN, RTT\\n\");\n10609\t            /* Request bandwidth updates */\n10610\t            picoquic_subscribe_pacing_rate_updates(test_ctx->cnx_client, 0x8000, 0x10000);\n10611\t\n10612\t            /* Start a standard scenario, pushing 1MB from the client*/\n10613\t            ret = tls_api_one_scenario_body(test_ctx, &simulated_time,\n10614\t                test_scenario_q_and_r, sizeof(test_scenario_q_and_r), 1000000, 0, 0, 20000, 3600000);\n10615\t        }\n10616\t    }\n10617\t\n10618\t    /* Free the test contex, which closes the trace file  */\n10619\t    if (test_ctx != NULL) {\n10620\t        tls_api_delete_ctx(test_ctx);\n10621\t        test_ctx = NULL;\n10622\t    }\n10623\t\n10624\t    /* compare the trace to the expected value */\n10625\t    if (ret == 0)\n10626\t    {\n10627\t        char pacing_rate_ref[512];\n10628\t\n10629\t        ret = picoquic_get_input_path(pacing_rate_ref, sizeof(pacing_rate_ref), picoquic_solution_dir, PACING_RATE_TEST_REF);\n10630\t\n10631\t        if (ret != 0) {\n10632\t            DBG_PRINTF(\"%s\", \"Cannot set the pacing rate test ref file name.\\n\");\n10633\t        }\n10634\t        else {\n10635\t            ret = picoquic_test_compare_text_files(PACING_RATE_CSV, pacing_rate_ref);\n10636\t        }\n10637\t    }\n10638\t\n10639\t    return ret;\n10640\t}\n10641\t\n10642\t/* testing the quality update functionality when using the default path\n10643\t* quality API.\n10644\t*/\n10645\t\n10646\t#ifdef _WINDOWS\n10647\t#define QUALITY_UPDATE_REF \"picoquictest\\\\quality_update_ref.txt\"\n10648\t#else\n10649\t#define QUALITY_UPDATE_REF \"picoquictest/quality_update_ref.txt\"\n10650\t#endif\n10651\t#define QUALITY_UPDATE_CSV \"quality_update.csv\"\n10652\t\n10653\tint quality_update_test(void)\n10654\t{\n10655\t    uint64_t simulated_time = 0;\n10656\t\n10657\t    picoquic_test_tls_api_ctx_t* test_ctx = NULL;\n10658\t    int ret = tls_api_init_ctx(&test_ctx, PICOQUIC_INTERNAL_TEST_VERSION_1, PICOQUIC_TEST_SNI, PICOQUIC_TEST_ALPN, &simulated_time, NULL, NULL, 0, 1, 0);\n10659\t\n10660\t    if (ret == 0 && test_ctx == NULL) {\n10661\t        ret = -1;\n10662\t    }\n10663\t    if (ret == 0) {\n10664\t        /* Open a file to log bandwidth updates and document it in context */\n10665\t        test_ctx->default_path_update = picoquic_file_open(QUALITY_UPDATE_CSV, \"w\");\n10666\t        if (test_ctx->default_path_update == NULL) {\n10667\t            DBG_PRINTF(\"Could not write file <%s>\", QUALITY_UPDATE_CSV);\n10668\t            ret = -1;\n10669\t        }\n10670\t        else {\n10671\t            fprintf(test_ctx->default_path_update, \"Time, Path_id, Sending_rate_CB, Pacing_rate, Receive_Rate, CWIN, RTT\\n\");\n10672\t            /* Request bandwidth updates */\n10673\t            picoquic_subscribe_to_quality_update(test_ctx->cnx_client, 0x10000, 0x1000);\n10674\t\n10675\t            /* Start a standard scenario, pushing 1MB from the client*/\n10676\t            ret = tls_api_one_scenario_body(test_ctx, &simulated_time,\n10677\t                test_scenario_q_and_r, sizeof(test_scenario_q_and_r), 1000000, 0, 0, 20000, 3600000);\n10678\t        }\n10679\t    }\n10680\t\n10681\t    /* Free the test contex, which closes the trace file  */\n10682\t    if (test_ctx != NULL) {\n10683\t        tls_api_delete_ctx(test_ctx);\n10684\t        test_ctx = NULL;\n10685\t    }\n10686\t\n10687\t    /* compare the trace to the expected value */\n10688\t    if (ret == 0)\n10689\t    {\n10690\t        char quality_update_ref[512];\n10691\t\n10692\t        ret = picoquic_get_input_path(quality_update_ref, sizeof(quality_update_ref), picoquic_solution_dir, QUALITY_UPDATE_REF);\n10693\t\n10694\t        if (ret != 0) {\n10695\t            DBG_PRINTF(\"%s\", \"Cannot set the quality update ref file name.\\n\");\n10696\t        }\n10697\t        else {\n10698\t            ret = picoquic_test_compare_text_files(QUALITY_UPDATE_CSV, quality_update_ref);\n10699\t        }\n10700\t    }\n10701\t\n10702\t    return ret;\n10703\t}\n10704\t\n10705\t\n10706\t/* Test the direct receive API\n10707\t */\n10708\t\n10709\tint direct_receive_test(void)\n10710\t{\n10711\t    int ret = 0;\n10712\t    uint64_t simulated_time = 0;\n10713\t    picoquic_test_tls_api_ctx_t* test_ctx = NULL;\n10714\t    uint64_t loss_mask = 8;\n10715\t    uint64_t max_completion_microsec = 3500000;\n10716\t\n10717\t    ret = tls_api_one_scenario_init(&test_ctx, &simulated_time,\n10718\t        0, NULL, NULL);\n10719\t\n10720\t    if (ret == 0) {\n10721\t        ret = tls_api_one_scenario_body_connect(test_ctx, &simulated_time, 0, 0);\n10722\t\n10723\t        /* Prepare to send data */\n10724\t        if (ret == 0) {\n10725\t            test_ctx->stream0_target = 0;\n10726\t            ret = test_api_init_send_recv_scenario(test_ctx, test_scenario_very_long, sizeof(test_scenario_very_long));\n10727\t\n10728\t            if (ret != 0)\n10729\t            {\n10730\t                DBG_PRINTF(\"Init send receive scenario returns %d\\n\", ret);\n10731\t            }\n10732\t        }\n10733\t\n10734\t        /* Set the direct receive API for the stream number 4. */\n10735\t        if (ret == 0) {\n10736\t            ret = picoquic_mark_direct_receive_stream(test_ctx->cnx_client, 4, test_api_direct_receive_callback, \n10737\t                (void*)&test_ctx->client_callback);\n10738\t\n10739\t            if (ret != 0)\n10740\t            {\n10741\t                DBG_PRINTF(\"Mark direct receive stream returns %d\\n\", ret);\n10742\t            }\n10743\t        }\n10744\t\n10745\t        /* Perform a data sending loop */\n10746\t        if (ret == 0) {\n10747\t            ret = tls_api_data_sending_loop(test_ctx, &loss_mask, &simulated_time, 0);\n10748\t\n10749\t            if (ret != 0)\n10750\t            {\n10751\t                DBG_PRINTF(\"Data sending loop returns %d\\n\", ret);\n10752\t            }\n10753\t        }\n10754\t\n10755\t        if (ret == 0) {\n10756\t            ret = tls_api_one_scenario_body_verify(test_ctx, &simulated_time, max_completion_microsec);\n10757\t        }\n10758\t    }\n10759\t\n10760\t    if (test_ctx != NULL) {\n10761\t        tls_api_delete_ctx(test_ctx);\n10762\t        test_ctx = NULL;\n10763\t    }\n10764\t\n10765\t    return ret;\n10766\t}\n10767\t\n10768\t/* Initial race condition.\n10769\t* What happens if the client immediately repeats the Initial packet?\n10770\t*/\n10771\t\n10772\tint initial_race_test(void)\n10773\t{\n10774\t    uint64_t simulated_time = 0;\n10775\t    uint64_t loss_mask = 0;\n10776\t    picoquic_test_tls_api_ctx_t* test_ctx = NULL;\n10777\t    int ret = tls_api_init_ctx(&test_ctx, PICOQUIC_INTERNAL_TEST_VERSION_1,\n10778\t        PICOQUIC_TEST_SNI, PICOQUIC_TEST_ALPN, &simulated_time, NULL, NULL, 0, 0, 0);\n10779\t\n10780\t    if (ret == 0 && test_ctx == NULL) {\n10781\t        ret = PICOQUIC_ERROR_MEMORY;\n10782\t    }\n10783\t\n10784\t    /* Run an initial loop to make to send the client's first packet, and then replicate it. */\n10785\t    if (ret == 0) {\n10786\t        int was_active = 0;\n10787\t        ret = tls_api_one_sim_round(test_ctx, &simulated_time, 0, &was_active);\n10788\t\n10789\t        if (ret == 0) {\n10790\t            /* Force a repeat of the first packet */\n10791\t            simulated_time += 100;\n10792\t            test_ctx->cnx_client->initial_repeat_needed = 1;\n10793\t            ret = tls_api_one_sim_round(test_ctx, &simulated_time, 0, &was_active);\n10794\t            test_ctx->cnx_client->initial_repeat_needed = 0;\n10795\t            /* Verify that there are two packets in the initial queue */\n10796\t            if (ret == 0) {\n10797\t                if (test_ctx->c_to_s_link->first_packet == NULL) {\n10798\t                    DBG_PRINTF(\"%s\", \"No packet queued\");\n10799\t                    ret = -1;\n10800\t                }\n10801\t                else if (test_ctx->c_to_s_link->last_packet == test_ctx->c_to_s_link->first_packet) {\n10802\t                    DBG_PRINTF(\"%s\", \"Only one packet queued\");\n10803\t                    ret = -1;\n10804\t                }\n10805\t            }\n10806\t        }\n10807\t\n10808\t        while (ret == 0 && test_ctx->s_to_c_link->first_packet == NULL){\n10809\t            /* run a couple of simulation round to process the first server packets,\n10810\t             * but make sure the server sends only one packet */\n10811\t            ret = tls_api_one_sim_round(test_ctx, &simulated_time, 0, &was_active);\n10812\t        }\n10813\t\n10814\t        if (ret == 0) {\n10815\t            if (test_ctx->cnx_server == NULL) {\n10816\t                DBG_PRINTF(\"%s\", \"No server connection\");\n10817\t                ret = -1;\n10818\t\n10819\t            }\n10820\t            else {\n10821\t                /* Make sure that the server waits before sending the next packet. */\n10822\t                test_ctx->cnx_server->next_wake_time += 2000;\n10823\t            }\n10824\t        }\n10825\t    }\n10826\t\n10827\t    /* Run a connection loop */\n10828\t    if (ret == 0) {\n10829\t        ret = tls_api_connection_loop(test_ctx, &loss_mask, 0, &simulated_time);\n10830\t    }\n10831\t\n10832\t    /* Prepare to send data */\n10833\t    if (ret == 0) {\n10834\t        ret = test_api_init_send_recv_scenario(test_ctx, test_scenario_q2_and_r2, sizeof(test_scenario_q2_and_r2));\n10835\t    }\n10836\t\n10837\t    /* Try send data */\n10838\t    if (ret == 0) {\n10839\t        ret = tls_api_data_sending_loop(test_ctx, &loss_mask, &simulated_time, 0);\n10840\t    }\n10841\t\n10842\t    /* Check that the data was sent and received */\n10843\t    if (ret == 0) {\n10844\t        ret = tls_api_one_scenario_verify(test_ctx);\n10845\t    }\n10846\t\n10847\t    if (ret == 0) {\n10848\t        ret = tls_api_attempt_to_close(test_ctx, &simulated_time);\n10849\t\n10850\t        if (ret != 0)\n10851\t        {\n10852\t            DBG_PRINTF(\"Connection close returns %d\\n\", ret);\n10853\t        }\n10854\t    }\n10855\t\n10856\t    if (test_ctx != NULL) {\n10857\t        tls_api_delete_ctx(test_ctx);\n10858\t        test_ctx = NULL;\n10859\t    }\n10860\t\n10861\t    return ret;\n10862\t}\n10863\t\n10864\t/*\n10865\t * Test connection establishment with ChaCha20\n10866\t */\n10867\t\n10868\tint chacha20_test(void)\n10869\t{\n10870\t    uint64_t simulated_time = 0;\n10871\t    picoquic_test_tls_api_ctx_t* test_ctx = NULL;\n10872\t    int has_chacha_poly = 0;\n10873\t    int ret = tls_api_init_ctx(&test_ctx, PICOQUIC_INTERNAL_TEST_VERSION_1, PICOQUIC_TEST_SNI, PICOQUIC_TEST_ALPN, &simulated_time, NULL, NULL, 0, 1, 0);\n10874\t\n10875\t    if (ret == 0 && test_ctx == NULL) {\n10876\t        ret = -1;\n10877\t    }\n10878\t\n10879\t    /* Set the cipher suite to chacha20\n10880\t     */\n10881\t    if (ret == 0) {\n10882\t        has_chacha_poly = (picoquic_set_cipher_suite(test_ctx->qclient, PICOQUIC_CHACHA20_POLY1305_SHA256) == 0);\n10883\t\n10884\t        if (has_chacha_poly) {\n10885\t\n10886\t            /* Run a basic test scenario */\n10887\t            ret = tls_api_one_scenario_body(test_ctx, &simulated_time,\n10888\t                test_scenario_q_and_r, sizeof(test_scenario_q_and_r), 0, 0, 0, 0, 250000);\n10889\t        }\n10890\t        else {\n10891\t            DBG_PRINTF(\"%s\", \"Could not test CHACHA20, not supported on this platform.\");\n10892\t        }\n10893\t    }\n10894\t\n10895\t    /* And then free the resource\n10896\t     */\n10897\t\n10898\t    if (test_ctx != NULL) {\n10899\t        tls_api_delete_ctx(test_ctx);\n10900\t        test_ctx = NULL;\n10901\t    }\n10902\t\n10903\t    return ret;\n10904\t}\n10905\t\n10906\t/*\n10907\t * Test CID renewal on quiescence larger than PICOQUIC_CID_REFRESH_DELAY\n10908\t */\n10909\tint cid_quiescence_test(void)\n10910\t{\n10911\t    uint64_t simulated_time = 0;\n10912\t    uint64_t loss_mask = 0;\n10913\t    picoquic_test_tls_api_ctx_t* test_ctx = NULL;\n10914\t    picoquic_connection_id_t previous_remote_id = picoquic_null_connection_id;\n10915\t    int ret = tls_api_init_ctx(&test_ctx, PICOQUIC_INTERNAL_TEST_VERSION_1, PICOQUIC_TEST_SNI, PICOQUIC_TEST_ALPN, &simulated_time, NULL, NULL, 0, 0, 0);\n10916\t\n10917\t    /* Set up the connection */\n10918\t    if (ret == 0) {\n10919\t        /* establish the connection */\n10920\t        ret = tls_api_connection_loop(test_ctx, &loss_mask, 0, &simulated_time);\n10921\t    }\n10922\t\n10923\t    if (ret == 0) {\n10924\t        previous_remote_id = test_ctx->cnx_client->path[0]->first_tuple->p_remote_cnxid->cnx_id;\n10925\t        /* Prepare to send data */\n10926\t        ret = test_api_init_send_recv_scenario(test_ctx, test_scenario_very_long, sizeof(test_scenario_very_long));\n10927\t    }\n10928\t\n10929\t    if (ret == 0) {\n10930\t        ret = wait_client_connection_ready(test_ctx, &simulated_time);\n10931\t    }\n10932\t\n10933\t    if (ret == 0) {\n10934\t        previous_remote_id = test_ctx->cnx_client->path[0]->first_tuple->p_remote_cnxid->cnx_id;\n10935\t        simulated_time += PICOQUIC_CID_REFRESH_DELAY;\n10936\t    }\n10937\t\n10938\t    /* Perform a data sending loop */\n10939\t    if (ret == 0) {\n10940\t        ret = tls_api_data_sending_loop(test_ctx, &loss_mask, &simulated_time, 0);\n10941\t    }\n10942\t\n10943\t    /* verify that the transmission was complete */\n10944\t    if (ret == 0) {\n10945\t        ret = tls_api_one_scenario_body_verify(test_ctx, &simulated_time, 0);\n10946\t    }\n10947\t    \n10948\t    /* Verify that the CID has rotated */\n10949\t    if (ret == 0 &&\n10950\t        picoquic_compare_connection_id(&previous_remote_id, &test_ctx->cnx_client->path[0]->first_tuple->p_remote_cnxid->cnx_id) == 0) {\n10951\t        ret = -1;\n10952\t    }\n10953\t    \n10954\t    /* And then free the resource  */\n10955\t    if (test_ctx != NULL) {\n10956\t        tls_api_delete_ctx(test_ctx);\n10957\t        test_ctx = NULL;\n10958\t    }\n10959\t\n10960\t    return ret;\n10961\t}\n10962\t\n10963\t/*\n10964\t * Test that the Quic Bit is properly greased.\n10965\t * Negotiate the Quic Bit parameter, transfer packets,\n10966\t * verify at the end that the quic bit was greased.\n10967\t */\n10968\t\n10969\tint grease_quic_bit_test_one(unsigned int one_way_grease_quic_bit)\n10970\t{\n10971\t    int ret;\n10972\t    picoquic_tp_t client_parameters;\n10973\t    uint64_t simulated_time = 0;\n10974\t    picoquic_test_tls_api_ctx_t* test_ctx = NULL;\n10975\t\n10976\t    memset(&client_parameters, 0, sizeof(picoquic_tp_t));\n10977\t    picoquic_init_transport_parameters(&client_parameters);\n10978\t\n10979\t    client_parameters.do_grease_quic_bit = 1;\n10980\t\n10981\t    ret = tls_api_one_scenario_init(&test_ctx, &simulated_time, 0, &client_parameters, NULL);\n10982\t\n10983\t    if (ret == 0 && one_way_grease_quic_bit) {\n10984\t        test_ctx->qserver->one_way_grease_quic_bit = 1;\n10985\t    }\n10986\t\n10987\t    if (ret == 0) {\n10988\t        ret = tls_api_one_scenario_body(test_ctx, &simulated_time,\n10989\t            test_scenario_very_long, sizeof(test_scenario_very_long), 0, 0, 0, 0, 0);\n10990\t    }\n10991\t\n10992\t    if (ret == 0) {\n10993\t        if (one_way_grease_quic_bit) {\n10994\t            if (test_ctx->cnx_client->quic_bit_greased) {\n10995\t                DBG_PRINTF(\"%s\", \"Quic bit was greased on client\");\n10996\t                ret = -1;\n10997\t            }\n10998\t        }\n10999\t        else {"}]},"parent_tool_use_id":"toolu_01Rt4pELUTT189iuGyrewME6","session_id":"782f2f02-5f93-4f6f-b663-2ef2c783a0cf","uuid":"801ac5d1-f6a3-42f6-9373-55ed785ce786","timestamp":"2026-05-05T12:37:45.732Z"}
