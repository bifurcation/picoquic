,\n3049\t    picoquic_connection_id_t * icid)\n3050\t{\n3051\t    int ret = tls_api_init_ctx_ex(p_test_ctx,\n3052\t        (proposed_version == 0) ? PICOQUIC_INTERNAL_TEST_VERSION_1 : proposed_version,\n3053\t        PICOQUIC_TEST_SNI, PICOQUIC_TEST_ALPN, simulated_time, NULL, NULL, 0, 1, 0, icid);\n3054\t\n3055\t    if (ret != 0) {\n3056\t        DBG_PRINTF(\"Could not create the QUIC test contexts for V=%x\\n\", proposed_version);\n3057\t    }\n3058\t    else if (*p_test_ctx == NULL || (*p_test_ctx)->cnx_client == NULL || (*p_test_ctx)->qserver == NULL) {\n3059\t        DBG_PRINTF(\"%s\", \"Connections where not properly created!\\n\");\n3060\t        ret = -1;\n3061\t    }\n3062\t\n3063\t    if (ret == 0 && client_params != NULL) {\n3064\t        picoquic_set_transport_parameters((*p_test_ctx)->cnx_client, client_params);\n3065\t    }\n3066\t\n3067\t    if (ret == 0 && server_params != NULL) {\n3068\t        ret = picoquic_set_default_tp((*p_test_ctx)->qserver, server_params);\n3069\t        if (server_params->preferred_address.ipv4Port != 0 ||\n3070\t            server_params->preferred_address.ipv6Port != 0) {\n3071\t            /* If testing server migration, disable address check */\n3072\t            (*p_test_ctx)->server_use_multiple_addresses = 1;\n3073\t        }\n3074\t    }\n3075\t\n3076\t    return ret;\n3077\t}\n3078\t\n3079\tint tls_api_one_scenario_init(\n3080\t    picoquic_test_tls_api_ctx_t** p_test_ctx, uint64_t* simulated_time,\n3081\t    uint32_t proposed_version,\n3082\t    picoquic_tp_t* client_params, picoquic_tp_t* server_params)\n3083\t{\n3084\t    return tls_api_one_scenario_init_ex(p_test_ctx, simulated_time, proposed_version, client_params, server_params, NULL);\n3085\t}\n3086\t\n3087\tint tls_api_one_scenario_verify(picoquic_test_tls_api_ctx_t* test_ctx)\n3088\t{\n3089\t    int ret = 0;\n3090\t\n3091\t    if (test_ctx->server_callback.error_detected) {\n3092\t        ret = -1;\n3093\t    }\n3094\t    else if (test_ctx->client_callback.