 usize, pub datagram_data_size: usize, pub max_streams_client: u64, pub max_streams_server: u64, pub max_stream_data: u64, pub bandwidth: f64 }\n       pub fn warptest_one(_warptest_id: u32, _spec: &WarptestSpec) -> crate::Result<()> { todo!() }\n       // WifiTestSuspension + WifiTestSpec + wifi_test_one\n       pub struct WifiTestSuspension { pub suspend_time: u64, pub suspend_interval: u64 }\n       pub struct WifiTestSpec { pub latency: u64, pub suspension: &'static [WifiTestSuspension], pub ccalgo_id: &'static str, pub cc_algo_option: Option<&'static str>, pub target_time: u64, pub simulate_receive_block: bool, pub queue_max_delay: u64 }\n       pub fn wifi_test_one(_test_id: u32, _spec: &WifiTestSpec) -> crate::Result<()> { todo!() }\n       // ticket/transport helpers\n       pub fn ticket_seed_test_one(_mode: u32) -> crate::Result<()> { todo!() }\n       pub fn transport_param_test_one(_ctx, _tp, _is_client) -> crate::Result<()> { todo!() }\n       pub fn transport_param_log_test_one(_filename: &str) -> crate::Result<()> { todo!() }\n       pub fn vn_tp_test_one(_test_id: u32, _is_client: bool, _expect_ok: bool) -> crate::Result<()> { todo!() }\n       ```\n\n   - **`rs/fq/src/tests/warptest.rs`** — Complete rewrite\n     All 5 tests call `warptest_one(id, &spec)` with faithfully translated WarptestSpec:\n     ```rust\n     fn warptest_video() {\n         let spec = WarptestSpec { ccalgo_id: Some(\"bbr\"), bandwidth: 0.01, do_video: true, ..Default::default() };\n         warptest_one(1, &spec).expect(\"warptest_video\");\n     }\n     fn warptest_video_audio() {\n         let spec = WarptestSpec { ccalgo_id: Some(\"bbr\"), bandwidth: 0.01, do_video: true, do_audio: true, ..Default::default() };\n         warptest_one(2, &spec).expect(\"warptest_video_audio\");\n     }\n     fn warptest_video_data_audio() {\n         let spec = WarptestSpec { ccalgo_id: Some(\"bbr\"), bandwidth: 0.01, do_video: true, do_audio: true, data_size: 10_000_000, ..Default::default() };\n         warptest_one(3, &spec).expect(\"warptest_video_data_audio\");\n     }\n     fn warptest_worst() {\n         let spec = WarptestSpec { ccalgo_id: Some(\"bbr\"), bandwidth: 0.01, do_video: true, do_audio: true, datagram_data_size: 10_000_000, ..Default::default() };\n         warptest_one(4, &spec).expect(\"warptest_worst\");\n     }\n     fn warptest_param() {\n         let spec = WarptestSpec { ccalgo_id: Some(\"bbr\"), bandwidth: 0.01, do_video: true, do_audio: true, max_streams_client: 4, max_streams_server: 4, ..Default::default() };\n         warptest_one(5, &spec).expect(\"warptest_param\");\n     }\n     ```\n\n   - **`rs/fq/src/tests/wifitest.rs`** — Complete rewrite\n     Defines three static suspension arrays and 14 tests:\n     ```rust\n     static SUSPENSION_BASIC: &[WifiTestSuspension] = &[WifiTestSuspension { suspend_time: 1_000_000, suspend_interval: 250_000 }];\n     static SUSPENSION_HARD: &[WifiTestSuspension] = &[\n         WifiTestSuspension { suspend_time: 1_000_000, suspend_interval: 250_000 },\n         WifiTestSuspension { suspend_time: 1_255_000, suspend_interval: 250_000 },\n         // ... 4 more\n     ];\n     static SUSPENSION_MANY: &[WifiTestSuspension] = &[ /* 6 events at 500ms intervals */ ];\n     // Test ID constants: WIFI_TEST_RENO=0, WIFI_TEST_CUBIC=1, WIFI_TEST_BBR=2, ...\n     fn wifi_bbr() { let spec = default_spec(\"bbr\", SUSPENSION_BASIC, 2_800_000); wifi_test_one(WIFI_TEST_BBR, &spec).expect(\"wifi_bbr\"); }\n     fn wifi_bbr1() { let spec = default_spec(\"bbr1\", SUSPENSION_BASIC, 2_800_000); wifi_test_one(WIFI_TEST_BBR1, &spec).expect(\"wifi_bbr1\"); }\n     // ... etc for all 14\n     ```\n\n   - **`rs/fq/src/tests/ticket_store.rs`** — Complete rewrite\n     Uses `tls_api_init_ctx` to get context, then calls methods on `ctx.qclient`/`ctx.qserver`:\n     ```rust\n     fn ticket_seed() { ticket_seed_test_one(1).expect(\"ticket_seed\"); }\n     fn ticket_seed_from_bdp_frame() { ticket_seed_test_one(2).expect(\"ticket_seed_from_bdp_frame\"); }\n     fn ticket_store() {\n         let mut t = Instant::from_ticks(0);\n         let mut ctx = tls_api_init_ctx(&mut t, 0, None).expect(\"ctx\");\n         // store tickets for 3 SNIs × 3 ALPNs × 3 versions\n         ctx.qclient.store_ticket(Some(sni), Some(alpn), version, ip_zero, ip_zero, &ticket, &tp).expect(\"store\");\n         ctx.qclient.save_tickets(t, TICKET_FILE).expect(\"save\");\n         let mut ctx2 = tls_api_init_ctx(&mut t, 0, None).expect(\"ctx2\");\n         ctx2.qclient.load_tickets(TICKET_FILE).expect(\"load\");\n         ctx2.qclient.get_ticket(Some(sni), Some(alpn), version, false).expect(\"get\");\n     }\n     fn token_reuse_api() {\n         let mut ctx = tls_api_init_ctx(&mut t, 0, None).expect(\"ctx\");\n         ctx.qserver.registered_token_check_reuse(token, token.len(), 2_000_000).expect(\"first\");\n         ctx.qserver.registered_token_check_reuse(token, token.len(), 2_000_000).expect_err(\"dup\");\n         ctx.qserver.registered_token_clear(t);\n     }\n     fn token_store() {\n         // store/save/load/get tokens for 4 IPs × 3 SNIs\n         ctx.qclient.store_token(Some(sni), *ip, &token).expect(\"store\");\n         ctx.qclient.save_tokens(TOKEN_FILE).expect(\"save\");\n         ctx2.qclient.load_tokens(TOKEN_FILE).expect(\"load\");\n         ctx2.qclient.get_token(Some(sni), *ip, false).expect(\"get\");\n     }\n     ```\n\n   - **`rs/fq/src/tests/transport_param.rs`** — Complete rewrite\n     ```rust\n     fn transport_param() {\n         let mut ctx = tls_api_init_ctx(&mut t, 0, None).expect(\"ctx\");\n         for (i, tp) in test_cases.iter().enumerate() {\n             transport_param_test_one(&mut ctx.qclient, tp, true).expect(...)\n             transport_param_test_one(&mut ctx.qserver, tp, false).expect(...)\n         }\n     }\n     fn transport_param_default() {\n         let mut ctx = tls_api_init_ctx(&mut t, 0, None).expect(\"ctx\");\n         for &id in param_ids { ctx.qserver.set_