  }\n12044\t\n12045\t    return ret;\n12046\t}\n12047\t\n12048\tint pn_random_test_one(int randomize_all)\n12049\t{\n12050\t    uint64_t simulated_time = 0;\n12051\t    uint64_t loss_mask = 0;\n12052\t    picoquic_test_tls_api_ctx_t* test_ctx = NULL;\n12053\t\n12054\t    picoquic_connection_id_t initial_cid = { {0xff, 0x12, 0x34, 0, 0, 0, 0, 0}, 8 };\n12055\t    int ret = tls_api_init_ctx_ex(&test_ctx, PICOQUIC_INTERNAL_TEST_VERSION_1, PICOQUIC_TEST_SNI, PICOQUIC_TEST_ALPN,\n12056\t        &simulated_time, NULL, NULL, 0, 1, 0, &initial_cid);\n12057\t\n12058\t    if (ret == 0 && test_ctx == NULL) {\n12059\t        ret = -1;\n12060\t    }\n12061\t\n12062\t    /* Set the initial packet number randomization */\n12063\t    if (ret == 0) {\n12064\t        picoquic_set_random_initial(test_ctx->qclient, (randomize_all) ? 2 : 1);\n12065\t        picoquic_set_random_initial(test_ctx->qserver, (randomize_all) ? 2 : 1);\n12066\t        picoquic_set_qlog(test_ctx->qserver, \".\");\n12067\t        /* The client connection is already created, so we force randomization of sequence numbers here */\n12068\t        for (picoquic_packet_context_enum pc = \n12069\t            (randomize_all)?picoquic_packet_context_application: picoquic_packet_context_initial;\n12070\t            pc < picoquic_nb_packet_context; pc++) {\n12071\t            test_ctx->cnx_client->pkt_ctx[pc].send_sequence = ((uint64_t)PICOQUIC_PN_RANDOM_MIN) + 17 + (uint64_t)pc;\n12072\t        }\n12073\t        /* Now, start the client connection */\n12074\t        ret = picoquic_start_client_cnx(test_ctx->cnx_client);\n12075\t    }\n12076\t\n12077\t    if (ret == 0){\n12078\t        ret = tls_api_connection_loop(test_ctx, 0, 0, &simulated_time);\n12079\t\n12080\t        if (ret != 0)\n12081\t        {\n12082\t            DBG_PRINTF(\"Connection loop returns error %d\\n\", ret);\n12083\t        }\n12084\t        else {\n12085\t            /* Check that the sequence numbers for all number spaces are larger than random minimum */\n12086\t            ret = pn_random_check_sequence(test_ctx->cnx_client, \"client\", randomize_all);\n12087\t            if (ret == 0) {\n12088\t                ret = pn_random_check_sequence(test_ctx->cnx_server, \"server\", randomize_all);\n12089\t            }\n12090\t        }\n12091\t    }\n12092\t    /* Complete the connection */\n12093\t    if (ret == 0) {\n12094\t        /* Prepare to send data */\n12095\t        ret = test_api_init_send_recv_scenario(test_ctx, test_scenario_q_and_r, sizeof(test_scenario_q_and_r));\n12096\t\n12097\t        /* Try to complete the data sending loop */\n12098\t        if (ret == 0) {\n12099\t            ret = tls_api_data_sending_loop(test_ctx, &loss_mask, &simulated_time, 0);\n12100\t        }\n12101\t\n12102\t        /* verify that the transmission was complete */\n12103\t        if (ret == 0) {\n12104\t            ret = tls_api_one_scenario_body_verify(test_ctx, &simulated_time, 1000000);\n12105\t        }\n12106\t    }\n12107\t\n12108\t    /* And then free the resource\n12109\t     */\n12110\t\n12111\t    if (test_ctx != NULL) {\n12112\t        tls_api_delete_ctx(test_ctx);\n12113\t        test_ctx = NULL;\n12114\t    }\n12115\t\n12116\t    return ret;\n12117\t}\n12118\t\n12119\tint pn_random_test(void)\n12120\t{\n12121\t\n12122\t    int ret = pn_random_test_one(0);\n12123\t\n12124\t    if (ret != 0) {\n12125\t        DBG_PRINTF(\"Randomize initials fails, ret = %d\", ret);\n12126\t    } else{\n12127\t        ret = pn_random_test_one(1);\n12128\t        if (ret != 0) {\n12129\t            DBG_PRINTF(\"Randomize all fails, ret = %d\", ret);\n12130\t        }\n12131\t    }\n12132\t\n12133\t    return ret;\n12134\t}\n12135\t\n12136\tint pn_random_init_test(void)\n12137\t{\n12138\t    int ret = pn_random_test_one(0);\n12139\t\n12140\t    return ret;\n12141\t}\n12142\t\n12143\t/* Test the stateless reset blowback control mechanism\n12144\t */\n12145\tint test_stateless_blowback_one(picoquic_quic_t* quic, uint64_t * simulated_time, int * was_sent)\n12146\t{\n12147\t    int ret = 0;\n12148\t    uint8_t bytes[PICOQUIC_MAX_PACKET_SIZE];\n12149\t    size_t length = PICOQUIC_MAX_PACKET_SIZE;\n12150\t    uint8_t filler;\n12151\t    struct sockaddr_in addr_peer, addr_srv;\n12152\t\n12153\t    *was_sent = 0;\n12154\t\n12155\t    /* Format random 1 RTT packet */\n12156\t    filler = 0xff ^ (((uint8_t)*simulated_time) & 0xff);\n12157\t    memset(bytes, filler, sizeof(bytes));\n12158\t    bytes[0] &= 0x7f;\n12159\t    picoquic_set_test_address(&addr_peer, 0x01010101, 1234);\n12160\t    picoquic_set_test_address(&addr_srv, 0x02020202, 4567);\n12161\t\n12162\t    /* Submit as incoming */\n12163\t    ret = picoquic_incoming_packet(quic, bytes, length, (struct sockaddr*) & addr_peer,\n12164\t        (struct sockaddr*) & addr_srv, 0, 0, *simulated_time);\n12165\t\n12166\t    /* Try read stateless packet */\n12167\t    if (ret == 0) {\n12168\t        picoquic_cnx_t* cnx;\n12169\t        picoquic_connection_id_t cid_log;\n12170\t        struct sockaddr_storage s_addr_to, s_addr_from;\n12171\t        int if_index;\n12172\t        ret = picoquic_prepare_next_packet(quic, *simulated_time, bytes, sizeof(bytes), &length,\n12173\t            &s_addr_to, &s_addr_from, &if_index, &cid_log, &cnx);\n12174\t        if (ret == 0 && length > 0) {\n12175\t            *was_sent = 1;\n12176\t        }\n12177\t    }\n12178\t\n12179\t    return ret;\n12180\t}\n12181\t\n12182\tint test_stateless_blowback(void)\n12183\t{\n12184\t    int was_sent = 0;\n12185\t    uint64_t new_interval = 2 * PICOQUIC_MICROSEC_STATELESS_RESET_INTERVAL_DEFAULT;\n12186\t\n12187\t    /* Create a context with the default timer. */\n12188\t    uint64_t simulated_time = 0;\n12189\t    picoquic_test_tls_api_ctx_t* test_ctx = NULL;\n12190\t\n12191\t    picoquic_connection_id_t initial_cid = { {0xb1, 0x08, 0xba, 0xcc, 0, 0, 0, 0}, 8 };\n12192\t    int ret = tls_api_init_ctx_ex(&test_ctx, PICOQUIC_INTERNAL_TEST_VERSION_1, PICOQUIC_TEST_SNI, PICOQUIC_TEST_ALPN,\n12193\t        &simulated_time, NULL, NULL, 0, 1, 0, &initial_cid);\n12194\t\n12195\t    if (test_ctx->qserver->stateless_reset_min_interval != PICOQUIC_MICROSEC_STATELESS_RESET_INTERVAL_DEFAULT) {\n12196\t        DBG_PRINTF(\"Stateless reset interval set to T=%\" PRIu64, test_ctx->qserver->stateless_reset_min_interval);\n12197\t        ret = -1;\n12198\t\n12199\t    }\n12200\t\n12201\t    /* Format a random packet and submit it, verify that the stateless reset is queued */\n12202\t    if (ret == 0) {\n12203\t        ret = test_stateless_blowback_one(test_ctx->qserver, &simulated_time, &was_sent);\n12204\t        if (ret == 0 && !was_sent) {\n12205\t            DBG_PRINTF(\"First stateless reset was not sent at T=%\" PRIu64, simulated_time);\n12206\t            ret = -1;\n12207\t        }\n12208\t    }\n12209\t\n12210\t    /* Progress by 1/2 specified interval, retry, it should not work  */\n12211\t    if (ret == 0) {\n12212\t        simulated_time += test_ctx->qserver->stateless_reset_min_interval;\n12213\t        ret = test_stateless_blowback_one(test_ctx->qserver, &simulated_time, &was_sent);\n12214\t        if (ret == 0 && !was_sent) {\n12215\t            DBG_PRINTF(\"Second stateless reset was not sent at T=%\" PRIu64, simulated_time);\n12216\t            ret = -1;\n12217\t        }\n12218\t    }\n12219\t    \n12220\t    /* Progress by 1x specified interval, retry, it should work  */\n12221\t    if (ret == 0) {\n12222\t        simulated_time += test_ctx->qserver->stateless_reset_min_interval / 2;\n12223\t        ret = test_stateless_blowback_one(test_ctx->qserver, &simulated_time, &was_sent);\n12224\t        if (ret == 0 && was_sent) {\n12225\t            DBG_PRINTF(\"Third stateless reset was sent at T=%\" PRIu64, simulated_time);\n12226\t            ret = -1;\n12227\t        }\n12228\t    }\n12229\t\n12230\t    /* Reset the interval to twice the previous value */\n12231\t    if (ret == 0) {\n12232\t        picoquic_set_default_stateless_reset_min_interval(test_ctx->qserver, new_interval);\n12233\t        if (test_ctx->qserver->stateless_reset_min_interval != new_interval) {\n12234\t            DBG_PRINTF(\"Stateless reset interval set to T=%\" PRIu64, test_ctx->qserver->stateless_reset_min_interval);\n12235\t            ret = -1;\n12236\t        }\n12237\t    }\n12238\t    \n12239\t    /* Progress by 0.75x new interval, retry, it should work  */\n12240\t    if (ret == 0) {\n12241\t        simulated_time += (new_interval - new_interval / 4);\n12242\t        ret = test_stateless_blowback_one(test_ctx->qserver, &simulated_time, &was_sent);\n12243\t        if (ret == 0 && !was_sent) {\n12244\t            DBG_PRINTF(\"After new interval,  stateless reset was not sent at T=%\" PRIu64, simulated_time);\n12245\t            ret = -1;\n12246\t        }\n12247\t    }\n12248\t\n12249\t    /* Reset the interval to zero */\n12250\t    if (ret == 0) {\n12251\t        picoquic_set_default_stateless_reset_min_interval(test_ctx->qserver, 0);\n12252\t        if (test_ctx->qserver->stateless_reset_min_interval != 0) {\n12253\t            DBG_PRINTF(\"Stateless reset interval set to T=%\" PRIu64, test_ctx->qserver->stateless_reset_min_interval);\n12254\t            ret = -1;\n12255\t        }\n12256\t    }\n12257\t\n12258\t    /* Try immediately, it should not work  */\n12259\t    if (ret == 0) {\n12260\t        ret = test_stateless_blowback_one(test_ctx->qserver, &simulated_time, &was_sent);\n12261\t        if (ret == 0 && !was_sent) {\n12262\t            DBG_PRINTF(\"After zero interval,  stateless reset was not sent at T=%\" PRIu64, simulated_time);\n12263\t            ret = -1;\n12264\t        }\n12265\t    }\n12266\t\n12267\t    /* Add 1 microsec, it should work  */\n12268\t    if (ret == 0) {\n12269\t        simulated_time += 1;\n12270\t        ret = test_stateless_blowback_one(test_ctx->qserver, &simulated_time, &was_sent);\n12271\t        if (ret == 0 && !was_sent) {\n12272\t            DBG_PRINTF(\"After zero +1 interval,  stateless reset was not sent at T=%\" PRIu64, simulated_time);\n12273\t            ret = -1;\n12274\t        }\n12275\t    }\n12276\t\n12277\t    /* Free the resurce and return */\n12278\t    if (test_ctx != NULL) {\n12279\t        tls_api_delete_ctx(test_ctx);\n12280\t        test_ctx = NULL;\n12281\t    }\n12282\t\n12283\t    return ret;\n12284\t}\n12285\t\n12286\t/* Test that random padding of coalesced packets has no unexpected side effects.\n12287\t */\n12288\tchar const* random_padding_text_log = \"random_padding_log.txt\";\n12289\t\n12290\tint random_padding_test_one(size_t pad_length, uint64_t* random_context, uint8_t test_id)\n12291\t{\n12292\t    int ret;\n12293\t    uint64_t simulated_time = 0;\n12294\t    uint64_t loss_mask = 0;\n12295\t    picoquic_test_tls_api_ctx_t* test_ctx = NULL;\n12296\t    uint32_t proposed_version = PICOQUIC_INTEROP_VERSION_LATEST;\n12297\t    picoquictest_sim_packet_t* packet = picoquictest_sim_link_create_packet();\n12298\t    picoquic_connection_id_t initial_cid = { {0x8a, 0x8d, 0x08, 0x9a, 0xdd, 0, 0, 0}, 8 };\n12299\t\n12300\t    ret = picoquic_save_tickets(NULL, simulated_time, ticket_file_name);\n12301\t    initial_cid.id[5] = test_id;\n12302\t    \n12303\t    ret = tls_api_init_ctx_ex(&test_ctx, proposed_version, PICOQUIC_TEST_SNI, PICOQUIC_TEST_ALPN, &simulated_time,\n12304\t            ticket_file_name, NULL, 0, 0, 0, &initial_cid);\n12305\t\n12306\t    if (ret != 0 || packet == NULL)\n12307\t    {\n12308\t        DBG_PRINTF(\"Could not create the QUIC test contexts for V=%x\\n\", proposed_version);\n12309\t        ret = -1;\n12310\t    }\n12311\t\n12312\t    if (ret == 0) {\n12313\t        /* Start logging on the server */\n12314\t        picoquic_set_textlog(test_ctx->qserver, random_padding_text_log);\n12315\t        picoquic_set_qlog(test_ctx->qserver, \".\");\n12316\t        test_ctx->qserver->use_long_log = 1;\n12317\t    }\n12318\t\n12319\t    if (ret == 0) {\n12320\t        /* Prepare a first packet from the client to the server */\n12321\t        ret = picoquic_prepare_packet(test_ctx->cnx_client, simulated_time,\n12322\t            packet->bytes, PICOQUIC_MAX_PACKET_SIZE, &packet->length,\n12323\t            &packet->addr_to, &packet->addr_from, NULL);\n12324\t        picoquic_store_addr(&packet->addr_from, (struct sockaddr*) & test_ctx->client_addr);\n12325\t\n12326\t        if (packet->length == 0) {\n12327\t            ret = PICOQUIC_ERROR_UNEXPECTED_ERROR;\n12328\t        }\n12329\t        if (ret != 0)\n12330\t        {\n12331\t            DBG_PRINTF(\"Could not create first client packet, ret=%x\\n\", ret);\n12332\t        }\n12333\t        else if (packet->length + pad_length > PICOQUIC_MAX_PACKET_SIZE) {\n12334\t            DBG_PRINTF(\"Cannot insert %uz bytes after length %uz\\n\", pad_length, packet->length);\n12335\t            ret = -1;\n12336\t        }\n12337\t        else {\n12338\t            /* Insert random padding */\n12339\t            picoquic_test_random_bytes(random_context, packet->bytes + packet->length, pad_length);\n12340\t            packet->bytes[packet->length] |= 0x80;\n12341\t            packet->length += pad_length;\n12342\t            simulated_time += test_ctx->c_to_s_link->microsec_latency;\n12343\t\n12344\t            ret = picoquic_incoming_packet(test_ctx->qserver, packet->bytes, (uint32_t)packet->length,\n12345\t                (struct sockaddr*) & packet->addr_from,\n12346\t                (struct sockaddr*) & packet->addr_to, 0, test_ctx->recv_ecn_server,\n12347\t                simulated_time);\n12348\t\n12349\t            if (ret == 0) {\n12350\t                picoquic_cnx_t* next = test_ctx->qserver->cnx_list;\n12351\t\n12352\t                while (next != NULL && picoquic_compare_connection_id(&next->initial_cnxid, &test_ctx->cnx_client->initial_cnxid) != 0) {\n12353\t                    next = next->next_in_table;\n12354\t                }\n12355\t\n12356\t                if (next != NULL) {\n12357\t                    test_ctx->cnx_server = next;\n12358\t                }\n12359\t                else {\n12360\t                    ret = -1;\n12361\t                    DBG_PRINTF(\"Could not create server side connection, ret = %d\\n\", ret);\n12362\t                }\n12363\t            }\n12364\t        }\n12365\t    }\n12366\t\n12367\t    if (ret == 0) {\n12368\t        /* Perform a connection loop to verify it goes OK */\n12369\t        ret = tls_api_connection_loop(test_ctx, &loss_mask,\n12370\t            2*test_ctx->c_to_s_link->microsec_latency, &simulated_time);\n12371\t\n12372\t        if (ret != 0)\n12373\t        {\n12374\t            DBG_PRINTF(\"Connection loop returns %d\\n\", ret);\n12375\t        }\n12376\t    }\n12377\t\n12378\t    if (test_ctx != NULL) {\n12379\t        tls_api_delete_ctx(test_ctx);\n12380\t        test_ctx = NULL;\n12381\t    }\n12382\t\n12383\t    if (packet != NULL) {\n12384\t        free(packet);\n12385\t    }\n12386\t\n12387\t    return ret;\n12388\t}\n12389\t\n12390\tint random_padding_test(void)\n12391\t{\n12392\t    uint64_t random_context = 0x1234567890abcdef;\n12393\t\n12394\t    int ret = random_padding_test_one(128, &random_context, 0);\n12395\t\n12396\t    if (ret == 0) {\n12397\t        ret = random_padding_test_one(16, &random_context, 1);\n12398\t    }\n12399\t\n12400\t    return ret;\n12401\t}\n12402\t\n12403\t/* Test closing a connection with a specific error message.\n12404\t */\n12405\t\n12406\tchar const* error_reason_text_log = \"error_reason_log.txt\";\n12407\t\n12408\tint error_reason_test(void)\n12409\t{\n12410\t    uint64_t simulated_time = 0;\n12411\t    uint64_t loss_mask = 0;\n12412\t    picoquic_test_tls_api_ctx_t* test_ctx = NULL;\n12413\t    picoquic_connection_id_t initial_cid = { {0xe8, 0x80, 0x88, 0xea, 0x50, 0, 0, 0}, 8 };\n12414\t    int ret = tls_api_init_ctx_ex(&test_ctx, PICOQUIC_INTERNAL_TEST_VERSION_1, PICOQUIC_TEST_SNI, PICOQUIC_TEST_ALPN,\n12415\t        &simulated_time, NULL, NULL, 0, 1, 0, &initial_cid);\n12416\t\n12417\t    if (ret == 0 && test_ctx == NULL) {\n12418\t        ret = -1;\n12419\t    }\n12420\t\n12421\t    if (ret == 0) {\n12422\t        /* Request the logs on the server side, so manual inspection can verify that\n12423\t         * the error reason is properly displayed. */\n12424\t        picoquic_set_textlog(test_ctx->qserver, error_reason_text_log);\n12425\t        test_ctx->qserver->use_long_log = 1;\n12426\t        picoquic_set_qlog(test_ctx->qserver, \".\");\n12427\t        /* Now, start the client connection */\n12428\t        ret = picoquic_start_client_cnx(test_ctx->cnx_client);\n12429\t    }\n12430\t\n12431\t    if (ret == 0) {\n12432\t        /* Perform a connection loop to verify it goes OK */\n12433\t        ret = tls_api_connection_loop(test_ctx, &loss_mask,\n12434\t            2 * test_ctx->c_to_s_link->microsec_latency, &simulated_time);\n12435\t\n12436\t        if (ret != 0)\n12437\t        {\n12438\t            DBG_PRINTF(\"Connection loop returns %d\\n\", ret);\n12439\t        }\n12440\t    }\n12441\t\n12442\t    if (ret == 0) {\n12443\t        /* force closure of the client connection with an internal error */\n12444\t        int local_error_ret = picoquic_connection_error_ex(test_ctx->cnx_client, PICOQUIC_TRANSPORT_INTERNAL_ERROR,\n12445\t            0, \"error reason test\");\n12446\t        if (local_error_ret != PICOQUIC_ERROR_DETECTED) {\n12447\t            DBG_PRINTF(\"picoquic_connection_error_ex returns %d\\n\", ret);\n12448\t            ret = -1;\n12449\t        }\n12450\t    }\n12451\t\n12452\t    if (ret == 0) {\n12453\t        /* verify that the connection will be closed */\n12454\t        int nb_trials = 0;\n12455\t        int nb_inactive = 0;\n12456\t        while (ret == 0 && nb_trials < 1024 && nb_inactive < 512 ) {\n12457\t            int was_active = 0;\n12458\t            nb_trials++;\n12459\t\n12460\t            ret = tls_api_one_sim_round(test_ctx, &simulated_time, 0, &was_active);\n12461\t\n12462\t            if (test_ctx->cnx_client->cnx_state == picoquic_state_disconnected &&\n12463\t                (test_ctx->cnx_server == NULL || test_ctx->cnx_server->cnx_state == picoquic_state_disconnected)) {\n12464\t                break;\n12465\t            }\n12466\t\n12467\t            if (nb_trials == 512) {\n12468\t                DBG_PRINTF(\"After %d trials, client state = %d, server state = %d\",\n12469\t                    nb_trials, (int)test_ctx->cnx_client->cnx_state,\n12470\t                    (test_ctx->cnx_server == NULL) ? -1 : test_ctx->cnx_server->cnx_state);\n12471\t            }\n12472\t\n12473\t            if (was_active) {\n12474\t                nb_inactive = 0;\n12475\t            }\n12476\t            else {\n12477\t                nb_inactive++;\n12478\t            }\n12479\t        }\n12480\t    }\n12481\t    /* Close the contexts, which will close the logs.\n12482\t     */\n12483\t\n12484\t    if (test_ctx != NULL) {\n12485\t        tls_api_delete_ctx(test_ctx);\n12486\t        test_ctx = NULL;\n12487\t    }\n12488\t\n12489\t    return ret;\n12490\t}\n12491\t /* Test of the blocked ports functionality\n12492\t  */\n12493\t\n12494\tint port_blocked_test_one(picoquic_quic_t * quic,\n12495\t    uint8_t* packet, size_t packet_length, \n12496\t    struct sockaddr* addr_from, struct sockaddr* addr_to,\n12497\t    int expect_blocked, int retry_accepted, uint64_t current_time)\n12498\t{\n12499\t    uint8_t send_buffer[PICOQUIC_MAX_PACKET_SIZE];\n12500\t    struct sockaddr_storage s_to;\n12501\t    struct sockaddr_storage s_from;\n12502\t    int if_index = 0;\n12503\t    picoquic_cnx_t* first_cnx = NULL;\n12504\t    picoquic_cnx_t* last_cnx = NULL;\n12505\t    size_t send_length = 0;\n12506\t    picoquic_connection_id_t log_cid = { 0 };\n12507\t\n12508\t\n12509\t    int ret = picoquic_incoming_packet_ex(quic, packet, packet_length, addr_from, addr_to, 0, 0, &first_cnx, current_time);\n12510\t\n12511\t    if (ret == 0) {\n12512\t        ret = picoquic_prepare_next_packet_ex(quic, current_time, send_buffer, PICOQUIC_MAX_PACKET_SIZE, &send_length, &s_to, &s_from, &if_index, &log_cid, &last_cnx, NULL);\n12513\t    }\n12514\t\n12515\t    if (ret == 0) {\n12516\t        if (send_length > 0 && expect_blocked) {\n12517\t            /* TODO: check whether the \"blocked\" packet is a stateless retry */\n12518\t            uint8_t flags;\n12519\t            uint32_t vn;\n12520\t            const uint8_t* bytes;\n12521\t            int version_index;\n12522\t\n12523\t            ret = -1;\n12524\t\n12525\t            if (retry_accepted) {\n12526\t                if ((bytes = picoquic_frames_uint8_decode(send_buffer, &send_buffer[send_length], &flags)) != NULL &&\n12527\t                    (bytes = picoquic_frames_uint32_decode(bytes, &send_buffer[send_length], &vn)) != NULL &&\n12528\t                    (version_index = picoquic_get_version_index(vn)) >= 0) {\n12529\t                    picoquic_packet_type_enum p_type = picoquic_parse_long_packet_type(flags, version_index);\n12530\t                    if (p_type == picoquic_packet_retry) {\n12531\t                        ret = 0;\n12532\t                    }\n12533\t                }\n12534\t            }\n12535\t        }\n12536\t        else if (send_length == 0 && !expect_blocked) {\n12537\t            ret = -1;\n12538\t        }\n12539\t    }\n12540\t\n12541\t    return ret;\n12542\t}\n12543\t\n12544\tint port_blocked_test_address(\n12545\t    struct sockaddr* addr_from, struct sockaddr* addr_to,\n12546\t    int expect_blocked, int do_disable)\n12547\t{\n12548\t    /* Create a series of connection contexts for the list of port */\n12549\t    uint8_t send_buffer[PICOQUIC_MAX_PACKET_SIZE];\n12550\t    struct sockaddr_storage s_to;\n12551\t    struct sockaddr_storage s_from;\n12552\t    size_t send_length;\n12553\t    int if_index;\n12554\t    picoquic_connection_id_t log_cid;\n12555\t    picoquic_cnx_t* last_cnx;\n12556\t    uint64_t simulated_time = 0;\n12557\t    picoquic_test_tls_api_ctx_t* test_ctx = NULL;\n12558\t    int ret = tls_api_init_ctx(&test_ctx, PICOQUIC_V1_VERSION, PICOQUIC_TEST_SNI, PICOQUIC_TEST_ALPN, &simulated_time, NULL, NULL, 0, 1, 0);\n12559\t    if (ret == 0) {\n12560\t        /* Delete the default connection */\n12561\t        picoquic_delete_cnx(test_ctx->cnx_client);\n12562\t        /* Set prot blocking to expected value */\n12563\t        picoquic_disable_port_blocking(test_ctx->qserver, do_disable);\n12564\t    }\n12565\t    /* Perform the VN test */\n12566\t    if (ret == 0) {\n12567\t        memset(send_buffer, 0xaa, PICOQUIC_ENFORCED_INITIAL_MTU);\n12568\t        send_buffer[1] = 0xa1;\n12569\t        send_buffer[2] = 0xa2;\n12570\t        send_buffer[3] = 0xa3;\n12571\t        send_buffer[4] = 0xa4;\n12572\t        send_buffer[5] = 8;\n12573\t        send_buffer[14] = 8;\n12574\t        send_length = PICOQUIC_ENFORCED_INITIAL_MTU;\n12575\t        simulated_time += 1000;\n12576\t        ret = port_blocked_test_one(test_ctx->qserver, send_buffer, send_length, addr_from, addr_to, expect_blocked, 0, simulated_time);\n12577\t        if (ret != 0) {\n12578\t            DBG_PRINTF(\"VN blocked test fails, ret = %d\", ret);\n12579\t        }\n12580\t    }\n12581\t    /* test the 1RTT function */\n12582\t    if (ret == 0) {\n12583\t        memset(send_buffer, 0xbb, PICOQUIC_ENFORCED_INITIAL_MTU);\n12584\t        send_buffer[0] = 0x7f;\n12585\t        send_length = PICOQUIC_ENFORCED_INITIAL_MTU;\n12586\t        simulated_time += 1000;\n12587\t        ret = port_blocked_test_one(test_ctx->qserver, send_buffer, send_length, addr_from, addr_to, expect_blocked, 0, simulated_time);\n12588\t        if (ret != 0) {\n12589\t            DBG_PRINTF(\"Stateless blocked test fails, ret = %d\", ret);\n12590\t        }\n12591\t    }\n12592\t    if (ret == 0) {\n12593\t        /* Create the client connection with correct address */\n12594\t        simulated_time += 1000;\n12595\t        test_ctx->cnx_client = picoquic_create_cnx(test_ctx->qclient,\n12596\t            picoquic_null_connection_id,\n12597\t            picoquic_null_connection_id,\n12598\t            addr_to, simulated_time,\n12599\t            PICOQUIC_V1_VERSION, PICOQUIC_TEST_SNI, PICOQUIC_TEST_ALPN, 1);\n12600\t        if (test_ctx->cnx_client == NULL) {\n12601\t            ret = -1;\n12602\t        }\n12603\t        else {\n12604\t            ret = picoquic_start_client_cnx(test_ctx->cnx_client);\n12605\t            if (ret != 0) {\n12606\t                DBG_PRINTF(\"Cannot start client connection, ret = %d\", ret);\n12607\t            }\n12608\t            else {\n12609\t                ret = picoquic_prepare_next_packet_ex(test_ctx->qclient, simulated_time, send_buffer, PICOQUIC_ENFORCED_INITIAL_MTU, &send_length, &s_to, &s_from, &if_index, &log_cid, &last_cnx, NULL);\n12610\t                if (ret == 0 && send_length == 0) {\n12611\t                    ret = -1;\n12612\t                }\n12613\t                if (ret == 0) {\n12614\t                    ret = port_blocked_test_one(test_ctx->qserver, send_buffer, send_length, addr_from, addr_to, expect_blocked, 1, simulated_time);\n12615\t                    if (ret != 0) {\n12616\t                        DBG_PRINTF(\"Initial blocked test fails, ret = %d\", ret);\n12617\t                    }\n12618\t                }\n12619\t            }\n12620\t        }\n12621\t    }\n12622\t    /* Delete the context */\n12623\t    if (test_ctx != NULL) {\n12624\t        tls_api_delete_ctx(test_ctx);\n12625\t        test_ctx = NULL;\n12626\t    }\n12627\t\n12628\t    return ret;\n12629\t}\n12630\t\n12631\tint port_blocked_test_port(uint16_t port, int expect_blocked)\n12632\t{\n12633\t    int ret = 0;\n12634\t    struct sockaddr_storage a_from = { 0 };\n12635\t    struct sockaddr_storage a_to = { 0 };\n12636\t    char const* a_from_t[2] = { \"1.1.1.1\", \"2001:2:3::4\" };\n12637\t    char const* a_to_t[2] = { \"10.0.0.1\", \"2002:3::4\" };\n12638\t\n12639\t    for (int a_x = 0; ret == 0 && a_x < 2; a_x++) {\n12640\t        /* set the addresses */\n12641\t        if (ret == 0) {\n12642\t            int is_name = 0;\n12643\t            ret = picoquic_get_server_address(a_from_t[a_x], port, &a_from, &is_name);\n12644\t            if (ret == 0 && is_name) {\n12645\t                ret = -1;\n12646\t            }\n12647\t        }\n12648\t        if (ret == 0) {\n12649\t            int is_name = 0;\n12650\t            ret = picoquic_get_server_address(a_to_t[a_x], 961, &a_to, &is_name);\n12651\t            if (ret == 0 && is_name) {\n12652\t                ret = -1;\n12653\t            }\n12654\t        }\n12655\t        /* Iterate for blocked or not */\n12656\t        for (int do_disable = 0; ret == 0 && do_disable < 2; do_disable++) {\n12657\t            int actually_blocked = expect_blocked && (do_disable == 0);\n12658\t\n12659\t            ret = port_blocked_test_address((struct sockaddr*)&a_from,\n12660\t                (struct sockaddr*)&a_to, actually_blocked, do_disable);\n12661\t            if (ret != 0) {\n12662\t                DBG_PRINTF(\"For [%s]:%u, test (%d (%d), %d) fails.\",\n12663\t                    a_from_t[a_x], port, expect_blocked, actually_blocked, do_disable);\n12664\t            }\n12665\t        }\n12666\t    } \n12667\t    return ret;\n12668\t}\n12669\t\n12670\tint port_blocked_test(void)\n12671\t{\n12672\t    int ret = 0;\n12673\t    const uint16_t blocked_port_to_test[] = { 0, 53, 138, 1900, 5353, 11211 };\n12674\t    const uint16_t unblocked_port_to_test[] = { 443, 4433, 33721 };\n12675\t    size_t nb_blocked = sizeof(blocked_port_to_test) / sizeof(uint16_t);\n12676\t    size_t nb_unblocked = sizeof(unblocked_port_to_test) / sizeof(uint16_t);\n12677\t\n12678\t    for (size_t i = 0; ret == 0 && i < nb_blocked; i++) {\n12679\t        ret = port_blocked_test_port(blocked_port_to_test[i], 1);\n12680\t    }\n12681\t\n12682\t    for (size_t i = 0; ret == 0 && i < nb_unblocked; i++) {\n12683\t        ret = port_blocked_test_port(unblocked_port_to_test[i], 0);\n12684\t    }\n12685\t\n12686\t    return ret;\n12687\t}\n12688\t\n12689\t/* Test the immediate ACK function.\n12690\t */\n12691\tint immediate_ack_test(void)\n12692\t{\n12693\t    uint64_t simulated_time = 0;\n12694\t    uint64_t loss_mask = 0;\n12695\t    picoquic_test_tls_api_ctx_t* test_ctx = NULL;\n12696\t    picoquic_connection_id_t initial_cid = { {0x1a, 0x1a, 0x1a, 0x1a, 0x1a, 0x1a, 0x1a, 0x1a}, 8 };\n12697\t    int ret;\n12698\t\n12699\t    ret = tls_api_init_ctx_ex(&test_ctx, PICOQUIC_INTERNAL_TEST_VERSION_1,\n12700\t        PICOQUIC_TEST_SNI, PICOQUIC_TEST_ALPN, &simulated_time, NULL, NULL, 0, 0, 0, &initial_cid);\n12701\t\n12702\t    if (ret == 0) {\n12703\t        picoquic_set_qlog(test_ctx->qserver, \".\");\n12704\t    }\n12705\t\n12706\t    if (ret == 0) {\n12707\t        ret = tls_api_connection_loop(test_ctx, &loss_mask, 0, &simulated_time);\n12708\t    }\n12709\t\n12710\t    if (ret == 0) {\n12711\t        ret = wait_client_connection_ready(test_ctx, &simulated_time);\n12712\t    }\n12713\t\n12714\t    if (ret == 0) {\n12715\t        int nb_trials = 0;\n12716\t        int was_active;\n12717\t        uint64_t immediate_received_at_server = 0;\n12718\t        uint64_t immediate_cleared_at_server = 0;\n12719\t        int all_acked = 0;\n12720\t        uint8_t immediate_ack_frame[2] = { picoquic_frame_type_immediate_ack };\n12721\t        /* Queue misc frame with \"Immediate ACK\" set */\n12722\t        picoquic_queue_misc_frame(test_ctx->cnx_client, immediate_ack_frame, 2, 0,\n12723\t            picoquic_packet_context_application);\n12724\t        /* Do couple of rounds until the frame is received;\n12725\t         * Check that it is received my verifying that the \"immediate ACK\" \n12726\t         * is set in the ACK context at the server. Check the time.\n12727\t         */\n12728\t        while (ret == 0 && nb_trials < 16) {\n12729\t            nb_trials++;\n12730\t            ret = tls_api_one_sim_round(test_ctx, &simulated_time, 0, &was_active);\n12731\t            if (test_ctx->cnx_server != NULL &&\n12732\t                test_ctx->cnx_server->ack_ctx[picoquic_packet_context_application].act[0].is_immediate_ack_required) {\n12733\t                immediate_received_at_server = simulated_time;\n12734\t                break;\n12735\t            }\n12736\t        }\n12737\t        if (ret == 0 && immediate_received_at_server == 0) {\n12738\t            DBG_PRINTF(\"Immediate ACK not received after %d rounds\", nb_trials);\n12739\t            ret = -1;\n12740\t        }\n12741\t        /* Do a couple rounds until the \"immediate ACK\" flag is not\n12742\t         * set at the server anymore. Verify that no time is elapsed since\n12743\t         * the end of the previous round */\n12744\t        nb_trials = 0;\n12745\t        while (ret == 0 && nb_trials < 16) {\n12746\t            nb_trials++;\n12747\t            ret = tls_api_one_sim_round(test_ctx, &simulated_time, 0, &was_active);\n12748\t            if (test_ctx->cnx_server != NULL &&\n12749\t                !test_ctx->cnx_server->ack_ctx[picoquic_packet_context_application].act[0].is_immediate_ack_required) {\n12750\t                immediate_cleared_at_server = simulated_time;\n12751\t                break;\n12752\t            }\n12753\t        }\n12754\t        if (ret != 0){\n12755\t            if (immediate_cleared_at_server == 0) {\n12756\t                DBG_PRINTF(\"Immediate ACK not cleared after %d rounds\", nb_trials);\n12757\t                ret = -1;\n12758\t            }\n12759\t            else if (immediate_cleared_at_server != immediate_received_at_server) {\n12760\t                DBG_PRINTF(\"ACK not quite immediate, set at: %\" PRIu64 \", cleared at %\" PRIu64,\n12761\t                    immediate_received_at_server, immediate_cleared_at_server);\n12762\t                ret = -1;\n12763\t            }\n12764\t        }\n12765\t        /* Do couple rounds until the ACK is received at the client. \n12766\t         * This is verified by checking that the client ACK queue is\n12767\t         * empty.\n12768\t         */\n12769\t        nb_trials = 0;\n12770\t        while (ret == 0 && nb_trials < 32) {\n12771\t            nb_trials++;\n12772\t            ret = tls_api_one_sim_round(test_ctx, &simulated_time, 0, &was_active);\n12773\t            if (test_ctx->cnx_client != NULL && \n12774\t                picoquic_is_cnx_backlog_empty(test_ctx->cnx_client)) {\n12775\t                all_acked = 1;\n12776\t                break;\n12777\t            }\n12778\t        }\n12779\t        if (ret == 0 && !all_acked) {\n12780\t            DBG_PRINTF(\"ACK was not received at: %\" PRIu64, simulated_time);\n12781\t            ret = -1;\n12782\t        }\n12783\t    }\n12784\t\n12785\t    if (test_ctx != NULL) {\n12786\t        tls_api_delete_ctx(test_ctx);\n12787\t        test_ctx = NULL;\n12788\t    }\n12789\t\n12790\t    return ret;\n12791\t}\n12792\t\n12793\t/* Testing the key logging facility.\n12794\t */\n12795\t#define TEST_KEYLOG_FILE_CLIENT \"test_keylog_client.txt\"\n12796\t#define TEST_KEYLOG_FILE_SERVER \"test_keylog_server.txt\"\n12797\t\n12798\tstatic void keylog_reset_file(char const* file_name)\n12799\t{\n12800\t    FILE* F = picoquic_file_open(file_name, \"w\");\n12801\t    if (F != NULL) {\n12802\t        (void)picoquic_file_close(F);\n12803\t    }\n12804\t}\n12805\t\n12806\tstatic size_t keylog_file_size(char const* file_name)\n12807\t{\n12808\t    size_t sz = 0;\n12809\t    FILE* F = picoquic_file_open(file_name, \"r\");\n12810\t    if (F != NULL) {\n12811\t        fseek(F, 0, SEEK_END);\n12812\t        sz = ftell(F);\n12813\t        (void)picoquic_file_close(F);\n12814\t    }\n12815\t    return(sz);\n12816\t}\n12817\t\n12818\tint keylog_test(void)\n12819\t{\n12820\t    uint64_t simulated_time = 0;\n12821\t    picoquic_test_tls_api_ctx_t* test_ctx = NULL;\n12822\t    picoquic_connection_id_t initial_cid = { {0x55, 0x17, 0xe9, 0x10, 0x90, 0x0, 0x