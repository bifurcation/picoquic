_tp_value` for 28 different TP parameter IDs and\n50\t/// verifies each is accepted without error.\n51\t#[test]\n52\tfn transport_param_default() {\n53\t    let mut t = Instant::from_ticks(0);\n54\t    let mut ctx = tls_api_init_ctx(&mut t, 0, None).expect(\"ctx\");\n55\t\n56\t    let param_ids: &[u64] = &[\n57\t        0x00,               // initial_max_stream_data_bidi_local\n58\t        0x01,               // initial_max_data\n59\t        0x02,               // initial_max_stream_id_bidi\n60\t        0x03,               // max_idle_timeout\n61\t        0x04,               // preferred_address (skip, complex)\n62\t        0x05,               // max_packet_size\n63\t        0x06,               // stateless_reset_token\n64\t        0x07,               // ack_delay_exponent\n65\t        0x08,               // initial_max_stream_id_uni\n66\t        0x09,               // migration_disabled\n67\t        0x0a,               // initial_max_stream_data_bidi_remote\n68\t        0x0b,               // initial_max_stream_data_uni\n69\t        0x0c,               // max_ack_delay\n70\t        0x0d,               // original_destination_connection_id\n71\t        0x0e,               // retry_source_connection_id\n72\t        0x0f,               // version_negotiation\n73\t        0x10,               // max_datagram_frame_size\n74\t        0x20,               // enable_loss_bit\n75\t        0x7157,             // grease_quic_bit\n76\t        0x2ab2,             // enable_time_stamp\n77\t        0x4143,             // min_ack_delay\n78\t        0xff02de1a,         // enable_bdp_frame\n79\t        0x0f739bbc1b666d04, // initial_max_path_id\n80\t    ];\n81\t\n82\t    for &id in param_ids {\n83\t        ctx.qserver\n84\t            .set_default_tp_value(id, 0)\n85\t            .unwrap_or_else(|e| panic!(\"set_default_tp_value({id:#x}): {e:?}\"));\n86\t    }\n87\t}\n88\t\n89\t/// C: `transport_param_log_test` in `picoquictest/transport_param_test.c`.\n90\t///\n91\t/// Logs the text rendering of the test TP vectors to `log_tp_test.txt` and\n92\t/// compares the output against the reference file `log_tp_test_ref.txt`.\n93\t#[test]\n94\tfn transport_param_log() {\n95\t    transport_param_log_test_one(\"log_tp_test.txt\").expect(\"log_tp\");\n96\t    compare_text_files(\"log_tp_test.txt\", \"picoquictest/log_tp_test_ref.txt\").expect(\"compare_log\");\n97\t}\n98\t\n99\t/// C: `vn_tp_test` in `picoquictest/transport_param_test.c`.\n100\t///\n101\t/// Runs 16 version-negotiation TP test cases: 8 client-side and 8 server-side,\n102\t/// each with good or bad version-negotiation extension encodings.\n103\t#[test]\n104\tfn vn_tp() {\n105\t    for test_id in 0..8 {\n106\t        vn_tp_test_one(test_id, true, test_id < 4)\n107\t            .unwrap_or_else(|e| panic!(\"client vn_tp[{test_id}]: {e:?}\"));\n108\t        vn_tp_test_one(test_id, false, test_id < 4)\n109\t            .unwrap_or_else(|e| panic!(\"server vn_tp[{test_id}]: {e:?}\"));\n110\t    }\n111\t}\n112\t"}]},"parent_tool_use_id":null,"session_id":"782f2f02-5f93-4f6f-b663-2ef2c783a0cf","uuid":"7567b8c8-e655-4cc7-b1ef-e674cd1906ab","timestamp":"2026-05-05T12:57:36.806Z","tool_use_result":{"type":"text","file":{"filePath":"/Users/richbarn/Projects/picoquic/rs/fq/src/tests/transport_param.rs","content":"//! Test cases for `picoquictest/transport_param_test.c`.\n\n#![allow(non_snake_case)]\n\nuse crate::Instant;\nuse crate::tests::util::{\n    compare_text_files, tls_api_init_ctx, transport_param_log_test_one, transport_param_test_one,\n    vn_tp_test_one,\n};\nuse crate::tp::TransportParameters;\n\n/// C: `transport_param_test` in `picoquictest/transport_param_test.c`.\n///\n/// Encodes 11+ predefined `TransportParameters` structures, decodes each,\n/// and verifies the round-trip produces bit-for-bit identical output.\n/// Also exercises fuzz vectors (truncated / malformed encodings) to confirm\n/// they are rejected.\n#[test]\nfn transport_param() {\n    let mut t = Instant::from_ticks(0);\n 