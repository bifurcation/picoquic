{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01Q2qg56AjCj5nUXaLBBhB4X","type":"tool_result","content":"100\t    uint64_t simulated_time = 0;\n101\t    picoquic_connection_id_t initial_cid = { {0x81, 0xf1, 0, 0, 0, 0, 0, 0}, 8 };\n102\t    picoquic_test_tls_api_ctx_t* test_ctx = NULL;\n103\t    uint64_t loss_mask = 0;\n104\t    int ret = 0;\n105\t    \n106\t    initial_cid.id[2] = test_id;\n107\t\n108\t    ret = tls_api_one_scenario_init_ex(&test_ctx, &simulated_time, PICOQUIC_INTERNAL_TEST_VERSION_1, NULL, NULL, &initial_cid);\n109\t\n110\t    if (ret == 0 && test_ctx == NULL) {\n111\t        ret = -1;\n112\t    }\n113\t\n114\t    if (ret == 0) {\n115\t        picoquic_set_default_congestion_algorithm_ex(test_ctx->qserver, spec->ccalgo, spec->cc_algo_option);\n116\t        picoquic_set_congestion_algorithm_ex(test_ctx->cnx_client, spec->ccalgo, spec->cc_algo_option);\n117\t\n118\t        test_ctx->c_to_s_link->microsec_latency = spec->latency;\n119\t        test_ctx->s_to_c_link->microsec_latency = spec->latency;\n120\t        test_ctx->immediate_exit = 1;\n121\t\n122\t        picoquic_cnx_set_pmtud_required(test_ctx->cnx_client, 1);\n123\t\n124\t        /* set the binary logs on both sides */\n125\t        picoquic_set_qlog(test_ctx->qclient, \".\");\n126\t        picoquic_set_qlog(test_ctx->qserver, \".\");\n127\t        picoquic_set_log_level(test_ctx->qserver, 1);\n128\t        picoquic_set_log_level(test_ctx->qclient, 1);\n129\t        test_ctx->qclient->use_long_log = 1;\n130\t        test_ctx->qserver->use_long_log = 1;\n131\t        /* Initialize the client connection */\n132\t        picoquic_start_client_cnx(test_ctx->cnx_client);\n133\t    }\n134\t\n135\t    /* establish the connection */\n136\t    if (ret == 0) {\n137\t        ret = tls_api_connection_loop(test_ctx, &loss_mask, spec->queue_max_delay, &simulated_time);\n138\t    }\n139\t\n140\t    /* wait until the client (and thus the server) is ready */\n141\t    if (ret == 0) {\n142\t        ret = wait_client_connection_ready(test_ctx, &simulated_time);\n143\t    }\n144\t\n145\t    /* Prepare to send data */\n146\t    if (ret == 0) {\n147\t        ret = test_api_init_send_recv_scenario(test_ctx, test_scenario_wifi, sizeof(test_scenario_wifi));\n148\t\n149\t        if (ret != 0)\n150\t        {\n151\t            DBG_PRINTF(\"Init send receive scenario returns %d\\n\", ret);\n152\t        }\n153\t    }\n154\t\n155\t    if (ret == 0) {\n156\t        for (size_t i = 0; i < spec->nb_suspend; i++) {\n157\t            ret = tls_api_wait_for_timeout(test_ctx, &simulated_time, spec->suspension[i].suspend_time - simulated_time);\n158\t            if (ret == 0) {\n159\t                /* suspension blocks both directions, as the client can neither send not receive */\n160\t                uint64_t resume_time = spec->suspension[i].suspend_time + spec->suspension[i].suspend_interval;\n161\t                picoquic_test_simlink_suspend(test_ctx->c_to_s_link, resume_time, 0);\n162\t                picoquic_test_simlink_suspend(test_ctx->s_to_c_link, resume_time, spec->simulate_receive_block);\n163\t            }\n164\t            else {\n165\t                DBG_PRINTF(\"Timeout wait %d returns %d\\n\", i, ret);\n166\t            }\n167\t        }\n168\t    }\n169\t\n170\t    if (ret == 0) {\n171\t        ret = tls_api_data_sending_loop(test_ctx, &loss_mask, &simulated_time, 0);\n172\t    }\n173\t\n174\t    /* Check that the transmission succeeded */\n175\t    if (ret == 0) {\n176\t        ret = tls_api_one_scenario_body_verify(test_ctx, &simulated_time, spec->target_time);\n177\t    }\n178\t\n179\t    /* Check that RTT max is consistent with suspension time.\n180\t     * Test on server only, as client is only sending ACKs.\n181\t     */\n182\t    if (ret == 0) {\n183\t        if (test_ctx->cnx_server->path[0]->rtt_max < spec->suspension->suspend_interval) {\n184\t            DBG_PRINTF(\"Expected rtt_max > %\" PRIu64 \", got %\" PRIu64, spec->suspension->suspend_interval,\n185\t                test_ctx->cnx_server->path[0]->rtt_max);\n186\t            ret = -1;\n187\t        }\n188\t    }\n189\t\n190\t    /* Delete the context */\n191\t    if (test_ctx != NULL) {\n192\t        tls_api_delete_ctx(test_ctx);\n193\t    }\n194\t\n195\t    return ret;\n196\t}\n197\t\n198\tstatic wifi_test_suspension_t suspension_basic[] = {\n199\t    { 1000000, 250000 }\n200\t};\n201\t\n202\tstatic size_t nb_suspension_basic = sizeof(suspension_basic) / sizeof(wifi_test_suspension_t);\n203\t\n204\tvoid wifi_test_set_default_spec(wifi_test_spec_t* spec, picoquic_congestion_algorithm_t* ccalgo, uint64_t target_time)\n205\t{\n206\t    memset(spec, 0, sizeof(wifi_test_spec_t));\n207\t\n208\t    spec->nb_suspend = nb_suspension_basic;\n209\t    spec->latency = 3000;\n210\t    spec->suspension = suspension_basic;\n211\t    spec->ccalgo = ccalgo;\n212\t    spec->target_time = target_time;\n213\t    spec->simulate_receive_block = 0;\n214\t    spec->queue_max_delay = 260000;\n215\t}\n216\t\n217\tint wifi_bbr_test(void)\n218\t{\n219\t    wifi_test_spec_t spec;\n220\t    wifi_test_set_default_spec(&spec, picoquic_bbr_algorithm, 2800000);\n221\t    int ret = wifi_test_one(wifi_test_bbr, &spec);\n222\t\n223\t    return ret;\n224\t}\n225\t\n226\tint wifi_bbr1_test(void)\n227\t{\n228\t    wifi_test_spec_t spec;\n229\t    wifi_test_set_default_spec(&spec, picoquic_bbr1_algorithm, 2800000);\n230\t    int ret = wifi_test_one(wifi_test_bbr, &spec);\n231\t\n232\t    return ret;\n233\t}\n234\t\n235\tint wifi_cubic_test(void)\n236\t{\n237\t    wifi_test_spec_t spec;\n238\t    wifi_test_set_default_spec(&spec, picoquic_cubic_algorithm, 2870000);\n239\t\n240\t    int ret = wifi_test_one(wifi_test_cubic, &spec);\n241\t\n242\t    return ret;\n243\t}\n244\t\n245\tint wifi_reno_test(void)\n246\t{\n247\t    wifi_test_spec_t spec;\n248\t    wifi_test_set_default_spec(&spec, picoquic_newreno_algorithm, 2800000);\n249\t    int ret = wifi_test_one(wifi_test_reno,