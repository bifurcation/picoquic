{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01NetbyP7KdjqgyhpTAg8Tu5","type":"tool_result","content":"5000\t}\n5001\t\n5002\tint mtu_max_test(void)\n5003\t{\n5004\t    int ret = mtu_discovery_test_one(picoquic_pmtud_basic, 1420, 1392,\n5005\t        test_scenario_mtu_discovery, sizeof(test_scenario_mtu_discovery), 1420);\n5006\t    return ret;\n5007\t}\n5008\t\n5009\t/*\n5010\t* MTU drop test. Perform a long duration transmission.\n5011\t* Verify that MTU was properly set to expected value, then\n5012\t* simulate a routing event that causes the MTU to drop.\n5013\t* Check that the MTU gets reduced, and the transmission\n5014\t* completes.\n5015\t*/\n5016\t\n5017\tstatic int mtu_drop_cc_algotest(picoquic_congestion_algorithm_t* cc_algo, uint64_t target_time)\n5018\t{\n5019\t    uint64_t simulated_time = 0;\n5020\t    uint64_t loss_mask = 0;\n5021\t    const uint64_t mtu_drop_latency = 100000;\n5022\t    const uint64_t picosec_1mbps = 8000000;\n5023\t    picoquic_test_tls_api_ctx_t* test_ctx = NULL;\n5024\t    picoquic_connection_id_t initial_cid = { {0xa1, 0x10, 0xcc, 0xa1, 0x90, 6, 7, 8}, 8 };\n5025\t    int ret;\n5026\t\n5027\t    initial_cid.id[4] = cc_algo->congestion_algorithm_number;\n5028\t    \n5029\t    ret = tls_api_init_ctx_ex(&test_ctx, PICOQUIC_INTERNAL_TEST_VERSION_1,\n5030\t        PICOQUIC_TEST_SNI, PICOQUIC_TEST_ALPN, &simulated_time, NULL, NULL, 0, 0, 0, &initial_cid);\n5031\t\n5032\t    if (ret == 0) {\n5033\t        /* Set long delays, 1 Mbps each way */\n5034\t        test_ctx->c_to_s_link->microsec_latency = mtu_drop_latency;\n5035\t        test_ctx->c_to_s_link->picosec_per_byte = picosec_1mbps;\n5036\t        test_ctx->s_to_c_link->microsec_latency = mtu_drop_latency;\n5037\t        test_ctx->s_to_c_link->picosec_per_byte = picosec_1mbps;\n5038\t        /* Set the CC algorithm to selected value */\n5039\t        picoquic_set_default_congestion_algorithm(test_ctx->qserver, cc_algo);\n5040\t        picoquic_set_qlog(test_ctx->qserver, \".\");\n5041\t        test_ctx->qserver->use_long_log = 1;\n5042\t    }\n5043\t\n5044\t    if (ret == 0) {\n5045\t        ret = tls_api_connection_loop(test_ctx, &loss_mask, 2*mtu_drop_latency, &simulated_time);\n5046\t    }\n5047\t\n5048\t    /* Prepare to send data */\n5049\t    if (ret == 0) {\n5050\t        ret = test_api_init_send_recv_scenario(test_ctx, test_scenario_very_long, sizeof(test_scenario_very_long));\n5051\t    }\n5052\t\n5053\t    /* Send for 1 seconds, check that MTU is discovered, and then drop the MTU size in the s_to_c direction */\n5054\t    if (ret == 0) {\n5055\t        ret = tls_api_wait_for_timeout(test_ctx, &simulated_time, 1000000);\n5056\t    }\n5057\t\n5058\t    if (ret == 0) {\n5059\t        if (test_ctx->cnx_client->path[0]->send_mtu != test_ctx->cnx_server->local_parameters.max_packet_size) {\n5060\t            ret = -1;\n5061\t        }\n5062\t        else if (test_ctx->cnx_server->path[0]->send_mtu != test_ctx->cnx_client->local_parameters.max_packet_size) {\n5063\t            ret = -1;\n5064\t        }\n5065\t    }\n5066\t\n5067\t    if (ret == 0) {\n5068\t        test_ctx->c_to_s_link->path_mtu = (PICOQUIC_INITIAL_MTU_IPV4 + test_ctx->c_to_s_link->path_mtu) / 2;\n5069\t        test_ctx->s_to_c_link->path_mtu = (PICOQUIC_INITIAL_MTU_IPV4 + test_ctx->s_to_c_link->path_mtu) / 2;\n5070\t    }\n5071\t\n5072\t    /* Try to complete the data sending loop */\n5073\t    if (ret == 0) {\n5074\t        ret = tls_api_data_sending_loop(test_ctx, &loss_mask, &simulated_time, 0);\n5075\t    }\n5076\t\n5077\t    /* verify that the transmission was complete */\n5078\t    if (ret == 0) {\n5079\t        ret = tls_api_one_scenario_body_verify(test_ctx, &simulated_time, target_time);\n5080\t    }\n5081\t\n5082\t    if (test_ctx != NULL) {\n5083\t        tls_api_delete_ctx(test_ctx);\n5084\t        test_ctx = NULL;\n5085\t    }\n5086\t\n5087\t    return ret;\n5088\t}\n5089\t\n5090\tint mtu_drop_bbr_test(void)\n5091\t{\n5092\t    /* TODO: the time with BBR v1 was 10300000. The current value is\n5093\t     * a slight regression. Investigate whether some performance\n5094\t     * for BBR3 \"recover from PTO\" could be improved. */\n5095\t    int ret = mtu_drop_cc_algotest(picoquic_bbr_algorithm, 10700000);\n5096\t    return ret;\n5097\t}\n5098\t\n5099\tint mtu_drop_cubic_test(void)\n5100\t{\n5101\t    int ret = mtu_drop_cc_algotest(picoquic_cubic_algorithm, 10000000);\n5102\t    return ret;\n5103\t}\n5104\t\n5105\tint mtu_drop_dcubic_test(void)\n5106\t{\n5107\t    int ret = mtu_drop_cc_algotest(picoquic_dcubic_algorithm, 9200000);\n5108\t    return ret;\n5109\t}\n5110\t\n5111\tint mtu_drop_fast_test(void)\n5112\t{\n5113\t    int ret = mtu_drop_cc_algotest(picoquic_fastcc_algorithm, 11500000);\n5114\t    return ret;\n5115\t}\n5116\t\n5117\tint mtu_drop_newreno_test(void)\n5118\t{\n5119\t    int ret = mtu_drop_cc_algotest(picoquic_newreno_algorithm, 11600000);\n5120\t    return ret;\n5121\t}\n5122\t\n5123\t/*\n5124\t * Trying to reproduce the scenario that resulted in\n5125\t * spurious retransmissions,and checking that it is fixed.\n5126\t */\n5127\t\n5128\tint spurious_retransmit_test(void)\n5129\t{\n5130\t    uint64_t loss_mask = 0;\n5131\t    uint64_t simulated_time = 0;\n5132\t    uint64_t next_time = 0;\n5133\t    picoquic_test_tls_api_ctx_t* test_ctx = NULL;\n5134\t    int ret = tls_api_init_ctx(&test_ctx, 0, PICOQUIC_TEST_SNI, PICOQUIC_TEST_ALPN, &simulated_time, NULL, NULL, 0, 0, 0);\n5135\t\n5136\t    if (ret == 0) {\n5137\t        test_ctx->c_to_s_link->microsec_latency = 50000ull;\n5138\t        test_ctx->s_to_c_link->microsec_latency = 50000ull;\n5139\t\n5140\t        ret = tls_api_connection_loop(test_ctx, &loss_mask, 0, &simulated_time);\n5141\t    }\n5142\t\n5143\t    /* simulate 1 second of silence */\n5144\t    next_time = simulated_time + 1000000ull;\n5145\t    while (ret == 0 && simulated_time < next_time && TEST_CLIENT_READY && TEST_SERVER_READY) {\n5146\t        int was_active = 0;\n5147\t\n5148\t        ret = tls_api_one_sim_round(test_ctx, &simulated_time, next_time, &was_active);\n5149\t    }\n5150\t\n5151\t    if (ret == 0) {\n5152\t        ret = tls_api_attempt_to_close(test_ctx, &simulated_time);\n5153\t    }\n5154\t\n5155\t    if (ret == 0) {\n5156\t        /* verify the absence of any spurious retransmission */\n5157\t        if (test_ctx->cnx_client->nb_spurious != 0) {\n5158\t            ret = -1;\n5159\t        } else if (test_ctx->cnx_server != NULL && test_ctx->cnx_server->nb_spurious != 0) {\n5160\t            ret = -1;\n5161\t        }\n5162\t    }\n5163\t\n5164\t    if (test_ctx != NULL) {\n5165\t        tls_api_delete_ctx(test_ctx);\n5166\t        test_ctx = NULL;\n5167\t    }\n5168\t\n5169\t    return ret;\n5170\t}\n5171\t\n5172\t/*\n5173\t* Set up a connection, and verify\n5174\t* that the key generated for PN encryption on\n5175\t* client and server produce the correct results.\n5176\t*/\n5177\t\n5178\tint pn_enc_1rtt_test(void)\n5179\t{\n5180\t    uint64_t loss_mask = 0;\n5181\t    uint64_t simulated_time = 0;\n5182\t    picoquic_test_tls_api_ctx_t* test_ctx = NULL;\n5183\t    int ret = tls_api_init_ctx(&test_ctx, 0, PICOQUIC_TEST_SNI, PICOQUIC_TEST_ALPN, &simulated_time, NULL, NULL, 0, 0, 0);\n5184\t\n5185\t    if (ret == 0) {\n5186\t        ret = tls_api_connection_loop(test_ctx, &loss_mask, 0, &simulated_time);\n5187\t    }\n5188\t\n5189\t    if (ret == 0) {\n5190\t        ret = wait_application_aead_ready(test_ctx, &simulated_time);\n5191\t    }\n5192\t\n5193\t    if (ret == 0)\n5194\t    {\n5195\t        /* Try to encrypt a sequence number */\n5196\t        uint8_t seq_num_1[4] = { 0xde, 0xad, 0xbe, 0xef };\n5197\t        uint8_t sample_1[16] = {\n5198\t            0x6b, 0xc1, 0xbe, 0xe2, 0x2e, 0x40, 0x9f, 0x96,\n5199\t            0xe9, 0x3d, 0x7e, 0x11, 0x73, 0x93, 0x17, 0x2a };\n5200\t        uint8_t seq_num_2[4] = { 0xba, 0xba, 0xc0, 0x0l };\n5201\t        uint8_t sample_2[16] = {\n5202\t            0xe9, 0x3d, 0x7e, 0x11, 0x73, 0x93, 0x17, 0x2a,\n5203\t            0x6b, 0xc1, 0xbe, 0xe2, 0x2e, 0x40, 0x9f, 0x96 };\n5204\t\n5205\t        for (int i = 1; i < 4; i *= 2)\n5206\t        {\n5207\t            ret = test_one_pn_enc_pair(seq_num_1, 4, test_ctx->cnx_client->crypto_context[3].pn_enc, test_ctx->cnx_server->crypto_context[3].pn_dec, sample_1);\n5208\t\n5209\t            if (ret == 0)\n5210\t            {\n5211\t                ret = test_one_pn_enc_pair(seq_num_2, 4, test_ctx->cnx_server->crypto_context[3].pn_enc, test_ctx->cnx_client->crypto_context[3].pn_dec, sample_2);\n5212\t            }\n5213\t        }\n5214\t    }\n5215\t\n5216\t    if (test_ctx != NULL) {\n5217\t        tls_api_delete_ctx(test_ctx);\n5218\t        test_ctx = NULL;\n5219\t    }\n5220\t\n5221\t    return ret;\n5222\t}\n5223\t\n5224\tint bad_certificate_test(void)\n5225\t{\n5226\t    uint64_t simulated_time = 0;\n5227\t    uint64_t loss_mask = 0;\n5228\t    picoquic_test_tls_api_ctx_t* test_ctx = NULL;\n5229\t    char test_server_cert_file[512];\n5230\t    char test_server_key_file[512];\n5231\t    char test_server_cert_store_file[512];\n5232\t    int ret = tls_api_init_ctx(&test_ctx, 0, PICOQUIC_TEST_SNI, PICOQUIC_TEST_ALPN, &simulated_time, NULL, NULL, 0, 0, 0);\n5233\t\n5234\t    if (ret == 0) {\n5235\t        ret = picoquic_get_input_path(test_server_cert_file, sizeof(test_server_cert_file), picoquic_solution_dir, PICOQUIC_TEST_FILE_SERVER_BAD_CERT);\n5236\t\n5237\t        if (ret == 0) {\n5238\t            ret = picoquic_get_input_path(test_server_key_file, sizeof(test_server_key_file), picoquic_solution_dir, PICOQUIC_TEST_FILE_SERVER_KEY);\n5239\t        }\n5240\t\n5241\t        if (ret == 0) {\n5242\t            ret = picoquic_get_input_path(test_server_cert_store_file, sizeof(test_server_cert_store_file), picoquic_solution_dir, PICOQUIC_TEST_FILE_CERT_STORE);\n5243\t        }\n5244\t\n5245\t        if (ret != 0) {\n5246\t            DBG_PRINTF(\"%s\", \"Cannot set the cert, key or store file names.\\n\");\n5247\t        }\n5248\t    }\n5249\t\n5250\t    /* Delete the server context, and recreate it with the bad certificate */\n5251\t\n5252\t    if (ret == 0)\n5253\t    {\n5254\t        if (test_ctx->qserver != NULL) {\n5255\t            picoquic_free(test_ctx->qserver);\n5256\t        }\n5257\t\n5258\t        test_ctx->qserver = picoquic_create(8,\n5259\t            test_server_cert_file, test_server_key_file, test_server_cert_store_file,\n5260\t            PICOQUIC_TEST_ALPN, test_api_callback, (void*)&test_ctx->server_callback, NULL, NULL, NULL,\n5261\t            simulated_time, &simulated_time, NULL,\n5262\t            test_ticket_encrypt_key, sizeof(test_ticket_encrypt_key));\n5263\t\n5264\t        if (test_ctx->qserver == NULL) {\n5265\t            ret = -1;\n5266\t        }\n5267\t    }\n5268\t\n5269\t    /* Proceed with the connection loop. It should fail, and thus we don't test the return code */\n5270\t    if (ret == 0) {\n5271\t        (void)tls_api_connection_loop(test_ctx, &loss_mask, 0, &simulated_time);\n5272\t\n5273\t        if (test_ctx->cnx_client == NULL) {\n5274\t            ret = -1;\n5275\t        }\n5276\t        else if (test_ctx->cnx_client->cnx_state != picoquic_state_disconnected) {\n5277\t            ret = -1;\n5278\t        }\n5279\t        else if (!picoquic_is_handshake_error(picoquic_get_local_error(test_ctx->cnx_client))) {\n5280\t            ret = -1;\n5281\t        }\n5282\t        else if (!picoquic_is_handshake_error(picoquic_get_remote_error(test_ctx->cnx_server))) {\n5283\t            ret = -1;\n5284\t        }\n5285\t        else {\n5286\t            ret = 0;\n5287\t        }\n5288\t    }\n5289\t\n5290\t    if (test_ctx != NULL) {\n5291\t        tls_api_delete_ctx(test_ctx);\n5292\t        test_ctx = NULL;\n5293\t    }\n5294\t\n5295\t    return ret;\n5296\t}\n5297\t\n5298\t/*\n5299\t* Test setting the verify certificate callback.\n5300\t*/\n5301\t\n5302\ttypedef struct st_verify_certificate_test_cb_t {\n5303\t    ptls_verify_certificate_t super;\n5304\t    int callcount;\n5305\t} verify_certificate_test_cb_t;\n5306\t\n5307\tstatic int verify_sign_test(void* verify_ctx, uint16_t UNUSED(algo), ptls_iovec_t UNUSED(data), ptls_iovec_t UNUSED(sign))\n5308\t{\n5309\t    int* ptr = (int*)verify_ctx;\n5310\t    *ptr += 1;\n5311\t\n5312\t    return 0;\n5313\t}\n5314\t/*\n5315\t    int (*cb)(struct st_ptls_verify_certificate_t *self, ptls_t *tls, const char *server_name,\n5316\t              int (**verify_sign)(void *verify_ctx, uint16_t algo, ptls_iovec_t data, ptls_iovec_t sign), void **verify_data,\n5317\t              ptls_iovec_t *certs, size_t num_certs);\n5318\t*/\n5319\tstatic int verify_certificate_test_cb(struct st_ptls_verify_certificate_t* self, ptls_t* UNUSED(tls), const char* UNUSED(server_name),\n5320\t    int (**verify_sign)(void* verify_ctx, uint16_t algo, ptls_iovec_t data, ptls_iovec_t sign), void** verify_data,\n5321\t    ptls_iovec_t* UNUSED(certs), size_t UNUSED(num_certs))\n5322\t{\n5323\t\n5324\t    int ret = 0;\n5325\t    verify_certificate_test_cb_t* verify_cb_ctx = (verify_certificate_test_cb_t*)\n5326\t        ((char*)self - offsetof(verify_certificate_test_cb_t, super.cb));\n5327\t\n5328\t    *verify_sign = verify_sign_test;\n5329\t    *verify_data = (void*)&verify_cb_ctx->callcount;\n5330\t\n5331\t    return ret;\n5332\t}\n5333\t\n5334\tint set_verify_certificate_callback_test(void)\n5335\t{\n5336\t    uint64_t simulated_time = 0;\n5337\t    uint64_t loss_mask = 0;\n5338\t    picoquic_test_tls_api_ctx_t* test_ctx = NULL;\n5339\t    char test_server_cert_file[512];\n5340\t    char test_server_key_file[512];\n5341\t    char test_server_cert_store_file[512];\n5342\t    int ret = tls_api_init_ctx(&test_ctx, PICOQUIC_INTERNAL_TEST_VERSION_1,\n5343\t        PICOQUIC_TEST_SNI, PICOQUIC_TEST_ALPN, &simulated_time, NULL, NULL, 0, 0, 0);\n5344\t    static const uint16_t default_algos[] = {\n5345\t        PTLS_SIGNATURE_ED25519, PTLS_SIGNATURE_RSA_PSS_RSAE_SHA256,\n5346\t        PTLS_SIGNATURE_ECDSA_SECP256R1_SHA256, PTLS_SIGNATURE_RSA_PKCS1_SHA256, \n5347\t        PTLS_SIGNATURE_RSA_PKCS1_SHA1, UINT16_MAX };\n5348\t\n5349\t    verify_certificate_test_cb_t verify_cb = { 0 };\n5350\t\n5351\t    verify_cb.super.cb = verify_certificate_test_cb;\n5352\t    verify_cb.super.algos = default_algos;\n5353\t\n5354\t    if (ret == 0) {\n5355\t        ret = picoquic_get_input_path(test_server_cert_file, sizeof(test_server_cert_file), picoquic_solution_dir, PICOQUIC_TEST_FILE_SERVER_CERT);\n5356\t    }\n5357\t\n5358\t    if (ret == 0) {\n5359\t        ret = picoquic_get_input_path(test_server_key_file, sizeof(test_server_key_file), picoquic_solution_dir, PICOQUIC_TEST_FILE_SERVER_KEY);\n5360\t    }\n5361\t\n5362\t    if (ret == 0) {\n5363\t        ret = picoquic_get_input_path(test_server_cert_store_file, sizeof(test_server_cert_store_file), picoquic_solution_dir, PICOQUIC_TEST_FILE_CERT_STORE);\n5364\t    }\n5365\t\n5366\t    if (ret != 0) {\n5367\t        DBG_PRINTF(\"%s\", \"Cannot set the cert, key or store file names.\\n\");\n5368\t    }\n5369\t\n5370\t    /* Delete the client context, and recreate with a certificate */\n5371\t    if (ret == 0) {\n5372\t        if (test_ctx->qclient != NULL) {\n5373\t            picoquic_free(test_ctx->qclient);\n5374\t            test_ctx->cnx_client = NULL;\n5375\t        }\n5376\t\n5377\t        test_ctx->qclient = picoquic_create(8,\n5378\t            test_server_cert_file, test_server_key_file, test_server_cert_store_file,\n5379\t            NULL, test_api_callback, (void*)&test_ctx->client_callback, NULL, NULL, NULL,\n5380\t            simulated_time, &simulated_time, NULL, NULL, 0);\n5381\t\n5382\t        if (test_ctx->qclient == NULL) {\n5383\t            ret = -1;\n5384\t        }\n5385\t    }\n5386\t    /* recreate the client connection */\n5387\t    if (ret == 0) {\n5388\t        test_ctx->cnx_client = picoquic_create_cnx(test_ctx->qclient, picoquic_null_connection_id,\n5389\t                                                   picoquic_null_connection_id,\n5390\t                                                   (struct sockaddr*)&test_ctx->server_addr, 0,\n5391\t                                                   0, PICOQUIC_TEST_SNI, PICOQUIC_TEST_ALPN, 1);\n5392\t\n5393\t        if (test_ctx->cnx_client == NULL) {\n5394\t            ret = -1;\n5395\t        } else {\n5396\t            ret = picoquic_start_client_cnx(test_ctx->cnx_client);\n5397\t        }\n5398\t    }\n5399\t    /* Set the verify callback for the client */\n5400\t    if (ret == 0) {\n5401\t        picoquic_set_verify_certificate_callback(test_ctx->qclient, &verify_cb.super, NULL);\n5402\t    }\n5403\t\n5404\t    /* Set the verify callback for the server */\n5405\t    if (ret == 0) {\n5406\t        picoquic_set_verify_certificate_callback(test_ctx->qserver, &verify_cb.super, NULL);\n5407\t    }\n5408\t    /* Activate client authentication */\n5409\t    if (ret == 0) {\n5410\t        picoquic_set_client_authentication(test_ctx->qserver, 1);\n5411\t\n5412\t        ret = tls_api_connection_loop(test_ctx, &loss_mask, 0, &simulated_time);\n5413\t    }\n5414\t\n5415\t    if (ret == 0 && verify_cb.callcount != 2) {\n5416\t        ret = -1;\n5417\t    }\n5418\t\n5419\t    if (test_ctx != NULL) {\n5420\t        tls_api_delete_ctx(test_ctx);\n5421\t        test_ctx = NULL;\n5422\t    }\n5423\t\n5424\t    return ret;\n5425\t}\n5426\t\n5427\t/*\n5428\t * Verify that the simulated time works as expected\n5429\t */\n5430\t\n5431\tint virtual_time_test(void)\n5432\t{\n5433\t    int ret = 0;\n5434\t    uint64_t test_time = 0;\n5435\t    uint64_t simulated_time = 0;\n5436\t    uint64_t current_time = picoquic_current_time();\n5437\t    uint64_t ptls_time = 0;\n5438\t    uint8_t callback_ctx[256];\n5439\t    char test_server_cert_store_file[512];\n5440\t    picoquic_quic_t * qsimul = NULL;\n5441\t    picoquic_quic_t * qdirect = NULL;\n5442\t\n5443\t    ret = picoquic_get_input_path(test_server_cert_store_file, sizeof(test_server_cert_store_file), picoquic_solution_dir, PICOQUIC_TEST_FILE_CERT_STORE);\n5444\t\n5445\t    if (ret != 0) {\n5446\t        DBG_PRINTF(\"%s\", \"Cannot set the cert, key or store file names.\\n\");\n5447\t    }\n5448\t    else {\n5449\t        qsimul = picoquic_create(8, NULL, NULL, test_server_cert_store_file,\n5450\t            NULL, test_api_callback,\n5451\t            (void*)callback_ctx, NULL, NULL, NULL, simulated_time,\n5452\t            &simulated_time, ticket_file_name, NULL, 0);\n5453\t        qdirect = picoquic_create(8, NULL, NULL, PICOQUIC_TEST_FILE_CERT_STORE,\n5454\t            NULL, test_api_callback,\n5455\t            (void*)callback_ctx, NULL, NULL, NULL, current_time,\n5456\t            NULL, ticket_file_name, NULL, 0);\n5457\t\n5458\t        if (qsimul == NULL || qdirect == NULL)\n5459\t        {\n5460\t            ret = -1;\n5461\t        }\n5462\t        else\n5463\t        {\n5464\t            /* Check that the simulated time follows the simulation */\n5465\t            for (int i = 0; ret == 0 && i < 5; i++) {\n5466\t                simulated_time += 12345678000;\n5467\t                test_time = picoquic_get_quic_time(qsimul);\n5468\t                ptls_time = picoquic_get_tls_time(qsimul);\n5469\t                if (test_time != simulated_time) {\n5470\t                    DBG_PRINTF(\"Test time: %llu != Simulated: %llu\",\n5471\t                        (unsigned long long)test_time,\n5472\t                        (unsigned long long)simulated_time);\n5473\t                    ret = -1;\n5474\t                }\n5475\t                else if (ptls_time < test_time || ptls_time > test_time + 1000) {\n5476\t                    DBG_PRINTF(\"Test time: %llu does match ptls time: %llu\",\n5477\t                        (unsigned long long)test_time,\n5478\t                        (unsigned long long)ptls_time);\n5479\t                    ret = -1;\n5480\t                }\n5481\t            }\n5482\t        }\n5483\t\n5484\t        if (ret == 0) {\n5485\t            int64_t delta, delta_low, delta_high;\n5486\t            uint64_t current_previous = picoquic_current_time();\n5487\t            uint64_t test_previous = picoquic_current_time();\n5488\t            uint64_t ptls_previous = picoquic_get_tls_time(qdirect);\n5489\t\n5490\t            /* Check that the non simulated time follows the current time */\n5491\t            for (int i = 0; ret == 0 && i < 5; i++) {\n5492\t#ifdef _WINDOWS\n5493\t                Sleep(1);\n5494\t#else\n5495\t                usleep(1000);\n5496\t#endif\n5497\t                current_time = picoquic_current_time();\n5498\t                test_time = picoquic_get_quic_time(qdirect);\n5499\t                ptls_time = picoquic_get_tls_time(qdirect);\n5500\t\n5501\t                delta = current_time - current_previous;\n5502\t                delta_low = delta - 1000;\n5503\t                delta_high = delta + 1000;\n5504\t                if (test_time < test_previous + delta_low || test_time > test_previous + delta_high ) {\n5505\t                    DBG_PRINTF(\"Test time: %\" PRIu64 \" does not match previous test time : %\" PRIu64 \" + delta : %\" PRId64,\n5506\t                        test_time, test_previous, delta);\n5507\t                    ret = -1;\n5508\t                }\n5509\t                else if (ptls_time < ptls_previous + delta_low || ptls_time > ptls_previous + delta_high) {\n5510\t                    DBG_PRINTF(\"Test time: %\" PRIu64 \" does not match previous test time : %\" PRIu64 \" + delta : %\" PRId64,\n5511\t                        ptls_time, ptls_previous, delta);\n5512\t                    ret = -1;\n5513\t                }\n5514\t            }\n5515\t        }\n5516\t    }\n5517\t\n5518\t    if (qsimul != NULL)\n5519\t    {\n5520\t        picoquic_free(qsimul);\n5521\t        qsimul = NULL;\n5522\t    }\n5523\t\n5524\t    if (qdirect != NULL)\n5525\t    {\n5526\t        picoquic_free(qdirect);\n5527\t        qdirect = NULL;\n5528\t    }\n5529\t\n5530\t    return ret;\n5531\t}\n5532\t\n5533\t/*\n5534\t * Testing with different initial connection parameters\n5535\t */\n5536\t\n5537\tint tls_different_params_test(void)\n5538\t{\n5539\t    picoquic_tp_t test_parameters;\n5540\t\n5541\t    memset(&test_parameters, 0, sizeof(picoquic_tp_t));\n5542\t\n5543\t    picoquic_init_transport_parameters(&test_parameters);\n5544\t\n5545\t    test_parameters.initial_max_stream_id_bidir = 0;\n5546\t\n5547\t    return tls_api_one_scenario_test(test_scenario_very_long, sizeof(test_scenario_very_long), 0, 0, 0, 0, 0, 3510000, &test_parameters, NULL);\n5548\t}\n5549\t\n5550\tint tls_quant_params_test(void)\n5551\t{\n5552\t    picoquic_tp_t test_parameters;\n5553\t\n5554\t    memset(&test_parameters, 0, sizeof(picoquic_tp_t));\n5555\t\n5556\t    picoquic_init_transport_parameters(&test_parameters);\n5557\t\n5558\t    test_parameters.initial_max_data = 0x4000;\n5559\t    test_parameters.initial_max_stream_id_bidir = 0;\n5560\t    test_parameters.initial_max_stream_id_unidir = 16384;\n5561\t    test_parameters.initial_max_stream_data_bidi_local = 0x2000;\n5562\t    test_parameters.initial_max_stream_data_bidi_remote = 0x2000;\n5563\t    test_parameters.initial_max_stream_data_uni = 0x2000;\n5564\t\n5565\t    return tls_api_one_scenario_test(test_scenario_quant, sizeof(test_scenario_quant), 0, 0, 0, 0, 0, 3510000, &test_parameters, NULL);\n5566\t}\n5567\t\n5568\tint set_certificate_and_key_test(void)\n5569\t{\n5570\t    uint64_t simulated_time = 0;\n5571\t    uint64_t loss_mask = 0;\n5572\t    picoquic_test_tls_api_ctx_t* test_ctx = NULL;\n5573\t    char test_server_cert_file[512];\n5574\t    char test_server_key_file[512];\n5575\t    char test_server_cert_store_file[512];\n5576\t    int ret = tls_api_init_ctx(&test_ctx, 0, PICOQUIC_TEST_SNI, PICOQUIC_TEST_ALPN, &simulated_time, NULL, NULL, 0, 0, 0);\n5577\t\n5578\t    if (ret == 0) {\n5579\t        ret = picoquic_get_input_path(test_server_cert_file, sizeof(test_server_cert_file), picoquic_solution_dir, PICOQUIC_TEST_FILE_SERVER_CERT);\n5580\t    }\n5581\t\n5582\t    if (ret == 0) {\n5583\t        ret = picoquic_get_input_path(test_server_key_file, sizeof(test_server_key_file), picoquic_solution_dir, PICOQUIC_TEST_FILE_SERVER_KEY);\n5584\t    }\n5585\t\n5586\t    if (ret == 0) {\n5587\t        ret = picoquic_get_input_path(test_server_cert_store_file, sizeof(test_server_cert_store_file), picoquic_solution_dir, PICOQUIC_TEST_FILE_CERT_STORE);\n5588\t    }\n5589\t\n5590\t    if (ret != 0) {\n5591\t        DBG_PRINTF(\"%s\", \"Cannot set the cert, key or store file names.\\n\");\n5592\t    }\n5593\t\n5594\t    /* Delete the server context, and recreate it. */\n5595\t    if (ret == 0)\n5596\t    {\n5597\t        if (test_ctx->qserver != NULL) {\n5598\t            picoquic_free(test_ctx->qserver);\n5599\t        }\n5600\t\n5601\t        test_ctx->qserver = picoquic_create(8,\n5602\t            NULL, NULL, NULL,\n5603\t            PICOQUIC_TEST_ALPN, test_api_callback, (void*)&test_ctx->server_callback, NULL, NULL, NULL,\n5604\t            simulated_time, &simulated_time, NULL,\n5605\t            test_ticket_encrypt_key, sizeof(test_ticket_encrypt_key));\n5606\t\n5607\t        if (test_ctx->qserver == NULL) {\n5608\t            ret = -1;\n5609\t        }\n5610\t\n5611\t        if (ret == 0) {\n5612\t            ret = picoquic_set_private_key_from_file(test_ctx->qserver, test_server_key_file);\n5613\t        }\n5614\t\n5615\t        if (ret == 0) {\n5616\t            size_t count = 0;\n5617\t            ptls_iovec_t* chain = picoquic_get_certs_from_file(test_server_cert_file, &count);\n5618\t            if (chain == NULL) {\n5619\t                ret = -1;\n5620\t            } else {\n5621\t                picoquic_set_tls_certificate_chain(test_ctx->qserver, chain, count);\n5622\t            }\n5623\t        }\n5624\t\n5625\t        if (ret == 0) {\n5626\t            size_t count = 0;\n5627\t            ptls_iovec_t* chain = picoquic_get_certs_from_file(test_server_cert_store_file, &count);\n5628\t\n5629\t            if (chain == NULL) {\n5630\t                ret = -1;\n5631\t            } else {\n5632\t                picoquic_set_tls_root_certificates(test_ctx->qserver, chain, count);\n5633\t                for (size_t i = 0; i < count; i++) {\n5634\t                    free(chain[i].base);\n5635\t                }\n5636\t                free(chain);\n5637\t            }\n5638\t        }\n5639\t    }\n5640\t\n5641\t    /* Proceed with the connection loop. */\n5642\t    if (ret == 0) {\n5643\t        picoquic_enforce_client_only(test_ctx->qserver, 0);\n5644\t        ret = tls_api_connection_loop(test_ctx, &loss_mask, 0, &simulated_time);\n5645\t    }\n5646\t\n5647\t    if (ret == 0 && (!TEST_CLIENT_READY || !TEST_SERVER_READY)) {\n5648\t        ret = -1;\n5649\t    }\n5650\t\n5651\t    if (test_ctx != NULL) {\n5652\t        tls_api_delete_ctx(test_ctx);\n5653\t        test_ctx = NULL;\n5654\t    }\n5655\t\n5656\t    return ret;\n5657\t}\n5658\t\n5659\tint request_client_authentication_test_one(const char *test_client_cert_file,\n5660\t                                           const char *test_client_key_file,\n5661\t                                           const char *test_server_cert_file,\n5662\t                                           const char *test_server_key_file,\n5663\t                                           const char *test_ca_cert_store_file)\n5664\t{\n5665\t    uint64_t simulated_time = 0;\n5666\t    uint64_t loss_mask = 0;\n5667\t    picoquic_test_tls_api_ctx_t *test_ctx = NULL;\n5668\t    int ret = 0;\n5669\t\n5670\t    if (ret != 0) {\n5671\t        DBG_PRINTF(\"%s\", \"Cannot set the cert, key or store file names.\\n\");\n5672\t    } else {\n5673\t        ret = tls_api_init_ctx(&test_ctx, 0, PICOQUIC_TEST_SNI, PICOQUIC_TEST_ALPN, &simulated_time,\n5674\t                               NULL, NULL, 0, 0, 0);\n5675\t    }\n5676\t\n5677\t    if (ret == 0 && test_ctx == NULL) {\n5678\t        ret = -1;\n5679\t    }\n5680\t\n5681\t    /* Delete the client context, and recreate with a certificate */\n5682\t    if (ret == 0) {\n5683\t        if (test_ctx->qclient != NULL) {\n5684\t            picoquic_free(test_ctx->qclient);\n5685\t            test_ctx->cnx_client = NULL;\n5686\t        }\n5687\t\n5688\t        test_ctx->qclient = picoquic_create(8, test_client_cert_file, test_client_key_file,\n5689\t                                            test_ca_cert_store_file, NULL, test_api_callback,\n5690\t                                            (void *)&test_ctx->client_callback, NULL, NULL, NULL,\n5691\t                                            simulated_time, &simulated_time, NULL, NULL, 0);\n5692\t\n5693\t        if (test_ctx->qclient == NULL) {\n5694\t            ret = -1;\n5695\t        } else {\n5696\t            /* Enforce client only mode on the client side. */\n5697\t            picoquic_enforce_client_only(test_ctx->qclient, 1);\n5698\t        }\n5699\t\n5700\t        if (test_ctx->qserver != NULL) {\n5701\t            picoquic_free(test_ctx->qserver);\n5702\t            test_ctx->cnx_client = NULL;\n5703\t        }\n5704\t\n5705\t        test_ctx->qserver = picoquic_create(8, test_server_cert_file, test_server_key_file,\n5706\t                                            test_ca_cert_store_file, PICOQUIC_TEST_ALPN,\n5707\t                                            test_api_callback, (void *)&test_ctx->server_callback,\n5708\t                                            NULL, NULL, NULL, simulated_time, &simulated_time, NULL,\n5709\t                                            test_ticket_encrypt_key,\n5710\t                                            sizeof(test_ticket_encrypt_key));\n5711\t    }\n5712\t\n5713\t    /* recreate the client connection */\n5714\t    if (ret == 0) {\n5715\t        test_ctx->cnx_client = picoquic_create_cnx(test_ctx->qclient, picoquic_null_connection_id,\n5716\t                                                   picoquic_null_connection_id,\n5717\t                                                   (struct sockaddr *)&test_ctx->server_addr, 0, 0,\n5718\t                                                   PICOQUIC_TEST_SNI, PICOQUIC_TEST_ALPN, 1);\n5719\t\n5720\t        if (test_ctx->cnx_client == NULL) {\n5721\t            ret = -1;\n5722\t        } else {\n5723\t            ret = picoquic_start_client_cnx(test_ctx->cnx_client);\n5724\t        }\n5725\t    }\n5726\t\n5727\t    if (ret == 0) {\n5728\t        picoquic_set_client_authentication(test_ctx->qserver, 1);\n5729\t\n5730\t        /* Proceed with the connection loop. */\n5731\t        ret = tls_api_connection_loop(test_ctx, &loss_mask, 0, &simulated_time);\n5732\t    }\n5733\t\n5734\t    /* Check that both the client and server are ready. */\n5735\t    if (ret == 0) {\n5736\t        if (test_ctx->cnx_client == NULL || test_ctx->cnx_server == NULL || !TEST_CLIENT_READY ||\n5737\t            !TEST_SERVER_READY) {\n5738\t            ret = -1;\n5739\t        }\n5740\t    }\n5741\t\n5742\t    if (test_ctx != NULL) {\n5743\t        tls_api_delete_ctx(test_ctx);\n5744\t        test_ctx = NULL;\n5745\t    }\n5746\t\n5747\t    return ret;\n5748\t}\n5749\t\n5750\tint request_client_authentication_test(void)\n5751\t{\n5752\t    char test_client_cert_file[512];\n5753\t    char test_client_key_file[512];\n5754\t    char test_server_cert_file[512];\n5755\t    char test_server_key_file[512];\n5756\t    char test_ca_cert_store_file[512];\n5757\t    int ret = 0;\n5758\t\n5759\t    ret = picoquic_get_input_path(test_client_cert_file, sizeof(test_client_cert_file),\n5760\t                                  picoquic_solution_dir, PICOQUIC_TEST_FILE_SERVER_CERT_RSA);\n5761\t\n5762\t    if (ret == 0) {\n5763\t        ret = picoquic_get_input_path(test_client_key_file, sizeof(test_client_key_file),\n5764\t                                      picoquic_solution_dir, PICOQUIC_TEST_FILE_SERVER_KEY_RSA);\n5765\t    }\n5766\t\n5767\t    if (ret == 0) {\n5768\t        ret = picoquic_get_input_path(test_server_cert_file, sizeof(test_server_cert_file),\n5769\t                                      picoquic_solution_dir, PICOQUIC_TEST_FILE_SERVER_CERT);\n5770\t    }\n5771\t\n5772\t    if (ret == 0) {\n5773\t        ret = picoquic_get_input_path(test_server_key_file, sizeof(test_server_key_file),\n5774\t                                      picoquic_solution_dir, PICOQUIC_TEST_FILE_SERVER_KEY);\n5775\t    }\n5776\t\n5777\t    if (ret == 0) {\n5778\t        ret = picoquic_get_input_path(test_ca_cert_store_file, sizeof(test_ca_cert_store_file),\n5779\t                                      picoquic_solution_dir, PICOQUIC_TEST_FILE_CERT_STORE);\n5780\t    }\n5781\t\n5782\t    if (ret == 0) {\n5783\t        ret = request_client_authentication_test_one(test_client_cert_file, test_client_key_file,\n5784\t                                                     test_server_cert_file, test_server_key_file,\n5785\t                                                     test_ca_cert_store_file);\n5786\t    }\n5787\t\n5788\t    if (ret != 0) {\n5789\t        DBG_PRINTF(\"%s\", \"mTLS client-auth test failed RSA\\n\");\n5790\t    }\n5791\t\n5792\t    return ret;\n5793\t}\n5794\t\n5795\tint request_client_authentication_25519_test(void)\n5796\t{\n5797\t    char test_client_cert_file[512];\n5798\t    char test_client_key_file[512];\n5799\t    char test_server_cert_file[512];\n5800\t    char test_server_key_file[512];\n5801\t    char test_ca_cert_store_file[512];\n5802\t    int ret = 0;\n5803\t\n5804\t    ret = picoquic_get_input_path(test_client_cert_file, sizeof(test_client_cert_file),\n5805\t                                  picoquic_solution_dir, PICOQUIC_TEST_FILE_CLIENT_CERT_ED25519);\n5806\t\n5807\t    if (ret == 0) {\n5808\t        ret = picoquic_get_input_path(test_client_key_file, sizeof(test_client_key_file),\n5809\t                                      picoquic_solution_dir, PICOQUIC_TEST_FILE_CLIENT_KEY_ED25519);\n5810\t    }\n5811\t\n5812\t    if (ret == 0) {\n5813\t        ret = picoquic_get_input_path(test_server_cert_file, sizeof(test_server_cert_file),\n5814\t                                      picoquic_solution_dir,\n5815\t                                      PICOQUIC_TEST_FILE_SERVER_CERT_ED25519);\n5816\t    }\n5817\t\n5818\t    if (ret == 0) {\n5819\t        ret = picoquic_get_input_path(test_server_key_file, sizeof(test_server_key_file),\n5820\t                                      picoquic_solution_dir, PICOQUIC_TEST_FILE_SERVER_KEY_ED25519);\n5821\t    }\n5822\t\n5823\t    if (ret == 0) {\n5824\t        ret = picoquic_get_input_path(test_ca_cert_store_file, sizeof(test_ca_cert_store_file),\n5825\t                                      picoquic_solution_dir, PICOQUIC_TEST_FILE_CERT_STORE_ED25519);\n5826\t    }\n5827\t\n5828\t    if (ret == 0) {\n5829\t        ret = request_client_authentication_test_one(test_client_cert_file, test_client_key_file,\n5830\t                                                     test_server_cert_file, test_server_key_file,\n5831\t                                                     test_ca_cert_store_file);\n5832\t    }\n5833\t\n5834\t    if (ret != 0) {\n5835\t        DBG_PRINTF(\"%s\", \"mTLS client-auth test failed ED25519\\n\");\n5836\t    }\n5837\t\n5838\t    return ret;\n5839\t}\n5840\t\n5841\tint bad_client_certificate_test(void)\n5842\t{\n5843\t    uint64_t simulated_time = 0;\n5844\t    uint64_t loss_mask = 0;\n5845\t    picoquic_test_tls_api_ctx_t* test_ctx = NULL;\n5846\t    char test_server_cert_file[512];\n5847\t    char test_server_key_file[512];\n5848\t    char test_server_cert_store_file[512];\n5849\t    int ret = picoquic_get_input_path(test_server_cert_file, sizeof(test_server_cert_file), picoquic_solution_dir, PICOQUIC_TEST_FILE_SERVER_BAD_CERT);\n5850\t\n5851\t    if (ret == 0) {\n5852\t        ret = picoquic_get_input_path(test_server_key_file, sizeof(test_server_key_file), picoquic_solution_dir, PICOQUIC_TEST_FILE_SERVER_KEY);\n5853\t    }\n5854\t\n5855\t    if (ret == 0) {\n5856\t        ret = picoquic_get_input_path(test_server_cert_store_file, sizeof(test_server_cert_store_file), picoquic_solution_dir, PICOQUIC_TEST_FILE_CERT_STORE);\n5857\t    }\n5858\t\n5859\t    if (ret != 0) {\n5860\t        DBG_PRINTF(\"%s\", \"Cannot set the cert, key or store file names.\\n\");\n5861\t    }\n5862\t    else {\n5863\t        ret = tls_api_init_ctx(&test_ctx, 0, PICOQUIC_TEST_SNI, PICOQUIC_TEST_ALPN, &simulated_time, NULL, NULL, 0, 0, 0);\n5864\t    }\n5865\t\n5866\t    if (ret == 0 && test_ctx == NULL) {\n5867\t        ret = -1;\n5868\t    }\n5869\t\n5870\t    /* Delete the client context, and recreate with a certificate */\n5871\t    if (ret == 0)\n5872\t    {\n5873\t        if (test_ctx->qclient != NULL) {\n5874\t            picoquic_free(test_ctx->qclient);\n5875\t            test_ctx->cnx_client = NULL;\n5876\t        }\n5877\t\n5878\t        test_ctx->qclient = picoquic_create(8,\n5879\t            test_server_cert_file, test_server_key_file, test_server_cert_store_file,\n5880\t            NULL, test_api_callback, (void*)&test_ctx->client_callback, NULL, NULL, NULL,\n5881\t            simulated_time, &simulated_time, NULL, NULL, 0);\n5882\t\n5883\t        if (test_ctx->qclient == NULL) {\n5884\t            ret = -1;\n5885\t        }\n5886\t    }\n5887\t\n5888\t    /* recreate the client connection */\n5889\t    if (ret == 0) {\n5890\t        test_ctx->cnx_client = picoquic_create_cnx(test_ctx->qclient, picoquic_null_connection_id,\n5891\t                                                   picoquic_null_connection_id,\n5892\t                                                   (struct sockaddr*)&test_ctx->server_addr, 0,\n5893\t                                                   0, PICOQUIC_TEST_SNI, PICOQUIC_TEST_ALPN, 1);\n5894\t\n5895\t        if (test_ctx->cnx_client == NULL) {\n5896\t            ret = -1;\n5897\t        } else {\n5898\t            ret = picoquic_start_client_cnx(test_ctx->cnx_client);\n5899\t        }\n5900\t    }\n5901\t\n5902\t    if (ret == 0) {\n5903\t        picoquic_set_client_authentication(test_ctx->qserver, 1);\n5904\t        \n5905\t        /* Proceed with the connection loop. It should fail */\n5906\t        ret = tls_api_connection_loop(test_ctx, &loss_mask, 0, &simulated_time);\n5907\t    }\n5908\t\n5909\t    if (ret == 0) {\n5910\t        if (test_ctx->cnx_client == NULL) {\n5911\t            ret = -1;\n5912\t        }\n5913\t        else if (test_ctx->cnx_client->cnx_state != picoquic_state_disconnected) {\n5914\t            ret = -1;\n5915\t        }\n5916\t        else if (!picoquic_is_handshake_error(picoquic_get_local_error(test_ctx->cnx_server))) {\n5917\t            ret = -1;\n5918\t        }\n5919\t        else if (!picoquic_is_handshake_error(picoquic_get_remote_error(test_ctx->cnx_client))) {\n5920\t            ret = -1;\n5921\t        }\n5922\t    }\n5923\t\n5924\t    if (test_ctx != NULL) {\n5925\t        tls_api_delete_ctx(test_ctx);\n5926\t        test_ctx = NULL;\n5927\t    }\n5928\t\n5929\t    return ret;\n5930\t}\n5931\t\n5932\t/*\n5933\t* NAT Rebinding test. The client is unaware of the migration.\n5934\t* Start with one basic transmission, then switch the client\n5935\t* to a different port number. Verify that the server issues \n5936\t* a path challenge, that the client responds with a path\n5937\t* response, and that the connection completes.\n5938\t*/\n5939\t\n5940\tint nat_rebinding_count_r_cid(picoquic_cnx_t* cnx) {\n5941\t    int nb_cid = 0;\n5942\t    picoquic_remote_cnxid_t* r_cid = cnx->first_remote_cnxid_stash->cnxid_stash_first;\n5943\t\n5944\t    while (r_cid) {\n5945\t        nb_cid++;\n5946\t        r_cid = r_cid->next;\n5947\t    }\n5948\t\n5949\t    return nb_cid;\n5950\t}\n5951\t\n5952\tint nat_rebinding_test_one(uint64_t loss_mask_data, int zero_cid, uint64_t latency)\n5953\t{\n5954\t    int ret;\n5955\t    uint64_t simulated_time = 0;\n5956\t    uint64_t next_time = 0;\n5957\t    uint64_t loss_mask = 0;\n5958\t    uint64_t initial_challenge = 0;\n5959\t    int nb_inactive = 0;\n5960\t    picoquic_test_tls_api_ctx_t* test_ctx = NULL;\n5961\t    picoquic_connection_id_t initial_cid = { {0x19, 0x8a, 0, 0, 0, 0, 0, 0}, 8 };\n5962\t\n5963\t    if (loss_mask_data != 0) {\n5964\t        initial_cid.id[2] = 0x10;\n5965\t    }\n5966\t\n5967\t    if (zero_cid != 0) {\n5968\t        initial_cid.id[3] = 0xc1;\n5969\t    }\n5970\t\n5971\t    ret = tls_api_init_ctx_ex2(&test_ctx, PICOQUIC_INTERNAL_TEST_VERSION_1,\n5972\t        PICOQUIC_TEST_SNI, PICOQUIC_TEST_ALPN, &simulated_time, NULL, NULL, 0, 0, 0, &initial_cid, 8, zero_cid, 0, 0);\n5973\t\n5974\t    if (ret == 0 && test_ctx == NULL) {\n5975\t        ret = PICOQUIC_ERROR_MEMORY;\n5976\t    }\n5977\t    else {\n5978\t        if (latency > 0) {\n5979\t            test_ctx->c_to_s_link->microsec_latency = latency;\n5980\t            test_ctx->s_to_c_link->microsec_latency = latency;\n5981\t        }\n5982\t        picoquic_set_log_level(test_ctx->qserver, 1);\n5983\t        ret = picoquic_set_qlog(test_ctx->qserver, \".\");\n5984\t        picoquic_set_log_level(test_ctx->qclient, 1);\n5985\t        if (ret == 0) {\n5986\t            ret = picoquic_set_qlog(test_ctx->qclient, \".\");\n5987\t        }\n5988\t    }\n5989\t\n5990\t    if (ret == 0) {\n5991\t        ret = tls_api_connection_loop(test_ctx, &loss_mask, 0, &simulated_time);\n5992\t    }\n5993\t\n5994\t    /* run a receive loop until no outstanding data */\n5995\t    if (ret == 0) {\n5996\t        ret = tls_api_synch_to_empty_loop(test_ctx, &simulated_time, 2048, PICOQUIC_NB_PATH_TARGET, 1);\n5997\t    }\n5998\t\n5999\t    if (ret == 0) {"}]},"parent_tool_use_id":"toolu_01Rt4pELUTT189iuGyrewME6","session_id":"782f2f02-5f93-4f6f-b663-2ef2c783a0cf","uuid":"6905007b-2360-4f3f-b625-486b2c5b06ee","timestamp":"2026-05-05T12:37:41.956Z"}
{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01Uov53WBMvQSMiqz5vn3GcE","type":"tool_result","content":"6000\t        initial_challenge = test_ctx->cnx_server->path[0]->first_tuple->challenge[0];\n6001\t        loss_mask = loss_mask_data; \n6002\t        \n6003\t        /* Change the client address */\n6004\t        test_ctx->client_addr_natted = test_ctx->client_addr;\n6005\t        test_ctx->client_addr_natted.sin_port += 17;\n6006\t        test_ctx->client_use_nat = 1;\n6007\t\n6008\t        /* Prepare to send data */\n6009\t        ret = test_api_init_send_recv_scenario(test_ctx, test_scenario_q_and_r, sizeof(test_scenario_q_and_r));\n6010\t    }\n6011\t\n6012\t    /* Perform a data sending loop */\n6013\t    if (ret == 0) {\n6014\t        ret = tls_api_data_sending_loop(test_ctx, &loss_mask, &simulated_time, 0);\n6015\t    }\n6016\t    \n6017\t    /* verify that the transmission was complete */\n6018\t    if (ret == 0) {\n6019\t        ret = tls_api_one_scenario_verify(test_ctx);\n6020\t    }\n6021\t\n6022\t    /* Add a time loop of 3 seconds to give some time for the challenge to be repeated */\n6023\t    next_time = simulated_time + 3000000;\n6024\t    loss_mask = 0;\n6025\t    while (ret == 0 && simulated_time < next_time && TEST_CLIENT_READY \n6026\t        && TEST_SERVER_READY && !zero_cid\n6027\t        && (test_ctx->cnx_server->path[0]->first_tuple->challenge_verified != 1 ||\n6028\t            test_ctx->cnx_server->nb_paths > 1 ||\n6029\t            test_ctx->cnx_server->first_remote_cnxid_stash->cnxid_stash_first->sequence == 0 ||\n6030\t            nat_rebinding_count_r_cid(test_ctx->cnx_server) < 8 )) {\n6031\t        int was_active = 0;\n6032\t\n6033\t        ret = tls_api_one_sim_round(test_ctx, &simulated_time, next_time, &was_active);\n6034\t\n6035\t        if (was_active) {\n6036\t            nb_inactive = 0;\n6037\t        }\n6038\t        else {\n6039\t            nb_inactive++;\n6040\t            if (nb_inactive > 128) {\n6041\t                ret = 0;\n6042\t                if (nb_inactive > 256) {\n6043\t                    break;\n6044\t                }\n6045\t            }\n6046\t        }\n6047\t    }\n6048\t\n6049\t    /* Verify that the challenge was updated and done */\n6050\t    if (ret == 0) {\n6051\t        if (test_ctx->cnx_server == NULL) {\n6052\t            DBG_PRINTF(\"%s\", \"Server connection disappeared\");\n6053\t            ret = -1;\n6054\t        } else if (initial_challenge == test_ctx->cnx_server->path[0]->first_tuple->challenge[0]) {\n6055\t            DBG_PRINTF(\"%s\", \"Challenge was not renewed after NAT rebinding\");\n6056\t            ret = -1;\n6057\t        }\n6058\t        else if (test_ctx->cnx_server->path[0]->first_tuple->challenge_verified != 1) {\n6059\t            DBG_PRINTF(\"%s\", \"Challenge was not verified after NAT rebinding\");\n6060\t            ret = -1;\n6061\t        }\n6062\t    }\n6063\t\n6064\t    if (test_ctx != NULL) {\n6065\t        tls_api_delete_ctx(test_ctx);\n6066\t        test_ctx = NULL;\n6067\t    }\n6068\t\n6069\t    return ret;\n6070\t}\n6071\t\n6072\tint nat_rebinding_test(void)\n6073\t{\n6074\t    uint64_t loss_mask = 0;\n6075\t\n6076\t    return nat_rebinding_test_one(loss_mask, 0, 0);\n6077\t}\n6078\t\n6079\tint nat_rebinding_loss_test(void)\n6080\t{\n6081\t    uint64_t loss_mask = 0x2012;\n6082\t\n6083\t    return nat_rebinding_test_one(loss_mask, 0, 0);\n6084\t}\n6085\t\n6086\tint nat_rebinding_zero_test(void)\n6087\t{\n6088\t    /* Test of NAT rebinding with zero-length client CID */\n6089\t    uint64_t loss_mask = 0;\n6090\t\n6091\t    return nat_rebinding_test_one(loss_mask, 1, 0);\n6092\t}\n6093\t\n6094\tint nat_rebinding_latency_test(void)\n6095\t{\n6096\t    /* Test of NAT rebinding with zero-length client CID */\n6097\t    uint64_t loss_mask = 0;\n6098\t\n6099\t    return nat_rebinding_test_one(loss_mask, 0, 100000);\n6100\t}\n6101\t\n6102\t\n6103\t/*\n6104\t* Fast NAT Rebinding test. The client is unaware of the migration,\n6105\t* and is programmed to not support migration. The NAT alternates\n6106\t* between ports based on time, or packet counts. The test checks that\n6107\t* the connection survives 6 NAT transitions at short intervals.\n6108\t*/\n6109\t\n6110\tint fast_nat_rebinding_test(void)\n6111\t{\n6112\t    uint64_t simulated_time = 0;\n6113\t    uint64_t loss_mask = 0;\n6114\t    const int nb_switches_required = 6;\n6115\t    picoquic_test_tls_api_ctx_t* test_ctx = NULL;\n6116\t    picoquic_connection_id_t initial_cid = { {0xfa, 0x57, 0x08, 0xa7, 0, 0, 0, 0}, 8 };\n6117\t\n6118\t    int ret = tls_api_init_ctx_ex(&test_ctx, PICOQUIC_INTERNAL_TEST_VERSION_1,\n6119\t        PICOQUIC_TEST_SNI, PICOQUIC_TEST_ALPN, &simulated_time, NULL, NULL, 0, 0, 0, &initial_cid);\n6120\t\n6121\t    if (ret == 0 && test_ctx == NULL) {\n6122\t        ret = PICOQUIC_ERROR_MEMORY;\n6123\t    }\n6124\t\n6125\t    if (ret == 0) {\n6126\t        /* Set up logging */ \n6127\t        picoquic_set_qlog(test_ctx->qserver, \".\");\n6128\t        picoquic_set_qlog(test_ctx->qclient, \".\");\n6129\t    }\n6130\t\n6131\t    if (ret == 0) {\n6132\t        ret = tls_api_connection_loop(test_ctx, &loss_mask, 0, &simulated_time);\n6133\t    }\n6134\t\n6135\t    if (ret == 0) {\n6136\t        ret = test_api_init_send_recv_scenario(test_ctx, test_scenario_sustained, sizeof(test_scenario_sustained));\n6137\t    }\n6138\t\n6139\t    /* Perform a data sending loop */\n6140\t    if (ret == 0) {\n6141\t        uint64_t delta_t = 5 * (test_ctx->c_to_s_link->microsec_latency + test_ctx->s_to_c_link->microsec_latency);\n6142\t        uint64_t next_time = simulated_time + 200000000;\n6143\t        int nb_trials = 0;\n6144\t        int nb_inactive = 0;\n6145\t        int max_trials = 1000000;\n6146\t        uint64_t switch_time = simulated_time;\n6147\t        int switched = 0;\n6148\t        int nb_switched = 0;\n6149\t\n6150\t        test_ctx->client_use_nat = 1;\n6151\t        test_ctx->client_addr_natted = test_ctx->client_addr;\n6152\t        test_ctx->client_addr_natted.sin_port += 17;\n6153\t\n6154\t        while (ret == 0 && nb_trials < max_trials && nb_inactive < 256 && simulated_time < next_time && TEST_CLIENT_READY && TEST_SERVER_READY) {\n6155\t            int was_active = 0;\n6156\t\n6157\t            nb_trials++;\n6158\t\n6159\t            ret = tls_api_one_sim_round(test_ctx, &simulated_time, next_time, &was_active);\n6160\t\n6161\t            if (ret < 0)\n6162\t            {\n6163\t                break;\n6164\t            }\n6165\t\n6166\t            if (ret == 0 && test_ctx->cnx_server != NULL && test_ctx->cnx_server->cnx_state == picoquic_state_ready) {\n6167\t                if (((struct sockaddr_in*) & test_ctx->cnx_server->path[0]->first_tuple->peer_addr)->sin_port == 0) {\n6168\t                    DBG_PRINTF(\"Client address out of sync, port: %d\", ((struct sockaddr_in*) & test_ctx->cnx_server->path[0]->first_tuple->peer_addr)->sin_port);\n6169\t                }\n6170\t                else if (((struct sockaddr_in*) & test_ctx->cnx_server->path[0]->first_tuple->peer_addr)->sin_port == test_ctx->client_addr_natted.sin_port) {\n6171\t                    if (switched) {\n6172\t                        if (simulated_time > switch_time + delta_t &&\n6173\t                            nb_switched < nb_switches_required) {\n6174\t                            switched = 0;\n6175\t                        }\n6176\t                    }\n6177\t                    else\n6178\t                    {\n6179\t                        /* Change the client address */\n6180\t                        test_ctx->client_addr_natted.sin_port += 17;\n6181\t                        switched = 1;\n6182\t                        switch_time = simulated_time;\n6183\t                        nb_switched++;\n6184\t                    }\n6185\t                }\n6186\t            }\n6187\t\n6188\t            if (was_active) {\n6189\t                nb_inactive = 0;\n6190\t            }\n6191\t            else {\n6192\t                nb_inactive++;\n6193\t\n6194\t                if (nb_inactive == 254) {\n6195\t                    DBG_PRINTF(\"Almost stalled after %d trials, %d inactive, %d switches\", nb_trials, nb_inactive, nb_switched);\n6196\t                }\n6197\t            }\n6198\t\n6199\t            if (test_ctx->test_finished) {\n6200\t                if (picoquic_is_cnx_backlog_empty(test_ctx->cnx_client) && picoquic_is_cnx_backlog_empty(test_ctx->cnx_server)) {\n6201\t                    break;\n6202\t                }\n6203\t            }\n6204\t        }\n6205\t\n6206\t        DBG_PRINTF(\"Exit after %d trials, %d inactive, %d switches\", nb_trials, nb_inactive, nb_switched);\n6207\t\n6208\t        /* Verify that the test was effective */\n6209\t        if (ret == 0 && nb_switched < nb_switches_required) {\n6210\t            ret = -1;\n6211\t        }\n6212\t    }\n6213\t\n6214\t    /* verify that the transmission was complete */\n6215\t    if (ret == 0) {\n6216\t        ret = tls_api_one_scenario_verify(test_ctx);\n6217\t    }\n6218\t\n6219\t    if (test_ctx != NULL) {\n6220\t        tls_api_delete_ctx(test_ctx);\n6221\t        test_ctx = NULL;\n6222\t    }\n6223\t\n6224\t    return ret;\n6225\t}\n6226\t\n6227\t/*\n6228\t * Test whether the loss bit reporting can be enabled without breaking the connection\n6229\t */\n6230\t\n6231\tint loss_bit_test(void)\n6232\t{\n6233\t    int ret = 0;\n6234\t    picoquic_tp_t client_parameters;\n6235\t    picoquic_tp_t server_parameters;\n6236\t\n6237\t    for (int i = 0; ret == 0 && i <= 3; i++) {\n6238\t        memset(&client_parameters, 0, sizeof(picoquic_tp_t));\n6239\t        memset(&server_parameters, 0, sizeof(picoquic_tp_t));\n6240\t        picoquic_init_transport_parameters(&client_parameters);\n6241\t        picoquic_init_transport_parameters(&server_parameters);\n6242\t\n6243\t        client_parameters.enable_loss_bit = (i & 1);\n6244\t        server_parameters.enable_loss_bit = ((i > 1) & 1);\n6245\t\n6246\t        ret = tls_api_one_scenario_test(test_scenario_many_streams, sizeof(test_scenario_many_streams), 0, 0, 0, 0, 0, 250000, &client_parameters, &server_parameters);\n6247\t        if (ret != 0) {\n6248\t            DBG_PRINTF(\"Loss bit test fails for client: %d, server: %d, ret = %d\", i & 1, i >> 1, ret);\n6249\t        }\n6250\t    }\n6251\t\n6252\t    return ret;\n6253\t}\n6254\t\n6255\t\n6256\t/*\n6257\t* Closing on error test. We voluntarily inject an erroneous\n6258\t* frame on the client connection. The expected result is that\n6259\t* the server connection gets closed, but the server remains\n6260\t* responsive.\n6261\t*/\n6262\t\n6263\tint client_error_test_modal(int mode)\n6264\t{\n6265\t    uint64_t simulated_time = 0;\n6266\t    uint64_t next_time = 0;\n6267\t    uint64_t loss_mask = 0;\n6268\t    picoquic_test_tls_api_ctx_t* test_ctx = NULL;\n6269\t    int ret = tls_api_init_ctx(&test_ctx, PICOQUIC_INTERNAL_TEST_VERSION_1,\n6270\t        PICOQUIC_TEST_SNI, PICOQUIC_TEST_ALPN, &simulated_time, NULL, NULL, 0, 0, 0);\n6271\t\n6272\t    if (ret == 0) {\n6273\t        ret = tls_api_connection_loop(test_ctx, &loss_mask, 0, &simulated_time);\n6274\t    }\n6275\t\n6276\t    /* Prepare to send data */\n6277\t    if (ret == 0) {\n6278\t        ret = test_api_init_send_recv_scenario(test_ctx, test_scenario_q_and_r, sizeof(test_scenario_q_and_r));\n6279\t    }\n6280\t\n6281\t    /* Perform a data sending loop */\n6282\t    if (ret == 0) {\n6283\t        ret = tls_api_data_sending_loop(test_ctx, &loss_mask, &simulated_time, 0);\n6284\t    }\n6285\t\n6286\t    /* Inject an erroneous frame */\n6287\t    if (ret == 0) {\n6288\t        if (mode == 0) {\n6289\t            /* Queue a data frame on stream 4, which was already closed */\n6290\t            uint8_t stream_error_frame[] = { 0x17, 0x04, 0x41, 0x01, 0x08, 0x00, 0x01, 0x02, 0x03, 0x04, 0x05, 0x06, 0x07 };\n6291\t            picoquic_queue_misc_frame(test_ctx->cnx_client, stream_error_frame, sizeof(stream_error_frame), 0,\n6292\t                picoquic_packet_context_application);\n6293\t        }\n6294\t        else if (mode == 1) {\n6295\t            /* Test injection of a wrong NEW CONNECTION ID */\n6296\t            uint8_t new_cnxid_error[1024];\n6297\t            uint8_t* x = new_cnxid_error;\n6298\t\n6299\t            *x++ = picoquic_frame_type_new_connection_id;\n6300\t            *x++ = test_ctx->cnx_client->nb_paths + 3;\n6301\t            *x++ = 0;\n6302\t            *x++ = 8;\n6303\t            for (int i = 0; i < 8; i++) {\n6304\t                *x++ = 0x99; /* Hommage to Dilbert's random generator */\n6305\t            }\n6306\t            /* deliberate error: repeat the reset secret defined for path[0] */\n6307\t            memcpy(x, test_ctx->cnx_server->path[0]->first_tuple->p_remote_cnxid->reset_secret, PICOQUIC_RESET_SECRET_SIZE);\n6308\t            x += PICOQUIC_RESET_SECRET_SIZE;\n6309\t            picoquic_queue_misc_frame(test_ctx->cnx_client, new_cnxid_error, x - new_cnxid_error, 0,\n6310\t                picoquic_packet_context_application);\n6311\t        }\n6312\t        else if (mode == 2) {\n6313\t            /* Queue a stop sending on stream 2, which is unidir */\n6314\t            uint8_t stop_sending_error_frame[] = { (uint8_t)picoquic_frame_type_stop_sending, 2, 0 };\n6315\t            picoquic_queue_misc_frame(test_ctx->cnx_client, stop_sending_error_frame, sizeof(stop_sending_error_frame), 0,\n6316\t                picoquic_packet_context_application);\n6317\t        }\n6318\t        else {\n6319\t            DBG_PRINTF(\"Error mode %d is not defined yet\", mode);\n6320\t        }\n6321\t    }\n6322\t\n6323\t    /* Add a time loop of 3 seconds to give some time for the error to be repeated */\n6324\t    next_time = simulated_time + 3000000;\n6325\t    loss_mask = 0;\n6326\t    while (ret == 0 && simulated_time < next_time\n6327\t        && (test_ctx->cnx_client->cnx_state < picoquic_state_disconnected ||\n6328\t            test_ctx->cnx_server->cnx_state < picoquic_state_disconnected)) {\n6329\t        int was_active = 0;\n6330\t\n6331\t        ret = tls_api_one_sim_round(test_ctx, &simulated_time, next_time, &was_active);\n6332\t    }\n6333\t\n6334\t    if (ret == 0 && test_ctx->cnx_server->cnx_state != picoquic_state_disconnected) {\n6335\t        ret = -1;\n6336\t    }\n6337\t\n6338\t    if (ret == 0) {\n6339\t        /* Delete the client connection from the client context,\n6340\t         * without sending notification to the server */\n6341\t        while (test_ctx->qclient->cnx_list != NULL) {\n6342\t            picoquic_delete_cnx(test_ctx->qclient->cnx_list);\n6343\t        }\n6344\t\n6345\t        /* Erase the server connection reference */\n6346\t        test_ctx->cnx_server = NULL;\n6347\t\n6348\t        /* Create a new connection in the client context */\n6349\t\n6350\t        test_ctx->cnx_client = picoquic_create_cnx(test_ctx->qclient,\n6351\t            picoquic_null_connection_id, picoquic_null_connection_id,\n6352\t            (struct sockaddr*)&test_ctx->server_addr, simulated_time, 0, PICOQUIC_TEST_SNI, PICOQUIC_TEST_ALPN, 1);\n6353\t\n6354\t        if (test_ctx->cnx_client == NULL) {\n6355\t            ret = -1;\n6356\t        }\n6357\t        else if (ret == 0) {\n6358\t            ret = picoquic_start_client_cnx(test_ctx->cnx_client);\n6359\t        }\n6360\t    }\n6361\t\n6362\t    /* Now, restart a connection in the same context */\n6363\t    if (ret == 0) {\n6364\t        ret = tls_api_connection_loop(test_ctx, &loss_mask, 0, &simulated_time);\n6365\t    }\n6366\t\n6367\t    if (ret == 0){\n6368\t        ret = wait_application_aead_ready(test_ctx, &simulated_time);\n6369\t    }\n6370\t\n6371\t    if (ret == 0) {\n6372\t        ret = tls_api_attempt_to_close(test_ctx, &simulated_time);\n6373\t    }\n6374\t\n6375\t    if (test_ctx != NULL) {\n6376\t        tls_api_delete_ctx(test_ctx);\n6377\t        test_ctx = NULL;\n6378\t    }\n6379\t\n6380\t    return ret;\n6381\t}\n6382\t\n6383\tint client_error_test(void)\n6384\t{\n6385\t    int ret = 0;\n6386\t    char const* mode_name[] = { \"stream\", \"new_connection_id\", \"stop_sending\" };\n6387\t    int nb_modes = (int)(sizeof(mode_name) / sizeof(char const*));\n6388\t\n6389\t    for (int mode = 0; mode < nb_modes; mode++) {\n6390\t        if (client_error_test_modal(mode) != 0) {\n6391\t            DBG_PRINTF(\"Client error test mode(%s) failed.\\n\", mode_name[mode]);\n6392\t            ret = -1;\n6393\t        }\n6394\t    }\n6395\t\n6396\t    return ret;\n6397\t}\n6398\t\n6399\t/*\n6400\t* Client only test. Verify that if \"client only\" is set on the server context,\n6401\t* then connections are refused.\n6402\t*/\n6403\t\n6404\tint client_only_test(void)\n6405\t{\n6406\t    uint64_t simulated_time = 0;\n6407\t    uint64_t loss_mask = 0;\n6408\t    picoquic_test_tls_api_ctx_t* test_ctx = NULL;\n6409\t    picoquic_connection_id_t initial_cid = { {0xc1, 0x10, 0, 0, 0, 0, 0, 0}, 8 };\n6410\t    int ret;\n6411\t\n6412\t    ret = tls_api_init_ctx_ex(&test_ctx, PICOQUIC_INTERNAL_TEST_VERSION_1,\n6413\t        PICOQUIC_TEST_SNI, PICOQUIC_TEST_ALPN, &simulated_time, NULL, NULL, 0, 0, 0, &initial_cid);\n6414\t\n6415\t    if (ret == 0) {\n6416\t        /* First, try enforcement. We do set log on the server side, but it is expected to be empty */\n6417\t        int connection_ret = 0;\n6418\t        picoquic_enforce_client_only(test_ctx->qserver, 1);\n6419\t        picoquic_set_qlog(test_ctx->qserver, \".\");\n6420\t        picoquic_set_qlog(test_ctx->qclient, \".\");\n6421\t        connection_ret = tls_api_connection_loop(test_ctx, &loss_mask, 0, &simulated_time);\n6422\t        if (connection_ret == 0 && test_ctx->cnx_client->cnx_state < picoquic_state_disconnected) {\n6423\t            DBG_PRINTF(\"Connection unexpectedly succeeds, state=%d, ret=%d (0x%x)\",\n6424\t                test_ctx->cnx_client->cnx_state, connection_ret, connection_ret);\n6425\t            ret = -1;\n6426\t        }\n6427\t        else if (test_ctx->cnx_server != NULL) {\n6428\t            DBG_PRINTF(\"Connection context created on client-only note, ret=%d (0x%x)\",\n6429\t                connection_ret, connection_ret);\n6430\t            ret = -1;\n6431\t        }\n6432\t    }\n6433\t\n6434\t    if (test_ctx != NULL) {\n6435\t        tls_api_delete_ctx(test_ctx);\n6436\t        test_ctx = NULL;\n6437\t    }\n6438\t\n6439\t    return ret;\n6440\t}\n6441\t\n6442\t/*\n6443\t * Set a connection, then verify that the \"new connection id\" frames have been exchanged properly.\n6444\t * Use the \"check stash\" function to verify that new connection ID were properly\n6445\t * stashed on each side.\n6446\t *\n6447\t * TODO: also test that no New Connection Id frames are sent if migration is disabled \n6448\t */\n6449\t\n6450\tint test_cnxid_count_stash(picoquic_cnx_t * cnx) {\n6451\t    picoquic_remote_cnxid_t * stash = cnx->first_remote_cnxid_stash->cnxid_stash_first;\n6452\t    int nb = 0;\n6453\t\n6454\t    while (stash != NULL) {\n6455\t        nb++;\n6456\t        stash = stash->next;\n6457\t    }\n6458\t\n6459\t    return nb;\n6460\t}\n6461\t\n6462\tint transmit_cnxid_test_stash(picoquic_cnx_t * cnx1, picoquic_cnx_t * cnx2, char const * cnx_text)\n6463\t{\n6464\t    int ret = 0;\n6465\t    picoquic_remote_cnxid_t * stash = cnx1->first_remote_cnxid_stash->cnxid_stash_first;\n6466\t    picoquic_local_cnxid_t* cid_list = cnx2->first_local_cnxid_list->local_cnxid_first;\n6467\t    int rank = 0;\n6468\t\n6469\t    while (stash != NULL && cid_list != NULL) {\n6470\t        if (picoquic_compare_connection_id(&stash->cnx_id, &cid_list->cnx_id) != 0) {\n6471\t            DBG_PRINTF(\"On %s, cnx ID of stash #%d does not match cid[%d] of peer.\\n\",\n6472\t                cnx_text, rank, (int)cid_list->sequence);\n6473\t            ret = -1;\n6474\t            break;\n6475\t        }\n6476\t        stash = stash->next;\n6477\t        cid_list = cid_list->next;\n6478\t        rank++;\n6479\t    }\n6480\t\n6481\t    if (ret == 0 && cid_list != NULL) {\n6482\t        DBG_PRINTF(\"On %s, %d items in stash instead instead of %d.\\n\", cnx_text, rank, \n6483\t            cnx2->first_local_cnxid_list->nb_local_cnxid - 1);\n6484\t        ret = -1;\n6485\t    }\n6486\t\n6487\t    if (ret == 0 && stash != NULL) {\n6488\t        DBG_PRINTF(\"On %s, more than %d items in stash.\\n\", cnx_text, cnx2->first_local_cnxid_list->nb_local_cnxid - 1);\n6489\t        ret = -1;\n6490\t    }\n6491\t\n6492\t    return ret;\n6493\t}\n6494\t\n6495\tint transmit_cnxid_test_one(int retire_before, int disable_migration, int retire_number_zero)\n6496\t{\n6497\t    uint64_t simulated_time = 0;\n6498\t    uint64_t loss_mask = 0;\n6499\t    /* We set the default ttl to 5 seconds, which is longer than the\n6500\t     * delay set inside tls_api_synch_to_empty_loop */\n6501\t    const uint64_t sync_empty_loop_timeout = 4000000;\n6502\t    const uint64_t default_connection_id_ttl = 5000000;\n6503\t    picoquic_test_tls_api_ctx_t* test_ctx = NULL;\n6504\t    picoquic_tp_t test_parameters;\n6505\t    int ret = tls_api_init_ctx(&test_ctx, PICOQUIC_INTERNAL_TEST_VERSION_1,\n6506\t        PICOQUIC_TEST_SNI, PICOQUIC_TEST_ALPN, &simulated_time, NULL, NULL, 0, 0, 0);\n6507\t\n6508\t    if (ret == 0 && disable_migration) {\n6509\t        memset(&test_parameters, 0, sizeof(picoquic_tp_t));\n6510\t\n6511\t        picoquic_init_transport_parameters(&test_parameters);\n6512\t        test_parameters.migration_disabled = 1;\n6513\t        picoquic_set_default_tp(test_ctx->qserver, &test_parameters);\n6514\t    }\n6515\t\n6516\t    if (ret == 0 && retire_before) {\n6517\t        picoquic_set_default_connection_id_ttl(test_ctx->qserver, default_connection_id_ttl);\n6518\t    }\n6519\t\n6520\t    if (retire_number_zero) {\n6521\t        /* Do a short loop until the server connection is created */\n6522\t        int nb_trials = 0;\n6523\t        while (ret == 0 && nb_trials < 16 && test_ctx->cnx_server == NULL) {\n6524\t            int was_active = 0;\n6525\t            nb_trials++;\n6526\t\n6527\t            ret = tls_api_one_sim_round(test_ctx, &simulated_time, 0, &was_active);\n6528\t        }\n6529\t        if (test_ctx->cnx_server == NULL) {\n6530\t            DBG_PRINTF(\"Cannot create the server connection after %d trials\", nb_trials);\n6531\t            ret = -1;\n6532\t        }\n6533\t        else {\n6534\t            /* force the retire prior to 1 so it be set in the first batch of CID. */\n6535\t            test_ctx->cnx_server->first_local_cnxid_list->local_cnxid_retire_before = 1;\n6536\t        }\n6537\t    }\n6538\t\n6539\t    if (ret == 0) {\n6540\t        ret = tls_api_connection_loop(test_ctx, &loss_mask, 0, &simulated_time);\n6541\t    }\n6542\t\n6543\t    /* run a receive loop until no outstanding data */\n6544\t    if (ret == 0) {\n6545\t        ret = tls_api_synch_to_empty_loop(test_ctx, &simulated_time, 2048, PICOQUIC_NB_PATH_TARGET, 0);\n6546\t    }\n6547\t\n6548\t    if (ret == 0 && retire_number_zero) {\n6549\t        /* verify that the path 0 on client uses CID number > 1 */\n6550\t        if (test_ctx->cnx_client->path[0]->first_tuple->p_remote_cnxid->sequence == 0) {\n6551\t            DBG_PRINTF(\"First path still has CNX_ID=%d\", test_ctx->cnx_client->path[0]->first_tuple->p_remote_cnxid->sequence);\n6552\t            ret = -1;\n6553\t        }\n6554\t    }\n6555\t\n6556\t    if (ret == 0 && retire_before) {\n6557\t        /* wait until the TTL of local CID expires */\n6558\t        ret = tls_api_wait_for_timeout(test_ctx, &simulated_time, default_connection_id_ttl - sync_empty_loop_timeout);\n6559\t\n6560\t        if (ret == 0 && test_ctx->cnx_server->first_local_cnxid_list->local_cnxid_retire_before == 0) {\n6561\t            DBG_PRINTF(\"Retire before did not progress: %\" PRIu64 \".\\n\",\n6562\t                test_ctx->cnx_server->first_local_cnxid_list->local_cnxid_retire_before);\n6563\t            ret = -1;\n6564\t        }\n6565\t\n6566\t        /* Now, wait until the next batch of connection ID is sent. */\n6567\t        if (ret == 0) {\n6568\t            ret = tls_api_synch_to_empty_loop(test_ctx, &simulated_time, 2048, PICOQUIC_NB_PATH_TARGET, 0);\n6569\t        }\n6570\t    }\n6571\t\n6572\t    if (ret == 0) {\n6573\t        if (test_ctx->cnx_client->first_local_cnxid_list->nb_local_cnxid < PICOQUIC_NB_PATH_TARGET) {\n6574\t            DBG_PRINTF(\"Only %d CID created on client.\\n\", test_ctx->cnx_client->first_local_cnxid_list->nb_local_cnxid);\n6575\t            ret = -1;\n6576\t        } else if (test_ctx->cnx_server->first_local_cnxid_list->nb_local_cnxid < PICOQUIC_NB_PATH_TARGET) {\n6577\t            DBG_PRINTF(\"Only %d CID created on server.\\n\", test_ctx->cnx_server->first_local_cnxid_list->nb_local_cnxid);\n6578\t        }\n6579\t    }\n6580\t\n6581\t    if (ret == 0) {\n6582\t        ret = transmit_cnxid_test_stash(test_ctx->cnx_client, test_ctx->cnx_server, \"client\");\n6583\t    }\n6584\t\n6585\t    if (ret == 0) {\n6586\t        ret = transmit_cnxid_test_stash(test_ctx->cnx_server, test_ctx->cnx_client, \"server\");\n6587\t    }\n6588\t\n6589\t    if (ret == 0 && retire_before) {\n6590\t        /* Verify that all CID in the client stash have valid sequence numbers. */\n6591\t        picoquic_remote_cnxid_t* stashed = test_ctx->cnx_client->first_remote_cnxid_stash->cnxid_stash_first;\n6592\t\n6593\t        while (stashed != NULL && ret == 0) {\n6594\t            if (stashed->sequence < test_ctx->cnx_server->first_local_cnxid_list->local_cnxid_retire_before) {\n6595\t                DBG_PRINTF(\"Old CID %\" PRIu64 \" still on client.\\n\", stashed->sequence);\n6596\t                ret = -1;\n6597\t                break;\n6598\t            }\n6599\t            stashed = stashed->next;\n6600\t        }\n6601\t    }\n6602\t\n6603\t    if (test_ctx != NULL) {\n6604\t        tls_api_delete_ctx(test_ctx);\n6605\t        test_ctx = NULL;\n6606\t    }\n6607\t\n6608\t    return ret;\n6609\t}\n6610\t\n6611\tint transmit_cnxid_test(void)\n6612\t{\n6613\t    return transmit_cnxid_test_one(0, 0, 0);\n6614\t}\n6615\t\n6616\tint transmit_cnxid_disable_test(void)\n6617\t{\n6618\t    return transmit_cnxid_test_one(0, 1, 0);\n6619\t}\n6620\t\n6621\tint transmit_cnxid_retire_before_test(void)\n6622\t{\n6623\t    return transmit_cnxid_test_one(1, 0, 0);\n6624\t}\n6625\t\n6626\tint transmit_cnxid_retire_disable_test(void)\n6627\t{\n6628\t    return transmit_cnxid_test_one(1, 1, 0);\n6629\t}\n6630\t\n6631\tint transmit_cnxid_retire_early_test(void)\n6632\t{\n6633\t    return transmit_cnxid_test_one(0, 0, 1);\n6634\t}\n6635\t\n6636\t/*\n6637\t * Unit test for the probe management functions.\n6638\t *\n6639\t * Set up a connection, exchange new cnxid frames, then create a number of probes.\n6640\t * When the number exceeds the number of connections, the probing should fail.\n6641\t */\n6642\t\n6643\tint probe_api_test(void)\n6644\t{\n6645\t    uint64_t simulated_time = 0;\n6646\t    uint64_t loss_mask = 0;\n6647\t    picoquic_test_tls_api_ctx_t* test_ctx = NULL;\n6648\t    struct sockaddr_in t4[PICOQUIC_NB_PATH_TARGET];\n6649\t    struct sockaddr_in6 t6[PICOQUIC_NB_PATH_TARGET];\n6650\t    int nb_trials;\n6651\t\n6652\t    /* Initialize the test addresses to synthetic values */\n6653\t    for (int i = 0; i < PICOQUIC_NB_PATH_TARGET; i++) {\n6654\t        memset(&t4[i], 0, sizeof(struct sockaddr_in));\n6655\t        t4[i].sin_family = AF_INET;\n6656\t        t4[i].sin_port = 1000+i;\n6657\t        memset(&t4[i].sin_addr, i, 4);\n6658\t        memset(&t6[i], 0, sizeof(struct sockaddr_in6));\n6659\t        t6[i].sin6_family = AF_INET6;\n6660\t        t6[i].sin6_port = 2000 + i;\n6661\t        memset(&t6[i].sin6_addr, i, 16);\n6662\t    }\n6663\t\n6664\t    /* Set a test connection between client and server */\n6665\t    int ret = tls_api_init_ctx(&test_ctx, PICOQUIC_INTERNAL_TEST_VERSION_1,\n6666\t        PICOQUIC_TEST_SNI, PICOQUIC_TEST_ALPN, &simulated_time, NULL, NULL, 0, 0, 0);\n6667\t\n6668\t    if (ret == 0) {\n6669\t        ret = tls_api_connection_loop(test_ctx, &loss_mask, 0, &simulated_time);\n6670\t    }\n6671\t\n6672\t    /* run a receive loop until no outstanding data */\n6673\t    if (ret == 0) {\n6674\t        ret = tls_api_synch_to_empty_loop(test_ctx, &simulated_time, 2048, PICOQUIC_NB_PATH_TARGET, 0);\n6675\t    }\n6676\t\n6677\t    if (ret == 0) {\n6678\t        if (test_ctx->cnx_client->first_local_cnxid_list->nb_local_cnxid < PICOQUIC_NB_PATH_TARGET) {\n6679\t            DBG_PRINTF(\"Only %d CID created on client.\\n\", test_ctx->cnx_client->first_local_cnxid_list->nb_local_cnxid);\n6680\t            ret = -1;\n6681\t        }\n6682\t        else if (test_ctx->cnx_server->first_local_cnxid_list->nb_local_cnxid < PICOQUIC_NB_PATH_TARGET) {\n6683\t            DBG_PRINTF(\"Only %d CID created on server.\\n\", test_ctx->cnx_server->first_local_cnxid_list->nb_local_cnxid);\n6684\t        }\n6685\t    }\n6686\t\n6687\t    /* Now, create a series of probes.\n6688\t     * There are only PICOQUIC_NB_PATH_TARGET - 1 paths available. \n6689\t     * The last trial should fail.\n6690\t     */\n6691\t    nb_trials = 0;\n6692\t\n6693\t    for (int i = 1; ret == 0 && test_ctx->cnx_client->nb_paths < PICOQUIC_NB_PATH_TARGET && i < PICOQUIC_NB_PATH_TARGET; i++) {\n6694\t        for (int j = 0; ret == 0 && j < 2; j++) {\n6695\t            int ret_probe;\n6696\t            if (j == 0) {\n6697\t                ret_probe = picoquic_probe_new_path(test_ctx->cnx_client, (struct sockaddr *) &t4[0], \n6698\t                    (struct sockaddr *) &t4[i], simulated_time);\n6699\t            } else {\n6700\t                ret_probe = picoquic_probe_new_path(test_ctx->cnx_client, (struct sockaddr *) &t6[0],\n6701\t                    (struct sockaddr *) &t6[i], simulated_time);\n6702\t            }\n6703\t\n6704\t            nb_trials++;\n6705\t\n6706\t            if (nb_trials < PICOQUIC_NB_PATH_TARGET) {\n6707\t                if (ret_probe != 0) {\n6708\t                    DBG_PRINTF(\"Trial %d (%d, %d) fails with ret = %x\\n\", nb_trials, i, j, ret_probe);\n6709\t                    ret = -1;\n6710\t                }\n6711\t            }\n6712\t            else if (ret_probe == 0) {\n6713\t                DBG_PRINTF(\"Trial %d (%d, %d) succeeds (unexpected)\\n\", nb_trials, i, j);\n6714\t                ret = -1;\n6715\t            }\n6716\t\n6717\t            if (ret == 0 && ret_probe == 0) {\n6718\t                int path_id = test_ctx->cnx_client->nb_paths - 1;\n6719\t                for (int ichal = 0; ichal < PICOQUIC_CHALLENGE_REPEAT_MAX; ichal++) {\n6720\t                    test_ctx->cnx_client->path[path_id]->first_tuple->challenge[ichal] = (uint64_t)10000 + (uint64_t)10 * i + j + (uint64_t)1000*ichal;\n6721\t                }\n6722\t            }\n6723\t        }\n6724\t    }\n6725\t\n6726\t    /* Releasing the context will test the delete functions. */\n6727\t    if (test_ctx != NULL) {\n6728\t        tls_api_delete_ctx(test_ctx);\n6729\t        test_ctx = NULL;\n6730\t    }\n6731\t\n6732\t    return ret;\n6733\t}\n6734\t\n6735\t/*\n6736\t * Migration test. The client is aware of the migration, and\n6737\t * starts the migration by explicitly probing a new path.\n6738\t */\n6739\t\n6740\tint migration_test_scenario(test_api_stream_desc_t * scenario, size_t size_of_scenario, uint64_t loss_target, int cid_zero)\n6741\t{\n6742\t    uint64_t simulated_time = 0;\n6743\t    uint64_t next_time = 0;\n6744\t    uint64_t loss_mask = 0;\n6745\t    uint64_t initial_challenge = 0;\n6746\t    picoquic_connection_id_t target_id = picoquic_null_connection_id;\n6747\t    picoquic_connection_id_t previous_local_id = picoquic_null_connection_id;\n6748\t    picoquic_test_tls_api_ctx_t* test_ctx = NULL;\n6749\t    int ret = tls_api_init_ctx_ex2(&test_ctx, PICOQUIC_INTERNAL_TEST_VERSION_1,\n6750\t        PICOQUIC_TEST_SNI, PICOQUIC_TEST_ALPN, &simulated_time, NULL, NULL, 0, 0, 0, NULL, 8, cid_zero, 0, 0);\n6751\t\n6752\t    if (ret == 0 && test_ctx == NULL) {\n6753\t        ret = PICOQUIC_ERROR_MEMORY;\n6754\t    }\n6755\t\n6756\t    if (ret == 0) {\n6757\t        ret = tls_api_connection_loop(test_ctx, &loss_mask, 0, &simulated_time);\n6758\t    }\n6759\t\n6760\t    /* run a receive loop until no outstanding data */\n6761\t    if (ret == 0) {\n6762\t        ret = tls_api_synch_to_empty_loop(test_ctx, &simulated_time, 2048, PICOQUIC_NB_PATH_TARGET, 1);\n6763\t    }\n6764\t\n6765\t    if (ret == 0) {\n6766\t        /* Change the client address */\n6767\t        test_ctx->client_addr.sin_port += 17;\n6768\t\n6769\t        /* Probe the new path */\n6770\t        ret = picoquic_probe_new_path(test_ctx->cnx_client, (struct sockaddr *)&test_ctx->server_addr,\n6771\t            (struct sockaddr *)&test_ctx->client_addr, simulated_time);\n6772\t\n6773\t        if (ret == 0) {\n6774\t            if (test_ctx->cnx_client->path[0]->first_tuple->next_tuple == NULL ||\n6775\t                test_ctx->cnx_client->path[0]->first_tuple->next_tuple->p_remote_cnxid == NULL) {\n6776\t                ret = -1;\n6777\t            }\n6778\t            else {\n6779\t                target_id = test_ctx->cnx_client->path[0]->first_tuple->next_tuple->p_remote_cnxid->cnx_id;\n6780\t                if (!cid_zero) {\n6781\t                    previous_local_id = test_ctx->cnx_client->path[0]->first_tuple->p_local_cnxid->cnx_id;\n6782\t                }\n6783\t            }\n6784\t        }\n6785\t    }\n6786\t\n6787\t    /* Prepare to send data */\n6788\t    if (ret == 0) {\n6789\t        ret = test_api_init_send_recv_scenario(test_ctx, scenario, size_of_scenario);\n6790\t    }\n6791\t\n6792\t    /* Perform a data sending loop */\n6793\t    loss_mask = loss_target;\n6794\t\n6795\t    if (ret == 0) {\n6796\t        ret = tls_api_data_sending_loop(test_ctx, &loss_mask, &simulated_time, 0);\n6797\t    }\n6798\t\n6799\t    /* Check that the data was sent and received */\n6800\t    if (ret == 0) {\n6801\t        ret = tls_api_one_scenario_verify(test_ctx);\n6802\t    }\n6803\t\n6804\t    /* Add a time loop of 3 seconds to give some time for the probes to be repeated */\n6805\t    next_time = simulated_time + 4000000;\n6806\t    loss_mask = 0;\n6807\t    while (ret == 0 && simulated_time < next_time && TEST_CLIENT_READY\n6808\t        && TEST_SERVER_READY\n6809\t        && (test_ctx->cnx_server->path[0]->first_tuple->challenge_verified != 1 || test_ctx->cnx_client->path[0]->path_is_demoted == 1 ||\n6810\t            initial_challenge == test_ctx->cnx_server->path[0]->first_tuple->challenge[0])) {\n6811\t        int was_active = 0;\n6812\t\n6813\t        ret = tls_api_one_sim_round(test_ctx, &simulated_time, next_time, &was_active);\n6814\t    }\n6815\t\n6816\t    /* Verify that the challenge was updated and done */\n6817\t    /* TODO: verify that exactly one challenge was sent */\n6818\t    if (ret == 0 && test_ctx->cnx_server != NULL) {\n6819\t        if (initial_challenge == test_ctx->cnx_server->path[0]->first_tuple->challenge[0]) {\n6820\t            DBG_PRINTF(\"%s\", \"Challenge was not renewed after migration\");\n6821\t            ret = -1;\n6822\t        }\n6823\t        else if (test_ctx->cnx_server->path[0]->first_tuple->challenge_verified != 1) {\n6824\t            DBG_PRINTF(\"%s\", \"Challenge was not verified after migration\");\n6825\t            ret = -1;\n6826\t        }\n6827\t    }\n6828\t\n6829\t    /* Verify that the connection ID are what we expect */\n6830\t    if (ret == 0) {\n6831\t        if (picoquic_compare_connection_id(&test_ctx->cnx_client->path[0]->first_tuple->p_remote_cnxid->cnx_id, &target_id) != 0) {\n6832\t            DBG_PRINTF(\"%s\", \"The remote CNX ID did not change to selected value\");\n6833\t            ret = -1;\n6834\t        }\n6835\t        else if (!cid_zero && picoquic_compare_connection_id(&test_ctx->cnx_client->path[0]->first_tuple->p_local_cnxid->cnx_id, &previous_local_id) == 0) {\n6836\t            DBG_PRINTF(\"%s\", \"The local CNX ID did not change to a new value\");\n6837\t            ret = -1;\n6838\t        }\n6839\t    }\n6840\t\n6841\t    if (test_ctx != NULL) {\n6842\t        tls_api_delete_ctx(test_ctx);\n6843\t        test_ctx = NULL;\n6844\t    }\n6845\t\n6846\t    return ret;\n6847\t}\n6848\t\n6849\tint migration_test(void)\n6850\t{\n6851\t    return migration_test_scenario(test_scenario_q_and_r, sizeof(test_scenario_q_and_r), 0, 0);\n6852\t}\n6853\t\n6854\tint migration_test_long(void)\n6855\t{\n6856\t    return migration_test_scenario(test_scenario_very_long, sizeof(test_scenario_very_long), 0, 0);\n6857\t}\n6858\t\n6859\tint migration_test_loss(void)\n6860\t{\n6861\t    uint64_t loss_mask = 0x09;\n6862\t\n6863\t    return migration_test_scenario(test_scenario_q_and_r, sizeof(test_scenario_q_and_r), loss_mask, 0);\n6864\t}\n6865\t\n6866\tint migration_zero_test(void)\n6867\t{\n6868\t    return migration_test_scenario(test_scenario_very_long, sizeof(test_scenario_q_and_r), 0, 1);\n6869\t}\n6870\t\n6871\t/* Failed migration test.\n6872\t * Start a transfer, start a migration to a non existant address,\n6873\t * verify that the transfer completes */\n6874\t\n6875\tint migration_fail_test(void)\n6876\t{\n6877\t    uint64_t simulated_time = 0;\n6878\t    uint64_t loss_mask = 0;\n6879\t    picoquic_test_tls_api_ctx_t* test_ctx = NULL;\n6880\t    int ret = tls_api_init_ctx(&test_ctx, PICOQUIC_INTERNAL_TEST_VERSION_1,\n6881\t        PICOQUIC_TEST_SNI, PICOQUIC_TEST_ALPN, &simulated_time, NULL, NULL, 0, 0, 0);\n6882\t\n6883\t    /* establish the connection*/\n6884\t    if (ret == 0) {\n6885\t        ret = tls_api_connection_loop(test_ctx, &loss_mask, 0, &simulated_time);\n6886\t    }\n6887\t\n6888\t    /* Prepare to send data */\n6889\t    if (ret == 0) {\n6890\t        ret = test_api_init_send_recv_scenario(test_ctx, test_scenario_very_long, sizeof(test_scenario_very_long));\n6891\t\n6892\t        if (ret != 0)\n6893\t        {\n6894\t            DBG_PRINTF(\"Init send receive scenario returns %d\\n\", ret);\n6895\t        }\n6896\t    }\n6897\t\n6898\t    /* Perform a loop until the connection is in ready state */\n6899\t    if (ret == 0) {\n6900\t        ret = wait_client_connection_ready(test_ctx, &simulated_time);\n6901\t    }\n6902\t\n6903\t    /* Start migration to bogus address */\n6904\t    if (ret == 0) {\n6905\t        struct sockaddr_in bogus_addr = test_ctx->client_addr;\n6906\t        bogus_addr.sin_port += 1;\n6907\t\n6908\t        ret = picoquic_probe_new_path(test_ctx->cnx_client,\n6909\t            (struct sockaddr*) & test_ctx->server_addr, (struct sockaddr*) & bogus_addr, simulated_time);\n6910\t        if (ret != 0) {\n6911\t            DBG_PRINTF(\"Probe new path returns %d\\n\", ret);\n6912\t        }\n6913\t    }\n6914\t\n6915\t    /* Perform a data sending loop */\n6916\t    if (ret == 0) {\n6917\t        ret = tls_api_data_sending_loop(test_ctx, &loss_mask, &simulated_time, 0);\n6918\t\n6919\t        if (ret != 0)\n6920\t        {\n6921\t            DBG_PRINTF(\"Data sending loop returns %d\\n\", ret);\n6922\t        }\n6923\t    }\n6924\t\n6925\t    if (ret == 0) {\n6926\t        ret = tls_api_one_scenario_body_verify(test_ctx, &simulated_time, 1100000);\n6927\t    }\n6928\t\n6929\t    if (test_ctx != NULL) {\n6930\t        tls_api_delete_ctx(test_ctx);\n6931\t        test_ctx = NULL;\n6932\t    }\n6933\t\n6934\t    return ret;\n6935\t}\n6936\t\n6937\t\n6938\t/* Migration stress test. \n6939\t * This simulates an attack, during which a man on the side injects fake migration\n6940\t * packets from false addresses. One of the addresses is maintained so that packets sent\n6941\t * to it are natted back to the client.\n6942\t *\n6943\t * The goal of the attack is to verify that the connection resists.\n6944\t */\n6945\t\n6946\tint rebinding_stress_test(void)\n6947\t{\n6948\t    int nb_trials = 0;\n6949\t    const int max_trials = 10000;\n6950\t    int nb_inactive = 0;\n6951\t    int client_rebinding_done = 0;\n6952\t    struct sockaddr_in hack_address;\n6953\t    struct sockaddr_in hack_address_random;\n6954\t    uint64_t simulated_time = 0;\n6955\t    uint64_t loss_mask = 0;\n6956\t    uint64_t last_inject_time = 0;\n6957\t    uint64_t random_context = 0xBABAC001CAFEull;\n6958\t    picoquictest_sim_packet_t* last_client_packet_processed = NULL;\n6959\t    picoquic_test_tls_api_ctx_t* test_ctx = NULL;\n6960\t    int ret = tls_api_init_ctx(&test_ctx, PICOQUIC_INTERNAL_TEST_VERSION_1,\n6961\t        PICOQUIC_TEST_SNI, PICOQUIC_TEST_ALPN, &simulated_time, NULL, NULL, 0, 0, 0);\n6962\t\n6963\t    if (ret == 0 && test_ctx == NULL) {\n6964\t        ret = PICOQUIC_ERROR_MEMORY;\n6965\t    }\n6966\t\n6967\t    if (ret == 0) {\n6968\t        memcpy(&hack_address, &test_ctx->client_addr, sizeof(struct sockaddr_in));\n6969\t        memcpy(&hack_address_random, &test_ctx->client_addr, sizeof(struct sockaddr_in));\n6970\t\n6971\t        hack_address.sin_port += 1023;\n6972\t\n6973\t        ret = tls_api_connection_loop(test_ctx, &loss_mask, 0, &simulated_time);\n6974\t    }\n6975\t\n6976\t    /* Prepare to send data */\n6977\t    if (ret == 0) {\n6978\t        ret = test_api_init_send_recv_scenario(test_ctx, test_scenario_very_long, sizeof(test_scenario_very_long));\n6979\t    }\n6980\t\n6981\t    /* Rewrite the sending loop, so we can add injection of packet copies */\n6982\t    if (ret == 0) {\n6983\t        test_ctx->client_use_multiple_addresses = 1;\n6984\t    }\n6985\t\n6986\t    while (ret == 0 && nb_trials < max_trials && nb_inactive < 256 && TEST_CLIENT_READY && TEST_SERVER_READY) {\n6987\t        int was_active = 0;\n6988\t\n6989\t        nb_trials++;\n6990\t\n6991\t        ret = tls_api_one_sim_round(test_ctx, &simulated_time, 0, &was_active);\n6992\t\n6993\t        if (ret < 0)\n6994\t        {\n6995\t            break;\n6996\t        }\n6997\t\n6998\t        if (was_active) {\n6999\t            nb_inactive = 0;"}]},"parent_tool_use_id":"toolu_01Rt4pELUTT189iuGyrewME6","session_id":"782f2f02-5f93-4f6f-b663-2ef2c783a0cf","uuid":"32f6724a-79dd-4482-bc62-a1ab9906c1c2","timestamp":"2026-05-05T12:37:42.036Z"}
