.\n/// Calls the internal `ticket_seed_test_one(1)` helper.\n#[test]\nfn ticket_seed() {\n    ticket_seed_test_one(1).expect(\"ticket_seed\");\n}\n\n/// C: `ticket_seed_from_bdp_frame_test` in `picoquictest/ticket_store_test.c`.\n///\n/// Second pass of the ticket-seed test: verifies that BDP frame data is\n/// correctly seeded into the session ticket.\n/// Calls the internal `ticket_seed_test_one(2)` helper.\n#[test]\nfn ticket_seed_from_bdp_frame() {\n    ticket_seed_test_one(2).expect(\"ticket_seed_from_bdp_frame\");\n}\n\n/// C: `ticket_store_test` in `picoquictest/ticket_store_test.c`.\n///\n/// Creates a QUIC context, stores synthetic tickets for 3 SNIs × 3 ALPNs ×\n/// 3 protocol versions, saves the ticket file, loads it into a fresh context,\n/// and verifies every ticket round-trips identically.  Also checks that\n/// tickets expire correctly.\n#[test]\nfn ticket_store() {\n    let test_sni = [TEST_SNI, \"example.com\", \"example.net\"];\n    let test_alpn = [TEST_ALPN, \"hq05\", \"hq07\"];\n    let test_version: [u32; 3] = [0x0000_0001, 0xFF00_0020, 0x0000_0002];\n    const TICKET_FILE: &str = \"ticket_store_test.bin\";\n\n    let mut t = Instant::from_ticks(0);\n\n    let ip_zero: IpAddr = \"0.0.0.0\".parse().unwrap();\n    let tp = TransportParameters::default();\n\n    let mut quic = Quic::new_for_test().expect(\"quic\");\n\n    for sni in &test_sni {\n        for alpn in &test_alpn {\n            for &version in &test_version {\n                let ticket = [0xcc_u8; 48];\n                quic.store_ticket(Some(sni), Some(alpn), version, ip_zero, ip_zero, &ticket, &tp)\n                    .expect(\"store_ticket\");\n            }\n        }\n    }\n\n    quic.save_tickets(t, TICKET_FILE).expect(\"save_tickets\");\n\n    let mut quic2 = Quic::new_for_test().expect(\"quic2\");\n    quic2.load_tickets(TICKET_FILE).expect(\"load_tickets\");\n\n    for sni in &test_sni {\n        for alpn in &test_alpn {\n            for &version in &test_version {\n                quic2\n                    .get_ticket(Some(sni), Some(alpn), version, false)\n                    .expect(\"get_ticket\");\n            }\n        }\n    }\n\n    t = Instant::from_ticks(u64::MAX);\n    quic.save_tickets(t, TICKET_FILE).expect(\"save_expired\");\n}\n\n/// C: `token_reuse_api_test` in `picoquictest/ticket_store_test.c`.\n///\n/// Exercises the replay-protection token API:\n/// `registered_token_check_reuse` (insert) and `registered_token_clear`\n/// (expire) with 7 test cases covering distinct and duplicate tokens.\n#[test]\nfn token_reuse_api() {\n    let mut t = Instant::from_ticks(1_000_000);\n    let mut quic = Quic::new_for_test().expect(\"quic\");\n\n    let tokens: &[&[u8]] = &[\n        b\"token_one\",\n        b\"token_two\",\n        b\"token_three\",\n        b\"token_four\",\n        b\"token_five\",\n        b\"token_six\",\n        b\"token_seven\",\n    ];\n\n    for token in tokens {\n        quic.registered_token_check_reuse(token, token.len(), 2_000_000)\n            .expect(\"check_reuse first\");\n        quic.registered_token_check_reuse(token, token.len(), 2_000_000)\n            .expect_err(\"duplicate should fail\");\n    }\n\n    t = Instant::from_ticks(3_000_000);\n    quic.registered_token_clear(t);\n\n    for token in tokens {\n        quic.registered_token_check_reuse(token, token.len(), 4_000_000)\n            .expect(\"check_reuse after clear\");\n    }\n}\n\n/// C: `token_store_test` in `picoquictest/ticket_store_test.c`.\n///\n/// Stores retry tokens for 4 IP addresses × 3 SNIs, saves and reloads the\n/// token file, and verifies each token round-trips correctly.\n#[test]\nfn token_store() {\n    let test_ips: &[IpAddr] = &[\n        \"192.168.0.1\".parse().unwrap(),\n        \"10.0.0.1\".parse().unwrap(),\n        \"172.16.0.1\".parse().unwrap(),\n        \"::1\".parse().unwrap(),\n    ];\n    let test_sni = [TEST_SNI, \"example.com\", \"example.net\"];\n    const TOKEN_FILE: &str = \"token_store_test.bin\";\n\n    let t = Instant::from_ticks(0);\n\n    let mut quic = Quic::new_for_test().expect(\"quic\");\n\n    for ip in test_ips {\n        for sni in &test_sni {\n            let token = [0xab_u8; 32];\n            quic.store_token(Some(sni), *ip, &token).expect(\"store_token\");\n        }\n    }\n\n    quic.save_tokens(TOKEN_FILE).expect(\"save_tokens\");\n\n    let mut quic2 = Quic::new_for_test().expect(\"quic2\");\n    quic2.load_tokens(TOKEN_FILE).expect(\"load_tokens\");\n\n    for ip in test_ips {\n        for sni in &test_sni {\n            quic2.get_token(Some(sni), *ip, false).expect(\"get_token\");\n        }\n    }\n\n    let _ = t;\n}\n","userModified":false}}
