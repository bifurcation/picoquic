    }\n348\t    else {\n349\t        picoquic_packet_type_enum packet_type;\n350\t        picoquic_packet_context_enum pc;\n351\t        picoquic_packet_context_t* pkt_ctx;\n352\t        size_t length = 0;\n353\t        size_t header_length;\n354\t        size_t checksum_overhead = picoquic_get_checksum_length(cnx, epoch);\n355\t        switch (epoch) {\n356\t        case 0:\n357\t            packet_type = picoquic_packet_initial;\n358\t            pc = picoquic_packet_context_initial;\n359\t            break;\n360\t        case 1:\n361\t            packet_type = picoquic_packet_0rtt_protected;\n362\t            pc = picoquic_packet_context_application;\n363\t            break;\n364\t        case 2:\n365\t            packet_type = picoquic_packet_handshake;\n366\t            pc = picoquic_packet_context_handshake;\n367\t            break;\n368\t        case 3:\n369\t        default:\n370\t            packet_type = picoquic_packet_1rtt_protected;\n371\t            pc = picoquic_packet_context_application;\n372\t            break;\n373\t        }\n374\t        pkt_ctx = &cnx->pkt_ctx[pc];\n375\t        if (packet_type == picoquic_packet_1rtt_protected && cnx->is_multipath_enabled) {\n376\t            pkt_ctx = &path_x->pkt_ctx;\n377\t        }\n378\t\n379\t        header_length = picoquic_predict_packet_header_length(cnx, packet_type, pkt_ctx);\n380\t        memcpy(packet->bytes + header_length, payload, p_length);\n381\t        length = header_length + p_length;\n382\t\n383\t        packet->ptype = packet_type;\n384\t        packet->offset = header_length;\n385\t        packet->sequence_number = pkt_ctx->send_sequence;\n386\t        packet->send_time = current_time;\n387\t        packet->send_path = path_x;\n388\t        packet->pc = pc;\n389\t        packet->length = length;\n390\t\n391\t        picoquic_finalize_and_protect_packet(cnx, packet, 0, length, header_length, checksum_overhead,\n392\t            &sim_packet->length, sim_packet->bytes, sizeof(sim_packet->bytes),\n393\t            path_x, current_time);\n394\t        /* Forward on selected link */\n395\t        picoquictest_sim_link_submit((from_client) ? test_ctx->c_to_s_link : test_ctx->s_to_c_link, sim_packet, current_time);\n396\t    }\n397\t\n398\t    return ret;\n399\t}\n400\t\n401\tint test_api_queue_initial_queries(picoquic_test_tls_api_ctx_t* test_ctx, uint64_t stream_id)\n402\t{\n403\t    int ret = 0;\n404\t    int more_stream = 0;\n405\t\n406\t    for (size_t i = 0; ret == 0 && i < test_ctx->nb_test_streams; i++) {\n407\t        if (test_ctx->test_stream[i].previous_stream_id == stream_id) {\n408\t            picoquic_cnx_t* cnx = NULL;\n409\t\n410\t            cnx = IS_CLIENT_STREAM_ID(test_ctx->test_stream[i].stream_id) ? test_ctx->cnx_client : test_ctx->cnx_server;\n411\t\n412\t            ret = picoquic_add_to_stream(cnx, test_ctx->test_stream[i].stream_id,\n413\t                test_ctx->test_stream[i].q_src,\n414\t                test_ctx->test_stream[i].q_len, 1);\n415\t\n416\t            if (ret == 0) {\n417\t                test_ctx->test_stream[i].q_sent = 1;\n418\t                more_stream = 1;\n419\t            }\n420\t        }\n421\t    }\n422\t\n423\t    if (test_ctx->stream0_target > 0) {\n424\t        ret = picoquic_mark_active_stream(test_ctx->cnx_client, 0, 1, NULL);\n425\t    }\n426\t\n427\t    /* TODO: check whether the test is actually finished */\n428\t    if (!more_stream) {\n429\t        for (size_t i = 0; ret == 0 && i < test_ctx->nb_test_streams; i++) {\n430\t            if (test_ctx->test_stream[i].r_received == 0) {\n431\t                more_stream = 1;\n432\t                break;\n433\t            }\n434\t        }\n435\t    }\n436\t\n437\t    if (more_stream == 0) {\n438\t        test_ctx->streams_finished = 1;\n439\t        if (test_ctx->stream0_received >= test_ctx->stream0_target) {\n440\t            test_ctx->test_finished = 1;\n441\t        }\n442\t        else {\n443\t            test_ctx->test_finished = 0;\n444\t        }\n445\t    } else {\n446\t        test_ctx->test_finished = 0;\n447\t        test_ctx->streams_finished = 0;\n448\t    }\n449\t\n450\t    return ret;\n451\t}\n452\t\n453\tstatic int test_api_direct_receive_callback(picoquic_cnx_t* UNUSED(cnx),\n454\t    uint64_t stream_id, int fin, const uint8_t* bytes, uint64_t offset, size_t length, void* direct_receive_ctx)\n455\t{\n456\t    int ret = 0;\n457\t    test_api_callback_t* cb_ctx = (test_api_callback_t*)direct_receive_ctx;\n458\t    size_t stream_index;\n459\t    picoquic_test_tls_api_ctx_t* ctx = NULL;\n460\t\n461\t    if (cb_ctx->client_mode) {\n462\t        ctx = (picoquic_test_tls_api_ctx_t*)(((char*)direct_receive_ctx) - offsetof(struct st_picoquic_test_tls_api_ctx_t, client_callback));\n463\t    }\n464\t    else {\n465\t        /* Only testing the direct receive on the client side */\n466\t        ret = -1;\n467\t    }\n468\t\n469\t    if (ret == 0) {\n470\t        for (stream_index = 0; stream_index < ctx->nb_test_streams; stream_index++) {\n471\t            if (ctx->test_stream[stream_index].stream_id == stream_id) {\n472\t                break;\n473\t            }\n474\t        }\n475\t\n476\t        if (stream_index >= ctx->nb_test_streams) {\n477\t            cb_ctx->error_detected |= test_api_fail_data_on_unknown_stream;\n478\t            ret = -1;\n479\t        }\n480\t        else if (offset + length > ctx->test_stream[stream_index].r_len) {\n481\t            cb_ctx->error_detected |= test_api_fail_data_on_unknown_stream;\n482\t            ret = -1;\n483\t        }\n484\t        else {\n485\t            uint64_t last_offset = offset + length;\n486\t            memcpy(ctx->test_stream[stream_index].r_rcv, bytes, length);\n487\t\n488\t            if (memcmp(ctx->test_stream[stream_index].r_src + (size_t)offset, bytes, length) != 0)\n489\t            {\n490\t                cb_ctx->error_detected |= test_api_fail_data_does_not_match;\n491\t                ret = -1;\n492\t            }\n493\t            else if (offset > ctx->test_stream[stream_index].next_direct_offset) {\n494\t                /* Need to create a hole. They are ordered from lowest to highest offset */\n495\t                test_api_stream_hole_t* hole = ctx->test_stream[stream_index].first_direct_hole;\n496\t                test_api_stream_hole_t* previous_hole = NULL;\n497\t                test_api_stream_hole_t* new_hole = (test_api_stream_hole_t*)malloc(sizeof(test_api_stream_hole_t));\n498\t                if (new_hole == NULL) {\n499\t                    ret = PICOQUIC_ERROR_MEMORY;\n500\t                }\n501\t                else {\n502\t                    while (hole != NULL) {\n503\t                        previous_hole = ctx->test_stream[stream_index].first_direct_hole;\n504\t                        hole = previous_hole->next_hole;\n505\t                    }\n506\t                    new_hole->offset = ctx->test_stream[stream_index].next_direct_offset;\n507\t                    new_hole->last_offset = offset;\n508\t                    new_hole->next_hole = NULL;\n509\t                    if (previous_hole == NULL) {\n510\t                        ctx->test_stream[stream_index].first_direct_hole = new_hole;\n511\t                    }\n512\t                    else {\n513\t                        previous_hole->next_hole = new_hole;\n514\t                    }\n515\t                    ctx->test_stream[stream_index].r_recv_nb += length;\n516\t                    ctx->test_stream[stream_index].next_direct_offset = last_offset;\n517\t                }\n518\t            }\n519\t            else {\n520\t                test_api_stream_hole_t* hole = ctx->test_stream[stream_index].first_direct_hole;\n521\t                test_api_stream_hole_t* previous_hole = NULL;\n522\t\n523\t                if (last_offset > ctx->test_stream[stream_index].next_direct_offset) {\n524\t                    /* At least some of the segment comes after the current max offset */\n525\t                    uint64_t new_direct_offset = last_offset;\n526\t                    ctx->test_stream[stream_index].r_recv_nb += (size_t)(last_offset - ctx->test_stream[stream_index].next_direct_offset);\n527\t                    last_offset = ctx->test_stream[stream_index].next_direct_offset;\n528\t                    ctx->test_stream[stream_index].next_direct_offset = new_direct_offset;\n529\t                }\n530\t\n531\t                while (hole != NULL && offset < last_offset) {\n532\t                    test_api_stream_hole_t* next_hole = hole->next_hole;\n533\t                    if (last_offset <= hole->offset) {\n534\t                        /* Segment is entirely covered by previously received data */\n535\t                        break;\n536\t                    }\n537\t                    else if (offset <= hole->offset) {\n538\t                        /* Beginning of segment already received */\n539\t                        offset = hole->offset;\n540\t                    }\n541\t\n542\t                    if (offset <= hole->last_offset) {\n543\t                        if (last_offset >= hole->last_offset) {\n544\t                            /* segment extends past the end of the hole */\n545\t                            uint64_t new_offset = hole->last_offset;\n546\t                            ctx->test_stream[stream_index].r_recv_nb += (size_t)(hole->last_offset - offset);\n547\t                            hole->last_offset = offset;\n548\t                            offset = new_offset;\n549\t                            if (hole->last_offset == hole->offset) {\n550\t                                /* Hole has been filled */\n551\t                                if (previous_hole == NULL) {\n552\t                                    ctx->test_stream[stream_index].first_direct_hole = next_hole;\n553\t                                }\n554\t                                else {\n555\t                                    previous_hole->next_hole = next_hole;\n556\t                                }\n557\t                                free(hole);\n558\t                            }\n559\t                            else {\n560\t                                previous_hole = hole;\n561\t                            }\n562\t                        }\n563\t                        else if (offset == hole->offset) {\n564\t                            /* segment starts at begining of hole */\n565\t                            ctx->test_stream[stream_index].r_recv_nb += (size_t)(last_offset - offset);\n566\t                            offset = last_offset;\n567\t                            hole->offset = last_offset;\n568\t                            previous_hole = hole;\n569\t                        }\n570\t                        else {\n571\t                            /* overlap, need a new hole */\n572\t                            test_api_stream_hole_t* new_hole = (test_api_stream_hole_t*)malloc(sizeof(test_api_stream_hole_t));\n573\t                            if (new_hole == NULL) {\n574\t                                ret = PICOQUIC_ERROR_MEMORY;\n575\t                            }\n576\t                            else {\n577\t                                new_hole->offset = last_offset;\n578\t                                new_hole->last_offset = hole->last_offset;\n579\t                                new_hole->next_hole = hole->next_hole;\n580\t                                hole->last_offset = offset;\n581\t                                hole->next_hole = new_hole;\n582\t                                ctx->test_stream[stream_index].r_recv_nb += (size_t)(last_offset - offset);\n583\t                            }\n584\t                            break;\n585\t                        }\n586\t                    }\n587\t                    else {\n588\t                        previous_hole = hole;\n589\t                    }\n590\t\n591\t                    hole = next_hole;\n592\t                }\n593\t            }\n594\t\n595\t            /* If fin received and no hole, mark received and signal fin */\n596\t            if (fin && ctx->test_stream[stream_index].direct_fin_received == 0) {\n597\t                ctx->test_stream[stream_index].direct_fin_received = fin;\n598\t            }\n599\t\n600\t            if (ctx->test_stream[stream_index].first_direct_hole == NULL && ctx->test_stream[stream_index].direct_fin_received) {\n601\t                ctx->test_stream[stream_index].r_received = 1;\n602\t                ret = PICOQUIC_STREAM_RECEIVE_COMPLETE;\n603\t\n604\t                if (cb_ctx->error_detected == 0) {\n605\t                    /* queue the new queries initiated by that stream */\n606\t                    if (test_api_queue_initial_queries(ctx, stream_id) != 0) {\n607\t                        cb_ctx->error_detected |= test_api_fail_cannot_send_query;\n608\t                    }\n609\t                }\n610\t            }\n611\t        }\n612\t    }\n613\t\n614\t    return ret;\n615\t}\n616\t\n617\tint test_api_callback(picoquic_cnx_t* cnx,\n618\t    uint64_t stream_id, uint8_t* bytes, size_t length,\n619\t    picoquic_call_back_event_t fin_or_event, void* callback_ctx, void* UNUSED(v_stream_ctx))\n620\t{\n621\t    /* Need to implement the server sending strategy */\n622\t    test_api_callback_t* cb_ctx = (test_api_callback_t*)callback_ctx;\n623\t    picoquic_test_tls_api_ctx_t* ctx = NULL;\n624\t    size_t stream_index;\n625\t    picoquic_call_back_event_t stream_finished = picoquic_callback_stream_data;\n626\t\n627\t    if (fin_or_event == picoquic_callback_close ||\n628\t        fin_or_event == picoquic_callback_application_close ||\n629\t        fin_or_event == picoquic_callback_almost_ready ||\n630\t        fin_or_event == picoquic_callback_ready ||\n631\t        fin_or_event == picoquic_callback_app_wakeup) {\n632\t        /* do nothing in our tests */\n633\t        return 0;\n634\t    }\n635\t\n636\t    if (cb_ctx->client_mode) {\n637\t        ctx = (picoquic_test_tls_api_ctx_t*)(((char*)callback_ctx) - offsetof(struct st_picoquic_test_tls_api_ctx_t, client_callback));\n638\t    } else {\n639\t        ctx = (picoquic_test_tls_api_ctx_t*)(((char*)callback_ctx) - offsetof(struct st_picoquic_test_tls_api_ctx_t, server_callback));\n640\t    }\n641\t\n642\t\n643\t    if (fin_or_event == picoquic_callback_version_negotiation) {\n644\t        if (ctx != NULL) {\n645\t            ctx->received_version_negotiation = 1;\n646\t        }\n647\t        return 0;\n648\t    }\n649\t\n650\t    if (fin_or_event == picoquic_callback_stateless_reset) {\n651\t        /* take note to validate test */\n652\t        ctx->reset_received = 1;\n653\t        return 0;\n654\t    }\n655\t\n656\t    if (fin_or_event == picoquic_callback_prepare_to_send) {\n657\t        if (cb_ctx->client_mode && stream_id == 0) {\n658\t            return test_api_stream0_prepare(ctx, bytes, length);\n659\t        } else {\n660\t            /* unexpected call */\n661\t            return -1;\n662\t        }\n663\t    }\n664\t\n665\t    if (fin_or_event == picoquic_callback_pacing_changed)\n666\t    {\n667\t        if (ctx->bw_update != NULL) {\n668\t            fprintf(ctx->bw_update, \"%\" PRIu64 \", %\" PRIu64 \", %\" PRIu64 \", %\" PRIu64 \", %\" PRIu64 \"\\n\",\n669\t                picoquic_get_quic_time(cnx->quic), stream_id, picoquic_get_pacing_rate(cnx),\n670\t                picoquic_get_cwin(cnx), picoquic_get_rtt(cnx));\n671\t        }\n672\t        return 0;\n673\t    }\n674\t\n675\t    if (fin_or_event == picoquic_callback_path_address_observed)\n676\t    {\n677\t        ctx->nb_address_observed++;\n678\t        return 0;\n679\t    }\n680\t\n681\t    if (fin_or_event == picoquic_callback_prepare_datagram)\n682\t    {\n683\t        int ret = -1;\n684\t        if (ctx->datagram_send_fn != NULL) {\n685\t            ret = ctx->datagram_send_fn(cnx, stream_id, bytes, length, ctx->datagram_ctx);\n686\t        }\n687\t        return ret;\n688\t    } else if (fin_or_event == picoquic_callback_datagram)\n689\t    {\n690\t        int ret = -1;\n691\t        if (ctx->datagram_recv_fn != NULL) {\n692\t            ret = ctx->datagram_recv_fn(cnx, stream_id, bytes, length, ctx->datagram_ctx);\n693\t        }\n694\t        return ret;\n695\t    }\n696\t    else if (fin_or_event == picoquic_callback_datagram_acked ||\n697\t        fin_or_event == picoquic_callback_datagram_lost ||\n698\t        fin_or_event == picoquic_callback_datagram_spurious)\n699\t    {\n700\t        int ret = -1;\n701\t        if (ctx->datagram_ack_fn != NULL) {\n702\t            ret = ctx->datagram_ack_fn(cnx, fin_or_event,\n703\t                bytes, length, stream_id /* encode send_time */, ctx->datagram_ctx);\n704\t        }\n705\t        return ret;\n706\t    }\n707\t    else if (fin_or_event == picoquic_callback_path_available ||\n708\t        fin_or_event == picoquic_callback_path_suspended ||\n709\t        fin_or_event == picoquic_callback_path_deleted ||\n710\t        fin_or_event == picoquic_callback_path_quality_changed ||\n711\t        fin_or_event == picoquic_callback_next_path_allowed) {\n712\t        int ret = 0;\n713\t        if (ctx->path_events != NULL) {\n714\t            if (fin_or_event == picoquic_callback_path_quality_changed) {\n715\t                uint64_t unique_path_id = stream_id;\n716\t                picoquic_path_quality_t quality;\n717\t                uint64_t current_time = picoquic_get_quic_time(cnx->quic);\n718\t\n719\t                ret = picoquic_get_path_quality(cnx, unique_path_id, &quality);\n720\t                if (ret == 0) {\n721\t                    fprintf(ctx->path_events,\n722\t                        \"%\" PRIu64 \", %\" PRIu64 \", %d, %\" PRIu64 \", %\" PRIu64 \", %\" PRIu64 \", %\" PRIu64 \"\\n\",\n723\t                        current_time, stream_id, (int)fin_or_event,\n724\t                        quality.pacing_rate, quality.receive_rate_estimate, quality.cwin, quality.rtt);\n725\t                }\n726\t            }\n727\t            else {\n728\t                fprintf(ctx->path_events, \"%\" PRIu64 \", %\" PRIu64 \", %d,\\n\",\n729\t                    picoquic_get_quic_time(cnx->quic), stream_id, (int)fin_or_event);\n730\t            }\n731\t        }\n732\t        else if (fin_or_event == picoquic_callback_path_quality_changed &&\n733\t            ctx->default_path_update != NULL) {\n734\t            picoquic_path_quality_t quality;\n735\t            uint64_t current_time = picoquic_get_quic_time(cnx->quic);\n736\t            picoquic_get_default_path_quality(cnx, &quality);\n737\t            fprintf(ctx->default_path_update,\n738\t                \"%\" PRIu64 \", %\" PRIu64 \", %d, %\" PRIu64 \", %\" PRIu64 \", %\" PRIu64 \", %\" PRIu64 \"\\n\",\n739\t                current_time, stream_id, (int)fin_or_event,\n740\t                quality.pacing_rate, quality.receive_rate_estimate, quality.cwin, quality.rtt);\n741\t        }\n742\t        return ret;\n743\t    }\n744\t\n745\t    if (bytes != NULL) {\n746\t        if (cb_ctx->client_mode) {\n747\t            ctx->sum_data_received_at_client += (int) length;\n748\t        } else {\n749\t            ctx->sum_data_received_at_server += (int) length;\n750\t        }\n751\t    }\n752\t\n753\t    if (stream_id == 0 && cb_ctx->client_mode == 0 &&\n754\t        (fin_or_event == picoquic_callback_stream_data || fin_or_event == picoquic_callback_stream_fin)) {\n755\t        if (bytes == NULL && length != 0) {\n756\t            cb_ctx->error_detected = test_api_bad_stream0_data;\n757\t        }\n758\t        else {\n759\t            for (size_t i = 0; i < length; i++) {\n760\t                if (bytes[i] != 0xA5) {\n761\t                    cb_ctx->error_detected = test_api_bad_stream0_data;\n762\t                }\n763\t            }\n764\t        }\n765\t        if (ctx->stream0_received == 0 && length > 0 && ctx->stream0_flow_release) {\n766\t            (void)picoquic_open_flow_control(cnx, stream_id, ctx->stream0_target);\n767\t        }\n768\t        ctx->stream0_received += length;\n769\t        if (ctx->streams_finished && ctx->stream0_received >= ctx->stream0_target) {\n770\t            ctx->test_finished = 1;\n771\t        }\n772\t    } else {\n773\t        for (stream_index = 0; stream_index < ctx->nb_test_streams; stream_index++) {\n774\t            if (ctx->test_stream[stream_index].stream_id == stream_id) {\n775\t                break;\n776\t            }\n777\t        }\n778\t\n779\t        if (stream_index >= ctx->nb_test_streams) {\n780\t            cb_ctx->error_detected |= test_api_fail_data_on_unknown_stream;\n781\t        }\n782\t        else if (fin_or_event == picoquic_callback_stop_sending) {\n783\t            /* Respond with a reset, no matter what. Should be smarter later */\n784\t            picoquic_reset_stream(cnx, stream_id, 0);\n785\t        }\n786\t        else if (fin_or_event == picoquic_callback_stream_data || fin_or_event == picoquic_callback_stream_fin || fin_or_event == picoquic_callback_stream_reset) {\n787\t            if (IS_CLIENT_STREAM_ID(stream_id)) {\n788\t                if (cb_ctx->client_mode) {\n789\t                    /* this is a response from the server to a client stream */\n790\t                    test_api_receive_stream_data(bytes, length, fin_or_event,\n791\t                        ctx->test_stream[stream_index].r_rcv,\n792\t                        ctx->test_stream[stream_index].r_len,\n793\t                        ctx->test_stream[stream_index].r_src,\n794\t                        &ctx->test_stream[stream_index].r_recv_nb,\n795\t                        &ctx->test_stream[stream_index].r_received,\n796\t                        &cb_ctx->error_detected);\n797\t\n798\t                    stream_finished = fin_or_event;\n799\t                }\n800\t                else {\n801\t                    /* this is a query to a server */\n802\t                    test_api_receive_stream_data(bytes, length, fin_or_event,\n803\t                        ctx->test_stream[stream_index].q_rcv,\n804\t                        ctx->test_stream[stream_index].q_len,\n805\t                        ctx->test_stream[stream_index].q_src,\n806\t                        &ctx->test_stream[stream_index].q_recv_nb,\n807\t                        &ctx->test_stream[stream_index].q_received,\n808\t                        &cb_ctx->error_detected);\n809\t\n810\t                    if (fin_or_event != 0) {\n811\t                        if (ctx->test_stream[stream_index].r_len == 0 || fin_or_event == picoquic_callback_stream_reset) {\n812\t                            ctx->test_stream[stream_index].r_received = 1;\n813\t                            stream_finished = fin_or_event;\n814\t                        }\n815\t                        else if (cb_ctx->error_detected == 0) {\n816\t                            /* send a response */\n817\t                            if (picoquic_add_to_stream(cnx, stream_id,\n818\t                                ctx->test_stream[stream_index].r_src,\n819\t                                ctx->test_stream[stream_index].r_len, 1)\n820\t                                != 0) {\n821\t                                cb_ctx->error_detected |= test_api_fail_cannot_send_response;\n822\t                            }\n823\t                        }\n824\t                    }\n825\t                }\n826\t            }\n827\t            else {\n828\t                if (cb_ctx->client_mode) {\n829\t                    /* this is a query from the server to the client */\n830\t                    test_api_receive_stream_data(bytes, length, fin_or_event,\n831\t                        ctx->test_stream[stream_index].q_rcv,\n832\t                        ctx->test_stream[stream_index].q_len,\n833\t                        ctx->test_stream[stream_index].q_src,\n834\t                        &ctx->test_stream[stream_index].q_recv_nb,\n835\t                        &ctx->test_stream[stream_index].q_received,\n836\t                        &cb_ctx->error_detected);\n837\t\n838\t                    if (fin_or_event != 0) {\n839\t                        if (ctx->test_stream[stream_index].r_len == 0 || fin_or_event == picoquic_callback_stream_reset) {\n840\t                            ctx->test_stream[stream_index].r_received = 1;\n841\t                            stream_finished = fin_or_event;\n842\t                        }\n843\t                        else if (cb_ctx->error_detected == 0) {\n844\t                            /* send a response */\n845\t                            if (picoquic_add_to_stream(cnx, stream_id,\n846\t                                ctx->test_stream[stream_index].r_src,\n847\t                                ctx->test_stream[stream_index].r_len, 1)\n848\t                                != 0) {\n849\t                                cb_ctx->error_detected |= test_api_fail_cannot_send_response;\n850\t                            }\n851\t                        }\n852\t                    }\n853\t                }\n854\t                else {\n855\t                    /* this is a response to the server */\n856\t                    test_api_receive_stream_data(bytes, length, fin_or_event,\n857\t                        ctx->test_stream[stream_index].r_rcv,\n858\t                        ctx->test_stream[stream_index].r_len,\n859\t                        ctx->test_stream[stream_index].r_src,\n860\t                        &ctx->test_stream[stream_index].r_recv_nb,\n861\t                        &ctx->test_stream[stream_index].r_received,\n862\t                        &cb_ctx->error_detected);\n863\t\n864\t                    stream_finished = fin_or_event;\n865\t                }\n866\t            }\n867\t        }\n868\t        else {\n869\t            cb_ctx->error_detected |= test_api_fail_unexpected_frame;\n870\t        }\n871\t\n872\t        if (stream_finished != 0\n873\t            && cb_ctx->error_detected == 0) {\n874\t            /* queue the new queries initiated by that stream */\n875\t            if (test_api_queue_initial_queries(ctx, stream_id) != 0) {\n876\t                cb_ctx->error_detected |= test_api_fail_cannot_send_query;\n877\t            }\n878\t        }\n879\t    }\n880\t\n881\t    return 0;\n882\t}\n883\t\n884\tint test_api_init_send_recv_scenario(picoquic_test_tls_api_ctx_t* test_ctx,\n885\t    test_api_stream_desc_t* stream_desc, size_t size_of_scenarios)\n886\t{\n887\t    int ret = 0;\n888\t    size_t nb_stream_desc = size_of_scenarios / sizeof(test_api_stream_desc_t);\n889\t\n890\t    if (nb_stream_desc > PICOQUIC_TEST_MAX_TEST_STREAMS) {\n891\t        ret = -1;\n892\t    } else {\n893\t        test_ctx->nb_test_streams = nb_stream_desc;\n894\t        test_ctx->test_finished = 0;\n895\t\n896\t        for (size_t i = 0; ret == 0 && i < nb_stream_desc; i++) {\n897\t            ret = test_api_init_test_stream(&test_ctx->test_stream[i],\n898\t                stream_desc[i].stream_id, stream_desc[i].previous_stream_id,\n899\t                stream_desc[i].q_len, stream_desc[i].r_len);\n900\t        }\n901\t    }\n902\t\n903\t    if (ret == 0) {\n904\t        ret = test_api_queue_initial_queries(test_ctx, 0);\n905\t    }\n906\t\n907\t    return ret;\n908\t}\n909\t\n910\tstatic int verify_transport_extension(picoquic_cnx_t* cnx_client, picoquic_cnx_t* cnx_server)\n911\t{\n912\t    int ret = 0;\n913\t\n914\t    /* verify that local parameters have a sensible value */\n915\t    if (cnx_client->local_parameters.max_idle_timeout == 0 || cnx_client->local_parameters.initial_max_data == 0 || cnx_client->local_parameters.initial_max_stream_data_bidi_local == 0 || cnx_client->local_parameters.max_packet_size == 0) {\n916\t        ret = -1;\n917\t    } else if (cnx_server->local_parameters.max_idle_timeout == 0 || cnx_server->local_parameters.initial_max_data == 0 || cnx_server->local_parameters.initial_max_stream_data_bidi_remote == 0 || cnx_server->local_parameters.max_packet_size == 0) {\n918\t        ret = -1;\n919\t    }\n920\t    /* Verify that the negotiation completed */\n921\t    else if (memcmp(&cnx_client->local_parameters, &cnx_server->remote_parameters,\n922\t                 sizeof(picoquic_tp_t))\n923\t        != 0) {\n924\t        ret = -1;\n925\t    } else if (memcmp(&cnx_server->local_parameters, &cnx_client->remote_parameters,\n926\t                   sizeof(picoquic_tp_t))\n927\t        != 0) {\n928\t        ret = -1;\n929\t    }\n930\t\n931\t    return ret;\n932\t}\n933\t\n934\tstatic int verify_sni(picoquic_cnx_t* cnx_client, picoquic_cnx_t* cnx_server,\n935\t    char const* sni)\n936\t{\n937\t    int ret = 0;\n938\t    char const* client_sni = picoquic_tls_get_sni(cnx_client);\n939\t    char const* server_sni = picoquic_tls_get_sni(cnx_server);\n940\t\n941\t    if (sni == NULL) {\n942\t        if (cnx_client->sni != NULL) {\n943\t            ret = -1;\n944\t        } else if (client_sni != NULL) {\n945\t            ret = -1;\n946\t        } else if (server_sni != NULL) {\n947\t            ret = -1;\n948\t        }\n949\t    } else {\n950\t        if (cnx_client->sni == NULL) {\n951\t            ret = -1;\n952\t        } else if (client_sni == NULL) {\n953\t            ret = -1;\n954\t        } else if (server_sni == NULL) {\n955\t            ret = -1;\n956\t        } else if (strcmp(cnx_client->sni, sni) != 0) {\n957\t            ret = -1;\n958\t        } else if (strcmp(client_sni, sni) != 0) {\n959\t            ret = -1;\n960\t        } else if (strcmp(server_sni, sni) != 0) {\n961\t            ret = -1;\n962\t        }\n963\t    }\n964\t\n965\t    return ret;\n966\t}\n967\t\n968\tstatic int verify_alpn(picoquic_cnx_t* cnx_client, picoquic_cnx_t* cnx_server,\n969\t    char const* alpn)\n970\t{\n971\t    int ret = 0;\n972\t    char const* client_alpn = picoquic_tls_get_negotiated_alpn(cnx_client);\n973\t    char const* server_alpn = picoquic_tls_get_negotiated_alpn(cnx_server);\n974\t\n975\t    if (alpn == NULL) {\n976\t        if (cnx_client->alpn != NULL) {\n977\t            ret = -1;\n978\t        } else if (client_alpn != NULL) {\n979\t            ret = -1;\n980\t        } else if (server_alpn != NULL) {\n981\t            ret = -1;\n982\t        }\n983\t    } else {\n984\t        if (cnx_client->alpn == NULL) {\n985\t            ret = -1;\n986\t        } else if (client_alpn == NULL) {\n987\t            ret = -1;\n988\t        } else if (server_alpn == NULL) {\n989\t            ret = -1;\n990\t        } else if (strcmp(cnx_client->alpn, alpn) != 0) {\n991\t            ret = -1;\n992\t        } else if (strcmp(client_alpn, alpn) != 0) {\n993\t            ret = -1;\n994\t        } else if (strcmp(server_alpn, alpn) != 0) {\n995\t            ret = -1;\n996\t        }\n997\t    }\n998\t\n999\t    return ret;"}]},"parent_tool_use_id":null,"session_id":"782f2f02-5f93-4f6f-b663-2ef2c783a0cf","uuid":"b961be4e-1374-46b3-a821-393152a91e8e","timestamp":"2026-05-05T12:30:52.841Z","tool_use_result":{"type":"text","file":{"filePath":"/Users/richbarn/Projects/picoquic/picoquictest/tls_api_test.c","content":"            available = space;\n            \n            if (ctx->stream0_test_option == 1 && space > 1) {\n                available--;\n            }\n            is_fin = 0;\n        }\n        else {\n            if (ctx->stream0_test_option == 2) {\n                is_fin = 0;\n            }\n        }\n\n        buffer = picoquic_provide_stream_data_buffer(context, available, is_fin, !is_fin);\n        if (buffer != NULL) {\n            memset(buffer, 0xA5, available);\n            ctx->stream0_sent += available;\n            ret = 0;\n        }\n    }\n    else if (ctx->stream0_test_option == 2 && ctx->stream0_sent == ctx->stream0_target) {\n        (void)picoquic_provide_stream_data_buffer(context, 0, 1, 0);\n        ret = 0;\n    }\n\n    return ret;\n}\n\nstatic int tls_api_inject_packet(picoquic_test_tls_api_ctx_t* test_ctx, int from_client,\n    picoquic_epoch_enum epoch, const uint8_t* payload, size_t p_length, int path_id, uint64_t current_time)\n{\n    int ret = 0;\n    /* Identify the connection */\n    picoquic_cnx_t* cnx = (from_client) ? test_ctx->cnx_client : test_ctx->cnx_server;\n    picoquic_path_t* path_x = cnx->path[path_id];\n    /* Prepare the creation of cleartext and sim packet */\n    picoquic_packet_t* packet = picoquic_create_packet(cnx->quic);\n    picoquictest_sim_packet_t* sim_packet = picoquictest_sim_link_create_packet();\n\n    if (packet == NULL || sim_packet == NULL) {\n        ret = -1;\n        if (packet != NULL) {\n            picoquic_recycle_packet(cnx->quic, packet);\n        }\n        if (sim_packet != NULL) {\n            free(sim_packet);\n        }\n    }\n    else {\n        picoquic_packet_type_enum packet_type;\n        picoquic_packet_context_enum pc;\n        picoquic_packet_context_t* pkt_ctx;\n        size_t length = 0;\n        size_t header_length;\n        size_t checksum_overhead = picoquic_get_checksum_length(cnx, epoch);\n        switch (epoch) {\n        case 0:\n            packet_type = picoquic_packet_initial;\n            pc = picoquic_packet_context_initial;\n            break;\n        case 1:\n            packet_type = picoquic_packet_0rtt_protected;\n            pc = picoquic_packet_context_application;\n            break;\n        case 2:\n            packet_type = picoquic_packet_handshake;\n            pc = picoquic_packet_context_handshake;\n            break;\n        case 3:\n        default:\n            packet_type = picoquic_packet_1rtt_protected;\n            pc = picoquic_packet_context_application;\n            break;\n        }\n        pkt_ctx = &cnx->pkt_ctx[pc];\n        if (packet_type == picoquic_packet_1rtt_protected && cnx->is_multipath_enabled) {\n            pkt_ctx = &path_x->pkt_ctx;\n        }\n\n        header_length = picoquic_predict_packet_header_length(cnx, packet_type, pkt_ctx);\n        memcpy(packet->bytes + header_length, payload, p_length);\n        length = header_length + p_length;\n\n        packet->ptype = packet_type;\n        packet->offset = header_length;\n        packet->sequence_number = pkt_ctx->send_sequence;\n        packet->send_time = current_time;\n        packet->send_path = path_x;\n        packet->pc = pc;\n        packet->length = length;\n\n        picoquic_finalize_and_protect_packet(cnx, packet, 0, length, header_length, checksum_overhead,\n            &sim_packet->length, sim_packet->bytes, sizeof(sim_packet->bytes),\n            path_x, current_time);\n        /* Forward on selected link */\n        picoquictest_sim_link_submit((from_client) ? test_ctx->c_to_s_link : test_ctx->s_to_c_link, sim_packet, current_time);\n    }\n\n    return ret;\n}\n\nint test_api_queue_initial_queries(picoquic_test_tls_api_ctx_t* test_ctx, uint64_t stream_id)\n{\n    int ret = 0;\n    int more_stream = 0;\n\n    for (size_t i = 0; ret == 0 && i < test_ctx->nb_test_streams; i++) {\n        if (test_ctx->test_stream[i].previous_stream_id == stream_id) {\n            picoquic_cnx_t* cnx = NULL;\n\n            cnx = IS_CLIENT_STREAM_ID(test_ctx->test_stream[i].stream_id) ? test_ctx->cnx_client : test_ctx->cnx_server;\n\n            ret = picoquic_add_to_stream(cnx, test_ctx->test_stream[i].stream_id,\n                test_ctx->test_stream[i].q_src,\n                test_ctx->test_stream[i].q_len, 1);\n\n            if (ret == 0) {\n                test_ctx->test_stream[i].q_sent = 1;\n                more_stream = 1;\n            }\n        }\n    }\n\n    if (test_ctx->stream0_target > 0) {\n        ret = picoquic_mark_active_stream(test_ctx->cnx_client, 0, 1, NULL);\n    }\n\n    /* TODO: check whether the test is actually finished */\n    if (!more_stream) {\n        for (size_t i = 0; ret == 0 && i < test_ctx->nb_test_streams; i++) {\n            if (test_ctx->test_stream[i].r_received == 0) {\n                more_stream = 1;\n                break;\n            }\n        }\n    }\n\n    if (more_stream == 0) {\n        test_ctx->streams_finished = 1;\n        if (test_ctx->stream0_received >= test_ctx->stream0_target) {\n            test_ctx->test_finished = 1;\n        }\n        else {\n            test_ctx->test_finished = 0;\n        }\n    } else {\n        test_ctx->test_finished = 0;\n        test_ctx->streams_finished = 0;\n    }\n\n    return ret;\n}\n\nstatic int test_api_direct_receive_callback(picoquic_cnx_t* UNUSED(cnx),\n    uint64_t stream_id, int fin, const uint8_t* bytes, uint64_t offset, size_t length, void* direct_receive_ctx)\n{\n    int ret = 0;\n    test_api_callback_t* cb_ctx = (test_api_callback_t*)direct_receive_ctx;\n    size_t stream_index;\n    picoquic_test_tls_api_ctx_t* ctx = NULL;\n\n    if (cb_ctx->client_mode) {\n        ctx = (picoquic_test_tls_api_ctx_t*)(((char*)direct_receive_ctx) - offsetof(struct st_picoquic_test_tls_api_ctx_t, client_callback));\n    }\n    else {\n        /* Only testing the direct receive on the client side */\n        ret = -1;\n    }\n\n    if (ret == 0) {\n        for (stream_index = 0; stream_index < ctx->nb_test_streams; stream_index++) {\n            if (ctx->test_stream[stream_index].stream_id == stream_id) {\n                break;\n            }\n        }\n\n        if (stream_index >= ctx->nb_test_streams) {\n            cb_ctx->error_detected |= test_api_fail_data_on_unknown_stream;\n            ret = -1;\n        }\n        else if (offset + length > ctx->test_stream[stream_index].r_len) {\n            cb_ctx->error_detected |= test_api_fail_data_on_unknown_stream;\n            ret = -1;\n        }\n        else {\n            uint64_t last_offset = offset + length;\n            memcpy(ctx->test_stream[stream_index].r_rcv, bytes, length);\n\n            if (memcmp(ctx->test_stream[stream_index].r_src + (size_t)offset, bytes, length) != 0)\n            {\n                cb_ctx->error_detected |= test_api_fail_data_does_not_match;\n                ret = -1;\n            }\n            else if (offset > ctx->test_stream[stream_index].next_direct_offset) {\n                /* Need to create a hole. They are ordered from lowest to highest offset */\n                test_api_stream_hole_t* hole = ctx->test_stream[stream_index].first_direct_hole;\n                test_api_stream_hole_t* previous_hole = NULL;\n                test_api_stream_hole_t* new_hole = (test_api_stream_hole_t*)malloc(sizeof(test_api_stream_hole_t));\n                if (new_hole == NULL) {\n                    ret = PICOQUIC_ERROR_MEMORY;\n                }\n                else {\n                    while (hole != NULL) {\n                        previous_hole = ctx->test_stream[stream_index].first_direct_hole;\n                        hole = previous_hole->next_hole;\n                    }\n                    new_hole->offset = ctx->test_stream[stream_index].next_direct_offset;\n                    new_hole->last_offset = offset;\n                    new_hole->next_hole = NULL;\n                    if (previous_hole == NULL) {\n                        ctx->test_stream[stream_index].first_direct_hole = new_hole;\n                    }\n                    else {\n                        previous_hole->next_hole = new_hole;\n                    }\n                    ctx->test_stream[stream_index].r_recv_nb += length;\n                    ctx->test_stream[stream_index].next_direct_offset = last_offset;\n                }\n            }\n            else {\n                test_api_stream_hole_t* hole = ctx->test_stream[stream_index].first_direct_hole;\n                test_api_stream_hole_t* previous_hole = NULL;\n\n                if (last_offset > ctx->test_stream[stream_index].next_direct_offset) {\n                    /* At least some of the segment comes after the current max offset */\n                    uint64_t new_direct_offset = last_offset;\n                    ctx->test_stream[stream_index].r_recv_nb += (size_t)(last_offset - ctx->test_stream[stream_index].next_direct_offset);\n                    last_offset = ctx->test_stream[stream_index].next_direct_offset;\n                    ctx->test_stream[stream_index].next_direct_offset = new_direct_offset;\n                }\n\n                while (hole != NULL && offset < last_offset) {\n                    test_api_stream_hole_t* next_hole = hole->next_hole;\n                    if (last_offset <= hole->offset) {\n                        /* Segment is entirely covered by previously received data */\n                        break;\n                    }\n                    else if (offset <= hole->offset) {\n                        /* Beginning of segment already received */\n                        offset = hole->offset;\n                    }\n\n                    if (offset <= hole->last_offset) {\n                        if (last_offset >= hole->last_offset) {\n                            /* segment extends past the end of the hole */\n                            uint64_t new_offset = hole->last_offset;\n                            ctx->test_stream[stream_index].r_recv_nb += (size_t)(hole->last_offset - offset);\n                            hole->last_offset = offset;\n                            offset = new_offset;\n                            if (hole->last_offset == hole->offset) {\n                                /* Hole has been filled */\n                                if (previous_hole == NULL) {\n                                    ctx->test_stream[stream_index].first_direct_hole = next_hole;\n                                }\n                                else {\n                                    previous_hole->next_hole = next_hole;\n                                }\n                                free(hole);\n                            }\n                            else {\n                                previous_hole = hole;\n                            }\n                        }\n                        else if (offset == hole->offset) {\n                            /* segment starts at begining of hole */\n                            ctx->test_stream[stream_index].r_recv_nb += (size_t)(last_offset - offset);\n                            offset = last_offset;\n                            hole->offset = last_offset;\n                            previous_hole = hole;\n                        }\n                        else {\n                            /* overlap, need a new hole */\n                            test_api_stream_hole_t* new_hole = (test_api_stream_hole_t*)malloc(sizeof(test_api_stream_hole_t));\n                            if (new_hole == NULL) {\n                                ret = PICOQUIC_ERROR_MEMORY;\n                            }\n                            else {\n                                new_hole->offset = last_offset;\n                                new_hole->last_offset = hole->last_offset;\n                                new_hole->next_hole = hole->next_hole;\n                                hole->last_offset = offset;\n                                hole->next_hole = new_hole;\n                                ctx->test_stream[stream_index].r_recv_nb += (size_t)(last_offset - offset);\n                            }\n                            break;\n                        }\n                    }\n                    else {\n                        previous_hole = hole;\n                    }\n\n                    hole = next_hole;\n                }\n            }\n\n            /* If fin received and no hole, mark received and signal fin */\n            if (fin && ctx->test_stream[stream_index].direct_fin_received == 0) {\n                ctx->test_stream[stream_index].direct_fin_received = fin;\n            }\n\n            if (ctx->test_stream[stream_index].first_direct_hole == NULL && ctx->test_stream[stream_index].direct_fin_received) {\n                ctx->test_stream[stream_index].r_received = 1;\n                ret = PICOQUIC_STREAM_RECEIVE_COMPLETE;\n\n                if (cb_ctx->error_detected == 0) {\n                    /* queue the new queries initiated by that stream */\n                    if (test_api_queue_initial_queries(ctx, stream_id) != 0) {\n                        cb_ctx->error_detected |= test_api_fail_cannot_send_query;\n                    }\n                }\n            }\n        }\n    }\n\n    return ret;\n}\n\nint test_api_callback(picoquic_cnx_t* cnx,\n    uint64_t stream_id, uint8_t* bytes, size_t length,\n    picoquic_call_back_event_t fin_or_event, void* callback_ctx, void* UNUSED(v_stream_ctx))\n{\n    /* Need to implement the server sending strategy */\n    test_api_callback_t* cb_ctx = (test_api_callback_t*)callback_ctx;\n    picoquic_test_tls_api_ctx_t* ctx = NULL;\n    size_t stream_index;\n    picoquic_call_back_event_t stream_finished = picoquic_callback_stream_data;\n\n    if (fin_or_event == picoquic_callback_close ||\n        fin_or_event == picoquic_callback_application_close ||\n        fin_or_event == picoquic_callback_almost_ready ||\n        fin_or_event == picoquic_callback_ready ||\n        fin_or_event == picoquic_callback_app_wakeup) {\n        /* do nothing in our tests */\n        return 0;\n    }\n\n    if (cb_ctx->client_mode) {\n        ctx = (picoquic_test_tls_api_ctx_t*)(((char*)callback_ctx) - offsetof(struct st_picoquic_test_tls_api_ctx_t, client_callback));\n    } else {\n        ctx = (picoquic_test_tls_api_ctx_t*)(((char*)callback_ctx) - offsetof(struct st_picoquic_test_tls_api_ctx_t, server_callback));\n    }\n\n\n    if (fin_or_event == picoquic_callback_version_negotiation) {\n        if (ctx != NULL) {\n            ctx->received_version_negotiation = 1;\n        }\n        return 0;\n    }\n\n    if (fin_or_event == picoquic_callback_stateless_reset) {\n        /* take note to validate test */\n        ctx->reset_received = 1;\n        return 0;\n    }\n\n    if (fin_or_event == picoquic_callback_prepare_to_send) {\n        if (cb_ctx->client_mode && stream_id == 0) {\n            return test_api_stream0_prepare(ctx, bytes, length);\n        } else {\n            /* unexpected call */\n            return -1;\n        }\n    }\n\n    if (fin_or_event == picoquic_callback_pacing_changed)\n    {\n        if (ctx->bw_update != NULL) {\n            fprintf(ctx->bw_update, \"%\" PRIu64 \", %\" PRIu64 \", %\" PRIu64 \", %\" PRIu64 \", %\" PRIu64 \"\\n\",\n                picoquic_get_quic_time(cnx->quic), stream_id, picoquic_get_pacing_rate(cnx),\n                picoquic_get_cwin(cnx), picoquic_get_rtt(cnx));\n        }\n        return 0;\n    }\n\n    if (fin_or_event == picoquic_callback_path_address_observed)\n    {\n        ctx->nb_address_observed++;\n        return 0;\n    }\n\n    if (fin_or_event == picoquic_callback_prepare_datagram)\n    {\n        int ret = -1;\n        if (ctx->datagram_send_fn != NULL) {\n            ret = ctx->datagram_send_fn(cnx, stream_id, bytes, length, ctx->datagram_ctx);\n        }\n        return ret;\n    } else if (fin_or_event == picoquic_callback_datagram)\n    {\n        int ret = -1;\n        if (ctx->datagram_recv_fn != NULL) {\n            ret = ctx->datagram_recv_fn(cnx, stream_id, bytes, length, ctx->datagram_ctx);\n        }\n        return ret;\n    }\n    else if (fin_or_event == picoquic_callback_datagram_acked ||\n        fin_or_event == picoquic_callback_datagram_lost ||\n        fin_or_event == picoquic_callback_datagram_spurious)\n    {\n        int ret = -1;\n        if (ctx->datagram_ack_fn != NULL) {\n            ret = ctx->datagram_ack_fn(cnx, fin_or_event,\n                bytes, length, stream_id /* encode send_time */, ctx->datagram_ctx);\n        }\n        return ret;\n    }\n    else if (fin_or_event == picoquic_callback_path_available ||\n        fin_or_event == picoquic_callback_path_suspended ||\n        fin_or_event == picoquic_callback_path_deleted ||\n        fin_or_event == picoquic_callback_path_quality_changed ||\n        fin_or_event == picoquic_callback_next_path_allowed) {\n        int ret = 0;\n        if (ctx->path_events != NULL) {\n            if (fin_or_event == picoquic_callback_path_quality_changed) {\n                uint64_t unique_path_id = stream_id;\n                picoquic_path_quality_t quality;\n                uint64_t current_time = picoquic_get_quic_time(cnx->quic);\n\n                ret = picoquic_get_path_quality(cnx, unique_path_id, &quality);\n                if (ret == 0) {\n                    fprintf(ctx->path_events,\n                        \"%\" PRIu64 \", %\" PRIu64 \", %d, %\" PRIu64 \", %\" PRIu64 \", %\" PRIu64 \", %\" PRIu64 \"\\n\",\n                        current_time, stream_id, (int)fin_or_event,\n                        quality.pacing_rate, quality.receive_rate_estimate, quality.cwin, quality.rtt);\n                }\n            }\n            else {\n                fprintf(ctx->path_events, \"%\" PRIu64 \", %\" PRIu64 \", %d,\\n\",\n                    picoquic_get_quic_time(cnx->quic), stream_id, (int)fin_or_event);\n            }\n        }\n        else if (fin_or_event == picoquic_callback_path_quality_changed &&\n            ctx->default_path_update != NULL) {\n            picoquic_path_quality_t quality;\n            uint64_t current_time = picoquic_get_quic_time(cnx->quic);\n            picoquic_get_default_path_quality(cnx, &quality);\n            fprintf(ctx->default_path_update,\n                \"%\" PRIu64 \", %\" PRIu64 \", %d, %\" PRIu64 \", %\" PRIu64 \", %\" PRIu64 \", %\" PRIu64 \"\\n\",\n                current_time, stream_id, (int)fin_or_event,\n                quality.pacing_rate, quality.receive_rate_estimate, quality.cwin, quality.rtt);\n        }\n        return ret;\n    }\n\n    if (bytes != NULL) {\n        if (cb_ctx->client_mode) {\n            ctx->sum_data_received_at_client += (int) length;\n        } else {\n            ctx->sum_data_received_at_server += (int) length;\n        }\n    }\n\n    if (stream_id == 0 && cb_ctx->client_mode == 0 &&\n        (fin_or_event == picoquic_callback_stream_data || fin_or_event == picoquic_callback_stream_fin)) {\n        if (bytes == NULL && length != 0) {\n            cb_ctx->error_detected = test_api_bad_stream0_data;\n        }\n        else {\n            for (size_t i = 0; i < length; i++) {\n                if (bytes[i] != 0xA5) {\n                    cb_ctx->error_detected = test_api_bad_stream0_data;\n                }\n            }\n        }\n        if (ctx->stream0_received == 0 && length > 0 && ctx->stream0_flow_release) {\n            (void)picoquic_open_flow_control(cnx, stream_id, ctx->stream0_target);\n        }\n        ctx->stream0_received += length;\n        if (ctx->streams_finished && ctx->stream0_received >= ctx->stream0_target) {\n            ctx->test_finished = 1;\n        }\n    } else {\n        for (stream_index = 0; stream_index < ctx->nb_test_streams; stream_index++) {\n            if (ctx->test_stream[stream_index].stream_id == stream_id) {\n                break;\n            }\n        }\n\n        if (stream_index >= ctx->nb_test_streams) {\n            cb_ctx->error_detected |= test_api_fail_data_on_unknown_stream;\n        }\n        else if (fin_or_event == picoquic_callback_stop_sending) {\n            /* Respond with a reset, no matter what. Should be smarter later */\n            picoquic_reset_stream(cnx, stream_id, 0);\n        }\n        else if (fin_or_event == picoquic_callback_stream_data || fin_or_event == picoquic_callback_stream_fin || fin_or_event == picoquic_callback_stream_reset) {\n            if (IS_CLIENT_STREAM_ID(stream_id)) {\n                if (cb_ctx->client_mode) {\n                    /* this is a response from the server to a client stream */\n                    test_api_receive_stream_data(bytes, length, fin_or_event,\n                        ctx->test_stream[stream_index].r_rcv,\n                        ctx->test_stream[stream_index].r_len,\n                        ctx->test_stream[stream_index].r_src,\n                        &ctx->test_stream[stream_index].r_recv_nb,\n                        &ctx->test_stream[stream_index].r_received,\n                        &cb_ctx->error_detected);\n\n                    stream_finished = fin_or_event;\n                }\n                else {\n                    /* this is a query to a server */\n                    test_api_receive_stream_data(bytes, length, fin_or_event,\n                        ctx->test_stream[stream_index].q_rcv,\n                        ctx->test_stream[stream_index].q_len,\n                        ctx->test_stream[stream_index].q_src,\n                        &ctx->test_stream[stream_index].q_recv_nb,\n                        &ctx->test_stream[stream_index].q_received,\n                        &cb_ctx->error_detected);\n\n                    if (fin_or_event != 0) {\n                        if (ctx->test_stream[stream_index].r_len == 0 || fin_or_event == picoquic_callback_stream_reset) {\n                            ctx->test_stream[stream_index].r_received = 1;\n                            stream_finished = fin_or_event;\n                        }\n                        else if (cb_ctx->error_detected == 0) {\n                            /* send a response */\n                            if (picoquic_add_to_stream(cnx, stream_id,\n                                ctx->test_stream[stream_index].r_src,\n                                ctx->test_stream[stream_index].r_len, 1)\n                                != 0) {\n                                cb_ctx->error_detected |= test_api_fail_cannot_send_response;\n                            }\n                        }\n                    }\n                }\n            }\n            else {\n                if (cb_ctx->client_mode) {\n                    /* this is a query from the server to the client */\n                    test_api_receive_stream_data(bytes, length, fin_or_event,\n                        ctx->test_stream[stream_index].q_rcv,\n                        ctx->test_stream[stream_index].q_len,\n                        ctx->test_stream[stream_index].q_src,\n                        &ctx->test_stream[stream_index].q_recv_nb,\n                        &ctx->test_stream[stream_index].q_received,\n                        &cb_ctx->error_detected);\n\n                    if (fin_or_event != 0) {\n                        if (ctx->test_stream[stream_index].r_len == 0 || fin_or_event == picoquic_callback_stream_reset) {\n                            ctx->test_stream[stream_index].r_received = 1;\n                            stream_finished = fin_or_event;\n                        }\n                        else if (cb_ctx->error_detected == 0) {\n                            /* send a response */\n                            if (picoquic_add_to_stream(cnx, stream_id,\n                                ctx->test_stream[stream_index].r_src,\n                                ctx->test_stream[stream_index].r_len, 1)\n                                != 0) {\n                                cb_ctx->error_detected |= test_api_fail_cannot_send_response;\n                            }\n                        }\n                    }\n                }\n                else {\n                    /* this is a response to the server */\n                    test_api_receive_stream_data(bytes, length, fin_or_event,\n                        ctx->test_stream[stream_index].r_rcv,\n                        ctx->test_stream[stream_index].r_len,\n                        ctx->test_stream[stream_index].r_src,\n                        &ctx->test_stream[stream_index].r_recv_nb,\n                        &ctx->test_stream[stream_index].r_received,\n                        &cb_ctx->error_detected);\n\n                    stream_finished = fin_or_event;\n                }\n            }\n        }\n        else {\n            cb_ctx->error_detected |= test_api_fail_unexpected_frame;\n        }\n\n        if (stream_finished != 0\n            && cb_ctx->error_detected == 0) {\n            /* queue the new queries initiated by that stream */\n            if (test_api_queue_initial_queries(ctx, stream_id) != 0) {\n                cb_ctx->error_detected |= test_api_fail_cannot_send_query;\n            }\n        }\n    }\n\n    return 0;\n}\n\nint test_api_init_send_recv_scenario(picoquic_test_tls_api_ctx_t* test_ctx,\n    test_api_stream_desc_t* stream_desc, size_t size_of_scenarios)\n{\n    int ret = 0;\n    size_t nb_stream_desc = size_of_scenarios / sizeof(test_api_stream_desc_t);\n\n    if (nb_stream_desc > PICOQUIC_TEST_MAX_TEST_STREAMS) {\n        ret = -1;\n    } else {\n        test_ctx->nb_test_streams = nb_stream_desc;\n        test_ctx->test_finished = 0;\n\n        for (size_t i = 0; ret == 0 && i < nb_stream_desc; i++) {\n            ret = test_api_init_test_stream(&test_ctx->test_stream[i],\n                stream_desc[i].stream_id, stream_desc[i].previous_stream_id,\n                stream_desc[i].q_len, stream_desc[i].r_len);\n        }\n    }\n\n    if (ret == 0) {\n        ret = test_api_queue_initial_queries(test_ctx, 0);\n    }\n\n    return ret;\n}\n\nstatic int verify_transport_extension(picoquic_cnx_t* cnx_client, picoquic_cnx_t* cnx_server)\n{\n    int ret = 0;\n\n    /* verify that local parameters have a sensible value */\n    if (cnx_client->local_parameters.max_idle_timeout == 0 || cnx_client->local_parameters.initial_max_data == 0 || cnx_client->local_parameters.initial_max_stream_data_bidi_local == 0 || cnx_client->local_parameters.max_packet_size == 0) {\n        ret = -1;\n    } else if (cnx_server->local_parameters.max_idle_timeout == 0 || cnx_server->local_parameters.initial_max_data == 0 || cnx_server->local_parameters.initial_max_stream_data_bidi_remote == 0 || cnx_server->local_parameters.max_packet_size == 0) {\n        ret = -1;\n    }\n    /* Verify that the negotiation completed */\n    else if (memcmp(&cnx_client->local_parameters, &cnx_server->remote_parameters,\n                 sizeof(picoquic_tp_t))\n        != 0) {\n        ret = -1;\n    } else if (memcmp(&cnx_server->local_parameters, &cnx_client->remote_parameters,\n                   sizeof(picoquic_tp_t))\n        != 0) {\n        ret = -1;\n    }\n\n    return ret;\n}\n\nstatic int verify_sni(picoquic_cnx_t* cnx_client, picoquic_cnx_t* cnx_server,\n    char const* sni)\n{\n    int ret = 0;\n    char const* client_sni = picoquic_tls_get_sni(cnx_client);\n    char const* server_sni = picoquic_tls_get_sni(cnx_server);\n\n    if (sni == NULL) {\n        if (cnx_client->sni != NULL) {\n            ret = -1;\n        } else if (client_sni != NULL) {\n            ret = -1;\n        } else if (server_sni != NULL) {\n            ret = -1;\n        }\n    } else {\n        if (cnx_client->sni == NULL) {\n            ret = -1;\n        } else if (client_sni == NULL) {\n            ret = -1;\n        } else if (server_sni == NULL) {\n            ret = -1;\n        } else if (strcmp(cnx_client->sni, sni) != 0) {\n            ret = -1;\n        } else if (strcmp(client_sni, sni) != 0) {\n            ret = -1;\n        } else if (strcmp(server_sni, sni) != 0) {\n            ret = -1;\n        }\n    }\n\n    return ret;\n}\n\nstatic int verify_alpn(picoquic_cnx_t* cnx_client, picoquic_cnx_t* cnx_server,\n    char const* alpn)\n{\n    int ret = 0;\n    char const* client_alpn = picoquic_tls_get_negotiated_alpn(cnx_client);\n    char const* server_alpn = picoquic_tls_get_negotiated_alpn(cnx_server);\n\n    if (alpn == NULL) {\n        if (cnx_client->alpn != NULL) {\n            ret = -1;\n        } else if (client_alpn != NULL) {\n            ret = -1;\n        } else if (server_alpn != NULL) {\n            ret = -1;\n        }\n    } else {\n        if (cnx_client->alpn == NULL) {\n            ret = -1;\n        } else if (client_alpn == NULL) {\n            ret = -1;\n        } else if (server_alpn == NULL) {\n            ret = -1;\n        } else if (strcmp(cnx_client->alpn, alpn) != 0) {\n            ret = -1;\n        } else if (strcmp(client_alpn, alpn) != 0) {\n            ret = -1;\n        } else if (strcmp(server_alpn, alpn) != 0) {\n            ret = -1;\n        }\n    }\n\n    return ret;","numLines":700,"startLine":300,"totalLines":13056}}}
