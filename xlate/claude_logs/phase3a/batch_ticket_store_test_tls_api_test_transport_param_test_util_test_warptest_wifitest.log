{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01N4TRsMGqJSyWkfHNMYnc5a","type":"tool_result","content":"4000\t                if (verified == 0) {\n4001\t                    DBG_PRINTF(\"%s\", \"Bad length check fails\\n\");\n4002\t                    ret = -1;\n4003\t                }\n4004\t            }\n4005\t        }\n4006\t    }\n4007\t\n4008\t    picoquic_free(quic);\n4009\t    return ret;\n4010\t}\n4011\t\n4012\tint tls_api_retry_test_one(int large_client_hello)\n4013\t{\n4014\t    uint64_t simulated_time = 0;\n4015\t    const uint64_t target_time = 230000ull;\n4016\t    uint64_t loss_mask = 0;\n4017\t    picoquic_test_tls_api_ctx_t* test_ctx = NULL;\n4018\t    int ret = tls_api_init_ctx(&test_ctx, 0, PICOQUIC_TEST_SNI, PICOQUIC_TEST_ALPN, &simulated_time, NULL, NULL, 0, 1, 0);\n4019\t\n4020\t    if (ret == 0) {\n4021\t        if (large_client_hello) {\n4022\t            test_ctx->cnx_client->test_large_chello = 1;\n4023\t        }\n4024\t        picoquic_set_qlog(test_ctx->qclient, \".\");\n4025\t        ret = picoquic_start_client_cnx(test_ctx->cnx_client);\n4026\t    }\n4027\t\n4028\t\n4029\t    if (ret == 0) {\n4030\t        /* Set the server in HRR/Cookies mode */\n4031\t        picoquic_set_cookie_mode(test_ctx->qserver, 1);\n4032\t        /* Try the connection */\n4033\t        ret = tls_api_connection_loop(test_ctx, &loss_mask, 0, &simulated_time);\n4034\t    }\n4035\t\n4036\t    if (ret == 0) {\n4037\t        ret = tls_api_attempt_to_close(test_ctx, &simulated_time);\n4038\t    }\n4039\t\n4040\t    if (ret == 0 && simulated_time > target_time) {\n4041\t        DBG_PRINTF(\"Retry test completes in %llu microsec, more than %llu\\n\", simulated_time, target_time);\n4042\t        ret = -1;\n4043\t    }\n4044\t\n4045\t    if (test_ctx != NULL) {\n4046\t        tls_api_delete_ctx(test_ctx);\n4047\t        test_ctx = NULL;\n4048\t    }\n4049\t\n4050\t    return ret;\n4051\t}\n4052\t\n4053\tint tls_api_retry_test(void)\n4054\t{\n4055\t    return tls_api_retry_test_one(0);\n4056\t}\n4057\t\n4058\tint tls_api_retry_large_test(void)\n4059\t{\n4060\t    return tls_api_retry_test_one(1);\n4061\t}\n4062\t/*\n4063\t* verify that a connection is correctly established\n4064\t* if the client does not initially provide a key share\n4065\t*/\n4066\t\n4067\tint tls_zero_share_test(void)\n4068\t{\n4069\t    uint64_t simulated_time = 0;\n4070\t    uint64_t loss_mask = 0;\n4071\t    picoquic_test_tls_api_ctx_t* test_ctx = NULL;\n4072\t    int ret = tls_api_init_ctx(&test_ctx, 0, PICOQUIC_TEST_SNI, PICOQUIC_TEST_ALPN, &simulated_time, NULL, NULL, 1, 0, 0);\n4073\t\n4074\t    if (ret == 0) {\n4075\t        ret = tls_api_connection_loop(test_ctx, &loss_mask, 0, &simulated_time);\n4076\t    }\n4077\t\n4078\t    if (ret == 0) {\n4079\t        ret = tls_api_attempt_to_close(test_ctx, &simulated_time);\n4080\t    }\n4081\t\n4082\t    if (test_ctx != NULL) {\n4083\t        tls_api_delete_ctx(test_ctx);\n4084\t        test_ctx = NULL;\n4085\t    }\n4086\t\n4087\t    return ret;\n4088\t}\n4089\t\n4090\t\n4091\t/*\n4092\t * Test two successive connections from the same client.\n4093\t */\n4094\t\n4095\tint tls_api_two_connections_test(void)\n4096\t{\n4097\t    uint64_t simulated_time = 0;\n4098\t    uint64_t loss_mask = 0;\n4099\t    picoquic_test_tls_api_ctx_t* test_ctx = NULL;\n4100\t    int ret = tls_api_init_ctx(&test_ctx, 0, PICOQUIC_TEST_SNI, PICOQUIC_TEST_ALPN, &simulated_time, NULL, NULL, 0, 0, 0);\n4101\t\n4102\t    if (ret == 0) {\n4103\t        ret = tls_api_connection_loop(test_ctx, &loss_mask, 0, &simulated_time);\n4104\t    }\n4105\t\n4106\t    if (ret == 0) {\n4107\t        /* Verify that the connection is fully established */\n4108\t        uint64_t target_time = simulated_time + 2000000;\n4109\t\n4110\t        while (ret == 0 && TEST_CLIENT_READY && TEST_SERVER_READY && simulated_time < target_time) {\n4111\t            int was_active = 0;\n4112\t            ret = tls_api_one_sim_round(test_ctx, &simulated_time, target_time, &was_active);\n4113\t        }\n4114\t\n4115\t        /* Delete the client connection from the client context,\n4116\t         * without sending notification to the server */\n4117\t        while (test_ctx->qclient->cnx_list != NULL) {\n4118\t            picoquic_delete_cnx(test_ctx->qclient->cnx_list);\n4119\t        }\n4120\t\n4121\t        /* Erase the server connection reference */\n4122\t        test_ctx->cnx_server = NULL;\n4123\t\n4124\t        /* Create a new connection in the client context */\n4125\t\n4126\t        test_ctx->cnx_client = picoquic_create_cnx(test_ctx->qclient,\n4127\t            picoquic_null_connection_id, picoquic_null_connection_id,\n4128\t            (struct sockaddr*)&test_ctx->server_addr, simulated_time, 0, PICOQUIC_TEST_SNI, PICOQUIC_TEST_ALPN, 1);\n4129\t\n4130\t        if (test_ctx->cnx_client == NULL) {\n4131\t            ret = -1;\n4132\t        }\n4133\t        else {\n4134\t            ret = picoquic_start_client_cnx(test_ctx->cnx_client);\n4135\t        }\n4136\t    }\n4137\t\n4138\t    /* Now, restart a connection in the same context */\n4139\t    if (ret == 0) {\n4140\t        ret = tls_api_connection_loop(test_ctx, &loss_mask, 0, &simulated_time);\n4141\t    }\n4142\t\n4143\t    if (ret == 0) {\n4144\t        ret = tls_api_attempt_to_close(test_ctx, &simulated_time);\n4145\t    }\n4146\t\n4147\t    if (test_ctx != NULL) {\n4148\t        tls_api_delete_ctx(test_ctx);\n4149\t        test_ctx = NULL;\n4150\t    }\n4151\t\n4152\t    return ret;\n4153\t}\n4154\t\n4155\tint tls_api_client_first_loss_test(void)\n4156\t{\n4157\t    return tls_api_loss_test(1ull);\n4158\t}\n4159\t\n4160\tint tls_api_client_second_loss_test(void)\n4161\t{\n4162\t    return tls_api_loss_test(2ull);\n4163\t}\n4164\t\n4165\tint tls_api_server_first_loss_test(void)\n4166\t{\n4167\t    return tls_api_loss_test(14ull);\n4168\t}\n4169\t\n4170\tint tls_api_client_losses_test(void)\n4171\t{\n4172\t    return tls_api_loss_test(3ull);\n4173\t}\n4174\t\n4175\tint tls_api_server_losses_test(void)\n4176\t{\n4177\t    return tls_api_loss_test(6ull);\n4178\t}\n4179\t\n4180\t/*\n4181\t * Do a simple test for all supported versions\n4182\t */\n4183\tint tls_api_multiple_versions_test(void)\n4184\t{\n4185\t    int ret = 0;\n4186\t\n4187\t    for (size_t i = 1; ret == 0 && i < picoquic_nb_supported_versions; i++) {\n4188\t        ret = tls_api_one_scenario_test(test_scenario_q_and_r, sizeof(test_scenario_q_and_r), 0, 0, 0, 0,\n4189\t            picoquic_supported_versions[i].version, 0, NULL, NULL);\n4190\t    }\n4191\t\n4192\t    return ret;\n4193\t}\n4194\t\n4195\t/*\n4196\t * Keep alive test.\n4197\t */\n4198\t\n4199\tint keep_alive_test_impl(int keep_alive)\n4200\t{\n4201\t    uint64_t simulated_time = 0;\n4202\t    const uint64_t keep_alive_interval = 0; /* Will use the default value */\n4203\t    uint64_t loss_mask = 0;\n4204\t    picoquic_test_tls_api_ctx_t* test_ctx = NULL;\n4205\t    int ret = tls_api_init_ctx(&test_ctx, 0, PICOQUIC_TEST_SNI, PICOQUIC_TEST_ALPN, &simulated_time, NULL, NULL, 0, 0, 0);\n4206\t    int was_active = 0;\n4207\t\n4208\t    if (ret == 0 && test_ctx == NULL) {\n4209\t        return PICOQUIC_ERROR_MEMORY;\n4210\t    }\n4211\t\n4212\t    /*\n4213\t     * setup the connections.\n4214\t     */\n4215\t\n4216\t    if (ret == 0) {\n4217\t        ret = tls_api_connection_loop(test_ctx, &loss_mask, 0, &simulated_time);\n4218\t    }\n4219\t\n4220\t    /*\n4221\t     * Enable keep alive\n4222\t     */\n4223\t    if (ret == 0 && keep_alive) {\n4224\t        picoquic_enable_keep_alive(test_ctx->cnx_client, keep_alive_interval);\n4225\t    }\n4226\t\n4227\t    /* Perform rounds of sending data until the requested time has been spent */\n4228\t    for (int i = 0; ret == 0 && i < 0x10000 && test_ctx->cnx_client->cnx_state != picoquic_state_disconnected ; i++) {\n4229\t        was_active = 0;\n4230\t\n4231\t        ret = tls_api_one_sim_round(test_ctx, &simulated_time, 0, &was_active);\n4232\t        if (simulated_time > 2 * PICOQUIC_MICROSEC_SILENCE_MAX) {\n4233\t            break;\n4234\t        }\n4235\t    }\n4236\t\n4237\t    /* Check that the status matched the expected value */\n4238\t    if (test_ctx == NULL || test_ctx->cnx_client == NULL) {\n4239\t        ret = -1;\n4240\t    } else if (keep_alive != 0) {\n4241\t        if (!TEST_CLIENT_READY) {\n4242\t            ret = -1;\n4243\t        } else if (simulated_time < 2 * PICOQUIC_MICROSEC_SILENCE_MAX) {\n4244\t            DBG_PRINTF(\"Keep alive test concludes after %llu microsecs instead of %llu, ret = %d\\n\",\n4245\t                (unsigned long long)simulated_time, (unsigned long long)2 * PICOQUIC_MICROSEC_SILENCE_MAX, ret);\n4246\t            ret = -1;\n4247\t        } \n4248\t    } else if (keep_alive == 0) {\n4249\t        /* If keep alive was not activated, reset ret to `0`, as `tls_api_one_sim_round` returns -1\n4250\t         * when the connection was disconnected.\n4251\t         */\n4252\t        ret = test_ctx->cnx_client->cnx_state != picoquic_state_disconnected;\n4253\t    }\n4254\t\n4255\t    /* Close the connection */\n4256\t    if (ret == 0 && test_ctx->cnx_client->cnx_state != picoquic_state_disconnected) {\n4257\t        ret = tls_api_attempt_to_close(test_ctx, &simulated_time);\n4258\t    }\n4259\t\n4260\t    /* Clean up */\n4261\t    if (test_ctx != NULL) {\n4262\t        tls_api_delete_ctx(test_ctx);\n4263\t        test_ctx = NULL;\n4264\t    }\n4265\t\n4266\t    return ret;\n4267\t}\n4268\t\n4269\tint keep_alive_test(void)\n4270\t{\n4271\t    int ret = keep_alive_test_impl(1);\n4272\t\n4273\t    if (ret == 0) {\n4274\t        ret = keep_alive_test_impl(0);\n4275\t    }\n4276\t\n4277\t    return ret;\n4278\t}\n4279\t\n4280\t/*\n4281\t * Session resume test.\n4282\t */\n4283\tstatic char const* ticket_file_name = \"resume_tests_tickets.bin\";\n4284\t\n4285\tint session_resume_wait_for_ticket(picoquic_test_tls_api_ctx_t* test_ctx,\n4286\t    uint64_t * simulated_time) \n4287\t{\n4288\t    int ret = 0;\n4289\t    uint64_t time_out = *simulated_time + 4000000;\n4290\t    int nb_trials = 0;\n4291\t    int nb_inactive = 0;\n4292\t\n4293\t    while (*simulated_time <time_out &&\n4294\t        TEST_CLIENT_READY &&\n4295\t        TEST_SERVER_READY &&\n4296\t        test_ctx->qclient->p_first_ticket == NULL &&\n4297\t        nb_trials < 1024 &&\n4298\t        nb_inactive < 64 &&\n4299\t        ret == 0){\n4300\t        int was_active = 0;\n4301\t        nb_trials++;\n4302\t\n4303\t        ret = tls_api_one_sim_round(test_ctx, simulated_time, time_out, &was_active);\n4304\t\n4305\t        if (was_active) {\n4306\t            nb_inactive = 0;\n4307\t        }\n4308\t        else {\n4309\t            nb_inactive++;\n4310\t        }\n4311\t    }\n4312\t    \n4313\t    return ret;\n4314\t}\n4315\t\n4316\tint session_resume_test(void)\n4317\t{\n4318\t    uint64_t simulated_time = 0;\n4319\t    picoquic_test_tls_api_ctx_t* test_ctx = NULL;\n4320\t    char const* sni = PICOQUIC_TEST_SNI;\n4321\t    char const* alpn = PICOQUIC_TEST_ALPN;\n4322\t    uint64_t loss_mask = 0;\n4323\t    int ret = 0;\n4324\t\n4325\t    /* Initialize an empty ticket store */\n4326\t    ret = picoquic_save_tickets(NULL, simulated_time, ticket_file_name);\n4327\t\n4328\t    for (int i = 0; i < 2; i++) {\n4329\t        /* Set up the context, while setting the ticket store parameter for the client */\n4330\t        if (ret == 0) {\n4331\t            ret = tls_api_init_ctx(&test_ctx, 0, sni, alpn, &simulated_time, ticket_file_name, NULL, 0, 0, 0);\n4332\t        }\n4333\t\n4334\t        if (ret == 0) {\n4335\t            test_ctx->cnx_client->max_early_data_size = 0;\n4336\t\n4337\t            ret = tls_api_connection_loop(test_ctx, &loss_mask, 0, &simulated_time);\n4338\t        }\n4339\t\n4340\t        if (ret == 0 && i == 1) {\n4341\t            /* If resume succeeded, the second connection will have a type \"PSK\" */\n4342\t            if (picoquic_tls_is_psk_handshake(test_ctx->cnx_server) == 0 || picoquic_tls_is_psk_handshake(test_ctx->cnx_client) == 0) {\n4343\t                ret = -1;\n4344\t            }\n4345\t        }\n4346\t\n4347\t        if (ret == 0 && i == 0) {\n4348\t            /* Before closing, wait for the session ticket to arrive */\n4349\t            ret = session_resume_wait_for_ticket(test_ctx, &simulated_time);\n4350\t        }\n4351\t\n4352\t        if (ret == 0) {\n4353\t            ret = tls_api_attempt_to_close(test_ctx, &simulated_time);\n4354\t        }\n4355\t\n4356\t        /* Verify that the session ticket has been received correctly */\n4357\t        if (ret == 0) {\n4358\t            if (test_ctx->qclient->p_first_ticket == NULL) {\n4359\t                ret = -1;\n4360\t            } else {\n4361\t                ret = picoquic_save_tickets(test_ctx->qclient->p_first_ticket, simulated_time, ticket_file_name);\n4362\t            }\n4363\t        }\n4364\t        /* Tear down and free everything */\n4365\t\n4366\t        if (test_ctx != NULL) {\n4367\t            tls_api_delete_ctx(test_ctx);\n4368\t            test_ctx = NULL;\n4369\t        }\n4370\t    }\n4371\t\n4372\t    return ret;\n4373\t}\n4374\t\n4375\t/*\n4376\t * Zero RTT test. Like the session resume test, but with a twist...\n4377\t * Use multipath_init_params procedure to set up parameters for the multipath test.\n4378\t */\n4379\tvoid multipath_init_params(picoquic_tp_t* test_parameters, int enable_time_stamp);\n4380\t\n4381\tint zero_rtt_test_one(zero_rtt_test_t * zrt)\n4382\t{\n4383\t    uint64_t simulated_time = 0;\n4384\t    picoquic_test_tls_api_ctx_t* test_ctx = NULL;\n4385\t    char const* sni = PICOQUIC_TEST_SNI;\n4386\t    char const* alpn = PICOQUIC_TEST_ALPN;\n4387\t    uint64_t loss_mask = 0;\n4388\t    uint32_t proposed_version = 0;\n4389\t\n4390\t    picoquic_tp_t server_parameters = { 0 };\n4391\t    int ret = 0;\n4392\t\n4393\t    /* Initialize an empty ticket store */\n4394\t    ret = picoquic_save_tickets(NULL, simulated_time, ticket_file_name);\n4395\t\n4396\t    for (int i = 0; i < 2; i++) {\n4397\t        /* Insert a delay before the second connection attempt */\n4398\t        if (i == 1) {\n4399\t            simulated_time += zrt->extra_delay;\n4400\t        }\n4401\t        /* Set up the context, while setting the ticket store parameter for the client */\n4402\t        if (ret == 0) {\n4403\t            ret = tls_api_init_ctx(&test_ctx, \n4404\t                (i==0)?0: proposed_version, sni, alpn, &simulated_time, ticket_file_name, NULL, 0, 1,\n4405\t                (i == 0)?0: zrt->use_badcrypt);\n4406\t\n4407\t            if (ret == 0 && zrt->no_coal) {\n4408\t                test_ctx->qserver->dont_coalesce_init = 1;\n4409\t            }\n4410\t\n4411\t            if (ret == 0 && zrt->hardreset != 0 && i == 1) {\n4412\t                picoquic_set_cookie_mode(test_ctx->qserver, 1);\n4413\t            }\n4414\t\n4415\t            if (ret == 0 && zrt->do_multipath) {\n4416\t                /* Set the multipath option at both client and server */\n4417\t                multipath_init_params(&server_parameters, 0);\n4418\t                picoquic_set_default_tp(test_ctx->qserver, &server_parameters);\n4419\t                test_ctx->cnx_client->local_parameters.initial_max_path_id = 3;\n4420\t                test_ctx->cnx_client->local_parameters.enable_time_stamp = 0;\n4421\t            }\n4422\t\n4423\t            if (ret == 0 && i > 0 && zrt->change_params) {\n4424\t                test_ctx->qserver->default_tp.initial_max_data -= 1;\n4425\t                test_ctx->qserver->default_tp.initial_max_stream_id_bidir += 1;\n4426\t            }\n4427\t\n4428\t            if (ret == 0 && zrt->propose_ech) {\n4429\t                ret = picoquic_ech_configure_quic_ctx(test_ctx->qclient, NULL, NULL);\n4430\t            }\n4431\t\n4432\t            if (ret == 0) {\n4433\t                /* Initialize the client connection */\n4434\t                picoquic_start_client_cnx(test_ctx->cnx_client);\n4435\t            }\n4436\t        }\n4437\t\n4438\t        if (ret == 0 && i == 1) {\n4439\t            /* set the link delays to 100 ms, for realistic testing */\n4440\t            test_ctx->c_to_s_link->microsec_latency = 50000ull;\n4441\t            test_ctx->s_to_c_link->microsec_latency = 50000ull;\n4442\t\n4443\t            if (zrt->long_data) {\n4444\t                for (uint64_t x = 0; x <= 16; x++) {\n4445\t                    uint64_t stream_id = 4u * x + 4u;\n4446\t                    test_ctx->nb_test_streams = (size_t)(x + 1);\n4447\t                    if (test_api_init_test_stream(&test_ctx->test_stream[x], stream_id, UINT64_MAX, 256, 32) != 0){\n4448\t                        DBG_PRINTF(\"Could not initialize data for stream %d\", (int)stream_id);\n4449\t                        ret = -1;\n4450\t                    }\n4451\t                    /* Queue an initial frame on each stream */\n4452\t                    if (picoquic_add_to_stream(test_ctx->cnx_client, stream_id, \n4453\t                        test_ctx->test_stream[x].q_src, test_ctx->test_stream[x].q_len, 1) != 0) {\n4454\t                        DBG_PRINTF(\"Could not write data for stream %d\", (int)stream_id);\n4455\t                        ret = -1;\n4456\t                    }\n4457\t                }\n4458\t            }\n4459\t            else {\n4460\t                uint8_t test_data[8] = { 't', 'e', 's', 't', '0', 'r', 't', 't' };\n4461\t                /* Queue an initial frame on the client connection */\n4462\t                if (picoquic_add_to_stream(test_ctx->cnx_client, 0, test_data, sizeof(test_data), 1) != 0) {\n4463\t                    DBG_PRINTF(\"Could not write data for stream %d\", 0);\n4464\t                    ret = -1;\n4465\t                }\n4466\t            }\n4467\t\n4468\t            if (zrt->early_loss > 0) {\n4469\t                loss_mask = zrt->early_loss;\n4470\t            }\n4471\t        }\n4472\t\n4473\t        if (ret == 0) {\n4474\t            ret = tls_api_connection_loop(test_ctx, &loss_mask, 0, &simulated_time);\n4475\t\n4476\t            if (ret != 0) {\n4477\t                DBG_PRINTF(\"Zero RTT test (badcrypt: %d, hard: %d), connection %d fails (0x%x)\\n\",\n4478\t                    zrt->use_badcrypt, zrt->hardreset, i, ret);\n4479\t            }\n4480\t        }\n4481\t\n4482\t        if (ret == 0 && zrt->use_badcrypt == 0 && zrt->hardreset == 0 && zrt->change_params == 0) {\n4483\t            int rtt_is_available = picoquic_is_0rtt_available(test_ctx->cnx_client);\n4484\t\n4485\t            if ((rtt_is_available && i == 0) ||\n4486\t                (!rtt_is_available && i != 0)) {\n4487\t                ret = -1;\n4488\t            }\n4489\t        }\n4490\t\n4491\t        if (ret == 0 && i == 1) {\n4492\t            /* If resume succeeded, the second connection will have a type \"PSK\" */\n4493\t            if (zrt->use_badcrypt == 0 && zrt->hardreset == 0 && zrt->change_params == 0 && (\n4494\t                picoquic_tls_is_psk_handshake(test_ctx->cnx_server) == 0 || \n4495\t                picoquic_tls_is_psk_handshake(test_ctx->cnx_client) == 0)) {\n4496\t                DBG_PRINTF(\"Zero RTT test (badcrypt: %d, hard: %d, change: %d), connection %d not PSK.\\n\",\n4497\t                    zrt->use_badcrypt, zrt->hardreset, zrt->change_params, i);\n4498\t                ret = -1;\n4499\t            } else {\n4500\t                /* run a receive loop until no outstanding data */\n4501\t                ret = tls_api_synch_to_empty_loop(test_ctx, &simulated_time, 2048, 0, 0);\n4502\t            }\n4503\t        }\n4504\t\n4505\t        if (ret == 0 && i == 1 && zrt->do_multipath) {\n4506\t            /* verify that multipath was negotiated */\n4507\t            if (!test_ctx->cnx_client->is_multipath_enabled ||\n4508\t                !test_ctx->cnx_server->is_multipath_enabled) {\n4509\t                DBG_PRINTF(\"Zero RTT test, multipath not negotiated (client: %d, server: %d).\\n\",\n4510\t                    test_ctx->cnx_client->is_multipath_enabled,\n4511\t                    test_ctx->cnx_server->is_multipath_enabled);\n4512\t                ret = -1;\n4513\t            }\n4514\t        }\n4515\t\n4516\t        if (ret == 0) {\n4517\t            if (i == 0) {\n4518\t                /* Before closing, wait for the session ticket to arrive */\n4519\t                ret = session_resume_wait_for_ticket(test_ctx, &simulated_time);\n4520\t            }\n4521\t            else {\n4522\t                /* Before closing, wait for all data to be acknowledged, etc. */\n4523\t                ret = tls_api_synch_to_empty_loop(test_ctx, &simulated_time, 2048, 0, 1);\n4524\t            }\n4525\t        }\n4526\t\n4527\t        if (ret == 0) {\n4528\t            ret = tls_api_attempt_to_close(test_ctx, &simulated_time);\n4529\t\n4530\t            if (ret != 0) {\n4531\t                DBG_PRINTF(\"Zero RTT test (badcrypt: %d, hard: %d), connection %d close error (0x%x).\\n\",\n4532\t                    zrt->use_badcrypt, zrt->hardreset, i, ret);\n4533\t            }\n4534\t        }\n4535\t\n4536\t        /* Verify that the 0RTT data was sent and acknowledged */\n4537\t        if (ret == 0 && i == 1) {\n4538\t            if (zrt->use_badcrypt == 0 && zrt->hardreset == 0 && zrt->change_params == 0) {\n4539\t                if (test_ctx->cnx_client->nb_zero_rtt_sent == 0) {\n4540\t                    DBG_PRINTF(\"Zero RTT test (badcrypt: %d, hard: %d), no zero RTT sent.\\n\",\n4541\t                        zrt->use_badcrypt, zrt->hardreset);\n4542\t                    ret = -1;\n4543\t                }\n4544\t                else if (zrt->early_loss == 0 &&\n4545\t                    test_ctx->cnx_client->nb_zero_rtt_acked != test_ctx->cnx_client->nb_zero_rtt_sent) {\n4546\t                    DBG_PRINTF(\"Zero RTT test (badcrypt: %d, hard: %d), no zero RTT acked.\\n\",\n4547\t                        zrt->use_badcrypt, zrt->hardreset);\n4548\t                    ret = -1;\n4549\t                }\n4550\t                else if (zrt->early_loss == 0 && zrt->no_coal && test_ctx->cnx_server != NULL &&\n4551\t                        test_ctx->cnx_client->nb_zero_rtt_sent != test_ctx->cnx_server->nb_zero_rtt_received) {\n4552\t                    DBG_PRINTF(\"Zero RTT test sent %d 0RTT, received %d\\n\",\n4553\t                        test_ctx->cnx_client->nb_zero_rtt_sent, test_ctx->cnx_server->nb_zero_rtt_received);\n4554\t                    ret = -1;\n4555\t                }\n4556\t                else if (zrt->long_data && test_ctx->cnx_client->nb_zero_rtt_sent < 3) {\n4557\t                    DBG_PRINTF(\"Zero RTT long test (badcrypt: %d, hard: %d), only %d zero RTT sent.\\n\",\n4558\t                        zrt->use_badcrypt, zrt->hardreset, (int)test_ctx->cnx_client->nb_zero_rtt_sent);\n4559\t                    ret = -1;\n4560\t                }\n4561\t            } else {\n4562\t                if (test_ctx->cnx_client->nb_zero_rtt_sent == 0) {\n4563\t                    DBG_PRINTF(\"Zero RTT test (badcrypt: %d, hard: %d, change: %d), no zero RTT sent.\\n\",\n4564\t                        zrt->use_badcrypt, zrt->hardreset, zrt->change_params);\n4565\t                    ret = -1;\n4566\t                }\n4567\t                else if ((zrt->early_loss || zrt->change_params) && test_ctx->cnx_client->nb_zero_rtt_acked != 0) {\n4568\t                    DBG_PRINTF(\"Zero RTT test (badcrypt: %d, change : %d), zero rtt acked, not expected.\\n\",\n4569\t                        zrt->use_badcrypt, zrt->change_params);\n4570\t                    ret = -1;\n4571\t                }\n4572\t                else if (test_ctx->sum_data_received_at_server == 0) {\n4573\t                    DBG_PRINTF(\"Zero RTT test (badcrypt: %d, hard: %d, loss: %d), no data received.\\n\",\n4574\t                        zrt->use_badcrypt, zrt->hardreset, zrt->early_loss);\n4575\t                    ret = -1;\n4576\t                }\n4577\t                else if (test_ctx->cnx_client->did_receive_short_initial) {\n4578\t                    DBG_PRINTF(\"Zero RTT test (badcrypt: %d, hard: %d), server sent unpadded initial.\\n\",\n4579\t                        zrt->use_badcrypt, zrt->hardreset);\n4580\t                    ret = -1;\n4581\t                }\n4582\t            }\n4583\t        }\n4584\t\n4585\t        /* Verify that the session ticket has been received correctly */\n4586\t        if (ret == 0) {\n4587\t            if (test_ctx->qclient->p_first_ticket == NULL) {\n4588\t                DBG_PRINTF(\"Zero RTT test (badcrypt: %d, hard: %d), cnx %d, no ticket received.\\n\",\n4589\t                    zrt->use_badcrypt, zrt->hardreset, i);\n4590\t                ret = -1;\n4591\t            } else {\n4592\t                ret = picoquic_save_tickets(test_ctx->qclient->p_first_ticket, simulated_time, ticket_file_name);\n4593\t                if (ret != 0) {\n4594\t                    DBG_PRINTF(\"Zero RTT test (badcrypt: %d, hard: %d), cnx %d, ticket save error (0x%x).\\n\",\n4595\t                        zrt->use_badcrypt, zrt->hardreset, i, ret);\n4596\t                }\n4597\t            }\n4598\t        }\n4599\t"}]},"parent_tool_use_id":"toolu_01DLpwD9vYuhD2vecYuV5PML","session_id":"782f2f02-5f93-4f6f-b663-2ef2c783a0cf","uuid":"0d0434da-de2d-4bac-a30a-d98a45258c77","timestamp":"2026-05-05T12:34:04.393Z"}
