t                }\n8040\t            }\n8041\t        }\n8042\t\n8043\t        if (ret == 0) {\n8044\t            ret = tls_api_one_sim_round(test_ctx, &simulated_time, 0, &was_active);\n8045\t        }\n8046\t\n8047\t        if (ret != 0)\n8048\t        {\n8049\t            break;\n8050\t        }\n8051\t\n8052\t        if (was_active) {\n8053\t            nb_inactive = 0;\n8054\t        }\n8055\t        else {\n8056\t            nb_inactive++;\n8057\t        }\n8058\t\n8059\t        if (test_ctx->test_finished) {\n8060\t            if (picoquic_is_cnx_backlog_empty(test_ctx->cnx_client) && picoquic_is_cnx_backlog_empty(test_ctx->cnx_server)) {\n8061\t                break;\n8062\t            }\n8063\t        }\n8064\t    }\n8065\t\n8066\t    if (ret == 0 && TEST_CLIENT_READY) {\n8067\t        ret = tls_api_attempt_to_close(test_ctx, &simulated_time);\n8068\t\n8069\t        if (ret != 0) {\n8070\t            DBG_PRINTF(\"Connection close returns %d\\n\", ret);\n8071\t        }\n8072\t    }\n8073\t\n8074\t    /*\n8075\t     * Allow for some time for the server connection to close.\n8076\t     */\n8077\t    closing_time = simulated_time + 4000000;\n8078\t    while (ret == 0 && simulated_time < closing_time) {\n8079\t        int was_active = 0; \n8080\t        if (test_ctx->cnx_server == NULL) {\n8081\t            ret = -1;\n8082\t            break;\n8083\t        }\n8084\t        if (test_ctx->qserver->cnx_list == NULL || test_ctx->cnx_server->cnx_state == picoquic_state_disconnected) {\n8085\t            break;\n8086\t        }\n8087\t\n8088\t        ret = tls_api_one_sim_round(test_ctx, &simulated_time, 0, &was_active);\n8089\t    }\n8090\t\n8091\t    if (test_ctx != NULL) {\n8092\t        tls_api_delete_ctx(test_ctx);\n8093\t        test_ctx = NULL;\n8094\t    }\n8095\t\n8096\t    return ret;\n8097\t}\n8098\t\n8099\tint key_rotation_stress_test(void)\n8100\t{\n8101\t    return key_rotation_stress_test_one(10);\n8102\t}\n8103\t\n8104\t\n8105\t/*\n8106\t * False migration. Test that the client server connection resists injection of\n8107\t * some packets sent from a wrong address. The \"false migration inject\" acts as\n8108\t * a misbehaving NAT. The expectation is that the server will ignore handshake\n8109\t * packets from a wrong origin, and that the connection will recover from\n8110\t * false packet injection during the data phase.\n8111\t */\n8112\t\n8113\tint false_migration_inject(picoquic_test_tls_api_ctx_t* test_ctx, int target_client, picoquic_packet_context_enum false_pc, uint64_t simulated_time)\n8114\t{\n8115\t\n8116\t    /* In order to test robustness of key rotation against attacks, we inject a\n8117\t     * random packet with properly set header indication transition */\n8118\t    int ret = 0;\n8119\t    picoquic_cnx_t * cnx = (target_client) ? test_ctx->cnx_client : test_ctx->cnx_server;\n8120\t    picoquictest_sim_link_t* target_link = (target_client) ? test_ctx->c_to_s_link : test_ctx->s_to_c_link;\n8121\t    picoquictest_sim_packet_t* sim_packet = picoquictest_sim_link_create_packet();\n8122\t    picoquic_packet_t* packet = NULL;\n8123\t\n8124\t    if (cnx == NULL) {\n8125\t        return -1;\n8126\t    }\n8127\t\n8128\t    packet = picoquic_create_packet(cnx->quic);\n8129\t\n8130\t    if (sim_packet == NULL || packet == NULL || cnx == NULL) {\n8131\t        if (sim_packet != NULL) {\n8132\t            free(sim_packet);\n8133\t        }\n8134\t        if (packet != NULL) {\n8135\t            picoquic_recycle_packet(cnx->quic, packet);\n8136\t        }\n8137\t        ret = -1;\n8138\t    }\n8139\t    else {\n8140\t        struct sockaddr_in false_address;\n8141\t        size_t checksum_overhead = 8;\n8142\t        uint32_t header_length = 0;\n8143\t        size_t length = 0;\n8144\t        picoquic_epoch_enum epoch;\n8145\t        picoquic_path_t * path_x = cnx->path[0];\n8146\t\n8147\t        switch (false_pc) {\n8148\t        case picoquic_packet_context_application:\n8149\t            packet->ptype = picoquic_packet_1rtt_protected;\n8150\t            epoch = picoquic_epoch_1rtt;\n8151\t            break;\n8152\t        case picoquic_packet_context_handshake:\n8153\t            packet->ptype = picoquic_packet_handshake;\n8154\t            epoch = picoquic_epoch_handshake;\n8155\t            break;\n8156\t        case picoquic_packet_context_initial:\n8157\t        default:\n8158\t            packet->ptype = picoquic_packet_initial;\n8159\t            epoch = picoquic_epoch_initial;\n8160\t            break;\n8161\t        }\n8162\t\n8163\t        if (target_client) {\n8164\t            memcpy(&false_address, &test_ctx->client_addr, sizeof(false_address));\n8165\t        }\n8166\t        else {\n8167\t            memcpy(&false_address, &test_ctx->server_addr, sizeof(false_address));\n8168\t        }\n8169\t        false_address.sin_port += 1234;\n8170\t\n8171\t\n8172\t        checksum_overhead = picoquic_get_checksum_length(cnx, epoch);\n8173\t        packet->checksum_overhead = checksum_overhead;\n8174\t        packet->pc = false_pc;\n8175\t        length = checksum_overhead + 32;\n8176\t        memset(packet->bytes, 0, length);\n8177\t\n8178\t        picoquic_finalize_and_protect_packet(cnx, packet,\n8179\t            ret, length, header_length, checksum_overhead,\n8180\t            &sim_packet->length, sim_packet->bytes, PICOQUIC_MAX_PACKET_SIZE,\n8181\t            path_x, simulated_time);\n8182\t\n8183\t        picoquic_store_addr(&sim_packet->addr_from, (struct sockaddr *)&false_address);\n8184\t\n8185\t        if (target_client) {\n8186\t            picoquic_store_addr(&sim_packet->addr_to, (struct sockaddr *)&test_ctx->server_addr);\n8187\t        }\n8188\t        else {\n8189\t            picoquic_store_addr(&sim_packet->addr_to, (struct sockaddr *)&test_ctx->client_addr);\n8190\t        }\n8191\t\n8192\t        picoquictest_sim_link_submit(target_link, sim_packet, simulated_time);\n8193\t    }\n8194\t\n8195\t    return ret;\n8196\t}\n8197\t\n8198\tint false_migration_test_scenario(test_api_stream_desc_t * scenario, size_t size_of_scenario, int target_client, picoquic_packet_context_enum false_pc, uint64_t false_rank)\n8199\t{\n8200\t    uint64_t simulated_time = 0;\n8201\t    int nb_injected = 0;\n8202\t    int nb_trials = 0;\n8203\t    int nb_inactive = 0;\n8204\t    picoquic_test_tls_api_ctx_t* test_ctx = NULL;\n8205\t    int ret = tls_api_init_ctx(&test_ctx, PICOQUIC_INTERNAL_TEST_VERSION_1,\n8206\t        PICOQUIC_TEST_SNI, PICOQUIC_TEST_ALPN, &simulated_time, NULL, NULL, 0, 0, 0);\n8207\t\n8208\t    if (ret == 0 && test_ctx == NULL) {\n8209\t        ret = PICOQUIC_ERROR_MEMORY;\n8210\t    }\n8211\t\n8212\t    /* Run a connection loop with injection test */\n8213\t    if (ret == 0) {\n8214\t\n8215\t        while (ret == 0 && nb_trials < 1024 && nb_inactive < 512 && (!TEST_CLIENT_READY || (test_ctx->cnx_server == NULL || !TEST_SERVER_READY))) {\n8216\t            int was_active = 0;\n8217\t            nb_trials++;\n8218\t\n8219\t            if (nb_injected == 0) {\n8220\t                if ((target_client && test_ctx->cnx_client->pkt_ctx[false_pc].send_sequence > false_rank && test_ctx->cnx_client->path[0]->first_tuple->p_remote_cnxid->cnx_id.id_len != 0) ||\n8221\t                    (!target_client && test_ctx->cnx_server != NULL && test_ctx->cnx_server->pkt_ctx[false_pc].send_sequence > false_rank)) {\n8222\t                    /* Inject a spoofed packet in the context */\n8223\t                    ret = false_migration_inject(test_ctx, target_client, false_pc, simulated_time);\n8224\t                    if (ret == 0) {\n8225\t                        nb_injected++;\n8226\t                    }\n8227\t                    else\n8228\t                    {\n8229\t                        DBG_PRINTF(\"Could not inject false packet, ret = %x\\n\", ret);\n8230\t                    }\n8231\t                }\n8232\t            }\n8233\t\n8234\t            ret = tls_api_one_sim_round(test_ctx, &simulated_time, 0, &was_active);\n8235\t\n8236\t            if (test_ctx->cnx_client->cnx_state == picoquic_state_disconnected &&\n8237\t                (test_ctx->cnx_server == NULL || test_ctx->cnx_server->cnx_state == picoquic_state_disconnected)) {\n8238\t                break;\n8239\t            }\n8240\t\n8241\t            if (was_active) {\n8242\t                nb_inactive = 0;\n8243\t            }\n8244\t            else {\n8245\t                nb_inactive++;\n8246\t            }\n8247\t        }\n8248\t    }\n8249\t\n8250\t    /* Prepare to send data */\n8251\t    if (ret == 0) {\n8252\t        ret = test_api_init_send_recv_scenario(test_ctx, scenario, size_of_scenario);\n8253\t    }\n8254\t\n8255\t    /* Perform a data sending loop */\n8256\t    nb_trials = 0;\n8257\t    nb_inactive = 0;\n8258\t\n8259\t    /* Perform a data sending loop, during which various key rotations are tried\n8260\t     * every 100 packets or so. To test robustness, inject bogus packets that\n8261\t     * mimic a transition trigger */\n8262\t\n8263\t    while (ret == 0 && nb_trials < 1024 && nb_inactive < 256 && TEST_CLIENT_READY && TEST_SERVER_READY) {\n8264\t        int was_active = 0;\n8265\t\n8266\t        nb_trials++;\n8267\t\n8268\t        if (nb_injected == 0) {\n8269\t            if ((target_client && test_ctx->cnx_client->pkt_ctx[false_pc].send_sequence > false_rank) ||\n8270\t                (!target_client && test_ctx->cnx_server != NULL && test_ctx->cnx_server->pkt_ctx[false_pc].send_sequence > false_rank)) {\n8271\t                /* Inject a spoofed packet in the context */\n8272\t                ret = false_migration_inject(test_ctx, target_client, false_pc, simulated_time);\n8273\t                if (ret == 0) {\n8274\t                    nb_injected++;\n8275\t                }\n8276\t                else\n8277\t                {\n8278\t                    DBG_PRINTF(\"Could not inject false packet, ret = %x\\n\", ret);\n8279\t                }\n8280\t            }\n8281\t        }\n8282\t\n8283\t        if (ret == 0) {\n8284\t            ret = tls_api_one_sim_round(test_ctx, &simulated_time, 0, &was_active);\n8285\t        }\n8286\t\n8287\t        if (ret < 0)\n8288\t        {\n8289\t            break;\n8290\t        }\n8291\t\n8292\t        if (was_active) {\n8293\t            nb_inactive = 0;\n8294\t        }\n8295\t        else {\n8296\t            nb_inactive++;\n8297\t        }\n8298\t\n8299\t        if (test_ctx->test_finished) {\n8300\t            if (picoquic_is_cnx_backlog_empty(test_ctx->cnx_client) && picoquic_is_cnx_backlog_empty(test_ctx->cnx_server)) {\n8301\t                break;\n8302\t            }\n8303\t        }\n8304\t    }\n8305\t    if (ret == 0 && nb_injected == 0) {\n8306\t        DBG_PRINTF(\"Could not inject after packet #%d in context %d\\n\", (int)false_rank, (int)false_pc);\n8307\t        ret = -1;\n8308\t    }\n8309\t\n8310\t    if (ret == 0) {\n8311\t        ret = tls_api_attempt_to_close(test_ctx, &simulated_time);\n8312\t\n8313\t        if (ret != 0)\n8314\t        {\n8315\t            DBG_PRINTF(\"Connection close returns %d\\n\", ret);\n8316\t        }\n8317\t    }\n8318\t\n8319\t    if (test_ctx != NULL) {\n8320\t        tls_api_delete_ctx(test_ctx);\n8321\t        test_ctx = NULL;\n8322\t    }\n8323\t\n8324\t    return ret;\n8325\t}\n8326\t\n8327\tint false_migration_test(void)\n8328\t{\n8329\t    int ret = 0;\n8330\t    int target_client;\n8331\t\n8332\t    for (target_client = 1; ret == 0 && target_client >= 0; target_client--) {\n8333\t        ret = false_migration_test_scenario(test_scenario_q2_and_r2, sizeof(test_scenario_q2_and_r2), target_client, picoquic_packet_context_initial, 0);\n8334\t        \n8335\t        if (ret == 0) {\n8336\t            ret = false_migration_test_scenario(test_scenario_q2_and_r2, sizeof(test_scenario_q2_and_r2), target_client, picoquic_packet_context_handshake, 0);\n8337\t        }\n8338\t\n8339\t        for (uint64_t seq = 0; ret == 0 && seq < 4; seq++) {\n8340\t            ret = false_migration_test_scenario(test_scenario_q2_and_r2, sizeof(test_scenario_q2_and_r2), target_client, picoquic_packet_context_application, seq);\n8341\t        }\n8342\t    }\n8343\t\n8344\t    return ret;\n8345\t}\n8346\t\n8347\t/*\n8348\t* Testing what happens in case of NAT rebinding during handshake.\n8349\t* In theory, it may cause the handshake to fail, but in practice it does\n8350\t* not...\n8351\t*/\n8352\t\n8353\tint nat_handshake_test_one(int test_rank)\n8354\t{\n8355\t    uint64_t simulated_time = 0;\n8356\t    uint64_t loss_mask = 0;\n8357\t    int nb_inactive = 0;\n8358\t    int nb_trials = 0;\n8359\t    int natted = 0;\n8360\t    picoquic_test_tls_api_ctx_t* test_ctx = NULL;\n8361\t    int ret = tls_api_init_ctx(&test_ctx, PICOQUIC_INTERNAL_TEST_VERSION_1,\n8362\t        PICOQUIC_TEST_SNI, PICOQUIC_TEST_ALPN, &simulated_time, NULL, NULL, 0, 0, 0);\n8363\t\n8364\t    if (ret == 0 && test_ctx == NULL) {\n8365\t        ret = PICOQUIC_ERROR_MEMORY;\n8366\t    }\n8367\t\n8368\t    /* Run a connection loop with rebinding test */\n8369\t    if (ret == 0) {\n8370\t\n8371\t        while (ret == 0 && nb_trials < 1024 && nb_inactive < 512 && (!TEST_CLIENT_READY || (test_ctx->cnx_server == NULL || !TEST_SERVER_READY))) {\n8372\t            int was_active = 0;\n8373\t            nb_trials++;\n8374\t\n8375\t            if (natted == 0) {\n8376\t                int should_nat = 0;\n8377\t\n8378\t                switch (test_rank) {\n8379\t                case 0: /* check that at least one packet was received from the server, setting the CNX_ID */\n8380\t                    should_nat = (test_ctx->cnx_client->path[0]->first_tuple->p_remote_cnxid->cnx_id.id_len > 0);\n8381\t                    break;\n8382\t                case 1: /* Check that the connection is almost complete, but finished has not been sent */\n8383\t                    should_nat = (test_ctx->cnx_client->crypto_context[3].aead_decrypt != NULL);\n8384\t                    break;\n8385\t                default:\n8386\t                    break;\n8387\t                }\n8388\t                if (should_nat) {\n8389\t                    /* Simulate a NAT rebinding */\n8390\t                    test_ctx->client_addr_natted = test_ctx->client_addr;\n8391\t                    test_ctx->client_addr_natted.sin_port += 17;\n8392\t                    test_ctx->client_use_nat = 1;\n8393\t                    natted++;\n8394\t                }\n8395\t            }\n8396\t\n8397\t            ret = tls_api_one_sim_round(test_ctx, &simulated_time, 0, &was_active);\n8398\t\n8399\t            if (test_ctx->cnx_client->cnx_state == picoquic_state_disconnected ||\n8400\t                (test_ctx->cnx_server != NULL && test_ctx->cnx_server->cnx_state == picoquic_state_disconnected)) {\n8401\t                break;\n8402\t            }\n8403\t\n8404\t            if (was_active) {\n8405\t                nb_inactive = 0;\n8406\t            }\n8407\t            else {\n8408\t                nb_inactive++;\n8409\t            }\n8410\t        }\n8411\t    }\n8412\t\n8413\t    /* Prepare to send data */\n8414\t    if (ret == 0) {\n8415\t        ret = test_api_init_send_recv_scenario(test_ctx, test_scenario_q2_and_r2, sizeof(test_scenario_q2_and_r2));\n8416\t    }\n8417\t\n8418\t    /* Try send data */\n8419\t    if (ret == 0) {\n8420\t        ret = tls_api_data_sending_loop(test_ctx, &loss_mask, &simulated_time, 0);\n8421\t    }\n8422\t\n8423\t    if (ret == 0) {\n8424\t        ret = tls_api_attempt_to_close(test_ctx, &simulated_time);\n8425\t\n8426\t        if (ret != 0)\n8427\t        {\n8428\t            DBG_PRINTF(\"Connection close returns %d\\n\", ret);\n8429\t        }\n8430\t    }\n8431\t\n8432\t    /* verify that the connection did change address */\n8433\t    if (ret == 0 && !natted) {\n8434\t        DBG_PRINTF(\"Connection succeeded after %d natting in handshake, rank %d\\n\", natted, test_rank);\n8435\t        ret = -1;\n8436\t    }\n8437\t\n8438\t    if (test_ctx != NULL) {\n8439\t        tls_api_delete_ctx(test_ctx);\n8440\t        test_ctx = NULL;\n8441\t    }\n8442\t\n8443\t\n8444\t    return ret;\n8445\t}\n8446\t\n8447\tint nat_handshake_test(void)\n8448\t{\n8449\t    int ret = 0;\n8450\t\n8451\t    for (int test_rank = 0; ret == 0 && test_rank < 2; test_rank++) {\n8452\t        ret = nat_handshake_test_one(test_rank);\n8453\t    }\n8454\t\n8455\t    return ret;\n8456\t}\n8457\t\n8458\t/*\n8459\t * Verify that connection attempts with a too-short CID are rejected.\n8460\t */\n8461\tstatic int short_initial_cid_test_one(uint8_t cid_length)\n8462\t{\n8463\t    uint64_t simulated_time = 0;\n8464\t    uint64_t loss_mask = 0;\n8465\t    picoquic_test_tls_api_ctx_t* test_ctx = NULL;\n8466\t    int ret = tls_api_init_ctx(&test_ctx, 0, PICOQUIC_TEST_SNI, PICOQUIC_TEST_ALPN, &simulated_time, NULL, NULL, 0, 0, 0);\n8467\t\n8468\t    if (ret == 0 && test_ctx == NULL) {\n8469\t        ret = -1;\n8470\t    }\n8471\t\n8472\t    /* Delete the client context, and recreate with a short CID */\n8473\t    if (ret == 0)\n8474\t    {\n8475\t        picoquic_connection_id_t init_cid;\n8476\t\n8477\t        for (unsigned int i = 0; i < cid_length; i++) {\n8478\t            init_cid.id[i] = (uint8_t)(i + 1);\n8479\t        }\n8480\t        init_cid.id_len = cid_length;\n8481\t\n8482\t        if (test_ctx->cnx_client != NULL) {\n8483\t            picoquic_delete_cnx(test_ctx->cnx_client);\n8484\t            test_ctx->cnx_client = NULL;\n8485\t        }\n8486\t\n8487\t        test_ctx->cnx_client = picoquic_create_cnx(test_ctx->qclient, init_cid,\n8488\t            picoquic_null_connection_id,\n8489\t            (struct sockaddr*)&test_ctx->server_addr, 0,\n8490\t            0, PICOQUIC_TEST_SNI, PICOQUIC_TEST_ALPN, 1);\n8491\t\n8492\t        if (test_ctx->cnx_client == NULL) {\n8493\t            ret = -1;\n8494\t        }\n8495\t        else {\n8496\t            ret = picoquic_start_client_cnx(test_ctx->cnx_client);\n8497\t        }\n8498\t    }\n8499\t\n8500\t    /* Proceed with the connection loop. */\n8501\t    if (ret == 0) {\n8502\t        ret = tls_api_connection_loop(test_ctx, &loss_mask, 0, &simulated_time);\n8503\t    }\n8504\t\n8505\t    /* Check that both the client and server are ready. */\n8506\t    if (ret == 0 && TEST_CLIENT_READY) {\n8507\t        if (cid_length < PICOQUIC_ENFORCED_INITIAL_CID_LENGTH) {\n8508\t            DBG_PRINTF(\"Connection succeeds despites cid_length %d < %d\\n\",\n8509\t                cid_length, PICOQUIC_ENFORCED_INITIAL_CID_LENGTH);\n8510\t            ret = -1;\n8511\t        }\n8512\t    }\n8513\t    else if (cid_length > PICOQUIC_ENFORCED_INITIAL_CID_LENGTH) {\n8514\t        DBG_PRINTF(\"Connection fails despites cid_length %d >= %d\\n\",\n8515\t            cid_length, PICOQUIC_ENFORCED_INITIAL_CID_LENGTH);\n8516\t        if (ret == 0) {\n8517\t            ret = -1;\n8518\t        }\n8519\t    }\n8520\t    else if (cid_length < PICOQUIC_ENFORCED_INITIAL_CID_LENGTH) {\n8521\t        ret = 0;\n8522\t    }\n8523\t\n8524\t    if (test_ctx != NULL) {\n8525\t        tls_api_delete_ctx(test_ctx);\n8526\t        test_ctx = NULL;\n8527\t    }\n8528\t\n8529\t    return ret;\n8530\t}\n8531\t\n8532\tint short_initial_cid_test(void)\n8533\t{\n8534\t    int ret = 0;\n8535\t    for (uint8_t i = 4; ret == 0 && i < 18; i++) {\n8536\t        ret = short_initial_cid_test_one(i);\n8537\t    }\n8538\t\n8539\t    return ret;\n8540\t}\n8541\t\n8542\t/*\n8543\t * Test whether the number of open streams is properly enforced\n8544\t */\n8545\t\n8546\tint stream_id_max_test(void)\n8547\t{\n8548\t    picoquic_tp_t test_parameters;\n8549\t\n8550\t    memset(&test_parameters, 0, sizeof(picoquic_tp_t));\n8551\t\n8552\t    picoquic_init_transport_parameters(&test_parameters);\n8553\t    test_parameters.initial_max_stream_id_bidir = 4;\n8554\t\n8555\t    return tls_api_one_scenario_test(test_scenario_many_streams, sizeof(test_scenario_many_streams), 0, 0, 0, 0, 0, 250000, NULL, &test_parameters);\n8556\t}\n8557\t\n8558\t/*\n8559\t * Test whether padding policy is correctly applied, and whether the corresponding\n8560\t * connection succeeds.\n8561\t */\n8562\tsize_t padding_test_predict_pn_length(picoquic_packet_context_t * pkt_ctx)\n8563\t{\n8564\t    /* Predict acceptable length of packet number */\n8565\t    size_t pn_l = 4;\n8566\t    int64_t delta = (pkt_ctx->send_sequence==0)?0: pkt_ctx->send_sequence-1;\n8567\t    if (pkt_ctx->pending_first != NULL) {\n8568\t        delta -= pkt_ctx->pending_first->sequence_number;\n8569\t    }\n8570\t    if (delta < 262144) {\n8571\t        pn_l = 3;\n8572\t        if (pkt_ctx->send_sequence < 1024) {\n8573\t            pn_l = 2;\n8574\t            if (pkt_ctx->send_sequence < 16) {\n8575\t                pn_l = 1;\n8576\t            }\n8577\t        }\n8578\t    }\n8579\t    return pn_l;\n8580\t}\n8581\t\n8582\tint padding_test_one(uint32_t padding_multiple, uint32_t padding_min_size)\n8583\t{\n8584\t    uint64_t simulated_time = 0;\n8585\t    uint64_t loss_mask = 0;\n8586\t    picoquic_test_tls_api_ctx_t* test_ctx = NULL;\n8587\t    int ret = tls_api_init_ctx(&test_ctx, PICOQUIC_INTERNAL_TEST_VERSION_1, PICOQUIC_TEST_SNI, PICOQUIC_TEST_ALPN, &simulated_time, NULL, NULL, 0, 1, 0);\n8588\t    uint8_t data[PICOQUIC_MAX_PACKET_SIZE];\n8589\t    const size_t test_sizes[] = { 1, 2, 3, 5, 8, 13, 21, 44, 65, 109, 174, 283, 457, 740, 1023 };\n8590\t    const size_t nb_test_sizes = sizeof(test_sizes) / sizeof(size_t);\n8591\t\n8592\t    if (ret == 0 && test_ctx == NULL) {\n8593\t        ret = -1;\n8594\t    }\n8595\t\n8596\t    /* Set the padding policy in the server context and in the client connection\n8597\t     */\n8598\t    if (ret == 0) {\n8599\t        picoquic_set_default_padding(test_ctx->qserver, padding_multiple, padding_min_size);\n8600\t        picoquic_cnx_set_padding_policy(test_ctx->cnx_client, padding_multiple, padding_min_size);\n8601\t        ret = picoquic_start_client_cnx(test_ctx->cnx_client);\n8602\t    }\n8603\t\n8604\t    /* start the connection */\n8605\t    if (ret == 0) {\n8606\t        ret = tls_api_connection_loop(test_ctx, &loss_mask, 0, &simulated_time);\n8607\t    }\n8608\t\n8609\t    if (ret == 0) {\n8610\t        size_t checksum_length = picoquic_get_checksum_length(test_ctx->cnx_client, picoquic_epoch_1rtt);\n8611\t        size_t pn_iv_length = picoquic_pn_iv_size(test_ctx->cnx_client->crypto_context[picoquic_epoch_1rtt].pn_enc);\n8612\t\n8613\t        for (size_t i = 0; ret == 0 && i < nb_test_sizes; i++) {\n8614\t            /* repeat: queue a packet of size X, wait until it is acknowledged.\n8615\t             * verify that the padding is as expected.\n8616\t             */\n8617\t            int nb_trials = 0;\n8618\t            int nb_inactive = 0;\n8619\t            int is_queued = 0;\n8620\t            int is_success = 0;\n8621\t\n8622\t            memset(data, picoquic_frame_type_padding, test_sizes[i] - 1);\n8623\t            data[test_sizes[i] - 1] = picoquic_frame_type_ping;\n8624\t\n8625\t            while (ret == 0 && nb_trials < 256 && nb_inactive < 256 && TEST_CLIENT_READY && TEST_SERVER_READY) {\n8626\t                int was_active = 0;\n8627\t\n8628\t                nb_trials++;\n8629\t                if ((picoquic_is_cnx_backlog_empty(test_ctx->cnx_client) && picoquic_is_cnx_backlog_empty(test_ctx->cnx_server) &&\n8630\t                    test_ctx->c_to_s_link->first_packet == NULL && test_ctx->s_to_c_link->first_packet == NULL)) {\n8631\t                    if (!is_queued) {\n8632\t                        ret = picoquic_queue_misc_frame(test_ctx->cnx_client, data, test_sizes[i], 0, picoquic_packet_context_application);\n8633\t                        is_queued = 1;\n8634\t                    }\n8635\t                    else {\n8636\t                        is_success = 1;\n8637\t                        break;\n8638\t                    }\n8639\t                }\n8640\t                ret = tls_api_one_sim_round(test_ctx, &simulated_time, 0, &was_active);\n8641\t\n8642\t                if (ret == 0 && is_queued && test_ctx->c_to_s_link->first_packet != NULL) {\n8643\t                    size_t length = test_ctx->c_to_s_link->first_packet->length;\n8644\t                    size_t pn_offset = 1 + test_ctx->cnx_client->path[0]->first_tuple->p_remote_cnxid->cnx_id.id_len;\n8645\t                    size_t pn_length = padding_test_predict_pn_length(&test_ctx->cnx_client->pkt_ctx[picoquic_packet_context_application]);\n8646\t                    size_t raw_length = pn_offset + pn_length + test_sizes[i];\n8647\t\n8648\t                    if (pn_length == 1 && raw_length + checksum_length > length) {\n8649\t                        /* Too short for this length.\n8650\t                         * The test depends on correct prediction of pn length, which is hard, so\n8651\t                         * we only do it if the predicted  pn_length is 1 */\n8652\t                        ret = -1;\n8653\t                    }\n8654\t                    else if (pn_offset + 4 + pn_iv_length > length) {\n8655\t                        /* Not enough length to fit the data */\n8656\t                        ret = -1;\n8657\t                    }\n8658\t                    else if (padding_multiple == 0 && padding_min_size == 0) {\n8659\t                        /* No padding. The size should be equal to either the natural size of the minimum valid,\n8660\t                         * unless the stack queued an acknowledgement, which would add 5 or 6 bytes */\n8661\t                        if (raw_length + checksum_length + 6 < length && pn_offset + 4 + pn_iv_length != length) {\n8662\t                            ret = -1;\n8663\t                        }\n8664\t                    }\n8665\t                    else if (padding_min_size != 0 && length < padding_min_size) {\n8666\t                        /* Size should be at least min size */\n8667\t                        ret = -1;\n8668\t                    }\n8669\t                    else if (padding_min_size != 0 &&\n8670\t                        raw_length  < padding_min_size &&\n8671\t                        length != padding_min_size + checksum_length) {\n8672\t                        /* too much padding */\n8673\t                        ret = -1;\n8674\t                    }\n8675\t                    else if (padding_multiple != 0){\n8676\t                        if ((length - padding_min_size - checksum_length) % padding_multiple != 0 &&\n8677\t                            length != test_ctx->cnx_client->path[0]->send_mtu) {\n8678\t                            /* padding does not match formula */\n8679\t                            ret = -1;\n8680\t                        }\n8681\t                        else if (raw_length > padding_min_size &&\n8682\t                            ((length - checksum_length) - raw_length) >= padding_multiple) {\n8683\t                            /* Too much padding */\n8684\t                            ret = -1;\n8685\t                        }\n8686\t                    }\n8687\t                }\n8688\t\n8689\t                if (ret < 0)\n8690\t                {\n8691\t                    break;\n8692\t                }\n8693\t\n8694\t                if (was_active) {\n8695\t                    nb_inactive = 0;\n8696\t                }\n8697\t                else {\n8698\t                    nb_inactive++;\n8699\t                }\n8700\t            }\n8701\t\n8702\t            if (ret == 0 && !is_success) {\n8703\t                ret = -1;\n8704\t            }\n8705\t        }\n8706\t    }\n8707\t\n8708\t#if 0\n8709\t    /* Prepare to send data, setting a scenario that creates packets of multiple sizes. */\n8710\t    if (ret == 0) {\n8711\t        ret = test_api_init_send_recv_scenario(test_ctx, test_scenario_many_streams, sizeof(test_scenario_many_streams));\n8712\t    }\n8713\t\n8714\t    if (ret == 0) {\n8715\t        /* do the sending loop until everything is received. */\n8716\t        ret = tls_api_data_sending_loop(test_ctx, NULL, &simulated_time, 0);\n8717\t    }\n8718\t#endif\n8719\t\n8720\t    /* And then free the resource\n8721\t     */\n8722\t\n8723\t    if (test_ctx != NULL) {\n8724\t        tls_api_delete_ctx(test_ctx);\n8725\t        test_ctx = NULL;\n8726\t    }\n8727\t\n8728\t    return ret;\n8729\t}\n8730\t\n8731\tint padding_test(void)\n8732\t{\n8733\t    return padding_test_one(128, 64);\n8734\t}\n8735\t\n8736\tint padding_null_test(void)\n8737\t{\n8738\t    return padding_test_one(0, 0);\n8739\t}\n8740\t\n8741\tint padding_zero_min_test(void)\n8742\t{\n8743\t    return padding_test_one(128, 0);\n8744\t}\n8745\t\n8746\t\n8747\t/*\n8748\t * Test whether the server correctly processes coalesced packets when one of the segments does not decrypt correctly \n8749\t */\n8750\t\n8751\tint bad_coalesce_test(void)\n8752\t{\n8753\t    uint64_t simulated_time = 0;\n8754\t    picoquic_test_tls_api_ctx_t* test_ctx = NULL;\n8755\t    int ret = tls_api_init_ctx(&test_ctx, PICOQUIC_INTERNAL_TEST_VERSION_1, PICOQUIC_TEST_SNI, PICOQUIC_TEST_ALPN, &simulated_time, NULL, NULL, 0, 1, 0);\n8756\t\n8757\t    if (ret == 0 && test_ctx == NULL) {\n8758\t        ret = -1;\n8759\t    }\n8760\t\n8761\t    /* Set the coalescing policy in the test context\n8762\t     */\n8763\t    if (ret == 0) {\n8764\t        test_ctx->do_bad_coalesce_test = 1;\n8765\t\n8766\t        /* Run a basic test scenario\n8767\t         */\n8768\t\n8769\t        ret = tls_api_one_scenario_body(test_ctx, &simulated_time,\n8770\t            test_scenario_q_and_r, sizeof(test_scenario_q_and_r), 0, 0, 0, 0, 250000);\n8771\t    }\n8772\t\n8773\t    /* And then free the resource\n8774\t     */\n8775\t\n8776\t    if (test_ctx != NULL) {\n8777\t        tls_api_delete_ctx(test_ctx);\n8778\t        test_ctx = NULL;\n8779\t    }\n8780\t\n8781\t    return ret;\n8782\t}\n8783\t\n8784\t/*\n8785\t * Bad packet test. The client opens a connection, requests a page, and then only\n8786\t * sends bad 1RTT packets. The test succeeds if the server closes its connection\n8787\t * in a reasonable time. */\n8788\ttypedef struct st_header_fuzzer_ctx_t {\n8789\t    uint64_t random_context;\n8790\t    uint32_t nb_packets;\n8791\t    uint32_t nb_fuzzed;\n8792\t} header_fuzzer_ctx_t;\n8793\t\n8794\tstatic uint32_t header_fuzzer(void* fuzz_ctx, picoquic_cnx_t* cnx,\n8795\t    uint8_t* bytes, size_t bytes_max, size_t length, size_t UNUSED(header_length))\n8796\t{\n8797\t    header_fuzzer_ctx_t* ctx = (header_fuzzer_ctx_t*)fuzz_ctx;\n8798\t\n8799\t    ctx->nb_packets++;\n8800\t\n8801\t    if (cnx->cnx_state >= picoquic_state_client_almost_ready &&\n8802\t        cnx->pkt_ctx[picoquic_packet_context_application].send_sequence > 2) {\n8803\t        uint64_t fuzz_pilot = picoquic_test_random(&ctx->random_context);\n8804\t        \n8805\t        for (size_t i =1; i <= 8 && i < length && i < bytes_max ; i++) {\n8806\t            bytes[i] ^= (uint8_t)fuzz_pilot;\n8807\t            fuzz_pilot >>= 8;\n8808\t        }\n8809\t\n8810\t        ctx->nb_fuzzed++;\n8811\t    }\n8812\t\n8813\t    return (uint32_t)length;\n8814\t}\n8815\t\n8816\tint bad_cnxid_test(void)\n8817\t{\n8818\t    uint64_t simulated_time = 0;\n8819\t    header_fuzzer_ctx_t fuzz_ctx;\n8820\t    picoquic_test_tls_api_ctx_t* test_ctx = NULL;\n8821\t    int ret = tls_api_init_ctx(&test_ctx, PICOQUIC_INTERNAL_TEST_VERSION_1, PICOQUIC_TEST_SNI, PICOQUIC_TEST_ALPN, &simulated_time, NULL, NULL, 0, 1, 0);\n8822\t\n8823\t    memset(&fuzz_ctx, 0, sizeof(fuzz_ctx));\n8824\t    fuzz_ctx.random_context = 0x123456789ABCDEF0ull;\n8825\t\n8826\t    if (ret == 0) {\n8827\t        /* Prepare to send data */\n8828\t        ret = test_api_init_send_recv_scenario(test_ctx, test_scenario_very_long, sizeof(test_scenario_very_long));\n8829\t    }\n8830\t\n8831\t    if (ret == 0) {\n8832\t        /* establish the connection */\n8833\t        ret = tls_api_one_scenario_body_connect(test_ctx, &simulated_time, 0, 0);\n8834\t    }\n8835\t\n8836\t    /* Set fuzzer, then perform a data sending loop */\n8837\t    if (ret == 0) {\n8838\t        picoquic_set_fuzz(test_ctx->qclient, header_fuzzer, &fuzz_ctx);\n8839\t\n8840\t        (void) tls_api_data_sending_loop(test_ctx, NULL, &simulated_time, 0);\n8841\t\n8842\t\n8843\t        /* verify that the server connection has disappeared */\n8844\t        if (fuzz_ctx.nb_fuzzed > 0 && (test_ctx->cnx_server == NULL || test_ctx->cnx_server->cnx_state == picoquic_state_disconnected)) {\n8845\t            ret = 0;\n8846\t        }\n8847\t        else {\n8848\t            DBG_PRINTF(\"Unexpected server state: %d, packet: %d, fuzzed: %d\\n\", test_ctx->cnx_server->cnx_state, \n8849\t                fuzz_ctx.nb_packets, fuzz_ctx.nb_fuzzed);\n8850\t            ret = -1;\n8851\t        }\n8852\t    }\n8853\t\n8854\t    if (ret == 0) {\n8855\t        /* Remove the reference to the old server connection */\n8856\t        test_ctx->cnx_server = NULL;\n8857\t        /* Delete the old client connection */\n8858\t        picoquic_delete_cnx(test_ctx->cnx_client);\n8859\t        test_ctx->cnx_client = NULL;\n8860\t        /* Remove the fuzzer */\n8861\t        picoquic_set_fuzz(test_ctx->qclient, NULL, NULL);\n8862\t        /* re-create a client connection */\n8863\t        test_ctx->cnx_client = picoquic_create_cnx(test_ctx->qclient,\n8864\t            picoquic_null_connection_id, picoquic_null_connection_id,\n8865\t            (struct sockaddr*) & test_ctx->server_addr, simulated_time,\n8866\t            PICOQUIC_INTERNAL_TEST_VERSION_1, PICOQUIC_TEST_SNI, PICOQUIC_TEST_ALPN, 1);\n8867\t        if (test_ctx->cnx_client == NULL) {\n8868\t            DBG_PRINTF(\"%s\", \"Could not create second client connection\\n\");    \n8869\t            ret = -1;\n8870\t        }\n8871\t        else {\n8872\t            for (size_t i = 0; i < test_ctx->nb_test_streams; i++) {\n8873\t                test_api_delete_test_stream(&test_ctx->test_stream[i]);\n8874\t            }\n8875\t            ret = tls_api_one_scenario_body(test_ctx, &simulated_time,\n8876\t                test_scenario_q_and_r, sizeof(test_scenario_q_and_r), 0, 0, 0, 20000, 100000);\n8877\t            if (ret != 0) {\n8878\t                DBG_PRINTF(\"Second connection fails, ret=%d (x%x)\\n\", ret, ret);\n8879\t            }\n8880\t        }\n8881\t    }\n8882\t\n8883\t    if (test_ctx != NULL) {\n8884\t        tls_api_delete_ctx(test_ctx);\n8885\t        test_ctx = NULL;\n8886\t    }\n8887\t\n8888\t    return ret;\n8889\t}\n8890\t\n8891\t\n8892\t/*\n8893\t * Test whether packet tracing works correctly by setting up a basic connection\n8894\t * and verifying that the log file is what we expect.\n8895\t */\n8896\t#ifdef _WINDOWS\n8897\t#define PACKET_TRACE_TEST_REF \"picoquictest\\\\packet_trace_ref.txt\"\n8898\t#else\n8899\t#define PACKET_TRACE_TEST_REF \"picoquictest/packet_trace_ref.txt\"\n8900\t#endif\n8901\t#define PACKET_TRACE_CSV \"packet_trace.csv\"\n8902\t#define PACKET_TRACE_BIN \"ace1020304050607.server.log\"\n8903\t\n8904\tint packet_trace_test(void)\n8905\t{\n8906\t    uint64_t simulated_time = 0;\n8907\t    picoquic_test_tls_api_ctx_t* test_ctx = NULL;\n8908\t    picoquic_connection_id_t initial_cid = { {0xac, 0xe1, 2, 3, 4, 5, 6, 7}, 8 };\n8909\t    int ret = tls_api_init_ctx_ex(&test_ctx, PICOQUIC_INTERNAL_TEST_VERSION_1, PICOQUIC_TEST_SNI, PICOQUIC_TEST_ALPN, &simulated_time, NULL, NULL, 0, 1, 0, &initial_cid);\n8910\t\n8911\t    if (ret == 0 && test_ctx == NULL) {\n8912\t        ret = -1;\n8913\t    }\n8914\t\n8915\t    /* Set the logging policy on the server side, to store data in the\n8916\t     * current working directory, and run a basic test scenario */\n8917\t    if (ret == 0) {\n8918\t        picoquic_set_binlog(test_ctx->qserver, \".\");\n8919\t        picoquic_set_default_lossbit_policy(test_ctx->qserver, picoquic_lossbit_send_receive);\n8920\t        picoquic_set_default_lossbit_policy(test_ctx->qclient, picoquic_lossbit_send_receive);\n8921\t        test_ctx