og(test_ctx->qserver, \".\");\n11292\t        test_ctx->qserver->use_long_log = 1;\n11293\t    }\n11294\t\n11295\t    if (ret == 0 && scenario_id == 1) {\n11296\t        allocated_scenario = heavy_loss_inter_scenario(&scenario_size);\n11297\t        if (allocated_scenario == NULL) {\n11298\t            DBG_PRINTF(\"%s\", \"Could not allocate interactive scenario\");\n11299\t            ret = -1;\n11300\t        }\n11301\t        else {\n11302\t            scenario = allocated_scenario;\n11303\t        }\n11304\t    }\n11305\t\n11306\t    if (ret == 0) {\n11307\t        ret = picoquic_start_client_cnx(test_ctx->cnx_client);\n11308\t    }\n11309\t\n11310\t    if (ret == 0) {\n11311\t        ret = tls_api_connection_loop(test_ctx, &loss_mask, 0, &simulated_time);\n11312\t    }\n11313\t\n11314\t    /* Prepare to send data */\n11315\t    if (ret == 0) {\n11316\t        ret = test_api_init_send_recv_scenario(test_ctx, scenario, scenario_size);\n11317\t    }\n11318\t\n11319\t    /* Send for 0.1 second, in order to ramp up transfer speed */\n11320\t    if (ret == 0) {\n11321\t        ret = tls_api_wait_for_timeout(test_ctx, &simulated_time, 100000);\n11322\t    }\n11323\t\n11324\t    /* Send for up to 30 seconds, with 50% packet loss rate.\n11325\t     * Stop earlier if something breaks, or if all the required\n11326\t     * data is sent.\n11327\t     * In scenario 2, simulate \"total loss\".\n11328\t     */\n11329\t    if (ret == 0) {\n11330\t        loss_mask = (scenario_id == 2)?UINT64_MAX:0x13596ac77ca69531ull;\n11331\t        for (int i = 0; ret == 0 && !test_ctx->test_finished && i < 20; i++) {\n11332\t            ret = tls_api_wait_for_timeout(test_ctx, &simulated_time, 1000000);\n11333\t        }\n11334\t    }\n11335\t\n11336\t    /* Stop losing packets, try to complete the data sending loop */\n11337\t    if (ret == 0) {\n11338\t        loss_mask = 0;\n11339\t        ret = tls_api_data_sending_loop(test_ctx, &loss_mask, &simulated_time, 0);\n11340\t    }\n11341\t\n11342\t    /* verify that the transmission was complete */\n11343\t    if (ret == 0) {\n11344\t        ret = tls_api_one_scenario_body_verify(test_ctx, &simulated_time, completion_target);\n11345\t    }\n11346\t\n11347\t    if (test_ctx != NULL) {\n11348\t        tls_api_delete_ctx(test_ctx);\n11349\t        test_ctx = NULL;\n11350\t    }\n11351\t\n11352\t    if (allocated_scenario != NULL) {\n11353\t        free(allocated_scenario);\n11354\t    }\n11355\t\n11356\t    return ret;\n11357\t}\n11358\t\n11359\tint heavy_loss_test(void)\n11360\t{\n11361\t    return heavy_loss_test_one(0, 23500000);\n11362\t}\n11363\t\n11364\tint heavy_loss_inter_test(void)\n11365\t{\n11366\t    return heavy_loss_test_one(1, 22000000);\n11367\t}\n11368\t\n11369\tint heavy_loss_total_test(void)\n11370\t{\n11371\t    return heavy_loss_test_one(2, 25000000);\n11372\t}\n11373\t\n11374\t\n11375\t\n11376\tint integrity_limit_test(void)\n11377\t{\n11378\t    uint64_t simulated_time = 0;\n11379\t    uint64_t loss_mask = 0;\n11380\t    int nb_initial_loop = 0;\n11381\t    picoquic_test_tls_api_ctx_t* test_ctx = NULL;\n11382\t    picoquic_connection_id_t initial_cid = { {0x15, 0x4E, 0x98, 0x14, 0, 0, 0, 1}, 8 };\n11383\t    int ret = tls_api_init_ctx_ex(&test_ctx, PICOQUIC_INTERNAL_TEST_VERSION_1,\n11384\t        PICOQUIC_TEST_SNI, PICOQUIC_TEST_ALPN, &simulated_time, NULL, NULL, 0, 0, 0, &initial_cid);\n11385\t\n11386\t    if (ret == 0 && test_ctx == NULL) {\n11387\t        ret = -1;\n11388\t    }\n11389\t\n11390\t    if (ret == 0) {\n11391\t        picoquic_set_qlog(test_ctx->qserver, \".\");\n11392\t        ret = tls_api_connection_loop(test_ctx, &loss_mask, 0, &simulated_time);\n11393\t    }\n11394\t\n11395\t    /* Prepare to send data */\n11396\t    if (ret == 0) {\n11397\t        ret = test_api_init_send_recv_scenario(test_ctx, test_scenario_very_long, sizeof(test_scenario_very_long));\n11398\t    }\n11399\t\n11400\t    /* Perform a data sending loop for a few rounds after the ready state */\n11401\t    while (ret == 0 && nb_initial_loop < 64) {\n11402\t        if (test_ctx->cnx_server != NULL && \n11403\t            test_ctx->cnx_server->crypto_context[picoquic_epoch_1rtt].aead_decrypt != NULL) {\n11404\t            nb_initial_loop++;\n11405\t        }\n11406\t\n11407\t        ret = tls_api_data_sending_loop(test_ctx, &loss_mask, &simulated_time, 16);\n11408\t    }\n11409\t\n11410\t    /* Check the max length of an epoch is the expected value */\n11411\t    if (ret == 0) {\n11412\t        uint64_t limit = picoquic_aead_confidentiality_limit(test_ctx->cnx_server->crypto_context[picoquic_epoch_1rtt].aead_decrypt);\n11413\t\n11414\t        if (test_ctx->cnx_server->crypto_epoch_length_max != limit) {\n11415\t            DBG_PRINTF(\"Server confidentiality limit set to 0x%\" PRIx64 \", insted of %\" PRIx64,\n11416\t                test_ctx->cnx_server->crypto_epoch_length_max, limit);\n11417\t            ret = -1;\n11418\t        } else if (test_ctx->cnx_client->crypto_epoch_length_max != limit) {\n11419\t            DBG_PRINTF(\"Client confidentiality limit set to 0x%\" PRIx64 \", insted of %\" PRIx64,\n11420\t                test_ctx->cnx_client->crypto_epoch_length_max, limit);\n11421\t            ret = -1;\n11422\t        }\n11423\t    }\n11424\t\n11425\t\n11426\t    /* Set the number of failed decryptions just below the limit and then send a bad packet  */\n11427\t    if (ret == 0 && test_ctx->cnx_server != NULL) {\n11428\t        uint8_t p[256];\n11429\t\n11430\t        test_ctx->cnx_server->crypto_failure_count = picoquic_aead_integrity_limit(\n11431\t            test_ctx->cnx_server->crypto_context[picoquic_epoch_1rtt].aead_decrypt);\n11432\t\n11433\t        memset(p, 0, sizeof(p));\n11434\t        memcpy(p + 1, test_ctx->cnx_server->path[0]->first_tuple->p_local_cnxid->cnx_id.id, test_ctx->cnx_server->path[0]->first_tuple->p_local_cnxid->cnx_id.id_len);\n11435\t        p[0] |= 64;\n11436\t        (void)picoquic_incoming_packet(test_ctx->qserver, p, sizeof(p), (struct sockaddr*) & test_ctx->cnx_server->path[0]->first_tuple->peer_addr,\n11437\t            (struct sockaddr*) & test_ctx->cnx_server->path[0]->first_tuple->local_addr, 0, test_ctx->recv_ecn_server, simulated_time);\n11438\t\n11439\t        if (test_ctx->cnx_server->cnx_state != picoquic_state_disconnecting) {\n11440\t            DBG_PRINTF(\"Connection not disconnecting, limit 0x%\" PRIx64 \", reached %\" PRIx64,\n11441\t                test_ctx->cnx_server->crypto_context[picoquic_epoch_1rtt].aead_decrypt,\n11442\t                test_ctx->cnx_server->crypto_failure_count);\n11443\t            ret = -1;\n11444\t        }\n11445\t        else if (test_ctx->cnx_server->local_error != PICOQUIC_TRANSPORT_AEAD_LIMIT_REACHED) {\n11446\t            DBG_PRINTF(\"Wrong error code, 0x%x instead of 0x%x\",\n11447\t                test_ctx->cnx_server->local_error,\n11448\t                PICOQUIC_TRANSPORT_AEAD_LIMIT_REACHED);\n11449\t            ret = -1;\n11450\t        }\n11451\t    }\n11452\t\n11453\t    if (test_ctx != NULL) {\n11454\t        tls_api_delete_ctx(test_ctx);\n11455\t        test_ctx = NULL;\n11456\t    }\n11457\t\n11458\t    return ret;\n11459\t}\n11460\t\n11461\t/* Excess repeat test.\n11462\t * start a big transfer, then kill the client. Check how many packets the server sends\n11463\t * before giving up. Fail if too many.\n11464\t * Repeat for all supported congestion control algorithms */\n11465\t\n11466\tint excess_repeat_test_one(picoquic_congestion_algorithm_t* cc_algo, int repeat_target)\n11467\t{\n11468\t    const uint64_t test_latency = 30000;\n11469\t    const uint64_t picosec_100mbps = 80000;\n11470\t    const int nb_loops_max = 3000;\n11471\t    uint64_t simulated_time = 0;\n11472\t    uint64_t loss_mask = 0;\n11473\t    int nb_initial_loop = 0;\n11474\t    int nb_repeated = 0;\n11475\t    picoquic_test_tls_api_ctx_t* test_ctx = NULL;\n11476\t    picoquic_connection_id_t initial_cid = { {0xe8, 0xce, 0x55, 0, 0, 0, 0, 0}, 8 };\n11477\t    int ret;\n11478\t    \n11479\t    initial_cid.id[7] = cc_algo->congestion_algorithm_number;\n11480\t    ret = tls_api_init_ctx_ex(&test_ctx, PICOQUIC_INTERNAL_TEST_VERSION_1,\n11481\t        PICOQUIC_TEST_SNI, PICOQUIC_TEST_ALPN, &simulated_time, NULL, NULL, 0, 0, 0, &initial_cid);\n11482\t\n11483\t    if (ret == 0 && test_ctx == NULL) {\n11484\t        ret = -1;\n11485\t    }\n11486\t\n11487\t    if (ret == 0) {\n11488\t        /* Set long delays, 1 Mbps each way */\n11489\t        test_ctx->c_to_s_link->microsec_latency = test_latency;\n11490\t        test_ctx->c_to_s_link->picosec_per_byte = picosec_100mbps;\n11491\t        test_ctx->s_to_c_link->microsec_latency = test_latency;\n11492\t        test_ctx->s_to_c_link->picosec_per_byte = picosec_100mbps;\n11493\t        /* Set the CC algorithm to selected value */\n11494\t        picoquic_set_default_congestion_algorithm(test_ctx->qserver, cc_algo);\n11495\t        /* set qlog */\n11496\t        picoquic_set_qlog(test_ctx->qserver, \".\");\n11497\t        /* initial connection */\n11498\t        ret = tls_api_connection_loop(test_ctx, &loss_mask, 0, &simulated_time);\n11499\t    }\n11500\t\n11501\t    /* Prepare to send data */\n11502\t    if (ret == 0) {\n11503\t        ret = test_api_init_send_recv_scenario(test_ctx, test_scenario_very_long, sizeof(test_scenario_very_long));\n11504\t    }\n11505\t\n11506\t    /* Perform a data sending loop for a few rounds after the ready state */\n11507\t    while (ret == 0 && nb_initial_loop < 64) {\n11508\t        if (test_ctx->cnx_server != NULL && test_ctx->cnx_client->cnx_state >= picoquic_state_ready){\n11509\t            nb_initial_loop++;\n11510\t        }\n11511\t\n11512\t        ret = tls_api_data_sending_loop(test_ctx, &loss_mask, &simulated_time, 16);\n11513\t    }\n11514\t\n11515\t    /* Now, simulate that the client has gone away, and count the packets */\n11516\t    if (ret == 0) {\n11517\t        picoquictest_sim_packet_t* packet = picoquictest_sim_link_create_packet();\n11518\t        int if_index = 0;\n11519\t        picoquic_connection_id_t log_cid;\n11520\t        picoquic_cnx_t* last_cnx;\n11521\t        uint64_t max_disconnected_time = simulated_time + 30000000;\n11522\t        int nb_loops = 0;\n11523\t\n11524\t        if (cc_algo->congestion_algorithm_number == PICOQUIC_CC_ALGO_NUMBER_DCUBIC ||\n11525\t            cc_algo->congestion_algorithm_number == PICOQUIC_CC_ALGO_NUMBER_FAST) {\n11526\t            repeat_target = 200;\n11527\t        }\n11528\t\n11529\t        if (packet == NULL) {\n11530\t            ret = -1;\n11531\t        }\n11532\t        else {\n11533\t            while (ret == 0 &&\n11534\t                test_ctx->qserver->current_number_connections > 0 &&\n11535\t                test_ctx->cnx_server != NULL &&\n11536\t                test_ctx->cnx_server->cnx_state != picoquic_state_disconnected) {\n11537\t                uint64_t old_time = simulated_time;\n11538\t                uint64_t delta_t;\n11539\t\n11540\t                simulated_time = picoquic_get_next_wake_time(test_ctx->qserver, simulated_time);\n11541\t                delta_t = simulated_time - old_time;\n11542\t                if (delta_t > 3000000) {\n11543\t                    DBG_PRINTF(\"Large delta t=%\" PRIu64, delta_t);\n11544\t                    ret = -1;\n11545\t                    break;\n11546\t                }\n11547\t                if (simulated_time > max_disconnected_time) {\n11548\t                    DBG_PRINTF(\"Timeout too at t=%\" PRIu64 \", Delta_t=%\" PRIu64,\n11549\t                        simulated_time, delta_t);\n11550\t                    ret = -1;\n11551\t                    break;\n11552\t                }\n11553\t                else {\n11554\t                    ret = picoquic_prepare_next_packet(test_ctx->qserver, simulated_time,\n11555\t                        packet->bytes, sizeof(packet->bytes), &packet->length,\n11556\t                        &packet->addr_to, &packet->addr_from, &if_index, &log_cid, &last_cnx);\n11557\t                    if (ret == 0 && packet->length > 0) {\n11558\t                        nb_repeated++;\n11559\t                        if (nb_repeated > repeat_target) {\n11560\t                            DBG_PRINTF(\"Stop test for cc=%s stopped after %d repeats, t=%\" PRIu64,\n11561\t                                cc_algo->congestion_algorithm_id, nb_repeated, simulated_time);\n11562\t                            ret = -1;\n11563\t                            break;\n11564\t                        }\n11565\t                    }\n11566\t                }\n11567\t                nb_loops += 1;\n11568\t                if (nb_loops > nb_loops_max) {\n11569\t                    DBG_PRINTF(\"Stop test for cc=%s stopped after %d loops, %d repeats, t=%\" PRIu64,\n11570\t                        cc_algo->congestion_algorithm_id, nb_loops, nb_repeated, simulated_time);\n11571\t                    ret = -1;\n11572\t                    break;\n11573\t                }\n11574\t\n11575\t            }\n11576\t            if (ret == 0) {\n11577\t                DBG_PRINTF(\"Test for cc=%s passes after %d loops, %d repeats, t=%\" PRIu64,\n11578\t                    cc_algo->congestion_algorithm_id, nb_loops, nb_repeated, simulated_time);\n11579\t            }\n11580\t\n11581\t            free(packet);\n11582\t        }\n11583\t    }\n11584\t\n11585\t    /* Delete the context */\n11586\t    if (test_ctx != NULL) {\n11587\t        tls_api_delete_ctx(test_ctx);\n11588\t    }\n11589\t\n11590\t    return ret;\n11591\t}\n11592\t\n11593\tint excess_repeat_test(void)\n11594\t{\n11595\t    const int nb_repeat_max = 128;\n11596\t\n11597\t    picoquic_congestion_algorithm_t* algo_list[6] = {\n11598\t        picoquic_newreno_algorithm,\n11599\t        picoquic_cubic_algorithm,\n11600\t        picoquic_dcubic_algorithm,\n11601\t        picoquic_fastcc_algorithm,\n11602\t        picoquic_bbr_algorithm,\n11603\t        picoquic_prague_algorithm\n11604\t    };\n11605\t    int ret = 0;\n11606\t\n11607\t    for (int i = 0; i < 6 && ret == 0; i++) {\n11608\t        ret = excess_repeat_test_one(algo_list[i], nb_repeat_max);\n11609\t        if (ret != 0) {\n11610\t            DBG_PRINTF(\"Excess repeat test fails for CC=%s\", algo_list[i]->congestion_algorithm_id);\n11611\t        }\n11612\t    }\n11613\t\n11614\t    return ret;\n11615\t}\n11616\t\n11617\t/* Connection DDOS\n11618\t* Simulate attack on server by sending tons of connection requests. See\n11619\t* what happens.\n11620\t*/\n11621\t\n11622\tint cnx_ddos_test_loop(int nb_connections, uint64_t ddos_interval, const char* qlogdir)\n11623\t{\n11624\t    uint64_t simulated_time = 0;\n11625\t    uint64_t ddos_time = 0;\n11626\t    int nb_ddos_done = 0;\n11627\t    int nb_sent = 0;\n11628\t    int if_index = 0;\n11629\t    int still_sending = 0;\n11630\t    picoquic_connection_id_t log_cid;\n11631\t    picoquic_cnx_t* last_cnx;\n11632\t    picoquic_quic_t* qddos = picoquic_create(100, NULL, NULL, NULL, PICOQUIC_TEST_ALPN, NULL, NULL,\n11633\t        NULL, NULL, NULL, 0, &simulated_time, NULL, NULL, 0);\n11634\t    picoquic_test_tls_api_ctx_t* test_ctx = NULL;\n11635\t    uint64_t start_wall_time;\n11636\t    uint64_t elapsed_wall_time;\n11637\t    picoquictest_sim_packet_t* packet = picoquictest_sim_link_create_packet();\n11638\t    picoquictest_sim_packet_t* ddos_packet_first = NULL;\n11639\t    int ret = tls_api_init_ctx_ex2(&test_ctx, PICOQUIC_INTERNAL_TEST_VERSION_1,\n11640\t        PICOQUIC_TEST_SNI, PICOQUIC_TEST_ALPN, &simulated_time, NULL, NULL, 0, 0, 0, NULL, 10000, 0, 0, 0);\n11641\t    uint32_t max_number_cnx_ctx = 0;\n11642\t\n11643\t    if (ret == 0 && (test_ctx == NULL || packet == NULL || qddos == NULL)) {\n11644\t        ret = -1;\n11645\t    }\n11646\t\n11647\t    if (ret == 0 && qlogdir != NULL && strcmp(\"-\", qlogdir) != 0) {\n11648\t        picoquic_set_qlog(test_ctx->qserver, qlogdir);\n11649\t    }\n11650\t\n11651\t    /* Create a list of nb_connections initial packets. We do this before running the\n11652\t     * DDOS, so the time to create the attack is not counted in the \"wall time\" of\n11653\t     * the server under attacks. */\n11654\t    for (int i = 0; ret == 0 && i < nb_connections; i++) {\n11655\t        picoquictest_sim_packet_t* ddos_packet = picoquictest_sim_link_create_packet();\n11656\t        if (ddos_packet == NULL) {\n11657\t            DBG_PRINTF(\"Could not create dos packet #%d\", i + 1);\n11658\t            ret = -1;\n11659\t        }\n11660\t        else {\n11661\t            picoquic_cnx_t* ddos_cnx = NULL;\n11662\t\n11663\t            ddos_packet->next_packet = ddos_packet_first;\n11664\t            ddos_packet_first = ddos_packet;\n11665\t\n11666\t            ddos_cnx = picoquic_create_cnx(qddos, picoquic_null_connection_id, picoquic_null_connection_id,\n11667\t                (struct sockaddr*)&test_ctx->server_addr, simulated_time, 0, PICOQUIC_TEST_SNI,\n11668\t                PICOQUIC_TEST_ALPN, 1);\n11669\t            if (ddos_cnx == NULL) {\n11670\t                DBG_PRINTF(\"Cannot create ddos cnx #%d\", nb_ddos_done);\n11671\t                ret = -1;\n11672\t            }\n11673\t            else if ((ret = picoquic_start_client_cnx(ddos_cnx)) != 0) {\n11674\t                DBG_PRINTF(\"Cannot create ddos cnx #%d\", nb_ddos_done);\n11675\t                ret = -1;\n11676\t            }\n11677\t            else if ((ret = picoquic_prepare_next_packet(qddos, simulated_time,\n11678\t                ddos_packet->bytes, sizeof(ddos_packet->bytes), &ddos_packet->length,\n11679\t                &ddos_packet->addr_to, &ddos_packet->addr_from, &if_index, &log_cid, &last_cnx)) != 0 ||\n11680\t                ddos_packet->length == 0) {\n11681\t                DBG_PRINTF(\"Cannot create ddos initial #%d, ret = 0x%x\", nb_ddos_done, ret);\n11682\t                ret = -1;\n11683\t            }\n11684\t            else {\n11685\t                picoquic_set_test_address((struct sockaddr_in*)&packet->addr_from,\n11686\t                    0x0a010000 + nb_ddos_done, 0x8421);\n11687\t            }\n11688\t\n11689\t            if (ddos_cnx != NULL) {\n11690\t                picoquic_delete_cnx(ddos_cnx);\n11691\t            }\n11692\t        }\n11693\t    }\n11694\t    if (ret == 0) {\n11695\t        DBG_PRINTF(\"Created %d ddos initial packets\", nb_connections);\n11696\t    }\n11697\t\n11698\t    start_wall_time = picoquic_current_time();\n11699\t    while (ret == 0 && (ddos_packet_first != NULL || still_sending)) {\n11700\t        uint64_t next_time = picoquic_get_next_wake_time(test_ctx->qserver, simulated_time);\n11701\t\n11702\t        still_sending = 0;\n11703\t\n11704\t        if (test_ctx->qserver->current_number_connections > max_number_cnx_ctx) {\n11705\t            max_number_cnx_ctx = test_ctx->qserver->current_number_connections;\n11706\t        }\n11707\t\n11708\t        if (next_time < ddos_time) {\n11709\t            simulated_time = next_time;\n11710\t\n11711\t            ret = picoquic_prepare_next_packet(test_ctx->qserver, simulated_time,\n11712\t                packet->bytes, sizeof(packet->bytes), &packet->length,\n11713\t                &packet->addr_to, &packet->addr_from, &if_index, &log_cid, &last_cnx);\n11714\t            if (ret != 0) {\n11715\t                DBG_PRINTF(\"Server error after #%d ddos, ret = 0x%x\", nb_ddos_done, ret);\n11716\t                ret = -1;\n11717\t            }\n11718\t            else if (packet->length > 0) {\n11719\t                nb_sent++;\n11720\t                still_sending = 1;\n11721\t            }\n11722\t        }\n11723\t        else if (ddos_packet_first != NULL) {\n11724\t            picoquictest_sim_packet_t* ddos_packet = ddos_packet_first;\n11725\t            ddos_packet_first = ddos_packet->next_packet;\n11726\t\n11727\t            simulated_time = ddos_time;\n11728\t            nb_ddos_done++;\n11729\t\n11730\t            if (nb_ddos_done >= nb_connections) {\n11731\t                ddos_time = UINT64_MAX;\n11732\t            }\n11733\t            else {\n11734\t                ddos_time += ddos_interval;\n11735\t            }\n11736\t\n11737\t            ret = picoquic_incoming_packet(test_ctx->qserver, ddos_packet->bytes, ddos_packet->length,\n11738\t                (struct sockaddr*)&ddos_packet->addr_from, (struct sockaddr*)&ddos_packet->addr_to,\n11739\t                if_index, 0, simulated_time);\n11740\t            still_sending = 1;\n11741\t            if (ret != 0) {\n11742\t                DBG_PRINTF(\"Server chokes on initial #%d, ret = 0x%x\", nb_ddos_done, ret);\n11743\t            }\n11744\t\n11745\t            free(ddos_packet);\n11746\t        }\n11747\t    }\n11748\t\n11749\t    elapsed_wall_time = picoquic_current_time() - start_wall_time;\n11750\t\n11751\t    if (ret == 0) {\n11752\t        if (max_number_cnx_ctx > test_ctx->qserver->max_half_open_before_retry) {\n11753\t            DBG_PRINTF(\"Too many connection context, up to %d instead of at most %d\",\n11754\t                max_number_cnx_ctx, test_ctx->qserver->max_half_open_before_retry);\n11755\t            ret = -1;\n11756\t        }\n11757\t\n11758\t        DBG_PRINTF(\"Simulation succeeds at t=%\" PRIu64 \", spent: %\" PRIu64 \", sent: %d\",\n11759\t            simulated_time, elapsed_wall_time, nb_sent);\n11760\t    }\n11761\t\n11762\t    /* TODO: run a simulated connection to verify that the context is operational */\n11763\t    if (ret == 0) {\n11764\t        /* Get rid of the connection if one was created in the context */\n11765\t        if (test_ctx->cnx_client != NULL) {\n11766\t            (void)picoquic_delete_cnx(test_ctx->cnx_client);\n11767\t            test_ctx->cnx_client = NULL;\n11768\t        }\n11769\t        /* re-create a client connection, this time picking up the correct start time */\n11770\t        test_ctx->cnx_client = picoquic_create_cnx(test_ctx->qclient,\n11771\t            picoquic_null_connection_id, picoquic_null_connection_id,\n11772\t            (struct sockaddr*)&test_ctx->server_addr, simulated_time,\n11773\t            PICOQUIC_INTERNAL_TEST_VERSION_1, PICOQUIC_TEST_SNI, PICOQUIC_TEST_ALPN, 1);\n11774\t\n11775\t        ret = tls_api_one_scenario_body(test_ctx, &simulated_time,\n11776\t            test_scenario_q2_and_r2, sizeof(test_scenario_q2_and_r2), 0, 0x00004281, 0, 20000, 2000000);\n11777\t\n11778\t        if (ret == 0) {\n11779\t            DBG_PRINTF(\"Post DDOS connection succeeds at t=%\" PRIu64 \", spent: %\" PRIu64 \", sent: %d\",\n11780\t                simulated_time, elapsed_wall_time, nb_sent);\n11781\t        }\n11782\t    }\n11783\t\n11784\t    /* Delete the context and other fields. */\n11785\t    if (packet != NULL) {\n11786\t        free(packet);\n11787\t    }\n11788\t\n11789\t    if (qddos != NULL) {\n11790\t        picoquic_free(qddos);\n11791\t    }\n11792\t\n11793\t    while (ddos_packet_first != NULL) {\n11794\t        picoquictest_sim_packet_t* ddos_packet = ddos_packet_first;\n11795\t        ddos_packet_first = ddos_packet->next_packet;\n11796\t        free(ddos_packet);\n11797\t    }\n11798\t\n11799\t    if (test_ctx != NULL) {\n11800\t        tls_api_delete_ctx(test_ctx);\n11801\t    }\n11802\t\n11803\t    return ret;\n11804\t}\n11805\t\n11806\tint cnx_ddos_unit_test(void)\n11807\t{\n11808\t    return cnx_ddos_test_loop(1000, 1000, NULL);\n11809\t}\n11810\t\n11811\t/* Test sending various malformed CHello packets to the server.\n11812\t* \n11813\t* We first reproduced an issue signalled by email:\n11814\t* What I changed from a normal connection establishment: I sent the curve X25519 as the\n11815\t* ECDHE group in the Supported Groups Extension and Key Share Extension in the client hello,\n11816\t* but formated the elliptic curve point in the secp256r1 format: 0x04<32B X-coordinate><32B Y-coordinate>.\n11817\t* \n11818\t* Tested with the picoquicdemo server from picoquic 1.1.33.2 in the default configuration,\n11819\t* compiled with the \"-DPICOQUIC_FETCH_PTLS=Y\" flag. \n11820\t* \n11821\t*/\n11822\t\n11823\tstatic uint8_t chello_malformed[] = {\n11824\t    0x01, /* Client Hello */\n11825\t    0x00, 0x01, 0x19, /* L= 281 */\n11826\t    0x03, 0x03, /* version = 0x0303 */\n11827\t    0xe2, 0xc9, 0x8d, 0x67, 0xe6, 0x60, 0xeb, 0x1f,\n11828\t    0xe4, 0xbc, 0xa6, 0x19, 0x14, 0xac, 0x86, 0x1a,\n11829\t    0xf7, 0xb1, 0xa1, 0x8d, 0xd5, 0x59, 0xe9, 0x19,\n11830\t    0x20, 0xd2, 0xee, 0xd3, 0xa5, 0x04, 0x2e, 0xa2, /* Random 32 */\n11831\t    0x00, /* length of legacy version = 0 */\n11832\t    0x00, 0x06, /* Length of cipher suites = 6 */\n11833\t        0x13, 0x01, /* TLS_AES_128_GCM_SHA256 */\n11834\t        0x13, 0x02, /* TLS_AES_256_GCM_SHA384 */\n11835\t        0x13, 0x03, /* TLS_CHACHA20_POLY1305_SHA256  */\n11836\t    0x01, 0x00, /* opaque legacy_compression_methods, l=1, v[1] = 0 */\n11837\t    0x00, 0xea, /* Extension length = 234 */\n11838\t        0x00, 0x33, /* Key share extension(51) */\n11839\t        0x00, 0x47, /* Key share group */\n11840\t        0x00, 0x45, /* Key share entry */\n11841\t            0x00, 0x1d, /* Named group, should be secp256r1, 0x0017, but we are using x25519(0x001D), keeping the secp format! */\n11842\t            0x00, 0x41, /* key exchange length = 65 */\n11843\t            0x04, /* legacy form */\n11844\t            0x1e, 0x93, 0x9a, 0x4a, 0x38, 0x62, 0xf3, 0xd9,\n11845\t            0x23, 0x68, 0x25, 0x5d, 0x63, 0x01, 0xcb, 0xcc,\n11846\t            0x73, 0xa0, 0x7e, 0x3c, 0xf2, 0x23, 0xab, 0x0e,\n11847\t            0x5a, 0x3e, 0x65, 0x50, 0x8b, 0xcb, 0x21, 0xe3, /* X, 32 bytes */\n11848\t            0x7b, 0x6f, 0xb7, 0x13, 0xaf, 0x3d, 0x0b, 0x8a,\n11849\t            0x5e, 0xb3, 0x13, 0x59, 0xda, 0x73, 0x24, 0xbf,\n11850\t            0x69, 0xf1, 0x4f, 0x64, 0x7e, 0x04, 0xad, 0x6d,\n11851\t            0x4d, 0xdb, 0x99, 0x0f, 0xc9, 0x20, 0x8d, 0xdc, /* Y, 32 bytes */\n11852\t    0x00, 0x00, /* Server name extension (0) */\n11853\t    0x00, 0x15, /* Server name extension length length (21) */\n11854\t        0x00, 0x13, /* Server name struct (19) */\n11855\t        0x00, /* Name type: host name(0) */\n11856\t        0x00, 0x10, /* name length (16) */\n11857\t        0x74, 0x65, 0x73, 0x74, 0x2e, /* test. */\n11858\t        0x65, 0x78, 0x61, 0x6d, 0x70, 0x6c, 0x65, /* example */\n11859\t        0x2e, 0x63, 0x6f, 0x6d, /* .com */\n11860\t    0x00, 0x10, /* Extension application_layer_protocol_negotiation(16) */\n11861\t        0x00, 0x10, /* ALPN extension length (16) */\n11862\t        0x00, 0x0e, /* Protocol name list length (14) */\n11863\t        0x0d, /* name length (13) */\n11864\t        0x70, 0x69, 0x63, 0x6f, 0x71, 0x75, 0x69, 0x63, 0x2d, 0x74, 0x65, 0x73, 0x74, /* picoquic-test */\n11865\t    0x00, 0x2b, /* extension: supported_versions(43) */\n11866\t        0x00, 0x03, /* supported_versions length(3) */\n11867\t        0x02, /* Length of version (2) */\n11868\t        0x03, 0x04, /* TLS 1.3 = 0x0304 */\n11869\t    0x00, 0x0d, /* Extension signature_algorithms(13) */\n11870\t    0x00, 0x10, /* signature_algorithms extension length (16) */\n11871\t        0x00, 0x0e, /* length of algorithm list (14) -- 7 algorithms */\n11872\t        0x08, 0x07, /* ed25519(0x0807), */\n11873\t        0x04, 0x03, /* ecdsa_secp256r1_sha256(0x0403), */\n11874\t        0x05, 0x03, /* ecdsa_secp384r1_sha384(0x0503), */\n11875\t        0x06, 0x03, /* ecdsa_secp521r1_sha512(0x0603), */\n11876\t        0x08, 0x06, /* rsa_pss_rsae_sha512(0x0806), */\n11877\t        0x08, 0x05, /* rsa_pss_rsae_sha384(0x0805), */\n11878\t        0x08, 0x04, /* rsa_pss_rsae_sha256(0x0804), */\n11879\t    0x00, 0x0a, /* extension supported_groups(10), */\n11880\t    0x00, 0x06, /* length of supported_groups extension(6) */\n11881\t        0x00, 0x04, /* length of list of supported_groups extension(4) -- 2 groups. We place x25519 first */\n11882\t        0x00, 0x1d, /* x25519(0x001D), */\n11883\t        0x00, 0x17, /* secp256r1(0x0017) */\n11884\t    0xff, 0xa5, /* extension type 0xffa5 (draft version of QUIc extensions) */\n11885\t    0x00, 0x49, /* quic extension length 73 */\n11886\t    0x05, 0x04, 0x80, 0x20, 0x00, 0x00, 0x04, 0x04,\n11887\t    0x80, 0x10, 0x00, 0x00, 0x08, 0x02, 0x42, 0x00,\n11888\t    0x01, 0x04, 0x80, 0x00, 0x75, 0x30, 0x03, 0x02,\n11889\t    0x45, 0xa0, 0x09, 0x02, 0x42, 0x00, 0x06, 0x04,\n11890\t    0x80, 0x01, 0x00, 0x63, 0x07, 0x04, 0x80, 0x00,\n11891\t    0xff, 0xff, 0x0e, 0x01, 0x08, 0x0b, 0x01, 0x0a,\n11892\t    0x0f, 0x08, 0x0e, 0xa0, 0xd8, 0xd8, 0x54, 0x9e,\n11893\t    0x27, 0x43, 0x50, 0x57, 0x01, 0x01, 0xc0, 0x00,\n11894\t    0x00, 0x00, 0xff, 0x04, 0xde, 0x1b, 0x02, 0x43,\n11895\t    0xe8,\n11896\t};\n11897\t\n11898\tint bad_chello_fill_initial(picoquic_quic_t * quic, uint8_t *buffer, size_t buffer_size, uint8_t * chello,  size_t chello_length)\n11899\t{\n11900\t    int ret = 0;\n11901\t    picoquic_connection_id_t icid;\n11902\t    picoquic_connection_id_t scid;\n11903\t    void* aead_ctx = NULL;\n11904\t    void* pn_enc_ctx = NULL;\n11905\t    size_t length = 0;\n11906\t    size_t header_length = 0;\n11907\t    size_t pn_offset = 0;\n11908\t    size_t pn_length = 0;\n11909\t    uint8_t first_mask = 0x0f;\n11910\t    uint8_t* bytes = buffer;\n11911\t    uint8_t* bytes_max = buffer + buffer_size - 16;\n11912\t\n11913\t    /* Prepare initial and source CID */\n11914\t    icid.id_len = 8;\n11915\t    picoquic_public_random(icid.id, 8);\n11916\t    scid.id_len = quic->local_cnxid_length;\n11917\t    picoquic_public_random(scid.id, scid.id_len);\n11918\t    /* format the initial header */\n11919\t    header_length = picoquic_create_long_header(\n11920\t        picoquic_packet_initial,\n11921\t        &icid,\n11922\t        &scid,\n11923\t        0, /* Do grease bit */\n11924\t        picoquic_supported_versions[0].version,\n11925\t        0, /* version_index */\n11926\t        0, /* sequence_number */\n11927\t        0, /* retry_token_length */\n11928\t        NULL, /* retry_token */\n11929\t        buffer,\n11930\t        &pn_offset,\n11931\t        &pn_length);\n11932\t    /* Format the payload, i.e. the chello encoded as a crypto stream data */\n11933\t    bytes += header_length;\n11934\t    if ((bytes = picoquic_frames_uint8_encode(bytes, bytes_max, picoquic_frame_type_crypto_hs)) != NULL &&\n11935\t        (bytes = picoquic_frames_varint_encode(bytes, bytes_max, 0)) != NULL &&\n11936\t        (bytes = picoquic_frames_length_data_encode(bytes, bytes_max, chello_length, chello)) != NULL) {\n11937\t        length = bytes - buffer;\n11938\t        picoquic_update_payload_length(buffer, pn_offset, header_length - pn_length,\n11939\t            length + 16);\n11940\t    }\n11941\t    else {\n11942\t        ret = -1;\n11943\t    }\n11944\t    if (ret == 0) {\n11945\t        /* create an encryption context */\n11946\t        if ((ret = picoquic_get_initial_aead_context(quic, 0, &icid,\n11947\t            1 /* is_client=1 */, 1 /* is_enc = 1 */, &aead_ctx, &pn_enc_ctx)) == 0) {\n11948\t            /* encrypt the payload. */\n11949\t            size_t send_length = picoquic_aead_encrypt_generic(buffer + /* header_length */ header_length,\n11950\t                buffer + header_length, length - header_length,\n11951\t                0, buffer, header_length, aead_ctx);\n11952\t            send_length += header_length;\n11953\t            /* Next, encrypt the PN -- The sample is located after the pn_offset */\n11954\t            picoquic_protect_packet_header(buffer, pn_offset, first_mask, pn_enc_ctx);\n11955\t            /* Fill the packet to specified length */\n11956\t            memset(buffer + send_length, 0, buffer_size - send_length);\n11957\t        }\n11958\t        /* Free the encryption contexts if allocated */\n11959\t        if (aead_ctx != NULL) {\n11960\t            /* Free the AEAD CTX */\n11961\t            picoquic_aead_free(aead_ctx);\n11962\t        }\n11963\t\n11964\t        if (pn_enc_ctx != NULL) {\n11965\t            /* Free the PN encryption context */\n11966\t            picoquic_cipher_free(pn_enc_ctx);\n11967\t        }\n11968\t    }\n11969\t\n11970\t    return ret;\n11971\t}\n11972\t\n11973\tint bad_chello_test(void)\n11974\t{\n11975\t    picoquic_test_tls_api_ctx_t* test_ctx = NULL;\n11976\t    uint64_t simulated_time = 0;\n11977\t    picoquic_connection_id_t icid = { { 0xba, 0xdc, 0xe1, 0x10, 0, 0, 0, 0}, 8 };\n11978\t    int ret = tls_api_init_ctx_ex2(&test_ctx, PICOQUIC_INTERNAL_TEST_VERSION_1,\n11979\t        PICOQUIC_TEST_SNI, PICOQUIC_TEST_ALPN, &simulated_time, NULL, NULL, 0, 1, 0, &icid, 10000, 0, 0, 0);\n11980\t    uint8_t buffer[PICOQUIC_ENFORCED_INITIAL_MTU];\n11981\t    \n11982\t\n11983\t    if (ret == 0 && test_ctx == NULL) {\n11984\t        ret = -1;\n11985\t    }\n11986\t    else {\n11987\t        picoquic_set_qlog(test_ctx->qserver, \".\");\n11988\t        /* Create an initial packet with a bad chello */\n11989\t        ret = bad_chello_fill_initial(test_ctx->qserver, buffer, PICOQUIC_ENFORCED_INITIAL_MTU, chello_malformed, sizeof(chello_malformed));\n11990\t    }\n11991\t\n11992\t    /* Submit the packet to the server context */\n11993\t    if (ret == 0) {\n11994\t        picoquic_cnx_t* cnx_trial = NULL;\n11995\t        ret = picoquic_incoming_packet_ex(test_ctx->qserver, buffer, PICOQUIC_ENFORCED_INITIAL_MTU,\n11996\t            (struct sockaddr*)&test_ctx->client_addr, (struct sockaddr*)&test_ctx->server_addr, 0,\n11997\t            0, &cnx_trial, simulated_time);\n11998\t        if (cnx_trial != NULL) {\n11999\t            DBG_PRINTF(\"Bad chello caused context creation at t=%\" PRIu64, simulated_time);"}]},"parent_tool_use_id":"toolu_01Rt4pELUTT189iuGyrewME6","session_id":"782f2f02-5f93-4f6f-b663-2ef2c783a0cf","uuid":"ec2e3eab-4473-434e-974e-c29e0aa0874e","timestamp":"2026-05-05T12:37:46.036Z"}
