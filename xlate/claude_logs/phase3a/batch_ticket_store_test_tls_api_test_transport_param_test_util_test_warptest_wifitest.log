icoquic_cnx_t* cnx, int spoof_mode, uint8_t * packet, size_t packet_length)\n2743\t{\n2744\t    size_t packet_index = 0;\n2745\t    picoquic_connection_id_t bad_cid = { {0xba, 0xdc, 0x1d, 0, 0, 0, 0, 0}, 8 };\n2746\t    uint32_t this_vn = picoquic_supported_versions[cnx->version_index].version;\n2747\t    uint32_t random_vn = 0xa5a6a7a8 ^ (this_vn & 0x0f0f0f0f);\n2748\t    /* First byte for long header packet */\n2749\t    if (packet_index < packet_length) {\n2750\t        packet[packet_index++] = (uint8_t)(spoof_mode | 0x80);\n2751\t    }\n2752\t    /* version value 0 */\n2753\t    if (packet_index + 4 < packet_length) {\n2754\t        picoformat_32(&packet[packet_index], 0);\n2755\t        packet_index += 4;\n2756\t    }\n2757\t    /* DCID */\n2758\t    if (packet_index + 1 < packet_length) {\n2759\t        if (spoof_mode == 1) {\n2760\t            packet[packet_index++] = bad_cid.id_len;\n2761\t            packet_index += picoquic_format_connection_id(&packet[packet_index], packet_length - packet_index, bad_cid);\n2762\t        }\n2763\t        else {\n2764\t            packet[packet_index++] = cnx->path[0]->first_tuple->p_local_cnxid->cnx_id.id_len;\n2765\t            packet_index += picoquic_format_connection_id(&packet[packet_index], packet_length - packet_index, cnx->path[0]->first_tuple->p_local_cnxid->cnx_id);\n2766\t        }\n2767\t    }\n2768\t    /* SCID */\n2769\t    if (packet_index + 1 < packet_length) {\n2770\t        if (spoof_mode == 2) {\n2771\t            packet[packet_index++] = bad_cid.id_len;\n2772\t            packet_index += picoquic_format_connection_id(&packet[packet_index], packet_length - packet_index, bad_cid);\n2773\t        }\n2774\t        else {\n2775\t            packet[packet_index++] = cnx->initial_cnxid.id_len;\n2776\t            packet_index += picoquic_format_connection_id(&packet[packet_index], packet_length - packet_index, cnx->initial_cnxid);\n2777\t        }\n2778\t    }\n2779\t    /* Encode the proposed versions */\n2780\t    if (spoof_mode != 3) {\n2781\t        if (packet_index + 4 < packet_length) {\n2782\t            picoformat_32(&packet[packet_index], random_vn);\n2783\t            packet_index += 4;\n2784\t        }\n2785\t        if (packet_index + 4 < packet_length) {\n2786\t            uint32_t plausible_vn = 0xffffffff;\n2787\t            if (spoof_mode == 4) {\n2788\t                plausible_vn = this_vn;\n2789\t            }\n2790\t            else if (spoof_mode == 5) {\n2791\t                plausible_vn = this_vn;\n2792\t            }\n2793\t            else if (spoof_mode != 6 && picoquic_nb_supported_versions > 1) {\n2794\t                size_t plausible_index = picoquic_nb_supported_versions - 1;\n2795\t                if ((size_t)cnx->version_index == plausible_index) {\n2796\t                    plausible_index = 0;\n2797\t                }\n2798\t                plausible_vn = picoquic_supported_versions[plausible_index].version;\n2799\t            }\n2800\t            picoformat_32(&packet[packet_index], plausible_vn);\n2801\t            packet_index += 4;\n2802\t        }\n2803\t        if (spoof_mode == 7 && packet_index < packet_length) {\n2804\t            packet[packet_index++] = 0xaf;\n2805\t        }\n2806\t    }\n2807\t\n2808\t    return packet_index;\n2809\t}\n2810\t\n2811\tint test_version_negotiation_spoof_one(int spoof_mode)\n2812\t{\n2813\t    uint64_t simulated_time = 0;\n2814\t    picoquic_test_tls_api_ctx_t* test_ctx = NULL;\n2815\t    int ret = tls_api_init_ctx(&test_ctx, 0, PICOQUIC_TEST_SNI, PICOQUIC_TEST_ALPN, &simulated_time, NULL, NULL, 0, 0, 0);\n2816\t    uint8_t packet[256];\n2817\t    size_t packet_length = 0;\n2818\t    int nb_trials = 0;\n2819\t    int nb_inactive = 0;\n2820\t\n2821\t    /* Do one round of simulation so the client connection moves to initial state */\n2822\t    while (ret == 0 && nb_trials < 1024 && nb_inactive < 512) {\n2823\t        int was_active = 0;\n2824\t        nb_trials++;\n2825\t\n2826\t        ret = tl