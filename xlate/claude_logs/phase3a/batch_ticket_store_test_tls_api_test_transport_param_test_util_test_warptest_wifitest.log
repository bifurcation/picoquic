2372\t            ret = -1;\n2373\t        }\n2374\t    }\n2375\t\n2376\t    if (ret == 0) {\n2377\t        picoquic_set_use_exporter(test_ctx->qclient, 1);\n2378\t        picoquic_set_use_exporter(test_ctx->qserver, 1);\n2379\t    }\n2380\t\n2381\t    if (ret == 0) {\n2382\t        test_ctx->cnx_client = picoquic_create_cnx(test_ctx->qclient, picoquic_null_connection_id,\n2383\t                                                   picoquic_null_connection_id,\n2384\t                                                   (struct sockaddr *)&test_ctx->server_addr, 0, 0,\n2385\t                                                   PICOQUIC_TEST_SNI, PICOQUIC_TEST_ALPN, 1);\n2386\t\n2387\t        if (test_ctx->cnx_client == NULL) {\n2388\t            ret = -1;\n2389\t        }\n2390\t    }\n2391\t\n2392\t    if (ret == 0) {\n2393\t        ret = picoquic_start_client_cnx(test_ctx->cnx_client);\n2394\t    }\n2395\t\n2396\t    if (ret == 0) {\n2397\t        ret = tls_api_connection_loop(test_ctx, &loss_mask, 0, &simulated_time);\n2398\t    }\n2399\t\n2400\t    if (ret == 0) {\n2401\t        const char *label = \"tls api test\";\n2402\t        const size_t export_key_len = 16;\n2403\t        unsigned char client_export_key[16] = { 0 };\n2404\t        unsigned char server_export_key[16] = { 0 };\n2405\t\n2406\t        picoquic_cnx_t *client_cnx = test_ctx->cnx_client;\n2407\t        picoquic_cnx_t *server_cnx = test_ctx->cnx_server;\n2408\t\n2409\t        if (client_cnx == NULL || server_cnx == NULL) {\n2410\t            ret = -1;\n2411\t        }\n2412\t\n2413\t        if (ret == 0) {\n2414\t            int r = picoquic_export_secret(client_cnx, label, client_export_key, export_key_len);\n2415\t            if (r != 0) {\n2416\t                ret = -1;\n2417\t            }\n2418\t        }\n2419\t\n2420\t        if (ret == 0) {\n2421\t            int r = picoquic_export_secret(server_cnx, label, server_export_key, export_key_len);\n2422\t            if (r != 0) {\n2423\t                ret = -1;\n2424\t            }\n2425\t        }\n2426\t\n2427\t        if (ret == 0) {\n2428\t            if (memcmp(client_export_key, server_export_key, export_key_len) != 0) {\n2429\t                ret = -1;\n2430\t            }\n2431\t        }\n2432\t    }\n2433\t\n2434\t    if (test_ctx != NULL) {\n2435\t        tls_api_delete_ctx(test_ctx);\n2436\t    }\n2437\t\n2438\t    return ret;\n2439\t}\n2440\t\n2441\tint tls_api_silence_test(void)\n2442\t{\n2443\t    uint64_t loss_mask = 0;\n2444\t    uint64_t simulated_time = 0;\n2445\t    uint64_t next_time = 0;\n2446\t    picoquic_test_tls_api_ctx_t* test_ctx = NULL;\n2447\t    int ret = tls_api_init_ctx(&test_ctx, 0, PICOQUIC_TEST_SNI, PICOQUIC_TEST_ALPN, &simulated_time, NULL, NULL, 0, 0, 0);\n2448\t\n2449\t    if (ret == 0) {\n2450\t        ret = tls_api_connection_loop(test_ctx, &loss_mask, 0, &simulated_time);\n2451\t    }\n2452\t\n2453\t    /* simulate 5 seconds of silence */\n2454\t    next_time = simulated_time + 5000000;\n2455\t    while (ret == 0 && simulated_time < next_time && TEST_CLIENT_READY && TEST_SERVER_READY) {\n2456\t        int was_active = 0;\n2457\t\n2458\t        ret = tls_api_one_sim_round(test_ctx, &simulated_time, next_time, &was_active);\n2459\t    }\n2460\t\n2461\t    if (ret == 0) {\n2462\t        ret = tls_api_attempt_to_close(test_ctx, &simulated_time);\n2463\t    }\n2464\t\n2465\t    if (ret == 0) {\n2466\t        /* verify the absence of any spurious retransmission */\n2467\t        if (test_ctx->cnx_client->nb_retransmission_total != 0) {\n2468\t            ret = -1;\n2469\t        } else if (test_ctx->cnx_server != NULL && test_ctx->cnx_server->nb_retransmission_total != 0) {\n2470\t            ret = -1;\n2471\t        }\n2472\t    }\n2473\t\n2474\t    if (test_ctx != NULL) {\n2475\t        tls_api_delete_ctx(test_ctx);\n2476\t        test_ctx = NULL;\n2477\t    }\n2478\t\n2479\t    return ret;\n2480\t}\n2481\t\n2482\tint tls_api_loss_test(uint64_t mask)\n2483\t{\n2484\t    uint64_t loss_mask = mask;\n2485\t\n2486\t    return tls_api_test_with_loss(&loss_mask, 0, PICOQUIC_TEST_SNI, PICOQUIC_TEST_ALPN);\n2487\t}\n2488\t\n2489\t/* Test that connection establishment succeeds in presence of many losses */\n2490\tint tls_api_many_losses(void)\n2491\t{\n2492\t    uint64_t loss_mask = 0;\n2493\t    int ret = 0;\n2494\t    uint64_t random_context = 0x1055ca45c001babaull;\n2495\t\n2496\t    /* We first test with a set of preprogrammed masks, checking consecutive drops */\n2497\t    for (int i = 0; ret == 0 && i < 6; i++) {\n2498\t        for (int j = 0; ret == 0 && j < 4; j++) {\n2499\t            uint64_t j_mask = ~(UINT64_MAX << j);\n2500\t            loss_mask = j_mask << i;\n2501\t            ret = tls_api_loss_test(loss_mask);\n2502\t            if (ret != 0) {\n2503\t                DBG_PRINTF(\"Handshake fails for mask %d-%d = %llx\", i, j, (unsigned long long)loss_mask);\n2504\t            }\n2505\t        }\n2506\t        for (uint64_t j = 8; ret == 0 && j < 11; j++) {\n2507\t            loss_mask = (j | (j << 4) | (j << 8))<<i;\n2508\t            ret = tls_api_loss_test(loss_mask);\n2509\t            if (ret != 0) {\n2510\t                DBG_PRINTF(\"Handshake fails for mask %d, %\" PRIu64\" = %llx\", i, j,  (unsigned long long)loss_mask);\n2511\t            }\n2512\t        }\n2513\t    }\n2514\t\n2515\t    /* Then we verify that we can establish 50 connections with packet drop rate=30% */\n2516\t    for (int i = 0; ret == 0 &&  i < 50; i++)\n2517\t    {\n2518\t        uint64_t loss_mask = 0;\n2519\t        for (int j = 0; j < 64; j++)\n2520\t        {\n2521\t            loss_mask <<= 1;\n2522\t\n2523\t            if (picoquic_test_uniform_random(&random_context, 1000) < 300) {\n2524\t                loss_mask |= 1;\n2525\t            }\n2526\t        }\n2527\t\n2528\t        ret = tls_api_one_scenario_test(test_scenario_q_and_r, sizeof(test_scenario_q_and_r), 0, loss_mask, 128000, 0, 0, 0, NULL, NULL);\n2529\t        if (ret != 0) {\n2530\t            DBG_PRINTF(\"Handshake fails for random mask %d, mask = %llx\", i, (unsigned long long)loss_mask);\n2531\t        }\n2532\t    }\n2533\t\n2534\t    return ret;\n2535\t}\n2536\t\n2537\t/* Basic version negotiation.\n2538\t * Verifies that client properly handles a version negotiation packet.\n2539\t */\n2540\t\n2541\tint tls_api_version_negotiation_test(void)\n2542\t{\n2543\t    const uint32_t version_grease = 0x0aca4a0a;\n2544\t    uint64_t simulated_time = 0;\n2545\t    picoquic_test_tls_api_ctx_t* test_ctx = NULL;\n2546\t    int ret = tls_api_init_ctx(&test_ctx, version_grease, PICOQUIC_TEST_SNI, PICOQUIC_TEST_ALPN, &simulated_time, NULL, NULL, 0, 0, 0);\n2547\t\n2548\t    if (ret != 0)\n2549\t    {\n2550\t        DBG_PRINTF(\"Could not create the QUIC test contexts for V=%x\\n\", version_grease);\n2551\t    }\n2552\t\n2553\t    if (ret == 0) {\n2554\t        (void)tls_api_connection_loop(test_ctx, NULL, 0, &simulated_time);\n2555\t\n2556\t        if (test_ctx->cnx_client->cnx_state == picoquic_state_disconnected) {\n2557\t            ret = 0;\n2558\t        }\n2559\t        else {\n2560\t            DBG_PRINTF(\"Unexpected state: %d\\n\", test_ctx->cnx_client->cnx_state);\n2561\t            ret = -1;\n2562\t        }\n2563\t    }\n2564\t\n2565\t\n2566\t    if (ret == 0) {\n2567\t        if (!test_ctx->received_version_negotiation){\n2568\t            DBG_PRINTF(\"%s\", \"No version negotiation notified\\n\");\n2569\t            ret = -1;\n2570\t        }\n2571\t    }\n2572\t\n2573\t    if (test_ctx != NULL) {\n2574\t        tls_api_delete_ctx(test_ctx);\n2575\t        test_ctx = NULL;\n2576\t    }\n2577\t\n2578\t    return ret;\n2579\t}\n2580\t\n2581\t/* Version negotiation invariant test.\n2582\t * Verifies that server generates a version negotiation packet, even if the\n2583\t * connection ID lengths are larger than the current version permits.\n2584\t */\n2585\t\n2586\tstatic int check_vn_invariant(uint8_t* packet, size_t packet_length, uint8_t* response, size_t response_length)\n2587\t{\n2588\t    int ret = 0;\n2589\t    size_t icid_len;\n2590\t    uint8_t * icid;\n2591\t    size_t scid_len;\n2592\t    uint8_t* scid;\n2593\t    size_t response_index = 5; /* Points to byte after VN */\n2594\t\n2595\t    if (packet_length < 6) {\n2596\t        ret = -1;\n2597\t    }\n2598\t    else {\n2599\t        /* Invariant parsing -- compute minimum length */\n2600\t        icid_len = packet[5];\n2601\t        icid = &packet[6];\n2602\t        if (packet_length < 5 + 1 + icid_len + 1) {\n2603\t            ret = -1;\n2604\t        }\n2605\t        else {\n2606\t            scid_len = packet[5 + 1 + icid_len];\n2607\t            scid = &packet[5 + 1 + icid_len + 1];\n2608\t            /* Check that the response is long enough */\n2609\t\n2610\t            if (packet_length < 1 + 4 + 1 + icid_len + 1 + scid_len + 4) {\n2611\t                ret = -1;\n2612\t            }\n2613\t            else if (response_length < 1 + 4 + 1 + icid_len + 1 + scid_len + 4) {\n2614\t                DBG_PRINTF(\"Response too short, length = %zu\", response_length);\n2615\t                ret = -1;\n2616\t            }\n2617\t        }\n2618\t    }\n2619\t    /* Check that response is long header */\n2620\t    if (ret == 0 && (response[0] & 0x80) != 0x80) {\n2621\t        DBG_PRINTF(\"Not a long header, packet[0] = 0x%02x\", response[0]);\n2622\t        ret = -1;\n2623\t    }\n2624\t    /* Check that response version is 0 */\n2625\t    for (size_t i = 1; ret == 0 && i < 5; i++) {\n2626\t        if (response[i] != 0) {\n2627\t            DBG_PRINTF(\"Version ID not zero, packet[%zu] = 0x%02x\", i, response[i]);\n2628\t            ret = -1;\n2629\t        }\n2630\t    }\n2631\t    /* Verify that the DCID matches incoming SCID */\n2632\t    if (ret == 0) {\n2633\t        if (response[response_index] != scid_len) {\n2634\t            DBG_PRINTF(\"Expected DCID length %zu, got 0x02x\", scid_len, response[response_index]);\n2635\t            ret = -1;\n2636\t        }\n2637\t        else {\n2638\t            response_index++;\n2639\t            if (scid_len > 0 && memcmp(scid, response + response_index, scid_len) != 0) {\n2640\t                DBG_PRINTF(\"%s\", \"DCID does not match incoming SCID\");\n2641\t                ret = -1;\n2642\t            }\n2643\t            else {\n2644\t                response_index += scid_len;\n2645\t            }\n2646\t        }\n2647\t    }\n2648\t    /* Verify that the SCID matches incoming DCID */\n2649\t    if (ret == 0) {\n2650\t        if (response[response_index] != icid_len) {\n2651\t            DBG_PRINTF(\"Expected ICID length %zu, got 0x02x\", icid_len, response[response_index]);\n2652\t            ret = -1;\n2653\t        }\n2654\t        else {\n2655\t            response_index++;\n2656\t            if (scid_len > 0 && memcmp(icid, response + response_index, icid_len) != 0) {\n2657\t                DBG_PRINTF(\"%s\", \"SCID does not match incoming ICID\");\n2658\t                ret = -1;\n2659\t            }\n2660\t        }\n2661\t    }\n2662\t\n2663\t    return ret;\n2664\t}\n2665\t\n2666\tint tls_api_version_invariant_test(void)\n2667\t{\n2668\t    uint64_t simulated_time = 0;\n2669\t    picoquic_test_tls_api_ctx_t* test_ctx = NULL;\n2670\t    int ret = tls_api_init_ctx(&test_ctx, 0, PICOQUIC_TEST_SNI, PICOQUIC_TEST_ALPN, &simulated_time, NULL, NULL, 0, 0, 0);\n2671\t\n2672\t    if (ret != 0)\n2673\t    {\n2674\t        DBG_PRINTF(\"%s\", \"Could not create the QUIC test contexts\");\n2675\t    }\n2676\t    else {\n2677\t        /* Fabricate a packet that stresses the invariants */\n2678\t        uint8_t packet[PICOQUIC_MAX_PACKET_SIZE];\n2679\t        /* Initialize first byte to long header value*/\n2680\t        packet[0] = 0xF5;\n2681\t        /* Set version to unexpected value */\n2682\t        memset(packet + 1, 0xaa, 4);\n2683\t        /* Set destination CID to 255 times \"dd\" */\n2684\t        packet[6] = 255;\n2685\t        memset(packet + 7, 0xdd, 255);\n2686\t        /* Set source CID to 127 times \"cc\" */\n2687\t        packet[262] = 127;\n2688\t        memset(packet + 263, 0xcc, 127);\n2689\t        /* Set reminder of packet to 0x55*/\n2690\t        memset(packet + 290, 0x55, PICOQUIC_MAX_PACKET_SIZE - 290);\n2691\t\n2692\t        /* Submit the packet to the server */\n2693\t        ret = picoquic_incoming_packet(test_ctx->qserver, packet, PICOQUIC_MAX_PACKET_SIZE,\n2694\t            (struct sockaddr*) & test_ctx->client_addr, (struct sockaddr*) & test_ctx->server_addr,\n2695\t            0, 0, simulated_time);\n2696\t        if (ret != 0) {\n2697\t            DBG_PRINTF(\"incoming invariant test returns %d (0x%x)\", ret, ret);\n2698\t        }\n2699\t        else {\n2700\t            uint8_t response[PICOQUIC_MAX_PACKET_SIZE];\n2701\t            struct sockaddr_storage addr_to;\n2702\t            struct sockaddr_storage addr_from;\n2703\t            size_t send_length = 0;\n2704\t            int if_index = 0;\n2705\t            picoquic_connection_id_t log_cid;\n2706\t            picoquic_cnx_t* last_cnx = NULL;\n2707\t\n2708\t            ret = picoquic_prepare_next_packet(test_ctx->qserver, simulated_time, response, PICOQUIC_MAX_PACKET_SIZE,\n2709\t                &send_length, &addr_to, &addr_from, &if_index, &log_cid, &last_cnx);\n2710\t            if (ret != 0) {\n2711\t                DBG_PRINTF(\"Invariant response test returns %d (0x%x)\", ret, ret);\n2712\t            }\n2713\t            else if (send_length == 0) {\n2714\t                DBG_PRINTF(\"%s\", \"Invariant response test does not return any data\");\n2715\t                ret = -1;\n2716\t            }\n2717\t            else {\n2718\t                ret = check_vn_invariant(packet, PICOQUIC_MAX_PACKET_SIZE, response, send_length);\n2719\t            }\n2720\t        }\n2721\t    }\n2722\t\n2723\t    if (test_ctx != NULL) {\n2724\t        tls_api_delete_ctx(test_ctx);\n2725\t        test_ctx = NULL;\n2726\t    }\n2727\t\n2728\t    return ret;\n2729\t}\n2730\t\n2731\t/* Test that spoofed version negotiation does not delete the connection context\n2732\t * spoof mode:\n2733\t * 0- valid CID\n2734\t * 1- invalid DCID\n2735\t * 2- invalid SCID\n2736\t * 3- invalid VN, empty list\n2737\t * 4- invalid list, contains current version\n2738\t * 5- invalid list, contains null version\n2739\t * 6- invalid list, contains only non existing versions\n2740\t * 7- invalid VN, length not multiple of 4\n2741\t */\n2742\tsize_t test_version_negotiation_get_spoofed(picoquic_cnx_t* cnx, int spoof_mode, uint8_t * packet, size_t packet_length)\n2743\t{\n2744\t    size_t packet_index = 0;\n2745\t    picoquic_connection_id_t bad_cid = { {0xba, 0xdc, 0x1d, 0, 0, 0, 0, 0}, 8 };\n2746\t    uint32_t this_vn = picoquic_supported_versions[cnx->version_index].version;\n2747\t    uint32_t random_vn = 0xa5a6a7a8 ^ (this_vn & 0x0f0f0f0f);\n2748\t    /* First byte for long header packet */\n2749\t    if (packet_index < packet_length) {\n2750\t        packet[packet_index++] = (uint8_t)(spoof_mode | 0x80);\n2751\t    }\n2752\t    /* version value 0 */\n2753\t    if (packet_index + 4 < packet_length) {\n2754\t        picoformat_32(&packet[packet_index], 0);\n2755\t        packet_index += 4;\n2756\t    }\n2757\t    /* DCID */\n2758\t    if (packet_index + 1 < packet_length) {\n2759\t        if (spoof_mode == 1) {\n2760\t            packet[packet_index++] = bad_cid.id_len;\n2761\t            packet_index += picoquic_format_connection_id(&packet[packet_index], packet_length - packet_index, bad_cid);\n2762\t        }\n2763\t        else {\n2764\t            packet[packet_index++] = cnx->path[0]->first_tuple->p_local_cnxid->cnx_id.id_len;\n2765\t            packet_index += picoquic_format_connection_id(&packet[packet_index], packet_length - packet_index, cnx->path[0]->first_tuple->p_local_cnxid->cnx_id);\n2766\t        }\n2767\t    }\n2768\t    /* SCID */\n2769\t    if (packet_index + 1 < packet_length) {\n2770\t        if (spoof_mode == 2) {\n2771\t            packet[packet_index++] = bad_cid.id_len;\n2772\t            packet_index += picoquic_format_connection_id(&packet[packet_index], packet_length - packet_index, bad_cid);\n2773\t        }\n2774\t        else {\n2775\t            packet[packet_index++] = cnx->initial_cnxid.id_len;\n2776\t            packet_index += picoquic_format_connection_id(&packet[packet_index], packet_length - packet_index, cnx->initial_cnxid);\n2777\t        }\n2778\t    }\n2779\t    /* Encode the proposed versions */\n2780\t    if (spoof_mode != 3) {\n2781\t        if (packet_index + 4 < packet_length) {\n2782\t            picoformat_32(&packet[packet_index], random_vn);\n2783\t            packet_index += 4;\n2784\t        }\n2785\t        if (packet_index + 4 < packet_length) {\n2786\t            uint32_t plausible_vn = 0xffffffff;\n2787\t            if (spoof_mode == 4) {\n2788\t                plausible_vn = this_vn;\n2789\t            }\n2790\t            else if (spoof_mode == 5) {\n2791\t                plausible_vn = this_vn;\n2792\t            }\n2793\t            else if (spoof_mode != 6 && picoquic_nb_supported_versions > 1) {\n2794\t                size_t plausible_index = picoquic_nb_supported_versions - 1;\n2795\t                if ((size_t)cnx->version_index == plausible_index) {\n2796\t                    plausible_index = 0;\n2797\t                }\n2798\t                plausible_vn = picoquic_supported_versions[plausible_index].version;\n2799\t            }\n2800\t            picoformat_32(&packet[packet_index], plausible_vn);\n2801\t            packet_index += 4;\n2802\t        }\n2803\t        if (spoof_mode == 7 && packet_index < packet_length) {\n2804\t            packet[packet_index++] = 0xaf;\n2805\t        }\n2806\t    }\n2807\t\n2808\t    return packet_index;\n2809\t}\n2810\t\n2811\tint test_version_negotiation_spoof_one(int spoof_mode)\n2812\t{\n2813\t    uint64_t simulated_time = 0;\n2814\t    picoquic_test_tls_api_ctx_t* test_ctx = NULL;\n2815\t    int ret = tls_api_init_ctx(&test_ctx, 0, PICOQUIC_TEST_SNI, PICOQUIC_TEST_ALPN, &simulated_time, NULL, NULL, 0, 0, 0);\n2816\t    uint8_t packet[256];\n2817\t    size_t packet_length = 0;\n2818\t    int nb_trials = 0;\n2819\t    int nb_inactive = 0;\n2820\t\n2821\t    /* Do one round of simulation so the client connection moves to initial state */\n2822\t    while (ret == 0 && nb_trials < 1024 && nb_inactive < 512) {\n2823\t        int was_active = 0;\n2824\t        nb_trials++;\n2825\t\n2826\t        ret = tls_api_one_sim_round(test_ctx, &simulated_time, 0, &was_active);\n2827\t\n2828\t        if (test_ctx->cnx_client->cnx_state >= picoquic_state_client_init_sent) {\n2829\t            break;\n2830\t        }\n2831\t\n2832\t        if (nb_trials == 512) {\n2833\t            DBG_PRINTF(\"After %d trials, client state = %d, server state = %d\",\n2834\t                nb_trials, (int)test_ctx->cnx_client->cnx_state,\n2835\t                (test_ctx->cnx_server == NULL) ? -1 : test_ctx->cnx_server->cnx_state);\n2836\t        }\n2837\t\n2838\t        if (was_active) {\n2839\t            nb_inactive = 0;\n2840\t        }\n2841\t        else {\n2842\t            nb_inactive++;\n2843\t        }\n2844\t    }\n2845\t    /* Verify that the connection is in the right state */\n2846\t    if (ret == 0 && test_ctx->cnx_client->cnx_state != picoquic_state_client_init_sent) {\n2847\t        DBG_PRINTF(\"After %d trials, client state = %d\",\n2848\t            nb_trials, (int)test_ctx->cnx_client->cnx_state);\n2849\t        ret = -1;\n2850\t    }\n2851\t\n2852\t    if (ret == 0) {\n2853\t        /* Create the spoofed VN */\n2854\t        packet_length = test_version_negotiation_get_spoofed(test_ctx->cnx_client, spoof_mode, packet, sizeof(packet));\n2855\t\n2856\t        /* Inject the spoofed VN packet */\n2857\t        ret = picoquic_incoming_packet(test_ctx->qclient, packet, packet_length,\n2858\t            (struct sockaddr*)&test_ctx->server_addr, (struct sockaddr*)&test_ctx->client_addr,\n2859\t            0, 0, simulated_time);\n2860\t    }\n2861\t\n2862\t    if (ret == 0) {\n2863\t        /* Verify that the connection survived */\n2864\t        if (test_ctx->cnx_client->cnx_state != picoquic_state_client_init_sent) {\n2865\t            DBG_PRINTF(\"After VN injection, client state = %d\",\n2866\t                (int)test_ctx->cnx_client->cnx_state);\n2867\t            ret = -1;\n2868\t        }\n2869\t    }\n2870\t\n2871\t    if (test_ctx != NULL) {\n2872\t        tls_api_delete_ctx(test_ctx);\n2873\t        test_ctx = NULL;\n2874\t    }\n2875\t\n2876\t    return ret;\n2877\t}\n2878\t\n2879\tint test_version_negotiation_spoof(void)\n2880\t{\n2881\t    int ret = 0;\n2882\t\n2883\t    if (test_version_negotiation_spoof_one(0) == 0) {\n2884\t        DBG_PRINTF(\"%s\", \"VN spoof mode 0 has no effect\");\n2885\t        ret = -1;\n2886\t    }\n2887\t\n2888\t    for (int spoof_mode = 1; ret == 0 && spoof_mode < 8; spoof_mode++) {\n2889\t        ret = test_version_negotiation_spoof_one(spoof_mode);\n2890\t        if (ret != 0) {\n2891\t            DBG_PRINTF(\"VN spoof mode %d caused failure\", spoof_mode);\n2892\t            ret = -1;\n2893\t        }\n2894\t    }\n2895\t\n2896\t    return ret;\n2897\t}\n2898\t\n2899\t/* Test the compatible VN setup.\n2900\t * This will start a connection with version 1, and verify that it gets established with version 2,\n2901\t * or to version 2 draft.\n2902\t */\n2903\tint vn_compat_test_one(uint32_t current, uint32_t target)\n2904\t{\n2905\t    uint64_t simulated_time = 0;\n2906\t    picoquic_test_tls_api_ctx_t* test_ctx = NULL;\n2907\t    int ret = tls_api_init_ctx(&test_ctx, current, PICOQUIC_TEST_SNI, PICOQUIC_TEST_ALPN, &simulated_time, NULL, NULL, 0, 1, 0);\n2908\t\n2909\t\n2910\t    if (ret == 0) {\n2911\t        /* Set the desired version */\n2912\t        picoquic_set_desired_version(test_ctx->cnx_client, target);\n2913\t        /* Start the client connection */\n2914\t        ret = picoquic_start_client_cnx(test_ctx->cnx_client);\n2915\t    }\n2916\t\n2917\t    if (ret != 0)\n2918\t    {\n2919\t        DBG_PRINTF(\"Could not create the QUIC test contexts for V=%x\\n\", current);\n2920\t    }\n2921\t\n2922\t    if (ret == 0) {\n2923\t        (void)tls_api_connection_loop(test_ctx, NULL, 0, &simulated_time);\n2924\t    }\n2925\t\n2926\t\n2927\t    if (ret == 0) {\n2928\t        if (picoquic_supported_versions[test_ctx->cnx_client->version_index].version != target) {\n2929\t            DBG_PRINTF(\"Client remained to version 0x%08x\",\n2930\t                picoquic_supported_versions[test_ctx->cnx_client->version_index].version);\n2931\t            ret = -1;\n2932\t        }\n2933\t        else if (picoquic_supported_versions[test_ctx->cnx_server->version_index].version != target) {\n2934\t            DBG_PRINTF(\"Server remained to version 0x%08x\",\n2935\t                picoquic_supported_versions[test_ctx->cnx_client->version_index].version);\n2936\t            ret = -1;\n2937\t        }\n2938\t    }\n2939\t\n2940\t    if (test_ctx != NULL) {\n2941\t        tls_api_delete_ctx(test_ctx);\n2942\t        test_ctx = NULL;\n2943\t    }\n2944\t\n2945\t    return ret;\n2946\t}\n2947\t\n2948\tint vn_compat_test(void)\n2949\t{\n2950\t    int ret = 0;\n2951\t\n2952\t    if (vn_compat_test_one(PICOQUIC_V1_VERSION, PICOQUIC_V2_VERSION) != 0) {\n2953\t        ret = -1;\n2954\t    }\n2955\t    else if (vn_compat_test_one(PICOQUIC_V1_VERSION, PICOQUIC_V2_VERSION_DRAFT) != 0) {\n2956\t        ret = -1;\n2957\t    }\n2958\t    else if (vn_compat_test_one(PICOQUIC_V1_VERSION, PICOQUIC_INTERNAL_TEST_VERSION_1) == 0) {\n2959\t        ret = -1;\n2960\t    }\n2961\t\n2962\t    return ret;\n2963\t}\n2964\t\n2965\t/* Test setting the SNI\n2966\t */\n2967\t\n2968\tint tls_api_sni_test(void)\n2969\t{\n2970\t    return tls_api_test_with_loss(NULL, 0, PICOQUIC_TEST_SNI, PICOQUIC_TEST_ALPN);\n2971\t}\n2972\t\n2973\t/* The ALPN test checks that the connection fails if no ALPN is specified.\n2974\t */\n2975\t\n2976\tint tls_api_alpn_test(void)\n2977\t{\n2978\t    int ret = tls_api_test_with_loss(NULL, 0, PICOQUIC_TEST_SNI, NULL);\n2979\t\n2980\t    if (ret == PICOQUIC_ERROR_NO_ALPN_PROVIDED) {\n2981\t        ret = 0;\n2982\t    } else if (ret == 0) {\n2983\t        DBG_PRINTF(\"ALPN test succeeds while no ALPN is specified, ret = 0x%x\", ret);\n2984\t        ret = -1;\n2985\t    }\n2986\t    else {\n2987\t        DBG_PRINTF(\"ALPN test does not return expected error code, ret = 0x%x\", ret);\n2988\t        ret = -1;\n2989\t    }\n2990\t    return ret;\n2991\t}\n2992\t\n2993\tint tls_api_wrong_alpn_test(void)\n2994\t{\n2995\t    uint64_t simulated_time = 0;\n2996\t    picoquic_test_tls_api_ctx_t* test_ctx = NULL;\n2997\t    int ret = tls_api_init_ctx(&test_ctx, 0, PICOQUIC_TEST_SNI, PICOQUIC_TEST_WRONG_ALPN, &simulated_time, NULL, NULL, 0, 0, 0);\n2998\t\n2999\t    if (ret == 0) {"}]},"parent_tool_use_id":"toolu_01Rt4pELUTT189iuGyrewME6","session_id":"782f2f02-5f93-4f6f-b663-2ef2c783a0cf","uuid":"97bde5e3-b310-4c02-8f5d-84d81407396a","timestamp":"2026-05-05T12:37:40.969Z"}
{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01AeztENZ4L3oLNeHHZ6oaAF","type":"tool_result","content":"3000\t        /* By default, client and servers are using the same ALPN. Correct that on the server side \n3001\t         * so we can test the wrong ALPN condition */\n3002\t        free((void*)test_ctx->qserver->default_alpn);\n3003\t        test_ctx->qserver->default_alpn = picoquic_string_duplicate(PICOQUIC_TEST_ALPN);\n3004\t    }\n3005\t\n3006\t    if (ret != 0)\n3007\t    {\n3008\t        DBG_PRINTF(\"Could not create the QUIC test contexts for V=%x\\n\", 0);\n3009\t    }\n3010\t\n3011\t    if (ret == 0) {\n3012\t        ret = tls_api_connection_loop(test_ctx, 0, 0, &simulated_time);\n3013\t\n3014\t        if (ret == 0)\n3015\t        {\n3016\t            if (test_ctx->cnx_client != NULL) {\n3017\t                if (test_ctx->cnx_client->cnx_state == picoquic_state_disconnected &&\n3018\t                    test_ctx->cnx_client->remote_error == PICOQUIC_TLS_ALERT_WRONG_ALPN) {\n3019\t                    ret = 0;\n3020\t                }\n3021\t                else {\n3022\t                    DBG_PRINTF(\"Connection loop returns 0x%\" PRIx64, test_ctx->cnx_client->remote_error);\n3023\t                    ret = -1;\n3024\t                }\n3025\t            }\n3026\t            else {\n3027\t                DBG_PRINTF(\"%s\", \"Could not establish a client connection\");\n3028\t                ret = -1;\n3029\t            }\n3030\t        }\n3031\t    }\n3032\t\n3033\t    if (test_ctx != NULL) {\n3034\t        tls_api_delete_ctx(test_ctx);\n3035\t        test_ctx = NULL;\n3036\t    }\n3037\t\n3038\t    return ret;\n3039\t}\n3040\t\n3041\t/*\n3042\t * Scenario based transmission tests.\n3043\t */\n3044\t\n3045\tint tls_api_one_scenario_init_ex(\n3046\t    picoquic_test_tls_api_ctx_t** p_test_ctx, uint64_t * simulated_time,\n3047\t    uint32_t proposed_version,\n3048\t    picoquic_tp_t * client_params, picoquic_tp_t * server_params,\n3049\t    picoquic_connection_id_t * icid)\n3050\t{\n3051\t    int ret = tls_api_init_ctx_ex(p_test_ctx,\n3052\t        (proposed_version == 0) ? PICOQUIC_INTERNAL_TEST_VERSION_1 : proposed_version,\n3053\t        PICOQUIC_TEST_SNI, PICOQUIC_TEST_ALPN, simulated_time, NULL, NULL, 0, 1, 0, icid);\n3054\t\n3055\t    if (ret != 0) {\n3056\t        DBG_PRINTF(\"Could not create the QUIC test contexts for V=%x\\n\", proposed_version);\n3057\t    }\n3058\t    else if (*p_test_ctx == NULL || (*p_test_ctx)->cnx_client == NULL || (*p_test_ctx)->qserver == NULL) {\n3059\t        DBG_PRINTF(\"%s\", \"Connections where not properly created!\\n\");\n3060\t        ret = -1;\n3061\t    }\n3062\t\n3063\t    if (ret == 0 && client_params != NULL) {\n3064\t        picoquic_set_transport_parameters((*p_test_ctx)->cnx_client, client_params);\n3065\t    }\n3066\t\n3067\t    if (ret == 0 && server_params != NULL) {\n3068\t        ret = picoquic_set_default_tp((*p_test_ctx)->qserver, server_params);\n3069\t        if (server_params->preferred_address.ipv4Port != 0 ||\n3070\t            server_params->preferred_address.ipv6Port != 0) {\n3071\t            /* If testing server migration, disable address check */\n3072\t            (*p_test_ctx)->server_use_multiple_addresses = 1;\n3073\t        }\n3074\t    }\n3075\t\n3076\t    return ret;\n3077\t}\n3078\t\n3079\tint tls_api_one_scenario_init(\n3080\t    picoquic_test_tls_api_ctx_t** p_test_ctx, uint64_t* simulated_time,\n3081\t    uint32_t proposed_version,\n3082\t    picoquic_tp_t* client_params, picoquic_tp_t* server_params)\n3083\t{\n3084\t    return tls_api_one_scenario_init_ex(p_test_ctx, simulated_time, proposed_version, client_params, server_params, NULL);\n3085\t}\n3086\t\n3087\tint tls_api_one_scenario_verify(picoquic_test_tls_api_ctx_t* test_ctx)\n3088\t{\n3089\t    int ret = 0;\n3090\t\n3091\t    if (test_ctx->server_callback.error_detected) {\n3092\t        ret = -1;\n3093\t    }\n3094\t    else if (test_ctx->client_callback.error_detected) {\n3095\t        ret = -1;\n3096\t    }\n3097\t    else {\n3098\t        for (size_t i = 0; ret == 0 && i < test_ctx->nb_test_streams; i++) {\n3099\t            if (test_ctx->test_stream[i].q_recv_nb != test_ctx->test_stream[i].q_len) {\n3100\t                ret = -1;\n3101\t            }\n3102\t            else if (test_ctx->test_stream[i].r_recv_nb != test_ctx->test_stream[i].r_len) {\n3103\t                ret = -1;\n3104\t            }\n3105\t            else if (test_ctx->test_stream[i].q_received == 0 || test_ctx->test_stream[i].r_received == 0) {\n3106\t                ret = -1;\n3107\t            }\n3108\t        }\n3109\t\n3110\t        if (test_ctx->stream0_sent != test_ctx->stream0_target ||\n3111\t            test_ctx->stream0_sent != test_ctx->stream0_received) {\n3112\t            ret = -1;\n3113\t        }\n3114\t\n3115\t        if (ret == 0 && test_ctx->qclient->nb_data_nodes_allocated > test_ctx->qclient->nb_data_nodes_in_pool) {\n3116\t            ret = -1;\n3117\t        } else \n3118\t        if (ret == 0 && test_ctx->qserver->nb_data_nodes_allocated > test_ctx->qserver->nb_data_nodes_in_pool) {\n3119\t            ret = -1;\n3120\t        }\n3121\t    }\n3122\t    if (ret != 0)\n3123\t    {\n3124\t        DBG_PRINTF(\"Test scenario verification returns %d\\n\", ret);\n3125\t    }\n3126\t\n3127\t    return ret;\n3128\t}\n3129\t\n3130\tint tls_api_one_scenario_body_connect(picoquic_test_tls_api_ctx_t* test_ctx,\n3131\t    uint64_t * simulated_time, uint64_t max_data, uint64_t queue_delay_max)\n3132\t{\n3133\t    int ret = picoquic_start_client_cnx(test_ctx->cnx_client);\n3134\t    test_ctx->loss_mask_default = 0;\n3135\t\n3136\t    if (ret != 0)\n3137\t    {\n3138\t        DBG_PRINTF(\"%s\", \"Could not initialize connection for the client\\n\");\n3139\t    }\n3140\t    else {\n3141\t        ret = tls_api_connection_loop(test_ctx, &test_ctx->loss_mask_default, queue_delay_max, simulated_time);\n3142\t\n3143\t        if (ret != 0)\n3144\t        {\n3145\t            DBG_PRINTF(\"Connection loop returns error %d\\n\", ret);\n3146\t        }\n3147\t    }\n3148\t\n3149\t    if (ret == 0 && max_data != 0) {\n3150\t        test_ctx->cnx_client->maxdata_local = max_data;\n3151\t        test_ctx->cnx_client->maxdata_remote = max_data;\n3152\t        test_ctx->cnx_server->maxdata_local = max_data;\n3153\t        test_ctx->cnx_server->maxdata_remote = max_data;\n3154\t    }\n3155\t\n3156\t    return ret;\n3157\t}\n3158\t\n3159\tint tls_api_one_scenario_body_verify(picoquic_test_tls_api_ctx_t* test_ctx,\n3160\t    uint64_t * simulated_time,\n3161\t    uint64_t max_completion_microsec)\n3162\t{\n3163\t\n3164\t    uint64_t close_time = 0;\n3165\t    int ret = tls_api_one_scenario_verify(test_ctx);\n3166\t\n3167\t    if (ret == 0) {\n3168\t        close_time = *simulated_time;\n3169\t        tls_api_attempt_to_close(test_ctx, simulated_time);\n3170\t        if (ret != 0)\n3171\t        {\n3172\t            DBG_PRINTF(\"Attempt to close returns %d\\n\", ret);\n3173\t        }\n3174\t    }\n3175\t\n3176\t    if (ret == 0 && max_completion_microsec != 0) {\n3177\t        uint64_t completion_time = close_time - test_ctx->cnx_client->start_time;\n3178\t        if (completion_time > max_completion_microsec)\n3179\t        {\n3180\t            DBG_PRINTF(\"Scenario completes in %llu microsec, more than %llu, %llu losses, %llu spurious\\n\",\n3181\t                (unsigned long long)completion_time, (unsigned long long)max_completion_microsec,\n3182\t                test_ctx->cnx_server->nb_retransmission_total, test_ctx->cnx_server->nb_spurious);\n3183\t             ret = -1;\n3184\t        }\n3185\t    }\n3186\t\n3187\t    return ret;\n3188\t}\n3189\t\n3190\tint tls_api_one_scenario_body_ex(picoquic_test_tls_api_ctx_t* test_ctx,\n3191\t    uint64_t * simulated_time,\n3192\t    test_api_stream_desc_t* scenario, size_t sizeof_scenario, size_t stream0_target,\n3193\t    uint64_t init_loss_mask, uint64_t max_data, uint64_t queue_delay_max,\n3194\t    uint64_t max_completion_microsec, size_t nb_link_states, test_vary_link_spec_t* link_state)\n3195\t{\n3196\t    int ret = tls_api_one_scenario_body_connect(test_ctx, simulated_time, max_data, queue_delay_max);\n3197\t\n3198\t    /* Prepare to send data */\n3199\t    if (ret == 0) {\n3200\t        test_ctx->stream0_target = stream0_target;\n3201\t        test_ctx->loss_mask_default = init_loss_mask;\n3202\t        ret = test_api_init_send_recv_scenario(test_ctx, scenario, sizeof_scenario);\n3203\t\n3204\t        if (ret != 0)\n3205\t        {\n3206\t            DBG_PRINTF(\"Init send receive scenario returns %d\\n\", ret);\n3207\t        }\n3208\t    }\n3209\t\n3210\t    /* Perform a data sending loop */\n3211\t    if (ret == 0) {\n3212\t        ret = tls_api_data_sending_loop_ex(test_ctx, &test_ctx->loss_mask_default, simulated_time, 0,\n3213\t            nb_link_states, link_state);\n3214\t\n3215\t        if (ret != 0)\n3216\t        {\n3217\t            DBG_PRINTF(\"Data sending loop returns %d\\n\", ret);\n3218\t        }\n3219\t    }\n3220\t\n3221\t    if (ret == 0) {\n3222\t        ret = tls_api_one_scenario_body_verify(test_ctx, simulated_time, max_completion_microsec);\n3223\t    }\n3224\t\n3225\t    return ret;\n3226\t}\n3227\t\n3228\tint tls_api_one_scenario_body(picoquic_test_tls_api_ctx_t* test_ctx,\n3229\t    uint64_t* simulated_time,\n3230\t    test_api_stream_desc_t* scenario, size_t sizeof_scenario, size_t stream0_target,\n3231\t    uint64_t init_loss_mask, uint64_t max_data, uint64_t queue_delay_max,\n3232\t    uint64_t max_completion_microsec)\n3233\t{\n3234\t    return tls_api_one_scenario_body_ex(test_ctx, simulated_time, scenario, sizeof_scenario,\n3235\t        stream0_target, init_loss_mask, max_data, queue_delay_max, max_completion_microsec,\n3236\t        0, NULL);\n3237\t}\n3238\t\n3239\t\n3240\tint tls_api_one_scenario_test(test_api_stream_desc_t* scenario,\n3241\t    size_t sizeof_scenario, size_t stream0_target,\n3242\t    uint64_t init_loss_mask, uint64_t max_data, uint64_t queue_delay_max,\n3243\t    uint32_t proposed_version, uint64_t max_completion_microsec,\n3244\t    picoquic_tp_t * client_params, picoquic_tp_t * server_params) \n3245\t{\n3246\t    uint64_t simulated_time = 0;\n3247\t    picoquic_test_tls_api_ctx_t* test_ctx = NULL;\n3248\t\n3249\t    int ret = tls_api_one_scenario_init(&test_ctx, &simulated_time,\n3250\t        proposed_version, client_params, server_params);\n3251\t\n3252\t    if (ret == 0) {\n3253\t        ret = tls_api_one_scenario_body(test_ctx, &simulated_time,\n3254\t            scenario, sizeof_scenario, stream0_target, init_loss_mask, max_data, queue_delay_max,\n3255\t            max_completion_microsec);\n3256\t    }\n3257\t\n3258\t    if (test_ctx != NULL) {\n3259\t        tls_api_delete_ctx(test_ctx);\n3260\t        test_ctx = NULL;\n3261\t    }\n3262\t\n3263\t    return ret;\n3264\t}\n3265\t\n3266\tint tls_api_oneway_stream_test(void)\n3267\t{\n3268\t    return tls_api_one_scenario_test(test_scenario_oneway, sizeof(test_scenario_oneway), 0, 0, 0, 0, 0, 75000, NULL, NULL);\n3269\t}\n3270\t\n3271\tint tls_api_q_and_r_stream_test(void)\n3272\t{\n3273\t    return tls_api_one_scenario_test(test_scenario_q_and_r, sizeof(test_scenario_q_and_r), 0, 0, 0, 0, 0, 75000, NULL, NULL);\n3274\t}\n3275\t\n3276\tint tls_api_q2_and_r2_stream_test(void)\n3277\t{\n3278\t    return tls_api_one_scenario_test(test_scenario_q2_and_r2, sizeof(test_scenario_q2_and_r2), 0, 0, 0, 0, 0, 86000, NULL, NULL);\n3279\t}\n3280\t\n3281\tint tls_api_very_long_stream_test(void)\n3282\t{\n3283\t    return tls_api_one_scenario_test(test_scenario_very_long, sizeof(test_scenario_very_long), 0, 0, 0, 0, 0, 1000000, NULL, NULL);\n3284\t}\n3285\t\n3286\tint tls_api_very_long_max_test(void)\n3287\t{\n3288\t    return tls_api_one_scenario_test(test_scenario_very_long, sizeof(test_scenario_very_long), 0, 0, 128000, 0, 0, 1000000, NULL, NULL);\n3289\t}\n3290\t\n3291\tint tls_api_very_long_with_err_test(void)\n3292\t{\n3293\t    return tls_api_one_scenario_test(test_scenario_very_long, sizeof(test_scenario_very_long), 0, 0x30000, 128000, 0, 0, 2210000, NULL, NULL);\n3294\t}\n3295\t\n3296\tint tls_api_very_long_congestion_test(void)\n3297\t{\n3298\t    return tls_api_one_scenario_test(test_scenario_very_long, sizeof(test_scenario_very_long), 0, 0, 128000, 20000, 0, 1000000, NULL, NULL);\n3299\t}\n3300\t\n3301\tint unidir_test(void)\n3302\t{\n3303\t    uint64_t simulated_time = 0;\n3304\t    picoquic_test_tls_api_ctx_t* test_ctx = NULL;\n3305\t\n3306\t    int ret = tls_api_one_scenario_init(&test_ctx, &simulated_time,\n3307\t        0, NULL, NULL);\n3308\t\n3309\t    if (ret == 0) {\n3310\t        ret = tls_api_one_scenario_body(test_ctx, &simulated_time,\n3311\t            test_scenario_unidir, sizeof(test_scenario_unidir), 0, 0, 128000, 10000,\n3312\t            100000);\n3313\t    }\n3314\t\n3315\t    /* Verify that the unidir streams are properly closed. */\n3316\t    if (ret == 0 && test_ctx->cnx_client != NULL && test_ctx->cnx_client->stream_tree.size != 0) {\n3317\t        DBG_PRINTF(\"There are %d streams left open on client at the end of test.\",\n3318\t            test_ctx->cnx_client->stream_tree.size);\n3319\t        ret = -1;\n3320\t    }\n3321\t\n3322\t    if (ret == 0 && test_ctx->cnx_server != NULL && test_ctx->cnx_server->stream_tree.size != 0) {\n3323\t        DBG_PRINTF(\"There are %d streams left open on client at the end of test.\",\n3324\t            test_ctx->cnx_server->stream_tree.size);\n3325\t        ret = -1;\n3326\t    }\n3327\t\n3328\t    if (test_ctx != NULL) {\n3329\t        tls_api_delete_ctx(test_ctx);\n3330\t        test_ctx = NULL;\n3331\t    }\n3332\t\n3333\t    return ret;\n3334\t}\n3335\t\n3336\tint many_short_loss_test(void)\n3337\t{\n3338\t    return tls_api_one_scenario_test(test_scenario_more_streams, sizeof(test_scenario_more_streams), 0, 0x882818A881288848ull, 16000, 2000, 0, 0, NULL, NULL);\n3339\t}\n3340\t\n3341\t/* Implicit ACK test: verify that the queues of initial and\n3342\t * handshake packets are empty after reaching the ready state\n3343\t */\n3344\t\n3345\tint implicit_ack_test(void)\n3346\t{\n3347\t    uint64_t simulated_time = 0;\n3348\t    uint64_t loss_mask = 0;\n3349\t    picoquic_test_tls_api_ctx_t* test_ctx = NULL;\n3350\t    int ret = tls_api_init_ctx(&test_ctx, 0, PICOQUIC_TEST_SNI, PICOQUIC_TEST_ALPN, &simulated_time, NULL, NULL, 0, 0, 0);\n3351\t    picoquic_packet_context_enum pc[2] = { picoquic_packet_context_initial, picoquic_packet_context_handshake };\n3352\t\n3353\t    if (ret == 0) {\n3354\t        ret = tls_api_connection_loop(test_ctx, &loss_mask, 0, &simulated_time);\n3355\t    }\n3356\t\n3357\t    if (ret == 0) {\n3358\t        ret = wait_client_connection_ready(test_ctx, &simulated_time);\n3359\t    }\n3360\t\n3361\t    for (int i = 0; ret == 0 && i < 2; i++) {\n3362\t        if (test_ctx->cnx_client->pkt_ctx[pc[i]].pending_first != NULL) {\n3363\t            DBG_PRINTF(\"Retransmit queue type %d not empty on client\", pc[i]);\n3364\t            ret = -1;\n3365\t        }\n3366\t        else if (test_ctx->cnx_server->pkt_ctx[pc[i]].pending_first != NULL) {\n3367\t            DBG_PRINTF(\"Retransmit queue type %d not empty on server\", pc[i]);\n3368\t            ret = -1;\n3369\t        }\n3370\t        else if (test_ctx->cnx_client->pkt_ctx[pc[i]].retransmitted_oldest != NULL) {\n3371\t            DBG_PRINTF(\"Retransmitted queue type %d not empty on client\", pc[i]);\n3372\t            ret = -1;\n3373\t        }\n3374\t        else if (test_ctx->cnx_server->pkt_ctx[pc[i]].pending_first != NULL) {\n3375\t            DBG_PRINTF(\"Retransmitted queue type %d not empty on server\", pc[i]);\n3376\t            ret = -1;\n3377\t        }\n3378\t    }\n3379\t\n3380\t    if (test_ctx != NULL) {\n3381\t        tls_api_delete_ctx(test_ctx);\n3382\t        test_ctx = NULL;\n3383\t    }\n3384\t\n3385\t    return ret;\n3386\t}\n3387\t\n3388\t/*\n3389\t * Server reset test.\n3390\t * Establish a connection between server and client.\n3391\t * When the connection is established, delete the server connection, and prime the client\n3392\t * to send data.\n3393\t * Expected result: the client sends a packet with a stream frame, the server responds\n3394\t * with a stateless reset, the client closes its own connection.\n3395\t */\n3396\t\n3397\tint stateless_reset_test(void)\n3398\t{\n3399\t    uint64_t simulated_time = 0;\n3400\t    uint64_t loss_mask = 0;\n3401\t    picoquic_test_tls_api_ctx_t* test_ctx = NULL;\n3402\t    int ret = tls_api_init_ctx(&test_ctx, 0, PICOQUIC_TEST_SNI, PICOQUIC_TEST_ALPN, &simulated_time, NULL, NULL, 0, 0, 0);\n3403\t    uint8_t buffer[128];\n3404\t    int was_active = 0;\n3405\t\n3406\t    if (ret == 0) {\n3407\t        ret = tls_api_connection_loop(test_ctx, &loss_mask, 0, &simulated_time);\n3408\t    }\n3409\t\n3410\t    if (ret == 0) {\n3411\t        ret = wait_client_connection_ready(test_ctx, &simulated_time);\n3412\t    }\n3413\t\n3414\t    /* verify that client and server have the same reset secret */\n3415\t    if (ret == 0) {\n3416\t        uint8_t ref_secret[PICOQUIC_RESET_SECRET_SIZE];\n3417\t\n3418\t        (void)picoquic_create_cnxid_reset_secret(test_ctx->qserver,\n3419\t            &test_ctx->cnx_client->path[0]->first_tuple->p_remote_cnxid->cnx_id, ref_secret);\n3420\t        if (memcmp(test_ctx->cnx_client->path[0]->first_tuple->p_remote_cnxid->reset_secret, ref_secret,\n3421\t            PICOQUIC_RESET_SECRET_SIZE) != 0) {\n3422\t            ret = -1;\n3423\t        }\n3424\t    }\n3425\t\n3426\t    /* Prepare to reset */\n3427\t    if (ret == 0) {\n3428\t        picoquic_delete_cnx(test_ctx->cnx_server);\n3429\t        test_ctx->cnx_server = NULL;\n3430\t\n3431\t        memset(buffer, 0xaa, sizeof(buffer));\n3432\t        ret = picoquic_add_to_stream(test_ctx->cnx_client, 4,\n3433\t            buffer, sizeof(buffer), 1);\n3434\t    }\n3435\t\n3436\t    /* Perform a couple rounds of sending data */\n3437\t    for (int i = 0; ret == 0 && i < 64 && test_ctx->cnx_client->cnx_state != picoquic_state_disconnected; i++) {\n3438\t        was_active = 0;\n3439\t\n3440\t        ret = tls_api_one_sim_round(test_ctx, &simulated_time, 0, &was_active);\n3441\t    }\n3442\t\n3443\t    /* Client should now be in state disconnected */\n3444\t    if (ret == 0 && test_ctx->cnx_client->cnx_state != picoquic_state_disconnected) {\n3445\t        ret = -1;\n3446\t    }\n3447\t\n3448\t    if (ret == 0 && test_ctx->reset_received == 0) {\n3449\t        ret = -1;\n3450\t    }\n3451\t    if (test_ctx != NULL) {\n3452\t        tls_api_delete_ctx(test_ctx);\n3453\t        test_ctx = NULL;\n3454\t    }\n3455\t\n3456\t    return ret;\n3457\t}\n3458\t\n3459\t/*\n3460\t* Server reset negative test.\n3461\t* Establish a connection between server and client.\n3462\t* When the connection is established, fabricate a bogus server reset and\n3463\t* send it to the client.\n3464\t* Expected result: the client ignores the bogus reset.\n3465\t*/\n3466\tint stateless_reset_bad_test(void)\n3467\t{\n3468\t    uint64_t simulated_time = 0;\n3469\t    uint64_t loss_mask = 0;\n3470\t    picoquic_test_tls_api_ctx_t* test_ctx = NULL;\n3471\t    int ret = tls_api_init_ctx(&test_ctx, 0, PICOQUIC_TEST_SNI, PICOQUIC_TEST_ALPN, &simulated_time, NULL, NULL, 0, 0, 0);\n3472\t    uint8_t buffer[256];\n3473\t\n3474\t    if (ret == 0) {\n3475\t        ret = tls_api_connection_loop(test_ctx, &loss_mask, 0, &simulated_time);\n3476\t    }\n3477\t\n3478\t    /* Prepare the bogus reset */\n3479\t    if (ret == 0) {\n3480\t        size_t byte_index = 0;\n3481\t        buffer[byte_index++] = 0x41;\n3482\t        byte_index += picoquic_format_connection_id(&buffer[byte_index], sizeof(buffer) - byte_index, test_ctx->cnx_client->path[0]->first_tuple->p_local_cnxid->cnx_id);\n3483\t        memset(buffer + byte_index, 0xcc, sizeof(buffer) - byte_index);\n3484\t        \n3485\t        /* Submit bogus request to client */\n3486\t        ret = picoquic_incoming_packet(test_ctx->qclient, buffer, sizeof(buffer),\n3487\t            (struct sockaddr*)(&test_ctx->server_addr),\n3488\t            (struct sockaddr*)(&test_ctx->client_addr), 0, test_ctx->recv_ecn_client,\n3489\t            simulated_time);\n3490\t    }\n3491\t\n3492\t    /* check that the client is still up */\n3493\t    if (ret == 0 && !TEST_CLIENT_READY) {\n3494\t        ret = -1;\n3495\t    }\n3496\t\n3497\t    if (test_ctx != NULL) {\n3498\t        tls_api_delete_ctx(test_ctx);\n3499\t        test_ctx = NULL;\n3500\t    }\n3501\t\n3502\t    return ret;\n3503\t}\n3504\t\n3505\t/*\n3506\t* Server reset client test.\n3507\t* Establish a connection between server and client.\n3508\t* Get the connection almost established on server,\n3509\t* fabricate a bogus stateless reset and\n3510\t* send it from the client to the server.\n3511\t* Expected result: the server connection ignores the bogus reset.\n3512\t*/\n3513\tint stateless_reset_client_test(void)\n3514\t{\n3515\t    uint64_t simulated_time = 0;\n3516\t    uint64_t loss_mask = 0;\n3517\t    picoquic_test_tls_api_ctx_t* test_ctx = NULL;\n3518\t    int ret = tls_api_init_ctx(&test_ctx, 0, PICOQUIC_TEST_SNI, PICOQUIC_TEST_ALPN, &simulated_time, NULL, NULL, 0, 0, 0);\n3519\t    uint8_t buffer[256];\n3520\t\n3521\t    if (ret == 0) {\n3522\t        ret = tls_api_connection_loop(test_ctx, &loss_mask, 0, &simulated_time);\n3523\t    }\n3524\t\n3525\t    /* Prepare the bogus reset */\n3526\t    if (ret == 0) {\n3527\t        size_t byte_index = 0;\n3528\t        buffer[byte_index++] = 0x41;\n3529\t        /* Copy the client ID */\n3530\t        byte_index += picoquic_format_connection_id(&buffer[byte_index], sizeof(buffer) - byte_index, test_ctx->cnx_server->path[0]->first_tuple->p_local_cnxid->cnx_id);\n3531\t        /* Change one byte of the client ID */\n3532\t        if (byte_index > 5) {\n3533\t            buffer[5] ^= 0xff;\n3534\t        }\n3535\t        else {\n3536\t            buffer[1] ^= 0xff;\n3537\t        }\n3538\t        /* rest of packet is null */\n3539\t        memset(buffer + byte_index, 0xcc, sizeof(buffer) - byte_index);\n3540\t\n3541\t        /* Submit bogus request to server */\n3542\t        ret = picoquic_incoming_packet(test_ctx->qserver, buffer, sizeof(buffer),\n3543\t            (struct sockaddr*)(&test_ctx->client_addr),\n3544\t            (struct sockaddr*)(&test_ctx->server_addr), 0, test_ctx->recv_ecn_server,\n3545\t            simulated_time);\n3546\t    }\n3547\t\n3548\t    /* check that the server is still up */\n3549\t    if (ret == 0 && test_ctx->cnx_server != NULL && test_ctx->cnx_server->cnx_state > picoquic_state_ready) {\n3550\t        ret = -1;\n3551\t    }\n3552\t\n3553\t    if (test_ctx != NULL) {\n3554\t        tls_api_delete_ctx(test_ctx);\n3555\t        test_ctx = NULL;\n3556\t    }\n3557\t\n3558\t    return ret;\n3559\t}\n3560\t\n3561\t\n3562\t/*\n3563\t* Server reset handshake test.\n3564\t* Verify that the server does not send a reset in response to\n3565\t* a bogus long header packet\n3566\t*/\n3567\tint stateless_reset_handshake_test(void)\n3568\t{\n3569\t    uint64_t simulated_time = 0;\n3570\t    uint64_t loss_mask = 0;\n3571\t    picoquic_test_tls_api_ctx_t* test_ctx = NULL;\n3572\t    int ret = tls_api_init_ctx(&test_ctx, 0, PICOQUIC_TEST_SNI, PICOQUIC_TEST_ALPN, &simulated_time, NULL, NULL, 0, 0, 0);\n3573\t    uint8_t buffer[256];\n3574\t\n3575\t    if (ret == 0) {\n3576\t        ret = tls_api_connection_loop(test_ctx, &loss_mask, 0, &simulated_time);\n3577\t    }\n3578\t\n3579\t    /* Prepare the bogus reset */\n3580\t    if (ret == 0) {\n3581\t        size_t byte_index = 0;\n3582\t        buffer[byte_index++] = 0xff;\n3583\t        buffer[byte_index++] = test_ctx->cnx_server->path[0]->first_tuple->p_local_cnxid->cnx_id.id_len;\n3584\t        buffer[byte_index++] = test_ctx->cnx_server->path[0]->first_tuple->p_remote_cnxid->cnx_id.id_len;\n3585\t        /* Copy the client ID */\n3586\t        byte_index += picoquic_format_connection_id(&buffer[byte_index], sizeof(buffer) - byte_index, test_ctx->cnx_server->path[0]->first_tuple->p_local_cnxid->cnx_id);\n3587\t        /* Change one byte of the client ID */\n3588\t        if (byte_index > 5) {\n3589\t            buffer[5] ^= 0xff;\n3590\t        }\n3591\t        else {\n3592\t            buffer[1] ^= 0xff;\n3593\t        }\n3594\t        /* Copy the server ID */\n3595\t        byte_index += picoquic_format_connection_id(&buffer[byte_index], sizeof(buffer) - byte_index, test_ctx->cnx_server->path[0]->first_tuple->p_remote_cnxid->cnx_id);\n3596\t        /* rest of packet is null */\n3597\t        memset(buffer + byte_index, 0xcc, sizeof(buffer) - byte_index);\n3598\t\n3599\t        /* Submit bogus request to server */\n3600\t        ret = picoquic_incoming_packet(test_ctx->qserver, buffer, sizeof(buffer),\n3601\t            (struct sockaddr*)(&test_ctx->client_addr),\n3602\t            (struct sockaddr*)(&test_ctx->server_addr), 0, test_ctx->recv_ecn_server,\n3603\t            simulated_time);\n3604\t    }\n3605\t\n3606\t    /* check that the server is still up */\n3607\t    if (ret == 0 && test_ctx->cnx_server != NULL && test_ctx->cnx_server->cnx_state > picoquic_state_ready) {\n3608\t        ret = -1;\n3609\t    }\n3610\t    /* Check that no stateless packet is queued */\n3611\t    if (ret == 0 && test_ctx->qserver->pending_stateless_packet != NULL) {\n3612\t        ret = -1;\n3613\t    }\n3614\t\n3615\t    if (test_ctx != NULL) {\n3616\t        tls_api_delete_ctx(test_ctx);\n3617\t        test_ctx = NULL;\n3618\t    }\n3619\t\n3620\t    return ret;\n3621\t}\n3622\t\n3623\t/* Immediate close. Test that a server can issue an immediate close,\n3624\t * and that the client eventually closes the connection. \n3625\t */\n3626\t\n3627\tint immediate_close_test(void)\n3628\t{\n3629\t    uint64_t simulated_time = 0;\n3630\t    uint64_t loss_mask = 0;\n3631\t    uint64_t nb_packet_sent_before_close = 0;\n3632\t    picoquic_test_tls_api_ctx_t* test_ctx = NULL;\n3633\t    int ret = tls_api_init_ctx(&test_ctx, 0, PICOQUIC_TEST_SNI, PICOQUIC_TEST_ALPN, &simulated_time, NULL, NULL, 0, 0, 0);\n3634\t    uint8_t buffer[128];\n3635\t    int was_active = 0;\n3636\t\n3637\t    if (ret == 0) {\n3638\t        ret = tls_api_connection_loop(test_ctx, &loss_mask, 0, &simulated_time);\n3639\t    }\n3640\t\n3641\t    if (ret == 0) {\n3642\t        ret = wait_client_connection_ready(test_ctx, &simulated_time);\n3643\t    }\n3644\t\n3645\t    /* Immediate close */\n3646\t    if (ret == 0) {\n3647\t        nb_packet_sent_before_close = test_ctx->cnx_server->nb_packets_sent;\n3648\t        picoquic_close_immediate(test_ctx->cnx_server);\n3649\t    }\n3650\t    /* Client sends some data, in order to test the connection */\n3651\t    if (ret == 0) {\n3652\t        memset(buffer, 0xaa, sizeof(buffer));\n3653\t        ret = picoquic_add_to_stream(test_ctx->cnx_client, 4,\n3654\t            buffer, sizeof(buffer), 1);\n3655\t    }\n3656\t\n3657\t    /* Perform a couple rounds of sending data */\n3658\t    for (int i = 0; ret == 0 && i < 256 ; i++) {\n3659\t        was_active = 0;\n3660\t\n3661\t        ret = tls_api_one_sim_round(test_ctx, &simulated_time, 0, &was_active);\n3662\t        if (test_ctx->cnx_client->cnx_state >= picoquic_state_disconnected) {\n3663\t            /* Client has noticed the disconnect */\n3664\t            ret = 0;\n3665\t            break;\n3666\t        }\n3667\t    }\n3668\t\n3669\t    /* Client and server should now be in state disconnected */\n3670\t    if (ret == 0 && test_ctx->cnx_client->cnx_state != picoquic_state_disconnected) {\n3671\t        ret = -1;\n3672\t    }\n3673\t\n3674\t    if (ret == 0 && test_ctx->cnx_server != NULL){\n3675\t        if (test_ctx->cnx_server->cnx_state != picoquic_state_disconnected) {\n3676\t            ret = -1;\n3677\t        }\n3678\t        else if (nb_packet_sent_before_close != test_ctx->cnx_server->nb_packets_sent)\n3679\t        {\n3680\t            ret = -1;\n3681\t        }\n3682\t    }\n3683\t\n3684\t    if (test_ctx != NULL) {\n3685\t        tls_api_delete_ctx(test_ctx);\n3686\t        test_ctx = NULL;\n3687\t    }\n3688\t\n3689\t    return ret;\n3690\t}\n3691\t\n3692\t/*\n3693\t * verify that a connection is correctly established after a stateless retry,\n3694\t * and then verify that retyr is not used if tickets are available.\n3695\t */\n3696\t\n3697\tstatic char const* token_file_name = \"retry_tests_tokens.bin\";\n3698\t\n3699\tint tls_retry_token_test_one(int token_mode, int dup_token)\n3700\t{\n3701\t    int ret = 0;\n3702\t    uint64_t simulated_time = 0;\n3703\t    uint64_t loss_mask = 0;\n3704\t    picoquic_test_tls_api_ctx_t* test_ctx = NULL;\n3705\t    /* ensure that the token file is empty */\n3706\t    FILE* F = picoquic_file_open(token_file_name, \"wb\");\n3707\t    if (F == NULL) {\n3708\t        ret = -1;\n3709\t    }\n3710\t    else {\n3711\t        F = picoquic_file_close(F);\n3712\t    }\n3713\t    \n3714\t    if (ret == 0) {\n3715\t        ret = tls_api_init_ctx(&test_ctx, 0, PICOQUIC_TEST_SNI, PICOQUIC_TEST_ALPN,\n3716\t            &simulated_time, NULL, token_file_name, 0, 0, 0);\n3717\t    }\n3718\t\n3719\t    if (ret == 0) {\n3720\t        /* Set the server in requested token mode -- either check or merely provide */\n3721\t        picoquic_set_cookie_mode(test_ctx->qserver, token_mode);\n3722\t        /* Try the connection */\n3723\t        ret = tls_api_connection_loop(test_ctx, &loss_mask, 0, &simulated_time);\n3724\t    }\n3725\t\n3726\t    if (ret == 0) {\n3727\t        /* Wait some time, so the connection can stabilize to ready state */\n3728\t        ret = tls_api_synch_to_empty_loop(test_ctx, &simulated_time, 2048, PICOQUIC_NB_PATH_TARGET, 1);\n3729\t    }\n3730\t\n3731\t    if (ret == 0) {\n3732\t        ret = tls_api_attempt_to_close(test_ctx, &simulated_time);\n3733\t    }\n3734\t\n3735\t    /* Now we remove the client connection and create a new one.\n3736\t     * Force the retry token flag, in case it was not set before, to ensure token retry mode.\n3737\t     */\n3738\t    if (ret == 0) {\n3739\t        picoquic_delete_cnx(test_ctx->cnx_client);\n3740\t        if (test_ctx->cnx_server != NULL) {\n3741\t            picoquic_delete_cnx(test_ctx->cnx_server);\n3742\t            test_ctx->cnx_server = NULL;\n3743\t        }\n3744\t        /* If testing token duplication, simulate previous use of token */\n3745\t        if (dup_token) {\n3746\t            uint8_t * token = NULL;\n3747\t            uint16_t token_length = 0;\n3748\t\n3749\t            ret = picoquic_get_token(test_ctx->qclient,\n3750\t                PICOQUIC_TEST_SNI, (uint16_t)strlen(PICOQUIC_TEST_SNI),\n3751\t                NULL, 0,\n3752\t                &token, &token_length, 0);\n3753\t            if (ret != 0){\n3754\t                DBG_PRINTF(\"picoquic_get_token returns %d\\n\", ret);\n3755\t            }\n3756\t            else {\n3757\t                uint8_t text[256];\n3758\t                size_t text_len = 256;\n3759\t                int is_new_token = 0;\n3760\t\n3761\t                ret = picoquic_server_decrypt_retry_token(test_ctx->qserver, (struct sockaddr*) & test_ctx->client_addr,\n3762\t                    &is_new_token, token, token_length, text, &text_len);\n3763\t                if (ret != 0) {\n3764\t                    DBG_PRINTF(\"cannot decrypt the token, ret= %d\\n\", ret);\n3765\t                }\n3766\t                else if (text_len < 8 ) {\n3767\t                    DBG_PRINTF(\"Token too short, len=%z\\n\", text_len);\n3768\t                    ret = -1;\n3769\t                }\n3770\t                else {\n3771\t                    uint64_t valid_until = PICOPARSE_64(text);\n3772\t                    ret = picoquic_registered_token_check_reuse(test_ctx->qserver, token, token_length, valid_until);\n3773\t                    if (ret != 0) {\n3774\t                        DBG_PRINTF(\"Token already registered, ret= %d\\n\", ret);\n3775\t                    }\n3776\t                }\n3777\t            }\n3778\t            if (token != NULL) {\n3779\t                free(token);\n3780\t            }\n3781\t        }\n3782\t\n3783\t        if (ret == 0) {\n3784\t            test_ctx->qserver->check_token = 1;\n3785\t\n3786\t            test_ctx->cnx_client = picoquic_create_cnx(test_ctx->qclient,\n3787\t                picoquic_null_connection_id, picoquic_null_connection_id,\n3788\t                (struct sockaddr*) & test_ctx->server_addr, simulated_time,\n3789\t                0, PICOQUIC_TEST_SNI, PICOQUIC_TEST_ALPN, 1);\n3790\t\n3791\t            if (test_ctx->cnx_client == NULL) {\n3792\t                ret = -1;\n3793\t            }\n3794\t            else {\n3795\t                ret = picoquic_start_client_cnx(test_ctx->cnx_client);\n3796\t            }\n3797\t        }\n3798\t    }\n3799\t\n3800\t    if (ret == 0) {\n3801\t        /* Try the new connection */\n3802\t        ret = tls_api_connection_loop(test_ctx, &loss_mask, 0, &simulated_time);\n3803\t\n3804\t        if (dup_token ) {\n3805\t            if (ret == 0 && test_ctx->cnx_client->cnx_state != picoquic_state_disconnected){\n3806\t                if (test_ctx->cnx_client->original_cnxid.id_len > 0) {\n3807\t                    /* Correct behavior, required a new token */\n3808\t                    ret = tls_api_attempt_to_close(test_ctx, &simulated_time);\n3809\t                }\n3810\t                else {\n3811\t                    ret = -1;\n3812\t                    DBG_PRINTF(\"Connection succeeds despite duplicate token, ret= %d\\n\", ret);\n3813\t                }\n3814\t            }\n3815\t        }\n3816\t        else {\n3817\t            if (ret == 0) {\n3818\t                ret = tls_api_attempt_to_close(test_ctx, &simulated_time);\n3819\t            }\n3820\t\n3821\t            if (ret == 0 && test_ctx->cnx_client->original_cnxid.id_len != 0) {\n3822\t                DBG_PRINTF(\"Second retry did not use the stored token, odcil len=%d\\n\",\n3823\t                    test_ctx->cnx_client->original_cnxid.id_len);\n3824\t                ret = -1;\n3825\t            }\n3826\t        }\n3827\t    }\n3828\t    if (ret == 0) {\n3829\t        /* Not strictly needed, but allows for inspection */\n3830\t        ret = picoquic_save_tokens(test_ctx->qclient, token_file_name);\n3831\t    }\n3832\t\n3833\t    if (test_ctx != NULL) {\n3834\t        tls_api_delete_ctx(test_ctx);\n3835\t        test_ctx = NULL;\n3836\t    }\n3837\t\n3838\t    return ret;\n3839\t}\n3840\t\n3841\tint tls_retry_token_test(void)\n3842\t{\n3843\t    int ret = tls_retry_token_test_one(1,0);\n3844\t\n3845\t    if (ret != 0) {\n3846\t        DBG_PRINTF(\"Retry token test returns %d\", ret);\n3847\t    }\n3848\t    else {\n3849\t        ret = tls_retry_token_test_one(2,0);\n3850\t\n3851\t        if (ret != 0) {\n3852\t            DBG_PRINTF(\"Provide token test returns %d\", ret);\n3853\t        }\n3854\t        else {\n3855\t            ret = tls_retry_token_test_one(1, 1);\n3856\t            if (ret != 0){\n3857\t                DBG_PRINTF(\"Duplicate token test returns %d\", ret);\n3858\t            }\n3859\t        }\n3860\t    }\n3861\t\n3862\t    return ret;\n3863\t}\n3864\t\n3865\t/* Unit test of token validation */\n3866\tint tls_retry_token_valid_test(void)\n3867\t{\n3868\t    int ret = 0;\n3869\t    int is_new_token = 0;\n3870\t    struct sockaddr_in addr1, addr2, addr3;\n3871\t    struct sockaddr* addr[3];\n3872\t    picoquic_connection_id_t n_cid = picoquic_null_connection_id;\n3873\t    picoquic_connection_id_t cid1 = { { 1,1,1,1,1,1,1,1}, 8 };\n3874\t    picoquic_connection_id_t cid2 = { { 2,2,2,2,2,2,2,2,2}, 9 };\n3875\t    picoquic_connection_id_t* cid[3];\n3876\t    picoquic_connection_id_t cid_o = { { 3,3,3,3,3,3,3,3}, 8 };\n3877\t    picoquic_connection_id_t* odcid[2];\n3878\t    picoquic_connection_id_t odcid_found;\n3879\t    uint64_t time_base = 10000;\n3880\t    uint64_t time_delta[4] = { 0, 0, PICOQUIC_TOKEN_DELAY_SHORT + 1,\n3881\t        PICOQUIC_TOKEN_DELAY_LONG + 1000000 };\n3882\t    uint32_t pn[3] = { 0, 1, 2 };\n3883\t    uint8_t token_buffer[128];\n3884\t    size_t token_size;\n3885\t    int verified;\n3886\t    picoquic_quic_t * quic = picoquic_create(8, NULL, NULL, NULL, PICOQUIC_TEST_ALPN, NULL, NULL, NULL, NULL, NULL,\n3887\t        time_base*1000000, NULL, NULL, test_ticket_encrypt_key, sizeof(test_ticket_encrypt_key));\n3888\t\n3889\t    if (quic == NULL) {\n3890\t        return -1;\n3891\t    }\n3892\t\n3893\t    picoquic_set_test_address(&addr1, 0x01010101, 1234);\n3894\t    picoquic_set_test_address(&addr2, 0x01010101, 3456);\n3895\t    picoquic_set_test_address(&addr3, 0x03030303, 1234);\n3896\t    addr[0] = (struct sockaddr*) & addr1;\n3897\t    addr[1] = (struct sockaddr*) & addr2;\n3898\t    addr[2] = (struct sockaddr*) & addr3;\n3899\t    cid[0] = &cid1;\n3900\t    cid[1] = &n_cid;\n3901\t    cid[2] = &cid2;\n3902\t    odcid[0] = &cid_o;\n3903\t    odcid[1] = &n_cid;\n3904\t\n3905\t    /* Test of a connection token\n3906\t     * - Create a token with test address, time1, cid1, pn1.\n3907\t     * - Check with time-0 (valid), time1(valid), time2(invalid)\n3908\t     * - Check with addr1,port1 (valid), addr1,port2 (valid), addr2,port1(invalid)\n3909\t     * - Check with pn2 (valid), pn1(invalid)\n3910\t     * - check with cid1 (valid), cid2(invalid)\n3911\t     */\n3912\t\n3913\t     /* Test of a new token\n3914\t      * - Create a token with test address, time1, n_cid, pn1.\n3915\t      * - Check with time-0 (valid), time1(valid), time2(invalid)\n3916\t      * - Check with addr1,port1 (valid), addr1,port2 (valid), addr2,port1(invalid)\n3917\t      * - Check with pn2 (valid), pn1(valid)\n3918\t      * - check with cid1 (valid), cid2(valid)\n3919\t      */\n3920\t\n3921\t    /* Test of an invalid token: valid token with changed bytes */\n3922\t\n3923\t    for (int token_mode = 0; ret == 0 && token_mode < 2; token_mode++) {\n3924\t        if (picoquic_prepare_retry_token(quic, addr[0], time_base * 1000000 + time_delta[1], odcid[token_mode],\n3925\t            cid[token_mode], pn[1],\n3926\t            token_buffer, sizeof(token_buffer), &token_size) != 0) {\n3927\t            ret = PICOQUIC_ERROR_MEMORY;\n3928\t        }\n3929\t\n3930\t        if (ret == 0) {\n3931\t            verified = picoquic_verify_retry_token(quic, addr[0], time_base * 1000000 + time_delta[0],\n3932\t                &is_new_token, &odcid_found, cid[0], pn[2],\n3933\t                token_buffer, token_size, 0);\n3934\t            if (verified != 0) {\n3935\t                DBG_PRINTF(\"%s\", \"Token validation fails for normal parameters\\n\");\n3936\t                ret = -1;\n3937\t            }\n3938\t            else if (token_mode == 0 && picoquic_compare_connection_id(odcid[0], &odcid_found) != 0) {\n3939\t                DBG_PRINTF(\"%s\", \"ODCID validation fails\\n\");\n3940\t                ret = -1;\n3941\t            }\n3942\t            else if (token_mode == 1 && odcid_found.id_len > 0) {\n3943\t                DBG_PRINTF(\"%s\", \"Spurious ODCID\\n\");\n3944\t                ret = -1;\n3945\t            }\n3946\t            else if (!is_new_token && odcid[token_mode]->id_len == 0) {\n3947\t                DBG_PRINTF(\"%s\", \"Wrongly recognized as new token\\n\");\n3948\t                ret = -1;\n3949\t            }\n3950\t            else if (is_new_token && odcid[token_mode]->id_len > 0) {\n3951\t                DBG_PRINTF(\"%s\", \"Wrongly recognized as retry token\\n\");\n3952\t                ret = -1;\n3953\t            }\n3954\t        }\n3955\t\n3956\t        if (ret == 0 && picoquic_verify_retry_token(quic, addr[0], time_base * 1000000 + time_delta[2 + token_mode],\n3957\t            &is_new_token, &odcid_found, cid[0], pn[2],\n3958\t            token_buffer, token_size, 0) == 0) {\n3959\t            DBG_PRINTF(\"%s\", \"Token validation does not detect elapsed time.\\n\");\n3960\t            ret = -1;\n3961\t        }\n3962\t\n3963\t        if (ret == 0) {\n3964\t            verified = picoquic_verify_retry_token(quic, addr[0], time_base * 1000000 + time_delta[0],\n3965\t                &is_new_token, &odcid_found, cid[2], pn[2],\n3966\t                token_buffer, token_size, 0);\n3967\t            if (token_mode == 0 && verified == 0) {\n3968\t                DBG_PRINTF(\"%s\", \"RCID invalidation fails\\n\");\n3969\t                ret = -1;\n3970\t            }\n3971\t            else if (token_mode == 1 && verified != 0) {\n3972\t                DBG_PRINTF(\"%s\", \"Spurious RCID invalidation\\n\");\n3973\t                ret = -1;\n3974\t            }\n3975\t        }\n3976\t\n3977\t        for (int pn_id = 0; ret == 0 && pn_id < 2; pn_id++) {\n3978\t            verified = picoquic_verify_retry_token(quic, addr[0], time_base * 1000000 + time_delta[0],\n3979\t                &is_new_token, &odcid_found, cid[0], pn[pn_id],\n3980\t                token_buffer, token_size, 0);\n3981\t            if (token_mode == 0 && verified == 0) {\n3982\t                DBG_PRINTF(\"%s\", \"PN invalidation fails\\n\");\n3983\t                ret = -1;\n3984\t            }\n3985\t            else if (token_mode == 1 && verified != 0) {\n3986\t                DBG_PRINTF(\"%s\", \"Spurious PN invalidation\\n\");\n3987\t                ret = -1;\n3988\t            }\n3989\t        }\n3990\t\n3991\t        /* test of an invalid token, overly long */\n3992\t        if (ret == 0 && token_mode == 0) {\n3993\t            uint8_t big_token[PICOQUIC_MAX_PACKET_SIZE];\n3994\t            if (token_size < sizeof(big_token)) {\n3995\t                memcpy(big_token, token_buffer, token_size);\n3996\t                memset(big_token + token_size, 0xa5, sizeof(big_token) - token_size);\n3997\t                verified = picoquic_verify_retry_token(quic, addr[0], time_base * 1000000 + time_delta[0],\n3998\t  