mulated_time, ticket_file_name);\n4395\t\n4396\t    for (int i = 0; i < 2; i++) {\n4397\t        /* Insert a delay before the second connection attempt */\n4398\t        if (i == 1) {\n4399\t            simulated_time += zrt->extra_delay;\n4400\t        }\n4401\t        /* Set up the context, while setting the ticket store parameter for the client */\n4402\t        if (ret == 0) {\n4403\t            ret = tls_api_init_ctx(&test_ctx, \n4404\t                (i==0)?0: proposed_version, sni, alpn, &simulated_time, ticket_file_name, NULL, 0, 1,\n4405\t                (i == 0)?0: zrt->use_badcrypt);\n4406\t\n4407\t            if (ret == 0 && zrt->no_coal) {\n4408\t                test_ctx->qserver->dont_coalesce_init = 1;\n4409\t            }\n4410\t\n4411\t            if (ret == 0 && zrt->hardreset != 0 && i == 1) {\n4412\t                picoquic_set_cookie_mode(test_ctx->qserver, 1);\n4413\t            }\n4414\t\n4415\t            if (ret == 0 && zrt->do_multipath) {\n4416\t                /* Set the multipath option at both client and server */\n4417\t                multipath_init_params(&server_parameters, 0);\n4418\t                picoquic_set_default_tp(test_ctx->qserver, &server_parameters);\n4419\t                test_ctx->cnx_client->local_parameters.initial_max_path_id = 3;\n4420\t                test_ctx->cnx_client->local_parameters.enable_time_stamp = 0;\n4421\t            }\n4422\t\n4423\t            if (ret == 0 && i > 0 && zrt->change_params) {\n4424\t                test_ctx->qserver->default_tp.initial_max_data -= 1;\n4425\t                test_ctx->qserver->default_tp.initial_max_stream_id_bidir += 1;\n4426\t            }\n4427\t\n4428\t            if (ret == 0 && zrt->propose_ech) {\n4429\t                ret = picoquic_ech_configure_quic_ctx(test_ctx->qclient, NULL, NULL);\n4430\t            }\n4431\t\n4432\t            if (ret == 0) {\n4433\t                /* Initialize the client connection */\n4434\t                picoquic_start_client_cnx(test_ctx->cnx_client);\n4435\t            }\n4436\t        }\n4437\t\n4438\t        if (ret == 0 && i == 1) {\n4439\t            /* set the link delays to 100 ms, for realistic testing */\n4440\t            test_ctx->c_to_s_link->microsec_latency = 50000ull;\n4441\t            test_ctx->s_to_c_link->microsec_latency = 50000ull;\n4442\t\n4443\t            if (zrt->long_data) {\n4444\t                for (uint64_t x = 0; x <= 16; x++) {\n4445\t                    uint64_t stream_id = 4u * x + 4u;\n4446\t                    test_ctx->nb_test_streams = (size_t)(x + 1);\n4447\t                    if (test_api_init_test_stream(&test_ctx->test_stream[x], stream_id, UINT64_MAX, 256, 32) != 0){\n4448\t                        DBG_PRINTF(\"Could not initialize data for stream %d\", (int)stream_id);\n4449\t                        ret = -1;\n4450\t                    }\n4451\t                    /* Queue an initial frame on each stream */\n4452\t                    if (picoquic_add_to_stream(test_ctx->cnx_client, stream_id, \n4453\t                        test_ctx->test_stream[x].q_src, test_ctx->test_stream[x].q_len, 1) != 0) {\n4454\t                        DBG_PRINTF(\"Could not write data for stream %d\", (int)stream_id);\n4455\t                        ret = -1;\n4456\t                    }\n4457\t                }\n4458\t            }\n4459\t            else {\n4460\t                uint8_t test_data[8] = { 't', 'e', 's', 't', '0', 'r', 't', 't' };\n4461\t                /* Queue an initial frame on the client connection */\n4462\t                if (picoquic_add_to_stream(test_ctx->cnx_client, 0, test_data, sizeof(test_data), 1) != 0) {\n4463\t                    DBG_PRINTF(\"Could not write data for stream %d\", 0);\n4464\t                    ret = -1;\n4465\t                }\n4466\t            }\n4467\t\n4468\t            if (zrt->early_loss > 0) {\n4469\t                loss_mask = zrt->early_loss;\n4470\t            }\n4471\t        }\n4472\t\n4473\t        if (ret == 0) {\n4474\t            ret = tls_api_connection_loop(test_ctx, &loss_mask, 0, &simulated_time);\n4475\t\n4476\t            if (ret != 0) {\n4477\t                DBG_PRINTF(\"Zero RTT test (badcrypt: %d, hard: %d), connection %d fails (0x%x)\\n\",\n4478\t                    zrt->use_badcrypt, zrt->hardreset, i, ret);\n4479\t            }\n4480\t        }\n4481\t\n4482\t        if (ret == 0 && zrt->use_badcrypt == 0 && zrt->hardreset == 0 && zrt->change_params == 0) {\n4483\t            int rtt_is_available = picoquic_is_0rtt_available(test_ctx->cnx_client);\n4484\t\n4485\t            if ((rtt_is_available && i == 0) ||\n4486\t                (!rtt_is_available && i != 0)) {\n4487\t                ret = -1;\n4488\t            }\n4489\t        }\n4490\t\n4491\t        if (ret == 0 && i == 1) {\n4492\t            /* If resume succeeded, the second connection will have a type \"PSK\" */\n4493\t            if (zrt->use_badcrypt == 0 && zrt->hardreset == 0 && zrt->change_params == 0 && (\n4494\t                picoquic_tls_is_psk_handshake(test_ctx->cnx_server) == 0 || \n4495\t                picoquic_tls_is_psk_handshake(test_ctx->cnx_client) == 0)) {\n4496\t                DBG_PRINTF(\"Zero RTT test (badcrypt: %d, hard: %d, change: %d), connection %d not PSK.\\n\",\n4497\t                    zrt->use_badcrypt, zrt->hardreset, zrt->change_params, i);\n4498\t                ret = -1;\n4499\t            } else {\n4500\t                /* run a receive loop until no outstanding data */\n4501\t                ret = tls_api_synch_to_empty_loop(test_ctx, &simulated_time, 2048, 0, 0);\n4502\t            }\n4503\t        }\n4504\t\n4505\t        if (ret == 0 && i == 1 && zrt->do_multipath) {\n4506\t            /* verify that multipath was negotiated */\n4507\t            if (!test_ctx->cnx_client->is_multipath_enabled ||\n4508\t                !test_ctx->cnx_server->is_multipath_enabled) {\n4509\t                DBG_PRINTF(\"Zero RTT test, multipath not negotiated (client: %d, server: %d).\\n\",\n4510\t                    test_ctx->cnx_client->is_multipath_enabled,\n4511\t                    test_ctx->cnx_server->is_multipath_enabled);\n4512\t                ret = -1;\n4513\t            }\n4514\t        }\n4515\t\n4516\t        if (ret == 0) {\n4517\t            if (i == 0) {\n4518\t                /* Before closing, wait for the session ticket to arrive */\n4519\t                ret = session_resume_wait_for_ticket(test_ctx, &simulated_time);\n4520\t            }\n4521\t            else {\n4522\t                /* Before closing, wait for all data to be acknowledged, etc. */\n4523\t                ret = tls_api_synch_to_empty_loop(test_ctx, &simulated_time, 2048, 0, 1);\n4524\t            }\n4525\t        }\n4526\t\n4527\t        if (ret == 0) {\n4528\t            ret = tls_api_attempt_to_close(test_ctx, &simulated_time);\n4529\t\n4530\t            if (ret != 0) {\n4531\t                DBG_PRINTF(\"Zero RTT test (badcrypt: %d, hard: %d), connection %d close error (0x%x).\\n\",\n4532\t                    zrt->use_badcrypt, zrt->hardreset, i, ret);\n4533\t            }\n4534\t        }\n4535\t\n4536\t        /* Verify that the 0RTT data was sent and acknowledged */\n4537\t        if (ret == 0 && i == 1) {\n4538\t            if (zrt->use_badcrypt == 0 && zrt->hardreset == 0 && zrt->change_params == 0) {\n4539\t                if (test_ctx->cnx_client->nb_zero_rtt_sent == 0) {\n4540\t                    DBG_PRINTF(\"Zero RTT test (badcrypt: %d, hard: %d), no zero RTT sent.\\n\",\n4541\t                        zrt->use_badcrypt, zrt->hardreset);\n4542\t                    ret = -1;\n4543\t                }\n4544\t                else if (zrt->early_loss == 0 &&\n4545\t                    test_ctx->cnx_client->nb_zero_rtt_acked != test_ctx->cnx_client->nb_zero_rtt_sent) {\n4546\t                    DBG_PRINTF(\"Zero RTT test (badcrypt: %d, hard: %d), no zero RTT acked.\\n\",\n4547\t                        zrt->use_badcrypt, zrt->hardreset);\n4548\t                    ret = -1;\n4549\t                }\n4550\t                else if (zrt->early_loss == 0 && zrt->no_coal && test_ctx->cnx_server != NULL &&\n4551\t                        test_ctx->cnx_client->nb_zero_rtt_sent != test_ctx->cnx_server->nb_zero_rtt_received) {\n4552\t                    DBG_PRINTF(\"Zero RTT test sent %d 0RTT, received %d\\n\",\n4553\t                        test_ctx->cnx_client->nb_zero_rtt_sent, test_ctx->cnx_server->nb_zero_rtt_received);\n4554\t                    ret = -1;\n4555\t                }\n4556\t                else if (zrt->long_data && test_ctx->cnx_client->nb_zero_rtt_sent < 3) {\n4557\t                    DBG_PRINTF(\"Zero RTT long test (badcrypt: %d, hard: %d), only %d zero RTT sent.\\n\",\n4558\t                        zrt->use_badcrypt, zrt->hardreset, (int)test_ctx->cnx_client->nb_zero_rtt_sent);\n4559\t                    ret = -1;\n4560\t                }\n4561\t            } else {\n4562\t                if (test_ctx->cnx_client->nb_zero_rtt_sent == 0) {\n4563\t                    DBG_PRINTF(\"Zero RTT test (badcrypt: %d, hard: %d, change: %d), no zero RTT sent.\\n\",\n4564\t                        zrt->use_badcrypt, zrt->hardreset, zrt->change_params);\n4565\t                    ret = -1;\n4566\t                }\n4567\t                else if ((zrt->early_loss || zrt->change_params) && test_ctx->cnx_client->nb_zero_rtt_acked != 0) {\n4568\t                    DBG_PRINTF(\"Zero RTT test (badcrypt: %d, change : %d), zero rtt acked, not expected.\\n\",\n4569\t                        zrt->use_badcrypt, zrt->change_params);\n4570\t                    ret = -1;\n4571\t                }\n4572\t                else if (test_ctx->sum_data_received_at_server == 0) {\n4573\t                    DBG_PRINTF(\"Zero RTT test (badcrypt: %d, hard: %d, loss: %d), no data received.\\n\",\n4574\t                        zrt->use_badcrypt, zrt->hardreset, zrt->early_loss);\n4575\t                    ret = -1;\n4576\t                }\n4577\t                else if (test_ctx->cnx_client->did_receive_short_initial) {\n4578\t                    DBG_PRINTF(\"Zero RTT test (badcrypt: %d, hard: %d), server sent unpadded initial.\\n\",\n4579\t                        zrt->use_badcrypt, zrt->hardreset);\n4580\t                    ret = -1;\n4581\t                }\n4582\t            }\n4583\t        }\n4584\t\n4585\t        /* Verify that the session ticket has been received correctly */\n4586\t        if (ret == 0) {\n4587\t            if (test_ctx->qclient->p_first_ticket == NULL) {\n4588\t                DBG_PRINTF(\"Zero RTT test (badcrypt: %d, hard: %d), cnx %d, no ticket received.\\n\",\n4589\t                    zrt->use_badcrypt, zrt->hardreset, i);\n4590\t                ret = -1;\n4591\t            } else {\n4592\t                ret = picoquic_save_tickets(test_ctx->qclient->p_first_ticket, simulated_time, ticket_file_name);\n4593\t                if (ret != 0) {\n4594\t                    DBG_PRINTF(\"Zero RTT test (badcrypt: %d, hard: %d), cnx %d, ticket save error (0x%x).\\n\",\n4595\t                        zrt->use_badcrypt, zrt->hardreset, i, ret);\n4596\t                }\n4597\t            }\n4598\t        }\n4599\t\n4600\t        /* Tear down and free everything */\n4601\t        if (test_ctx != NULL) {\n4602\t            tls_api_delete_ctx(test_ctx);\n4603\t            test_ctx = NULL;\n4604\t        }\n4605\t    }\n4606\t\n4607\t    return ret;\n4608\t}\n4609\t\n4610\t/* \n4611\t* Basic 0-RTT test. Verify that things work in the absence of loss \n4612\t*/\n4613\t\n4614\tint zero_rtt_test(void)\n4615\t{\n4616\t    zero_rtt_test_t zrt = { 0 };\n4617\t    return zero_rtt_test_one(&zrt);\n4618\t}\n4619\t\n4620\t/*\n4621\t* zero rtt test with losses. Verify that the connection setup works even \n4622\t* if packets are lost. The \"loss test\" indicates which packet will be lost\n4623\t* during the exchange. As the code stands for draft-13, the EOED is sent in\n4624\t* a zero RTT packet, the 9th packet on the connection. This order is\n4625\t* however very dependent on the details of the implementation. To be on the safe\n4626\t* side, we should repeat the test while emulating the loss of any packet\n4627\t* between 1 and 16.\n4628\t*/\n4629\t\n4630\tint zero_rtt_loss_test(void)\n4631\t{\n4632\t    int ret = 0;\n4633\t\n4634\t    for (unsigned int i = 1; ret == 0 && i < 16; i++) {\n4635\t        zero_rtt_test_t zrt = { 0 };\n4636\t        zrt.early_loss = 1ull << i;\n4637\t\n4638\t        ret = zero_rtt_test_one(&zrt);\n4639\t        if (ret != 0) {\n4640\t            DBG_PRINTF(\"Zero RTT test fails when packet #%d is lost.\\n\", i);\n4641\t        }\n4642\t    }\n4643\t\n4644\t    return ret;\n4645\t}\n4646\t/*\n4647\t* Zero Spurious RTT test.\n4648\t* Check what happens if the client attempts to resume a connection using a bogus ticket.\n4649\t* This will cause a connection retry of some kind, the 0rtt packet will be lost.\n4650\t* This is simulated by runnig the zero-rtt code, but using a different\n4651\t* ticket key for the second server instance.\n4652\t*/\n4653\t\n4654\tint zero_rtt_spurious_test(void)\n4655\t{\n4656\t    zero_rtt_test_t zrt = { 0 };\n4657\t    zrt.use_badcrypt = 1;\n4658\t    return zero_rtt_test_one(&zrt);\n4659\t}\n4660\t\n4661\t\n4662\t/*\n4663\t* Zero RTT bad param test.\n4664\t* Check what happens if the client attempts to resume a connection using a ticket\n4665\t* issued on a previous instance, and the default TP parameters have changed.\n4666\t* We expect that the connection will not use 0RTT.\n4667\t*/\n4668\t\n4669\tint zero_rtt_bad_param_test(void)\n4670\t{\n4671\t    zero_rtt_test_t zrt = { 0 };\n4672\t    zrt.change_params = 1;\n4673\t    return zero_rtt_test_one(&zrt);\n4674\t}\n4675\t\n4676\t/*\n4677\t* Zero RTT Retry test.\n4678\t* Check what happens if the client attempts to resume a connection but the\n4679\t* server responds with a retry. This is simulated by activating the retry\n4680\t* mode on the server between the 2 client connections.\n4681\t*/\n4682\t\n4683\tint zero_rtt_retry_test(void)\n4684\t{\n4685\t    zero_rtt_test_t zrt = { 0 };\n4686\t    zrt.hardreset = 1;\n4687\t    return zero_rtt_test_one(&zrt);\n4688\t}\n4689\t\n4690\t/*\n4691\t* Zero RTT No Coalesced Packets test\n4692\t* Check what happens if the server does not coalesce packets.\n4693\t* We expect the client to send an ACK of the Initial packet, and if\n4694\t* zero RTT is enabled to add a padded 0-RTT packet\n4695\t*/\n4696\t\n4697\tint zero_rtt_no_coal_test(void)\n4698\t{\n4699\t    zero_rtt_test_t zrt = { 0 };\n4700\t    zrt.no_coal = 1;\n4701\t    return zero_rtt_test_one(&zrt);\n4702\t}\n4703\t\n4704\t/* Test the robustness of the connection in a zero RTT scenario,\n4705\t * which uses a slightly different path than the regular connections.\n4706\t * We test that 50 connections succeed in presence of 30% packet drops.\n4707\t */\n4708\t\n4709\tint zero_rtt_many_losses_test(void)\n4710\t{\n4711\t    int ret = 0;\n4712\t    uint64_t random_context = 0x1055ca45c001babaull;\n4713\t\n4714\t    for (int i = 0; ret == 0 && i < 50; i++)\n4715\t    {\n4716\t        uint64_t loss_mask = 0;\n4717\t        zero_rtt_test_t zrt = { 0 };\n4718\t\n4719\t        for (int j = 0; j < 64; j++)\n4720\t        {\n4721\t            loss_mask <<= 1;\n4722\t\n4723\t            if (picoquic_test_uniform_random(&random_context, 1000) < 300) {\n4724\t                loss_mask |= 1;\n4725\t            }\n4726\t        }\n4727\t        zrt.early_loss = loss_mask;\n4728\t        ret = zero_rtt_test_one(&zrt);\n4729\t        if (ret != 0) {\n4730\t            DBG_PRINTF(\"Handshake fails for mask %d, mask = %llx\", i, (unsigned long long)loss_mask);\n4731\t        }\n4732\t    }\n4733\t    return ret;\n4734\t}\n4735\t\n4736\t/*\n4737\t* 0-RTT long test. Verify that the client can send several 0-RTT packets\n4738\t*/\n4739\t\n4740\tint zero_rtt_long_test(void)\n4741\t{\n4742\t    zero_rtt_test_t zrt = { 0 };\n4743\t    zrt.long_data = 1;\n4744\t    return zero_rtt_test_one(&zrt);\n4745\t}\n4746\t\n4747\t/*\n4748\t* 0-RTT delay test. Verify that the tickets as old as the specified delay are still accepted.\n4749\t*/\n4750\t\n4751\tint zero_rtt_delay_test(void)\n4752\t{\n4753\t    int ret = 0;\n4754\t    int bad_ret;\n4755\t    const uint64_t nominal_delay_sec = 100000;\n4756\t    const uint64_t nominal_delay = nominal_delay_sec * 1000000;\n4757\t    zero_rtt_test_t zrt = { 0 };\n4758\t    zrt.long_data = 1;\n4759\t    zrt.extra_delay = nominal_delay + 1000000;\n4760\t\n4761\t    bad_ret = zero_rtt_test_one(&zrt);\n4762\t    if (bad_ret == 0) {\n4763\t        DBG_PRINTF(\"Zero RTT succeed despite delay = %\" PRIu64, \" + 1 second.\", nominal_delay_sec);\n4764\t        ret = -1;\n4765\t    }\n4766\t    else {\n4767\t        zrt.extra_delay = nominal_delay - 2000000;\n4768\t        ret = zero_rtt_test_one(&zrt);\n4769\t        if (ret != 0) {\n4770\t            DBG_PRINTF(\"Zero RTT fails for delay = %\" PRIu64, \" - 2 seconds.\", nominal_delay_sec);\n4771\t        }\n4772\t    }\n4773\t\n4774\t    return ret;\n4775\t}\n4776\t\n4777\t/*\n4778\t* 0-RTT ech. Verify that the 0 RTT works even greasing ech\n4779\t*/\n4780\t\n4781\tint zero_rtt_ech_test(void)\n4782\t{\n4783\t    zero_rtt_test_t zrt = { 0 };\n4784\t    zrt.propose_ech = 1;\n4785\t    return zero_rtt_test_one(&zrt);\n4786\t}\n4787\t\n4788\t/*\n4789\t * Stop sending test. Start a long transmission, but after receiving some bytes,\n4790\t * send a stop sending request. Then ask for another transmission. The\n4791\t * test succeeds if only few bytes of the first are received, and all bytes\n4792\t * of the second.\n4793\t * \n4794\t * The same code is used to test the \"stream discard\" test, creates a reset\n4795\t * and a stop sending in a single call.\n4796\t */\n4797\t\n4798\tint stop_sending_test_one(int discard, int reset_loss)\n4799\t{\n4800\t    uint64_t simulated_time = 0;\n4801\t    const uint64_t stop_sending_latency = 100000;\n4802\t    uint64_t loss_mask = 0x0F0F0F0F0F000000ull;\n4803\t    picoquic_test_tls_api_ctx_t* test_ctx = NULL;\n4804\t    int ret = tls_api_init_ctx(&test_ctx, PICOQUIC_INTERNAL_TEST_VERSION_1,\n4805\t        PICOQUIC_TEST_SNI, PICOQUIC_TEST_ALPN, &simulated_time, NULL, NULL, 0, 0, 0);\n4806\t    int nb_initial_loop = 0;\n4807\t\n4808\t    if (ret == 0) {\n4809\t        /* Set long delays, in order to test potential leaks of node structure */\n4810\t        test_ctx->c_to_s_link->microsec_latency = stop_sending_latency;\n4811\t        test_ctx->s_to_c_link->microsec_latency = stop_sending_latency;\n4812\t    }\n4813\t\n4814\t    if (ret == 0) {\n4815\t        ret = tls_api_connection_loop(test_ctx, &loss_mask, 0, &simulated_time);\n4816\t    }\n4817\t\n4818\t    /* Prepare to send data */\n4819\t    if (ret == 0) {\n4820\t        ret = test_api_init_send_recv_scenario(test_ctx, test_scenario_stop_sending, sizeof(test_scenario_stop_sending));\n4821\t    }\n4822\t\n4823\t    /* Perform a data sending loop for a few rounds, until some bytes are received on the first stream */\n4824\t    while (ret == 0 && nb_initial_loop < 64) {\n4825\t        nb_initial_loop++;\n4826\t\n4827\t        ret = tls_api_data_sending_loop(test_ctx, &loss_mask, &simulated_time, 16);\n4828\t\n4829\t        if (test_ctx->test_stream[0].r_recv_nb != 0) {\n4830\t            break;\n4831\t        }\n4832\t    }\n4833\t\n4834\t    /* issue the stop sending command */\n4835\t    if (ret == 0 && test_ctx->cnx_client != NULL) {\n4836\t        if (discard) {\n4837\t            ret = picoquic_discard_stream(test_ctx->cnx_client, test_scenario_stop_sending[0].stream_id, 1);\n4838\t            /* discarding the stream causes end of notifications, so we\n4839\t             * simulate a reset notification */\n4840\t            if (test_api_callback(test_ctx->cnx_client, test_scenario_stop_sending[0].stream_id,\n4841\t                NULL, 0, picoquic_callback_stream_reset, (void*)&test_ctx->client_callback, NULL) != 0) {\n4842\t                ret = -1;\n4843\t            }\n4844\t        }\n4845\t        else {\n4846\t            ret = picoquic_stop_sending(test_ctx->cnx_client, test_scenario_stop_sending[0].stream_id, 1);\n4847\t        }\n4848\t    }\n4849\t\n4850\t    /* resume the sending scenario */\n4851\t    if (ret == 0) {\n4852\t        if (reset_loss) {\n4853\t            /* Mask is calibrated to cause loss of the reset packet.\n4854\t             * This could be replaced by a specialized wait loop up to the\n4855\t             * point when the stop sending packet has been received.\n4856\t             */\n4857\t            loss_mask = 0x00FC0000000ull;\n4858\t        }\n4859\t        ret = tls_api_data_sending_loop(test_ctx, &loss_mask, &simulated_time, 0);\n4860\t    }\n4861\t\n4862\t    if (ret == 0) {\n4863\t        if (test_ctx->server_callback.error_detected) {\n4864\t            ret = -1;\n4865\t        } else if (test_ctx->client_callback.error_detected) {\n4866\t            ret = -1;\n4867\t        } else {\n4868\t            for (size_t i = 0; ret == 0 && i < test_ctx->nb_test_streams; i++) {\n4869\t                if (test_ctx->test_stream[i].q_recv_nb != test_ctx->test_stream[i].q_len) {\n4870\t                    ret = -1;\n4871\t                } else if (i == 0 && test_ctx->test_stream[i].r_recv_nb == test_ctx->test_stream[i].r_len) {\n4872\t                    ret = -1;\n4873\t                } else if (i != 0 && test_ctx->test_stream[i].r_recv_nb != test_ctx->test_stream[i].r_len) {\n4874\t                    ret = -1;\n4875\t                } else if (test_ctx->test_stream[i].q_received == 0 || test_ctx->test_stream[i].r_received == 0) {\n4876\t                    ret = -1;\n4877\t                }\n4878\t            }\n4879\t        }\n4880\t    }\n4881\t\n4882\t    if (ret == 0 && test_ctx->qclient->nb_data_nodes_allocated > test_ctx->qclient->nb_data_nodes_in_pool) {\n4883\t        ret = -1;\n4884\t    }\n4885\t    else if (ret == 0 && test_ctx->qserver->nb_data_nodes_allocated > test_ctx->qserver->nb_data_nodes_in_pool) {\n4886\t        ret = -1;\n4887\t    }\n4888\t\n4889\t    if (ret == 0) {\n4890\t        ret = picoquic_close(test_ctx->cnx_client, 0);\n4891\t    }\n4892\t\n4893\t    if (test_ctx != NULL) {\n4894\t        tls_api_delete_ctx(test_ctx);\n4895\t        test_ctx = NULL;\n4896\t    }\n4897\t\n4898\t    return ret;\n4899\t}\n4900\t\n4901\tint stop_sending_test(void)\n4902\t{\n4903\t    int ret = stop_sending_test_one(0, 0);\n4904\t    return ret;\n4905\t}\n4906\t\n4907\tint stop_sending_loss_test(void)\n4908\t{\n4909\t    int ret = stop_sending_test_one(0, 1);\n4910\t    return ret;\n4911\t}\n4912\t\n4913\tint discard_stream_test(void)\n4914\t{\n4915\t    int ret = stop_sending_test_one(1, 0);\n4916\t    return ret;\n4917\t}\n4918\t\n4919\t/*\n4920\t* MTU discovery tests. Perform a moderate transmission.\n4921\t* Verify that MTU was properly set to expected value,\n4922\t* according to the specified option.\n4923\t*/\n4924\t\n4925\tint mtu_discovery_test_one(picoquic_pmtud_policy_enum pmtud_policy, \n4926\t    size_t mtu_expected_client, size_t mtu_expected_server,\n4927\t    test_api_stream_desc_t * scenario, size_t scenario_size,\n4928\t    uint32_t mtu_max)\n4929\t{\n4930\t    uint64_t simulated_time = 0;\n4931\t    uint64_t loss_mask = 0;\n4932\t    picoquic_test_tls_api_ctx_t* test_ctx = NULL;\n4933\t    int ret = tls_api_init_ctx(&test_ctx, PICOQUIC_INTERNAL_TEST_VERSION_1,\n4934\t        PICOQUIC_TEST_SNI, PICOQUIC_TEST_ALPN, &simulated_time, NULL, NULL, 0, 0, 0);\n4935\t\n4936\t    if (ret == 0) {\n4937\t        picoquic_set_default_pmtud_policy(test_ctx->qserver, pmtud_policy);\n4938\t        picoquic_cnx_set_pmtud_policy(test_ctx->cnx_client, pmtud_policy);\n4939\t        if (mtu_max > 0) {\n4940\t            picoquic_set_mtu_max(test_ctx->qserver, mtu_max);\n4941\t        }\n4942\t    }\n4943\t\n4944\t    if (ret == 0) {\n4945\t        ret = tls_api_connection_loop(test_ctx, &loss_mask, 0, &simulated_time);\n4946\t    }\n4947\t\n4948\t    /* Prepare to send data */\n4949\t    if (ret == 0) {\n4950\t        ret = test_api_init_send_recv_scenario(test_ctx, scenario, scenario_size);\n4951\t    }\n4952\t\n4953\t    /* Perform a data sending loop */\n4954\t    if (ret == 0) {\n4955\t        ret = tls_api_data_sending_loop(test_ctx, &loss_mask, &simulated_time, 0);\n4956\t    }\n4957\t\n4958\t    if (ret == 0) {\n4959\t        if (test_ctx->cnx_client->path[0]->send_mtu != mtu_expected_client) {\n4960\t            ret = -1;\n4961\t        } else if (test_ctx->cnx_server->path[0]->send_mtu != mtu_expected_server) {\n4962\t            ret = -1;\n4963\t        }\n4964\t    }\n4965\t\n4966\t    if (test_ctx != NULL) {\n4967\t        tls_api_delete_ctx(test_ctx);\n4968\t        test_ctx = NULL;\n4969\t    }\n4970\t\n4971\t    return ret;\n4972\t}\n4973\t\n4974\tint mtu_discovery_test(void)\n4975\t{\n4976\t    int ret = mtu_discovery_test_one(picoquic_pmtud_basic, 1440, 1440, \n4977\t        test_scenario_mtu_discovery, sizeof(test_scenario_mtu_discovery), 0);\n4978\t    return ret;\n4979\t}\n4980\t\n4981\tint mtu_blocked_test(void)\n4982\t{\n4983\t    int ret = mtu_discovery_test_one(picoquic_pmtud_blocked, 1252, 1252, \n4984\t        test_scenario_mtu_discovery, sizeof(test_scenario_mtu_discovery), 0);\n4985\t    return ret;\n4986\t}\n4987\t\n4988\tint mtu_delayed_test(void)\n4989\t{\n4990\t    int ret = mtu_discovery_test_one(picoquic_pmtud_delayed, 1252, 1440, \n4991\t        test_scenario_very_long, sizeof(test_scenario_very_long), 0);\n4992\t    return ret;\n4993\t}\n4994\t\n4995\tint mtu_required_test(void)\n4996\t{\n4997\t    int ret = mtu_discovery_test_one(picoquic_pmtud_required, 1440, 1440, \n4998\t        test_scenario_q_and_r, sizeof(test_scenario_q_and_r), 0);\n4999\t    return ret;"}]},"parent_tool_use_id":"toolu_01Rt4pELUTT189iuGyrewME6","session_id":"782f2f02-5f93-4f6f-b663-2ef2c783a0cf","uuid":"94b13b84-10a