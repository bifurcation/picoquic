       ret = -1;\n5885\t        }\n5886\t    }\n5887\t\n5888\t    /* recreate the client connection */\n5889\t    if (ret == 0) {\n5890\t        test_ctx->cnx_client = picoquic_create_cnx(test_ctx->qclient, picoquic_null_connection_id,\n5891\t                                                   picoquic_null_connection_id,\n5892\t                                                   (struct sockaddr*)&test_ctx->server_addr, 0,\n5893\t                                                   0, PICOQUIC_TEST_SNI, PICOQUIC_TEST_ALPN, 1);\n5894\t\n5895\t        if (test_ctx->cnx_client == NULL) {\n5896\t            ret = -1;\n5897\t        } else {\n5898\t            ret = picoquic_start_client_cnx(test_ctx->cnx_client);\n5899\t        }\n5900\t    }\n5901\t\n5902\t    if (ret == 0) {\n5903\t        picoquic_set_client_authentication(test_ctx->qserver, 1);\n5904\t        \n5905\t        /* Proceed with the connection loop. It should fail */\n5906\t        ret = tls_api_connection_loop(test_ctx, &loss_mask, 0, &simulated_time);\n5907\t    }\n5908\t\n5909\t    if (ret == 0) {\n5910\t        if (test_ctx->cnx_client == NULL) {\n5911\t            ret = -1;\n5912\t        }\n5913\t        else if (test_ctx->cnx_client->cnx_state != picoquic_state_disconnected) {\n5914\t            ret = -1;\n5915\t        }\n5916\t        else if (!picoquic_is_handshake_error(picoquic_get_local_error(test_ctx->cnx_server))) {\n5917\t            ret = -1;\n5918\t        }\n5919\t        else if (!picoquic_is_handshake_error(picoquic_get_remote_error(test_ctx->cnx_client))) {\n5920\t            ret = -1;\n5921\t        }\n5922\t    }\n5923\t\n5924\t    if (test_ctx != NULL) {\n5925\t        tls_api_delete_ctx(test_ctx);\n5926\t        test_ctx = NULL;\n5927\t    }\n5928\t\n5929\t    return ret;\n5930\t}\n5931\t\n5932\t/*\n5933\t* NAT Rebinding test. The client is unaware of the migration.\n5934\t* Start with one basic transmission, then switch the client\n5935\t* to a different port number. Verify that the server issues \n5936\t* a path challenge, that the client responds with a path\n5937\t* response, and that the connection completes.\n5938\t*/\n5939\t\n5940\tint nat_rebinding_count_r_cid(picoquic_cnx_t* cnx) {\n5941\t    int nb_cid = 0;\n5942\t    picoquic_remote_cnxid_t* r_cid = cnx->first_remote_cnxid_stash->cnxid_stash_first;\n5943\t\n5944\t    while (r_cid) {\n5945\t        nb_cid++;\n5946\t        r_cid = r_cid->next;\n5947\t    }\n5948\t\n5949\t    return nb_cid;\n5950\t}\n5951\t\n5952\tint nat_rebinding_test_one(uint64_t loss_mask_data, int zero_cid, uint64_t latency)\n5953\t{\n5954\t    int ret;\n5955\t    uint64_t simulated_time = 0;\n5956\t    uint64_t next_time = 0;\n5957\t    uint64_t loss_mask = 0;\n5958\t    uint64_t initial_challenge = 0;\n5959\t    int nb_inactive = 0;\n5960\t    picoquic_test_tls_api_ctx_t* test_ctx = NULL;\n5961\t    picoquic_connection_id_t initial_cid = { {0x19, 0x8a, 0, 0, 0, 0, 0, 0}, 8 };\n5962\t\n5963\t    if (loss_mask_data != 0) {\n5964\t        initial_cid.id[2] = 0x10;\n5965\t    }\n5966\t\n5967\t    if (zero_cid != 0) {\n5968\t        initial_cid.id[3] = 0xc1;\n5969\t    }\n5970\t\n5971\t    ret = tls_api_init_ctx_ex2(&test_ctx, PICOQUIC_INTERNAL_TEST_VERSION_1,\n5972\t        PICOQUIC_TEST_SNI, PICOQUIC_TEST_ALPN, &simulated_time, NULL, NULL, 0, 0, 0, &initial_cid, 8, zero_cid, 0, 0);\n5973\t\n5974\t    if (ret == 0 && test_ctx == NULL) {\n5975\t        ret = PICOQUIC_ERROR_MEMORY;\n5976\t    }\n5977\t    else {\n5978\t        if (latency > 0) {\n5979\t            test_ctx->c_to_s_link->microsec_latency = latency;\n5980\t            test_ctx->s_to_c_link->microsec_latency = latency;\n5981\t        }\n5982\t        picoquic_set_log_level(test_ctx->qserver, 1);\n5983\t        ret = picoquic_set_qlog(test_ctx->qserver, \".\");\n5984\t        picoquic_set_log_level(test_ctx->qclient, 1);\n5985\t        if (ret == 0) {\n5986\t            ret = picoquic_set_qlog(test_ctx->qclient, \".\");\n5987\t        }\n5988\t    }\n5989\t\n5990\t    if (ret == 0) {\n5991\t        ret = tls_api_connection_loop(test_ctx, &loss_mask, 0, &simulated_time);\n5992\t    }\n5993\t\n5994\t    /* run a receive loop until no outstanding data */\n5995\t    if (ret == 0) {\n5996\t        ret = tls_api_synch_to_empty_loop(test_ctx, &simulated_time, 2048, PICOQUIC_NB_PATH_TARGET, 1);\n5997\t    }\n5998\t\n5999\t    if (ret == 0) {\n6000\t        initial_challenge = test_ctx->cnx_server->path[0]->first_tuple->challenge[0];\n6001\t        loss_mask = loss_mask_data; \n6002\t        \n6003\t        /* Change the client address */\n6004\t        test_ctx->client_addr_natted = test_ctx->client_addr;\n6005\t        test_ctx->client_addr_natted.sin_port += 17;\n6006\t        test_ctx->client_use_nat = 1;\n6007\t\n6008\t        /* Prepare to send data */\n6009\t        ret = test_api_init_send_recv_scenario(test_ctx, test_scenario_q_and_r, sizeof(test_scenario_q_and_r));\n6010\t    }\n6011\t\n6012\t    /* Perform a data sending loop */\n6013\t    if (ret == 0) {\n6014\t        ret = tls_api_data_sending_loop(test_ctx, &loss_mask, &simulated_time, 0);\n6015\t    }\n6016\t    \n6017\t    /* verify that the transmission was complete */\n6018\t    if (ret == 0) {\n6019\t        ret = tls_api_one_scenario_verify(test_ctx);\n6020\t    }\n6021\t\n6022\t    /* Add a time loop of 3 seconds to give some time for the challenge to be repeated */\n6023\t    next_time = simulated_time + 3000000;\n6024\t    loss_mask = 0;\n6025\t    while (ret == 0 && simulated_time < next_time && TEST_CLIENT_READY \n6026\t        && TEST_SERVER_READY && !zero_cid\n6027\t        && (test_ctx->cnx_server->path[0]->first_tuple->challenge_verified != 1 ||\n6028\t            test_ctx->cnx_server->nb_paths > 1 ||\n6029\t            test_ctx->cnx_server->first_remote_cnxid_stash->cnxid_stash_first->sequence == 0 ||\n6030\t            nat_rebinding_count_r_cid(test_ctx->cnx_server) < 8 )) {\n6031\t        int was_active = 0;\n6032\t\n6033\t        ret = tls_api_one_sim_round(test_ctx, &simulated_time, next_time, &was_active);\n6034\t\n6035\t        if (was_active) {\n6036\t            nb_inactive = 0;\n6037\t        }\n6038\t        else {\n6039\t            nb_inactive++;\n6040\t            if (nb_inactive > 128) {\n6041\t                ret = 0;\n6042\t                if (nb_inactive > 256) {\n6043\t                    break;\n6044\t                }\n6045\t            }\n6046\t        }\n6047\t    }\n6048\t\n6049\t    /* Verify that the challenge was updated and done */\n6050\t    if (ret == 0) {\n6051\t        if (test_ctx->cnx_server == NULL) {\n6052\t            DBG_PRINTF(\"%s\", \"Server connection disappeared\");\n6053\t            ret = -1;\n6054\t        } else if (initial_challenge == test_ctx->cnx_server->path[0]->first_tuple->challenge[0]) {\n6055\t            DBG_PRINTF(\"%s\", \"Challenge was not renewed after NAT rebinding\");\n6056\t            ret = -1;\n6057\t        }\n6058\t        else if (test_ctx->cnx_server->path[0]->first_tuple->challenge_verified != 1) {\n6059\t            DBG_PRINTF(\"%s\", \"Challenge was not verified after NAT rebinding\");\n6060\t            ret = -1;\n6061\t        }\n6062\t    }\n6063\t\n6064\t    if (test_ctx != NULL) {\n6065\t        tls_api_delete_ctx(test_ctx);\n6066\t        test_ctx = NULL;\n6067\t    }\n6068\t\n6069\t    return ret;\n6070\t}\n6071\t\n6072\tint nat_rebinding_test(void)\n6073\t{\n6074\t    uint64_t loss_mask = 0;\n6075\t\n6076\t    return nat_rebinding_test_one(loss_mask, 0, 0);\n6077\t}\n6078\t\n6079\tint nat_rebinding_loss_test(void)\n6080\t{\n6081\t    uint64_t loss_mask = 0x2012;\n6082\t\n6083\t    return nat_rebinding_test_one(loss_mask, 0, 0);\n6084\t}\n6085\t\n6086\tint nat_rebinding_zero_test(void)\n6087\t{\n6088\t    /* Test of NAT rebinding with zero-length client CID */\n6089\t    uint64_t loss_mask = 0;\n6090\t\n6091\t    return nat_rebinding_test_one(loss_mask, 1, 0);\n6092\t}\n6093\t\n6094\tint nat_rebinding_latency_test(void)\n6095\t{\n6096\t    /* Test of NAT rebinding with zero-length client CID */\n6097\t    uint64_t loss_mask = 0;\n6098\t\n6099\t    return nat_rebinding_test_one(loss_mask, 0, 100000);\n6100\t}\n6101\t\n6102\t\n6103\t/*\n6104\t* Fast NAT Rebinding test. The client is unaware of the migration,\n6105\t* and is programmed to not support migration. The NAT alternates\n6106\t* between ports based on time, or packet counts. The test checks that\n6107\t* the connection survives 6 NAT transitions at short intervals.\n6108\t*/\n6109\t\n6110\tint fast_nat_rebinding_test(void)\n6111\t{\n6112\t    uint64_t simulated_time = 0;\n6113\t    uint64_t loss_mask = 0;\n6114\t    const int nb_switches_required = 6;\n6115\t    picoquic_test_tls_api_ctx_t* test_ctx = NULL;\n6116\t    picoquic_connection_id_t initial_cid = { {0xfa, 0x57, 0x08, 0xa7, 0, 0, 0, 0}, 8 };\n6117\t\n6118\t    int ret = tls_api_init_ctx_ex(&test_ctx, PICOQUIC_INTERNAL_TEST_VERSION_1,\n6119\t        PICOQUIC_TEST_SNI, PICOQUIC_TEST_ALPN, &simulated_time, NULL, NULL, 0, 0, 0, &initial_cid);\n6120\t\n6121\t    if (ret == 0 && test_ctx == NULL) {\n6122\t        ret = PICOQUIC_ERROR_MEMORY;\n6123\t    }\n6124\t\n6125\t    if (ret == 0) {\n6126\t        /* Set up logging */ \n6127\t        picoquic_set_qlog(test_ctx->qserver, \".\");\n6128\t        picoquic_set_qlog(test_ctx->qclient, \".\");\n6129\t    }\n6130\t\n6131\t    if (ret == 0) {\n6132\t        ret = tls_api_connection_loop(test_ctx, &loss_mask, 0, &simulated_time);\n6133\t    }\n6134\t\n6135\t    if (ret == 0) {\n6136\t        ret = test_api_init_send_recv_scenario(test_ctx, test_scenario_sustained, sizeof(test_scenario_sustained));\n6137\t    }\n6138\t\n6139\t    /* Perform a data sending loop */\n6140\t    if (ret == 0) {\n6141\t        uint64_t delta_t = 5 * (test_ctx->c_to_s_link->microsec_latency + test_ctx->s_to_c_link->microsec_latency);\n6142\t        uint64_t next_time = simulated_time + 200000000;\n6143\t        int nb_trials = 0;\n6144\t        int nb_inactive = 0;\n6145\t        int max_trials = 1000000;\n6146\t        uint64_t switch_time = simulated_time;\n6147\t        int switched = 0;\n6148\t        int nb_switched = 0;\n6149\t\n6150\t        test_ctx->client_use_nat = 1;\n6151\t        test_ctx->client_addr_natted = test_ctx->client_addr;\n6152\t        test_ctx->client_addr_natted.sin_port += 17;\n6153\t\n6154\t        while (ret == 0 && nb_trials < max_trials && nb_inactive < 256 && simulated_time < next_time && TEST_CLIENT_READY && TEST_SERVER_READY) {\n6155\t            int was_active = 0;\n6156\t\n6157\t            nb_trials++;\n6158\t\n6159\t            ret = tls_api_one_sim_round(test_ctx, &simulated_time, next_time, &was_active);\n6160\t\n6161\t            if (ret < 0)\n6162\t            {\n6163\t                break;\n6164\t            }\n6165\t\n6166\t            if (ret == 0 && test_ctx->cnx_server != NULL && test_ctx->cnx_server->cnx_state == picoquic_state_ready) {\n6167\t                if (((struct sockaddr_in*) & test_ctx->cnx_server->path[0]->first_tuple->peer_addr)->sin_port == 0) {\n6168\t                    DBG_PRINTF(\"Client address out of sync, port: %d\", ((struct sockaddr_in*) & test_ctx->cnx_server->path[0]->first_tuple->peer_addr)->sin_port);\n6169\t                }\n6170\t                else if (((struct sockaddr_in*) & test_ctx->cnx_server->path[0]->first_tuple->peer_addr)->sin_port == test_ctx->client_addr_natted.sin_port) {\n6171\t                    if (switched) {\n6172\t                        if (simulated_time > switch_time + delta_t &&\n6173\t                            nb_switched < nb_switches_required) {\n6174\t                            switched = 0;\n6175\t                        }\n6176\t                    }\n6177\t                    else\n6178\t                    {\n6179\t                        /* Change the client address */\n6180\t                        test_ctx->client_addr_natted.sin_port += 17;\n6181\t                        switched = 1;\n6182\t                        switch_time = simulated_time;\n6183\t                        nb_switched++;\n6184\t                    }\n6185\t                }\n6186\t            }\n6187\t\n6188\t            if (was_active) {\n6189\t                nb_inactive = 0;\n6190\t            }\n6191\t            else {\n6192\t                nb_inactive++;\n6193\t\n6194\t                if (nb_inactive == 254) {\n6195\t                    DBG_PRINTF(\"Almost stalled after %d trials, %d inactive, %d switches\", nb_trials, nb_inactive, nb_switched);\n6196\t                }\n6197\t            }\n6198\t\n6199\t            if (test_ctx->test_finished) {\n6200\t                if (picoquic_is_cnx_backlog_empty(test_ctx->cnx_client) && picoquic_is_cnx_backlog_empty(test_ctx->cnx_server)) {\n6201\t                    break;\n6202\t                }\n6203\t            }\n6204\t        }\n6205\t\n6206\t        DBG_PRINTF(\"Exit after %d trials, %d inactive, %d switches\", nb_trials, nb_inactive, nb_switched);\n6207\t\n6208\t        /* Verify that the test was effective */\n6209\t        if (ret == 0 && nb_switched < nb_switches_required) {\n6210\t            ret = -1;\n6211\t        }\n6212\t    }\n6213\t\n6214\t    /* verify that the transmission was complete */\n6215\t    if (ret == 0) {\n6216\t        ret = tls_api_one_scenario_verify(test_ctx);\n6217\t    }\n6218\t\n6219\t    if (test_ctx != NULL) {\n6220\t        tls_api_delete_ctx(test_ctx);\n6221\t        test_ctx = NULL;\n6222\t    }\n6223\t\n6224\t    return ret;\n6225\t}\n6226\t\n6227\t/*\n6228\t * Test whether the loss bit reporting can be enabled without breaking the connection\n6229\t */\n6230\t\n6231\tint loss_bit_test(void)\n6232\t{\n6233\t    int ret = 0;\n6234\t    picoquic_tp_t client_parameters;\n6235\t    picoquic_tp_t server_parameters;\n6236\t\n6237\t    for (int i = 0; ret == 0 && i <= 3; i++) {\n6238\t        memset(&client_parameters, 0, sizeof(picoquic_tp_t));\n6239\t        memset(&server_parameters, 0, sizeof(picoquic_tp_t));\n6240\t        picoquic_init_transport_parameters(&client_parameters);\n6241\t        picoquic_init_transport_parameters(&server_parameters);\n6242\t\n6243\t        client_parameters.enable_loss_bit = (i & 1);\n6244\t        server_parameters.enable_loss_bit = ((i > 1) & 1);\n6245\t\n6246\t        ret = tls_api_one_scenario_test(test_scenario_many_streams, sizeof(test_scenario_many_streams), 0, 0, 0, 0, 0, 250000, &client_parameters, &server_parameters);\n6247\t        if (ret != 0) {\n6248\t            DBG_PRINTF(\"Loss bit test fails for client: %d, server: %d, ret = %d\", i & 1, i >> 1, ret);\n6249\t        }\n6250\t    }\n6251\t\n6252\t    return ret;\n6253\t}\n6254\t\n6255\t\n6256\t/*\n6257\t* Closing on error test. We voluntarily inject an erroneous\n6258\t* frame on the client connection. The expected result is that\n6259\t* the server connection gets closed, but the server remains\n6260\t* responsive.\n6261\t*/\n6262\t\n6263\tint client_error_test_modal(int mode)\n6264\t{\n6265\t    uint64_t simulated_time = 0;\n6266\t    uint64_t next_time = 0;\n6267\t    uint64_t loss_mask = 0;\n6268\t    picoquic_test_tls_api_ctx_t* test_ctx = NULL;\n6269\t    int ret = tls_api_init_ctx(&test_ctx, PICOQUIC_INTERNAL_TEST_VERSION_1,\n6270\t        PICOQUIC_TEST_SNI, PICOQUIC_TEST_ALPN, &simulated_time, NULL, NULL, 0, 0, 0);\n6271\t\n6272\t    if (ret == 0) {\n6273\t        ret = tls_api_connection_loop(test_ctx, &loss_mask, 0, &simulated_time);\n6274\t    }\n6275\t\n6276\t    /* Prepare to send data */\n6277\t    if (ret == 0) {\n6278\t        ret = test_api_init_send_recv_scenario(test_ctx, test_scenario_q_and_r, sizeof(test_scenario_q_and_r));\n6279\t    }\n6280\t\n6281\t    /* Perform a data sending loop */\n6282\t    if (ret == 0) {\n6283\t        ret = tls_api_data_sending_loop(test_ctx, &loss_mask, &simulated_time, 0);\n6284\t    }\n6285\t\n6286\t    /* Inject an erroneous frame */\n6287\t    if (ret == 0) {\n6288\t        if (mode == 0) {\n6289\t            /* Queue a data frame on stream 4, which was already closed */\n6290\t            uint8_t stream_error_frame[] = { 0x17, 0x04, 0x41, 0x01, 0x08, 0x00, 0x01, 0x02, 0x03, 0x04, 0x05, 0x06, 0x07 };\n6291\t            picoquic_queue_misc_frame(test_ctx->cnx_client, stream_error_frame, sizeof(stream_error_frame), 0,\n6292\t                picoquic_packet_context_application);\n6293\t        }\n6294\t        else if (mode == 1) {\n6295\t            /* Test injection of a wrong NEW CONNECTION ID */\n6296\t            uint8_t new_cnxid_error[1024];\n6297\t            uint8_t* x = new_cnxid_error;\n6298\t\n6299\t            *x++ = picoquic_frame_type_new_connection_id;\n6300\t            *x++ = test_ctx->cnx_client->nb_paths + 3;\n6301\t            *x++ = 0;\n6302\t            *x++ = 8;\n6303\t            for (int i = 0; i < 8; i++) {\n6304\t                *x++ = 0x99; /* Hommage to Dilbert's random generator */\n6305\t            }\n6306\t            /* deliberate error: repeat the reset secret defined for path[0] */\n6307\t            memcpy(x, test_ctx->cnx_server->path[0]->first_tuple->p_remote_cnxid->reset_secret, PICOQUIC_RESET_SECRET_SIZE);\n6308\t            x += PICOQUIC_RESET_SECRET_SIZE;\n6309\t            picoquic_queue_misc_frame(test_ctx->cnx_client, new_cnxid_error, x - new_cnxid_error, 0,\n6310\t                picoquic_packet_context_application);\n6311\t        }\n6312\t        else if (mode == 2) {\n6313\t            /* Queue a stop sending on stream 2, which is unidir */\n6314\t            uint8_t stop_sending_error_frame[] = { (uint8_t)picoquic_frame_type_stop_sending, 2, 0 };\n6315\t            picoquic_queue_misc_frame(test_ctx->cnx_client, stop_sending_error_frame, sizeof(stop_sending_error_frame), 0,\n6316\t                picoquic_packet_context_application);\n6317\t        }\n6318\t        else {\n6319\t            DBG_PRINTF(\"Error mode %d is not defined yet\", mode);\n6320\t        }\n6321\t    }\n6322\t\n6323\t    /* Add a time loop of 3 seconds to give some time for the error to be repeated */\n6324\t    next_time = simulated_time + 3000000;\n6325\t    loss_mask = 0;\n6326\t    while (ret == 0 && simulated_time < next_time\n6327\t        && (test_ctx->cnx_client->cnx_state < picoquic_state_disconnected ||\n6328\t            test_ctx->cnx_server->cnx_state < picoquic_state_disconnected)) {\n6329\t        int was_active = 0;\n6330\t\n6331\t        ret = tls_api_one_sim_round(test_ctx, &simulated_time, next_time, &was_active);\n6332\t    }\n6333\t\n6334\t    if (ret == 0 && test_ctx->cnx_server->cnx_state != picoquic_state_disconnected) {\n6335\t        ret = -1;\n6336\t    }\n6337\t\n6338\t    if (ret == 0) {\n6339\t        /* Delete the client connection from the client context,\n6340\t         * without sending notification to the server */\n6341\t        while (test_ctx->qclient->cnx_list != NULL) {\n6342\t            picoquic_delete_cnx(test_ctx->qclient->cnx_list);\n6343\t        }\n6344\t\n6345\t        /* Erase the server connection reference */\n6346\t        test_ctx->cnx_server = NULL;\n6347\t\n6348\t        /* Create a new connection in the client context */\n6349\t\n6350\t        test_ctx->cnx_client = picoquic_create_cnx(test_ctx->qclient,\n6351\t            picoquic_null_connection_id, picoquic_null_connection_id,\n6352\t            (struct sockaddr*)&test_ctx->server_addr, simulated_time, 0, PICOQUIC_TEST_SNI, PICOQUIC_TEST_ALPN, 1);\n6353\t\n6354\t        if (test_ctx->cnx_client == NULL) {\n6355\t            ret = -1;\n6356\t        }\n6357\t        else if (ret == 0) {\n6358\t            ret = picoquic_start_client_cnx(test_ctx->cnx_client);\n6359\t        }\n6360\t    }\n6361\t\n6362\t    /* Now, restart a connection in the same context */\n6363\t    if (ret == 0) {\n6364\t        ret = tls_api_connection_loop(test_ctx, &loss_mask, 0, &simulated_time);\n6365\t    }\n6366\t\n6367\t    if (ret == 0){\n6368\t        ret = wait_application_aead_ready(test_ctx, &simulated_time);\n6369\t    }\n6370\t\n6371\t    if (ret == 0) {\n6372\t        ret = tls_api_attempt_to_close(test_ctx, &simulated_time);\n6373\t    }\n6374\t\n6375\t    if (test_ctx != NULL) {\n6376\t        tls_api_delete_ctx(test_ctx);\n6377\t        test_ctx = NULL;\n6378\t    }\n6379\t\n6380\t    return ret;\n6381\t}\n6382\t\n6383\tint client_error_test(void)\n6384\t{\n6385\t    int ret = 0;\n6386\t    char const* mode_name[] = { \"stream\", \"new_connection_id\", \"stop_sending\" };\n6387\t    int nb_modes = (int)(sizeof(mode_name) / sizeof(char const*));\n6388\t\n6389\t    for (int mode = 0; mode < nb_modes; mode++) {\n6390\t        if (client_error_test_modal(mode) != 0) {\n6391\t            DBG_PRINTF(\"Client error test mode(%s) failed.\\n\", mode_name[mode]);\n6392\t            ret = -1;\n6393\t        }\n6394\t    }\n6395\t\n6396\t    return ret;\n6397\t}\n6398\t\n6399\t/*\n6400\t* Client only test. Verify that if \"client only\" is set on the server context,\n6401\t* then connections are refused.\n6402\t*/\n6403\t\n6404\tint client_only_test(void)\n6405\t{\n6406\t    uint64_t simulated_time = 0;\n6407\t    uint64_t loss_mask = 0;\n6408\t    picoquic_test_tls_api_ctx_t* test_ctx = NULL;\n6409\t    picoquic_connection_id_t initial_cid = { {0xc1, 0x10, 0, 0, 0, 0, 0, 0}, 8 };\n6410\t    int ret;\n6411\t\n6412\t    ret = tls_api_init_ctx_ex(&test_ctx, PICOQUIC_INTERNAL_TEST_VERSION_1,\n6413\t        PICOQUIC_TEST_SNI, PICOQUIC_TEST_ALPN, &simulated_time, NULL, NULL, 0, 0, 0, &initial_cid);\n6414\t\n6415\t    if (ret == 0) {\n6416\t        /* First, try enforcement. We do set log on the server side, but it is expected to be empty */\n6417\t        int connection_ret = 0;\n6418\t        picoquic_enforce_client_only(test_ctx->qserver, 1);\n6419\t        picoquic_set_qlog(test_ctx->qserver, \".\");\n6420\t        picoquic_set_qlog(test_ctx->qclient, \".\");\n6421\t        connection_ret = tls_api_connection_loop(test_ctx, &loss_mask, 0, &simulated_time);\n6422\t        if (connection_ret == 0 && test_ctx->cnx_client->cnx_state < picoquic_state_disconnected) {\n6423\t            DBG_PRINTF(\"Connection unexpectedly succeeds, state=%d, ret=%d (0x%x)\",\n6424\t                test_ctx->cnx_client->cnx_state, connection_ret, connection_ret);\n6425\t            ret = -1;\n6426\t        }\n6427\t        else if (test_ctx->cnx_server != NULL) {\n6428\t            DBG_PRINTF(\"Connection context created on client-only note, ret=%d (0x%x)\",\n6429\t                connection_ret, connection_ret);\n6430\t            ret = -1;\n6431\t        }\n6432\t    }\n6433\t\n6434\t    if (test_ctx != NULL) {\n6435\t        tls_api_delete_ctx(test_ctx);\n6436\t        test_ctx = NULL;\n6437\t    }\n6438\t\n6439\t    return ret;\n6440\t}\n6441\t\n6442\t/*\n6443\t * Set a connection, then verify that the \"new connection id\" frames have been exchanged properly.\n6444\t * Use the \"check stash\" function to verify that new connection ID were properly\n6445\t * stashed on each side.\n6446\t *\n6447\t * TODO: also test that no New Connection Id frames are sent if migration is disabled \n6448\t */\n6449\t\n6450\tint test_cnxid_count_stash(picoquic_cnx_t * cnx) {\n6451\t    picoquic_remote_cnxid_t * stash = cnx->first_remote_cnxid_stash->cnxid_stash_first;\n6452\t    int nb = 0;\n6453\t\n6454\t    while (stash != NULL) {\n6455\t        nb++;\n6456\t        stash = stash->next;\n6457\t    }\n6458\t\n6459\t    return nb;\n6460\t}\n6461\t\n6462\tint transmit_cnxid_test_stash(picoquic_cnx_t * cnx1, picoquic_cnx_t * cnx2, char const * cnx_text)\n6463\t{\n6464\t    int ret = 0;\n6465\t    picoquic_remote_cnxid_t * stash = cnx1->first_remote_cnxid_stash->cnxid_stash_first;\n6466\t    picoquic_local_cnxid_t* cid_list = cnx2->first_local_cnxid_list->local_cnxid_first;\n6467\t    int rank = 0;\n6468\t\n6469\t    while (stash != NULL && cid_list != NULL) {\n6470\t        if (picoquic_compare_connection_id(&stash->cnx_id, &cid_list->cnx_id) != 0) {\n6471\t            DBG_PRINTF(\"On %s, cnx ID of stash #%d does not match cid[%d] of peer.\\n\",\n6472\t                cnx_text, rank, (int)cid_list->sequence);\n6473\t            ret = -1;\n6474\t            break;\n6475\t        }\n6476\t        stash = stash->next;\n6477\t        cid_list = cid_list->next;\n6478\t        rank++;\n6479\t    }\n6480\t\n6481\t    if (ret == 0 && cid_list != NULL) {\n6482\t        DBG_PRINTF(\"On %s, %d items in stash instead instead of %d.\\n\", cnx_text, rank, \n6483\t            cnx2->first_local_cnxid_list->nb_local_cnxid - 1);\n6484\t        ret = -1;\n6485\t    }\n6486\t\n6487\t    if (ret == 0 && stash != NULL) {\n6488\t        DBG_PRINTF(\"On %s, more than %d items in stash.\\n\", cnx_text, cnx2->first_local_cnxid_list->nb_local_cnxid - 1);\n6489\t        ret = -1;\n6490\t    }\n6491\t\n6492\t    return ret;\n6493\t}\n6494\t\n6495\tint transmit_cnxid_test_one(int retire_before, int disable_migration, int retire_number_zero)\n6496\t{\n6497\t    uint64_t simulated_time = 0;\n6498\t    uint64_t loss_mask = 0;\n6499\t    /* We set the default ttl to 5 seconds, which is longer than the"}]},"parent_tool_use_id":"toolu_01DLpwD9vYuhD2vecYuV5PML","session_id":"782f2f02-5f93-4f6f-b663-2ef2c783a0cf","uuid":"5fd04e7d-0e84-403b-927f-11dadb4039a8","timestamp":"2026-05-05T12:34:07.344Z"}
