&[]);"," }"," ","-/// C: `l4s_bbr_updown_test` in `picoquictest/l4s_test.c`.","+/// Prague (L4S-native) under DualQ AQM.  C: `l4s_prague_test`."," #[test]","-fn l4s_bbr_updown() {","-    todo!(\"l4s_bbr_updown_test\")","+fn l4s_prague() {","+    let ccalgo = get_congestion_algorithm(\"prague\").expect(\"prague cc algo\");","+    l4s_congestion_test(ccalgo, true, 4_100_000, 9, 4_500, &[]);"," }"," ","-/// C: `l4s_c4_test` in `picoquictest/l4s_test.c`.","+/// Prague under DualQ AQM with updown bandwidth variation.","+/// C: `l4s_prague_updown_test`."," #[test]","-fn l4s_c4() {","-    todo!(\"l4s_c4_test\")","+fn l4s_prague_updown() {","+    let ccalgo = get_congestion_algorithm(\"prague\").expect(\"prague cc algo\");","+    l4s_congestion_test(ccalgo, true, 6_300_000, 55, 6_000, L4S_LINK_UPDOWN);"," }"," ","-/// C: `l4s_prague_test` in `picoquictest/l4s_test.c`.","+/// BBR under DualQ AQM.  C: `l4s_bbr_test`."," #[test]","-fn l4s_prague() {","-    todo!(\"l4s_prague_test\")","+fn l4s_bbr() {","+    let ccalgo = get_congestion_algorithm(\"bbr\").expect(\"bbr cc algo\");","+    l4s_congestion_test(ccalgo, true, 3_800_000, 21, 3_000, &[]);"," }"," ","-/// C: `l4s_prague_updown_test` in `picoquictest/l4s_test.c`.","+/// C4 under DualQ AQM.  C: `l4s_c4_test`."," #[test]","-fn l4s_prague_updown() {","-    todo!(\"l4s_prague_updown_test\")","+fn l4s_c4() {","+    let ccalgo = get_congestion_algorithm(\"c4\").expect(\"c4 cc algo\");","+    l4s_congestion_test(ccalgo, true, 3_600_000, 30, 3_000, &[]);"," }"," ","-/// C: `l4s_reno_test` in `picoquictest/l4s_test.c`.","+/// BBR under DualQ AQM with updown bandwidth variation.","+/// C: `l4s_bbr_updown_test` (Windows 32-bit guard omitted — not applicable)."," #[test]","-fn l4s_reno() {","-    todo!(\"l4s_reno_test\")","+fn l4s_bbr_updown() {","+    let ccalgo = get_congestion_algorithm(\"bbr\").expect(\"bbr cc algo\");","+    l4s_congestion_test(ccalgo, true, 5_800_000, 69, 3_000, L4S_LINK_UPDOWN);"," }"]}],"originalFile":"//! Te