\n44\t#ifdef _WINDOWS\n45\t#define MEMLOG_TEST_REF \"picoquictest\\\\memlog_test_ref.csv\"\n46\t#else\n47\t#define MEMLOG_TEST_REF \"picoquictest/memlog_test_ref.csv\"\n48\t#endif\n49\t\n50\t//void memlog_call_back(picoquic_cnx_t* cnx, picoquic_path_t* path, void* v_memlog, int op_code, uint64_t current_time);\n51\t\n52\tstatic test_api_stream_desc_t test_scenario_memlog[] = {\n53\t    { 4, 0, 100000, 100000 }\n54\t};\n55\t\n56\tint memlog_test_one(int is_multipath, char const * memlog_file_name, int expect_error)\n57\t{\n58\t    uint64_t simulated_time = 0;\n59\t    uint64_t loss_mask = 0;\n60\t    int nb_inactive = 0;\n61\t    int nb_trials = 0;\n62\t    int was_active = 0;\n63\t    uint64_t queue_delay_max = 40000;\n64\t    picoquic_test_tls_api_ctx_t* test_ctx = NULL;\n65\t    picoquic_connection_id_t initial_cid = { {0x8e, 0x10, 0x97, 0xe5, 0x70, 0, 0, 0}, 8 };\n66\t    int ret = 0;\n67\t\n68\t    if (ret == 0) {\n69\t        ret = tls_api_init_ctx_ex2(&test_ctx,\n70\t            PICOQUIC_INTERNAL_TEST_VERSION_1,\n71\t            PICOQUIC_TEST_SNI, PICOQUIC_TEST_ALPN, &simulated_time, NULL, NULL, 0, 1, 0, &initial_cid, 8, 0, 0, 0);\n72\t\n73\t        if (ret == 0) {\n74\t            /* Initialize memory log on client or server */\n75\t            ret = memlog_init(test_ctx->cnx_client, 100, memlog_file_name);\n76\t        }\n77\t    }\n78\t\n79\t    if (is_multipath) {\n80\t        /* Add negotiation of multipath option */\n81\t        test_ctx->qserver->default_tp.initial_max_path_id = 1;\n82\t        test_ctx->qclient->default_tp.initial_max_path_id = 1;\n83\t        test_ctx->cnx_client->local_parameters.initial_max_path_id = 1;\n84\t    }\n85\t\n86\t    if (ret == 0) {\n87\t        picoquic_start_client_cnx(test_ctx->cnx_client);\n88\t        ret = tls_api_connection_loop(test_ctx, &loss_mask, queue_delay_max, &simulated_time);\n89\t    }\n90\t\n91\t    if (ret == 0 && is_multipath) {\n92\t        if (!test_ctx->cnx_client->is_multipath_enabled) {\n93\t            ret = -1;\n94\t        }\n95\t    }\n96\t\n97\t    if (ret == 0) {\n98\t        /* Prepare to send data */\n99\t        ret = test_api_init_send_recv_scenario(test_ctx, test_scenario_memlog, sizeof(test_scenario_memlog));\n100\t    }\n101\t\n102\t    while (ret == 0 && picoquic_get_cnx_state(test_ctx->cnx_client) != picoquic_state_disconnected) {\n103\t        /* Progress. */\n104\t        if ((ret = tls_api_one_sim_round(test_ctx, &simulated_time, 0, &was_active)) != 0) {\n105\t            break;\n106\t        }\n107\t\n108\t        if (was_active) {\n109\t            nb_inactive = 0;\n110\t        }\n111\t        else {\n112\t            nb_inactive++;\n113\t        }\n114\t\n115\t        if (test_ctx->test_finished) {\n116\t            if (picoquic_is_cnx_backlog_empty(test_ctx->cnx_client) && picoquic_is_cnx_backlog_empty(test_ctx->cnx_server)) {\n117\t                break;\n118\t            }\n119\t        }\n120\t\n121\t        if (++nb_trials > 1000000 || nb_inactive > 1024) {\n122\t            ret = -1;\n123\t            break;\n124\t        }\n125\t    }\n126\t\n127\t    if (test_ctx != NULL) {\n128\t        tls_api_delete_ctx(test_ctx);\n129\t        test_ctx = NULL;\n130\t    }\n131\t\n132\t    /* compare the log file to the expected value */\n133\t    if (ret == 0 && !is_multipath && !expect_error)\n134\t    {\n135\t        char memlog_test_ref[512];\n136\t\n137\t        ret = picoquic_get_input_path(memlog_test_ref, sizeof(memlog_test_ref),\n138\t            picoquic_solution_dir, MEMLOG_TEST_REF);\n139\t\n140\t        if (ret != 0) {\n141\t            DBG_PRINTF(\"%s\", \"Cannot set the qlog trace test ref file name.\\n\");\n142\t        }\n143\t        else {\n144\t            ret = picoquic_test_compare_text_files(memlog_file_name, memlog_test_ref);\n145\t        }\n146\t    }\n147\t    else if (expect_error) {\n148\t        if (ret == 0) {\n149\t            ret = -1;\n150\t        }\n151\t        else {\n152\t            ret = 0;\n153\t        }\n154\t    }\n155\t\n156\t    return ret;\n157\t}\n158\t\n159\tint memlog_test(void)\n160\t{\n161\t    int ret = memlog_test_one(0, MEMLOG_FILE, 0);\n162\t\n163\t    if (ret == 0) {\n164\t        ret = memlog_test_one(1, MEMLOG_FILE_MP, 0);\n165\t    }\n166\t\n167\t    if (ret == 0) {\n168\t        ret = memlog_test_one(1, MEMLOG_FILE_BAD, 1);\n169\t    }\n170\t    return ret;\n171\t}\n172\t"}]},"parent_tool_use_id":null,"session_id":"efe36d5e-8c7a-42d9-a085-8d43da824da0","uuid":"a2d53597-dd61-497d-b05a-f3e668568aba","timestamp":"2026-05-05T03:51:53.217Z","tool_use_result":{"type":"text","file":{"filePath":"/Users/richbarn/Projects/picoquic/picoquictest/memlog_test.c","content":"/*\n* Author: Christian Huitema\n* Copyright (c) 2024, Private Octopus, Inc.\n* All rights reserved.\n*\n* Permission to use, copy, modify, and distribute this software for any\n* purpose with or without fee is hereby granted, provided that the above\n* copyright notice and this permission notice appear in all copies.\n*\n* THIS SOFTWARE IS PROVIDED BY THE COPYRIGHT HOLDERS AND CONTRIBUTORS \"AS IS\" AND\n* ANY EXPRESS OR IMPLIED WARRANTIES, INCLUDING, BUT NOT LIMITED TO, THE IMPLIED\n* WARRANTIES OF MERCHANTABILITY AND FITNESS FOR A PARTICULAR PURPOSE ARE\n* DISCLAIMED. IN NO EVENT SHALL Private Octopus, Inc. BE LIABLE FOR ANY\n* DIRECT, INDIRECT, INCIDENTAL, SPECIAL, EXEMPLARY, OR CONSEQUENTIAL DAMAGES\n* (INCLUDING, BUT NOT LIMITED TO, PROCUREMENT OF SUBSTITUTE GOODS OR SERVICES;\n* LOSS OF USE, DATA, OR PROFITS; OR BUSINESS INTERRUPTION) HOWEVER CAUSED AND\n* ON ANY THEORY OF LIABILITY, WHETHER IN CONTRACT, STRICT LIABILITY, OR TORT\n* (INCLUDING NEGLIGENCE OR OTHERWISE) ARISING IN ANY WAY OUT OF THE USE OF THIS\n* SOFTWARE, EVEN IF ADVISED OF THE POSSIBILITY OF SUCH DAMAGE.\n*/\n#include <stdio.h>\n#include <stdlib.h>\n#include <string.h>\n#include <inttypes.h>\n#include <errno.h>\n\n#include \"picoquic_internal.h\"\n#include \"bytestream.h\"\n#include \"csv.h\"\n#include \"svg.h\"\n#include \"qlog.h\"\n#include \"cidset.h\"\n#include \"logreader.h\"\n#include \"picoquic_utils.h\"\n#include \"picoquictest_internal.h\"\n#include \"picoquic.h\"\n#include \"auto_memlog.h\"\n\n/* testing the \"memory log\" function.\n */\n#define MEMLOG_FILE \"memlog_file.csv\"\n#define MEMLOG_FILE_MP \"memlog_file_mp.csv\"\n#define MEMLOG_FILE_BAD \"no_such_folder/bad\\\\memlog_file_bad.csv\"\n#ifdef _WINDOWS\n#define MEMLOG_TEST_REF \"picoquictest\\\\memlog_test_ref.csv\"\n#else\n#define MEMLOG_TEST_REF \"picoquictest/memlog_test_ref.csv\"\n#endif\n\n//void memlog_call_back(picoquic_cnx_t* cnx, picoquic_path_t* path, void* v_memlog, int op_code, uint64_t current_time);\n\nstatic test_api_stream_desc_t test_scenario_memlog[] = {\n    { 4, 0, 100000, 100000 }\n};\n\nint memlog_test_one(int is_multipath, char const * memlog_file_name, int expect_error)\n{\n    uint64_t simulated_time = 0;\n    uint64_t loss_mask = 0;\n    int nb_inactive = 0;\n    int nb_trials = 0;\n    int was_active = 0;\n    uint64_t queue_delay_max = 40000;\n    picoquic_test_tls_api_ctx_t* test_ctx = NULL;\n    picoquic_connection_id_t initial_cid = { {0x8e, 0x10, 0x97, 0xe5, 0x70, 0, 0, 0}, 8 };\n    int ret = 0;\n\n    if (ret == 0) {\n        ret = tls_api_init_ctx_ex2(&test_ctx,\n            PICOQUIC_INTERNAL_TEST_VERSION_1,\n            PICOQUIC_TEST_SNI, PICOQUIC_TEST_ALPN, &simulated_time, NULL, NULL, 0, 1, 0, &initial_cid, 8, 0, 0, 0);\n\n        if (ret == 0) {\n            /* Initialize memory log on client or server */\n            ret = memlog_init(test_ctx->cnx_client, 100, memlog_file_name);\n        }\n    }\n\n    if (is_multipath) {\n        /* Add negotiation of multipath option */\n        test_ctx->qserver->default_tp.initial_max_path_id = 1;\n        test_ctx->qclient->default_tp.initial_max_path_id = 1;\n        test_ctx->cnx_client->local_parameters.initial_max_path_id = 1;\n    }\n\n    if (ret == 0) {\n        picoquic_start_client_cnx(test_ctx->cnx_client);\n        ret = tls_api_connection_loop(test_ctx, &loss_mask, queue_delay_max, &simulated_time);\n    }\n\n    if (ret == 0 && is_multipath) {\n        if (!test_ctx->cnx_client->is_multipath_enabled) {\n            ret = -1;\n        }\n    }\n\n    if (ret == 0) {\n        /* Prepare to send data */\n        ret = test_api_init_send_recv_scenario(test_ctx, test_scenario_memlog, sizeof(test_scenario_memlog));\n    }\n\n    while (ret == 0 && picoquic_get_cnx_state(test_ctx->cnx_client) != picoquic_state_disconnected) {\n        /* Progress. */\n        if ((ret = tls_api_one_sim_round(test_ctx, &simulated_time, 0, &was_active)) != 0) {\n            break;\n        }\n\n        if (was_active) {\n            nb_inactive = 0;\n        }\n        else {\n            nb_inactive++;\n        }\n\n        if (test_ctx->test_finished) {\n            if (picoquic_is_cnx_backlog_empty(test_ctx->cnx_client) && picoquic_is_cnx_backlog_empty(test_ctx->cnx_server)) {\n                break;\n            }\n        }\n\n        if (++nb_trials > 1000000 || nb_inactive > 1024) {\n            ret = -1;\n            break;\n        }\n    }\n\n    if (test_ctx != NULL) {\n        tls_api_delete_ctx(test_ctx);\n        test_ctx = NULL;\n    }\n\n    /* compare the log file to the expected value */\n    if (ret == 0 && !is_multipath && !expect_error)\n    {\n        char memlog_test_ref[512];\n\n        ret = picoquic_get_input_path(memlog_test_ref, sizeof(memlog_test_ref),\n            picoquic_solution_dir, MEMLOG_TEST_REF);\n\n        if (ret != 0) {\n            DBG_PRINTF(\"%s\", \"Cannot set the qlog trace test ref file name.\\n\");\n        }\n        else {\n            ret = picoquic_test_compare_text_files(memlog_file_name, memlog_test_ref);\n        }\n    }\n    else if (expect_error) {\n        if (ret == 0) {\n            ret = -1;\n        }\n        else {\n            ret = 0;\n        }\n    }\n\n    return ret;\n}\n\nint memlog_test(void)\n{\n    int ret = memlog_test_one(0, MEMLOG_FILE, 0);\n\n    if (ret == 0) {\n        ret = memlog_test_one(1, MEMLOG_FILE_MP, 0);\n    }\n\n    if (ret == 0) {\n        ret = memlog_test_one(1, MEMLOG_FILE_BAD, 1);\n    }\n    return ret;\n}\n","numLines":172,"startLine":1,"totalLines":172}}}
