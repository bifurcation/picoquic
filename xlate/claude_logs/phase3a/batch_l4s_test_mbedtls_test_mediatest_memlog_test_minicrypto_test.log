}\n44\t};\n45\t\n46\t\n47\tstatic int l4s_congestion_test(picoquic_congestion_algorithm_t* ccalgo, int do_l4s, uint64_t max_completion_time, uint64_t max_losses, uint64_t max_rttvar,\n48\t    size_t nb_link_states, test_vary_link_spec_t* link_state)\n49\t{\n50\t    uint64_t simulated_time = 0;\n51\t    uint64_t queue_delay_max = 20000;\n52\t    uint64_t l4s_max = max_rttvar;\n53\t    picoquic_test_tls_api_ctx_t* test_ctx = NULL;\n54\t    picoquic_connection_id_t initial_cid = { {0x45, 0xcc, 0, 0, 0, 0, 0, 0}, 8 };\n55\t    int ret;\n56\t\n57\t    initial_cid.id[2] = ccalgo->congestion_algorithm_number;\n58\t    initial_cid.id[3] = (uint8_t)nb_link_states;\n59\t\n60\t    for (size_t i = 0; i < nb_link_states; i++) {\n61\t        if (2 * link_state->microsec_latency > queue_delay_max) {\n62\t            queue_delay_max = 2 * link_state->microsec_latency;\n63\t            /* l4s_max = link_state->microsec_latency / 4; */\n64\t        }\n65\t    }\n66\t\n67\t    ret = tls_api_init_ctx_ex(&test_ctx, PICOQUIC_INTERNAL_TEST_VERSION_1, PICOQUIC_TEST_SNI, PICOQUIC_TEST_ALPN, &simulated_time, NULL, NULL, 0, 1, 0, &initial_cid);\n68\t\n69\t    if (ret == 0 && test_ctx == NULL) {\n70\t        ret = -1;\n71\t    }\n72\t    else {\n73\t        test_ctx->c_to_s_link->queue_delay_max = queue_delay_max;\n74\t        test_ctx->s_to_c_link->queue_delay_max = queue_delay_max;\n75\t    }\n76\t\n77\t    /* Set the congestion algorithm to specified value.\n78\t     * Initialize L4S behavior.\n79\t     * Request a packet trace */\n80\t    if (ret == 0) {\n81\t        picoquic_set_default_congestion_algorithm(test_ctx->qclient, ccalgo);\n82\t        picoquic_set_default_congestion_algorithm(test_ctx->qserver, ccalgo);\n83\t        picoquic_set_congestion_algorithm(test_ctx->cnx_client, ccalgo);\n84\t\n85\t\n86\t        if (do_l4s) {\n87\t            test_ctx->ecn_support = 1;\n88\t            test_ctx->packet_ecn_default = PICOQUIC_ECN_ECT_1;\n89\t            if ((ret = dualq_configure(test_ctx->c_to_s_link, l4s_max)) == 0) {\n90\t                ret = dualq_configure(test_ctx->s_to_c_link, l4s_max);\n91\t            }\n92\t        }\n93\t\n94\t        if (ret == 0) {\n95\t            picoquic_set_qlog(test_ctx->qserver, \".\");\n96\t\n97\t            ret = tls_api_one_scenario_body_ex(test_ctx, &simulated_time,\n98\t                test_scenario_l4s, sizeof(test_scenario_l4s), 0, 0, 0, queue_delay_max, max_completion_time, nb_link_states, link_state);\n99\t        }\n100\t    }\n101\t\n102\t    /* Verify that L4S ECN feedback was received properly */\n103\t    /* verify that the delay meets target requirements */\n104\t    /* Verify that the losses are as expected, \"low loss\" part of L4S */\n105\t    if (ret == 0) {\n106\t        if (test_ctx->cnx_server == NULL) {\n107\t            DBG_PRINTF(\"%s\", \"Cannot assess server connection\");\n108\t            ret = -1;\n109\t        }\n110\t        else if (test_ctx->cnx_server->nb_retransmission_total > max_losses) {\n111\t            DBG_PRINTF(\"Noted %\" PRIu64 \" losses, expected maximum %\" PRIu64, test_ctx->cnx_server->nb_retransmission_total, max_losses);\n112\t            ret = -1;\n113\t        }\n114\t        else if (test_ctx->cnx_server->path[0]->rtt_variant > max_rttvar) {\n115\t            DBG_PRINTF(\"RTT variant %\" PRIu64 \", expected maximum %\" PRIu64, test_ctx->cnx_server->path[0]->rtt_variant, max_rttvar);\n116\t            ret = -1;\n117\t        }\n118\t    }\n119\t\n120\t    /* Free the resource, which will close the log file.\n121\t     */\n122\t\n123\t    if (test_ctx != NULL) {\n124\t        tls_api_delete_ctx(test_ctx);\n125\t        test_ctx = NULL;\n126\t    }\n127\t\n128\t    return ret;\n129\t}\n130\t\n131\t/* This test is used for reference. Perf is bad, because each CE mark is\n132\t * a congestion mark.\n133\t */\n134\tint l4s_reno_test(void)\n135\t{\n136\t    picoquic_congestion_algorithm_t* ccalgo = picoquic_newreno_algorithm;\n137\t\n138\t    int ret = l4s_congestion_test(ccalgo, 1, 5600000, 45, 3000, 0, NULL);\n139\t\n140\t    return ret;\n141\t}\n142\t\n143\tint l4s_prague_test(void)\n144\t{\n145\t    picoquic_congestion_algorithm_t* ccalgo = picoquic_prague_algorithm;\n146\t\n147\t    int ret = l4s_congestion_test(ccalgo, 1, 4100000, 9, 4500, 0, NULL);\n148\t\n149\t    return ret;\n150\t}\n151\t\n152\tint l4s_bbr_test(void)\n153\t{\n154\t    picoquic_congestion_algorithm_t* ccalgo = picoquic_bbr_algorithm;\n155\t\n156\t    int ret = l4s_congestion_test(ccalgo, 1, 3800000, 21, 3000, 0, NULL);\n157\t\n158\t    return ret;\n159\t}\n160\t\n161\t\n162\tint l4s_c4_test(void)\n163\t{\n164\t    picoquic_congestion_algorithm_t* ccalgo = c4_algorithm;\n165\t\n166\t    int ret = l4s_congestion_test(ccalgo, 1, 3600000, 30, 3000, 0, NULL);\n167\t\n168\t    return ret;\n169\t}\n170\t\n171\ttest_vary_link_spec_t l4s_link_updown[] = {\n172\t    { 1000000, 10000000, 10000000, 10000},\n173\t    { 2000000,  2000000,  2000000, 10000},\n174\t    { 8000000, 10000000, 10000000, 10000},\n175\t};\n176\t\n177\tsize_t nb_l4s_link_updown = sizeof(l4s_link_updown) / sizeof(test_vary_link_spec_t);\n178\t\n179\tint l4s_prague_updown_test(void)\n180\t{\n181\t    picoquic_congestion_algorithm_t* ccalgo = picoquic_prague_algorithm;\n182\t\n183\t    int ret = l4s_congestion_test(ccalgo, 1, 6300000, 55, 6000, nb_l4s_link_updown, l4s_link_updown);\n184\t\n185\t    return ret;\n186\t}\n187\t\n188\tint l4s_bbr_updown_test(void)\n189\t{\n190\t#if defined(_WINDOWS) && !defined(_WINDOWS64)\n191\t    return 0;\n192\t#else\n193\t    picoquic_congestion_algorithm_t* ccalgo = picoquic_bbr_algorithm;\n194\t\n195\t    int ret = l4s_congestion_test(ccalgo, 1, 5800000, 69, 3000, nb_l4s_link_updown, l4s_link_updown);\n196\t\n197\t    return ret;\n198\t#endif\n199\t}\n200\t"}]},"parent_tool_use_id":null,"session_id":"efe36d5e-8c7a-42d9-a085-8d43da824da0","uuid":"9f26d7ff-c764-4cb1-a3f6-b85d72c1d53b","timestamp":"2026-05-05T03:51:52.421Z","tool_use_result":{"type":"text","file":{"filePath":"/Users/richbarn/Projects/picoquic/picoquictest/l4s_test.c","content":"/*\n* Author: Christian Huitema\n* Copyright (c) 2022, Private Octopus, Inc.\n* All rights reserved.\n*\n* Permission to use, copy, modify, and distribute this software for any\n* purpose with or without fee is hereby granted, provided that the above\n* copyright notice and this permission notice appear in all copies.\n*\n* THIS SOFTWARE IS PROVIDED BY THE COPYRIGHT HOLDERS AND CONTRIBUTORS \"AS IS\" AND\n* ANY EXPRESS OR IMPLIED WARRANTIES, INCLUDING, BUT NOT LIMITED TO, THE IMPLIED\n* WARRANTIES OF MERCHANTABILITY AND FITNESS FOR A PARTICULAR PURPOSE ARE\n* DISCLAIMED. IN NO EVENT SHALL Private Octopus, Inc. BE LIABLE FOR ANY\n* DIRECT, INDIRECT, INCIDENTAL, SPECIAL, EXEMPLARY, OR CONSEQUENTIAL DAMAGES\n* (INCLUDING, BUT NOT LIMITED TO, PROCUREMENT OF SUBSTITUTE GOODS OR SERVICES;\n* LOSS OF USE, DATA, OR PROFITS; OR BUSINESS INTERRUPTION) HOWEVER CAUSED AND\n* ON ANY THEORY OF LIABILITY, WHETHER IN CONTRACT, STRICT LIABILITY, OR TORT\n* (INCLUDING NEGLIGENCE OR OTHERWISE) ARISING IN ANY WAY OUT OF THE USE OF THIS\n* SOFTWARE, EVEN IF ADVISED OF THE POSSIBILITY OF SUCH DAMAGE.\n*/\n\n#include <stdlib.h>\n#include <string.h>\n#include \"picoquic.h\"\n#include \"picoquic_utils.h\"\n#include \"picosocks.h\"\n#include \"picoquic_internal.h\"\n#include \"picoquictest_internal.h\"\n#include \"tls_api.h\"\n#include \"picoquic_qlog.h\"\n#include \"picoquic_newreno.h\"\n#include \"picoquic_cubic.h\"\n#include \"picoquic_bbr.h\"\n#include \"picoquic_prague.h\"\n#include \"c4.h\"\n\n#include \"picoquictest_dualq.h\"\n\nstatic test_api_stream_desc_t test_scenario_l4s[] = {\n    { 4, 0, 257, 1000000 },\n    { 8, 4, 257, 1000000 },\n    { 12, 8, 257, 1000000 },\n    { 16, 12, 257, 1000000 }\n};\n\n\nstatic int l4s_congestion_test(picoquic_congestion_algorithm_t* ccalgo, int do_l4s, uint64_t max_completion_time, uint64_t max_losses, uint64_t max_rttvar,\n    size_t nb_link_states, test_vary_link_spec_t* link_state)\n{\n    uint64_t simulated_time = 0;\n    uint64_t queue_delay_max = 20000;\n    uint64_t l4s_max = max_rttvar;\n    picoquic_test_tls_api_ctx_t* test_ctx = NULL;\n    picoquic_connection_id_t initial_cid = { {0x45, 0xcc, 0, 0, 0, 0, 0, 0}, 8 };\n    int ret;\n\n    initial_cid.id[2] = ccalgo->congestion_algorithm_number;\n    initial_cid.id[3] = (uint8_t)nb_link_states;\n\n    for (size_t i = 0; i < nb_link_states; i++) {\n        if (2 * link_state->microsec_latency > queue_delay_max) {\n            queue_delay_max = 2 * link_state->microsec_latency;\n            /* l4s_max = link_state->microsec_latency / 4; */\n        }\n    }\n\n    ret = tls_api_init_ctx_ex(&test_ctx, PICOQUIC_INTERNAL_TEST_VERSION_1, PICOQUIC_TEST_SNI, PICOQUIC_TEST_ALPN, &simulated_time, NULL, NULL, 0, 1, 0, &initial_cid);\n\n    if (ret == 0 && test_ctx == NULL) {\n        ret = -1;\n    }\n    else {\n        test_ctx->c_to_s_link->queue_delay_max = queue_delay_max;\n        test_ctx->s_to_c_link->queue_delay_max = queue_delay_max;\n    }\n\n    /* Set the congestion algorithm to specified value.\n     * Initialize L4S behavior.\n     * Request a packet trace */\n    if (ret == 0) {\n        picoquic_set_default_congestion_algorithm(test_ctx->qclient, ccalgo);\n        picoquic_set_default_congestion_algorithm(test_ctx->qserver, ccalgo);\n        picoquic_set_congestion_algorithm(test_ctx->cnx_client, ccalgo);\n\n\n        if (do_l4s) {\n            test_ctx->ecn_support = 1;\n            test_ctx->packet_ecn_default = PICOQUIC_ECN_ECT_1;\n            if ((ret = dualq_configure(test_ctx->c_to_s_link, l4s_max)) == 0) {\n                ret = dualq_configure(test_ctx->s_to_c_link, l4s_max);\n            }\n        }\n\n        if (ret == 0) {\n            picoquic_set_qlog(test_ctx->qserver, \".\");\n\n            ret = tls_api_one_scenario_body_ex(test_ctx, &simulated_time,\n                test_scenario_l4s, sizeof(test_scenario_l4s), 0, 0, 0, queue_delay_max, max_completion_time, nb_link_states, link_state);\n        }\n    }\n\n    /* Verify that L4S ECN feedback was received properly */\n    /* verify that the delay meets target requirements */\n    /* Verify that the losses are as expected, \"low loss\" part of L4S */\n    if (ret == 0) {\n        if (test_ctx->cnx_server == NULL) {\n            DBG_PRINTF(\"%s\", \"Cannot assess server connection\");\n            ret = -1;\n        }\n        else if (test_ctx->cnx_server->nb_retransmission_total > max_losses) {\n            DBG_PRINTF(\"Noted %\" PRIu64 \" losses, expected maximum %\" PRIu64, test_ctx->cnx_server->nb_retransmission_total, max_losses);\n            ret = -1;\n        }\n        else if (test_ctx->cnx_server->path[0]->rtt_variant > max_rttvar) {\n            DBG_PRINTF(\"RTT variant %\" PRIu64 \", expected maximum %\" PRIu64, test_ctx->cnx_server->path[0]->rtt_variant, max_rttvar);\n            ret = -1;\n        }\n    }\n\n    /* Free the resource, which will close the log file.\n     */\n\n    if (test_ctx != NULL) {\n        tls_api_delete_ctx(test_ctx);\n        test_ctx = NULL;\n    }\n\n    return ret;\n}\n\n/* This test is used for reference. Perf is bad, because each CE mark is\n * a congestion mark.\n */\nint l4s_reno_test(void)\n{\n    picoquic_congestion_algorithm_t* ccalgo = picoquic_newreno_algorithm;\n\n    int ret = l4s_congestion_test(ccalgo, 1, 5600000, 45, 3000, 0, NULL);\n\n    return ret;\n}\n\nint l4s_prague_test(void)\n{\n    picoquic_congestion_algorithm_t* ccalgo = picoquic_prague_algorithm;\n\n    int ret = l4s_congestion_test(ccalgo, 1, 4100000, 9, 4500, 0, NULL);\n\n    return ret;\n}\n\nint l4s_bbr_test(void)\n{\n    picoquic_congestion_algorithm_t* ccalgo = picoquic_bbr_algorithm;\n\n    int ret = l4s_congestion_test(ccalgo, 1, 3800000, 21, 3000, 0, NULL);\n\n    return ret;\n}\n\n\nint l4s_c4_test(void)\n{\n    picoquic_congestion_algorithm_t* ccalgo = c4_algorithm;\n\n    int ret = l4s_congestion_test(ccalgo, 1, 3600000, 30, 3000, 0, NULL);\n\n    return ret;\n}\n\ntest_vary_link_spec_t l4s_link_updown[] = {\n    { 1000000, 10000000, 10000000, 10000},\n    { 2000000,  2000000,  2000000, 10000},\n    { 8000000, 10000000, 10000000, 10000},\n};\n\nsize_t nb_l4s_link_updown = sizeof(l4s_link_updown) / sizeof(test_vary_link_spec_t);\n\nint l4s_prague_updown_test(void)\n{\n    picoquic_congestion_algorithm_t* ccalgo = picoquic_prague_algorithm;\n\n    int ret = l4s_congestion_test(ccalgo, 1, 6300000, 55, 6000, nb_l4s_link_updown, l4s_link_updown);\n\n    return ret;\n}\n\nint l4s_bbr_updown_test(void)\n{\n#if defined(_WINDOWS) && !defined(_WINDOWS64)\n    return 0;\n#else\n    picoquic_congestion_algorithm_t* ccalgo = picoquic_bbr_algorithm;\n\n    int ret = l4s_congestion_test(ccalgo, 1, 5800000, 69, 3000, nb_l4s_link_updown, l4s_link_updown);\n\n    return ret;\n#endif\n}\n","numLines":200,"startLine":1,"totalLines":200}}}
