{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01JpGVefdFr1VNuorFoSTVCu","type":"tool_result","content":"1\t/*\n2\t* Author: Christian Huitema\n3\t* Copyright (c) 2019, Private Octopus, Inc.\n4\t* All rights reserved.\n5\t*\n6\t* Permission to use, copy, modify, and distribute this software for any\n7\t* purpose with or without fee is hereby granted, provided that the above\n8\t* copyright notice and this permission notice appear in all copies.\n9\t*\n10\t* THIS SOFTWARE IS PROVIDED BY THE COPYRIGHT HOLDERS AND CONTRIBUTORS \"AS IS\" AND\n11\t* ANY EXPRESS OR IMPLIED WARRANTIES, INCLUDING, BUT NOT LIMITED TO, THE IMPLIED\n12\t* WARRANTIES OF MERCHANTABILITY AND FITNESS FOR A PARTICULAR PURPOSE ARE\n13\t* DISCLAIMED. IN NO EVENT SHALL Private Octopus, Inc. BE LIABLE FOR ANY\n14\t* DIRECT, INDIRECT, INCIDENTAL, SPECIAL, EXEMPLARY, OR CONSEQUENTIAL DAMAGES\n15\t* (INCLUDING, BUT NOT LIMITED TO, PROCUREMENT OF SUBSTITUTE GOODS OR SERVICES;\n16\t* LOSS OF USE, DATA, OR PROFITS; OR BUSINESS INTERRUPTION) HOWEVER CAUSED AND\n17\t* ON ANY THEORY OF LIABILITY, WHETHER IN CONTRACT, STRICT LIABILITY, OR TORT\n18\t* (INCLUDING NEGLIGENCE OR OTHERWISE) ARISING IN ANY WAY OUT OF THE USE OF THIS\n19\t* SOFTWARE, EVEN IF ADVISED OF THE POSSIBILITY OF SUCH DAMAGE.\n20\t*/\n21\t\n22\t#include <stdlib.h>\n23\t#include <string.h>\n24\t#include <stdint.h>\n25\t#include <math.h>\n26\t#include \"picoquic.h\"\n27\t#include \"picoquic_utils.h\"\n28\t#include \"picoquictest_internal.h\"\n29\t#include \"picoquic_binlog.h\"\n30\t#include \"picoquic_cubic.h\"\n31\t#include \"picoquic_bbr.h\"\n32\t\n33\t/* Media tests: simulate media transmission, include cases in which\n34\t* the media bandwidth is much lower than the available bandwidth on\n35\t* average, but sometimes higher when sending large frames. Also\n36\t* consider case of audio + video, sent as stream, together with\n37\t* data. Shall verify that audio and video delays do not suffer\n38\t* in presence of data streams.\n39\t* \n40\t* This requires writing a data generation model that mimics real time.\n41\t* The network topology will be simple: client, server, link.\n42\t* \n43\t* Data generation is linked to a callback. The callback accomodate for:\n44\t* - video generation model, 60 fps, combined one large \"I\" frame and\n45\t*   then 99 \"P\" frames, repeated three times.\n46\t* - Audio generation model, 50 fps, 30 bytes per frame.\n47\t* - Data generation model, some number of megabytes.\n48\t* \n49\t* The test must verify that frame delays are within specified bounds.\n50\t* For that, we will format the frames:\n51\t* - length: in bytes\n52\t* - type: Audio, Video, Data.\n53\t* - time sent.\n54\t* \n55\t*/\n56\t\n57\t#define MEDIATEST_ALPN \"picoquic_mediatest\"\n58\t#define MEDIATEST_HEADER_SIZE 13\n59\t#define MEDIATEST_ERROR_INTERNAL 1\n60\t#define MEDIATEST_DURATION 10000000\n61\t#define MEDIATEST_AUDIO_PERIOD 20000\n62\t#define MEDIATEST_VIDEO_PERIOD 33333\n63\t#define MEDIATEST_VIDEO2_PERIOD 16666\n64\t#define MEDIATEST_DATA_FRAME_SIZE 0x4000\n65\t\n66\ttypedef enum {\n67\t    mediatest_video = 1,\n68\t    mediatest_video_audio = 2,\n69\t    mediatest_video_data_audio = 3,\n70\t    mediatest_worst = 4,\n71\t    mediatest_video2_down = 5,\n72\t    mediatest_wifi = 6,\n73\t    mediatest_video2_back = 7,\n74\t    mediatest_suspension = 8,\n75\t    mediatest_video2_probe = 9,\n76\t    mediatest_suspension2 = 10,\n77\t    mediatest_no_coal = 11\n78\t} mediatest_id_enum;\n79\t\n80\ttypedef enum {\n81\t    media_test_data = 0,\n82\t    media_test_audio,\n83\t    media_test_video,\n84\t    media_test_video2,\n85\t    media_test_nb_types\n86\t} media_test_type_enum;\n87\t\n88\ttypedef struct st_mediatest_message_buffer_t {\n89\t    size_t bytes_sent;\n90\t    size_t bytes_received;\n91\t    media_test_type_enum message_type;\n92\t    uint32_t message_size;\n93\t    uint64_t sent_time;\n94\t    uint8_t header[MEDIATEST_HEADER_SIZE];\n95\t} mediatest_message_buffer_t;\n96\t\n97\ttypedef struct st_mediatest_stream_ctx_t {\n98\t    /* Organize the streams as part of the connection */\n99\t    struct st_mediatest_stream_ctx_t* next_stream;\n100\t    struct st_mediatest_stream_ctx_t* previous_stream;\n101\t    struct st_mediatest_cnx_ctx_t* cnx_ctx;\n102\t    /* stream identifier */\n103\t    uint64_t stream_id;\n104\t    /* Specify the type of stream */\n105\t    media_test_type_enum stream_type;\n106\t    /* Specify the state of the stream: number of frames sent  or received */\n107\t    unsigned int is_sender : 1;\n108\t    unsigned int finished_sending : 1;\n109\t    unsigned int fin_received : 1;\n110\t    unsigned int is_fin_sent : 1;\n111\t    unsigned int is_reset : 1;\n112\t\n113\t    uint64_t frames_to_send;\n114\t    uint64_t frames_sent;\n115\t    uint64_t frames_skipped;\n116\t    uint64_t frames_received;\n117\t    size_t bytes_sent;\n118\t    size_t bytes_received;\n119\t    uint64_t next_frame_time;\n120\t    uint64_t next_iframe_time;\n121\t\n122\t    mediatest_message_buffer_t message_sent;\n123\t    mediatest_message_buffer_t message_received;\n124\t} mediatest_stream_ctx_t;\n125\t\n126\t/* Mediatest per connection context */\n127\ttypedef struct st_mediatest_cnx_ctx_t {\n128\t    struct st_mediatest_cnx_ctx_t* next_cnx;\n129\t    struct st_mediatest_cnx_ctx_t* previous_cnx;\n130\t    struct st_mediatest_ctx_t* mt_ctx;\n131\t\n132\t    char* sni;\n133\t    struct sockaddr_storage addr;\n134\t    picoquic_cnx_t* cnx;\n135\t    int is_server;\n136\t\n137\t    struct st_mediatest_stream_ctx_t* first_stream;\n138\t    struct st_mediatest_stream_ctx_t* last_stream;\n139\t} mediatest_cnx_ctx_t;\n140\t\n141\t/* Mediatest statistics per media type */\n142\ttypedef struct st_mediatest_media_stats_t {\n143\t    int nb_frames;\n144\t    uint64_t sum_delays;\n145\t    uint64_t sum_square_delays;\n146\t    uint64_t min_delay;\n147\t    uint64_t max_delay;\n148\t} mediatest_media_stats_t;\n149\t\n150\t/* Mediatest context */"}]},