ength);\n645\t        if (buffer == NULL) {\n646\t            ret = -1;\n647\t        }\n648\t        else {\n649\t            memset(buffer, 'd', length);\n650\t            mt_ctx->datagram_data_sent += length;\n651\t            mt_ctx->nb_datagrams_sent++;\n652\t        }\n653\t    }\n654\t    if (ret == 0) {\n655\t        ret = picoquic_mark_datagram_ready(cnx_ctx->cnx, is_active);\n656\t    }\n657\t\n658\t    return ret;\n659\t}\n660\t\n661\t/* Callback from Quic\n662\t*/\n663\tint mediatest_callback(picoquic_cnx_t* cnx,\n664\t    uint64_t stream_id, uint8_t* bytes, size_t length,\n665\t    picoquic_call_back_event_t fin_or_event, void* callback_ctx, void* v_stream_ctx)\n666\t{\n667\t\n668\t    int ret = 0;\n669\t    mediatest_cnx_ctx_t* cnx_ctx = (mediatest_cnx_ctx_t*)callback_ctx;\n670\t    mediatest_stream_ctx_t* stream_ctx = (mediatest_stream_ctx_t*)v_stream_ctx;\n671\t\n672\t    /* If this is the first reference to the connection, the application context is set\n673\t    * to the default value defined for the server. This default value contains the pointer\n674\t    * to the global context in which streams and roles are defined.\n675\t    */\n676\t    if (callback_ctx == NULL || callback_ctx == picoquic_get_default_callback_context(picoquic_get_quic_ctx(cnx))) {\n677\t        if (fin_or_event == picoquic_callback_close) {\n678\t            picoquic_set_callback(cnx, NULL, NULL);\n679\t            return 0;\n680\t        }\n681\t        else {\n682\t            cnx_ctx = mediatest_create_cnx_context((mediatest_ctx_t*)callback_ctx, cnx);\n683\t            if (cnx_ctx == NULL) {\n684\t                /* cannot handle the connection */\n685\t                picoquic_close(cnx, PICOQUIC_ERROR_MEMORY);\n686\t                return -1;\n687\t            }\n688\t            else {\n689\t                cnx_ctx->is_server = 1;\n690\t                picoquic_set_callback(cnx, mediatest_callback, cnx_ctx);\n691\t            }\n692\t        }\n693\t    }\n694\t\n695\t    if (ret == 0) {\n696\t        switch (fin_or_event) {\n697\t        case picoquic_callback_stream_data:\n698\t        case picoquic_callback_stream_fin:\n699\t            /* Data arrival on stream #x, maybe with fin mark */\n700\t            if (stream_ctx == NULL) {\n701\t                /* Retrieve, or create and initialize stream context */\n702\t                stream_ctx = mediatest_find_or_create_stream(stream_id, cnx_ctx, 1);\n703\t            }\n704\t\n705\t            if (stream_ctx == NULL) {\n706\t                /* Internal error */\n707\t                (void)picoquic_reset_stream(cnx, stream_id, MEDIATEST_ERROR_INTERNAL);\n708\t                ret = -1;\n709\t            }\n710\t            else {\n711\t                ret = mediatest_receive_stream_data(stream_ctx, bytes, length, (fin_or_event == picoquic_callback_stream_fin));\n712\t            }\n713\t            break;\n714\t        case picoquic_callback_prepare_to_send:\n715\t            /* Active sending API */\n716\t            if (stream_ctx == NULL) {\n717\t                /* This should never happen */\n718\t                picoquic_log_app_message(cnx, \"MEDIATEST callback returns %d, event %d\", ret, fin_or_event);\n719\t                DBG_PRINTF(\"Prepare to send on NULL context, steam: %\" PRIu64, stream_id);\n720\t                ret = -1;\n721\t            }\n722\t            else {\n723\t                ret = mediatest_prepare_to_send_on_stream(stream_ctx, bytes, length, cnx_ctx->mt_ctx->simulated_time);\n724\t            }\n725\t            break;\n726\t        case picoquic_callback_datagram:\n727\t            /* Receive data in a datagram */\n728\t            ret = mediatest_receive_datagram(cnx_ctx, length);\n729\t            break;\n730\t        case picoquic_callback_prepare_datagram:\n731\t            /* Prepare to send a datagram */\n732\t        {\n733\t            ret = mediatest_prepare_to_send_datagram(cnx_ctx, bytes, length);\n734\t            break;\n735\t        }\n736\t        case picoquic_callback_stream_reset: /* Client reset stream #x */\n737\t        case picoquic_callback_stop_sending: /* Client asks server to reset stream #x */\n738\t                                             /* TODO: react to abandon stream, etc. */\n739\t            break;\n740\t        case picoquic_callback_stateless_reset: /* Received an error message */\n741\t        case picoquic_callback_close: /* Received connection close */\n742\t        case picoquic_callback_application_close: /* Received application close */\n743\t                                                  /* Remove the connection from the context, and then delete it */\n744\t            cnx_ctx->cnx = NULL;\n745\t            mediatest_delete_cnx_context(cnx_ctx);\n746\t            picoquic_set_callback(cnx, NULL, NULL);\n747\t            break;\n748\t        case picoquic_callback_version_negotiation:\n749\t            /* The server should never receive a version negotiation response */\n750\t            break;\n751\t        case picoquic_callback_stream_gap:\n752\t            /* This callback is never used. */\n753\t            break;\n754\t        case picoquic_callback_almost_ready:\n755\t        case picoquic_callback_ready:\n756\t            if (cnx_ctx->mt_ctx->datagram_data_requested > 0 && !cnx_ctx->is_server) {\n757\t                ret = picoquic_mark_datagram_ready(cnx, 1);\n758\t            }\n759\t            break;\n760\t        case picoquic_callback_datagram_acked:\n761\t            /* Ack for packet carrying datagram-object received from peer */\n762\t        case picoquic_callback_datagram_lost:\n763\t            /* Packet carrying datagram-object probably lost */\n764\t        case picoquic_callback_datagram_spurious:\n765\t            /* Packet carrying datagram-object was not really lost */\n766\t#if 0\n767\t            ret = mediatest_handle_datagram_ack_nack(cnx_ctx, fin_or_event, stream_id /* encodes the send time!*/,\n768\t                bytes, length, picoquic_get_quic_time(cnx_ctx->mt_ctx->quic));\n769\t#else\n770\t            ret = 0;\n771\t#endif\n772\t            break;\n773\t        case picoquic_callback_pacing_changed:\n774\t            /* Notification of rate change from congestion controller */\n775\t            break;\n776\t        default:\n777\t            /* unexpected */\n778\t            break;\n779\t        }\n780\t    }\n781\t\n782\t    if (ret != 0) {\n783\t        picoquic_log_app_message(cnx, \"MEDIATEST callback returns %d, event %d\", ret, fin_or_event);\n784\t        DBG_PRINTF(\"MEDIATEST callback returns %d, event %d\", ret, fin_or_event);\n785\t    }\n786\t\n787\t\n788\t    return ret;\n789\t}\n790\t\n791\t\n792\t/* Process arrival of a packet from a link */\n793\tint mediatest_packet_arrival(mediatest_ctx_t* mt_ctx, int link_id, int is_losing_data, int * is_active)\n794\t{\n795\t    int ret = 0;\n796\t    picoquictest_sim_packet_t* packet = picoquictest_sim_link_dequeue(mt_ctx->link[link_id], mt_ctx->simulated_time);\n797\t\n798\t    if (packet == NULL) {\n799\t        /* unexpected, probably bug in test program */"}]},"parent_tool_use_id":null,"session_id":"efe36d5e-8c7a-42d9-a085-8d43da824da0","uuid":"ad45093a-5c53-463e-b8b0-63fc23dae5fd","timestamp":"2026-05-05T03:52:05.223Z","tool_use_result":{"type":"text","file":{"filePath":"/Users/richbarn/Projects/picoquic/picoquictest/mediatest.c","content":"                    memset(&stream_ctx->message_sent, 0, sizeof(mediatest_message_buffer_t));\n                    stream_ctx->frames_sent += 1;\n                    stream_ctx->finished_sending = (stream_ctx->frames_sent >= stream_ctx->frames_to_send) ? 1 : 0;\n                }\n            }\n        }\n        else {\n            (void)picoquic_provide_stream_data_buffer(context, 0, 0, 0);\n        }\n    }\n    else if (stream_ctx->fin_received && !stream_ctx->is_fin_sent) {\n        (void)picoquic_provide_stream_data_buffer(context, 0, 1, 0);\n        stream_ctx->is_fin_sent = 1;\n    }\n    return ret;\n}\n\n/* Receive datagram data.\n * We only use datagrams to test conflicts between datagrams and streams,\n * deliberately causing bandwidth saturation with datagrams.\n */\nint mediatest_receive_datagram(mediatest_cnx_ctx_t* cnx_ctx, size_t  length)\n{\n    cnx_ctx->mt_ctx->nb_datagrams_received++;\n    cnx_ctx->mt_ctx->datagram_data_received += length;\n    return 0;\n}\n\nint mediatest_prepare_to_send_datagram(mediatest_cnx_ctx_t* cnx_ctx, void * context, size_t length)\n{\n    int ret = 0;\n    mediatest_ctx_t* mt_ctx = cnx_ctx->mt_ctx;\n    size_t available = 0;\n    int is_active = 0;\n    if (mt_ctx->datagram_data_sent < mt_ctx->datagram_data_requested) {\n        void* buffer;\n\n        is_active = 1;\n        available = mt_ctx->datagram_data_requested - mt_ctx->datagram_data_sent;\n        if (available < length) {\n            length = available;\n            is_active = 0;\n        }\n        /* Get a buffer inside the datagram packet */\n        buffer = picoquic_provide_datagram_buffer(context, length);\n        if (buffer == NULL) {\n            ret = -1;\n        }\n        else {\n            memset(buffer, 'd', length);\n            mt_ctx->datagram_data_sent += length;\n            mt_ctx->nb_datagrams_sent++;\n        }\n    }\n    if (ret == 0) {\n        ret = picoquic_mark_datagram_ready(cnx_ctx->cnx, is_active);\n    }\n\n    return ret;\n}\n\n/* Callback from Quic\n*/\nint mediatest_callback(picoquic_cnx_t* cnx,\n    uint64_t stream_id, uint8_t* bytes, size_t length,\n    picoquic_call_back_event_t fin_or_event, void* callback_ctx, void* v_stream_ctx)\n{\n\n    int ret = 0;\n    mediatest_cnx_ctx_t* cnx_ctx = (mediatest_cnx_ctx_t*)callback_ctx;\n    mediatest_stream_ctx_t* stream_ctx = (mediatest_stream_ctx_t*)v_stream_ctx;\n\n    /* If this is the first reference to the connection, the application context is set\n    * to the default value defined for the server. This default value contains the pointer\n    * to the global context in which streams and roles are defined.\n    */\n    if (callback_ctx == NULL || callback_ctx == picoquic_get_default_callback_context(picoquic_get_quic_ctx(cnx))) {\n        if (fin_or_event == picoquic_callback_close) {\n            picoquic_set_callback(cnx, NULL, NULL);\n            return 0;\n        }\n        else {\n            cnx_ctx = mediatest_create_cnx_context((mediatest_ctx_t*)callback_ctx, cnx);\n            if (cnx_ctx == NULL) {\n                /* cannot handle the connection */\n                picoquic_close(cnx, PICOQUIC_ERROR_MEMORY);\n                return -1;\n            }\n            else {\n                cnx_ctx->is_server = 1;\n                picoquic_set_callback(cnx, mediatest_callback, cnx_ctx);\n            }\n        }\n    }\n\n    if (ret == 0) {\n        switch (fin_or_event) {\n        case picoquic_callback_stream_data:\n        case picoquic_callback_stream_fin:\n            /* Data arrival on stream #x, maybe with fin mark */\n            if (stream_ctx == NULL) {\n                /* Retrieve, or create and initialize stream context */\n                stream_ctx = mediatest_find_or_create_stream(stream_id, cnx_ctx, 1);\n            }\n\n            if (stream_ctx == NULL) {\n                /* Internal error */\n                (void)picoquic_reset_stream(cnx, stream_id, MEDIATEST_ERROR_INTERNAL);\n                ret = -1;\n            }\n            else {\n                ret = mediatest_receive_stream_data(stream_ctx, bytes, length, (fin_or_event == picoquic_callback_stream_fin));\n            }\n            break;\n        case picoquic_callback_prepare_to_send:\n            /* Active sending API */\n            if (stream_ctx == NULL) {\n                /* This should never happen */\n                picoquic_log_app_message(cnx, \"MEDIATEST callback returns %d, event %d\", ret, fin_or_event);\n                DBG_PRINTF(\"Prepare to send on NULL context, steam: %\" PRIu64, stream_id);\n                ret = -1;\n            }\n            else {\n                ret = mediatest_prepare_to_send_on_stream(stream_ctx, bytes, length, cnx_ctx->mt_ctx->simulated_time);\n            }\n            break;\n        case picoquic_callback_datagram:\n            /* Receive data in a datagram */\n            ret = mediatest_receive_datagram(cnx_ctx, length);\n            break;\n        case picoquic_callback_prepare_datagram:\n            /* Prepare to send a datagram */\n        {\n            ret = mediatest_prepare_to_send_datagram(cnx_ctx, bytes, length);\n            break;\n        }\n        case picoquic_callback_stream_reset: /* Client reset stream #x */\n        case picoquic_callback_stop_sending: /* Client asks server to reset stream #x */\n                                             /* TODO: react to abandon stream, etc. */\n            break;\n        case picoquic_callback_stateless_reset: /* Received an error message */\n        case picoquic_callback_close: /* Received connection close */\n        case picoquic_callback_application_close: /* Received application close */\n                                                  /* Remove the connection from the context, and then delete it */\n            cnx_ctx->cnx = NULL;\n            mediatest_delete_cnx_context(cnx_ctx);\n            picoquic_set_callback(cnx, NULL, NULL);\n            break;\n        case picoquic_callback_version_negotiation:\n            /* The server should never receive a version negotiation response */\n            break;\n        case picoquic_callback_stream_gap:\n            /* This callback is never used. */\n            break;\n        case picoquic_callback_almost_ready:\n        case picoquic_callback_ready:\n            if (cnx_ctx->mt_ctx->datagram_data_requested > 0 && !cnx_ctx->is_server) {\n                ret = picoquic_mark_datagram_ready(cnx, 1);\n            }\n            break;\n        case picoquic_callback_datagram_acked:\n            /* Ack for packet carrying datagram-object received from peer */\n        case picoquic_callback_datagram_lost:\n            /* Packet carrying datagram-object probably lost */\n        case picoquic_callback_datagram_spurious:\n            /* Packet carrying datagram-object was not really lost */\n#if 0\n            ret = mediatest_handle_datagram_ack_nack(cnx_ctx, fin_or_event, stream_id /* encodes the send time!*/,\n                bytes, length, picoquic_get_quic_time(cnx_ctx->mt_ctx->quic));\n#else\n            ret = 0;\n#endif\n            break;\n        case picoquic_callback_pacing_changed:\n            /* Notification of rate change from congestion controller */\n            break;\n        default:\n            /* unexpected */\n            break;\n        }\n    }\n\n    if (ret != 0) {\n        picoquic_log_app_message(cnx, \"MEDIATEST callback returns %d, event %d\", ret, fin_or_event);\n        DBG_PRINTF(\"MEDIATEST callback returns %d, event %d\", ret, fin_or_event);\n    }\n\n\n    return ret;\n}\n\n\n/* Process arrival of a packet from a link */\nint mediatest_packet_arrival(mediatest_ctx_t* mt_ctx, int link_id, int is_losing_data, int * is_active)\n{\n    int ret = 0;\n    picoquictest_sim_packet_t* packet = picoquictest_sim_link_dequeue(mt_ctx->link[link_id], mt_ctx->simulated_time);\n\n    if (packet == NULL) {\n        /* unexpected, probably bug in test program */","numLines":200,"startLine":600,"totalLines":1530}}}
