true }\n","structuredPatch":[{"oldStart":9,"oldLines":6,"newStart":9,"newLines":8,"lines":[" # for the implementations it actually links.  See `src/sys/`."," sys-picotls = []"," sys-openssl = [\"dep:openssl\"]","+sys-mbedtls = []","+sys-fusion = []"," "," [dependencies]"," fugit = { version = \"0.3\", default-features = false }"]}],"userModified":false,"replaceAll":false}}
