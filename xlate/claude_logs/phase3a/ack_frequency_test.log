icoquic_cnx_t* cnx, uint64_t unique_path_id,\n47\t    uint8_t* bytes, size_t length, void* datagram_ctx);\n48\ttypedef int (*picoquic_datagram_recv_fn)(picoquic_cnx_t* cnx, uint64_t unique_path_id,\n49\t    uint8_t* bytes, size_t length, void* datagram_ctx);\n50\ttypedef int (*picoquic_datagram_ack_fn)(picoquic_cnx_t* cnx,\n51\t    picoquic_call_back_event_t d_event, uint8_t* bytes, size_t length, uint64_t sent_time, void* datagram_ctx);\n52\t\n53\t/* Example functions for datagrams. */\n54\ttypedef struct st_test_datagram_send_recv_ctx_t {\n55\t    uint32_t dg_max_size;\n56\t    uint32_t dg_small_size;\n57\t    int dg_target[2];\n58\t    int dg_sent[2];\n59\t    int dg_recv[2];\n60\t    int dg_acked[2];\n61\t    int dg_nacked[2];\n62\t    int dg_spurious[2];\n63\t    int batch_size[2];\n64\t    int batch_sent[2];\n65\t    uint64_t dg_time_ready[2];\n66\t    uint64_t dg_latency_max[2];\n67\t    uint64_t dg_received_last[2];\n68\t    uint64_t dg_number_delta_max[2];\n69\t    uint64_t dg_latency_target[2];\n70\t    uint64_t dg_number_delta_target[2];\n71\t    uint64_t link_latency;\n72\t    uint64_t picosec_per_byte;\n73\t    uint64_t send_delay;\n74\t    uint64_t next_gen_time[2];\n75\t    uint64_t duration_max;\n76\t    int is_ready[2];\n77\t    int max_packets_received;\n78\t    int nb_recv_path_0[2];\n79\t    int nb_recv_path_other[2];\n80\t    int nb_trials_max;\n81\t\n82\t    unsigned int use_extended_provider_api;\n83\t    unsigned int do_skip_test[2];\n84\t    unsigned int is_skipping[2];\n85\t    unsigned int test_affinity;\n86\t    unsigned int test_wifi;\n87\t    unsigned int test_too_long;\n88\t    unsigned int one_datagram_per_packet;\n89\t\n90\t} test_datagram_send_recv_ctx_t;\n91\t\n92\tuint64_t test_datagram_next_time_ready(test_datagram_send_recv_ctx_t* dg_ctx);\n93\tint test_datagram_check_ready(test_datagram_send_recv_ctx_t* dg_ctx, int client_mode, uint64_t current_time);\n94\tint test_datagram_send(picoquic_cnx_t* cnx, uint64_t unique_path_id,\n95