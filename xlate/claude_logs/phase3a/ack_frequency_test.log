{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01G8SRZG8qVonuw3fh6snfAb","type":"tool_result","content":"1\t/*\n2\t* Author: Christian Huitema\n3\t* Copyright (c) 2020, Private Octopus, Inc.\n4\t* All rights reserved.\n5\t*\n6\t* Permission to use, copy, modify, and distribute this software for any\n7\t* purpose with or without fee is hereby granted, provided that the above\n8\t* copyright notice and this permission notice appear in all copies.\n9\t*\n10\t* THIS SOFTWARE IS PROVIDED BY THE COPYRIGHT HOLDERS AND CONTRIBUTORS \"AS IS\" AND\n11\t* ANY EXPRESS OR IMPLIED WARRANTIES, INCLUDING, BUT NOT LIMITED TO, THE IMPLIED\n12\t* WARRANTIES OF MERCHANTABILITY AND FITNESS FOR A PARTICULAR PURPOSE ARE\n13\t* DISCLAIMED. IN NO EVENT SHALL Private Octopus, Inc. BE LIABLE FOR ANY\n14\t* DIRECT, INDIRECT, INCIDENTAL, SPECIAL, EXEMPLARY, OR CONSEQUENTIAL DAMAGES\n15\t* (INCLUDING, BUT NOT LIMITED TO, PROCUREMENT OF SUBSTITUTE GOODS OR SERVICES;\n16\t* LOSS OF USE, DATA, OR PROFITS; OR BUSINESS INTERRUPTION) HOWEVER CAUSED AND\n17\t* ON ANY THEORY OF LIABILITY, WHETHER IN CONTRACT, STRICT LIABILITY, OR TORT\n18\t* (INCLUDING NEGLIGENCE OR OTHERWISE) ARISING IN ANY WAY OUT OF THE USE OF THIS\n19\t* SOFTWARE, EVEN IF ADVISED OF THE POSSIBILITY OF SUCH DAMAGE.\n20\t*/\n21\t\n22\t#include <stdlib.h>\n23\t#include <string.h>\n24\t#include \"picoquic.h\"\n25\t#include \"picoquic_internal.h\"\n26\t#include \"picoquictest_internal.h\"\n27\t#include \"tls_api.h\"\n28\t#include \"autoqlog.h\"\n29\t#include \"logreader.h\"\n30\t#include \"qlog.h\"\n31\t\n32\t#include \"picoquic_newreno.h\"\n33\t#include \"picoquic_cubic.h\"\n34\t#include \"picoquic_bbr.h\"\n35\t#include \"picoquic_bbr1.h\"\n36\t#include \"picoquic_fastcc.h\"\n37\t\n38\t/* Verify that the ack frequency is correctly set.\n39\t */\n40\t\n41\ttypedef enum {\n42\t    ackfrq_test_basic = 0\n43\t} ackfrq_test_enum;\n44\t\n45\ttypedef struct st_ackfrq_test_spec_t {\n46\t    ackfrq_test_enum test_id;\n47\t    uint64_t latency;\n48\t    uint64_t picosec_per_byte_down;\n49\t    uint64_t picosec_per_byte_up;\n50\t    picoquic_congestion_algorithm_t* ccalgo;\n51\t    uint64_t target_time;\n52\t    uint64_t max_ack_delay_remote;\n53\t    uint64_t max_ack_gap_remote;\n54\t    uint64_t min_ack_delay_remote;\n55\t    uint64_t target_interval;\n56\t} ackfrq_test_spec_t;\n57\t\n58\tstatic test_api_stream_desc_t test_scenario_ackfrq[] = {\n59\t    { 4, 0, 257, 1000000 }\n60\t};\n61\t\n62\tstatic int ackfrq_test_one(ackfrq_test_spec_t * spec)\n63\t{\n64\t    uint64_t simulated_time = 0;\n65\t    picoquic_connection_id_t initial_cid = { {0xac, 0xf8, 0, 0, 0, 0, 0, 0}, 8 };\n66\t    picoquic_test_tls_api_ctx_t* test_ctx = NULL;\n67\t    uint64_t loss_mask = 0;\n68\t    int ret = 0;\n69\t\n70\t    initial_cid.id[2] = spec->test_id;\n71\t\n72\t    ret = tls_api_one_scenario_init_ex(&test_ctx, &simulated_time, PICOQUIC_INTERNAL_TEST_VERSION_1, NULL, NULL, &initial_cid);\n73\t\n74\t    if (ret == 0 && test_ctx == NULL) {\n75\t        ret = -1;\n76\t    }\n77\t\n78\t    if (ret == 0) {\n79\t        picoquic_set_default_congestion_algorithm(test_ctx->qserver, spec->ccalgo);\n80\t        picoquic_set_congestion_algorithm(test_ctx->cnx_client, spec->ccalgo);\n81\t\n82\t        test_ctx->c_to_s_link->microsec_latency = spec->latency;\n83\t        test_ctx->s_to_c_link->microsec_latency = spec->latency;\n84\t\n85\t        if (spec->picosec_per_byte_down > 0) {\n86\t            test_ctx->s_to_c_link->picosec_per_byte = spec->picosec_per_byte_down;\n87\t        }\n88\t        if (spec->picosec_per_byte_up > 0) {\n89\t            test_ctx->c_to_s_link->picosec_per_byte = spec->picosec_per_byte_up;\n90\t        }\n91\t\n92\t        /* set the binary logs on both sides */\n93\t        picoquic_set_qlog(test_ctx->qclient, \".\");\n94\t        picoquic_set_qlog(test_ctx->qserver, \".\");\n95\t        picoquic_set_log_level(test_ctx->qserver, 1);\n96\t        picoquic_set_log_level(test_ctx->qclient, 1);\n97\t        test_ctx->qclient->use_long_log = 1;\n98\t        test_ctx->qserver->use_long_log = 1;\n99\t        /* Initialize the client connection */\n100\t        picoquic_start_client_cnx(test_ctx->cnx_client);\n101\t    }\n102\t\n103\t    /* establish the connection */\n104\t    if (ret == 0) {\n105\t        ret = tls_api_connection_loop(test_ctx, &loss_mask, 0, &simulated_time);\n106\t    }\n107\t\n108\t    /* wait until the client (and thus the server) is ready */\n109\t    if (ret == 0) {\n110\t        ret = wait_client_connection_ready(test_ctx, &simulated_time);\n111\t    }\n112\t\n113\t    /* Prepare to send data */\n114\t    if (ret == 0) {\n115\t        ret = test_api_init_send_recv_scenario(test_ctx, test_scenario_ackfrq, sizeof(test_scenario_ackfrq));\n116\t\n117\t        if (ret != 0)\n118\t        {\n119\t            DBG_PRINTF(\"Init send receive scenario returns %d\\n\", ret);\n120\t        }\n121\t    }\n122\t\n123\t    if (ret == 0) {\n124\t        ret = tls_api_data_sending_loop(test_ctx, &loss_mask, &simulated_time, 0);\n125\t    }\n126\t\n127\t    /* Check that the transmission succeeded */\n128\t    if (ret == 0) {\n129\t        ret = tls_api_one_scenario_body_verify(test_ctx, &simulated_time, spec->target_time);\n130\t    }\n131\t\n132\t\n133\t    /* TODO: verify that the ack frequency option is negotiated */\n134\t    if (ret == 0 && !test_ctx->cnx_client->is_ack_frequency_negotiated){\n135\t        DBG_PRINTF(\"%s\", \"Ack Frequency not negotiated at client\");\n136\t        ret = -1;\n137\t    }\n138\t\n139\t    if (ret == 0 && !test_ctx->cnx_server->is_ack_frequency_negotiated) {\n140\t        DBG_PRINTF(\"%s\", \"Ack Frequency not negotiated at server\");\n141\t        ret = -1;\n142\t    }\n143\t    /* Verify that the ack gap and ack delay are what we expected */\n144\t    if (ret == 0 && test_ctx->cnx_client->max_ack_delay_remote > spec->max_ack_delay_remote) {\n145\t        DBG_PRINTF(\"Max Ack Delay %\" PRIu64 \" > \" PRIu64, test_ctx->cnx_client->max_ack_delay_remote, spec->max_ack_delay_remote);\n146\t        ret = -1;\n147\t    }\n148\t    if (ret == 0 && test_ctx->cnx_client->min_ack_delay_remote > spec->min_ack_delay_remote) {\n149\t        DBG_PRINTF(\"Min Ack Delay %\" PRIu64 \" < \" PRIu64, test_ctx->cnx_client->min_ack_delay_remote, spec->min_ack_delay_remote);\n150\t        ret = -1;\n151\t    }\n152\t    if (ret == 0 && test_ctx->cnx_client->max_ack_gap_remote > spec->max_ack_gap_remote) {\n153\t        DBG_PRINTF(\"Max Ack Gap %\" PRIu64 \" > \" PRIu64, test_ctx->cnx_client->max_ack_gap_remote, spec->max_ack_gap_remote);\n154\t        ret = -1;\n155\t    }\n156\t\n157\t    if (ret == 0) {\n158\t        uint64_t duration = simulated_time - test_ctx->cnx_server->start_time;\n159\t        uint64_t interval = duration / test_ctx->cnx_server->nb_packets_received;\n160\t        uint64_t interval_min = interval - (interval >> 2);\n161\t        uint64_t interval_max = interval + (interval >> 2);\n162\t\n163\t        if (spec->target_interval < interval_min || spec->target_interval > interval_max) {\n164\t            DBG_PRINTF(\"Interval %\" PRIu64 \" <> \" PRIu64, interval, spec->target_interval);\n165\t            ret = -1;\n166\t        }\n167\t    }\n168\t\n169\t    /* Verify that the average time between ACK is close to expectations */\n170\t    /* Delete the context */\n171\t    if (test_ctx != NULL) {\n172\t        tls_api_delete_ctx(test_ctx);\n173\t    }\n174\t\n175\t    return ret;\n176\t}\n177\t\n178\tint ackfrq_basic_test(void)\n179\t{\n180\t    ackfrq_test_spec_t spec = { 0 };\n181\t    spec.test_id = ackfrq_test_basic;\n182\t    spec.latency = 10000;\n183\t    spec.picosec_per_byte_up = 80000;\n184\t    spec.picosec_per_byte_down = 80000;\n185\t    spec.ccalgo = picoquic_cubic_algorithm;\n186\t    spec.max_ack_delay_remote = 6000;\n187\t    spec.max_ack_gap_remote = 40;\n188\t    spec.min_ack_delay_remote = 1000;\n189\t    spec.target_interval = 4000;\n190\t\n191\t    return ackfrq_test_one(&spec);\n192\t}\n193\t\n194\tint ackfrq_short_test(void)\n195\t{\n196\t    ackfrq_test_spec_t spec = { 0 };\n197\t    spec.test_id = ackfrq_test_basic;\n198\t    spec.latency = 10;\n199\t    spec.picosec_per_byte_up = 80000;\n200\t    spec.picosec_per_byte_down = 80000;\n201\t    spec.ccalgo = picoquic_cubic_algorithm;\n202\t    spec.max_ack_delay_remote = 1000;\n203\t    spec.max_ack_gap_remote = 32;\n204\t    spec.min_ack_delay_remote = 1000;\n205\t    spec.target_interval = 1000;\n206\t\n207\t    return ackfrq_test_one(&spec);\n208\t}\n209\t"}]},"parent_tool_use_id":null,"session_id":"e8527e90-2f36-45ce-b310-d1a913164cfe","uuid":"14161b5c-aa74-4ae1-a09f-91f8c0c16e6e","timestamp":"2026-05-04T18:49:19.136Z","tool_use_result":{"type":"text","file":{"filePath":"/Users/richbarn/Projects/picoquic/picoquictest/ack_frequency_test.c","content":"/*\n* Author: Christian Huitema\n* Copyright (c) 2020, Private Octopus, Inc.\n* All rights reserved.\n*\n* Permission to use, copy, modify, and distribute this software for any\n* purpose with or without fee is hereby granted, provided that the above\n* copyright notice and this permission notice appear in all copies.\n*\n* THIS SOFTWARE IS PROVIDED BY THE COPYRIGHT HOLDERS AND CONTRIBUTORS \"AS IS\" AND\n* ANY EXPRESS OR IMPLIED WARRANTIES, INCLUDING, BUT NOT LIMITED TO, THE IMPLIED\n* WARRANTIES OF MERCHANTABILITY AND FITNESS FOR A PARTICULAR PURPOSE ARE\n* DISCLAIMED. IN NO EVENT SHALL Private Octopus, Inc. BE LIABLE FOR ANY\n* DIRECT, INDIRECT, INCIDENTAL, SPECIAL, EXEMPLARY, OR CONSEQUENTIAL DAMAGES\n* (INCLUDING, BUT NOT LIMITED TO, PROCUREMENT OF SUBSTITUTE GOODS OR SERVICES;\n* LOSS OF USE, DATA, OR PROFITS; OR BUSINESS INTERRUPTION) HOWEVER CAUSED AND\n* ON ANY THEORY OF LIABILITY, WHETHER IN CONTRACT, STRICT LIABILITY, OR TORT\n* (INCLUDING NEGLIGENCE OR OTHERWISE) ARISING IN ANY WAY OUT OF THE USE OF THIS\n* SOFTWARE, EVEN IF ADVISED OF THE POSSIBILITY OF SUCH DAMAGE.\n*/\n\n#include <stdlib.h>\n#include <string.h>\n#include \"picoquic.h\"\n#include \"picoquic_internal.h\"\n#include \"picoquictest_internal.h\"\n#include \"tls_api.h\"\n#include \"autoqlog.h\"\n#include \"logreader.h\"\n#include \"qlog.h\"\n\n#include \"picoquic_newreno.h\"\n#include \"picoquic_cubic.h\"\n#include \"picoquic_bbr.h\"\n#include \"picoquic_bbr1.h\"\n#include \"picoquic_fastcc.h\"\n\n/* Verify that the ack frequency is correctly set.\n */\n\ntypedef enum {\n    ackfrq_test_basic = 0\n} ackfrq_test_enum;\n\ntypedef struct st_ackfrq_test_spec_t {\n    ackfrq_test_enum test_id;\n    uint64_t latency;\n    uint64_t picosec_per_byte_down;\n    uint64_t picosec_per_byte_up;\n    picoquic_congestion_algorithm_t* ccalgo;\n    uint64_t target_time;\n    uint64_t max_ack_delay_remote;\n    uint64_t max_ack_gap_remote;\n    uint64_t min_ack_delay_remote;\n    uint64_t target_interval;\n} ackfrq_test_spec_t;\n\nstatic test_api_stream_desc_t test_scenario_ackfrq[] = {\n    { 4, 0, 257, 1000000 }\n};\n\nstatic int ackfrq_test_one(ackfrq_test_spec_t * spec)\n{\n    uint64_t simulated_time = 0;\n    picoquic_connection_id_t initial_cid = { {0xac, 0xf8, 0, 0, 0, 0, 0, 0}, 8 };\n    picoquic_test_tls_api_ctx_t* test_ctx = NULL;\n    uint64_t loss_mask = 0;\n    int ret = 0;\n\n    initial_cid.id[2] = spec->test_id;\n\n    ret = tls_api_one_scenario_init_ex(&test_ctx, &simulated_time, PICOQUIC_INTERNAL_TEST_VERSION_1, NULL, NULL, &initial_cid);\n\n    if (ret == 0 && test_ctx == NULL) {\n        ret = -1;\n    }\n\n    if (ret == 0) {\n        picoquic_set_default_congestion_algorithm(test_ctx->qserver, spec->ccalgo);\n        picoquic_set_congestion_algorithm(test_ctx->cnx_client, spec->ccalgo);\n\n        test_ctx->c_to_s_link->microsec_latency = spec->latency;\n        test_ctx->s_to_c_link->microsec_latency = spec->latency;\n\n        if (spec->picosec_per_byte_down > 0) {\n            test_ctx->s_to_c_link->picosec_per_byte = spec->picosec_per_byte_down;\n        }\n        if (spec->picosec_per_byte_up > 0) {\n            test_ctx->c_to_s_link->picosec_per_byte = spec->picosec_per_byte_up;\n        }\n\n        /* set the binary logs on both sides */\n        picoquic_set_qlog(test_ctx->qclient, \".\");\n        picoquic_set_qlog(test_ctx->qserver, \".\");\n        picoquic_set_log_level(test_ctx->qserver, 1);\n        picoquic_set_log_level(test_ctx->qclient, 1);\n        test_ctx->qclient->use_long_log = 1;\n        test_ctx->qserver->use_long_log = 1;\n        /* Initialize the client connection */\n        picoquic_start_client_cnx(test_ctx->cnx_client);\n    }\n\n    /* establish the connection */\n    if (ret == 0) {\n        ret = tls_api_connection_loop(test_ctx, &loss_mask, 0, &simulated_time);\n    }\n\n    /* wait until the client (and thus the server) is ready */\n    if (ret == 0) {\n        ret = wait_client_connection_ready(test_ctx, &simulated_time);\n    }\n\n    /* Prepare to send data */\n    if (ret == 0) {\n        ret = test_api_init_send_recv_scenario(test_ctx, test_scenario_ackfrq, sizeof(test_scenario_ackfrq));\n\n        if (ret != 0)\n        {\n            DBG_PRINTF(\"Init send receive scenario returns %d\\n\", ret);\n        }\n    }\n\n    if (ret == 0) {\n        ret = tls_api_data_sending_loop(test_ctx, &loss_mask, &simulated_time, 0);\n    }\n\n    /* Check that the transmission succeeded */\n    if (ret == 0) {\n        ret = tls_api_one_scenario_body_verify(test_ctx, &simulated_time, spec->target_time);\n    }\n\n\n    /* TODO: verify that the ack frequency option is negotiated */\n    if (ret == 0 && !test_ctx->cnx_client->is_ack_frequency_negotiated){\n        DBG_PRINTF(\"%s\", \"Ack Frequency not negotiated at client\");\n        ret = -1;\n    }\n\n    if (ret == 0 && !test_ctx->cnx_server->is_ack_frequency_negotiated) {\n        DBG_PRINTF(\"%s\", \"Ack Frequency not negotiated at server\");\n        ret = -1;\n    }\n    /* Verify that the ack gap and ack delay are what we expected */\n    if (ret == 0 && test_ctx->cnx_client->max_ack_delay_remote > spec->max_ack_delay_remote) {\n        DBG_PRINTF(\"Max Ack Delay %\" PRIu64 \" > \" PRIu64, test_ctx->cnx_client->max_ack_delay_remote, spec->max_ack_delay_remote);\n        ret = -1;\n    }\n    if (ret == 0 && test_ctx->cnx_client->min_ack_delay_remote > spec->min_ack_delay_remote) {\n        DBG_PRINTF(\"Min Ack Delay %\" PRIu64 \" < \" PRIu64, test_ctx->cnx_client->min_ack_delay_remote, spec->min_ack_delay_remote);\n        ret = -1;\n    }\n    if (ret == 0 && test_ctx->cnx_client->max_ack_gap_remote > spec->max_ack_gap_remote) {\n        DBG_PRINTF(\"Max Ack Gap %\" PRIu64 \" > \" PRIu64, test_ctx->cnx_client->max_ack_gap_remote, spec->max_ack_gap_remote);\n        ret = -1;\n    }\n\n    if (ret == 0) {\n        uint64_t duration = simulated_time - test_ctx->cnx_server->start_time;\n        uint64_t interval = duration / test_ctx->cnx_server->nb_packets_received;\n        uint64_t interval_min = interval - (interval >> 2);\n        uint64_t interval_max = interval + (interval >> 2);\n\n        if (spec->target_interval < interval_min || spec->target_interval > interval_max) {\n            DBG_PRINTF(\"Interval %\" PRIu64 \" <> \" PRIu64, interval, spec->target_interval);\n            ret = -1;\n        }\n    }\n\n    /* Verify that the average time between ACK is close to expectations */\n    /* Delete the context */\n    if (test_ctx != NULL) {\n        tls_api_delete_ctx(test_ctx);\n    }\n\n    return ret;\n}\n\nint ackfrq_basic_test(void)\n{\n    ackfrq_test_spec_t spec = { 0 };\n    spec.test_id = ackfrq_test_basic;\n    spec.latency = 10000;\n    spec.picosec_per_byte_up = 80000;\n    spec.picosec_per_byte_down = 80000;\n    spec.ccalgo = picoquic_cubic_algorithm;\n    spec.max_ack_delay_remote = 6000;\n    spec.max_ack_gap_remote = 40;\n    spec.min_ack_delay_remote = 1000;\n    spec.target_interval = 4000;\n\n    return ackfrq_test_one(&spec);\n}\n\nint ackfrq_short_test(void)\n{\n    ackfrq_test_spec_t spec = { 0 };\n    spec.test_id = ackfrq_test_basic;\n    spec.latency = 10;\n    spec.picosec_per_byte_up = 80000;\n    spec.picosec_per_byte_down = 80000;\n    spec.ccalgo = picoquic_cubic_algorithm;\n    spec.max_ack_delay_remote = 1000;\n    spec.max_ack_gap_remote = 32;\n    spec.min_ack_delay_remote = 1000;\n    spec.target_interval = 1000;\n\n    return ackfrq_test_one(&spec);\n}\n","numLines":209,"startLine":1,"totalLines":209}}}
