{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01H2QTKwFA2o8mBCFJdYCe7E","type":"tool_result","content":"1\t//! Tests for `picoquictest/ack_frequency_test.c`.\n2\t//!\n3\t//! Verifies that the ACK-frequency extension is negotiated correctly\n4\t//! and that the resulting ACK gap / delay / packet-interval values\n5\t//! fall within expected bounds after a simulated data transfer.\n6\t//!\n7\t//! Tests covered:\n8\t//! * [`ackfrq_basic`] — C `ackfrq_basic_test`: 10 ms RTT, cubic, moderate bandwidth.\n9\t//! * [`ackfrq_short`] — C `ackfrq_short_test`: 10 µs RTT, cubic, moderate bandwidth.\n10\t\n11\t#![allow(non_snake_case)]\n12\t\n13\tuse crate::internal::Version;\n14\tuse crate::{CongestionAlgorithm, Duration, Instant, get_congestion_algorithm};\n15\t\n16\tuse super::util::{\n17\t    TestApiStreamDesc, test_api_init_send_recv_scenario, tls_api_connection_loop,\n18\t    tls_api_data_sending_loop, tls_api_one_scenario_body_verify, tls_api_one_scenario_init_ex,\n19\t    wait_client_connection_ready,\n20\t};\n21\t\n22\t// ---------------------------------------------------------------------------\n23\t// Shared scenario: one stream, 257-byte query, 1 MB response.\n24\t// C: `test_scenario_ackfrq[]`.\n25\t\n26\tconst TEST_SCENARIO_ACKFRQ: &[TestApiStreamDesc] = &[TestApiStreamDesc {\n27\t    stream_id: 4,\n28\t    previous_stream_id: 0,\n29\t    q_len: 257,\n30\t    r_len: 1_000_000,\n31\t}];\n32\t\n33\t// ---------------------------------------------------------------------------\n34\t// Per-test parameter bundle.\n35\t\n36\tstruct AckfrqTestSpec {\n37\t    /// One-way link latency in microseconds.\n38\t    latency: u64,\n39\t    /// Link data rate (server→client) in picoseconds per byte.\n40\t    picosec_per_byte_down: u64,\n41\t    /// Link data rate (client→server) in picoseconds per byte.\n42\t    picosec_per_byte_up: u64,\n43\t    /// Congestion-control algorithm to install on both sides.\n44\t    ccalgo: &'static CongestionAlgorithm,\n45\t    /// Maximum simulation time allowed for the scenario (0 = no limit).\n46\t    target_time: u64,\n47\t    /// Maximum allowed `max_ack_delay_remote` on the client connection.\n48\t    max_ack_delay_remote: Duration,\n49\t    /// Maximum allowed `max_ack_gap_remote` on the client connection.\n50\t    max_ack_gap_remote: u64,\n51\t    /// Maximum allowed `min_ack_delay_remote` on the client connection.\n52\t    min_ack_delay_remote: Duration,\n53\t    /// Expected average inter-packet interval on the server (±25 %).\n54\t    target_interval: Duration,\n55\t}\n56\t\n57\t// ---------------------------------------------------------------------------\n58\t// Shared test body.  C: `ackfrq_test_one`.\n59\t\n60\tfn ackfrq_test_one(spec: &AckfrqTestSpec) {\n61\t    let mut simulated_time = Instant::from_ticks(0);\n62\t    let initial_cid = crate::ConnectionId::clone_from_slice(&[0xac, 0xf8, 0, 0, 0, 0, 0, 0])\n63\t        .expect(\"8-byte initial CID\");\n64\t    // id[2] encodes the test variant; ackfrq_test_basic == 0 so the\n65\t    // zero-initialised byte already carries the right value.\n66\t    let _ = initial_cid; // used below via tls_api_one_scenario_init_ex\n67\t\n68\t    let mut test_ctx = tls_api_one_scenario_init_ex(\n69\t        &mut simulated_time,\n70\t        Version::InternalTest1,\n71\t        None,\n72\t        None,\n73\t        Some(&initial_cid),\n74\t    )\n75\t    .expect(\"tls_api_one_scenario_init_ex\");\n76\t\n77\t    test_ctx\n78\t        .qserver\n79\t        .set_default_congestion_algorithm(spec.ccalgo);\n80\t    test_ctx.cnx_client().set_congestion_algorithm(spec.ccalgo);"}]},"parent_tool_use_id":null,"session_id":"e8527e90-2f36-45ce-b310-d1a913164cfe","uuid":"ac24dce6-2bde-4376-aa32-16a04977938f","timestamp":"2026-05-04T19:00:28.836Z","tool_use_result":{"type":"text","file":{"filePath":"/Users/richbarn/Projects/picoquic/rs/fq/src/tests/ack_frequency.rs","content":"//! Tests for `picoquictest/ack_frequency_test.c`.\n//!\n//! Verifies that the ACK-frequency extension is negotiated correctly\n//! and that the resulting ACK gap / delay / packet-interval values\n//! fall within expected bounds after a simulated data transfer.\n//!\n//! Tests covered:\n//! * [`ackfrq_basic`] — C `ackfrq_basic_test`: 10 ms RTT, cubic, moderate bandwidth.\n//! * [`ackfrq_short`] — C `ackfrq_short_test`: 10 µs RTT, cubic, moderate bandwidth.\n\n#![allow(non_snake_case)]\n\nuse crate::internal::Version;\nuse crate::{CongestionAlgorithm, Duration, Instant, get_congestion_algorithm};\n\nuse super::util::{\n    TestApiStreamDesc, test_api_init_send_recv_scenario, tls_api_connection_loop,\n    tls_api_data_sending_loop, tls_api_one_scenario_body_verify, tls_api_one_scenario_init_ex,\n    wait_client_connection_ready,\n};\n\n// ---------------------------------------------------------------------------\n// Shared scenario: one stream, 257-byte query, 1 MB response.\n// C: `test_scenario_ackfrq[]`.\n\nconst TEST_SCENARIO_ACKFRQ: &[TestApiStreamDesc] = &[TestApiStreamDesc {\n    stream_id: 4,\n    previous_stream_id: 0,\n    q_len: 257,\n    r_len: 1_000_000,\n}];\n\n// ---------------------------------------------------------------------------\n// Per-test parameter bundle.\n\nstruct AckfrqTestSpec {\n    /// One-way link latency in microseconds.\n    latency: u64,\n    /// Link data rate (server→client) in picoseconds per byte.\n    picosec_per_byte_down: u64,\n    /// Link data rate (client→server) in picoseconds per byte.\n    picosec_per_byte_up: u64,\n    /// Congestion-control algorithm to install on both sides.\n    ccalgo: &'static CongestionAlgorithm,\n    /// Maximum simulation time allowed for the scenario (0 = no limit).\n    target_time: u64,\n    /// Maximum allowed `max_ack_delay_remote` on the client connection.\n    max_ack_delay_remote: Duration,\n    /// Maximum allowed `max_ack_gap_remote` on the client connection.\n    max_ack_gap_remote: u64,\n    /// Maximum allowed `min_ack_delay_remote` on the client connection.\n    min_ack_delay_remote: Duration,\n    /// Expected average inter-packet interval on the server (±25 %).\n    target_interval: Duration,\n}\n\n// ---------------------------------------------------------------------------\n// Shared test body.  C: `ackfrq_test_one`.\n\nfn ackfrq_test_one(spec: &AckfrqTestSpec) {\n    let mut simulated_time = Instant::from_ticks(0);\n    let initial_cid = crate::ConnectionId::clone_from_slice(&[0xac, 0xf8, 0, 0, 0, 0, 0, 0])\n        .expect(\"8-byte initial CID\");\n    // id[2] encodes the test variant; ackfrq_test_basic == 0 so the\n    // zero-initialised byte already carries the right value.\n    let _ = initial_cid; // used below via tls_api_one_scenario_init_ex\n\n    let mut test_ctx = tls_api_one_scenario_init_ex(\n        &mut simulated_time,\n        Version::InternalTest1,\n        None,\n        None,\n        Some(&initial_cid),\n    )\n    .expect(\"tls_api_one_scenario_init_ex\");\n\n    test_ctx\n        .qserver\n        .set_default_congestion_algorithm(spec.ccalgo);\n    test_ctx.cnx_client().set_congestion_algorithm(spec.ccalgo);","numLines":80,"startLine":1,"totalLines":210}}}
