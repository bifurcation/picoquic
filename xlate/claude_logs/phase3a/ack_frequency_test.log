tion_client_departure,\n152\t    sim_action_server_departure,\n153\t    sim_action_client_arrival,\n154\t    sim_action_server_arrival,\n155\t    sim_action_client_arrival2,\n156\t    sim_action_server_arrival2,\n157\t    sim_action_client_admission,\n158\t    sim_action_server_admission,\n159\t    sim_action_client_admission2,\n160\t    sim_action_server_admission2,\n161\t    sim_action_client_dequeue,\n162\t    sim_action_server_dequeue\n163\t} tls_api_sim_action_enum;\n164\t\n165\ttypedef struct st_picoquic_test_endpoint_t {\n166\t    /* configuration parameters */\n167\t    uint64_t prepare_cpu_time;\n168\t    uint64_t incoming_cpu_time;\n169\t    size_t packet_queue_max;\n170\t    /* flag to mark use of AF_UNSPEC for receiving \"addr_to\" */\n171\t    int addr_to_unspec;\n172\t    /* next time endpoint ready */\n173\t    uint64_t next_time_ready;\n174\t    /* last time client sent something */\n175\t    uint64_t last_send_time;\n176\t    int ready_to_send;\n177\t    /* packet queue waiting to be processed. */\n178\t    size_t queue_size;\n179\t    picoquictest_sim_packet_t* first_packet;\n180\t    picoquictest_sim_packet_t* last_packet;\n181\t} picoquic_test_endpoint_t;\n182\t\n183\ttypedef struct st_test_api_callback_t {\n184\t    int client_mode;\n185\t    int fin_received;\n186\t    int error_detected;\n187\t    uint32_t nb_bytes_received;\n188\t} test_api_callback_t;\n189\t\n190\ttypedef struct st_picoquic_test_tls_api_ctx_t {\n191\t    picoquic_quic_t* qclient;\n192\t    picoquic_quic_t* qserver;\n193\t    picoquic_cnx_t* cnx_client;\n194\t    picoquic_cnx_t* cnx_server;\n195\t    int client_use_nat;\n196\t    int server_use_multiple_addresses;\n197\t    int client_use_multiple_addresses;\n198\t    int do_bad_coalesce_test;\n199\t    struct sockaddr_in client_addr;\n200\t    struct sockaddr_in client_addr_natted; /* When simulating NAT (client use NAT) */\n201\t    struct sockaddr_in client_addr_2; /* for use in multipath tests */\n202\t    struct sockaddr