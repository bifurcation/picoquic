{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01JuePmqo13qj3ssvMcLiqqy","type":"tool_result","content":"803\tint skip_frame_test(void)\n804\t{\n805\t    int ret = 0;\n806\t    uint8_t buffer[PICOQUIC_MAX_PACKET_SIZE];\n807\t    uint8_t fuzz_buffer[PICOQUIC_MAX_PACKET_SIZE];\n808\t    const uint8_t extra_bytes[4] = { 0xFF, 0, 0, 0 };\n809\t    uint64_t random_context = 0xBABED011;\n810\t    int fuzz_count = 0;\n811\t    int fuzz_fail = 0;\n812\t    picoquic_cnx_t cnx;\n813\t\n814\t    memset(&cnx, 0, sizeof(cnx)); /* Null value gets default test version */\n815\t\n816\t    for (size_t i = 0; ret == 0 && i < nb_test_skip_list; i++) {\n817\t        for (int sharp_end = 0; ret == 0 && sharp_end < 2; sharp_end++) {\n818\t            size_t consumed = 0;\n819\t            size_t byte_max = 0;\n820\t            int pure_ack;\n821\t            int t_ret = 0;\n822\t\n823\t            memcpy(buffer, test_skip_list[i].val, test_skip_list[i].len);\n824\t            byte_max = test_skip_list[i].len;\n825\t            if (test_skip_list[i].must_be_last == 0 && sharp_end == 0) {\n826\t                memcpy(buffer + byte_max, extra_bytes, sizeof(extra_bytes));\n827\t                byte_max += sizeof(extra_bytes);\n828\t            }\n829\t\n830\t            t_ret = picoquic_skip_frame(buffer, byte_max, &consumed, &pure_ack);\n831\t\n832\t            if (t_ret != 0) {\n833\t                DBG_PRINTF(\"Skip frame <%s> fails, ret = %d\\n\", test_skip_list[i].name, t_ret);\n834\t                ret = t_ret;\n835\t            }\n836\t            else if (consumed != test_skip_list[i].len) {\n837\t                DBG_PRINTF(\"Skip frame <%s> fails, wrong length, %d instead of %d\\n\",\n838\t                    test_skip_list[i].name, (int)consumed, (int)test_skip_list[i].len);\n839\t                ret = -1;\n840\t            }\n841\t            else if (pure_ack != test_skip_list[i].is_pure_ack) {\n842\t                DBG_PRINTF(\"Skip frame <%s> fails, wrong pure ack, %d instead of %d\\n\",\n843\t                    test_skip_list[i].name, (int)pure_ack, (int)test_skip_list[i].is_pure_ack);\n844\t                ret = -1;\n845\t            }\n846\t        }\n847\t    }\n848\t\n849\t    /* Check a series of known bad packets. We are checking that an error is\n850\t     * detected and no adverse code issue happens. */\n851\t    for (size_t i = 0; ret == 0 && i < nb_test_frame_error_list; i++) {\n852\t        for (int sharp_end = 0; ret == 0 && sharp_end < 2; sharp_end++) {\n853\t            size_t consumed = 0;\n854\t            size_t byte_max = 0;\n855\t            int pure_ack;\n856\t            int t_ret = 0;\n857\t            memcpy(buffer, test_frame_error_list[i].val, test_frame_error_list[i].len);\n858\t            byte_max = test_frame_error_list[i].len;\n859\t            if (test_frame_error_list[i].must_be_last == 0 && sharp_end == 0) {\n860\t                memcpy(buffer + byte_max, extra_bytes, sizeof(extra_bytes));\n861\t                byte_max += sizeof(extra_bytes);\n862\t            }\n863\t\n864\t            t_ret = picoquic_skip_frame(buffer, byte_max, &consumed, &pure_ack);\n865\t\n866\t            if (t_ret == 0 && test_frame_error_list[i].skip_fails) {\n867\t                DBG_PRINTF(\"Skip error frame <%s> does not fails, ret = %d\\n\", test_frame_error_list[i].name, t_ret);\n868\t                ret = -1;\n869\t            }\n870\t        }\n871\t    }\n872\t    /* Derive and test a series of packets with bad varint encodings */\n873\t    if (ret == 0) {\n874\t        ret = skip_frame_varint_test(buffer, PICOQUIC_MAX_PACKET_SIZE);\n875\t    }\n876\t\n877\t    /* Do a minimal fuzz test */\n878\t    for (size_t i = 0; ret == 0 && i < 100; i++) {\n879\t        size_t bytes_max = format_random_packet(buffer, sizeof(buffer), &random_context, -1);\n880\t\n881\t        ret = skip_test_packet(buffer, bytes_max);\n882\t        if (ret != 0) {\n883\t            DBG_PRINTF(\"Skip packet <%d> fails, ret = %d\\n\", i, ret);\n884\t        } else {\n885\t            /* do the actual fuzz test */\n886\t            int suspended = debug_printf_reset(1);\n887\t            for (size_t j = 0; j < 100; j++) {\n888\t                skip_test_fuzz_packet(fuzz_buffer, buffer, bytes_max, &random_context);\n889\t                if (skip_test_packet(fuzz_buffer, bytes_max) != 0) {\n890\t                    fuzz_fail++;\n891\t                }\n892\t                fuzz_count++;\n893\t            }\n894\t            (void)debug_printf_reset(suspended);\n895\t        }\n896\t    }\n897\t\n898\t    if (ret == 0) {\n899\t        DBG_PRINTF(\"Fuzz skip test passes after %d trials, %d error detected\\n\",\n900\t            fuzz_count, fuzz_fail);\n901\t    }\n902\t\n903\t    return ret;\n904\t}\n905\t\n906\tvoid parse_test_packet_cnx_fix(picoquic_cnx_t* cnx, uint64_t simulated_time, int epoch, int mpath)\n907\t{\n908\t    /* Stupid fix to ensure that the NCID decoding test will not protest */\n909\t    cnx->path[0]->first_tuple->p_remote_cnxid->cnx_id.id_len = 8;\n910\t\n911\t    cnx->pkt_ctx[0].send_sequence = 0x0102030406;\n912\t    cnx->path[0]->pkt_ctx.send_sequence = 0x0102030406;\n913\t\n914\t    /* create a local cid  which can be retired with a connection_id_retire frame */\n915\t    (void)picoquic_create_local_cnxid(cnx, 0, NULL, simulated_time);\n916\t\n917\t    /* enable time stamp so it can be used in test */\n918\t    cnx->is_time_stamp_enabled = 1;\n919\t\n920\t    /* Set datagram max size to pass verification */\n921\t    cnx->local_parameters.max_datagram_frame_size = PICOQUIC_MAX_PACKET_SIZE;\n922\t\n923\t    /* Set min ack delay so there is no issue with ack frequency frame */\n924\t    cnx->is_ack_frequency_negotiated = 1;\n925\t    cnx->remote_parameters.min_ack_delay = 1000;\n926\t\n927\t    /* Set enable_bdp so there is no issue with bdp frame */\n928\t    cnx->local_parameters.enable_bdp_frame = 3;\n929\t\n930\t    /* Enable multipath so the test of multipath frames works. */\n931\t    if (mpath != 0) {\n932\t        cnx->is_multipath_enabled = 1;\n933\t        cnx->max_path_id_local = 5;\n934\t        if (mpath >= 2) {\n935\t            /* Enable the P2P extensions. */\n936\t            cnx->is_address_discovery_provider = 1;\n937\t            cnx->is_address_discovery_receiver = 1;\n938\t        }\n939\t    }\n940\t\n941\t    /* enable stream reset at so the test works */\n942\t    cnx->is_reset_stream_at_enabled = 1;\n943\t\n944\t    /* if testing handshake done, set state to ready so frame is ignored. */\n945\t    if (epoch == 3) {\n946\t        cnx->cnx_state = picoquic_state_ready;\n947\t    }\n948\t}\n949\t\n950\tint parse_test_packet(picoquic_quic_t* qclient, struct sockaddr* saddr, uint64_t simulated_time,\n951\t    uint8_t * buffer, size_t byte_max, int epoch, int* ack_needed, uint64_t * err, int mpath)\n952\t{\n953\t    int ret = 0;\n954\t    picoquic_packet_context_enum pc = picoquic_context_from_epoch(epoch);\n955\t    picoquic_cnx_t* cnx = picoquic_create_cnx(qclient,\n956\t        picoquic_null_connection_id, picoquic_null_connection_id, saddr,\n957\t        simulated_time, 0, \"test-sni\", \"test-alpn\", 1);\n958\t\n959\t\n960\t    *ack_needed = 0;\n961\t\n962\t    if (cnx == NULL) {\n963\t        DBG_PRINTF(\"%s\", \"Cannot create QUIC CNX context\\n\");\n964\t        ret = -1;\n965\t    }\n966\t    else {\n967\t        parse_test_packet_cnx_fix(cnx, simulated_time, epoch, mpath);\n968\t\n969\t        ret = picoquic_decode_frames(cnx, cnx->path[0], buffer, byte_max, NULL, epoch, \n970\t            NULL, NULL, 0, 0, simulated_time);\n971\t\n972\t        *ack_needed = cnx->ack_ctx[pc].act[0].ack_needed;\n973\t\n974\t        *err = cnx->local_error;\n975\t\n976\t        if (ret == 0 &&\n977\t            (cnx->cnx_state == picoquic_state_disconnecting ||\n978\t                cnx->cnx_state == picoquic_state_handshake_failure)) {\n979\t            ret = -1;\n980\t        }\n981\t\n982\t        picoquic_delete_cnx(cnx);\n983\t    }\n984\t\n985\t    return ret;\n986\t}\n987\t\n988\tint parse_frame_varint_test(picoquic_quic_t* qclient, struct sockaddr* saddr, uint64_t simulated_time,\n989\t    uint8_t* buffer, size_t buffer_size)\n990\t{\n991\t    int ret = 0;\n992\t\n993\t    for (size_t i = 0; ret == 0 && i < nb_test_skip_list; i++) {\n994\t        for (int v = 1; v <= test_skip_list[i].nb_varints; v++) {\n995\t            int ack_needed = 0;\n996\t            uint64_t err = 0;\n997\t            size_t len = create_test_varint_frame(buffer, buffer_size, i, v);\n998\t            if (len > 0 &&\n999\t                parse_test_packet(qclient, saddr, simulated_time, buffer, len,\n1000\t                    test_skip_list[i].epoch, &ack_needed, &err, test_skip_list[i].mpath) == 0) {\n1001\t                ret = -1;\n1002\t            }\n1003\t        }\n1004\t    }\n1005\t    return ret;\n1006\t}\n1007\t\n1008\tint parse_frame_not_mpath_test(picoquic_quic_t* qclient, struct sockaddr* saddr, uint64_t simulated_time,\n1009\t    uint8_t* buffer, size_t buffer_size)\n1010\t{\n1011\t    int ret = 0;\n1012\t\n1013\t    for (size_t i = 0; ret == 0 && i < nb_test_skip_list; i++) {\n1014\t        if (test_skip_list[i].mpath){\n1015\t            int ack_needed = 0;\n1016\t            uint64_t err = 0;\n1017\t            size_t len = test_skip_list[i].len;\n1018\t            if (len > buffer_size) {\n1019\t                DBG_PRINTF(\"Test frame <%s> is too long for buffer, len = %d\\n\", test_skip_list[i].name, (int)len);\n1020\t                ret = -1;\n1021\t                continue;\n1022\t            }\n1023\t            memcpy(buffer, test_skip_list[i].val, len);\n1024\t\n1025\t            if (parse_test_packet(qclient, saddr, simulated_time, buffer, len,\n1026\t                test_skip_list[i].epoch, &ack_needed, &err, 0) == 0) {\n1027\t                ret = -1;\n1028\t            }\n1029\t        }\n1030\t    }\n1031\t    return ret;\n1032\t}\n1033\t\n1034\tint parse_frame_0rtt_test(picoquic_quic_t* qclient, struct sockaddr* saddr, uint64_t simulated_time,\n1035\t    uint8_t* buffer, size_t buffer_size)\n1036\t{\n1037\t    int ret = 0;\n1038\t\n1039\t    for (size_t i = 0; ret == 0 && i < nb_test_skip_list; i++) {\n1040\t        uint64_t frame_type = 0;\n1041\t        if (picoquic_frames_varint_decode(test_skip_list[i].val, test_skip_list[i].val + test_skip_list[i].len, &frame_type) != NULL) {\n1042\t            int ack_needed = 0;\n1043\t            uint64_t err = 0;\n1044\t            size_t len = test_skip_list[i].len;\n1045\t            int l_ret = 0;\n1046\t            if (len > buffer_size) {\n1047\t                DBG_PRINTF(\"Test frame <%s> is too long for buffer, len = %d\\n\", test_skip_list[i].name, (int)len);\n1048\t                ret = -1;\n1049\t                continue;\n1050\t            }\n1051\t            memcpy(buffer, test_skip_list[i].val, len);\n1052\t            l_ret = parse_test_packet(qclient, saddr, simulated_time, buffer, len,\n1053\t                picoquic_epoch_0rtt, &ack_needed, &err, test_skip_list[i].mpath);\n1054\t            if (frame_type >= picoquic_frame_type_stream_range_min && frame_type <= picoquic_frame_type_stream_range_max) {\n1055\t                if (l_ret != 0) {\n1056\t                    ret = -1;\n1057\t                }\n1058\t            } else {\n1059\t                switch (frame_type) {\n1060\t                case picoquic_frame_type_padding:\n1061\t                case picoquic_frame_type_ping:\n1062\t                case picoquic_frame_type_reset_stream:\n1063\t                case picoquic_frame_type_stop_sending:\n1064\t                case picoquic_frame_type_connection_close:\n1065\t                case picoquic_frame_type_application_close:\n1066\t                case picoquic_frame_type_max_data:\n1067\t                case picoquic_frame_type_max_stream_data:\n1068\t                case picoquic_frame_type_max_streams_bidir:\n1069\t                case picoquic_frame_type