{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01HZJbm1mE2FqvhdEGHLa2ay","type":"tool_result","content":"336\t/// Loop-construction parameters (v2 / v3 entry points).\n337\t/// C: `packet_loop_param_t`.  `repr(C)` is dropped — the\n338\t/// struct never crosses an external boundary.\n339\t#[derive(Debug, Default, Copy, Clone)]\n340\tpub struct LoopParam {\n341\t    /// Default port for outgoing connections.  `0` ⇒ ephemeral.\n342\t    pub local_port: u16,\n343\t    /// `AF_INET` / `AF_INET6`, or `0` for \"both\".\n344\t    pub local_af: i32,\n345\t    /// Outbound interface index (or `0` to leave it to the kernel).\n346\t    pub dest_if: i32,\n347\t    /// Server / public-facing port.  `0` for client-only loops.\n348\t    pub public_port: u16,\n349\t    /// Whether the public port is shared across this thread pool\n350\t    /// (uses `SO_REUSEPORT`).\n351\t    pub is_port_shared: bool,\n352\t    /// `SO_SNDBUF` / `SO_RCVBUF` size, or `0` to skip the syscall.\n353\t    pub socket_buffer_size: i32,\n354\t    /// Disable `UDP_SEGMENT` GSO even if the kernel advertises it.\n355\t    pub do_not_use_gso: bool,\n356\t    /// Open the public-port socket pair too (needed for migration).\n357\t    pub extra_socket_required: bool,\n358\t    /// When both port pairs exist, prefer the extra socket as the\n359\t    /// outgoing source.\n360\t    pub prefer_extra_socket: bool,\n361\t    /// Inject a synthetic `EIO` once into the send path (debug\n362\t    /// hook).\n363\t    pub simulate_eio: bool,\n364\t    /// Cap on the size of an individual coalesced send.  `0` ⇒\n365\t    /// kernel default.\n366\t    pub send_length_max: usize,\n367\t}\n368\t\n369\t// ---------------------------------------------------------------------------\n370\t// Custom thread-management hooks.\n371\t\n372\t/// Spawn-a-thread hook.  C:\n373\t/// `int (*custom_thread_create_fn)(void** thread_id,\n374\t/// thread_fn thread_fn, void* arg)`.\n375\t///\n376\t/// In C, `(thread_fn, arg)` is the trampoline + state pair the new\n377\t/// thread will run.  In Rust, [`std::thread::spawn`] already takes\n378\t/// an arbitrary `FnOnce() + Send` closure (which subsumes the C\n379\t/// \"function pointer + void* arg\" pattern), so the hook reduces to\n380\t/// \"produce a [`JoinHandle`] from that closure\".\n381\tpub trait CustomThreadCreateFn {\n382\t    /// Create a thread that runs `thread_fn` to completion.  The\n383\t    /// returned [`JoinHandle`] is owned by the caller and passed\n384\t    /// back through [`CustomThreadDeleteFn::delete`] at teardown.\n385\t    ///\n386\t    /// The C contract returns `0` for success / non-zero `errno`\n387\t    /// otherwise; the [`OsError`] payload carries the same value\n388\t    /// that the C `*ret` out-parameter would on\n389\t    /// [`NetworkThreadCtx::spawn_custom`].\n390\t    fn create(\n391\t        &mut self,\n392\t        thread_fn: Box<dyn FnOnce() + Send + 'static>,\n393\t    ) -> Result<JoinHandle<()>, OsError>;\n394\t}\n395\t\n396\t/// Set-thread-name hook.  C:\n397\t/// `void (*custom_thread_setname_fn)(char const* thread_name)`.\n398\t///\n399\t/// Length is capped at 16 bytes (including the trailing NUL) on\n400\t/// Linux's `prctl(PR_SET_NAME, …)`; the trait takes a `&str` slice\n401\t/// and lets the implementor truncate / re-encode as needed.\n402\tpub trait CustomThreadSetnameFn {\n403\t    /// Apply `thread_name` to the *current* thread.  Called from\n404\t    /// inside the thread after it starts, per the C convention.\n405\t    fn set_name(&mut self, thread_name: &str);\n406\t}\n407\t\n408\t/// Tear-down-a-thread hook.  C:\n409\t/// `void (*custom_thread_delete_fn)(void** thread_id)`.\n410\t///\n411\t/// In Rust the standard `JoinHandle` cleans itself up on drop, so\n412\t/// this hook only matters for backends that allocate their own\n413\t/// out-of-band thread bookkeeping; the default\n414\t/// [`internal_thread_delete`] just lets the handle go.\n415\tpub trait CustomThreadDeleteFn