{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_013ytLiPoBgqB63mi6cpL6Qy","type":"tool_result","content":"220\t    }\n221\t}\n222\t\n223\t// ---------------------------------------------------------------------------\n224\t// Callback enum + companion arg structs.\n225\t\n226\t/// Loop-callback event delivered to [`PacketLoopCbFn::callback`].\n227\t/// Replaces the C `(packet_loop_cb_enum cb_mode, void* callback_argv)`\n228\t/// pair: the enum carries the per-event payload directly, so\n229\t/// implementors no longer cast a `void*`.\n230\t/// C: `packet_loop_cb_enum`.\n231\t#[derive(Debug)]\n232\tpub enum LoopEvent<'a> {\n233\t    /// Loop has finished initializing.  C: `packet_loop_ready`,\n234\t    /// `callback_argv: *mut LoopOptions`.\n235\t    Ready(&'a mut LoopOptions),\n236\t    /// Number of packets received this iteration.  C:\n237\t    /// `packet_loop_after_receive`, `callback_argv: *mut size_t`.\n238\t    AfterReceive(usize),\n239\t    /// Number of packets sent this iteration.  C:\n240\t    /// `packet_loop_after_send`, `callback_argv: *mut size_t`.\n241\t    AfterSend(usize),\n242\t    /// New local address advertised by the application after a\n243\t    /// port update.  C: `packet_loop_port_update`,\n244\t    /// `callback_argv: *mut sockaddr`.\n245\t    PortUpdate(core::net::SocketAddr),\n246\t    /// Optional check-in fired when the application set\n247\t    /// [`LoopOptions::do_time_check`].  C:\n248\t    /// `packet_loop_time_check`.\n249\t    TimeCheck(&'a mut TimeCheckArg),\n250\t    /// Optional system-call duration report fired when the\n251\t    /// application set [`LoopOptions::do_system_call_duration`].\n252\t    /// C: `packet_loop_system_call_duration`.\n253\t    SystemCallDuration(&'a mut SystemCallDuration),\n254\t    /// Wake-up event triggered by [`NetworkThreadCtx::wake_up`].\n255\t    /// C: `packet_loop_wake_up` with `callback_argv: NULL`.\n256\t    WakeUp,\n257\t    /// Alt-port address surfaced for multipath / migration tests.\n258\t    /// C: `packet_loop_alt_port`.\n259\t    AltPort(core::net::SocketAddr),\n260\t}\n261\t\n262\t/// System-call duration statistics surfaced through the optional\n263\t/// [`LoopEvent::SystemCallDuration`] callback.\n264\t/// C: `packet_loop_system_call_duration_t`.\n265\t#[derive(Debug, Default, Copy, Clone)]\n266\tpub struct SystemCallDuration {\n267\t    /// Duration of the most recent zero-delay system call\n268\t    /// (microseconds).\n269\t    pub scd_last: u64,\n270\t    /// Maximum observed system-call duration so far.\n271\t    pub scd_max: u64,\n272\t    /// Smoothed system-call duration (RFC-6298–style EWMA).\n273\t    pub scd_smoothed: u64,\n274\t    /// Mean absolute deviation around `scd_smoothed`.\n275\t    pub scd_dev: u64,\n276\t}\n277\t\n278\t/// In/out argument for the [`LoopEvent::TimeCheck`] callback.\n279\t/// The loop fills `current_time` and a proposed `delta_t`;\n280\t/// the application overwrites `delta_t` with a (possibly smaller)\n281\t/// value if it has work to do sooner.\n282\t/// C: `packet_loop_time_check_arg_t`.\n283\t#[derive(Debug, Copy, Clone)]\n284\tpub struct TimeCheckArg {\n285\t    /// Loop-time timestamp.\n286\t    pub current_time: Instant,\n287\t    /// Proposed sleep, in microseconds — application may shrink.\n288\t    pub delta_t: i64,\n289\t}\n290\t\n291\timpl Default for TimeCheckArg {\n292\t    fn default() -> Self {\n293\t        Self {\n294\t            current_time: Instant::from_ticks(0),\n295\t            delta_t: 0,\n296\t        }\n297\t    }\n298\t}\n299\t\n300\t/// Application callback fired at the lifecycle and per-iteration\n301\t/// events listed in [`LoopEvent`].\n302\t///\n303\t/// C: `int (*packet_loop_cb_fn)(picoquic_quic_t* quic,\n304\t/// packet_loop_cb_enum cb_mode, void* callback_ctx, void*\n305\t/// callback_argv)`.  The `callback_ctx` companion folds into the\n306\t/// trait implementor's state; the `(cb_mode, callback_argv)` tagged\n307\t/// union folds into [`LoopEvent`].\n308\t///\n309\t/// Returns `Ok(())` on success, or an error to break the loop.\n310\tpub trait PacketLoopCbFn {\n311\t    fn callback(&mut self, quic: &mut Quic, event: LoopEvent<'_>) -> Result<(), Error>;\n312\t}\n313\t\n314\t// ---------------------------------------------------------------------------\n315\t// Loop options + parameters.\n316\t\n317\t/// Feature-flags the application advertises in response to the\n318\t/// [`LoopEvent::Ready`]\n319\t/// callback.  C: `packet_loop_options_t`, three single-bit\n320\t/// `unsigned int : 1` fields collapsed to `bool` per the\n321\t/// established convention (see `config.rs`).\n322\t#[derive(Debug, Default, Copy, Clone)]\n323\tpub struct LoopOptions {\n324\t    /// Application wants the loop to call back with\n325\t    /// [`LoopEvent::TimeCheck`]\n326\t    /// before each select.\n327\t    pub do_time_check: bool,\n328\t    /// Application wants notifications when zero-delay system calls\n329\t    /// take noticeably long.\n330\t    pub do_system_call_duration: bool,\n331\t    /// Application provides an alternate port for migration /\n332\t    /// multipath testing.\n333\t    pub provide_alt_port: bool,\n334\t}\n335\t\n336\t/// Loop-construction parameters (v2 / v3 entry points).\n337\t/// C: `packet_loop_param_t`.  `repr(C)` is dropped — the\n338\t/// struct never crosses an external boundary.\n339\t#[derive(Debug, Default, Copy, Clone)]"}]},"parent_tool_use_id":null,"session_id":"cb85c5eb-b826-43b9-84a4-4be9b46756f2","uuid":"cabea1a5-227f-4f71-8b27-8096cfe1a17c","timestamp":"2026-05-05T11:55:11.386Z","tool_use_result":{"type":"text","file":{"filePath":"/Users/richbarn/Projects/picoquic/rs/fq/src/packet_loop.rs","content":"    }\n}\n\n// ---------------------------------------------------------------------------\n// Callback enum + companion arg structs.\n\n/// Loop-callback event delivered to [`PacketLoopCbFn::callback`].\n/// Replaces the C `(packet_loop_cb_enum cb_mode, void* callback_argv)`\n/// pair: the enum carries the per-event payload directly, so\n/// implementors no longer cast a `void*`.\n/// C: `packet_loop_cb_enum`.\n#[derive(Debug)]\npub enum LoopEvent<'a> {\n    /// Loop has finished initializing.  C: `packet_loop_ready`,\n    /// `callback_argv: *mut LoopOptions`.\n    Ready(&'a mut LoopOptions),\n    /// Number of packets received this iteration.  C:\n    /// `packet_loop_after_receive`, `callback_argv: *mut size_t`.\n    AfterReceive(usize),\n    /// Number of packets sent this iteration.  C:\n    /// `packet_loop_after_send`, `callback_argv: *mut size_t`.\n    AfterSend(usize),\n    /// New local address advertised by the application after a\n    /// port update.  C: `packet_loop_port_update`,\n    /// `callback_argv: *mut sockaddr`.\n    PortUpdate(core::net::SocketAddr),\n    /// Optional check-in fired when the application set\n    /// [`LoopOptions::do_time_check`].  C:\n    /// `packet_loop_time_check`.\n    TimeCheck(&'a mut TimeCheckArg),\n    /// Optional system-call duration report fired when the\n    /// application set [`LoopOptions::do_system_call_duration`].\n    /// C: `packet_loop_system_call_duration`.\n    SystemCallDuration(&'a mut SystemCallDuration),\n    /// Wake-up event triggered by [`NetworkThreadCtx::wake_up`].\n    /// C: `packet_loop_wake_up` with `callback_argv: NULL`.\n    WakeUp,\n    /// Alt-port address surfaced for multipath / migration tests.\n    /// C: `packet_loop_alt_port`.\n    AltPort(core::net::SocketAddr),\n}\n\n/// System-call duration statistics surfaced through the optional\n/// [`LoopEvent::SystemCallDuration`] callback.\n/// C: `packet_loop_system_call_duration_t`.\n#[derive(Debug, Default, Copy, Clone)]\npub struct SystemCallDuration {\n    /// Duration of the most recent zero-delay system call\n    /// (microseconds).\n    pub scd_last: u64,\n    /// Maximum observed system-call duration so far.\n    pub scd_max: u64,\n    /// Smoothed system-call duration (RFC-6298–style EWMA).\n    pub scd_smoothed: u64,\n    /// Mean absolute deviation around `scd_smoothed`.\n    pub scd_dev: u64,\n}\n\n/// In/out argument for the [`LoopEvent::TimeCheck`] callback.\n/// The loop fills `current_time` and a proposed `delta_t`;\n/// the application overwrites `delta_t` with a (possibly smaller)\n/// value if it has work to do sooner.\n/// C: `packet_loop_time_check_arg_t`.\n#[derive(Debug, Copy, Clone)]\npub struct TimeCheckArg {\n    /// Loop-time timestamp.\n    pub current_time: Instant,\n    /// Proposed sleep, in microseconds — application may shrink.\n    pub delta_t: i64,\n}\n\nimpl Default for TimeCheckArg {\n    fn default() -> Self {\n        Self {\n            current_time: Instant::from_ticks(0),\n            delta_t: 0,\n        }\n    }\n}\n\n/// Application callback fired at the lifecycle and per-iteration\n/// events listed in [`LoopEvent`].\n///\n/// C: `int (*packet_loop_cb_fn)(picoquic_quic_t* quic,\n/// packet_loop_cb_enum cb_mode, void* callback_ctx, void*\n/// callback_argv)`.  The `callback_ctx` companion folds into the\n/// trait implementor's state; the `(cb_mode, callback_argv)` tagged\n/// union folds into [`LoopEvent`].\n///\n/// Returns `Ok(())` on success, or an error to break the loop.\npub trait PacketLoopCbFn {\n    fn callback(&mut self, quic: &mut Quic, event: LoopEvent<'_>) -> Result<(), Error>;\n}\n\n// ---------------------------------------------------------------------------\n// Loop options + parameters.\n\n/// Feature-flags the application advertises in response to the\n/// [`LoopEvent::Ready`]\n/// callback.  C: `packet_loop_options_t`, three single-bit\n/// `unsigned int : 1` fields collapsed to `bool` per the\n/// established convention (see `config.rs`).\n#[derive(Debug, Default, Copy, Clone)]\npub struct LoopOptions {\n    /// Application wants the loop to call back with\n    /// [`LoopEvent::TimeCheck`]\n    /// before each select.\n    pub do_time_check: bool,\n    /// Application wants notifications when zero-delay system calls\n    /// take noticeably long.\n    pub do_system_call_duration: bool,\n    /// Application provides an alternate port for migration /\n    /// multipath testing.\n    pub provide_alt_port: bool,\n}\n\n/// Loop-construction parameters (v2 / v3 entry points).\n/// C: `packet_loop_param_t`.  `repr(C)` is dropped — the\n/// struct never crosses an external boundary.\n#[derive(Debug, Default, Copy, Clone)]","numLines":120,"startLine":220,"totalLines":747}}}
