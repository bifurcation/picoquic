{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01FwP623LwqW7zEqqcK3VuFD","type":"tool_result","content":"1\t/*\n2\t* Author: Christian Huitema\n3\t* Copyright (c) 2023, Private Octopus, Inc.\n4\t* All rights reserved.\n5\t*\n6\t* Permission to use, copy, modify, and distribute this software for any\n7\t* purpose with or without fee is hereby granted, provided that the above\n8\t* copyright notice and this permission notice appear in all copies.\n9\t*\n10\t* THIS SOFTWARE IS PROVIDED BY THE COPYRIGHT HOLDERS AND CONTRIBUTORS \"AS IS\" AND\n11\t* ANY EXPRESS OR IMPLIED WARRANTIES, INCLUDING, BUT NOT LIMITED TO, THE IMPLIED\n12\t* WARRANTIES OF MERCHANTABILITY AND FITNESS FOR A PARTICULAR PURPOSE ARE\n13\t* DISCLAIMED. IN NO EVENT SHALL Private Octopus, Inc. BE LIABLE FOR ANY\n14\t* DIRECT, INDIRECT, INCIDENTAL, SPECIAL, EXEMPLARY, OR CONSEQUENTIAL DAMAGES\n15\t* (INCLUDING, BUT NOT LIMITED TO, PROCUREMENT OF SUBSTITUTE GOODS OR SERVICES;\n16\t* LOSS OF USE, DATA, OR PROFITS; OR BUSINESS INTERRUPTION) HOWEVER CAUSED AND\n17\t* ON ANY THEORY OF LIABILITY, WHETHER IN CONTRACT, STRICT LIABILITY, OR TORT\n18\t* (INCLUDING NEGLIGENCE OR OTHERWISE) ARISING IN ANY WAY OUT OF THE USE OF THIS\n19\t* SOFTWARE, EVEN IF ADVISED OF THE POSSIBILITY OF SUCH DAMAGE.\n20\t*/\n21\t\n22\t#include <stdlib.h>\n23\t#include <string.h>\n24\t#include <stdint.h>\n25\t#include <math.h>\n26\t#include \"picoquic.h\"\n27\t#include \"picoquic_utils.h\"\n28\t#include \"picoquictest_internal.h\"\n29\t#include \"autoqlog.h\"\n30\t#include \"picoquic_packet_loop.h\"\n31\t#include \"picosocks.h\"\n32\t\n33\t\n34\t#ifndef SLEEP\n35\t#ifdef _WINDOWS\n36\t#define SLEEP(x) Sleep(x)\n37\t#else\n38\t#define SLEEP(x) usleep((x)*1000)\n39\t#endif\n40\t#endif\n41\t\n42\t/* \n43\t* Testing the socket loop.\n44\t* This requires sending packets through sockets, etc. We do that by using a \n45\t* single QUIC context as both server and client, using a local socket to\n46\t* loop packets between the client and server connections.\n47\t */\n48\t\n49\ttypedef struct st_sockloop_test_spec_t {\n50\t    uint8_t test_id;\n51\t    int af;\n52\t    uint16_t port;\n53\t    int socket_buffer_size;\n54\t    test_api_stream_desc_t* scenario;\n55\t    size_t scenario_size;\n56\t    char const* thread_name;\n57\t    int use_background_thread;\n58\t    int ipv6_only;\n59\t    int do_not_use_gso;\n60\t    int simulate_eio;\n61\t    int double_bind;\n62\t    int extra_socket_required;\n63\t    int prefer_extra_socket;\n64\t    int force_migration;\n65\t} sockloop_test_spec_t;\n66\t\n67\ttypedef struct st_sockloop_test_cb_t {\n68\t    picoquic_test_tls_api_ctx_t* test_ctx;\n69\t    uint8_t test_id;\n70\t    int notified_ready;\n71\t    int established;\n72\t    int force_migration;\n73\t    int migration_started;\n74\t    int address_updated;\n75\t    int zero_rtt_available;\n76\t    int socket_buffer_size;\n77\t    struct sockaddr_storage server_address;\n78\t    struct sockaddr_storage client_address;\n79\t    struct sockaddr_storage client_alt_address[PICOQUIC_NB_PATH_TARGET];\n80\t    int client_alt_if[PICOQUIC_NB_PATH_TARGET];\n81\t    int nb_alt_paths;\n82\t    uint16_t alt_port;\n83\t    picoquic_connection_id_t server_cid_before_migration;\n84\t    picoquic_connection_id_t client_cid_before_migration;\n85\t    picoquic_packet_loop_param_t* param;\n86\t} sockloop_test_cb_t;\n87\t\n88\tint sockloop_test_received_finished(picoquic_test_tls_api_ctx_t* test_ctx)\n89\t{\n90\t    int ret = 0;\n91\t\n92\t    if (test_ctx->nb_test_streams > 0) {\n93\t        if (test_ctx->server_callback.error_detected) {\n94\t            ret = -1;\n95\t        }\n96\t        else if (test_ctx->client_callback.error_detected) {\n97\t            ret = -1;\n98\t        }\n99\t        else {\n100\t            ret = 1;\n101\t            for (size_t i = 0; ret == 1 && i < test_ctx->nb_test_streams; i++) {\n102\t                if (test_ctx->test_stream[i].q_recv_nb != test_ctx->test_stream[i].q_len ||\n103\t                    test_ctx->test_stream[i].r_recv_nb != test_ctx->test_stream[i].r_len) {\n104\t                    ret = 0;\n105\t                }\n106\t            }\n107\t\n108\t            if (test_ctx->stream0_sent != test_ctx->stream0_target ||\n109\t                test_ctx->stream0_sent != test_ctx->stream0_received) {\n110\t                ret = 0;\n111\t            }\n112\t        }\n113\t    }\n114\t    return ret;\n115\t}\n116\t\n117\tint sockloop_test_verify_extra_socket(picoquic_cnx_t* cnx_client, struct sockaddr* server_address)\n118\t{\n119\t    int ret = 0;\n120\t    if (picoquic_compare_addr((struct sockaddr*)&cnx_client->path[0]->first_tuple->peer_addr, server_address) != 0 ||\n121\t        picoquic_compare_addr((struct sockaddr*)&cnx_client->path[0]->first_tuple->local_addr, server_address) == 0) {\n122\t        ret = -1;\n123\t    }\n124\t\n125\t    return ret;\n126\t}\n127\t\n128\tint sockloop_test_cb(picoquic_quic_t* UNUSED(quic), picoquic_packet_loop_cb_enum cb_mode,\n129\t    void* callback_ctx, void * callback_arg)\n130\t{\n131\t    int ret = 0;\n132\t    sockloop_test_cb_t* cb_ctx = (sockloop_test_cb_t*)callback_ctx;\n133\t\n134\t    if (cb_ctx == NULL) {\n135\t        ret = PICOQUIC_ERROR_UNEXPECTED_ERROR;\n136\t    }\n137\t    else {\n138\t        picoquic_cnx_t* cnx_client = (cb_ctx->test_ctx == NULL)?NULL:cb_ctx->test_ctx->cnx_client;\n139\t        switch (cb_mode) {\n140\t        case picoquic_packet_loop_ready: {\n141\t            picoquic_packet_loop_options_t* options = (picoquic_packet_loop_options_t*)callback_arg;\n142\t            if (cb_ctx->test_id > 1) {\n143\t                options->do_time_check = 1;\n144\t                if (cb_ctx->param->extra_socket_required) {\n145\t                    options->provide_alt_port = 1;\n146\t                }\n147\t            }\n148\t            DBG_PRINTF(\"%s\", \"Waiting for packets.\\n\");\n149\t            break;\n150\t        }\n151\t        case picoquic_packet_loop_after_receive:\n152\t            /* Post receive callback */\n153\t            if (cnx_client->cnx_state == picoquic_state_disconnected) {\n154\t                DBG_PRINTF(\"%s\", \"The connection is closed!\\n\");\n155\t                ret = PICOQUIC_NO_ERROR_TERMINATE_PACKET_LOOP;\n156\t                break;\n157\t            }\n158\t            if (picoquic_get_cnx_state(cnx_client) == picoquic_state_client_almost_ready && cb_ctx->notified_ready == 0) {\n159\t                /* if almost ready, display results of negotiation */\n160\t                if (picoquic_tls_is_psk_handshake(cnx_client)) {\n161\t                    DBG_PRINTF(\"%s\", \"The session was properly resumed!\");\n162\t                }\n163\t\n164\t                if (cnx_client->zero_rtt_data_accepted) {\n165\t                    DBG_PRINTF(\"%s\", \"Zero RTT data is accepted!\");\n166\t                }\n167\t\n168\t                if (cnx_client->alpn != NULL) {\n169\t                    DBG_PRINTF(\"Negotiated ALPN: %s\", cnx_client->alpn);\n170\t                }\n171\t                DBG_PRINTF(\"%s\", \"Almost ready!\");\n172\t                cb_ctx->notified_ready = 1;\n173\t                /* Store the initial versions of address and CID */\n174\t                picoquic_store_addr(&cb_ctx->client_address, (struct sockaddr*)&cnx_client->path[0]->first_tuple->local_addr);\n175\t                picoquic_store_addr(&cb_ctx->server_address, (struct sockaddr*)&cnx_client->path[0]->first_tuple->peer_addr);\n176\t                cb_ctx->client_cid_before_migration = cnx_client->path[0]->first_tuple->p_local_cnxid->cnx_id;\n177\t                cb_ctx->server_cid_before_migration = cnx_client->path[0]->first_tuple->p_remote_cnxid->cnx_id;\n178\t            }\n179\t            else if (ret == 0 && picoquic_get_cnx_state(cnx_client) == picoquic_state_ready) {\n180\t                /* Handle migration tests */\n181\t                if (cb_ctx->force_migration){\n182\t                    if 