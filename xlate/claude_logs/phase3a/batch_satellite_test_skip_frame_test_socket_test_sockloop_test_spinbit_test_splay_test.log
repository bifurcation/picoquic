{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_017VpdM5DMNUmr9nJ7keWpqH","type":"tool_result","content":"1\t//! Test cases for `picoquictest/high_latency_test.c`.\n2\t//!\n3\t//! Exercises the QUIC stack over simulated high-latency satellite links\n4\t//! (5-second one-way delay) with various congestion-control algorithms.\n5\t\n6\t#![allow(non_snake_case)]\n7\t\n8\tuse super::util::{TestApiStreamDesc, tls_api_one_scenario_body, tls_api_one_scenario_init_ex};\n9\tuse crate::internal::{Version, init_transport_parameters};\n10\tuse crate::tp::TransportParameters;\n11\tuse crate::{CongestionAlgorithm, ConnectionId, Duration, Instant, get_congestion_algorithm};\n12\t\n13\t// ---------------------------------------------------------------------------\n14\t// Shared large scenario: 100 × 1 MB streams.\n15\t// C: `hilat_scenario_100mb[]` in `picoquictest/high_latency_test.c`.\n16\t\n17\tconst HILAT_SCENARIO_100MB: &[TestApiStreamDesc] = &{\n18\t    const fn desc(id: u64) -> TestApiStreamDesc {\n19\t        TestApiStreamDesc {\n20\t            stream_id: id,\n21\t            previous_stream_id: 0,\n22\t            q_len: 257,\n23\t            r_len: 1_000_000,\n24\t        }\n25\t    }\n26\t    [\n27\t        desc(4),\n28\t        desc(8),\n29\t        desc(12),\n30\t        desc(16),\n31\t        desc(20),\n32\t        desc(24),\n33\t        desc(28),\n34\t        desc(32),\n35\t        desc(36),\n36\t        desc(40),\n37\t        desc(44),\n38\t        desc(48),\n39\t        desc(52),\n40\t        desc(56),\n41\t        desc(60),\n42\t        desc(64),\n43\t        desc(68),\n44\t        desc(72),\n45\t        desc(76),\n46\t        desc(80),\n47\t        desc(84),\n48\t        desc(88),\n49\t        desc(92),\n50\t        desc(96),\n51\t        desc(100),\n52\t        desc(104),\n53\t        desc(108),\n54\t        desc(112),\n55\t        desc(116),\n56\t        desc(120),\n57\t        desc(124),\n58\t        desc(128),\n59\t        desc(132),\n60\t        desc(136),\n61\t        desc(140),\n62\t        desc(144),\n63\t        desc(148),\n64\t        desc(152),\n65\t        desc(156),\n66\t        desc(160),\n67\t        desc(164),\n68\t        desc(168),\n69\t        desc(172),\n70\t        desc(176),\n71\t        desc(180),\n72\t        desc(184),\n73\t        desc(188),\n74\t        desc(192),\n75\t        desc(196),\n76\t        desc(200),\n77\t        desc(204),\n78\t        desc(208),\n79\t        desc(212),\n80\t        desc(216),\n81\t        desc(220),\n82\t        desc(224),\n83\t        desc(228),\n84\t        desc(232),\n85\t        desc(236),\n86\t        desc(240),\n87\t        desc(244),\n88\t        desc(248),\n89\t        desc(252),\n90\t        desc(256),\n91\t        desc(260),\n92\t        desc(264),\n93\t        desc(268),\n94\t        desc(272),\n95\t        desc(276),\n96\t        desc(280),\n97\t        desc(284),\n98\t        desc(288),\n99\t        desc(292),\n100\t        desc(296),\n101\t        desc(300),\n102\t        desc(304),\n103\t        desc(308),\n104\t        desc(312),\n105\t        desc(316),\n106\t        desc(320),\n107\t        desc(324),\n108\t        desc(328),\n109\t        desc(332),\n110\t        desc(336),\n111\t        desc(340),\n112\t        desc(344),\n113\t        desc(348),\n114\t        desc(352),\n115\t        desc(356),\n116\t        desc(360),\n117\t        desc(364),\n118\t        desc(368),\n119\t        desc(372),\n120\t        desc(376),\n121\t        desc(380),\n122\t        desc(384),\n123\t        desc(388),\n124\t        desc(392),\n125\t        desc(396),\n126\t        desc(400),\n127\t    ]\n128\t};\n129\t\n130\t// ---------------------------------------------------------------------------\n131\t// Core helper.\n132\t// C: `high_latency_one` in `picoquictest/high_latency_test.c`.\n133\t\n134\tfn high_latency_one(\n135\t    test_id: u8,\n136\t    ccalgo: &'static CongestionAlgorithm,\n137\t    scenario: &[TestApiStreamDesc],\n138\t    max_completion_time: u64,\n139\t    latency: u64,\n140\t    mbps_up: u64,\n141\t    mbps_down: u64,\n142\t    jitter: u64,\n143\t    has_loss: bool,\n144\t    do_preemptive: bool,\n145\t    seed_bw: bool,\n146\t) {\n147\t    let mut simulated_time = Instant::from_ticks(0);\n148\t    let picosec_per_byte_up = (1_000_000u64 * 8) / mbps_up;\n149\t    let picosec_per_byte_down = (1_000_000u64 * 8) / mbps_down;\n150\t\n151\t    let mut client_params = TransportParameters::default();\n152\t    init_transport_parameters(&mut client_params);\n153\t    client_params.enable_time_stamp = 3;\n154\t\n155\t    let mut server_params = TransportParameters::default();\n156\t    init_transport_parameters(&mut server_params);\n157\t    server_params.enable_time_stamp = 3;\n158\t\n159\t    // Build an initial CID with test-specific bytes, matching the C layout.\n160\t    let mut cid_bytes = [0u8; 8];\n161\t    cid_bytes[0] = 0x1a;\n162\t    cid_bytes[1] = 0x7e;\n163\t    cid_bytes[2] = test_id;\n164\t    cid_bytes[3] = if mbps_up > 0xff { 0xff } else { mbps_up as u8 };\n165\t    cid_bytes[4] = if mbps_down > 0xff {\n166\t        0xff\n167\t    } else {\n168\t        mbps_down as u8\n169\t    };\n170\t    cid_bytes[5] = if latency > 16_000_000 {\n171\t        0xff\n172\t    } else {\n173\t        (latency / 100_000) as u8\n174\t    };\n175\t    cid_bytes[6] = if jitter > 255_000 {\n176\t        0xff\n177\t    } else {\n178\t        (jitter / 1_000) as u8\n179\t    };\n180\t    cid_bytes[7] = if has_loss { 0x30 } else { 0x00 };\n181\t    if seed_bw {\n182\t        cid_bytes[7] |= 0x80;\n183\t    }\n184\t    if do_preemptive {\n185\t        cid_bytes[7] ^= 0x0f;\n186\t    }\n187\t    let initial_cid = ConnectionId::clone_from_slice(&cid_bytes).expect(\"initial CID\");\n188\t\n189\t    let mut test_ctx = tls_api_one_scenario_init_ex(\n190\t        &mut simulated_time,\n191\t        Version::InternalTest1,\n192\t        Some(&client_params),\n193\t        Some(&server_params),\n194\t        Some(&initial_cid),\n195\t    )\n196\t    .expect(\"test context\");\n197\t\n198\t    test_ctx.qserver.set_default_congestion_algorithm(ccalgo);\n199\t    test_ctx.cnx_client().set_preemptive_repeat(do_preemptive);\n200\t    test_ctx.qserver.set_preemptive_repeat_policy(do_preemptive);\n201\t\n202\t    test_ctx.c_to_s_link.jitter = jitter;\n203\t    test_ctx.c_to_s_link.microsec_latency = latency;\n204\t    test_ctx.c_to_s_link.picosec_per_byte = picosec_per_byte_up;\n205\t    test_ctx.s_to_c_link.microsec_latency = latency;\n206\t    test_ctx.s_to_c_link.picosec_per_byte = picosec_per_byte_down;\n207\t    test_ctx.s_to_c_link.jitter = jitter;\n208\t    test_ctx.stream0_flow_release = true;\n209\t    test_ctx.immediate_exit = true;\n210\t\n211\t    if seed_bw {\n212\t        let estimated_rtt = 2 * latency;\n213\t        let estimated_bdp = estimated_rtt * 125_000 * mbps_up / 1_000_000;\n214\t        let server_ip = test_ctx.server_addr.ip();\n215\t        test_ctx.cnx_client().seed_bandwidth(\n216\t            Duration::from_ticks(estimated_rtt),\n217\t            estimated_bdp,\n218\t            server_ip,\n219\t        );\n220\t    }\n221\t\n222\t    test_ctx.cnx_client().set_pmtud_required(true);\n223\t\n224\t    let _ = test_ctx.qserver.set_qlog(\".\");\n225\t    let _ = test_ctx.qclient.set_qlog(\".\");\n226\t\n227\t    let loss_mask: u64 = if has_loss { 0x1000_0000 } else { 0 };\n228\t    tls_api_one_scenario_body(\n229\t        &mut test_ctx,\n230\t        &mut simulated_time,\n231\t        scenario,\n232\t        loss_mask,\n233\t        0,\n234\t        0,\n235\t        2 * latency,\n236\t        max_completion_time,\n237\t    )\n238\t    .expect(\"scenario completed\");\n239\t\n240\t    if do_preemptive {\n241\t        assert!(\n242\t            test_ctx.cnx_client().preemptive_repeat_count() > 0,\n243\t            \"expected non-zero preemptive repeats\"\n244\t        );\n245\t    }\n246\t}\n247\t\n248\t// --------------------------------------------------