{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01P1ytSi2LDMTxQy2x4YZWaa","type":"tool_result","content":"1\t/*\n2\t* Author: Christian Huitema\n3\t* Copyright (c) 2017, Private Octopus, Inc.\n4\t* All rights reserved.\n5\t*\n6\t* Permission to use, copy, modify, and distribute this software for any\n7\t* purpose with or without fee is hereby granted, provided that the above\n8\t* copyright notice and this permission notice appear in all copies.\n9\t*\n10\t* THIS SOFTWARE IS PROVIDED BY THE COPYRIGHT HOLDERS AND CONTRIBUTORS \"AS IS\" AND\n11\t* ANY EXPRESS OR IMPLIED WARRANTIES, INCLUDING, BUT NOT LIMITED TO, THE IMPLIED\n12\t* WARRANTIES OF MERCHANTABILITY AND FITNESS FOR A PARTICULAR PURPOSE ARE\n13\t* DISCLAIMED. IN NO EVENT SHALL Private Octopus, Inc. BE LIABLE FOR ANY\n14\t* DIRECT, INDIRECT, INCIDENTAL, SPECIAL, EXEMPLARY, OR CONSEQUENTIAL DAMAGES\n15\t* (INCLUDING, BUT NOT LIMITED TO, PROCUREMENT OF SUBSTITUTE GOODS OR SERVICES;\n16\t* LOSS OF USE, DATA, OR PROFITS; OR BUSINESS INTERRUPTION) HOWEVER CAUSED AND\n17\t* ON ANY THEORY OF LIABILITY, WHETHER IN CONTRACT, STRICT LIABILITY, OR TORT\n18\t* (INCLUDING NEGLIGENCE OR OTHERWISE) ARISING IN ANY WAY OUT OF THE USE OF THIS\n19\t* SOFTWARE, EVEN IF ADVISED OF THE POSSIBILITY OF SUCH DAMAGE.\n20\t*/\n21\t\n22\t#include \"picosocks.h\"\n23\t#include \"picoquic_utils.h\"\n24\t\n25\tstatic int socket_ping_pong(SOCKET_TYPE fd, struct sockaddr* server_addr,\n26\t    picoquic_server_sockets_t* server_sockets)\n27\t{\n28\t    int ret = 0;\n29\t    uint64_t current_time = picoquic_current_time();\n30\t    uint8_t message[1440];\n31\t    uint8_t buffer[1536];\n32\t    int bytes_sent = 0;\n33\t    int bytes_recv = 0;\n34\t    struct sockaddr_storage server_addr_n = { 0 };\n35\t    struct sockaddr_storage addr_from;\n36\t    struct sockaddr_storage addr_dest;\n37\t    int dest_if = 0;\n38\t    struct sockaddr_storage addr_back;\n39\t    int server_address_length = (server_addr->sa_family == AF_INET) ? sizeof(struct sockaddr_in) : sizeof(struct sockaddr_in6);\n40\t\n41\t    for (size_t i = 0; i < sizeof(message);) {\n42\t        for (int j = 0; j < 64 && i < sizeof(message); j += 8, i++) {\n43\t            message[i++] = (uint8_t)(current_time >> j);\n44\t        }\n45\t    }\n46\t    memcpy(&server_addr_n, server_addr, (server_addr->sa_family == AF_INET) ? sizeof(struct sockaddr_in) : sizeof(struct sockaddr_in6));\n47\t\n48\t    /* send from client to sever address */\n49\t    \n50\t    bytes_sent = sendto(fd, (const char*)&message, sizeof(message), 0, (struct sockaddr*)&server_addr_n, server_address_length);\n51\t\n52\t    if (bytes_sent != (int)sizeof(message)) {\n53\t        DBG_PRINTF(\"Sendto sent %d bytes, expected %d\\n\", bytes_sent, (int)sizeof(message));\n54\t        ret = -1;\n55\t    }\n56\t\n57\t    /* perform select at server */\n58\t    if (ret == 0) {\n59\t        unsigned char received_ecn;\n60\t        memset(buffer, 0, sizeof(buffer));\n61\t\n62\t        bytes_recv = picoquic_select(server_sockets->s_socket, PICOQUIC_NB_SERVER_SOCKETS,\n63\t            &addr_from, &addr_dest, &dest_if, &received_ecn,\n64\t            buffer, sizeof(buffer), 1000000, &current_time);\n65\t\n66\t        if (bytes_recv != bytes_sent) {\n67\t            DBG_PRINTF(\"Select returns %d bytes, expected %d\\n\", bytes_recv, bytes_sent);\n68\t            ret = -1;\n69\t        }\n70\t    }\n71\t\n72\t    /* Convert message using XOR  and send to address from which the message was received */\n73\t    if (ret == 0) {\n74\t        int sock_err = 0;\n75\t        for (int i = 0; i < bytes_recv; i++) {\n76\t            buffer[i] ^= 0xFF;\n77\t        }\n78\t\n79\t        if (picoquic_send_through_server_sockets(server_sockets,\n80\t                (struct sockaddr*)&addr_from,\n81\t                (struct sockaddr*)&addr_dest, dest_if,\n82\t                (char*)buffer, bytes_recv, &sock_err)\n83\t            != bytes_recv) {\n84\t            DBG_PRINTF(\"Send_through_server_sockets return %d, err %d\", ret, sock_err);\n85\t            ret = -1;\n86\t        }\n87\t    }\n88\t\n89\t    /* perform select at client */\n90\t    if (ret == 0) {\n91\t        unsigned char received_ecn;\n92\t        memset(buffer, 0, sizeof(buffer));\n93\t\n94\t        bytes_recv = picoquic_select(&fd, 1,\n95\t            &addr_back, NULL, NULL, &received_ecn,\n96\t            buffer, sizeof(buffer), 1000000, &current_time);\n97\t\n98\t        if (bytes_recv != bytes_sent) {\n99\t            DBG_PRINTF(\"Second select returns %d bytes, expected %d\\n\", bytes_recv, bytes_sent);\n100\t            ret = -1;\n101\t        } else {\n102\t            /* Check that the message matches what was sent initially */\n103\t\n104\t            for (int i = 0; ret == 0 && i < bytes_recv; i++) {\n105\t                if (message[i] != (buffer[i] ^ 0xFF)) {\n106\t                    DBG_PRINTF(\"Second select, message mismatch at position %d\\n\", i);\n107\t                    ret = -1;\n108\t                }\n109\t            }\n110\t\n111\t            DBG_PRINTF(\"Received ecn: %x\\n\", received_ecn);\n112\t        }\n113\t    }\n114\t\n115\t    return ret;\n116\t}\n117\t\n118\tstatic int socket_test_one(char const* addr_text, int server_port, int should_be_name,\n119\t    picoquic_server_sockets_t* server_sockets)\n120\t{\n121\t    int ret = 0;\n122\t    struct sockaddr_storage server_address;\n123\t    int is_name;\n124\t    SOCKET_TYPE fd = INVALID_SOCKET;\n125\t\n126\t    /* Resolve the server address -- check the \"is_name\" property */\n127\t    ret = picoquic_get_server_address(addr_text, server_port, &server_address, &is_name);\n128\t\n129\t    if (ret == 0) {\n130\t        if (is_name != should_be_name) {\n131\t            ret = -1;\n132\t        } else {\n133\t            fd = socket(server_address.ss_family, SOCK_DGRAM, IPPROTO_UDP);\n134\t            if (fd == INVALID_SOCKET) {\n135\t                ret = -1;\n136\t            } else {\n137\t                ret = socket_ping_pong(fd, (struct sockaddr*)&server_address, server_sockets);\n138\t            }\n139\t\n140\t            SOCKET_CLOSE(fd);\n141\t        }\n142\t    }\n143\t\n144\t    return ret;\n145\t}\n146\t\n147\tint socket_test_port(picoquic_server_sockets_t* server_sockets, int test_port)\n148\t{\n149\t    int ret = 0;\n150\t\n151\t    /* For a series of server addresses, do a ping pong test */\n152\t    if (socket_test_one(\"127.0.0.1\", test_port, 0, server_sockets) != 0) {\n153\t        ret = -1;\n154\t    }\n155\t    else if (socket_test_one(\"::1\", test_port, 0, server_sockets) != 0) {\n156\t        ret = -1;\n157\t    }\n158\t    else if (socket_test_one(\"localhost\", test_port, 1, server_sockets) != 0) {\n159\t        ret = -1;\n160\t    }\n161\t\n162\t    return ret;\n163\t}\n164\t\n165\tint socket_test(void)\n166\t{\n167\t    int ret = 0;\n168\t    int test_port = 12345;\n169\t    int test_port2 = 1234;\n170\t\n171\t    /* Open server sockets */\n172\t    picoquic_server_sockets_t server_sockets;\n173\t    ret = picoquic_open_server_sockets(&server_sockets, test_port);\n174\t\n175\t    if (ret == 0) {\n176\t\n177\t        /* Test with one server socket */\n178\t        ret = socket_test_port(&server_sockets, test_port);\n179\t\n180\t        if (ret == 0) {\n181\t            /* Test with two server sockets */\n182\t            picoquic_server_sockets_t server_sockets2;\n183\t            ret = picoquic_open_server_sockets(&server_sockets2, test_port2);\n184\t\n185\t            if (ret == 0) {\n186\t                ret = socket_test_port(&server_sockets2, test_port2);\n187\t                picoquic_close_server_sockets(&server_sockets2);\n188\t            }\n189\t        }\n190\t\n191\t        /* Close the sockets */\n192\t        picoquic_close_server_sockets(&server_sockets);\n193\t    }\n194\t\n195\t    return ret;\n196\t}\n197\t\n198\t/*\n199\t * Test whether ECN values can be set.\n200\t */\n201\t\n202\tint socket_ecn_test_one(int af_domain)\n203\t{\n204\t    int ret = 0;\n205\t    SOCKET_TYPE fd = picoquic_open_client_socket(af_domain);\n206\t\n207\t    if (fd == INVALID_SOCKET) {\n208\t        ret = -1;\n209\t    }\n210\t    else {\n211\t        int recv_set = 0;\n212\t        int send_set = 0;\n213\t\n214\t        ret = picoquic_socket_set_ecn_options(fd, af_domain, &recv_set, &send_set);\n215\t\n216\t        if (ret != 0) {\n217\t            DBG_PRINTF(\"Cannot set ECN options, af = %d, ret = %d\\n\", af_domain, ret);\n218\t        } else if (!recv_set) {\n219\t            DBG_PRINTF(\"Cannot receive ECN flags, af = %d\\n\", af_domain);\n220\t            ret = -1;\n221\t        } else if (!send_set){\n222\t            DBG_PRINTF(\"Cannot send ECN 0, af = %d\\n\", af_domain);\n223\t#ifndef _WINDOWS\n224\t            ret = -1;\n225\t#endif\n226\t        }\n227\t\n228\t        SOCKET_CLOSE(fd);\n229\t    }\n230\t\n231\t    return ret;\n232\t}\n233\t\n234\tint socket_ecn_test(void)\n235\t{\n236\t    int ret;\n237\t\n238\t    ret = socket_ecn_test_one(AF_INET);\n239\t\n240\t    if (ret == 0) {\n241\t        ret = socket_ecn_test_one(AF_INET6);\n242\t    }\n243\t\n244\t    return ret;\n245\t}\n246\t"}]},"parent_tool_use_id":null,"session_id":"cb85c5eb-b826-43b9-84a4-4be9b46756f2","uuid":"43888f28-f8c2-429d-9ae6-2f4a9a17fe53","timestamp":"2026-05-05T11:51:19.675Z","tool_use_result":{"type":"text","file":{"filePath":"/Users/richbarn/Projects/picoquic/picoquictest/socket_test.c","content":"/*\n* Author: Christian Huitema\n* Copyright (c) 2017, Private Octopus, Inc.\n* All rights reserved.\n*\n* Permission to use, copy, modify, and distribute this software for any\n* purpose with or without fee is hereby granted, provided that the above\n* copyright notice and this permission notice appear in all copies.\n*\n* THIS SOFTWARE IS PROVIDED BY THE COPYRIGHT HOLDERS AND CONTRIBUTORS \"AS IS\" AND\n* ANY EXPRESS OR IMPLIED WARRANTIES, INCLUDING, BUT NOT LIMITED TO, THE IMPLIED\n* WARRANTIES OF MERCHANTABILITY AND FITNESS FOR A PARTICULAR PURPOSE ARE\n* DISCLAIMED. IN NO EVENT SHALL Private Octopus, Inc. BE LIABLE FOR ANY\n* DIRECT, INDIRECT, INCIDENTAL, SPECIAL, EXEMPLARY, OR CONSEQUENTIAL DAMAGES\n* (INCLUDING, BUT NOT LIMITED TO, PROCUREMENT OF SUBSTITUTE GOODS OR SERVICES;\n* LOSS OF USE, DATA, OR PROFITS; OR BUSINESS INTERRUPTION) HOWEVER CAUSED AND\n* ON ANY THEORY OF LIABILITY, WHETHER IN CONTRACT, STRICT LIABILITY, OR TORT\n* (INCLUDING NEGLIGENCE OR OTHERWISE) ARISING IN ANY WAY OUT OF THE USE OF THIS\n* SOFTWARE, EVEN IF ADVISED OF THE POSSIBILITY OF SUCH DAMAGE.\n*/\n\n#include \"picosocks.h\"\n#include \"picoquic_utils.h\"\n\nstatic int socket_ping_pong(SOCKET_TYPE fd, struct sockaddr* server_addr,\n    picoquic_server_sockets_t* server_sockets)\n{\n    int ret = 0;\n    uint64_t current_time = picoquic_current_time();\n    uint8_t message[1440];\n    uint8_t buffer[1536];\n    int bytes_sent = 0;\n    int bytes_recv = 0;\n    struct sockaddr_storage server_addr_n = { 0 };\n    struct sockaddr_storage addr_from;\n    struct sockaddr_storage addr_dest;\n    int dest_if = 0;\n    struct sockaddr_storage addr_back;\n    int server_address_length = (server_addr->sa_family == AF_INET) ? sizeof(struct sockaddr_in) : sizeof(struct sockaddr_in6);\n\n    for (size_t i = 0; i < sizeof(message);) {\n        for (int j = 0; j < 64 && i < sizeof(message); j += 8, i++) {\n            message[i++] = (uint8_t)(current_time >> j);\n        }\n    }\n    memcpy(&server_addr_n, server_addr, (server_addr->sa_family == AF_INET) ? sizeof(struct sockaddr_in) : sizeof(struct sockaddr_in6));\n\n    /* send from client to sever address */\n    \n    bytes_sent = sendto(fd, (const char*)&message, sizeof(message), 0, (struct sockaddr*)&server_addr_n, server_address_length);\n\n    if (bytes_sent != (int)sizeof(message)) {\n        DBG_PRINTF(\"Sendto sent %d bytes, expected %d\\n\", bytes_sent, (int)sizeof(message));\n        ret = -1;\n    }\n\n    /* perform select at server */\n    if (ret == 0) {\n        unsigned char received_ecn;\n        memset(buffer, 0, sizeof(buffer));\n\n        bytes_recv = picoquic_select(server_sockets->s_socket, PICOQUIC_NB_SERVER_SOCKETS,\n            &addr_from, &addr_dest, &dest_if, &received_ecn,\n            buffer, sizeof(buffer), 1000000, &current_time);\n\n        if (bytes_recv != bytes_sent) {\n            DBG_PRINTF(\"Select returns %d bytes, expected %d\\n\", bytes_recv, bytes_sent);\n            ret = -1;\n        }\n    }\n\n    /* Convert message using XOR  and send to address from which the message was received */\n    if (ret == 0) {\n        int sock_err = 0;\n        for (int i = 0; i < bytes_recv; i++) {\n            buffer[i] ^= 0xFF;\n        }\n\n        if (picoquic_send_through_server_sockets(server_sockets,\n                (struct sockaddr*)&addr_from,\n                (struct sockaddr*)&addr_dest, dest_if,\n                (char*)buffer, bytes_recv, &sock_err)\n            != bytes_recv) {\n            DBG_PRINTF(\"Send_through_server_sockets return %d, err %d\", ret, sock_err);\n            ret = -1;\n        }\n    }\n\n    /* perform select at client */\n    if (ret == 0) {\n        unsigned char received_ecn;\n        memset(buffer, 0, sizeof(buffer));\n\n        bytes_recv = picoquic_select(&fd, 1,\n            &addr_back, NULL, NULL, &received_ecn,\n            buffer, sizeof(buffer), 1000000, &current_time);\n\n        if (bytes_recv != bytes_sent) {\n            DBG_PRINTF(\"Second select returns %d bytes, expected %d\\n\", bytes_recv, bytes_sent);\n            ret = -1;\n        } else {\n            /* Check that the message matches what was sent initially */\n\n            for (int i = 0; ret == 0 && i < bytes_recv; i++) {\n                if (message[i] != (buffer[i] ^ 0xFF)) {\n                    DBG_PRINTF(\"Second select, message mismatch at position %d\\n\", i);\n                    ret = -1;\n                }\n            }\n\n            DBG_PRINTF(\"Received ecn: %x\\n\", received_ecn);\n        }\n    }\n\n    return ret;\n}\n\nstatic int socket_test_one(char const* addr_text, int server_port, int should_be_name,\n    picoquic_server_sockets_t* server_sockets)\n{\n    int ret = 0;\n    struct sockaddr_storage server_address;\n    int is_name;\n    SOCKET_TYPE fd = INVALID_SOCKET;\n\n    /* Resolve the server address -- check the \"is_name\" property */\n    ret = picoquic_get_server_address(addr_text, server_port, &server_address, &is_name);\n\n    if (ret == 0) {\n        if (is_name != should_be_name) {\n            ret = -1;\n        } else {\n            fd = socket(server_address.ss_family, SOCK_DGRAM, IPPROTO_UDP);\n            if (fd == INVALID_SOCKET) {\n                ret = -1;\n            } else {\n                ret = socket_ping_pong(fd, (struct sockaddr*)&server_address, server_sockets);\n            }\n\n            SOCKET_CLOSE(fd);\n        }\n    }\n\n    return ret;\n}\n\nint socket_test_port(picoquic_server_sockets_t* server_sockets, int test_port)\n{\n    int ret = 0;\n\n    /* For a series of server addresses, do a ping pong test */\n    if (socket_test_one(\"127.0.0.1\", test_port, 0, server_sockets) != 0) {\n        ret = -1;\n    }\n    else if (socket_test_one(\"::1\", test_port, 0, server_sockets) != 0) {\n        ret = -1;\n    }\n    else if (socket_test_one(\"localhost\", test_port, 1, server_sockets) != 0) {\n        ret = -1;\n    }\n\n    return ret;\n}\n\nint socket_test(void)\n{\n    int ret = 0;\n    int test_port = 12345;\n    int test_port2 = 1234;\n\n    /* Open server sockets */\n    picoquic_server_sockets_t server_sockets;\n    ret = picoquic_open_server_sockets(&server_sockets, test_port);\n\n    if (ret == 0) {\n\n        /* Test with one server socket */\n        ret = socket_test_port(&server_sockets, test_port);\n\n        if (ret == 0) {\n            /* Test with two server sockets */\n            picoquic_server_sockets_t server_sockets2;\n            ret = picoquic_open_server_sockets(&server_sockets2, test_port2);\n\n            if (ret == 0) {\n                ret = socket_test_port(&server_sockets2, test_port2);\n                picoquic_close_server_sockets(&server_sockets2);\n            }\n        }\n\n        /* Close the sockets */\n        picoquic_close_server_sockets(&server_sockets);\n    }\n\n    return ret;\n}\n\n/*\n * Test whether ECN values can be set.\n */\n\nint socket_ecn_test_one(int af_domain)\n{\n    int ret = 0;\n    SOCKET_TYPE fd = picoquic_open_client_socket(af_domain);\n\n    if (fd == INVALID_SOCKET) {\n        ret = -1;\n    }\n    else {\n        int recv_set = 0;\n        int send_set = 0;\n\n        ret = picoquic_socket_set_ecn_options(fd, af_domain, &recv_set, &send_set);\n\n        if (ret != 0) {\n            DBG_PRINTF(\"Cannot set ECN options, af = %d, ret = %d\\n\", af_domain, ret);\n        } else if (!recv_set) {\n            DBG_PRINTF(\"Cannot receive ECN flags, af = %d\\n\", af_domain);\n            ret = -1;\n        } else if (!send_set){\n            DBG_PRINTF(\"Cannot send ECN 0, af = %d\\n\", af_domain);\n#ifndef _WINDOWS\n            ret = -1;\n#endif\n        }\n\n        SOCKET_CLOSE(fd);\n    }\n\n    return ret;\n}\n\nint socket_ecn_test(void)\n{\n    int ret;\n\n    ret = socket_ecn_test_one(AF_INET);\n\n    if (ret == 0) {\n        ret = socket_ecn_test_one(AF_INET6);\n    }\n\n    return ret;\n}\n","numLines":246,"startLine":1,"totalLines":246}}}
