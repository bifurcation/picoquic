{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01JgEbAPqZLWatrnk2doNPBL","type":"tool_result","content":"226\t/// Loop-callback event delivered to [`PacketLoopCbFn::callback`].\n227\t/// Replaces the C `(packet_loop_cb_enum cb_mode, void* callback_argv)`\n228\t/// pair: the enum carries the per-event payload directly, so\n229\t/// implementors no longer cast a `void*`.\n230\t/// C: `packet_loop_cb_enum`.\n231\t#[derive(Debug)]\n232\tpub enum LoopEvent<'a> {\n233\t    /// Loop has finished initializing.  C: `packet_loop_ready`,\n234\t    /// `callback_argv: *mut LoopOptions`.\n235\t    Ready(&'a mut LoopOptions),\n236\t    /// Number of packets received this iteration.  C:\n237\t    /// `packet_loop_after_receive`, `callback_argv: *mut size_t`.\n238\t    AfterReceive(usize),\n239\t    /// Number of packets sent this iteration.  C:\n240\t    /// `packet_loop_after_send`, `callback_argv: *mut size_t`.\n241\t    AfterSend(usize),\n242\t    /// New local address advertised by the application after a\n243\t    /// port update.  C: `packet_loop_port_update`,\n244\t    /// `callback_argv: *mut sockaddr`.\n245\t    PortUpdate(core::net::SocketAddr),\n246\t    /// Optional check-in fired when the application set\n247\t    /// [`LoopOptions::do_time_check`].  C:\n248\t    /// `packet_loop_time_check`.\n249\t    TimeCheck(&'a mut TimeCheckArg),\n250\t    /// Optional system-call duration report fired when the\n251\t    /// application set [`LoopOptions::do_system_call_duration`].\n252\t    /// C: `packet_loop_system_call_duration`.\n253\t    SystemCallDuration(&'a mut SystemCallDuration),\n254\t    /// Wake-up event triggered by [`NetworkThreadCtx::wake_up`].\n255\t    /// C: `packet_loop_wake_up` with `callback_argv: NULL`.\n256\t    WakeUp,\n257\t    /// Alt-port address surfaced for multipath / migration tests.\n258\t    /// C: `packet_loop_alt_port`.\n259\t    AltPort(core::net::SocketAddr),\n260\t}\n261\t\n262\t/// System-call duration statistics surfaced through the optional\n263\t/// [`LoopEvent::SystemCallDuration`] callback.\n264\t/// C: `packet_loop_system_call_duration_t`.\n265\t#[derive(Debug, Default, Copy, Clone)]\n266\tpub struct SystemCallDuration {\n267\t    /// Duration of the most recent zero-delay system call\n268\t    /// (microseconds).\n269\t    pub scd_last: u64,\n270\t    /// Maximum observed system-call duration so far.\n271\t    pub scd_max: u64,\n272\t    /// Smoothed system-call duration (RFC-6298–style EWMA).\n273\t    pub scd_smoothed: u64,\n274\t    /// Mean absolute deviation around `scd_smoothed`.\n275\t    pub scd_dev: u64,\n276\t}\n277\t\n278\t/// In/out argument for the [`LoopEvent::TimeCheck`] callback.\n279\t/// The loop fills `current_time` and a proposed `delta_t`;\n280\t/// the application overwrites `delta_t` with a (possibly smaller)\n281\t/// value if it has work to do sooner.\n282\t/// C: `packet_loop_time_check_arg_t`.\n283\t#[derive(Debug, Copy, Clone)]\n284\tpub struct TimeCheckArg {\n285\t    /// Loop-time timestamp.\n286\t    pub current_time: Instant,\n287\t    /// Proposed sleep, in microseconds — application may shrink.\n288\t    pub delta_t: i64,\n289\t}\n290\t\n291\timpl Default for TimeCheckArg {\n292\t    fn default() -> Self {\n293\t        Self {\n294\t            current_time: Instant::from_ticks(0),\n295\t            delta_t: 0,\n296\t        }\n297\t    }\n298\t}\n299\t\n300\t/// Application callback fired at the lifecycle and per-iteration\n301\t/// events listed in [`LoopEvent`].\n302\t///\n303\t/// C: `int (*packet_loop_cb_fn)(picoquic_quic_t* quic,\n304\t/// packet_loop_cb_enum cb_mode, void* callback_ctx, void*\n305\t/// callback_argv)`.  The `callback_ctx` companion folds into the\n306\t/// trait implementor's state; the `(cb_mode, callback_argv)` tagged\n307\t/// union folds into [`LoopEvent`].\n308\t///\n309\t/// Returns `Ok(())` on success, or an error to break the loop.\n310\tpub trait PacketLoopCbFn {\n311\t    fn callback(&mut self, quic: &mut Quic, event: LoopEvent<'_>) -> Result<(), Error>;\n312\t}\n313\t\n314\t// ---------------------------------------------------------------------------\n315\t// Loop options + parameters.\n316\t\n317\t/// Feature-flags the application advertises in response to the\n318\t/// [`LoopEvent::Ready`]\n319\t/// callback.  C: `packet_loop_options_t`, three single-bit\n320\t/// `unsigned int : 1` fields collapsed to `bool` per the\n321\t/// established convention (see `config.rs`).\n322\t#[derive(Debug, Default, Copy, Clone)]\n323\tpub struct LoopOptions {\n324\t    /// Application wants the loop to call back with\n325\t    /// [`LoopEvent::TimeCheck`]\n326\t    /// before each select.\n327\t    pub do_time_check: bool,\n328\t    /// Application wants notifications when zero-delay system calls\n329\t    /// take noticeably long.\n330\t    pub do_system_call_duration: bool,\n331\t    /// Application provides an alternate port for migration /\n332\t    /// multipath testing.\n333\t    pub provide_alt_port: bool,\n334\t}\n335\t\n336\t/// Loop-construction parameters (v2 / v3 entry points).\n337\t/// C: `packet_loop_param_t`.  `repr(C)` is dropped — the\n338\t/// struct never crosses an external boundary.\n339\t#[derive(Debug, Default, Copy, Clone)]\n340\tpub struct LoopParam {\n341\t    /// Default port for outgoing connections.  `0` ⇒ ephemeral.\n342\t    pub local_port: u16,\n343\t    /// `AF_INET` / `AF_INET6`, or `0` for \"both\".\n344\t    pub local_af: i32,\n345\t    /// Outbound interface index (or `0` to leave it to the kernel)."}]},"parent_tool_use_id":null,"session_id":"cb85c5eb-b826-43b9-84a4-4be9b46756f2","uuid":"6d344927-6629-416f-8848-e4b41e521de4","timestamp":"2026-05-05T11:48:46.337Z","tool_use_result":{"type":"text","file":{"filePath":"/Users/richbarn/Projects/picoquic/rs/fq/src/packet_loop.rs","content":"/// Loop-callback event delivered to [`PacketLoopCbFn::callback`].\n/// Replaces the C `(packet_loop_cb_enum cb_mode, void* callback_argv)`\n/// pair: the 