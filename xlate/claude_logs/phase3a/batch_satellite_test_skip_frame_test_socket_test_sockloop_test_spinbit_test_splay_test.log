me(values_last[i]), \"last after insert i={i}\");\n42\t    }\n43\t\n44\t    // Direct lookups: succeed when the key is in `values`, fail otherwise.\n45\t    for (i, &probe) in previous_test.iter().enumerate() {\n46\t        let token = tree.find(&probe);\n47\t        if previous_value[i] == probe {\n48\t            let token = token.expect(\"hit on present key\");\n49\t            let (k, _) = tree.get_key_value(token).expect(\"token live\");\n50\t            assert_eq!(*k, previous_value[i], \"find at i={i}, probe={probe}\");\n51\t        } else {\n52\t            assert!(token.is_none(), \"false hit at i={i}, probe={probe}\");\n53\t        }\n54\t    }\n55\t\n56\t    // Previous-or-equal lookups: succeed when there's any key ≤ probe.\n57\t    for (i, &probe) in previous_test.iter().enumerate() {\n58\t        let token = tree.find_previous(&probe);\n59\t        if previous_value[i] >= 0 {\n60\t            let token = token.expect(\"previous hit\");\n61\t            let (k, _) = tree.get_key_value(token).expect(\"token live\");\n62\t            assert_eq!(\n63\t                *k, previous_value[i],\n64\t                \"find_previous at i={i}, probe={probe}\"\n65\t            );\n66\t        } else {\n67\t            assert!(\n68\t                token.is_none(),\n69\t                \"false previous-hit at i={i}, probe={probe}\"\n70\t            );\n71\t        }\n72\t    }\n73\t\n74\t    // Deletion + running min / max after each delete.\n75\t    for (i, &v) in values.iter().enumerate() {\n76\t        tree.remove_by_key(&v).expect(\"delete present key\");\n77\t        if i < 6 {\n78\t            let first = tree\n79\t                .first()\n80\t                .and_then(|t| tree.get_key_value(t))\n81\t                .map(|(k, _)| *k);\n82\t            let last = tree\n83\t                .last()\n84\t                .and_then(|t| tree.get_key_value(t))\n85\t                .map(|(k, _)| *k);\n86\t            assert_eq!(first, Some(value2_first[i]), \"first af