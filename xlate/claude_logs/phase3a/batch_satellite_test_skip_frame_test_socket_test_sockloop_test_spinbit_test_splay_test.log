{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01XNh1QBFvTcFpH9kzFsMd9Q","type":"tool_result","content":"100\t    /// outbound TOS / ECN value (`ecn` is one of the 2-bit\n101\t    /// `EcnCodepoint` codes).  Default: delegates to the\n102\t    /// no-op `set_ecn_options`.\n103\t    fn set_ecn_options_ex(&mut self, _ecn: EcnCodepoint) -> Result<(bool, bool), Error> {\n104\t        self.set_ecn_options()\n105\t    }\n106\t\n107\t    /// Enable Path-MTU-Discovery probing on this socket\n108\t    /// (Linux-only; no-op on other platforms by default).\n109\t    fn set_pmtud_options(&mut self) -> Result<(), Error> {\n110\t        Ok(())\n111\t    }\n112\t}\n113\t\n114\t// ---------------------------------------------------------------------------\n115\t// `ServerSockets` -- generic over the socket implementation.\n116\t\n117\t/// Pair of UDP sockets owned by a server (one IPv4, one IPv6).\n118\t/// C: `picoquic_server_sockets_t`.  Generic over the active\n119\t/// [`Socket`] implementation.\n120\tpub struct ServerSockets<S: Socket> {\n121\t    /// One UDP socket per address family.  `None` slots are\n122\t    /// uninitialised — see [`ServerSockets::open`] /\n123\t    /// [`ServerSockets::close`].\n124\t    pub sockets: [Option<S>; SERVER_SOCKET_COUNT],\n125\t}\n126\t\n127\timpl<S: Socket> Default for ServerSockets<S> {\n128\t    fn default() -> Self {\n129\t        Self {\n130\t            sockets: [None, None],\n131\t        }\n132\t    }\n133\t}\n134\t\n135\timpl<S: Socket> ServerSockets<S> {\n136\t    /// Open the IPv4 + IPv6 server-side UDP socket pair listening\n137\t    /// on `port`.  C: `picoquic_open_server_sockets`.  The\n138\t    /// concrete `S` implementor is chosen at the call site;\n139\t    /// the default `crate::socks_socket2::Socket2Udp` wraps\n140\t    /// [`socket2::Socket`].\n141\t    pub fn open(_port: i32) -> Result<Self, Error> {\n142\t        todo!()\n143\t    }\n144\t\n145\t    /// Close every socket in the pair, leaving each slot `None`.\n146\t    /// C: `picoquic_close_server_sockets`.\n147\t    pub fn close(&mut self) {\n148\t        todo!()\n149\t    }\n150\t\n151\t    /// Pick the matching socket (v4 / v6, dispatched by\n152\t    /// `addr_dest`'s family) and send through it.\n153\t    /// C: `picoquic_send_through_server_sockets`.\n154\t    pub fn send_through(\n155\t        &mut self,\n156\t        _addr_dest: &SocketAddr,\n157\t        _addr_from: Option<&SocketAddr>,\n158\t        _from_if: i32,\n159\t        _bytes: &[u8],\n160\t    ) -> Result<usize, OsError> {\n161\t        todo!()\n162\t    }\n163\t}\n164\t\n165\t// ---------------------------------------------------------------------------\n166\t// Receive metadata.\n167\t\n168\t/// Receive metadata returned by [`Socket::recv`].  Mirrors the\n169\t/// C output parameters folded into a single struct.\n170\t#[derive(Debug, Default, Copy, Clone)]\n171\tpub struct RecvInfo {\n172\t    /// Source address; `None` matches the C `addr_from->ss_family\n173\t    /// = 0` written when `recvmsg` returned `<= 0`.\n174\t    pub addr_from: Option<SocketAddr>,\n175\t    /// Destination address parsed out of `IP_PKTINFO` /\n176\t    /// `IPV6_PKTINFO` cmsg; `None` when no pktinfo was attached.\n177\t    pub addr_dest: Option<SocketAddr>,\n178\t    /// Receiving interface index from the same cmsg.\n179\t    pub dest_if: i32,\n180\t    /// `IP_TOS` / `IPV6_TCLASS` ECN code-point byte.\n181\t    pub received_ecn: u8,\n182\t    /// Number of bytes written into the caller's buffer.\n183\t    pub bytes_recv: usize,\n184\t}\n185\t\n186\t/// Result of [`select`].\n187\t///\n188\t/// Folds the seven nullable out-parameters of the C\n189\t/// `picoquic_select_ex` helper into one struct: source / destination\n190\t/// address, interface index, ECN code-point, byte count,\n191\t/// post-receive timestamp, and the index of the socket that fired.\n192\t#[derive(Debug, Copy, Clone)]\n193\tpub struct SelectInfo {\n194\t    pub addr_from: Option<Soc