d[i], (int)s);\n930\t            ret = -1;\n931\t        }\n932\t    }\n933\t\n934\t    return ret;\n935\t}\n936\t\n937\tint stream_rank_test(void)\n938\t{\n939\t    uint64_t stream_rank[] = { 1, 2, 3, 1000, 10000 };\n940\t    uint64_t stream_client_bidir[] = { 0, 4, 8, 3996, 39996 };\n941\t    uint64_t stream_client_unidir[] = { 2, 6, 10, 3998, 39998 };\n942\t    uint64_t stream_server_bidir[] = { 1, 5, 9, 3997, 39997 };\n943\t    uint64_t stream_server_unidir[] = { 3, 7, 11, 3999, 39999 };\n944\t    size_t n = sizeof(stream_rank) / sizeof(uint64_t);\n945\t    int ret = 0;\n946\t\n947\t    ret |= stream_rank_test_one(n, stream_rank, stream_client_bidir, 0, 1);\n948\t    ret |= stream_rank_test_one(n, stream_rank, stream_client_unidir, 1, 1);\n949\t    ret |= stream_rank_test_one(n, stream_rank, stream_server_bidir, 0, 0);\n950\t    ret |= stream_rank_test_one(n, stream_rank, stream_server_unidir, 1, 0);\n951\t\n952\t    return ret;\n953\t}\n954\t\n955\t/* Unit test of \"picoquic_provide_stream_data_buffer\"\n956\t */\n957\t\n958\tstatic int picoquic_set_stream_buffer_context(picoquic_stream_data_buffer_argument_t * stream_data_context,\n959\t    uint8_t * bytes, uint8_t * bytes_max, uint64_t stream_id, uint64_t stream_offset)\n960\t{\n961\t    int ret = 0;\n962\t    uint8_t* bytes0 = bytes;\n963\t    memset(stream_data_context, 0, sizeof(picoquic_stream_data_buffer_argument_t));\n964\t    if ((bytes = picoquic_format_stream_frame_header(bytes, bytes_max, stream_id, stream_offset)) == NULL) {\n965\t        ret = -1;\n966\t    }\n967\t    else {\n968\t        /* Compute the length */\n969\t        stream_data_context->bytes = bytes0;\n970\t        stream_data_context->byte_index = bytes - bytes0;\n971\t        stream_data_context->allowed_space = bytes_max - bytes;\n972\t        stream_data_context->byte_space = bytes_max - bytes;\n973\t        stream_data_context->length = 0;\n974\t        stream_data_context->is_fin = 0;\n975\t        stream_data_context->is_still_active = 0;\n976\t        stream_data_context->app_buffer = NULL;\n977\t    }\n978\t    return ret;\n979\t}\n980\t\n981\ttypedef enum {\n982\t    size_test_full = 0,\n983\t    size_test_minus_1,\n984\t    size_test_minus_2,\n985\t    size_test_minus_3,\n986\t    size_test_1,\n987\t    size_test_0,\n988\t    size_test_too_long,\n989\t    size_test_last\n990\t} size_test_enum;\n991\t\n992\tint provide_stream_buffer_test_one(uint64_t stream_id, uint64_t stream_offset, size_test_enum size_test, int is_fin)\n993\t{\n994\t    uint8_t packet[512];\n995\t    uint8_t test_data[512];\n996\t    picoquic_stream_data_buffer_argument_t stream_data_context;\n997\t    int ret = picoquic_set_stream_buffer_context(&stream_data_context, packet, packet + sizeof(packet), stream_id, stream_offset);\n998\t    size_t length = 0;\n999\t\n1000\t    if (ret == 0) {\n1001\t\n1002\t        switch (size_test) {\n1003\t        case size_test_full:\n1004\t            length = stream_data_context.byte_space;\n1005\t            break;\n1006\t        case size_test_minus_1:\n1007\t            length = stream_data_context.byte_space - 1;\n1008\t            break;\n1009\t        case size_test_minus_2:\n1010\t            length = stream_data_context.byte_space - 2;\n1011\t            break;\n1012\t        case size_test_minus_3:\n1013\t            length = stream_data_context.byte_space - 3;\n1014\t            break;\n1015\t        case size_test_1:\n1016\t            length = 1;\n1017\t            break;\n1018\t        case size_test_0:\n1019\t            length = 0;\n1020\t            break;\n1021\t        case size_test_too_long:\n1022\t            length = stream_data_context.byte_space;\n1023\t            stream_data_context.allowed_space = length - 1;\n1024\t            break;\n1025\t        default:\n1026\t            ret = -1;\n1027\t            break;\n1028\t        }\n1029\t    }\n1030\t\n1031\t    if (ret == 0) {\n1032\t        uint8_t * data_ptr = picoquic_provide_stream_data_buffer(&stream_data_context, length, is_fin, 0);\n1033\t\n1034\t        if (size_test == size_test_too_long) {\n1035\t            ret = (data_ptr == NULL) ? 0 : -1;\n1036\t        }\n1037\t        else if (data_ptr == NULL) {\n1038\t            ret = -1;\n1039\t        }\n1040\t        else if (data_ptr + length > packet + sizeof(packet)) {\n1041\t            ret = -1;\n1042\t        }\n1043\t        else {\n1044\t            uint8_t* packet_start = packet;\n1045\t            uint64_t received_stream_id;\n1046\t            uint64_t received_offset;\n1047\t            size_t received_length = 0;\n1048\t            size_t consumed = 0;\n1049\t            int received_fin = 0;\n1050\t\n1051\t            if (length > 0) {\n1052\t                /* set test data value */\n1053\t                for (size_t i = 0; i < length; i++) {\n1054\t                    test_data[i] = (uint8_t)(i ^ 0x7f);\n1055\t                }\n1056\t                /* Fill the data space */\n1057\t                memcpy(data_ptr, test_data, length);\n1058\t            }\n1059\t            /* Get the start point of the data frame */\n1060\t            while (*packet_start == picoquic_frame_type_padding && packet_start < packet + sizeof(packet)) {\n1061\t                packet_start++;\n1062\t            }\n1063\t            /* decode the stream header */\n1064\t            if (picoquic_parse_stream_header(packet_start,\n1065\t                sizeof(packet) - (packet_start - packet), &received_stream_id, &received_offset,\n1066\t                &received_length, &received_fin, &consumed) != 0) {\n1067\t                ret = -1;\n1068\t            }\n1069\t            else if (received_stream_id != stream_id ||\n1070\t                received_offset != stream_offset ||\n1071\t                received_length != length ||\n1072\t                received_fin != is_fin) {\n1073\t                ret = -1;\n1074\t            }\n1075\t            else if (length > 0 &&\n1076\t                memcmp(packet_start + consumed, test_data, length) != 0) {\n1077\t                ret = -1;\n1078\t            }\n1079\t        }\n1080\t    }\n1081\t    return ret;\n1082\t}\n1083\t\n1084\tint provide_stream_buffer_test(void)\n1085\t{\n1086\t    uint64_t stream_ids[4] = { 0, 7, 127, 0x10000 };\n1087\t    uint64_t offsets[4] = { 0, 1, 65, 0x10000 };\n1088\t    int ret = 0;\n1089\t\n1090\t    for (int i_stream = 0; ret == 0 && i_stream < 4; i_stream++) {\n1091\t        for (int i_offset = 0; ret == 0 &&  i_offset < 4; i_offset++) {\n1092\t            for (int is_fin = 0; ret == 0 &&  is_fin < 2; is_fin++) {\n1093\t                for (size_test_enum size_test = 0; ret == 0 &&  size_test < size_test_last; size_test++) {\n1094\t                    ret = provide_stream_buffer_test_one(stream_ids[i_stream], offsets[i_offset], size_test, is_fin);\n1095\t                    if (ret != 0) {\n1096\t                        DBG_PRINTF(\"Fails for stream %\" PRIu64 \", offset %\" PRIu64 \", fin %d, test %d\",\n1097\t                            stream_ids[i_stream], offsets[i_offset], is_fin, size_test);\n1098\t                        break;\n1099\t                    }\n1100\t                }\n1101\t            }\n1102\t        }\n1103\t    }\n1104\t    return ret;\n1105\t}\n1106\t"}]},"parent_tool_use_id":"toolu_01BPSNvzyvS5qpeXKUcCsUGk","session_id":"cb85c5eb-b826-43b9-84a4-4be9b46756f2","uuid":"e3a85d9b-0dea-4799-a206-fd355946ad8b","timestamp":"2026-05-05T12:08:32.091Z"}
