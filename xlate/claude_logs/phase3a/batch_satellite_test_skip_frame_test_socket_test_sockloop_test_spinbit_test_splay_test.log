,\n687\t    TEST_SKIP_ITEM_OLD(\"bad_frame_id\", test_frame_type_bad_frame_id, 1, 0, 3, ERR_P, 1)\n688\t};\n689\t\n690\tsize_t nb_test_frame_error_list = sizeof(test_frame_error_list) / sizeof(test_skip_frames_t);\n691\t\n692\tstatic size_t format_random_packet(uint8_t * bytes, size_t bytes_max, uint64_t * random_context, int epoch)\n693\t{\n694\t    size_t byte_index = 0;\n695\t\n696\t    while (byte_index < bytes_max) {\n697\t        /* Pick a frame from the test list */\n698\t        uint64_t r = picoquic_test_uniform_random(random_context, nb_test_skip_list);\n699\t        if (epoch == -1 || test_skip_list[r].epoch == epoch) {\n700\t            /* stack it in the packet */\n701\t            if (byte_index + test_skip_list[r].len >= bytes_max) {\n702\t                break;\n703\t            }\n704\t            else {\n705\t                memcpy(bytes + byte_index, test_skip_list[r].val, test_skip_list[r].len);\n706\t                byte_index += test_skip_list[r].len;\n707\t                if (test_skip_list[r].must_be_last) {\n708\t                    break;\n709\t                }\n710\t            }\n711\t        }\n712\t    }\n713\t\n714\t    return byte_index;\n715\t}\n716\t\n717\tstatic int skip_test_packet(uint8_t * bytes, size_t bytes_max)\n718\t{\n719\t    int pure_ack;\n720\t    int ret = 0;\n721\t    size_t byte_index = 0;\n722\t    picoquic_cnx_t cnx;\n723\t    memset(&cnx, 0, sizeof(cnx));\n724\t\n725\t    while (ret == 0 && byte_index < bytes_max) {\n726\t        size_t consumed;\n727\t        ret = picoquic_skip_frame(bytes + byte_index, bytes_max - byte_index, &consumed, &pure_ack);\n728\t        if (ret == 0) {\n729\t            byte_index += consumed;\n730\t        }\n731\t    }\n732\t\n733\t    return ret;\n734\t}\n735\t\n736\tstatic void skip_test_fuzz_packet(uint8_t * target, uint8_t * source, size_t bytes_max, uint64_t * random_context)\n737\t{\n738\t    size_t fuzz_index = (size_t) picoquic_test_uniform_random(random_context, bytes_max);\n739\t    size_t fuzz_length = (size_t) (picoquic_test_uniform_random(random_context, 8) + 1);\n740\t    uint64_t fuzz_data = picoquic_test_random(random_context);\n741\t\n742\t    memcpy(target, source, bytes_max);\n743\t\n744\t    for (size_t i = 0; i < fuzz_length && fuzz_index + i < bytes_max; i++) {\n745\t        target[fuzz_index + i] = (uint8_t)(fuzz_data & 0xFF);\n746\t        fuzz_data >>= 8;\n747\t    }\n748\t}\n749\t\n750\tstatic size_t create_test_varint_frame(uint8_t* buffer, size_t buffer_size, size_t i, int v)\n751\t{\n752\t    const uint8_t* bytes = test_skip_list[i].val;\n753\t    const uint8_t* bytes_max = bytes + test_skip_list[i].len;\n754\t    uint64_t u = 0;\n755\t    size_t skipped = 0;\n756\t    /* skip the type and v-1 integers */\n757\t    for (int n = 0; bytes != NULL && n < v; n++) {\n758\t        bytes = picoquic_frames_varint_skip(bytes, bytes_max);\n759\t    }\n760\t    skipped = bytes - test_skip_list[i].val;\n761\t    if (skipped > buffer_size) {\n762\t        return 0;\n763\t    }\n764\t    memcpy(buffer, test_skip_list[i].val, skipped);\n765\t    if (bytes != NULL) {\n766\t        bytes = picoquic_frames_varint_decode(bytes, bytes_max, &u);\n767\t    }\n768\t    if (bytes != NULL) {\n769\t        buffer[skipped++] = 0xc0 + (uint8_t)(u >> 56);\n770\t        buffer[skipped++] = (uint8_t)(u >> 48);\n771\t        buffer[skipped++] = (uint8_t)(u >> 40);\n772\t        buffer[skipped++] = (uint8_t)(u >> 32);\n773\t        buffer[skipped++] = (uint8_t)(u >> 24);\n774\t        buffer[skipped++] = (uint8_t)(u >> 16);\n775\t        buffer[skipped++] = (uint8_t)(u >> 8);\n776\t        /* Last byte is omitted, to force a decoding error */\n777\t    }\n778\t    else {\n779\t        skipped = 0;\n780\t    }\n781\t\n782\t    return skipped;\n783\t}\n784\t\n785\tint skip_frame_varint_test(uint8_t * buffer, size_t buffer_size)\n786\t{\n787\t    int ret = 0;\n788\t\n789\t    for (size_t i = 0; ret == 0 && i < nb_test_skip_list; i++) {\n790\t        for (int v = 1; v <= test_skip_list[i].nb_varints; v++) {\n791\t            size_t consumed = 0;\n792\t            int pure_ack = 0;\n793\t            size_t len = create_test_varint_frame(buffer, buffer_size, i, v);\n794\t            if (len > 0 &&\n795\t                picoquic_skip_frame(buffer, len, &consumed, &pure_ack) == 0) {\n796\t                ret = -1;\n797\t            }\n798\t        }\n799\t    }\n800\t    return ret;\n801\t}\n802\t\n803\tint skip_frame_test(void)\n804\t{\n805\t    int ret = 0;\n806\t    uint8_t buffer[PICOQUIC_MAX_PACKET_SIZE];\n807\t    uint8_t fuzz_buffer[PICOQUIC_MAX_PACKET_SIZE];\n808\t    const uint8_t extra_bytes[4] = { 0xFF, 0, 0, 0 };\n809\t    uint64_t random_context = 0xBABED011;\n810\t    int fuzz_count = 0;\n811\t    int fuzz_fail = 0;\n812\t    picoquic_cnx_t cnx;\n813\t\n814\t    memset(&cnx, 0, sizeof(cnx)); /* Null value gets default test version */\n815\t\n816\t    for (size_t i = 0; ret == 0 && i < nb_test_skip_list; i++) {\n817\t        for (int sharp_end = 0; ret == 0 && sharp_end < 2; sharp_end++) {\n818\t            size_t consumed = 0;\n819\t            size_t byte_max = 0;\n820\t            int pure_ack;\n821\t            int t_ret = 0;\n822\t\n823\t            memcpy(buffer, test_skip_list[i].val, test_skip_list[i].len);\n824\t            byte_max = test_skip_list[i].len;\n825\t            if (test_skip_list[i].must_be_last == 0 && sharp_end == 0) {\n826\t                memcpy(buffer + byte_max, extra_bytes, sizeof(extra_bytes));\n827\t                byte_max += sizeof(extra_bytes);\n828\t            }\n829\t\n830\t            t_ret = picoquic_skip_frame(buffer, byte_max, &consumed, &pure_ack);\n831\t\n832\t            if (t_ret != 0) {\n833\t                DBG_PRINTF(\"Skip frame <%s> fails, ret = %d\\n\", test_skip_list[i].name, t_ret);\n834\t                ret = t_ret;\n835\t            }\n836\t            else if (consumed != test_skip_list[i].len) {\n837\t                DBG_PRINTF(\"Skip frame <%s> fails, wrong length, %d instead of %d\\n\",\n838\t                    test_skip_list[i].name, (int)consumed, (int)test_skip_list[i].len);\n839\t                ret = -1;\n840\t            }\n841\t            else if (pure_ack != test_skip_list[i].is_pure_ack) {\n842\t                DBG_PRINTF(\"Skip frame <%s> fails, wrong pure ack, %d instead of %d\\n\",\n843\t                    test_skip_list[i].name, (int)pure_ack, (int)test_skip_list[i].is_pure_ack);\n844\t                ret = -1;\n845\t            }\n846\t        }\n847\t    }\n848\t\n849\t    /* Check a series of known bad packets. We are checking that an error is\n850\t     * detected and no adverse code issue happens. */\n851\t    for (size_t i = 0; ret == 0 && i < nb_test_frame_error_list; i++) {\n852\t        for (int sharp_end = 0; ret == 0 && sharp_end < 2; sharp_end++) {\n853\t            size_t consumed = 0;\n854\t            size_t byte_max = 0;\n855\t            int pure_ack;\n856\t            int t_ret = 0;\n857\t            memcpy(buffer, test_frame_error_list[i].val, test_frame_error_list[i].len);\n858\t            byte_max = test_frame_error_list[i].len;\n859\t            if (test_frame_error_list[i].must_be_last == 0 && sharp_end == 0) {\n860\t                memcpy(buffer + byte_max, extra_bytes, sizeof(extra_bytes));\n861\t                byte_max += sizeof(extra_bytes);\n862\t            }\n863\t\n864\t            t_ret = picoquic_skip_frame(buffer, byte_max, &consumed, &pure_ack);\n865\t\n866\t            if (t_ret == 0 && test_frame_error_list[i].skip_fails) {\n867\t                DBG_PRINTF(\"Skip error frame <%s> does not fails, ret = %d\\n\", test_frame_error_list[i].name, t_ret);\n868\t                ret = -1;\n869\t            }\n870\t        }\n871\t    }\n872\t    /* Derive and test a series of packets with bad varint encodings */\n873\t    if (ret == 0) {\n874\t        ret = skip_frame_varint_test(buffer, PICOQUIC_MAX_PACKET_SIZE);\n875\t    }\n876\t\n877\t    /* Do a minimal fuzz test */\n878\t    for (size_t i = 0; ret == 0 && i < 100; i++) {\n879\t        size_t bytes_max = format_random_packet(buffer, sizeof(buffer), &random_context, -1);\n880\t\n881\t        ret = skip_test_packet(buffer, bytes_max);\n882\t        if (ret != 0) {\n883\t            DBG_PRINTF(\"Skip packet <%d> fails, ret = %d\\n\", i, ret);\n884\t        } else {\n885\t            /* do the actual fuzz test */\n886\t            int suspended = debug_printf_reset(1);\n887\t            for (size_t j = 0; j < 100; j++) {\n888\t                skip_test_fuzz_packet(fuzz_buffer, buffer, bytes_max, &random_context);\n889\t                if (skip_test_packet(fuzz_buffer, bytes_max) != 0) {\n890\t                    fuzz_fail++;\n891\t                }\n892\t                fuzz_count++;\n893\t            }\n894\t            (void)debug_printf_reset(suspended);\n895\t        }\n896\t    }\n897\t\n898\t    if (ret == 0) {\n899\t        DBG_PRINTF(\"Fuzz skip test passes after %d trials, %d error detected\\n\","}]},"parent_tool_use_id":null,"session_id":"cb85c5eb-b826-43b9-84a4-4be9b46756f2","uuid":"b70114d9-44dc-4be4-baa8-bf0c4549f88f","timestamp":"2026-05-05T11:46:35.245Z","tool_use_result":{"type":"text","file":{"filePath":"/Users/richbarn/Projects/picoquic/picoquictest/skip_frame_test.c","content":"    TEST_SKIP_ITEM(\"stream_min\", test_frame_type_stream_range_min, 0, 1, 3, 0, 0, 1),\n    TEST_SKIP_ITEM(\"stream_max\", test_frame_type_stream_range_max, 0, 0, 3, 0, 0, 4),\n    TEST_SKIP_ITEM(\"crypto_hs\", test_frame_type_crypto_hs, 0, 0, 2, 0, 0, 2),\n    TEST_SKIP_ITEM(\"retire_connection_id\", test_frame_type_retire_connection_id, 0, 0, 3, 0, 0, 1),\n\n    TEST_SKIP_ITEM(\"datagram\", test_frame_type_datagram, 0, 1, 3, 0, 0, 0),\n    TEST_SKIP_ITEM(\"datagram_l\", test_frame_type_datagram_l, 0, 0, 3, 0, 0, 1),\n    TEST_SKIP_ITEM(\"handshake_done\", test_frame_type_handshake_done, 0, 0, 3, 0, 0, 0),\n    TEST_SKIP_ITEM(\"ack_frequency\", test_frame_type_ack_frequency, 0