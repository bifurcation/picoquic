nection! */\n146\t    if (c_ctx->qclient->cnx_list == NULL) {\n147\t        best_wake_time = simulated_time;\n148\t    }\n149\t    else {\n150\t        /* Find the arrival time of the next packet, by looking at\n151\t        * the various links. remember the winner */\n152\t        best_wake_time = simulated_time + picoquic_get_next_wake_delay(c_ctx->qclient,\n153\t            simulated_time, 100000000);\n154\t\n155\t        if (c_ctx->s_to_c_link->first_packet != NULL &&\n156\t            c_ctx->s_to_c_link->first_packet->arrival_time < best_wake_time) {\n157\t            best_wake_time = c_ctx->s_to_c_link->first_packet->arrival_time;\n158\t        }\n159\t\n160\t        if (c_ctx->c_to_s_link->first_packet != NULL &&\n161\t            c_ctx->c_to_s_link->first_packet->arrival_time < best_wake_time) {\n162\t            best_wake_time = c_ctx->c_to_s_link->first_packet->arrival_time;\n163\t        }\n164\t    }\n165\t\n166\t    c_ctx->client_next_time = best_wake_time;\n167\t}\n168\t\n169\tstatic void stress_context_reorder(picoquic_stress_ctx_t* stress_ctx, picoquic_stress_client_t* c_ctx, uint64_t simulated_time)\n170\t{\n171\t    picosplay_delete_hint(&stress_ctx->c_tree, &c_ctx->client_node);\n172\t    stress_client_eval_next_time(c_ctx, simulated_time);\n173\t    picosplay_insert(&stress_ctx->c_tree, c_ctx);\n174\t}\n175\t\n176\t/*\n177\t* Call back function, server side.\n178\t*\n179\t* Try to provide some code coverage on the server side while maintaining as\n180\t* little state as possible.\n181\t* TODO: add debug_break on error condition.\n182\t*/\n183\t\n184\tstatic int stress_server_callback(picoquic_cnx_t* cnx,\n185\t    uint64_t stream_id, uint8_t* bytes, size_t length,\n186\t    picoquic_call_back_event_t fin_or_event, void* callback_ctx, void* UNUSED(v_stream_ctx))\n187\t{\n188\t    int ret = 0;\n189\t    picoquic_stress_server_callback_ctx_t* stress_ctx = (picoquic_stress_server_callback_ctx_t*)callback_ctx;\n190\t\n191\t    if (fin_or_event == pico