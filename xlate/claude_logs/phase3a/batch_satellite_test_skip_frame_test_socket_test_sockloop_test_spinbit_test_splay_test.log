    let r = test_uniform_random(&mut ctx, uniform_ranges[j]);","+            assert_eq!(","+                r, expected,","+                \"case {i}, seed {:#x}, uniform({}) = {r}, expected {expected}\",","+                uniform_ranges[j],","+            );","+        }","+    }"," }"," "," /// C: `random_gauss_test` in `picoquictest/stresstest.c`.","+///","+/// Verifies that the Gaussian generator has mean ≈ 0 and variance ≈ 1","+/// over 255 samples."," #[test]"," fn random_gauss() {","-    todo!(\"random_gauss_test\")","-}","+    const NB_TESTS: usize = 255;","+    let mut t_seed: u64 = 0xDEADBEEFBABAC001u64;","+    let mut x_sum: f64 = 0.0;","+    let mut x2: f64 = 0.0;"," ","-/// C: `random_tester_test` in `picoquictest/stresstest.c`.","-#[test]","-fn random_tester() {","-    todo!(\"random_tester_test\")","+    for _ in 0..NB_TESTS {","+        let x = test_gauss_random(&mut t_seed);","+        x_sum += x;","+        x2 += x * x;","+    }","+","+    let mean = x_sum / NB_TESTS as f64;","+    let var = x2 / NB_TESTS as f64;","+","+    assert!(","+        (-0.02..=0.02).contains(&mean),","+        \"Gaussian mean {mean} out of range [-0.02, 0.02]\"","+    );","+    assert!(","+        (0.97..=1.03).contains(&var),","+        \"Gaussian variance {var} out of range [0.97, 1.03]\"","+    );"," }"," "," /// C: `stress_test` in `picoquictest/stresstest.c`."," #[test]"," fn stress() {","-    todo!(\"stress_test\")","+    let duration: u64 = 60_000_000; // 1 minute","+    let wall_time_max: u64 = 10 * duration;","+    stress_or_fuzz_test(duration, wall_time_max).expect(\"stress_test\");"," }","+","+/// C: `fuzz_test` in `picoquictest/stresstest.c`.","+#[test]","+fn fuzz() {","+    let duration: u64 = 60_000_000;","+    stress_or_fuzz_test(duration, duration).expect(\"fuzz_test\");","+}","+","+/// C: `fuzz_initial_test` in `picoquictest/stresstest.c`.","+#[test]","+fn fuzz_initial() {","+    let duration: u64 = 60_000_000;","+    stress_or_fuzz_test(2 * duration, 4 * duration).expect(\"fuzz_initial_test\");","+}"]}],"originalFile":"//! Test cases for `picoquictest/stresstest*.c` (auto-stubbed).\n//!\n//! Generated by `scripts/phase3.py` from\n//! `picoquic_t/picoquic_t.c`'s `test_table[]`.  Each stub\n//! corresponds to one C test entry; bodies are `todo!()`\n//! until the body-translation pass lands.\n\n#![allow(non_snake_case)]\n\n/// C: `fuzz_test` in `picoquictest/stresstest.c`.\n#[test]\nfn fuzz() {\n    todo!(\"fuzz_test\")\n}\n\n/// C: `fuzz_initial_test` in `picoquictest/stresstest.c`.\n#[test]\nfn fuzz_initial() {\n    todo!(\"fuzz_initial_test\")\n}\n\n/// C: `random_gauss_test` in `picoquictest/stresstest.c`.\n#[test]\nfn random_gauss() {\n    todo!(\"random_gauss_test\")\n}\n\n/// C: `random_tester_test` in `picoquictest/stresstest.c`.\n#[test]\nfn random_tester() {\n    todo!(\"random_tester_test\")\n}\n\n/// C: `stress_test` in `picoquictest/stresstest.c`.\n#[test]\nfn stress() {\n    todo!(\"stress_test\")\n}\n","userModified":false}}
