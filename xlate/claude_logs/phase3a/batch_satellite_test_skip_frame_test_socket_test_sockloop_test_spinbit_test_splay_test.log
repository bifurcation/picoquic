{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01AgG5ZQSuwcPtSRKyiduWBR","type":"tool_result","content":"1\t/*\n2\t* Author: Christian Huitema\n3\t* Copyright (c) 2017, Private Octopus, Inc.\n4\t* All rights reserved.\n5\t*\n6\t* Permission to use, copy, modify, and distribute this software for any\n7\t* purpose with or without fee is hereby granted, provided that the above\n8\t* copyright notice and this permission notice appear in all copies.\n9\t*\n10\t* THIS SOFTWARE IS PROVIDED BY THE COPYRIGHT HOLDERS AND CONTRIBUTORS \"AS IS\" AND\n11\t* ANY EXPRESS OR IMPLIED WARRANTIES, INCLUDING, BUT NOT LIMITED TO, THE IMPLIED\n12\t* WARRANTIES OF MERCHANTABILITY AND FITNESS FOR A PARTICULAR PURPOSE ARE\n13\t* DISCLAIMED. IN NO EVENT SHALL Private Octopus, Inc. BE LIABLE FOR ANY\n14\t* DIRECT, INDIRECT, INCIDENTAL, SPECIAL, EXEMPLARY, OR CONSEQUENTIAL DAMAGES\n15\t* (INCLUDING, BUT NOT LIMITED TO, PROCUREMENT OF SUBSTITUTE GOODS OR SERVICES;\n16\t* LOSS OF USE, DATA, OR PROFITS; OR BUSINESS INTERRUPTION) HOWEVER CAUSED AND\n17\t* ON ANY THEORY OF LIABILITY, WHETHER IN CONTRACT, STRICT LIABILITY, OR TORT\n18\t* (INCLUDING NEGLIGENCE OR OTHERWISE) ARISING IN ANY WAY OUT OF THE USE OF THIS\n19\t* SOFTWARE, EVEN IF ADVISED OF THE POSSIBILITY OF SUCH DAMAGE.\n20\t*/\n21\t\n22\t#include \"tls_api.h\"\n23\t#include \"picoquic_internal.h\"\n24\t#include \"picoquictest_internal.h\"\n25\t#include \"picoquic.h\"\n26\t#include <stdlib.h>\n27\t#include <string.h>\n28\t\n29\t#include \"logreader.h\"\n30\t#include \"picoquic_binlog.h\"\n31\t#include \"picoquic_logger.h\"\n32\t#include \"qlog.h\"\n33\t\n34\t\n35\t/*\n36\t * Spin bit test. Verify that the bit does spin, and that the number\n37\t * of rotations is plausible given the duration and the min delay\n38\t * for various the spin policies.\n39\t */\n40\t\n41\tstatic test_api_stream_desc_t test_scenario_spin[] = {\n42\t    { 4, 0, 257, 1000000 }\n43\t};\n44\t\n45\tint spinbit_test_one(picoquic_spinbit_version_enum spin_policy, picoquic_spinbit_version_enum spin_policy_server)\n46\t{\n47\t    uint64_t simulated_time = 0;\n48\t    uint64_t loss_mask = 0;\n49\t    uint64_t spin_duration = 0;\n50\t    picoquic_test_tls_api_ctx_t* test_ctx = NULL;\n51\t    int spin_count = 0;\n52\t    int ret = tls_api_init_ctx(&test_ctx, PICOQUIC_INTERNAL_TEST_VERSION_1,\n53\t        PICOQUIC_TEST_SNI, PICOQUIC_TEST_ALPN, &simulated_time, NULL, NULL, 0, 1, 0);\n54\t\n55\t    if (ret != 0)\n56\t    {\n57\t        DBG_PRINTF(\"%s\", \"Could not create the QUIC test contexts\\n\");\n58\t    }\n59\t\n60\t    if (ret == 0) {\n61\t        /* force spinbit policy as specified, then start */\n62\t        if (picoquic_set_default_spinbit_policy(test_ctx->qserver, spin_policy_server) != 0 ||\n63\t            picoquic_set_spinbit_policy(test_ctx->cnx_client, spin_policy) != 0)\n64\t        {\n65\t            DBG_PRINTF(\"Invalid policies: %d, %d\\n\", spin_policy_server, spin_policy);\n66\t            ret = -1;\n67\t        }\n68\t    }\n69\t    if (ret == 0) {\n70\t        ret = picoquic_start_client_cnx(test_ctx->cnx_client);\n71\t        if (ret != 0)\n72\t        {\n73\t            DBG_PRINTF(\"%s\", \"Could not initialize stream zero for the client\\n\");\n74\t        }\n75\t    }\n76\t\n77\t    if (ret == 0) {\n78\t        ret = tls_api_connection_loop(test_ctx, &loss_mask, 0, &simulated_time);\n79\t\n80\t        if (ret != 0)\n81\t        {\n82\t            DBG_PRINTF(\"Connection loop returns error %d\\n\", ret);\n83\t        }\n84\t    }\n85\t\n86\t    /* Prepare to send data */\n87\t    if (ret == 0) {\n88\t        ret = test_api_init_send_recv_scenario(test_ctx, test_scenario_spin, sizeof(test_scenario_spin));\n89\t\n90\t        if (ret != 0)\n91\t        {\n92\t            DBG_PRINTF(\"Init send receive scenario returns %d\\n\", ret);\n93\t        }\n94\t    }\n95\t\n96\t    /* Explore the data sending loop so we can observe the spin bit  */\n97\t    if (ret == 0) {\n98\t        uint64_t spin_begin_time = simulated_time;\n99\t        uint64_t next_time = simulated_time + 10000000;\n100\t        int ret = 0;\n101\t        int nb_trials = 0;\n102\t        int nb_inactive = 0;\n103\t        int max_trials = 100000;\n104\t        int current_spin = test_ctx->cnx_client->path[0]->current_spin;\n105\t\n106\t        test_ctx->c_to_s_link->loss_mask = &loss_mask;\n107\t        test_ctx->s_to_c_link->loss_mask = &loss_mask;\n108\t\n109\t        while (ret == 0 && nb_trials < max_trials && simulated_time < next_time && nb_inactive < 256 && TEST_CLIENT_READY && TEST_SERVER_READY) {\n110\t            int was_active = 0;\n111\t\n112\t            nb_trials++;\n113\t\n114\t            ret = tls_api_one_sim_round(test_ctx, &simulated_time, next_time, &was_active);\n115\t\n116\t            if (ret < 0)\n117\t            {\n118\t                break;\n119\t            }\n120\t\n121\t            if (test_ctx->cnx_client->path[0]->current_spin != current_spin) {\n122\t                spin_count++;\n123\t                current_spin = test_ctx->cnx_client->path[0]->current_spin;\n124\t            }\n125\t\n126\t            if (was_active) {\n127\t                nb_inactive = 0;\n128\t            }\n129\t            else {\n130\t                nb_inactive++;\n131\t            }\n132\t\n133\t            if (test_ctx->test_finished) {\n134\t                if (picoquic_is_cnx_backlog_empty(test_ctx->cnx_client) && picoquic_is_cnx_backlog_empty(test_ctx->cnx_server)) {\n135\t                    break;\n136\t                }\n137\t            }\n138\t        }\n139\t\n140\t        spin_duration = simulated_time - spin_begin_time;\n141\t\n142\t        if (ret != 0)\n143\t        {\n144\t            DBG_PRINTF(\"Data sending loop fails with ret = %d\\n\", ret);\n145\t        }\n146\t    }\n147\t\n148\t    if (ret == 0) {\n149\t        ret = picoquic_close(test_ctx->cnx_client, 0);\n150\t        if (ret != 0)\n151\t        {\n152\t            DBG_PRINTF(\"Picoquic close returns %d\\n\", ret);\n153\t        }\n154\t    }\n155\t\n156\t    if (ret == 0) {\n157\t        if (spin_policy == picoquic_spinbit_basic) {\n158\t            if (spin_policy_server == picoquic_spinbit_on) {\n159\t                if (spin_count < 6) {\n160\t                    DBG_PRINTF(\"Unplausible spin bit: %d rotations, rtt_min = %d, duration = %d\\n\",\n161\t                        spin_count, (int)test_ctx->cnx_client->path[0]->rtt_min, (int)spin_duration);\n162\t                    ret = -1;\n163\t                }\n164\t            }\n165\t            else if (spin_policy_server == picoquic_spinbit_random) {\n166\t                if (spin_count < 100) {\n167\t                    DBG_PRINTF(\"Unplausible spin bit: %d rotations, rtt_min = %d, duration = %d\\n\",\n168\t                        spin_count, (int)test_ctx->cnx_client->path[0]->rtt_min, (int)spin_duration);\n169\t                    ret = -1;\n170\t                }\n171\t            }\n172\t            else if (spin_policy_server == picoquic_spinbit_null) {\n173\t                if (spin_count >  0) {\n174\t                    DBG_PRINTF(\"Unplausible spin bit: %d rotations, rtt_min = %d, duration = %d\\n\",\n175\t                        spin_count, (int)test_ctx->cnx_client->path[0]->rtt_min, (int)spin_duration);\n176\t                    ret = -1;\n177\t                }\n178\t            }\n179\t        }\n180\t    }\n181\t\n182\t    if (test_ctx != NULL) {\n183\t        tls_api_delete_ctx(test_ctx);\n184\t        test_ctx = NULL;\n185\t    }\n186\t\n187\t    return ret;\n188\t}\n189\t\n190\tint spinbit_test(void)\n191\t{\n192\t    return spinbit_test_one(picoquic_spinbit_basic, picoquic_spinbit_on);\n193\t}\n194\t\n195\tint spinbit_random_test(void)\n196\t{\n197\t    return spinbit_test_one(picoquic_spinbit_basic, picoquic_spinbit_random);\n198\t}\n199\t\n200\tint spinbit_randclient_test(void)\n201\t{\n202\t    return spinbit_test_one(picoquic_spinbit_random, picoquic_spinbit_basic);\n203\t}\n204\t\n205\tint spinbit_null_test(void)\n206\t{\n207\t    return spinbit_test_one(picoquic_spinbit_basic, picoquic_spinbit_null);\n208\t}\n209\t\n210\tint spinbit_bad_test(void)\n211\t{\n212\t    int ret = 0;\n213\t    if (spinbit_test_one(picoquic_spinbit_on, 123456) == 0 ||\n214\t        spinbit_test_one(123455, picoquic_spinbit_null) == 0) {\n215\t        ret = -1;\n216\t    }\n217\t    return ret;\n218\t}\n219\t\n220\t\n221\t"}]},"parent_tool_use_id":null,"session_id":"cb85c5eb-b826-43b9-84a4-4be9b46756f2","uuid":"10adc351-d754-4d6a-9ca1-4e76c01c2570","timestamp":"2026-05-05T11:51:05.598Z","tool_use_result":{"type":"text","file":{"filePath":"/Users/richbarn/Projects/picoquic/picoquictest/spinbit_test.c","content":"/*\n* Author: Christian Huitema\n* Copyright (c) 2017, Private Octopus, Inc.\n* All rights reserved.\n*\n* Permission to use, copy, modify, and distribute this software for any\n* purpose with or without fee is hereby granted, provided that the above\n* copyright notice and this permission notice appear in all copies.\n*\n* THIS SOFTWARE IS PROVIDED BY THE COPYRIGHT HOLDERS AND CONTRIBUTORS \"AS IS\" AND\n* ANY EXPRESS OR IMPLIED WARRANTIES, INCLUDING, BUT NOT LIMITED TO, THE IMPLIED\n* WARRANTIES OF MERCHANTABILITY AND FITNESS FOR A PARTICULAR PURPOSE ARE\n* DISCLAIMED. IN NO EVENT SHALL Private Octopus, Inc. BE LIABLE FOR ANY\n* DIRECT, INDIRECT, INCIDENTAL, SPECIAL, EXEMPLARY, OR CONSEQUENTIAL DAMAGES\n* (INCLUDING, BUT NOT LIMITED TO, PROCUREMENT OF SUBSTITUTE GOODS OR SERVICES;\n* LOSS OF USE, DATA, OR PROFITS; OR BUSINESS INTERRUPTION) HOWEVER CAUSED AND\n* ON ANY THEORY OF LIABILITY, WHETHER IN CONTRACT, STRICT LIABILITY, OR TORT\n* (INCLUDING NEGLIGENCE OR OTHERWISE) ARISING IN ANY WAY OUT OF THE USE OF THIS\n* SOFTWARE, EVEN IF ADVISED OF THE POSSIBILITY OF SUCH DAMAGE.\n*/\n\n#include \"tls_api.h\"\n#include \"picoquic_internal.h\"\n#include \"picoquictest_internal.h\"\n#include \"picoquic.h\"\n#include <stdlib.h>\n#include <string.h>\n\n#include \"logreader.h\"\n#include \"picoquic_binlog.h\"\n#include \"picoquic_logger.h\"\n#include \"qlog.h\"\n\n\n/*\n * Spin bit test. Verify that the bit does spin, and that the number\n * of rotations is plausible given the duration and the min delay\n * for various the spin policies.\n */\n\nstatic test_api_stream_desc_t test_scenario_spin[] = {\n    { 4, 0, 257, 1000000 }\n};\n\nint spinbit_test_one(picoquic_spinbit_version_enum spin_policy, picoquic_spinbit_version_enum spin_policy_server)\n{\n    uint64_t simulated_time = 0;\n    uint64_t loss_mask = 0;\n    uint64_t spin_duration = 0;\n    picoquic_test_tls_api_ctx_t* test_ctx = NULL;\n    int spin_count = 0;\n    int ret = tls_api_init_ctx(&test_ctx, PICOQUIC_INTERNAL_TEST_VERSION_1,\n        PICOQUIC_TEST_SNI, PICOQUIC_TEST_ALPN, &simulated_time, NULL, NULL, 0, 1, 0);\n\n    if (ret != 0)\n    {\n        DBG_PRINTF(\"%s\", \"Could not create the QUIC test contexts\\n\");\n    }\n\n    if (ret == 0) {\n        /* force spinbit policy as specified, then start */\n        if (picoquic_set_default_spinbit_policy(test_ctx->qserver, spin_policy_server) != 0 ||\n            picoquic_set_spinbit_policy(test_ctx->cnx_client, spin_policy) != 0)\n        {\n            DBG_PRINTF(\"Invalid policies: %d, %d\\n\", spin_policy_server, spin_policy);\n            ret = -1;\n        }\n    }\n    if (ret == 0) {\n        ret = picoquic_start_client_cnx(test_ctx->cnx_client);\n        if (ret != 0)\n        {\n            DBG_PRINTF(\"%s\", \"Could not initialize stream zero for the client\\n\");\n        }\n    }\n\n    if (ret == 0) {\n        ret = tls_api_connection_loop(test_ctx, &loss_mask, 0, &simulated_time);\n\n        if (ret != 0)\n        {\n            DBG_PRINTF(\"Connection loop returns error %d\\n\", ret);\n        }\n    }\n\n    /* Prepare to send data */\n    if (ret == 0) {\n        ret = test_api_init_send_recv_scenario(test_ctx, test_scenario_spin, sizeof(test_scenario_spin));\n\n        if (ret != 0)\n        {\n            DBG_PRINTF(\"Init send receive scenario returns %d\\n\", ret);\n        }\n    }\n\n    /* Explore the data sending loop so we can observe the spin bit  */\n    if (ret == 0) {\n        uint64_t spin_begin_time = simulated_time;\n        uint64_t next_time = simulated_time + 10000000;\n        int ret = 0;\n        int nb_trials = 0;\n        int nb_inactive = 0;\n        int max_trials = 100000;\n        int current_spin = test_ctx->cnx_client->path[0]->current_spin;\n\n        test_ctx->c_to_s_link->loss_mask = &loss_mask;\n        test_ctx->s_to_c_link->loss_mask = &loss_mask;\n\n        while (ret == 0 && nb_trials < max_trials && simulated_time < next_time && nb_inactive < 256 && TEST_CLIENT_READY && TEST_SERVER_READY) {\n            int was_active = 0;\n\n            nb_trials++;\n\n            ret = tls_api_one_sim_round(test_ctx, &simulated_time, next_time, &was_active);\n\n            if (ret < 0)\n            {\n                break;\n            }\n\n            if (test_ctx->cnx_client->path[0]->current_spin != current_spin) {\n                spin_count++;\n                current_spin = test_ctx->cnx_client->path[0]->current_spin;\n            }\n\n            if (was_active) {\n                nb_inactive = 0;\n            }\n            else {\n                nb_inactive++;\n            }\n\n            if (test_ctx->test_finished) {\n                if (picoquic_is_cnx_backlog_empty(test_ctx->cnx_client) && picoquic_is_cnx_backlog_empty(test_ctx->cnx_server)) {\n                    break;\n                }\n            }\n        }\n\n        spin_duration = simulated_time - spin_begin_time;\n\n        if (ret != 0)\n        {\n            DBG_PRINTF(\"Data sending loop fails with ret = %d\\n\", ret);\n        }\n    }\n\n    if (ret == 0) {\n        ret = picoquic_close(test_ctx->cnx_client, 0);\n        if (ret != 0)\n        {\n            DBG_PRINTF(\"Picoquic close returns %d\\n\", ret);\n        }\n    }\n\n    if (ret == 0) {\n        if (spin_policy == picoquic_spinbit_basic) {\n            if (spin_policy_server == picoquic_spinbit_on) {\n                if (spin_count < 6) {\n                    DBG_PRINTF(\"Unplausible spin bit: %d rotations, rtt_min = %d, duration = %d\\n\",\n                        spin_count, (int)test_ctx->cnx_client->path[0]->rtt_min, (int)spin_duration);\n                    ret = -1;\n                }\n            }\n            else if (spin_policy_server == picoquic_spinbit_random) {\n                if (spin_count < 100) {\n                    DBG_PRINTF(\"Unplausible spin bit: %d rotations, rtt_min = %d, duration = %d\\n\",\n                        spin_count, (int)test_ctx->cnx_client->path[0]->rtt_min, (int)spin_duration);\n                    ret = -1;\n                }\n            }\n            else if (spin_policy_server == picoquic_spinbit_null) {\n                if (spin_count >  0) {\n                    DBG_PRINTF(\"Unplausible spin bit: %d rotations, rtt_min = %d, duration = %d\\n\",\n                        spin_count, (int)test_ctx->cnx_client->path[0]->rtt_min, (int)spin_duration);\n                    ret = -1;\n                }\n            }\n        }\n    }\n\n    if (test_ctx != NULL) {\n        tls_api_delete_ctx(test_ctx);\n        test_ctx = NULL;\n    }\n\n    return ret;\n}\n\nint spinbit_test(void)\n{\n    return spinbit_test_one(picoquic_spinbit_basic, picoquic_spinbit_on);\n}\n\nint spinbit_random_test(void)\n{\n    return spinbit_test_one(picoquic_spinbit_basic, picoquic_spinbit_random);\n}\n\nint spinbit_randclient_test(void)\n{\n    return spinbit_test_one(picoquic_spinbit_random, picoquic_spinbit_basic);\n}\n\nint spinbit_null_test(void)\n{\n    return spinbit_test_one(picoquic_spinbit_basic, picoquic_spinbit_null);\n}\n\nint spinbit_bad_test(void)\n{\n    int ret = 0;\n    if (spinbit_test_one(picoquic_spinbit_on, 123456) == 0 ||\n        spinbit_test_one(123455, picoquic_spinbit_null) == 0) {\n        ret = -1;\n    }\n    return ret;\n}\n\n\n","numLines":221,"startLine":1,"totalLines":221}}}
