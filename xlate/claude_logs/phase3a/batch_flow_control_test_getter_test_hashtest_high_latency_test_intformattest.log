   }\n158\t    }\n159\t\n160\t    return ret;\n161\t}\n162\t\n163\ttypedef struct st_picoquic_varintformat_test_t {\n164\t    uint8_t encoding[8];\n165\t    size_t length;\n166\t    uint64_t decoded;\n167\t    int is_canonical;\n168\t} picoquic_varintformat_test_t;\n169\t\n170\tstatic picoquic_varintformat_test_t varint_test_cases[] = {\n171\t    { { 0, 0xCC, 0xCC, 0xCC, 0xCC, 0xCC, 0xCC, 0xCC },\n172\t        1,\n173\t        0,\n174\t        1 },\n175\t    { { 1, 0xCC, 0xCC, 0xCC, 0xCC, 0xCC, 0xCC, 0xCC },\n176\t        1,\n177\t        1,\n178\t        1 },\n179\t    { { 63, 0xCC, 0xCC, 0xCC, 0xCC, 0xCC, 0xCC, 0xCC },\n180\t        1,\n181\t        63,\n182\t        1 },\n183\t    { { 0x40, 64, 0xCC, 0xCC, 0xCC, 0xCC, 0xCC, 0xCC },\n184\t        2,\n185\t        64,\n186\t        1 },\n187\t    { { 0x7F, 0xFF, 0xCC, 0xCC, 0xCC, 0xCC, 0xCC, 0xCC },\n188\t        2,\n189\t        0x3FFF,\n190\t        1 },\n191\t    { { 0x80, 0, 0x40, 0, 0xCC, 0xCC, 0xCC, 0xCC },\n192\t        4,\n193\t        0x4000,\n194\t        1 },\n195\t    { { 0xBF, 0xFF, 0xFF, 0xFF, 0xCC, 0xCC, 0xCC, 0xCC },\n196\t        4,\n197\t        0x3FFFFFFF,\n198\t        1 },\n199\t    { { 0xC0, 0, 0, 0, 0x40, 0, 0, 0 },\n200\t        8,\n201\t        0x40000000,\n202\t        1 },\n203\t    { { 0xFF, 0xFF, 0xFF, 0xFF, 0xFF, 0xFF, 0xFF, 0xFF },\n204\t        8,\n205\t        0x3FFFFFFFFFFFFFFFull,\n206\t        1 },\n207\t    /* For example, the eight octet sequence c2 19 7c 5e ff 14 e8 8c (in hexadecimal) \n208\t     * decodes to the decimal value 151288809941952652; \n209\t     * the four octet sequence 9d 7f 3e 7d decodes to 494878333; \n210\t     * the two octet sequence 7b bd decodes to 15293; \n211\t     * and the single octet 25 decodes to 37 (as does the two octet sequence 40 25). */\n212\t    {\n213\t        { 0xc2, 0x19, 0x7c, 0x5e, 0xff, 0x14, 0xe8, 0x8c },\n214\t        8,\n215\t        151288809941952652ull,\n216\t        1 },\n217\t    { { 0x9d, 0x7f, 0x3e, 0x7d, 0xff, 0x14, 0xe8, 0x8c },\n218\t        4,\n219\t        494878333,\n220\t        1 },\n221\t    { { 0xC0, 0, 0, 0, 0x1d, 0x7f, 0x3e, 0x7d },\n222\t        8,\n223\t        494878333,\n224\t        0 },\n225\t    { { 0x7b, 0xbd, 0x3e, 0x7d, 0xff, 0x14, 0xe8, 0x8c },\n226\t        2,\n227\t        15293,\n228\t        1 },\n229\t    { { 0x80, 0, 0x3b, 0xbd, 0x3e, 0x7d, 0xff, 0x14 },\n230\t        4,\n231\t        15293,\n232\t        0 },\n233\t    { { 0xC0, 0, 0, 0, 0, 0, 0x3b, 0xbd },\n234\t        8,\n235\t        15293,\n236\t        0 },\n237\t    { { 0x25, 0xbd, 0x3e, 0x7d, 0xff, 0x14, 0xe8, 0x8c },\n238\t        1,\n239\t        37,\n240\t        1 },\n241\t    { { 0x40, 0x25, 0xbd, 0x3e, 0x7d, 0xff, 0x14, 0xe8 },\n242\t        2,\n243\t        37,\n244\t        0 }\n245\t};\n246\t\n247\tstatic size_t nb_varint_test_cases = sizeof(varint_test_cases) / sizeof(picoquic_varintformat_test_t);\n248\t\n249\tint varint_test(void)\n250\t{\n251\t    int ret = 0;\n252\t    uint8_t test_buf[16];\n253\t    const picoquic_varintformat_test_t* max_test = varint_test_cases + nb_varint_test_cases;\n254\t    memset(test_buf, 0xcc, 16);\n255\t\n256\t    for (picoquic_varintformat_test_t* test = varint_test_cases; ret == 0 && test < max_test; test++) {\n257\t        for (int is_new_decode = 0; ret == 0 && is_new_decode <= 1; is_new_decode++) {\n258\t            for (size_t buf_size = 0; ret == 0 && buf_size <= test->length + 2 && buf_size < 16; buf_size++) {\n259\t                int test_ret = 0;\n260\t                uint64_t n64 = 0;\n261\t                size_t length;\n262\t\n263\t                memcpy(test_buf, test->encoding, test->length);\n264\t\n265\t                if (is_new_decode) {\n266\t                    const uint8_t* bytes = picoquic_frames_varint_decode(test_buf, test_buf + buf_size, &n64);\n267\t                    length = bytes != NULL ? bytes - test_buf : 0;\n268\t                }\n269\t                else {\n270\t                    length = picoquic_varint_decode(test_buf, buf_size, &n64);\n271\t                }\n272\t\n273\t                if (length != (buf_size < test->length ? 0 : test->length)) {\n274\t                    DBG_PRINTF(\"Varint: unexpected length %u\", (unsigned)length);\n275\t                    test_ret = -1;\n276\t                }\n277\t                else if (length == 0) {\n278\t                    continue;\n279\t                }\n280\t                else if (n64 != test->decoded) {\n281\t                    DBG_PRINTF(\"Varint: unexpected value %llu [expected %llu]\",\n282\t                        (unsigned long long)n64, (unsigned long long)test->decoded);\n283\t                    test_ret = -1;\n284\t                }\n285\t\n286\t                if (test_ret != 0) {\n287\t                    DBG_PRINTF(\" (is_new=%d, test=%u, buf_size=%u/%u)\\n\",\n288\t                        is_new_decode, (unsigned)(max_test - test), (unsigned)buf_size, (unsigned)test->length);\n289\t                    ret = -1;\n290\t                }\n291\t            }\n292\t        }\n293\t\n294\t        for (int is_new_encode = 0; ret == 0 && is_new_encode <= 1; is_new_encode++) {\n295\t            if (test->is_canonical != 0) {\n296\t                uint8_t encoding[8];\n297\t                size_t coded_length = 0;\n298\t\n299\t                if (is_new_encode) {\n300\t                    uint8_t *bytes = picoquic_frames_varint_encode(encoding, &encoding[0] + sizeof(encoding), test->decoded);\n301\t                    if (bytes == NULL) {\n302\t                        coded_length = SIZE_MAX;\n303\t                    }\n304\t                    else {\n305\t                        coded_length = bytes - encoding;\n306\t                    }\n307\t                }\n308\t                else {\n309\t                    coded_length = picoquic_varint_encode(encoding, test->length, test->decoded);\n310\t                }\n311\t\n312\t                if (coded_length != test->length) {\n313\t                    DBG_PRINTF(\"Varint, is_new=%d: unexpected coded_length=%\"PRIst, is_new_encode, coded_length);\n314\t                    ret = -1;\n315\t                }\n316\t                else if (coded_length > sizeof(encoding)) {\n317\t                    DBG_PRINTF(\"Unexpected coded_length=%\"PRIst\", > sizeof(buffer)\", coded_length);\n318\t                    ret = -1;\n319\t                }\n320\t                else if (memcmp(encoding, test->encoding, coded_length) != 0) {\n321\t                    DBG_PRINTF(\"Varint, is_new=%d: unexpected coded value\", is_new_encode);\n322\t                    ret = -1;\n323\t                }\n324\t            }\n325\t        }\n326\t    }\n327\t\n328\t    if (ret == 0) {\n329\t        /* test the length prediction */\n330\t        size_t picoquic_frames_varint_encode_length(uint64_t n64);\n331\t\n332\t        for (picoquic_varintformat_test_t* test = varint_test_cases; ret == 0 && test < max_test; test++) {\n333\t            if (test->is_canonical) {\n334\t                size_t predicted_length = picoquic_frames_varint_encode_length(test->decoded);\n335\t                if (predicted_length != test->length) {\n336\t                    ret = -1;\n337\t                }\n338\t            }\n339\t        }\n340\t    }\n341\t \n342\t    return ret;\n343\t}\n344\t\n345\t/* Simple implementation of SQRT using UINT64, so we do not have to link \n346\t * the math library\n347\t */\n348\t\n349\tuint64_t picoquic_sqrt_for_tests(uint64_t y)\n350\t{\n351\t    const uint64_t sqrt_6[16] = { 0, 1, 1, 1, 2, 2 };\n352\t    uint64_t x = 0;\n353\t    if (y < 6) {\n354\t        x = sqrt_6[y];\n355\t    }\n356\t    else {\n357\t        uint64_t x_min = 2;\n358\t        uint64_t x_max = ((y / 2) > 0xffffffff) ? 0xffffffff : y / 2;\n359\t\n360\t        for (int i = 0; i < 64; i++) {\n361\t            uint64_t x2;\n362\t            x = (x_min + x_max) / 2;\n363\t            if (x_min + 1 >= x_max) {\n364\t                break;\n365\t            }\n366\t            x2 = x * x;\n367\t            if (x2 < y) {\n368\t                x_min = x;\n369\t            }\n370\t            else if (x2 > y) {\n371\t                x_max = x;\n372\t            }\n373\t            else\n374\t            {\n375\t                x_min = x;\n376\t                x_max = x;\n377\t                break;\n378\t            }\n379\t        }\n380\t    }\n381\t    return x;\n382\t}\n383\t\n384\tint sqrt_for_test_test(void)\n385\t{\n386\t    int ret = 0;\n387\t    uint64_t x_base = 0;\n388\t\n389\t    while (x_base < 0xffffffff && ret == 0) {\n390\t        for (uint64_t i = 0; i < 2; i++) {\n391\t            uint64_t y = x_base * (x_base+i);\n392\t            uint64_t x = picoquic_sqrt_for_tests(y);\n393\t            if (x != x_base) {\n394\t                ret = -1;\n395\t                break;\n396\t            }\n397\t        }\n398\t        x_base = 2 * x_base + 1;\n399\t    }\n400\t    return ret;\n401\t}\n402\t"}]},"parent_tool_use_id":null,"session_id":"483d188f-86bb-48b4-b530-27cbba01828e","uuid":"7ea5571a-f66c-40d8-a4a7-801295bfb947","timestamp":"2026-05-05T03:32:15.174Z","tool_use_result":{"type":"text","file":{"filePath":"/Users/richbarn/Projects/picoquic/picoquictest/intformattest.c","content":"/*\n* Author: Christian Huitema\n* Copyright (c) 2017, Private Octopus, Inc.\n* All rights reserved.\n*\n* Permission to use, copy, modify, and distribute this software for any\n* purpose with or without fee is hereby granted, provided that the above\n* copyright notice and this permission notice appear in all copies.\n*\n* THIS SOFTWARE IS PROVIDED BY THE COPYRIGHT HOLDERS AND CONTRIBUTORS \"AS IS\" AND\n* ANY EXPRESS OR IMPLIED WARRANTIES, INCLUDING, BUT NOT LIMITED TO, THE IMPLIED\n* WARRANTIES OF MERCHANTABILITY AND FITNESS FOR A PARTICULAR PURPOSE ARE\n* DISCLAIMED. IN NO EVENT SHALL Private Octopus, Inc. BE LIABLE FOR ANY\n* DIRECT, INDIRECT, INCIDENTAL, SPECIAL, EXEMPLARY, OR CONSEQUENTIAL DAMAGES\n* (INCLUDING, BUT NOT LIMITED TO, PROCUREMENT OF SUBSTITUTE GOODS OR SERVICES;\n* LOSS OF USE, DATA, OR PROFITS; OR BUSINESS INTERRUPTION) HOWEVER CAUSED AND\n* ON ANY THEORY OF LIABILITY, WHETHER IN CONTRACT, STRICT LIABILITY, OR TORT\n* (INCLUDING NEGLIGENCE OR OTHERWISE) ARISING IN ANY WAY OUT OF THE USE OF THIS\n* SOFTWARE, EVEN IF ADVISED OF THE POSSIBILITY OF SUCH DAMAGE.\n*/\n\n#include \"picoquic_internal.h\"\n#include <string.h>\n\nstatic const uint64_t test_number[] = {\n    0,\n    1,\n    0xFFFFFFFFFFFFFFFFull,\n    0xDEADBEEFull,\n    0x12345678DEADBEEFull\n};\n\nstatic size_t nb_test_numbers = sizeof(test_number) / sizeof(const uint64_t);\n\nstatic uint64_t decode_number(uint8_t* bytes, size_t length)\n{\n    uint64_t n = 0;\n\n    for (size_t i = 0; i < length; i++) {\n        n <<= 8;\n\n        n += bytes[i];\n    }\n\n    return n;\n}\n\nint intformattest(void)\n{\n    /* Test the formating routines */\n    int ret = 0;\n    uint8_t bytes[8];\n    uint64_t decoded;\n    uint64_t parsed;\n    uint32_t test32;\n    uint32_t test24;\n    uint16_t test16;\n    uint64_t test64;\n\n    for (int new_encoding = 0; new_encoding < 2; new_encoding++) {\n        /* First test with 16 bits macros */\n        for (size_t i = 0; ret == 0 && i < nb_test_numbers; i++) {\n            test16 = (uint16_t)test_number[i];\n            if (new_encoding == 0) {\n                picoformat_16(bytes, test16);\n            }\n            else {\n                uint8_t* next_byte = picoquic_frames_uint16_encode(bytes, bytes + sizeof(bytes), test16);\n                if ((next_byte - bytes) != 2) {\n                    ret = -1;\n                }\n            }\n            decoded = decode_number(bytes, 2);\n            if (decoded != test16) {\n                ret = -1;\n            }\n            else {\n                parsed = PICOPARSE_16(bytes);\n                if (parsed != test16) {\n                    ret = -1;\n                }\n            }\n        }\n\n        /* Next test with 24 bits macros