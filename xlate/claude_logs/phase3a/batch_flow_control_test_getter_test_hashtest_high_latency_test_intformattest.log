{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_017G48Ne7qwuLugNZkHeqsmL","type":"tool_result","content":"80\t/// Full simulation state.  C: `cnx_stress_ctx_t`.\n81\tstruct CnxStressCtx {\n82\t    shared: Rc<RefCell<CnxStressShared>>,\n83\t    qserver: Box<Quic>,\n84\t    qclient: Box<Quic>,\n85\t    server_addr: SocketAddr,\n86\t    client_addr: SocketAddr,\n87\t    link_to_clients: Box<TestSimLink>,\n88\t    link_to_server: Box<TestSimLink>,\n89\t    client_creation_interval: u64,\n90\t    next_client_creation_time: u64,\n91\t    client_deletion_interval: u64,\n92\t    next_client_deletion_time: u64,\n93\t    message_creation_interval: u64,\n94\t    next_message_creation_time: u64,\n95\t    /// Initial source CIDs of client connections, indexed by rank.\n96\t    /// `None` means the slot is vacant (never filled or connection closed).\n97\t    client_connections: Vec<Option<ConnectionId>>,\n98\t    /// Same for server-side connections.\n99\t    server_connections: Vec<Option<ConnectionId>>,\n100\t}\n101\t\n102\timpl CnxStressCtx {\n103\t    fn simulated_time(&self) -> u64 {\n104\t        self.shared.borrow().simulated_time\n105\t    }\n106\t}\n107\t\n108\t// ---------------------------------------------------------------------------\n109\t// Connection callback.\n110\t\n111\t/// Per-connection callback context.  C: `cnx_stress_callback_ctx_t`.\n112\t///\n113\t/// `mode` values:\n114\t/// * `0` — client connection\n115\t/// * `1` — server connection (created after the default context fires)\n116\t/// * `2` — default server context (installed on `qserver`); on the first\n117\t///   non-close event it replaces itself with a mode-1 callback.\n118\tstruct CnxStressCallback {\n119\t    shared: Rc<RefCell<CnxStressShared>>,\n120\t    mode: i32,\n121\t    rank: usize,\n122\t    streams: Vec<CnxStressStreamCtx>,\n123\t}\n124\t\n125\timpl CnxStressCallback {\n126\t    fn find_stream_mut(&mut self, stream_id: u64) -> Option<&mut CnxStressStreamCtx> {\n127\t        self.streams.iter_mut().find(|s| s.stream_id == stream_id)\n128\t    }\n129\t\n130\t    fn create_stream(&mut self, stream_id: u64) -> &mut CnxStressStreamCtx {\n131\t        self.streams.push(CnxStressStreamCtx {\n132\t            stream_id,\n133\t            send_time: 0,\n134\t            nb_bytes_expected: 0,\n135\t            nb_bytes_received: 0,\n136\t            nb_bytes_sent: 0,\n137\t        });\n138\t        self.streams.last_mut().unwrap()\n139\t    }\n140\t\n141\t    fn delete_stream(&mut self, connection: &mut Connection, stream_id: u64) {\n142\t        connection.unlink_app_stream_ctx(stream_id);\n143\t        self.streams.retain(|s| s.stream_id != stream_id);\n144\t    }\n145\t\n146\t    /// Handle incoming stream data / FIN.\n147\t    /// C: `cnx_stress_callback_data`.\n148\t    fn handle_data(\n149\t        &mut self,\n150\t        connection: &mut Connection,\n151\t        stream_id: u64,\n152\t        bytes: &[u8],\n153\t        is_fin: bool,\n154\t    ) -> i32 {\n155\t        if self.find_stream_mut(stream_id).is_none() {\n156\t            let stream = self.create_stream(stream_id);\n157\t            stream.stream_id = stream_id;\n158\t            if connection.set_app_stream_ctx(stream_id, None).is_err() {\n159\t                return -1;\n160\t            }\n161\t        }\n162\t        let stream = self.find_stream_mut(stream_id).unwrap();\n163\t        let mut pos = 0usize;\n164\t        let buf = bytes;\n165\t        while pos < buf.len() && stream.nb_bytes_received < 8 {\n166\t            stream.send_time = (stream.send_time << 8) | buf[pos] as u64;\n167\t            pos += 1;\n168\t            stream.nb_bytes_received += 1;\n169\t        }\n170\t        while pos < buf.len() && stream.nb_bytes_received < 16 {\n171\t            stream.nb_bytes_expected = (stream.nb_bytes_expected << 8) | buf[pos] as u64;\n172\t            pos += 1;\n173\t            stream.nb_bytes_received += 1;\n174\t        }\n175\t        stream.nb_bytes_received += (buf.len() - pos) as u64;\n176\t\n177\t        if is_fin {\n178\t            let (recv, expected, send_time) = (\n179\t                stream.nb_bytes_received,\n180\t                stream.nb_bytes_expected,\n181\t                stream.send_time,\n182\t            );\n183\t            {\n184\t                let mut shared = self.shared.borrow_mut();\n185\t                if recv < 16 || recv < expected {\n186\t                    shared.nb_messages_errors += 1;\n187\t                } else {\n188\t                    let time_now = shared.simulated_time;\n189\t                    let delta_t = time_now as i64 - send_time as i64;\n190\t                    shared.nb_messages_received += 1;\n191\t                    shared.sum_message_delays += delta_t;\n192\t                    shared.sum_square_message_delays += (delta_t as f64) * (delta_t as f64);\n193\t                    if delta_t > shared.message_delay_max {\n194\t                        shared.message_delay_max = delta_t;\n195\t                    }\n196\t                    if delta_t < shared.message_delay_min {\n197\t                        shared.message_delay_min = delta_t;\n198\t                    }\n199\t                }\n200\t            }\n201\t            self.delete_stream(connection, stream_id);\n202\t        }\n203\t        0\n204\t    }\n205\t\n206\t    /// Called when the connection is closed (any flavour).\n207\t    /// C: `cnx_stress_callback_delete_context`.\n208\t    fn handle_close(&mut self, connection: &mut Connection) {\n209\t        {\n210\t            let mut shared = self.shared.borrow_mut();\n211\t            if self.mode == 0 {\n212\t                if shared.is_limit_test\n213\t                    && self.rank + 1 == shared.nb_client_target\n214\t                    && connection.state() == State::Disconnected\n215\t                    && connection.remote_error() == TransportError::ServerBusy as u64\n216\t                {\n217\t                    shared.limit_tes