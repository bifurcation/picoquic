0;\n44\t    picoquic_test_tls_api_ctx_t* test_ctx = NULL;\n45\t    picoquic_cnx_t* cnx = NULL;\n46\t    picoquic_cnx_t* cnx_s = NULL;\n47\t    picoquic_connection_id_t initial_cid = { {0x9e, 0x77, 0xe8, 0, 0, 0, 0, 0}, 8 };\n48\t    int ret = tls_api_init_ctx_ex2(&test_ctx, PICOQUIC_INTERNAL_TEST_VERSION_1, PICOQUIC_TEST_SNI, PICOQUIC_TEST_ALPN,\n49\t        &simulated_time, NULL, NULL,\n50\t        0, 1, 0, &initial_cid, 8, 0, 0, 0);\n51\t\n52\t    if (ret == 0) {\n53\t        if (picoquic_set_default_connection_id_length(test_ctx->qserver, (uint8_t)255) != PICOQUIC_ERROR_CNXID_CHECK ||\n54\t            picoquic_set_default_connection_id_length(test_ctx->qclient, (uint8_t)5) != PICOQUIC_ERROR_CANNOT_CHANGE_ACTIVE_CONTEXT) {\n55\t            ret = -1;\n56\t        }\n57\t    }\n58\t\n59\t    if (ret == 0) {\n60\t        if (picoquic_get_default_connection_id_ttl(test_ctx->qserver) != test_ctx->qserver->local_cnxid_ttl) {\n61\t            ret = -1;\n62\t        }\n63\t    }\n64\t\n65\t    if (ret == 0) {\n66\t        const picoquic_tp_t* tp = picoquic_get_default_tp(test_ctx->qserver);\n67\t        if (tp != &test_ctx->qserver->default_tp) {\n68\t            ret = -1;\n69\t        }\n70\t    }\n71\t\n72\t    if (ret == 0) {\n73\t        uint64_t old_max = test_ctx->qserver->cwin_max;\n74\t        picoquic_set_cwin_max(test_ctx->qserver, 0);\n75\t        if (test_ctx->qserver->cwin_max != UINT64_MAX) {\n76\t            ret = -1;\n77\t        }\n78\t        test_ctx->qserver->cwin_max = old_max;\n79\t    }\n80\t\n81\t    if (ret == 0) {\n82\t        int partial_match = 0;\n83\t        int path_id = picoquic_find_path_by_address(test_ctx->cnx_client, NULL,\n84\t            (struct sockaddr*)&test_ctx->cnx_client->path[0]->first_tuple->peer_addr, &partial_match);\n85\t        if (path_id != 0 || partial_match == 0) {\n86\t            ret = -1;\n87\t        }\n88\t    }\n89\t\n90\t    if (ret == 0) {\n91\t        ret = picoquic_set_local_addr(test_ctx->cnx_client, (struct sockaddr*) &test_ctx->client_addr);\n92\t        if (ret == 0 && picoquic_set_local_addr(test_ctx->cnx_client, (struct sockaddr*)&test_ctx->client_addr) == 0) {\n93\t            /* Second call should fail because the address is already set */\n94\t            ret = -1;\n95\t        }\n96\t        memset(&test_ctx->cnx_client->path[0]->first_tuple->local_addr, 0, sizeof(struct sockaddr_storage));\n97\t    }\n98\t\n99\t    if (ret == 0) {\n100\t        uint8_t mf[] = { picoquic_frame_type_max_streams_bidir, 0x41, 0 };\n101\t        cnx = test_ctx->cnx_client;\n102\t        if (picoquic_queue_misc_frame(cnx, mf, SIZE_MAX, 0, picoquic_packet_context_initial) == 0) {\n103\t            ret = -1;\n104\t        }\n105\t        else if (picoquic_queue_misc_frame(cnx, mf, sizeof(mf), 0, picoquic_packet_context_initial) != 0) {\n106\t            ret = -1;\n107\t        }\n108\t        else {\n109\t            picoquic_purge_misc_frames_after_ready(cnx);\n110\t            if (cnx->first_misc_frame != NULL) {\n111\t                ret = -1;\n112\t            }\n113\t        }\n114\t        if (ret == 0) {\n115\t            if (picoquic_queue_misc_frame(cnx, mf, sizeof(mf), 0, picoquic_packet_context_initial) != 0 ||\n116\t                picoquic_queue_misc_frame(cnx, mf, sizeof(mf), 0, picoquic_packet_context_initial) != 0) {\n117\t                ret = -1;\n118\t            }\n119\t            else {\n120\t                picoquic_delete_misc_or_dg(&cnx->first_misc_frame, &cnx->last_misc_frame, cnx->last_misc_frame);\n121\t                if (cnx->first_misc_frame == NULL || cnx->first_misc_frame->next_misc_frame != NULL) {\n122\t                    ret = -1;\n123\t                }\n124\t                picoquic_purge_misc_frames_after_ready(cnx);\n125\t            }\n126\t        }\n127\t    }\n128\t\n129\t    /* Activate a connection so all data are properly initialized */\n130\t    if (ret == 0) {\n131\t        ret = picoquic_start_client_cnx(test_ctx->cnx_client);\n132\t    }\n133\t    if (ret == 0) {\n134\t        ret = tls_api_connection_loop(test_ctx, &loss_mask, 0, &simulated_time);\n135\t    }\n136\t    if (ret == 0) {\n137\t        cnx_s = test_ctx->cnx_server;\n138\t    }\n139\t    /* Test a series of getter interfaces */\n140\t\n141\t    if (ret == 0 &&\n142\t        picoquic_get_local_if_index(cnx) != cnx->path[0]->first_tuple->if_index) {\n143\t        ret = -1;\n144\t    }\n145\t\n146\t    if (ret == 0) {\n147\t        picoquic_connection_id_t cid = picoquic_get_local_cnxid(cnx);\n148\t\n149\t        if (cid.id_len != cnx->path[0]->first_tuple->p_local_cnxid->cnx_id.id_len ||\n150\t            memcmp(cid.id, cnx->path[0]->first_tuple->p_local_cnxid->cnx_id.id, cid.id_len) != 0) {\n151\t            ret = -1;\n152\t        }\n153\t    }\n154\t\n155\t    if (ret == 0) {\n156\t        picoquic_connection_id_t cid = picoquic_get_remote_cnxid(cnx);\n157\t\n158\t        if (cid.id_len != cnx->path[0]->first_tuple->p_remote_cnxid->cnx_id.id_len ||\n159\t            memcmp(cid.id, cnx->path[0]->first_tuple->p_remote_cnxid->cnx_id.id, cid.id_len) != 0) {\n160\t            ret = -1;\n161\t        }\n162\t    }\n163\t\n164\t    if (ret == 0) {\n165\t        picoquic_connection_id_t cid = picoquic_get_initial_cnxid(cnx);\n166\t\n167\t        if (cid.id_len != cnx->initial_cnxid.id_len ||\n168\t            memcmp(cid.id, cnx->initial_cnxid.id, cid.id_len) != 0) {\n169\t            ret = -1;\n170\t        }\n171\t    }\n172\t\n173\t    if (ret == 0) {\n174\t        picoquic_connection_id_t cid = picoquic_get_client_cnxid(cnx);\n175\t        if (cid.id_len != cnx->path[0]->first_tuple->p_local_cnxid->cnx_id.id_len ||\n176\t            memcmp(cid.id, cnx->path[0]->first_tuple->p_local_cnxid->cnx_id.id, cid.id_len) != 0) {\n177\t            ret = -1;\n178\t        }\n179\t        else {\n180\t            picoquic_connection_id_t cid_s = picoquic_get_client_cnxid(cnx_s);\n181\t            if (cid.id_len != cid_s.id_len ||\n182\t                memcmp(cid.id, cid_s.id, cid.id_len) != 0) {\n183\t                ret = -1;\n184\t            }\n185\t        }\n186\t    }\n187\t\n188\t    if (ret == 0) {\n189\t        picoquic_connection_id_t cid = picoquic_get_server_cnxid(cnx);\n190\t        if (cid.id_len != cnx->path[0]->first_tuple->p_remote_cnxid->cnx_id.id_len ||\n191\t            memcmp(cid.id, cnx->path[0]->first_tuple->p_remote_cnxid->cnx_id.id, cid.id_len) != 0) {\n192\t            ret = -1;\n193\t        }\n194\t        else {\n195\t            picoquic_connection_id_t cid_s = picoquic_get_server_cnxid(cnx_s);\n196\t            if (cid.id_len != cid_s.id_len ||\n197\t                memcmp(cid.id, cid_s.id, cid.id_len) != 0) {\n198\t                ret = -1;\n199\t            }\n200\t        }\n201\t    }\n202\t\n203\t    if (ret == 0) {\n204\t        uint32_t r_padding_multiple = 256;\n205\t        uint32_t r_padding_minsize = 55;\n206\t        uint32_t padding_multiple = 0;\n207\t        uint32_t padding_minsize = 0;\n208\t\n209\t        picoquic_cnx_set_padding_policy(cnx, r_padding_multiple, r_padding_minsize);\n210\t        picoquic_cnx_get_padding_policy(cnx, &padding_multiple, &padding_minsize);\n211\t        if (padding_multiple != r_padding_multiple ||\n212\t            padding_minsize != r_padding_minsize) {\n213\t            ret = -1;\n214\t        }\n215\t    }\n216\t\n217\t    if (ret == 0) {\n218\t        picoquic_spinbit_version_enum spin = picoquic_spinbit_random;\n219\t        picoquic_cnx_set_spinbit_policy(cnx, spin);\n220\t        if (cnx->spin_policy != spin) {\n221\t            ret = -1;\n222\t        }\n223\t    }\n224\t\n225\t    if (ret == 0) {\n226\t        if (picoquic_is_sslkeylog_enabled(test_ctx->qclient) != test_ctx->qclient->enable_sslkeylog) {\n227\t            ret = -1;\n228\t        }\n229\t    }\n230\t\n231\t    if (ret == 0) {\n232\t        if (!picoquic_is_handshake_error(PICOQUIC_TLS_HANDSHAKE_FAILED) ||\n233\t            !picoquic_is_handshake_error(PICOQUIC_TRANSPORT_CRYPTO_ERROR(123)) ||\n234\t            picoquic_is_handshake_error(PICOQUIC_TRANSPORT_FRAME_FORMAT_ERROR)) {\n235\t            ret = -1;\n236\t        }\n237\t    }\n238\t    /* set the algorithm list to the complete value before the alogorithm set/get test\n239\t    * Hopefully, nobody is going to call their algorithm \"wuovipfwds\".\n240\t     */\n241\t    picoquic_register_all_congestion_control_algorithms();\n242\t    if (ret == 0) {\n243\t        char const* alg_name[] = {\n244\t            \"reno\", \"cubic\", \"dcubic\", \"fast\", \"bbr\", \"prague\", \"bbr1\", \"wuovipfwds\", NULL\n245\t        };\n246\t        picoquic_congestion_algorithm_t const* alg[] = {\n247\t            picoquic_newreno_algorithm, picoquic_cubic_algorithm, picoquic_dcubic_algorithm,\n248\t            picoquic_fastcc_algorithm, picoquic_bbr_algorithm, picoquic_prague_algorithm,\n249\t            picoquic_bbr1_algorithm, NULL, NULL\n250\t        };\n251\t        size_t nb_alg = sizeof(alg_name) / sizeof(char const*);\n252\t\n253\t        for (size_t i = 0; i < nb_alg && ret == 0; i++) {\n254\t            if (picoquic_get_congestion_algorithm(alg_name[i]) != alg[i]) {\n255\t                ret = -1;\n256\t            }\n257\t        }\n258\t    }\n259\t\n260\t    if (ret == 0) {\n261\t        picoquic_set_default_congestion_algorithm_by_name(test_ctx->qclient, \"dcubic\");\n262\t        if (test_ctx->qclient->default_congestion_alg != picoquic_dcubic_algorithm) {\n263\t            ret = -1;\n264\t        }\n265\t    }\n266\t\n267\t    if (ret == 0) {\n268\t        uint64_t l_timer = 10000000;\n269\t        uint64_t r_timer = cnx->path[0]->retransmit_timer;\n270\t        cnx->idle_timeout = 0;\n271\t        cnx->local_parameters.max_idle_timeout = r_timer / 500;\n272\t        picoquic_enable_keep_alive(cnx, 0);\n273\t        if (cnx->keep_alive_interval == 0 ||\n274\t            cnx->keep_alive_interval >= 3 * cnx->path[0]->retransmit_timer) {\n275\t            ret = -1;\n276\t        }\n277\t        else {\n278\t            picoquic_enable_keep_alive(cnx, l_timer);\n279\t            if (cnx->keep_alive_interval != l_timer) {\n280\t                ret = -1;\n281\t            }\n282\t            else {\n283\t                picoquic_disable_keep_alive(cnx);\n284\t                if (cnx->keep_alive_interval != 0) {\n285\t                    ret = -1;\n286\t                }\n287\t            }\n288\t        }\n289\t    }\n290\t\n291\t    if (ret == 0) {\n292\t        uint64_t app_error = 0x12345678abcdefull;\n293\t        cnx->remote_application_error = app_error;\n294\t        if (picoquic_get_application_error(cnx) != app_error) {\n295\t            ret = -1;\n296\t        }\n297\t        cnx->remote_application_error = 0;\n298\t    }\n299\t\n300\t    if (ret == 0) {\n301\t        if (picoquic_get_remote_stream_error(cnx, UINT32_MAX) != 0) {\n302\t            ret = -1;\n303\t        }\n304\t        else {\n305\t            uint8_t data[] = { 1, 2, 3, 4 };\n306\t            ret = picoquic_add_to_stream(cnx, 0, data, sizeof(data), 0);\n307\t            if (ret == 0) {\n308\t                uint64_t app_error = 0x12345678abcdefull;\n309\t                picoquic_stream_head_t* stream = picoquic_find_stream(cnx, 0);\n310\t                if (stream == NULL) {\n311\t                    ret = -1;\n312\t                }\n313\t                else {\n314\t                    stream->remote_error = app_error;\n315\t                    if (picoquic_get_remote_stream_error(cnx, 0) != app_error) {\n316\t                        ret = -1;\n317\t                    }\n318\t                }\n319\t            }\n320\t        }\n321\t    }\n322\t\n323\t    if (ret == 0 &&\n324\t        (ret = picoquic_adjust_max_connections(test_ctx->qserver, 4)) == 0) {\n325\t        if (test_ctx->qserver->tentative_max_number_connections != 4) {\n326\t            ret = -1;\n327\t        }\n328\t    }\n329\t\n330\t    if (ret == 0 &&\n331\t        picoquic_current_number_connections(test_ctx->qserver) != 1) {\n332\t        ret = -1;\n333\t    }\n334\t\n335\t    if (ret == 0 &&\n336\t        picoquic_get_default_crypto_epoch_length(test_ctx->qserver) !=\n337\t        test_ctx->qserver->crypto_epoch_length_max) {\n338\t        ret = -1;\n339\t    }\n340\t\n341\t    if (ret == 0) {\n342\t        picoquic_set_crypto_epoch_length(cnx, 0);\n343\t        if (cnx->crypto_epoch_length_max != PICOQUIC_DEFAULT_CRYPTO_EPOCH_LENGTH ||\n344\t            picoquic_get_crypto_epoch_length(cnx) != PICOQUIC_DEFAULT_CRYPTO_EPOCH_LENGTH) {\n345\t            ret = -1;\n346\t        }\n347\t    }\n348\t\n349\t    if (ret == 0 &&\n350\t        picoquic_get_local_cid_length(test_ctx->qserver) !=\n351\t        test_ctx->qserver->local_cnxid_length) {\n352\t        ret = -1;\n353\t    }\n354\t\n355\t    if (ret == 0) {\n356\t        picoquic_connection_id_t cid = { { 1, 2, 3}, 3 };\n357\t        if (picoquic_is_local_cid(test_ctx->qclient, &cid) ||\n358\t            !picoquic_is_local_cid(test_ctx->qclient, &cnx->path[0]->first_tuple->p_local_cnxid->cnx_id)) {\n359\t            ret = -1;\n360\t        }\n361\t    }\n362\t\n363\t    if (ret == 0) {\n364\t        uint32_t max_simul_log = 17;\n365\t        picoquic_set_max_simultaneous_logs(test_ctx->qserver, max_simul_log);\n366\t        if (picoquic_get_max_simultaneous_logs(test_ctx->qserver) != max_simul_log) {\n367\t            ret = -1;\n368\t        }\n369\t    }\n370\t\n371\t\n372\t    if (ret == 0) {\n373\t        uint32_t max_half_open = 17;\n374\t        picoquic_set_max_half_open_retry_threshold(test_ctx->qserver, max_half_open);\n375\t        if (picoquic_get_max_half_open_retry_threshold(test_ctx->qserver) != max_half_open) {\n376\t            ret = -1;\n377\t        }\n378\t    }\n379\t\n380\t    if (ret == 0 && picoquic_register_cnx_id(test_ctx->qclient, cnx, cnx->path[0]->first_tuple->p_local_cnxid) == 0) {\n381\t        /* Should be already registered ! */\n382\t        ret = -1;\n383\t    }\n384\t\n385\t    if (ret == 0){\n386\t        if (cnx->registered_icid_addr.ss_family == 0 &&\n387\t            picoquic_register_net_icid(cnx) != 0) {\n388\t            ret = -1;\n389\t        }\n390\t        else if (picoquic_register_net_icid(cnx) == 0) {\n391\t            /* Should be already registered ! */\n392\t            ret = -1;\n393\t        }\n394\t    }\n395\t\n396\t    if (ret == 0 && picoquic_get_quic_ctx(NULL) != NULL) {\n397\t        ret = -1;\n398\t    }\n399\t\n400\t    if (ret == 0) {\n401\t        uint64_t wake_time = picoquic_get_next_wake_time(test_ctx->qclient, UINT64_MAX);\n402\t\n403\t        if (wake_time > 2 && picoquic_get_earliest_cnx_to_wake(test_ctx->qclient, wake_time / 2) != NULL) {\n404\t            ret = -1;\n405\t        }\n406\t    }\n407\t\n408\t    if (ret == 0) {\n409\t        int64_t delay = 1000;\n410\t        uint64_t test_time = cnx->next_wake_time - delay;\n411\t        int64_t sooner = delay / 2;\n412\t\n413\t        if (picoquic_get_wake_delay(cnx, test_time, INT64_MAX) != delay) {\n414\t            ret = -1;\n415\t        }\n416\t        else if (picoquic_get_wake_delay(cnx, test_time, sooner) != sooner) {\n417\t            ret = -1;\n418\t        }\n419\t    }\n420\t\n421\t    if (test_ctx != NULL) {\n422\t        tls_api_delete_ctx(test_ctx);\n423\t        test_ctx = NULL;\n424\t    }\n425\t    return ret;\n426\t}\n427\t"}]},"parent_tool_use_id":null,"session_id":"483d188f-86bb-48b4-b530-27cbba01828e","uuid":"c7757cae-c011-4fe1-bd06-3f2784d621ef","timestamp":"2026-05-05T03:32:13.889Z","tool_use_result":{"type":"text","file":{"filePath":"/Users/richbarn/Projects/picoquic/picoquictest/getter_test.c","content":"/*\n* Author: Christian Huitema\n* Copyright (c) 2024, Private Octopus, Inc.\n* All rights reserved.\n*\n* Permission to use, copy, modify, and distribute this software for any\n* purpose with or without fee is hereby granted, provided that the above\n* copyright notice and this permission notice appear in all copies.\n*\n* THIS SOFTWARE IS PROVIDED BY THE COPYRIGHT HOLDERS AND CONTRIBUTORS \"AS IS\" AND\n* ANY EXPRESS OR IMPLIED WARRANTIES, INCLUDING, BUT NOT LIMITED TO, THE IMPLIED\n* WARRANTIES OF MERCHANTABILITY AND FITNESS FOR A PARTICULAR PURPOSE ARE\n* DISCLAIMED. IN NO EVENT SHALL Private Octopus, Inc. BE LIABLE FOR ANY\n* DIRECT, INDIRECT, INCIDENTAL, SPECIAL, EXEMPLARY, OR CONSEQUENTIAL DAMAGES\n* (INCLUDING, BUT NOT LIMITED TO, PROCUREMENT OF SUBSTITUTE GOODS OR SERVICES;\n* LOSS OF USE, DATA, OR PROFITS; OR BUSINESS INTERRUPTION) HOWEVER CAUSED AND\n* ON ANY THEORY OF LIABILITY, WHETHER IN CONTRACT, STRICT LIABILITY, OR TORT\n* (INCLUDING NEGLIGENCE OR OTHERWISE) ARISING IN ANY WAY OUT OF THE USE OF THIS\n* SOFTWARE, EVEN IF ADVISED OF THE POSSIBILITY OF SUCH DAMAGE.\n*/\n\n#include <string.h>\n#include <stdlib.h>\n#include <stdio.h>\n#include \"picoquic_internal.h\"\n#include \"picoquic_utils.h\"\n#include \"picoquictest_internal.h\"\n#include \"picoquic.h\"\n#include \"picoquic_newreno.h\"\n#include \"picoquic_cubic.h\"\n#include \"picoquic_bbr.h\"\n#include \"picoquic_bbr1.h\"\n#include \"picoquic_fastcc.h\"\n#include \"picoquic_prague.h\"\n\n/* Verify that the getter/setter functions work as expected \n */\n\nint getter_test(void)\n{\n    /* Create a connection context so we can test the various API */\n    uint64_t simulated_time = 0;\n    uint64_t loss_mask = 0;\n    picoquic_test_tls_api_ctx_t* test_ctx = NULL;\n    picoquic_cnx_t* cnx = NULL;\n    picoquic_cnx_t* cnx_s = NULL;\n    picoquic_connection_id_t initial_cid = { {0x9e, 0x77, 0xe8, 0, 0, 0, 0, 0}, 8 };\n    int ret = tls_api_init_ctx_ex2(&test_ctx, PICOQUIC_INTERNAL_TEST_VERSION_1, PICOQUIC_TEST_SNI, PICOQUIC_TEST_ALPN,\n        &simulated_time, NULL, NULL,\n        0, 1, 0, &initial_cid, 8, 0, 0, 0);\n\n    if (ret == 0) {\n        if (picoquic_set_default_connection_id_length(test_ctx->qserver, (uint8_t)255) != PICOQUIC_ERROR_CNXID_CHECK ||\n            picoquic_set_default_connection_id_length(test_ctx->qclient, (uint8_t)5) != PICOQUIC_ERROR_CANNOT_CHANGE_ACTIVE_CONTEXT) {\n            ret = -1;\n        }\n    }\n\n    if (ret == 0) {\n        if (picoquic_get_default_connection_id_ttl(test_ctx->qserver) != test_ctx->qserver->local_cnxid_ttl) {\n            ret = -1;\n        }\n    }\n\n    if (ret == 0) {\n        const picoquic_tp_t* tp = picoquic_get_default_tp(test_ctx->qserver);\n        if (tp != &test_ctx->qserver->default_tp) {\n            ret = -1;\n        }\n    }\n\n    if (ret == 0) {\n        uint64_t old_max = test_ctx->qserver->cwin_max;\n        picoquic_set_cwin_max(test_ctx->qserver, 0);\n        if (test_ctx->qserver->cwin_max != UINT64_MAX) {\n            ret = -1;\n        }\n        test_ctx->qserver->cwin_max = old_max;\n    }\n\n    if (ret == 0) {\n        int partial_match = 0;\n        int path_id = picoquic_find_path_by_address(test_ctx->cnx_client, NULL,\n            (struct sockaddr*)&test_ctx->cnx_client->path[0]->first_tuple->peer_addr, &partial_match);\n        if (path_id != 0 || partial_match == 0) {\n            ret = -1;\n        }\n    }\n\n    if (ret == 0) {\n        ret = picoquic_set_local_addr(test_ctx->cnx_client, (struct sockaddr*) &test_ctx->client_addr);\n        if (ret == 0 && picoquic_set_local_addr(test_ctx->cnx_client, (struct sockaddr*)&test_ctx->client_addr) == 0) {\n            /* Second call should fail because the address is already set */\n            ret = -1;\n        }\n        memset(&test_ctx->cnx_client->path[0]->first_tuple->local_addr, 0, sizeof(struct sockaddr_storage));\n    }\n\n    if (ret == 0) {\n        uint8_t mf[] = { picoquic_frame_type_max_streams_bidir, 0x41, 0 };\n        cnx = test_ctx->cnx_client;\n        if (picoquic_queue_misc_frame(cnx, mf, SIZE_MAX, 0, picoquic_packet_context_initial) == 0) {\n            ret = -1;\n        }\n        else if (picoquic_queue_misc_frame(cnx, mf, sizeof(mf), 0, picoquic_packet_context_initial) != 0) {\n            ret = -1;\n        }\n        else {\n            picoquic_purge_misc_frames_after_ready(cnx);\n            if (cnx->first_misc_frame != NULL) {\n                ret = -1;\n            }\n        }\n        if (ret == 0) {\n            if (picoquic_queue_misc_frame(cnx, mf, sizeof(mf), 0, picoquic_packet_context_initial) != 0 ||\n                picoquic_queue_misc_frame(cnx, mf, sizeof(mf), 0, picoquic_packet_context_initial) != 0) {\n                ret = -1;\n            }\n            else {\n                picoquic_delete_misc_or_dg(&cnx->first_misc_frame, &cnx->last_misc_frame, cnx->last_misc_frame);\n                if (cnx->first_misc_frame == NULL || cnx->first_misc_frame->next_misc_frame != NULL) {\n                    ret = -1;\n                }\n                picoquic_purge_misc_frames_after_ready(cnx);\n            }\n        }\n    }\n\n    /* Activate a connection so all data are properly initialized */\n    if (ret == 0) {\n        ret = picoquic_start_client_cnx(test_ctx->cnx_client);\n    }\n    if (ret == 0) {\n        ret = tls_api_connection_loop(test_ctx, &loss_mask, 0, &simulated_time);\n    }\n    if (ret == 0) {\n        cnx_s = test_ctx->cnx_server;\n    }\n    /* Test a series of getter interfaces */\n\n    if (ret == 0 &&\n        picoquic_get_local_if_index(cnx) != cnx->path[0]->first_tuple->if_index) {\n        ret = -1;\n    }\n\n    if (ret == 0) {\n        picoquic_connection_id_t cid = picoquic_get_local_cnxid(cnx);\n\n        if (cid.id_len != cnx->path[0]->first_tuple->p_local_cnxid->cnx_id.id_len ||\n            memcmp(cid.id, cnx->path[0]->first_tuple->p_local_cnxid->cnx_id.id, cid.id_len) != 0) {\n            ret = -1;\n        }\n    }\n\n    if (ret == 0) {\n        picoquic_connection_id_t cid = picoquic_get_remote_cnxid(cnx);\n\n        if (cid.id_len != cnx->path[0]->first_tuple->p_remote_cnxid->cnx_id.id_len ||\n            memcmp(cid.id, cnx->path[0]->first_tuple->p_remote_cnxid->cnx_id.id, cid.id_len) != 0) {\n            ret = -1;\n        }\n    }\n\n    if (ret == 0) {\n        picoquic_connection_id_t cid = picoquic_get_initial_cnxid(cnx);\n\n        if (cid.id_len != cnx->initial_cnxid.id_len ||\n            memcmp(cid.id, cnx->initial_cnxid.id, cid.id_len) != 0) {\n            ret = -1;\n        }\n    }\n\n    if (ret == 0) {\n        picoquic_connection_id_t cid = picoquic_get_client_cnxid(cnx);\n        if (cid.id_len != cnx->path[0]->first_tuple->p_local_cnxid->cnx_id.id_len ||\n            memcmp(cid.id, cnx->path[0]->first_tuple->p_local_cnxid->cnx_id.id, cid.id_len) != 0) {\n            ret = -1;\n        }\n        else {\n            picoquic_connection_id_t cid_s = picoquic_get_client_cnxid(cnx_s);\n            if (cid.id_len != cid_s.id_len ||\n                memcmp(cid.id, cid_s.id, cid.id_len) != 0) {\n                ret = -1;\n            }\n        }\n    }\n\n    if (ret == 0) {\n        picoquic_connection_id_t cid = picoquic_get_server_cnxid(cnx);\n        if (cid.id_len != cnx->path[0]->first_tuple->p_remote_cnxid->cnx_id.id_len ||\n            memcmp(cid.id, cnx->path[0]->first_tuple->p_remote_cnxid->cnx_id.id, cid.id_len) != 0) {\n            ret = -1;\n        }\n        else {\n            picoquic_connection_id_t cid_s = picoquic_get_server_cnxid(cnx_s);\n            if (cid.id_len != cid_s.id_len ||\n                memcmp(cid.id, cid_s.id, cid.id_len) != 0) {\n                ret = -1;\n            }\n        }\n    }\n\n    if (ret == 0) {\n        uint32_t r_padding_multiple = 256;\n        uint32_t r_padding_minsize = 55;\n        uint32_t padding_multiple = 0;\n        uint32_t padding_minsize = 0;\n\n        picoquic_cnx_set_padding_policy(cnx, r_padding_multiple, r_padding_minsize);\n        picoquic_cnx_get_padding_policy(cnx, &padding_multiple, &padding_minsize);\n        if (padding_multiple != r_padding_multiple ||\n            padding_minsize != r_padding_minsize) {\n            ret = -1;\n        }\n    }\n\n    if (ret == 0) {\n        picoquic_spinbit_version_enum spin = picoquic_spinbit_random;\n        picoquic_cnx_set_spinbit_policy(cnx, spin);\n        if (cnx->spin_policy != spin) {\n            ret = -1;\n        }\n    }\n\n    if (ret == 0) {\n        if (picoquic_is_sslkeylog_enabled(test_ctx->qclient) != test_ctx->qclient->enable_sslkeylog) {\n            ret = -1;\n        }\n    }\n\n    if (ret == 0) {\n        if (!picoquic_is_handshake_error(PICOQUIC_TLS_HANDSHAKE_FAILED) ||\n            !picoquic_is_handshake_error(PICOQUIC_TRANSPORT_CRYPTO_ERROR(123)) ||\n            picoquic_is_handshake_error(PICOQUIC_TRANSPORT_FRAME_FORMAT_ERROR)) {\n            ret = -1;\n        }\n    }\n    /* set the algorithm list to the complete value before the alogorithm set/get test\n    * Hopefully, nobody is going to call their algorithm \"wuovipfwds\".\n     */\n    picoquic_register_all_congestion_control_algorithms();\n    if (ret == 0) {\n        char const* alg_name[] = {\n            \"reno\", \"cubic\", \"dcubic\", \"fast\", \"bbr\", \"prague\", \"bbr1\", \"wuovipfwds\", NULL\n        };\n        picoquic_congestion_algorithm_t const* alg[] = {\n            picoquic_newreno_algorithm, picoquic_cubic_algorithm, picoquic_dcubic_algorithm,\n            picoquic_fastcc_algorithm, picoquic_bbr_algorithm, picoquic_prague_algorithm,\n            picoquic_bbr1_algorithm, NULL, NULL\n        };\n        size_t nb_alg = sizeof(alg_name) / sizeof(char const*);\n\n        for (size_t i = 0; i < nb_alg && ret == 0; i++) {\n            if (picoquic_get_congestion_algorithm(alg_name[i]) != alg[i]) {\n                ret = -1;\n            }\n        }\n    }\n\n    if (ret == 0) {\n        picoquic_set_default_congestion_algorithm_by_name(test_ctx->qclient, \"dcubic\");\n        if (test_ctx->qclient->default_congestion_alg != picoquic_dcubic_algorithm) {\n            ret = -1;\n        }\n    }\n\n    if (ret == 0) {\n        uint64_t l_timer = 10000000;\n        uint64_t r_timer = cnx->path[0]->retransmit_timer;\n        cnx->idle_timeout = 0;\n        cnx->local_parameters.max_idle_timeout = r_timer / 500;\n        picoquic_enable_keep_alive(cnx, 0);\n        if (cnx->keep_alive_interval == 0 ||\n            cnx->keep_alive_interval >= 3 * cnx->path[0]->retransmit_timer) {\n            ret = -1;\n        }\n        else {\n            picoquic_enable_keep_alive(cnx, l_timer);\n            if (cnx->keep_alive_interval != l_timer) {\n                ret = -1;\n            }\n            else {\n                picoquic_disable_keep_alive(cnx);\n                if (cnx->keep_alive_interval != 0) {\n                    ret = -1;\n                }\n            }\n        }\n    }\n\n    if (ret == 0) {\n        uint64_t app_error = 0x12345678abcdefull;\n        cnx->remote_application_error = app_error;\n        if (picoquic_get_application_error(cnx) != app_error) {\n            ret = -1;\n        }\n        cnx->remote_application_error = 0;\n    }\n\n    if (ret == 0) {\n        if (picoquic_get_remote_stream_error(cnx, UINT32_MAX) != 0) {\n            ret = -1;\n        }\n        else {\n            uint8_t data[] = { 1, 2, 3, 4 };\n            ret = picoquic_add_to_stream(cnx, 0, data, sizeof(data), 0);\n            if (ret == 0) {\n                uint64_t app_error = 0x12345678abcdefull;\n                picoquic_stream_head_t* stream = picoquic_find_stream(cnx, 0);\n                if (stream == NULL) {\n                    ret = -1;\n                }\n                else {\n                    stream->remote_error = app_error;\n                    if (picoquic_get_remote_stream_error(cnx, 0) != app_error) {\n                        ret = -1;\n                    }\n                }\n            }\n        }\n    }\n\n    if (ret == 0 &&\n        (ret = picoquic_adjust_max_connections(test_ctx->qserver, 4)) == 0) {\n        if (test_ctx->qserver->tentative_max_number_connections != 4) {\n            ret = -1;\n        }\n    }\n\n    if (ret == 0 &&\n        picoquic_current_number_connections(test_ctx->qserver) != 1) {\n        ret = -1;\n    }\n\n    if (ret == 0 &&\n        picoquic_get_default_crypto_epoch_length(test_ctx->qserver) !=\n        test_ctx->qserver->crypto_epoch_length_max) {\n        ret = -1;\n    }\n\n    if (ret == 0) {\n        picoquic_set_crypto_epoch_length(cnx, 0);\n        if (cnx->crypto_epoch_length_max != PICOQUIC_DEFAULT_CRYPTO_EPOCH_LENGTH ||\n            picoquic_get_crypto_epoch_length(cnx) != PICOQUIC_DEFAULT_CRYPTO_EPOCH_LENGTH) {\n            ret = -1;\n        }\n    }\n\n    if (ret == 0 &&\n        picoquic_get_local_cid_length(test_ctx->qserver) !=\n        test_ctx->qserver->local_cnxid_length) {\n        ret = -1;\n    }\n\n    if (ret == 0) {\n        picoquic_connection_id_t cid = { { 1, 2, 3}, 3 };\n        if (picoquic_is_local_cid(test_ctx->qclient, &cid) ||\n            !picoquic_is_local_cid(test_ctx->qclient, &cnx->path[0]->first_tuple->p_local_cnxid->cnx_id)) {\n            ret = -1;\n        }\n    }\n\n    if (ret == 0) {\n        uint32_t max_simul_log = 17;\n        picoquic_set_max_simultaneous_logs(test_ctx->qserver, max_simul_log);\n        if (picoquic_get_max_simultaneous_logs(test_ctx->qserver) != max_simul_log) {\n            ret = -1;\n        }\n    }\n\n\n    if (ret == 0) {\n        uint32_t max_half_open = 17;\n        picoquic_set_max_half_open_retry_threshold(test_ctx->qserver, max_half_open);\n        if (picoquic_get_max_half_open_retry_threshold(test_ctx->qserver) != max_half_open) {\n            ret = -1;\n        }\n    }\n\n    if (ret == 0 && picoquic_register_cnx_id(test_ctx->qclient, cnx, cnx->path[0]->first_tuple->p_local_cnxid) == 0) {\n        /* Should be already registered ! */\n        ret = -1;\n    }\n\n    if (ret == 0){\n        if (cnx->registered_icid_addr.ss_family == 0 &&\n            picoquic_register_net_icid(cnx) != 0) {\n            ret = -1;\n        }\n        else if (picoquic_register_net_icid(cnx) == 0) {\n            /* Should be already registered ! */\n            ret = -1;\n        }\n    }\n\n    if (ret == 0 && picoquic_get_quic_ctx(NULL) != NULL) {\n        ret = -1;\n    }\n\n    if (ret == 0) {\n        uint64_t wake_time = picoquic_get_next_wake_time(test_ctx->qclient, UINT64_MAX);\n\n        if (wake_time > 2 && picoquic_get_earliest_cnx_to_wake(test_ctx->qclient, wake_time / 2) != NULL) {\n            ret = -1;\n        }\n    }\n\n    if (ret == 0) {\n        int64_t delay = 1000;\n        uint64_t test_time = cnx->next_wake_time - delay;\n        int64_t sooner = delay / 2;\n\n        if (picoquic_get_wake_delay(cnx, test_time, INT64_MAX) != delay) {\n            ret = -1;\n        }\n        else if (picoquic_get_wake_delay(cnx, test_time, sooner) != sooner) {\n            ret = -1;\n        }\n    }\n\n    if (test_ctx != NULL) {\n        tls_api_delete_ctx(test_ctx);\n        test_ctx = NULL;\n    }\n    return ret;\n}\n","numLines":427,"startLine":1,"totalLines":427}}}
