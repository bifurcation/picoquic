{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01WJUknMn1SA6S8wEBqmT42i","type":"tool_result","content":"1\t//! Test cases for `picoquictest/intformattest.c`.\n2\t\n3\t#![allow(non_snake_case)]\n4\t\n5\tuse crate::internal::{\n6\t    format_16, format_24, format_32, format_64, parse_16, parse_24, parse_32, parse_64,\n7\t};\n8\t\n9\tconst TEST_NUMBERS: &[u64] = &[\n10\t    0,\n11\t    1,\n12\t    0xFFFF_FFFF_FFFF_FFFF,\n13\t    0xDEAD_BEEF,\n14\t    0x1234_5678_DEAD_BEEF,\n15\t];\n16\t\n17\t/// Decode a big-endian integer of `length` bytes from `bytes`.\n18\t/// Mirror of the C `decode_number` helper used by the test.\n19\tfn decode_number(bytes: &[u8], length: usize) -> u64 {\n20\t    let mut n = 0u64;\n21\t    for &b in &bytes[..length] {\n22\t        n = (n << 8) | b as u64;\n23\t    }\n24\t    n\n25\t}\n26\t\n27\t/// C: `intformattest` in `picoquictest/intformattest.c`.\n28\t///\n29\t/// Roundtrip every value in [`TEST_NUMBERS`] through each of the\n30\t/// 16 / 24 / 32 / 64-bit big-endian formatters and parsers.  The\n31\t/// C version also exercises a parallel `picoquic_frames_uint*_encode`\n32\t/// family that returns a tail pointer; that encoding is a Phase 4\n33\t/// addition and is omitted here.\n34\t#[test]\n35\tfn intformat() {\n36\t    let mut buf = [0u8; 8];\n37\t\n38\t    for &n in TEST_NUMBERS {\n39\t        let n16 = n as u16;\n40\t        format_16(&mut buf, n16);\n41\t        assert_eq!(decode_number(&buf, 2), n16 as u64, \"u16 BE bytes mismatch\");\n42\t        assert_eq!(parse_16(&buf), n16, \"parse_16 roundtrip\");\n43\t\n44\t        let n24 = (n & 0xFF_FFFF) as u32;\n45\t        format_24(&mut buf, n24);\n46\t        assert_eq!(decode_number(&buf, 3), n24 as u64, \"u24 BE bytes mismatch\");\n47\t        assert_eq!(parse_24(&buf), n24, \"parse_24 roundtrip\");\n48\t\n49\t        let n32 = n as u32;\n50\t        format_32(&mut buf, n32);\n51\t        assert_eq!(decode_number(&buf, 4), n32 as u64, \"u32 BE bytes mismatch\");\n52\t        assert_eq!(parse_32(&buf), n32, \"parse_32 roundtrip\");\n53\t\n54\t        format_64(&mut buf, n);\n55\t        assert_eq!(decode_number(&buf, 8), n, \"u64 BE bytes mismatch\");\n56\t        assert_eq!(parse_64(&buf), n, \"parse_64 roundtrip\");\n57\t    }\n58\t}\n59\t\n60\t/// C: `varint_test` in `picoquictest/intformattest.c`.\n61\t///\n62\t/// Known-answer test for the QUIC varint encoder/decoder\n63\t/// ([`crate::internal::varint_encode`] / [`varint_decode`]).\n64\t/// Cases lifted verbatim from the C source (and from RFC 9000\n65\t/// Appendix A.1).\n66\t#[test]\n67\tfn varint() {\n68\t    use crate::internal::{varint_decode, varint_encode};\n69\t\n70\t    struct Case {\n71\t        encoding: [u8; 8],\n72\t        length: usize,\n73\t        decoded: u64,\n74\t        is_canonical: bool,\n75\t    }\n76\t\n77\t    let cases = [\n78\t        Case {\n79\t            encoding: [0, 0xCC, 0xCC, 0xCC, 0xCC, 0xCC, 0xCC, 0xCC],\n80\t            length: 1,\n81\t            decoded: 0,\n82\t            is_canonical: true,\n83\t        },\n84\t        Case {\n85\t            encoding: [1, 0xCC, 0xCC, 0xCC, 0xCC, 0xCC, 0xCC, 0xCC],\n86\t            length: 1,\n87\t            decoded: 1,\n88\t            is_canonical: true,\n89\t        },\n90\t        Case {\n91\t            encoding: [63, 0xCC, 0xCC, 0xCC, 0xCC, 0xCC, 0xCC, 0xCC],\n92\t            length: 1,\n93\t            decoded: 63,\n94\t            is_canonical: true,\n95\t        },\n96\t        Case {\n97\t            encoding: [0x40, 64, 0xCC, 0xCC, 0xCC, 0xCC, 0xCC, 0xCC],\n98\t            length: 2,\n99\t            decoded: 64,\n100\t            is_canonical: true,\n101\t        },\n102\t        Case {\n103\t            encoding: [0x7F, 0xFF, 0xCC, 0xCC, 0xCC, 0xCC, 0xCC, 0xCC],\n104\t            length: 2,\n105\t            decoded: 0x3FFF,\n106\t            is_canonical: true,\n107\t        },\n108\t        Case {\n109\t            encoding: [0x80, 0, 0x40, 0, 0xCC, 0xCC, 0xCC, 0xCC],\n110\t            length: 4,\n111\t            decoded: 0x4000,\n112\t            is_canonical: true,\n113\t        },\n114\t        Case {\n115\t            encoding: [0xBF, 0xFF, 0xFF, 0xFF, 0xCC, 0xCC, 0xCC, 0xCC],\n116\t            length: 4,\n117\t            decoded: 0x3FFF_FFFF,\n118\t            is_canonical: true,\n119\t        },\n120\t        Case {\n121\t            encoding: [0xC0, 0, 0, 0, 0x40, 0, 0, 0],\n122\t            length: 8,\n123\t            decoded: 0x4000_0000,\n124\t            is_canonical: true,\n125\t        },\n126\t        Case {\n127\t            encoding: [0xFF, 0xFF, 0xFF, 0xFF, 0xFF, 0xFF, 0xFF, 0xFF],\n128\t            length: 8,\n129\t            decoded: 0x3FFF_FFFF_FFFF_FFFF,\n130\t            is_canonical: true,\n131\t        },\n132\t        Case {\n133\t            encoding: [0xc2, 0x19, 0x7c, 0x5e, 0xff, 0x14, 0xe8, 0x8c],\n134\t            length: 8,\n135\t            decoded: 151_288_809_941_952_652,\n136\t            is_canonical: true,\n137\t        },\n138\t        Case {\n139\t            encoding: [0x9d, 0x7f, 0x3e, 0x7d, 0xff, 0x14, 0xe8, 0x8c],\n140\t            length: 4,\n141\t            decoded: 494_878_333,\n142\t            is_canonical: true,\n143\t        },\n144\t        Case {\n145\t            encoding: [0xC0, 0, 0, 0, 0x1d, 0x7f, 0x3e, 0x7d],\n146\t            length: 8,\n147\t            decoded: 494_878_333,\n148\t            is_canonical: false,\n149\t        },\n150\t        Case {\n151\t            encoding: [0x7b, 0xbd, 0x3e, 0x7d, 0xff, 0x14, 0xe8, 0x8c],\n152\t            length: 2,\n153\t            decoded: 15_293,\n154\t            is_canonical: true,\n155\t        },\n156\t        Case {\n157\t            encoding: [0x80, 0, 0x3b, 0xbd, 0x3e, 0x7d, 0xff, 0x14],\n158\t            length: 4,\n159\t            decoded: 15_293,\n160\t            is_canonical: false,\n161\t        },\n162\t        Case {\n163\t            encoding: [0xC0, 0, 0, 0, 0, 0, 0x3b, 0xbd],\n164\t            length: 8,\n165