{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01Cu7FzYPbaukyV26u9yHkpr","type":"tool_result","content":"1\t/*\n2\t* Author: Christian Huitema\n3\t* Copyright (c) 2025, Private Octopus, Inc.\n4\t* All rights reserved.\n5\t*\n6\t* Permission to use, copy, modify, and distribute this software for any\n7\t* purpose with or without fee is hereby granted, provided that the above\n8\t* copyright notice and this permission notice appear in all copies.\n9\t*\n10\t* THIS SOFTWARE IS PROVIDED BY THE COPYRIGHT HOLDERS AND CONTRIBUTORS \"AS IS\" AND\n11\t* ANY EXPRESS OR IMPLIED WARRANTIES, INCLUDING, BUT NOT LIMITED TO, THE IMPLIED\n12\t* WARRANTIES OF MERCHANTABILITY AND FITNESS FOR A PARTICULAR PURPOSE ARE\n13\t* DISCLAIMED. IN NO EVENT SHALL Private Octopus, Inc. BE LIABLE FOR ANY\n14\t* DIRECT, INDIRECT, INCIDENTAL, SPECIAL, EXEMPLARY, OR CONSEQUENTIAL DAMAGES\n15\t* (INCLUDING, BUT NOT LIMITED TO, PROCUREMENT OF SUBSTITUTE GOODS OR SERVICES;\n16\t* LOSS OF USE, DATA, OR PROFITS; OR BUSINESS INTERRUPTION) HOWEVER CAUSED AND\n17\t* ON ANY THEORY OF LIABILITY, WHETHER IN CONTRACT, STRICT LIABILITY, OR TORT\n18\t* (INCLUDING NEGLIGENCE OR OTHERWISE) ARISING IN ANY WAY OUT OF THE USE OF THIS\n19\t* SOFTWARE, EVEN IF ADVISED OF THE POSSIBILITY OF SUCH DAMAGE.\n20\t*/\n21\t\n22\t#include \"tls_api.h\"\n23\t#include \"picoquic_internal.h\"\n24\t#include \"picoquictest_internal.h\"\n25\t#include <stdlib.h>\n26\t#include <string.h>\n27\t\n28\t#include \"logreader.h\"\n29\t#include \"autoqlog.h\"\n30\t#include \"picoquic_logger.h\"\n31\t#include \"picoquic_bbr.h\"\n32\t#include \"qlog.h\"\n33\t\n34\t/* Flow control test:\n35\t* \n36\t* Simulate a data receiver that can only process data slowly, and must\n37\t* buffer whatever excess data is delivered. The test verifies that the\n38\t* amount of data that the application must queue does not exceed a\n39\t* preset limit, and fails the connection if it does.\n40\t*/\n41\t#define FCTEST_TEST_ALPN \"fctest\"\n42\t\n43\ttypedef struct st_fctest_spec_t {\n44\t\tuint8_t test_id;\n45\t\tpicoquic_congestion_algorithm_t* ccalgo;\n46\t\tuint64_t loss_mask;\n47\t\tuint64_t transfer_size;\n48\t\tuint64_t microsecs_per_byte;\n49\t\tuint64_t credit_quantum;\n50\t\tuint64_t initial_credit;\n51\t\tuint64_t bytes_buffered_max;\n52\t\tuint64_t completion_target;\n53\t} fctest_spec_t;\n54\t\n55\ttypedef struct st_fctest_ctx_t {\n56\t\tuint64_t transfer_size;\n57\t\tuint64_t microsecs_per_byte;\n58\t\tuint64_t credit_quantum;\n59\t\n60\t\tuint64_t simulated_time;\n61\t\tuint64_t loss_mask;\n62\t\tuint64_t stream_id;\n63\t\tuint64_t bytes_sent;\n64\t\n65\t\tuint64_t bytes_received;\n66\t\tuint64_t bytes_buffered;\n67\t\tuint64_t buffered_time;\n68\t\tuint64_t microsec_rounding_error;\n69\t\n70\t\tuint64_t credits_pending;\n71\t\n72\t\tuint64_t bytes_buffered_max;\n73\t\n74\t\tint is_started;\n75\t\tint fin_sent;\n76\t\tint fin_received;\n77\t\tint is_closed;\n78\t\tint error_detected;\n79\t} fctest_ctx_t;\n80\t\n81\tvoid fctest_ctx_init(fctest_ctx_t* fctest_ctx, fctest_spec_t* spec)\n82\t{\n83\t\tmemset(fctest_ctx, 0, sizeof(fctest_ctx_t));\n84\t\tfctest_ctx->transfer_size = spec->transfer_size;\n85\t\tfctest_ctx->microsecs_per_byte = spec->microsecs_per_byte;\n86\t\tfctest_ctx->credit_quantum = spec->credit_quantum;\n87\t\tfctest_ctx->loss_mask = spec->loss_mask;\n88\t}\n89\t\n90\tint fctest_start_stream(fctest_ctx_t* fctest_ctx, picoquic_cnx_t* cnx)\n91\t{\n92\t\tint ret = 0;\n93\t\n94\t\tif (cnx->client_mode && !fctest_ctx->is_started) {\n95\t\t\tuint8_t start[] = { 0xff, 0xfe, 0xfd, 0xfc };\n96\t\t\tfctest_ctx->is_started = 1;\n97\t\t\tfctest_ctx->stream_id = picoquic_get_next_local_stream_id(cnx, 0);\n98\t\t\tret = picoquic_add_to_stream(cnx, fctest_ctx->stream_id, start, sizeof(start), 1);\n99\t\t\tif (ret == 0) {\n100\t\t\t\tret = picoquic_set_app_flow_control(cnx, fctest_ctx->stream_id, 1);\n101\t\t\t}\n102\t\t}\n103\t\treturn ret;\n104\t}\n105\t\n106\tint fctest_receive_data(fctest_ctx_t* fctest_ctx, picoquic_cnx_t* cnx, uint64_t current_time, size_t length)\n107\t{\n108\t\tint ret = 0;\n109\t\tuint64_t delta_t = current_time - fctest_ctx->buffered_time + fctest_ctx->microsec_rounding_error;\n110\t\tuint64_t processed_bytes = delta_t / fctest_ctx->microsecs_per_byte;\n111\t\n112\t\tif (processed_bytes >= fctest_ctx->bytes_buffered) {\n113\t\t\tprocessed_bytes = fctest_ctx->bytes_buffered;\n114\t\t\tfctest_ctx->bytes_buffered = 0;\n115\t\t\tfctest_ctx->microsec_rounding_error = 0;\n116\t\t}\n117\t\telse {\n118\t\t\tfctest_ctx->bytes_buffered -= processed_bytes;\n119\t\t\tfctest_ctx->microsec_rounding_error = delta_t % fctest_ctx->microsecs_per_byte;\n120\t\t}\n121\t\tfctest_ctx->buffered_time = current_time;\n122\t\tfctest_ctx->credits_pending += processed_bytes;\n123\t\n124\t\tif (length > 0) {\n125\t\t\tfctest_ctx->bytes_buffered += length;\n126\t\t\tfctest_ctx->bytes_received += length;\n127\t\t\tif (fctest_ctx->bytes_buffered > fctest_ctx->bytes_buffered_max) {\n128\t\t\t\tfctest_ctx->bytes_buffered_max = fctest_ctx->bytes_buffered;\n129\t\t\t}\n130\t\t}\n131\t\t/* Enforcing a quantum, because dripping credits in small number will lead to\n132\t\t * silly packet syndrome */\n133\t\tif (fctest_ctx->credits_pending >= fctest_ctx->credit_quantum) {\n134\t\t\tfctest_ctx->credits_pending -= fctest_ctx->credit_quantum;\n135\t\t\tret = picoquic_open_flow_control(cnx, fctest_ctx->stream_id, fctest_ctx->credit_quantum);\n136\t\t}\n137\t\treturn ret;\n138\t}\n139\t\n140\tstatic int fctest_prepare_to_send(fctest_ctx_t* fctest_ctx, uint8_t* context, size_t space)\n141\t{\n142\t\tint ret = 0;\n143\t\tuint8_t* buffer;\n144\t\tint is_fin = 0;\n145\t\n146\t\tif (fctest_ctx->bytes_sent + space >= fctest_ctx->transfer_size) {\n147\t\t\tspace = (size_t)(fctest_ctx->transfer_size - fctest_ctx->bytes_sent);\n148\t\t\tis_fin = 1;\n149\t\t\tfctest_ctx->fin_sent = 1;\n150\t\t}\n151\t\n152\t\tbuffer = picoquic_provide_stream_data_buffer(context, space, is_fin, !is_fin);\n153\t\tif (buffer != NULL) {\n154\t\t\tmemset(buffer, 0xFC, space);\n155\t\t\tfctest_ctx->bytes_sent += space;\n156\t\t}\n157\t\telse {\n158\t\t\tret = -1;\n159\t\t}\n160\t\treturn ret;\n161\t}\n162\t\n163\t/* Slow receiver call back */\n164\tint fctest_callback(picoquic_cnx_t* cnx,\n165\t\tuint64_t stream_id, uint8_t* bytes, size_t length,\n166\t\tpicoquic_call_back_event_t fin_or_event, void* callback_ctx, void* v_stream_ctx)\n167\t{\n168\t\tint ret = 0;\n169\t\tfctest_ctx_t* fctest_ctx = (fctest_ctx_t*)callback_ctx;\n170\t\tuint64_t current_time = picoquic_get_quic_time(cnx->quic);\n171\t\t/* TODO: decide what to do with the stream context */\n172\t\n173\t\tif (fctest_ctx == NULL) {\n174\t\t\treturn -1;\n175\t\t}\n176\t\n177\t\tif (ret == 0) {\n178\t\t\tswitch (fin_or_event) {\n179\t\t\tcase picoquic_callback_stream_data:\n180\t\t\tcase picoquic_callback_stream_fin:\n181\t\t\t\t/* data arrival on stream x. \n182\t\t\t\t* On server: Simulate dequeuing based on the receiver rate,\n183\t\t\t\t* then increase queue by provided amount. Monitor maximum\n184\t\t\t\t* queue length. Mark complete if stream fin.\n185\t\t\t\t*/\n186\t\t\t\tif (bytes == NULL && length != 0 && v_stream_ctx != NULL) {\n187\t\t\t\t\tret = -1;\n188\t\t\t\t}\n189\t\t\t\telse if (cnx->client_mode) {\n190\t\t\t\t\tif (stream_id == fctest_ctx->stream_id) {\n191\t\t\t\t\t\tret = fctest_receive_data(fctest_ctx, cnx, current_time, length);\n192\t\t\t\t\t\tfctest_ctx->fin_received = (fin_or_event == picoquic_callback_stream_fin);\n193\t\t\t\t\t}\n194\t\t\t\t}\n195\t\t\t\telse {\n196\t\t\t\t\tif (stream_id == fctest_ctx->stream_id && fin_or_event == picoquic_callback_stream_fin) {\n197\t\t\t\t\t\tpicoquic_mark_active_stream(cnx, stream_id, 1, NULL);\n198\t\t\t\t\t}\n199\t\t\t\t}\n200\t\t\t\tbreak;\n201\t\t\tcase picoquic_callback_stream_reset: /* Peer reset stream #x */\n202\t\t\tcase picoquic_callback_stop_sending: /* Peer asks server to reset stream #x */\n203\t\t\t\t/* Not expected in this test. Failure. */\n204\t\t\t\tbreak;\n205\t\t\tcase picoquic_callback_stateless_reset:\n206\t\t\tcase picoquic_callback_close: /* Received connection close */\n207\t\t\tcase picoquic_callback_application_close: /* Received application close */\n208\t\t\t\tfctest_ctx->is_closed = 1;\n209\t\t\t\tbreak;\n210\t\t\tcase picoquic_callback_version_negotiation:\n211\t\t\t\t/* Not expected in this test */\n212\t\t\t\tret = -1;\n213\t\t\t\tbreak;\n214\t\t\tcase picoquic_callback_stream_gap:\n215\t\t\t\t/* Gap indication, when unreliable streams are supported */\n216\t\t\t\tret = -1;\n217\t\t\t\tbreak;\n218\t\t\tcase picoquic_callback_prepare_to_send:\n219\t\t\t\t/* On the client, prepare the expected amount of data. Mark\n220\t\t\t\t* active until the expected amount is received. */\n221\t\t\t\tif (!cnx->client_mode) {\n222\t\t\t\t\tret = fctest_prepare_to_send(fctest_ctx, bytes, length);\n223\t\t\t\t}\n224\t\t\t\tbreak;\n225\t\t\tcase picoquic_callback_datagram: /* Datagram frame has been received */\n226\t\t\t\t/* Not expected in this test */\n227\t\t\t\tret = -1;\n228\t\t\t\tbreak;\n229\t\t\tcase picoquic_callback_prepare_datagram: /* Prepare the next datagram */\n230\t\t\t\t/* Not expected in this test */\n231\t\t\t\tret = -1;\n232\t\t\t\tbreak;\n233\t\t\tcase picoquic_callback_datagram_acked: /* Ack for packet carrying datagram-frame received from peer */\n234\t\t\tcase picoquic_callback_datagram_lost: /* Packet carrying datagram-frame probably lost */\n235\t\t\tcase picoquic_callback_datagram_spurious: /* Packet carrying datagram-frame was not really lost */\n236\t\t\t\t/* Not expected in this test */\n237\t\t\t\tret = -1;\n238\t\t\t\tbreak;\n239\t\t\tcase picoquic_callback_almost_ready:\n240\t\t\tcase picoquic_callback_ready:\n241\t\t\t\t/* On the client, open a \"bidir\" stream and mark it active */\n242\t\t\t\tret = fctest_start_stream(fctest_ctx, cnx);\n243\t\t\t\tbreak;\n244\t\t\tdefault:\n245\t\t\t\t/* unexpected -- just ignore. */\n246\t\t\t\tbreak;\n247\t\t\t}\n248\t\t}\n249\t\n250\t\treturn ret;\n251\t}\n252\t\n253\tint fctest_one(fctest_spec_t* spec)\n254\t{\n255\t\tint nb_trials = 0;\n256\t\tint nb_inactive = 0;\n257\t\tint was_active = 0;\n258\t\tpicoquic_test_tls_api_ctx_t* test_ctx = NULL;\n259\t\tfctest_ctx_t fctest_ctx;\n260\t\tpicoquic_connection_id_t initial_cid = { {0xfc, 0x4e, 0x54, 0, 0, 0, 0, 0}, 8 };\n261\t\tint ret = 0;\n262\t\tuint64_t timeout = 10000;\n263\t\n264\t\tinitial_cid.id[7] = spec->test_id;\n265\t\n266\t\tfctest_ctx_init(&fctest_ctx, spec);\n267\t\n268\t\tif (ret == 0) {\n269\t\t\tret = tls_api_init_ctx_ex2(&test_ctx,\n270\t\t\t\tPICOQUIC_INTERNAL_TEST_VERSION_1,\n271\t\t\t\tPICOQUIC_TEST_SNI, FCTEST_TEST_ALPN, &fctest_ctx.simulated_time, NULL, NULL, 0, 1, 0, &initial_cid, 8, 0, 0, 0);\n272\t\n273\t\t\tif (ret == 0) {\n274\t\t\t\tpicoquic_tp_t * client_tp = (picoquic_tp_t *) picoquic_get_transport_parameters(test_ctx->cnx_client, 1);\n275\t\n276\t\t\t\tclient_tp->initial_max_stream_data_bidi_local = spec->initial_credit;\n277\t\n278\t\t\t\tpicoquic_set_default_congestion_algorithm(test_ctx->qserver, spec->ccalgo);\n279\t\t\t\tpicoquic_set_congestion_algorithm(test_ctx->cnx_client, spec->ccalgo);\n280\t\n281\t\t\t\tpicoquic_set_qlog(test_ctx->qserver, \".\");\n282\t\t\t\ttest_ctx->qserver->use_long_log = 1;\n283\t\t\t\tpicoquic_set_qlog(test_ctx->qclient, \".\");\n284\t\t\t}\n285\t\t}\n286\t\n287\t\t/* The default procedure creates connections using the test callback.\n288\t\t* We want to replace that by the fctest callback */\n289\t\n290\t\tif (ret == 0) {\n291\t\t\t/* TODO: proper call back context */\n292\t\t\tpicoquic_set_default_callback(test_ctx->qserver, fctest_callback, &fctest_ctx);\n293\t\t\tpicoquic_set_callback(test_ctx->cnx_client, fctest_callback, &fctest_ctx);\n294\t\t\tif (ret == 0) {\n295\t\t\t\tret = picoquic_start_client_cnx(test_ctx->cnx_client);\n296\t\t\t}\n297\t\t}\n298\t\n299\t\tif (ret == 0) {\n300\t\t\tret = tls_api_connection_loop(test_ctx, &fctest_ctx.loss_mask, 0, &fctest_ctx.simulated_time);\n301\t\t}\n302\t\n303\t\twhile (ret == 0 && picoquic_get_cnx_state(test_ctx->cnx_client) != picoquic_state_disconnected) {\n304\t\t\t/* May need to set a timeout per flow control. */\n305\t\t\tif (fctest_ctx.bytes_buffered > 0 &&\n306\t\t\t\tfctest_ctx.simulated_time >= fctest_ctx.buffered_time + timeout) {\n307\t\t\t\tret = fctest_receive_data(&fctest_ctx, test_ctx->cnx_client, fctest_ctx.simulated_time, 0);\n308\t\t\t}\n309\t\t\t/* Progress. */\n310\t\t\tif ((ret = tls_api_one_sim_round(test_ctx, &fctest_ctx.simulated_time, fctest_ctx.simulated_time + timeout, &was_active)) != 0) {\n311\t\t\t\tbreak;\n312\t\t\t}\n313\t\n314\t\t\t/* TODO: test based on fctest context. */\n315\t\t\tif (fctest_ctx.fin_received || fctest_ctx.is_closed || fctest_ctx.error_detected) {\n316\t\t\t\tbreak;\n317\t\t\t}\n318\t\t\t\n319\t\t\tif (was_active) {\n320\t\t\t\tnb_inactive = 0;\n321\t\t\t}\n322\t\t\telse {\n323\t\t\t\tnb_inactive++;\n324\t\t\t\tif (nb_inactive > 256) {\n325\t\t\t\t\tbreak;\n326\t\t\t\t}\n327\t\t\t}\n328\t\n329\t\t\tif (++nb_trials > 1000000) {\n330\t\t\t\tret = -1;\n331\t\t\t\tbreak;\n332\t\t\t}\n333\t\t}\n334\t\n335\t\t/* check that the transfer is complete */\n336\t\tif (ret == 0 &&(!fctest_ctx.fin_received || fctest_ctx.bytes_received < spec->transfer_size)) {\n337\t\t\tDBG_PRINTF(\"Test received %\" PRIu64 \" bytes instead of %\" PRIu64, fctest_ctx.bytes_received, spec->transfer_size);\n338\t\t\tret = -1;\n339\t\t}\n340\t\n341\t\t/* TODO: check that the buffers remained within specified limits */\n342\t\tif (ret == 0 && fctest_ctx.bytes_buffered_max > spec->initial_credit + spec->credit_quantum) {\n343\t\t\tDBG_PRINTF(\"Test buffer max %\" PRIu64 \" bytes instead of %\" PRIu64, fctest_ctx.bytes_buffered_max, spec->bytes_buffered_max);\n344\t\t\tret = -1;\n345\t\t}\n346\t\n347\t\t/* Also check completion time */\n348\t\tif (ret == 0 && spec->completion_target != 0 && fctest_ctx.simulated_time > spec->completion_target) {\n349\t\t\tDBG_PRINTF(\"Test uses %llu microsec instead of %llu\", fctest_ctx.simulated_time, spec->completion_target);\n350\t\t\tret = -1;\n351\t\t}\n352\t\n353\t\tif (test_ctx != NULL) {\n354\t\t\ttls_api_delete_ctx(test_ctx);\n355\t\t\ttest_ctx = NULL;\n356\t\t}\n357\t\n358\t\treturn ret;\n359\t}\n360\t\n361\tint flow_control_test(void)\n362\t{\n363\t\tfctest_spec_t spec = { 0 };\n364\t\tspec.test_id = 1;\n365\t\tspec.transfer_size = 1000000;\n366\t\tspec.microsecs_per_byte = 10;\n367\t\tspec.credit_quantum = 0x4000;\n368\t\tspec.initial_credit = 0x10000;\n369\t\tspec.bytes_buffered_max = 0x4000;\n370\t\tspec.completion_target = 11000000;\n371\t\tspec.ccalgo = picoquic_bbr_algorithm;\n372\t\n373\t\treturn fctest_one(&spec);\n374\t}\n375\t"}]},"parent_tool_use_id":null,"session_id":"483d188f-86bb-48b4-b530-27cbba01828e","uuid":"cc8bb309-86fb-4662-a01e-6290635b9916","timestamp":"2026-05-05T03:32:13.484Z","tool_use_result":{"type":"text","file":{"filePath":"/Users/richbarn/Projects/picoquic/picoquictest/flow_control_test.c","content":"/*\n* Author: Christian Huitema\n* Copyright (c) 2025, Private Octopus, Inc.\n* All rights reserved.\n*\n* Permission to use, copy, modify, and distribute this software for any\n* purpose with or without fee is hereby granted, provided that the above\n* copyright notice and this permission notice appear in all copies.\n*\n* THIS SOFTWARE IS PROVIDED BY THE COPYRIGHT HOLDERS AND CONTRIBUTORS \"AS IS\" AND\n* ANY EXPRESS OR IMPLIED WARRANTIES, INCLUDING, BUT NOT LIMITED TO, THE IMPLIED\n* WARRANTIES OF MERCHANTABILITY AND FITNESS FOR A PARTICULAR PURPOSE ARE\n* DISCLAIMED. IN NO EVENT SHALL Private Octopus, Inc. BE LIABLE FOR ANY\n* DIRECT, INDIRECT, INCIDENTAL, SPECIAL, EXEMPLARY, OR CONSEQUENTIAL DAMAGES\n* (INCLUDING, BUT NOT LIMITED TO, PROCUREMENT OF SUBSTITUTE GOODS OR SERVICES;\n* LOSS OF USE, DATA, OR PROFITS; OR BUSINESS INTERRUPTION) HOWEVER CAUSED AND\n* ON ANY THEORY OF LIABILITY, WHETHER IN CONTRACT, STRICT LIABILITY, OR TORT\n* (INCLUDING NEGLIGENCE OR OTHERWISE) ARISING IN ANY WAY OUT OF THE USE OF THIS\n* SOFTWARE, EVEN IF ADVISED OF THE POSSIBILITY OF SUCH DAMAGE.\n*/\n\n#include \"tls_api.h\"\n#include \"picoquic_internal.h\"\n#include \"picoquictest_internal.h\"\n#include <stdlib.h>\n#include <string.h>\n\n#include \"logreader.h\"\n#include \"autoqlog.h\"\n#include \"picoquic_logger.h\"\n#include \"picoquic_bbr.h\"\n#include \"qlog.h\"\n\n/* Flow control test:\n* \n* Simulate a data receiver that can only process data slowly, and must\n* buffer whatever excess data is delivered. The test verifies that the\n* amount of data that the application must queue does not exceed a\n* preset limit, and fails the connection if it does.\n*/\n#define FCTEST_TEST_ALPN \"fctest\"\n\ntypedef struct st_fctest_spec_t {\n\tuint8_t test_id;\n\tpicoquic_congestion_algorithm_t* ccalgo;\n\tuint64_t loss_mask;\n\tuint64_t transfer_size;\n\tuint64_t microsecs_per_byte;\n\tuint64_t credit_quantum;\n\tuint64_t initial_credit;\n\tuint64_t bytes_buffered_max;\n\tuint64_t completion_target;\n} fctest_spec_t;\n\ntypedef struct st_fctest_ctx_t {\n\tuint64_t transfer_size;\n\tuint64_t microsecs_per_byte;\n\tuint64_t credit_quantum;\n\n\tuint64_t simulated_time;\n\tuint64_t loss_mask;\n\tuint64_t stream_id;\n\tuint64_t bytes_sent;\n\n\tuint64_t bytes_received;\n\tuint64_t bytes_buffered;\n\tuint64_t buffered_time;\n\tuint64_t microsec_rounding_error;\n\n\tuint64_t credits_pending;\n\n\tuint64_t bytes_buffered_max;\n\n\tint is_started;\n\tint fin_sent;\n\tint fin_received;\n\tint is_closed;\n\tint error_detected;\n} fctest_ctx_t;\n\nvoid fctest_ctx_init(fctest_ctx_t* fctest_ctx, fctest_spec_t* spec)\n{\n\tmemset(fctest_ctx, 0, sizeof(fctest_ctx_t));\n\tfctest_ctx->transfer_size = spec->transfer_size;\n\tfctest_ctx->microsecs_per_byte = spec->microsecs_per_byte;\n\tfctest_ctx->credit_quantum = spec->credit_quantum;\n\tfctest_ctx->loss_mask = spec->loss_mask;\n}\n\nint fctest_start_stream(fctest_ctx_t* fctest_ctx, picoquic_cnx_t* cnx)\n{\n\tint ret = 0;\n\n\tif (cnx->client_mode && !fctest_ctx->is_started) {\n\t\tuint8_t start[] = { 0xff, 0xfe, 0xfd, 0xfc };\n\t\tfctest_ctx->is_started = 1;\n\t\tfctest_ctx->stream_id = picoquic_get_next_local_stream_id(cnx, 0);\n\t\tret = picoquic_add_to_stream(cnx, fctest_ctx->stream_id, start, sizeof(start), 1);\n\t\tif (ret == 0) {\n\t\t\tret = picoquic_set_app_flow_control(cnx, fctest_ctx->stream_id, 1);\n\t\t}\n\t}\n\treturn ret;\n}\n\nint fctest_receive_data(fctest_ctx_t* fctest_ctx, picoquic_cnx_t* cnx, uint64_t current_time, size_t length)\n{\n\tint ret = 0;\n\tuint64_t delta_t = current_time - fctest_ctx->buffered_time + fctest_ctx->microsec_rounding_error;\n\tuint64_t processed_bytes = delta_t / fctest_ctx->microsecs_per_byte;\n\n\tif (processed_bytes >= fctest_ctx->bytes_buffered) {\n\t\tprocessed_bytes = fctest_ctx->bytes_buffered;\n\t\tfctest_ctx->bytes_buffered = 0;\n\t\tfctest_ctx->microsec_rounding_error = 0;\n\t}\n\telse {\n\t\tfctest_ctx->bytes_buffered -= processed_bytes;\n\t\tfctest_ctx->microsec_rounding_error = delta_t % fctest_ctx->microsecs_per_byte;\n\t}\n\tfctest_ctx->buffered_time = current_time;\n\tfctest_ctx->credits_pending += processed_bytes;\n\n\tif (length > 0) {\n\t\tfctest_ctx->bytes_buffered += length;\n\t\tfctest_ctx->bytes_received += length;\n\t\tif (fctest_ctx->bytes_buffered > fctest_ctx->bytes_buffered_max) {\n\t\t\tfctest_ctx->bytes_buffered_max = fctest_ctx->bytes_buffered;\n\t\t}\n\t}\n\t/* Enforcing a quantum, because dripping credits in small number will lead to\n\t * silly packet syndrome */\n\tif (fctest_ctx->credits_pending >= fctest_ctx->credit_quantum) {\n\t\tfctest_ctx->credits_pending -= fctest_ctx->credit_quantum;\n\t\tret = picoquic_open_flow_control(cnx, fctest_ctx->stream_id, fctest_ctx->credit_quantum);\n\t}\n\treturn ret;\n}\n\nstatic int fctest_prepare_to_send(fctest_ctx_t* fctest_ctx, uint8_t* context, size_t space)\n{\n\tint ret = 0;\n\tuint8_t* buffer;\n\tint is_fin = 0;\n\n\tif (fctest_ctx->bytes_sent + space >= fctest_ctx->transfer_size) {\n\t\tspace = (size_t)(fctest_ctx->transfer_size - fctest_ctx->bytes_sent);\n\t\tis_fin = 1;\n\t\tfctest_ctx->fin_sent = 1;\n\t}\n\n\tbuffer = picoquic_provide_stream_data_buffer(context, space, is_fin, !is_fin);\n\tif (buffer != NULL) {\n\t\tmemset(buffer, 0xFC, space);\n\t\tfctest_ctx->bytes_sent += space;\n\t}\n\telse {\n\t\tret = -1;\n\t}\n\treturn ret;\n}\n\n/* Slow receiver call back */\nint fctest_callback(picoquic_cnx_t* cnx,\n\tuint64_t stream_id, uint8_t* bytes, size_t length,\n\tpicoquic_call_back_event_t fin_or_event, void* callback_ctx, void* v_stream_ctx)\n{\n\tint ret = 0;\n\tfctest_ctx_t* fctest_ctx = (fctest_ctx_t*)callback_ctx;\n\tuint64_t current_time = picoquic_get_quic_time(cnx->quic);\n\t/* TODO: decide what to do with the stream context */\n\n\tif (fctest_ctx == NULL) {\n\t\treturn -1;\n\t}\n\n\tif (ret == 0) {\n\t\tswitch (fin_or_event) {\n\t\tcase picoquic_callback_stream_data:\n\t\tcase picoquic_callback_stream_fin:\n\t\t\t/* data arrival on stream x. \n\t\t\t* On server: Simulate dequeuing based on the receiver rate,\n\t\t\t* then increase queue by provided amount. Monitor maximum\n\t\t\t* queue length. Mark complete if stream fin.\n\t\t\t*/\n\t\t\tif (bytes == NULL && length != 0 && v_stream_ctx != NULL) {\n\t\t\t\tret = -1;\n\t\t\t}\n\t\t\telse if (cnx->client_mode) {\n\t\t\t\tif (stream_id == fctest_ctx->stream_id) {\n\t\t\t\t\tret = fctest_receive_data(fctest_ctx, cnx, current_time, length);\n\t\t\t\t\tfctest_ctx->fin_received = (fin_or_event == picoquic_callback_stream_fin);\n\t\t\t\t}\n\t\t\t}\n\t\t\telse {\n\t\t\t\tif (stream_id == fctest_ctx->stream_id && fin_or_event == picoquic_callback_stream_fin) {\n\t\t\t\t\tpicoquic_mark_active_stream(cnx, stream_id, 1, NULL);\n\t\t\t\t}\n\t\t\t}\n\t\t\tbreak;\n\t\tcase picoquic_callback_stream_reset: /* Peer reset stream #x */\n\t\tcase picoquic_callback_stop_sending: /* Peer asks server to reset stream #x */\n\t\t\t/* Not expected in this test. Failure. */\n\t\t\tbreak;\n\t\tcase picoquic_callback_stateless_reset:\n\t\tcase picoquic_callback_close: /* Received connection close */\n\t\tcase picoquic_callback_application_close: /* Received application close */\n\t\t\tfctest_ctx->is_closed = 1;\n\t\t\tbreak;\n\t\tcase picoquic_callback_version_negotiation:\n\t\t\t/* Not expected in this test */\n\t\t\tret = -1;\n\t\t\tbreak;\n\t\tcase picoquic_callback_stream_gap:\n\t\t\t/* Gap indication, when unreliable streams are supported */\n\t\t\tret = -1;\n\t\t\tbreak;\n\t\tcase picoquic_callback_prepare_to_send:\n\t\t\t/* On the client, prepare the expected amount of data. Mark\n\t\t\t* active until the expected amount is received. */\n\t\t\tif (!cnx->client_mode) {\n\t\t\t\tret = fctest_prepare_to_send(fctest_ctx, bytes, length);\n\t\t\t}\n\t\t\tbreak;\n\t\tcase picoquic_callback_datagram: /* Datagram frame has been received */\n\t\t\t/* Not expected in this test */\n\t\t\tret = -1;\n\t\t\tbreak;\n\t\tcase picoquic_callback_prepare_datagram: /* Prepare the next datagram */\n\t\t\t/* Not expected in this test */\n\t\t\tret = -1;\n\t\t\tbreak;\n\t\tcase picoquic_callback_datagram_acked: /* Ack for packet carrying datagram-frame received from peer */\n\t\tcase picoquic_callback_datagram_lost: /* Packet carrying datagram-frame probably lost */\n\t\tcase picoquic_callback_datagram_spurious: /* Packet carrying datagram-frame was not really lost */\n\t\t\t/* Not expected in this test */\n\t\t\tret = -1;\n\t\t\tbreak;\n\t\tcase picoquic_callback_almost_ready:\n\t\tcase picoquic_callback_ready:\n\t\t\t/* On the client, open a \"bidir\" stream and mark it active */\n\t\t\tret = fctest_start_stream(fctest_ctx, cnx);\n\t\t\tbreak;\n\t\tdefault:\n\t\t\t/* unexpected -- just ignore. */\n\t\t\tbreak;\n\t\t}\n\t}\n\n\treturn ret;\n}\n\nint fctest_one(fctest_spec_t* spec)\n{\n\tint nb_trials = 0;\n\tint nb_inactive = 0;\n\tint was_active = 0;\n\tpicoquic_test_tls_api_ctx_t* test_ctx = NULL;\n\tfctest_ctx_t fctest_ctx;\n\tpicoquic_connection_id_t initial_cid = { {0xfc, 0x4e, 0x54, 0, 0, 0, 0, 0}, 8 };\n\tint ret = 0;\n\tuint64_t timeout = 10000;\n\n\tinitial_cid.id[7] = spec->test_id;\n\n\tfctest_ctx_init(&fctest_ctx, spec);\n\n\tif (ret == 0) {\n\t\tret = tls_api_init_ctx_ex2(&test_ctx,\n\t\t\tPICOQUIC_INTERNAL_TEST_VERSION_1,\n\t\t\tPICOQUIC_TEST_SNI, FCTEST_TEST_ALPN, &fctest_ctx.simulated_time, NULL, NULL, 0, 1, 0, &initial_cid, 8, 0, 0, 0);\n\n\t\tif (ret == 0) {\n\t\t\tpicoquic_tp_t * client_tp = (picoquic_tp_t *) picoquic_get_transport_parameters(test_ctx->cnx_client, 1);\n\n\t\t\tclient_tp->initial_max_stream_data_bidi_local = spec->initial_credit;\n\n\t\t\tpicoquic_set_default_congestion_algorithm(test_ctx->qserver, spec->ccalgo);\n\t\t\tpicoquic_set_congestion_algorithm(test_ctx->cnx_client, spec->ccalgo);\n\n\t\t\tpicoquic_set_qlog(test_ctx->qserver, \".\");\n\t\t\ttest_ctx->qserver->use_long_log = 1;\n\t\t\tpicoquic_set_qlog(test_ctx->qclient, \".\");\n\t\t}\n\t}\n\n\t/* The default procedure creates connections using the test callback.\n\t* We want to replace that by the fctest callback */\n\n\tif (ret == 0) {\n\t\t/* TODO: proper call back context */\n\t\tpicoquic_set_default_callback(test_ctx->qserver, fctest_callback, &fctest_ctx);\n\t\tpicoquic_set_callback(test_ctx->cnx_client, fctest_callback, &fctest_ctx);\n\t\tif (ret == 0) {\n\t\t\tret = picoquic_start_client_cnx(test_ctx->cnx_client);\n\t\t}\n\t}\n\n\tif (ret == 0) {\n\t\tret = tls_api_connection_loop(test_ctx, &fctest_ctx.loss_mask, 0, &fctest_ctx.simulated_time);\n\t}\n\n\twhile (ret == 0 && picoquic_get_cnx_state(test_ctx->cnx_client) != picoquic_state_disconnected) {\n\t\t/* May need to set a timeout per flow control. */\n\t\tif (fctest_ctx.bytes_buffered > 0 &&\n\t\t\tfctest_ctx.simulated_time >= fctest_ctx.buffered_time + timeout) {\n\t\t\tret = fctest_receive_data(&fctest_ctx, test_ctx->cnx_client, fctest_ctx.simulated_time, 0);\n\t\t}\n\t\t/* Progress. */\n\t\tif ((ret = tls_api_one_sim_round(test_ctx, &fctest_ctx.simulated_time, fctest_ctx.simulated_time + timeout, &was_active)) != 0) {\n\t\t\tbreak;\n\t\t}\n\n\t\t/* TODO: test based on fctest context. */\n\t\tif (fctest_ctx.fin_received || fctest_ctx.is_closed || fctest_ctx.error_detected) {\n\t\t\tbreak;\n\t\t}\n\t\t\n\t\tif (was_active) {\n\t\t\tnb_inactive = 0;\n\t\t}\n\t\telse {\n\t\t\tnb_inactive++;\n\t\t\tif (nb_inactive > 256) {\n\t\t\t\tbreak;\n\t\t\t}\n\t\t}\n\n\t\tif (++nb_trials > 1000000) {\n\t\t\tret = -1;\n\t\t\tbreak;\n\t\t}\n\t}\n\n\t/* check that the transfer is complete */\n\tif (ret == 0 &&(!fctest_ctx.fin_received || fctest_ctx.bytes_received < spec->transfer_size)) {\n\t\tDBG_PRINTF(\"Test received %\" PRIu64 \" bytes instead of %\" PRIu64, fctest_ctx.bytes_received, spec->transfer_size);\n\t\tret = -1;\n\t}\n\n\t/* TODO: check that the buffers remained within specified limits */\n\tif (ret == 0 && fctest_ctx.bytes_buffered_max > spec->initial_credit + spec->credit_quantum) {\n\t\tDBG_PRINTF(\"Test buffer max %\" PRIu64 \" bytes instead of %\" PRIu64, fctest_ctx.bytes_buffered_max, spec->bytes_buffered_max);\n\t\tret = -1;\n\t}\n\n\t/* Also check completion time */\n\tif (ret == 0 && spec->completion_target != 0 && fctest_ctx.simulated_time > spec->completion_target) {\n\t\tDBG_PRINTF(\"Test uses %llu microsec instead of %llu\", fctest_ctx.simulated_time, spec->completion_target);\n\t\tret = -1;\n\t}\n\n\tif (test_ctx != NULL) {\n\t\ttls_api_delete_ctx(test_ctx);\n\t\ttest_ctx = NULL;\n\t}\n\n\treturn ret;\n}\n\nint flow_control_test(void)\n{\n\tfctest_spec_t spec = { 0 };\n\tspec.test_id = 1;\n\tspec.transfer_size = 1000000;\n\tspec.microsecs_per_byte = 10;\n\tspec.credit_quantum = 0x4000;\n\tspec.initial_credit = 0x10000;\n\tspec.bytes_buffered_max = 0x4000;\n\tspec.completion_target = 11000000;\n\tspec.ccalgo = picoquic_bbr_algorithm;\n\n\treturn fctest_one(&spec);\n}\n","numLines":375,"startLine":1,"totalLines":375}}}
