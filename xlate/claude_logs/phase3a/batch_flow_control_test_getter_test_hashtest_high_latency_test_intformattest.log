{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01Ra3JwnJxbuRjE2AQkKM2EU","type":"tool_result","content":"1\t//! Test cases for `picoquictest/hashtest.c`.\n2\t\n3\t#![allow(non_snake_case)]\n4\t\n5\t/// C: `siphash_test` in `picoquictest/hashtest.c`.\n6\t///\n7\t/// Known-answer test for [`crate::siphash::siphash`].  The C\n8\t/// reference values come from the upstream public-domain release.\n9\t#[test]\n10\tfn siphash() {\n11\t    use crate::siphash::siphash;\n12\t\n13\t    let mut test = [0u8; 1024];\n14\t    let mut k = [0u8; 16];\n15\t\n16\t    // Mirror the C `hash_test_init`: deterministic data + key.\n17\t    for (i, b) in test.iter_mut().enumerate() {\n18\t        *b = (i + (i >> 8)) as u8;\n19\t    }\n20\t    let k_len = k.len();\n21\t    for (i, b) in k.iter_mut().enumerate() {\n22\t        *b = (k_len - i) as u8;\n23\t    }\n24\t\n25\t    let lengths = [1, 3, 7, 8, 12, 16, 17, 31, 127, 257, 515, 1024];\n26\t    let expected: [u64; 12] = [\n27\t        0xa9b7_8693_5f98_d6b8,\n28\t        0x3fb6_4f2d_81eb_f107,\n29\t        0xcd34_491a_7b43_7e1b,\n30\t        0x5fbe_9177_0928_6bc4,\n31\t        0xb2cc_76e0_f81d_6e2f,\n32\t        0x09e6_9c0f_7075_3651,\n33\t        0xc615_b534_9acc_0cc2,\n34\t        0x9653_79fb_0e26_e150,\n35\t        0x85a2_86cf_c4a6_2574,\n36\t        0x5f77_4367_aeea_9f83,\n37\t        0xd04e_e1d4_20e9_bc22,\n38\t        0x0a7a_d665_5680_779e,\n39\t    ];\n40\t\n41\t    for (i, &len) in lengths.iter().enumerate() {\n42\t        let h = siphash(&test[..len], &k);\n43\t        assert_eq!(h, expected[i], \"siphash[{i}] for len={len}\");\n44\t    }\n45\t}\n46\t\n47\t/// C: `picohash_test` in `picoquictest/hashtest.c`.\n48\t///\n49\t/// Drives the standard hash-table API ([`crate::hash::HashTable`])\n50\t/// through inserts, lookups, collision-handling, and deletions.\n51\t/// The C body uses a custom hash function `hashtest_hash` and a\n52\t/// custom comparator; the Rust counterpart parameterises on\n53\t/// `Hash