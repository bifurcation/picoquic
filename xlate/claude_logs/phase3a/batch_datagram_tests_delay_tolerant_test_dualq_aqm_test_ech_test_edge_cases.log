{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01B2MjSM5jYCweRQ3A4TSsGe","type":"tool_result","content":"1\t//! Test cases for `picoquictest/cpu_limited.c`.\n2\t//!\n3\t//! Exercises CPU-limited client scenarios with different congestion-control\n4\t//! algorithms (NewReno, Cubic, BBR) and stream patterns (small vs. large\n5\t//! transfers, batched initial streams, flow-control-limited safe mode).\n6\t//!\n7\t//! The simulator models a client that can only process a fixed number of\n8\t//! packets per second: each receive or send call consumes `incoming_cpu_time`\n9\t//! / `prepare_cpu_time` microseconds, and arrivals during that window back up\n10\t//! in a bounded queue.\n11\t\n12\t#![allow(non_snake_case)]\n13\t\n14\tuse super::util::{TestApiStreamDesc, tls_api_init_ctx_ex, tls_api_one_scenario_body};\n15\tuse crate::internal::Version;\n16\tuse crate::{CongestionAlgorithm, ConnectionId, Instant, get_congestion_algorithm};\n17\t\n18\t// ---------------------------------------------------------------------------\n19\t// Shared config type.  C: `limited_test_config_t`.\n20\t\n21\tstruct LimitedTestConfig {\n22\t    test_id: u8,\n23\t    ccalgo: &'static CongestionAlgorithm,\n24\t    incoming_cpu_time: u64,\n25\t    prepare_cpu_time: u64,\n26\t    packet_queue_max: usize,\n27\t    nb_initial_steps: usize,\n28\t    nb_final_steps: usize,\n29\t    max_completion_time: u64,\n30\t    microsec_latency: u64,\n31\t    picosec_per_byte: u64,\n32\t    flow_control_max: u64,\n33\t    nb_losses_max: u64,\n34\t}\n35\t\n36\t/// Build a default limited-client config.  C: `limited_config_set_default`.\n37\tfn limited_config_default(test_id: u8) -> LimitedTestConfig {\n38\t    LimitedTestConfig {\n39\t        test_id,\n40\t        ccalgo: get_congestion_algorithm(\"newreno\").expect(\"newreno algo\"),\n41\t        incoming_cpu_time: 2_000,\n42\t        prepare_cpu_time: 2_000,\n43\t        packet_queue_max: 16,\n44\t        nb_final_steps: 2,\n45\t        nb_initial_steps: 0,\n46\t        max_completion_time: 0,\n47\t        microsec_latency: 50_000,\n48\t        picosec_per_byte: 80_000, // 100 Mbps\n49\t        flow_control_max: 0,\n50\t        nb_losses_max: 0,\n51\t    }\n52\t}\n53\t\n54\t/// Build a scenario of `nb_initial_steps` small (32 KB response) streams\n55\t/// followed by `nb_final_steps` large (1 MB response) streams.\n56\t/// C: `limited_client_create_scenario`.\n57\tfn limited_client_create_scenario(\n58\t    nb_initial_steps: usize,\n59\t    nb_final_steps: usize,\n60\t) -> Vec<TestApiStreamDesc> {\n61\t    let nb_steps = nb_initial_steps + nb_final_steps;\n62\t    let mut scenario = Vec::with_capacity(nb_steps);\n63\t    let mut previous_stream_id: u64 = 0;\n64\t\n65\t    for _ in 0..nb_initial_steps {\n66\t        let old_prev = previous_stream_id;\n67\t        previous_stream_id += 4;\n68\t        scenario.push(TestApiStreamDesc {\n69\t            stream_id: previous_stream_id,\n70\t            previous_stream_id: old_prev,\n71\t            q_len: 257,\n72\t            r_len: 32_000,\n73\t        });\n74\t    }\n75\t\n76\t    // Note: previous_stream_id is held constant across the final loop, and\n77\t    // stream IDs are spaced by the loop index — faithfully transcribed from C.\n78\t    for i in nb_initial_steps..nb_steps {\n79\t        scenario.push(TestApiStreamDesc {\n80\t            stream_id: previous_stream_id + 4 * (i as u64 + 1),\n81\t            previous_stream_id,\n82\t            q_len: 257,\n83\t            r_len: 1_000_000,\n84\t        });\n85\t    }\n86\t\n87\t    scenario\n88\t}\n89\t\n90\t/// Run one cpu-limited client scenario end-to-end.\n91\t/// C: `limited_client_test_one`.\n92\tfn limited_client_test_one(config: LimitedTestConfig) {\n93\t    let mut simulated_time = Instant::from_ticks(0);\n94\t\n95\t    let initial_cid =\n96\t        ConnectionId::clone_from_slice(&[0x11, 0x01, 0xc1, 0x1e, 0x44, config.test_id, 0, 0])\n97\t            .expect(\"8-byte CID\");\n98\t\n99\t    let scenario = limited_client_create_scenario(config.nb_initial_steps, config.nb_final_steps);\n100\t\n101\t    let mut test_ctx = tls_api_init_ctx_ex(\n102\t        &mut simulated_time,\n103\t        Version::InternalTest1 as u32,\n104\t        None,\n105\t        Some(&initial_cid),\n106\t    )\n107\t    .expect(\"tls_api_init_ctx_ex\");\n108\t\n109\t    let ccalgo = config.ccalgo;\n110\t    test_ctx.qserver.set_default_congestion_algorithm(ccalgo);\n111\t    test_ctx.cnx_client().set_congestion_algorithm(ccalgo);\n112\t\n113\t    test_ctx.client_endpoint.incoming_cpu_time = config.incoming_cpu_time;\n114\t    test_ctx.client_endpoint.prepare_cpu_time = config.prepare_cpu_time;\n115\t    test_ctx.client_endpoint.packet_queue_max = config.packet_queue_max;\n116\t\n117\t    test_ctx.qserver.use_long_log = true;\n118\t    test_ctx.qserver.set_qlog(\".\").ok();\n119\t    test_ctx.qclient.use_long_log = true;\n120\t    test_ctx.qclient.set_qlog(\".\").ok();\n121\t\n122\t    test_ctx.c_to_s_link.microsec_latency = config.microsec_latency;\n123\t    test_ctx.c_to_s_link.picosec_per_byte = config.picosec_per_byte;\n124\t    test_ctx.s_to_c_link.microsec_latency = config.microsec_latency;\n125\t    test_ctx.s_to_c_link.picosec_per_byte = config.picosec_per_byte;\n126\t\n127\t    if config.flow_control_max != 0 {\n128\t        test_ctx\n129\t            .qclient\n130\t            .set_max_data_control(config.flow_control_max);"}]},"parent_tool_use_id":null,"session_id":"17072f18-9969-498e-bec6-45838e44ca80","uuid":"47c33314-1433-42a3-a4d2-b049cfac1844","timestamp":"2026-05-05T03:05:30.258Z","tool_use_result":{"type":"text","file":{"filePath":"/Users/richbarn/Projects/picoquic/rs/fq/src/tests/cpu_limited.rs","content":"//! Test cases for `picoquictest/cpu_limited.c`.\n//!\n//! Exercises CPU-limited client scenarios with different congestion-control\n//! algorithms (NewReno, Cubic, BBR) and stream patterns (small vs. large\n//! transfers, batched initial streams, flow-control-limited safe mode).\n//!\n//! The simulator models a client that can only process a fixed number of\n//! packets per second: each receive or send call consumes `incoming_cpu_time`\n//! / `prepare_cpu_time` microseconds, and arrivals during that window back up\n//! in a bounded queue.\n\n#![allow(non_snake_case)]\n\nuse super::util::{TestApiStreamDesc, tls_api_init_ctx_ex, tls_api_one_scenario_body};\nuse crate::internal::Version;\nuse crate::{CongestionAlgorithm, ConnectionId, Instant, get_congestion_algorithm};\n\n// ---------------------------------------------------------------------------\n// Shared config type.  C: `limited_test_config_t`.\n\nstruct LimitedTestConfig {\n    test_id: u8,\n    ccalgo: &'static CongestionAlgorithm,\n    incoming_cpu_time: u64,\n    prepare_cpu_time: u64,\n    packet_queue_max: usize,\n    nb_initial_steps: usize,\n    nb_final_steps: usize,\n    max_completion_time: u64,\n    microsec_latency: u64,\n    picosec_per_byte: u64,\n    flow_control_max: u64,\n    nb_losses_max: u64,\n}\n\n/// Build a default limited-client config.  C: `limited_config_set_default`.\nfn limited_config_default(test_id: u8) -> LimitedTestConfig {\n    LimitedTestConfig {\n        test_id,\n        ccalgo: get_congestion_algorithm(\"newreno\").expect(\"newreno algo\"),\n        incoming_cpu_time: 2_000,\n        prepare_cpu_time: 2_000,\n        packet_queue_max: 16,\n        nb_final_steps: 2,\n        nb_initial_steps: 0,\n        max_completion_time: 0,\n        microsec_latency: 50_000,\n        picosec_per_byte: 80_000, // 100 Mbps\n        flow_control_max: 0,\n        nb_losses_max: 0,\n    }\n}\n\n/// Build a scenario of `nb_initial_steps` small (32 KB response) streams\n/// followed by `nb_final_steps` large (1 MB response) streams.\n/// C: `limited_client_create_scenario`.\nfn limited_client_create_scenario(\n    nb_initial_steps: usize,\n    nb_final_steps: usize,\n) -> Vec<TestApiStreamDesc> {\n    let nb_steps = nb_initial_steps + nb_final_steps;\n    let mut scenario = Vec::with_capacity(nb_steps);\n    let mut previous_stream_id: u64 = 0;\n\n    for _ in 0..nb_initial_steps {\n        let old_prev = previous_stream_id;\n        previous_stream_id += 4;\n        scenario.push(TestApiStreamDesc {\n            stream_id: previous_stream_id,\n            previous_stream_id: old_prev,\n            q_len: 257,\n            r_len: 32_000,\n        });\n    }\n\n    // Note: previous_stream_id is held constant across the final loop, and\n    // stream IDs are spaced by the loop index — faithfully transcribed from C.\n    for i in nb_initial_steps..nb_steps {\n        scenario.push(TestApiStreamDesc {\n            stream_id: previous_stream_id + 4 * (i as u64 + 1),\n            previous_stream_id,\n            q_len: 257,\n            r_len: 1_000_000,\n        });\n    }\n\n    scenario\n}\n\n/// Run one cpu-limited client scenario end-to-end.\n/// C: `limited_client_test_one`.\nfn limited_client_test_one(config: LimitedTestConfig) {\n    let mut simulated_time = Instant::from_ticks(0);\n\n    let initial_cid =\n        ConnectionId::clone_from_slice(&[0x11, 0x01, 0xc1, 0x1e, 0x44, config.test_id, 0, 0])\n            .expect(\"8-byte CID\");\n\n    let scenario = limited_client_create_scenario(config.nb_initial_steps, config.nb_final_steps);\n\n    let mut test_ctx = tls_api_init_ctx_ex(\n        &mut simulated_time,\n        Version::InternalTest1 as u32,\n        None,\n        Some(&initial_cid),\n    )\n    .expect(\"tls_api_init_ctx_ex\");\n\n    let ccalgo = config.ccalgo;\n    test_ctx.qserver.set_default_congestion_algorithm(ccalgo);\n    test_ctx.cnx_client().set_congestion_algorithm(ccalgo);\n\n    test_ctx.client_endpoint.incoming_cpu_time = config.incoming_cpu_time;\n    test_ctx.client_endpoint.prepare_cpu_time = config.prepare_cpu_time;\n    test_ctx.client_endpoint.packet_queue_max = config.packet_queue_max;\n\n    test_ctx.qserver.use_long_log = true;\n    test_ctx.qserver.set_qlog(\".\").ok();\n    test_ctx.qclient.use_long_log = true;\n    test_ctx.qclient.set_qlog(\".\").ok();\n\n    test_ctx.c_to_s_link.microsec_latency = config.microsec_latency;\n    test_ctx.c_to_s_link.picosec_per_byte = config.picosec_per_byte;\n    test_ctx.s_to_c_link.microsec_latency = config.microsec_latency;\n    test_ctx.s_to_c_link.picosec_per_byte = config.picosec_per_byte;\n\n    if config.flow_control_max != 0 {\n        test_ctx\n            .qclient\n            .set_max_data_control(config.flow_control_max);","numLines":130,"startLine":1,"totalLines":206}}}
