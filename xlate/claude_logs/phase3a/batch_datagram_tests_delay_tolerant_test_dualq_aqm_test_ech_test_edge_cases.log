{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01M7uyg9jvfGPniJ4KEEi6UV","type":"tool_result","content":"1\t/*\n2\t* Author: Christian Huitema\n3\t* Copyright (c) 2025, Private Octopus, Inc.\n4\t* All rights reserved.\n5\t*\n6\t* Permission to use, copy, modify, and distribute this software for any\n7\t* purpose with or without fee is hereby granted, provided that the above\n8\t* copyright notice and this permission notice appear in all copies.\n9\t*\n10\t* THIS SOFTWARE IS PROVIDED BY THE COPYRIGHT HOLDERS AND CONTRIBUTORS \"AS IS\" AND\n11\t* ANY EXPRESS OR IMPLIED WARRANTIES, INCLUDING, BUT NOT LIMITED TO, THE IMPLIED\n12\t* WARRANTIES OF MERCHANTABILITY AND FITNESS FOR A PARTICULAR PURPOSE ARE\n13\t* DISCLAIMED. IN NO EVENT SHALL Private Octopus, Inc. BE LIABLE FOR ANY\n14\t* DIRECT, INDIRECT, INCIDENTAL, SPECIAL, EXEMPLARY, OR CONSEQUENTIAL DAMAGES\n15\t* (INCLUDING, BUT NOT LIMITED TO, PROCUREMENT OF SUBSTITUTE GOODS OR SERVICES;\n16\t* LOSS OF USE, DATA, OR PROFITS; OR BUSINESS INTERRUPTION) HOWEVER CAUSED AND\n17\t* ON ANY THEORY OF LIABILITY, WHETHER IN CONTRACT, STRICT LIABILITY, OR TORT\n18\t* (INCLUDING NEGLIGENCE OR OTHERWISE) ARISING IN ANY WAY OUT OF THE USE OF THIS\n19\t* SOFTWARE, EVEN IF ADVISED OF THE POSSIBILITY OF SUCH DAMAGE.\n20\t*/\n21\t\n22\t#include \"picoquic_internal.h\"\n23\t#include \"picoquic_utils.h\"\n24\t#include \"picosocks.h\"\n25\t#include \"tls_api.h\"\n26\t#include \"picoquictest_internal.h\"\n27\t#ifdef _WINDOWS\n28\t#include \"wincompat.h\"\n29\t#pragma warning(disable:4204)\n30\t#endif\n31\t#include <picotls.h>\n32\t#ifdef _WINDOWS\n33\t#include <picotls\\pembase64.h>\n34\t#include <picotls\\minicrypto.h>\n35\t#else\n36\t#include <picotls/pembase64.h>\n37\t#include <picotls/minicrypto.h>\n38\t#endif\n39\t#include <stddef.h>\n40\t#include <stdlib.h>\n41\t#include <string.h>\n42\t#include \"picoquictest.h\"\n43\ttypedef const struct st_ptls_cipher_suite_t ptls_cipher_suite_t;\n44\t#include \"picoquic_crypto_provider_api.h\"\n45\t#include \"autoqlog.h\"\n46\t#include \"picoquic_logger.h\"\n47\t\n48\t /* ech_config_test:\n49\t * Create an ech configuration list, i.e., the content of an HTTPS \"ech=\" parameter.\n50\t  */\n51\t#define ECH_CONFIG_FILE_TXT \"ech_config.txt\"\n52\t\n53\tint picoquic_ech_read_config(ptls_buffer_t* config, char const* file_name);\n54\tint picoquic_ech_create_config_from_public_key(uint8_t** config, size_t* config_len, char const* public_key_file, char const* public_name);\n55\tint picoquic_ech_create_config_from_private_key(uint8_t** config, size_t* config_len, char const* private_key_file, char const* public_name);\n56\tint picoquic_ech_save_config(uint8_t* config, size_t config_len, char const* file_name);\n57\t\n58\tint ech_test_check_buf(uint8_t* config, size_t config_len, char const* ref_file_name)\n59\t{\n60\t    int ret = 0;\n61\t    char test_ref_file[512];\n62\t\n63\t    ret = picoquic_get_input_path(test_ref_file, sizeof(test_ref_file), picoquic_solution_dir,\n64\t        ref_file_name);\n65\t\n66\t    if (ret != 0) {\n67\t        DBG_PRINTF(\"Cannot find <%s> file in <%s>, err: %d (0x%x)\", ref_file_name, picoquic_solution_dir, ret, ret);\n68\t    }\n69\t    else {\n70\t        ptls_buffer_t config_buffer;\n71\t        ptls_buffer_init(&config_buffer, \"\", 0);\n72\t        ret = picoquic_ech_read_config(&config_buffer, test_ref_file);\n73\t        if (ret != 0) {\n74\t            DBG_PRINTF(\"Cannot read reference for <%s> from <%s>, err: %d (0x%x)\", ref_file_name, test_ref_file, ret, ret);\n75\t        }\n76\t        else {\n77\t            if (config_buffer.off != config_len ||\n78\t                memcmp(config_buffer.base, config, config_len) != 0) {\n79\t                DBG_PRINTF(\"Data does not match reference for <%s> from <%s>, len = %zu vs %zu\",\n80\t                    ref_file_name, test_ref_file, config_len, config_buffer.off);\n81\t                ret = -1;\n82\t            }\n83\t        }\n84\t        ptls_buffer_dispose(&config_buffer);\n85\t    }\n86\t    return ret;\n87\t}\n88\t\n89\tint ech_config_test(void)\n90\t{\n91\t    int ret = 0;\n92\t    char test_server_pub_key_file[512];\n93\t    const char* public_name = \"test.example.com\";\n94\t    uint8_t* config = NULL;\n95\t    size_t config_len = 0;\n96\t\n97\t    if (picoquic_hpke_kems[0] == NULL) {\n98\t        picoquic_tls_api_init();\n99\t    }\n100\t\n101\t    ret = picoquic_get_input_path(test_server_pub_key_file, sizeof(test_server_pub_key_file), picoquic_solution_dir,\n102\t        PICOQUIC_TEST_ECH_PUB_KEY);\n103\t    if (ret != 0) {\n104\t        DBG_PRINTF(\"Cannot find pub_key file in <%s>, err: %d (0x%x)\", picoquic_solution_dir, ret, ret);\n105\t    }\n106\t    else if ((ret = picoquic_ech_create_config_from_public_key(&config, &config_len, test_server_pub_key_file, public_name)) != 0) {\n107\t        DBG_PRINTF(\"Cannot create ECH record from <%s>, err: %d (0x%x)\", test_server_pub_key_file, ret, ret);\n108\t    }\n109\t    /* Save a config representation in ech_config.txt */\n110\t    if (ret == 0) {\n111\t        ret = picoquic_ech_save_config(config, config_len, ECH_CONFIG_FILE_TXT);\n112\t        if (ret == 0) {\n113\t            ret = ech_test_check_buf(config, config_len, PICOQUIC_TEST_ECH_CONFIG_REF);\n114\t        }\n115\t    }\n116\t\n117\t    if (config != NULL) {\n118\t        free(config);\n119\t    }\n120\t\n121\t    return ret;\n122\t}\n123\t\n124\tint ech_config_p_test(void)\n125\t{\n126\t    int ret = 0;\n127\t    char test_server_key_file[512];\n128\t    const char* public_name = \"test.example.com\";\n129\t    uint8_t* config = NULL;\n130\t    size_t config_len = 0;\n131\t\n132\t    if (picoquic_hpke_kems[0] == NULL) {\n133\t        picoquic_tls_api_init();\n134\t    }\n135\t\n136\t    ret = picoquic_get_input_path(test_server_key_file, sizeof(test_server_key_file), picoquic_solution_dir,\n137\t        PICOQUIC_TEST_ECH_PRIVATE_KEY);\n138\t    if (ret != 0) {\n139\t        DBG_PRINTF(\"Cannot locate %s\", PICOQUIC_TEST_ECH_PRIVATE_KEY);\n140\t    }\n141\t    else if ((ret = picoquic_ech_create_config_from_private_key(&config, &config_len, test_server_key_file, public_name)) != 0) {\n142\t        DBG_PRINTF(\"Cannot create ECH record from <%s>, err: %d (0x%x)\", test_server_key_file, ret, ret);\n143\t    }\n144\t\n145\t    /* Save a config representation in ech_config.txt */\n146\t    if (ret == 0) {\n147\t        ret = picoquic_ech_save_config(config, config_len, ECH_CONFIG_FILE_TXT);\n148\t        if (ret == 0) {\n149\t            ret = ech_test_check_buf(config, config_len, PICOQUIC_TEST_ECH_CONFIG_REF);\n150\t        }\n151\t    }\n152\t\n153\t    if (config != NULL) {\n154\t        free(config);\n155\t    }\n156\t\n157\t    return ret;\n158\t}\n159\t\n160\t#if 0\n161\t/* ECH test of config from CERT */\n162\tint ech_cert_test(void)\n163\t{\n164\t    int ret = 0;\n165\t    char test_server_cert_file[512];\n166\t    uint8_t* config = NULL;\n167\t    size_t config_len = 0;\n168\t\n169\t    if (picoquic_hpke_kems[0] == NULL) {\n170\t        picoquic_tls_api_init();\n171\t    }\n172\t    if ((ret = picoquic_get_input_path(test_server_cert_file, sizeof(test_server_cert_file), picoquic_solution_dir,\n173\t        PICOQUIC_TEST_ECH_CERT)) != 0) {\n174\t        DBG_PRINTF(\"Cannot find cert file in <%s>, err: %d (0x%x)\", picoquic_solution_dir, ret, ret);\n175\t    }\n176\t    else if ((ret = picoquic_ech_create_config_from_cert(&config, &config_len, test_server_cert_file, \"test.example.com\")) != 0) {\n177\t        DBG_PRINTF(\"Cannot create config from cert file in <%s>, err: %d (0x%x)\", test_server_cert_file, ret, ret);\n178\t    }\n179\t    else {\n180\t        ptls_iovec_t io_config = { .base = config, .len = config_len };\n181\t        ret = ech_test_check_buf(io_config, PICOQUIC_TEST_ECH_CONFIG_REF);\n182\t        free(config);\n183\t    }\n184\t\n185\t    return ret;\n186\t}\n187\t#endif\n188\t/* ECH end to end test. Create a connection, verify that the proper files\n189\t* are returned.\n190\t */\n191\t\n192\ttypedef struct st_ech_e2e_spec_t {\n193\t    int expect_success;\n194\t    int expect_grease;\n195\t    int no_ech_server;\n196\t    int complete_cnx;\n197\t    int try_twice;\n198\t} ech_e2e_spec_t;\n199\t\n200\tint ech_test_check_retry_config(picoquic_cnx_t* cnx,\n201\t    uint8_t* config, size_t config_len)\n202\t{\n203\t    int ret = 0;\n204\t    uint8_t* retry_config;\n205\t    size_t retry_config_len;\n206\t\n207\t    picoquic_ech_get_retry_config(cnx, &retry_config, &retry_config_len);\n208\t\n209\t    if (retry_config == NULL ||\n210\t        retry_config_len != config_len ||\n211\t        memcmp(retry_config, config, config_len) != 0) {\n212\t        ret = -1;\n213\t    }\n214\t    return ret;\n215\t}\n216\t\n217\t#define ECH_TICKET_FILE_NAME \"ech_ticket_store.bin\"\n218\t\n219\tstatic test_api_stream_desc_t ech_scenario_small[] = {\n220\t    { 4, 0, 256, 1000 }\n221\t};\n222\t\n223\tint ech_test_complete_cnx(picoquic_test_tls_api_ctx_t* test_ctx, uint64_t* loss_mask, uint64_t* simulated_time)\n224\t{\n225\t    /* load a small scenario */\n226\t    int ret = test_api_init_send_recv_scenario(test_ctx, ech_scenario_small, sizeof(ech_scenario_small));\n227\t\n228\t    /* Perform a data sending loop */\n229\t    if (ret == 0) {\n230\t        ret = tls_api_data_sending_loop(test_ctx, loss_mask, simulated_time, 0);\n231\t    }\n232\t\n233\t    /* Before closing, wait for the session ticket to arrive */\n234\t    ret = session_resume_wait_for_ticket(test_ctx, simulated_time);\n235\t\n236\t    /* verify that the transmission was complete */\n237\t    if (ret == 0) {\n238\t        ret = tls_api_one_scenario_body_verify(test_ctx, simulated_time, 1000000);\n239\t    }\n240\t\n241\t    /* Verify that the session ticket has been received correctly */\n242\t    if (ret == 0) {\n243\t        if (test_ctx->qclient->p_first_ticket == NULL) {\n244\t            DBG_PRINTF(\"%s\", \"no ticket received.\");\n245\t            ret = -1;\n246\t        }\n247\t        else {\n248\t            ret = picoquic_save_tickets(test_ctx->qclient->p_first_ticket, *simulated_time, ECH_TICKET_FILE_NAME);\n249\t            if (ret != 0) {\n250\t                DBG_PRINTF(\"ticket save error (0x%x).\\n\", ret);\n251\t            }\n252\t        }\n253\t    }\n254\t\n255\t    return ret;\n256\t}\n257\t\n258\t\n259\tint ech_e2e_second(picoquic_test_tls_api_ctx_t* test_ctx, ptls_buffer_t *ech_config_buf, uint64_t * loss_mask, uint64_t* simulated_time)\n260\t{\n261\t    int ret = 0;\n262\t\n263\t    /* We should verify that 0RTT works for the 2nd connection */\n264\t    picoquic_delete_cnx(test_ctx->cnx_client);\n265\t    test_ctx->cnx_client = NULL;\n266\t    if (test_ctx->cnx_server != NULL) {\n267\t        picoquic_delete_cnx(test_ctx->cnx_server);\n268\t        test_ctx->cnx_server = NULL;\n269\t    }\n270\t\n271\t    /* recreate the client connection */\n272\t    test_ctx->cnx_client = picoquic_create_cnx(test_ctx->qclient, picoquic_null_connection_id,\n273\t        picoquic_null_connection_id,\n274\t        (struct sockaddr*)&test_ctx->server_addr, *simulated_time,\n275\t        PICOQUIC_INTERNAL_TEST_VERSION_1, PICOQUIC_TEST_SNI, PICOQUIC_TEST_ALPN, 1);\n276\t\n277\t    if (test_ctx->cnx_client == NULL) {\n278\t        ret = -1;\n279\t    }\n280\t    else {\n281\t        if (ech_config_buf->off > 0) {\n282\t            picoquic_ech_configure_client(test_ctx->cnx_client, ech_config_buf->base, ech_config_buf->off);\n283\t        }\n284\t\n285\t        ret = picoquic_start_client_cnx(test_ctx->cnx_client);\n286\t    }\n287\t\n288\t    if (ret == 0) {\n289\t        ret = tls_api_connection_loop(test_ctx, loss_mask, 0, simulated_time);\n290\t    }\n291\t    if (ret == 0 ) {\n292\t        /* If resume succeeded, the second connection will have a type \"PSK\" */\n293\t        if (picoquic_tls_is_psk_handshake(test_ctx->cnx_client) == 0) {\n294\t            DBG_PRINTF(\"%s\", \"ECH test, second connection is not PSK.\");\n295\t            ret = -1;\n296\t        }\n297\t        else {\n298\t            /* run a receive loop until no outstanding data */\n299\t            ret = tls_api_synch_to_empty_loop(test_ctx, simulated_time, 2048, 0, 0);\n300\t        }\n301\t    }\n302\t    return ret;\n303\t}\n304\t\n305\tint ech_e2e_test_one(ech_e2e_spec_t* spec)\n306\t{\n307\t    uint64_t simulated_time = 0;\n308\t    uint64_t loss_mask = 0;\n309\t    picoquic_test_tls_api_ctx_t* test_ctx = NULL;\n310\t    picoquic_connection_id_t initial_cid = { {0xec, 0x8e, 0x2e, 0, 0, 0, 0, 0}, 8 };\n311\t    ptls_buffer_t ech_config_buf = { 0 };\n312\t    char ech_test_key_file[512];\n313\t    char ech_test_config_file[512];\n314\t    int ret;\n315\t\n316\t    initial_cid.id[3] = (uint8_t)spec->expect_success;\n317\t    initial_cid.id[4] = (uint8_t)spec->expect_grease;\n318\t\n319\t    ptls_buffer_init(&ech_config_buf, \"\", 0);\n320\t\n321\t\n322\t    /* Initialize an empty ticket store */\n323\t    ret = picoquic_save_tickets(NULL, simulated_time, ECH_TICKET_FILE_NAME);\n324\t\n325\t    /* Create a test context with delayed init */\n326\t    ret = tls_api_init_ctx_ex(&test_ctx, PICOQUIC_INTERNAL_TEST_VERSION_1,\n327\t        PICOQUIC_TEST_SNI, PICOQUIC_TEST_ALPN, &simulated_time, ECH_TICKET_FILE_NAME, NULL, 0, 1, 0, &initial_cid);\n328\t\n329\t    if (ret == 0) {\n330\t        ret = picoquic_get_input_path(ech_test_key_file, sizeof(ech_test_key_file), picoquic_solution_dir,\n331\t            PICOQUIC_TEST_ECH_PRIVATE_KEY);\n332\t        if (ret != 0) {\n333\t            DBG_PRINTF(\"Cannot locate %s\", PICOQUIC_TEST_ECH_PRIVATE_KEY);\n334\t        }\n335\t    }\n336\t    if (ret == 0) {\n337\t        ret = picoquic_get_input_path(ech_test_config_file, sizeof(ech_test_config_file), picoquic_solution_dir,\n338\t            PICOQUIC_TEST_ECH_CONFIG);\n339\t        if (ret != 0) {\n340\t            DBG_PRINTF(\"Cannot locate %s\", PICOQUIC_TEST_ECH_CONFIG);\n341\t        }\n342\t    }\n343\t\n344\t    if (ret == 0) {\n345\t        /* server side configuration */\n346\t        picoquic_set_qlog(test_ctx->qserver, \".\");\n347\t        test_ctx->qserver->use_long_log = 1;\n348\t        if (!spec->no_ech_server) {\n349\t            ret = picoquic_ech_configure_quic_ctx(test_ctx->qserver, ech_test_key_file, ech_test_config_file);\n350\t            if (ret != 0) {\n351\t                DBG_PRINTF(\"Cannot configure quic server context for ECH, ret = %d (0x%x).\", ret, ret);\n352\t            }\n353\t        }\n354\t    }\n355\t    if (ret == 0 && (!spec->no_ech_server || spec->expect_grease)) {\n356\t        /* client side configuration */\n357\t        ret = picoquic_ech_configure_quic_ctx(test_ctx->qclient, NULL, NULL);\n358\t        if (ret != 0) {\n359\t            DBG_PRINTF(\"Cannot configure quic client context for ECH, ret = %d (0x%x).\", ret, ret);\n360\t        }\n361\t    }\n362\t\n363\t    if (!spec->no_ech_server) {\n364\t        if (ret == 0) {\n365\t            /* Read the ECH config from the same file used for the server */\n366\t            ret = picoquic_ech_read_config(&ech_config_buf, ech_test_config_file);\n367\t        }\n368\t\n369\t        if (ret == 0) {\n370\t            if (spec->expect_success) {\n371\t                ret = picoquic_ech_configure_client(test_ctx->cnx_client, ech_config_buf.base, ech_config_buf.off);\n372\t            }\n373\t            else if (spec->expect_grease) {\n374\t                ret = picoquic_ech_configure_client(test_ctx->cnx_client, NULL, 0);\n375\t            }\n376\t            else {\n377\t                ret = -1;\n378\t            }\n379\t            if (ret != 0) {\n380\t                DBG_PRINTF(\"Cannot configure quic client connection for ECH, ret = %d (0x%x).\", ret, ret);\n381\t            }\n382\t        }\n383\t    }\n384\t\n385\t    if (ret == 0) {\n386\t        /* start the client connection, thus creating a TLS context */\n387\t        ret = picoquic_start_client_cnx(test_ctx->cnx_client);\n388\t    }\n389\t\n390\t    if (ret == 0) {\n391\t        ret = tls_api_connection_loop(test_ctx, &loss_mask, 0, &simulated_time);\n392\t    }\n393\t\n394\t    if (ret == 0 && (!TEST_CLIENT_READY || !TEST_SERVER_READY)) {\n395\t        DBG_PRINTF(\"%s\", \"Connection failed!\");\n396\t        ret = -1;\n397\t    }\n398\t\n399\t    if (ret == 0) {\n400\t        if (spec->expect_success) {\n401\t            /* TODO: verify that ECH worked! */\n402\t            if (!picoquic_is_ech_handshake(test_ctx->cnx_client)) {\n403\t                DBG_PRINTF(\"%s\", \"ECH negotiation failed!\");\n404\t                ret = -1;\n405\t            }\n406\t        }\n407\t        else if (picoquic_is_ech_handshake(test_ctx->cnx_client)) {\n408\t            DBG_PRINTF(\"%s\", \"ECH negotiation should have failed!\");\n409\t            ret = -1;\n410\t        }\n411\t        else if (ech_test_check_retry_config(test_ctx->cnx_client,\n412\t            ech_config_buf.base, ech_config_buf.off) != 0) {\n413\t            if (!spec->no_ech_server) {\n414\t                /* TODO: understand why this does not work. */\n415\t                DBG_PRINTF(\"%s\", \"No retry config available!\");\n416\t            }\n417\t        }\n418\t        else if (spec->no_ech_server) {\n419\t            DBG_PRINTF(\"%s\", \"There should be no retry config!\");\n420\t            ret = -1;\n421\t        }\n422\t    }\n423\t\n424\t    if (ret == 0 && spec->complete_cnx) {\n425\t        ret = ech_test_complete_cnx(test_ctx, &loss_mask, &simulated_time);\n426\t    }\n427\t\n428\t    if (ret == 0 && spec->try_twice) {\n429\t        ret = ech_e2e_second(test_ctx, &ech_config_buf, &loss_mask, &simulated_time);\n430\t    }\n431\t\n432\t    ptls_buffer_dispose(&ech_config_buf);\n433\t\n434\t    if (test_ctx != NULL) {\n435\t        tls_api_delete_ctx(test_ctx);\n436\t        test_ctx = NULL;\n437\t    }\n438\t\n439\t    return ret;\n440\t}\n441\t\n442\tint ech_e2e_test(void)\n443\t{\n444\t    ech_e2e_spec_t spec = { 0 };\n445\t    spec.expect_success = 1;\n446\t    return ech_e2e_test_one(&spec);\n447\t}\n448\t\n449\tint ech_e2e_0rtt_test(void)\n450\t{\n451\t    ech_e2e_spec_t spec = { 0 };\n452\t    spec.expect_grease = 1;\n453\t    spec.complete_cnx = 1;\n454\t    spec.try_twice = 1;\n455\t    return ech_e2e_test_one(&spec);\n456\t}\n457\t\n458\tint ech_grease_test(void)\n459\t{\n460\t    ech_e2e_spec_t spec = { 0 };\n461\t    spec.expect_grease = 1;\n462\t    return ech_e2e_test_one(&spec);\n463\t}\n464\t\n465\tint ech_no_ech_test(void)\n466\t{\n467\t    ech_e2e_spec_t spec = { 0 };\n468\t    spec.expect_grease = 0;\n469\t    spec.no_ech_server = 1;\n470\t    spec.complete_cnx = 1;\n471\t    spec.try_twice = 1;\n472\t    return ech_e2e_test_one(&spec);\n473\t}\n474\t"}]},"parent_tool_use_id":null,"session_id":"17072f18-9969-498e-bec6-45838e44ca80","uuid":"9c47a1f0-3ee5-43f6-a31e-052b8ae9c14c","timestamp":"2026-05-05T03:12:22.033Z","tool_use_result":{"type":"text","file":{"filePath":"/Users/richbarn/Projects/picoquic/picoquictest/ech_test.c","content":"/*\n* Author: Christian Huitema\n* Copyright (c) 2025, Private Octopus, Inc.\n* All rights reserved.\n*\n* Permission to use, copy, modify, and distribute this software for any\n* purpose with or without fee is hereby granted, provided that the above\n* copyright notice and this permission notice appear in all copies.\n*\n* THIS SOFTWARE IS PROVIDED BY THE COPYRIGHT HOLDERS AND CONTRIBUTORS \"AS IS\" AND\n* ANY EXPRESS OR IMPLIED WARRANTIES, INCLUDING, BUT NOT LIMITED TO, THE IMPLIED\n* WARRANTIES OF MERCHANTABILITY AND FITNESS FOR A PARTICULAR PURPOSE ARE\n* DISCLAIMED. IN NO EVENT SHALL Private Octopus, Inc. BE LIABLE FOR ANY\n* DIRECT, INDIRECT, INCIDENTAL, SPECIAL, EXEMPLARY, OR CONSEQUENTIAL DAMAGES\n* (INCLUDING, BUT NOT LIMITED TO, PROCUREMENT OF SUBSTITUTE GOODS OR SERVICES;\n* LOSS OF USE, DATA, OR PROFITS; OR BUSINESS INTERRUPTION) HOWEVER CAUSED AND\n* ON ANY THEORY OF LIABILITY, WHETHER IN CONTRACT, STRICT LIABILITY, OR TORT\n* (INCLUDING NEGLIGENCE OR OTHERWISE) ARISING IN ANY WAY OUT OF THE USE OF THIS\n* SOFTWARE, EVEN IF ADVISED OF THE POSSIBILITY OF SUCH DAMAGE.\n*/\n\n#include \"picoquic_internal.h\"\n#include \"picoquic_utils.h\"\n#include \"picosocks.h\"\n#include \"tls_api.h\"\n#include \"picoquictest_internal.h\"\n#ifdef _WINDOWS\n#include \"wincompat.h\"\n#pragma warning(disable:4204)\n#endif\n#include <picotls.h>\n#ifdef _WINDOWS\n#include <picotls\\pembase64.h>\n#include <picotls\\minicrypto.h>\n#else\n#include <picotls/pembase64.h>\n#include <picotls/minicrypto.h>\n#endif\n#include <stddef.h>\n#include <stdlib.h>\n#include <string.h>\n#include \"picoquictest.h\"\ntypedef const struct st_ptls_cipher_suite_t ptls_cipher_suite_t;\n#include \"picoquic_crypto_provider_api.h\"\n#include \"autoqlog.h\"\n#include \"picoquic_logger.h\"\n\n /* ech_config_test:\n * Create an ech configuration list, i.e., the content of an HTTPS \"ech=\" parameter.\n  */\n#define ECH_CONFIG_FILE_TXT \"ech_config.txt\"\n\nint picoquic_ech_read_config(ptls_buffer_t* config, char const* file_name);\nint picoquic_ech_create_config_from_public_key(uint8_t** config, size_t* config_len, char const* public_key_file, char const* public_name);\nint picoquic_ech_create_config_from_private_key(uint8_t** config, size_t* config_len, char const* private_key_file, char const* public_name);\nint picoquic_ech_save_config(uint8_t* config, size_t config_len, char const* file_name);\n\nint ech_test_check_buf(uint8_t* config, size_t config_len, char const* ref_file_name)\n{\n    int ret = 0;\n    char test_ref_file[512];\n\n    ret = picoquic_get_input_path(test_ref_file, sizeof(test_ref_file), picoquic_solution_dir,\n        ref_file_name);\n\n    if (ret != 0) {\n        DBG_PRINTF(\"Cannot find <%s> file in <%s>, err: %d (0x%x)\", ref_file_name, picoquic_solution_dir, ret, ret);\n    }\n    else {\n        ptls_buffer_t config_buffer;\n        ptls_buffer_init(&config_buffer, \"\", 0);\n        ret = picoquic_ech_read_config(&config_buffer, test_ref_file);\n        if (ret != 0) {\n            DBG_PRINTF(\"Cannot read reference for <%s> from <%s>, err: %d (0x%x)\", ref_file_name, test_ref_file, ret, ret);\n        }\n        else {\n            if (config_buffer.off != config_len ||\n                memcmp(config_buffer.base, config, config_len) != 0) {\n                DBG_PRINTF(\"Data does not match reference for <%s> from <%s>, len = %zu vs %zu\",\n                    ref_file_name, test_ref_file, config_len, config_buffer.off);\n                ret = -1;\n            }\n        }\n        ptls_buffer_dispose(&config_buffer);\n    }\n    return ret;\n}\n\nint ech_config_test(void)\n{\n    int ret = 0;\n    char test_server_pub_key_file[512];\n    const char* public_name = \"test.example.com\";\n    uint8_t* config = NULL;\n    size_t config_len = 0;\n\n    if (picoquic_hpke_kems[0] == NULL) {\n        picoquic_tls_api_init();\n    }\n\n    ret = picoquic_get_input_path(test_server_pub_key_file, sizeof(test_server_pub_key_file), picoquic_solution_dir,\n        PICOQUIC_TEST_ECH_PUB_KEY);\n    if (ret != 0) {\n        DBG_PRINTF(\"Cannot find pub_key file in <%s>, err: %d (0x%x)\", picoquic_solution_dir, ret, ret);\n    }\n    else if ((ret = picoquic_ech_create_config_from_public_key(&config, &config_len, test_server_pub_key_file, public_name)) != 0) {\n        DBG_PRINTF(\"Cannot create ECH record from <%s>, err: %d (0x%x)\", test_server_pub_key_file, ret, ret);\n    }\n    /* Save a config representation in ech_config.txt */\n    if (ret == 0) {\n        ret = picoquic_ech_save_config(config, config_len, ECH_CONFIG_FILE_TXT);\n        if (ret == 0) {\n            ret = ech_test_check_buf(config, config_len, PICOQUIC_TEST_ECH_CONFIG_REF);\n        }\n    }\n\n    if (config != NULL) {\n        free(config);\n    }\n\n    return ret;\n}\n\nint ech_config_p_test(void)\n{\n    int ret = 0;\n    char test_server_key_file[512];\n    const char* public_name = \"test.example.com\";\n    uint8_t* config = NULL;\n    size_t config_len = 0;\n\n    if (picoquic_hpke_kems[0] == NULL) {\n        picoquic_tls_api_init();\n    }\n\n    ret = picoquic_get_input_path(test_server_key_file, sizeof(test_server_key_file), picoquic_solution_dir,\n        PICOQUIC_TEST_ECH_PRIVATE_KEY);\n    if (ret != 0) {\n        DBG_PRINTF(\"Cannot locate %s\", PICOQUIC_TEST_ECH_PRIVATE_KEY);\n    }\n    else if ((ret = picoquic_ech_create_config_from_private_key(&config, &config_len, test_server_key_file, public_name)) != 0) {\n        DBG_PRINTF(\"Cannot create ECH record from <%s>, err: %d (0x%x)\", test_server_key_file, ret, ret);\n    }\n\n    /* Save a config representation in ech_config.txt */\n    if (ret == 0) {\n        ret = picoquic_ech_save_config(config, config_len, ECH_CONFIG_FILE_TXT);\n        if (ret == 0) {\n            ret = ech_test_check_buf(config, config_len, PICOQUIC_TEST_ECH_CONFIG_REF);\n        }\n    }\n\n    if (config != NULL) {\n        free(config);\n    }\n\n    return ret;\n}\n\n#if 0\n/* ECH test of config from CERT */\nint ech_cert_test(void)\n{\n    int ret = 0;\n    char test_server_cert_file[512];\n    uint8_t* config = NULL;\n    size_t config_len = 0;\n\n    if (picoquic_hpke_kems[0] == NULL) {\n        picoquic_tls_api_init();\n    }\n    if ((ret = picoquic_get_input_path(test_server_cert_file, sizeof(test_server_cert_file), picoquic_solution_dir,\n        PICOQUIC_TEST_ECH_CERT)) != 0) {\n        DBG_PRINTF(\"Cannot find cert file in <%s>, err: %d (0x%x)\", picoquic_solution_dir, ret, ret);\n    }\n    else if ((ret = picoquic_ech_create_config_from_cert(&config, &config_len, test_server_cert_file, \"test.example.com\")) != 0) {\n        DBG_PRINTF(\"Cannot create config from cert file in <%s>, err: %d (0x%x)\", test_server_cert_file, ret, ret);\n    }\n    else {\n        ptls_iovec_t io_config = { .base = config, .len = config_len };\n        ret = ech_test_check_buf(io_config, PICOQUIC_TEST_ECH_CONFIG_REF);\n        free(config);\n    }\n\n    return ret;\n}\n#endif\n/* ECH end to end test. Create a connection, verify that the proper files\n* are returned.\n */\n\ntypedef struct st_ech_e2e_spec_t {\n    int expect_success;\n    int expect_grease;\n    int no_ech_server;\n    int complete_cnx;\n    int try_twice;\n} ech_e2e_spec_t;\n\nint ech_test_check_retry_config(picoquic_cnx_t* cnx,\n    uint8_t* config, size_t config_len)\n{\n    int ret = 0;\n    uint8_t* retry_config;\n    size_t retry_config_len;\n\n    picoquic_ech_get_retry_config(cnx, &retry_config, &retry_config_len);\n\n    if (retry_config == NULL ||\n        retry_config_len != config_len ||\n        memcmp(retry_config, config, config_len) != 0) {\n        ret = -1;\n    }\n    return ret;\n}\n\n#define ECH_TICKET_FILE_NAME \"ech_ticket_store.bin\"\n\nstatic test_api_stream_desc_t ech_scenario_small[] = {\n    { 4, 0, 256, 1000 }\n};\n\nint ech_test_complete_cnx(picoquic_test_tls_api_ctx_t* test_ctx, uint64_t* loss_mask, uint64_t* simulated_time)\n{\n    /* load a small scenario */\n    int ret = test_api_init_send_recv_scenario(test_ctx, ech_scenario_small, sizeof(ech_scenario_small));\n\n    /* Perform a data sending loop */\n    if (ret == 0) {\n        ret = tls_api_data_sending_loop(test_ctx, loss_mask, simulated_time, 0);\n    }\n\n    /* Before closing, wait for the session ticket to arrive */\n    ret = session_resume_wait_for_ticket(test_ctx, simulated_time);\n\n    /* verify that the transmission was complete */\n    if (ret == 0) {\n        ret = tls_api_one_scenario_body_verify(test_ctx, simulated_time, 1000000);\n    }\n\n    /* Verify that the session ticket has been received correctly */\n    if (ret == 0) {\n        if (test_ctx->qclient->p_first_ticket == NULL) {\n            DBG_PRINTF(\"%s\", \"no ticket received.\");\n            ret = -1;\n        }\n        else {\n            ret = picoquic_save_tickets(test_ctx->qclient->p_first_ticket, *simulated_time, ECH_TICKET_FILE_NAME);\n            if (ret != 0) {\n                DBG_PRINTF(\"ticket save error (0x%x).\\n\", ret);\n            }\n        }\n    }\n\n    return ret;\n}\n\n\nint ech_e2e_second(picoquic_test_tls_api_ctx_t* test_ctx, ptls_buffer_t *ech_config_buf, uint64_t * loss_mask, uint64_t* simulated_time)\n{\n    int ret = 0;\n\n    /* We should verify that 0RTT works for the 2nd connection */\n    picoquic_delete_cnx(test_ctx->cnx_client);\n    test_ctx->cnx_client = NULL;\n    if (test_ctx->cnx_server != NULL) {\n        picoquic_delete_cnx(test_ctx->cnx_server);\n        test_ctx->cnx_server = NULL;\n    }\n\n    /* recreate the client connection */\n    test_ctx->cnx_client = picoquic_create_cnx(test_ctx->qclient, picoquic_null_connection_id,\n        picoquic_null_connection_id,\n        (struct sockaddr*)&test_ctx->server_addr, *simulated_time,\n        PICOQUIC_INTERNAL_TEST_VERSION_1, PICOQUIC_TEST_SNI, PICOQUIC_TEST_ALPN, 1);\n\n    if (test_ctx->cnx_client == NULL) {\n        ret = -1;\n    }\n    else {\n        if (ech_config_buf->off > 0) {\n            picoquic_ech_configure_client(test_ctx->cnx_client, ech_config_buf->base, ech_config_buf->off);\n        }\n\n        ret = picoquic_start_client_cnx(test_ctx->cnx_client);\n    }\n\n    if (ret == 0) {\n        ret = tls_api_connection_loop(test_ctx, loss_mask, 0, simulated_time);\n    }\n    if (ret == 0 ) {\n        /* If resume succeeded, the second connection will have a type \"PSK\" */\n        if (picoquic_tls_is_psk_handshake(test_ctx->cnx_client) == 0) {\n            DBG_PRINTF(\"%s\", \"ECH test, second connection is not PSK.\");\n            ret = -1;\n        }\n        else {\n            /* run a receive loop until no outstanding data */\n            ret = tls_api_synch_to_empty_loop(test_ctx, simulated_time, 2048, 0, 0);\n        }\n    }\n    return ret;\n}\n\nint ech_e2e_test_one(ech_e2e_spec_t* spec)\n{\n    uint64_t simulated_time = 0;\n    uint64_t loss_mask = 0;\n    picoquic_test_tls_api_ctx_t* test_ctx = NULL;\n    picoquic_connection_id_t initial_cid = { {0xec, 0x8e, 0x2e, 0, 0, 0, 0, 0}, 8 };\n    ptls_buffer_t ech_config_buf = { 0 };\n    char ech_test_key_file[512];\n    char ech_test_config_file[512];\n    int ret;\n\n    initial_cid.id[3] = (uint8_t)spec->expect_success;\n    initial_cid.id[4] = (uint8_t)spec->expect_grease;\n\n    ptls_buffer_init(&ech_config_buf, \"\", 0);\n\n\n    /* Initialize an empty ticket store */\n    ret = picoquic_save_tickets(NULL, simulated_time, ECH_TICKET_FILE_NAME);\n\n    /* Create a test context with delayed init */\n    ret = tls_api_init_ctx_ex(&test_ctx, PICOQUIC_INTERNAL_TEST_VERSION_1,\n        PICOQUIC_TEST_SNI, PICOQUIC_TEST_ALPN, &simulated_time, ECH_TICKET_FILE_NAME, NULL, 0, 1, 0, &initial_cid);\n\n    if (ret == 0) {\n        ret = picoquic_get_input_path(ech_test_key_file, sizeof(ech_test_key_file), picoquic_solution_dir,\n            PICOQUIC_TEST_ECH_PRIVATE_KEY);\n        if (ret != 0) {\n            DBG_PRINTF(\"Cannot locate %s\", PICOQUIC_TEST_ECH_PRIVATE_KEY);\n        }\n    }\n    if (ret == 0) {\n        ret = picoquic_get_input_path(ech_test_config_file, sizeof(ech_test_config_file), picoquic_solution_dir,\n            PICOQUIC_TEST_ECH_CONFIG);\n        if (ret != 0) {\n            DBG_PRINTF(\"Cannot locate %s\", PICOQUIC_TEST_ECH_CONFIG);\n        }\n    }\n\n    if (ret == 0) {\n        /* server side configuration */\n        picoquic_set_qlog(test_ctx->qserver, \".\");\n        test_ctx->qserver->use_long_log = 1;\n        if (!spec->no_ech_server) {\n            ret = picoquic_ech_configure_quic_ctx(test_ctx->qserver, ech_test_key_file, ech_test_config_file);\n            if (ret != 0) {\n                DBG_PRINTF(\"Cannot configure quic server context for ECH, ret = %d (0x%x).\", ret, ret);\n            }\n        }\n    }\n    if (ret == 0 && (!spec->no_ech_server || spec->expect_grease)) {\n        /* client side configuration */\n        ret = picoquic_ech_configure_quic_ctx(test_ctx->qclient, NULL, NULL);\n        if (ret != 0) {\n            DBG_PRINTF(\"Cannot configure quic client context for ECH, ret = %d (0x%x).\", ret, ret);\n        }\n    }\n\n    if (!spec->no_ech_server) {\n        if (ret == 0) {\n            /* Read the ECH config from the same file used for the server */\n            ret = picoquic_ech_read_config(&ech_config_buf, ech_test_config_file);\n        }\n\n        if (ret == 0) {\n            if (spec->expect_success) {\n                ret = picoquic_ech_configure_client(test_ctx->cnx_client, ech_config_buf.base, ech_config_buf.off);\n            }\n            else if (spec->expect_grease) {\n                ret = picoquic_ech_configure_client(test_ctx->cnx_client, NULL, 0);\n            }\n            else {\n                ret = -1;\n            }\n            if (ret != 0) {\n                DBG_PRINTF(\"Cannot configure quic client connection for ECH, ret = %d (0x%x).\", ret, ret);\n            }\n        }\n    }\n\n    if (ret == 0) {\n        /* start the client connection, thus creating a TLS context */\n        ret = picoquic_start_client_cnx(test_ctx->cnx_client);\n    }\n\n    if (ret == 0) {\n        ret = tls_api_connection_loop(test_ctx, &loss_mask, 0, &simulated_time);\n    }\n\n    if (ret == 0 && (!TEST_CLIENT_READY || !TEST_SERVER_READY)) {\n        DBG_PRINTF(\"%s\", \"Connection failed!\");\n        ret = -1;\n    }\n\n    if (ret == 0) {\n        if (spec->expect_success) {\n            /* TODO: verify that ECH worked! */\n            if (!picoquic_is_ech_handshake(test_ctx->cnx_client)) {\n                DBG_PRINTF(\"%s\", \"ECH negotiation failed!\");\n                ret = -1;\n            }\n        }\n        else if (picoquic_is_ech_handshake(test_ctx->cnx_client)) {\n            DBG_PRINTF(\"%s\", \"ECH negotiation should have failed!\");\n            ret = -1;\n        }\n        else if (ech_test_check_retry_config(test_ctx->cnx_client,\n            ech_config_buf.base, ech_config_buf.off) != 0) {\n            if (!spec->no_ech_server) {\n                /* TODO: understand why this does not work. */\n                DBG_PRINTF(\"%s\", \"No retry config available!\");\n            }\n        }\n        else if (spec->no_ech_server) {\n            DBG_PRINTF(\"%s\", \"There should be no retry config!\");\n            ret = -1;\n        }\n    }\n\n    if (ret == 0 && spec->complete_cnx) {\n        ret = ech_test_complete_cnx(test_ctx, &loss_mask, &simulated_time);\n    }\n\n    if (ret == 0 && spec->try_twice) {\n        ret = ech_e2e_second(test_ctx, &ech_config_buf, &loss_mask, &simulated_time);\n    }\n\n    ptls_buffer_dispose(&ech_config_buf);\n\n    if (test_ctx != NULL) {\n        tls_api_delete_ctx(test_ctx);\n        test_ctx = NULL;\n    }\n\n    return ret;\n}\n\nint ech_e2e_test(void)\n{\n    ech_e2e_spec_t spec = { 0 };\n    spec.expect_success = 1;\n    return ech_e2e_test_one(&spec);\n}\n\nint ech_e2e_0rtt_test(void)\n{\n    ech_e2e_spec_t spec = { 0 };\n    spec.expect_grease = 1;\n    spec.complete_cnx = 1;\n    spec.try_twice = 1;\n    return ech_e2e_test_one(&spec);\n}\n\nint ech_grease_test(void)\n{\n    ech_e2e_spec_t spec = { 0 };\n    spec.expect_grease = 1;\n    return ech_e2e_test_one(&spec);\n}\n\nint ech_no_ech_test(void)\n{\n    ech_e2e_spec_t spec = { 0 };\n    spec.expect_grease = 0;\n    spec.no_ech_server = 1;\n    spec.complete_cnx = 1;\n    spec.try_twice = 1;\n    return ech_e2e_test_one(&spec);\n}\n","numLines":474,"startLine":1,"totalLines":474}}}
