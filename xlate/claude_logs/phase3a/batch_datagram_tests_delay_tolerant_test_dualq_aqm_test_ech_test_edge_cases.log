{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01Ntbr5vzSA3P9Svt8ePXeyH","type":"tool_result","content":"1396\t/* Skip through packets, document types and next pointer */\n1397\tconst uint8_t* v1_header_skip(const uint8_t* bytes, const uint8_t* bytes_max, picoquic_packet_type_enum* ptype)\n1398\t{\n1399\t    uint8_t first_byte = *bytes++;\n1400\t\n1401\t    *ptype = picoquic_packet_error;\n1402\t\n1403\t    if ((first_byte & 0x80) == 0) {\n1404\t        bytes = bytes_max;\n1405\t        *ptype = picoquic_packet_1rtt_protected;\n1406\t    }\n1407\t    else {\n1408\t        uint8_t lcid;\n1409\t        if (bytes + 5 > bytes_max) {\n1410\t            bytes = NULL;\n1411\t        }\n1412\t        else {\n1413\t            bytes += 4; /* skip version */\n1414\t            lcid = *bytes++;\n1415\t            bytes = picoquic_frames_fixed_skip(bytes, bytes_max, lcid);\n1416\t\n1417\t            if (bytes == NULL || bytes + 1 >= bytes_max) {\n1418\t                bytes = NULL;\n1419\t            }\n1420\t            else {\n1421\t                lcid = *bytes++;\n1422\t                bytes = picoquic_frames_fixed_skip(bytes, bytes_max, lcid);\n1423\t            }\n1424\t        }\n1425\t        if (bytes != NULL) {\n1426\t            /* The next part is not version invariant. We assume v1 */\n1427\t            int p_type_number = ((first_byte) >> 4) & 3;\n1428\t            /* int number_length = ((first_byte) & 3) + 1; */\n1429\t            uint64_t length = 0;\n1430\t            uint64_t token_length = 0;\n1431\t\n1432\t            if (p_type_number == 0) {\n1433\t                *ptype = picoquic_packet_initial;\n1434\t                if ((bytes = picoquic_frames_varint_decode(bytes, bytes_max, &token_length)) != NULL &&\n1435\t                    (bytes = picoquic_frames_fixed_skip(bytes, bytes_max, token_length)) != NULL &&\n1436\t                    (bytes = picoquic_frames_varint_decode(bytes, bytes_max, &length)) != NULL /* &&\n1437\t                    (bytes = picoquic_frames_fixed_skip(bytes, bytes_max, number_length)) != NULL */) {\n1438\t                    bytes = picoquic_frames_fixed_skip(bytes, bytes_max, length);\n1439\t                }\n1440\t            }\n1441\t            else if (p_type_number == 2) {\n1442\t                *ptype = picoquic_packet_handshake;\n1443\t                if ((bytes = picoquic_frames_varint_decode(bytes, bytes_max, &length)) != NULL /* &&\n1444\t                    (bytes = picoquic_frames_fixed_skip(bytes, bytes_max, number_length)) != NULL */) {\n1445\t                    bytes = picoquic_frames_fixed_skip(bytes, bytes_max, length);\n1446\t                }\n1447\t            }\n1448\t            else {\n1449\t                /* unexpected in our scenario */\n1450\t                bytes = NULL;\n1451\t            }\n1452\t        }\n1453\t    }\n1454\t    return bytes;\n1455\t}\n1456\t\n1457\t\n1458\t/* test that when the initial packet is repeated, a handshake is included */\n1459\tint pto_server_prepare(picoquic_test_tls_api_ctx_t* test_ctx, uint64_t simulated_time, int * has_packet, int* has_initial, int* has_handshake)\n1460\t{\n1461\t    int ret = 0;\n1462\t    uint8_t buf[PICOQUIC_MAX_PACKET_SIZE];\n1463\t    struct sockaddr_storage addr_to;\n1464\t    struct sockaddr_storage addr_from;\n1465\t    size_t length;\n1466\t\n1467\t    ret = picoquic_prepare_packet(test_ctx->cnx_server, simulated_time,\n1468\t        buf, PICOQUIC_MAX_PACKET_SIZE, &length,\n1469\t        &addr_to, &addr_from, NULL);\n1470\t    if (ret == 0 && length > 0) {\n1471\t        *has_packet = 1;\n1472\t        const uint8_t* bytes = buf;\n1473\t        const uint8_t* bytes_max = buf + length;\n1474\t\n1475\t        while (bytes < bytes_max) {\n1476\t            picoquic_packet_type_enum ptype;\n1477\t            if ((bytes = v1_header_skip(bytes, bytes_max, &ptype)) == NULL) {\n1478\t                break;\n1479\t            }\n1480\t            else {\n1481\t                if (ptype == picoquic_packet_initial) {\n1482\t                    *has_initial = 1;\n1483\t                }\n1484\t                else if (ptype == picoquic_packet_handshake) {\n1485\t                    *has_handshake = 1;\n1486\t                }\n1487\t            }\n1488\t        }\n1489\t    }\n1490\t    return ret;\n1491\t}\n1492\t\n1493\tint initial_pto_srv_test(void)\n1494\t{\n1495\t    int ret = 0;\n1496\t    picoquic_test_tls_api_ctx_t* test_ctx = NULL;\n1497\t    size_t length = 0;\n1498\t    int has_packet;\n1499\t    int has_initial;\n1500\t    int has_handshake;\n1501\t    uint64_t simulated_time = 0;\n1502\t    picoquic_connection_id_t initial_cid = { { 0x94, 0x01, 0x85, 0, 0, 0, 0, 0}, 8 };\n1503\t\n1504\t    /* Create a client. */\n1505\t    ret = tls_api_init_ctx_ex(&test_ctx, PICOQUIC_INTERNAL_TEST_VERSION_1,\n1506\t        PICOQUIC_TEST_SNI, PICOQUIC_TEST_ALPN, &simulated_time, NULL, NULL, 0, 1, 0, &initial_cid);\n1507\t    if (ret != 0) {\n1508\t        DBG_PRINTF(\"Cannot initialize context, ret = 0x%x\", ret);\n1509\t    }\n1510\t    else {\n1511\t        /* Set the binlog */\n1512\t        picoquic_set_qlog(test_ctx->qserver, \".\");\n1513\t        /* start the client connection */\n1514\t        ret = picoquic_start_client_cnx(test_ctx->cnx_client);\n1515\t    }\n1516\t    /* Send the initial packet */\n1517\t    if (ret == 0) {\n1518\t        ret = initial_pto_prepare(test_ctx, &simulated_time, &length);\n1519\t        if (ret == 0 && length < 1200) {\n1520\t            length = -1;\n1521\t        }\n1522\t    }\n1523\t    if (ret == 0) {\n1524\t        /* pretend that the address is validated, so the server sends ACKS, etc. */\n1525\t        test_ctx->cnx_server->initial_validated = 1;\n1526\t        /* Set the time to server next wake. */\n1527\t        simulated_time = picoquic_get_next_wake_time(test_ctx->qserver, simulated_time);\n1528\t        has_initial = 0;\n1529\t        has_handshake = 0;\n1530\t        /* Get the first flight. */\n1531\t        do {\n1532\t            has_packet = 0;\n1533\t            ret = pto_server_prepare(test_ctx, simulated_time, &has_packet, &has_initial, &has_handshake);\n1534\t        } while (ret == 0 && has_packet);\n1535\t    }\n1536\t\n1537\t    /* verify that the packet has Initial and Handshake */\n1538\t    if (ret == 0) {\n1539\t        /* Set the time to server next wake. */\n1540\t        has_initial = 0;\n1541\t        has_handshake = 0;\n1542\t        simulated_time = picoquic_get_next_wake_time(test_ctx->qserver, simulated_time);\n1543\t        /* Get the PTO. */\n1544\t        do {\n1545\t            has_packet = 0;\n1546\t            ret = pto_server_prepare(test_ctx, simulated_time, &has_packet, &has_initial, &has_handshake);\n1547\t        } while (ret == 0 && has_packet);\n1548\t\n1549\t        if (ret == 0 && !(has_initial && has_handshake)) {\n1550\t            /* Bug. The server out to repeat both the initial packet and some handshake packet */\n1551\t            ret = -1;\n1552\t        }\n1553\t    }\n1554\t\n1555\t    if (test_ctx != NULL) {\n1556\t        tls_api_delete_ctx(test_ctx);\n1557\t        test_ctx = NULL;\n1558\t    }\n1559\t\n1560\t    return ret;\n1561\t}\n1562\t\n1563\t\n1564\t/* Test of out of order crypto packets.\n1565\t* We test that by injecting a crypto handshake frame with an\n1566\t* offset of 64K in the crypto context. There will be three tests,\n1567\t* for initial, handshake and 1 rtt contexts.\n1568\t */\n1569\t\n1570\t\n1571\tint crypto_hs_offset_test_one(picoquic_packet_context_enum pc)\n1572\t{\n1573\t    int ret = 0;\n1574\t    picoquic_test_tls_api_ctx_t* test_ctx = NULL;\n1575\t    //size_t length = 0;\n1576\t    uint64_t simulated_time = 0;\n1577\t    picoquic_connection_id_t initial_cid = { { 0xC0, 0xFF, 0x5E, 0x40, 0, 0, 0, 0}, 8 };\n1578\t    uint8_t bad_crypto_hs[] = { picoquic_frame_type_crypto_hs, 0x80, 0x01, 0, 0, 4, 1, 2, 3, 4 };\n1579\t\n1580\t    initial_cid.id[4] = (uint8_t)pc;\n1581\t\n1582\t    /* Create a client. */\n1583\t    ret = tls_api_init_ctx_ex(&test_ctx, PICOQUIC_INTERNAL_TEST_VERSION_1,\n1584\t        PICOQUIC_TEST_SNI, PICOQUIC_TEST_ALPN, &simulated_time, NULL, NULL, 0, 1, 0, &initial_cid);\n1585\t    if (ret != 0) {\n1586\t        DBG_PRINTF(\"Cannot initialize context, ret = 0x%x\", ret);\n1587\t    }\n1588\t    else {\n1589\t        /* Set the binlog */\n1590\t        picoquic_set_qlog(test_ctx->qserver, \".\");\n1591\t        /* start the client connection */\n1592\t        ret = picoquic_start_client_cnx(test_ctx->cnx_client);\n1593\t    }\n1594\t\n1595\t    if (ret == 0) {\n1596\t        /* Inject the  made up packet */\n1597\t        ret = picoquic_queue_misc_frame(test_ctx->cnx_client, bad_crypto_hs, sizeof(bad_crypto_hs), 1, pc);\n1598\t    }\n1599\t\n1600\t\n1601\t    /* Try to establish the connection */\n1602\t    if (ret == 0) {\n1603\t        if (wait_client_connection_timeout(test_ctx, &simulated_time, 300000000) == 0) {\n1604\t            if (test_ctx->cnx_server != NULL) {\n1605\t                if (test_ctx->cnx_server->cnx_state != picoquic_state_handshake_failure &&\n1606\t                    test_ctx->cnx_server->cnx_state < picoquic_state_disconnecting) {\n1607\t                    /* Should wait for ready state */\n1608\t                    DBG_PRINTF(\"Unexpected success, pc=%d\\n\", pc);\n1609\t                    ret = -1;\n1610\t                }\n1611\t            }\n1612\t        }\n1613\t    }\n1614\t\n1615\t    if (ret == 0 && !(\n1616\t        test_ctx->cnx_client->remote_error == PICOQUIC_TRANSPORT_CRYPTO_BUFFER_EXCEEDED ||\n1617\t        test_ctx->cnx_client->local_error == PICOQUIC_ERROR_IDLE_TIMEOUT)) {\n1618\t        DBG_PRINTF(\"For pc=%d, expected error 0x%x, got 0x%x, local 0x%x\\n\", pc,\n1619\t            PICOQUIC_TRANSPORT_CRYPTO_BUFFER_EXCEEDED,\n1620\t            test_ctx->cnx_client->remote_error, test_ctx->cnx_client->local_error);\n1621\t        ret = -1;\n1622\t    }\n1623\t\n1624\t    if (test_c