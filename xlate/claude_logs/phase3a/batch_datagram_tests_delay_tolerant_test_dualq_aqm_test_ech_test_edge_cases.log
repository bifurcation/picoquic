{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01LDDFGLtJ9wravjTY8wjDuY","type":"tool_result","content":"210\t/// Discriminants follow the declaration order of the C `state_enum`.\n211\t#[derive(Debug, Copy, Clone, PartialEq, Eq, PartialOrd, Ord)]\n212\tpub enum State {\n213\t    ClientInit,\n214\t    ClientInitSent,\n215\t    ClientRenegotiate,\n216\t    ClientRetryReceived,\n217\t    ClientInitResent,\n218\t    ServerInit,\n219\t    ServerHandshake,\n220\t    ClientHandshakeStart,\n221\t    HandshakeFailure,\n222\t    HandshakeFailureResend,\n223\t    ClientAlmostReady,\n224\t    ServerFalseStart,\n225\t    ServerAlmostReady,\n226\t    ClientReadyStart,\n227\t    Ready,\n228\t    Disconnecting,\n229\t    ClosingReceived,\n230\t    Closing,\n231\t    Draining,\n232\t    Disconnected,\n233\t}\n234\t\n235\t// `TransportParameter`, `PreferredAddress`, `VersionNegotiation`,\n236\t// `TransportParameters`, and `TransportParameter0RttKind` live in\n237\t// [`crate::tp`].\n238\t\n239\t// ---------------------------------------------------------------------------\n240\t// Packet contexts and enumerated policy types.\n241\t\n242\t/// Encryption-level packet context.  Each value selects one of the\n243\t/// three QUIC packet-number spaces (Initial, Handshake, 1-RTT).\n244\t/// The C enum's trailing `nb_packet_context` count is exposed as\n245\t/// the [`NB_PACKET_CONTEXT`] constant below.\n246\t#[derive(Debug, Copy, Clone, PartialEq, Eq)]\n247\t#[repr(u8)]\n248\tpub enum PacketContext {\n249\t    Application = 0,\n250\t    Handshake = 1,\n251\t    Initial = 2,\n252\t}\n253\t\n254\t/// Number of packet contexts (matches the variant count of\n255\t/// [`PacketContext`]).\n256\tpub const NB_PACKET_CONTEXT: usize = 3;\n257\t\n258\t/// Path-MTU-discovery policy for a connection.\n259\t#[derive(Debug, Copy, Clone, PartialEq, Eq, Default)]"}]},"parent_tool_use_id":null,"session_id":"17072f18-9969-498e-bec6-45838e44ca80","uuid":"c65266cc-f5e1-451c-adca-5455