{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01EJbKRmY3xKPB34toQWWLGF","type":"tool_result","content":"1\t/*\n2\t* Author: Christian Huitema\n3\t* Copyright (c) 2021, Private Octopus, Inc.\n4\t* All rights reserved.\n5\t*\n6\t* Permission to use, copy, modify, and distribute this software for any\n7\t* purpose with or without fee is hereby granted, provided that the above\n8\t* copyright notice and this permission notice appear in all copies.\n9\t*\n10\t* THIS SOFTWARE IS PROVIDED BY THE COPYRIGHT HOLDERS AND CONTRIBUTORS \"AS IS\" AND\n11\t* ANY EXPRESS OR IMPLIED WARRANTIES, INCLUDING, BUT NOT LIMITED TO, THE IMPLIED\n12\t* WARRANTIES OF MERCHANTABILITY AND FITNESS FOR A PARTICULAR PURPOSE ARE\n13\t* DISCLAIMED. IN NO EVENT SHALL Private Octopus, Inc. BE LIABLE FOR ANY\n14\t* DIRECT, INDIRECT, INCIDENTAL, SPECIAL, EXEMPLARY, OR CONSEQUENTIAL DAMAGES\n15\t* (INCLUDING, BUT NOT LIMITED TO, PROCUREMENT OF SUBSTITUTE GOODS OR SERVICES;\n16\t* LOSS OF USE, DATA, OR PROFITS; OR BUSINESS INTERRUPTION) HOWEVER CAUSED AND\n17\t* ON ANY THEORY OF LIABILITY, WHETHER IN CONTRACT, STRICT LIABILITY, OR TORT\n18\t* (INCLUDING NEGLIGENCE OR OTHERWISE) ARISING IN ANY WAY OUT OF THE USE OF THIS\n19\t* SOFTWARE, EVEN IF ADVISED OF THE POSSIBILITY OF SUCH DAMAGE.\n20\t*/\n21\t\n22\t#include \"picoquic_internal.h\"\n23\t#include \"picoquic_utils.h\"\n24\t#include \"tls_api.h\"\n25\t#include \"picoquictest_internal.h\"\n26\t#ifdef _WINDOWS\n27\t#include \"wincompat.h\"\n28\t#pragma warning(disable:4204)\n29\t#endif\n30\t#include <picotls.h>\n31\t#include <stddef.h>\n32\t#include <stdlib.h>\n33\t#include <string.h>\n34\t#include \"picoquic_binlog.h\"\n35\t#include \"csv.h\"\n36\t#include \"qlog.h\"\n37\t#include \"autoqlog.h\"\n38\t#include \"picoquic_logger.h\"\n39\t#include \"performance_log.h\"\n40\t#include \"picoquictest.h\"\n41\t#include \"picoquic_newreno.h\"\n42\t\n43\t\n44\t/* Delay tolerant networking tests.\n45\t *  \n46\t * These tests are added at the request of Marc Blanchet, who would like\n47\t * to study usability of QUIC in \"deep space\" scenarios. The pre-existing\n48\t * \"high latency\" test demonstrate use of a non-modified QUIC stack with\n49\t * latency of 5 seconds, or RTT of 10 seconds. This is enough for lunar\n50\t * communication, but not adequate for communication with distant planets,\n51\t * let alone communication with probes leaving the solar system. In\n52\t * contrast with the basic high latency tests, the delay tolerant tests\n53\t * assume that the QUIC stack is reconfigured to handle large delays,\n54\t * with special configuration of both clients and servers. The tests\n55\t * help us design the corresponding extension.\n56\t */\n57\t\n58\ttypedef struct st_dtn_test_spec_t {\n59\t    uint64_t latency;\n60\t    uint64_t max_completion_time;\n61\t    picoquic_congestion_algorithm_t* ccalgo;\n62\t    test_api_stream_desc_t* scenario;\n63\t    size_t sizeof_scenario;\n64\t    uint64_t mbps_up;\n65\t    uint64_t mbps_down;\n66\t    uint64_t initial_flow_control_credit;\n67\t    uint64_t max_number_of_packets;\n68\t    int has_loss;\n69\t} dtn_test_spec_t;\n70\t\n71\tstatic int dtn_test_one(uint8_t test_id, dtn_test_spec_t * spec)\n72\t{\n73\t    uint64_t simulated_time = 0;\n74\t    uint64_t picoseq_per_byte_up = (1000000ull * 8) / spec->mbps_up;\n75\t    uint64_t picoseq_per_byte_down = (1000000ull * 8) / spec->mbps_down;\n76\t    picoquic_tp_t client_parameters;\n77\t    picoquic_tp_t server_parameters;\n78\t    picoquic_connection_id_t initial_cid = { {0xde, 0x40, 0, 0, 0, 0, 0, 0}, 8 };\n79\t    picoquic_test_tls_api_ctx_t* test_ctx = NULL;\n80\t    int ret = 0;\n81\t\n82\t    initial_cid.id[2] = test_id;\n83\t\n84\t    memset(&client_parameters, 0, sizeof(picoquic_tp_t));\n85\t    picoquic_init_transport_parameters(&client_parameters);\n86\t    client_parameters.enable_time_stamp = 3;\n87\t    client_parameters.max_idle_timeout = (uint32_t)((spec->latency * 5)/1000);\n88\t    if (spec->initial_flow_control_credit > client_parameters.initial_max_data) {\n89\t        client_parameters.initial_max_data = spec->initial_flow_control_credit;\n90\t    }\n91\t    if (spec->initial_flow_control_credit > client_parameters.initial_max_stream_data_bidi_local ) {\n92\t        client_parameters.initial_max_stream_data_bidi_local = spec->initial_flow_control_credit;\n93\t    }\n94\t    if (spec->initial_flow_control_credit > client_parameters.initial_max_stream_data_bidi_remote ) {\n95\t        client_parameters.initial_max_stream_data_bidi_remote = spec->initial_flow_control_credit;\n96\t    }\n97\t    memset(&server_parameters, 0, sizeof(picoquic_tp_t));\n98\t    picoquic_init_transport_parameters(&server_parameters);\n99\t    server_parameters.enable_time_stamp = 3;\n100\t    server_parameters.max_idle_timeout = client_parameters.max_idle_timeout;\n101\t\n102\t    ret = tls_api_one_scenario_init_ex(&test_ctx, &simulated_time, PICOQUIC_INTERNAL_TEST_VERSION_1, &client_parameters, &server_parameters, &initial_cid);\n103\t\n104\t    if (ret == 0 && test_ctx == NULL) {\n105\t        ret = -1;\n106\t    }\n107\t\n108\t    if (ret == 0) {\n109\t        picoquic_set_default_congestion_algorithm(test_ctx->qserver, spec->ccalgo);\n110\t        picoquic_set_congestion_algorithm(test_ctx->cnx_client, spec->ccalgo);\n111\t\n112\t        test_ctx->c_to_s_link->microsec_latency = spec->latency;\n113\t        test_ctx->c_to_s_link->picosec_per_byte = picoseq_per_byte_up;\n114\t        test_ctx->s_to_c_link->microsec_latency = spec->latency;\n115\t        test_ctx->s_to_c_link->picosec_per_byte = picoseq_per_byte_down;\n116\t        test_ctx->stream0_flow_release = 1;\n117\t        test_ctx->immediate_exit = 1;\n118\t\n119\t        picoquic_cnx_set_pmtud_required(test_ctx->cnx_client, 1);\n120\t\n121\t        /* Set the binary log on the server side */\n122\t        picoquic_set_qlog(test_ctx->qserver, \".\");\n123\t        test_ctx->qserver->use_long_log = 1;\n124\t\n125\t        /* set the binary log on the client side */\n126\t        picoquic_set_qlog(test_ctx->qclient, \".\");\n127\t        test_ctx->qclient->use_long_log = 1;\n128\t\n129\t        if (ret == 0) {\n130\t            ret = tls_api_one_scenario_body(test_ctx, &simulated_time,\n131\t                spec->scenario, spec->sizeof_scenario, 0, (spec->has_loss) ? 0x10000000 : 0, 0, 2 * spec->latency, spec->max_completion_time);\n132\t        }\n133\t    }\n134\t\n135\t    /* Free the resource, which will close the log file.\n136\t     */\n137\t\n138\t    if (test_ctx != NULL) {\n139\t        if (spec->max_number_of_packets != 0 && ret == 0) {\n140\t            if (test_ctx->cnx_client != NULL) {\n141\t                uint64_t number_of_packets = test_ctx->cnx_client->nb_packets_sent + test_ctx->cnx_client->nb_packets_received;\n142\t\n143\t                if (number_of_packets > spec->max_number_of_packets) {\n144\t                    DBG_PRINTF(\"Expected at most %\" PRIu64 \"packets, got %\" PRIu64,\n145\t                        spec->max_number_of_packets, number_of_packets);\n146\t                    ret = -1;\n147\t                }\n148\t            }\n149\t            else {\n150\t                DBG_PRINTF(\"%s\", \"Cannot estimate number of packets\");\n151\t                ret = -1;\n152\t            }\n153\t        }\n154\t        tls_api_delete_ctx(test_ctx);\n155\t        test_ctx = NULL;\n156\t    }\n157\t\n158\t    return ret;\n159\t}\n160\t\n161\t/* Basic test. Just verify that the handshake completes, and that a small\n162\t * document can be downloaded\n163\t */\n164\t\n165\tstatic test_api_stream_desc_t dtn_scenario_basic[] = {\n166\t    { 4, 0, 257, 2000 }\n167\t};\n168\t\n169\tvoid dtn_set_basic_test_spec(dtn_test_spec_t* spec)\n170\t{\n171\t    memset(spec, 0, sizeof(dtn_test_spec_t));\n172\t    spec->latency = 60000000;\n173\t    spec->max_completion_time = 8* spec->latency;\n174\t    spec->ccalgo = picoquic_newreno_algorithm;\n175\t    spec->scenario = dtn_scenario_basic;\n176\t    spec->sizeof_scenario = sizeof(dtn_scenario_basic);\n177\t    spec->mbps_up = 10;\n178\t    spec->mbps_down = 10;\n179\t    spec->has_loss = 0;\n180\t}\n181\t\n182\tint dtn_basic_test(void)\n183\t{\n184\t    /* Simple test. */\n185\t    dtn_test_spec_t spec;\n186\t    dtn_set_basic_test_spec(&spec);\n187\t    spec.max_number_of_packets = 120;\n188\t\n189\t    return dtn_test_one(0xba, &spec);\n190\t}\n191\t\n192\tstatic test_api_stream_desc_t dtn_scenario_data[] = {\n193\t    { 4, 0, 257, 100000000 }\n194\t};\n195\t\n196\t\n197\tint dtn_data_test(void)\n198\t{\n199\t    /* Simple test. */\n200\t    dtn_test_spec_t spec;\n201\t    dtn_set_basic_test_spec(&spec);\n202\t    spec.scenario = dtn_scenario_data;\n203\t    spec.sizeof_scenario = sizeof(dtn_scenario_data);\n204\t    spec.initial_flow_control_credit = 100000000; /* 100 MB, same as data size in scenario */\n205\t    spec.max_completion_time = 500000000; /* 8 minutes and 20 sec, including 2 minutes handshae, 2 minutes req/resp, 2 minutes chirp... */\n206\t    return dtn_test_one(0xda, &spec);\n207\t}\n208\t\n209\t\n210\tstatic test_api_stream_desc_t dtn_scenario_silence[] = {\n211\t    { 4, 0, 257, 257 },\n212\t    { 8, 4, 257, 257 },\n213\t    { 12, 8, 257, 257 }\n214\t};\n215\t\n216\tint dtn_silence_test(void)\n217\t{\n218\t    /* Simple test. */\n219\t    dtn_test_spec_t spec;\n220\t    dtn_set_basic_test_spec(&spec);\n221\t    spec.scenario = dtn_scenario_silence;\n222\t    spec.sizeof_scenario = sizeof(dtn_scenario_silence);\n223\t    spec.max_number_of_packets = 120; /* Check that the number of packets does not increase wildly */\n224\t    spec.max_completion_time = 481000000; /* 8 minutes: 2 for handshake, plus 2 per transaction */\n225\t    return dtn_test_one(0x51, &spec);\n226\t}\n227\t\n228\tint dtn_twenty_test(void)\n229\t{\n230\t    /* Simple test. */\n231\t    dtn_test_spec_t spec;\n232\t    dtn_set_basic_test_spec(&spec);\n233\t    spec.latency = 20 * 60000000;\n234\t    spec.max_completion_time = 8* spec.latency;\n235\t\n236\t    spec.max_number_of_packets = 190;\n237\t\n238\t    return dtn_test_one(0x20, &spec);\n239\t}\n240\t"}]},"parent_tool_use_id":null,"session_id":"17072f18-9969-498e-bec6-45838e44ca80","uuid":"b1d2a006-6abd-4669-a083-50a406de056c","timestamp":"2026-05-05T02:59:25.858Z","tool_use_result":{"type":"text","file":{"filePath":"/Users/richbarn/Projects/picoquic/picoquictest/delay_tolerant_test.c","content":"/*\n* Author: Christian Huitema\n* Copyright (c) 2021, Private Octopus, Inc.\n* All rights reserved.\n*\n* Permission to use, copy, modify, and distribute this software for any\n* purpose with or without fee is hereby granted, provided that the above\n* copyright notice and this permission notice appear in all copies.\n*\n* THIS SOFTWARE IS PROVIDED BY THE COPYRIGHT HOLDERS AND CONTRIBUTORS \"AS IS\" AND\n* ANY EXPRESS OR IMPLIED WARRANTIES, INCLUDING, BUT NOT LIMITED TO, THE IMPLIED\n* WARRANTIES OF MERCHANTABILITY AND FITNESS FOR A PARTICULAR PURPOSE ARE\n* DISCLAIMED. IN NO EVENT SHALL Private Octopus, Inc. BE LIABLE FOR ANY\n* DIRECT, INDIRECT, INCIDENTAL, SPECIAL, EXEMPLARY, OR CONSEQUENTIAL DAMAGES\n* (INCLUDING, BUT NOT LIMITED TO, PROCUREMENT OF SUBSTITUTE GOODS OR SERVICES;\n* LOSS OF USE, DATA, OR PROFITS; OR BUSINESS INTERRUPTION) HOWEVER CAUSED AND\n* ON ANY THEORY OF LIABILITY, WHETHER IN CONTRACT, STRICT LIABILITY, OR TORT\n* (INCLUDING NEGLIGENCE OR OTHERWISE) ARISING IN ANY WAY OUT OF THE USE OF THIS\n* SOFTWARE, EVEN IF ADVISED OF THE POSSIBILITY OF SUCH DAMAGE.\n*/\n\n#include \"picoquic_internal.h\"\n#include \"picoquic_utils.h\"\n#include \"tls_api.h\"\n#include \"picoquictest_internal.h\"\n#ifdef _WINDOWS\n#include \"wincompat.h\"\n#pragma warning(disable:4204)\n#endif\n#include <picotls.h>\n#include <stddef.h>\n#include <stdlib.h>\n#include <string.h>\n#include \"picoquic_binlog.h\"\n#include \"csv.h\"\n#include \"qlog.h\"\n#include \"autoqlog.h\"\n#include \"picoquic_logger.h\"\n#include \"performance_log.h\"\n#include \"picoquictest.h\"\n#include \"picoquic_newreno.h\"\n\n\n/* Delay tolerant networking tests.\n *  \n * These tests are added at the request of Marc Blanchet, who would like\n * to study usability of QUIC in \"deep space\" scenarios. The pre-existing\n * \"high latency\" test demonstrate use of a non-modified QUIC stack with\n * latency of 5 seconds, or RTT of 10 seconds. This is enough for lunar\n * communication, but not adequate for communication with distant planets,\n * let alone communication with probes leaving the solar system. In\n * contrast with the basic high latency tests, the delay tolerant tests\n * assume that the QUIC stack is reconfigured to handle large delays,\n * with special configuration of both clients and servers. The tests\n * help us design the corresponding extension.\n */\n\ntypedef struct st_dtn_test_spec_t {\n    uint64_t latency;\n    uint64_t max_completion_time;\n    picoquic_congestion_algorithm_t* ccalgo;\n    test_api_stream_desc_t* scenario;\n    size_t sizeof_scenario;\n    uint64_t mbps_up;\n    uint64_t mbps_down;\n    uint64_t initial_flow_control_credit;\n    uint64_t max_number_of_packets;\n    int has_loss;\n} dtn_test_spec_t;\n\nstatic int dtn_test_one(uint8_t test_id, dtn_test_spec_t * spec)\n{\n    uint64_t simulated_time = 0;\n    uint64_t picoseq_per_byte_up = (1000000ull * 8) / spec->mbps_up;\n    uint64_t picoseq_per_byte_down = (1000000ull * 8) / spec->mbps_down;\n    picoquic_tp_t client_parameters;\n    picoquic_tp_t server_parameters;\n    picoquic_connection_id_t initial_cid = { {0xde, 0x40, 0, 0, 0, 0, 0, 0}, 8 };\n    picoquic_test_tls_api_ctx_t* test_ctx = NULL;\n    int ret = 0;\n\n    initial_cid.id[2] = test_id;\n\n    memset(&client_parameters, 0, sizeof(picoquic_tp_t));\n    picoquic_init_transport_parameters(&client_parameters);\n    client_parameters.enable_time_stamp = 3;\n    client_parameters.max_idle_timeout = (uint32_t)((spec->latency * 5)/1000);\n    if (spec->initial_flow_control_credit > client_parameters.initial_max_data) {\n        client_parameters.initial_max_data = spec->initial_flow_control_credit;\n    }\n    if (spec->initial_flow_control_credit > client_parameters.initial_max_stream_data_bidi_local ) {\n        client_parameters.initial_max_stream_data_bidi_local = spec->initial_flow_control_credit;\n    }\n    if (spec->initial_flow_control_credit > client_parameters.initial_max_stream_data_bidi_remote ) {\n        client_parameters.initial_max_stream_data_bidi_remote = spec->initial_flow_control_credit;\n    }\n    memset(&server_parameters, 0, sizeof(picoquic_tp_t));\n    picoquic_init_transport_parameters(&server_parameters);\n    server_parameters.enable_time_stamp = 3;\n    server_parameters.max_idle_timeout = client_parameters.max_idle_timeout;\n\n    ret = tls_api_one_scenario_init_ex(&test_ctx, &simulated_time, PICOQUIC_INTERNAL_TEST_VERSION_1, &client_parameters, &server_parameters, &initial_cid);\n\n    if (ret == 0 && test_ctx == NULL) {\n        ret = -1;\n    }\n\n    if (ret == 0) {\n        picoquic_set_default_congestion_algorithm(test_ctx->qserver, spec->ccalgo);\n        picoquic_set_congestion_algorithm(test_ctx->cnx_client, spec->ccalgo);\n\n        test_ctx->c_to_s_link->microsec_latency = spec->latency;\n        test_ctx->c_to_s_link->picosec_per_byte = picoseq_per_byte_up;\n        test_ctx->s_to_c_link->microsec_latency = spec->latency;\n        test_ctx->s_to_c_link->picosec_per_byte = picoseq_per_byte_down;\n        test_ctx->stream0_flow_release = 1;\n        test_ctx->immediate_exit = 1;\n\n        picoquic_cnx_set_pmtud_required(test_ctx->cnx_client, 1);\n\n        /* Set the binary log on the server side */\n        picoquic_set_qlog(test_ctx->qserver, \".\");\n        test_ctx->qserver->use_long_log = 1;\n\n        /* set the binary log on the client side */\n        picoquic_set_qlog(test_ctx->qclient, \".\");\n        test_ctx->qclient->use_long_log = 1;\n\n        if (ret == 0) {\n            ret = tls_api_one_scenario_body(test_ctx, &simulated_time,\n                spec->scenario, spec->sizeof_scenario, 0, (spec->has_loss) ? 0x10000000 : 0, 0, 2 * spec->latency, spec->max_completion_time);\n        }\n    }\n\n    /* Free the resource, which will close the log file.\n     */\n\n    if (test_ctx != NULL) {\n        if (spec->max_number_of_packets != 0 && ret == 0) {\n            if (test_ctx->cnx_client != NULL) {\n                uint64_t number_of_packets = test_ctx->cnx_client->nb_packets_sent + test_ctx->cnx_client->nb_packets_received;\n\n                if (number_of_packets > spec->max_number_of_packets) {\n                    DBG_PRINTF(\"Expected at most %\" PRIu64 \"packets, got %\" PRIu64,\n                        spec->max_number_of_packets, number_of_packets);\n                    ret = -1;\n                }\n            }\n            else {\n                DBG_PRINTF(\"%s\", \"Cannot estimate number of packets\");\n                ret = -1;\n            }\n        }\n        tls_api_delete_ctx(test_ctx);\n        test_ctx = NULL;\n    }\n\n    return ret;\n}\n\n/* Basic test. Just verify that the handshake completes, and that a small\n * document can be downloaded\n */\n\nstatic test_api_stream_desc_t dtn_scenario_basic[] = {\n    { 4, 0, 257, 2000 }\n};\n\nvoid dtn_set_basic_test_spec(dtn_test_spec_t* spec)\n{\n    memset(spec, 0, sizeof(dtn_test_spec_t));\n    spec->latency = 60000000;\n    spec->max_completion_time = 8* spec->latency;\n    spec->ccalgo = picoquic_newreno_algorithm;\n    spec->scenario = dtn_scenario_basic;\n    spec->sizeof_scenario = sizeof(dtn_scenario_basic);\n    spec->mbps_up = 10;\n    spec->mbps_down = 10;\n    spec->has_loss = 0;\n}\n\nint dtn_basic_test(void)\n{\n    /* Simple test. */\n    dtn_test_spec_t spec;\n    dtn_set_basic_test_spec(&spec);\n    spec.max_number_of_packets = 120;\n\n    return dtn_test_one(0xba, &spec);\n}\n\nstatic test_api_stream_desc_t dtn_scenario_data[] = {\n    { 4, 0, 257, 100000000 }\n};\n\n\nint dtn_data_test(void)\n{\n    /* Simple test. */\n    dtn_test_spec_t spec;\n    dtn_set_basic_test_spec(&spec);\n    spec.scenario = dtn_scenario_data;\n    spec.sizeof_scenario = sizeof(dtn_scenario_data);\n    spec.initial_flow_control_credit = 100000000; /* 100 MB, same as data size in scenario */\n    spec.max_completion_time = 500000000; /* 8 minutes and 20 sec, including 2 minutes handshae, 2 minutes req/resp, 2 minutes chirp... */\n    return dtn_test_one(0xda, &spec);\n}\n\n\nstatic test_api_stream_desc_t dtn_scenario_silence[] = {\n    { 4, 0, 257, 257 },\n    { 8, 4, 257, 257 },\n    { 12, 8, 257, 257 }\n};\n\nint dtn_silence_test(void)\n{\n    /* Simple test. */\n    dtn_test_spec_t spec;\n    dtn_set_basic_test_spec(&spec);\n    spec.scenario = dtn_scenario_silence;\n    spec.sizeof_scenario = sizeof(dtn_scenario_silence);\n    spec.max_number_of_packets = 120; /* Check that the number of packets does not increase wildly */\n    spec.max_completion_time = 481000000; /* 8 minutes: 2 for handshake, plus 2 per transaction */\n    return dtn_test_one(0x51, &spec);\n}\n\nint dtn_twenty_test(void)\n{\n    /* Simple test. */\n    dtn_test_spec_t spec;\n    dtn_set_basic_test_spec(&spec);\n    spec.latency = 20 * 60000000;\n    spec.max_completion_time = 8* spec.latency;\n\n    spec.max_number_of_packets = 190;\n\n    return dtn_test_one(0x20, &spec);\n}\n","numLines":240,"startLine":1,"totalLines":240}}}
