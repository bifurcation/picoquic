   ret = -1;\n1841\t    }\n1842\t\n1843\t    if (ret == 0) {\n1844\t        /* add data to the stream to elicit some bad behavior */\n1845\t        uint8_t bogus_data[4] = { 1, 2, 3, 4 }; \n1846\t        if (picoquic_add_to_stream(test_ctx->cnx_server, test_stream, bogus_data, 4, 1) == 0) {\n1847\t            DBG_PRINTF(\"Adding on stream %\" PRIu64 \" after reset should be forbidden\", test_stream);\n1848\t            ret = -1;\n1849\t        }\n1850\t    }\n1851\t\n1852\t    if (ret == 0) {\n1853\t        /* add data to the stream to elicit some bad behavior */\n1854\t        uint8_t bogus_context[4] = { 0, 0, 0, 0 };\n1855\t        if (picoquic_mark_active_stream(test_ctx->cnx_server, test_stream, 1, bogus_context) == 0) {\n1856\t            DBG_PRINTF(\"Marking stream %\" PRIu64 \" active after reset should be forbidden\", test_stream);\n1857\t            ret = -1;\n1858\t        }\n1859\t    }\n1860\t\n1861\t    /* Do a loop to check the behavior */\n1862\t    if (ret == 0) {\n1863\t        timeout = simulated_time + 2000000;\n1864\t        ret = tls_api_wait_for_timeout(test_ctx, &simulated_time, timeout);\n1865\t    }\n1866\t\n1867\t    if (test_ctx != NULL) {\n1868\t        tls_api_delete_ctx(test_ctx);\n1869\t        test_ctx = NULL;\n1870\t    }\n1871\t\n1872\t    return ret;\n1873\t}\n1874\t\n1875\t/*\n1876\t* Add a series of tests for the \"reset_stream_at\" function.\n1877\t* Basic: verify that if one stream is created but not sent yet, we can\n1878\t* reset it and verify that the \"reliable_size\" bytes have been\n1879\t* delivered.\n1880\t*/\n1881\t\n1882\tstatic test_api_stream_desc_t test_scenario_reset_at[] = {\n1883\t    { 4, 0, 257, 1000000 }\n1884\t};\n1885\t\n1886\ttypedef enum {\n1887\t    rsat_basic,\n1888\t    rsat_limit,\n1889\t    rsat_loss\n1890\t} reset_stream_at_test_enum;\n1891\t\n1892\tint reset_stream_at_test_one(reset_stream_at_test_enum rsat_spec)\n1893\t{\n1894\t    /* set a test context, establish the connection, \n1895\t     * ensure that reset_at is supported.\n1896\t     */\n1897\t    uint64_t simulated_time = 0;\n1898\t    uint64_t loss_mask = 0;\n1899\t    uint64_t timeout = 0;\n1900\t    uint64_t reliable_size = 0;\n1901\t    uint64_t sent_limit = 0;\n1902\t\n1903\t    picoquic_connection_id_t icid = { { 0x8e, 0x5e, 0x57, 0xa7, 0, 0, 0, 0}, 8 };\n1904\t    picoquic_test_tls_api_ctx_t* test_ctx = NULL;\n1905\t    int ret;\n1906\t    \n1907\t    icid.id[4] = (uint8_t)rsat_spec;\n1908\t\n1909\t    ret = tls_api_init_ctx_ex(&test_ctx, PICOQUIC_INTERNAL_TEST_VERSION_1,\n1910\t        PICOQUIC_TEST_SNI, PICOQUIC_TEST_ALPN, &simulated_time, NULL, NULL, 0, 1, 0, &icid);\n1911\t\n1912\t    if (ret == 0) {\n1913\t        /* set parameters */\n1914\t        test_ctx->qserver->default_tp.is_reset_stream_at_enabled = 1;\n1915\t        test_ctx->cnx_client->local_parameters.is_reset_stream_at_enabled = 1;\n1916\t        /* request logs */\n1917\t        test_ctx->qserver->use_long_log = 1;\n1918\t        picoquic_set_qlog(test_ctx->qserver, \".\");\n1919\t        test_ctx->qclient->use_long_log = 1;\n1920\t        picoquic_set_qlog(test_ctx->qclient, \".\");\n1921\t        /* start connection */\n1922\t        ret = picoquic_start_client_cnx(test_ctx->cnx_client);\n1923\t    }\n1924\t    if (ret == 0) {\n1925\t        ret = tls_api_connection_loop(test_ctx, &loss_mask, 0, &simulated_time);\n1926\t    }\n1927\t\n1928\t    if (ret == 0) {\n1929\t        if (!test_ctx->cnx_client->is_reset_stream_at_enabled ||\n1930\t            !test_ctx->cnx_server->is_reset_stream_at_enabled) {\n1931\t            DBG_PRINTF(\"Fail no negotiate reset_at, client: %d, server: %d\",\n1932\t                test_ctx->cnx_client->is_reset_stream_at_enabled,\n1933\t                test_ctx->cnx_server->is_reset_stream_at_enabled);\n1934\t            ret = -1;\n1935\t        }\n1936\t    }\n1937\t\n1938\t    if (ret == 0 && rsat_spec == rsat_loss) {\n1939\t        loss_mask = 0xf0a05007030c9042ull;\n1940\t    }\n1941\t\n1942\t    /* Prepare to send data */\n1943\t    ret = test_api_init_send_recv_scenario(test_ctx, test_scenario_reset_at, sizeof(test_scenario_reset_at));\n1944\t\n1945\t    /* Run a few runs of simulation to make sure that some amount of data is sent */\n1946\t    if (ret == 0) {\n1947\t        timeout = 30000;\n1948\t        ret = tls_api_wait_for_timeout(test_ctx, &simulated_time, timeout);\n1949\t    }\n1950\t\n1951\t    if (ret == 0) {\n1952\t        uint64_t received = test_ctx->test_stream[0].r_recv_nb;\n1953\t        picoquic_stream_head_t* stream = NULL;\n1954\t        if ((stream = picoquic_find_stream(test_ctx->cnx_server, 4)) == NULL) {\n1955\t            ret = -1;\n1956\t        }\n1957\t        else {\n1958\t            sent_limit = stream->sent_offset;\n1959\t        }\n1960\t\n1961\t        switch (rsat_spec) {\n1962\t        case rsat_limit:\n1963\t            /* receive everything that was already sent, but no more */\n1964\t            reliable_size = sent_limit;\n1965\t            break;\n1966\t        case rsat_loss:\n1967\t            /* ask for more data than was received, to test loss recovery vs reset */\n1968\t            reliable_size = received + 5000;\n1969\t            break;\n1970\t        case rsat_basic:\n1971\t            default:\n1972\t            /* Very basic scenario: reset at something almost already received */\n1973\t            reliable_size = received + 1;\n1974\t            break;\n1975\t        }\n1976\t\n1977\t        if (reliable_size > sent_limit) {\n1978\t            reliable_size = sent_limit;\n1979\t        }\n1980\t        \n1981\t        if (reliable_size > 0) {\n1982\t            ret = picoquic_reset_stream_at(test_ctx->cnx_server, 4, 0, reliable_size);\n1983\t        }\n1984\t    }\n1985\t\n1986\t    if (ret == 0) {\n1987\t        ret = tls_api_data_sending_loop(test_ctx, &loss_mask, &simulated_time, 1000);\n1988\t    }\n1989\t\n1990\t    if (ret == 0 && !test_ctx->test_finished) {\n1991\t        DBG_PRINTF(\"Faile