   /* Set the timeout */\n646\t        picoquic_set_default_idle_timeout(test_ctx->qclient, client_timeout);\n647\t        picoquic_set_default_idle_timeout(test_ctx->qserver, server_timeout);\n648\t        /* Directly set the timeout in the client parameters,\n649\t           because the connection context is already created */\n650\t        test_ctx->cnx_client->local_parameters.max_idle_timeout = client_timeout;\n651\t    }\n652\t\n653\t    /* Do the connection */\n654\t    if (ret == 0) {\n655\t        test_ctx->cnx_client->max_early_data_size = 0;\n656\t\n657\t        if ((ret = picoquic_start_client_cnx(test_ctx->cnx_client)) == 0) {\n658\t            ret = tls_api_connection_loop(test_ctx, &loss_mask, 0, &simulated_time);\n659\t        }\n660\t    }\n661\t\n662\t    /* Verify the timer negotiation */\n663\t    if (ret == 0) {\n664\t        if (test_ctx->cnx_client->local_parameters.max_idle_timeout != client_timeout) {\n665\t            DBG_PRINTF(\"Idle timeout test %d. Client parameter set to %\" PRIu64 \" instead of %\" PRIu64 \"\\n\",\n666\t                test_id, test_ctx->cnx_client->local_parameters.max_idle_timeout, client_timeout);\n667\t            ret = -1;\n668\t        }\n669\t        if (test_ctx->cnx_server->local_parameters.max_idle_timeout != server_timeout) {\n670\t            DBG_PRINTF(\"Idle timeout test %d. Server parameter set to %\" PRIu64 \" instead of %\" PRIu64 \"\\n\",\n671\t                test_id, test_ctx->cnx_server->local_parameters.max_idle_timeout, server_timeout);\n672\t            ret = -1;\n673\t        }\n674\t        if (test_ctx->cnx_client->idle_timeout != expected_timeout) {\n675\t            DBG_PRINTF(\"Idle timeout test %d. Client negotiated %\" PRIu64 \" instead of %\" PRIu64 \"\\n\",\n676\t                test_id, test_ctx->cnx_client->idle_timeout, expected_timeout);\n677\t            ret = -1;\n678\t        }\n679\t        if (test_ctx->cnx_server->idle_timeout != expected_timeout) {\n680\t            DBG_PRINTF(\"Idle timeout test %d. Server negotiated %\" PRIu64 \" instead of %\" PRIu64 \"\\n\",\n681\t                test_id, test_ctx->cnx_server->idle_timeout, expected_timeout);\n682\t            ret = -1;\n683\t        }\n684\t    }\n685\t\n686\t    if (ret == 0) {\n687\t        /* Wait for half time. Expectation: connections are still up */\n688\t        ret = tls_api_wait_for_timeout(test_ctx, &simulated_time, half_time);\n689\t        if (ret != 0 || !((TEST_CLIENT_READY && TEST_SERVER_READY))) {\n690\t            DBG_PRINTF(\"Idle timeout test %d. Broke early, time = %\" PRIu64 \"\\n\", test_id, simulated_time);\n691\t            ret = -1;\n692\t        }\n693\t    }\n694\t\n695\t    if (ret == 0) {\n696\t        /* Wait for full time. Expectation: connections are down, unless timeout == 0 */\n697\t        ret = tls_api_wait_for_timeout(test_ctx, &simulated_time, full_time);\n698\t\n699\t        if (ret == 0){\n700\t            if (TEST_CLIENT_READY && TEST_SERVER_READY) {\n701\t                if (expected_timeout != UINT64_MAX) {\n702\t                    DBG_PRINTF(\"Idle timeout test %d. Waited too long, time = %\" PRIu64 \"\\n\", test_id, simulated_time);\n703\t                    ret = -1;\n704\t                }\n705\t            }\n706\t            else {\n707\t                if (expected_timeout == UINT64_MAX) {\n708\t                    DBG_PRINTF(\"Idle timeout test %d. Broke early, time = %\" PRIu64 \"\\n\", test_id, simulated_time);\n709\t                    ret = -1;\n710\t                }\n711\t            }\n712\t        }\n713\t    }\n714\t\n715\t    if (test_ctx != NULL) {\n716\t        tls_api_delete_ctx(test_ctx);\n717\t        test_ctx = NULL;\n718\t    }\n719\t\n720\t    return ret;\n721\t}\n722\t\n723\tint idle_timeout_test(void)\n724\t{\n725\t    int ret = 0;\n726\t\n727\t    if ((ret = idle_timeout_test_one(1, 30000, 30000, 30000000)) == 0 &&\n728\t        (ret = idle_timeout_test_one(2, 60000, 20000, 20000000)) == 0 &&\n729\t        (ret = idle_timeout_test_one(3, 20000, 60000, 20000000)) == 0 &&\n730\t        (ret = idle_timeout_test_one(4, 5000, 300000, 5000000)) == 0 &&\n731\t        (ret = idle_timeout_test_one(5, 300000, 5000, 5000000)) == 0 &&\n732\t        (ret = idle_timeout_test_one(6, 0, 5000, 5000000)) == 0 &&\n733\t        (ret = idle_timeout_test_one(7, 0, 60000, 60000000)) == 0 &&\n734\t        (ret = idle_timeout_test_one(8, 5000, 0, 5000000)) == 0 &&\n735\t        (ret = idle_timeout_test_one(9, 60000, 0, 60000000)) == 0 &&\n736\t        (ret = idle_timeout_test_one(10, 0, 0, UINT64_MAX)) == 0) {\n737\t        DBG_PRINTF(\"%s\", \"All idle timeout tests pass.\\n\");\n738\t    }\n739\t    return ret;\n740\t}\n741\t\n742\t/* Testing that connection attempt against a non responding server\n743\t * finishes after the timeout value.\n744\t */\n745\t\n746\tint idle_server_test_one(uint8_t test_id, uint64_t client_timeout, uint64_t handshake_timeout, uint64_t expected_timeout)\n747\t{\n748\t    picoquic_test_tls_api_ctx_t* test_ctx = NULL;\n749\t    uint64_t simulated_time = 0;\n750\t    uint64_t target_timeout;\n751\t    picoquic_connection_id_t initial_cid = { { 0x41, 0x9e, 0xc0, 0x99, 0, 0, 0, 0}, 8 };\n752\t    uint8_t send_buffer[PICOQUIC_MAX_PACKET_SIZE];\n753\t    int ret = 0;\n754\t\n755\t    initial_cid.id[4] = test_id;\n756\t\n757\t    /* derive target timeout form spec */\n758\t    target_timeout = handshake_timeout;\n759\t    if (handshake_timeout == 0) {\n760\t        target_timeout = client_timeout * 1000;\n761\t        if (client_timeout == 0) {\n762\t            target_timeout = PICOQUIC_MICROSEC_HANDSHAKE_MAX;\n763\t        }\n764\t    }\n765\t\n766\t    /* Create the test context */\n767\t    if (ret == 0) {\n768\t        ret = tls_api_init_ctx_ex(&test_ctx, PICOQUIC_INTERNAL_TEST_VERSION_1,\n769\t            PICOQUIC_TEST_SNI, PICOQUIC_TEST_ALPN, &simulated_time, NULL, NULL, 0, 1, 0, &initial_cid);\n770\t    }\n771\t\n772\t    /* Set the binlog */\n773\t    if (ret == 0) {\n774\t        picoquic_set_qlog(test_ctx->qclient, \".\");\n775\t        /* Set the timeout */\n776\t        picoquic_set_default_idle_timeout(test_ctx->qclient, client_timeout);\n777\t        if (handshake_timeout > 0) {\n778\t            picoquic_set_default_handshake_timeout(test_ctx->qclient, handshake_timeout);\n779\t        }\n780\t        /* Directly set the timeout in the client parameters,\n781\t        because the connection context is already created */\n782\t        test_ctx->cnx_client->local_parameters.max_idle_timeout = client_timeout;\n783\t        /* Start the client */\n784\t        ret = picoquic_start_client_cnx(test_ctx->cnx_client);\n785\t    }\n786\t\n787\t    /* Run a simulation loop -- the server never responds. */\n788\t    if (ret == 0) {\n789\t        int nb_trials = 0;\n790\t        while (ret == 0 && simulated_time < expected_timeout) {\n791\t            size_t send_length = 0;\n792\t            struct sockaddr_storage addr_to;\n793\t            struct sockaddr_storage addr_from;\n794\t            int if_index;\n795\t\n796\t            ret = picoquic_prepare_packet_ex(test_ctx->cnx_client, simulated_time,\n797\t                send_buffer, sizeof(send_buffer), &send_length,\n798\t                &addr_to, &addr_from, &if_index, NULL);\n799\t            if (ret != 0) {\n800\t                break;\n801\t            }\n802\t            else if (test_ctx->cnx_client->cnx_state == picoquic_state_disconnected) {\n803\t                break;\n804\t            }\n805\t            else if (simulated_time > test_ctx->cnx_client->next_wake_time) {\n806\t                DBG_PRINTF(\"Idle server test %d. Bug, simulation is walking back in time.\", test_id);\n807\t                ret = -1;\n808\t            }\n809\t            else if (nb_trials >= 512) {\n810\t                DBG_PRINTF(\"Idle server test %d. Bug, simulation exceeds %d steps.\", test_id, nb_trials);\n811\t                ret = -1;\n812\t            }\n813\t            else {\n814\t                nb_trials++;\n815\t                simulated_time = test_ctx->cnx_client->next_wake_time;\n816\t            }\n817\t        }\n818\t    }\n819\t\n820\t    if ((ret == 0 && test_ctx->cnx_client->cnx_state == picoquic_state_disconnected) ||\n821\t        ret == PICOQUIC_ERROR_DISCONNECTED) {\n822\t        if (simulated_time < target_timeout) {\n823\t            DBG_PRINTF(\"Idle server test %d. Client gave up too soon, time = %\" PRIu64 \"\\n\", test_id, simulated_time);\n824\t            ret = -1;\n825\t        }\n826\t        else {\n827\t            ret = 0;\n828\t        }\n829\t    }\n830\t    else if (ret == 0) {\n831\t        DBG_PRINTF(\"Idle server test %d. Client did not disconnect, time = %\" PRIu64 \"\\n\", test_id, simulated_time);\n832\t        ret = -1;\n833\t    }\n834\t    else {\n835\t        DBG_PRINTF(\"Idle server test %d. ret=0x%x, time = %\" PRIu64 \"\\n\", ret, test_id, simulated_time);\n836\t    }\n837\t\n838\t    if (test_ctx != NULL) {\n839\t        tls_api_delete_ctx(test_ctx);\n840\t        test_ctx = NULL;\n841\t    }\n842\t\n843\t    return ret;\n844\t}\n845\t\n846\tint idle_server_test(void)\n847\t{\n848\t    int ret = 0;\n849\t\n850\t    if ((ret = idle_server_test_one(1, 30000, 0, 30100000)) == 0 &&\n851\t        (ret = idle_server_test_one(2, 60000, 0, 60100000)) == 0 &&\n852\t        (ret = idle_server_test_one(3, 5000, 0, 5100000)) == 0 &&\n853\t        (ret = idle_server_test_one(4, 0, 0, 30100000)) == 0 &&\n854\t        (ret = idle_server_test_one(5, 0, 10000, 10100000)) == 0 &&\n855\t        (ret = idle_server_test_one(6, 20000, 60000, 60100000)) == 0 &&\n856\t        (ret = idle_server_test_one(7, 60000, 5000, 5100000)) == 0){\n857\t        DBG_PRINTF(\"%s\", \"All idle timeout tests pass.\\n\");\n858\t    }\n859\t    return ret;\n860\t}\n861\t\n862\t/*\n863\t* Testing issues caused by frame events after a stream is reset.\n864\t* \n865\t* We are concerned with possible errors when copies of \"old\"\n866\t* frames cause processing of a stream after the stream has been\n867\t* closed. This includes:\n868\t* \n869\t* - reset stream frames,\n870\t* - stop sending frames,\n871\t* - max stream data frames.\n872\t* \n873\t* We are concerned with three events:\n874\t* \n875\t* - processing the ACK of a packet that contained the frame, because\n876\t*   the ACK may be received after the reset after the stream context\n877\t*   was deleted,\n878\t* - receiving extra copies of the frames after the stream is deleted.\n879\t*   These extra copies shall be ignored with no side effect.\n880\t* - processing of frames in packets detected as lost after the\n881\t*   stream was deleted. The stack whether the packets needs to\n882\t*   be repeated.\n883\t* \n884\t* The combination of \"ack/extra/need\" with three frame types produces\n885\t* 9 possible tests. However, there is no acking processing for\n886\t* stop sending frames, so we do not implement a test for\n887\t* \"reset_ack_stop_sending\".\n888\t */\n889\t\n890\ttypedef enum {\n891\t    reset_ack_max_stream = 0,\n892\t    reset_ack_reset,\n893\t    reset_ack_stop_sending,\n894\t    reset_extra_max_stream,\n895\t    reset_extra_reset,\n896\t    reset_extra_stop_sending,\n897\t    reset_need_max_stream,\n898\t    reset_need_reset,\n899\t    reset_need_stop_sending\n900\t} reset_test_enum;\n901\t\n902\tstatic test_api_stream_desc_t test_scenario_edge_reset[] = {\n903\t    { 4, 0, 1000000, 1000000 }\n904\t};\n905\t\n906\tint picoquic_process_ack_of_reset_stream_frame(picoquic_cnx_t* cnx, const uint8_t* bytes, size_t bytes_size, size_t* consumed);\n907\tint picoquic_process_ack_of_max_stream_data_frame(picoquic_cnx_t* cnx, const uint8_t* bytes,\n908\t    size_t bytes_size, size_t* consumed);\n909\t\n910\tint reset_repeat_test_receive_frame(int test_id, picoquic_cnx_t * cnx, const uint8_t * frame, size_t frame_size,\n911\t    uint64_t simulated_time, uint64_t stream_id, int do_not_create)\n912\t{\n913\t    picoquic_stream_data_node_t dn;\n914\t    int ret = picoquic_decode_frames(cnx, cnx->path[0], frame, frame_size,\n915\t        &dn, picoquic_epoch_1rtt,\n916\t        (struct sockaddr*)&cnx->path[0]->first_tuple->peer_addr,\n917\t        (struct sockaddr*)&cnx->path[0]->first_tuple->local_addr,\n918\t        123, 0, simulated_time);\n919\t\n920\t    if (ret != 0 || cnx->cnx_state > picoquic_state_ready) {\n921\t        DBG_PRINTF(\"Test %d. Error after stop sending, ret = 0x%x.\", test_id, ret);\n922\t        ret = -1;\n923\t    }\n924\t    else if (ret == 0 && stream_id != UINT64_MAX && do_not_create && picoquic_find_stream(cnx, stream_id) != NULL) {\n925\t        DBG_PRINTF(\"Test %d. Stream %\" PRIu64 \" was created.\", test_id, stream_id);\n926\t        ret = -1;\n927\t    }\n928\t    return ret;\n929\t}\n930\t\n931\tint reset_repeat_test_need_repeat(int test_id, picoquic_cnx_t* cnx, const uint8_t* frame, size_t frame_size)\n932\t{\n933\t    int no_need_to_repeat = 0;\n934\t    int do_not_detect_spurious = 0;\n935\t    int is_preemptive_needed = 0;\n936\t\n937\t    int ret = picoquic_check_frame_needs_repeat(cnx, frame, frame_size, picoquic_packet_1rtt_protected,\n938\t        &no_need_to_repeat, &do_not_detect_spurious, &is_preemptive_needed);\n939\t\n940\t    if (ret != 0 || cnx->cnx_state > picoquic_state_ready || !no_need_to_repeat) {\n941\t        DBG_PRINTF(\"Test %d. Error after ack of frame 0x%x, ret = 0x%x.\", test_id, frame[0], ret);\n942\t        ret = -1;\n943\t    }\n944\t    return ret;\n945\t}\n946\t\n947\tint reset_loop_check_stream_opened(picoquic_test_tls_api_ctx_t* test_ctx, uint64_t data_stream_id)\n948\t{\n949\t    int is_opened = 0;\n950\t    if (test_ctx->cnx_client != NULL && test_ctx->cnx_server != NULL) {\n951\t        picoquic_stream_head_t* c_stream = picoquic_find_stream(test_ctx->cnx_client, data_stream_id);\n952\t        if (c_stream != NULL && c_stream->sent_offset > 10000) {\n953\t            picoquic_stream_head_t* s_stream = picoquic_find_stream(test_ctx->cnx_server, data_stream_id);\n954\t            if (s_stream != NULL) {\n955\t                is_opened = 1;\n956\t            }\n957\t        }\n958\t    }\n959\t    return is_opened;\n960\t}\n961\t\n962\tint reset_loop_wait_stream_opened(picoquic_test_tls_api_ctx_t* test_ctx,\n963\t    uint64_t* simulated_time, uint64_t data_stream_id, uint64_t loop1_time)\n964\t{\n965\t    int ret = 0;\n966\t    int nb_inactive = 0;\n967\t    uint64_t time_out = *simulated_time + loop1_time;\n968\t    int was_active = 0;\n969\t    int is_opened = 0;\n970\t\n971\t    while (ret == 0 && *simulated_time < time_out &&\n972\t        TEST_CLIENT_READY &&\n973\t        TEST_SERVER_READY &&\n974\t        nb_inactive < 64) {\n975\t\n976\t        if (reset_loop_check_stream_opened(test_ctx, data_stream_id)) {\n977\t            is_opened = 1;\n978\t            break;\n979\t        }\n980\t\n981\t        was_active = 0;\n982\t\n983\t        ret = tls_api_one_sim_round(test_ctx, simulated_time, 0, &was_active);\n984\t\n985\t        if (was_active) {\n986\t            nb_inactive = 0;\n987\t        }\n988\t        else {\n989\t            nb_inactive++;\n990\t        }\n991\t    }\n992\t    if (!is_opened) {\n993\t        ret = -1;\n994\t    }\n995\t    return ret;\n996\t}\n997\t\n998\tint reset_repeat_test_one(uint8_t test_id)\n999\t{"}]},"parent_tool_use_id":null,"session_id":"17072f18-9969-498e-bec6-45838e44ca80","uuid":"64872c28-fb98-49a2-8d59-be96b4df6ce2","timestamp":"2026-05-05T03:12:36.453Z","tool_use_result":{"type":"text","file":{"filePath":"/Users/richbarn/Projects/picoquic/picoquictest/edge_cases.c","content":"                ret = -1;\n            }\n            else if (repeat_duration > cnx_server_idle_timeout) {\n                DBG_PRINTF(\"End at t=%\" PRIu64 \", later than %\" PRIu64,\n                    simulated_time, cnx_server_idle_timeout);\n                ret = -1;\n            }\n            else if (cnx_server_nb_preemptive_repeat == 0) {\n                DBG_PRINTF(\"%s\", \"No preemptive repeat\");\n                ret = -1;\n            }\n        }\n    }\n\n    if (test_ctx != NULL) {\n        tls_api_delete_ctx(test_ctx);\n        test_ctx = NULL;\n    }\n\n    return ret;\n}\n\n/* testing the negotiation of the idle timeout.\n*/\nint idle_timeout_test_one(uint8_t test_id, uint64_t client_timeout, uint64_t server_timeout, uint64_t expected_timeout)\n{\n    picoquic_test_tls_api_ctx_t* test_ctx = NULL;\n    uint64_t simulated_time = 0;\n    uint64_t loss_mask = 0;\n    picoquic_connection_id_t initial_cid = { { 0x41, 0x9e, 0x00, 0x94, 0, 0, 0, 0}, 8 };\n    uint64_t half_time = (expected_timeout == UINT64_MAX) ? 20000000 : (expected_timeout / 2);\n    uint64_t full_time = (expected_timeout == UINT64_MAX) ? 600000000 : (half_time + 100000);\n    int ret = 0;\n\n    initial_cid.id[4] = test_id;\n\n    /* Create the test context */\n    if (ret == 0) {\n        ret = tls_api_init_ctx_ex(&test_ctx, PICOQUIC_INTERNAL_TEST_VERSION_1,\n            PICOQUIC_TEST_SNI, PICOQUIC_TEST_ALPN, &simulated_time, NULL, NULL, 0, 1, 0, &initial_cid);\n    }\n    /* Set the binlog */\n    if (ret == 0) {\n        picoquic_set_qlog(test_ctx->qclient, \".\");\n        picoquic_set_qlog(test_ctx->qserver, \".\");\n        /* Set the timeout */\n        picoquic_set_default_idle_timeout(test_ctx->qclient, client_timeout);\n        picoquic_set_default_idle_timeout(test_ctx->qserver, server_timeout);\n        /* Directly set the timeout in the client parameters,\n           because the connection context is already created */\n        test_ctx->cnx_client->local_parameters.max_idle_timeout = client_timeout;\n    }\n\n    /* Do the connection */\n    if (ret == 0) {\n        test_ctx->cnx_client->max_early_data_size = 0;\n\n        if ((ret = picoquic_start_client_cnx(test_ctx->cnx_client)) == 0) {\n            ret = tls_api_connection_loop(test_ctx, &loss_mask, 0, &simulated_time);\n        }\n    }\n\n    /* Verify the timer negotiation */\n    if (ret == 0) {\n        if (test_ctx->cnx_client->local_parameters.max_idle_timeout != client_timeout) {\n            DBG_PRINTF(\"Idle timeout test %d. Client parameter set to %\" PRIu64 \" instead of %\" PRIu64 \"\\n\",\n                test_id, test_ctx->cnx_client->local_parameters.max_idle_timeout, client_timeout);\n            ret = -1;\n        }\n        if (test_ctx->cnx_server->local_parameters.max_idle_timeout != server_timeout) {\n            DBG_PRINTF(\"Idle timeout test %d. Server parameter set to %\" PRIu64 \" instead of %\" PRIu64 \"\\n\",\n                test_id, test_ctx->cnx_server->local_parameters.max_idle_timeout, server_timeout);\n            ret = -1;\n        }\n        if (test_ctx->cnx_client->idle_timeout != expected_timeout) {\n            DBG_PRINTF(\"Idle timeout test %d. Client negotiated %\" PRIu64 \" instead of %\" PRIu64 \"\\n\",\n                test_id, test_ctx->cnx_client->idle_timeout, expected_timeout);\n            ret = -1;\n        }\n        if (test_ctx->cnx_server->idle_timeout != expected_timeout) {\n            DBG_PRINTF(\"Idle timeout test %d. Server negotiated %\" PRIu64 \" instead of %\" PRIu64 \"\\n\",\n                test_id, test_ctx->cnx_server->idle_timeout, expected_timeout);\n            ret = -1;\n        }\n    }\n\n    if (ret == 0) {\n        /* Wait for half time. Expectation: connections are still up */\n        ret = tls_api_wait_for_timeout(test_ctx, &simulated_time, half_time);\n        if (ret != 0 || !((TEST_CLIENT_READY && TEST_SERVER_READY))) {\n            DBG_PRINTF(\"Idle timeout test %d. Broke early, time = %\" PRIu64 \"\\n\", test_id, simulated_time);\n            ret = -1;\n        }\n    }\n\n    if (ret == 0) {\n        /* Wait for full time. Expectation: connections are down, unless timeout == 0 */\n        ret = tls_api_wait_for_timeout(test_ctx, &simulated_time, full_time);\n\n        if (ret == 0){\n            if (TEST_CLIENT_READY && TEST_SERVER_READY) {\n                if (expected_timeout != UINT64_MAX) {\n                    DBG_PRINTF(\"Idle timeout test %d. Waited too long, time = %\" PRIu64 \"\\n\", test_id, simulated_time);\n                    ret = -1;\n                }\n            }\n            else {\n                if (expected_timeout == UINT64_MAX) {\n                    DBG_PRINTF(\"Idle timeout test %d. Broke early, time = %\" PRIu64 \"\\n\", test_id, simulated_time);\n                    ret = -1;\n                }\n            }\n        }\n    }\n\n    if (test_ctx != NULL) {\n        tls_api_delete_ctx(test_ctx);\n        test_ctx = NULL;\n    }\n\n    return ret;\n}\n\nint idle_timeout_test(void)\n{\n    int ret = 0;\n\n    if ((ret = idle_timeout_test_one(1, 30000, 30000, 30000000)) == 0 &&\n        (ret = idle_timeout_test_one(2, 60000, 20000, 20000000)) == 0 &&\n        (ret = idle_timeout_test_one(3, 20000, 60000, 20000000)) == 0 &&\n        (ret = idle_timeout_test_one(4, 5000, 300000, 5000000)) == 0 &&\n        (ret = idle_timeout_test_one(5, 300000, 5000, 5000000)) == 0 &&\n        (ret = idle_timeout_test_one(6, 0, 5000, 5000000)) == 0 &&\n        (ret = idle_timeout_test_one(7, 0, 60000, 60000000)) == 0 &&\n        (ret = idle_timeout_test_one(8, 5000, 0, 5000000)) == 0 &&\n        (ret = idle_timeout_test_one(9, 60000, 0, 60000000)) == 0 &&\n        (ret = idle_timeout_test_one(10, 0, 0, UINT64_MAX)) == 0) {\n        DBG_PRINTF(\"%s\", \"All idle timeout tests pass.\\n\");\n    }\n    return ret;\n}\n\n/* Testing that connection attempt against a non responding server\n * finishes after the timeout value.\n */\n\nint idle_server_test_one(uint8_t test_id, uint64_t client_timeout, uint64_t handshake_timeout, uint64_t expected_timeout)\n{\n    picoquic_test_tls_api_ctx_t* test_ctx = NULL;\n    uint64_t simulated_time = 0;\n    uint64_t target_timeout;\n    picoquic_connection_id_t initial_cid = { { 0x41, 0x9e, 0xc0, 0x99, 0, 0, 0, 0}, 8 };\n    uint8_t send_buffer[PICOQUIC_MAX_PACKET_SIZE];\n    int ret = 0;\n\n    initial_cid.id[4] = test_id;\n\n    /* derive target timeout form spec */\n    target_timeout = handshake_timeout;\n    if (handshake_timeout == 0) {\n        target_timeout = client_timeout * 1000;\n        if (client_timeout == 0) {\n            target_timeout = PICOQUIC_MICROSEC_HANDSHAKE_MAX;\n        }\n    }\n\n    /* Create the test context */\n    if (ret == 0) {\n        ret = tls_api_init_ctx_ex(&test_ctx, PICOQUIC_INTERNAL_TEST_VERSION_1,\n            PICOQUIC_TEST_SNI, PICOQUIC_TEST_ALPN, &simulated_time, NULL, NULL, 0, 1, 0, &initial_cid);\n    }\n\n    /* Set the binlog */\n    if (ret == 0) {\n        picoquic_set_qlog(test_ctx->qclient, \".\");\n        /* Set the timeout */\n        picoquic_set_default_idle_timeout(test_ctx->qclient, client_timeout);\n        if (handshake_timeout > 0) {\n            picoquic_set_default_handshake_timeout(test_ctx->qclient, handshake_timeout);\n        }\n        /* Directly set the timeout in the client parameters,\n        because the connection context is already created */\n        test_ctx->cnx_client->local_parameters.max_idle_timeout = client_timeout;\n        /* Start the client */\n        ret = picoquic_start_client_cnx(test_ctx->cnx_client);\n    }\n\n    /* Run a simulation loop -- the server never responds. */\n    if (ret == 0) {\n        int nb_trials = 0;\n        while (ret == 0 && simulated_time < expected_timeout) {\n            size_t send_length = 0;\n            struct sockaddr_storage addr_to;\n            struct sockaddr_storage addr_from;\n            int if_index;\n\n            ret = picoquic_prepare_packet_ex(test_ctx->cnx_client, simulated_time,\n                send_buffer, sizeof(send_buffer), &send_length,\n                &addr_to, &addr_from, &if_index, NULL);\n            if (ret != 0) {\n                break;\n            }\n            else if (test_ctx->cnx_client->cnx_state == picoquic_state_disconnected) {\n                break;\n            }\n            else if (simulated_time > test_ctx->cnx_client->next_wake_time) {\n                DBG_PRINTF(\"Idle server test %d. Bug, simulation is walking back in time.\", test_id);\n                ret = -1;\n            }\n            else if (nb_trials >= 512) {\n                DBG_PRINTF(\"Idle server test %d. Bug, simulation exceeds %d steps.\", test_id, nb_trials);\n                ret = -1;\n            }\n            else {\n                nb_trials++;\n                simulated_time = test_ctx->cnx_client->next_wake_time;\n            }\n        }\n    }\n\n    if ((ret == 0 && test_ctx->cnx_client->cnx_state == picoquic_state_disconnected) ||\n        ret == PICOQUIC_ERROR_DISCONNECTED) {\n        if (simulated_time < target_timeout) {\n            DBG_PRINTF(\"Idle server test %d. Client gave up too soon, time = %\" PRIu64 \"\\n\", test_id, simulated_time);\n            ret = -1;\n        }\n        else {\n            ret = 0;\n        }\n    }\n    else if (ret == 0) {\n        DBG_PRINTF(\"Idle server test %d. Client did not disconnect, time = %\" PRIu64 \"\\n\", test_id, simulated_time);\n        ret = -1;\n    }\n    else {\n        DBG_PRINTF(\"Idle server test %d. ret=0x%x, time = %\" PRIu64 \"\\n\", ret, test_id, simulated_time);\n    }\n\n    if (test_ctx != NULL) {\n        tls_api_delete_ctx(test_ctx);\n        test_ctx = NULL;\n    }\n\n    return ret;\n}\n\nint idle_server_test(void)\n{\n    int ret = 0;\n\n    if ((ret = idle_server_test_one(1, 30000, 0, 30100000)) == 0 &&\n        (ret = idle_server_test_one(2, 60000, 0, 60100000)) == 0 &&\n        (ret = idle_server_test_one(3, 5000, 0, 5100000)) == 0 &&\n        (ret = idle_server_test_one(4, 0, 0, 30100000)) == 0 &&\n        (ret = idle_server_test_one(5, 0, 10000, 10100000)) == 0 &&\n        (ret = idle_server_test_one(6, 20000, 60000, 60100000)) == 0 &&\n        (ret = idle_server_test_one(7, 60000, 5000, 5100000)) == 0){\n        DBG_PRINTF(\"%s\", \"All idle timeout tests pass.\\n\");\n    }\n    return ret;\n}\n\n/*\n* Testing issues caused by frame events after a stream is reset.\n* \n* We are concerned with possible errors when copies of \"old\"\n* frames cause processing of a stream after the stream has been\n* closed. This includes:\n* \n* - reset stream frames,\n* - stop sending frames,\n* - max stream data frames.\n* \n* We are concerned with three events:\n* \n* - processing the ACK of a packet that contained the frame, because\n*   the ACK may be received after the reset after the stream context\n*   was deleted,\n* - receiving extra copies of the frames after the stream is deleted.\n*   These extra copies shall be ignored with no side effect.\n* - processing of frames in packets detected as lost after the\n*   stream was deleted. The stack whether the packets needs to\n*   be repeated.\n* \n* The combination of \"ack/extra/need\" with three frame types produces\n* 9 possible tests. However, there is no acking processing for\n* stop sending frames, so we do not implement a test for\n* \"reset_ack_stop_sending\".\n */\n\ntypedef enum {\n    reset_ack_max_stream = 0,\n    reset_ack_reset,\n    reset_ack_stop_sending,\n    reset_extra_max_stream,\n    reset_extra_reset,\n    reset_extra_stop_sending,\n    reset_need_max_stream,\n    reset_need_reset,\n    reset_need_stop_sending\n} reset_test_enum;\n\nstatic test_api_stream_desc_t test_scenario_edge_reset[] = {\n    { 4, 0, 1000000, 1000000 }\n};\n\nint picoquic_process_ack_of_reset_stream_frame(picoquic_cnx_t* cnx, const uint8_t* bytes, size_t bytes_size, size_t* consumed);\nint picoquic_process_ack_of_max_stream_data_frame(picoquic_cnx_t* cnx, const uint8_t* bytes,\n    size_t bytes_size, size_t* consumed);\n\nint reset_repeat_test_receive_frame(int test_id, picoquic_cnx_t * cnx, const uint8_t * frame, size_t frame_size,\n    uint64_t simulated_time, uint64_t stream_id, int do_not_create)\n{\n    picoquic_stream_data_node_t dn;\n    int ret = picoquic_decode_frames(cnx, cnx->path[0], frame, frame_size,\n        &dn, picoquic_epoch_1rtt,\n        (struct sockaddr*)&cnx->path[0]->first_tuple->peer_addr,\n        (struct sockaddr*)&cnx->path[0]->first_tuple->local_addr,\n        123, 0, simulated_time);\n\n    if (ret != 0 || cnx->cnx_state > picoquic_state_ready) {\n        DBG_PRINTF(\"Test %d. Error after stop sending, ret = 0x%x.\", test_id, ret);\n        ret = -1;\n    }\n    else if (ret == 0 && stream_id != UINT64_MAX && do_not_create && picoquic_find_stream(cnx, stream_id) != NULL) {\n        DBG_PRINTF(\"Test %d. Stream %\" PRIu64 \" was created.\", test_id, stream_id);\n        ret = -1;\n    }\n    return ret;\n}\n\nint reset_repeat_test_need_repeat(int test_id, picoquic_cnx_t* cnx, const uint8_t* frame, size_t frame_size)\n{\n    int no_need_to_repeat = 0;\n    int do_not_detect_spurious = 0;\n    int is_preemptive_needed = 0;\n\n    int ret = picoquic_check_frame_needs_repeat(cnx, frame, frame_size, picoquic_packet_1rtt_protected,\n        &no_need_to_repeat, &do_not_detect_spurious, &is_preemptive_needed);\n\n    if (ret != 0 || cnx->cnx_state > picoquic_state_ready || !no_need_to_repeat) {\n        DBG_PRINTF(\"Test %d. Error after ack of frame 0x%x, ret = 0x%x.\", test_id, frame[0], ret);\n        ret = -1;\n    }\n    return ret;\n}\n\nint reset_loop_check_stream_opened(picoquic_test_tls_api_ctx_t* test_ctx, uint64_t data_stream_id)\n{\n    int is_opened = 0;\n    if (test_ctx->cnx_client != NULL && test_ctx->cnx_server != NULL) {\n        picoquic_stream_head_t* c_stream = picoquic_find_stream(test_ctx->cnx_client, data_stream_id);\n        if (c_stream != NULL && c_stream->sent_offset > 10000) {\n            picoquic_stream_head_t* s_stream = picoquic_find_stream(test_ctx->cnx_server, data_stream_id);\n            if (s_stream != NULL) {\n                is_opened = 1;\n            }\n        }\n    }\n    return is_opened;\n}\n\nint reset_loop_wait_stream_opened(picoquic_test_tls_api_ctx_t* test_ctx,\n    uint64_t* simulated_time, uint64_t data_stream_id, uint64_t loop1_time)\n{\n    int ret = 0;\n    int nb_inactive = 0;\n    uint64_t time_out = *simulated_time + loop1_time;\n    int was_active = 0;\n    int is_opened = 0;\n\n    while (ret == 0 && *simulated_time < time_out &&\n        TEST_CLIENT_READY &&\n        TEST_SERVER_READY &&\n        nb_inactive < 64) {\n\n        if (reset_loop_check_stream_opened(test_ctx, data_stream_id)) {\n            is_opened = 1;\n            break;\n        }\n\n        was_active = 0;\n\n        ret = tls_api_one_sim_round(test_ctx, simulated_time, 0, &was_active);\n\n        if (was_active) {\n            nb_inactive = 0;\n        }\n        else {\n            nb_inactive++;\n        }\n    }\n    if (!is_opened) {\n        ret = -1;\n    }\n    return ret;\n}\n\nint reset_repeat_test_one(uint8_t test_id)\n{","numLines":400,"startLine":600,"totalLines":2166}}}
