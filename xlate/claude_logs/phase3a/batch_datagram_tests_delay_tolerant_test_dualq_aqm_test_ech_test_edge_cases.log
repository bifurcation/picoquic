Eq, Default)]\n140\tpub enum JitterMode {\n141\t    /// Gaussian jitter.  C: `jitter_gauss`.\n142\t    #[default]\n143\t    Gauss = 0,\n144\t    /// Wi-Fi-style jitter.  C: `jitter_wifi`.\n145\t    Wifi = 1,\n146\t}\n147\t\n148\t/// One simulated network link with an embedded queue plus AQM\n149\t/// hook.  C: `picoquictest_sim_link_t`.\n150\t///\n151\t/// Pointer-shape choices, derived from the bodies in\n152\t/// `picoquictest/sim_link.c`:\n153\t///\n154\t/// * `packets` replaces the C `first_packet` / `last_packet`\n155\t///   doubly-linked list head pair plus the per-`TestSimPacket`\n156\t///   `next_packet` chain.\n157\t/// * `loss_mask` — the C field was `*mut u64`, an externally-owned\n158\t///   error mask the link reads on every enqueue.  In the Rust port\n159\t///   the link owns its own copy: tests `&mut link.loss_mask` to\n160\t///   shift the mask between operations.  `None` matches the C\n161\t///   `NULL` sentinel.\n162\t/// * `aqm_state` becomes `Option<Box<dyn TestAqm>>` —\n163\t///   `None` matches the C `NULL` (no AQM installed).\n164\t/// * `is_switched_off` / `is_unreachable` / `is_suspended` were\n165\t///   `int` flags in C; promoted to `bool`.\n166\tpub struct TestSimLink {\n167\t    pub next_send_time: Instant,\n168\t    pub queue_time: Instant,\n169\t    pub resume_time: Instant,\n170\t    pub queue_delay_max: u64,\n171\t    pub picosec_per_byte: u64,\n172\t    pub microsec_latency: u64,\n173\t    pub packets_dropped: u64,\n174\t    pub packets_sent: u64,\n175\t    pub jitter: u64,\n176\t    pub jitter_mode: JitterMode,\n177\t    pub jitter_seed: u64,\n178\t    pub path_mtu: usize,\n179\t    /// Packets in flight on this link.  FIFO; the head is the\n180\t    /// next packet to deliver.\n181\t    pub packets: std::collections::VecDeque<TestSimPacket>,\n182\t    /// 64-bit error mask used in unit tests.  `None` ↔ \"no mask\".\n183\t    pub loss_mask: Option<u64>,\n184\t    pub nb_loss_in_burst: u64,\n185\t    pub packets_between_losses: u64,