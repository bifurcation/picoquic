{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01H7FkPiimhMcW8ghSer5MWb","type":"tool_result","content":"900\t} reset_test_enum;\n901\t\n902\tstatic test_api_stream_desc_t test_scenario_edge_reset[] = {\n903\t    { 4, 0, 1000000, 1000000 }\n904\t};\n905\t\n906\tint picoquic_process_ack_of_reset_stream_frame(picoquic_cnx_t* cnx, const uint8_t* bytes, size_t bytes_size, size_t* consumed);\n907\tint picoquic_process_ack_of_max_stream_data_frame(picoquic_cnx_t* cnx, const uint8_t* bytes,\n908\t    size_t bytes_size, size_t* consumed);\n909\t\n910\tint reset_repeat_test_receive_frame(int test_id, picoquic_cnx_t * cnx, const uint8_t * frame, size_t frame_size,\n911\t    uint64_t simulated_time, uint64_t stream_id, int do_not_create)\n912\t{\n913\t    picoquic_stream_data_node_t dn;\n914\t    int ret = picoquic_decode_frames(cnx, cnx->path[0], frame, frame_size,\n915\t        &dn, picoquic_epoch_1rtt,\n916\t        (struct sockaddr*)&cnx->path[0]->first_tuple->peer_addr,\n917\t        (struct sockaddr*)&cnx->path[0]->first_tuple->local_addr,\n918\t        123, 0, simulated_time);\n919\t\n920\t    if (ret != 0 || cnx->cnx_state > picoquic_state_ready) {\n921\t        DBG_PRINTF(\"Test %d. Error after stop sending, ret = 0x%x.\", test_id, ret);\n922\t        ret = -1;\n923\t    }\n924\t    else if (ret == 0 && stream_id != UINT64_MAX && do_not_create && picoquic_find_stream(cnx, stream_id) != NULL) {\n925\t        DBG_PRINTF(\"Test %d. Stream %\" PRIu64 \" was created.\", test_id, stream_id);\n926\t        ret = -1;\n927\t    }\n928\t    return ret;\n929\t}\n930\t\n931\tint reset_repeat_test_need_repeat(int test_id, picoquic_cnx_t* cnx, const uint8_t* frame, size_t frame_size)\n932\t{\n933\t    int no_need_to_repeat = 0;\n934\t    int do_not_detect_spurious = 0;\n935\t    int is_preemptive_needed = 0;\n936\t\n937\t    int ret = picoquic_check_frame_needs_repeat(cnx, frame, frame_size, picoquic_packet_1rtt_protected,\n938\t        &no_need_to_repeat, &do_not_detect_spurious, &is_preemptive_needed);\n939\t\n940\t    if (ret != 0 || cnx->cnx_state > picoquic_state_ready || !no_need_to_repeat) {\n941\t        DBG_PRINTF(\"Test %d. Error after ack of frame 0x%x, ret = 0x%x.\", test_id, frame[0], ret);\n942\t        ret = -1;\n943\t    }\n944\t    return ret;\n945\t}\n946\t\n947\tint reset_loop_check_stream_opened(picoquic_test_tls_api_ctx_t* test_ctx, uint64_t data_stream_id)\n948\t{\n949\t    int is_opened = 0;\n950\t    if (test_ctx->cnx_client != NULL && test_ctx->cnx_server != NULL) {\n951\t        picoquic_stream_head_t* c_stream = picoquic_find_stream(test_ctx->cnx_client, data_stream_id);\n952\t        if (c_stream != NULL && c_stream->sent_offset > 10000) {\n953\t            picoquic_stream_head_t* s_stream = picoquic_find_stream(test_ctx->cnx_server, data_stream_id);\n954\t            if (s_stream != NULL) {\n955\t                is_opened = 1;\n956\t            }\n957\t        }\n958\t    }\n959\t    return is_opened;\n960\t}\n961\t\n962\tint reset_loop_wait_stream_opened(picoquic_test_tls_api_ctx_t* test_ctx,\n963\t    uint64_t* simulated_time, uint64_t data_stream_id, uint64_t loop1_time)\n964\t{\n965\t    int ret = 0;\n966\t    int nb_inactive = 0;\n967\t    uint64_t time_out = *simulated_time + loop1_time;\n968\t    int was_active = 0;\n969\t    int is_opened = 0;\n970\t\n971\t    while (ret == 0 && *simulated_time < time_out &&\n972\t        TEST_CLIENT_READY &&\n973\t        TEST_SERVER_READY &&\n974\t        nb_inactive < 64) {\n975\t\n976\t        if (reset_loop_check_stream_opened(test_ctx, data_stream_id)) {\n977\t            is_opened = 1;\n978\t            break;\n979\t        }\n980\t\n981\t        was_active = 0;\n982\t\n983\t        ret = tls_api_one_sim_round(test_ctx, simulated_time, 0, &was_active);\n984\t\n985\t        if (was_active) {\n986\t            nb_inactive = 0;\n987\t        }\n988\t        else {\n989\t            nb_inactive++;\n990\t        }\n991\t    }\n992\t    if (!is_opened) {\n993\t        ret = -1;\n994\t    }\n995\t    return ret;\n996\t}\n997\t\n998\tint reset_repeat_test_one(uint8_t test_id)\n999\t{\n1000\t    picoquic_test_tls_api_ctx_t* test_ctx = NULL;\n1001\t    uint64_t simulated_time = 0;\n1002\t    uint64_t loss_mask = 0;\n1003\t    uint64_t data_stream_id = 4;\n1004\t    uint64_t loop1_time = 50000;\n1005\t    uint64_t loop2_time = 1000000;\n1006\t    picoquic_connection_id_t initial_cid = { { 0x8e, 0x5e, 0x48, 0xe9, 0, 0, 0, 0}, 8 };\n1007\t    int ret = 0;\n1008\t    uint8_t stop_sending_frame[3] = {\n1009\t        (uint8_t)picoquic_frame_type_stop_sending,\n1010\t        (uint8_t)data_stream_id,\n1011\t        0x17 };\n1012\t    uint8_t max_stream_data_frame[3] = {\n1013\t        (uint8_t)picoquic_frame_type_max_stream_data,\n1014\t        (uint8_t)data_stream_id,\n1015\t        63 };\n1016\t    uint8_t reset_frame[4] = {\n1017\t        (uint8_t)picoquic_frame_type_reset_stream,\n1018\t        (uint8_t)data_stream_id,\n1019\t        1,\n1020\t        1 };\n1021\t\n1022\t    initial_cid.id[4] = test_id;\n1023\t\n1024\t    /* Create the test context */\n1025\t    if (ret == 0) {\n1026\t        ret = tls_api_init_ctx_ex(&test_ctx, PICOQUIC_INTERNAL_TEST_VERSION_1,\n1027\t            PICOQUIC_TEST_SNI, PICOQUIC_TEST_ALPN, &simulated_time, NULL, NULL, 0, 1, 0, &initial_cid);\n1028\t    }\n1029\t\n1030\t    /* Set the binlog */\n1031\t    if (ret == 0) {\n1032\t        picoquic_set_qlog(test_ctx->qclient, \".\");\n1033\t        ret = picoquic_start_client_cnx(test_ctx->cnx_client);\n1034\t    }\n1035\t\n1036\t    /* set the connection */\n1037\t    if (ret == 0) {\n1038\t        ret = tls_api_connection_loop(test_ctx, &loss_mask, 0, &simulated_time);\n1039\t    }\n1040\t\n1041\t    /* Prepare to send data */\n1042\t    if (ret == 0) {\n1043\t        ret = test_api_init_send_recv_scenario(test_ctx, test_scenario_edge_reset, sizeof(test_scenario_edge_reset));\n1044\t\n1045\t        if (ret != 0)\n1046\t        {\n1047\t            DBG_PRINTF(\"Init send receive scenario returns %d\\n\", ret);\n1048\t        }\n1049\t    }\n1050\t\n1051\t    /* Run for a short time, so the stream is created and the transfer started */\n1052\t    if (ret == 0) {\n1053\t        ret = reset_loop_wait_stream_opened(test_ctx, &simulated_time, data_stream_id, loop1_time);\n1054\t        if (ret != 0) {\n1055\t            DBG_PRINTF(\"Test #%d. Loop wait stream failed!\", test_id);\n1056\t            ret = -1;\n1057\t        }\n1058\t    }\n1059\t\n1060\t    /* Verify that the stream #4 is present, and the\n1061\t     * transmission has not stopped.\n1062\t     */\n1063\t    if (ret == 0 && (!(TEST_CLIENT_READY) || !(TEST_SERVER_READY))) {\n1064\t        DBG_PRINTF(\"%s\", \"Server or client not ready!\");\n1065\t        ret = -1;\n1066\t    }\n1067\t    if (ret == 0) {\n1068\t        picoquic_stream_head_t* stream = picoquic_find_stream(test_ctx->cnx_client, data_stream_id);\n1069\t        if (stream == NULL || stream->fin_sent) {\n1070\t            DBG_PRINTF(\"Waited too long, stream is %s\\n\", (stream == NULL) ? \"deleted\" : \"finished\");\n1071\t            ret = -1;\n1072\t        }\n1073\t    }\n1074\t    /* Reset the stream, then run the connection for a short time.\n1075\t     */\n1076\t    if (ret == 0) {\n1077\t        ret = picoquic_reset_stream(test_ctx->cnx_client, data_stream_id, 0);\n1078\t    }\n1079\t    if (ret == 0) {\n1080\t        ret = picoquic_reset_stream(test_ctx->cnx_server, data_stream_id, 0);\n1081\t    }\n1082\t    if (ret == 0) {\n1083\t        int was_active = 0;\n1084\t        int nb_inactive = 0;\n1085\t        int client_stream_gone = 0;\n1086\t        uint64_t time_out = simulated_time + loop2_time;\n1087\t        while (ret == 0 && simulated_time < time_out &&\n1088\t            TEST_CLIENT_READY &&\n1089\t            TEST_SERVER_READY &&\n1090\t            nb_inactive < 64) {\n1091\t            was_active = 0;\n1092\t\n1093\t            ret = tls_api_one_sim_round(test_ctx, &simulated_time, time_out, &was_active);\n1094\t\n1095\t            if (was_active) {\n1096\t                nb_inactive = 0;\n1097\t            }\n1098\t            else {\n1099\t                nb_inactive++;\n1100\t            }\n1101\t            if (picoquic_find_stream(test_ctx->cnx_client, data_stream_id) == NULL) {\n1102\t                client_stream_gone = 1;\n1103\t                break;\n1104\t            }\n1105\t        }\n1106\t        if (!client_stream_gone) {\n1107\t            DBG_PRINTF(\"%s\", \"Did not wait long enough, stream is still there.\");\n1108\t            ret = -1;\n1109\t        }\n1110\t    }\n1111\t    /* Perform the specified test.\n1112\t     */\n1113\t    switch (test_id) {\n1114\t    case reset_ack_max_stream: {\n1115\t        size_t consumed = 0;\n1116\t        ret = picoquic_process_ack_of_max_stream_data_frame(test_ctx->cnx_client, reset_frame, sizeof(reset_frame), &consumed);\n1117\t\n1118\t        if (ret != 0 || test_ctx->cnx_client->cnx_state > picoquic_state_ready) {\n1119\t            DBG_PRINTF(\"Test %d. Error after ack of max stream, ret = 0x%x.\", test_id, ret);\n1120\t            ret = -1;\n1121\t        }\n1122\t        break;\n1123\t    }\n1124\t    case reset_ack_reset:/* spurious ack of reset frame. */ {\n1125\t        size_t consumed = 0;\n1126\t        ret = picoquic_process_ack_of_reset_stream_frame(test_ctx->cnx_client, reset_frame, sizeof(reset_frame), &consumed);\n1127\t\n1128\t        if (ret != 0 || test_ctx->cnx_client->cnx_state > picoquic_state_ready) {\n1129\t            DBG_PRINTF(\"Test %d. Error after ack of reset, ret = 0x%x.\", test_id, ret);\n1130\t            ret = -1;\n1131\t        }\n1132\t        break;\n1133\t    }\n1134\t    case reset_ack_stop_sending:\n1135\t        /* TODO: there is no code yet for processing acks of stop sending frame. */\n1136\t        ret = -1;\n1137\t        break;\n1138\t    case reset_extra_max_stream:\n1139\t        /* arrival of stream related frame on a non existing stream.\n1140\t        * this is a bit more subtle than the ACK test.\n1141\t        * - if this is a remotely created stream:\n1142\t        *     - if it is bidir, this could be an out of order request to\n1143\t        *       not send response, or it could be an old stream that was\n1144\t        *       already deleted.\n1145\t        *     - if it is monodir, it does not make sense.\n1146\t        * - if it is locally created:\n1147\t        *     - if it is closed, just ignore it.\n1148\t        *     - if it is not created yet, this is a protocol error.\n1149\t        */\n1150\t        ret = reset_repeat_test_receive_frame(test_id, test_ctx->cnx_client, max_stream_data_frame, sizeof(max_stream_data_frame),\n1151\t            simulated_time, data_stream_id, 1);\n1152\t        break;\n1153\t    case reset_extra_reset:\n1154\t        /* arrival of extra reset frame.\n1155\t        * see, arrival of stop sending.\n1156\t        */\n1157\t        ret = reset_repeat_test_receive_frame(test_id, test_ctx->cnx_client, reset_frame, sizeof(reset_frame),\n1158\t            simulated_time, data_stream_id, 1);\n1159\t        break;\n1160\t    case reset_extra_stop_sending:\n1161\t        ret = reset_repeat_test_receive_frame(test_id, test_ctx->cnx_client, stop_sending_frame, sizeof(stop_sending_frame),\n1162\t            simulated_time, data_stream_id, 1);\n1163\t        break;\n1164\t    case reset_need_max_stream:\n1165\t        /* Check whether a frame needs to be repeated.\n1166\t        * this should never cause an error! If the stream is not\n1167\t        * there any more, this means the original reset was\n1168\t        * successful, there is no need to resend it.\n1169\t        */\n1170\t        ret = reset_repeat_test_need_repeat(test_id, test_ctx->cnx_client, max_stream_data_frame, sizeof(max_stream_data_frame));\n1171\t        break;\n1172\t    case reset_need_reset:\n1173\t        ret = reset_repeat_test_need_repeat(test_id, test_ctx->cnx_client, reset_frame, sizeof(reset_frame));\n1174\t        break;\n1175\t    case reset_need_stop_sending:\n1176\t        ret = reset_repeat_test_need_repeat(test_id, test_ctx->cnx_client, stop_sending_frame, sizeof(stop_sending_frame));\n1177\t        break;\n1178\t    default:\n1179\t        DBG_PRINTF(\"What test is that: %d?\", test_id);\n1180\t        ret = -1;\n1181\t        break;\n1182\t    }\n1183\t\n1184\t    /* Clean up */\n1185\t    if (test_ctx != NULL) {\n1186\t        tls_api_delete_ctx(test_ctx);\n1187\t        test_ctx = NULL;\n1188\t    }\n1189\t\n1190\t    return ret;\n1191\t}\n1192\t\n1193\tint reset_ack_max_test(void)\n1194\t{\n1195\t    return reset_repeat_test_one(reset_ack_max_stream);\n1196\t}\n1197\t\n1198\tint reset_ack_reset_test(void)\n1199\t{\n1200\t    return reset_repeat_test_one(reset_ack_reset);\n1201\t}\n1202\t\n1203\tint reset_extra_max_test(void)\n1204\t{\n1205\t    return reset_repeat_test_one(reset_extra_max_stream);\n1206\t}\n1207\t\n1208\tint reset_extra_reset_test(void)\n1209\t{\n1210\t    return reset_repeat_test_one(reset_extra_reset);\n1211\t}\n1212\t\n1213\tint reset_extra_stop_test(void)\n1214\t{\n1215\t    return reset_repeat_test_one(reset_extra_stop_sending);\n1216\t}\n1217\t\n1218\tint reset_need_max_test(void)\n1219\t{\n1220\t    return reset_repeat_test_one(reset_need_max_stream);\n1221\t}\n1222\t\n1223\tint reset_need_reset_test(void)\n1224\t{\n1225\t    return reset_repeat_test_one(reset_need_reset);\n1226\t}\n1227\t\n1228\tint reset_need_stop_test(void)\n1229\t{\n1230\t    return reset_repeat_test_one(reset_need_stop_sending);\n1231\t}\n1232\t\n1233\t/*\n1234\t* Initial PTO test:\n1235\t* Test the scenario in which:\n1236\t* - the client sends an initial message\n1237\t* - the server sends an ACK\n1238\t* - no further packets from the server, either because they are lost\n1239\t*   or because the server is hitting the amplification limit.\n1240\t* Verify that the client sends a message after a PTO commensurate\n1241\t* with the RTT.\n1242\t*/\n1243\t\n1244\tint initial_pto_prepare(picoquic_test_tls_api_ctx_t* test_ctx, uint64_t* p_simulated_time,\n1245\t    size_t *length)\n1246\t{\n1247\t    int ret = 0;\n1248\t    uint8_t buf[PICOQUIC_MAX_PACKET_SIZE];\n1249\t    struct sockaddr_storage addr_to;\n1250\t    struct sockaddr_storage addr_from;\n1251\t\n1252\t    ret = picoquic_prepare_packet(test_ctx->cnx_client, *p_simulated_time,\n1253\t        buf, PICOQUIC_MAX_PACKET_SIZE, length,\n1254\t        &addr_to, &addr_from, NULL);\n1255\t\n1256\t    if (ret == 0) {\n1257\t        /* Submit initial packet to server context, so we get the\n1258\t         * crypto context created */\n1259\t        ret = picoquic_incoming_packet_ex(test_ctx->qserver, buf, *length, \n1260\t            (struct sockaddr*)&addr_from, (struct sockaddr*)&addr_to, 0, 0,\n1261\t            &test_ctx->cnx_server, *p_simulated_time);\n1262\t        if (ret == 0 && test_ctx->cnx_server == NULL) {\n1263\t            ret = -1;\n1264\t        }\n1265\t    }\n1266\t    return ret;\n1267\t}\n1268\t\n1269\tint initial_pto_wait(picoquic_test_tls_api_ctx_t* test_ctx, uint64_t* p_simulated_time,\n1270\t    uint64_t max_wait, size_t* length_sent)\n1271\t{\n1272\t    int ret = 0;\n1273\t    size_t length = 0;\n1274\t    *length_sent = 0;\n1275\t    while (ret == 0 && *p_simulated_time < max_wait) {\n1276\t        uint64_t client_departure = test_ctx->cnx_client->next_wake_time;\n1277\t\n1278\t        if (client_departure >= max_wait) {\n1279\t            *p_simulated_time = max_wait;\n1280\t            break;\n1281\t        }\n1282\t        else {\n1283\t            if (*p_simulated_time < client_departure) {\n1284\t                *p_simulated_time = client_departure;\n1285\t            }\n1286\t            ret = initial_pto_prepare(test_ctx, p_simulated_time, &length);\n1287\t            if (length > 0 || test_ctx->cnx_client->cnx_state >= picoquic_state_handshake_failure) {\n1288\t                *length_sent = length;\n1289\t                break;\n1290\t            }\n1291\t        }\n1292\t    }\n1293\t    return ret;\n1294\t}\n1295\t\n1296\tint initial_pto_ack(picoquic_test_tls_api_ctx_t* test_ctx, uint64_t* p_simulated_time)\n1297\t{\n1298\t    int ret = 0;\n1299\t    uint8_t buf[PICOQUIC_INITIAL_MTU_IPV6];\n1300\t    uint8_t send_buffer[PICOQUIC_MAX_PACKET_SIZE];\n1301\t    picoquic_packet_type_enum packet_type = picoquic_packet_initial;\n1302\t    picoquic_packet_context_enum pc = picoquic_packet_context_initial;\n1303\t    size_t checksum_overhead = 16;\n1304\t    uint8_t * bytes_max = buf + PICOQUIC_INITIAL_MTU_IPV6 - checksum_overhead;\n1305\t    uint8_t* bytes_next = buf;\n1306\t    size_t length = 0;\n1307\t    size_t header_length = 0;\n1308\t    int more_data = 0;\n1309\t    size_t send_length = 0;\n1310\t    /* Format the header */\n1311\t    header_length = picoquic_predict_packet_header_length(test_ctx->cnx_server, packet_type,\n1312\t        &test_ctx->cnx_server->pkt_ctx[pc]);\n1313\t    bytes_next += header_length;\n1314\t    /* add ack, function of client sequence number */\n1315\t    bytes_next = picoquic_format_ack_frame(test_ctx->cnx_server, bytes_next, bytes_max, &more_data,\n1316\t        *p_simulated_time, pc, 0);\n1317\t    /* add padding to minimum length */\n1318\t    length = picoquic_pad_to_target_length(buf, bytes_next - buf,\n1319\t        PICOQUIC_INITIAL_MTU_IPV6 - checksum_overhead);\n1320\t\n1321\t    /* Finalize */\n1322\t    send_length = picoquic_protect_packet(test_ctx->cnx_server, packet_type, buf, 0,\n1323\t        length, header_length,\n1324\t        send_buffer, PICOQUIC_MAX_PACKET_SIZE, \n1325\t        test_ctx->cnx_server->crypto_context[picoquic_epoch_initial].aead_encrypt,\n1326\t        test_ctx->cnx_server->crypto_context[picoquic_epoch_initial].pn_enc,\n1327\t        test_ctx->cnx_server->path[0], NULL, *p_simulated_time);\n1328\t    /* Submit to client. */\n1329\t    if (send_length == 0) {\n1330\t        ret = -1;\n1331\t    }\n1332\t    else {\n1333\t        picoquic_cnx_t* last_cnx = NULL;\n1334\t        ret = picoquic_incoming_packet_ex(test_ctx->qclient, send_buffer, send_length,\n1335\t            (struct sockaddr*)&test_ctx->server_addr, (struct sockaddr*)&test_ctx->client_addr, 0, 0,\n1336\t            &last_cnx, *p_simulated_time);\n1337\t    }\n1338\t    return ret;\n1339\t}\n1340\t\n1341\tint initial_pto_test(void)\n1342\t{\n1343\t    int ret = 0;\n1344\t    picoquic_test_tls_api_ctx_t *test_ctx = NULL;\n1345\t    size_t length = 0;\n1346\t    uint64_t simulated_time = 0;\n1347\t    uint64_t simulated_rtt = 20000;\n1348\t    uint64_t simulated_pto = 4*simulated_rtt;\n1349\t    picoquic_connection_id_t initial_cid = { { 0x94, 0x01, 0x41, 0, 0, 0, 0, 0}, 8 };\n1350\t\n1351\t    /* Create a client. */\n1352\t    ret = tls_api_init_ctx_ex(&test_ctx, PICOQUIC_INTERNAL_TEST_VERSION_1,\n1353\t            PICOQUIC_TEST_SNI, PICOQUIC_TEST_ALPN, &simulated_time, NULL, NULL, 0, 1, 0, &initial_cid);\n1354\t    if (ret != 0) {\n1355\t        DBG_PRINTF(\"Cannot initialize context, ret = 0x%x\", ret);\n1356\t    }\n1357\t    else {\n1358\t        /* Set the binlog */\n1359\t        picoquic_set_qlog(test_ctx->qclient, \".\");\n1360\t        /* start the client connection */\n1361\t        ret = picoquic_start_client_cnx(test_ctx->cnx_client);\n1362\t    }\n1363\t    /* Send the initial packet */\n1364\t    if (ret == 0) {\n1365\t        ret = initial_pto_prepare(test_ctx, &simulated_time, &length);\n1366\t        if (ret == 0 && length < 1200) {\n1367\t            length = -1;\n1368\t        }\n1369\t    }\n1370\t    /* get the initial message, wait until next client time >= time of ACK */\n1371\t    if (ret == 0 && simulated_time < 20000) {\n1372\t        ret = initial_pto_wait(test_ctx, &simulated_time, simulated_rtt, &length);\n1373\t    }\n1374\t    /* format an ACK packet, apply initial protection, submit ACK to client */\n1375\t    if (ret == 0) {\n1376\t        ret = initial_pto_ack(test_ctx, &simulated_time);\n1377\t    }\n1378\t    /* Wait until next client time >= expected response, or\n1379\t     * client is ready to send and does send. */\n1380\t    if (ret == 0 && simulated_time < simulated_pto) {\n1381\t        ret = initial_pto_wait(test_ctx, &simulated_time, simulated_pto, &length);\n1382\t        if (ret == 0 && length < 1200) {\n1383\t            /* Did not send the PTO */\n1384\t            ret = -1;\n1385\t        }\n1386\t    }\n1387\t    /* Clean up */\n1388\t    if (test_ctx != NULL) {\n1389\t        tls_api_delete_ctx(test_ctx);\n1390\t        test_ctx = NULL;\n1391\t    }\n1392\t\n1393\t    return ret;\n1394\t}\n1395\t\n1396\t/* Skip through packets, document types and next pointer */\n1397\tconst uint8_t* v1_header_skip(const uint8_t* bytes, const uint8_t* bytes_max, picoquic_packet_type_enum* ptype)\n1398\t{\n1399\t    uint8_t first_byte = *bytes++;"}]},"parent_tool_use_id":null,"session_id":"17072f18-9969-498e-bec6-45838e44ca80","uuid":"c18e7f8e-339c-412b-b873-22a9e8cf1384","timestamp":"2026-05-05T02:59:47.910Z","tool_use_result":{"type":"text","file":{"filePath":"/Users/richbarn/Projects/picoquic/picoquictest/edge_cases.c","content":"} reset_test_enum;\n\nstatic test_api_stream_desc_t test_scenario_edge_reset[] = {\n    { 4, 0, 1000000, 1000000 }\n};\n\nint picoquic_process_ack_of_reset_stream_frame(picoquic_cnx_t* cnx, const uint8_t* bytes, size_t bytes_size, size_t* consumed);\nint picoquic_process_ack_of_max_stream_data_frame(picoquic_cnx_t* cnx, const uint8_t* bytes,\n    size_t bytes_size, size_t* consumed);\n\nint reset_repeat_test_receive_frame(int test_id, picoquic_cnx_t * cnx, const uint8_t * frame, size_t frame_size,\n    uint64_t simulated_time, uint64_t stream_id, int do_not_create)\n{\n    picoquic_stream_data_node_t dn;\n    int ret = picoquic_decode_frames(cnx, cnx->path[0], frame, frame_size,\n        &dn, picoquic_epoch_1rtt,\n        (struct sockaddr*)&cnx->path[0]->first_tuple->peer_addr,\n        (struct sockaddr*)&cnx->path[0]->first_tuple->local_addr,\n        123, 0, simulated_time);\n\n    if (ret != 0 || cnx->cnx_state > picoquic_state_ready) {\n        DBG_PRINTF(\"Test %d. Error after stop sending, ret = 0x%x.\", test_id, ret);\n        ret = -1;\n    }\n    else if (ret == 0 && stream_id != UINT64_MAX && do_not_create && picoquic_find_stream(cnx, stream_id) != NULL) {\n        DBG_PRINTF(\"Test %d. Stream %\" PRIu64 \" was created.\", test_id, stream_id);\n        ret = -1;\n    }\n    return ret;\n}\n\nint reset_repeat_test_need_repeat(int test_id, picoquic_cnx_t* cnx, const uint8_t* frame, size_t frame_size)\n{\n    int no_need_to_repeat = 0;\n    int do_not_detect_spurious = 0;\n    int is_preemptive_needed = 0;\n\n    int ret = picoquic_check_frame_needs_repeat(cnx, frame, frame_size, picoquic_packet_1rtt_protected,\n        &no_need_to_repeat, &do_not_detect_spurious, &is_preemptive_needed);\n\n    if (ret != 0 || cnx->cnx_state > picoquic_state_ready || !no_need_to_repeat) {\n        DBG_PRINTF(\"Test %d. Error after ack of frame 0x%x, ret = 0x%x.\", test_id, frame[0], ret);\n        ret = -1;\n    }\n    return ret;\n}\n\nint reset_loop_check_stream_opened(picoquic_test_tls_api_ctx_t* test_ctx, uint64_t data_stream_id)\n{\n    int is_opened = 0;\n    if (test_ctx->cnx_client != NULL && test_ctx->cnx_server != NULL) {\n        picoquic_stream_head_t* c_stream = picoquic_find_stream(test_ctx->cnx_client, data_stream_id);\n        if (c_stream != NULL && c_stream->sent_offset > 10000) {\n            picoquic_stream_head_t* s_stream = picoquic_find_stream(test_ctx->cnx_server, data_stream_id);\n            if (s_stream != NULL) {\n                is_opened = 1;\n            }\n        }\n    }\n    return is_opened;\n}\n\nint reset_loop_wait_stream_opened(picoquic_test_tls_api_ctx_t* test_ctx,\n    uint64_t* simulated_time, uint64_t data_stream_id, uint64_t loop1_time)\n{\n    int ret = 0;\n    int nb_inactive = 0;\n    uint64_t time_out = *simulated_time + loop1_time;\n    int was_active = 0;\n    int is_opened = 0;\n\n    while (ret == 0 && *simulated_time < time_out &&\n        TEST_CLIENT_READY &&\n        TEST_SERVER_READY &&\n        nb_inactive < 64) {\n\n        if (reset_loop_check_stream_opened(test_ctx, data_stream_id)) {\n            is_opened = 1;\n            break;\n        }\n\n        was_active = 0;\n\n        ret = tls_api_one_sim_round(test_ctx, simulated_time, 0, &was_active);\n\n        if (was_active) {\n            nb_inactive = 0;\n        }\n        else {\n            nb_inactive++;\n        }\n    }\n    if (!is_opened) {\n        ret = -1;\n    }\n    return ret;\n}\n\nint reset_repeat_test_one(uint8_t test_id)\n{\n    picoquic_test_tls_api_ctx_t* test_ctx = NULL;\n    uint64_t simulated_time = 0;\n    uint64_t loss_mask = 0;\n    uint64_t data_stream_id = 4;\n    uint64_t loop1_time = 50000;\n    uint64_t loop2_time = 1000000;\n    picoquic_connection_id_t initial_cid = { { 0x8e, 0x5e, 0x48, 0xe9, 0, 0, 0, 0}, 8 };\n    int ret = 0;\n    uint8_t stop_sending_frame[3] = {\n        (uint8_t)picoquic_frame_type_stop_sending,\n        (uint8_t)data_stream_id,\n        0x17 };\n    uint8_t max_stream_data_frame[3] = {\n        (uint8_t)picoquic_frame_type_max_stream_data,\n        (uint8_t)data_stream_id,\n        63 };\n    uint8_t reset_frame[4] = {\n        (uint8_t)picoquic_frame_type_reset_stream,\n        (uint8_t)data_stream_id,\n        1,\n        1 };\n\n    initial_cid.id[4] = test_id;\n\n    /* Create the test context */\n    if (ret == 0) {\n        ret = tls_api_init_ctx_ex(&test_ctx, PICOQUIC_INTERNAL_TEST_VERSION_1,\n            PICOQUIC_TEST_SNI, PICOQUIC_TEST_ALPN, &simulated_time, NULL, NULL, 0, 1, 0, &initial_cid);\n    }\n\n    /* Set the binlog */\n    if (ret == 0) {\n        picoquic_set_qlog(test_ctx->qclient, \".\");\n        ret = picoquic_start_client_cnx(test_ctx->cnx_client);\n    }\n\n    /* set the connection */\n    if (ret == 0) {\n        ret = tls_api_connection_loop(test_ctx, &loss_mask, 0, &simulated_time);\n    }\n\n    /* Prepare to send data */\n    if (ret == 0) {\n        ret = test_api_init_send_recv_scenario(test_ctx, test_scenario_edge_reset, sizeof(test_scenario_edge_reset));\n\n        if (ret != 0)\n        {\n            DBG_PRINTF(\"Init send receive scenario returns %d\\n\", ret);\n        }\n    }\n\n    /* Run for a short time, so the stream is created and the transfer started */\n    if (ret == 0) {\n        ret = reset_loop_wait_stream_opened(test_ctx, &simulated_time, data_stream_id, loop1_time);\n        if (ret != 0) {\n            DBG_PRINTF(\"Test #%d. Loop wait stream failed!\", test_id);\n            ret = -1;\n        }\n    }\n\n    /* Verify that the stream #4 is present, and the\n     * transmission has not stopped.\n     */\n    if (ret == 0 && (!(TEST_CLIENT_READY) || !(TEST_SERVER_READY))) {\n        DBG_PRINTF(\"%s\", \"Server or client not ready!\");\n        ret = -1;\n    }\n    if (ret == 0) {\n        picoquic_stream_head_t* stream = picoquic_find_stream(test_ctx->cnx_client, data_stream_id);\n        if (stream == NULL || stream->fin_sent) {\n            DBG_PRINTF(\"Waited too long, stream is %s\\n\", (stream == NULL) ? \"deleted\" : \"finished\");\n            ret = -1;\n        }\n    }\n    /* Reset the stream, then run the connection for a short time.\n     */\n    if (ret == 0) {\n        ret = picoquic_reset_stream(test_ctx->cnx_client, data_stream_id, 0);\n    }\n    if (ret == 0) {\n        ret = picoquic_reset_stream(test_ctx->cnx_server, data_stream_id, 0);\n    }\n    if (ret == 0) {\n        int was_active = 0;\n        int nb_inactive = 0;\n        int client_stream_gone = 0;\n        uint64_t time_out = simulated_time + loop2_time;\n        while (ret == 0 && simulated_time < time_out &&\n            TEST_CLIENT_READY &&\n            TEST_SERVER_READY &&\n            nb_inactive < 64) {\n            was_active = 0;\n\n            ret = tls_api_one_sim_round(test_ctx, &simulated_time, time_out, &was_active);\n\n            if (was_active) {\n                nb_inactive = 0;\n            }\n            else {\n                nb_inactive++;\n            }\n            if (picoquic_find_stream(test_ctx->cnx_client, data_stream_id) == NULL) {\n                client_stream_gone = 1;\n                break;\n            }\n        }\n        if (!client_stream_gone) {\n            DBG_PRINTF(\"%s\", \"Did not wait long enough, stream is still there.\");\n            ret = -1;\n        }\n    }\n    /* Perform the specified test.\n     */\n    switch (test_id) {\n    case reset_ack_max_stream: {\n        size_t consumed = 0;\n        ret = picoquic_process_ack_of_max_stream_data_frame(test_ctx->cnx_client, reset_frame, sizeof(reset_frame), &consumed);\n\n        if (ret != 0 || test_ctx->cnx_client->cnx_state > picoquic_state_ready) {\n            DBG_PRINTF(\"Test %d. Error after ack of max stream, ret = 0x%x.\", test_id, ret);\n            ret = -1;\n        }\n        break;\n    }\n    case reset_ack_reset:/* spurious ack of reset frame. */ {\n        size_t consumed = 0;\n        ret = picoquic_process_ack_of_reset_stream_frame(test_ctx->cnx_client, reset_frame, sizeof(reset_frame), &consumed);\n\n        if (ret != 0 || test_ctx->cnx_client->cnx_state > picoquic_state_ready) {\n            DBG_PRINTF(\"Test %d. Error after ack of reset, ret = 0x%x.\", test_id, ret);\n            ret = -1;\n        }\n        break;\n    }\n    case reset_ack_stop_sending:\n        /* TODO: there is no code yet for processing acks of stop sending frame. */\n        ret = -1;\n        break;\n    case reset_extra_max_stream:\n        /* arrival of stream related frame on a non existing stream.\n        * this is a bit more subtle than the ACK test.\n        * - if this is a remotely created stream:\n        *     - if it is bidir, this could be an out of order request to\n        *       not send response, or it could be an old stream that was\n        *       already deleted.\n        *     - if it is monodir, it does not make sense.\n        * - if it is locally created:\n        *     - if it is closed, just ignore it.\n        *     - if it is not created yet, this is a protocol error.\n        */\n        ret = reset_repeat_test_receive_frame(test_id, test_ctx->cnx_client, max_stream_data_frame, sizeof(max_stream_data_frame),\n            simulated_time, data_stream_id, 1);\n        break;\n    case reset_extra_reset:\n        /* arrival of extra reset frame.\n        * see, arrival of stop sending.\n        */\n        ret = reset_repeat_test_receive_frame(test_id, test_ctx->cnx_client, reset_frame, sizeof(reset_frame),\n            simulated_time, data_stream_id, 1);\n        break;\n    case reset_extra_stop_sending:\n        ret = reset_repeat_test_receive_frame(test_id, test_ctx->cnx_client, stop_sending_frame, sizeof(stop_sending_frame),\n            simulated_time, data_stream_id, 1);\n        break;\n    case reset_need_max_stream:\n        /* Check whether a frame needs to be repeated.\n        * this should never cause an error! If the stream is not\n        * there any more, this means the original reset was\n        * successful, there is no need to resend it.\n        */\n        ret = reset_repeat_test_need_repeat(test_id, test_ctx->cnx_client, max_stream_data_frame, sizeof(max_stream_data_frame));\n        break;\n    case reset_need_reset:\n        ret = reset_repeat_test_need_repeat(test_id, test_ctx->cnx_client, reset_frame, sizeof(reset_frame));\n        break;\n    case reset_need_stop_sending:\n        ret = reset_repeat_test_need_repeat(test_id, test_ctx->cnx_client, stop_sending_frame, sizeof(stop_sending_frame));\n        break;\n    default:\n        DBG_PRINTF(\"What test is that: %d?\", test_id);\n        ret = -1;\n        break;\n    }\n\n    /* Clean up */\n    if (test_ctx != NULL) {\n        tls_api_delete_ctx(test_ctx);\n        test_ctx = NULL;\n    }\n\n    return ret;\n}\n\nint reset_ack_max_test(void)\n{\n    return reset_repeat_test_one(reset_ack_max_stream);\n}\n\nint reset_ack_reset_test(void)\n{\n    return reset_repeat_test_one(reset_ack_reset);\n}\n\nint reset_extra_max_test(void)\n{\n    return reset_repeat_test_one(reset_extra_max_stream);\n}\n\nint reset_extra_reset_test(void)\n{\n    return reset_repeat_test_one(reset_extra_reset);\n}\n\nint reset_extra_stop_test(void)\n{\n    return reset_repeat_test_one(reset_extra_stop_sending);\n}\n\nint reset_need_max_test(void)\n{\n    return reset_repeat_test_one(reset_need_max_stream);\n}\n\nint reset_need_reset_test(void)\n{\n    return reset_repeat_test_one(reset_need_reset);\n}\n\nint reset_need_stop_test(void)\n{\n    return reset_repeat_test_one(reset_need_stop_sending);\n}\n\n/*\n* Initial PTO test:\n* Test the scenario in which:\n* - the client sends an initial message\n* - the server sends an ACK\n* - no further packets from the server, either because they are lost\n*   or because the server is hitting the amplification limit.\n* Verify that the client sends a message after a PTO commensurate\n* with the RTT.\n*/\n\nint initial_pto_prepare(picoquic_test_tls_api_ctx_t* test_ctx, uint64_t* p_simulated_time,\n    size_t *length)\n{\n    int ret = 0;\n    uint8_t buf[PICOQUIC_MAX_PACKET_SIZE];\n    struct sockaddr_storage addr_to;\n    struct sockaddr_storage addr_from;\n\n    ret = picoquic_prepare_packet(test_ctx->cnx_client, *p_simulated_time,\n        buf, PICOQUIC_MAX_PACKET_SIZE, length,\n        &addr_to, &addr_from, NULL);\n\n    if (ret == 0) {\n        /* Submit initial packet to server context, so we get the\n         * crypto context created */\n        ret = picoquic_incoming_packet_ex(test_ctx->qserver, buf, *length, \n            (struct sockaddr*)&addr_from, (struct sockaddr*)&addr_to, 0, 0,\n            &test_ctx->cnx_server, *p_simulated_time);\n        if (ret == 0 && test_ctx->cnx_server == NULL) {\n            ret = -1;\n        }\n    }\n    return ret;\n}\n\nint initial_pto_wait(picoquic_test_tls_api_ctx_t* test_ctx, uint64_t* p_simulated_time,\n    uint64_t max_wait, size_t* length_sent)\n{\n    int ret = 0;\n    size_t length = 0;\n    *length_sent = 0;\n    while (ret == 0 && *p_simulated_time < max_wait) {\n        uint64_t client_departure = test_ctx->cnx_client->next_wake_time;\n\n        if (client_departure >= max_wait) {\n            *p_simulated_time = max_wait;\n            break;\n        }\n        else {\n            if (*p_simulated_time < client_departure) {\n                *p_simulated_time = client_departure;\n            }\n            ret = initial_pto_prepare(test_ctx, p_simulated_time, &length);\n            if (length > 0 || test_ctx->cnx_client->cnx_state >= picoquic_state_handshake_failure) {\n                *length_sent = length;\n                break;\n            }\n        }\n    }\n    return ret;\n}\n\nint initial_pto_ack(picoquic_test_tls_api_ctx_t* test_ctx, uint64_t* p_simulated_time)\n{\n    int ret = 0;\n    uint8_t buf[PICOQUIC_INITIAL_MTU_IPV6];\n    uint8_t send_buffer[PICOQUIC_MAX_PACKET_SIZE];\n    picoquic_packet_type_enum packet_type = picoquic_packet_initial;\n    picoquic_packet_context_enum pc = picoquic_packet_context_initial;\n    size_t checksum_overhead = 16;\n    uint8_t * bytes_max = buf + PICOQUIC_INITIAL_MTU_IPV6 - checksum_overhead;\n    uint8_t* bytes_next = buf;\n    size_t length = 0;\n    size_t header_length = 0;\n    int more_data = 0;\n    size_t send_length = 0;\n    /* Format the header */\n    header_length = picoquic_predict_packet_header_length(test_ctx->cnx_server, packet_type,\n        &test_ctx->cnx_server->pkt_ctx[pc]);\n    bytes_next += header_length;\n    /* add ack, function of client sequence number */\n    bytes_next = picoquic_format_ack_frame(test_ctx->cnx_server, bytes_next, bytes_max, &more_data,\n        *p_simulated_time, pc, 0);\n    /* add padding to minimum length */\n    length = picoquic_pad_to_target_length(buf, bytes_next - buf,\n        PICOQUIC_INITIAL_MTU_IPV6 - checksum_overhead);\n\n    /* Finalize */\n    send_length = picoquic_protect_packet(test_ctx->cnx_server, packet_type, buf, 0,\n        length, header_length,\n        send_buffer, PICOQUIC_MAX_PACKET_SIZE, \n        test_ctx->cnx_server->crypto_context[picoquic_epoch_initial].aead_encrypt,\n        test_ctx->cnx_server->crypto_context[picoquic_epoch_initial].pn_enc,\n        test_ctx->cnx_server->path[0], NULL, *p_simulated_time);\n    /* Submit to client. */\n    if (send_length == 0) {\n        ret = -1;\n    }\n    else {\n        picoquic_cnx_t* last_cnx = NULL;\n        ret = picoquic_incoming_packet_ex(test_ctx->qclient, send_buffer, send_length,\n            (struct sockaddr*)&test_ctx->server_addr, (struct sockaddr*)&test_ctx->client_addr, 0, 0,\n            &last_cnx, *p_simulated_time);\n    }\n    return ret;\n}\n\nint initial_pto_test(void)\n{\n    int ret = 0;\n    picoquic_test_tls_api_ctx_t *test_ctx = NULL;\n    size_t length = 0;\n    uint64_t simulated_time = 0;\n    uint64_t simulated_rtt = 20000;\n    uint64_t simulated_pto = 4*simulated_rtt;\n    picoquic_connection_id_t initial_cid = { { 0x94, 0x01, 0x41, 0, 0, 0, 0, 0}, 8 };\n\n    /* Create a client. */\n    ret = tls_api_init_ctx_ex(&test_ctx, PICOQUIC_INTERNAL_TEST_VERSION_1,\n            PICOQUIC_TEST_SNI, PICOQUIC_TEST_ALPN, &simulated_time, NULL, NULL, 0, 1, 0, &initial_cid);\n    if (ret != 0) {\n        DBG_PRINTF(\"Cannot initialize context, ret = 0x%x\", ret);\n    }\n    else {\n        /* Set the binlog */\n        picoquic_set_qlog(test_ctx->qclient, \".\");\n        /* start the client connection */\n        ret = picoquic_start_client_cnx(test_ctx->cnx_client);\n    }\n    /* Send the initial packet */\n    if (ret == 0) {\n        ret = initial_pto_prepare(test_ctx, &simulated_time, &length);\n        if (ret == 0 && length < 1200) {\n            length = -1;\n        }\n    }\n    /* get the initial message, wait until next client time >= time of ACK */\n    if (ret == 0 && simulated_time < 20000) {\n        ret = initial_pto_wait(test_ctx, &simulated_time, simulated_rtt, &length);\n    }\n    /* format an ACK packet, apply initial protection, submit ACK to client */\n    if (ret == 0) {\n        ret = initial_pto_ack(test_ctx, &simulated_time);\n    }\n    /* Wait until next client time >= expected response, or\n     * client is ready to send and does send. */\n    if (ret == 0 && simulated_time < simulated_pto) {\n        ret = initial_pto_wait(test_ctx, &simulated_time, simulated_pto, &length);\n        if (ret == 0 && length < 1200) {\n            /* Did not send the PTO */\n            ret = -1;\n        }\n    }\n    /* Clean up */\n    if (test_ctx != NULL) {\n        tls_api_delete_ctx(test_ctx);\n        test_ctx = NULL;\n    }\n\n    return ret;\n}\n\n/* Skip through packets, document types and next pointer */\nconst uint8_t* v1_header_skip(const uint8_t* bytes, const uint8_t* bytes_max, picoquic_packet_type_enum* ptype)\n{\n    uint8_t first_byte = *bytes++;","numLines":500,"startLine":900,"totalLines":2166}}}
