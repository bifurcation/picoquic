{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01PGRuBCHzjPYywLiEv7pPgk","type":"tool_result","content":"1\t//! Test cases for `picoquictest/edge_cases.c`.\n2\t//!\n3\t//! A collection of regression tests for edge cases typically discovered\n4\t//! via the QUIC interop runner.  Many involve specific loss patterns during\n5\t//! 0-RTT handshakes, idle-timeout negotiation, stream-reset interaction,\n6\t//! initial-PTO behaviour, and crypto-handshake frame errors.\n7\t\n8\t#![allow(non_snake_case)]\n9\t\n10\tuse super::util::{\n11\t    TestApiStreamDesc, TestTlsApiCtx, tls_api_close_with_losses, tls_api_connection_loop,\n12\t    tls_api_data_sending_loop, tls_api_init_ctx_ex, tls_api_one_scenario_body_verify,\n13\t};\n14\tuse crate::internal::Version;\n15\tuse crate::{ConnectionId, Instant, PacketContext};\n16\t\n17\t// ---------------------------------------------------------------------------\n18\t// Shared scenarios.  Passed to helpers once those are implemented.\n19\t\n20\t#[allow(dead_code)]\n21\tstatic SCENARIO_EDGE_CASE: &[TestApiStreamDesc] = &[TestApiStreamDesc {\n22\t    stream_id: 4,\n23\t    previous_stream_id: 0,\n24\t    q_len: 128,\n25\t    r_len: 1_000,\n26\t}];\n27\t\n28\t#[allow(dead_code)]\n29\tstatic SCENARIO_EDGE_RESET: &[TestApiStreamDesc] = &[TestApiStreamDesc {\n30\t    stream_id: 4,\n31\t    previous_stream_id: 0,\n32\t    q_len: 1_000_000,\n33\t    r_len: 1_000_000,\n34\t}];\n35\t\n36\t#[allow(dead_code)]\n37\tstatic SCENARIO_RESET_AT: &[TestApiStreamDesc] = &[TestApiStreamDesc {\n38\t    stream_id: 4,\n39\t    previous_stream_id: 0,\n40\t    q_len: 257,\n41\t    r_len: 1_000_000,\n42\t}];\n43\t\n44\t/// Set up a test context with the standard edge-case configuration: a\n45\t/// CID of the form `{0xed, 0x9e, 0xca, 0x5e, edge_case_id, zero_rtt, 0, 0}`,\n46\t/// optional 0-RTT first pass, and `nb_init_rounds` rounds of simulation\n47\t/// with the given `loss_mask`.\n48\t/// C: `edge_case_prepare` in `picoquictest/edge_cases.c`.\n49\tfn edge_case_prepare(\n50\t    _edge_case_id: u8,\n51\t    _zero_rtt: bool,\n52\t    _simulated_time: &mut Instant,\n53\t    _loss_mask: u64,\n54\t    _nb_init_rounds: i32,\n55\t) -> crate::Result<Box<TestTlsApiCtx>> {\n56\t    todo!(\"edge_case_prepare: 0-RTT setup and partial simulation not yet implemented\")\n57\t}\n58\t\n59\t/// Finish an edge-case test: run the connection loop, enable\n60\t/// `immediate_exit`, drive data sending, and verify completion within\n61\t/// `duration_max` µs.\n62\t/// C: `edge_case_complete` in `picoquictest/edge_cases.c`.\n63\tfn edge_case_complete(\n64\t    test_ctx: &mut TestTlsApiCtx,\n65\t    simulated_time: &mut Instant,\n66\t    duration_max: u64,\n67\t) -> crate::Result<()> {\n68\t    let mut loss_mask = 0u64;\n69\t    tls_api_connection_loop(test_ctx, &mut loss_mask, 0, simulated_time)?;\n70\t    test_ctx.immediate_exit = true;\n71\t    tls_api_data_sending_loop(test_ctx, &mut loss_mask, simulated_time, 0)?;\n72\t    tls_api_one_scenario_body_verify(test_ctx, simulated_time, duration_max)\n73\t}\n74\t\n75\t// ---------------------------------------------------------------------------\n76\t// Reset-repeat test.\n77\t\n78\t/// Variant of the reset-repeat test: which frame event to exercise.\n79\t/// C: `reset_test_enum` in `picoquictest/edge_cases.c`.\n80\tenum ResetTestKind {\n81\t    AckMaxStream = 0,\n82\t    AckReset,\n83\t    ExtraMaxStream,\n84\t    ExtraReset,\n85\t    ExtraStop,\n86\t    NeedMaxStream,\n87\t    NeedReset,\n88\t    NeedStop,\n89\t}\n90\t\n91\t/// Establish a connection, start a large stream transfer, reset the stream\n92\t/// on both sides, wait for the stream context to be freed, then exercise\n93\t/// the specified post-reset frame event.\n94\t/// C: `reset_repeat_test_one` in `picoquictest/edge_cases.c`.\n95\tfn reset_repeat_test_one(_kind: ResetTestKind) -> crate::Result<()> {\n96\t    todo!(\"reset_repeat_test_one: stream-reset ACK/extra/need logic not yet implemented\")\n97\t}\n98\t\n99\t// ---------------------------------------------------------------------------\n100\t// Idle-timeout test helpers.\n101\t\n102\t/// Verify idle-timeout negotiation: `client_timeout` and `server_timeout`\n103\t/// (in ms) must negotiate to `expected_timeout` (in µs); assert the\n104\t/// connection remains alive at half-time and drops by full-time.\n105\t/// C: `idle_timeout_test_one` in `picoquictest/edge_cases.c`.\n106\tfn idle_timeout_test_one(\n107\t    _test_id: u8,\n108\t    _client_timeout: u64,\n109\t    _server_timeout: u64,\n110\t    _expected_timeout: u64,\n111\t) -> crate::Result<()> {\n112\t    todo!(\"idle_timeout_test_one: idle-timeout negotiation loop not yet implemented\")\n113\t}\n114\t\n115\t/// Verify that a client connecting to a non-responding server disconnects\n116\t/// after `expected_timeout` µs (derived from `client_timeout` ms or\n117\t/// `handshake_timeout` µs).\n118\t/// C: `idle_server_test_one` in `picoquictest/edge_cases.c`.\n119\tfn idle_server_test_one(\n120\t    _test_id: u8,\n121\t    _client_timeout: u64,\n122\t    _handshake_timeout: u64,\n123\t    _expected_timeout: u64,\n124\t) -> crate::Result<()> {\n125\t    todo!(\"idle_server_test_one: server-silent loop not yet implemented\")\n126\t}\n127\t\n128\t// ---------------------------------------------------------------------------\n129\t// Initial-PTO helpers.\n130\t\n131\t/// Prepare the client's initial packet and submit it to the server to\n132\t/// establish a crypto context on both sides.\n133\t/// C: `initial_pto_prepare` in `picoquictest/edge_cases.c`.\n134\tfn initial_pto_prepare(\n135\t    _test_ctx: &mut TestTlsApiCtx,\n136\t    _simulated_time: &mut Instant,\n137\t) -> crate::Result<usize> {\n138\t    todo!(\"initial_pto_prepare: prepare_packet + incoming_packet not yet implemented\")\n139\t}\n140\t\n141\t/// Advance time until the client's next scheduled send, returning the packet\n142\t/// length.  Stops early if the client enters a failure state.\n143\t/// C: `initial_pto_wait` in `picoquictest/edge_cases.c`.\n144\tfn initial_pto_wait(\n145\t    _test_ctx: &mut TestTlsApiCtx,\n146\t    _simulated_time: &mut Instant,\n147\t    _max_wait: u64,\n148\t) -> crate::Result<usize> {\n149\t    todo!(\"initial_pto_wait: client next_wake_time loop not yet implemented\")\n150\t}\n151\t\n152\t/// Craft a synthetic server ACK (Initial epoch) and deliver it to the client.\n153\t/// C: `initial_pto_ack` in `picoquictest/edge_cases.c`.\n154\tfn initial_pto_ack(\n155\t    _test_ctx: &mut TestTlsApiCtx,\n156\t    _simulated_time: &mut Instant,\n157\t) -> crate::Result<()> {\n158\t    todo!(\"initial_pto_ack: predict_header + format_ack + protect_packet not yet implemented\")\n159\t}\n160\t\n161\t// ---------------------------------------------------------------------------\n162\t// Crypto-HS-offset helper.\n163\t\n164\t/// Inject a crypto handshake frame with a 64 KB offset into packet context\n165\t/// `pc`, attempt the connection, and verify the client receives\n166\t/// CRYPTO_BUFFER_EXCEEDED or IDLE_TIMEOUT.\n167\t/// C: `crypto_hs_offset_test_one` in `picoquictest/edge_cases.c`.\n168\tfn crypto_hs_offset_one(_pc: PacketContext) -> crate::Result<()> {\n169\t    todo!(\"crypto_hs_offset_one: queue_misc_frame + connection loop not yet implemented\")\n170\t}\n171\t\n172\t// ---------------------------------------------------------------------------\n173\t// Reset-stream-at helper.\n174\t\n175\t/// Variant for `reset_stream_at_test_one`.\n176\t/// C: `reset_stream_at_test_enum` in `picoquictest/edge_cases.c`.\n177\tenum ResetStreamAtSpec {\n178\t    /// Reset just past what was already received.\n179\t    Basic,\n180\t    /// Reset exactly at the sent offset.\n181\t    Limit,\n182\t    /// Reset past what was received with a lossy link.\n183\t    Loss,\n184\t}\n185\t\n186\t/// Establish a connection, start sending a 1 MB stream, wait a short\n187\t/// time, then call `reset_stream_at` with the appropriate `reliable_size`.\n188\t/// Verify that the scenario completes and that `reliable_size` bytes were\n189\t/// delivered.\n190\t/// C: `reset_stream_at_test_one` in `picoquictest/edge_cases.c`.\n191\tfn reset_stream_at_test_one(_spec: ResetStreamAtSpec) -> crate::Result<()> {\n192\t    todo!(\"reset_stream_at_test_one: reset_stream_at + data loop not yet implemented\")\n193\t}\n194\t\n195\t// ---------------------------------------------------------------------------\n196\t// ec9a helper (unique body, not a shared helper in C).\n197\t\n198\t/// Run the server-only prepare loop for `ec9a_preemptive_amok`:\n199\t/// advance simulated time through server wakes, counting sent packets,\n200\t/// until the server's connection count drops to zero.  Returns\n201\t/// `(send_count, repeat_duration_µs)`.\n202\tfn ec9a_server_loop(\n203\t    _test_ctx: &mut TestTlsApiCtx,\n204\t    _simulated_time: &mut Instant,\n205\t) -> crate::Result<(i32, u64)> {\n206\t    todo!(\"ec9a_server_loop: prepare_next_packet_ex server loop not yet implemented\")\n207\t}\n208\t\n209\t// ---------------------------------------------------------------------------\n210\t// Test entries.\n211\t\n212\t/// C: `crypto_hs_offset_test` in `picoquictest/edge_cases.c`.\n213\t#[test]\n214\tfn crypto_hs_offset() {\n215\t    for pc in [\n216\t        PacketContext::Initial,\n217\t        PacketContext::Handshake,\n218\t        PacketContext::Application,\n219\t    ] {\n220\t        crypto_hs_offset_one(pc).expect(\"crypto_hs_offset_one\");\n221\t    }\n222\t}\n223\t\n224\t/// Edge case zero: verify the common 0-RTT infrastructure works.\n225\t/// C: `ec00_zero_test` in `picoquictest/edge_cases.c`.\n226\t#[test]\n227\tfn ec00_zero() {\n228\t    let mut simulated_time = Instant::from_ticks(0);\n229\t    let mut test_ctx =\n230\t        edge_case_prepare(0x00, true, &mut simulated_time, 0, 4).expect(\"edge_case_prepare\");\n231\t    edge_case_complete(&mut test_ctx, &mut simulated_time, 100_000).expect(\"edge_case_complete\");\n232\t    assert!(\n233\t        test_ctx.cnx_client().nb_zero_rtt_acked > 0,\n234\t        \"expected at least one 0-RTT packet acked\"\n235\t    );\n236\t}\n237\t\n238\t/// Second-flight NACK: client should recover even when the handshake ACK\n239\t/// and HandshakeDone are lost.\n240\t/// C: `ec2f_second_flight_nack_test` in `picoquictest/edge_cases.c`.\n241\t#[test]\n242\tfn ec2f_second_flight() {\n243\t    let mut simulated_time = Instant::from_ticks(0);\n244\t    let initial_losses = 0x1c1u64;\n245\t    let mut test_ctx = edge_case_prepare(0x2f, true, &mut simulated_time, initial_losses, 9)\n246\t        .expect(\"edge_case_prepare\");\n247\t    // After 9 rounds: client must not yet be Ready; server must be Ready.\n248\t    assert!(\n249\t        !test_ctx.client_ready(),\n250\t        \"client should not be ready yet after partial handshake\"\n251\t    );\n252\t    assert!(test_ctx.server_ready(), \"server should be ready\");\n253\t    edge_case_complete(&mut test_ctx, &mut simulated_time, 360_000).expect(\"edge_case_complete\");\n254\t}\n255\t\n256\t/// Fuzz 50 random loss patterns to look for corrupted retransmissions.\n257\t/// C: `eccf_corrupted_file_fuzz_test` in `picoquictest/edge_cases.c`.\n258\t#[test]\n259\tfn eccf_corrupted_fuzz() {\n260\t    // Runs 50 edge_case_prepare + edge_case_complete iterations with\n261\t    // random loss masks derived from a deterministic seed.\n262\t    todo!(\"eccf_corrupted_fuzz: random-loss fuzz loop not yet implemented\")\n263\t}\n264\t\n265\t/// Amplification-limited handshake with a large server hello and losses.\n266\t/// C: `eca1_amplification_loss_test` in `picoquictest/edge_cases.c`.\n267\t#[test]\n268\tfn eca1_amplification_loss() {\n269\t    let mut simulated_time = Instant::from_ticks(0);\n270\t    let mut test_ctx =\n271\t        edge_case_prepare(0xa1, false, &mut simulated_time, 0x0FF4, 16).expect(\"edge_case_prepare\");\n272\t    edge_case_complete(&mut test_ctx, &mut simulated_time, 15_000_000).expect(\"edge_case_complete\");\n273\t}\n274\t\n275\t/// Loss of the final closing packet: connection must close within 10 s.\n276\t/// C: `ecf1_final_loss_test` in `picoquictest/edge_cases.c`.\n277\t#[test]\n278\tfn ecf1_final_loss() {\n279\t    let mut simulated_time = Instant::from_ticks(0);\n280\t    let mut test_ctx =\n281\t        edge_case_prepare(0xf1, false, &mut simulated_time, 0, 20).expect(\"edge_case_prepare\");\n282\t    let mut zero_loss = 0u64;\n283\t    tls_api_connection_loop(&mut test_ctx, &mut zero_loss, 0, &mut simulated_time)\n284\t        .expect(\"connection loop\");\n285\t    test_ctx.immediate_exit = true;\n286\t    tls_api_data_sending_loop(&mut test_ctx, &mut zero_loss, &mut simulated_time, 0)\n287\t        .expect(\"data sending loop\");\n288\t    tls_api_close_with_losses(&mut test_ctx, &mut simulated_time, 0xb10)\n289\t        .expect(\"close with losses\");\n290\t    assert!(\n291\t        simulated_time.ticks() <= 10_000_000,\n292\t        \"connection close took too long: {} µs\",\n293\t        simulated_time.ticks()\n294\t    );\n295\t}\n296\t\n297\t/// Silly CID: server sends a new CID frame that is dropped and later\n298\t/// repeated in a bogus way.  Both sides must reach Ready.\n299\t/// C: `ec5c_silly_cid_test` in `picoquictest/edge_cases.c`.\n300\t#[test]\n301\tfn ec5c_silly_cid() {\n302\t    let mut simulated_time = Instant::from_ticks(0);\n303\t    let mut test_ctx = edge_case_prepare(0x5c, false, &mut simulated_time, 0x01e084, 48)\n304\t        .expect(\"edge_case_prepare\");\n305\t    assert!(test_ctx.has_cnx_server(), \"server connection must exist\");\n306\t    assert!(test_ctx.client_ready(), \"client must be ready\");\n307\t    assert!(test_ctx.server_ready(), \"server must be ready\");\n308\t    edge_case_complete(&mut test_ctx, &mut simulated_time, 3_000_000).expect(\"edge_case_complete\");\n309\t}\n310\t\n311\t/// After the client closes, the server must not send more than ~50 preemptive\n312\t/// repeats and must stop within its idle timeout.\n313\t/// C: `ec9a_preemptive_amok_test` in `picoquictest/edge_cases.c`.\n314\t#[test]\n315\tfn ec9a_preemptive_amok() {\n316\t    let mut simulated_time = Instant::from_ticks(0);\n317\t    let mut test_ctx =\n318\t        edge_case_prepare(0x9a, false, &mut simulated_time, 0x800, 12).expect(\"edge_case_prepare\");\n319\t    assert!(test_ctx.has_cnx_server(), \"server connection must exist\");\n320\t    assert!(test_ctx.server_ready(), \"server must be in ready state\");\n321\t    assert!(test_ctx.test_finished, \"data transfer must have completed\");\n322\t    let (send_count, repeat_duration) =\n323\t        ec9a_server_loop(&mut test_ctx, &mut simulated_time).expect(\"server loop\");\n324\t    assert!(\n325\t        send_count <= 50,\n326\t        \"server sent too many repeat packets: {send_count}\"\n327\t    );\n328\t    // repeat_duration must be <= idle_timeout (checked inside ec9a_server_loop)\n329\t    let _ = repeat_duration;\n330\t}\n331\t\n332\t/// C: `idle_timeout_test` in `picoquictest/edge_cases.c`.\n333\t#[test]\n334\tfn idle_timeout() {\n335\t    idle_timeout_test_one(1, 30_000, 30_000, 30_000_000).expect(\"case 1\");\n336\t    idle_timeout_test_one(2, 60_000, 20_000, 20_000_000).expect(\"case 2\");\n337\t    idle_timeout_test_one(3, 20_000, 60_000, 20_000_000).expect(\"case 3\");\n338\t    idle_timeout_test_one(4, 5_000, 300_000, 5_000_000).expect(\"case 4\");\n339\t    idle_timeout_test_one(5, 300_000, 5_000, 5_000_000).expect(\"case 5\");\n340\t    idle_timeout_test_one(6, 0, 5_000, 5_000_000).expect(\"case 6\");\n341\t    idle_timeout_test_one(7, 0, 60_000, 60_000_000).expect(\"case 7\");\n342\t    idle_timeout_test_one(8, 5_000, 0, 5_000_000).expect(\"case 8\");\n343\t    idle_timeout_test_one(9, 60_000, 0, 60_000_000).expect(\"case 9\");\n344\t    idle_timeout_test_one(10, 0, 0, u64::MAX).expect(\"case 10\");\n345\t}\n346\t\n347\t/// C: `idle_server_test` in `picoquictest/edge_cases.c`.\n348\t#[test]\n349\tfn idle_server() {\n350\t    idle_server_test_one(1, 30_000, 0, 30_100_000).expect(\"case 1\");\n351\t    idle_server_test_one(2, 60_000, 0, 60_100_000).expect(\"case 2\");\n352\t    idle_server_test_one(3, 5_000, 0, 5_100_000).expect(\"case 3\");\n353\t    idle_server_test_one(4, 0, 0, 30_100_000).expect(\"case 4\");\n354\t    idle_server_test_one(5, 0, 10_000, 10_100_000).expect(\"case 5\");\n355\t    idle_server_test_one(6, 20_000, 60_000, 60_100_000).expect(\"case 6\");\n356\t    idle_server_test_one(7, 60_000, 5_000, 5_100_000).expect(\"case 7\");\n357\t}\n358\t\n359\t/// C: `initial_pto_test` in `picoquictest/edge_cases.c`.\n360\t#[test]\n361\tfn initial_pto() {\n362\t    let mut simulated_time = Instant::from_ticks(0);\n363\t    let initial_cid =\n364\t        ConnectionId::clone_from_slice(&[0x94, 0x01, 0x41, 0, 0, 0, 0, 0]).expect(\"8-byte CID\");\n365\t    let simulated_rtt = 20_000u64;\n366\t    let simulated_pto = 4 * simulated_rtt;\n367\t\n368\t    let mut test_ctx = tls_api_init_ctx_ex(\n369\t        &mut simulated_time,\n370\t        Version::InternalTest1 as u32,\n371\t        None,\n372\t        Some(&initial_cid),\n373\t    )\n374\t    .expect(\"tls_api_init_ctx_ex\");\n375\t\n376\t    test_ctx.qclient.set_qlog(\".\").ok();\n377\t    test_ctx.cnx_client().start_client().expect(\"start_client\");\n378\t\n379\t    // Send the initial packet to the server.\n380\t    let length =\n381\t        initial_pto_prepare(&mut test_ctx, &mut simulated_time).expect(\"initial_pto_prepare\");\n382\t    assert!(length >= 1200, \"initial packet too short: {length}\");\n383\t\n384\t    // Wait until the ACK time, then send a synthetic ACK to the client.\n385\t    if simulated_time.ticks() < simulated_rtt {\n386\t        let _length = initial_pto_wait(&mut test_ctx, &mut simulated_time, simulated_rtt)\n387\t            .expect(\"initial_pto_wait\");\n388\t    }\n389\t    initial_pto_ack(&mut test_ctx, &mut simulated_time).expect(\"initial_pto_ack\");\n390\t\n391\t    // The client should fire a PTO and send at least 1200 bytes.\n392\t    if simulated_time.ticks() < simulated_pto {\n393\t        let length = initial_pto_wait(&mut test_ctx, &mut simulated_time, simulated_pto)\n394\t            .expect(\"initial_pto_wait (PTO)\");\n395\t        assert!(length >= 1200, \"PTO packet not sent (length = {length})\");\n396\t    }\n397\t}\n398\t\n399\t/// C: `initial_pto_srv_test` in `picoquictest/edge_cases.c`.\n400\t#[test]\n401\tfn initial_pto_srv() {\n402\t    // Verify that the server's PTO includes both an Initial and a Handshake\n403\t    // packet when the initial packet is not yet acknowledged.\n404\t    todo!(\"initial_pto_srv: pto_server_prepare loop not yet implemented\")\n405\t}\n406\t\n407\t/// C: `reset_ack_max_test` in `picoquictest/edge_cases.c`.\n408\t#[test]\n409\tfn reset_ack_max() {\n410\t    reset_repeat_test_one(ResetTestKind::AckMaxStream).expect(\"reset_ack_max\");\n411\t}\n412\t\n413\t/// C: `reset_ack_reset_test` in `picoquictest/edge_cases.c`.\n414\t#[test]\n415\tfn reset_ack_reset() {\n416\t    reset_repeat_test_one(ResetTestKind::AckReset).expect(\"reset_ack_reset\");\n417\t}\n418\t\n419\t/// C: `reset_extra_max_test` in `picoquictest/edge_cases.c`.\n420\t#[test]\n421\tfn reset_extra_max() {\n422\t    reset_repeat_test_one(ResetTestKind::ExtraMaxStream).expect(\"reset_extra_max\");\n423\t}\n424\t\n425\t/// C: `reset_extra_reset_test` in `picoquictest/edge_cases.c`.\n426\t#[test]\n427\tfn reset_extra_reset() {\n428\t    reset_repeat_test_one(ResetTestKind::ExtraReset).expect(\"reset_extra_reset\");\n429\t}\n430\t\n431\t/// C: `reset_extra_stop_test` in `picoquictest/edge_cases.c`.\n432\t#[test]\n433\tfn reset_extra_stop() {\n434\t    reset_repeat_test_one(ResetTestKind::ExtraStop).expect(\"reset_extra_stop\");\n435\t}\n436\t\n437\t/// C: `reset_need_max_test` in `picoquictest/edge_cases.c`.\n438\t#[test]\n439\tfn reset_need_max() {\n440\t    reset_repeat_test_one(ResetTestKind::NeedMaxStream).expect(\"reset_need_max\");\n441\t}\n442\t\n443\t/// C: `reset_need_reset_test` in `picoquictest/edge_cases.c`.\n444\t#[test]\n445\tfn reset_need_reset() {\n446\t    reset_repeat_test_one(ResetTestKind::NeedReset).expect(\"reset_need_reset\");\n447\t}\n448\t\n449\t/// C: `reset_need_stop_test` in `picoquictest/edge_cases.c`.\n450\t#[test]\n451\tfn reset_need_stop() {\n452\t    reset_repeat_test_one(ResetTestKind::NeedStop).expect(\"reset_need_stop\");\n453\t}\n454\t\n455\t/// Reset a stream on the server side while it is still mid-transfer, then\n456\t/// verify that the client correctly forbids adding data or marking it active\n457\t/// after the reset.\n458\t/// C: `reset_loop_test` in `picoquictest/edge_cases.c`.\n459\t#[test]\n460\tfn reset_loop_test() {\n461\t    todo!(\"reset_loop_test: custom callback + stream manipulation not yet implemented\")\n462\t}\n463\t\n464\t/// C: `reset_stream_at_basic_test` in `picoquictest/edge_cases.c`.\n465\t#[test]\n466\tfn reset_stream_at_basic() {\n467\t    reset_stream_at_test_one(ResetStreamAtSpec::Basic).expect(\"reset_stream_at_basic\");\n468\t}\n469\t\n470\t/// C: `reset_stream_at_limit_test` in `picoquictest/edge_cases.c`.\n471\t#[test]\n472\tfn reset_stream_at_limit_test() {\n473\t    reset_stream_at_test_one(ResetStreamAtSpec::Limit).expect(\"reset_stream_at_limit\");\n474\t}\n475\t\n476\t/// C: `reset_stream_at_loss_test` in `picoquictest/edge_cases.c`.\n477\t#[test]\n478\tfn reset_stream_at_loss() {\n479\t    reset_stream_at_test_one(ResetStreamAtSpec::Loss).expect(\"reset_stream_at_loss\");\n480\t}\n481\t\n482\t/// Table-driven check that every named [`crate::errors::InternalError`]\n483\t/// and [`crate::errors::TransportError`] code resolves to its\n484\t/// short textual name, plus the four \"default-branch\" buckets\n485\t/// (`crypto error alert`, `unknown picoquic error`, `unknown`).\n486\t#[test]\n487\tfn error_name() {\n488\t    use crate::errors::InternalError;\n489\t\n490\t    let cases: &[(u64, &str)] = &[\n491\t        // Protocol (transport / TLS) errors.\n492\t        (0x1, \"internal\"),\n493\t        (0x2, \"server busy\"),\n494\t        (0x3, \"flow control\"),\n495\t        (0x4, \"stream limit\"),\n496\t        (0x5, \"stream state\"),\n497\t        (0x6, \"final offset\"),\n498\t        (0x7, \"frame format\"),\n499\t        (0x8, \"parameter\"),\n500\t        (0x9, \"connection_id limit\"),\n501\t        (0xA, \"protocol violation\"),\n502\t        (0xB, \"invalid token\"),\n503\t        (0xC, \"application\"),\n504\t        (0xD, \"crypto buffer exceeded\"),\n505\t        (0xE, \"key update\"),\n506\t        (0xF, \"aead limit\"),\n507\t        (0x178, \"wrong alpn\"),\n508\t        (0x201, \"tls handshake failed\"),\n509\t        (0x11, \"version negotiation\"),\n510\t        (0x3e, \"application abandon\"),\n511\t        (0x3e75, \"resource limit reached\"),\n512\t        (0x3e76, \"unstable interface\"),\n513\t        (0x3e77, \"no CID available\"),\n514\t        // Picoquic-internal codes (0x400+ range).\n515\t        (0x401, \"duplicate\"),\n516\t        (0x403, \"payload_decrypt_error\"),\n517\t        (0x404, \"unexpected packet\"),\n518\t        (0x405, \"memory\"),\n519\t        (0x407, \"connection ID check\"),\n520\t        (0x408, \"\"),\n521\t        (0x409, \"version negotation spoofed\"),\n522\t        (0x40A, \"malformed transport extension\"),\n523\t        (0x40B, \"extension buffer too small\"),\n524\t        (0x40C, \"illegal transport extension\"),\n525\t        (0x40D, \"cannot reset the crypto stream\"),\n526\t        (0x40E, \"invalid stream id\"),\n527\t        (0x40F, \"stream already closed\"),\n528\t        (0x410, \"frame buffer too small\"),\n529\t        (0x411, \"invalid frame\"),\n530\t        (0x412, \"cannot control the crypto stream\"),\n531\t        (0x413, \"retry\"),\n532\t        (0x414, \"disconnected\"),\n533\t        (0x415, \"error detected\"),\n534\t        (0x417, \"invalid ticket\"),\n535\t        (0x418, \"invalid file\"),\n536\t        (0x419, \"send buffer too small\"),\n537\t        (0x41A, \"unexpected state\"),\n538\t        (0x41B, \"unexpected error\"),\n539\t        (0x41C, \"server configuration without cert\"),\n540\t        (0x41D, \"no such file\"),\n541\t        (0x41E, \"stateless reset\"),\n542\t        (0x41F, \"connection deleted\"),\n543\t        (0x420, \"connection ID segment error\"),\n544\t        (0x421, \"connection ID not available\"),\n545\t        (0x422, \"migration disabled\"),\n546\t        (0x423, \"cannot compute key\"),\n547\t        (0x424, \"cannot set active stream\"),\n548\t        (0x425, \"cannot change active context\"),\n549\t        (0x426, \"invalid token\"),\n550\t        (0x427, \"initial CID too short\"),\n551\t        (0x428, \"key rotation not ready\"),\n552\t        (0x429, \"aead not ready\"),\n553\t        (0x42A, \"no ALPN provided\"),\n554\t        (0x42B, \"no callback provided\"),\n555\t        (0x42C, \"stream receive complete\"),\n556\t        (0x42D, \"packet header parsing\"),\n557\t        (0x42E, \"QUIC bit missing\"),\n558\t        (0x42F, \"terminate packet loop (not an error)\"),\n559\t        (0x430, \"simulate NAT (not an error)\"),\n560\t        (0x431, \"simulate migration (not an error)\"),\n561\t        (0x432, \"version not supported\"),\n562\t        (0x433, \"idle timeout\"),\n563\t        (0x434, \"repeat timeout\"),\n564\t        (0x435, \"handshake timeout\"),\n565\t        (0x436, \"socket\"),\n566\t        (0x437, \"version negotiation\"),\n567\t        (0x438, \"packet too long\"),\n568\t        (0x439, \"wrong version\"),\n569\t        (0x43A, \"port blocked\"),\n570\t        (0x43B, \"datagram too long\"),\n571\t        (0x43C, \"invalid path ID\"),\n572\t        (0x43D, \"retry needed\"),\n573\t        (0x43E, \"server busy\"),\n574\t        (0x43F, \"duplicate path\"),\n575\t        (0x440, \"blocked by lack of path ID\"),\n576\t        (0x441, \"blocked by lack of CID\"),\n577\t        (0x442, \"path address family\"),\n578\t        (0x443, \"path not ready\"),\n579\t        (0x444, \"path limit exceeded\"),\n580\t        (0x445, \"redirected to proxy (not an error)\"),\n581\t        (0x446, \"padding_packet\"),\n582\t        // CRYPTO_ERROR alert range (default branch).\n583\t        (0x101, \"crypto error alert\"),\n584\t        (0x150, \"crypto error alert\"),\n585\t        (0x1FF, \"crypto error alert\"),\n586\t        // Unknown picoquic error range (default branch).\n587\t        (0x450, \"unknown picoquic error\"),\n588\t        (0x4FF, \"unknown picoquic error\"),\n589\t        // Truly unknown.\n590\t        (0x0, \"unknown\"),\n591\t        (0x200, \"unknown\"),\n592\t        (0x500, \"unknown\"),\n593\t        (0xFFFF_FFFF_FFFF_FFFF, \"unknown\"),\n594\t    ];\n595\t\n596\t    for &(code, expected) in cases {\n597\t        let got = InternalError::name(code).unwrap_or(\"<none>\");\n598\t        assert_eq!(\n599\t            got, expected,\n600\t            \"error_code=0x{code:x} got={got:?} expected={expected:?}\",\n601\t        );\n602\t    }\n603\t}\n604\t"}]},"parent_tool_use_id":null,"session_id":"17072f18-9969-498e-bec6-45838e44ca80","uuid":"3af895d8-9ffd-40e5-a88c-1a6674269ca6","timestamp":"2026-05-05T03:27:07.682Z","tool_use_result":{"type":"text","file":{"filePath":"/Users/richbarn/Projects/picoquic/rs/fq/src/tests/edge_cases.rs","content":"//! Test cases for `picoquictest/edge_cases.c`.\n//!\n//! A collection of regression tests for edge cases typically discovered\n//! via the QUIC interop runner.  Many involve specific loss patterns during\n//! 0-RTT handshakes, idle-timeout negotiation, stream-reset interaction,\n//! initial-PTO behaviour, and crypto-handshake frame errors.\n\n#![allow(non_snake_case)]\n\nuse super::util::{\n    TestApiStreamDesc, TestTlsApiCtx, tls_api_close_with_losses, tls_api_connection_loop,\n    tls_api_data_sending_loop, tls_api_init_ctx_ex, tls_api_one_scenario_body_verify,\n};\nuse crate::internal::Version;\nuse crate::{ConnectionId, Instant, PacketContext};\n\n// ---------------------------------------------------------------------------\n// Shared scenarios.  Passed to helpers once those are implemented.\n\n#[allow(dead_code)]\nstatic SCENARIO_EDGE_CASE: &[TestApiStreamDesc] = &[TestApiStreamDesc {\n    stream_id: 4,\n    previous_stream_id: 0,\n    q_len: 128,\n    r_len: 1_000,\n}];\n\n#[allow(dead_code)]\nstatic SCENARIO_EDGE_RESET: &[TestApiStreamDesc] = &[TestApiStreamDesc {\n    stream_id: 4,\n    previous_stream_id: 0,\n    q_len: 1_000_000,\n    r_len: 1_000_000,\n}];\n\n#[allow(dead_code)]\nstatic SCENARIO_RESET_AT: &[TestApiStreamDesc] = &[TestApiStreamDesc {\n    stream_id: 4,\n    previous_stream_id: 0,\n    q_len: 257,\n    r_len: 1_000_000,\n}];\n\n/// Set up a test context with the standard edge-case configuration: a\n/// CID of the form `{0xed, 0x9e, 0xca, 0x5e, edge_case_id, zero_rtt, 0, 0}`,\n/// optional 0-RTT first pass, and `nb_init_rounds` rounds of simulation\n/// with the given `loss_mask`.\n/// C: `edge_case_prepare` in `picoquictest/edge_cases.c`.\nfn edge_case_prepare(\n    _edge_case_id: u8,\n    _zero_rtt: bool,\n    _simulated_time: &mut Instant,\n    _loss_mask: u64,\n    _nb_init_rounds: i32,\n) -> crate::Result<Box<TestTlsApiCtx>> {\n    todo!(\"edge_case_prepare: 0-RTT setup and partial simulation not yet implemented\")\n}\n\n/// Finish an edge-case test: run the connection loop, enable\n/// `immediate_exit`, drive data sending, and verify completion within\n/// `duration_max` µs.\n/// C: `edge_case_complete` in `picoquictest/edge_cases.c`.\nfn edge_case_complete(\n    test_ctx: &mut TestTlsApiCtx,\n    simulated_time: &mut Instant,\n    duration_max: u64,\n) -> crate::Result<()> {\n    let mut loss_mask = 0u64;\n    tls_api_connection_loop(test_ctx, &mut loss_mask, 0, simulated_time)?;\n    test_ctx.immediate_exit = true;\n    tls_api_data_sending_loop(test_ctx, &mut loss_mask, simulated_time, 0)?;\n    tls_api_one_scenario_body_verify(test_ctx, simulated_time, duration_max)\n}\n\n// ---------------------------------------------------------------------------\n// Reset-repeat test.\n\n/// Variant of the reset-repeat test: which frame event to exercise.\n/// C: `reset_test_enum` in `picoquictest/edge_cases.c`.\nenum ResetTestKind {\n    AckMaxStream = 0,\n    AckReset,\n    ExtraMaxStream,\n    ExtraReset,\n    ExtraStop,\n    NeedMaxStream,\n    NeedReset,\n    NeedStop,\n}\n\n/// Establish a connection, start a large stream transfer, reset the stream\n/// on both sides, wait for the stream context to be freed, then exercise\n/// the specified post-reset frame event.\n/// C: `reset_repeat_test_one` in `picoquictest/edge_cases.c`.\nfn reset_repeat_test_one(_kind: ResetTestKind) -> crate::Result<()> {\n    todo!(\"reset_repeat_test_one: stream-reset ACK/extra/need logic not yet implemented\")\n}\n\n// ---------------------------------------------------------------------------\n// Idle-timeout test helpers.\n\n/// Verify idle-timeout negotiation: `client_timeout` and `server_timeout`\n/// (in ms) must negotiate to `expected_timeout` (in µs); assert the\n/// connection remains alive at half-time and drops by full-time.\n/// C: `idle_timeout_test_one` in `picoquictest/edge_cases.c`.\nfn idle_timeout_test_one(\n    _test_id: u8,\n    _client_timeout: u64,\n    _server_timeout: u64,\n    _expected_timeout: u64,\n) -> crate::Result<()> {\n    todo!(\"idle_timeout_test_one: idle-timeout negotiation loop not yet implemented\")\n}\n\n/// Verify that a client connecting to a non-responding server disconnects\n/// after `expected_timeout` µs (derived from `client_timeout` ms or\n/// `handshake_timeout` µs).\n/// C: `idle_server_test_one` in `picoquictest/edge_cases.c`.\nfn idle_server_test_one(\n    _test_id: u8,\n    _client_timeout: u64,\n    _handshake_timeout: u64,\n    _expected_timeout: u64,\n) -> crate::Result<()> {\n    todo!(\"idle_server_test_one: server-silent loop not yet implemented\")\n}\n\n// ---------------------------------------------------------------------------\n// Initial-PTO helpers.\n\n/// Prepare the client's initial packet and submit it to the server to\n/// establish a crypto context on both sides.\n/// C: `initial_pto_prepare` in `picoquictest/edge_cases.c`.\nfn initial_pto_prepare(\n    _test_ctx: &mut TestTlsApiCtx,\n    _simulated_time: &mut Instant,\n) -> crate::Result<usize> {\n    todo!(\"initial_pto_prepare: prepare_packet + incoming_packet not yet implemented\")\n}\n\n/// Advance time until the client's next scheduled send, returning the packet\n/// length.  Stops early if the client enters a failure state.\n/// C: `initial_pto_wait` in `picoquictest/edge_cases.c`.\nfn initial_pto_wait(\n    _test_ctx: &mut TestTlsApiCtx,\n    _simulated_time: &mut Instant,\n    _max_wait: u64,\n) -> crate::Result<usize> {\n    todo!(\"initial_pto_wait: client next_wake_time loop not yet implemented\")\n}\n\n/// Craft a synthetic server ACK (Initial epoch) and deliver it to the client.\n/// C: `initial_pto_ack` in `picoquictest/edge_cases.c`.\nfn initial_pto_ack(\n    _test_ctx: &mut TestTlsApiCtx,\n    _simulated_time: &mut Instant,\n) -> crate::Result<()> {\n    todo!(\"initial_pto_ack: predict_header + format_ack + protect_packet not yet implemented\")\n}\n\n// ---------------------------------------------------------------------------\n// Crypto-HS-offset helper.\n\n/// Inject a crypto handshake frame with a 64 KB offset into packet context\n/// `pc`, attempt the connection, and verify the client receives\n/// CRYPTO_BUFFER_EXCEEDED or IDLE_TIMEOUT.\n/// C: `crypto_hs_offset_test_one` in `picoquictest/edge_cases.c`.\nfn crypto_hs_offset_one(_pc: PacketContext) -> crate::Result<()> {\n    todo!(\"crypto_hs_offset_one: queue_misc_frame + connection loop not yet implemented\")\n}\n\n// ---------------------------------------------------------------------------\n// Reset-stream-at helper.\n\n/// Variant for `reset_stream_at_test_one`.\n/// C: `reset_stream_at_test_enum` in `picoquictest/edge_cases.c`.\nenum ResetStreamAtSpec {\n    /// Reset just past what was already received.\n    Basic,\n    /// Reset exactly at the sent offset.\n    Limit,\n    /// Reset past what was received with a lossy link.\n    Loss,\n}\n\n/// Establish a connection, start sending a 1 MB stream, wait a short\n/// time, then call `reset_stream_at` with the appropriate `reliable_size`.\n/// Verify that the scenario completes and that `reliable_size` bytes were\n/// delivered.\n/// C: `reset_stream_at_test_one` in `picoquictest/edge_cases.c`.\nfn reset_stream_at_test_one(_spec: ResetStreamAtSpec) -> crate::Result<()> {\n    todo!(\"reset_stream_at_test_one: reset_stream_at + data loop not yet implemented\")\n}\n\n// ---------------------------------------------------------------------------\n// ec9a helper (unique body, not a shared helper in C).\n\n/// Run the server-only prepare loop for `ec9a_preemptive_amok`:\n/// advance simulated time through server wakes, counting sent packets,\n/// until the server's connection count drops to zero.  Returns\n/// `(send_count, repeat_duration_µs)`.\nfn ec9a_server_loop(\n    _test_ctx: &mut TestTlsApiCtx,\n    _simulated_time: &mut Instant,\n) -> crate::Result<(i32, u64)> {\n    todo!(\"ec9a_server_loop: prepare_next_packet_ex server loop not yet implemented\")\n}\n\n// ---------------------------------------------------------------------------\n// Test entries.\n\n/// C: `crypto_hs_offset_test` in `picoquictest/edge_cases.c`.\n#[test]\nfn crypto_hs_offset() {\n    for pc in [\n        PacketContext::Initial,\n        PacketContext::Handshake,\n        PacketContext::Application,\n    ] {\n        crypto_hs_offset_one(pc).expect(\"crypto_hs_offset_one\");\n    }\n}\n\n/// Edge case zero: verify the common 0-RTT infrastructure works.\n/// C: `ec00_zero_test` in `picoquictest/edge_cases.c`.\n#[test]\nfn ec00_zero() {\n    let mut simulated_time = Instant::from_ticks(0);\n    let mut test_ctx =\n        edge_case_prepare(0x00, true, &mut simulated_time, 0, 4).expect(\"edge_case_prepare\");\n    edge_case_complete(&mut test_ctx, &mut simulated_time, 100_000).expect(\"edge_case_complete\");\n    assert!(\n        test_ctx.cnx_client().nb_zero_rtt_acked > 0,\n        \"expected at least one 0-RTT packet acked\"\n    );\n}\n\n/// Second-flight NACK: client should recover even when the handshake ACK\n/// and HandshakeDone are lost.\n/// C: `ec2f_second_flight_nack_test` in `picoquictest/edge_cases.c`.\n#[test]\nfn ec2f_second_flight() {\n    let mut simulated_time = Instant::from_ticks(0);\n    let initial_losses = 0x1c1u64;\n    let mut test_ctx = edge_case_prepare(0x2f, true, &mut simulated_time, initial_losses, 9)\n        .expect(\"edge_case_prepare\");\n    // After 9 rounds: client must not yet be Ready; server must be Ready.\n    assert!(\n        !test_ctx.client_ready(),\n        \"client should not be ready yet after partial handshake\"\n    );\n    assert!(test_ctx.server_ready(), \"server should be ready\");\n    edge_case_complete(&mut test_ctx, &mut simulated_time, 360_000).expect(\"edge_case_complete\");\n}\n\n/// Fuzz 50 random loss patterns to look for corrupted retransmissions.\n/// C: `eccf_corrupted_file_fuzz_test` in `picoquictest/edge_cases.c`.\n#[test]\nfn eccf_corrupted_fuzz() {\n    // Runs 50 edge_case_prepare + edge_case_complete iterations with\n    // random loss masks derived from a deterministic seed.\n    todo!(\"eccf_corrupted_fuzz: random-loss fuzz loop not yet implemented\")\n}\n\n/// Amplification-limited handshake with a large server hello and losses.\n/// C: `eca1_amplification_loss_test` in `picoquictest/edge_cases.c`.\n#[test]\nfn eca1_amplification_loss() {\n    let mut simulated_time = Instant::from_ticks(0);\n    let mut test_ctx =\n        edge_case_prepare(0xa1, false, &mut simulated_time, 0x0FF4, 16).expect(\"edge_case_prepare\");\n    edge_case_complete(&mut test_ctx, &mut simulated_time, 15_000_000).expect(\"edge_case_complete\");\n}\n\n/// Loss of the final closing packet: connection must close within 10 s.\n/// C: `ecf1_final_loss_test` in `picoquictest/edge_cases.c`.\n#[test]\nfn ecf1_final_loss() {\n    let mut simulated_time = Instant::from_ticks(0);\n    let mut test_ctx =\n        edge_case_prepare(0xf1, false, &mut simulated_time, 0, 20).expect(\"edge_case_prepare\");\n    let mut zero_loss = 0u64;\n    tls_api_connection_loop(&mut test_ctx, &mut zero_loss, 0, &mut simulated_time)\n        .expect(\"connection loop\");\n    test_ctx.immediate_exit = true;\n    tls_api_data_sending_loop(&mut test_ctx, &mut zero_loss, &mut simulated_time, 0)\n        .expect(\"data sending loop\");\n    tls_api_close_with_losses(&mut test_ctx, &mut simulated_time, 0xb10)\n        .expect(\"close with losses\");\n    assert!(\n        simulated_time.ticks() <= 10_000_000,\n        \"connection close took too long: {} µs\",\n        simulated_time.ticks()\n    );\n}\n\n/// Silly CID: server sends a new CID frame that is dropped and later\n/// repeated in a bogus way.  Both sides must reach Ready.\n/// C: `ec5c_silly_cid_test` in `picoquictest/edge_cases.c`.\n#[test]\nfn ec5c_silly_cid() {\n    let mut simulated_time = Instant::from_ticks(0);\n    let mut test_ctx = edge_case_prepare(0x5c, false, &mut simulated_time, 0x01e084, 48)\n        .expect(\"edge_case_prepare\");\n    assert!(test_ctx.has_cnx_server(), \"server connection must exist\");\n    assert!(test_ctx.client_ready(), \"client must be ready\");\n    assert!(test_ctx.server_ready(), \"server must be ready\");\n    edge_case_complete(&mut test_ctx, &mut simulated_time, 3_000_000).expect(\"edge_case_complete\");\n}\n\n/// After the client closes, the server must not send more than ~50 preemptive\n/// repeats and must stop within its idle timeout.\n/// C: `ec9a_preemptive_amok_test` in `picoquictest/edge_cases.c`.\n#[test]\nfn ec9a_preemptive_amok() {\n    let mut simulated_time = Instant::from_ticks(0);\n    let mut test_ctx =\n        edge_case_prepare(0x9a, false, &mut simulated_time, 0x800, 12).expect(\"edge_case_prepare\");\n    assert!(test_ctx.has_cnx_server(), \"server connection must exist\");\n    assert!(test_ctx.server_ready(), \"server must be in ready state\");\n    assert!(test_ctx.test_finished, \"data transfer must have completed\");\n    let (send_count, repeat_duration) =\n        ec9a_server_loop(&mut test_ctx, &mut simulated_time).expect(\"server loop\");\n    assert!(\n        send_count <= 50,\n        \"server sent too many repeat packets: {send_count}\"\n    );\n    // repeat_duration must be <= idle_timeout (checked inside ec9a_server_loop)\n    let _ = repeat_duration;\n}\n\n/// C: `idle_timeout_test` in `picoquictest/edge_cases.c`.\n#[test]\nfn idle_timeout() {\n    idle_timeout_test_one(1, 30_000, 30_000, 30_000_000).expect(\"case 1\");\n    idle_timeout_test_one(2, 60_000, 20_000, 20_000_000).expect(\"case 2\");\n    idle_timeout_test_one(3, 20_000, 60_000, 20_000_000).expect(\"case 3\");\n    idle_timeout_test_one(4, 5_000, 300_000, 5_000_000).expect(\"case 4\");\n    idle_timeout_test_one(5, 300_000, 5_000, 5_000_000).expect(\"case 5\");\n    idle_timeout_test_one(6, 0, 5_000, 5_000_000).expect(\"case 6\");\n    idle_timeout_test_one(7, 0, 60_000, 60_000_000).expect(\"case 7\");\n    idle_timeout_test_one(8, 5_000, 0, 5_000_000).expect(\"case 8\");\n    idle_timeout_test_one(9, 60_000, 0, 60_000_000).expect(\"case 9\");\n    idle_timeout_test_one(10, 0, 0, u64::MAX).expect(\"case 10\");\n}\n\n/// C: `idle_server_test` in `picoquictest/edge_cases.c`.\n#[test]\nfn idle_server() {\n    idle_server_test_one(1, 30_000, 0, 30_100_000).expect(\"case 1\");\n    idle_server_test_one(2, 60_000, 0, 60_100_000).expect(\"case 2\");\n    idle_server_test_one(3, 5_000, 0, 5_100_000).expect(\"case 3\");\n    idle_server_test_one(4, 0, 0, 30_100_000).expect(\"case 4\");\n    idle_server_test_one(5, 0, 10_000, 10_100_000).expect(\"case 5\");\n    idle_server_test_one(6, 20_000, 60_000, 60_100_000).expect(\"case 6\");\n    idle_server_test_one(7, 60_000, 5_000, 5_100_000).expect(\"case 7\");\n}\n\n/// C: `initial_pto_test` in `picoquictest/edge_cases.c`.\n#[test]\nfn initial_pto() {\n    let mut simulated_time = Instant::from_ticks(0);\n    let initial_cid =\n        ConnectionId::clone_from_slice(&[0x94, 0x01, 0x41, 0, 0, 0, 0, 0]).expect(\"8-byte CID\");\n    let simulated_rtt = 20_000u64;\n    let simulated_pto = 4 * simulated_rtt;\n\n    let mut test_ctx = tls_api_init_ctx_ex(\n        &mut simulated_time,\n        Version::InternalTest1 as u32,\n        None,\n        Some(&initial_cid),\n    )\n    .expect(\"tls_api_init_ctx_ex\");\n\n    test_ctx.qclient.set_qlog(\".\").ok();\n    test_ctx.cnx_client().start_client().expect(\"start_client\");\n\n    // Send the initial packet to the server.\n    let length =\n        initial_pto_prepare(&mut test_ctx, &mut simulated_time).expect(\"initial_pto_prepare\");\n    assert!(length >= 1200, \"initial packet too short: {length}\");\n\n    // Wait until the ACK time, then send a synthetic ACK to the client.\n    if simulated_time.ticks() < simulated_rtt {\n        let _length = initial_pto_wait(&mut test_ctx, &mut simulated_time, simulated_rtt)\n            .expect(\"initial_pto_wait\");\n    }\n    initial_pto_ack(&mut test_ctx, &mut simulated_time).expect(\"initial_pto_ack\");\n\n    // The client should fire a PTO and send at least 1200 bytes.\n    if simulated_time.ticks() < simulated_pto {\n        let length = initial_pto_wait(&mut test_ctx, &mut simulated_time, simulated_pto)\n            .expect(\"initial_pto_wait (PTO)\");\n        assert!(length >= 1200, \"PTO packet not sent (length = {length})\");\n    }\n}\n\n/// C: `initial_pto_srv_test` in `picoquictest/edge_cases.c`.\n#[test]\nfn initial_pto_srv() {\n    // Verify that the server's PTO includes both an Initial and a Handshake\n    // packet when the initial packet is not yet acknowledged.\n    todo!(\"initial_pto_srv: pto_server_prepare loop not yet implemented\")\n}\n\n/// C: `reset_ack_max_test` in `picoquictest/edge_cases.c`.\n#[test]\nfn reset_ack_max() {\n    reset_repeat_test_one(ResetTestKind::AckMaxStream).expect(\"reset_ack_max\");\n}\n\n/// C: `reset_ack_reset_test` in `picoquictest/edge_cases.c`.\n#[test]\nfn reset_ack_reset() {\n    reset_repeat_test_one(ResetTestKind::AckReset).expect(\"reset_ack_reset\");\n}\n\n/// C: `reset_extra_max_test` in `picoquictest/edge_cases.c`.\n#[test]\nfn reset_extra_max() {\n    reset_repeat_test_one(ResetTestKind::ExtraMaxStream).expect(\"reset_extra_max\");\n}\n\n/// C: `reset_extra_reset_test` in `picoquictest/edge_cases.c`.\n#[test]\nfn reset_extra_reset() {\n    reset_repeat_test_one(ResetTestKind::ExtraReset).expect(\"reset_extra_reset\");\n}\n\n/// C: `reset_extra_stop_test` in `picoquictest/edge_cases.c`.\n#[test]\nfn reset_extra_stop() {\n    reset_repeat_test_one(ResetTestKind::ExtraStop).expect(\"reset_extra_stop\");\n}\n\n/// C: `reset_need_max_test` in `picoquictest/edge_cases.c`.\n#[test]\nfn reset_need_max() {\n    reset_repeat_test_one(ResetTestKind::NeedMaxStream).expect(\"reset_need_max\");\n}\n\n/// C: `reset_need_reset_test` in `picoquictest/edge_cases.c`.\n#[test]\nfn reset_need_reset() {\n    reset_repeat_test_one(ResetTestKind::NeedReset).expect(\"reset_need_reset\");\n}\n\n/// C: `reset_need_stop_test` in `picoquictest/edge_cases.c`.\n#[test]\nfn reset_need_stop() {\n    reset_repeat_test_one(ResetTestKind::NeedStop).expect(\"reset_need_stop\");\n}\n\n/// Reset a stream on the server side while it is still mid-transfer, then\n/// verify that the client correctly forbids adding data or marking it active\n/// after the reset.\n/// C: `reset_loop_test` in `picoquictest/edge_cases.c`.\n#[test]\nfn reset_loop_test() {\n    todo!(\"reset_loop_test: custom callback + stream manipulation not yet implemented\")\n}\n\n/// C: `reset_stream_at_basic_test` in `picoquictest/edge_cases.c`.\n#[test]\nfn reset_stream_at_basic() {\n    reset_stream_at_test_one(ResetStreamAtSpec::Basic).expect(\"reset_stream_at_basic\");\n}\n\n/// C: `reset_stream_at_limit_test` in `picoquictest/edge_cases.c`.\n#[test]\nfn reset_stream_at_limit_test() {\n    reset_stream_at_test_one(ResetStreamAtSpec::Limit).expect(\"reset_stream_at_limit\");\n}\n\n/// C: `reset_stream_at_loss_test` in `picoquictest/edge_cases.c`.\n#[test]\nfn reset_stream_at_loss() {\n    reset_stream_at_test_one(ResetStreamAtSpec::Loss).expect(\"reset_stream_at_loss\");\n}\n\n/// Table-driven check that every named [`crate::errors::InternalError`]\n/// and [`crate::errors::TransportError`] code resolves to its\n/// short textual name, plus the four \"default-branch\" buckets\n/// (`crypto error alert`, `unknown picoquic error`, `unknown`).\n#[test]\nfn error_name() {\n    use crate::errors::InternalError;\n\n    let cases: &[(u64, &str)] = &[\n        // Protocol (transport / TLS) errors.\n        (0x1, \"internal\"),\n        (0x2, \"server busy\"),\n        (0x3, \"flow control\"),\n        (0x4, \"stream limit\"),\n        (0x5, \"stream state\"),\n        (0x6, \"final offset\"),\n        (0x7, \"frame format\"),\n        (0x8, \"parameter\"),\n        (0x9, \"connection_id limit\"),\n        (0xA, \"protocol violation\"),\n        (0xB, \"invalid token\"),\n        (0xC, \"application\"),\n        (0xD, \"crypto buffer exceeded\"),\n        (0xE, \"key update\"),\n        (0xF, \"aead limit\"),\n        (0x178, \"wrong alpn\"),\n        (0x201, \"tls handshake failed\"),\n        (0x11, \"version negotiation\"),\n        (0x3e, \"application abandon\"),\n        (0x3e75, \"resource limit reached\"),\n        (0x3e76, \"unstable interface\"),\n        (0x3e77, \"no CID available\"),\n        // Picoquic-internal codes (0x400+ range).\n        (0x401, \"duplicate\"),\n        (0x403, \"payload_decrypt_error\"),\n        (0x404, \"unexpected packet\"),\n        (0x405, \"memory\"),\n        (0x407, \"connection ID check\"),\n        (0x408, \"\"),\n        (0x409, \"version negotation spoofed\"),\n        (0x40A, \"malformed transport extension\"),\n        (0x40B, \"extension buffer too small\"),\n        (0x40C, \"illegal transport extension\"),\n        (0x40D, \"cannot reset the crypto stream\"),\n        (0x40E, \"invalid stream id\"),\n        (0x40F, \"stream already closed\"),\n        (0x410, \"frame buffer too small\"),\n        (0x411, \"invalid frame\"),\n        (0x412, \"cannot control the crypto stream\"),\n        (0x413, \"retry\"),\n        (0x414, \"disconnected\"),\n        (0x415, \"error detected\"),\n        (0x417, \"invalid ticket\"),\n        (0x418, \"invalid file\"),\n        (0x419, \"send buffer too small\"),\n        (0x41A, \"unexpected state\"),\n        (0x41B, \"unexpected error\"),\n        (0x41C, \"server configuration without cert\"),\n        (0x41D, \"no such file\"),\n        (0x41E, \"stateless reset\"),\n        (0x41F, \"connection deleted\"),\n        (0x420, \"connection ID segment error\"),\n        (0x421, \"connection ID not available\"),\n        (0x422, \"migration disabled\"),\n        (0x423, \"cannot compute key\"),\n        (0x424, \"cannot set active stream\"),\n        (0x425, \"cannot change active context\"),\n        (0x426, \"invalid token\"),\n        (0x427, \"initial CID too short\"),\n        (0x428, \"key rotation not ready\"),\n        (0x429, \"aead not ready\"),\n        (0x42A, \"no ALPN provided\"),\n        (0x42B, \"no callback provided\"),\n        (0x42C, \"stream receive complete\"),\n        (0x42D, \"packet header parsing\"),\n        (0x42E, \"QUIC bit missing\"),\n        (0x42F, \"terminate packet loop (not an error)\"),\n        (0x430, \"simulate NAT (not an error)\"),\n        (0x431, \"simulate migration (not an error)\"),\n        (0x432, \"version not supported\"),\n        (0x433, \"idle timeout\"),\n        (0x434, \"repeat timeout\"),\n        (0x435, \"handshake timeout\"),\n        (0x436, \"socket\"),\n        (0x437, \"version negotiation\"),\n        (0x438, \"packet too long\"),\n        (0x439, \"wrong version\"),\n        (0x43A, \"port blocked\"),\n        (0x43B, \"datagram too long\"),\n        (0x43C, \"invalid path ID\"),\n        (0x43D, \"retry needed\"),\n        (0x43E, \"server busy\"),\n        (0x43F, \"duplicate path\"),\n        (0x440, \"blocked by lack of path ID\"),\n        (0x441, \"blocked by lack of CID\"),\n        (0x442, \"path address family\"),\n        (0x443, \"path not ready\"),\n        (0x444, \"path limit exceeded\"),\n        (0x445, \"redirected to proxy (not an error)\"),\n        (0x446, \"padding_packet\"),\n        // CRYPTO_ERROR alert range (default branch).\n        (0x101, \"crypto error alert\"),\n        (0x150, \"crypto error alert\"),\n        (0x1FF, \"crypto error alert\"),\n        // Unknown picoquic error range (default branch).\n        (0x450, \"unknown picoquic error\"),\n        (0x4FF, \"unknown picoquic error\"),\n        // Truly unknown.\n        (0x0, \"unknown\"),\n        (0x200, \"unknown\"),\n        (0x500, \"unknown\"),\n        (0xFFFF_FFFF_FFFF_FFFF, \"unknown\"),\n    ];\n\n    for &(code, expected) in cases {\n        let got = InternalError::name(code).unwrap_or(\"<none>\");\n        assert_eq!(\n            got, expected,\n            \"error_code=0x{code:x} got={got:?} expected={expected:?}\",\n        );\n    }\n}\n","numLines":604,"startLine":1,"totalLines":604}}}
