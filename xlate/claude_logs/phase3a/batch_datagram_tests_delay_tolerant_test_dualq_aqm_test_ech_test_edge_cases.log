{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01R7nFS7WpJaFEEEdGG6LPPg","type":"tool_result","content":"300\t    uint64_t simulated_time = 0;\n301\t    picoquic_test_tls_api_ctx_t* test_ctx = NULL;\n302\t    int ret = edge_case_prepare(&test_ctx, 0, 1, &simulated_time, 0, 4);\n303\t\n304\t    if (ret == 0) {\n305\t        ret = edge_case_complete(test_ctx, &simulated_time, 100000);\n306\t    }\n307\t\n308\t    if (ret == 0) {\n309\t        if (test_ctx->cnx_client->nb_zero_rtt_acked == 0) {\n310\t            DBG_PRINTF(\"Nb 0RTT acked = %d\", test_ctx->cnx_client->nb_zero_rtt_acked);\n311\t            ret = -1;\n312\t        }\n313\t    }\n314\t\n315\t    if (test_ctx != NULL) {\n316\t        tls_api_delete_ctx(test_ctx);\n317\t        test_ctx = NULL;\n318\t    }\n319\t\n320\t    return ret;\n321\t}\n322\t\n323\t/* Reproduce and fix a specific error:\n324\t * - 0RTT packet was lost\n325\t * - Client second flight arrives at peer, but handshake ACK is lost\n326\t * - Handshake Done is lost\n327\t * Client appears stuck repeating second flight, intead of trying to\n328\t * make progress and send data.\n329\t * \n330\t * This is unlocked by enabling retransmission of data in \"client almost ready\"\n331\t * state. \n332\t */\n333\t\n334\tint ec2f_second_flight_nack_test(void)\n335\t{\n336\t    uint64_t simulated_time = 0;\n337\t    picoquic_test_tls_api_ctx_t* test_ctx = NULL;\n338\t    uint64_t initial_losses = 0x1c1;\n339\t    uint8_t test_case_id = 0x2f;\n340\t    int ret = edge_case_prepare(&test_ctx, test_case_id, 1, &simulated_time, initial_losses, 9);\n341\t\n342\t    if (ret == 0) {\n343\t        if (test_ctx->cnx_client->cnx_state >= picoquic_state_ready ||\n344\t            test_ctx->cnx_server->cnx_state != picoquic_state_ready) {\n345\t            DBG_PRINTF(\"Unexpected state, client: %d, server: %d\",\n346\t                test_ctx->cnx_client->cnx_state, test_ctx->cnx_server->cnx_state);\n347\t            ret = -1;\n348\t        }\n349\t    }\n350\t\n351\t    if (ret == 0) {\n352\t        ret = edge_case_complete(test_ctx, &simulated_time, 360000);\n353\t    }\n354\t\n355\t    if (test_ctx != NULL) {\n356\t        tls_api_delete_ctx(test_ctx);\n357\t        test_ctx = NULL;\n358\t    }\n359\t\n360\t    return ret;\n361\t}\n362\t\n363\t/* Try reproduce a corrupt file transmission occuring\n364\t * during a lossy handshake. At some point, the server\n365\t * sent random content instead of repeating the original packet\n366\t * content. Attempts to just reproduce the sequence in\n367\t * the interop runner failed, so instead we add a specialized\n368\t * fuzzer. Running that fuzzer in ASAN/UBSAN builds might\n369\t * detect the corruption some day.\n370\t */\n371\t\n372\tvoid eccf_corrupted_file_fuzz(int nb_trials, uint64_t seed, FILE* F)\n373\t{\n374\t    uint64_t random_context = (seed == 0)?0x1234567887654321ull:seed;\n375\t\n376\t    for (int i = 0; i < nb_trials; i++) {\n377\t        uint64_t simulated_time = 0;\n378\t        picoquic_test_tls_api_ctx_t* test_ctx = NULL;\n379\t        uint64_t initial_losses = random_context & 0xFFFFFFFF86ull;\n380\t        uint8_t test_case_id = 0xcf;\n381\t        int ret = 0;\n382\t\n383\t        (void)picoquic_test_random(&random_context);\n384\t\n385\t        ret = edge_case_prepare(&test_ctx, test_case_id, 0, &simulated_time, initial_losses, 40);\n386\t\n387\t        if (ret == 0) {\n388\t            ret = edge_case_complete(test_ctx, &simulated_time, 15000000);\n389\t        }\n390\t\n391\t        if (ret != 0 && F != NULL) {\n392\t            fprintf(F, \"0x%\" PRIx64 \", %\" PRIu64 \", %d, %\" PRIu64 \"\\n\",\n393\t                initial_losses, initial_losses, ret, simulated_time);\n394\t        }\n395\t\n396\t        if (test_ctx != NULL) {\n397\t            tls_api_delete_ctx(test_ctx);\n398\t            test_ctx = NULL;\n399\t        }\n400\t    }\n401\t}\n402\t\n403\tint eccf_corrupted_file_fuzz_test(void)\n404\t{\n405\t    int ret = 0;\n406\t    FILE* F = picoquic_file_open(\"ECCF_Fuzz_report.csv\", \"w\");\n407\t    if (F == NULL) {\n408\t        ret = -1;\n409\t    }\n410\t    else {\n411\t        (void)fprintf(F, \"Seed_hex, Seed, Ret, Elapsed\\n\");\n412\t        eccf_corrupted_file_fuzz(50, 0, F);\n413\t        picoquic_file_close(F);\n414\t    }\n415\t    return ret;\n416\t}\n417\t\n418\t/* Amplification test using large \n419\t * server hello with losses.\n420\t */\n421\tint eca1_amplification_loss_test(void)\n422\t{\n423\t    uint64_t simulated_time = 0;\n424\t    picoquic_test_tls_api_ctx_t* test_ctx = NULL;\n425\t    uint64_t initial_losses = 0x0FF4;\n426\t    uint8_t test_case_id = 0xa1;\n427\t    int ret = edge_case_prepare(&test_ctx, test_case_id, 0, &simulated_time, initial_losses, 16);\n428\t\n429\t    if (ret == 0) {\n430\t        ret = edge_case_complete(test_ctx, &simulated_time, 15000000);\n431\t    }\n432\t\n433\t    if (test_ctx != NULL) {\n434\t        tls_api_delete_ctx(test_ctx);\n435\t        test_ctx = NULL;\n436\t    }\n437\t\n438\t    return ret;\n439\t}\n440\t\n441\t/* Loss of final closing packet, verify that overall time\n442\t * is acceptable.\n443\t */\n444\t\n445\tint ecf1_final_loss_test(void)\n446\t{\n447\t    uint64_t simulated_time = 0;\n448\t    picoquic_test_tls_api_ctx_t* test_ctx = NULL;\n449\t    uint64_t final_losses = 0xb10;\n450\t    uint8_t test_case_id = 0xf1;\n451\t    int ret = edge_case_prepare(&test_ctx, test_case_id, 0, &simulated_time, 0, 20);\n452\t    uint64_t zero_loss_mask = 0;\n453\t\n454\t    /* Finish the connection */\n455\t    if (ret == 0) {\n456\t        ret = tls_api_connection_loop(test_ctx, &zero_loss_mask, 0, &simulated_time);\n457\t        if (ret != 0)\n458\t        {\n459\t            DBG_PRINTF(\"Connect loop returns %d\\n\", ret);\n460\t        }\n461\t    }\n462\t    /* Finish sending data */\n463\t    test_ctx->immediate_exit = 1;\n464\t\n465\t    if (ret == 0) {\n466\t        ret = tls_api_data_sending_loop(test_ctx, &zero_loss_mask, &simulated_time, 0);\n467\t\n468\t        if (ret != 0)\n469\t        {\n470\t            DBG_PRINTF(\"Data sending loop returns %d\\n\", ret);\n471\t        }\n472\t    }\n473\t    /* Simulate losses during closing */\n474\t    if (ret == 0) {\n475\t        ret = tls_api_close_with_losses(test_ctx, &simulated_time, final_losses);\n476\t    }\n477\t\n478\t    if (ret == 0 && simulated_time > 10000000) {\n479\t        DBG_PRINTF(\"Took %\" PRIu64 \"us to complete, too long\", simulated_time);\n480\t        ret = -1;\n481\t    }\n482\t\n483\t    if (test_ctx != NULL) {\n484\t        tls_api_delete_ctx(test_ctx);\n485\t        test_ctx = NULL;\n486\t    }\n487\t\n488\t    return ret;\n489\t}\n490\t\n491\t/* Some traces show the CID packet from the server being dropped,\n492\t * then repeated a couple time, with one success but a drop\n493\t * of the clien't ack, and the server then sending a bogus repeat.\n494\t */\n495\t\n496\tint ec5c_silly_cid_test(void)\n497\t{\n498\t    uint64_t simulated_time = 0;\n499\t    picoquic_test_tls_api_ctx_t* test_ctx = NULL;\n500\t    uint64_t initial_losses = 0x01e084;\n501\t    uint8_t test_case_id = 0x5c;\n502\t    int ret = edge_case_prepare(&test_ctx, test_case_id, 0, &simulated_time, initial_losses, 48);\n503\t\n504\t    if (ret == 0) {\n505\t        if (test_ctx->cnx_server == NULL) {\n506\t            DBG_PRINTF(\"Unexpected state, client: %d, server: NULL\",\n507\t                test_ctx->cnx_client->cnx_state);\n508\t\n509\t        } else if (test_ctx->cnx_client->cnx_state != picoquic_state_ready ||\n510\t            test_ctx->cnx_server->cnx_state != picoquic_state_ready) {\n511\t            DBG_PRINTF(\"Unexpected state, client: %d, server: %d\",\n512\t                test_ctx->cnx_client->cnx_state, test_ctx->cnx_server->cnx_state);\n513\t            ret = -1;\n514\t        }\n515\t    }\n516\t\n517\t    if (ret == 0) {\n518\t        ret = edge_case_complete(test_ctx, &simulated_time, 3000000);\n519\t    }\n520\t\n521\t    if (test_ctx != NULL) {\n522\t        tls_api_delete_ctx(test_ctx);\n523\t        test_ctx = NULL;\n524\t    }\n525\t\n526\t    return ret;\n527\t}\n528\t\n529\t/* Some traces show that if a connection close from the client is dropped and\n530\t * then the client goes away, the server can produce a vast number of\n531\t * preemptive repeats before giving up. Repro, then verify.\n532\t */\n533\t\n534\tint ec9a_preemptive_amok_test(void)\n535\t{\n536\t    uint64_t simulated_time = 0;\n537\t    picoquic_test_tls_api_ctx_t* test_ctx = NULL;\n538\t    uint64_t initial_losses = 0x800;\n539\t    uint8_t test_case_id = 0x9a;\n540\t    uint64_t cnx_server_idle_timeout = 0;\n541\t    uint64_t cnx_server_nb_preemptive_repeat = 0;\n542\t    int ret = edge_case_prepare(&test_ctx, test_case_id, 0, &simulated_time, initial_losses, 12);\n543\t\n544\t    if (ret == 0) {\n545\t        if (test_ctx->cnx_server == NULL) {\n546\t            DBG_PRINTF(\"Unexpected state, client: %d, server: NULL\",\n547\t                test_ctx->cnx_client->cnx_state);\n548\t            ret = -1;\n549\t        }\n550\t        else if ( test_ctx->cnx_server->cnx_state != picoquic_state_ready ||\n551\t            !test_ctx->test_finished || \n552\t            test_ctx->cnx_server->pkt_ctx[picoquic_packet_context_application].pending_first == NULL){\n553\t            DBG_PRINTF(\"Unexpected state, server: %d, test finished: %d, queue for repeat %s\",\n554\t                test_ctx->cnx_server->cnx_state, test_ctx->test_finished, \n555\t                (test_ctx->cnx_server->pkt_ctx[picoquic_packet_context_application].pending_first == NULL)?\"empty\":\"full\");\n556\t            ret = -1;\n557\t        }\n558\t    }\n559\t    /* Do a loop involving only the server */\n560\t    if (ret == 0) {\n561\t        uint8_t buffer[PICOQUIC_MAX_PACKET_SIZE];\n562\t        size_t send_length;\n563\t        size_t send_msg_size;\n564\t        struct sockaddr_storage addr_to;\n565\t        struct sockaddr_storage addr_from;\n566\t        int if_index;\n567\t        picoquic_connection_id_t log_id;\n568\t        picoquic_cnx_t * last_cnx;\n569\t        int loop_count = 0;\n570\t        int send_count = 0;\n571\t        const int send_count_max = 50;\n572\t        uint64_t repeat_begin = simulated_time;\n573\t        uint64_t repeat_duration = 0;\n574\t\n575\t        cnx_server_idle_timeout = test_ctx->cnx_server->idle_timeout;\n576\t        cnx_server_nb_preemptive_repeat = test_ctx->cnx_server->nb_preemptive_repeat;\n577\t\n578\t        picoquic_reinsert_by_wake_time(test_ctx->qserver, test_ctx->cnx_server, simulated_time);\n579\t\n580\t        while (test_ctx->qserver->current_number_connections > 0 && test_ctx->cnx_server->cnx_state == picoquic_state_ready && loop_count < 10000 && ret == 0) {\n581\t            loop_count++;\n582\t            cnx_server_nb_preemptive_repeat = test_ctx->cnx_server->nb_preemptive_repeat;\n583\t            simulated_time = picoquic_get_next_wake_time(test_ctx->qserver, simulated_time);\n584\t            ret = picoquic_prepare_next_packet_ex(test_ctx->qserver, simulated_time, buffer,\n585\t                sizeof(buffer), &send_length, &addr_to, &addr_from, &if_index, &log_id,\n586\t                &last_cnx, &send_msg_size);\n587\t            if (ret != 0) {\n588\t                DBG_PRINTF(\"Prepare next returns an error: %d (0x%x)\", ret, ret);\n589\t            }\n590\t            else if (send_length > 0) {\n591\t                send_count++;\n592\t            }\n593\t        }\n594\t\n595\t        if (ret == 0) {\n596\t            repeat_duration = simulated_time - repeat_begin;\n597\t            if (send_count > send_count_max) {\n598\t                DBG_PRINTF(\"Repeated %d packets, more that the %d expected\",\n599\t                    send_count, send_count_max);"}]},"parent_tool_use_id":null,"session_id":"17072f18-9969-498e-bec6-45838e44ca80","uuid":"c8333542-8601-48b4-8dac-5a43d4e5f7a4","timestamp":"2026-05-05T03:12:29.103Z","tool_use_result":{"type":"text","file":{"filePath":"/Users/richbarn/Projects/picoquic/picoquictest/edge_cases.c","content":"    uint64_t simulated_time = 0;\n    picoquic_test_tls_api_ctx_t* test_ctx = NULL;\n    int ret = edge_case_prepare(&test_ctx, 0, 1, &simulated_time, 0, 4);\n\n    if (ret == 0) {\n        ret = edge_case_complete(test_ctx, &simulated_time, 100000);\n    }\n\n    if (ret == 0) {\n        if (test_ctx->cnx_client->nb_zero_rtt_acked == 0) {\n            DBG_PRINTF(\"Nb 0RTT acked = %d\", test_ctx->cnx_client->nb_zero_rtt_acked);\n            ret = -1;\n        }\n    }\n\n    if (test_ctx != NULL) {\n        tls_api_delete_ctx(test_ctx);\n        test_ctx = NULL;\n    }\n\n    return ret;\n}\n\n/* Reproduce and fix a specific error:\n * - 0RTT packet was lost\n * - Client second flight arrives at peer, but handshake ACK is lost\n * - Handshake Done is lost\n * Client appears stuck repeating second flight, intead of trying to\n * make progress and send data.\n * \n * This is unlocked by enabling retransmission of data in \"client almost ready\"\n * state. \n */\n\nint ec2f_second_flight_nack_test(void)\n{\n    uint64_t simulated_time = 0;\n    picoquic_test_tls_api_ctx_t* test_ctx = NULL;\n    uint64_t initial_losses = 0x1c1;\n    uint8_t test_case_id = 0x2f;\n    int ret = edge_case_prepare(&test_ctx, test_case_id, 1, &simulated_time, initial_losses, 9);\n\n    if (ret == 0) {\n        if (test_ctx->cnx_client->cnx_state >= picoquic_state_ready ||\n            test_ctx->cnx_server->cnx_state != picoquic_state_ready) {\n            DBG_PRINTF(\"Unexpected state, client: %d, server: %d\",\n                test_ctx->cnx_client->cnx_state, test_ctx->cnx_server->cnx_state);\n            ret = -1;\n        }\n    }\n\n    if (ret == 0) {\n        ret = edge_case_complete(test_ctx, &simulated_time, 360000);\n    }\n\n    if (test_ctx != NULL) {\n        tls_api_delete_ctx(test_ctx);\n        test_ctx = NULL;\n    }\n\n    return ret;\n}\n\n/* Try reproduce a corrupt file transmission occuring\n * during a lossy handshake. At some point, the server\n * sent random content instead of repeating the original packet\n * content. Attempts to just reproduce the sequence in\n * the interop runner failed, so instead we add a specialized\n * fuzzer. Running that fuzzer in ASAN/UBSAN builds might\n * detect the corruption some day.\n */\n\nvoid eccf_corrupted_file_fuzz(int nb_trials, uint64_t seed, FILE* F)\n{\n    uint64_t random_context = (seed == 0)?0x1234567887654321ull:seed;\n\n    for (int i = 0; i < nb_trials; i++) {\n        uint64_t simulated_time = 0;\n        picoquic_test_tls_api_ctx_t* test_ctx = NULL;\n        uint64_t initial_losses = random_context & 0xFFFFFFFF86ull;\n        uint8_t test_case_id = 0xcf;\n        int ret = 0;\n\n        (void)picoquic_test_random(&random_context);\n\n        ret = edge_case_prepare(&test_ctx, test_case_id, 0, &simulated_time, initial_losses, 40);\n\n        if (ret == 0) {\n            ret = edge_case_complete(test_ctx, &simulated_time, 15000000);\n        }\n\n        if (ret != 0 && F != NULL) {\n            fprintf(F, \"0x%\" PRIx64 \", %\" PRIu64 \", %d, %\" PRIu64 \"\\n\",\n                initial_losses, initial_losses, ret, simulated_time);\n        }\n\n        if (test_ctx != NULL) {\n            tls_api_delete_ctx(test_ctx);\n            test_ctx = NULL;\n        }\n    }\n}\n\nint eccf_corrupted_file_fuzz_test(void)\n{\n    int ret = 0;\n    FILE* F = picoquic_file_open(\"ECCF_Fuzz_report.csv\", \"w\");\n    if (F == NULL) {\n        ret = -1;\n    }\n    else {\n        (void)fprintf(F, \"Seed_hex, Seed, Ret, Elapsed\\n\");\n        eccf_corrupted_file_fuzz(50, 0, F);\n        picoquic_file_close(F);\n    }\n    return ret;\n}\n\n/* Amplification test using large \n * server hello with losses.\n */\nint eca1_amplification_loss_test(void)\n{\n    uint64_t simulated_time = 0;\n    picoquic_test_tls_api_ctx_t* test_ctx = NULL;\n    uint64_t initial_losses = 0x0FF4;\n    uint8_t test_case_id = 0xa1;\n    int ret = edge_case_prepare(&test_ctx, test_case_id, 0, &simulated_time, initial_losses, 16);\n\n    if (ret == 0) {\n        ret = edge_case_complete(test_ctx, &simulated_time, 15000000);\n    }\n\n    if (test_ctx != NULL) {\n        tls_api_delete_ctx(test_ctx);\n        test_ctx = NULL;\n    }\n\n    return ret;\n}\n\n/* Loss of final closing packet, verify that overall time\n * is acceptable.\n */\n\nint ecf1_final_loss_test(void)\n{\n    uint64_t simulated_time = 0;\n    picoquic_test_tls_api_ctx_t* test_ctx = NULL;\n    uint64_t final_losses = 0xb10;\n    uint8_t test_case_id = 0xf1;\n    int ret = edge_case_prepare(&test_ctx, test_case_id, 0, &simulated_time, 0, 20);\n    uint64_t zero_loss_mask = 0;\n\n    /* Finish the connection */\n    if (ret == 0) {\n        ret = tls_api_connection_loop(test_ctx, &zero_loss_mask, 0, &simulated_time);\n        if (ret != 0)\n        {\n            DBG_PRINTF(\"Connect loop returns %d\\n\", ret);\n        }\n    }\n    /* Finish sending data */\n    test_ctx->immediate_exit = 1;\n\n    if (ret == 0) {\n        ret = tls_api_data_sending_loop(test_ctx, &zero_loss_mask, &simulated_time, 0);\n\n        if (ret != 0)\n        {\n            DBG_PRINTF(\"Data sending loop returns %d\\n\", ret);\n        }\n    }\n    /* Simulate losses during closing */\n    if (ret == 0) {\n        ret = tls_api_close_with_losses(test_ctx, &simulated_time, final_losses);\n    }\n\n    if (ret == 0 && simulated_time > 10000000) {\n        DBG_PRINTF(\"Took %\" PRIu64 \"us to complete, too long\", simulated_time);\n        ret = -1;\n    }\n\n    if (test_ctx != NULL) {\n        tls_api_delete_ctx(test_ctx);\n        test_ctx = NULL;\n    }\n\n    return ret;\n}\n\n/* Some traces show the CID packet from the server being dropped,\n * then repeated a couple time, with one success but a drop\n * of the clien't ack, and the server then sending a bogus repeat.\n */\n\nint ec5c_silly_cid_test(void)\n{\n 