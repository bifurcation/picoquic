 ConnectionId {\n1707\t        todo!()\n1708\t    }\n1709\t\n1710\t    /// Client-side initial connection ID (mirrors C\n1711\t    /// `get_client_connection_id`).\n1712\t    pub fn client_connection_id(&self) -> ConnectionId {\n1713\t        todo!()\n1714\t    }\n1715\t\n1716\t    /// Server-side initial connection ID (mirrors C\n1717\t    /// `get_server_connection_id`).\n1718\t    pub fn server_connection_id(&self) -> ConnectionId {\n1719\t        todo!()\n1720\t    }\n1721\t\n1722\t    /// Connection ID used for log entries on this connection.\n1723\t    pub fn logging_connection_id(&self) -> ConnectionId {\n1724\t        todo!()\n1725\t    }\n1726\t\n1727\t    /// Wall-clock start time of this connection.\n1728\t    pub fn start_time(&self) -> u64 {\n1729\t        todo!()\n1730\t    }\n1731\t\n1732\t    /// Whether 0-RTT data may be sent on this connection.\n1733\t    pub fn is_0rtt_available(&self) -> bool {\n1734\t        todo!()\n1735\t    }\n1736\t\n1737\t    /// Whether the connection has any outstanding data still queued\n1738\t    /// for transmission.\n1739\t    pub fn is_backlog_empty(&self) -> bool {\n1740\t        todo!()\n1741\t    }\n1742\t\n1743\t    /// Install a per-connection stream/event callback (the\n1744\t    /// `callback_fn` + `callback_ctx` pair from C collapse to a\n1745\t    /// single trait object).  See [`Quic::set_default_callback`].\n1746\t    pub fn set_callback(&mut self, _callback: Option<Box<dyn StreamDataCallback>>) {\n1747\t        todo!()\n1748\t    }\n1749\t\n1750\t    /// Borrow this connection's callback (`None` when none was\n1751\t    /// installed).\n1752\t    pub fn callback(&self) -> Option<&dyn StreamDataCallback> {\n1753\t        todo!()\n1754\t    }\n1755\t\n1756\t    /// Queue a connection-level frame for transmission.\n1757\t    pub fn queue_misc_frame(\n1758\t        &mut self,\n1759\t        _bytes: &[u8],\n1760\t        _is_pure_ack: bool,\n1761\t        _pc: PacketContext,\n1762\t    ) -> Result<(), Error> {\n1763\t        todo!()\n1764\t    }\n1765\t\n1766\t    /// Queue a datagram frame for transmission.\n1767\t    pub fn queue_datagram_frame(&mut self, _bytes: &[u8]) -> Result<(), Error> {\n1768\t        todo!()\n1769\t    }\n1770\t}\n1771\t\n1772\timpl Quic {\n1773\t    /// Borrow the first connection registered with this context.\n1774\t    pub fn first_connection(&mut self) -> Option<&mut Connection> {\n1775\t        todo!()\n1776\t    }\n1777\t\n1778\t    /// Compute the number of microseconds until *any* connection on\n1779\t    /// this context next needs attention, capped at `delay_max`.\n1780\t    pub fn next_wake_delay(&self, _current_time: Instant, _delay_max: i64) -> i64 {\n1781\t        todo!()\n1782\t    }\n1783\t\n1784\t    /// Wall-clock time at which the next event is scheduled.\n1785\t    pub fn next_wake_time(&self, _current_time: Instant) -> u64 {\n1786\t        todo!()\n1787\t    }\n1788\t\n1789\t    /// Borrow the connection currently advancing through its state\n1790\t    /// machine, if any (`get_cnx_in_progress` in C).\n1791\t    pub fn connection_in_progress(&mut self) -> Option<&mut Connection> {\n1792\t        todo!()\n1793\t    }\n1794\t\n1795\t    /// Default PMTUD policy applied to new connections.\n1796\t    pub fn set_default_pmtud_policy(&mut self, _pmtud_policy: PmtudPolicy) {\n1797\t        todo!()\n1798\t    }\n1799\t\n1800\t    /// Borrow the default stream callback installed on this context.\n1801\t    pub fn default_callback(&self) -> Option<&dyn StreamDataCallback> {\n1802\t        todo!()\n1803\t    }\n1804\t}\n1805\t\n1806\t// ---------------------------------------------------------------------------\n1807\t// Packet I/O.\n1808\t\n1809\timpl Quic {\n1810\t    /// Submit a received packet to the QUIC context for dispatch.\n1811\t    /// `addr_from` and `addr_to` are borrowed for the duration of\n1812\t    /// the call; `received_ecn` carries the IP-level ECN code-point\n1813\t    /// byte.\n1814\t    #[allow(clippy::too_many_arguments)]\n1815\t    pub fn incoming_packet(\n1816\t        &mut self,\n1817\t        _bytes: &mut [u8],\n1818\t        _addr_from: &SocketAddr,\n1819\t        _addr_to: &SocketAddr,\n1820\t        _if_index_to: i32,\n1821\t        _received_ecn: u8,\n1822\t        _current_time: Instant,\n1823\t    ) -> Result<(), Error> {\n1824\t        todo!()\n1825\t    }\n1826\t\n1827\t    /// Same as [`Self::incoming_packet`] but additionally identifies\n1828\t    /// the connection that consumed the packet.\n1829\t    #[allow(clippy::too_many_arguments)]\n1830\t    pub fn incoming_packet_ex(\n1831\t        &mut self,\n1832\t        _bytes: &mut [u8],\n1833\t        _addr_from: &SocketAddr,\n1834\t        _addr_to: &SocketAddr,\n1835\t        _if_index_to: i32,\n1836\t        _received_ecn: u8,\n1837\t        _current_time: Instant,\n1838\t    ) -> Result<Option<&mut Connection>, Error> {\n1839\t        todo!()\n1840\t    }\n1841\t}\n1842\t\n1843\t/// Result of preparing a packet for transmission.  Folds the C\n1844\t/// out-parameter pile (`send_length`, `p_addr_to`, `p_addr_from`,\n1845\t/// `if_index`, `log_cid`, `send_msg_size`) into a single struct.\n1846\t#[derive(Debug)]\n1847\tpub struct PreparedPacket<'a> {\n1848\t    /// Number of bytes written into `send_buffer`.\n1849\t    pub send_length: usize,\n1850\t    /// Destination address.\n1851\t    pub addr_to: SocketAddr,\n1852\t    /// Source address.\n1853\t    pub addr_from: SocketAddr,\n1854\t    pub if_index: i32,\n1855\t    /// Connection ID that should be logged for this packet.\n1856\t    pub log_cid: ConnectionId,\n1857\t    /// Connection that produced the packet (the C\n1858\t    /// `p_last_connection`).  `None` when the QUIC context had no work to\n1859\t    /// do.\n1860\t    pub last_connection: Option<&'a mut Connection>,\n1861\t    /// Optional GSO segment size when the packet is a coalesced\n1862\t    /// train; `None` for a single-packet send.\n1863\t    pub send_msg_size: Option<usize>,\n1864\t}\n1865\t\n1866\timpl Quic {\n1867\t    /// Drive the next packet onto the wire.  Folds the seven\n1868\t    /// out-parameters of the C signature into a [`PreparedPacket`].\n1869\t    pub fn prepare_next_packet_ex(\n1870\t        &mut self,\n1871\t        _current_time: Instant,\n1872\t        _send_buffer: &mut [u8],\n1873\t    ) -> Result<PreparedPacket<'_>, Error> {\n1874\t        todo!()\n1875\t    }\n1876\t\n1877\t    /// Same shape as [`Self::prepare_next_packet_ex`] but without\n1878\t    /// GSO segment reporting.\n1879\t    pub fn prepare_next_packet(\n1880\t        &mut self,\n1881\t        _current_time: Instant,\n1882\t        _send_buffer: &mut [u8],\n1883\t    ) -> Result<PreparedPacket<'_>, Error> {\n1884\t        todo!()\n1885\t    }\n1886\t}\n1887\t\n1888\t/// Result of preparing a single connection's packet.  Subset of\n1889\t/// [`PreparedPacket`] that drops the cross-connection fields.\n1890\t#[derive(Debug)]\n1891\tpub struct PreparedCnxPacket {\n1892\t    pub send_length: usize,\n1893\t    pub addr_to: SocketAddr,\n1894\t    pub addr_from: SocketAddr,\n1895\t    pub if_index: i32,\n1896\t    pub send_msg_size: Option<usize>,\n1897\t}\n1898\t\n1899\timpl Connection {\n1900\t    /// Prepare the next packet on this connection (the `_ex`\n1901\t    /// flavour reports GSO segment size when the packet is a\n1902\t    /// coalesced train).\n1903\t    pub fn prepare_packet_ex(\n1904\t        &mut self,\n1905\t        _current_time: Instant,\n1906\t        _send_buffer: &mut [u8],\n1907\t    ) -> Result<PreparedCnxPacket, Error> {\n1908\t        todo!()\n1909\t    }\n1910\t\n1911\t    /// Same shape as [`Self::prepare_packet_ex`] without\n1912\t    /// GSO-segment reporting.\n1913\t    pub fn prepare_packet(\n1914\t        &mut self,\n1915\t        _current_time: Instant,\n1916\t        _send_buffer: &mut [u8],\n1917\t    ) -> Result<PreparedCnxPacket, Error> {\n1918\t        todo!()\n1919\t    }\n1920\t\n1921\t    /// Notify this connection that a destination became\n1922\t    /// unreachable.\n1923\t    pub fn notify_destination_unreachable(\n1924\t        &mut self,\n1925\t        _current_time: Instant,\n1926\t        _addr_peer: &SocketAddr,\n1927\t        _addr_local: &SocketAddr,\n1928\t        _if_index: i32,\n1929\t        _socket_err: i32,\n1930\t    ) {\n1931\t        todo!()\n1932\t    }\n1933\t}\n1934\t\n1935\timpl Quic {\n1936\t    /// Notify the connection identified by `connection_id` that a\n1937\t    /// destination became unreachable.\n1938\t    #[allow(clippy::too_many_arguments)]\n1939\t    pub fn notify_destination_unreachable_by_connection_id(\n1940\t        &mut self,\n1941\t        _connection_id: &ConnectionId,\n1942\t        _current_time: Instant,\n1943\t        _addr_peer: &SocketAddr,\n1944\t        _addr_local: &SocketAddr,\n1945\t        _if_index: i32,\n1946\t        _socket_err: i32,\n1947\t    ) {\n1948\t        todo!()\n1949\t    }\n1950\t}\n1951\t\n1952\t// ---------------------------------------------------------------------------\n1953\t// Streams.\n1954\t\n1955\timpl Connection {\n1956\t    /// Mark a stream as direct-receive: the stack hands incoming\n1957\t    /// stream payload straight to `direct_receive` instead of\n1958\t    /// queueing it for the application's regular callback.\n1959\t    pub fn mark_direct_receive_stream(\n1960\t        &mut self,\n1961\t        _stream_id: u64,\n1962\t        _direct_receive: Box<dyn StreamDirectReceive>,\n1963\t    ) -> Result<(), Error> {\n1964\t        todo!()\n1965\t    }\n1966\t\n1967\t    /// Attach opaque application data to a stream.\n1968\t    pub fn set_app_stream_ctx(\n1969\t        &mut self,\n1970\t        _stream_id: u64,\n1971\t        _app_stream_ctx: Option<Box<dyn core::any::Any>>,\n1972\t    ) -> Result<(), Error> {\n1973\t        todo!()\n1974\t    }\n1975\t\n1976\t    /// Detach the application data attached by\n1977\t    /// [`Self::set_app_stream_ctx`].\n1978\t    pub fn unlink_app_stream_ctx(&mut self, _stream_id: u64) {\n1979\t        todo!()\n1980\t    }\n1981\t\n1982\t    /// Toggle whether the stack should poll the application for\n1983\t    /// more data on this stream.\n1984\t    pub fn mark_active_stream(\n1985\t        &mut self,\n1986\t        _stream_id: u64,\n1987\t        _is_active: bool,\n1988\t        _v_stream_ctx: Option<Box<dyn core::any::Any>>,\n1989\t    ) -> Result<(), Error> {\n1990\t        todo!()\n1991\t    }\n1992\t\n1993\t    /// Toggle whether this stream is excluded from coalesced packet\n1994\t    /// trains.\n1995\t    pub fn set_stream_not_coalesced(\n1996\t        &mut self,\n1997\t        _stream_id: u64,\n1998\t        _is_not_coalesced: bool,\n1999\t    ) -> Result<(), Error> {\n2000\t        todo!()\n2001\t    }\n2002\t\n2003\t    /// Set per-stream priority (smaller is higher).\n2004\t    pub fn set_stream_priority(\n2005\t        &mut self,\n2006\t        _stream_id: u64,\n2007\t        _stream_priority: u8,\n2008\t    ) -> Result<(), Error> {\n2009\t        todo!()\n2010\t    }\n2011\t\n2012\t    /// Mark a stream as high-priority (skip ahead of normal\n2013\t    /// streams).\n2014\t    pub fn mark_high_priority_stream(\n2015\t        &mut self,\n2016\t        _stream_id: u64,\n2017\t        _is_high_priority: bool,\n2018\t    ) -> Result<(), Error> {\n2019\t        todo!()\n2020\t    }\n2021\t\n2022\t    /// Override the priority used for outbound datagrams on this\n2023\t    /// connection.\n2024\t    pub fn set_datagram_priority(&mut self, _datagram_priority: u8) {\n2025\t        todo!()\n2026\t    }\n2027\t}\n2028\t\n2029\timpl Quic {\n2030\t    /// Default per-stream priority applied to new streams.\n2031\t    pub fn set_default_priority(&mut self, _default_stream_priority: u8) {\n2032\t        todo!()\n2033\t    }\n2034\t\n2035\t    /// Default datagram priority applied to new connections.\n2036\t    pub fn set_default_datagram_priority(&mut self, _default_datagram_priority: u8) {\n2037\t        todo!()\n2038\t    }\n2039\t}\n2040\t\n2041\t/// C: `provide_stream_data_buffer`.  `context` is the\n2042\t/// `context` is the stack-supplied handle the application receives\n2043\t/// in the `callback_prepare_to_send` callback (a wrapper around\n2044\t/// the internal `StreamDataBufferArgument`).  Returns the\n2045\t/// borrowed buffer the application should fill, or `None` on\n2046\t/// error.  Lifetime ties the returned slice to `context` so the\n2047\t/// borrow ends with the callback.\n2048\tpub fn provide_stream_data_buffer<'a>(\n2049\t    _context: &'a mut crate::internal::StreamDataBufferArgument<'a>,\n2050\t    _nb_bytes: usize,\n2051\t    _is_fin: bool,\n2052\t    _is_still_active: bool,\n2053\t) -> Option<&'a mut [u8]> {\n2054\t    todo!()\n2055\t}\n2056\t\n2057\timpl Connection {\n2058\t    /// Append `data` to a stream's send buffer (`set_fin` closes the\n2059\t    /// stream when the data is fully delivered).\n2060\t    pub fn add_to_stream(\n2061\t        &mut self,\n2062\t        _stream_id: u64,\n2063\t        _data: &[u8],\n2064\t        _set_fin: bool,\n2065\t    ) -> Result<(), Error> {\n2066\t        todo!()\n2067\t    }\n2068\t\n2069\t    /// Reset just the per-stream application context.\n2070\t    pub fn reset_stream_ctx(&mut self, _stream_id: u64) {\n2071\t        todo!()\n2072\t    }\n2073\t\n2074\t    /// Same as [`Self::add_to_stream`] but also installs an\n2075\t    /// application-supplied stream context for callbacks.\n2076\t    pub fn add_to_stream_with_ctx(\n2077\t        &mut self,\n2078\t        _stream_id: u64,\n2079\t        _data: &[u8],\n2080\t        _set_fin: bool,\n2081\t        _app_stream_ctx: Option<Box<dyn core::any::Any>>,\n2082\t    ) -> Result<(), Error> {\n2083\t        todo!()\n2084\t    }\n2085\t\n2086\t    /// Send a STREAM_RESET frame for this stream.\n2087\t    pub fn reset_stream(&mut self, _stream_id: u64, _local_stream_error: u64) -> Result<(), Error> {\n2088\t        todo!()\n2089\t    }\n2090\t\n2091\t    /// Send a STREAM_RESET_AT frame (per the reliable-stream-reset\n2092\t    /// draft) for this stream.\n2093\t    pub fn reset_stream_at(\n2094\t        &mut self,\n2095\t        _stream_id: u64,\n2096\t        _local_stream_error: u64,\n2097\t        _reliable_size: u64,\n2098\t    ) -> Result<(), Error> {\n2099\t        todo!()\n2100\t    }\n2101\t\n2102\t    /// Open the flow-control window for an inbound stream up to the\n2103\t    /// expected payload size.\n2104\t    pub fn open_flow_control(\n2105\t        &mut self,\n2106\t        _stream_id: u64,\n2107\t        _expected_data_size: u64,\n2108\t    ) -> Result<(), Error> {\n2109\t        todo!()\n2110\t    }\n2111\t\n2112\t    /// Toggle application-managed flow control on a stream.\n2113\t    pub fn set_app_flow_control(\n2114\t        &mut self,\n2115\t        _stream_id: u64,\n2116\t        _use_app_flow_control: bool,\n2117\t    ) -> Result<(), Error> {\n2118\t        todo!()\n2119\t    }\n2120\t\n2121\t    /// Allocate the next locally-initiated stream ID.\n2122\t    pub fn next_local_stream_id(&mut self, _is_unidir: bool) -> u64 {\n2123\t        todo!()\n2124\t    }\n2125\t\n2126\t    /// Send a STOP_SENDING frame for this stream.\n2127\t    pub fn stop_sending(&mut self, _stream_id: u64, _local_stream_error: u64) -> Result<(), Error> {\n2128\t        todo!()\n2129\t    }\n2130\t\n2131\t    /// Drop a stream from local bookkeeping (rejecting further peer\n2132\t    /// frames).\n2133\t    pub fn discard_stream(\n2134\t        &mut self,\n2135\t        _stream_id: u64,\n2136\t        _local_stream_error: u16,\n2137\t    ) -> Result<(), Error> {\n2138\t        todo!()\n2139\t    }\n2140\t\n2141\t    /// Toggle datagram readiness for this connection.\n2142\t    pub fn mark_datagram_ready(&mut self, _is_ready: bool) -> Result<(), Error> {\n2143\t        todo!()\n2144\t    }\n2145\t\n2146\t    /// Per-path datagram readiness (multipath connections).\n2147\t    pub fn mark_datagram_ready_path(\n2148\t        &mut self,\n2149\t        _