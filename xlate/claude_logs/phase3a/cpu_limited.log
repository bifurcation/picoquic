{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01RM6ShNbkdZauGaecruUB19","type":"tool_result","content":"1\t/*\n2\t* Author: Christian Huitema\n3\t* Copyright (c) 2023, Private Octopus, Inc.\n4\t* All rights reserved.\n5\t*\n6\t* Permission to use, copy, modify, and distribute this software for any\n7\t* purpose with or without fee is hereby granted, provided that the above\n8\t* copyright notice and this permission notice appear in all copies.\n9\t*\n10\t* THIS SOFTWARE IS PROVIDED BY THE COPYRIGHT HOLDERS AND CONTRIBUTORS \"AS IS\" AND\n11\t* ANY EXPRESS OR IMPLIED WARRANTIES, INCLUDING, BUT NOT LIMITED TO, THE IMPLIED\n12\t* WARRANTIES OF MERCHANTABILITY AND FITNESS FOR A PARTICULAR PURPOSE ARE\n13\t* DISCLAIMED. IN NO EVENT SHALL Private Octopus, Inc. BE LIABLE FOR ANY\n14\t* DIRECT, INDIRECT, INCIDENTAL, SPECIAL, EXEMPLARY, OR CONSEQUENTIAL DAMAGES\n15\t* (INCLUDING, BUT NOT LIMITED TO, PROCUREMENT OF SUBSTITUTE GOODS OR SERVICES;\n16\t* LOSS OF USE, DATA, OR PROFITS; OR BUSINESS INTERRUPTION) HOWEVER CAUSED AND\n17\t* ON ANY THEORY OF LIABILITY, WHETHER IN CONTRACT, STRICT LIABILITY, OR TORT\n18\t* (INCLUDING NEGLIGENCE OR OTHERWISE) ARISING IN ANY WAY OUT OF THE USE OF THIS\n19\t* SOFTWARE, EVEN IF ADVISED OF THE POSSIBILITY OF SUCH DAMAGE.\n20\t*/\n21\t\n22\t#include <stdlib.h>\n23\t#include <string.h>\n24\t#include <inttypes.h>\n25\t#include \"picoquic.h\"\n26\t#include \"picoquic_internal.h\"\n27\t#include \"picoquictest_internal.h\"\n28\t#include \"tls_api.h\"\n29\t#include \"autoqlog.h\"\n30\t#include \"logreader.h\"\n31\t#include \"qlog.h\"\n32\t\n33\t#include \"picoquic_newreno.h\"\n34\t#include \"picoquic_cubic.h\"\n35\t#include \"picoquic_bbr.h\"\n36\t#include \"picoquic_bbr1.h\"\n37\t#include \"picoquic_fastcc.h\"\n38\t#include \"picoquic_prague.h\"\n39\t\n40\t\n41\t/* Add a series of tests to study the behavior of cpu-limited clients.\n42\t* This requires simulating clients that have cpu limitations, such\n43\t* as only being able to proceed a set number of messages per second.\n44\t* \n45\t* The main effort is to modify the simulator to keep track of the\n46\t* \"software load\" of a node. The simulator interacts with the code\n47\t* through two APIs: prepare a packet to send; and, receive a packet.\n48\t* We assume that each of these calls will take some time, because\n49\t* it includes CPU processing. The simulation needs to maintain a\n50\t* \"node readiness\" clock, so that the node only becomes available\n51\t* some time after performing an action. Then, we do the following:\n52\t* \n53\t* - On the \"prepare packet\" side, only consider the client ready\n54\t*   if time is large than the next ready time and also larger\n55\t*   than the next clock readiness time. Increase the next ready\n56\t*   time if a packet is successfully processed (but not if the\n57\t*   prepare packet call returns \"no action\").\n58\t* \n59\t* - On the \"receive packet\" side, only accept a packet if the\n60\t*   arrival time is after the the next ready time. If it is not,\n61\t*   queue the packet in an \"arrival queue\", and drop it if the\n62\t*   arrival queue is over some limit. Increase the next ready\n63\t*   time after the packet is processed\n64\t*\n65\t* We test this configuration with a couple of scenarios.\n66\t*/\n67\t\n68\ttypedef struct st_limited_test_config_t {\n69\t    uint8_t test_id;\n70\t    picoquic_congestion_algorithm_t* ccalgo;\n71\t    uint64_t incoming_cpu_time;\n72\t    uint64_t prepare_cpu_time;\n73\t    size_t packet_queue_max;\n74\t    size_t nb_initial_steps;\n75\t    size_t nb_final_steps;\n76\t    uint64_t max_completion_time;\n77\t    uint64_t microsec_latency;\n78\t    uint64_t picosec_per_byte;\n79\t    uint64_t flow_control_max;\n80\t    uint64_t nb_losses_max;\n81\t} limited_test_config_t;\n82\t\n83\tint limited_client_create_scenario(\n84\t    size_t nb_initial_steps, size_t nb_final_steps,\n85\t    test_api_stream_desc_t ** p_scenario,\n86\t    size_t * p_scenario_size)\n87\t{\n88\t    int ret = 0;\n89\t    size_t nb_steps = nb_initial_steps + nb_final_steps;\n90\t    size_t scenario_size = sizeof(test_api_stream_desc_t) * nb_steps;\n91\t    test_api_stream_desc_t* scenario = (test_api_stream_desc_t*)malloc(scenario_size);\n92\t    uint64_t previous_stream_id = 0;\n93\t\n94\t    if (scenario == NULL) {\n95\t        *p_scenario = NULL;\n96\t        *p_scenario_size = 0;\n97\t        ret = -1;\n98\t    }\n99\t    else {\n100\t        *p_scenario = scenario;\n101\t        *p_scenario_size = scenario_size;\n102\t        memset(scenario, 0, scenario_size);\n103\t        for (size_t i = 0; i < nb_initial_steps; i++) {\n104\t            scenario[i].q_len = 257;\n105\t            scenario[i].r_len = 32000;\n106\t            scenario[i].previous_stream_id = previous_stream_id;\n107\t            previous_stream_id += 4;\n108\t            scenario[i].stream_id = previous_stream_id;\n109\t        }\n110\t        for (size_t i = nb_initial_steps; i < nb_steps; i++) {\n111\t            scenario[i].q_len = 257;\n112\t            scenario[i].r_len = 1000000;\n113\t            scenario[i].previous_stream_id = previous_stream_id; \n114\t            scenario[i].stream_id = previous_stream_id + 4*(i+1);\n115\t        }\n116\t    }\n117\t\n118\t    return ret;\n119\t}\n120\t\n121\tint limited_client_test_one(limited_test_config_t * config)\n122\t{\n123\t    uint64_t simulated_time = 0;\n124\t    picoquic_test_tls_api_ctx_t* test_ctx = NULL;\n125\t    picoquic_connection_id_t initial_cid = { {0x11, 0x01, 0xc1, 0x1e, 0x44, 0, 0, 0}, 8 };\n126\t    test_api_stream_desc_t* scenario = NULL;\n127\t    size_t scenario_size = 0;\n128\t    int ret;\n129\t\n130\t    initial_cid.id[5] = config->test_id;\n131\t\n132\t\n133\t    ret = tls_api_init_ctx_ex(&test_ctx, PICOQUIC_INTERNAL_TEST_VERSION_1, PICOQUIC_TEST_SNI, PICOQUIC_TEST_ALPN, &simulated_time, NULL, NULL, 0, 1, 0, &initial_cid);\n134\t\n135\t    if (ret == 0 && test_ctx == NULL) {\n136\t        ret = -1;\n137\t    }\n138\t    else {\n139\t        ret = limited_client_create_scenario(config->nb_initial_steps,\n140\t            config->nb_final_steps, &scenario, &scenario_size);\n141\t    }\n142\t\n143\t    /* Set the congestion algorithm and endpoint limits to specified value. */\n144\t    if (ret == 0) {\n145\t\n146\t        picoquic_set_default_congestion_algorithm(test_ctx->qserver, config->ccalgo);\n147\t        picoquic_set_congestion_algorithm(test_ctx->cnx_client, config->ccalgo);\n148\t        test_ctx->client_endpoint.incoming_cpu_time = config->incoming_cpu_time;\n149\t        test_ctx->client_endpoint.prepare_cpu_time = config->prepare_cpu_time;\n150\t        test_ctx->client_endpoint.packet_queue_max = config->packet_queue_max;\n151\t        test_ctx->qserver->use_long_log = 1;\n152\t        picoquic_set_qlog(test_ctx->qserver, \".\");\n153\t        test_ctx->qclient->use_long_log = 1;\n154\t        picoquic_set_qlog(test_ctx->qclient, \".\");\n155\t        /* Set long delays, 1 Mbps each way */\n156\t        test_ctx->c_to_s_link->microsec_latency = config->microsec_latency;\n157\t        test_ctx->c_to_s_link->picosec_per_byte = config->picosec_per_byte;\n158\t        test_ctx->s_to_c_link->microsec_latency = config->microsec_latency;\n159\t        test_ctx->s_to_c_link->picosec_per_byte = config->picosec_per_byte;\n160\t        /* if required, set the flow control limit */\n161\t        if (config->flow_control_max != 0) {\n162\t            picoquic_set_max_data_control(test_ctx->qclient, config->flow_control_max);\n163\t        }\n164\t        ret = tls_api_one_scenario_body(test_ctx, &simulated_time,\n165\t            scenario, scenario_size, 0, 0, 0, 4 * config->microsec_latency, config->max_completion_time);\n166\t    }\n167\t\n168\t    if (ret == 0 && config->nb_losses_max != 0) {\n169\t        if (test_ctx->cnx_server == NULL) {\n170\t            DBG_PRINTF(\"Cannot verify number of losses < %\" PRIu64 \", server connection deleted\",\n171\t                config->nb_losses_max);\n172\t            ret = -1;\n173\t        }\n174\t        else if (test_ctx->cnx_server->nb_retransmission_total >= config->nb_losses_max) {\n175\t            DBG_PRINTF(\"Got %\" PRIu64 \", >= %\" PRIu64,\n176\t                test_ctx->cnx_server->nb_retransmission_total, config->nb_losses_max);\n177\t            ret = -1;\n178\t        }\n179\t    }\n180\t\n181\t    /* Free the resource, which will close the log file.\n182\t    */\n183\t\n184\t    if (test_ctx != NULL) {\n185\t        tls_api_delete_ctx(test_ctx);\n186\t        test_ctx = NULL;\n187\t    }\n188\t\n189\t    if (scenario != NULL) {\n190\t        free(scenario);\n191\t    }\n192\t\n193\t    return ret;\n194\t}\n195\t\n196\tstatic void limited_config_set_default( limited_test_config_t* config, uint8_t test_id)\n197\t{\n198\t    memset(config, 0, sizeof(limited_test_config_t));\n199\t    config->test_id = test_id;\n200\t    config->ccalgo = picoquic_newreno_algorithm;\n201\t    config->incoming_cpu_time = 2000;\n202\t    config->prepare_cpu_time = 2000;\n203\t    config->packet_queue_max = 16;\n204\t    config->nb_final_steps = 2;\n205\t    config->nb_initial_steps = 0;\n206\t    config->microsec_latency = 50000;\n207\t    config->picosec_per_byte = 80000; /* corresponds to 100 Mbps */\n208\t}\n209\t\n210\tint limited_reno_test(void)\n211\t{\n212\t    limited_test_config_t config;\n213\t    limited_config_set_default(&config, 1);\n214\t    config.ccalgo = picoquic_newreno_algorithm;\n215\t    config.max_completion_time = 4600000;\n216\t\n217\t    return limited_client_test_one(&config);\n218\t}\n219\t\n220\tint limited_cubic_test(void)\n221\t{\n222\t    limited_test_config_t config;\n223\t    limited_config_set_default(&config, 2);\n224\t    config.ccalgo = picoquic_cubic_algorithm;\n225\t    config.max_completion_time = 4200000;\n226\t\n227\t    return limited_client_test_one(&config);\n228\t}\n229\t\n230\tint limited_bbr_test(void)\n231\t{\n232\t    limited_test_config_t config;\n233\t    limited_config_set_default(&config, 3);\n234\t    config.ccalgo = picoquic_bbr_algorithm;\n235\t    config.max_completion_time = 4100000;\n236\t\n237\t    return limited_client_test_one(&config);\n238\t}\n239\t\n240\tint limited_batch_test(void)\n241\t{\n242\t    limited_test_config_t config;\n243\t    limited_config_set_default(&config, 4);\n244\t    config.ccalgo = picoquic_bbr_algorithm;\n245\t    config.max_completion_time = 6200000;\n246\t    config.nb_initial_steps = 10;\n247\t\n248\t    return limited_client_test_one(&config);\n249\t}\n250\t\n251\tint limited_safe_test(void)\n252\t{\n253\t    limited_test_config_t config;\n254\t    limited_config_set_default(&config, 5);\n255\t    config.ccalgo = picoquic_cubic_algorithm;\n256\t    config.max_completion_time = 5450000;\n257\t    /* Bug. Should investigate later -- there should be 0 or maybe 1 losses */\n258\t    config.nb_losses_max = 6;\n259\t    config.flow_control_max = 57344;\n260\t\n261\t    return limited_client_test_one(&config);\n262\t}\n263\t"}]},"parent_tool_use_id":null,"session_id":"b824c5fb-b8f4-4e6f-a6a3-c34fd6fc5265","uuid":"c93d98a7-41d9-43d1-b1cb-4a18c606ff02","timestamp":"2026-05-04T23:15:21.651Z","tool_use_result":{"type":"text","file":{"filePath":"/Users/richbarn/Projects/picoquic/picoquictest/cpu_limited.c","content":"/*\n* Author: Christian Huitema\n* Copyright (c) 2023, Private Octopus, Inc.\n* All rights reserved.\n*\n* Permission to use, copy, modify, and distribute this software for any\n* purpose with or without fee is hereby granted, provided that the above\n* copyright notice and this permission notice appear in all copies.\n*\n* THIS SOFTWARE IS PROVIDED BY THE COPYRIGHT HOLDERS AND CONTRIBUTORS \"AS IS\" AND\n* ANY EXPRESS OR IMPLIED WARRANTIES, INCLUDING, BUT NOT LIMITED TO, THE IMPLIED\n* WARRANTIES OF MERCHANTABILITY AND FITNESS FOR A PARTICULAR PURPOSE ARE\n* DISCLAIMED. IN NO EVENT SHALL Private Octopus, Inc. BE LIABLE FOR ANY\n* DIRECT, INDIRECT, INCIDENTAL, SPECIAL, EXEMPLARY, OR CONSEQUENTIAL DAMAGES\n* (INCLUDING, BUT NOT LIMITED TO, PROCUREMENT OF SUBSTITUTE GOODS OR SERVICES;\n* LOSS OF USE, DATA, OR PROFITS; OR BUSINESS INTERRUPTION) HOWEVER CAUSED AND\n* ON ANY THEORY OF LIABILITY, WHETHER IN CONTRACT, STRICT LIABILITY, OR TORT\n* (INCLUDING NEGLIGENCE OR OTHERWISE) ARISING IN ANY WAY OUT OF THE USE OF THIS\n* SOFTWARE, EVEN IF ADVISED OF THE POSSIBILITY OF SUCH DAMAGE.\n*/\n\n#include <stdlib.h>\n#include <string.h>\n#include <inttypes.h>\n#include \"picoquic.h\"\n#include \"picoquic_internal.h\"\n#include \"picoquictest_internal.h\"\n#include \"tls_api.h\"\n#include \"autoqlog.h\"\n#include \"logreader.h\"\n#include \"qlog.h\"\n\n#include \"picoquic_newreno.h\"\n#include \"picoquic_cubic.h\"\n#include \"picoquic_bbr.h\"\n#include \"picoquic_bbr1.h\"\n#include \"picoquic_fastcc.h\"\n#include \"picoquic_prague.h\"\n\n\n/* Add a series of tests to study the behavior of cpu-limited clients.\n* This requires simulating clients that have cpu limitations, such\n* as only being able to proceed a set number of messages per second.\n* \n* The main effort is to modify the simulator to keep track of the\n* \"software load\" of a node. The simulator interacts with the code\n* through two APIs: prepare a packet to send; and, receive a packet.\n* We assume that each of these calls will take some time, because\n* it includes CPU processing. The simulation needs to maintain a\n* \"node readiness\" clock, so that the node only becomes available\n* some time after performing an action. Then, we do the following:\n* \n* - On the \"prepare packet\" side, only consider the client ready\n*   if time is large than the next ready time and also larger\n*   than the next clock readiness time. Increase the next ready\n*   time if a packet is successfully processed (but not if the\n*   prepare packet call returns \"no action\").\n* \n* - On the \"receive packet\" side, only accept a packet if the\n*   arrival time is after the the next ready time. If it is not,\n*   queue the packet in an \"arrival queue\", and drop it if the\n*   arrival queue is over some limit. Increase the next ready\n*   time after the packet is processed\n*\n* We test this configuration with a couple of scenarios.\n*/\n\ntypedef struct st_limited_test_config_t {\n    uint8_t test_id;\n    picoquic_congestion_algorithm_t* ccalgo;\n    uint64_t incoming_cpu_time;\n    uint64_t prepare_cpu_time;\n    size_t packet_queue_max;\n    size_t nb_initial_steps;\n    size_t nb_final_steps;\n    uint64_t max_completion_time;\n    uint64_t microsec_latency;\n    uint64_t picosec_per_byte;\n    uint64_t flow_control_max;\n    uint64_t nb_losses_max;\n} limited_test_config_t;\n\nint limited_client_create_scenario(\n    size_t nb_initial_steps, size_t nb_final_steps,\n    test_api_stream_desc_t ** p_scenario,\n    size_t * p_scenario_size)\n{\n    int ret = 0;\n    size_t nb_steps = nb_initial_steps + nb_final_steps;\n    size_t scenario_size = sizeof(test_api_stream_desc_t) * nb_steps;\n    test_api_stream_desc_t* scenario = (test_api_stream_desc_t*)malloc(scenario_size);\n    uint64_t previous_stream_id = 0;\n\n    if (scenario == NULL) {\n        *p_scenario = NULL;\n        *p_scenario_size = 0;\n        ret = -1;\n    }\n    else {\n        *p_scenario = scenario;\n        *p_scenario_size = scenario_size;\n        memset(scenario, 0, scenario_size);\n        for (size_t i = 0; i < nb_initial_steps; i++) {\n            scenario[i].q_len = 257;\n            scenario[i].r_len = 32000;\n            scenario[i].previous_stream_id = previous_stream_id;\n            previous_stream_id += 4;\n            scenario[i].stream_id = previous_stream_id;\n        }\n        for (size_t i = nb_initial_steps; i < nb_steps; i++) {\n            scenario[i].q_len = 257;\n            scenario[i].r_len = 1000000;\n            scenario[i].previous_stream_id = previous_stream_id; \n            scenario[i].stream_id = previous_stream_id + 4*(i+1);\n        }\n    }\n\n    return ret;\n}\n\nint limited_client_test_one(limited_test_config_t * config)\n{\n    uint64_t simulated_time = 0;\n    picoquic_test_tls_api_ctx_t* test_ctx = NULL;\n    picoquic_connection_id_t initial_cid = { {0x11, 0x01, 0xc1, 0x1e, 0x44, 0, 0, 0}, 8 };\n    test_api_stream_desc_t* scenario = NULL;\n    size_t scenario_size = 0;\n    int ret;\n\n    initial_cid.id[5] = config->test_id;\n\n\n    ret = tls_api_init_ctx_ex(&test_ctx, PICOQUIC_INTERNAL_TEST_VERSION_1, PICOQUIC_TEST_SNI, PICOQUIC_TEST_ALPN, &simulated_time, NULL, NULL, 0, 1, 0, &initial_cid);\n\n    if (ret == 0 && test_ctx == NULL) {\n        ret = -1;\n    }\n    else {\n        ret = limited_client_create_scenario(config->nb_initial_steps,\n            config->nb_final_steps, &scenario, &scenario_size);\n    }\n\n    /* Set the congestion algorithm and endpoint limits to specified value. */\n    if (ret == 0) {\n\n        picoquic_set_default_congestion_algorithm(test_ctx->qserver, config->ccalgo);\n        picoquic_set_congestion_algorithm(test_ctx->cnx_client, config->ccalgo);\n        test_ctx->client_endpoint.incoming_cpu_time = config->incoming_cpu_time;\n        test_ctx->client_endpoint.prepare_cpu_time = config->prepare_cpu_time;\n        test_ctx->client_endpoint.packet_queue_max = config->packet_queue_max;\n        test_ctx->qserver->use_long_log = 1;\n        picoquic_set_qlog(test_ctx->qserver, \".\");\n        test_ctx->qclient->use_long_log = 1;\n        picoquic_set_qlog(test_ctx->qclient, \".\");\n        /* Set long delays, 1 Mbps each way */\n        test_ctx->c_to_s_link->microsec_latency = config->microsec_latency;\n        test_ctx->c_to_s_link->picosec_per_byte = config->picosec_per_byte;\n        test_ctx->s_to_c_link->microsec_latency = config->microsec_latency;\n        test_ctx->s_to_c_link->picosec_per_byte = config->picosec_per_byte;\n        /* if required, set the flow control limit */\n        if (config->flow_control_max != 0) {\n            picoquic_set_max_data_control(test_ctx->qclient, config->flow_control_max);\n        }\n        ret = tls_api_one_scenario_body(test_ctx, &simulated_time,\n            scenario, scenario_size, 0, 0, 0, 4 * config->microsec_latency, config->max_completion_time);\n    }\n\n    if (ret == 0 && config->nb_losses_max != 0) {\n        if (test_ctx->cnx_server == NULL) {\n            DBG_PRINTF(\"Cannot verify number of losses < %\" PRIu64 \", server connection deleted\",\n                config->nb_losses_max);\n            ret = -1;\n        }\n        else if (test_ctx->cnx_server->nb_retransmission_total >= config->nb_losses_max) {\n            DBG_PRINTF(\"Got %\" PRIu64 \", >= %\" PRIu64,\n                test_ctx->cnx_server->nb_retransmission_total, config->nb_losses_max);\n            ret = -1;\n        }\n    }\n\n    /* Free the resource, which will close the log file.\n    */\n\n    if (test_ctx != NULL) {\n        tls_api_delete_ctx(test_ctx);\n        test_ctx = NULL;\n    }\n\n    if (scenario != NULL) {\n        free(scenario);\n    }\n\n    return ret;\n}\n\nstatic void limited_config_set_default( limited_test_config_t* config, uint8_t test_id)\n{\n    memset(config, 0, sizeof(limited_test_config_t));\n    config->test_id = test_id;\n    config->ccalgo = picoquic_newreno_algorithm;\n    config->incoming_cpu_time = 2000;\n    config->prepare_cpu_time = 2000;\n    config->packet_queue_max = 16;\n    config->nb_final_steps = 2;\n    config->nb_initial_steps = 0;\n    config->microsec_latency = 50000;\n    config->picosec_per_byte = 80000; /* corresponds to 100 Mbps */\n}\n\nint limited_reno_test(void)\n{\n    limited_test_config_t config;\n    limited_config_set_default(&config, 1);\n    config.ccalgo = picoquic_newreno_algorithm;\n    config.max_completion_time = 4600000;\n\n    return limited_client_test_one(&config);\n}\n\nint limited_cubic_test(void)\n{\n    limited_test_config_t config;\n    limited_config_set_default(&config, 2);\n    config.ccalgo = picoquic_cubic_algorithm;\n    config.max_completion_time = 4200000;\n\n    return limited_client_test_one(&config);\n}\n\nint limited_bbr_test(void)\n{\n    limited_test_config_t config;\n    limited_config_set_default(&config, 3);\n    config.ccalgo = picoquic_bbr_algorithm;\n    config.max_completion_time = 4100000;\n\n    return limited_client_test_one(&config);\n}\n\nint limited_batch_test(void)\n{\n    limited_test_config_t config;\n    limited_config_set_default(&config, 4);\n    config.ccalgo = picoquic_bbr_algorithm;\n    config.max_completion_time = 6200000;\n    config.nb_initial_steps = 10;\n\n    return limited_client_test_one(&config);\n}\n\nint limited_safe_test(void)\n{\n    limited_test_config_t config;\n    limited_config_set_default(&config, 5);\n    config.ccalgo = picoquic_cubic_algorithm;\n    config.max_completion_time = 5450000;\n    /* Bug. Should investigate later -- there should be 0 or maybe 1 losses */\n    config.nb_losses_max = 6;\n    config.flow_control_max = 57344;\n\n    return limited_client_test_one(&config);\n}\n","numLines":263,"startLine":1,"totalLines":263}}}
