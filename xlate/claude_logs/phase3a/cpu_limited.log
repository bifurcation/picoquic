{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01Y5ndr35q1QGtqy8YKXARMV","type":"tool_result","content":"1\t//! Translation of `quic/quic.h`.\n2\t//!\n3\t//! `quic.h` is the kitchen-sink public header for the\n4\t//! quic-core library: it defines the protocol error codes, the\n5\t//! transport-parameter identifiers, the application-facing enums, the\n6\t//! opaque QUIC / connection / path types, the public structs that\n7\t//! cross the API boundary (`TransportParameters`, `PathQuality`,\n8\t//! `PerAckState`, `CongestionAlgorithm`, …)\n9\t//! and the dozens of free functions that make up the application API.\n10\t//!\n11\t//! Phase 1 contract: signatures only — every body is `todo!()`.\n12\t//!\n13\t//! Pointer-shape and translation policy notes that apply throughout\n14\t//! this module:\n15\t//!\n16\t//! * `Quic`, `Connection`, `Path` are\n17\t//!   opaque types defined in `internal.h`.  Phase 1 declares\n18\t//!   them as empty structs here so the public API can refer to them;\n19\t//!   the real layout lands when the internal header is translated.\n20\t//! * `struct sockaddr*` parameters and fields map to\n21\t//!   [`core::net::SocketAddr`].  The C source uses tagged unions of\n22\t//!   `sockaddr_in` / `sockaddr_in6`, which `SocketAddr` models\n23\t//!   directly.  Output parameters of type `struct sockaddr_storage*`\n24\t//!   become a `SocketAddr` returned by value.\n25\t//! * Function-pointer typedefs become traits (one trait per typedef\n26\t//!   by default).  Trait grouping is used for the four-function\n27\t//!   `CongestionAlgorithm` vtable, where the C side\n28\t//!   always installs the four together.\n29\t//! * `void*` \"callback context\" arguments are folded into the trait\n30\t//!   implementor's state.  Per-stream / per-path application\n31\t//!   contexts that flow through the stack (e.g. `stream_ctx`,\n32\t//!   `app_stream_ctx`) become `Option<Box<dyn core::any::Any>>` —\n33\t//!   the application produces them, downcasts on retrieval.\n34\t//! * C `int` / `int64_t` return values that encode 0/-1 or 0/error\n35\t//!   status become `Result<T, Error>` — the crate-level `Error` enum\n36\t//!   doesn't exist yet, so `()` is a placeholder per the Phase 1\n37\t//!   contract.  `i32` / `i64` are kept where the C value is a real\n38\t//!   integer (e.g., wake delays in microseconds, interface index).\n39\t//! * Single-bit `unsigned int : 1` bitfields collapse to `bool`.\n40\t//! * `va_list` has no Rust counterpart; the `_v` log helpers are\n41\t//!   omitted in favour of one entry point that takes\n42\t//!   `core::fmt::Arguments<'_>`.\n43\t//! * `extern` global state (`congestion_control_algorithms`)\n44\t//!   becomes accessor functions that hand out a borrowed slice; the\n45\t//!   companion `_nb_` length variable disappears (the slice carries\n46\t//!   its length).\n47\t\n48\t// Many translated functions mirror C signatures with >7 parameters.\n49\t// Builder patterns or shape changes are out of scope for Phase 1.\n50\t#![allow(clippy::too_many_arguments)]\n51\t\n52\tpub mod arena;\n53\tpub mod binlog;\n54\tpub mod bytestream;\n55\tpub mod cc_common;\n56\tpub mod config;\n57\tpub mod crypto;\n58\tpub mod errors;\n59\tpub mod frames;\n60\tpub mod hash;\n61\tpub mod header_protection;\n62\tpub mod internal;\n63\tpub mod lb;\n64\tpub mod logger;\n65\tpub mod packet_loop;\n66\tpub mod performance_log;\n67\tpub mod qlog;\n68\tpub mod siphash;\n69\tpub mod socks;\n70\tpub mod socks_socket2;\n71\tpub mod splay;\n72\tpub mod stream;\n73\tpub mod sys;\n74\t#[cfg(test)]\n75\tpub mod tests;\n76\tpub mod textlog;\n77\tpub mod tls;\n78\tpub mod tls_api;\n79\tpub mod tp;\n80\tpub mod utils;\n81\t\n82\t// Re-export the TP shapes from the public crate root for backwards\n83\t// compatibility with callers that already wrote `crate::TransportParameters`.\n84\tpub use tp::{PreferredAddress, TransportParameter, TransportParameters, VersionNegotiation};\n85\t\n86\tuse core::net::SocketAddr;\n87\t\n88\t// ---------------------------------------------------------------------------\n89\t// Version string and error class.\n90\t//\n91\t// Error values come straight from `#define` and would naturally be\n92\t// untyped in C; in Rust we commit to `u64` because the application\n93\t// API takes them as `uint64_t error_code` parameters and returns\n94\t// them in `get_local_error` etc.\n95\t\n96\t/// Library version string.  C: `VERSION`.\n97\tpub const VERSION: &str = \"1.1.48.0\";\n98\t\n99\t/// Crate-level error type for fallible operations.\n100\t///\n101\t/// Phase 1 stubs return `Result<T, Error>` even though the\n102\t/// `todo!()` bodies don't yet decide which variant to produce —\n103\t/// Phase 3 will fill that in based on the C control flow.  The\n104\t/// initial variant set covers the broad failure shapes; Phase 3\n105\t/// can add more as needed.  Marked `#[non_exhaustive]` so adding\n106\t/// variants later isn't a breaking change.\n107\t#[derive(Debug, Clone, Copy, PartialEq, Eq)]\n108\t#[non_exhaustive]\n109\tpub enum Error {\n110\t    /// Catch-all placeholder for paths Phase 1 has not yet\n111\t    /// distinguished.  Phase 3 should narrow these.\n112\t    Generic,\n113\t    /// Allocation failed.\n114\t    Memory,\n115\t    /// Caller supplied an invalid argument.\n116\t    InvalidArgument,\n117\t    /// A buffer the caller supplied was too small.\n118\t    BufferTooSmall,\n119\t    /// Caller-supplied file does not exist.\n120\t    NoSuchFile,\n121\t    /// Caller-supplied file was malformed.\n122\t    InvalidFile,\n123\t    /// Connection has been disconnected.\n124\t    Disconnected,\n125\t    /// Connection state didn't permit the requested operation.\n126\t    InvalidState,\n127\t    /// Operation produced or received a malformed QUIC frame.\n128\t    InvalidFrame,\n129\t    /// TLS / crypto error.\n130\t    Tls,\n131\t    /// Other QUIC protocol error; the wrapped value is the\n132\t    /// numeric `ERROR_*` code defined in this module.\n133\t    Protocol(u64),\n134\t}\n135\t\n136\timpl core::fmt::Display for Error {\n137\t    fn fmt(&self, f: &mut core::fmt::Formatter<'_>) -> core::fmt::Result {\n138\t        write!(f, \"{:?}\", self)\n139\t    }\n140\t}\n141\t\n142\timpl core::error::Error for Error {}\n143\t\n144\t/// Crate-wide `Result` alias defaulting the error type to [`Error`].\n145\tpub type Result<T, E = Error> = core::result::Result<T, E>;\n146\t\n147\t/// Wall-clock instant in microseconds since some application-defined\n148\t/// epoch.  Replaces the C `uint64_t current_time` parameter that\n149\t/// threads through every API call needing \"now\".  The type is\n150\t/// `Copy`, supports arithmetic with [`Duration`], and converts to\n151\t/// `u64` cheaply via `.ticks()` when crossing wire boundaries.\n152\t///\n153\t/// Phase 2 decision: per-call `current_time: Instant` parameters\n154\t/// stay (matches the C source's design — caller decides what time\n155\t/// it is).  No `Clock` trait at the library level; applications\n156\t/// can build a clock-injecting wrapper around the calls if they\n157\t/// want that style.\n158\tpub type Instant = fugit::Instant<u64, 1, 1_000_000>;\n159\t\n160\t/// Duration in microseconds.  Companion to [`Instant`].  Use for\n161\t/// timeouts, RTTs, jitter, etc.  In the C source these are bare\n162\t/// `uint64_t` values labelled by context (`idle_timeout`,\n163\t/// `microsec_latency`, …); the typed alias makes the unit explicit.\n164\tpub type Duration = fugit::Duration<u64, 1, 1_000_000>;\n165\t\n166\t// Error codes (picoquic-internal `ERROR_*` and protocol-defined\n167\t// `TRANSPORT_*` / TLS-alert) live as enums in [`crate::errors`].\n168\tpub use errors::{InternalError, TransportError};\n169\t\n170\t// ---------------------------------------------------------------------------\n171\t// Packet sizes and miscellaneous constants.\n172\t\n173\tpub const MAX_PACKET_SIZE: usize = 1536;\n174\tpub const INITIAL_MTU_IPV4: usize = 1252;\n175\tpub const INITIAL_MTU_IPV6: usize = 1232;\n176\tpub const RESET_SECRET_SIZE: usize = 16;\n177\tpub const RESET_PACKET_PAD_SIZE: usize = 23;\n178\tpub const RESET_PACKET_MIN_SIZE: usize = RESET_PACKET_PAD_SIZE + RESET_SECRET_SIZE;\n179\tpub const MAX_CRYPTO_BUFFER_GAP: usize = 16384;\n180\t\n181\tpub const LOG_PACKET_MAX_SEQUENCE: u32 = 100;\n182\t\n183\t/// First 4 bytes of `SHA256(\"QUIC Masque\")`.  Used as a sentinel\n184\t/// interface index where no real OS interface is meaningful.\n185\tpub const RESERVED_IF_INDEX: u32 = 0x09cb8ed3;\n186\t\n187\t// TLS cipher-suite identifiers (IANA).\n188\tpub const AES_128_GCM_SHA256: u16 = 0x1301;\n189\tpub const AES_256_GCM_SHA384: u16 = 0x1302;\n190\tpub const CHACHA20_POLY1305_SHA256: u16 = 0x1303;\n191\t\n192\tpub const GROUP_SECP256R1: u16 = 23;\n193\t\n194\t// ECN code points for the IP header `tos` byte.\n195\tpub const ECN_ECT_0: u8 = 0x02;\n196\tpub const ECN_ECT_1: u8 = 0x01;\n197\tpub const ECN_CE: u8 = 0x03;\n198\t\n199\t/// C macro `FOURCC(a, b, c, d)`.  Produces a 32-bit code from four\n200\t/// bytes in little-endian order.\n201\tpub const fn fourcc(a: u8, b: u8, c: u8, d: u8) -> u32 {\n202\t    u32::from_le_bytes([a, b, c, d])\n203\t}\n204\t\n205\t// ---------------------------------------------------------------------------\n206\t// Connection state.\n207\t\n208\t/// Connection-state machine, listing the QUIC connection states a\n209\t/// `Connection` walks through from initial handshake to teardown.\n210\t/// Discriminants follow the declaration order of the C `state_enum`.\n211\t#[derive(Debug, Copy, Clone, PartialEq, Eq, PartialOrd, Ord)]\n212\tpub enum State {\n213\t    ClientInit,\n214\t    ClientInitSent,\n215\t    ClientRenegotiate,\n216\t    ClientRetryReceived,\n217\t    ClientInitResent,\n218\t    ServerInit,\n219\t    ServerHandshake,\n220\t    ClientHandshakeStart,\n221\t    HandshakeFailure,\n222\t    HandshakeFailureResend,\n223\t    ClientAlmostReady,\n224\t    ServerFalseStart,\n225\t    ServerAlmostReady,\n226\t    ClientReadyStart,\n227\t    Ready,\n228\t    Disconnecting,\n229\t    ClosingReceived,\n230\t    Closing,\n231\t    Draining,\n232\t    Disconnected,\n233\t}\n234\t\n235\t// `TransportParameter`, `PreferredAddress`, `VersionNegotiation`,\n236\t// `TransportParameters`, and `TransportParameter0RttKind` live in\n237\t// [`crate::tp`].\n238\t\n239\t// ---------------------------------------------------------------------------\n240\t// Packet contexts and enumerated policy types.\n241\t\n242\t/// Encryption-level packet context.  Each value selects one of the\n243\t/// three QUIC packet-number spaces (Initial, Handshake, 1-RTT).\n244\t/// The C enum's trailing `nb_packet_context` count is exposed as\n245\t/// the [`NB_PACKET_CONTEXT`] constant below.\n246\t#[derive(Debug, Copy, Clone, PartialEq, Eq)]\n247\t#[repr(u8)]\n248\tpub enum PacketContext {\n249\t    Application = 0,\n250\t    Handshake = 1,\n251\t    Initial = 2,\n252\t}\n253\t\n254\t/// Number of packet contexts (matches the variant count of\n255\t/// [`PacketContext`]).\n256\tpub const NB_PACKET_CONTEXT: usize = 3;\n257\t\n258\t/// Path-MTU-discovery policy for a connection.\n259\t#[derive(Debug, Copy, Clone, PartialEq, Eq, Default)]\n260\t#[repr(u8)]\n261\tpub enum PmtudPolicy {\n262\t    /// Default opportunistic PMTUD.\n263\t    #[default]\n264\t    Basic = 0,\n265\t    /// Force PMTUD as soon as possible.\n266\t    Required = 1,\n267\t    /// Only do PMTUD if a lot of data has to be sent.\n268\t    Delayed = 2,\n269\t    /// Never do PMTUD.\n270\t    Blocked = 3,\n271\t}\n272\t\n273\t/// Spin-bit variant policy.\n274\t#[derive(Debug, Copy, Clone, PartialEq, Eq, Default)]\n275\t#[repr(u8)]\n276\tpub enum SpinbitVersion {\n277\t    /// Default behaviour, per the spin-bit draft.\n278\t    #[default]\n279\t    Basic = 0,\n280\t    /// Randomise per packet.\n281\t    Random = 1,\n282\t    /// Null behaviour, randomised per path.\n283\t    Null = 2,\n284\t    /// Test-only \"always on\" mode.  Not valid as a per-connection\n285\t    /// override (server only; see [`Quic::set_default_spinbit_policy`]).\n286\t    On = 3,\n287\t}\n288\t\n289\t/// Loss-bit support level.\n290\t#[derive(Debug, Copy, Clone, PartialEq, Eq, Default)]\n291\t#[repr(u8)]\n292\tpub enum LossbitVersion {\n293\t    /// Loss bits disabled.\n294\t    #[default]\n295\t    None = 0,\n296\t    /// This endpoint sets the loss bits but does not interpret peer's.\n297\t    SendOnly = 1,\n298\t    /// This endpoint both sets and receives loss bits.\n299\t    SendReceive = 2,\n300\t}\n301\t\n302\t/// Path scheduling status — whether a path participates in normal\n303\t/// scheduling or is held in reserve.\n304\t#[derive(Debug, Copy, Clone, PartialEq, Eq, Default)]\n305\t#[repr(u8)]\n306\tpub enum PathStatus {\n307\t    /// Path is available for sending.\n308\t    #[default]\n309\t    Available = 0,\n310\t    /// Path is held as a backup; data only flows when no Available\n311\t    /// path remains.\n312\t    Backup = 1,\n313\t}\n314\t\n315\t// ---------------------------------------------------------------------------\n316\t// Connection ID.\n317\t\n318\tpub const CONNECTION_ID_MIN_SIZE: usize = 0;\n319\tpub const CONNECTION_ID_MAX_SIZE: usize = 20;\n320\t\n321\t/// Fixed-capacity QUIC connection ID.  C: `ConnectionId`.\n322\t///\n323\t/// Stored as a 20-byte buffer plus a length so the type is `Copy`,\n324\t/// matching the C usage where connection IDs are passed by value\n325\t/// in many APIs (`get_local_connection_id`, `create_connection`,\n326\t/// …).  Fields are private — construct via [`Self::clone_from_slice`]\n327\t/// or [`Self::with_size`] and read via [`Self::as_bytes`].\n328\t///\n329\t/// `Ord` is derived as lexicographic over the live bytes (matching\n330\t/// the C `compare_connection_id` shape: per-byte compare under\n331\t/// `min(len_a, len_b)`, then length tie-break).\n332\t#[derive(Debug, Copy, Clone, PartialEq, Eq, PartialOrd, Ord, Hash, Default)]\n333\tpub struct ConnectionId {\n334\t    id: [u8; CONNECTION_ID_MAX_SIZE],\n335\t    id_len: u8,\n336\t}\n337\t\n338\timpl ConnectionId {\n339\t    /// Construct a connection id by copying `bytes`.  Returns `None`\n340\t    /// when `bytes.len()` exceeds [`CONNECTION_ID_MAX_SIZE`].\n341\t    pub fn clone_from_slice(_bytes: &[u8]) -> Option<Self> {\n342\t        todo!()\n343\t    }\n344\t\n345\t    /// Construct a zero-filled connection id of length `len`.\n346\t    /// Returns `None` when `len` exceeds [`CONNECTION_ID_MAX_SIZE`].\n347\t    pub fn with_size(_len: usize) -> Option<Self> {\n348\t        todo!()\n349\t    }\n350\t\n351\t    /// Borrow the live id bytes (`bytes[..len]`).\n352\t    pub fn as_bytes(&self) -> &[u8] {\n353\t        &self.id[..self.id_len as usize]\n354\t    }\n355\t\n356\t    /// Mutable borrow of the live id bytes.\n357\t    pub fn as_bytes_mut(&mut self) -> &mut [u8] {\n358\t        &mut self.id[..self.id_len as usize]\n359\t    }\n360\t\n361\t    /// Number of bytes in the id.\n362\t    pub fn len(&self) -> usize {\n363\t        self.id_len as usize\n364\t    }\n365\t\n366\t    /// `true` when the id has zero length.  Mirrors the C\n367\t    /// `is_connection_id_null` sentinel check.\n368\t    pub fn is_empty(&self) -> bool {\n369\t        self.id_len == 0\n370\t    }\n371\t\n372\t    /// Hash with a 16-byte seed.  C: `connection_id_hash`.\n373\t    pub fn hash_with_seed(&self, _seed: &[u8; 16]) -> u64 {\n374\t        todo!()\n375\t    }\n376\t\n377\t    /// Fold the first up-to-8 bytes of the id into a `u64`.\n378\t    /// C: `val64_connection_id`.\n379\t    pub fn val64(&self) -> u64 {\n380\t        todo!()\n381\t    }\n382\t}\n383\t\n384\t// ---------------------------------------------------------------------------\n385\t// IO vectors.\n386\t//\n387\t// The C `picoquic_iovec_t` (and the picotls-side `PtlsIovec*` that\n388\t// aliased it) are gone — every place that used to take an iovec\n389\t// pair now takes a `&[u8]` (single buffer) or `&[&[u8]]` /\n390\t// `Vec<Vec<u8>>` (list of buffers), per the project's\n391\t// \"use Rust's slice/vec types\" policy.\n392\t\n393\t// ---------------------------------------------------------------------------\n394\t// Opaque types (forward declarations).\n395\t//\n396\t// `Quic`, `Connection`, and `Path` are\n397\t// defined in `internal.h`.  Phase 1 declares them as empty\n398\t// structs so callers can refer to them; the real layout lands when\n399\t// the internal header is translated.  The `_opaque` field prevents\n400\t// callers from constructing one accidentally, and the `Debug` impl\n401\t// gives the structs a printable shape for log lines.\n402\t\n403\t// Full bodies live in `crate::internal`; pull them in for use within\n404\t// this module's signatures (no re-export — callers reach them as\n405\t// `crate::internal::*`).\n406\tuse crate::internal::{Connection, Path, Quic};\n407\t\n408\t// ---------------------------------------------------------------------------\n409\t// Application callback events.\n410\t\n411\t/// Event type passed to the application's stream / connection\n412\t/// callback (see [`StreamDataCallback`]).  Identifies which sort of\n413\t/// notification the stack is delivering — stream data, lifecycle\n414\t/// transition, datagram event, path event, etc.\n415\t#[derive(Debug, Copy, Clone, PartialEq, Eq)]\n416\tpub enum CallbackEvent {\n417\t    StreamData = 0,\n418\t    StreamFin,\n419\t    StreamReset,\n420\t    StopSending,\n421\t    StatelessReset,\n422\t    Close,\n423\t    ApplicationClose,\n424\t    StreamGap,\n425\t    PrepareToSend,\n426\t    AlmostReady,\n427\t    Ready,\n428\t    Datagram,\n429\t    VersionNegotiation,\n430\t    RequestAlpnList,\n431\t    SetAlpn,\n432\t    PacingChanged,\n433\t    PrepareDatagram,\n434\t    DatagramAcked,\n435\t    DatagramLost,\n436\t    DatagramSpurious,\n437\t    PathAvailable,\n438\t    PathSuspended,\n439\t    PathDeleted,\n440\t    PathQualityChanged,\n441\t    PathAddressObserved,\n442\t    AppWakeup,\n443\t    NextPathAllowed,\n444\t}\n445\t\n446\t// Transport-parameter shapes live in [`crate::tp`].\n447\t\n448\t// Stream-id decomposition lives on [`crate::stream::StreamId`].\n449\t\n450\t// ---------------------------------------------------------------------------\n451\t// Time management.\n452\t\n453\t/// Wall-clock microseconds since the Unix epoch.\n454\t///\n455\t/// The C body reads the OS clock; in Rust this requires the `std`\n456\t/// feature (`std::time::SystemTime`).  The `cfg`-gated split lands\n457\t/// when the crate gains its `std` feature and the rest of the\n458\t/// `no_std + alloc` plumbing — for Phase 1 the function is just a\n459\t/// `todo!()` stub.\n460\tpub fn current_time() -> u64 {\n461\t    todo!()\n462\t}\n463\t\n464\timpl Quic {\n465\t    /// Virtual time used by this QUIC context (wall-clock or\n466\t    /// simulated, depending on whether a simulated-time pointer was\n467\t    /// supplied at creation).  C: `get_quic_time`.\n468\t    pub fn time(&self) -> u64 {\n469\t        todo!()\n470\t    }\n471\t}\n472\t\n473\t// ---------------------------------------------------------------------------\n474\t// Application callbacks (function-pointer typedefs → traits).\n475\t\n476\t/// Stream/event callback installed on a QUIC context or connection.\n477\t/// Folds the C `void* callback_ctx` into the trait implementor's\n478\t/// state; `stream_ctx` is per-stream and remains a raw pointer\n479\t/// because it is produced and consumed by the application without\n480\t/// the stack interpreting it.\n481\t///\n482\t/// Returns the C `int` directly: `0` for success, or one of the\n483\t/// `_*` codes (e.g. `STREAM_RECEIVE_COMPLETE`) for\n484\t/// special signalling.  Phase 3 may refine to `Result` once the\n485\t/// crate-level error type lands.\n486\t///\n487\t/// `bytes` is `&[u8]` rather than `*const u8 + size_t`; events that\n488\t/// carry no payload pass `&[]`.\n489\tpub trait StreamDataCallback {\n490\t    fn callback(\n491\t        &mut self,\n492\t        connection: &mut Connection,\n493\t        stream_id: u64,\n494\t        bytes: &[u8],\n495\t        fin_or_event: CallbackEvent,\n496\t        stream_ctx: Option<&mut dyn core::any::Any>,\n497\t    ) -> i32;\n498\t}\n499\t\n500\t/// ALPN-selection callback.  Returns the index of the chosen ALPN\n501\t/// in `list`, or any value `>= list.len()` to signal \"none of the\n502\t/// proposed ALPNs is supported\".  C: `AlpnSelect` (the C `_v2`\n503\t/// flavour is folded in — it only differed in the iovec type, which\n504\t/// is now just `&[u8]`).\n505\t/// Application hook the TLS backend invokes to choose one of the\n506\t/// client's proposed ALPN values.  Returns the chosen index into\n507\t/// `list`, or `None` to reject the handshake.\n508\t///\n509\t/// `list` carries the raw bytes off the wire; mapping to the\n510\t/// strongly-typed [`Alpn`] enum is up to the implementor (most\n511\t/// applications keep a small whitelist by string identifier).\n512\tpub trait AlpnSelect {\n513\t    fn select(&mut self, quic: &mut Quic, list: &[&[u8]]) -> Option<usize>;\n514\t}\n515\t\n516\t/// Callback that produces a server-environment-compatible CID.\n517\t/// Folds the C `void* connection_id_cb_data` into the implementor's state.\n518\t/// C: `ConnectionIdCallback`.\n519\tpub trait ConnectionIdCallback {\n520\t    fn produce(\n521\t        &mut self,\n522\t        quic: &mut Quic,\n523\t        connection_id_local: ConnectionId,\n524\t        connection_id_remote: ConnectionId,\n525\t    ) -> ConnectionId;\n526\t}\n527\t\n528\t/// Packet-fuzzer callback.  Folds the C `void* fuzz_ctx` into the\n529\t/// implementor.  Returns the new packet length (which may equal\n530\t/// the input).  C: `Fuzz`.\n531\tpub trait Fuzz {\n532\t    fn fuzz(\n533\t        &mut self,\n534\t        connection: &mut Connection,\n535\t        bytes: &mut [u8],\n536\t        length: usize,\n537\t        header_length: usize,\n538\t    ) -> u32;\n539\t}\n540\t\n541\t/// Direct-receive callback for streams marked with\n542\t/// `mark_direct_receive_stream`.  C:\n543\t/// `StreamDirectReceive`.  Folds `direct_receive_ctx`\n544\t/// into the implementor.\n545\tpub trait StreamDirectReceive {\n546\t    fn receive(\n547\t        &mut self,\n548\t        connection: &mut Connection,\n549\t        stream_id: u64,\n550\t        fin: bool,\n551\t        bytes: &[u8],\n552\t        offset: u64,\n553\t    ) -> i32;\n554\t}\n555\t\n556\t// ---------------------------------------------------------------------------\n557\t// Path quality and per-ack state.\n558\t\n559\t/// Per-path quality snapshot reported by\n560\t/// `get_path_quality`.  C: `PathQuality`.\n561\t#[derive(Debug, Copy, Clone)]\n562\tpub struct PathQuality {\n563\t    /// Receive rate estimate in bytes per second.\n564\t    pub receive_rate_estimate: u64,\n565\t    /// Pacing rate in bytes per second.\n566\t    pub pacing_rate: u64,\n567\t    /// Number of bytes in the congestion window.\n568\t    pub cwin: u64,\n569\t    /// Smoothed RTT estimate in microseconds.\n570\t    pub rtt: Duration,\n571\t    /// Most recent RTT sample.\n572\t    pub rtt_sample: Duration,\n573\t    /// Estimated RTT variability.\n574\t    pub rtt_variant: Duration,\n575\t    /// Minimum observed RTT since path creation.\n576\t    pub rtt_min: Duration,\n577\t    /// Maximum observed RTT since path creation.\n578\t    pub rtt_max: Duration,\n579\t    pub sent: u64,\n580\t    pub lost: u64,\n581\t    pub timer_losses: u64,\n582\t    pub spurious_losses: u64,\n583\t    pub max_spurious_rtt: Duration,\n584\t    pub max_reorder_delay: Duration,\n585\t    pub max_reorder_gap: u64,\n586\t    pub bytes_in_transit: u64,\n587\t    pub bytes_sent: u64,\n588\t    pub bytes_received: u64,\n589\t}\n590\t\n591\timpl Default for PathQuality {\n592\t    fn default() -> Self {\n593\t        Self {\n594\t            receive_rate_estimate: 0,\n595\t            pacing_rate: 0,\n596\t            cwin: 0,\n597\t            rtt: Duration::from_ticks(0),\n598\t            rtt_sample: Duration::from_ticks(0),\n599\t            rtt_variant: Duration::from_ticks(0),\n600\t            rtt_min: Duration::from_ticks(0),\n601\t            rtt_max: Duration::from_ticks(0),\n602\t            sent: 0,\n603\t            lost: 0,\n604\t            timer_losses: 0,\n605\t            spurious_losses: 0,\n606\t            max_spurious_rtt: Duration::from_ticks(0),\n607\t            max_reorder_delay: Duration::from_ticks(0),\n608\t            max_reorder_gap: 0,\n609\t            bytes_in_transit: 0,\n610\t            bytes_sent: 0,\n611\t            bytes_received: 0,\n612\t        }\n613\t    }\n614\t}\n615\t\n616\t// ---------------------------------------------------------------------------\n617\t// Datagram and congestion APIs.\n618\t\n619\t/// Datagram-readiness signalling passed to\n620\t/// [`provide_datagram_buffer_ex`].\n621\t#[derive(Debug, Copy, Clone, PartialEq, Eq, Default)]\n622\t#[repr(u8)]\n623\tpub enum DatagramActive {\n624\t    /// Application has nothing more to send.\n625\t    #[default]\n626\t    NotActive = 0,\n627\t    /// Application can send on any path.\n628\t    AnyPath = 1,\n629\t    /// Application can send only on the current path.\n630\t    ThisPathOnly = 2,\n631\t    /// Application can send on the current path *and* others.\n632\t    ThisPathAndOthers = 3,\n633\t}\n634\t\n635\t/// Default stream priority used when none is set explicitly.\n636\tpub const DEFAULT_STREAM_PRIORITY: u8 = 9;\n637\t\n638\t/// Reference packet size used as the cautious upper bound when\n639\t/// queueing datagrams before path MTU is known.  In C this is\n640\t/// defined in terms of `ENFORCED_INITIAL_MTU`, which lives\n641\t/// in the internal header.  The numeric value (1252 bytes, the IPv4\n642\t/// initial MTU floor) is duplicated here to keep the public API\n643\t/// translatable in Phase 1 — the constant will be re-exported from\n644\t/// the internal module once it is translated.\n645\tpub const DATAGRAM_QUEUE_CAUTIOUS_LENGTH: usize = INITIAL_MTU_IPV4;\n646\t\n647\t/// Congestion-control event fed to a [`CongestionControl`]\n648\t/// implementation's `alg_notify` hook.\n649\t#[derive(Debug, Copy, Clone, PartialEq, Eq)]\n650\tpub enum CongestionNotification {\n651\t    /// At least one packet was acknowledged.\n652\t    Acknowledgement,\n653\t    /// A packet was retransmitted.\n654\t    Repeat,\n655\t    /// A retransmission timer expired.\n656\t    Timeout,\n657\t    /// A retransmission was found to have been spurious.\n658\t    SpuriousRepeat,\n659\t    /// A new RTT sample is available.\n660\t    RttMeasurement,\n661\t    /// ECN-marked traffic was acknowledged.\n662\t    EcnEc,\n663\t    /// The send path is blocked by the congestion window.\n664\t    CwinBlocked,\n665\t    /// Seed the congestion window from external knowledge.\n666\t    SeedCwin,\n667\t    /// Reset congestion-control state.\n668\t    Reset,\n669\t    /// Notification of lost feedback.\n670\t    LostFeedback,\n671\t}\n672\t\n673\t/// Per-ACK state passed to the congestion-control algorithm.  C:\n674\t/// `PerAckState`.\n675\t///\n676\t/// Single-bit `unsigned int : 1` bitfields collapse to `bool`.  `pc`\n677\t/// stays an `i32` (the C field used `int` instead of the enum\n678\t/// itself to avoid include dependencies; we follow suit so the\n679\t/// translation can be checked field-by-field).\n680\t#[derive(Debug, Copy, Clone)]\n681\tpub struct PerAckState {\n682\t    pub rtt_measurement: Duration,\n683\t    pub send_delay: Duration,\n684\t    pub one_way_delay: Duration,\n685\t    pub nb_bytes_acknowledged: u64,\n686\t    pub nb_bytes_newly_lost: u64,\n687\t    pub nb_bytes_lost_since_packet_sent: u64,\n688\t    pub nb_bytes_delivered_since_packet_sent: u64,\n689\t    pub inflight_prior: u64,\n690\t    pub lost_packet_number: u64,\n691\t    pub lost_packet_sent_time: Instant,\n692\t    pub pc: i32,\n693\t    pub is_app_limited: bool,\n694\t    pub is_cwnd_limited: bool,\n695\t}\n696\t\n697\timpl Default for PerAckState {\n698\t    fn default() -> Self {\n699\t        Self {\n700\t            rtt_measurement: Duration::from_ticks(0),\n701\t            send_delay: Duration::from_ticks(0),\n702\t            one_way_delay: Duration::from_ticks(0),\n703\t            nb_bytes_acknowledged: 0,\n704\t            nb_bytes_newly_lost: 0,\n705\t            nb_bytes_lost_since_packet_sent: 0,\n706\t            nb_bytes_delivered_since_packet_sent: 0,\n707\t            inflight_prior: 0,\n708\t            lost_packet_number: 0,\n709\t            lost_packet_sent_time: Instant::from_ticks(0),\n710\t            pc: 0,\n711\t            is_app_limited: false,\n712\t            is_cwnd_limited: false,\n713\t        }\n714\t    }\n715\t}\n716\t\n717\t/// Congestion-control algorithm vtable.  In C this is four\n718\t/// independent function-pointer typedefs grouped into a struct\n719\t/// (`congestion_algorithm_init`,\n720\t/// `_notify`, `_delete`, `_observe`).  The C side always installs\n721\t/// the four together, so they collapse to a single Rust trait per\n722\t/// the \"trait grouping is a judgment call\" rule.\n723\t///\n724\t/// `option_string` arrives as an optional borrowed `&str`; the C\n725\t/// version accepted a nullable `char const*` that callers either\n726\t/// owned for the duration of the call or set to `NULL`.\n727\tpub trait CongestionControl {\n728\t    fn alg_init(&self, path_x: &mut Path, option_string: Option<&str>, current_time: Instant);\n729\t\n730\t    fn alg_notify(\n731\t        &self,\n732\t        connection: &mut Connection,\n733\t        path_x: &mut Path,\n734\t        notification: CongestionNotification,\n735\t        ack_state: &PerAckState,\n736\t        current_time: Instant,\n737\t    );\n738\t\n739\t    fn alg_delete(&self, path_x: &mut Path);\n740\t\n741\t    /// Optional observation hook — many algorithms leave this\n742\t    /// unimplemented (`NULL` in C).  Callers that don't care can\n743\t    /// rely on the default `None` return.\n744\t    fn alg_observe(&self, _path_x: &Path) -> Option<(u64, u64)> {\n745\t        None\n746\t    }\n747\t}\n748\t\n749\t/// Congestion-control algorithm descriptor.  C:\n750\t/// `CongestionAlgorithm`.\n751\t///\n752\t/// The four function pointers from the C struct fold into a single\n753\t/// trait-object reference; the algorithm identifier and numeric tag\n754\t/// stay alongside it.  `congestion_algorithm_id` is `&'static str`\n755\t/// because the C side stores compile-time string literals.\n756\tpub struct CongestionAlgorithm {\n757\t    pub congestion_algorithm_id: &'static str,\n758\t    pub congestion_algorithm_number: u8,\n759\t    pub ecn_mark: u8,\n760\t    pub algorithm: &'static dyn CongestionControl,\n761\t}\n762\t\n763\timpl core::fmt::Debug for CongestionAlgorithm {\n764\t    fn fmt(&self, f: &mut core::fmt::Formatter<'_>) -> core::fmt::Result {\n765\t        f.debug_struct(\"CongestionAlgorithm\")\n766\t            .field(\"congestion_algorithm_id\", &self.congestion_algorithm_id)\n767\t            .field(\n768\t                \"congestion_algorithm_number\",\n769\t                &self.congestion_algorithm_number,\n770\t            )\n771\t            .field(\"ecn_mark\", &self.ecn_mark)\n772\t            .finish_non_exhaustive()\n773\t    }\n774\t}\n775\t\n776\t/// Return the registered congestion-control algorithm table.  In\n777\t/// C this was a pair of `extern` globals\n778\t/// (`congestion_control_algorithms` and\n779\t/// `nb_congestion_control_algorithms`); the Rust API\n780\t/// exposes a single accessor returning a borrowed slice — the\n781\t/// length is implicit.  The slice is empty until\n782\t/// [`register_congestion_control_algorithms`] (or its\n783\t/// `_all_` convenience wrapper) is called.\n784\tpub fn congestion_control_algorithms() -> &'static [&'static CongestionAlgorithm] {\n785\t    todo!()\n786\t}\n787\t\n788\t// ---------------------------------------------------------------------------\n789\t// ALPN list.\n790\t\n791\t/// Application-protocol identifiers used during session\n792\t/// negotiation.\n793\t#[derive(Debug, Copy, Clone, PartialEq, Eq, Default)]\n794\tpub enum Alpn {\n795\t    /// No ALPN selected / unrecognised.\n796\t    #[default]\n797\t    Undef,\n798\t    Http0_9,\n799\t    Http3,\n800\t    Quicperf,\n801\t}\n802\t\n803\timpl Alpn {\n804\t    /// Wire string for this ALPN, or `None` for [`Self::Undef`].\n805\t    pub const fn as_str(self) -> Option<&'static str> {\n806\t        match self {\n807\t            Self::Undef => None,\n808\t            Self::Http0_9 => Some(\"hq-interop\"),\n809\t            Self::Http3 => Some(\"h3\"),\n810\t            Self::Quicperf => Some(\"perf\"),\n811\t        }\n812\t    }\n813\t}\n814\t\n815\timpl core::str::FromStr for Alpn {\n816\t    type Err = ();\n817\t\n818\t    fn from_str(_s: &str) -> Result<Self, Self::Err> {\n819\t        todo!()\n820\t    }\n821\t}\n822\t\n823\t// ---------------------------------------------------------------------------\n824\t// MTU helper.\n825\t\n826\t/// C macro `MTU_OVERHEAD(p_s_addr)`.  Returns the IP+UDP\n827\t/// overhead for the address family of `addr`: 28 bytes for IPv4\n828\t/// (20 IP + 8 UDP), 48 bytes for IPv6 (40 IP + 8 UDP).\n829\tpub const fn mtu_overhead(addr: &SocketAddr) -> u32 {\n830\t    match addr {\n831\t        SocketAddr::V4(_) => 28,\n832\t        SocketAddr::V6(_) => 48,\n833\t    }\n834\t}\n835\t\n836\t// ---------------------------------------------------------------------------\n837\t// Free functions — handshake and error helpers.\n838\t\n839\t/// C: `is_handshake_error`.  Returns `true` when the given\n840\t/// error code is a TLS handshake error.\n841\tpub fn is_handshake_error(_error_code: u64) -> bool {\n842\t    todo!()\n843\t}\n844\t\n845\t// `error_name` lives on [`crate::errors::InternalError::name`].\n846\t\n847\t// `tp_name` lives on [`crate::tp::TransportParameter::name`].\n848\t\n849\t// `frame_name` lives on [`crate::frames::FrameType::name`].\n850\t\n851\t// `add_proposed_alpn` is gone.  In the C source this was the\n852\t// hook for the application's ALPN-select callback to push a\n853\t// proposed value into the picotls handshake state.  Phase 2's\n854\t// `TlsCallbacks::select_alpn` model returns the chosen index\n855\t// instead; the TLS backend provisions internally.\n856\t\n857\timpl Connection {\n858\t    /// Negotiated ALPN, or [`Alpn::Undef`] when no ALPN was selected.\n859\t    pub fn tls_negotiated_alpn(&self) -> Alpn {\n860\t        todo!()\n861\t    }\n862\t\n863\t    /// SNI value the peer presented during the handshake, or `None`\n864\t    /// when none was given.\n865\t    pub fn tls_sni(&self) -> Option<&str> {\n866\t        todo!()\n867\t    }\n868\t\n869\t    /// Reason this connection closed.  Only one of the four C\n870\t    /// out-parameters (`local_reason`, `remote_reason`,\n871\t    /// `local_application_reason`, `remote_application_reason`) was\n872\t    /// populated in any given case; that \"which side, transport\n873\t    /// vs. application\" choice folds into [`CloseReason`].\n874\t    /// Returns `None` when the connection has not (yet) closed.\n875\t    pub fn close_reason(&self) -> Option<CloseReason> {\n876\t        todo!()\n877\t    }\n878\t}\n879\t\n880\t/// Outcome reported by [`Connection::close_reason`].  Mirrors the\n881\t/// \"(side, layer)\" choice from the four C out-parameters.\n882\t#[derive(Debug, Copy, Clone, PartialEq, Eq)]\n883\tpub enum CloseReason {\n884\t    /// Local close at the QUIC transport layer.  Code is one of the\n885\t    /// [`crate::errors::TransportError`] / [`crate::errors::InternalError`]\n886\t    /// values, or a `CRYPTO_ERROR(alert)` from\n887\t    /// [`crate::errors::transport_crypto_error`].\n888\t    Local(u64),\n889\t    /// Local close at the application layer (CONNECTION_CLOSE frame\n890\t    /// type 0x1d).  Code is application-defined.\n891\t    LocalApp(u64),\n892\t    /// Peer closed at the QUIC transport layer.\n893\t    Remote(u64),\n894\t    /// Peer closed at the application layer.\n895\t    RemoteApp(u64),\n896\t}\n897\t\n898\t// ---------------------------------------------------------------------------\n899\t// Per-context settings (logging, diagnostics, pool sizing,\n900\t// port-blocking).\n901\t\n902\timpl Quic {\n903\t    /// Install a per-context packet fuzzer; `None` removes any\n904\t    /// previously installed fuzzer.\n905\t    pub fn set_fuzz(&mut self, _fuzzer: Option<Box<dyn Fuzz>>) {\n906\t        todo!()\n907\t    }\n908\t\n909\t    /// `1` → log every packet, `0` → log only the first\n910\t    /// [`LOG_PACKET_MAX_SEQUENCE`] packets per connection.\n911\t    pub fn set_log_level(&mut self, _log_level: i32) {\n912\t        todo!()\n913\t    }\n914\t\n915\t    /// Toggle randomised log-file names (defeating accidental\n916\t    /// collisions when clients pick non-random initial CIDs).\n917\t    pub fn set_use_unique_log_names(&mut self, _use_unique_log_names: bool) {\n918\t        todo!()\n919\t    }\n920\t\n921\t    /// Toggle SSL-keylog output.  Phase 1 follows the canonical\n922\t    /// build (`WITHOUT_SSLKEYLOG` undefined); a `cfg`-gated variant\n923\t    /// lands when build options are translated.\n924\t    pub fn set_sslkeylog_enabled(&mut self, _enable_sslkeylog: bool) {\n925\t        todo!()\n926\t    }\n927\t\n928\t    /// Whether SSL-keylog output is enabled on this context.\n929\t    pub fn is_sslkeylog_enabled(&self) -> bool {\n930\t        todo!()\n931\t    }\n932\t\n933\t    /// Configure packet-number randomisation: `0` (no\n934\t    /// randomisation), `1` (Initial PNs only), `2` (all PN spaces).\n935\t    pub fn set_random_initial(&mut self, _random_initial: i32) {\n936\t        todo!()\n937\t    }\n938\t\n939\t    /// Toggle packet-train mode (groups outbound packets into\n940\t    /// coalesced trains).\n941\t    pub fn set_packet_train_mode(&mut self, _train_mode: bool) {\n942\t        todo!()\n943\t    }\n944\t\n945\t    /// Configure default padding policy applied to outbound packets.\n946\t    pub fn set_padding_policy(&mut self, _padding_min_size: u32, _padding_multiple: u32) {\n947\t        todo!()\n948\t    }\n949\t\n950\t    /// Set (or clear, with `None`) the keylog destination file.\n951\t    pub fn set_key_log_file(&mut self, _keylog_filename: Option<&str>) {\n952\t        todo!()\n953\t    }\n954\t\n955\t    /// Read `SSLKEYLOGFILE` from the process environment (gated\n956\t    /// behind the build-time `WITHOUT_SSLKEYLOG` opt-out and the\n957\t    /// per-context `is_sslkeylog_enabled` flag) and install it via\n958\t    /// [`Quic::set_key_log_file`].  C:\n959\t    /// `picoquic_set_key_log_file_from_env`.\n960\t    ///\n961\t    /// The environment lookup is a `std`-only operation (it goes\n962\t    /// through `getenv`); Phase 3 will feature-gate the body.\n963\t    pub fn set_key_log_file_from_env(&mut self) {\n964\t        todo!()\n965\t    }\n966\t\n967\t    /// Adjust the connection-pool ceiling.  Cannot grow past the\n968\t    /// limit chosen at context creation.\n969\t    pub fn adjust_max_connections(&mut self, _max_nb_connections: u32) -> Result<(), Error> {\n970\t        todo!()\n971\t    }\n972\t\n973\t    /// Number of connections currently registered with this context.\n974\t    pub fn current_number_connections(&self) -> u32 {\n975\t        todo!()\n976\t    }\n977\t\n978\t    /// Set the half-open-connection threshold above which the server\n979\t    /// switches to retry-token mode.\n980\t    pub fn set_max_half_open_retry_threshold(&mut self, _max_half_open_before_retry: u32) {\n981\t        todo!()\n982\t    }\n983\t\n984\t    /// Retrieve the configured half-open retry threshold.\n985\t    pub fn max_half_open_retry_threshold(&self) -> u32 {\n986\t        todo!()\n987\t    }\n988\t\n989\t    /// Toggle per-context port blocking.\n990\t    pub fn set_port_blocking_disabled(&mut self, _is_port_blocking_disabled: bool) {\n991\t        todo!()\n992\t    }\n993\t}\n994\t\n995\t// ---------------------------------------------------------------------------\n996\t// Free-standing port / address blocklist queries (no per-context\n997\t// state — these consult a process-wide allowlist).\n998\t\n999\t/// Returns `true` when `port` is on the QUIC well-known-port\n1000\t/// blocklist.\n1001\tpub fn check_port_blocked(_port: u16) -> bool {\n1002\t    todo!()\n1003\t}\n1004\t\n1005\t/// Returns `true` when `addr_from` belongs to a blocked address\n1006\t/// range.\n1007\tpub fn check_addr_blocked(_addr_from: &SocketAddr) -> bool {\n1008\t    todo!()\n1009\t}\n1010\t\n1011\t// ---------------------------------------------------------------------------\n1012\t// QUIC context: construction, TLS configuration, default policies.\n1013\t//\n1014\t// `picoquic_create` is the canonical constructor in the C source;\n1015\t// here it is `Quic::new`.  The setters that follow are all on the\n1016\t// QUIC context; per-connection siblings live in `impl Connection` further\n1017\t// down.\n1018\t\n1019\timpl Quic {\n1020\t    /// Build a QUIC context with the supplied certificate paths,\n1021\t    /// default callbacks, and reset seed.\n1022\t    ///\n1023\t    /// Pointer-shape choices, derived from `quic/quicctx.c:634` and\n1024\t    /// `quic/sockloop.c:2009`:\n1025\t    ///\n1026\t    /// * Every `char const*` parameter is `Option<&str>` (the C\n1027\t    ///   source passes `NULL` to mean \"absent\").\n1028\t    /// * `default_callback_fn` + `default_callback_ctx` collapse to\n1029\t    ///   one `Option<Box<dyn StreamDataCallback>>`.\n1030\t    /// * `connection_id_callback` + `connection_id_callback_data` collapse to\n1031\t    ///   `Option<Box<dyn ConnectionIdCallback>>`.\n1032\t    /// * `reset_seed[16]` is `[u8; RESET_SECRET_SIZE]` taken by\n1033\t    ///   value (the C body deep-copies it into the context).\n1034\t    /// * `ticket_encryption_key` + `ticket_encryption_key_length`\n1035\t    ///   collapse to a borrowed `Option<&[u8]>`.\n1036\t    /// * The C `p_simulated_time: uint64_t*` parameter is dropped\n1037\t    ///   — the test simulator owns its own clock and threads the\n1038\t    ///   value through `current_time` directly.\n1039\t    ///\n1040\t    /// Returns `None` when context creation fails (the C side\n1041\t    /// returned `NULL`).\n1042\t    #[allow(clippy::too_many_arguments)]\n1043\t    pub fn new(\n1044\t        _max_nb_connections: u32,\n1045\t        _cert_file_name: Option<&str>,\n1046\t        _key_file_name: Option<&str>,\n1047\t        _cert_root_file_name: Option<&str>,\n1048\t        _default_alpn: Option<&str>,\n1049\t        _default_callback: Option<Box<dyn StreamDataCallback>>,\n1050\t        _cnx_id_callback: Option<Box<dyn ConnectionIdCallback>>,\n1051\t        _reset_seed: [u8; RESET_SECRET_SIZE],\n1052\t        _current_time: Instant,\n1053\t        _ticket_file_name: Option<&str>,\n1054\t        _ticket_encryption_key: Option<&[u8]>,\n1055\t    ) -> Option<Box<Quic>> {\n1056\t        todo!()\n1057\t    }\n1058\t\n1059\t    // The C `picoquic_free` entry point is dropped from the Rust API\n1060\t    // — context cleanup is the job of `Drop`, which Phase 3 will\n1061\t    // implement.\n1062\t\n1063\t    /// Toggle low-memory mode (smaller buffers, more aggressive\n1064\t    /// reclaim).\n1065\t    pub fn set_low_memory_mode(&mut self, _low_memory_mode: bool) -> Result<(), Error> {\n1066\t        todo!()\n1067\t    }\n1068\t\n1069\t    /// Configure the server cookie / retry-token mode.\n1070\t    pub fn set_cookie_mode(&mut self, _cookie_mode: i32) {\n1071\t        todo!()\n1072\t    }\n1073\t\n1074\t    /// Restrict TLS cipher-suite selection to the given IANA ID.\n1075\t    pub fn set_cipher_suite(&mut self, _cipher_suite_id: u16) -> Result<(), Error> {\n1076\t        todo!()\n1077\t    }\n1078\t\n1079\t    /// Restrict TLS key-exchange selection to the given IANA group.\n1080\t    pub fn set_key_exchange(&mut self, _key_exchange_id: u16) -> Result<(), Error> {\n1081\t        todo!()\n1082\t    }\n1083\t\n1084\t    /// Replace the default transport parameters used for new\n1085\t    /// connections.\n1086\t    pub fn set_default_tp(&mut self, _tp: &TransportParameters) -> Result<(), Error> {\n1087\t        todo!()\n1088\t    }\n1089\t\n1090\t    /// Borrow this context's default transport parameters.\n1091\t    pub fn default_tp(&self) -> &TransportParameters {\n1092\t        todo!()\n1093\t    }\n1094\t\n1095\t    /// Maximum number of simultaneous connections this context was\n1096\t    /// configured to accept.  C: reads `quic->max_number_connections`.\n1097\t    pub fn max_nb_connections(&self) -> u32 {\n1098\t        todo!()\n1099\t    }\n1100\t\n1101\t    /// Default ALPN string for newly accepted server connections, or\n1102\t    /// `None` if no default was set.  C: reads `quic->default_alpn`.\n1103\t    pub fn default_alpn_string(&self) -> Option<&str> {\n1104\t        todo!()\n1105\t    }\n1106\t\n1107\t    /// The stateless-reset secret seed for this context.\n1108\t    /// C: reads `quic->reset_seed`.\n1109\t    pub fn reset_seed_bytes(&self) -> &[u8] {\n1110\t        todo!()\n1111\t    }\n1112\t\n1113\t    /// Identifier string of the default congestion-control algorithm,\n1114\t    /// or `None` if no default was set.  C: reads\n1115\t    /// `quic->default_congestion_alg->congestion_algorithm_id`.\n1116\t    pub fn default_congestion_algorithm_id(&self) -> Option<&str> {\n1117\t        todo!()\n1118\t    }\n1119\t\n1120\t    /// Per-context maximum data limit used for flow control.\n1121\t    /// C: reads `quic->max_data_limit`.\n1122\t    pub fn max_data_limit(&self) -> u64 {\n1123\t        todo!()\n1124\t    }\n1125\t\n1126\t    /// Override a single transport-parameter slot in the default\n1127\t    /// set.  `tp_type` is the wire ID; values for unknown types are\n1128\t    /// stored verbatim and emitted as extension parameters.\n1129\t    pub fn set_default_tp_value(&mut self, _tp_type: u64, _tp_value: u64) -> Result<(), Error> {\n1130\t        todo!()\n1131\t    }\n1132\t\n1133\t    /// Install the TLS certificate chain.  The context takes\n1134\t    /// ownership of `certs` (each entry is one DER-encoded\n1135\t    /// certificate).\n1136\t    pub fn set_tls_certificate_chain(&mut self, _certs: Vec<Vec<u8>>) {\n1137\t        todo!()\n1138\t    }\n1139\t\n1140\t    /// Install the TLS root certificate set.  The C `int` return\n1141\t    /// distinguished load vs. store failure (`-1` / `-2`); Phase 1\n1142\t    /// collapses both into [`Error::Generic`] pending refinement in\n1143\t    /// Phase 4.\n1144\t    pub fn set_tls_root_certificates(&mut self, _certs: Vec<Vec<u8>>) -> Result<(), Error> {\n1145\t        todo!()\n1146\t    }\n1147\t\n1148\t    /// Install a no-op certificate verifier (test / interop only).\n1149\t    pub fn set_null_verifier(&mut self) {\n1150\t        todo!()\n1151\t    }\n1152\t\n1153\t    /// Install the TLS private key (caller-owned bytes; the context\n1154\t    /// copies on the way in).\n1155\t    pub fn set_tls_key(&mut self, _key: &[u8]) -> Result<(), Error> {\n1156\t        todo!()\n1157\t    }\n1158\t\n1159\t    /// Toggle whether this context demands client-side TLS\n1160\t    /// authentication.\n1161\t    pub fn set_client_authentication(&mut self, _client_authentication: bool) {\n1162\t        todo!()\n1163\t    }\n1164\t\n1165\t    /// Toggle whether the TLS exporter API is available on this\n1166\t    /// context.\n1167\t    pub fn set_use_exporter(&mut self, _use_exporter: bool) {\n1168\t        todo!()\n1169\t    }\n1170\t\n1171\t    /// Reject server-mode connections on this context (clients\n1172\t    /// only).\n1173\t    pub fn enforce_client_only(&mut self, _do_enforce: bool) {\n1174\t        todo!()\n1175\t    }\n1176\t\n1177\t    /// Default packet-padding policy (multiple, min-size).\n1178\t    pub fn set_default_padding(&mut self, _padding_multiple: u32, _padding_minsize: u32) {\n1179\t        todo!()\n1180\t    }\n1181\t\n1182\t    /// Default spin-bit policy applied to new connections.\n1183\t    pub fn set_default_spinbit_policy(\n1184\t        &mut self,\n1185\t        _default_spinbit_policy: SpinbitVersion,\n1186\t    ) -> Result<(), Error> {\n1187\t        todo!()\n1188\t    }\n1189\t\n1190\t    /// Default loss-bit policy applied to new connections.\n1191\t    pub fn set_default_lossbit_policy(&mut self, _default_lossbit_policy: LossbitVersion) {\n1192\t        todo!()\n1193\t    }\n1194\t\n1195\t    /// Default multipath option (per the multipath QUIC draft).\n1196\t    pub fn set_default_multipath_option(&mut self, _multipath_option: i32) {\n1197\t        todo!()\n1198\t    }\n1199\t\n1200\t    /// Default address-discovery mode (per the address-discovery\n1201\t    /// draft): `0`=none, `1`=provide-only, `2`=receive-only,\n1202\t    /// `3`=both.\n1203\t    pub fn set_default_address_discovery_mode(&mut self, _mode: i32) {\n1204\t        todo!()\n1205\t    }\n1206\t\n1207\t    /// Cap the congestion window across all connections on this\n1208\t    /// context.\n1209\t    pub fn set_cwin_max(&mut self, _cwin_max: u64) {\n1210\t        todo!()\n1211\t    }\n1212\t\n1213\t    /// Cap the maximum stream data control window across this\n1214\t    /// context.\n1215\t    pub fn set_max_data_control(&mut self, _max_data: u64) {\n1216\t        todo!()\n1217\t    }\n1218\t\n1219\t    /// Default idle-timeout (in milliseconds) advertised on new\n1220\t    /// connections.\n1221\t    pub fn set_default_idle_timeout(&mut self, _idle_timeout: Duration) {\n1222\t        todo!()\n1223\t    }\n1224\t}\n1225\t\n1226\timpl Connection {\n1227\t    /// Replace the local transport parameters for this connection\n1228\t    /// before the handshake completes.\n1229\t    pub fn set_transport_parameters(&mut self, _tp: &TransportParameters) {\n1230\t        todo!()\n1231\t    }\n1232\t\n1233\t    /// Borrow the local (`get_local = true`) or remote transport\n1234\t    /// parameters of this connection.\n1235\t    pub fn transport_parameters(&self, _get_local: bool) -> &TransportParameters {\n1236\t        todo!()\n1237\t    }\n1238\t\n1239\t    /// Export TLS keying material to `out` using `label`.  Returns\n1240\t    /// the number of bytes written.\n1241\t    pub fn export_secret(&mut self, _label: &str, _out: &mut [u8]) -> Result<usize, Error> {\n1242\t        todo!()\n1243\t    }\n1244\t\n1245\t    /// Per-connection spin-bit policy override.\n1246\t    pub fn set_spinbit_policy(&mut self, _spinbit_policy: SpinbitVersion) -> Result<(), Error> {\n1247\t        todo!()\n1248\t    }\n1249\t}\n1250\t\n1251\timpl Quic {\n1252\t    /// Default per-connection handshake-timeout (microseconds).\n1253\t    pub fn set_default_handshake_timeout(&mut self, _handshake_timeout: Duration) {\n1254\t        todo!()\n1255\t    }\n1256\t\n1257\t    /// Default per-connection crypto-epoch length (in encrypted\n1258\t    /// bytes before triggering a key update).\n1259\t    pub fn set_default_crypto_epoch_length(&mut self, _crypto_epoch_length_max: u64) {\n1260\t        todo!()\n1261\t    }\n1262\t\n1263\t    /// Retrieve the configured default crypto-epoch length.\n1264\t    pub fn default_crypto_epoch_length(&self) -> u64 {\n1265\t        todo!()\n1266\t    }\n1267\t\n1268\t    /// Local-CID length in bytes (the value advertised in new\n1269\t    /// connections).\n1270\t    pub fn local_cid_length(&self) -> u8 {\n1271\t        todo!()\n1272\t    }\n1273\t\n1274\t    /// Returns `true` when `cid` was issued by this context.\n1275\t    pub fn is_local_cid(&self, _cid: &ConnectionId) -> bool {\n1276\t        todo!()\n1277\t    }\n1278\t\n1279\t    /// Load issued-retry-tokens from a persistent store.\n1280\t    pub fn load_retry_tokens(&mut self, _token_store_filename: &str) -> Result<(), Error> {\n1281\t        todo!()\n1282\t    }\n1283\t\n1284\t    /// Persist session tickets to disk.\n1285\t    pub fn save_session_tickets(&mut self, _ticket_store_filename: &str) -> Result<(), Error> {\n1286\t        todo!()\n1287\t    }\n1288\t\n1289\t    /// Persist outstanding retry tokens to disk.\n1290\t    pub fn save_retry_tokens(&mut self, _token_store_filename: &str) -> Result<(), Error> {\n1291\t        todo!()\n1292\t    }\n1293\t\n1294\t    /// Toggle BDP-frame extension on new connections (per the\n1295\t    /// 0-RTT-BDP draft).\n1296\t    pub fn set_default_bdp_frame_option(&mut self, _enable_bdp_frame: bool) {\n1297\t        todo!()\n1298\t    }\n1299\t\n1300\t    /// Configure the local CID length (in bytes) advertised on new\n1301\t    /// connections.\n1302\t    pub fn set_default_connection_id_length(&mut self, _cid_length: u8) -> Result<(), Error> {\n1303\t        todo!()\n1304\t    }\n1305\t\n1306\t    /// Default per-connection-ID time-to-live before retirement, in\n1307\t    /// microseconds.\n1308\t    pub fn set_default_connection_id_ttl(&mut self, _ttl_usec: u64) {\n1309\t        todo!()\n1310\t    }\n1311\t\n1312\t    /// Retrieve the configured default connection-ID TTL.\n1313\t    pub fn default_connection_id_ttl(&self) -> u64 {\n1314\t        todo!()\n1315\t    }\n1316\t\n1317\t    /// Cap the maximum MTU PMTUD will probe up to.\n1318\t    pub fn set_mtu_max(&mut self, _mtu_max: u32) {\n1319\t        todo!()\n1320\t    }\n1321\t\n1322\t    /// Install (or remove, with `None`) the ALPN-selection callback.\n1323\t    /// The C `_v2` flavour (which differed only in iovec type) is\n1324\t    /// gone — both call sites land on this single entry point.\n1325\t    pub fn set_alpn_select_fn(&mut self, _alpn_select_fn: Option<Box<dyn AlpnSelect>>) {\n1326\t        todo!()\n1327\t    }\n1328\t\n1329\t    /// Install (or remove, with `None`) the default stream/event\n1330\t    /// callback applied to new connections.  The `(callback_fn,\n1331\t    /// callback_ctx)` pair from C collapses into one trait object.\n1332\t    pub fn set_default_callback(&mut self, _callback: Option<Box<dyn StreamDataCallback>>) {\n1333\t        todo!()\n1334\t    }\n1335\t\n1336\t    /// Default minimum interval between stateless-reset emissions\n1337\t    /// (microseconds).\n1338\t    pub fn set_default_stateless_reset_min_interval(&mut self, _min_interval: Duration) {\n1339\t        todo!()\n1340\t    }\n1341\t\n1342\t    /// Cap the number of connections that may emit logs\n1343\t    /// simultaneously.\n1344\t    pub fn set_max_simultaneous_logs(&mut self, _max_simultaneous_logs: u32) {\n1345\t        todo!()\n1346\t    }\n1347\t\n1348\t    /// Retrieve the configured maximum-simultaneous-logs cap.\n1349\t    pub fn max_simultaneous_logs(&self) -> u32 {\n1350\t        todo!()\n1351\t    }\n1352\t}\n1353\t\n1354\t// ---------------------------------------------------------------------------\n1355\t// Connection lifecycle and path management.\n1356\t\n1357\timpl Quic {\n1358\t    /// Create a new connection bound to this QUIC context.\n1359\t    /// `client_mode` selects between the client and server roles\n1360\t    /// (`char` flag in C, promoted to `bool` here).\n1361\t    ///\n1362\t    /// The returned `&mut Connection` borrows from the context because the\n1363\t    /// C side stores the new connection in the context's hash\n1364\t    /// tables.\n1365\t    #[allow(clippy::too_many_arguments)]\n1366\t    pub fn create_connection(\n1367\t        &mut self,\n1368\t        _initial_cnx_id: ConnectionId,\n1369\t        _remote_cnx_id: ConnectionId,\n1370\t        _addr_to: Option<&SocketAddr>,\n1371\t        _start_time: Instant,\n1372\t        _preferred_version: u32,\n1373\t        _sni: Option<&str>,\n1374\t        _alpn: Option<&str>,\n1375\t        _client_mode: bool,\n1376\t    ) -> Option<&mut Connection> {\n1377\t        todo!()\n1378\t    }\n1379\t\n1380\t    /// Look up a live connection by its initial source connection ID and return\n1381\t    /// a mutable reference to it.  Returns `None` when no such connection is\n1382\t    /// live in this context.  C: access pattern of storing and dereferencing a\n1383\t    /// `picoquic_cnx_t*` pointer obtained from `picoquic_create_cnx`.\n1384\t    pub fn connection_ref_by_id(&mut self, _id: ConnectionId) -> Option<&mut Connection> {\n1385\t        todo!()\n1386\t    }\n1387\t\n1388\t    /// Convenience wrapper around [`Self::create_connection`] for the\n1389\t    /// client side; `addr` is required.\n1390\t    pub fn create_client_connection(\n1391\t        &mut self,\n1392\t        _addr: &SocketAddr,\n1393\t        _start_time: Instant,\n1394\t        _preferred_version: u32,\n1395\t        _sni: Option<&str>,\n1396\t        _alpn: Option<&str>,\n1397\t        _callback: Option<Box<dyn StreamDataCallback>>,\n1398\t    ) -> Option<&mut Connection> {\n1399\t        todo!()\n1400\t    }\n1401\t\n1402\t    /// Default callback enablement for path-state events on new\n1403\t    /// connections.\n1404\t    pub fn set_path_callbacks_default(&mut self, _are_enabled: bool) {\n1405\t        todo!()\n1406\t    }\n1407\t\n1408\t    /// Default thresholds for the path-quality-update callback.\n1409\t    pub fn set_default_quality_update(&mut self, _pacing_rate_delta: u64, _rtt_delta: Duration) {\n1410\t        todo!()\n1411\t    }\n1412\t}\n1413\t\n1414\timpl Connection {\n1415\t    /// Begin the client-side handshake on this connection.\n1416\t    pub fn start_client(&mut self) -> Result<(), Error> {\n1417\t        todo!()\n1418\t    }\n1419\t\n1420\t    /// Begin an ordered close.\n1421\t    pub fn close(&mut self, _application_reason_code: u64) -> Result<(), Error> {\n1422\t        todo!()\n1423\t    }\n1424\t\n1425\t    /// Same as [`Self::close`] but carries a textual `error_reason`.\n1426\t    /// `None` matches the C `NULL` case.\n1427\t    pub fn close_with_reason(\n1428\t        &mut self,\n1429\t        _application_reason_code: u64,\n1430\t        _error_reason: Option<&str>,\n1431\t    ) -> Result<(), Error> {\n1432\t        todo!()\n1433\t    }\n1434\t\n1435\t    /// Force-close the connection without waiting for the protocol\n1436\t    /// drain.\n1437\t    pub fn close_immediate(&mut self) {\n1438\t        todo!()\n1439\t    }\n1440\t\n1441\t    /// Delete the connection.  In the C API this releases the\n1442\t    /// connection's slot inside its QUIC context; in Rust the\n1443\t    /// resources drop when `Connection` itself does, so this remains a\n1444\t    /// `todo!()` until Phase 3 wires up the deletion semantics.\n1445\t    pub fn delete(&mut self) {\n1446\t        todo!()\n1447\t    }\n1448\t\n1449\t    /// Override the application-set wake time.\n1450\t    pub fn set_app_wake_time(&mut self, _app_wake_time: Instant) {\n1451\t        todo!()\n1452\t    }\n1453\t\n1454\t    /// Set the version the client should request on next handshake.\n1455\t    pub fn set_desired_version(&mut self, _desired_version: u32) {\n1456\t        todo!()\n1457\t    }\n1458\t\n1459\t    /// Record a peer-rejected version (for diagnostics / VN frames).\n1460\t    pub fn set_rejected_version(&mut self, _rejected_version: u32) {\n1461\t        todo!()\n1462\t    }\n1463\t\n1464\t    /// Probe a new local↔peer path tuple.\n1465\t    pub fn probe_new_path(\n1466\t        &mut self,\n1467\t        _addr_peer: &SocketAddr,\n1468\t        _addr_local: &SocketAddr,\n1469\t        _current_time: Instant,\n1470\t    ) -> Result<(), Error> {\n1471\t        todo!()\n1472\t    }\n1473\t\n1474\t    /// Probe a new path with explicit interface index and\n1475\t    /// preferred-address flag.\n1476\t    pub fn probe_new_path_ex(\n1477\t        &mut self,\n1478\t        _addr_peer: &SocketAddr,\n1479\t        _addr_local: &SocketAddr,\n1480\t        _if_index: i32,\n1481\t        _current_time: Instant,\n1482\t        _to_preferred_address: bool,\n1483\t    ) -> Result<(), Error> {\n1484\t        todo!()\n1485\t    }\n1486\t\n1487\t    /// Probe a new tuple on an existing path object.\n1488\t    #[allow(clippy::too_many_arguments)]\n1489\t    pub fn probe_new_tuple(\n1490\t        &mut self,\n1491\t        _path_x: &mut Path,\n1492\t        _addr_peer: &SocketAddr,\n1493\t        _addr_local: &SocketAddr,\n1494\t        _if_index: i32,\n1495\t        _current_time: Instant,\n1496\t        _to_preferred_address: bool,\n1497\t    ) -> Result<(), Error> {\n1498\t        todo!()\n1499\t    }\n1500\t\n1501\t    /// Toggle path-state event callbacks for this connection.\n1502\t    pub fn set_path_callbacks(&mut self, _are_enabled: bool) {\n1503\t        todo!()\n1504\t    }\n1505\t\n1506\t    /// Attach opaque application data to a specific path.\n1507\t    /// `app_path_ctx` is produced and consumed by the application\n1508\t    /// without the stack interpreting it.\n1509\t    pub fn set_app_path_ctx(\n1510\t        &mut self,\n1511\t        _unique_path_id: u64,\n1512\t        _app_path_ctx: Option<Box<dyn core::any::Any>>,\n1513\t    ) -> Result<(), Error> {\n1514\t        todo!()\n1515\t    }\n1516\t\n1517\t    /// Tear down a path.\n1518\t    pub fn abandon_path(\n1519\t        &mut self,\n1520\t        _unique_path_id: u64,\n1521\t        _reason: u64,\n1522\t        _current_time: Instant,\n1523\t    ) -> Result<(), Error> {\n1524\t        todo!()\n1525\t    }\n1526\t\n1527\t    /// Issue a fresh CID for the given path.\n1528\t    pub fn refresh_path_connection_id(&mut self, _unique_path_id: u64) -> Result<(), Error> {\n1529\t        todo!()\n1530\t    }\n1531\t\n1532\t    /// Pin a stream to a specific path.\n1533\t    pub fn set_stream_path_affinity(\n1534\t        &mut self,\n1535\t        _stream_id: u64,\n1536\t        _unique_path_id: u64,\n1537\t    ) -> Result<(), Error> {\n1538\t        todo!()\n1539\t    }\n1540\t\n1541\t    /// Mark a path as Available or Backup.\n1542\t    pub fn set_path_status(\n1543\t        &mut self,\n1544\t        _unique_path_id: u64,\n1545\t        _status: PathStatus,\n1546\t    ) -> Result<(), Error> {\n1547\t        todo!()\n1548\t    }\n1549\t\n1550\t    /// Subscribe to \"new path allowed\" events.\n1551\t    ///\n1552\t    /// The C signature returned the answer through an\n1553\t    /// `int* is_already_allowed` parameter that doubled as a status\n1554\t    /// flag; the Rust shape splits that: `Ok(true)` if a new path is\n1555\t    /// already allowed (caller can proceed immediately), `Ok(false)`\n1556\t    /// if the caller will be notified later by callback.\n1557\t    pub fn subscribe_new_path_allowed(&mut self) -> Result<bool, Error> {\n1558\t        todo!()\n1559\t    }\n1560\t\n1561\t    /// Override the interface index for the first path.\n1562\t    pub fn set_first_if_index(&mut self, _if_index: u32) -> Result<(), Error> {\n1563\t        todo!()\n1564\t    }\n1565\t\n1566\t    /// Look up a path's address.  `local` selects which: `1` =\n1567\t    /// local, `2` = peer, `3` = peer's observed.  The C side\n1568\t    /// returned this through a `struct sockaddr_storage*`\n1569\t    /// out-parameter; here it folds into the `Result`.\n1570\t    pub fn path_addr(&self, _unique_path_id: u64, _local: i32) -> Result<SocketAddr, Error> {\n1571\t        todo!()\n1572\t    }\n1573\t\n1574\t    /// Snapshot a path's quality metrics.\n1575\t    pub fn path_quality(&self, _unique_path_id: u64) -> Result<PathQuality, Error> {\n1576\t        todo!()\n1577\t    }\n1578\t\n1579\t    /// Snapshot the default path's quality metrics.\n1580\t    pub fn default_path_quality(&self) -> PathQuality {\n1581\t        todo!()\n1582\t    }\n1583\t\n1584\t    /// Subscribe to quality-update events on a specific path with\n1585\t    /// the given thresholds.\n1586\t    pub fn subscribe_to_quality_update_per_path(\n1587\t        &mut self,\n1588\t        _unique_path_id: u64,\n1589\t        _pacing_rate_delta: u64,\n1590\t        _rtt_delta: Duration,\n1591\t    ) -> Result<(), Error> {\n1592\t        todo!()\n1593\t    }\n1594\t\n1595\t    /// Subscribe to quality-update events on every path of this\n1596\t    /// connection.\n1597\t    pub fn subscribe_to_quality_update(&mut self, _pacing_rate_delta: u64, _rtt_delta: Duration) {\n1598\t        todo!()\n1599\t    }\n1600\t}\n1601\t\n1602\t// ---------------------------------------------------------------------------\n1603\t// Connection iteration, timing, accessors, and frame queueing.\n1604\t\n1605\timpl Connection {\n1606\t    /// Trigger the next TLS key rotation.\n1607\t    pub fn start_key_rotation(&mut self) -> Result<(), Error> {\n1608\t        todo!()\n1609\t    }\n1610\t\n1611\t    /// Borrow the QUIC context that owns this connection.\n1612\t    pub fn quic(&mut self) -> &mut Quic {\n1613\t        todo!()\n1614\t    }\n1615\t\n1616\t    /// Walk to the next connection in the QUIC context's list, if\n1617\t    /// any.  (Named `next_in_list` rather than `next` to avoid\n1618\t    /// confusion with the `Iterator::next` shape — Phase 3 may\n1619\t    /// turn this into a proper `Iterator` impl on `Quic`.)\n1620\t    pub fn next_in_list(&mut self) -> Option<&mut Connection> {\n1621\t        todo!()\n1622\t    }\n1623\t\n1624\t    /// Compute the number of microseconds until this connection\n1625\t    /// next needs attention, capped at `delay_max`.\n1626\t    pub fn wake_delay(&self, _current_time: Instant, _delay_max: i64) -> i64 {\n1627\t        todo!()\n1628\t    }\n1629\t\n1630\t    /// Connection state-machine position.\n1631\t    pub fn state(&self) -> State {\n1632\t        todo!()\n1633\t    }\n1634\t\n1635\t    /// Override the per-connection padding policy.\n1636\t    pub fn set_padding_policy(&mut self, _padding_multiple: u32, _padding_minsize: u32) {\n1637\t        todo!()\n1638\t    }\n1639\t\n1640\t    /// Read the per-connection padding policy as `(multiple,\n1641\t    /// min-size)`.\n1642\t    pub fn padding_policy(&self) -> (u32, u32) {\n1643\t        todo!()\n1644\t    }\n1645\t\n1646\t    /// Set the per-connection crypto-epoch length.\n1647\t    pub fn set_crypto_epoch_length(&mut self, _crypto_epoch_length_max: u64) {\n1648\t        todo!()\n1649\t    }\n1650\t\n1651\t    /// Read