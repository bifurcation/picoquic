6\t\n2207\t    /// Returns `true` for client-initiated connections.\n2208\t    pub fn is_client(&self) -> bool {\n2209\t        todo!()\n2210\t    }\n2211\t\n2212\t    /// Local error code reported on close (0 if none).\n2213\t    pub fn local_error(&self) -> u64 {\n2214\t        todo!()\n2215\t    }\n2216\t\n2217\t    /// Remote error code reported on close.\n2218\t    pub fn remote_error(&self) -> u64 {\n2219\t        todo!()\n2220\t    }\n2221\t\n2222\t    /// Application-level error reported on close.\n2223\t    pub fn application_error(&self) -> u64 {\n2224\t        todo!()\n2225\t    }\n2226\t\n2227\t    /// Per-stream error reported by the peer.\n2228\t    pub fn remote_stream_error(&self, _stream_id: u64) -> u64 {\n2229\t        todo!()\n2230\t    }\n2231\t\n2232\t    /// Total bytes of stream data sent on this connection.\n2233\t    pub fn data_sent(&self) -> u64 {\n2234\t        todo!()\n2235\t    }\n2236\t\n2237\t    /// Total bytes of stream data received on this connection.\n2238\t    pub fn data_received(&self) -> u64 {\n2239\t        todo!()\n2240\t    }\n2241\t\n2242\t    /// `true` while the connection still streams events into its\n2243\t    /// log (capped per [`Quic::set_max_simultaneous_logs`]).\n2244\t    pub fn is_still_logging(&self) -> bool {\n2245\t        todo!()\n2246\t    }\n2247\t}\n2248\t\n2249\t// ---------------------------------------------------------------------------\n2250\t// Congestion-control registry.\n2251\t//\n2252\t// The registry itself is process-wide, so the entry points stay as\n2253\t// free functions; the per-context / per-connection setters fold\n2254\t// into methods.\n2255\t\n2256\t/// Register a slice of congestion-control algorithms with the\n2257\t/// global registry.  The C signature took `CongestionAlgorithm\n2258\t/// const**` plus a length; the Rust shape collapses both into a\n2259\t/// borrowed slice with `'static` element lifetime — algorithms are\n2260\t/// typically file-scope statics, mirroring how\n2261\t/// `register_all_cc_algorithms.c` builds the list.\n2262\tpub fn register_congestion_control_algorithms(_alg: &'static [&'static CongestionAlgorithm]) {\n2263\t    todo!()\n2264\t}\n2265\t\n2266\t/// Convenience wrapper around\n2267\t/// [`register_congestion_control_algorithms`] that pulls in every\n2268\t/// algorithm shipped with the crate.\n2269\tpub fn register_all_congestion_control_algorithms() {\n2270\t    todo!()\n2271\t}\n2272\t\n2273\t/// Look up a registered algorithm by name (`alg_id`).\n2274\tpub fn get_congestion_algorithm(_alg_id: &str) -> Option<&'static CongestionAlgorithm> {\n2275\t    todo!()\n2276\t}\n2277\t\n2278\timpl Quic {\n2279\t    /// Set the default congestion-control algorithm applied to new\n2280\t    /// connections on this context.\n2281\t    pub fn set_default_congestion_algorithm(&mut self, _algo: &'static CongestionAlgorithm) {\n2282\t        todo!()\n2283\t    }\n2284\t\n2285\t    /// Same as [`Self::set_default_congestion_algorithm`] but\n2286\t    /// passes through a per-algorithm options string.\n2287\t    pub fn set_default_congestion_algorithm_ex(\n2288\t        &mut self,\n2289\t        _alg: &'static CongestionAlgorithm,\n2290\t        _alg_option_string: Option<&str>,\n2291\t    ) {\n2292\t        todo!()\n2293\t    }\n2294\t\n2295\t    /// Convenience: select the default algorithm by name (looking up\n2296\t    /// in the registry).  Returns `Err` when no registered algorithm\n2297\t    /// matches `alg_name`.\n2298\t    pub fn set_default_congestion_algorithm_by_name(\n2299\t        &mut self,\n2300\t        _alg_name: &str,\n2301\t    ) -> Result<(), Error> {\n2302\t        todo!()\n2303\t    }\n2304\t}\n2305\t\n2306\timpl Connection {\n2307\t    /// Override the congestion-control algorithm for this\n2308\t    /// connection.\n2309\t    pub fn set_congestion_algorithm(&mut self, _algo: &'static CongestionAlgorithm) {\n2310\t        todo!()\n2311\t    }\n2312\t\n2313\t    /// Same as [`Self::set_congestion_algorithm`] but passes\n2314\t    /// through a per-algorithm options string.\n2315\t    pub fn set_congestion_algorithm_ex(\n2316\t        &mut self,\n2317\t        _alg: &'static CongestionAlgorithm,\n2318\t        _alg_option_string: Option<&str>,\n2319\t    ) {\n2320\t        todo!()\n2321\t    }\n2322\t\n2323\t    /// Set the priority limit above which streams bypass congestion\n2324\t    /// control.\n2325\t    pub fn set_priority_limit_for_bypass(&mut self, _priority_limit: u8) {\n2326\t        todo!()\n2327\t    }\n2328\t\n2329\t    /// Toggle whether the application receives feedback-loss\n2330\t    /// notifications.\n2331\t    pub fn set_feedback_loss_notification(&mut self, _should_notify: bool) {\n2332\t        todo!()\n2333\t    }\n2334\t\n2335\t    /// Force the next probe upward (BBR / Cubic probe-up).\n2336\t    pub fn request_forced_probe_up(&mut self, _request_forced_probe_up: bool) {\n2337\t        todo!()\n2338\t    }\n2339\t\n2340\t    /// Subscribe to pacing-rate change notifications, with the\n2341\t    /// given relative thresholds.\n2342\t    pub fn subscribe_pacing_rate_updates(\n2343\t        &mut self,\n2344\t        _decrease_threshold: u64,\n2345\t        _increase_threshold: u64,\n2346\t    ) {\n2347\t        todo!()\n2348\t    }\n2349\t\n2350\t    /// Current pacing rate (bytes per second).\n2351\t    pub fn pacing_rate(&self) -> u64 {\n2352\t        todo!()\n2353\t    }\n2354\t\n2355\t    /// Current congestion window (bytes).\n2356\t    pub fn cwin(&self) -> u64 {\n2357\t        todo!()\n2358\t    }\n2359\t\n2360\t    /// Smoothed round-trip-time estimate (microseconds).\n2361\t    pub fn rtt(&self) -> u64 {\n2362\t        todo!()\n2363\t    }\n2364\t}\n2365\t\n2366\t// ---------------------------------------------------------------------------\n2367\t// ECH / ESNI.\n2368\t\n2369\timpl Quic {\n2370\t    /// Configure server-side Encrypted-ClientHello (ECH) by loading\n2371\t    /// the private key and config from disk.\n2372\t    pub fn