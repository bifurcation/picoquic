{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01FoUQshnP6qqjusMqU1yWWu","type":"tool_result","content":"1\t/*\n2\t* Author: Christian Huitema\n3\t* Copyright (c) 2021, Private Octopus, Inc.\n4\t* All rights reserved.\n5\t*\n6\t* Permission to use, copy, modify, and distribute this software for any\n7\t* purpose with or without fee is hereby granted, provided that the above\n8\t* copyright notice and this permission notice appear in all copies.\n9\t*\n10\t* THIS SOFTWARE IS PROVIDED BY THE COPYRIGHT HOLDERS AND CONTRIBUTORS \"AS IS\" AND\n11\t* ANY EXPRESS OR IMPLIED WARRANTIES, INCLUDING, BUT NOT LIMITED TO, THE IMPLIED\n12\t* WARRANTIES OF MERCHANTABILITY AND FITNESS FOR A PARTICULAR PURPOSE ARE\n13\t* DISCLAIMED. IN NO EVENT SHALL Private Octopus, Inc. BE LIABLE FOR ANY\n14\t* DIRECT, INDIRECT, INCIDENTAL, SPECIAL, EXEMPLARY, OR CONSEQUENTIAL DAMAGES\n15\t* (INCLUDING, BUT NOT LIMITED TO, PROCUREMENT OF SUBSTITUTE GOODS OR SERVICES;\n16\t* LOSS OF USE, DATA, OR PROFITS; OR BUSINESS INTERRUPTION) HOWEVER CAUSED AND\n17\t* ON ANY THEORY OF LIABILITY, WHETHER IN CONTRACT, STRICT LIABILITY, OR TORT\n18\t* (INCLUDING NEGLIGENCE OR OTHERWISE) ARISING IN ANY WAY OUT OF THE USE OF THIS\n19\t* SOFTWARE, EVEN IF ADVISED OF THE POSSIBILITY OF SUCH DAMAGE.\n20\t*/\n21\t\n22\t/*\n23\t* Datagram communication tests.\n24\t*/\n25\t\n26\t\n27\t#include \"picoquic_internal.h\"\n28\t#include \"picoquic_utils.h\"\n29\t#include \"tls_api.h\"\n30\t#include \"picoquictest_internal.h\"\n31\t#ifdef _WINDOWS\n32\t#include \"wincompat.h\"\n33\t#pragma warning(disable:4204)\n34\t#endif\n35\t#include <picotls.h>\n36\t#include <stddef.h>\n37\t#include <stdlib.h>\n38\t#include <string.h>\n39\t#include \"picoquic_binlog.h\"\n40\t#include \"csv.h\"\n41\t#include \"qlog.h\"\n42\t#include \"autoqlog.h\"\n43\t#include \"picoquic_logger.h\"\n44\t#include \"performance_log.h\"\n45\t#include \"picoquictest.h\"\n46\t#include \"picoquic_bbr.h\"\n47\t/*\n48\t * Test whether datagrams are sent and received properly\n49\t */\n50\t\n51\t\n52\tuint64_t test_datagram_next_time_ready(test_datagram_send_recv_ctx_t* dg_ctx)\n53\t{\n54\t    uint64_t next_time = 0;\n55\t\n56\t    for (int client_mode = 0; client_mode < 2; client_mode++) {\n57\t        if (!dg_ctx->is_ready[client_mode] && dg_ctx->dg_sent[client_mode] < dg_ctx->dg_target[client_mode]\n58\t            && (dg_ctx->next_gen_time[client_mode] < next_time || next_time == 0)) {\n59\t            next_time = dg_ctx->next_gen_time[client_mode];\n60\t        }\n61\t    }\n62\t    return next_time;\n63\t}\n64\t\n65\tint test_datagram_check_ready(test_datagram_send_recv_ctx_t* dg_ctx, int client_mode, uint64_t current_time)\n66\t{\n67\t    if (!dg_ctx->is_ready[client_mode] && dg_ctx->dg_sent[client_mode] < dg_ctx->dg_target[client_mode] &&\n68\t        current_time >= dg_ctx->next_gen_time[client_mode]) {\n69\t        dg_ctx->is_ready[client_mode] = 1;\n70\t        dg_ctx->dg_time_ready[client_mode] = current_time;\n71\t    }\n72\t    return dg_ctx->is_ready[client_mode];\n73\t}\n74\t\n75\tint test_datagram_send(picoquic_cnx_t* cnx, uint64_t unique_path_id,\n76\t    uint8_t* bytes, size_t length, void* datagram_ctx)\n77\t{\n78\t    int ret = 0;\n79\t    int skipping = 0;\n80\t    int is_active = 1;\n81\t    size_t available = 0;\n82\t    test_datagram_send_recv_ctx_t* dg_ctx = datagram_ctx;\n83\t    uint64_t current_time = picoquic_get_quic_time(picoquic_get_quic_ctx(cnx));\n84\t\n85\t    if (!cnx->client_mode && length > dg_ctx->dg_max_size) {\n86\t        ret = -1;\n87\t    }\n88\t    else if (length < 24) {\n89\t        ret = 0;\n90\t    }\n91\t    else if (dg_ctx->do_skip_test[cnx->client_mode] && !dg_ctx->is_skipping[cnx->client_mode]){\n92\t        dg_ctx->is_skipping[cnx->client_mode] = 1;\n93\t        skipping = 1;\n94\t        if (dg_ctx->use_extended_provider_api) {\n95\t            is_active = test_datagram_check_ready(dg_ctx, cnx->client_mode, current_time);\n96\t            (void)picoquic_provide_datagram_buffer_ex(bytes, 0, (is_active && !dg_ctx->one_datagram_per_packet));\n97\t        }\n98\t    }\n99\t    else if (!dg_ctx->is_ready[cnx->client_mode] || (dg_ctx->test_affinity && unique_path_id != 0)) {\n100\t        /* Datagram callback when the client was not ready. */\n101\t        is_active = 0;\n102\t        (void)picoquic_provide_datagram_buffer_ex(bytes, 0, (picoquic_datagram_active_enum)0);\n103\t    }\n104\t    else {\n105\t        uint8_t* buffer = NULL;\n106\t\n107\t        dg_ctx->is_skipping[cnx->client_mode] = 0;\n108\t        available = length - (size_t)(dg_ctx->dg_sent[cnx->client_mode]%6) - 8;\n109\t\n110\t        if (dg_ctx->dg_small_size > 0){\n111\t            if (available >= dg_ctx->dg_small_size) {\n112\t                available = dg_ctx->dg_small_size;\n113\t            }\n114\t            else {\n115\t                available = 0;\n116\t            }\n117\t        }\n118\t        if (dg_ctx->use_extended_provider_api) {\n119\t            picoquic_datagram_active_enum is_active = picoquic_datagram_active_any_path;\n120\t            if (dg_ctx->test_affinity) {\n121\t                is_active = picoquic_datagram_active_this_path_only;\n122\t            }\n123\t            is_active &= !dg_ctx->one_datagram_per_packet;\n124\t            buffer = picoquic_provide_datagram_buffer_ex(bytes, available, is_active);\n125\t            dg_ctx->is_ready[cnx->client_mode] = is_active;\n126\t        }\n127\t        else {\n128\t            buffer = picoquic_provide_datagram_buffer(bytes, available);\n129\t        }\n130\t        if (buffer != NULL) {\n131\t            uint8_t* buffer_bytes;\n132\t            uint64_t send_time = (dg_ctx->dg_sent[cnx->client_mode] == 0) ? current_time : dg_ctx->dg_time_ready[cnx->client_mode];\n133\t            dg_ctx->dg_sent[cnx->client_mode]++;\n134\t\n135\t            if ((buffer_bytes = picoquic_frames_uint64_encode(buffer, buffer + available,\n136\t                dg_ctx->dg_sent[cnx->client_mode])) == NULL ||\n137\t                (buffer_bytes = picoquic_frames_uint64_encode(buffer_bytes, buffer + available,\n138\t                    send_time)) == NULL) {\n139\t                ret = -1;\n140\t            }\n141\t            else {\n142\t                memset(buffer_bytes, 'd', available - (buffer_bytes - buffer));\n143\t                if (dg_ctx->batch_size[cnx->client_mode] == 0 ||\n144\t                    (dg_ctx->dg_sent[cnx->client_mode] % dg_ctx->batch_size[cnx->client_mode]) == 0) {\n145\t                    dg_ctx->next_gen_time[cnx->client_mode] += dg_ctx->send_delay;\n146\t                    dg_ctx->is_ready[cnx->client_mode] = 0;\n147\t                }\n148\t            }\n149\t        }\n150\t        else {\n151\t            ret = -1;\n152\t        }\n153\t    }\n154\t\n155\t    if (ret == 0 && !skipping && !dg_ctx->use_extended_provider_api) {\n156\t        (void)test_datagram_check_ready(dg_ctx, cnx->client_mode, current_time);\n157\t        if (dg_ctx->test_affinity) {\n158\t            picoquic_mark_datagram_ready_path(cnx, 0, dg_ctx->is_ready[cnx->client_mode]);\n159\t        }\n160\t        else {\n161\t            picoquic_mark_datagram_ready(cnx, dg_ctx->is_ready[cnx->client_mode]);\n162\t        }\n163\t    }\n164\t    return ret;\n165\t}\n166\t\n167\tint test_datagram_recv(picoquic_cnx_t* cnx, uint64_t unique_path_id,\n168\t    uint8_t* bytes, size_t length, void* datagram_ctx)\n169\t{\n170\t    test_datagram_send_recv_ctx_t* dg_ctx = datagram_ctx;\n171\t    dg_ctx->dg_recv[cnx->client_mode] += 1;\n172\t\n173\t    if (length > 16) {\n174\t        uint64_t current_time = picoquic_get_quic_time(picoquic_get_quic_ctx(cnx));\n175\t        const uint8_t* dg_bytes;\n176\t        uint64_t time_sent;\n177\t        uint64_t number_sent;\n178\t\n179\t        if (unique_path_id == 0) {\n180\t            dg_ctx->nb_recv_path_0[cnx->client_mode] += 1;\n181\t        }\n182\t        else {\n183\t            dg_ctx->nb_recv_path_other[cnx->client_mode] += 1;\n184\t        }\n185\t\n186\t        if ((dg_bytes = picoquic_frames_uint64_decode(bytes, bytes + length, &number_sent)) != NULL &&\n187\t            (dg_bytes = picoquic_frames_uint64_decode(dg_bytes, bytes + length, &time_sent)) != NULL &&\n188\t             time_sent <= current_time ) {\n189\t            uint64_t latency = current_time - time_sent;\n190\t            \n191\t            if (latency > dg_ctx->dg_latency_max[cnx->client_mode]) {\n192\t                dg_ctx->dg_latency_max[cnx->client_mode] = latency;\n193\t            }\n194\t            if (number_sent >= dg_ctx->dg_received_last[cnx->client_mode]) {\n195\t                dg_ctx->dg_received_last[cnx->client_mode] = number_sent;\n196\t            }\n197\t            else {\n198\t                uint64_t number_delta = dg_ctx->dg_received_last[cnx->client_mode] - number_sent;\n199\t                if (number_delta > dg_ctx->dg_number_delta_max[cnx->client_mode]) {\n200\t                    dg_ctx->dg_number_delta_max[cnx->client_mode] = number_sent;\n201\t                }\n202\t            }\n203\t        }\n204\t    }\n205\t    return 0;\n206\t}\n207\t\n208\tint test_datagram_ack(picoquic_cnx_t* cnx,\n209\t    picoquic_call_back_event_t d_event, uint8_t* UNUSED(bytes), size_t UNUSED(length), uint64_t UNUSED(sent_time), void* datagram_ctx)\n210\t{\n211\t    int ret = 0;\n212\t    test_datagram_send_recv_ctx_t* dg_ctx = datagram_ctx;\n213\t    switch (d_event) {\n214\t    case picoquic_callback_datagram_acked:\n215\t        dg_ctx->dg_acked[cnx->client_mode] += 1;\n216\t        break;\n217\t    case picoquic_callback_datagram_lost:\n218\t        dg_ctx->dg_nacked[cnx->client_mode] += 1;\n219\t        break;\n220\t    case picoquic_callback_datagram_spurious:\n221\t        dg_ctx->dg_spurious[cnx->client_mode] += 1;\n222\t        break;\n223\t    default:\n224\t        ret = -1;\n225\t        break;\n226\t    }\n227\t    return ret;\n228\t}\n229\t\n230\t\n231\t/* Datagram too long tests.\n232\t* we want to test what happens if the application uses the \"queue\" API\n233\t* to queue datagrams that are too long. We need to test several conditions:\n234\t*\n235\t* - max packet size -- should be rejected immediately\n236\t* - more than MTU+29 -- should be rejected immediately\n237\t* - faking it: set the MTU larger than necessary to bypass the test,\n238\t*   then reset it. Datagram should be deleted in the send loop\n239\t*   and the send loop should proceed.\n240\t* - exactly + 29 -- should be accepted and should succeed\n241\t*/\n242\t\n243\tint test_datagram_too_long(picoquic_cnx_t* cnx)\n244\t{\n245\t    int ret = 0;\n246\t    int q_ret = 0;\n247\t    uint8_t buffer[PICOQUIC_MAX_PACKET_SIZE];\n248\t    size_t pmtu = cnx->path[0]->send_mtu;\n249\t\n250\t    memset(buffer, 0xda, PICOQUIC_MAX_PACKET_SIZE);\n251\t    if ((q_ret = picoquic_queue_datagram_frame(cnx, PICOQUIC_MAX_PACKET_SIZE, buffer)) == 0) {\n252\t        DBG_PRINTF(\"Submit packet of size %d is accepted, ret = %x\", PICOQUIC_MAX_PACKET_SIZE, q_ret);\n253\t        ret = -1;\n254\t    }\n255\t\n256\t    if (ret == 0) {\n257\t        memset(buffer, 0xdb, PICOQUIC_MAX_PACKET_SIZE);\n258\t        if ((q_ret = picoquic_queue_datagram_frame(cnx, pmtu, buffer)) == 0) {\n259\t            DBG_PRINTF(\"Submit packet of size %d is accepted, ret = %x\", pmtu, q_ret);\n260\t            ret = -1;\n261\t        }\n262\t    }\n263\t\n264\t    if (ret == 0) {\n265\t        memset(buffer, 0xdc, PICOQUIC_MAX_PACKET_SIZE);\n266\t        if ((q_ret = picoquic_queue_datagram_frame(cnx, pmtu - 20 - cnx->quic->local_cnxid_length, buffer)) == 0) {\n267\t            DBG_PRINTF(\"Submit packet of size %d is accepted, ret = %x\", pmtu - 28, q_ret);\n268\t            ret = -1;\n269\t        }\n270\t    }\n271\t\n272\t    if (ret == 0) {\n273\t        memset(buffer, 0xdd, PICOQUIC_MAX_PACKET_SIZE);\n274\t        cnx->path[0]->send_mtu = 1500;\n275\t        if ((q_ret = picoquic_queue_datagram_frame(cnx, 1450, buffer)) != 0) {\n276\t            DBG_PRINTF(\"Submit packet of size %d is not accepted, ret = %x\", 1450, q_ret);\n277\t            ret = -1;\n278\t        }\n279\t        cnx->path[0]->send_mtu = pmtu;\n280\t    }\n281\t\n282\t    if (ret == 0) {\n283\t        size_t dg_overhead = 1 + cnx->quic->local_cnxid_length + 1 + 1 + 16;\n284\t        memset(buffer, 0xde, PICOQUIC_MAX_PACKET_SIZE);\n285\t        cnx->path[0]->send_mtu = 1500;\n286\t        if ((q_ret = picoquic_queue_datagram_frame(cnx, pmtu - dg_overhead, buffer)) != 0) {\n287\t            DBG_PRINTF(\"Submit packet of size %d is not accepted, ret = %x\", pmtu - dg_overhead, q_ret);\n288\t            ret = -1;\n289\t        }\n290\t        cnx->path[0]->send_mtu = pmtu;\n291\t    }\n292\t\n293\t    if (ret == 0) {\n294\t        size_t dg_overhead = 1 + cnx->quic->local_cnxid_length + 1 + 1 + 16;\n295\t        memset(buffer, 0xde, PICOQUIC_MAX_PACKET_SIZE);\n296\t        cnx->path[0]->send_mtu = 1500;\n297\t        if ((q_ret = picoquic_queue_datagram_frame(cnx, pmtu - dg_overhead - 1, buffer)) != 0) {\n298\t            DBG_PRINTF(\"Submit packet of size %d is not accepted, ret = %x\", pmtu - dg_overhead - 1, q_ret);\n299\t            ret = -1;\n300\t        }\n301\t        cnx->path[0]->send_mtu = pmtu;\n302\t    }\n303\t\n304\t    if (ret == 0) {\n305\t        size_t dg_overhead = 1 + cnx->quic->local_cnxid_length + 4 + 1 + 16;\n306\t        if ((q_ret = picoquic_queue_datagram_frame(cnx, pmtu - dg_overhead - 1, buffer)) != 0) {\n307\t            DBG_PRINTF(\"Submit packet of size %d is not accepted, ret = %x\", pmtu - dg_overhead - 1, q_ret);\n308\t        }\n309\t        cnx->path[0]->send_mtu = pmtu;\n310\t    }\n311\t\n312\t    return ret;\n313\t}\n314\t\n315\tint datagram_test_one(uint8_t test_id, test_datagram_send_recv_ctx_t *dg_ctx, uint64_t loss_mask_init)\n316\t{\n317\t    uint64_t simulated_time = 0;\n318\t    uint64_t loss_mask = 0;\n319\t    uint64_t all_sent_time = 0;\n320\t    picoquic_test_tls_api_ctx_t* test_ctx = NULL;\n321\t    picoquic_connection_id_t initial_cid = { {0xda, 0xda, 0x01, 0, 0, 0, 0, 0}, 8 };\n322\t    picoquic_congestion_algorithm_t* ccalgo = picoquic_bbr_algorithm;\n323\t    /* picoquic_tp_t server_parameters; */\n324\t    picoquic_tp_t client_parameters;\n325\t    int nb_trials = 0;\n326\t    int nb_inactive = 0;\n327\t    int ret;\n328\t    int wifi_todo = dg_ctx->test_wifi;\n329\t    uint64_t wifi_test_time = 1000000;\n330\t    uint64_t wifi_interval = 250000;\n331\t    int nb_trial_max = (dg_ctx->nb_trials_max == 0) ? 2048 : dg_ctx->nb_trials_max;\n332\t\n333\t\n334\t    initial_cid.id[3] = test_id;\n335\t\n336\t    ret = tls_api_init_ctx_ex(&test_ctx, PICOQUIC_INTERNAL_TEST_VERSION_1,\n337\t        PICOQUIC_TEST_SNI, PICOQUIC_TEST_ALPN, &simulated_time, NULL, NULL, 0, 1, 0,\n338\t        &initial_cid);\n339\t    \n340\t    if (ret == 0) {\n341\t        /* Set the test contexts for sending and receiving datagrams */\n342\t        test_ctx->datagram_ctx = dg_ctx;\n343\t        test_ctx->datagram_recv_fn = test_datagram_recv;\n344\t        test_ctx->datagram_send_fn = test_datagram_send;\n345\t        test_ctx->datagram_ack_fn = test_datagram_ack;\n346\t        /* Set the congestion control  */\n347\t        picoquic_set_default_congestion_algorithm(test_ctx->qserver, ccalgo);\n348\t        picoquic_set_congestion_algorithm(test_ctx->cnx_client, ccalgo);\n349\t        /* request logs */\n350\t        test_ctx->qserver->use_long_log = 1;\n351\t        picoquic_set_qlog(test_ctx->qserver, \".\");\n352\t        test_ctx->qclient->use_long_log = 1;\n353\t        picoquic_set_qlog(test_ctx->qclient, \".\");\n354\t        /* set latency to non default, if desired */\n355\t        if (dg_ctx->link_latency != 0) {\n356\t            test_ctx->c_to_s_link->microsec_latency = dg_ctx->link_latency;\n357\t            test_ctx->s_to_c_link->microsec_latency = dg_ctx->link_latency;\n358\t        }\n359\t        if (dg_ctx->picosec_per_byte != 0) {\n360\t            test_ctx->c_to_s_link->picosec_per_byte = dg_ctx->picosec_per_byte;\n361\t            test_ctx->s_to_c_link->picosec_per_byte = dg_ctx->picosec_per_byte;\n362\t        }\n363\t        /* Set parameters */\n364\t        picoquic_init_transport_parameters(&client_parameters);\n365\t        client_parameters.max_datagram_frame_size = dg_ctx->dg_max_size;\n366\t        picoquic_set_transport_parameters(test_ctx->cnx_client, &client_parameters);\n367\t        ret = picoquic_start_client_cnx(test_ctx->cnx_client);\n368\t    }\n369\t\n370\t    if (ret == 0) {\n371\t        /* Perform a connection loop to verify it goes OK \n372\t         * If testing WiFi spike, set the queue delay max to a high value.\n373\t         */\n374\t        ret = tls_api_connection_loop(test_ctx, &loss_mask,\n375\t            2 * test_ctx->c_to_s_link->microsec_latency + \n376\t            (dg_ctx->test_wifi)?275000:0, &simulated_time);\n377\t\n378\t        if (ret != 0)\n379\t        {\n380\t            DBG_PRINTF(\"Connection loop returns %d\\n\", ret);\n381\t        }\n382\t        else {\n383\t            /* Verify datagrams are negotiated */\n384\t            if (test_ctx->cnx_client->remote_parameters.max_datagram_frame_size != PICOQUIC_MAX_PACKET_SIZE ||\n385\t                test_ctx->cnx_server->remote_parameters.max_datagram_frame_size != dg_ctx->dg_max_size) {\n386\t                DBG_PRINTF(\"Datagram size badly negotiated: %zu, %zu\",\n387\t                    test_ctx->cnx_client->remote_parameters.max_datagram_frame_size,\n388\t                    test_ctx->cnx_server->remote_parameters.max_datagram_frame_size);\n389\t                ret = -1;\n390\t            }\n391\t        }\n392\t    }\n393\t\n394\t    if (ret == 0 && dg_ctx->test_too_long) {\n395\t        ret = test_datagram_too_long(test_ctx->cnx_client);\n396\t    }\n397\t\n398\t    /* Mark that datagrams are ready */\n399\t    if (ret == 0) {\n400\t        picoquic_mark_datagram_ready(test_ctx->cnx_client, 1);\n401\t        picoquic_mark_datagram_ready(test_ctx->cnx_server, 1);\n402\t        dg_ctx->is_ready[0] = 1;\n403\t        dg_ctx->is_ready[1] = 1;\n404\t        dg_ctx->dg_time_ready[0] = simulated_time;\n405\t        dg_ctx->dg_time_ready[1] = simulated_time;\n406\t    }\n407\t\n408\t    /* Set the loss mask */\n409\t    if (ret == 0) {\n410\t        loss_mask = loss_mask_init;\n411\t    }\n412\t\n413\t    /* Send datagrams for specified time */\n414\t    while (ret == 0 && nb_trials < nb_trial_max && nb_inactive < 16) {\n415\t        int was_active = 0;\n416\t        uint64_t time_out = test_datagram_next_time_ready(dg_ctx);\n417\t\n418\t        nb_trials++;\n419\t\n420\t        if (wifi_todo) {\n421\t            if (simulated_time >= wifi_test_time) {\n422\t                uint64_t resume_time = simulated_time + wifi_interval;\n423\t                picoquic_test_simlink_suspend(test_ctx->c_to_s_link, resume_time, 0);\n424\t                picoquic_test_simlink_suspend(test_ctx->s_to_c_link, resume_time, 1);\n425\t                wifi_todo = 0;\n426\t            }\n427\t            else if (time_out > wifi_test_time) {\n428\t                time_out = wifi_test_time;\n429\t            }\n430\t        }\n431\t\n432\t        ret = tls_api_one_sim_round(test_ctx, &simulated_time, time_out, &was_active);\n433\t\n434\t        if (was_active) {\n435\t            nb_inactive = 0;\n436\t        }\n437\t        else {\n438\t            nb_inactive++;\n439\t        }\n440\t        if (dg_ctx->dg_recv[0] == dg_ctx->dg_target[1] &&\n441\t            dg_ctx->dg_recv[1] == dg_ctx->dg_target[0] &&\n442\t            test_ctx->cnx_client->first_datagram == NULL) {\n443\t            break;\n444\t        }\n445\t        else if ((loss_mask_init != 0 || dg_ctx->test_wifi != 0) &&\n446\t            dg_ctx->dg_sent[0] == dg_ctx->dg_target[0] &&\n447\t            dg_ctx->dg_sent[1] == dg_ctx->dg_target[1]) {\n448\t            if (all_sent_time == 0) {\n449\t                /* Queue a Ping frame to trigger acks */\n450\t                uint8_t ping_frame[] = { picoquic_frame_type_ping };\n451\t                picoquic_queue_misc_frame(test_ctx->cnx_client, ping_frame, sizeof(ping_frame), 0,\n452\t                    picoquic_packet_context_application);\n453\t                picoquic_queue_misc_frame(test_ctx->cnx_server, ping_frame, sizeof(ping_frame), 0,\n454\t                    picoquic_packet_context_application);\n455\t                loss_mask = 0;\n456\t                all_sent_time = simulated_time;\n457\t            }\n458\t            else if (picoquic_is_cnx_backlog_empty(test_ctx->cnx_server)  &&\n459\t                picoquic_is_cnx_backlog_empty(test_ctx->cnx_client) &&\n460\t                test_ctx->cnx_client->first_datagram == NULL)\n461\t            {\n462\t                break;\n463\t            }\n464\t        }\n465\t        /* Simulate wake up when data is ready for real time operation */\n466\t        if (!dg_ctx->is_ready[0] && test_datagram_check_ready(dg_ctx, 0, simulated_time)) {\n467\t            picoquic_mark_datagram_ready(test_ctx->cnx_server, 1);\n468\t        }\n469\t        if (!dg_ctx->is_ready[1] && test_datagram_check_ready(dg_ctx, 1, simulated_time)) {\n470\t            picoquic_mark_datagram_ready(test_ctx->cnx_client, 1);\n471\t        }\n472\t\n473\t        if ((dg_ctx->is_ready[0] && !test_ctx->cnx_server->is_datagram_ready) ||\n474\t            (dg_ctx->is_ready[1] && !test_ctx->cnx_client->is_datagram_ready))\n475\t        {\n476\t            DBG_PRINTF(\"%s\", \"Datagram ready out of synch!\");\n477\t        }\n478\t    }\n479\t\n480\t    if (ret == 0) {\n481\t        if (loss_mask_init == 0  ||\n482\t            (dg_ctx->dg_recv[0] == dg_ctx->dg_target[1] &&\n483\t                dg_ctx->dg_recv[1] == dg_ctx->dg_target[0])) {\n484\t            /* Verify datagrams have been received */\n485\t            if (dg_ctx->dg_recv[0] != dg_ctx->dg_target[1] ||\n486\t                dg_ctx->dg_recv[1] != dg_ctx->dg_target[0]) {\n487\t                DBG_PRINTF(\"Did not receive expected datagrams after %d trials, %d inactive\",\n488\t                    nb_trials, nb_inactive);\n489\t                for (int i = 0; i < 2; i++) {\n490\t                    DBG_PRINTF(\"dg_target[%d]=%d, dg_sent[%d]=%d, dg_recv[%d]=%d\",\n491\t                        i, dg_ctx->dg_target[i], i, dg_ctx->dg_sent[i], 1 - i, dg_ctx->dg_recv[1 - i]);\n492\t                }\n493\t                ret = -1;\n494\t            }\n495\t            /* Verify that all NACK are counted spurious */\n496\t            if (ret == 0 && (\n497\t                dg_ctx->dg_nacked[0] != dg_ctx->dg_spurious[0] ||\n498\t                dg_ctx->dg_nacked[1] != dg_ctx->dg_spurious[1])) {\n499\t                for (int i = 0; i < 2; i++) {\n500\t                    DBG_PRINTF(\"dg_nacked[%d]=%d != dg_spurious[%d]=%d\",\n501\t                        i, dg_ctx->dg_nacked[i], i, dg_ctx->dg_spurious[i]);\n502\t                    DBG_PRINTF(\"dg_nacked[%d]=%d != dg_spurious[%d]=%d\",\n503\t                        i, dg_ctx->dg_nacked[i], i, dg_ctx->dg_spurious[i]);\n504\t                }\n505\t                ret = -1;\n506\t            }\n507\t            /* Verify that the number of packets is as expected */\n508\t            if (ret == 0 && dg_ctx->max_packets_received > 0) {\n509\t                if (test_ctx->cnx_client->nb_packets_received > (uint64_t)dg_ctx->max_packets_received) {\n510\t                    DBG_PRINTF(\"Expected at most %d packets for %d datagrams, batch by %d, got %d\",\n511\t                        dg_ctx->max_packets_received, dg_ctx->dg_recv[1], dg_ctx->batch_size[0], (int)test_ctx->cnx_client->nb_packets_received);\n512\t                    ret = -1;\n513\t                }\n514\t            }\n515\t\n516\t            if (ret == 0 && dg_ctx->duration_max > 0 && dg_ctx->duration_max < simulated_time) {\n517\t                DBG_PRINTF(\"Expected test complete in %\" PRIu64 \", but simulation lasted until %\" PRIu64,\n518\t                    dg_ctx->duration_max, simulated_time);\n519\t                ret = -1;\n520\t\n521\t            }\n522\t        }\n523\t        else {\n524\t            /* In a loss test, check that ACK and NACK are as expected */\n525\t            if (dg_ctx->dg_recv[0] != (dg_ctx->dg_acked[1] + dg_ctx->dg_spurious[1]) ||\n526\t                dg_ctx->dg_recv[1] != (dg_ctx->dg_acked[0] + dg_ctx->dg_spurious[0])) {\n527\t                DBG_PRINTF(\"Did not receive expected datagrams ACKs after %d trials, %d inactive\",\n528\t                    nb_trials, nb_inactive);\n529\t                for (int i = 0; i < 2; i++) {\n530\t                    DBG_PRINTF(\"dg_recv[%d]=%d, dg_acked[%d]=%d, dg_spurious[%d]=%d\",\n531\t                        i, dg_ctx->dg_recv[i], 1 - i, dg_ctx->dg_acked[1 - i], 1 - i, dg_ctx->dg_spurious[1 - i]);\n532\t                }\n533\t                ret = -1;\n534\t            }\n535\t\n536\t            if (ret == 0) {\n537\t                if (dg_ctx->dg_recv[0] + dg_ctx->dg_nacked[1] - dg_ctx->dg_spurious[1] != dg_ctx->dg_sent[1] ||\n538\t                    dg_ctx->dg_recv[1] + dg_ctx->dg_nacked[0] - dg_ctx->dg_spurious[0] != dg_ctx->dg_sent[0]) {\n539\t                    DBG_PRINTF(\"Did not receive expected datagrams NACKs after %d trials, %d inactive\",\n540\t                        nb_trials, nb_inactive);\n541\t                    for (int i = 0; i < 2; i++) {\n542\t                        DBG_PRINTF(\"dg_recv[%d]=%d, dg_nacked[%d]=%d, dg_spurious[%d]=%d, dg_sent[%d]=%d\",\n543\t                            i, dg_ctx->dg_recv[i], 1 - i, dg_ctx->dg_acked[1 - i],\n544\t                            1 - i, dg_ctx->dg_spurious[1 - i], 1 - i, dg_ctx->dg_sent[1 - i]);\n545\t                    }\n546\t                    ret = -1;\n547\t                }\n548\t            }\n549\t        }\n550\t        for (int i = 0; ret == 0 && i < 2; i++) {\n551\t            if (dg_ctx->dg_latency_target[i] > 0 &&\n552\t                dg_ctx->dg_latency_max[i] > dg_ctx->dg_latency_target[i]) {\n553\t                DBG_PRINTF(\"latency max[%d]=%\" PRIu64 \", latency target[%d] = %\" PRIu64,\n554\t                    i, dg_ctx->dg_latency_max[i], i, dg_ctx->dg_latency_target[i]);\n555\t                ret = -1;\n556\t            }\n557\t            if (dg_ctx->dg_number_delta_max[i] > dg_ctx->dg_number_delta_target[i]) {\n558\t                DBG_PRINTF(\"delta number max[%d]=%\" PRIu64 \", delta number max[%d] = %\" PRIu64,\n559\t                    i, dg_ctx->dg_number_delta_max[i], i, dg_ctx->dg_number_delta_target[i]);\n560\t            }\n561\t        }\n562\t    }\n563\t\n564\t    /* And then free the resource */\n565\t\n566\t    if (test_ctx != NULL) {\n567\t        tls_api_delete_ctx(test_ctx);\n568\t        test_ctx = NULL;\n569\t    }\n570\t\n571\t    return ret;\n572\t}\n573\t\n574\tint datagram_test(void)\n575\t{\n576\t    test_datagram_send_recv_ctx_t dg_ctx = { 0 };\n577\t    dg_ctx.dg_max_size = PICOQUIC_MAX_PACKET_SIZE;\n578\t    dg_ctx.dg_target[0] = 5;\n579\t    dg_ctx.dg_target[1] = 5;\n580\t\n581\t    return datagram_test_one(1, &dg_ctx, 0);\n582\t}\n583\t\n584\tint datagram_rt_test(void)\n585\t{\n586\t    test_datagram_send_recv_ctx_t dg_ctx = { 0 };\n587\t    dg_ctx.dg_max_size = PICOQUIC_MAX_PACKET_SIZE;\n588\t    dg_ctx.dg_target[0] = 100;\n589\t    dg_ctx.dg_target[1] = 100;\n590\t    dg_ctx.send_delay = 20000;\n591\t    dg_ctx.next_gen_time[0] = 100000;\n592\t    dg_ctx.next_gen_time[1] = 100000;\n593\t    dg_ctx.dg_latency_target[0] = 18000;\n594\t    dg_ctx.dg_latency_target[1] = 18000;\n595\t\n596\t    return datagram_test_one(2, &dg_ctx, 0);\n597\t}\n598\t\n599\tint datagram_rt_skip_test(void)\n600\t{\n601\t    test_datagram_send_recv_ctx_t dg_ctx = { 0 };\n602\t    dg_ctx.dg_max_size = PICOQUIC_MAX_PACKET_SIZE;\n603\t    dg_ctx.dg_target[0] = 100;\n604\t    dg_ctx.dg_target[1] = 10;\n605\t    dg_ctx.send_delay = 20000;\n606\t    dg_ctx.next_gen_time[0] = 100000;\n607\t    dg_ctx.next_gen_time[1] = 100000;\n608\t    dg_ctx.dg_latency_target[0] = 13000;\n609\t    dg_ctx.dg_latency_target[1] = 20000;\n610\t    dg_ctx.do_skip_test[0] = 1;\n611\t    dg_ctx.do_skip_test[1] = 1;\n612\t\n613\t    return datagram_test_one(3, &dg_ctx, 0);\n614\t}\n615\t\n616\tint datagram_rtnew_skip_test(void)\n617\t{\n618\t    test_datagram_send_recv_ctx_t dg_ctx = { 0 };\n619\t    dg_ctx.dg_max_size = PICOQUIC_MAX_PACKET_SIZE;\n620\t    dg_ctx.dg_target[0] = 100;\n621\t    dg_ctx.dg_target[1] = 10;\n622\t    dg_ctx.send_delay = 20000;\n623\t    dg_ctx.next_gen_time[0] = 100000;\n624\t    dg_ctx.next_gen_time[1] = 100000;\n625\t    dg_ctx.dg_latency_target[0] = 13000;\n626\t    dg_ctx.dg_latency_target[1] = 20000;\n627\t    dg_ctx.do_skip_test[0] = 1;\n628\t    dg_ctx.do_skip_test[1] = 1;\n629\t    dg_ctx.use_extended_provider_api = 1;\n630\t\n631\t    return datagram_test_one(7, &dg_ctx, 0);\n632\t}\n633\t\n634\t\n635\tint datagram_loss_test(void)\n636\t{\n637\t    test_datagram_send_recv_ctx_t dg_ctx = { 0 };\n638\t    dg_ctx.dg_max_size = PICOQUIC_MAX_PACKET_SIZE;\n639\t    dg_ctx.dg_target[0] = 100;\n640\t    dg_ctx.dg_target[1] = 100;\n641\t    dg_ctx.send_delay = 20000;\n642\t    dg_ctx.next_gen_time[0] = 100000;\n643\t    dg_ctx.next_gen_time[1] = 100000;\n644\t\n645\t    return datagram_test_one(4, &dg_ctx, 0x040080100200400ull);\n646\t}\n647\t\n648\tint datagram_size_test(void)\n649\t{\n650\t    test_datagram_send_recv_ctx_t dg_ctx = { 0 };\n651\t    dg_ctx.dg_max_size = 512;\n652\t    dg_ctx.dg_target[0] = 100;\n653\t    dg_ctx.dg_target[1] = 100;\n654\t    dg_ctx.send_delay = 5000;\n655\t\n656\t    return datagram_test_one(5, &dg_ctx, 0);\n657\t}\n658\t\n659\tint datagram_small_test(void)\n660\t{\n661\t    test_datagram_send_recv_ctx_t dg_ctx = { 0 };\n662\t    dg_ctx.dg_max_size = 512;\n663\t    dg_ctx.dg_small_size = 64;\n664\t    dg_ctx.batch_size[0] = 4;\n665\t    dg_ctx.batch_size[1] = 4;\n666\t    dg_ctx.dg_target[0] = 100;\n667\t    dg_ctx.dg_target[1] = 100;\n668\t    dg_ctx.send_delay = 5000;\n669\t    dg_ctx.next_gen_time[0] = 50000;\n670\t    dg_ctx.next_gen_time[1] = 50000;\n671\t    dg_ctx.max_packets_received = 55;\n672\t\n673\t    return datagram_test_one(6, &dg_ctx, 0);\n674\t}\n675\t\n676\tint datagram_small_new_test(void)\n677\t{\n678\t    test_datagram_send_recv_ctx_t dg_ctx = { 0 };\n679\t    dg_ctx.dg_max_size = 512;\n680\t    dg_ctx.dg_small_size = 64;\n681\t    dg_ctx.batch_size[0] = 4;\n682\t    dg_ctx.batch_size[1] = 4;\n683\t    dg_ctx.dg_target[0] = 100;\n684\t    dg_ctx.dg_target[1] = 100;\n685\t    dg_ctx.send_delay = 5000;\n686\t    dg_ctx.next_gen_time[0] = 50000;\n687\t    dg_ctx.next_gen_time[1] = 50000;\n688\t    dg_ctx.max_packets_received = 55;\n689\t    dg_ctx.use_extended_provider_api = 1;\n690\t\n691\t    return datagram_test_one(7, &dg_ctx, 0);\n692\t}\n693\t\n694\tint datagram_wifi_test(void)\n695\t{\n696\t    test_datagram_send_recv_ctx_t dg_ctx = { 0 };\n697\t    dg_ctx.dg_max_size = PICOQUIC_MAX_PACKET_SIZE;\n698\t    dg_ctx.dg_target[0] = 1000;\n699\t    dg_ctx.dg_target[1] = 1000;\n700\t    dg_ctx.send_delay = 2000;\n701\t    dg_ctx.next_gen_time[0] = 100000;\n702\t    dg_ctx.next_gen_time[1] = 100000;\n703\t    dg_ctx.dg_latency_target[0] = 305000;\n704\t    dg_ctx.dg_latency_target[1] = 280000;\n705\t    dg_ctx.test_wifi = 1;\n706\t    dg_ctx.nb_trials_max = 64000;\n707\t    dg_ctx.link_latency = 25000;\n708\t\n709\t    return datagram_test_one(8, &dg_ctx, 0);\n710\t}\n711\t\n712\tint datagram_small_packet_test(void)\n713\t{\n714\t    test_datagram_send_recv_ctx_t dg_ctx = { 0 };\n715\t    dg_ctx.dg_max_size = 512;\n716\t    dg_ctx.dg_small_size = 64;\n717\t    dg_ctx.dg_target[0] = 100;\n718\t    dg_ctx.dg_target[1] = 20000;\n719\t    dg_ctx.send_delay = 100;\n720\t    dg_ctx.next_gen_time[0] = 50000;\n721\t    dg_ctx.next_gen_time[1] = 50000;\n722\t    dg_ctx.link_latency = 10000;\n723\t    dg_ctx.picosec_per_byte = 20000; /* 400 Mbps */\n724\t    dg_ctx.dg_latency_target[0] = 20000;\n725\t    dg_ctx.dg_latency_target[1] = 13500;\n726\t    dg_ctx.use_extended_provider_api = 1;\n727\t    dg_ctx.one_datagram_per_packet = 1;\n728\t    dg_ctx.nb_trials_max = 200000;\n729\t    dg_ctx.duration_max = 2060000;\n730\t\n731\t    return datagram_test_one(9, &dg_ctx, 0);\n732\t}\n733\t\n734\tint datagram_too_long_test(void)\n735\t{\n736\t    test_datagram_send_recv_ctx_t dg_ctx = { 0 };\n737\t    dg_ctx.dg_max_size = PICOQUIC_MAX_PACKET_SIZE;\n738\t    dg_ctx.dg_target[0] = 5;\n739\t    dg_ctx.dg_target[1] = 5;\n740\t    dg_ctx.test_too_long = 1;\n741\t\n742\t    return datagram_test_one(10, &dg_ctx, 0);\n743\t}\n744\t"}]},"parent_tool_use_id":null,"session_id":"5cc9d803-73c1-43c9-a3eb-598e27889782","uuid":"1bf2a562-673a-4493-b593-fd1487a46110","timestamp":"2026-05-04T23:21:36.443Z","tool_use_result":{"type":"text","file":{"filePath":"/Users/richbarn/Projects/picoquic/picoquictest/datagram_tests.c","content":"/*\n* Author: Christian Huitema\n* Copyright (c) 2021, Private Octopus, Inc.\n* All rights reserved.\n*\n* Permission to use, copy, modify, and distribute this software for any\n* purpose with or without fee is hereby granted, provided that the above\n* copyright notice and this permission notice appear in all copies.\n*\n* THIS SOFTWARE IS PROVIDED BY THE COPYRIGHT HOLDERS AND CONTRIBUTORS \"AS IS\" AND\n* ANY EXPRESS OR IMPLIED WARRANTIES, INCLUDING, BUT NOT LIMITED TO, THE IMPLIED\n* WARRANTIES OF MERCHANTABILITY AND FITNESS FOR A PARTICULAR PURPOSE ARE\n* DISCLAIMED. IN NO EVENT SHALL Private Octopus, Inc. BE LIABLE FOR ANY\n* DIRECT, INDIRECT, INCIDENTAL, SPECIAL, EXEMPLARY, OR CONSEQUENTIAL DAMAGES\n* (INCLUDING, BUT NOT LIMITED TO, PROCUREMENT OF SUBSTITUTE GOODS OR SERVICES;\n* LOSS OF USE, DATA, OR PROFITS; OR BUSINESS INTERRUPTION) HOWEVER CAUSED AND\n* ON ANY THEORY OF LIABILITY, WHETHER IN CONTRACT, STRICT LIABILITY, OR TORT\n* (INCLUDING NEGLIGENCE OR OTHERWISE) ARISING IN ANY WAY OUT OF THE USE OF THIS\n* SOFTWARE, EVEN IF ADVISED OF THE POSSIBILITY OF SUCH DAMAGE.\n*/\n\n/*\n* Datagram communication tests.\n*/\n\n\n#include \"picoquic_internal.h\"\n#include \"picoquic_utils.h\"\n#include \"tls_api.h\"\n#include \"picoquictest_internal.h\"\n#ifdef _WINDOWS\n#include \"wincompat.h\"\n#pragma warning(disable:4204)\n#endif\n#include <picotls.h>\n#include <stddef.h>\n#include <stdlib.h>\n#include <string.h>\n#include \"picoquic_binlog.h\"\n#include \"csv.h\"\n#include \"qlog.h\"\n#include \"autoqlog.h\"\n#include \"picoquic_logger.h\"\n#include \"performance_log.h\"\n#include \"picoquictest.h\"\n#include \"picoquic_bbr.h\"\n/*\n * Test whether datagrams are sent and received properly\n */\n\n\nuint64_t test_datagram_next_time_ready(test_datagram_send_recv_ctx_t* dg_ctx)\n{\n    uint64_t next_time = 0;\n\n    for (int client_mode = 0; client_mode < 2; client_mode++) {\n        if (!dg_ctx->is_ready[client_mode] && dg_ctx->dg_sent[client_mode] < dg_ctx->dg_target[client_mode]\n            && (dg_ctx->next_gen_time[client_mode] < next_time || next_time == 0)) {\n            next_time = dg_ctx->next_gen_time[client_mode];\n        }\n    }\n    return next_time;\n}\n\nint test_datagram_check_ready(test_datagram_send_recv_ctx_t* dg_ctx, int client_mode, uint64_t current_time)\n{\n    if (!dg_ctx->is_ready[client_mode] && dg_ctx->dg_sent[client_mode] < dg_ctx->dg_target[client_mode] &&\n        current_time >= dg_ctx->next_gen_time[client_mode]) {\n        dg_ctx->is_ready[client_mode] = 1;\n        dg_ctx->dg_time_ready[client_mode] = current_time;\n    }\n    return dg_ctx->is_ready[client_mode];\n}\n\nint test_datagram_send(picoquic_cnx_t* cnx, uint64_t unique_path_id,\n    uint8_t* bytes, size_t length, void* datagram_ctx)\n{\n    int ret = 0;\n    int skipping = 0;\n    int is_active = 1;\n    size_t available = 0;\n    test_datagram_send_recv_ctx_t* dg_ctx = datagram_ctx;\n    uint64_t current_time = picoquic_get_quic_time(picoquic_get_quic_ctx(cnx));\n\n    if (!cnx->client_mode && length > dg_ctx->dg_max_size) {\n        ret = -1;\n    }\n    else if (length < 24) {\n        ret = 0;\n    }\n    else if (dg_ctx->do_skip_test[cnx->client_mode] && !dg_ctx->is_skipping[cnx->client_mode]){\n        dg_ctx->is_skipping[cnx->client_mode] = 1;\n        skipping = 1;\n        if (dg_ctx->use_extended_provider_api) {\n            is_active = test_datagram_check_ready(dg_ctx, cnx->client_mode, current_time);\n            (void)picoquic_provide_datagram_buffer_ex(bytes, 0, (is_active && !dg_ctx->one_datagram_per_packet));\n        }\n    }\n    else if (!dg_ctx->is_ready[cnx->client_mode] || (dg_ctx->test_affinity && unique_path_id != 0)) {\n        /* Datagram callback when the client was not ready. */\n        is_active = 0;\n        (void)picoquic_provide_datagram_buffer_ex(bytes, 0, (picoquic_datagram_active_enum)0);\n    }\n    else {\n        uint8_t* buffer = NULL;\n\n        dg_ctx->is_skipping[cnx->client_mode] = 0;\n        available = length - (size_t)(dg_ctx->dg_sent[cnx->client_mode]%6) - 8;\n\n        if (dg_ctx->dg_small_size > 0){\n            if (available >= dg_ctx->dg_small_size) {\n                available = dg_ctx->dg_small_size;\n            }\n            else {\n                available = 0;\n            }\n        }\n        if (dg_ctx->use_extended_provider_api) {\n            picoquic_datagram_active_enum is_active = picoquic_datagram_active_any_path;\n            if (dg_ctx->test_affinity) {\n                is_active = picoquic_datagram_active_this_path_only;\n            }\n            is_active &= !dg_ctx->one_datagram_per_packet;\n            buffer = picoquic_provide_datagram_buffer_ex(bytes, available, is_active);\n            dg_ctx->is_ready[cnx->client_mode] = is_active;\n        }\n        else {\n            buffer = picoquic_provide_datagram_buffer(bytes, available);\n        }\n        if (buffer != NULL) {\n            uint8_t* buffer_bytes;\n            uint64_t send_time = (dg_ctx->dg_sent[cnx->client_mode] == 0) ? current_time : dg_ctx->dg_time_ready[cnx->client_mode];\n            dg_ctx->dg_sent[cnx->client_mode]++;\n\n            if ((buffer_bytes = picoquic_frames_uint64_encode(buffer, buffer + available,\n                dg_ctx->dg_sent[cnx->client_mode])) == NULL ||\n                (buffer_bytes = picoquic_frames_uint64_encode(buffer_bytes, buffer + available,\n                    send_time)) == NULL) {\n                ret = -1;\n            }\n            else {\n                memset(buffer_bytes, 'd', available - (buffer_bytes - buffer));\n                if (dg_ctx->batch_size[cnx->client_mode] == 0 ||\n                    (dg_ctx->dg_sent[cnx->client_mode] % dg_ctx->batch_size[cnx->client_mode]) == 0) {\n                    dg_ctx->next_gen_time[cnx->client_mode] += dg_ctx->send_delay;\n                    dg_ctx->is_ready[cnx->client_mode] = 0;\n                }\n            }\n        }\n        else {\n            ret = -1;\n        }\n    }\n\n    if (ret == 0 && !skipping && !dg_ctx->use_extended_provider_api) {\n        (void)test_datagram_check_ready(dg_ctx, cnx->client_mode, current_time);\n        if (dg_ctx->test_affinity) {\n            picoquic_mark_datagram_ready_path(cnx, 0, dg_ctx->is_ready[cnx->client_mode]);\n        }\n        else {\n            picoquic_mark_datagram_ready(cnx, dg_ctx->is_ready[cnx->client_mode]);\n        }\n    }\n    return ret;\n}\n\nint test_datagram_recv(picoquic_cnx_t* cnx, uint64_t unique_path_id,\n    uint8_t* bytes, size_t length, void* datagram_ctx)\n{\n    test_datagram_send_recv_ctx_t* dg_ctx = datagram_ctx;\n    dg_ctx->dg_recv[cnx->client_mode] += 1;\n\n    if (length > 16) {\n        uint64_t current_time = picoquic_get_quic_time(picoquic_get_quic_ctx(cnx));\n        const uint8_t* dg_bytes;\n        uint64_t time_sent;\n        uint64_t number_sent;\n\n        if (unique_path_id == 0) {\n            dg_ctx->nb_recv_path_0[cnx->client_mode] += 1;\n        }\n        else {\n            dg_ctx->nb_recv_path_other[cnx->client_mode] += 1;\n        }\n\n        if ((dg_bytes = picoquic_frames_uint64_decode(bytes, bytes + length, &number_sent)) != NULL &&\n            (dg_bytes = picoquic_frames_uint64_decode(dg_bytes, bytes + length, &time_sent)) != NULL &&\n             time_sent <= current_time ) {\n            uint64_t latency = current_time - time_sent;\n            \n            if (latency > dg_ctx->dg_latency_max[cnx->client_mode]) {\n                dg_ctx->dg_latency_max[cnx->client_mode] = latency;\n            }\n            if (number_sent >= dg_ctx->dg_received_last[cnx->client_mode]) {\n                dg_ctx->dg_received_last[cnx->client_mode] = number_sent;\n            }\n            else {\n                uint64_t number_delta = dg_ctx->dg_received_last[cnx->client_mode] - number_sent;\n                if (number_delta > dg_ctx->dg_number_delta_max[cnx->client_mode]) {\n                    dg_ctx->dg_number_delta_max[cnx->client_mode] = number_sent;\n                }\n            }\n        }\n    }\n    return 0;\n}\n\nint test_datagram_ack(picoquic_cnx_t* cnx,\n    picoquic_call_back_event_t d_event, uint8_t* UNUSED(bytes), size_t UNUSED(length), uint64_t UNUSED(sent_time), void* datagram_ctx)\n{\n    int ret = 0;\n    test_datagram_send_recv_ctx_t* dg_ctx = datagram_ctx;\n    switch (d_event) {\n    case picoquic_callback_datagram_acked:\n        dg_ctx->dg_acked[cnx->client_mode] += 1;\n        break;\n    case picoquic_callback_datagram_lost:\n        dg_ctx->dg_nacked[cnx->client_mode] += 1;\n        break;\n    case picoquic_callback_datagram_spurious:\n        dg_ctx->dg_spurious[cnx->client_mode] += 1;\n        break;\n    default:\n        ret = -1;\n        break;\n    }\n    return ret;\n}\n\n\n/* Datagram too long tests.\n* we want to test what happens if the application uses the \"queue\" API\n* to queue datagrams that are too long. We need to test several conditions:\n*\n* - max packet size -- should be rejected immediately\n* - more than MTU+29 -- should be rejected immediately\n* - faking it: set the MTU larger than necessary to bypass the test,\n*   then reset it. Datagram should be deleted in the send loop\n*   and the send loop should proceed.\n* - exactly + 29 -- should be accepted and should succeed\n*/\n\nint test_datagram_too_long(picoquic_cnx_t* cnx)\n{\n    int ret = 0;\n    int q_ret = 0;\n    uint8_t buffer[PICOQUIC_MAX_PACKET_SIZE];\n    size_t pmtu = cnx->path[0]->send_mtu;\n\n    memset(buffer, 0xda, PICOQUIC_MAX_PACKET_SIZE);\n    if ((q_ret = picoquic_queue_datagram_frame(cnx, PICOQUIC_MAX_PACKET_SIZE, buffer)) == 0) {\n        DBG_PRINTF(\"Submit packet of size %d is accepted, ret = %x\", PICOQUIC_MAX_PACKET_SIZE, q_ret);\n        ret = -1;\n    }\n\n    if (ret == 0) {\n        memset(buffer, 0xdb, PICOQUIC_MAX_PACKET_SIZE);\n        if ((q_ret = picoquic_queue_datagram_frame(cnx, pmtu, buffer)) == 0) {\n            DBG_PRINTF(\"Submit packet of size %d is accepted, ret = %x\", pmtu, q_ret);\n            ret = -1;\n        }\n    }\n\n    if (ret == 0) {\n        memset(buffer, 0xdc, PICOQUIC_MAX_PACKET_SIZE);\n        if ((q_ret = picoquic_queue_datagram_frame(cnx, pmtu - 20 - cnx->quic->local_cnxid_length, buffer)) == 0) {\n            DBG_PRINTF(\"Submit packet of size %d is accepted, ret = %x\", pmtu - 28, q_ret);\n            ret = -1;\n        }\n    }\n\n    if (ret == 0) {\n        memset(buffer, 0xdd, PICOQUIC_MAX_PACKET_SIZE);\n        cnx->path[0]->send_mtu = 1500;\n        if ((q_ret = picoquic_queue_datagram_frame(cnx, 1450, buffer)) != 0) {\n            DBG_PRINTF(\"Submit packet of size %d is not accepted, ret = %x\", 1450, q_ret);\n            ret = -1;\n        }\n        cnx->path[0]->send_mtu = pmtu;\n    }\n\n    if (ret == 0) {\n        size_t dg_overhead = 1 + cnx->quic->local_cnxid_length + 1 + 1 + 16;\n        memset(buffer, 0xde, PICOQUIC_MAX_PACKET_SIZE);\n        cnx->path[0]->send_mtu = 1500;\n        if ((q_ret = picoquic_queue_datagram_frame(cnx, pmtu - dg_overhead, buffer)) != 0) {\n            DBG_PRINTF(\"Submit packet of size %d is not accepted, ret = %x\", pmtu - dg_overhead, q_ret);\n            ret = -1;\n        }\n        cnx->path[0]->send_mtu = pmtu;\n    }\n\n    if (ret == 0) {\n        size_t dg_overhead = 1 + cnx->quic->local_cnxid_length + 1 + 1 + 16;\n        memset(buffer, 0xde, PICOQUIC_MAX_PACKET_SIZE);\n        cnx->path[0]->send_mtu = 1500;\n        if ((q_ret = picoquic_queue_datagram_frame(cnx, pmtu - dg_overhead - 1, buffer)) != 0) {\n            DBG_PRINTF(\"Submit packet of size %d is not accepted, ret = %x\", pmtu - dg_overhead - 1, q_ret);\n            ret = -1;\n        }\n        cnx->path[0]->send_mtu = pmtu;\n    }\n\n    if (ret == 0) {\n        size_t dg_overhead = 1 + cnx->quic->local_cnxid_length + 4 + 1 + 16;\n        if ((q_ret = picoquic_queue_datagram_frame(cnx, pmtu - dg_overhead - 1, buffer)) != 0) {\n            DBG_PRINTF(\"Submit packet of size %d is not accepted, ret = %x\", pmtu - dg_overhead - 1, q_ret);\n        }\n        cnx->path[0]->send_mtu = pmtu;\n    }\n\n    return ret;\n}\n\nint datagram_test_one(uint8_t test_id, test_datagram_send_recv_ctx_t *dg_ctx, uint64_t loss_mask_init)\n{\n    uint64_t simulated_time = 0;\n    uint64_t loss_mask = 0;\n    uint64_t all_sent_time = 0;\n    picoquic_test_tls_api_ctx_t* test_ctx = NULL;\n    picoquic_connection_id_t initial_cid = { {0xda, 0xda, 0x01, 0, 0, 0, 0, 0}, 8 };\n    picoquic_congestion_algorithm_t* ccalgo = picoquic_bbr_algorithm;\n    /* picoquic_tp_t server_parameters; */\n    picoquic_tp_t client_parameters;\n    int nb_trials = 0;\n    int nb_inactive = 0;\n    int ret;\n    int wifi_todo = dg_ctx->test_wifi;\n    uint64_t wifi_test_time = 1000000;\n    uint64_t wifi_interval = 250000;\n    int nb_trial_max = (dg_ctx->nb_trials_max == 0) ? 2048 : dg_ctx->nb_trials_max;\n\n\n    initial_cid.id[3] = test_id;\n\n    ret = tls_api_init_ctx_ex(&test_ctx, PICOQUIC_INTERNAL_TEST_VERSION_1,\n        PICOQUIC_TEST_SNI, PICOQUIC_TEST_ALPN, &simulated_time, NULL, NULL, 0, 1, 0,\n        &initial_cid);\n    \n    if (ret == 0) {\n        /* Set the test contexts for sending and receiving datagrams */\n        test_ctx->datagram_ctx = dg_ctx;\n        test_ctx->datagram_recv_fn = test_datagram_recv;\n        test_ctx->datagram_send_fn = test_datagram_send;\n        test_ctx->datagram_ack_fn = test_datagram_ack;\n        /* Set the congestion control  */\n        picoquic_set_default_congestion_algorithm(test_ctx->qserver, ccalgo);\n        picoquic_set_congestion_algorithm(test_ctx->cnx_client, ccalgo);\n        /* request logs */\n        test_ctx->qserver->use_long_log = 1;\n        picoquic_set_qlog(test_ctx->qserver, \".\");\n        test_ctx->qclient->use_long_log = 1;\n        picoquic_set_qlog(test_ctx->qclient, \".\");\n        /* set latency to non default, if desired */\n        if (dg_ctx->link_latency != 0) {\n            test_ctx->c_to_s_link->microsec_latency = dg_ctx->link_latency;\n            test_ctx->s_to_c_link->microsec_latency = dg_ctx->link_latency;\n        }\n        if (dg_ctx->picosec_per_byte != 0) {\n            test_ctx->c_to_s_link->picosec_per_byte = dg_ctx->picosec_per_byte;\n            test_ctx->s_to_c_link->picosec_per_byte = dg_ctx->picosec_per_byte;\n        }\n        /* Set parameters */\n        picoquic_init_transport_parameters(&client_parameters);\n        client_parameters.max_datagram_frame_size = dg_ctx->dg_max_size;\n        picoquic_set_transport_parameters(test_ctx->cnx_client, &client_parameters);\n        ret = picoquic_start_client_cnx(test_ctx->cnx_client);\n    }\n\n    if (ret == 0) {\n        /* Perform a connection loop to verify it goes OK \n         * If testing WiFi spike, set the queue delay max to a high value.\n         */\n        ret = tls_api_connection_loop(test_ctx, &loss_mask,\n            2 * test_ctx->c_to_s_link->microsec_latency + \n            (dg_ctx->test_wifi)?275000:0, &simulated_time);\n\n        if (ret != 0)\n        {\n            DBG_PRINTF(\"Connection loop returns %d\\n\", ret);\n        }\n        else {\n            /* Verify datagrams are negotiated */\n            if (test_ctx->cnx_client->remote_parameters.max_datagram_frame_size != PICOQUIC_MAX_PACKET_SIZE ||\n                test_ctx->cnx_server->remote_parameters.max_datagram_frame_size != dg_ctx->dg_max_size) {\n                DBG_PRINTF(\"Datagram size badly negotiated: %zu, %zu\",\n                    test_ctx->cnx_client->remote_parameters.max_datagram_frame_size,\n                    test_ctx->cnx_server->remote_parameters.max_datagram_frame_size);\n                ret = -1;\n            }\n        }\n    }\n\n    if (ret == 0 && dg_ctx->test_too_long) {\n        ret = test_datagram_too_long(test_ctx->cnx_client);\n    }\n\n    /* Mark that datagrams are ready */\n    if (ret == 0) {\n        picoquic_mark_datagram_ready(test_ctx->cnx_client, 1);\n        picoquic_mark_datagram_ready(test_ctx->cnx_server, 1);\n        dg_ctx->is_ready[0] = 1;\n        dg_ctx->is_ready[1] = 1;\n        dg_ctx->dg_time_ready[0] = simulated_time;\n        dg_ctx->dg_time_ready[1] = simulated_time;\n    }\n\n    /* Set the loss mask */\n    if (ret == 0) {\n        loss_mask = loss_mask_init;\n    }\n\n    /* Send datagrams for specified time */\n    while (ret == 0 && nb_trials < nb_trial_max && nb_inactive < 16) {\n        int was_active = 0;\n        uint64_t time_out = test_datagram_next_time_ready(dg_ctx);\n\n        nb_trials++;\n\n        if (wifi_todo) {\n            if (simulated_time >= wifi_test_time) {\n                uint64_t resume_time = simulated_time + wifi_interval;\n                picoquic_test_simlink_suspend(test_ctx->c_to_s_link, resume_time, 0);\n                picoquic_test_simlink_suspend(test_ctx->s_to_c_link, resume_time, 1);\n                wifi_todo = 0;\n            }\n            else if (time_out > wifi_test_time) {\n                time_out = wifi_test_time;\n            }\n        }\n\n        ret = tls_api_one_sim_round(test_ctx, &simulated_time, time_out, &was_active);\n\n        if (was_active) {\n            nb_inactive = 0;\n        }\n        else {\n            nb_inactive++;\n        }\n        if (dg_ctx->dg_recv[0] == dg_ctx->dg_target[1] &&\n            dg_ctx->dg_recv[1] == dg_ctx->dg_target[0] &&\n            test_ctx->cnx_client->first_datagram == NULL) {\n            break;\n        }\n        else if ((loss_mask_init != 0 || dg_ctx->test_wifi != 0) &&\n            dg_ctx->dg_sent[0] == dg_ctx->dg_target[0] &&\n            dg_ctx->dg_sent[1] == dg_ctx->dg_target[1]) {\n            if (all_sent_time == 0) {\n                /* Queue a Ping frame to trigger acks */\n                uint8_t ping_frame[] = { picoquic_frame_type_ping };\n                picoquic_queue_misc_frame(test_ctx->cnx_client, ping_frame, sizeof(ping_frame), 0,\n                    picoquic_packet_context_application);\n                picoquic_queue_misc_frame(test_ctx->cnx_server, ping_frame, sizeof(ping_frame), 0,\n                    picoquic_packet_context_application);\n                loss_mask = 0;\n                all_sent_time = simulated_time;\n            }\n            else if (picoquic_is_cnx_backlog_empty(test_ctx->cnx_server)  &&\n                picoquic_is_cnx_backlog_empty(test_ctx->cnx_client) &&\n                test_ctx->cnx_client->first_datagram == NULL)\n            {\n                break;\n            }\n        }\n        /* Simulate wake up when data is ready for real time operation */\n        if (!dg_ctx->is_ready[0] && test_datagram_check_ready(dg_ctx, 0, simulated_time)) {\n            picoquic_mark_datagram_ready(test_ctx->cnx_server, 1);\n        }\n        if (!dg_ctx->is_ready[1] && test_datagram_check_ready(dg_ctx, 1, simulated_time)) {\n            picoquic_mark_datagram_ready(test_ctx->cnx_client, 1);\n        }\n\n        if ((dg_ctx->is_ready[0] && !test_ctx->cnx_server->is_datagram_ready) ||\n            (dg_ctx->is_ready[1] && !test_ctx->cnx_client->is_datagram_ready))\n        {\n            DBG_PRINTF(\"%s\", \"Datagram ready out of synch!\");\n        }\n    }\n\n    if (ret == 0) {\n        if (loss_mask_init == 0  ||\n            (dg_ctx->dg_recv[0] == dg_ctx->dg_target[1] &&\n                dg_ctx->dg_recv[1] == dg_ctx->dg_target[0])) {\n            /* Verify datagrams have been received */\n            if (dg_ctx->dg_recv[0] != dg_ctx->dg_target[1] ||\n                dg_ctx->dg_recv[1] != dg_ctx->dg_target[0]) {\n                DBG_PRINTF(\"Did not receive expected datagrams after %d trials, %d inactive\",\n                    nb_trials, nb_inactive);\n                for (int i = 0; i < 2; i++) {\n                    DBG_PRINTF(\"dg_target[%d]=%d, dg_sent[%d]=%d, dg_recv[%d]=%d\",\n                        i, dg_ctx->dg_target[i], i, dg_ctx->dg_sent[i], 1 - i, dg_ctx->dg_recv[1 - i]);\n                }\n                ret = -1;\n            }\n            /* Verify that all NACK are counted spurious */\n            if (ret == 0 && (\n                dg_ctx->dg_nacked[0] != dg_ctx->dg_spurious[0] ||\n                dg_ctx->dg_nacked[1] != dg_ctx->dg_spurious[1])) {\n                for (int i = 0; i < 2; i++) {\n                    DBG_PRINTF(\"dg_nacked[%d]=%d != dg_spurious[%d]=%d\",\n                        i, dg_ctx->dg_nacked[i], i, dg_ctx->dg_spurious[i]);\n                    DBG_PRINTF(\"dg_nacked[%d]=%d != dg_spurious[%d]=%d\",\n                        i, dg_ctx->dg_nacked[i], i, dg_ctx->dg_spurious[i]);\n                }\n                ret = -1;\n            }\n            /* Verify that the number of packets is as expected */\n            if (ret == 0 && dg_ctx->max_packets_received > 0) {\n                if (test_ctx->cnx_client->nb_packets_received > (uint64_t)dg_ctx->max_packets_received) {\n                    DBG_PRINTF(\"Expected at most %d packets for %d datagrams, batch by %d, got %d\",\n                        dg_ctx->max_packets_received, dg_ctx->dg_recv[1], dg_ctx->batch_size[0], (int)test_ctx->cnx_client->nb_packets_received);\n                    ret = -1;\n                }\n            }\n\n            if (ret == 0 && dg_ctx->duration_max > 0 && dg_ctx->duration_max < simulated_time) {\n                DBG_PRINTF(\"Expected test complete in %\" PRIu64 \", but simulation lasted until %\" PRIu64,\n                    dg_ctx->duration_max, simulated_time);\n                ret = -1;\n\n            }\n        }\n        else {\n            /* In a loss test, check that ACK and NACK are as expected */\n            if (dg_ctx->dg_recv[0] != (dg_ctx->dg_acked[1] + dg_ctx->dg_spurious[1]) ||\n                dg_ctx->dg_recv[1] != (dg_ctx->dg_acked[0] + dg_ctx->dg_spurious[0])) {\n                DBG_PRINTF(\"Did not receive expected datagrams ACKs after %d trials, %d inactive\",\n                    nb_trials, nb_inactive);\n                for (int i = 0; i < 2; i++) {\n                    DBG_PRINTF(\"dg_recv[%d]=%d, dg_acked[%d]=%d, dg_spurious[%d]=%d\",\n                        i, dg_ctx->dg_recv[i], 1 - i, dg_ctx->dg_acked[1 - i], 1 - i, dg_ctx->dg_spurious[1 - i]);\n                }\n                ret = -1;\n            }\n\n            if (ret == 0) {\n                if (dg_ctx->dg_recv[0] + dg_ctx->dg_nacked[1] - dg_ctx->dg_spurious[1] != dg_ctx->dg_sent[1] ||\n                    dg_ctx->dg_recv[1] + dg_ctx->dg_nacked[0] - dg_ctx->dg_spurious[0] != dg_ctx->dg_sent[0]) {\n                    DBG_PRINTF(\"Did not receive expected datagrams NACKs after %d trials, %d inactive\",\n                        nb_trials, nb_inactive);\n                    for (int i = 0; i < 2; i++) {\n                        DBG_PRINTF(\"dg_recv[%d]=%d, dg_nacked[%d]=%d, dg_spurious[%d]=%d, dg_sent[%d]=%d\",\n                            i, dg_ctx->dg_recv[i], 1 - i, dg_ctx->dg_acked[1 - i],\n                            1 - i, dg_ctx->dg_spurious[1 - i], 1 - i, dg_ctx->dg_sent[1 - i]);\n                    }\n                    ret = -1;\n                }\n            }\n        }\n        for (int i = 0; ret == 0 && i < 2; i++) {\n            if (dg_ctx->dg_latency_target[i] > 0 &&\n                dg_ctx->dg_latency_max[i] > dg_ctx->dg_latency_target[i]) {\n                DBG_PRINTF(\"latency max[%d]=%\" PRIu64 \", latency target[%d] = %\" PRIu64,\n                    i, dg_ctx->dg_latency_max[i], i, dg_ctx->dg_latency_target[i]);\n                ret = -1;\n            }\n            if (dg_ctx->dg_number_delta_max[i] > dg_ctx->dg_number_delta_target[i]) {\n                DBG_PRINTF(\"delta number max[%d]=%\" PRIu64 \", delta number max[%d] = %\" PRIu64,\n                    i, dg_ctx->dg_number_delta_max[i], i, dg_ctx->dg_number_delta_target[i]);\n            }\n        }\n    }\n\n    /* And then free the resource */\n\n    if (test_ctx != NULL) {\n        tls_api_delete_ctx(test_ctx);\n        test_ctx = NULL;\n    }\n\n    return ret;\n}\n\nint datagram_test(void)\n{\n    test_datagram_send_recv_ctx_t dg_ctx = { 0 };\n    dg_ctx.dg_max_size = PICOQUIC_MAX_PACKET_SIZE;\n    dg_ctx.dg_target[0] = 5;\n    dg_ctx.dg_target[1] = 5;\n\n    return datagram_test_one(1, &dg_ctx, 0);\n}\n\nint datagram_rt_test(void)\n{\n    test_datagram_send_recv_ctx_t dg_ctx = { 0 };\n    dg_ctx.dg_max_size = PICOQUIC_MAX_PACKET_SIZE;\n    dg_ctx.dg_target[0] = 100;\n    dg_ctx.dg_target[1] = 100;\n    dg_ctx.send_delay = 20000;\n    dg_ctx.next_gen_time[0] = 100000;\n    dg_ctx.next_gen_time[1] = 100000;\n    dg_ctx.dg_latency_target[0] = 18000;\n    dg_ctx.dg_latency_target[1] = 18000;\n\n    return datagram_test_one(2, &dg_ctx, 0);\n}\n\nint datagram_rt_skip_test(void)\n{\n    test_datagram_send_recv_ctx_t dg_ctx = { 0 };\n    dg_ctx.dg_max_size = PICOQUIC_MAX_PACKET_SIZE;\n    dg_ctx.dg_target[0] = 100;\n    dg_ctx.dg_target[1] = 10;\n    dg_ctx.send_delay = 20000;\n    dg_ctx.next_gen_time[0] = 100000;\n    dg_ctx.next_gen_time[1] = 100000;\n    dg_ctx.dg_latency_target[0] = 13000;\n    dg_ctx.dg_latency_target[1] = 20000;\n    dg_ctx.do_skip_test[0] = 1;\n    dg_ctx.do_skip_test[1] = 1;\n\n    return datagram_test_one(3, &dg_ctx, 0);\n}\n\nint datagram_rtnew_skip_test(void)\n{\n    test_datagram_send_recv_ctx_t dg_ctx = { 0 };\n    dg_ctx.dg_max_size = PICOQUIC_MAX_PACKET_SIZE;\n    dg_ctx.dg_target[0] = 100;\n    dg_ctx.dg_target[1] = 10;\n    dg_ctx.send_delay = 20000;\n    dg_ctx.next_gen_time[0] = 100000;\n    dg_ctx.next_gen_time[1] = 100000;\n    dg_ctx.dg_latency_target[0] = 13000;\n    dg_ctx.dg_latency_target[1] = 20000;\n    dg_ctx.do_skip_test[0] = 1;\n    dg_ctx.do_skip_test[1] = 1;\n    dg_ctx.use_extended_provider_api = 1;\n\n    return datagram_test_one(7, &dg_ctx, 0);\n}\n\n\nint datagram_loss_test(void)\n{\n    test_datagram_send_recv_ctx_t dg_ctx = { 0 };\n    dg_ctx.dg_max_size = PICOQUIC_MAX_PACKET_SIZE;\n    dg_ctx.dg_target[0] = 100;\n    dg_ctx.dg_target[1] = 100;\n    dg_ctx.send_delay = 20000;\n    dg_ctx.next_gen_time[0] = 100000;\n    dg_ctx.next_gen_time[1] = 100000;\n\n    return datagram_test_one(4, &dg_ctx, 0x040080100200400ull);\n}\n\nint datagram_size_test(void)\n{\n    test_datagram_send_recv_ctx_t dg_ctx = { 0 };\n    dg_ctx.dg_max_size = 512;\n    dg_ctx.dg_target[0] = 100;\n    dg_ctx.dg_target[1] = 100;\n    dg_ctx.send_delay = 5000;\n\n    return datagram_test_one(5, &dg_ctx, 0);\n}\n\nint datagram_small_test(void)\n{\n    test_datagram_send_recv_ctx_t dg_ctx = { 0 };\n    dg_ctx.dg_max_size = 512;\n    dg_ctx.dg_small_size = 64;\n    dg_ctx.batch_size[0] = 4;\n    dg_ctx.batch_size[1] = 4;\n    dg_ctx.dg_target[0] = 100;\n    dg_ctx.dg_target[1] = 100;\n    dg_ctx.send_delay = 5000;\n    dg_ctx.next_gen_time[0] = 50000;\n    dg_ctx.next_gen_time[1] = 50000;\n    dg_ctx.max_packets_received = 55;\n\n    return datagram_test_one(6, &dg_ctx, 0);\n}\n\nint datagram_small_new_test(void)\n{\n    test_datagram_send_recv_ctx_t dg_ctx = { 0 };\n    dg_ctx.dg_max_size = 512;\n    dg_ctx.dg_small_size = 64;\n    dg_ctx.batch_size[0] = 4;\n    dg_ctx.batch_size[1] = 4;\n    dg_ctx.dg_target[0] = 100;\n    dg_ctx.dg_target[1] = 100;\n    dg_ctx.send_delay = 5000;\n    dg_ctx.next_gen_time[0] = 50000;\n    dg_ctx.next_gen_time[1] = 50000;\n    dg_ctx.max_packets_received = 55;\n    dg_ctx.use_extended_provider_api = 1;\n\n    return datagram_test_one(7, &dg_ctx, 0);\n}\n\nint datagram_wifi_test(void)\n{\n    test_datagram_send_recv_ctx_t dg_ctx = { 0 };\n    dg_ctx.dg_max_size = PICOQUIC_MAX_PACKET_SIZE;\n    dg_ctx.dg_target[0] = 1000;\n    dg_ctx.dg_target[1] = 1000;\n    dg_ctx.send_delay = 2000;\n    dg_ctx.next_gen_time[0] = 100000;\n    dg_ctx.next_gen_time[1] = 100000;\n    dg_ctx.dg_latency_target[0] = 305000;\n    dg_ctx.dg_latency_target[1] = 280000;\n    dg_ctx.test_wifi = 1;\n    dg_ctx.nb_trials_max = 64000;\n    dg_ctx.link_latency = 25000;\n\n    return datagram_test_one(8, &dg_ctx, 0);\n}\n\nint datagram_small_packet_test(void)\n{\n    test_datagram_send_recv_ctx_t dg_ctx = { 0 };\n    dg_ctx.dg_max_size = 512;\n    dg_ctx.dg_small_size = 64;\n    dg_ctx.dg_target[0] = 100;\n    dg_ctx.dg_target[1] = 20000;\n    dg_ctx.send_delay = 100;\n    dg_ctx.next_gen_time[0] = 50000;\n    dg_ctx.next_gen_time[1] = 50000;\n    dg_ctx.link_latency = 10000;\n    dg_ctx.picosec_per_byte = 20000; /* 400 Mbps */\n    dg_ctx.dg_latency_target[0] = 20000;\n    dg_ctx.dg_latency_target[1] = 13500;\n    dg_ctx.use_extended_provider_api = 1;\n    dg_ctx.one_datagram_per_packet = 1;\n    dg_ctx.nb_trials_max = 200000;\n    dg_ctx.duration_max = 2060000;\n\n    return datagram_test_one(9, &dg_ctx, 0);\n}\n\nint datagram_too_long_test(void)\n{\n    test_datagram_send_recv_ctx_t dg_ctx = { 0 };\n    dg_ctx.dg_max_size = PICOQUIC_MAX_PACKET_SIZE;\n    dg_ctx.dg_target[0] = 5;\n    dg_ctx.dg_target[1] = 5;\n    dg_ctx.test_too_long = 1;\n\n    return datagram_test_one(10, &dg_ctx, 0);\n}\n","numLines":744,"startLine":1,"totalLines