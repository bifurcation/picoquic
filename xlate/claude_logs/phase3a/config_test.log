{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01M6cTszHAFsaLGeytZ1G2ZL","type":"tool_result","content":"89\t/// Server's preferred address advertised in transport parameters.\n90\t/// At most one IPv4 and at most one IPv6 endpoint may be present;\n91\t/// each socket address (the C `ipvNAddress[]` + `ipvNPort` pair)\n92\t/// folds into an `Option<SocketAddr>`.  C: `TpPreferredAddress`.\n93\t#[derive(Debug, Default, Copy, Clone)]\n94\tpub struct PreferredAddress {\n95\t    /// IPv4 address + port, if the server advertised one.\n96\t    pub v4: Option<SocketAddr>,\n97\t    /// IPv6 address + port, if the server advertised one.\n98\t    pub v6: Option<SocketAddr>,\n99\t    pub connection_id: ConnectionId,\n100\t    pub stateless_reset_token: [u8; 16],\n101\t}\n102\t\n103\t// ---------------------------------------------------------------------------\n104\t// Version-negotiation TP value.\n105\t\n106\t/// Version-negotiation TP payload.  C: `TpVersionNegotiation`.\n107\t/// The C `nb_received` / `nb_supported` length fields disappear\n108\t/// (the `Vec`s carry their lengths).\n109\t#[derive(Debug, Default, Clone)]\n110\tpub struct VersionNegotiation {\n111\t    /// Version found in TP, should match envelope.\n112\t    pub current: u32,\n113\t    /// Version that triggered a previous version negotiation.\n114\t    pub previous: u32,\n115\t    /// Versions received in a prior VN packet (client side only).\n116\t    pub received: Vec<u32>,\n117\t    /// Compatible versions supported by the peer (client side only).\n118\t    pub supported: Vec<u32>,"}]},"parent_tool_use_id":null,"session_id":"d53c3c63-c627-4b47-883a-4097aa7b6589","uuid":"623320ad-70f0-47f3-af4b-26148d0abef9","timestamp":"2026-05-04T22:41:06.398Z","tool_use_result":{"type":"text","file":{"filePath":"/Users/richbarn/Projects/picoquic/rs/fq/src/tp.rs","content":"/// Server's preferred address advertised in transport parameters.\n/// At most one IPv4 and at most one IPv6 endpoint may be present;\n/// each socket address (the C `ipvNAddress[]` + `ipvNPort` pair)\n/// folds into an `Option<SocketAddr>`.  C: `TpPreferredAddress`.\n#[derive(Debug, Default, Copy, Clone)]\npub struct PreferredAddress {\n    /// IPv4 address + port, if the server advertised one.\n    pub v4: Option<SocketAddr>,\n    /// IPv6 address + port, if the server advertised one.\n    pub v6: Option<SocketAddr>,\n    pub connection_id: ConnectionId,\n    pub stateless_reset_token: [u8; 16],\n}\n\n// ---------------------------------------------------------------------------\n// Version-negotiation TP value.\n\n/// Version-negotiation TP payload.  C: `TpVersionNegotiation`.\n/// The C `nb_received` / `nb_supported` length fields disappear\n/// (the `Vec`s carry their lengths).\n#[derive(Debug, Default, Clone)]\npub struct VersionNegotiation {\n    /// Version found in TP, should match envelope.\n    pub current: u32,\n    /// Version that triggered a previous version negotiation.\n    pub previous: u32,\n    /// Versions received in a prior VN packet (client side only).\n    pub received: Vec<u32>,\n    /// Compatible versions supported by the peer (client side only).\n    pub supported: Vec<u32>,","numLines":30,"startLine":89,"totalLines":193}}}
