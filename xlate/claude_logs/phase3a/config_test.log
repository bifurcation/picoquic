rites one bit at a time as a Boolean\n35\t//!   (`config->do_retry = 1`), so the\n36\t//!   integer-with-mask-and-shift translation buys nothing here and\n37\t//!   `bitflags!` is overkill for an unrelated set of flags.\n38\t//! * Bitfield `enable_sslkeylog` is gated by\n39\t//!   `#ifndef WITHOUT_SSLKEYLOG` in C.  v1 follows the\n40\t//!   canonical build (the macro is undefined), so the field is\n41\t//!   always present in Rust; a `cfg`-gated variant lands when the\n42\t//!   build options are translated.\n43\t\n44\tuse crate::Error;\n45\tuse crate::Instant;\n46\tuse crate::{LossbitVersion, Quic, SpinbitVersion, StreamDataCallback};\n47\t\n48\t// ---------------------------------------------------------------------------\n49\t// Option identifiers.\n50\t\n51\t/// One identifier per CLI / API option understood by [`Config`].\n52\t///\n53\t/// Mirrors the C `picoquic_option_enum_t`; variant order is\n54\t/// load-bearing — the option dispatch table in `quic/config.c`\n55\t/// indexes by variant — so the discriminants do not get reordered.\n56\t///\n57\t/// [`OptionId::SslKeyLog`] is unconditional here even though the C\n58\t/// enum gates it on `#ifndef WITHOUT_SSLKEYLOG`, matching the\n59\t/// canonical-build behavior; see the module-level docs for the\n60\t/// rationale.\n61\t#[derive(Debug, Copy, Clone, PartialEq, Eq)]\n62\tpub enum OptionId {\n63\t    Cert,\n64\t    Key,\n65\t    ServerPort,\n66\t    ProposedVersion,\n67\t    OutDir,\n68\t    WwwDir,\n69\t    MaxConnections,\n70\t    DoRetry,\n71\t    InitialRandom,\n72\t    ResetSeed,\n73\t    DisablePortBlocking,\n74\t    SolutionDir,\n75\t    CcAlgo,\n76\t    CcOption,\n77\t    Spinbit,\n78\t    Lossbit,\n79\t    Multipath,\n80\t    DestIf,\n81\t    CipherSuite,\n82\t    InitCnxId,\n83\t    LogFile,\n84\t    LongLog,\n85\t    BinlogDir,\n86\t    QlogDir,\n87\t    MtuMax,\n88\t    Sni,\n89\t    Alpn,\n90\t    RootTrustFile,\n91\t    ForceZeroShare,\n92\t    CnxIdLength,\n93\t    NoDisk,\n94\t    IdleTimeout,\n95\t    LargeClientHello,\n96\t    TicketFileName,\n97\t    TokenFileName,\n98\t    SocketBufferSize,\n99\t    PerformanceLog,\n100\t    PreemptiveRepeat,\n101\t    VersionUpgrade,\n102\t    NoGso,\n103\t    BdpFrame,\n104\t    CwinMax,\n105\t    SslKeyLog,\n106\t    AddressDiscovery,\n107\t    EchServer,\n108\t    EchClient,\n109\t    EchInit,\n110\t    FlowControlMax,\n111\t    PreferredV4,\n112\t    PreferredV6,\n113\t    Help,\n114\t}\n115\t\n116\t// ---------------------------------------------------------------------------\n117\t// Configuration struct.\n118\t\n119\t/// Configuration bag for a QUIC context, populated from CLI flags\n120\t/// (via [`Config::command_line`]) or directly (via\n121\t/// [`Config::set_option`]) and consumed by\n122\t/// [`Config::create_and_configure`].\n123\t///\n124\t/// Mirrors the C `picoquic_quic_config_t` field-for-field;\n125\t/// `repr(C)` is dropped because the struct never crosses an\n126\t/// external boundary.  See the module-level docs for the\n127\t/// pointer-shape rationale.\n128\t///\n129\t/// `Default` produces the documented C defaults:\n130\t/// `nb_connections = 256`, `connection_id_length = -1`, `cwin_max =\n131\t/// u64::MAX`, idle timeout from `MICROSEC_HANDSHAKE_MAX`, etc.  This\n132\t/// folds the C `picoquic_config_init` step into the constructor —\n133\t/// the C `config_clear` (which `free`s every owned string) collapses\n134\t/// to `Drop`, and resetting a config to defaults is just\n135\t/// `*config = Config::default()`.\n136\t#[derive(Debug)]\n137\tpub struct Config {\n138\t    pub nb_connections: u32,\n139\t    pub solution_dir: Option<String>,\n140\t    pub server_cert_file: Option<String>,\n141\t    pub server_key_file: Option<String>,\n142\t    pub log_file: Option<String>,\n143\t    pub bin_dir: Option<String>,\n144\t    pub qlog_dir: Option<String>,\n145\t    pub performance_log: Option<String>,\n146\t    pub server_port: u16,\n147\t    pub local_port: u16,\n148\t    /// Whether the public por