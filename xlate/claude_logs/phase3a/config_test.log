}\n919\t        }\n920\t    }\n921\t    return ret;\n922\t}\n923\t\n924\t/*\n925\t* test of the port setting option.\n926\t*/\n927\t\n928\tint config_set_port(picoquic_quic_config_t* config, char const* port_string);\n929\t\n930\t\n931\ttypedef struct st_test_set_port_t {\n932\t    char const* port_string;\n933\t    int is_valid;\n934\t    uint16_t server_port;\n935\t    uint16_t local_port;\n936\t    uint16_t nb_threads;\n937\t    int is_port_shared;\n938\t} test_set_port_t;\n939\t\n940\ttest_set_port_t test_set_port_cases[] = {\n941\t    { \"4433\", 1, 4433, 0, 0, 0 },\n942\t    { \"443:4434\", 1, 443, 4434, 0, 0 },\n943\t    { \"S4433\", 1, 4433, 0, 0, 1 },\n944\t    { \"S443:4434\", 1, 443, 4434, 0, 1 },\n945\t    { \"S443:4434*\", 1, 443, 4434, 0, 1 },\n946\t    { \"S443:4434*1\", 1, 443, 4434, 1, 1 },\n947\t    { \"S443:4434*256\", 1, 443, 4434, 256, 1 },\n948\t    { \"4433*7\", 1, 4433, 0, 7, 0 },\n949\t    { \"\", 1, 0, 0, 0, 0 },\n950\t    { \"0\", 1, 0, 0, 0, 0 },\n951\t    { \"*5\", 1, 0, 0, 5, 0 },\n952\t    { \"0*3\", 1, 0, 0, 3, 0 },\n953\t    { \"65535\", 1, 65535, 0, 0, 0 },\n954\t    { \"S65535\", 1, 65535, 0, 0, 1 },\n955\t    { \"S65534:65535\", 1, 65534, 65535, 0, 1 },\n956\t    { \"65536\", 0, 0, 0, 0, 0 },\n957\t    { \"-1\", 0, 0, 0, 0, 0 },\n958\t    { \"abc\", 0, 0, 0, 0, 0 },\n959\t    { \"4433:abc\", 0, 0, 0, 0, 0 },\n960\t    { \"abc:4433\", 0, 0, 0, 0, 0 },\n961\t    { \"S4433:abc\", 0, 0, 0, 0, 0 },\n962\t    { \"Sabc:4433\", 0, 0, 0, 0, 0 },\n963\t};\n964\t\n965\tint config_set_port_test(void)\n966\t{\n967\t    int ret = 0;\n968\t    for (size_t i = 0; ret == 0 && i < sizeof(test_set_port_cases) / sizeof(test_set_port_t); i++) {\n969\t        picoquic_quic_config_t config = { 0 };\n970\t        int is_valid = (config_set_port(&config, test_set_port_cases[i].port_string) == 0);\n971\t        if (is_valid != test_set_port_cases[i].is_valid) {\n972\t            DBG_PRINTF(\"Test case %zu: expected validity %d, got %d\", i, test_set_port_cases[i].is_valid, is_valid);\n973\t            ret = -1;\n974\t        }\n975\t        else if (is_valid) {\n976\t            if (config.server_port != test_set_port_cases[i].server_port ||\n977\t                config.local_port != test_set_port_cases[i].local_port ||\n978\t                config.is_port_shared != test_set_port_cases[i].is_port_shared) {\n979\t                DBG_PRINTF(\"Test case %zu: expected and actual port settings differ\", i);\n980\t                ret = -1;\n981\t            }\n982\t        }\n983\t    }\n984\t    return ret;\n985\t}\n986\t"}]},"parent_tool_use_id":null,"session_id":"d53c3c63-c627-4b47-883a-4097aa7b6589","uuid":"6e9e978d-a12d-489d-8cd7-d8aeba8b3a8b","timestamp":"2026-05-04T22:40:50.928Z","tool_use_result":{"type":"text","file":{"filePath":"/Users/richbarn/Projects/picoquic/picoquictest/config_test.c","content":"/*\n* Author: Christian Huitema\n* Copyright (c) 2020, Private Octopus, Inc.\n* All rights reserved.\n*\n* Permission to use, copy, modify, and distribute this software for any\n* purpose with or without fee is hereby granted, provided that the above\n* copyright notice and this permission notice appear in all copies.\n*\n* THIS SOFTWARE IS PROVIDED BY THE COPYRIGHT HOLDERS AND CONTRIBUTORS \"AS IS\" AND\n* ANY EXPRESS OR IMPLIED WARRANTIES, INCLUDING, BUT NOT LIMITED TO, THE IMPLIED\n* WARRANTIES OF MERCHANTABILITY AND FITNESS FOR A PARTICULAR PURPOSE ARE\n* DISCLAIMED. IN NO EVENT SHALL Private Octopus, Inc. BE LIABLE FOR ANY\n* DIRECT, INDIRECT, INCIDENTAL, SPECIAL, EXEMPLARY, OR CONSEQUENTIAL DAMAGES\n* (INCLUDING, BUT NOT LIMITED TO, PROCUREMENT OF SUBSTITUTE GOODS OR SERVICES;\n* LOSS OF USE, DATA, OR PROFITS; OR BUSINESS INTERRUPTION) HOWEVER CAUSED AND\n* ON ANY THEORY OF LIABILITY, WHETHER IN CONTRACT, STRICT LIABILITY, OR TORT\n* (INCLUDING NEGLIGENCE OR OTHERWISE) ARISING IN ANY WAY OUT OF THE USE OF THIS\n* SOFTWARE, EVEN IF ADVISED OF THE POSSIBILITY OF SUCH DAMAGE.\n*/\n\n#include <stdlib.h>\n#include <