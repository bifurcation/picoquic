mentation; the API below stays the same.\n48\tpub struct Arena<T> {\n49\t    /// Phase 4 fills the body.  Sketch:\n50\t    ///\n51\t    /// ```ignore\n52\t    /// struct Slot<T> {\n53\t    ///     generation: u32,\n54\t    ///     state:      SlotState<T>,\n55\t    /// }\n56\t    /// enum SlotState<T> { Free { next_free: Option<u32> }, Filled(T) }\n57\t    /// pub struct Arena<T> {\n58\t    ///     slots: Vec<Slot<T>>,\n59\t    ///     free:  Option<u32>,\n60\t    ///     len:   usize,\n61\t    /// }\n62\t    /// ```\n63\t    _slots: PhantomData<T>,\n64\t}\n65\t\n66\timpl<T> Arena<T> {\n67\t    /// Build an empty arena.\n68\t    pub const fn new() -> Self {\n69\t        Self {\n70\t            _slots: PhantomData,\n71\t        }\n72\t    }\n73\t\n74\t    /// Insert `value`, returning its token.\n75\t    ///\n76\t    /// Returns [`Error::Memory`] on slot-vector allocation failure.\n77\t    pub fn insert(&mut self, _value: T) -> Result<Token<T>, Error> {\n78\t        todo!()\n79\t    }\n80\t\n81\t    /// Borrow the value at `token`, or `None` if it has been\n82\t    /// removed (slot generation has moved on) or is out of bounds.\n83\t    pub fn get(&self, _token: Token<T>) -> Option<&T> {\n84\t        todo!()\n85\t    }\n86\t\n87\t    /// Mutably borrow the value at `token`, or `None` if stale.\n88\t    pub fn get_mut(&mut self, _token: Token<T>) -> Option<&mut T> {\n89\t        todo!()\n90\t    }\n91\t\n92\t    /// Remove and return the value at `token`.  Bumps the slot's\n93\t    /// generation; subsequent [`Arena::get`] calls with the same\n94\t    /// token return `None`.\n95\t    pub fn remove(&mut self, _token: Token<T>) -> Option<T> {\n96\t        todo!()\n97\t    }\n98\t\n99\t    /// `true` when `token` still names a live value.\n100\t    pub fn contains(&self, _token: Token<T>) -> bool {\n101\t        todo!()\n102\t    }\n103\t\n104\t    /// Number of live values.\n105\t    pub fn len(&self) -> usize {\n106\t        todo!()\n107\t    }\n108\t\n109\t    /// `t