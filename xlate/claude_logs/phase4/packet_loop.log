        /* TODO: set option IPv6 only */\n398\t        picoquic_socket_set_ecn_options_ex(s_ctx->fd, s_ctx->af, &recv_set, &send_set, ecn_value) != 0 ||\n399\t#endif\n400\t        picoquic_socket_set_pkt_info(s_ctx->fd, s_ctx->af) != 0 ||\n401\t        (s_ctx->is_port_shared && setsockopt(s_ctx->fd, SOL_SOCKET, SO_REUSEADDR, (const char*)&opt_val, sizeof(opt_val)) != 0) ||\n402\t#if defined(SO_REUSEPORT)\n403\t        (s_ctx->is_port_shared && setsockopt(s_ctx->fd, SOL_SOCKET, SO_REUSEPORT, (const char*)&opt_val, sizeof(opt_val)) != 0) ||\n404\t#endif\n405\t        picoquic_bind_to_port(s_ctx->fd,s_ctx->af, s_ctx->port) != 0 ||\n406\t        picoquic_get_local_address(s_ctx->fd, &local_address) != 0 ||\n407\t        picoquic_socket_set_pmtud_options(s_ctx->fd, s_ctx->af) != 0)\n408\t    {\n409\t        DBG_PRINTF(\"Cannot set socket (af=%d, port = %d)\\n\", s_ctx->af, s_ctx->port);\n410\t        ret = -1;\n411\t    }\n412\t    else {\n413\t        if (local_address.ss_family == AF_INET6) {\n414\t            s_ctx->port = ntohs(((struct sockaddr_in6*)&local_address)->sin6_port);\n415\t        }\n416\t        else if (local_address.ss_family == AF_INET) {\n417\t            s_ctx->port = ntohs(((struct sockaddr_in*)&local_address)->sin_port);\n418\t        }\n419\t        \n420\t#ifndef ESP_PLATFORM\n421\t        if (socket_buffer_size > 0) {\n422\t            socklen_t opt_len;\n423\t            int opt_ret;\n424\t            int so_sndbuf;\n425\t            int so_rcvbuf;\n426\t            int last_op = SO_SNDBUF;\n427\t            char const* last_op_name = \"SO_SNDBUF\";\n428\t\n429\t            opt_len = sizeof(int);\n430\t            so_sndbuf = socket_buffer_size;\n431\t            opt_ret = setsockopt(s_ctx->fd, SOL_SOCKET, SO_SNDBUF, (const char*)&so_sndbuf, opt_len);\n432\t            if (opt_ret == 0) {\n433\t                last_op = SO_RCVBUF;\n434\t                last_op_name = \"SO_RECVBUF\";\n435\t                opt_len = sizeof(int);\n436\t                so_rcvbuf = socket_buffer_size;\n437\t                opt_ret = setsockopt(s_ctx->fd, SOL_SOCKET, SO_RCVBUF, (const char*)&so_rcvbuf, opt_len);\n438\t            }\n439\t            if (opt_ret != 0) {\n440\t                int so_errbuf = 0;\n441\t#ifdef _WINDOWS\n442\t                int sock_error = WSAGetLastError();\n443\t#else\n444\t                int sock_error = errno;\n445\t#endif\n446\t                opt_ret = getsockopt(s_ctx->fd, SOL_SOCKET, last_op, (char*)&so_errbuf, &opt_len);\n447\t                DBG_PRINTF(\"Cannot set %s to %d, err=%d, so_sndbuf=%d (%d)\",\n448\t                    last_op_name, socket_buffer_size, sock_error, so_errbuf, opt_ret);\n449\t                ret = -1;\n450\t            }\n451\t        }\n452\t#endif\n453\t\n454\t#ifdef _WINDOWS\n455\t        if (ret == 0) {\n456\t            ret = picoquic_packet_set_windows_socket(send_coalesced, recv_coalesced, s_ctx);\n457\t        }\n458\t#endif\n459\t    }\n460\t\n461\t    return ret;\n462\t}\n463\t\n464\tint picoquic_packet_loop_open_sockets(uint16_t local_port, int local_af, uint16_t public_port, int is_shared,\n465\t    int socket_buffer_size, int extra_socket_required, int do_not_use_gso, picoquic_socket_ctx_t* s_ctx, uint8_t ecn_value)\n466\t{\n467\t    /* Compute how many sockets are necessary, and set the intial value of AF and port per socket */\n468\t    int nb_sockets = 0;\n469\t    int af[2];\n470\t    int nb_af;\n471\t    uint16_t current_port = local_port;\n472\t    int sock_ret = 0;\n473\t\n474\t    if (local_af == 0) {\n475\t#ifdef ESP_PLATFORM\n476\t        nb_af = 1;\n477\t        af[0] = AF_INET;\n478\t#else\n479\t        nb_af = 2;\n480\t        af[0] = AF_INET;\n481\t        af[1] = AF_INET6;\n482\t#endif\n483\t    }\n484\t    else {\n485\t        nb_af = 1;\n486\t        af[0] = local_af;\n487\t    }\n488\t    for (int iteration = 0; sock_ret == 0 && iteration < 1 + (extra_socket_required); iteration++) {\n489\t        for (int i_af = 0; sock_ret == 0 && i_af < nb_af; i_af++) {\n490\t            s_ctx[nb_sockets].af = af[i_af];\n491\t            s_ctx[nb_sockets].port = current_port;\n492\t            s_ctx[nb_sockets].n_port = htons(current_port);\n493\t            s_ctx[nb_sockets].is_port_shared = 0;\n494\t            if ((sock_ret = picoquic_packet_loop_open_socket(socket_buffer_size, do_not_use_gso, &s_ctx[nb_sockets], ecn_value)) == 0) {\n495\t                if (current_port == 0) {\n496\t                    current_port = s_ctx[nb_sockets].port;\n497\t                    s_ctx[nb_sockets].n_port = htons(current_port);\n498\t                }\n499\t                nb_sockets++;\n500\t            }\n501\t            if (sock_ret == 0 && public_port != 0) {\n502\t                s_ctx[nb_sockets].af = af[i_af];\n503\t                s_ctx[nb_sockets].port = public_port;\n504\t                s_ctx[nb_sockets].n_port = htons(public_port);\n505\t                s_ctx[nb_sockets].is_port_shared = (is_shared != 0);\n506\t                if ((sock_ret = picoquic_packet_loop_open_socket(socket_buffer_size, do_not_use_gso, &s_ctx[nb_sockets], ecn_value)) == 0) {\n507\t                    nb_sockets++;\n508\t                }\n509\t            }\n510\t        }\n511\t        current_port = 0;\n512\t    }\n513\t\n514\t    if (sock_ret != 0) {\n515\t        DBG_PRINTF(\"Cannot set socket (af=%d, port = %d)\\n\", s_ctx[nb_sockets].af, s_ctx[nb_sockets].port);\n516\t        for (int j = 0; j < nb_sockets; j++) {\n517\t            picoquic_packet_loop_close_socket(&s_ctx[j]);\n518\t        }\n519\t        nb_sockets = 0;\n520\t    }\n521\t    return nb_sockets;\n522\t}\n523\t\n524\t/*\n525\t* Windows: use asynchronous receive. Asynchronous receive requires\n526\t* declaring an overlap context and event per socket, as well as a\n527\t* buffer per socket. This should probably be an option. Instead of\n528\t* calling socket, just use a \"wait for event\" to find out which\n529\t* readmsg has completed on what socket. If a read is available,\n530\t* return it. The memory is allocated per socket. After the loop\n531\t* has processed the message, it needs to \"rearm\" the socket to\n532\t* ready it for the next message.\n533\t* \n534\t* Unix: use select. (Consider using poll instead?). If data is\n535\t* available, read it. This uses a shared buffer.\n536\t* \n537\t* Both can return on timeout.\n538\t* \n539\t* Both can accomodate a \"wakeup\" event. Should there be a\n540\t* specific callback if the wakeup event fires?\n541\t* \n542\t */\n543\t#if defined(_WINDOWS)"}]},"parent_tool_use_id":null,"session_id":"fbc51140-68a0-4c62-b36a-79f6bbd7de93","uuid":"b280660d-2331-42a7-9b09-47ada6323cd8","timestamp":"2026-05-06T11:20:11.189Z","tool_use_result":{"type":"text","file":{"filePath":"/Users/richbarn/Projects/picoquic/picoquic/sockloop.c","content":"void picoquic_packet_loop_close_socket(picoquic_socket_ctx_t* s_ctx)\n{\n    if (s_ctx->fd != INVALID_SOCKET) {\n        SOCKET_CLOSE(s_ctx->fd);\n        s_ctx->fd = INVALID_SOCKET;\n    }\n#ifdef _WINDOWS\n    if (s_ctx->overlap.hEvent != WSA_INVALID_EVENT) {\n        WSACloseEvent(s_ctx->overlap.hEvent);\n        s_ctx->overlap.hEvent = WSA_INVALID_EVENT;\n    }\n\n    if (s_ctx->recv_buffer != NULL) {\n        free(s_ctx->recv_buffer);\n        s_ctx->recv_buffer = NULL;\n    }\n#endif\n}\n\n#ifdef _WINDOWS\nint picoquic_packet_loop_open_socket(int socket_buffer_size, int do_not_use_gso,\n    picoquic_socket_ctx_t* s_ctx, uint8_t ecn_value)\n#else\nint picoquic_packet_loop_open_socket(int socket_buffer_size, int UNUSED(do_not_use_gso),\n    picoquic_socket_ctx_t* s_ctx, uint8_t ecn_value)\n#endif\n{\n    int ret = 0;\n    struct sockaddr_storage local_address;\n    int recv_set = 0;\n    int send_set = 0;\n    int opt_val = 1;\n#ifdef _WINDOWS\n    int recv_coalesced = 0;\n    int send_coalesced = 0;\n\n    /* Assess whether coalescing is supported */\n    if (!do_not_use_gso) {\n        picoquic_sockloop_win_coalescing_test(&recv_coalesced, &send_coalesced);\n#if 0\n        /* TODO: remove temporary fix, after we figure how to work that out. */\n        recv_coalesced = 0;\n#endif\n    }\n    s_ctx->overlap.hEvent = WSA_INVALID_EVENT;\n    s_ctx->fd = WSASocket(s_ctx->af, SOCK_DGRAM, IPPROTO_UDP, NULL, 0, WSA_FLAG_OVERLAPPED);\n#else\n    s_ctx->fd = socket(s_ctx->af, SOCK_DGRAM, IPPROTO_UDP);\n#endif\n\n\n    if (s_ctx->fd == INVALID_SOCKET ||\n#ifndef ESP_PLATFORM\n        /* TODO: set option IPv6 only */\n        picoquic_socket_set_ecn_options_ex(s_ctx->fd, s_ctx->af, &recv_set, &send_set, ecn_value) != 0 ||\n#endif\n        picoquic_socket_set_pkt_info(s_ctx->fd, s_ctx->af) != 0 ||\n        (s_ctx->is_port_shared && setsockopt(s_ctx->fd, SOL_SOCKET, SO_REUSEADDR, (const char*)&opt_val, sizeof(opt_val)) != 0) ||\n#if defined(SO_REUSEPORT)\n        (s_ctx->is_port_shared && setsockopt(s_ctx->fd, SOL_SOCKET, SO_REUSEPORT, (const char*)&opt_val, sizeof(opt_val)) != 0) ||\n#endif\n        picoquic_bind_to_port(s_ctx->fd,s_ctx->af, s_ctx->port) != 0 ||\n        picoquic_get_local_address(s_ctx->fd, &local_address) != 0 ||\n        picoquic_socket_set_pmtud_options(s_ctx->fd, s_ctx->af) != 0)\n    {\n        DBG_PRINTF(\"Cannot set socket (af=%d, port = %d)\\n\", s_ctx->af, s_ctx->port);\n        ret = -1;\n    }\n    else {\n        if (local_address.ss_family == AF_INET6) {\n            s_ctx->port = ntohs(((struct sockaddr_in6*)&local_address)->sin6_port);\n        }\n        else if (local_address.ss_family == AF_INET) {\n            s_ctx->port = ntohs(((struct sockaddr_in*)&local_address)->sin_port);\n        }\n        \n#ifndef ESP_PLATFORM\n        if (socket_buffer_size > 0) {\n            socklen_t opt_len;\n            int opt_ret;\n            int so_sndbuf;\n            int so_rcvbuf;\n            int last_op = SO_SNDBUF;\n            char const* last_op_name = \"SO_SNDBUF\";\n\n            opt_len = sizeof(int);\n            so_sndbuf = socket_buffer_size;\n            opt_ret = setsockopt(s_ctx->fd, SOL_SOCKET, SO_SNDBUF, (const char*)&so_sndbuf, opt_len);\n            if (opt_ret == 0) {\n                last_op = SO_RCVBUF;\n                last_op_name = \"SO_RECVBUF\";\n                opt_len = sizeof(int);\n                so_rcvbuf = socket_buffer_size;\n                opt_ret = setsockopt(s_ctx->fd, SOL_SOCKET, SO_RCVBUF, (const char*)&so_rcvbuf, opt_len);\n            }\n            if (opt_ret != 0) {\n                int so_errbuf = 0;\n#ifdef _WINDOWS\n                int sock_error = WSAGetLastError();\n#else\n                int sock_error = errno;\n#endif\n                opt_ret = getsockopt(s_ctx->fd, SOL_SOCKET, last_op, (char*)&so_errbuf, &opt_len);\n                DBG_PRINTF(\"Cannot set %s to %d, err=%d, so_sndbuf=%d (%d)\",\n                    last_op_name, socket_buffer_size, sock_error, so_errbuf, opt_ret);\n                ret = -1;\n            }\n        }\n#endif\n\n#ifdef _WINDOWS\n        if (ret == 0) {\n            ret = picoquic_packet_set_windows_socket(send_coalesced, recv_coalesced, s_ctx);\n        }\n#endif\n    }\n\n    return ret;\n}\n\nint picoquic_packet_loop_open_sockets(uint16_t local_port, int local_af, uint16_t public_port, int is_shared,\n    int socket_buffer_size, int extra_socket_required, int do_not_use_gso, picoquic_socket_ctx_t* s_ctx, uint8_t ecn_value)\n{\n    /* Compute how many sockets are necessary, and set the intial value of AF and port per socket */\n    int nb_sockets = 0;\n    int af[2];\n    int nb_af;\n    uint16_t current_port = local_port;\n    int sock_ret = 0;\n\n    if (local_af == 0) {\n#ifdef ESP_PLATFORM\n        nb_af = 1;\n        af[0] = AF_INET;\n#else\n        nb_af = 2;\n        af[0] = AF_INET;\n        af[1] = AF_INET6;\n#endif\n    }\n    else {\n        nb_af = 1;\n        af[0] = local_af;\n    }\n    for (int iteration = 0; sock_ret == 0 && iteration < 1 + (extra_socket_required); iteration++) {\n        for (int i_af = 0; sock_ret == 0 && i_af < nb_af; i_af++) {\n            s_ctx[nb_sockets].af = af[i_af];\n            s_ctx[nb_sockets].port = current_port;\n            s_ctx[nb_sockets].n_port = htons(current_port);\n            s_ctx[nb_sockets].is_port_shared = 0;\n            if ((sock_ret = picoquic_packet_loop_open_socket(socket_buffer_size, do_not_use_gso, &s_ctx[nb_sockets], ecn_value)) == 0) {\n                if (current_port == 0) {\n                    current_port = s_ctx[nb_sockets].port;\n                    s_ctx[nb_sockets].n_port = htons(current_port);\n                }\n                nb_sockets++;\n            }\n            if (sock_ret == 0 && public_port != 0) {\n                s_ctx[nb_sockets].af = af[i_af];\n                s_ctx[nb_sockets].port = public_port;\n                s_ctx[nb_sockets].n_port = htons(public_port);\n                s_ctx[nb_sockets].is_port_shared = (is_shared != 0);\n                if ((sock_ret = picoquic_packet_loop_open_socket(socket_buffer_size, do_not_use_gso, &s_ctx[nb_sockets], ecn_value)) == 0) {\n                    nb_sockets++;\n                }\n            }\n        }\n        current_port = 0;\n    }\n\n    if (sock_ret != 0) {\n        DBG_PRINTF(\"Cannot set socket (af=%d, port = %d)\\n\", s_ctx[nb_sockets].af, s_ctx[nb_sockets].port);\n        for (int j = 0; j < nb_sockets; j++) {\n            picoquic_packet_loop_close_socket(&s_ctx[j]);\n        }\n        nb_sockets = 0;\n    }\n    return nb_sockets;\n}\n\n/*\n* Windows: use asynchronous receive. Asynchronous receive requires\n* declaring an overlap context and event per socket, as well as a\n* buffer per socket. This should probably be an option. Instead of\n* calling socket, just use a \"wait for event\" to find out which\n* readmsg has completed on what socket. If a read is available,\n* return it. The memory is allocated per socket. After the loop\n* has processed the message, it needs to \"rearm\" the socket to\n* ready it for the next message.\n* \n* Unix: use select. (Consider using poll instead?). If data is\n* available, read it. This uses a shared buffer.\n* \n* Both can return on timeout.\n* \n* Both can accomodate a \"wakeup\" event. Should there be a\n* specific callback if the wakeup event fires?\n* \n */\n#if defined(_WINDOWS)","numLines":200,"startLine":344,"totalLines":2066}}}
