oop callback context is the same for all threads. The function\n1962\t* can retrieve the thread context from the \"quic\" context argument using\n1963\t* the function picoquic_get_thread_ctx_from_quic().\n1964\t*/\n1965\t\n1966\tint picoquic_start_server_threads(\n1967\t    struct st_picoquic_quic_config_t* config,\n1968\t    uint64_t current_time,\n1969\t    picoquic_alpn_select_fn_v2 alpn_select_fn,\n1970\t    picoquic_stream_data_cb_fn default_callback_fn,\n1971\t    void* default_callback_ctx,\n1972\t    picoquic_packet_loop_cb_fn loop_callback_fn,\n1973\t    void* loop_callback_ctx,\n1974\t    picoquic_custom_thread_create_fn thread_create_fn,\n1975\t    picoquic_custom_thread_delete_fn thread_delete_fn,\n1976\t    picoquic_custom_thread_setname_fn thread_setname_fn,\n1977\t    picoquic_network_thread_ctx_t** thread_ctxs,\n1978\t    int nb_threads_max,\n1979\t    int* nb_threads_created)\n1980\t{\n1981\t    int ret = 0;\n1982\t    int nb_threads = 0;\n1983\t    uint8_t default_ticket_key[16] = { 0 };\n1984\t    /* Set the thread functions to default value if not set */\n1985\t    if (thread_create_fn == NULL) {\n1986\t        thread_create_fn = picoquic_internal_thread_create;\n1987\t    }\n1988\t    if (thread_delete_fn == NULL) {\n1989\t        thread_delete_fn = picoquic_internal_thread_delete;\n1990\t    }\n1991\t    if (thread_setname_fn == NULL) {\n1992\t        thread_setname_fn = picoquic_internal_thread_setname;\n1993\t    }\n1994\t    /* Check that the number of threads matches the config value\n1995\t     */\n1996\t    if (config->nb_threads > nb_threads_max) {\n1997\t        fprintf(stdout, \"Cannot start %d threads, max is %d.\\n\", config->nb_threads, nb_threads_max);\n1998\t\n1999\t        ret = -1;\n2000\t    }\n2001\t    else if (config->nb_threads < 1) {\n2002\t        nb_threads = 1;\n2003\t    }\n2004\t    else {\n2005\t        nb_threads = (int)config->nb_threads;\n2006\t    }\n2007\t    /* set the ticket encryption key if not present in co