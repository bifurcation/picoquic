{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01VwZpUVqSrb6ErgzBY2LwcW","type":"tool_result","content":"60\t/// the C `SOCKET_TYPE` (a raw file descriptor); the host\n61\t/// implementation supplies open / bind / send / recv operations\n62\t/// while the rest of picoquic stays platform-agnostic.\n63\t///\n64\t/// The default [`socket2::Socket`] implementation is in\n65\t/// [`crate::socks_socket2`] (gated on the `std` feature).\n66\tpub trait Socket {\n67\t    /// Local address bound to this socket (`getsockname`).\n68\t    /// C: `picoquic_get_local_address`.\n69\t    fn local_address(&self) -> Result<SocketAddr, Error>;\n70\t\n71\t    /// Receive one UDP datagram into `buffer`.  Output parameters\n72\t    /// (source / dest address, interface index, ECN, byte count)\n73\t    /// fold into [`RecvInfo`]; the slice length subsumes the C\n74\t    /// `buffer_max` parameter.  C: `picoquic_recvmsg`.\n75\t    fn recv(&mut self, buffer: &mut [u8]) -> Result<RecvInfo, Error>;\n76\t\n77\t    /// Send `bytes` to `addr_dest` from `addr_from` with an\n78\t    /// optional GSO segmentation hint `gso_size` (`UDP_SEGMENT`).\n79\t    /// `addr_from = None` lets the kernel choose the source\n80\t    /// address.  `Ok(n)` reports bytes sent; `Err` carries the\n81\t    /// OS error.  C: `picoquic_sendmsg`.\n82\t    fn send(\n83\t        &mut self,\n84\t        addr_dest: &SocketAddr,\n85\t        addr_from: Option<&SocketAddr>,\n86\t        dest_if: i32,\n87\t        bytes: &[u8],\n88\t        gso_size: i32,\n89\t    ) -> Result<usize, OsError>;\n90\t\n91\t    /// Enable per-packet destination-info delivery on this\n92\t    /// socket (`IP_PKTINFO` / `IPV6_RECVPKTINFO`).  Default:\n93\t    /// no-op for backends that don't surface pktinfo.\n94\t    fn set_pkt_info(&mut self) -> Result<(), Error> {\n95\t        Ok(())\n96\t    }\n97\t\n98\t    /// Enable ECN reception (and request `ECN_ECT_1` outbound).\n99\t    /// Returns `(recv_set, send_set)` indicating whether the\n100\t    /// kernel honored each socket option.  Default: no-op,\n101\t    /// returns `(false, false)`.\n102\t    fn set_ecn_options(&mut self) -> Result<(bool, bool), Error> {\n103\t        Ok((false, false))\n104\t    }\n105\t\n106\t    /// Like [`Self::set_ecn_options`] but with an explicit\n107\t    /// outbound TOS / ECN value (`ecn` is one of the 2-bit\n108\t    /// `EcnCodepoint` codes).  Default: delegates to the\n109\t    /// no-op `set_ecn_options`.\n110\t    fn set_ecn_options_ex(&mut self, _ecn: EcnCodepoint) -> Result<(bool, bool), Error> {\n111\t        self.set_ecn_options()\n112\t    }\n113\t\n114\t    /// Enable Path-MTU-Discovery probing on this socket\n115\t    /// (Linux-only; no-op on other platforms by default).\n116\t    fn set_pmtud_options(&mut self) -> Result<(), Error> {\n117\t        Ok(())\n118\t    }\n119\t\n120\t    /// Open and bind an IPv4 server socket on `port`.  Called by\n121\t    /// [`ServerSockets::open`]; concrete implementations override\n122\t    /// this to use their socket backend.\n123\t    fn open_server_v4(_port: i32) -> Result<Self, Error>\n124\t    where\n125\t        Self: Sized,\n126\t    {\n127\t        Err(Error::Generic)\n128\t    }\n129\t\n130\t    /// Open and bind an IPv6 server socket on `port`.  Called by\n131\t    /// [`ServerSockets::open`]; concrete implementations override\n132\t    /// this to use their socket backend.\n133\t    fn open_server_v6(_port: i32) -> Result<Self, Error>\n134\t    where\n135\t        Self: Sized,\n136\t    {\n137\t        Err(Error::Generic)\n138\t    }\n139\t}\n140\t\n141\t// ---------------------------------------------------------------------------\n142\t// `ServerSockets` -- generic over the socket implementation.\n143\t\n144\t/// Pair of UDP sockets owned by a server (one IPv4, one IPv6).\n145\t/// C: `picoquic_server_sockets_t`.  Generic over the active\n146\t/// [`Socket`] implementation.\n147\tpub struct ServerSockets<S: Socket> {\n148\t    /// One UDP socket per address family.  `None` slots are\n149\t    /// uninitialised — see [`ServerSockets::open`] /\n150\t    /// [`ServerSockets::close`].\n151\t    pub sockets: [Option<S>; SERVER_SOCKET_COUNT],\n152\t}\n153\t\n154\timpl<S: Socket> Default for ServerSockets<S> {\n155\t    fn default() -> Self {\n156\t        Self {\n157\t            sockets: [None, None],\n158\t        }\n159\t    }\n160\t}\n161\t\n162\timpl<S: Socket> ServerSockets<S> {\n163\t    /// Open the IPv4 + IPv6 server-side UDP socket pair listening\n164\t    /// on `port`.  C: `picoquic_open_server_sockets`.  The\n165\t    /// concrete `S` implementor is chosen at the call site;\n166\t    /// the default `crate::socks_socket2::Socket2Udp` wraps\n167\t    /// [`socket2::Socket`].\n168\t    pub fn open(port: i32) -> Result<Self, Error> {\n169\t        let s6 = S::open_server_v6(port)?;\n170\t        let s4 = S::open_server_v4(port)?;\n171\t        Ok(Self {\n172\t            sockets: [Some(s6), Some(s4)],\n173\t        })\n174\t    }\n175\t\n176\t    /// Close every socket in the pair, leaving each slot `None`.\n177\t    /// C: `picoquic_close_server_sockets`.\n178\t    pub fn close(&mut self) {\n179\t        for slot in &mut self.sockets {\n180\t            *slot = None;\n181\t        }\n182\t    }\n183\t\n184\t    /// Pick the matching socket (v4 / v6, dispatched by\n185\t    /// `addr_dest`'s family) and send through it.\n186\t    /// C: `picoquic_send_through_server_sockets`.\n187\t    pub fn send_through(\n188\t        &mut self,\n189\t        addr_dest: &SocketAddr,\n190\t        addr_from: Option<&SocketAddr>,\n191\t        from_if: i32,\n192\t        bytes: &[u8],\n193\t    ) -> Result<usize, OsError> {\n194\t        let idx = if addr_dest.is_ipv4() { 1 } else { 0 };\n195\t        match &mut self.sockets[idx] {\n196\t            Some(s) => s.send(addr_dest, addr_from, from_if, bytes, 0),\n197\t            None => Err(OsError(-1)),\n198\t        }\n199\t    }\n200\t}\n201\t\n202\t// -----------