{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01GGYreMN5qbCMDCEZQcifzf","type":"tool_result","content":"7370\t// ---------------------------------------------------------------------------\n7371\t// Version accessors needed by packet-header tests.\n7372\t\n7373\timpl Connection {\n7374\t    /// Wire version number of the active protocol version.\n7375\t    /// C: `picoquic_supported_versions[cnx->version_index].version`.\n7376\t    pub fn version_number(&self) -> u32 {\n7377\t        // In the Rust translation, `proposed_version` carries the wire version\n7378\t        // number directly (C: cnx->proposed_version set from the supported-version\n7379\t        // table entry's .version field).\n7380\t        self.proposed_version\n7381\t    }\n7382\t\n7383\t    /// TLS-label prefix string for the active protocol version.\n7384\t    /// C: `picoquic_supported_versions[cnx->version_index].tls_prefix_label`.\n7385\t    pub fn version_tls_prefix_label(&self) -> &'static str {\n7386\t        // Resolve via proposed_version to a Version enum, then use parameters().\n7387\t        Version::try_from_wire(self.proposed_version)\n7388\t            .map(|v| v.parameters().tls_prefix_label)\n7389\t            .unwrap_or(\"tls13 quic \")\n7390\t    }\n7391\t}\n7392\t\n7393\t// ---------------------------------------------------------------------------\n7394\t// LB CID generation / verification helpers.\n7395\t\n7396\timpl Quic {\n7397\t    /// Generate a CID using the installed LB CID callback with `nonce` as the\n7398\t    /// nonce / \"for-server-use\" bytes.  Returns `None` when no callback is\n7399\t    /// installed.  C: direct call to `quic->cnx_id_callback_fn`."}]},"parent_tool_use_id":null,"session_id":"11c0fdef-3e1f-4ccf-8c80-12d2748eb248","uuid":"bb2ceb9d-51fa-4d86-a869-36dbb02f263c","timestamp":"2026-05-06T12:14:22.147Z","tool_use_result":{"type":"text","file":{"filePath":"/Users/richbarn/Projects/picoquic/rs/fq/src/internal.rs","content":"// ---------------------------------------------------------------------------\n// Version accessors needed by packet-header tests.\n\nimpl Connection {\n    /// Wire version number of the active protocol version.\n    /// C: `picoquic_supported_versions[cnx->version_index].version`.\n    pub fn version_number(&self) -> u32 {\n        // In the Rust translation, `proposed_version` carries the wire version\n        // number directly (C: cnx->proposed_version set from the supported-version\n        // table entry's .version field).\n        self.proposed_version\n    }\n\n    /// TLS-label prefix string for the active protocol version.\n    /// C: `picoquic_supported_versions[cnx->version_index].tls_prefix_label`.\n    pub fn version_tls_prefix_label(&self) -> &'static str {\n        // Resolve via proposed_version to a Version enum, then use parameters().\n        Version::try_from_wire(self.proposed_version)\n            .map(|v| v.parameters().tls_prefix_label)\n            .unwrap_or(\"tls13 quic \")\n    }\n}\n\n// ---------------------------------------------------------------------------\n// LB CID generation / verification helpers.\n\nimpl Quic {\n    /// Generate a CID using the installed LB CID callback with `nonce` as the\n    /// nonce / \"for-server-use\" bytes.  Returns `None` when no callback is\n    /// installed.  C: direct call to `quic->cnx_id_callback_fn`.","numLines":30,"startLine":7370,"totalLines":7642}}}
