{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01Tc7yCRCDW462d4u929xuJj","type":"tool_result","content":"1\t/*\n2\t* Author: Christian Huitema\n3\t* Copyright (c) 2017, Private Octopus, Inc.\n4\t* All rights reserved.\n5\t*\n6\t* Permission to use, copy, modify, and distribute this software for any\n7\t* purpose with or without fee is hereby granted, provided that the above\n8\t* copyright notice and this permission notice appear in all copies.\n9\t*\n10\t* THIS SOFTWARE IS PROVIDED BY THE COPYRIGHT HOLDERS AND CONTRIBUTORS \"AS IS\" AND\n11\t* ANY EXPRESS OR IMPLIED WARRANTIES, INCLUDING, BUT NOT LIMITED TO, THE IMPLIED\n12\t* WARRANTIES OF MERCHANTABILITY AND FITNESS FOR A PARTICULAR PURPOSE ARE\n13\t* DISCLAIMED. IN NO EVENT SHALL Private Octopus, Inc. BE LIABLE FOR ANY\n14\t* DIRECT, INDIRECT, INCIDENTAL, SPECIAL, EXEMPLARY, OR CONSEQUENTIAL DAMAGES\n15\t* (INCLUDING, BUT NOT LIMITED TO, PROCUREMENT OF SUBSTITUTE GOODS OR SERVICES;\n16\t* LOSS OF USE, DATA, OR PROFITS; OR BUSINESS INTERRUPTION) HOWEVER CAUSED AND\n17\t* ON ANY THEORY OF LIABILITY, WHETHER IN CONTRACT, STRICT LIABILITY, OR TORT\n18\t* (INCLUDING NEGLIGENCE OR OTHERWISE) ARISING IN ANY WAY OUT OF THE USE OF THIS\n19\t* SOFTWARE, EVEN IF ADVISED OF THE POSSIBILITY OF SUCH DAMAGE.\n20\t*/\n21\t\n22\t\n23\t/* The tls_api.c file provides the glue between the QUIC protocol code and the\n24\t * implementation of TLS 1.3 in picotls. That glue code has two main components:\n25\t *\n26\t * - matching TLS concepts such as handshake events with QUIC protocol events.\n27\t * - providing implementation of cryptographic algorithms.\n28\t *\n29\t * The bulk of the code corresponds to the first objective, the implementation\n30\t * of generic interactions with picotls. But this implementation relies on\n31\t * implementation of cryptographic primitives. The initial version of\n32\t * picoquic relies on OpenSSL for the implementation of these primitives,\n33\t * which limits portability of Picoquic to platforms that support OpenSSL.\n34\t *\n35\t * Picotls includes API for providing a variety of implementations of the\n36\t * cryptographic algorithms, linking with external libraries like OpenSSL or\n37\t * minimal implementations like \"minicrypto\". Our goal there is to provide a\n38\t * \"crypto-provider\" API so that applications can decide which provider they\n39\t * prefer.\n40\t *\n41\t * As an intermediate state towards that goal, we isolate the dependencies on\n42\t * OpenSSL in a small set of function calls.\n43\t */\n44\t\n45\t#ifdef _WINDOWS\n46\t#include \"wincompat.h\"\n47\t#ifndef PTLS_WITHOUT_FUSION\n48\t/* temporary disabling of PTLS_FUSION until memory alignment issues are fixed*/\n49\t#define PTLS_WITHOUT_FUSION\n50\t#endif\n51\t#endif\n52\t\n53\t#include <stddef.h>\n54\t#include <stdlib.h>\n55\t#ifdef _WINDOWS\n56\t#include \"wincompat.h\"\n57\t#include \"ws2ipdef.h\"\n58\t#pragma warning(disable:4100)\n59\t#pragma warning(disable:4204)\n60\t#endif\n61\t#include \"picotls.h\"\n62\t#include \"picoquic_internal.h\"\n63\t#ifndef PTLS_WITHOUT_OPENSSL\n64\t#include \"picotls/openssl.h\"\n65\t#endif\n66\t#include \"tls_api.h\"\n67\t#include \"picoquic_crypto_provider_api.h\"\n68\t#include <stdio.h>\n69\t#include <string.h>\n70\t#include \"picoquic_unified_log.h\"\n71\t\n72\t#define container_of(ptr, type, member) ((type *)((char *)(ptr) - offsetof(type, member)))\n73\t\n74\t#ifndef UNREFERENCED_PARAMETER\n75\t#define UNREFERENCED_PARAMETER(x) (void)(x)\n76\t#endif\n77\t\n78\t#define PICOQUIC_TRANSPORT_PARAMETERS_TLS_EXTENSION_DRAFT 0xFFA5\n79\t#define PICOQUIC_TRANSPORT_PARAMETERS_TLS_EXTENSION_V1 0x39\n80\t#define PICOQUIC_TRANSPORT_PARAMETERS_MAX_SIZE 2048\n81\t\n82\tstruct st_picoquic_log_event_t {\n83\t    ptls_log_event_t super;\n84\t    FILE* fp;\n85\t};\n86\t\n87\t\n88\t/* This first part of this file provides a set of function for accessing\n89\t * the cryptographic libraries.\n90\t */\n91\t#define CRYPTO_PROVIDERS_REGION 1\n92\t\n93\t#ifdef CRYPTO_PROVIDERS_REGION\n94\t\n95\tstruct st_picoquic_cipher_suites_t picoquic_cipher_suites[PICOQUIC_CIPHER_SUITES_NB_MAX + 1] = { 0 };\n96\t\n97\tptls_key_exchange_algorithm_t* picoquic_key_exchanges[PICOQUIC_KEY_EXCHANGES_NB_MAX + 1] = { 0 };\n98\tptls_key_exchange_algorithm_t* picoquic_key_exchange_secp256r1[2] = { 0 };\n99\tptls_hpke_cipher_suite_t* picoquic_hpke_cipher_suites[PICOQUIC_HPKE_CIPHER_SUITE_NB_MAX + 1] = { 0 };\n100\tptls_hpke_kem_t* picoquic_hpke_kems[PICOQUIC_HPKE_KEM_NB_MAX + 1] = { 0 };\n101\tpicoquic_set_private_key_from_file_t picoquic_set_private_key_from_file_fn = NULL;\n102\tpicoquic_dispose_sign_certificate_t picoquic_dispose_sign_certificate_fn = NULL;\n103\tpicoquic_get_certs_from_file_t picoquic_get_certs_from_file_fn = NULL;\n104\tpicoquic_get_public_key_from_private_t picoquic_get_public_key_from_private_fn = NULL;\n105\tpicoquic_get_certificate_verifier_t picoquic_get_certificate_verifier_fn = NULL;\n106\tpicoquic_dispose_certificate_verifier_t picoquic_dispose_certificate_verifier_fn = NULL;\n107\tpicoquic_set_tls_root_certificates_t picoquic_set_tls_root_certificates_fn = NULL;\n108\tpicoquic_explain_crypto_error_t picoquic_explain_crypto_error_fn = NULL;\n109\tpicoquic_clear_crypto_errors_t picoquic_clear_crypto_errors_fn = NULL;\n110\tpicoquic_crypto_random_provider_t picoquic_crypto_random_provider_fn = NULL;\n111\tpicoquic_keyex_from_key_file_t picoquic_keyex_from_key_file_fn = NULL;\n112\tpicoquic_keyex_dispose_t picoquic_keyex_dispose_fn = NULL;\n113\t\n114\t\n115\t/* Initialization of the cryptographic tables and functions\n116\t * \n117\t * The code calls a series of potential crypto providers. \n118\t * The personalization relies on compile mode parameters\n119\t * such as \"ifdef\" and real time flags assessed in each\n120\t * per provider module.\n121\t */\n122\t#ifdef PICOQUIC_WITH_MBEDTLS\n123\tvoid picoquic_mbedtls_load(int unload);\n124\tvoid picoquic_mbedtls_log_version(picoquic_cnx_t* cnx);\n125\t#en