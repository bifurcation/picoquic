{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01NSJr5PAYhEyq1vWmNvxSoj","type":"tool_result","content":"1\t//! TLS-for-QUIC trait surface, modeled on `quinn-proto::crypto`.\n2\t//!\n3\t//! Quinn dependency: **none** — we lift the trait shapes\n4\t//! verbatim into our own module.  Borrow inspiration; don't\n5\t//! link the crate.\n6\t//!\n7\t//! This module defines the trait surface; concrete backends\n8\t//! (picotls, rustls, OpenSSL) live in sibling modules\n9\t//! (`tls_picotls.rs`, `tls_rustls.rs`, `tls_openssl.rs`)\n10\t//! gated by the matching Cargo features.\n11\t//!\n12\t//! Phase 1 contract: signatures only — every body is `todo!()`.\n13\t//!\n14\t//! ## Structure\n15\t//!\n16\t//! * [`Session`] — per-connection TLS state.  One impl per\n17\t//!   backend; each backend wraps its native session type.\n18\t//!   Replaces the C `*mut c_void` `tls_ctx` and `tls_sendbuf`\n19\t//!   fields.\n20\t//!\n21\t//! * [`ClientConfig`] / [`ServerConfig`] — builder traits;\n22\t//!   pick one to start a [`Session`].\n23\t//!\n24\t//! * [`PacketKey`] — packet protection (the AEAD layer).\n25\t//!   Hides the underlying AEAD primitive from picoquic.\n26\t//!\n27\t//! * [`HeaderKey`] — header protection.  See also\n28\t//!   [`crate::header_protection::HeaderProtector`], which is the\n29\t//!   concrete implementation; backends supply `HeaderKey`s\n30\t//!   that delegate to it.\n31\t//!\n32\t//! * [`Keys`] / [`KeyPair`] — bundles of keys per epoch.\n33\t//!\n34\t//! * [`TlsCallbacks`] — application-supplied hooks the TLS\n35\t//!   layer invokes (ALPN selection, ticket store, certificate\n36\t//!   verification).  One trait, default impls everywhere\n37\t//!   except the genuinely application-specific bits.\n38\t\n39\textern crate alloc;\n40\tuse alloc::boxed::Box;\n41\tuse alloc::vec::Vec;\n42\t\n43\tuse crate::Error;\n44\t\n45\t// ---------------------------------------------------------------------------\n46\t// Per-connection TLS state.\n47\t\n48\t/// Per-connection TLS state.  Drives the handshake forward,\n49\t/// surfaces handshake events, exposes negotiated keys.\n50\t///\n51\t/// Modeled on `quinn_proto::crypto::Session`.  The `Send` bound\n52\t/// is preserved so a connection can be moved between threads\n53\t/// even though picoquic itself is single-threaded in v1\n54\t/// (matters for v2 multi-threading and for users who run\n55\t/// multiple Quic contexts on different threads).\n56\tpub trait Session: Send {\n57\t    /// Read handshake bytes received from the peer.  Returns\n58\t    /// `Ok(true)` when the handshake transitions to a new\n59\t    /// epoch (new keys are now available via\n60\t    /// [`Self::next_1rtt_keys`] / [`Self::write_handshake`]).\n61\t    fn read_handshake(&mut self, plaintext: &[u8]) -> Result<bool, Error>;\n62\t\n63\t    /// Write handshake bytes for the peer.  Returns\n64\t    /// `Some(Keys)` when an epoch transition produces fresh\n65\t    /// outbound keys.\n66\t    fn write_handshake(&mut self, buf: &mut Vec<u8>) -> Option<Keys>;\n67\t\n68\t    /// `true` until the handshake completes.  After the\n69\t    /// handshake the session is in steady state and this\n70\t    /// returns `false`.\n71\t    fn is_handshaking(&self) -> bool;\n72\t\n73\t    /// Negotiated 1-RTT keys.  Returns `Some` once after the\n74\t    /// handshake completes; subsequent calls return `None`\n75\t    /// until a key update.\n76\t    fn next_1rtt_keys(&mut self) -> Option<KeyPair>;\n77\t\n78\t    /// Server-side handshake parameters (SNI, ALPN, etc.).\n79\t    /// Available after the first ClientHello.\n80\t    fn handshake_data(&self) -> Option<HandshakeData>;\n81\t\n82\t    /// Peer's certificate chain (or whatever identity material\n83\t    /// the backend exposes).  Available after the handshake.\n84\t    fn peer_identity(&self) -> Option<PeerIdentity>;\n85\t\n86\t    /// Early-data (0-RTT) keys, if the session offers them.\n87\t    fn early_keys(&self) -> Option<(Box<dyn HeaderKey>, Box<dyn PacketKey>)>;\n88\t\n89\t    /// Whether the server accepted the client's 0-RTT data.\n90\t    fn early_data_accepted(&self) -> Option<bool>;\n91\t\n92\t    /// Decode the peer's QUIC transport parameters (TLS\n93\t    /// extension 57; RFC 9001 §8.2).  Returns the decoded\n94\t    /// transport parameters as raw bytes — picoquic parses\n95\t    /// them with its own decoder.\n96\t    fn transport_parameters(&self) -> Result<Option<Vec<u8>>, Error>;\n97\t\n98\t    /// HKDF-Expand-Label using the session's exporter master\n99\t    /// secret.  Used by QUIC for stateless-reset tokens etc.\n100\t    fn export_keying_material(\n101\t        &self,\n102\t        label: &[u8],\n103\t        context: &[u8],\n104\t        output: &mut [u8],\n105\t    ) -> Result<(), Error>;\n106\t}\n107\t\n108\t// ---------------------------------------------------------------------------\n109\t// Builder traits for client / server sessions.\n110\t\n111\t/// Builder for client-side sessions.  Each backend exposes one\n112\t/// concrete `ClientConfig` type; the application constructs it\n113\t/// with backend-specific options (cert store, ALPN list, etc.)\n114\t/// and then calls [`ClientConfig::start_session`] per outgoing\n115\t/// connection.\n116\tpub trait ClientConfig {\n117\t    type Session: Session;\n118\t\n119\t    /// Start a fresh client-side TLS session.\n120\t    ///\n121\t    /// * `version` — QUIC wire version (passed to TLS as the\n122\t    ///   transport-parameter version field).\n123\t    /// * `server_name` — SNI value.\n124\t    /// * `transport_params` — already-encoded transport-parameters\n125\t    ///   blob to ship in the TLS extension.\n126\t    fn start_session(\n127\t        &self,\n128\t        version: u32,\n129\t        server_name: &str,\n130\t        transport_params: &[u8],\n131\t    ) -> Result<Self::Session, ConfigError>;\n132\t}\n133\t\n134\t/// Builder for server-side sessions.\n135\tpub trait ServerConfig {\n136\t    type Session: Session;\n137\t\n138\t    fn start_session(\n139\t        &self,\n140\t        version: u32,\n141\t        transport_params: &[u8],\n142\t    ) -> Result<Self::Session, ConfigError>;\n143\t}\n144\t\n145\t/// Top-level backend trait.  Each backend (picotls, rustls,\n146\t/// OpenSSL) implements this once at the crate level.\n147\t///\n148\t/// In v1 `Quic` holds boxed [`DynClientConfig`] /\n149\t/// [`DynServerConfig`] trait objects (so a single binary can carry\n150\t/// multiple backends and pick at runtime).  An ergonomic generic\n151\t/// wrapper (`Quic<T: TlsBackend>`) for compile-time-only selection\n152\t/// is a candidate Phase-4 follow-up.\n153\tpub trait TlsBackend {\n154\t    type Client: ClientConfig;\n155\t    type Server: ServerConfig;\n156\t}\n157\t\n158\t// ---------------------------------------------------------------------------\n159\t// Dyn-compatible wrappers around `ClientConfig` / `ServerConfig`.\n160\t//\n161\t// `ClientConfig::start_session` returns `Self::Session`, which makes\n162\t// the trait itself non-dyn-compatible.  The `Dyn*Config` wrappers\n163\t// re-export the same operation but Box the returned session so the\n164\t// caller doesn't need to know the concrete `Self::Session` type.\n165\t// Blanket impls plumb every `ClientConfig` / `ServerConfig` through\n166\t// to these.\n167\t\n168\t/// Dyn-compatible mirror of [`ClientConfig`].\n169\tpub trait DynClientConfig: Send {\n170\t    /// Start a fresh client-side TLS session, boxing the result.\n171\t    fn start_session(\n172\t        &self,\n173\t        version: u32,\n174\t        server_name: &str,\n175\t        transport_params: &[u8],\n176\t    ) -> Result<Box<dyn Session>, ConfigError>;\n177\t}\n178\t\n179\timpl<T> DynClientConfig for T\n180\twhere\n181\t    T: ClientConfig + Send,\n182\t    T::Session: 'static,\n183\t{\n184\t    fn start_session(\n185\t        &self,\n186\t        version: u32,\n187\t        server_name: &str,\n188\t        transport_params: &[u8],\n189\t    ) -> Result<Box<dyn Session>, ConfigError> {\n190\t        ClientConfig::start_session(self, version, server_name, transport_params)\n191\t            .map(|s| Box::new(s) as Box<dyn Session>)\n192\t    }\n193\t}\n194\t\n195\t/// Dyn-compatible mirror of [`ServerConfig`].\n196\tpub trait DynServerConfig: Send {\n197\t    fn start_session(\n198\t        &self,\n199\t        version: u32,\n200\t        transport_params: &[u8],\n201\t    ) -> Result<Box<dyn Session>, ConfigError>;\n202\t}\n203\t\n204\timpl<T> DynServerConfig for T\n205\twhere\n206\t    T: ServerConfig + Send,\n207\t    T::Session: 'static,\n208\t{\n209\t    fn start_session(\n210\t        &self,\n211\t        version: u32,\n212\t        transport_params: &[u8],\n213\t    ) -> Result<Box<dyn Session>, ConfigError> {\n214\t        ServerConfig::start_session(self, version, transport_params)\n215\t            .map(|s| Box::new(s) as Box<dyn Session>)\n216\t    }\n217\t}\n218\t\n219\t// ---------------------------------------------------------------------------\n220\t// Packet protection (AEAD layer).\n221\t\n222\t/// One direction of packet protection (client-to-server, or\n223\t/// vice versa).  Hides the AEAD primitive from the rest of\n224\t/// picoquic; backend implementations hold an `aead::AeadInPlace`\n225\t/// from a Rust Crypto crate.\n226\tpub trait PacketKey: Send {\n227\t    /// In-place encrypt: `payload[..]` is the plaintext on\n228\t    /// entry; on success the ciphertext + 16-byte auth tag\n229\t    /// fills `payload`.  `header` is the AAD.  `packet` is the\n230\t    /// QUIC packet sequence number, used to derive the AEAD\n231\t    /// nonce.\n232\t    fn encrypt(&self, packet: u64, header: &[u8], payload: &mut Vec<u8>);\n233\t\n234\t    /// In-place decrypt + tag verify.  Shrinks `payload` by\n235\t    /// the tag length on success.\n236\t    fn decrypt(&self, packet: u64, header: &[u8], payload: &mut Vec<u8>) -> Result<(), Error>;\n237\t\n238\t    /// AEAD tag length (16 for all QUIC-defined cipher suites).\n239\t    fn tag_len(&self) -> usize;\n240\t\n241\t    /// Maximum number of packets that may be received before\n242\t    /// the integrity guarantee weakens (RFC 9001 §6.6).\n243\t    fn integrity_limit(&self) -> u64;\n244\t\n245\t    /// Maximum number of packets that may be sent before the\n246\t    /// confidentiality guarantee weakens (RFC 9001 §6.6).\n247\t    fn confidentiality_limit(&self) -> u64;\n248\t}\n249\t\n250\t/// Pair of keys for one direction (typically one for encrypt,\n251\t/// one for decrypt).  Both ends of a connection hold one\n252\t/// `KeyPair` per epoch.\n253\tpub struct KeyPair {\n254\t    /// Encrypt-side key (used for outbound packets).\n255\t    pub local: Box<dyn PacketKey>,\n256\t    /// Decrypt-side key (used for inbound packets).\n257\t    pub remote: Box<dyn PacketKey>,\n258\t}\n259\t\n260\t// ---------------------------------------------------------------------------\n261\t// Header protection.\n262\t\n263\t/// Header-protection key.  All QUIC cipher suites use a single AES\n264\t/// (or ChaCha20) ECB-style transform: feed it a 16-byte sample of\n265\t/// ciphertext and it returns a 16-byte mask whose first 5 bytes\n266\t/// XOR into the protected header.  The trait surface here is\n267\t/// exactly that bare cipher op — picoquic-side logic\n268\t/// ([`crate::header_protection`]) handles sampling, slicing the\n269\t/// header, and applying the mask.\n270\tpub trait HeaderKey: Send {\n271\t    /// Apply the ECB-style block to `sample`, producing the 16-byte\n272\t    /// header-protection mask.  RFC 9001 §5.4.\n273\t    fn mask(&self, sample: [u8; 16]) -> [u8; 16];\n274\t}\n275\t\n276\t/// Bundle of keys associated with a single epoch.\n277\tpub struct Keys {\n278\t    pub header: KeyPairHeader,\n279\t    pub packet: KeyPair,\n280\t}\n281\t\n282\t/// Pair of header-protection keys.\n283\tpub struct KeyPairHeader {\n284\t    pub local: Box<dyn HeaderKey>,\n285\t    pub remote: Box<dyn HeaderKey>,\n286\t}\n287\t\n288\t// ---------------------------------------------------------------------------\n289\t// Side-channel data surfaced through `Session`.\n290\t\n291\t/// Server-side handshake data.  Available after the first\n292\t/// ClientHello arrives.\n293\tpub struct HandshakeData {\n294\t    /// SNI (server-name-indication) value from the ClientHello.\n295\t    pub sni: Option<Vec<u8>>,\n296\t    /// Negotiated ALPN value, if any.\n297\t    pub alpn: Option<Vec<u8>>,\n298\t}\n299\t\n300\t/// Peer identity (typically the certificate chain).\n301\tpub enum PeerIdentity {\n302\t    /// X.509 certificate chain.  Each element is one DER-encoded\n303\t    /// certificate.\n304\t    Certificates(Vec<Vec<u8>>),\n305\t}\n306\t\n307\t// ---------------------------------------------------------------------------\n308\t// Application-supplied callbacks.\n309\t\n310\t/// Hooks the TLS layer invokes on the application.  One trait\n311\t/// covers ALPN selection, the resumption-ticket store, and\n312\t/// certificate verification.  Default implementations cover\n313\t/// the simple cases; override for custom behavior.\n314\t///\n315\t/// The application installs an implementation at QUIC-context\n316\t/// construction time (one entry point — no C-style global\n317\t/// registry of function pointers).\n318\tpub trait TlsCallbacks: Send {\n319\t    /// Negotiate ALPN from the client's proposal list.  Default:\n320\t    /// pick the first proposal that matches the server's\n321\t    /// configured ALPN list (set on the backend's config).\n322\t    fn select_alpn(&mut self, _list: &[&[u8]]) -> Option<usize> {\n323\t        None\n324\t    }\n325\t\n326\t    /// Server-side: look up a previously-issued session ticket\n327\t    /// keyed by the SNI / ALPN combination.  Default: return\n328\t    /// `None` (no resumption).\n329\t    fn lookup_ticket(&mut self, _sni: &str, _alpn: &str) -> Option<Vec<u8>> {\n330\t        None\n331\t    }\n332\t\n333\t    /// Server-side: persist a freshly-issued session ticket.\n334\t    /// Default: discard.\n335\t    fn store_ticket(&mut self, _sni: &str, _alpn: &str, _ticket: &[u8]) {}\n336\t\n337\t    /// Verify the peer certificate chain.  Default: trust any\n338\t    /// chain rooted in the system trust store (backends that\n339\t    /// don't have a system store provide their own default).\n340\t    fn verify_certificate(&mut self, _certs: &[&[u8]]) -> Result<(), Error> {\n341\t        Ok(())\n342\t    }\n343\t}\n344\t\n345\t// ---------------------------------------------------------------------------\n346\t// Backend-construction errors.\n347\t\n348\t/// Backend-construction failure (bad config, unsupported\n349\t/// version, etc.).  Distinct from the runtime-error\n350\t/// [`crate::Error`] so type-system can enforce that\n351\t/// `start_session` doesn't return a generic `Error`.\n352\t#[derive(Debug)]\n353\tpub struct ConfigError {\n354\t    pub message: alloc::string::String,\n355\t}\n356\t\n357\t#[cfg(test)]\n358\tmod test {}\n359\t"}]},"parent_tool_use_id":"toolu_019hJ3usbndovtpVpSYaBo87","session_id":"c6df50c8-84e7-456d-b33a-aec683aa6926","uuid":"12248ae1-ce1d-4969-ad1c-22b1c774bd0b","timestamp":"2026-05-05T17:25:09.639Z"}
