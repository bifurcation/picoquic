{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01H5fRShia3dCGjSHfwwPvrb","type":"tool_result","content":"105\t/// can add more as needed.  Marked `#[non_exhaustive]` so adding\n106\t/// variants later isn't a breaking change.\n107\t#[derive(Debug, Clone, Copy, PartialEq, Eq)]\n108\t#[non_exhaustive]\n109\tpub enum Error {\n110\t    /// Catch-all placeholder for paths Phase 1 has not yet\n111\t    /// distinguished.  Phase 3 should narrow these.\n112\t    Generic,\n113\t    /// Allocation failed.\n114\t    Memory,\n115\t    /// Caller supplied an invalid argument.\n116\t    InvalidArgument,\n117\t    /// A buffer the caller supplied was too small.\n118\t    BufferTooSmall,\n119\t    /// Caller-supplied file does not exist.\n120\t    NoSuchFile,\n121\t    /// Caller-supplied file was malformed.\n122\t    InvalidFile,\n123\t    /// Connection has been disconnected.\n124\t    Disconnected,\n125\t    /// Connection state didn't permit the requested operation.\n126\t    InvalidState,\n127\t    /// Operation produced or received a malformed QUIC frame.\n128\t    InvalidFrame,\n129\t    /// TLS / crypto error.\n130\t    Tls,\n131\t    /// Other QUIC protocol error; the wrapped value is the\n132\t    /// numeric `ERROR_*` code defined in this module.\n133\t    Protocol(u64),\n134\t}\n135\t\n136\timpl core::fmt::Display for Error {\n137\t    fn fmt(&self, f: &mut core::fmt::Formatter<'_>) -> core::fmt::Result {\n138\t        write!(f, \"{:?}\", self)\n139\t    }\n140\t}\n141\t\n142\timpl core::error::Error for Error {}\n143\t\n144\t/// Crate-wide `Result` alias defaulting the error type to [`Error`].\n145\tpub type Result<T, E = Error> = core::result::Result<T, E>;\n146\t\n147\t/// Wall-clock instant in microseconds since some application-defined\n148\t/// epoch.  Replaces the C `uint64_t current_time` parameter that\n149\t/// threads through every API call needing \"now\".  The type is\n150\t/// `Copy`, supports arithmetic with [`Duration`], and converts to\n151\t/// `u64` cheaply via `.ticks()` when crossing wire boundaries.\n152\t///\n153\t/// Phase 2 decision: per-call `current_time: Instant` parameters\n154\t/// stay (matches the C source's design — caller decides what time\n155\t/// it is).  No `Clock` trait at the library level; applications\n156\t/// can build a clock-injecting wrapper around the calls if they\n157\t/// want that style.\n158\tpub type Instant = fugit::Instant<u64, 1, 1_000_000>;\n159\t\n160\t/// Duration in microseconds.  Companion to [`Instant`].  Use for\n161\t/// timeouts, RTTs, jitter, etc.  In the C source these are bare\n162\t/// `uint64_t` values labelled by context (`idle_timeout`,\n163\t/// `microsec_latency`, …); the typed alias makes the unit explicit.\n164\tpub type Duration = fugit::Duration<u64, 1, 1_000_000>;"}]},"parent_tool_use_id":null,"session_id":"c6df50c8-84e7-456d-b33a-aec683aa6926","uuid":"b002480e-cb17-430c-8c01-52bcfea8f1a8","timestamp":"2026-05-05T17:05:17.252Z","tool_use_result":{"type":"text","file":{"filePath":"/Users/richbarn/Projects/picoquic/rs/fq/src/lib.rs","content":"/// can add more as needed.  Marked `#[non_exhaustive]` so adding\n/// variants later isn't a breaking change.\n#[derive(Debug, Clone, Copy, PartialEq, Eq)]\n#[non_exhaustive]\npub enum Error {\n    /// Catch-all placeholder for paths Phase 1 has not yet\n    /// distinguished.  Phase 3 should narrow these.\n    Generic,\n    /// Allocation failed.\n    Memory,\n    /// Caller supplied an invalid argument.\n    InvalidArgument,\n    /// A buffer the caller supplied was too small.\n    BufferTooSmall,\n    /// Caller-supplied file does not exist.\n    NoSuchFile,\n    /// Caller-supplied file was malformed.\n    InvalidFile,\n    /// Connection has been disconnected.\n    Disconnected,\n    /// Connection state didn't permit the requested operation.\n    InvalidState,\n    /// Operation produced or received a malformed QUIC frame.\n    InvalidFrame,\n    /// TLS / crypto error.\n    Tls,\n    /// Other QUIC protocol error; the wrapped value is the\n    /// numeric `ERROR_*` code defined in this module.\n    Protocol(u64),\n}\n\nimpl core::fmt::Display for Error {\n    fn fmt(&self, f: &mut core::fmt::Formatter<'_>) -> core::fmt::Result {\n        write!(f, \"{:?}\", self)\n    }\n}\n\nimpl core::error::Error for Error {}\n\n/// Crate-wide `Result` alias defaulting the error type to [`Error`].\npub type Result<T, E = Error> = core::result::Result<T, E>;\n\n/// Wall-clock instant in microseconds since some application-defined\n/// epoch.  Replaces the C `uint64_t current_time` parameter that\n/// threads through every API call needing \"now\".  The type is\n/// `Copy`, supports arithmetic with [`Duration`], and converts to\n/// `u64` cheaply via `.ticks()` when crossing wire boundaries.\n///\n/// Phase 2 decision: per-call `current_time: Instant` parameters\n/// stay (matches the C source's design — caller decides what time\n/// it is).  No `Clock` trait at the library level; applications\n/// can build a clock-injecting wrapper around the calls if they\n/// want that style.\npub type Instant = fugit::Instant<u64, 1, 1_000_000>;\n\n/// Duration in microseconds.  Companion to [`Instant`].  Use for\n/// timeouts, RTTs, jitter, etc.  In the C source these are bare\n/// `uint64_t` values labelled by context (`idle_timeout`,\n/// `microsec_latency`, …); the typed alias makes the unit explicit.\npub type Duration = fugit::Duration<u64, 1, 1_000_000>;","numLines":60,"startLine":105,"totalLines":2855}}}
