{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01XcsZjZy7GFvFR3Msq1qYe4","type":"tool_result","content":"697\t\n698\t    let predicted_length = {\n699\t        let cnx = quic.connection_ref_by_id(i_cid).unwrap();\n700\t        cnx.predict_packet_header_length_for_pc(hlc.ptype, pc)\n701\t    };\n702\t\n703\t    // Dequeue / re-queue for the after-state\n704\t    {\n705\t        let cnx = quic.connection_ref_by_id(i_cid).unwrap();\n706\t        if hlc.sequence_unack != hlc.sequence_unack_after {\n707\t            if hlc.sequence_unack.is_some() {\n708\t                cnx.dequeue_first_pending_for_pc(pc);\n709\t            }\n710\t            if let Some(unack_after) = hlc.sequence_unack_after {\n711\t                cnx.queue_unacked_packet_for_pc(\n712\t                    pc,\n713\t                    hlc.ptype,\n714\t                    unack_after,\n715\t                    crate::MAX_PACKET_SIZE,\n716\t                    current_time,\n717\t                );\n718\t            }\n719\t        }\n720\t    }\n721\t\n722\t    let mut buffer = [0u8; crate::MAX_PACKET_SIZE];\n723\t    let mut pn_offset = 0usize;\n724\t    let mut pn_length = 0usize;\n725\t    let header_length = {\n726\t        let cnx = quic.connection_ref_by_id(i_cid).unwrap();\n727\t        cnx.create_packet_header_at(\n728\t            hlc.ptype,\n729\t            hlc.sequence,\n730\t            0,\n731\t            0,\n732\t            predicted_length,\n733\t            &mut buffer,\n734\t            &mut pn_offset,\n735\t            &mut pn_length,\n736\t        )\n737\t    };\n738\t\n739\t    assert_eq!(\n740\t        header_length, predicted_length,\n741\t        \"predicted={predicted_length} actual={header_length}\"\n742\t    );\n743\t    assert!(\n744\t        pn_length > 0 && pn_length <= 4,\n745\t        \"invalid pn_length {pn_length}\"\n746\t    );\n747\t    assert_eq!(\n748\t        pn_length + pn_offset,\n749\t        header_length,\n750\t        \"pn_offset={pn_offset} + pn_length={pn_length} != header_length={header_length}\"\n751\t    );\n752\t}\n753\t\n754\t/// C: `header_length_test` in `picoquictest/parseheadertest.c`.\n755\t#[test]\n756\tfn header_length() {"}]},"parent_tool_use_id":"toolu_01FNJRg8YhsoxF5PXikNyYX1","session_id":"6e30a456-15c0-4e3c-af27-9f4dab375915","uuid":"ed25bc39-4114-4f76-88fb-3eb1f99a199e","timestamp":"2026-05-05T21:50:17.528Z"}
