{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01Vjw8rcxHhAvVaSihFEEgfi","type":"tool_result","content":"200\tpub const fn bits_set_in_range(v: u64, min: u64, max: u64, bits: u64) -> bool {\n201\t    (v & !(min ^ max ^ bits)) == (min ^ bits)\n202\t}\n203\t\n204\t/// `BITS_CLEAR_IN_RANGE(v, min, max, bits)`.\n205\t#[inline]\n206\tpub const fn bits_clear_in_range(v: u64, min: u64, max: u64, bits: u64) -> bool {\n207\t    (v & !(min ^ max ^ bits)) == min\n208\t}\n209\t\n210\t// ---------------------------------------------------------------------------\n211\t// Frame types.\n212\t\n213\t// `FrameType` lives in [`crate::frames`].\n214\t\n215\t// ---------------------------------------------------------------------------\n216\t// PMTU discovery requirement status.\n217\t\n218\t#[derive(Debug, Copy, Clone, PartialEq, Eq, Default)]\n219\t#[repr(u8)]\n220\tpub enum PmtuDiscoveryStatus {\n221\t    #[default]\n222\t    NotNeeded = 0,\n223\t    Optional,\n224\t    Required,\n225\t}\n226\t\n227\t// ---------------------------------------------------------------------------\n228\t// Supported QUIC versions.\n229\t\n230\t/// QUIC version codes recognised by this build.  Wire values are the\n231\t/// `u32` `Initial` packet version field; `TryFrom<u32>` converts an\n232\t/// arbitrary wire value to a [`Version`] (or fails when the version\n233\t/// isn't recognised).\n234\t#[derive(Debug, Copy, Clone, PartialEq, Eq)]\n235\t#[repr(u32)]\n236\tpub enum Version {\n237\t    SeventeenthInterop = 0xFF00001B,\n238\t    EighteenthInterop = 0xFF00001C,\n239\t    NineteenthInterop = 0xFF00001D,\n240\t    NineteenthBisInterop = 0xFF00001E,\n241\t    TwentiethPreInterop = 0xFF00001F,\n242\t    TwentiethInterop = 0xFF000020,\n243\t    TwentyFirstInterop = 0xFF000021,\n244\t    PostIesg = 0xFF000022,\n245\t    V1 = 0x00000001,\n246\t    V2 = 0x6b3343cf,\n247\t    V2Draft = 0x709a50c4,\n248\t    InternalTest1 = 0x50435130,\n249\t    InternalTest2 = 0x50435131,\n250\t}\n251\t\n252\t/// First entry in `Version`'s declaration order — the canonical\n253\t/// interop version reported by `INTEROP_VERSION_LATEST` in C.\n254\tpub const INTEROP_VERSION_LATEST: Version = Version::NineteenthInterop;\n255\t\n256\timpl Version {\n257\t    /// Resolve `proposed` to a known [`Version`] (RFC 9000 §15\n258\t    /// \"Versions\").  C: `get_version_index`.\n259\t    pub fn try_from_wire(proposed: u32) -> Option<Self> {\n260\t        // SKIP: try_from_wire: version table requires static crypto byte arrays not yet wired up;\n261\t        // returning None for all until Version::parameters is implemented\n262\t        match proposed {\n263\t            0x00000001 => Some(Version::V1),\n264\t            0x6b3343cf => Some(Version::V2),\n265\t            0x709a50c4 => Some(Version::V2Draft),\n266\t            0xFF00001B => Some(Version::SeventeenthInterop),\n267\t            0xFF00001C => Some(Version::EighteenthInterop),\n268\t            0xFF00001D => Some(Version::NineteenthInterop),\n269\t            0xFF00001E => Some(Version::NineteenthBisInterop),\n270\t            0xFF00001F => Some(Version::TwentiethPreInterop),\n271\t            0xFF000020 => Some(Version::TwentiethInterop),\n272\t            0xFF000021 => Some(Version::TwentyFirstInterop),\n273\t            0xFF000022 => Some(Version::PostIesg),\n274\t            0x50435130 => Some(Version::InternalTest1),\n275\t            0x50435131 => Some(Version::InternalTest2),\n276\t            _ => None,\n277\t        }\n278\t    }\n279\t\n280\t    /// Per-version cryptographic and label parameters.  C:\n281\t    /// `picoquic_supported_versions[]`'s row for this version.\n282\t    pub fn parameters(self) -> VersionParameters {\n283\t        // SKIP: parameters: requires static crypto byte slices from C tables not yet ported\n284\t        // Returning a placeholder V1 parameters for now\n285\t        VersionParameters {\n286\t            version: self,\n287\t            version_aead_key: &[],\n288\t            version_retry_key: &[],\n289\t            tls_prefix_label: \"tls13 quic \",\n290\t            tls_traffic_update_label: \"quic ku\",\n291\t            packet_type_version: self as u32,\n292\t            upgrade_from: &[],\n293\t        }\n294\t    }\n295\t}\n296\t\n297\t/// Per-version cryptographic and label parameters.  C:\n298\t/// `VersionParameters`.\n299\t///\n300\t/// `version_aead_key` and `version_retry_key` are static byte\n301\t/// tables in the C source — Rust models them as borrowed slices.\n302\t/// `upgrade_from` is a `NULL`-terminated list in C; here it is a\n303\t/// borrowed slice, with an empty slice for \"no upgrade path\".\n304\t#[derive(Debug)]\n305\tpub struct VersionParameters {\n306\t    pub version: Version,\n307\t    pub version_aead_key: &'static [u8],\n308\t    pub version_retry_key: &'static [u8],\n309\t    pub tls_prefix_label: &'static str,\n310\t    pub tls_traffic_update_label: &'static str,\n311\t    pub packet_type_version: u32,\n312\t    pub upgrade_from: &'static [Version],\n313\t}\n314\t\n315\t// ---------------------------------------------------------------------------\n316\t// Crypto epochs and packet types.\n317\t\n318\t#[derive(Debug, Copy, Clone, PartialEq, Eq)]\n319\t#[repr(u8)]\n320\tpub enum Epoch {\n321\t    Initial = 0,\n322\t    ZeroRtt = 1,\n323\t    Handshake = 2,\n324\t    OneRtt = 3,\n325\t}\n326\t\n327\t#[derive(Debug, Copy, Clone, PartialEq, Eq)]\n328\t#[repr(u8)]\n329\tpub enum PacketType {\n330\t    Error = 0,\n331\t    VersionNegotiation,\n332\t    Initial,\n333\t    Retry,\n334\t    Handshake,\n335\t    ZeroRttProtected,\n336\t    OneRttProtected,\n337\t    TypeMax,\n338\t}\n339\t\n340\t// ---------------------------------------------------------------------------\n341\t// Packet header.\n342\t\n343\t/// Parsed long/short packet header.  C: `PacketHeader`.\n344\t///\n345\t/// The C struct uses a packed bitfield for eight single-bit\n346\t/// flags; Rust stores them as plain `bool` fields (one per flag).\n347\tpub struct PacketHeader {\n348\t    pub dest_connection_id: ConnectionId,\n349\t    pub src_connection_id: ConnectionId,\n350\t    /// Truncated packet number as it appeared on the wire (1-4 bytes,\n351\t    /// extended to `u32`).  Reconstructed full PN is in\n352\t    /// [`Self::packet_number_full`].\n353\t    pub packet_number_truncated: u32,\n354\t    pub version: u32,\n355\t    pub offset: usize,\n356\t    pub packet_number_offset: usize,\n357\t    pub packet_type: PacketType,\n358\t    pub packet_number_mask: u64,\n359\t    pub packet_number_full: u64,\n360\t    pub payload_length: usize,\n361\t    pub version_index: i32,\n362\t    pub epoch: Epoch,\n363\t    pub packet_context: PacketContext,\n364\t\n365\t    pub key_phase: bool,\n366\t    pub spin: bool,\n367\t    pub has_spin_bit: bool,\n368\t    pub has_reserved_bit_set: bool,\n369\t    pub has_loss_bits: bool,\n370\t    pub loss_bit_q: bool,\n371\t    pub loss_bit_l: bool,\n372\t    pub quic_bit_is_zero: bool,\n373\t\n374\t    /// Borrowed token bytes (length implicit in the slice).  Phase\n375\t    /// 4 plan: `IncomingPacket` decoders carry a lifetime; the\n376\t    /// `token_length` field is gone (it lived only as the slice's\n377\t    /// length).\n378\t    pub token_bytes: Vec<u8>,\n379\t    pub payload_length_value: usize,\n380\t    /// Token into [`Quic`]'s arena for the local CID this packet\n381\t    /// targets, if any.  C: `*mut LocalConnectionId` back-pointer.\n382\t    pub local_connection_id: Option<LocalConnectionIdToken>,\n383\t}\n384\t\n385\t// ---------------------------------------------------------------------------\n386\t// Spin-bit policy vtable.\n387\t\n388\t/// Spin-bit policy: how to update the spin bit on an incoming\n389\t/// packet, and what value to emit on outgoing packets.  In C the\n390\t/// policy is two function pointers grouped into\n391\t/// `SpinbitDef`; the two are always installed\n392\t/// together so they share one Rust trait.\n393\tpub trait SpinBitPolicy: Sync {\n394\t    /// C: `spinbit_incoming_fn`.\n395\t    fn incoming(&self, connection: &mut Connection, path_x: &mut Path, ph: &PacketHeader);\n396\t\n397\t    /// C: `spinbit_outgoing_fn`.\n398\t    fn outgoing(&self, connection: &mut Connection) -> u8;\n399\t}"}]},"parent_tool_use_id":"toolu_01FNJRg8YhsoxF5PXikNyYX1","session_id":"6e30a456-15c0-4e3c-af27-9f4dab375915","uuid":"5cb65980-eef9-473c-8963-4726d4accea6","timestamp":"2026-05-05T21:19:56.013Z"}
