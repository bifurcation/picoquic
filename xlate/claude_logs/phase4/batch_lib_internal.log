8\t        Ok(token)\n5329\t    }\n5330\t}\n5331\t\n5332\timpl Connection {\n5333\t    pub fn demote_local_connection_id_list(&mut self, unique_path_id: u64, _reason: u64) -> i32 {\n5334\t        if let Some(list) = self\n5335\t            .local_connection_id_lists\n5336\t            .iter_mut()\n5337\t            .find(|l| l.unique_path_id == unique_path_id)\n5338\t        {\n5339\t            if !list.is_demoted {\n5340\t                list.is_demoted = true;\n5341\t                return 1;\n5342\t            }\n5343\t        }\n5344\t        0\n5345\t    }\n5346\t}\n5347\t\n5348\timpl Connection {\n5349\t    pub fn delete_local_connection_id(&mut self, l_cid: LocalConnectionIdToken) {\n5350\t        // Remove from the backing arena.\n5351\t        let removed = self.local_connection_ids.remove(l_cid);\n5352\t        if removed.is_none() {\n5353\t            // Stale token — no-op.\n5354\t            return;\n5355\t        }\n5356\t        // Remove the token from whichever list holds it.\n5357\t        for list in &mut self.local_connection_id_lists {\n5358\t            if let Some(pos) = list.connection_ids.iter().position(|t| *t == l_cid) {\n5359\t                list.connection_ids.swap_remove(pos);\n5360\t                break;\n5361\t            }\n5362\t        }\n5363\t    }\n5364\t}\n5365\t\n5366\timpl Connection {\n5367\t    /// Remove `connection.local_connection_id_lists[list_index]`.\n5368\t    pub fn delete_local_connection_id_list(&mut self, list_index: usize) {\n5369\t        if list_index >= self.local_connection_id_lists.len() {\n5370\t            return;\n5371\t        }\n5372\t        // Remove all CIDs in this list from the arena.\n5373\t        let tokens: Vec<LocalConnectionIdToken> =\n5374\t            self.local_connection_id_lists[list_index].connection_ids.clone();\n5375\t        for tok in tokens {\n5376\t            self.local_connection_ids.remove(tok);\n5377\t        }\n5378\t        self.local_connection_id_lists.swap_remove(list