{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01VeYK2Ad7j5q9ovXL1L4aR1","type":"tool_result","content":"642\timpl Quic {\n643\t    /// Cache a session ticket alongside the transport-parameters that\n644\t    /// were in force at the time, indexed by `(sni, alpn, version)`.\n645\t    #[allow(clippy::too_many_arguments)]\n646\t    pub fn store_ticket(\n647\t        &mut self,\n648\t        sni: Option<&str>,\n649\t        alpn: Option<&str>,\n650\t        version: u32,\n651\t        ip_addr: core::net::IpAddr,\n652\t        ip_addr_client: core::net::IpAddr,\n653\t        ticket: &[u8],\n654\t        tp: &TransportParameters,\n655\t    ) -> Result<(), crate::Error> {\n656\t        // Remove any old ticket for the same (sni, alpn, version) key.\n657\t        self.stored_tickets.retain(|t| {\n658\t            t.sni.as_deref() != sni || t.alpn.as_deref() != alpn || t.version != version\n659\t        });\n660\t        let stored = StoredTicket {\n661\t            sni: sni.map(str::to_owned),\n662\t            alpn: alpn.map(str::to_owned),\n663\t            ip_addr,\n664\t            ip_addr_client,\n665\t            tp_0rtt: {\n666\t                use crate::tp::TransportParameter0RttKind::*;\n667\t                let mut arr = [0u64; crate::tp::NB_TP_0RTT];\n668\t                arr[MaxData as usize] = tp.initial_max_data;\n669\t                arr[MaxStreamDataBidiLocal as usize] = tp.initial_max_stream_data_bidi_local;\n670\t                arr[MaxStreamDataBidiRemote as usize] = tp.initial_max_stream_data_bidi_remote;\n671\t                arr[MaxStreamDataUni as usize] = tp.initial_max_stream_data_uni;\n672\t                arr[MaxStreamsIdBidir as usize] = tp.initial_max_stream_id_bidir;\n673\t                arr[MaxStreamsIdUnidir as usize] = tp.initial_max_stream_id_unidir;\n674\t                arr\n675\t            },\n676\t            ticket: ticket.to_vec(),\n677\t            time_valid_until: crate::Instant::from_ticks(0),\n678\t            version,\n679\t            was_used: false,\n680\t        };\n681\t        self.stored_tickets.push(stored);\n682\t        Ok(())\n683\t    }\n684\t\n685\t    /// Retrieve a cached ticket record (without consuming it).\n686\t    /// `need_unused` skips already-used tickets.\n687\t    pub fn get_stored_ticket(\n688\t        &self,\n689\t        _sni: Option<&str>,\n690\t        _alpn: Option<&str>,\n691\t        _version: u32,\n692\t        _need_unused: bool,\n693\t        _ticket_id: u64,\n694\t    ) -> Option<&mut StoredTicket> {\n695\t        // SKIP: get_stored_ticket: returns &mut from &self which requires unsafe or refcell;\n696\t        // the C side uses raw pointers. Returning None for now.\n697\t        None\n698\t    }\n699\t\n700\t    /// Output of [`Self::get_ticket`] / [`Self::get_ticket_and_version`].\n701\t    /// Replaces the C trio of out-parameters\n702\t    /// (`uint8_t** ticket`, `uint16_t* ticket_length`,\n703\t    /// `picoquic_tp_t* tp`).  The byte slice borrows from the\n704\t    /// cached ticket entry.\n705\t    #[allow(clippy::too_many_arguments)]\n706\t    pub fn get_ticket(\n707\t        &mut self,\n708\t        sni: Option<&str>,\n709\t        alpn: Option<&str>,\n710\t        version: u32,\n711\t        mark_used: bool,\n712\t    ) -> Result<(&[u8], TransportParameters), crate::Error> {\n713\t        let idx = self\n714\t            .stored_tickets\n715\t            .iter()\n716\t            .position(|t| {\n717\t                t.sni.as_deref() == sni\n718\t                    && t.alpn.as_deref() == alpn\n719\t                    && t.version == version\n720\t                    && !t.was_used\n721\t            })\n722\t            .ok_or(crate::Error::Generic)?;\n723\t        if mark_used {\n724\t            self.stored_tickets[idx].was_used = true;\n725\t        }\n726\t        // SKIP: get_ticket: lifetime of returned slice tied to self; cannot safely borrow\n727\t        // after mutating. Returning Err for now - caller must be reworked.\n728\t        Err(crate::Error::Generic)\n729\t    }\n730\t\n731\t    /// As [`Self::get_ticket`] but also returns the QUIC version\n732\t    /// the ticket was issued for (in the first tuple slot).\n733\t    pub fn get_ticket_and_version(\n734\t        &mut self,\n735\t        _sni: Option<&str>,\n736\t        _alpn: Option<&str>,\n737\t        _version: u32,\n738\t        _mark_used: bool,\n739\t    ) -> Result<(u32, &[u8], TransportParameters), crate::Error> {\n740\t        // SKIP: get_ticket_and_version: same lifetime/borrow issue as get_ticket\n741\t        Err(crate::Error::Generic)\n742\t    }\n743\t\n744\t    /// Load cached tickets from `ticket_file_name`.\n745\t    pub fn load_tickets(\n746\t        &mut self,\n747\t        _ticket_file_name: &(impl AsRef<std::path::Path> + ?Sized),\n748\t    ) -> Result<(), crate::Error> {\n749\t        // SKIP: load_tickets: requires binary deserialization of C ticket format\n750\t        Ok(())\n751\t    }\n752\t\n753\t    /// Persist the cached ticket vector to `ticket_file_name`,\n754\t    /// dropping entries that expired before `current_time`.  C:\n755\t    /// `save_tickets` (operated on the C linked-list head).\n756\t    pub fn save_tickets(\n757\t        &self,\n758\t        _current_time: Instant,\n759\t        _ticket_file_name: &(impl AsRef<std::path::Path> + ?Sized),\n760\t    ) -> Result<(), crate::Error> {\n761\t        // SKIP: save_tickets: requires binary serialization of C ticket format\n762\t        Ok(())\n763\t    }\n764\t}\n765\t\n766\t// `free_tickets` is gone -- `Quic.stored_tickets.clear()` is the\n767\t// Rust equivalent (Drop frees each entry).\n768\t\n769\timpl Connection {\n770\t    /// Stash this connection's RTT and CWIN into the issued-ticket\n771\t    /// table so a future resumption can seed bandwidth estimates.\n772\t    pub fn seed_ticket(&mut self, path_x: &mut Path) {\n773\t        // SKIP: seed_ticket: requires access to quic context (not available on Connection alone)\n774\t        // In C, calls into quic->remember_issued_ticket or picoquic_update_stored_ticket\n775\t        // Just mark the path as seeded.\n776\t        path_x.is_ticket_seeded = true;\n777\t    }\n778\t}\n779\t\n780\t// ---------------------------------------------------------------------------\n781\t// Stored retry-token (for client side, indexed by SNI + IP).\n782\t\n783\tpub struct StoredToken {\n784\t    /// Owned SNI string (C: `sni: *const c_char` plus `sni_length`).\n785\t    pub sni: Option<String>,\n786\t    /// Owned retry-token bytes (C: `token: *const u8` plus\n787\t    /// `token_length`).\n788\t    pub token: Vec<u8>,\n789\t    /// Server IP address.\n790\t    pub ip_addr: core::net::IpAddr,\n791\t    pub time_valid_until: Instant,"}]},"parent_tool_use_id":"toolu_01FNJRg8YhsoxF5PXikNyYX1","session_id":"6e30a456-15c0-4e3c-af27-9f4dab375915","uuid":"d80d7d45-5aa3-4c57-a80b-f55f5f360054","timestamp":"2026-05-05T21:28:16.765Z"}
