{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01M4Ep9MYUkCdvzCLUe8i9gn","type":"tool_result","content":"1\t//! Tests for `picoquictest/parseheadertest.c`.\n2\t//!\n3\t//! Tests covered:\n4\t//! * [`header_length`]    — C `header_length_test`\n5\t//! * [`incoming_initial`] — C `incoming_initial_test`\n6\t//! * [`packet_enc_dec`]   — C `packet_enc_dec_test`\n7\t//! * [`parseheader`]      — C `parseheadertest`\n8\t\n9\t#![allow(non_snake_case)]\n10\t\n11\tuse core::net::SocketAddr;\n12\t\n13\tuse crate::internal::{Epoch, PacketHeader, PacketType, Version, update_payload_length};\n14\tuse crate::{ConnectionId, Instant, PacketContext, Quic, RESET_SECRET_SIZE};\n15\t\n16\tuse super::util;\n17\t\n18\t// ---------------------------------------------------------------------------\n19\t// Shared test CIDs.\n20\t\n21\tfn ini_id() -> ConnectionId {\n22\t    ConnectionId::clone_from_slice(&[0x00, 0x01, 0x02, 0x03, 0x04, 0x05, 0x06, 0x07]).unwrap()\n23\t}\n24\tfn rem_id() -> ConnectionId {\n25\t    ConnectionId::clone_from_slice(&[0x04, 0x05, 0x06, 0x07]).unwrap()\n26\t}\n27\tfn local_id() -> ConnectionId {\n28\t    ConnectionId::clone_from_slice(&[0x01, 0x02, 0x03, 0x04, 0x05, 0x06, 0x07, 0x08]).unwrap()\n29\t}\n30\tfn r10_id() -> ConnectionId {\n31\t    ConnectionId::clone_from_slice(&[0x02, 0x03, 0x04, 0x05, 0x06, 0x07, 0x08, 0x09]).unwrap()\n32\t}\n33\t\n34\t// ---------------------------------------------------------------------------\n35\t// Test packet bytes and expected headers (see C test_entries[]).\n36\t\n37\t#[allow(dead_code)]\n38\tstruct TestEntry {\n39\t    packet: &'static [u8],\n40\t    ph: ExpectedPh,\n41\t    decode_test_only: bool,\n42\t    local_cid_length: u8,\n43\t}\n44\t\n45\t#[allow(dead_code)]\n46\tstruct ExpectedPh {\n47\t    dest_connection_id: fn() -> ConnectionId,\n48\t    src_connection_id: fn() -> ConnectionId,\n49\t    pn_truncated: u32,\n50\t    version: u32,\n51\t    offset: usize,\n52\t    pn_offset: usize,\n53\t    packet_type: PacketType,\n54\t    packet_number_full: u64,\n55\t    payload_length: usize,\n56\t    epoch: Epoch,\n57\t    packet_context: PacketContext,\n58\t    key_phase: bool,\n59\t    spin: bool,\n60\t    has_loss_bits: bool,\n61\t}\n62\t\n63\t// pinitial10\n64\tstatic PINITIAL10: &[u8] = &[\n65\t    0xC3, 0x50, 0x43, 0x51, 0x30, 0x08, // DCID len = 8\n66\t    0x00, 0x01, 0x02, 0x03, 0x04, 0x05, 0x06, 0x07, 0x04, // SCID len = 4\n67\t    0x04, 0x05, 0x06, 0x07, 0x00, // token len = 0\n68\t    0x44, 0x00, // payload length = 0x400\n69\t    0xDE, 0xAD, 0xBE, 0xEF, // PN\n70\t];\n71\t\n72\t// pinitial10_l (local CID in SCID)\n73\tstatic PINITIAL10_L: &[u8] = &[\n74\t    0xC3, 0x50, 0x43, 0x51, 0x30, 0x08, 0x00, 0x01, 0x02, 0x03, 0x04, 0x05, 0x06, 0x07,\n75\t    0x08, // SCID len = 8 (local CID)\n76\t    0x01, 0x02, 0x03, 0x04, 0x05, 0x06, 0x07, 0x08, 0x00, 0x44, 0x00, 0xDE, 0xAD, 0xBE, 0xEF,\n77\t];\n78\t\n79\t// pvnego10\n80\tstatic PVNEGO10: &[u8] = &[\n81\t    0xFF, 0x00, 0x00, 0x00, 0x00, 0x08, 0x02, 0x03, 0x04, 0x05, 0x06, 0x07, 0x08, 0x09, 0x04, 0x04,\n82\t    0x05, 0x06, 0x07, 0x50, 0x43, 0x51, 0x30, 0xFF, 0x00, 0x00, 0x07,\n83\t];\n84\t\n85\t// pvnegobis10 (first byte 0xAA instead of 0xFF)\n86\tstatic PVNEGOBIS10: &[u8] = &[\n87\t    0xAA, 0x00, 0x00, 0x00, 0x00, 0x08, 0x02, 0x03, 0x04, 0x05, 0x06, 0x07, 0x08, 0x09, 0x04, 0x04,\n88\t    0x05, 0x06, 0x07, 0x50, 0x43, 0x51, 0x30, 0xFF, 0x00, 0x00, 0x07,\n89\t];\n90\t\n91\t// phandshake\n92\tstatic PHANDSHAKE: &[u8] = &[\n93\t    0xE3, 0x50, 0x43, 0x51, 0x30, 0x08, 0x01, 0x02, 0x03, 0x04, 0x05, 0x06, 0x07, 0x08, 0x04, 0x04,\n94\t    0x05, 0x06, 0x07, 0x44, 0x00, 0xDE, 0xAD, 0xBE, 0xEF,\n95\t];\n96\t\n97\t// packet_short_phi0_c_32\n98\tstatic PACKET_SHORT_PHI0_C_32: &[u8] = &[\n99\t    0x43, 0x02, 0x03, 0x04, 0x05, 0x06, 0x07, 0x08, 0x09, 0xDE, 0xAD, 0xBE, 0xEF,\n100\t];"}]},"parent_tool_use_id":"toolu_01FNJRg8YhsoxF5PXikNyYX1","session_id":"6e30a456-15c0-4e3c-af27-9f4dab375915","uuid":"de85694a-fb48-46f9-9c45-