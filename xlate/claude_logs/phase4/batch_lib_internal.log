{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_0168xNXSKM7jaXs3aR8EgUVX","type":"tool_result","content":"4350\tpicoquic_cnx_t* picoquic_create_cnx(picoquic_quic_t* quic,\n4351\t    picoquic_connection_id_t initial_cnx_id, picoquic_connection_id_t remote_cnx_id,\n4352\t    const struct sockaddr* addr_to, uint64_t start_time, uint32_t preferred_version,\n4353\t    char const* sni, char const* alpn, char client_mode)\n4354\t{\n4355\t    PICOQUIC_THREAD_CHECK(quic);\n4356\t    return picoquic_create_cnx_internal(quic, initial_cnx_id, remote_cnx_id, addr_to, start_time, preferred_version,\n4357\t        sni, alpn, client_mode, NULL, NULL);\n4358\t}\n4359\t\n4360\tpicoquic_cnx_t* picoquic_create_client_cnx(picoquic_quic_t* quic,\n4361\t    struct sockaddr* addr, uint64_t start_time, uint32_t preferred_version,\n4362\t    char const* sni, char const* alpn, picoquic_stream_data_cb_fn callback_fn, void* callback_ctx)\n4363\t{\n4364\t    picoquic_cnx_t* cnx = picoquic_create_cnx(quic, picoquic_null_connection_id, picoquic_null_connection_id, addr, start_time, preferred_version, sni, alpn, 1);\n4365\t\n4366\t    if (cnx != NULL) {\n4367\t        int ret;\n4368\t\n4369\t        if (callback_fn != NULL)\n4370\t            cnx->callback_fn = callback_fn;\n4371\t        if (callback_ctx != NULL)\n4372\t            cnx->callback_ctx = callback_ctx;\n4373\t        ret = picoquic_start_client_cnx(cnx);\n4374\t        if (ret != 0) {\n4375\t            /* Cannot just do partial initialization! */\n4376\t            picoquic_delete_cnx(cnx);\n4377\t            cnx = NULL;\n4378\t        }\n4379\t    }\n4380\t\n4381\t    return cnx;\n4382\t}\n4383\t\n4384\tint picoquic_start_client_cnx(picoquic_cnx_t * cnx)\n4385\t{\n4386\t    int ret = 0;\n4387\t    PICOQUIC_THREAD_CHECK(cnx->quic);\n4388\t\n4389\t    if (cnx->cnx_state != picoquic_state_client_init ||\n4390\t        cnx->tls_stream[0].sent_offset > 0 ||\n4391\t        cnx->tls_stream[0].send_queue != NULL) {\n4392\t        DBG_PRINTF(\"%s\", \"picoquic_start_client_cnx called twice.\");\n4393\t        return -1;\n4394\t    }\n4395\t\n4396\t    picoquic_log_new_connection(cnx);\n4397\t        \n4398\t    ret = picoquic_initialize_tls_stream(cnx, picoquic_get_quic_time(cnx->quic));\n4399\t    /* A remote session ticket may have been loaded as part of initializing TLS,\n4400\t     * and remote parameters may have been initialized to the initial value\n4401\t     * of the previous session. Apply these new parameters. */\n4402\t    cnx->maxdata_remote = cnx->remote_parameters.initial_max_data;\n4403\t    cnx->max_stream_id_bidir_remote =\n4404\t        STREAM_ID_FROM_RANK(cnx->remote_parameters.initial_max_stream_id_bidir, cnx->client_mode, 0);\n4405\t    cnx->max_stream_id_unidir_remote = \n4406\t        STREAM_ID_FROM_RANK(cnx->remote_parameters.initial_max_stream_id_unidir, cnx->client_mode, 1);\n4407\t    cnx->max_stream_data_remote = cnx->remote_parameters.initial_max_data;\n4408\t    cnx->max_stream_data_local = cnx->local_parameters.initial_max_stream_data_bidi_local;\n4409\t\n4410\t    picoquic_reinsert_by_wake_time(cnx->quic, cnx, picoquic_get_quic_time(cnx->quic));\n4411\t\n4412\t    return ret;\n4413\t}\n4414\t\n4415\tvoid picoquic_set_transport_parameters(picoquic_cnx_t * cnx, picoquic_tp_t const * tp)\n4416\t{\n4417\t    PICOQUIC_THREAD_CHECK(cnx->quic);\n4418\t    cnx->local_parameters = *tp;\n4419\t\n4420\t    if (cnx->quic->mtu_max > 0 && cnx->local_parameters.max_packet_size == 0)\n4421\t    {\n4422\t        cnx->local_parameters.max_packet_size = cnx->quic->mtu_max - \n4423\t            PICOQUIC_MTU_OVERHEAD((struct sockaddr*)&(cnx->path[0])->first_tuple->peer_addr);\n4424\t    }\n4425\t\n4426\t    /* Initialize local flow control variables to advertised values */\n4427\t\n4428\t    cnx->maxdata_local = ((uint64_t)cnx->local_parameters.initial_max_data);\n4429\t    cnx->max_stream_id_bidir_local = STREAM_ID_FROM_RANK(\n4430\t        cnx->local_parameters.initial_max_stream_id_bidir, cnx->client_mode, 0);\n4431\t    cnx->max_stream_id_unidir_local = STREAM_ID_FROM_RANK(\n4432\t        cnx->local_parameters.initial_max_stream_id_unidir, cnx->client_mode, 1);\n4433\t}\n4434\t\n4435\tpicoquic_tp_t const* picoquic_get_transport_parameters(picoquic_cnx_t* cnx, int get_local)\n4436\t{\n4437\t    PICOQUIC_THREAD_CHECK(cnx->quic);\n4438\t    return(get_local) ? &cnx->local_parameters : &cnx->remote_parameters;\n4439\t}\n4440\t\n4441\tvoid picoquic_get_peer_addr(picoquic_cnx_t* cnx, struct sockaddr** addr)\n4442\t{\n4443\t    PICOQUIC_THREAD_CHECK(cnx->quic);\n4444\t    *addr = (struct sockaddr*)&cnx->path[0]->first_tuple->peer_addr;\n4445\t}\n4446\t\n4447\tvoid picoquic_get_local_addr(picoquic_cnx_t* cnx, struct sockaddr** addr)\n4448\t{\n4449\t    PICOQUIC_THREAD_CHECK(cnx->quic);"}]},"parent_tool_use_id":"toolu_01FNJRg8YhsoxF5PXikNyYX1","session_id":"6e30a456-15c0-4e3c-af27-9f4dab375915","uuid":"dff6b384-4307-477b-8dd1-c41a6be26900","timestamp":"2026-05-05T21:37:27.079Z"}
