{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01LAJexhfrLFjrdQKiQK7wxM","type":"tool_result","content":"55\t    }\n56\t\n57\t    /// Build a stream id from its 1-based `rank`, opening `role`,\n58\t    /// and direction.  C: `STREAM_ID_FROM_RANK`.\n59\t    pub const fn from_parts(rank: u64, role: Role, direction: Direction) -> Self {\n60\t        let role_bit = match role {\n61\t            Role::Client => 0,\n62\t            Role::Server => 1,\n63\t        };\n64\t        let dir_bit = match direction {\n65\t            Direction::Bidir => 0,\n66\t            Direction::Unidir => 2,\n67\t        };\n68\t        Self(((rank - 1) << 2) | dir_bit | role_bit)\n69\t    }\n70\t\n71\t    /// Recover the 1-based rank within the `(role, direction)` quadrant.\n72\t    /// C: `STREAM_RANK_FROM_ID` — note the off-by-four arithmetic;\n73\t    /// preserved here for parity.\n74\t    pub const fn rank(self) -> u64 {\n75\t        (self.0 + 4) >> 2\n76\t    }\n77\t\n78\t    /// Decompose a stream id into its `(direction, role)` quadrant.\n79\t    /// C: `STREAM_TYPE_FROM_ID`.\n80\t    pub const fn kind(self) -> (Direction, Role) {\n81\t        let role = if (self.0 & 1) == 0 {\n82\t            Role::Client\n83\t        } else {\n84\t            Role::Server\n85\t        };\n86\t        let direction = if (self.0 & 2) == 0 {\n87\t            Direction::Bidir\n88\t        } else {\n89\t            Direction::Unidir\n90\t        };\n91\t        (direction, role)\n92\t    }\n93\t\n94\t    /// Next stream id with the same `(direction, role)` quadrant."}]},"parent_tool_use_id":"toolu_01FNJRg8YhsoxF5PXikNyYX1","session_id":"6e30a456-15c0-4e3c-af27-9f4dab375915","uuid":"fb26efdb-9a52-43d6-9e4b-8367946a7ba0","timestamp":"2026-05-05T21:42:10.421Z"}
