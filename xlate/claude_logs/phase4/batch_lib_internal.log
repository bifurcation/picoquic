he value stored is a ConnectionToken; for the LocalConnectionIdToken\n3516\t        // we return a synthetic placeholder (Phase 4 full wiring would store it\n3517\t        // in the CID arena).\n3518\t        let ht = self.connection_by_id.lookup(&cnx_id)?;\n3519\t        let &conn_tok = self.connection_by_id.get(ht)?;\n3520\t        // Placeholder token — callers that only use the ConnectionToken part work;\n3521\t        // callers that use the LocalConnectionIdToken part may need further work.\n3522\t        let lcid_tok = LocalConnectionIdToken::synthetic(0, 0);\n3523\t        Some((conn_tok, lcid_tok))\n3524\t    }\n3525\t\n3526\t    /// Look up a connection by peer address.  C: `connection_by_net`.\n3527\t    pub fn connection_by_net(&mut self, addr: Option<&SocketAddr>) -> Option<ConnectionToken> {\n3528\t        let addr = addr?;\n3529\t        let ht = self.connection_by_net.lookup(addr)?;\n3530\t        let &tok = self.connection_by_net.get(ht)?;\n3531\t        Some(tok)\n3532\t    }\n3533\t\n3534\t    /// Look up a connection by initial CID and peer address.  C:\n3535\t    /// `connection_by_icid`.\n3536\t    pub fn connection_by_icid(\n3537\t        &mut self,\n3538\t        icid: &ConnectionId,\n3539\t        _addr: Option<&SocketAddr>,\n3540\t    ) -> Option<ConnectionToken> {\n3541\t        let ht = self.connection_by_icid.lookup(icid)?;\n3542\t        let &tok = self.connection_by_icid.get(ht)?;\n3543\t        Some(tok)\n3544\t    }\n3545\t\n3546\t    /// Look up a connection by stateless-reset secret and peer\n3547\t    /// address.  C: `connection_by_secret`.\n3548\t    pub fn connection_by_secret(\n3549\t        &mut self,\n3550\t        reset_secret: &[u8],\n3551\t        _addr: Option<&SocketAddr>,\n3552\t    ) -> Option<ConnectionToken> {\n3553\t        if reset_secret.len() < RESET_SECRET_SIZE {\n3554\t            return None;\n3555\t        }\n3556\t        let mut key = [0u8; RESET_SECRET_SIZE];\n3557\t        key.copy_from_slice(&reset_secret[..RESET_SECRET_SIZE]);\n3558\t        let ht = self.connection_by_secret.lookup(&key)?;\n3559\t        let &tok = self.connection_by_secret.get(ht)?;\n3560\t        Some(tok)\n3561\t    }\n3562\t}\n3563\t\n3564\t// ---------------------------------------------------------------------------\n3565\t// Pacing.\n3566\t\n3567\timpl Pacing {\n3568\t    /// Initialize the pacing state at `current_time`.\n3569\t    pub fn init(&mut self, _current_time: Instant) {\n3570\t        todo!()\n3571\t    }\n3572\t\n3573\t    /// True when the pacer is currently throttling sends.\n3574\t    pub fn is_blocked(&self) -> bool {\n3575\t        todo!()\n3576\t    }\n3577\t\n3578\t    /// Decide whether sending right now is authorized by the pacer.\n3579\t    /// Writes the next authorized time into `next_time` when blocked.\n3580\t    /// C: `picoquic_is_authorized_by_pacing` — last C arg `signal_path`\n3581\t    /// maps to `Option<PathToken>` (`NULL` → `None`).\n3582\t    pub fn is_authorized(\n3583\t        &self,\n3584\t        _current_time: Instant,\n3585\t        _next_time: &mut Instant,\n3586\t        _packet_train_mode: bool,\n3587\t        _signalled_path: Option<PathToken>,\n3588\t    ) -> bool {\n3589\t        todo!()\n3590\t    }\n3591\t\n3592\t    /// Re-derive bucket and rate after a configuration change.\n3593\t    pub fn update_parameters(\n3594\t        &mut self,\n3595\t        _pacing_rate: f64,\n3596\t        _quantum: u64,\n3597\t        _send_mtu: usize,\n3598\t        _smoothed_rtt: Duration,\n3599\t        _signalled_path: Option<PathToken>,\n3600\t    ) {\n3601\t        todo!()\n3602\t    }\n3603\t\n3604\t    /// Recompute pacing parameters from the congestion window.\n3605\t    pub fn update_window(\n3606\t        &mut self,\n3607\t        _slow_start: i32,\n3608\t        _cwin: u64,\n3609\t        _send_mtu: usize,\n3610\t        _smoothed_rtt: Duration,"}]},"parent_tool_use_id":"toolu_01FNJRg8YhsoxF5PXikNyYX1","session_id":"6e30a456-15c0-4e3c-af27-9f4dab3