`None` if no default was set.  C: reads\n1227\t    /// `quic->default_congestion_alg->congestion_algorithm_id`.\n1228\t    pub fn default_congestion_algorithm_id(&self) -> Option<&str> {\n1229\t        self.default_congestion_alg\n1230\t            .map(|a| a.congestion_algorithm_id)\n1231\t    }\n1232\t\n1233\t    /// Per-context maximum data limit used for flow control.\n1234\t    /// C: reads `quic->max_data_limit`.\n1235\t    pub fn max_data_limit(&self) -> u64 {\n1236\t        self.max_data_limit\n1237\t    }\n1238\t\n1239\t    /// Override a single transport-parameter slot in the default\n1240\t    /// set.  `tp_type` is the wire ID; values for unknown types are\n1241\t    /// stored verbatim and emitted as extension parameters.\n1242\t    pub fn set_default_tp_value(&mut self, tp_type: u64, tp_value: u64) -> Result<(), Error> {\n1243\t        let tp = &mut self.default_tp;\n1244\t        match tp_type {\n1245\t            1 => {\n1246\t                tp.max_idle_timeout = Duration::from_ticks(tp_value);\n1247\t            }\n1248\t            3 => {\n1249\t                tp.max_packet_size = tp_value as u32;\n1250\t            }\n1251\t            4 => {\n1252\t                tp.initial_max_data = tp_value;\n1253\t            }\n1254\t            5 => {\n1255\t                tp.initial_max_stream_data_bidi_local = tp_value;\n1256\t            }\n1257\t            6 => {\n1258\t                tp.initial_max_stream_data_bidi_remote = tp_value;\n1259\t            }"}]},"parent_tool_use_id":"toolu_01FNJRg8YhsoxF5PXikNyYX1","session_id":"6e30a456-15c0-4e3c-af27-9f4dab375915","uuid":"13f93bb8-1513-4599-94fb-479dc27c0b56","timestamp":"2026-05-05T21:30:21.722Z"}
