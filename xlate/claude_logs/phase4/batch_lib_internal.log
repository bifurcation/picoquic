{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01SmXEokC8uxxmUWVWJN3ejE","type":"tool_result","content":"155\t                \"non-registered address must not be found\"\n156\t            );\n157\t        } else {\n158\t            let bad_target = ConnectionId::clone_from_slice(&[1, 2, 3, 4, 5, 6, 7, 8]).unwrap();\n159\t            assert!(\n160\t                quic.connection_by_id(bad_target).is_none(),\n161\t                \"non-registered CID must not be found\"\n162\t            );\n163\t        }\n164\t\n165\t        // Delete connections at even indices (first, middle, last).\n166\t        // C: `picoquic_delete_cnx(test_cnx[i])` for i in {0,2,4,6}.\n167\t        for i in (0..TEST_CNX_COUNT).step_by(2) {\n168\t            let tok = if use_cid {\n169\t                quic.connection_by_id(test_cid[i]).map(|(t, _)| t)\n170\t            } else {\n171\t                quic.connection_by_net(Some(&test_cnx_addr[i]))\n172\t            };\n173\t            if let Some(t) = tok {\n174\t                quic.delete_connection(t);\n175\t            }\n176\t        }\n177\t\n178\t        // Verify deleted connections are gone; surviving (odd-indexed) ones remain.\n179\t        for i in 0..TEST_CNX_COUNT {\n180\t            let found = if use_cid {\n181\t                quic.connection_by_id(test_cid[i]).is_some()\n182\t            } else {\n183\t                quic.connection_by_net(Some(&test_cnx_addr[i])).is_some()\n184\t            };\n185\t            if i % 2 == 0 {\n186\t                assert!(!found, \"connection {i} (even) should have been deleted\");\n187\t            } else {\n188\t                assert!(found, \"connection {i} (odd) should still exist\");\n189\t            }\n190\t        }\n191\t        // `quic` is dropped here — equivalent to `picoquic_free(quic)`.\n192\t    }\n193\t}\n194\t\n195\t/// C: `create_quic_test` in `picoquictest/cnx_creation_test.c`.\n196\t///\n197\t/// Edge cases for [`Quic::new`]:\n198\t///\n199\t/// * Requesting 0 connections clamps `max_number_connections` to 1.\n200\t/// * A bad cert or key path causes creation to return `None`.\n201\t/// * A bad ticket-store path does **not** crash creation (client contexts\n202\t///   don't need one).\n203\t/// * [`Quic::load_token_file`] with a bad file should fail; a bad directory\n204\t///   is platform-dependent.\n205\t/// * Resetting transport parameters to `None` (→ `Default`) succeeds.\n206\t#[test]\n207\tfn create_quic() {\n208\t    let bad_file = \"no_such_file_should_exist.pem\";\n209\t    let bad_dir = \"..\";\n210\t\n211\t    // 0 connections clamps to 1.\n212\t    // C: `quic->max_number_connections != 1` → fail.\n213\t    {\n214\t        let quic = Quic::new(\n215\t            0,\n216\t            None,\n217\t            None,\n218\t            None,\n219\t            None,\n220\t            None,\n221\t            None,\n222\t            [0u8; RESET_SECRET_SIZE],\n223\t            Instant::from_ticks(0),\n224\t            None,\n225\t            None,\n226\t        )\n227\t        .expect(\"0 max_nb_connections must still create a context (clamped to 1)\");\n228\t        assert_eq!(\n229\t            quic.max_number_connections, 1,\n230\t            \"0 max_nb_connections must clamp to 1\"\n231\t        );\n232\t    }\n233\t\n234\t    // Bad cert or key path must cause creation to fail."}]},"parent_tool_use_id":"toolu_01FNJRg8YhsoxF5PXikNyYX1","session_id":"6e30a456-15c0-4e3c-af27-9f4dab375915","uuid":"f0f8bb2c-dd75-47f6-808f-ff866aaa4ce5","timestamp":"2026-05-05T21:43:48.685Z"}
