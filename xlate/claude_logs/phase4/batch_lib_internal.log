{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01XjdMgy8FNtcWroRzbfpuos","type":"tool_result","content":"5990\t// Index-based packet-header helpers (avoid borrow conflicts in tests).\n5991\t\n5992\timpl Connection {\n5993\t    /// Like [`predict_packet_header_length`] but selects the packet context by\n5994\t    /// enum value instead of taking a `&mut PacketContextState`.  This avoids the\n5995\t    /// split-borrow problem in tests that hold `&mut Connection` while computing\n5996\t    /// the header length.\n5997\t    pub fn predict_packet_header_length_for_pc(\n5998\t        &mut self,\n5999\t        packet_type: PacketType,\n6000\t        pc: PacketContext,\n6001\t    ) -> usize {\n6002\t        let pkt_ctx = &self.pkt_ctx[pc as usize];\n6003\t        let send_sequence = pkt_ctx.send_sequence;\n6004\t        let first_pending_seq = pkt_ctx.pending.keys().next().copied();\n6005\t\n6006\t        // Remote CID length: get from path 0, stash for path 0, first CID.\n6007\t        let remote_cid_len = self\n6008\t            .remote_connection_id_stashes\n6009\t            .first()\n6010\t            .and_then(|s| s.connection_ids.first())\n6011\t            .map(|r| r.connection_id.len())\n6012\t            .unwrap_or(8);\n6013\t\n6014\t        // Local CID length: get from path 0 tuple 0's local CID token.\n6015\t        let local_cid_len = self\n6016\t            .paths\n6017\t            .first()\n6018\t            .and_then(|p| p.tuples.first())\n6019\t            .and_then(|t| t.local_connection_id)\n6020\t            .and_then(|tok| self.local_connection_ids.get(tok))\n6021\t            .map(|l| l.connection_id.len())\n6022\t            .unwrap_or(self.local_cid_length as usize);\n6023\t\n6024\t        if packet_type == PacketType::OneRttProtected {\n6025\t            // Short header: 1 byte flags + remote CID + PN\n6026\t            let delta = if let Some(first) = first_pending_seq {\n6027\t                send_sequence.saturating_sub(first) as i64\n6028\t            } else {\n6029\t                send_sequence as i64\n6030\t            };\n6031\t            let pn_l = if delta >= 262144 {\n6032\t                4usize\n6033\t            } else if send_sequence >= 1024 {\n6034\t                3\n6035\t            } else if send_sequence >= 16 {\n6036\t                2\n6037\t            } else {\n6038\t                1\n6039\t            };\n6040\t            1 + remote_cid_len + pn_l\n6041\t        } else {\n6042\t            // Long header: 1 byte + 4 version + 2 CID lengths + dest CID + src CID + 2 payload len + 4 PN\n6043\t            let dest_cid_len = if self.client_mode\n6044\t                && (packet_type == PacketType::Initial\n6045\t                    || packet_type == PacketType::ZeroRttProtected)\n6046\t                && remote_cid_len == 0\n6047\t            {\n6048\t                self.initial_connection_id.len()\n6049\t            } else {\n6050\t                remote_cid_len\n6051\t            };\n6052\t\n6053\t            let mut header_length = 1 + 4 + 2 + dest_cid_len + local_cid_len + 2 + 4;\n6054\t\n6055\t            // Token length for initial packets.\n6056\t            if packet_type == PacketType::Initial {\n6057\t                let token_len = self.retry_token.len();\n6058\t                let vlen = encode_varint_length(token_len as u64);\n6059\t                header_length += vlen + token_len;\n6060\t            }\n6061\t\n6062\t            header_length\n6063\t        }\n6064\t    }\n6065\t\n6066\t    /// Like [`create_packet_header`] but addresses the path and tuple by index\n6067\t    /// instead of by `&mut` reference.  This avoids the split-borrow problem\n6068\t    /// that arises when the path and tuple live inside `&mut self`.\n6069\t    #[allow(clippy::too_many_arguments)]\n6070\t    pub fn create_packet_header_at(\n6071\t        &mut self,\n6072\t        packet_type: PacketType,\n6073\t        sequence_number: u64,\n6074\t        path_idx: usize,\n6075\t        _tuple_idx: usize,\n6076\t        header_length: usize,\n6077\t        bytes: &mut [u8],\n6078\t        pn_offset: &mut usize,\n6079\t        pn_length: &mut usize,\n6080\t    ) -> usize {\n6081\t        // Get remote and local CIDs.\n6082\t        let unique_path_id = self.paths.get(path_idx).map(|p| p.unique_path_id).unwrap_or(0);\n6083\t\n6084\t        let remote_cid = self\n6085\t            .remote_connection_id_stashes\n6086\t            .iter()\n6087\t            .find(|s| s.unique_path_id == unique_path_id)\n6088\t            .and_then(|s| s.connection_ids.first())\n6089\t            .map(|r| r.connection_id)\n6090\t            .unwrap_or_default();\n6091\t\n6092\t        let local_cid_tok = self\n6093\t            .paths\n6094\t            .get(path_idx)\n6095\t            .and_then(|p| p.tuples.first())\n6096\t            .and_then(|t| t.local_connection_id);\n6097\t        let local_cid = local_cid_tok\n6098\t            .and_then(|tok| self.local_connection_ids.get(tok))\n6099\t            .map(|l| l.connection_id)\n6100\t            .unwrap_or_default();\n6101\t\n6102\t        if packet_type == PacketType::OneRttProtected {\n6103\t            // Short header.\n6104\t            let k = if self.key_phase_enc { 0x04u8 } else { 0u8 };\n6105\t            let c = 0x40u8; // QUIC bit\n6106\t            let mut pn_l = 4usize;\n6107\t            bytes[0] = k | c; // spin bit = 0\n6108\t            let mut length = 1;\n6109\t            length += write_cid(&mut bytes[length..], remote_cid);\n6110\t            *pn_offset = length;\n6111\t            if header_length > length && header_length < length + 4 {\n6112\t                pn_l = header_length - length;\n6113\t            }\n6114\t            *pn_length = pn_l;\n6115\t            bytes[0] |= (pn_l - 1) as u8;\n6116\t            write_pn(&mut bytes[length..], sequence_number, pn_l);\n6117\t            length += pn_l;\n6118\t            length\n6119\t        } else {\n6120\t            // Long header.\n6121\t            // Determine first byte based on version and packet type.\n6122\t            let version = self.proposed_version;\n6123\t            // Use V1 encoding for all versions unless it's V2.\n6124\t            let is_v2 = version == Version::V2 as u32 || version == Version::V2Draft as u32;\n6125\t            let first_byte: u8 = match (packet_type, is_v2) {\n6126\t                (PacketType::Initial, false) => 0xC3,\n6127\t                (PacketType::ZeroRttProtected, false) => 0xD3,\n6128\t                (PacketType::Handshake, false) => 0xE3,\n6129\t                (PacketType::Retry, false) => 0xF0,\n6130\t                (PacketType::Initial, true) => 0xD3,\n6131\t                (PacketType::ZeroRttProtected, true) => 0xE3,\n6132\t                (PacketType::Handshake, true) => 0xF3,\n6133\t                (PacketType::Retry, true) => 0xC0,\n6134\t                _ => 0xFF,\n6135\t            };\n6136\t            bytes[0] = first_byte;\n6137\t            let mut length = 1;\n6138\t\n6139\t            // Version\n6140\t            let ver_bytes = version.to_be_bytes();\n6141\t            bytes[length..length + 4].copy_from_slice(&ver_bytes);\n6142\t            length += 4;\n6143\t\n6144\t            // Dest CID\n6145\t            let dest_cid = if self.client_mode\n6146\t                && (packet_type == PacketType::Initial\n6147\t                    || packet_type == PacketType::ZeroRttProtected)\n6148\t                && remote_cid.is_empty()\n6149\t            {\n6150\t                self.initial_connection_id\n6151\t            } else {\n6152\t                remote_cid\n6153\t            };\n6154\t            bytes[length] = dest_cid.len() as u8;\n6155\t            length += 1;\n6156\t            length += write_cid(&mut bytes[length..], dest_cid);\n6157\t\n6158\t            // Src CID\n6159\t            bytes[length] = local_cid.len() as u8;\n6160\t            length += 1;\n6161\t            length += write_cid(&mut bytes[length..], local_cid);\n6162\t\n6163\t            // Token for initial packets\n6164\t            if packet_type == PacketType::Initial {\n6165\t                let token_len = self.retry_token.len() as u64;\n6166\t                length += varint_encode(&mut bytes[length..], token_len);\n6167\t                if !self.retry_token.is_empty() {\n6168\t                    let rlen = self.retry_token.len();\n6169\t                    bytes[length..length + rlen].copy_from_slice(&self.retry_token);\n6170\t                    length += rlen;\n6171\t                }\n6172\t            }\n6173\t\n6174\t            if packet_type == PacketType::Retry {\n6175\t                *pn_offset = 0;\n6176\t                *pn_length = 0;\n6177\t            } else {\n6178\t                // 2-byte placeholder for payload length\n6179\t                bytes[length] = 0;\n6180\t                bytes[length + 1] = 0;\n6181\t                length += 2;\n6182\t                *pn_offset = length;\n6183\t                *pn_length = 4;\n6184\t                let pn32 = sequence_number as u32;\n6185\t                bytes[length..length + 4].copy_from_slice(&pn32.to_be_bytes());\n6186\t                length += 4;\n6187\t            }\n6188\t            length\n6189\t        }"}]},"parent_tool_use_id":"toolu_01FNJRg8YhsoxF5PXikNyYX1","session_id":"6e30a456-15c0-4e3c-af27-9f4dab375915","uuid":"bd758ff9-ee58-4054-aaab-a66550bb33cf","timestamp":"2026-05-05T22:07:30.775Z"}
