{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01QGG6q2Pb2jHUyKmVEMPfhk","type":"tool_result","content":"7230\t    /// Override `pkt_ctx[pc].send_sequence`.  Convenience for tests that need\n7231\t    /// to inject a particular sequence number before calling\n7232\t    /// `predict_packet_header_length_for_pc`.\n7233\t    pub fn set_send_sequence_for_pc(&mut self, pc: PacketContext, sequence: u64) {\n7234\t        self.pkt_ctx[pc as usize].send_sequence = sequence;\n7235\t    }\n7236\t\n7237\t    /// Create a dummy in-flight packet for `pc` and enqueue it on the retransmit\n7238\t    /// queue.  Encapsulates `create_packet` + field setup + `queue_for_retransmit`\n7239\t    /// in one call to avoid the split-borrow needed for the path argument.\n7240\t    pub fn queue_unacked_packet_for_pc(\n7241\t        &mut self,\n7242\t        pc: PacketContext,\n7243\t        _packet_type: PacketType,\n7244\t        sequence: u64,\n7245\t        _length: usize,\n7246\t        _current_time: Instant,\n7247\t    ) {\n7248\t        // Insert a synthetic PacketToken placeholder (generation 0) so the\n7249\t        // pending map has an entry at the given sequence number.\n7250\t        let tok = PacketToken::synthetic(sequence as u32, 0);\n7251\t        self.pkt_ctx[pc as usize].pending.insert(sequence, tok);\n7252\t    }\n7253\t\n7254\t    /// Dequeue the first entry in `pkt_ctx[pc].pending` as if it had been\n7255\t    /// acknowledged.  Encapsulates `dequeue_retransmit_packet` to avoid the\n7256\t    /// split-borrow needed for the `&mut PacketContextState` argument.\n7257\t    pub fn dequeue_first_pending_for_pc(&mut self, pc: PacketContext) {\n7258\t        let first_key = self.pkt_ctx[pc as usize]\n7259\t            .pending\n7260\t            .keys()\n7261\t            .next()\n7262\t            .copied();\n7263\t        if let Some(key) = first_key {\n7264\t            self.pkt_ctx[pc as usize].pending.remove(&key);\n7265\t        }\n7266\t    }\n7267\t}\n7268\t\n7269\t// ---------------------------------------------------------------------------\n7270\t// Version accessors needed by packet-header tests.\n7271\t\n7272\timpl Connection {\n7273\t    /// Wire version number of the active protocol version.\n7274\t    /// C: `picoquic_supported_versions[cnx->version_index].version`.\n7275\t    pub fn version_number(&self) -> u32 {\n7276\t        // In the Rust translation, `proposed_version` carries the wire version\n7277\t        // number directly (C: cnx->proposed_version set from the supported-version\n7278\t        // table entry's .version field).\n7279\t        self.proposed_version\n7280\t    }\n7281\t\n7282\t    /// TLS-label prefix string for the active protocol version.\n7283\t    /// C: `picoquic_supported_versions[cnx->version_index].tls_prefix_label`.\n7284\t    pub fn version_tls_prefix_label(&self) -> &'static str {\n7285\t        // Resolve via proposed_version to a Version enum, then use parameters().\n7286\t        Version::try_from_wire(self.proposed_version)\n7287\t            .map(|v| v.parameters().tls_prefix_label)\n7288\t            .unwrap_or(\"tls13 quic \")\n7289\t    }\n7290\t}\n7291\t\n7292\t// ---------------------------------------------------------------------------\n7293\t// LB CID generation / verification helpers.\n7294\t\n7295\timpl Quic {\n7296\t    /// Generate a CID using the installed LB CID callback with `nonce` as the\n7297\t    /// nonce / \"for-server-use\" bytes.  Returns `None` when no callback is\n7298\t    /// installed.  C: direct call to `quic->cnx_id_callback_fn`.\n7299\t    pub fn lb_generate_cid(&mut self, nonce: &ConnectionId) -> Option<ConnectionId> {\n7300\t        let mut ctx_box = self.connection_id_callback_ctx.take()?;\n7301\t        let result = ctx_box\n7302\t            .downcast_mut::<crate::lb::ConnectionIdContext>()\n7303\t            .map(|ctx| ctx.generate(self, nonce));\n7304\t        self.connection_id_callback_ctx = Some(ctx_box);\n7305\t        result\n7306\t    }\n7307\t\n7308\t    /// Verify a CID using the installed LB context and return the embedded\n7309\t    /// server ID.  Returns `None` when no LB context is installed or the CID\n7310\t    /// length mismatches.  C: `lb_compat_cid_verify`.\n7311\t    pub fn lb_verify_cid(&mut self, cid: &ConnectionId) -> Option<u64> {\n7312\t        let mut ctx_box = self.connection_id_callback_ctx.take()?;\n7313\t        let result = if let Some(ctx) = ctx_box.downcast_mut::<crate::lb::ConnectionIdContext>() {\n7314\t            ctx.verify(cid)\n7315\t        } else {\n7316\t            None\n7317\t        };\n7318\t        self.connection_id_callback_ctx = Some(ctx_box);\n7319\t        result\n7320\t    }\n7321\t\n7322\t    /// Return a mutable reference to the first (most-recently-created) live\n7323\t    /// connection in this QUIC context, if any.  C: `quic->cnx_list`.\n7324\t    pub fn first_cnx_mut(&mut self) -> Option<&mut Connection> {\n7325\t        // C uses a head pointer into a doubly-linked list; in Rust we iterate\n7326\t        // the arena and return the first live entry.\n7327\t        self.connections.iter_mut().next()\n7328\t    }\n7329\t}\n7330\t\n7331\t// ---------------------------------------------------------------------------\n7332\t// Test-only crypto helpers (packet_enc_dec_test).\n7333\t\n7334\timpl Connection {\n7335\t    /// Install a test AEAD encryption context for `epoch`, keyed by `secret`.\n7336\t    /// C: `cnx->crypto_context[epoch].aead_encrypt =\n7337\t    ///       picoquic_setup_test_aead_context(1, secret, prefix_label)`.\n7338\t    pub fn set_test_aead_encrypt(&mut self, _epoch: Epoch, _secret: &[u8]) {\n7339\t        todo!()\n7340\t    }\n7341\t\n7342\t    /// Install a test AEAD decryption context for `epoch`, keyed by `secret`.\n7343\t    pub fn set_test_aead_decrypt(&mut self, _epoch: Epoch, _secret: &[u8]) {\n7344\t        todo!()\n7345\t    }\n7346\t\n7347\t    /// Install a test packet-number encryption context f