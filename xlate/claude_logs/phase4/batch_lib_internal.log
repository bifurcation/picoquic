{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_015dCuGutneMbEYJRgjfAuMs","type":"tool_result","content":"195\t/// C: `create_quic_test` in `picoquictest/cnx_creation_test.c`.\n196\t///\n197\t/// Edge cases for [`Quic::new`]:\n198\t///\n199\t/// * Requesting 0 connections clamps `max_number_connections` to 1.\n200\t/// * A bad cert or key path causes creation to return `None`.\n201\t/// * A bad ticket-store path does **not** crash creation (client contexts\n202\t///   don't need one).\n203\t/// * [`Quic::load_token_file`] with a bad file should fail; a bad directory\n204\t///   is platform-dependent.\n205\t/// * Resetting transport parameters to `None` (→ `Default`) succeeds.\n206\t#[test]\n207\tfn create_quic() {\n208\t    let bad_file = \"no_such_file_should_exist.pem\";\n209\t    let bad_dir = \"..\";\n210\t\n211\t    // 0 connections clamps to 1.\n212\t    // C: `quic->max_number_connections != 1` → fail.\n213\t    {\n214\t        let quic = Quic::new(\n215\t            0,\n216\t            None,\n217\t            None,\n218\t            None,\n219\t            None,\n220\t            None,\n221\t            None,\n222\t            [0u8; RESET_SECRET_SIZE],\n223\t            Instant::from_ticks(0),\n224\t            None,\n225\t            None,\n226\t        )\n227\t        .expect(\"0 max_nb_connections must still create a context (clamped to 1)\");\n228\t        assert_eq!(\n229\t            quic.max_number_connections, 1,\n230\t            \"0 max_nb_connections must clamp to 1\"\n231\t        );\n232\t    }\n233\t\n234\t    // Bad cert or key path must cause creation to fail.\n235\t    let cert_file = concat!(env!(\"CARGO_MANIFEST_DIR\"), \"/../../certs/cert.pem\");\n236\t    let key_file = concat!(env!(\"CARGO_MANIFEST_DIR\"), \"/../../certs/key.pem\");\n237\t\n238\t    assert!(\n239\t        Quic::new(\n240\t            8,\n241\t            Some(bad_file),\n242\t            Some(key_file),\n243\t            None,\n244\t            None,\n245\t            None,\n246\t            None,\n247\t            [0u8; RESET_SECRET_SIZE],\n248\t            Instant::from_ticks(0),\n249\t            None,\n250\t            None,\n251\t        )\n252\t        .is_none(),\n253\t        \"bad cert path must reject context creation\"\n254\t    );\n255\t    assert!(\n256\t        Quic::new(\n257\t            8,\n258\t            Some(cert_file),\n259\t            Some(bad_file),\n260\t            None,\n261\t            None,\n262\t            None,\n263\t            None,\n264\t            [0u8; RESET_SECRET_SIZE],\n265\t            Instant::from_ticks(0),\n266\t            None,\n267\t            None,\n268\t        )\n269\t        .is_none(),\n270\t        \"bad key path must reject context creation\"\n271\t    );\n272\t\n273\t    // Bad ticket-store path must NOT crash a client context.\n274\t    // C: the ticket file is position 13 in `picoquic_create` (→ Rust `ticket_file_name`)."}]},"parent_tool_use_id":"toolu_01FNJRg8YhsoxF5PXikNyYX1","session_id":"6e30a456-15c0-4e3c-af27-9f4dab375915","uuid":"271ee1dc-5317-4ef8-83e8-7f216592d918","timestamp":"2026-05-05T21:32:22.151Z"}
