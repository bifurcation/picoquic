{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_012Y2oQej1ZaZHRiuDUHT7by","type":"tool_result","content":"343\t/// Parsed long/short packet header.  C: `PacketHeader`.\n344\t///\n345\t/// The C struct uses a packed bitfield for eight single-bit\n346\t/// flags; Rust stores them as plain `bool` fields (one per flag).\n347\tpub struct PacketHeader {\n348\t    pub dest_connection_id: ConnectionId,\n349\t    pub src_connection_id: ConnectionId,\n350\t    /// Truncated packet number as it appeared on the wire (1-4 bytes,\n351\t    /// extended to `u32`).  Reconstructed full PN is in\n352\t    /// [`Self::packet_number_full`].\n353\t    pub packet_number_truncated: u32,\n354\t    pub version: u32,\n355\t    pub offset: usize,\n356\t    pub packet_number_offset: usize,\n357\t    pub packet_type: PacketType,\n358\t    pub packet_number_mask: u64,\n359\t    pub packet_number_full: u64,\n360\t    pub payload_length: usize,\n361\t    pub version_index: i32,\n362\t    pub epoch: Epoch,\n363\t    pub packet_context: PacketContext,\n364\t\n365\t    pub key_phase: bool,\n366\t    pub spin: bool,\n367\t    pub has_spin_bit: bool,\n368\t    pub has_reserved_bit_set: bool,\n369\t    pub has_loss_bits: bool,\n370\t    pub loss_bit_q: bool,\n371\t    pub loss_bit_l: bool,\n372\t    pub quic_bit_is_zero: bool,\n373\t\n374\t    /// Borrowed token bytes (length implicit in the slice).  Phase\n375\t    /// 4 plan: `IncomingPacket` decoders carry a lifetime; the\n376\t    /// `token_length` field is gone (it lived only as the slice's\n377\t    /// length).\n378\t    pub token_bytes: Vec<u8>,\n379\t    pub payload_length_value: usize,\n380\t    /// Token into [`Quic`]'s arena for the local CID this packet\n381\t    /// targets, if any.  C: `*mut LocalConnectionId` back-pointer.\n382\t    pub local_connection_id: Option<LocalConnectionIdToken>,\n383\t}\n384\t\n385\t// ---------------------------------------------------------------------------\n386\t// Spin-bit policy vtable.\n387\t\n388\t/// Spin-bit policy: how to update the spin bit on an incoming\n389\t/// packet, and what value to emit on outgoing packets.  In C the\n390\t/// policy is two function pointers grouped into\n391\t/// `SpinbitDef`; the two are always installed\n392\t/// together so they share one Rust trait.\n393\tpub trait SpinBitPolicy: Sync {\n394\t    /// C: `spinbit_incoming_fn`.\n395\t    fn incoming(&self, connection: &mut Connection, path_x: &mut Path, ph: &PacketHeader);\n396\t\n397\t    /// C: `spinbit_outgoing_fn`.\n398\t    fn outgoing(&self, connection: &mut Connection) -> u8;\n399\t}\n400\t\n401\t/// Spin-bit policy dispatch table.  Replaces `extern SpinbitDef\n402\t/// spin_function_table[]` from the C source.  Each row is a\n403\t/// `&'static dyn` to a stateless policy implementor; the wrapper\n404\t/// `SpinbitDef` struct from C is gone (the trait object carries\n405\t/// the same information).\n406\t///\n407\t/// Indices match [`crate::SpinbitVersion`] values:\n408\t/// * 0 = Basic\n409\t/// * 1 = Random\n410\t/// * 2 = Null\n411\t/// * 3 = On (test-only, server side)\n412\t///\n413\t/// The concrete policy types and the populated table land in\n414\t/// `crate::spinbit` (Phase 4).\n415\tpub static SPIN_FUNCTION_TABLE: &[&dyn SpinBitPolicy] = &[];\n416\t\n417\t// ---------------------------------------------------------------------------\n418\t// Stateless packet, queued at the QUIC context until sendable.\n419\t\n420\tpub struct StatelessPacket {\n421\t    pub addr_to: SocketAddr,\n422\t    pub addr_local: SocketAddr,"}]},"parent_tool_use_id":"toolu_01FNJRg8YhsoxF5PXikNyYX1","session_id":"6e30a456-15c0-4e3c-af27-9f4dab375915","uuid":"addeebb7-8adc-4c69-88b0-dac9fce84202","timestamp":"2026-05-05T21:59:04.139Z"}
