{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01YWaoRBnwS2XMMN6fTJEa1V","type":"tool_result","content":"690\t                pc,\n691\t                hlc.ptype,\n692\t                unack,\n693\t                crate::MAX_PACKET_SIZE,\n694\t                current_time,\n695\t            );\n696\t        }\n697\t    }\n698\t\n699\t    let predicted_length = {\n700\t        let cnx = quic.connection_ref_by_id(i_cid).unwrap();\n701\t        cnx.predict_packet_header_length_for_pc(hlc.ptype, pc)\n702\t    };\n703\t\n704\t    // Dequeue / re-queue for the after-state\n705\t    {\n706\t        let cnx = quic.connection_ref_by_id(i_cid).unwrap();\n707\t        if hlc.sequence_unack != hlc.sequence_unack_after {\n708\t            if hlc.sequence_unack.is_some() {\n709\t                cnx.dequeue_first_pending_for_pc(pc);\n710\t            }\n711\t            if let Some(unack_after) = hlc.sequence_unack_after {\n712\t                cnx.queue_unacked_packet_for_pc(\n713\t                    pc,\n714\t                    hlc.ptype,\n715\t                    unack_after,\n716\t                    crate::MAX_PACKET_SIZE,\n717\t                    current_time,\n718\t                );\n719\t            }\n720\t        }\n721\t    }\n722\t\n723\t    let mut buffer = [0u8; crate::MAX_PACKET_SIZE];\n724\t    let mut pn_offset = 0usize;\n725\t    let mut pn_length = 0usize;\n726\t    let header_length = {\n727\t        let cnx = quic.connection_ref_by_id(i_cid).unwrap();\n728\t        cnx.create_packet_header_at(\n729\t            hlc.ptype,\n730\t            hlc.sequence,\n731\t            0,\n732\t            0,\n733\t            predicted_length,\n734\t            &mut buffer,\n735\t            &mut pn_offset,\n736\t            &mut pn_length,\n737\t        )\n738\t    };\n739\t\n740\t    assert_eq!(\n741\t        header_length, predicted_length,\n742\t        \"predicted={predicted_length} actual={header_length}\"\n743\t    );\n744\t    assert!(\n745\t        pn_length > 0 && pn_length <= 4,\n746\t        \"invalid pn_length {pn_length}\"\n747\t    );\n748\t    assert_eq!(\n749\t        pn_length + pn_offset,\n750\t        header_length,\n751\t        \"pn_offset={pn_offset} + pn_length={pn_length} != header_length={header_length}\"\n752\t    );\n753\t}\n754\t\n755\t/// C: `header_length_test` in `picoquictest/parseheadertest.c`.\n756\t#[test]\n757\tfn header_length() {\n758\t    const U64MAX: Option<u64> = None;\n759\t    let cases: &[HlCase] = &[\n760\t        HlCase {\n761\t            is_client: false,\n762\t            i_cid_length: 8,\n763\t            local_cid_length: 8,\n764\t            remote_cid_length: 8,\n765\t            ptype: PacketType::Initial,\n766\t            sequence: 0,\n767\t            sequence_unack: U64MAX,\n768\t            sequence_unack_after: U64MAX,\n769\t        },"}]},"parent_tool_use_id":"toolu_01FNJRg8YhsoxF5PXikNyYX1","session_id":"6e30a456-15c0-4e3c-af27-9f4dab375915","uuid":"e65122b0-e9a4-4fe7-8b24-2d141c49fbcc","timestamp":"2026-05-05T22:07:25.971Z"}
