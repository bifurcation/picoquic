ne\n1972\t    }\n1973\t\n1974\t    /// Compute the number of microseconds until this connection\n1975\t    /// next needs attention, capped at `delay_max`.\n1976\t    pub fn wake_delay(&self, current_time: Instant, delay_max: i64) -> i64 {\n1977\t        let next = self.next_wake_time.ticks();\n1978\t        let now = current_time.ticks();\n1979\t        if next <= now {\n1980\t            0\n1981\t        } else {\n1982\t            let delta = (next - now) as i64;\n1983\t            delta.min(delay_max)\n1984\t        }\n1985\t    }\n1986\t\n1987\t    /// Connection state-machine position.\n1988\t    pub fn state(&self) -> State {\n1989\t        self.connection_state\n1990\t    }\n1991\t\n1992\t    /// Override the per-connection padding policy.\n1993\t    pub fn set_padding_policy(&mut self, padding_multiple: u32, padding_minsize: u32) {\n1994\t        self.padding_multiple = padding_multiple;\n1995\t        self.padding_minsize = padding_minsize;\n1996\t    }\n1997\t\n1998\t    /// Read the per-connection padding policy as `(multiple,\n1999\t    /// min-size)`."}]},"parent_tool_use_id":"toolu_01FNJRg8YhsoxF5PXikNyYX1","session_id":"6e30a456-15c0-4e3c-af27-9f4dab375915","uuid":"91ed4738-cdc3-4c32-bd52-285ea5452cd3","timestamp":"2026-05-05T21:20:25.204Z"}
