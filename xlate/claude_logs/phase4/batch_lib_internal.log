{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01YFzASYQxeNWxVTBSKMqrz3","type":"tool_result","content":"4039\tpicoquic_cnx_t* picoquic_create_cnx_internal(picoquic_quic_t* quic,\n4040\t    picoquic_connection_id_t initial_cnx_id, picoquic_connection_id_t remote_cnx_id, \n4041\t    const struct sockaddr* addr_to, uint64_t start_time, uint32_t preferred_version,\n4042\t    char const* sni, char const* alpn, char client_mode,\n4043\t    void * initial_aead_dec, void* initial_pn_dec)\n4044\t{\n4045\t    picoquic_cnx_t* cnx = (picoquic_cnx_t*)malloc(sizeof(picoquic_cnx_t));\n4046\t\n4047\t    if (cnx != NULL) {\n4048\t        int ret;\n4049\t        picoquic_local_cnxid_t* cnxid0;\n4050\t\n4051\t        memset(cnx, 0, sizeof(picoquic_cnx_t));\n4052\t        cnx->start_time = start_time;\n4053\t        cnx->phase_delay = INT64_MAX;\n4054\t        cnx->client_mode = client_mode;\n4055\t        if (client_mode) {\n4056\t            if (picoquic_is_connection_id_null(&initial_cnx_id)) {\n4057\t                picoquic_create_random_cnx_id(quic, &initial_cnx_id, 8);\n4058\t            }\n4059\t        }\n4060\t        cnx->initial_cnxid = initial_cnx_id;\n4061\t        cnx->quic = quic;\n4062\t        cnx->pmtud_policy = quic->default_pmtud_policy;\n4063\t        /* Create the connection ID number 0 */\n4064\t        cnxid0 = picoquic_create_local_cnxid(cnx, 0, NULL, start_time);\n4065\t\n4066\t        /* Initialize path updates and quality updates before creating the first path */\n4067\t        cnx->are_path_callbacks_enabled = quic->are_path_callbacks_enabled;\n4068\t        cnx->rtt_update_delta = quic->rtt_update_delta;\n4069\t        cnx->pacing_rate_update_delta = quic->pacing_rate_update_delta;\n4070\t\n4071\t        /* Initialize the stream data repeat queue */\n4072\t        picoquic_queue_data_repeat_init(cnx);\n4073\t\n4074\t        /* Initialize the connection ID stash */\n4075\t        ret = picoquic_create_path(cnx, start_time, NULL, addr_to, 0, 0);\n4076\t        if (ret == 0) {\n4077\t            /* Should return 0, since this is the first path */\n4078\t            ret = picoquic_init_cnxid_stash(cnx);\n4079\t        }\n4080\t\n4081\t        if (ret != 0 || cnxid0 == NULL) {\n4082\t            picoquic_delete_cnx(cnx);\n4083\t            /* free(cnx); */\n4084\t            cnx = NULL;\n4085\t        } else {\n4086\t            cnx->next_wake_time = start_time;\n4087\t            SET_LAST_WAKE(quic, PICOQUIC_QUICCTX);\n4088\t            picoquic_insert_cnx_in_list(quic, cnx);\n4089\t            picoquic_insert_cnx_by_wake_time(quic, cnx);\n4090\t            /* Do not require verification for default path */\n4091\t            cnx->path[0]->first_tuple->p_local_cnxid = cnxid0;\n4092\t            cnx->path[0]->first_tuple->challenge_verified = 1;\n4093\t\n4094\t            cnx->datagram_priority = cnx->quic->default_datagram_priority;\n4095\t            cnx->high_priority_stream_id = UINT64_MAX;\n4096\t            for (int i = 0; i < 4; i++) {\n4097\t                cnx->next_stream_id[i] = i;\n4098\t            }\n4099\t            picoquic_register_path(cnx, cnx->path[0]);\n4100\t        }\n4101\t    }\n4102\t\n4103\t    if (cnx != NULL) {\n4104\t        memcpy(&cnx->local_parameters, &quic->default_tp, sizeof(picoquic_tp_t));\n4105\t        /* If the default parameters include preferred address, document it */\n4106\t        if (cnx->local_parameters.preferred_address.is_defined) {\n4107\t            /* Create an additional CID -- always for path 0, even if multipath */\n4108\t            picoquic_local_cnxid_t* cnxid1 = picoquic_create_local_cnxid(cnx, 0, NULL, start_time);\n4109\t            if (cnxid1 != NULL){\n4110\t                /* copy the connection ID into the local parameter */\n4111\t                cnx->local_parameters.preferred_address.connection_id = cnxid1->cnx_id;\n4112\t                /* Create the reset secret */\n4113\t                (void)picoquic_create_cnxid_reset_secret(cnx->quic, &cnxid1->cnx_id,\n4114\t                    cnx->local_parameters.preferred_address.statelessResetToken);\n4115\t            }\n4116\t        }\n4117\t\n4118\t        /* Apply the defined MTU MAX if specified and not set in defaults. */\n4119\t        if (cnx->local_parameters.max_packet_size == 0 && cnx->quic->mtu_max > 0)\n4120\t        {\n4121\t            cnx->local_parameters.max_packet_size = cnx->quic->mtu_max -\n4122\t                PICOQUIC_MTU_OVERHEAD(addr_to);\n4123\t        }\n4124\t\n4125\t        /* If local connection ID size is null, don't allow migration */\n4126\t        if (!cnx->client_mode && quic->local_cnxid_length == 0) {\n4127\t            cnx->local_parameters.migration_disabled = 1;\n4128\t        }\n4129\t\n4130\t        /* Initialize BDP transport parameter */\n4131\t        if (quic->default_send_receive_bdp_frame) {\n4132\t           /* Accept and send BDP extension frame */\n4133\t            cnx->local_parameters.enable_bdp_frame = 1;\n4134\t        }\n4135\t \n4136\t        /* Initialize local flow control variables to advertised values */\n4137\t        cnx->maxdata_local = ((uint64_t)cnx->local_parameters.initial_max_data);\n4138\t        cnx->max_stream_id_bidir_local = STREAM_ID_FROM_RANK(\n4139\t            cnx->local_parameters.initial_max_stream_id_bidir, cnx->client_mode, 0);\n4140\t        cnx->max_stream_id_bidir_local_computed = STREAM_TYPE_FROM_ID(cnx->max_stream_id_bidir_local);\n4141\t        cnx->max_stream_id_unidir_local = STREAM_ID_FROM_RANK(\n4142\t            cnx->local_parameters.initial_max_stream_id_unidir, cnx->client_mode, 1);\n4143\t        cnx->max_stream_id_unidir_local_computed = STREAM_TYPE_FROM_ID(cnx->max_stream_id_unidir_local);\n4144\t       \n4145\t        /* Initialize padding policy to default for context */\n4146\t        cnx->padding_multiple = quic->padding_multiple_default;\n4147\t        cnx->padding_minsize = quic->padding_minsize_default;\n4148\t\n4149\t        /* Initialize spin policy, ensure that at least 1/8th of connections do not spin */\n4150\t        cnx->spin_policy = quic->default_spin_policy;\n4151\t        if (cnx->spin_policy == picoquic_spinbit_basic) {\n4152\t            uint8_t rand256 = (uint8_t)picoquic_public_random_64();\n4153\t            if (rand256 < PICOQUIC_SPIN_RESERVE_MOD_256) {\n4154\t                cnx->spin_policy = picoquic_spinbit_null;\n4155\t            }\n4156\t        }\n4157\t        else if (cnx->spin_policy == picoquic_spinbit_on) {\n4158\t            /* Option used in test to avoid randomizing spin bit on/off */\n4159\t            cnx->spin_policy = picoquic_spinbit_basic;\n4160\t        }\n4161\t\n4162\t        if (sni != NULL) {\n4163\t            cnx->sni = picoquic_string_duplicate(sni);\n4164\t        }\n4165\t\n4166\t        if (alpn != NULL) {\n4167\t            cnx->alpn = picoquic_string_duplicate(alpn);\n4168\t        }\n4169\t\n4170\t        cnx->callback_fn = quic->default_callback_fn;\n4171\t        cnx->callback_ctx = quic->default_callback_ctx;\n4172\t        cnx->congestion_alg = quic->default_congestion_alg;\n4173\t        cnx->is_preemptive_repeat_enabled = quic->is_preemptive_repeat_enabled;\n4174\t\n4175\t        /* Initialize key rotation interval to default value */\n4176\t        cnx->crypto_epoch_length_max = quic->crypto_epoch_length_max;\n4177\t\n4178\t        for (int epoch = 0; epoch < PICOQUIC_NUMBER_OF_EPOCHS; epoch++) {\n4179\t            cnx->tls_stream[epoch].send_queue = NULL;\n4180\t        }\n4181\t\n4182\t        /* Perform different initializations for clients and servers */\n4183\t        if (cnx->client_mode) {\n4184\t            if (preferred_version == 0) {\n4185\t                cnx->proposed_version = picoquic_supported_versions[0].version;\n4186\t                cnx->version_index = 0;\n4187\t            } else {\n4188\t                cnx->version_index = picoquic_get_version_index(preferred_version);\n4189\t                if (cnx->version_index