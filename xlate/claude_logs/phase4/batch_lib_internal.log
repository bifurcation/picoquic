{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01UuMrxt22CjdvvAKYAZuzeS","type":"tool_result","content":"98\tint picoquic_is_stream_closed(picoquic_stream_head_t* stream, int client_mode)\n99\t{\n100\t    int is_closed = 0;\n101\t\n102\t    if (IS_BIDIR_STREAM_ID(stream->stream_id)) {\n103\t        is_closed = ((stream->fin_requested && stream->fin_sent) || (stream->reset_requested && stream->reset_sent)) &&\n104\t            ((stream->fin_received && stream->fin_signalled) || (stream->reset_received && stream->reset_signalled));\n105\t    }\n106\t    else if (IS_LOCAL_STREAM_ID(stream->stream_id, client_mode)) {\n107\t        /* Unidir from local host*/\n108\t        is_closed = ((stream->fin_requested && stream->fin_sent) || (stream->reset_requested && stream->reset_sent));\n109\t    }\n110\t    else {\n111\t        is_closed = ((stream->fin_received && stream->fin_signalled) || (stream->reset_received && stream->reset_signalled));\n112\t    }\n113\t\n114\t    return is_closed;\n115\t}\n116\t\n117\tint picoquic_is_stream_acked(picoquic_stream_head_t* stream)\n118\t{\n119\t    int is_acked = 0;\n120\t\n121\t    if (stream->is_closed) {\n122\t        if (stream->reset_sent) {\n123\t            is_acked = stream->reset_acked;\n124\t        } \n125\t        else {\n126\t        /* Check whether the ack was already received, including the FIN bit */\n127\t            is_acked = picoquic_check_sack_list(&stream->sack_list, 0, stream->sent_offset);\n128\t        }\n129\t    }\n130\t\n131\t    return is_acked;\n132\t}\n133\t\n134\tint picoquic_delete_stream_if_closed(picoquic_cnx_t* cnx, picoquic_stream_head_t* stream)\n135\t{\n136\t    int ret = 0;\n137\t\n138\t    if (!stream->is_closed && picoquic_is_stream_closed(stream, cnx->client_mode)) {\n139\t        picoquic_update_max_stream_ID_local(cnx, stream);\n140\t        stream->is_closed = 1;\n141\t        ret = 1;\n142\t    }\n143\t    \n144\t    /* We only delete the stream if there are no pe