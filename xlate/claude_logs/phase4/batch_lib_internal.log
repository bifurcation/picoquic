{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_012wB3pzSpBdEoNvqqSvpFge","type":"tool_result","content":"1\t//! QUIC stream identifiers.\n2\t//!\n3\t//! RFC 9000 §2.1 packs four pieces of information into the\n4\t//! 62-bit stream-id integer: the role of the endpoint that opened\n5\t//! the stream (client / server, low bit), the directionality (bidi /\n6\t//! uni, second-low bit), and a 1-based rank within that\n7\t//! `(role, direction)` quadrant (the remaining bits).  This module\n8\t//! exposes those decompositions as inherent methods on a\n9\t//! [`StreamId`] newtype, replacing the C bit-twiddling helpers.\n10\t\n11\t/// Endpoint role responsible for opening a stream.  Maps to the\n12\t/// low bit of a stream id (`0` ↔ client-initiated, `1` ↔\n13\t/// server-initiated).\n14\t#[derive(Debug, Copy, Clone, PartialEq, Eq)]\n15\tpub enum Role {\n16\t    Client,\n17\t    Server,\n18\t}\n19\t\n20\t/// Stream directionality.  Maps to the second-low bit of a stream\n21\t/// id (`0` ↔ bidirectional, `1` ↔ unidirectional).\n22\t#[derive(Debug, Copy, Clone, PartialEq, Eq)]\n23\tpub enum Direction {\n24\t    Bidir,\n25\t    Unidir,\n26\t}\n27\t\n28\t/// QUIC stream identifier (62-bit).  Wraps `u64` as a newtype so\n29\t/// the bit-packed layout (RFC 9000 §2.1) is reachable through\n30\t/// well-named methods rather than C macros.\n31\t#[derive(Debug, Copy, Clone, PartialEq, Eq, PartialOrd, Ord, Hash)]\n32\tpub struct StreamId(pub u64);\n33\t\n34\timpl StreamId {\n35\t    /// `true` when this stream id was opened by the client.\n36\t    /// C: `IS_CLIENT_STREAM_ID`.\n37\t    pub const fn is_client(self) -> bool {\n38\t        (self.0 & 1) == 0\n39\t    }\n40\t\n41\t    /// `true` when this stream id identifies a bidirectional stream.\n42\t    /// C: `IS_BIDIR_STREAM_ID`.\n43\t    pub const fn is_bidir(self) -> bool {\n44\t        (self.0 & 2) == 0\n45\t    }\n46\t\n47\t    /// Whether this stream id was opened locally by an endpoint\n48\t    /// playing `local_role`.  C: `IS_LOCAL_STREAM_ID`.\n49\t    pub const fn is_local(self, local_role: Role) -> bool {\n50\t        let local_bit = match local_role {\n51\t            Role::Client => 0,\n52\t            Role::Server => 1,\n53\t        };\n54\t        (self.0 & 1) == local_bit\n55\t    }\n56\t\n57\t    /// Build a stream id from its 1-based `rank`, opening `role`,\n58\t    /// and direction.  C: `STREAM_ID_FROM_RANK`.\n59\t    pub const fn from_parts(rank: u64, role: Role, direction: Direction) -> Self {\n60\t        let role_bit = match role {\n61\t            Role::Client => 0,\n62\t            Role::Server => 1,\n63\t        };\n64\t        let dir_bit = match direction {\n65\t            Direction::Bidir => 0,\n66\t            Direction::Unidir => 2,\n67\t        };\n68\t        Self(((rank - 1) << 2) | dir_bit | role_bit)\n69\t    }\n70\t\n71\t    /// Recover the 1-based rank within the `(role, direction)` quadrant.\n72\t    /// C: `STREAM_RANK_FROM_ID` — note the off-by-four arithmetic;\n73\t    /// preserved here for parity.\n74\t    pub const fn rank(self) -> u64 {\n75\t        (self.0 + 4) >> 2\n76\t    }\n77\t\n78\t    /// Decompose a stream id into its `(direction, role)` quadrant.\n79\t    /// C: `STREAM_TYPE_FROM_ID`.\n80\t    pub const fn kind(self) -> (Direction, Role) {\n81\t        let role = if (self.0 & 1) == 0 {\n82\t            Role::Client\n83\t        } else {\n84\t            Role::Server\n85\t        };\n86\t        let direction = if (self.0 & 2) == 0 {\n87\t            Direction::Bidir\n88\t        } else {\n89\t            Direction::Unidir\n90\t        };\n91\t        (direction, role)\n92\t    }\n93\t\n94\t    /// Next stream id with the same `(direction, role)` quadrant.\n95\t    /// C: `NEXT_STREAM_ID_FOR_TYPE`.\n96\t    pub const fn next_with_same_kind(self) -> Self {\n97\t        Self(self.0 + 4)\n98\t    }\n99\t}\n100\t\n101\t#[cfg(test)]\n102\tmod test {}\n103\t"}]},"parent_tool_use_id":"toolu_01FNJRg8YhsoxF5PXikNyYX1","session_id":"6e30a456-15c0-4e3c-af27-9f4dab375915","uuid":"06bc4bff-9238-40e4-ac9f-e33830240bea","timestamp":"2026-05-05T22:22:21.764Z"}
