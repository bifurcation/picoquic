{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01VzqMdAejjcfnzhZdAoLent","type":"tool_result","content":"380\t    /// `true` when the id has zero length.  Mirrors the C\n381\t    /// `is_connection_id_null` sentinel check.\n382\t    pub fn is_empty(&self) -> bool {\n383\t        self.id_len == 0\n384\t    }\n385\t\n386\t    /// Hash with a 16-byte seed.  C: `connection_id_hash`.\n387\t    pub fn hash_with_seed(&self, seed: &[u8; 16]) -> u64 {\n388\t        crate::siphash::siphash(seed, self.as_bytes())\n389\t    }\n390\t\n391\t    /// Fold the first up-to-8 bytes of the id into a `u64`.\n392\t    /// C: `val64_connection_id`.\n393\t    pub fn val64(&self) -> u64 {\n394\t        let bytes = self.as_bytes();\n395\t        let len = bytes.len().min(8);\n396\t        let mut buf = [0u8; 8];\n397\t        buf[..len].copy_from_slice(&bytes[..len]);\n398\t        u64::from_be_bytes(buf)\n399\t    }\n400\t}\n401\t\n402\t// ---------------------------------------------------------------------------\n403\t// IO vectors.\n404\t//\n405\t// The C `picoquic_iovec_t` (and the picotls-side `PtlsIovec*` that\n406\t// aliased it) are gone — every place that used to take an iovec\n407\t// pair now takes a `&[u8]` (single buffer) or `&[&[u8]]` /\n408\t// `Vec<Vec<u8>>` (list of buffers), per the project's\n409\t// \"use Rust's slice/vec types\" policy.\n410\t\n411\t// ---------------------------------------------------------------------------\n412\t// Opaque types (forward declarations).\n413\t//\n414\t// `Quic`, `Connection`, and `Path` are\n415\t// defined in `internal.h`.  Phase 1 declares them as empty\n416\t// structs so callers can refer to them; the real layout lands when\n417\t// the internal header is translated.  The `_opaque` field prevents\n418\t// callers from constructing one accidentally, and the `Debug` impl\n419\t// gives the structs a printable shape for log lines.\n420\t\n421\t// Full bodies live in `crate::internal`; pull them in for use within\n422\t// this module's signatures (no re-export — callers reach them as\n423\t// `crate::internal::*`).\n424\tuse crate::internal::{Connection, Path, Quic};\n425\t\n426\t// ---------------------------------------------------------------------------\n427\t// Application callback events.\n428\t\n429\t/// Event type passed to the application's stream / connection"}]},"parent_tool_use_id":"toolu_01FNJRg8YhsoxF5PXikNyYX1","session_id":"6e30a456-15c0-4e3c-af27-9f4dab375915","uuid":"897a6a7d-7d61-4fee-8017-5a58437ce1cf","timestamp":"2026-05-05T21:22:10.560Z"}
