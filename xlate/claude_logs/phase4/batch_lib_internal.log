{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_011pQoFk7sU7B9QRLpQmXeja","type":"tool_result","content":"3352\tint picoquic_process_ack_of_ack_frame(\n3353\t    picoquic_sack_list_t* sack_list, uint8_t* bytes, size_t bytes_max, size_t* consumed, int is_ecn)\n3354\t{\n3355\t    int ret;\n3356\t    uint64_t largest;\n3357\t    uint64_t ack_delay;\n3358\t    uint64_t num_block;\n3359\t\n3360\t    ret = picoquic_parse_ack_header(bytes, bytes_max, &num_block, NULL, &largest, &ack_delay, consumed, 0);\n3361\t\n3362\t    if (ret == 0) {\n3363\t        ret = picoquic_process_ack_of_ack_body(sack_list, largest, num_block, bytes, bytes_max, consumed, is_ecn);\n3364\t    }\n3365\t\n3366\t    return ret;\n3367\t}\n3368\t\n3369\t/* Forward declaration of skip frame function */\n3370\tstatic const uint8_t* picoquic_skip_ack_frame_maybe_ecn(const uint8_t* bytes, const uint8_t* bytes_max, int is_ecn, int has_path);\n3371\t\n3372\t/* For PATH_ACK frame, ACK of ACK needs to retrieve the ACK context associated with the path */\n3373\tint picoquic_process_ack_of_path_ack_frame(\n3374\t    picoquic_cnx_t * cnx, uint8_t* bytes, size_t bytes_max, size_t* consumed, int is_ecn)\n3375\t{\n3376\t    int ret;\n3377\t    uint64_t largest;\n3378\t    uint64_t ack_delay;\n3379\t    uint64_t num_block;\n3380\t    uint64_t path_id = 0;\n3381\t\n3382\t    ret = picoquic_parse_ack_header(bytes, bytes_max, &num_block, &path_id, &largest, &ack_delay, consumed, 0);\n3383\t\n3384\t    if (ret == 0) {\n3385\t        picoquic_ack_context_t* ack_ctx = NULL;\n3386\t        if (cnx->is_multipath_enabled) {\n3387\t            int path_index = picoquic_find_path_by_unique_id(cnx, path_id);\n3388\t            if (path_index >= 0) {\n3389\t                ack_ctx = &cnx->path[path_index]->ack_ctx;\n3390\t            }\n3391\t        }\n3392\t\n3393\t        if (ack_ctx == NULL) {\n3394\t            /* skip ack frame */\n3395\t            const uint8_t* bytes_next = picoquic_skip_ack_frame_maybe_ecn(bytes, bytes + bytes_max, is_ecn, 1);\n3396\t            if (bytes_next == NULL) {\n3397\t                ret = -1;\n3398\t                *consumed = bytes_max;\n3399\t            }\n3400\t            else {\n3401\t                *consumed = bytes_next - bytes;\n3402\t            }\n3403\t        }\n3404\t        else {\n3405\t            ret = picoquic_process_ack_of_ack_body(&ack_ctx->sack_list, largest, num_block, bytes, bytes_max, consumed, is_ecn);\n3406\t        }\n3407\t    }\n3408\t\n3409\t    return ret;\n3410\t}\n3411\t\n3412\tint picoquic_check_frame_needs_repeat(picoquic_cnx_t* cnx, const uint8_t* bytes,\n3413\t    size_t bytes_max, picoquic_packet_type_enum p_type, \n3414\t    int* no_need_to_repeat, int* do_not_detect_spurious, int *is_preemptive_needed)\n3415\t{\n3416\t    int ret = 0;\n3417\t    int fin;\n3418\t    size_t data_length;\n3419\t    uint64_t stream_id;\n3420\t    uint64_t offset;\n3421\t    uint64_t maxdata;"}]},"parent_tool_use_id":"toolu_01FNJRg8YhsoxF5PXikNyYX1","session_id":"6e30a456-15c0-4e3c-af27-9f4dab375915","uuid":"3aafc4b3-8331-4c8b-b206-fb4ef272e237","timestamp":"2026-05-05T22:22:53.113Z"}
