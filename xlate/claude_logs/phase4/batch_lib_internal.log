{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01Y1yB7W29XGtKqJjosVRKpv","type":"tool_result","content":"1165\t    pub v_thread_ctx: Option<Box<dyn Any>>,\n1166\t}\n1167\t\n1168\t/// Map a crypto epoch (0-3) to its packet-number-space context.\n1169\t/// C: `picoquic_context_from_epoch`.\n1170\t///\n1171\t/// Epoch 0 = Initial → Initial\n1172\t/// Epoch 1 = 0-RTT   → Application\n1173\t/// Epoch 2 = Handshake → Handshake\n1174\t/// Epoch 3 = 1-RTT   → Application\n1175\tpub fn context_from_epoch(epoch: i32) -> PacketContext {\n1176\t    const PC: [PacketContext; 4] = [\n1177\t        PacketContext::Initial,\n1178\t        PacketContext::Application,\n1179\t        PacketContext::Handshake,\n1180\t        PacketContext::Application,\n1181\t    ];\n1182\t    if epoch >= 0 && epoch < 4 {\n1183\t        PC[epoch as usize]\n1184\t    } else {\n1185\t        PacketContext::Application\n1186\t    }\n1187\t}\n1188\t\n1189\timpl Quic {\n1190\t    /// Replay-protection check: is this token already in the\n1191\t    /// registered-token table?  Inserts it if not.\n1192\t    pub fn registered_token_check_reuse(\n1193\t        &mut self,\n1194\t        token: &[u8],\n1195\t        token_length: usize,\n1196\t        expiry_time: u64,\n1197\t    ) -> Result<(), crate::Error> {\n1198\t        if token_length < 8 {\n1199\t            return Err(crate::Error::InvalidArgument);\n1200\t        }\n1201\t        // Last 8 bytes of token form the hash key (C: PICOPARSE_64(token + length - 8)).\n1202\t        let token_hash = parse_64(&token[token_length - 8..token_length]);\n1203\t        if let Some(rt_splay_tok) = self.token_reuse_tree.find(&token_hash) {\n1204\t            // Already registered — increment count.\n1205\t            if let Some(arena_tok) = self.token_reuse_tree.get(rt_splay_tok) {\n1206\t                let arena_tok = *arena_tok;\n1207\t                if let Some(rt) = self.registered_tokens.get_mut(arena_tok) {\n1208\t                    rt.count += 1;\n1209\t                }\n1210\t            }\n1211\t            Err(crate::Error::Generic) // token reuse detected\n1212\t        } else {\n1213\t            let rt = RegisteredToken {\n1214\t                registered_token_membership: None,\n1215\t                token_time: crate::Instant::from_ticks(expiry_time),\n1216\t                token_hash,\n1217\t                count: 1,\n1218\t            };\n1219\t            let rt_tok = self.registered_tokens.insert(rt)?;\n1220\t            let (st, _) = self.token_reuse_tree.insert(token_hash, rt_tok)?;\n1221\t            // Store the splay token back for O(1) removal.\n1222\t            if let Some(entry) = self.registered_tokens.get_mut(rt_tok) {\n1223\t                entry.registered_token_membership = Some(st);\n1224\t            }\n1225\t            Ok(())\n1226\t        }\n1227\t    }\n1228\t\n1229\t    /// Drop registered-token entries that expired before\n1230\t    /// `expiry_time_max`.\n1231\t    pub fn registered_token_clear(&mut self, expiry_time_max: Instant) {\n1232\t        // Remove entries from the front of the tree (lowest key = lowest token_hash)\n1233\t        // that have expired. Since the tree is keyed by token_hash not by time,\n1234\t        // we iterate all entries and remove expired ones.\n1235\t        // C iterates smallest token_time first using picosplay_first.\n1236\t        // We approximate by draining from the arena's perspective.\n1237\t        loop {\n1238\t            let first_st = match self.token_reuse_tree.first() {\n1239\t                Some(st) => st,\n1240\t                None => break,\n1241\t            };\n1242\t            let arena_tok = match self.token_reuse_tree.get(first_st) {\n1243\t                Some(&t) => t,\n1244\t                None => break,\n1245\t            };\n1246\t            let expired = match self.registered_tokens.get(arena_tok) {\n1247\t                Some(rt) => rt.token_time < expiry_time_max,\n1248\t                None => true,\n1249\t            };\n1250\t            if !expired {\n1251\t                break;\n1252\t            }\n1253\t            self.token_reuse_tree.remove(first_st);\n1254\t            self.registered_tokens.remove(arena_tok);\n1255\t        }\n1256\t    }\n1257\t}\n1258\t\n1259\t// ---------------------------------------------------------------------------\n1260\t// SACK list (used for both packet-number and stream-byte ranges).\n1261\t\n1262\tpub struct SackItem {\n1263\t    /// Membership in the parent [`SackList::ack_tree`].  Phase 4\n1264\t    /// uses this for O(1) removal once a range is acknowledged.\n1265\t    pub ack_tree_membership: Option<SplayToken>,\n1266\t    pub start_of_sack_range: u64,\n1267\t    pub end_of_sack_range: u64,\n1268\t    pub time_created: Instant,\n1269\t    pub nb_times_sent: [i32; 2],\n1270\t}\n1271\t\n1272\tpub struct SackRangeCount {\n1273\t    pub range_counts: [i32; MAX_ACK_RANGE_REPEAT],\n1274\t}\n1275\t\n1276\tpub struct SackList {\n1277\t    /// SACK ranges sorted by start of range.  Splay-tree access\n1278\t    /// locality matters: incoming acks tend to merge adjacent ranges.\n1279\t    pub ack_tree: SplayTree<u64, SackItemToken>,\n1280\t    /// Owning arena for [`SackItem`] entries reachable through\n1281\t    /// [`Self::ack_tree`].\n1282\t    pub sack_items: Arena<SackItem>,\n1283\t    pub ack_horizon: Instant,\n1284\t    pub horizon_delay: i64,\n1285\t    pub rc: [SackRangeCount; 2],\n1286\t}\n1287\t\n1288\t// ---------------------------------------------------------------------------\n1289\t// Stream head.\n1290\t\n1291\tpub struct StreamHead {\n1292\t    /// Membership in the owning connection's `stream_tree`.\n1293\t    /// Phase 4 uses this for O(1) removal when the stream closes.\n1294\t    pub stream_tree_membership: Option<SplayToken>,\n1295\t    pub stream_id: u64,\n1296\t    /// Path this stream is pinned to, if any.  C: `*mut Path`\n1297\t    /// back-pointer (`affinity_path`).\n1298\t    pub affinit