).expect(\"parse CONFIG_TWO\"));\n459\t\n460\t    // Every entry in ERROR_CASES must fail to parse.\n461\t    for (i, args) in ERROR_CASES.iter().enumerate() {\n462\t        assert!(\n463\t            parse_argv(args).is_err(),\n464\t            \"Expected parse error for case {i}: {:?}\",\n465\t            args[0],\n466\t        );\n467\t    }\n468\t}\n469\t\n470\t/// C: `config_quic_test` in `picoquictest/config_test.c`.\n471\t///\n472\t/// Builds a QUIC context from a parsed config and verifies that key\n473\t/// fields (max connections, ALPN, reset seed, congestion algorithm,\n474\t/// flow-control limits, and preferred address) are reflected correctly\n475\t/// in the resulting context.  Mirrors `config_quic_test_one` for two\n476\t/// distinct configs.\n477\t#[test]\n478\tfn config_quic() {\n479\t    fn config_quic_test_one(mut config: Config) {\n480\t        use crate::tests::util::{\n481\t            TEST_ECH_CONFIG, TEST_ECH_PRIVATE_KEY, TEST_FILE_CERT_STORE, TEST_FILE_SERVER_CERT,\n482\t            TEST_FILE_SERVER_KEY,\n483\t        };\n484\t\n485\t        // Swap in test-fixture paths where the config has non-None file fields,\n486\t        // mirroring the C `picoquic_get_input_path` substitutions.\n487\t        if config.server_cert_file.is_some() {\n488\t            config.server_cert_file = Some(fixture_path(TEST_FILE_SERVER_CERT));\n489\t        }\n490\t        if config.server_key_file.is_some() {\n491\t            config.server_key_file = Some(fixture_path(TEST_FILE_SERVER_KEY));\n492\t        }\n493\t        if config.root_trust_file.is_some() {\n494\t            config.root_trust_file = Some(fixture_path(TEST_FILE_CERT_STORE));\n495\t        }\n496\t        if config.ech_key_file.is_some() {\n497\t            config.ech_key_file = Some(fixture_path(TEST_ECH_PRIVATE_KEY));\n498\t        }\n499\t        if config.ech_config_file.is_some() {"}]},"parent_tool_use_id":"toolu_01FNJRg8YhsoxF5PXikNyYX1","session_id":"6e30a456-15c0-4e3c-af27-9f4dab375915