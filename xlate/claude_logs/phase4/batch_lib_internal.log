{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01WQURTup74krLDRjYAqFWnR","type":"tool_result","content":"3785\t/// Decode a QUIC variable-length integer from `bytes`.\n3786\t/// Returns the number of bytes consumed (0 on error/underflow).\n3787\t/// C: `picoquic_varint_decode`.\n3788\tpub fn varint_decode(bytes: &[u8], n64: &mut u64) -> usize {\n3789\t    if bytes.is_empty() {\n3790\t        *n64 = 0;\n3791\t        return 0;\n3792\t    }\n3793\t    let length = 1usize << ((bytes[0] & 0xC0) >> 6);\n3794\t    if length > bytes.len() {\n3795\t        *n64 = 0;\n3796\t        return 0;\n3797\t    }\n3798\t    let mut v = (bytes[0] & 0x3F) as u64;\n3799\t    for i in 1..length {\n3800\t        v <<= 8;\n3801\t        v += bytes[i] as u64;\n3802\t    }\n3803\t    *n64 = v;\n3804\t    length\n3805\t}\n3806\t\n3807\t/// Decode a QUIC varint at the start of `bytes`, return the\n3808\t/// remaining tail (or `None` on under-read).  C: returned a\n3809\t/// pointer past the consumed bytes; the Rust shape returns the\n3810\t/// remaining slice instead.\n3811\tpub fn frames_varint_decode<'a>(bytes: &'a [u8], n64: &mut u64) -> Option<&'a [u8]> {\n3812\t    if bytes.is_empty() {\n3813\t        return None;\n3814\t    }\n3815\t    let length = 1usize << ((bytes[0] & 0xC0) >> 6);\n3816\t    if length > bytes.len() {\n3817\t        return None;\n3818\t    }\n3819\t    let mut v = (bytes[0] & 0x3F) as u64;\n3820\t    for i in 1..length {\n3821\t        v <<= 8;\n3822\t        v += bytes[i] as u64;\n3823\t    }\n3824\t    *n64 = v;\n3825\t    Some(&bytes[length..])\n3826\t}\n3827\t\n3828\t/// Skip past a varint, returning the remaining tail.  C:\n3829\t/// `frames_varint_skip` returning a pointer.\n3830\tpub fn frames_varint_skip(bytes: &[u8]) -> Option<&[u8]> {\n3831\t    if bytes.is_empty() {\n3832\t        return None;\n3833\t    }\n3834\t    let v_len = 1usize << ((bytes[0] & 0xC0) >> 6);\n3835\t    if v_len > bytes.len() {\n3836\t        None\n3837\t    } else {\n3838\t        Some(&bytes[v_len..])\n3839\t    }\n3840\t}\n3841\t\n3842\t/// Return the byte-length of the varint starting at `bytes[0]`.\n3843\t/// C: `picoquic_varint_skip`.\n3844\tpub fn varint_skip(bytes: &[u8]) -> usize {\n3845\t    if bytes.is_empty() {\n3846\t        return 0;\n3847\t    }\n3848\t    1usize << ((bytes[0] & 0xC0) >> 6)\n3849\t}\n3850\t\n3851\t/// Predict the number of bytes required to encode `n64` as a QUIC varint.\n3852\t/// C: `picoquic_encode_varint_length`.\n3853\tpub fn encode_varint_length(n64: u64) -> usize {\n3854\t    if n64 < 64 {\n3855\t        1\n3856\t    } else if n64 < 16_384 {\n3857\t        2\n3858\t    } else if n64 < 1_073_741_824 {\n3859\t        4\n3860\t    } else {\n3861\t        8\n3862\t    }\n3863\t}\n3864\t"}]},"parent_tool_use_id":"toolu_01FNJRg8YhsoxF5PXikNyYX1","session_id":"6e30a456-15c0-4e3c-af27-9f4dab375915","uuid":"77f1d080-9dc2-485e-93e2-84a431645056","timestamp":"2026-05-05T21:59:10.338Z"}
