\t            stream->affinity_path = NULL;\n1919\t        }\n1920\t        stream = picoquic_next_stream(stream);\n1921\t    }\n1922\t\n1923\t    /* Signal to the application */\n1924\t    if (cnx->are_path_callbacks_enabled && cnx->callback_fn != NULL &&\n1925\t        cnx->callback_fn(cnx, path_x->unique_path_id, NULL, 0, picoquic_callback_path_deleted,\n1926\t        cnx->callback_ctx, path_x->app_path_ctx) != 0) {\n1927\t        picoquic_connection_error_ex(cnx, PICOQUIC_TRANSPORT_INTERNAL_ERROR, 0, \"Path deleted callback failed.\");\n1928\t    }\n1929\t    /* Remove old path data from retransmitted queue */\n1930\t    /* TODO: what if using multiple number spaces? */\n1931\t    for (picoquic_packet_context_enum pc = 0; pc < picoquic_nb_packet_context; pc++)"}]},"parent_tool_use_id":"toolu_01FNJRg8YhsoxF5PXikNyYX1","session_id":"6e30a456-15c0-4e3c-af27-9f4dab375915","uuid":"ed76d7b0-2ea1-4ecc-bb2a-a2517fc35ee0","timestamp":"2026-05-05T21:39:51.462Z"}
