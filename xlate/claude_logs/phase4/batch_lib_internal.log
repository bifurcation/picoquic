{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01LJorXbhrUcznSGZU3byett","type":"tool_result","content":"550\t/// Packet-fuzzer callback.  Folds the C `void* fuzz_ctx` into the\n551\t/// implementor.  Returns the new packet length (which may equal\n552\t/// the input).  C: `Fuzz`.\n553\tpub trait Fuzz {\n554\t    fn fuzz(\n555\t        &mut self,\n556\t        connection: &mut Connection,\n557\t        bytes: &mut [u8],\n558\t        length: usize,\n559\t        header_length: usize,\n560\t    ) -> u32;\n561\t}\n562\t\n563\t/// Direct-receive callback for streams marked with\n564\t/// `mark_direct_receive_stream`.  C:\n565\t/// `StreamDirectReceive`.  Folds `direct_receive_ctx`\n566\t/// into the implementor.\n567\tpub trait StreamDirectReceive {\n568\t    fn receive(\n569\t        &mut self,\n570\t        connection: &mut Connection,\n571\t        stream_id: u64,\n572\t        fin: bool,\n573\t        bytes: &[u8],\n574\t        offset: u64,\n575\t    ) -> i32;\n576\t}\n577\t\n578\t// ---------------------------------------------------------------------------\n579\t// Path quality and per-ack state.\n580\t\n581\t/// Per-path quality snapshot reported by\n582\t/// `get_path_quality`.  C: `PathQuality`.\n583\t#[derive(Debug, Copy, Clone)]\n584\tpub struct PathQuality {\n585\t    /// Receive rate estimate in bytes per second.\n586\t    pub receive_rate_estimate: u64,\n587\t    /// Pacing rate in bytes per second.\n588\t    pub pacing_rate: u64,\n589\t    /// Number of bytes in the congestion window.\n590\t    pub cwin: u64,\n591\t    /// Smoothed RTT estimate in microseconds.\n592\t    pub rtt: Duration,\n593\t    /// Most recent RTT sample.\n594\t    pub rtt_sample: Duration,\n595\t    /// Estimated RTT variability.\n596\t    pub rtt_variant: Duration,\n597\t    /// Minimum observed RTT since path creation.\n598\t    pub rtt_min: Duration,\n599\t    /// Maximum observed RTT since path creation.\n600\t    pub rtt_max: Duration,\n601\t    pub sent: u64,\n602\t    pub lost: u64,\n603\t    pub timer_losses: u64,\n604\t    pub spurious_losses: u64,\n605\t    pub max_spurious_rtt: Duration,\n606\t    pub max_reorder_delay: Duration,\n607\t    pub max_reorder_gap: u64,\n608\t    pub bytes_in_transit: u64,\n609\t    pub bytes_sent: u64,\n610\t    pub bytes_received: u64,\n611\t}\n612\t\n613\timpl Default for PathQuality {\n614\t    fn default() -> Self {\n615\t        Self {\n616\t            receive_rate_estimate: 0,\n617\t            pacing_rate: 0,\n618\t            cwin: 0,\n619\t            rtt: Duration::from_ticks(0),\n620\t            rtt_sample: Duration::from_ticks(0),\n621\t            rtt_variant: Duration::from_ticks(0),\n622\t            rtt_min: Duration::from_ticks(0),\n623\t            rtt_max: Duration::from_ticks(0),\n624\t            sent: 0,\n625\t            lost: 0,\n626\t            timer_losses: 0,\n627\t            spurious_losses: 0,\n628\t            max_spurious_rtt: Duration::from_ticks(0),\n629\t            max_reorder_delay: Duration::from_ticks(0),\n630\t            max_reorder_gap: 0,\n631\t            bytes_in_transit: 0,\n632\t            bytes_sent: 0,\n633\t            bytes_received: 0,\n634\t        }\n635\t    }\n636\t}\n637\t\n638\t// ---------------------------------------------------------------------------\n639\t// Datagram and congestion APIs.\n640\t\n641\t/// Datagram-readiness signalling passed to\n642\t/// [`provide_datagram_buffer_ex`].\n643\t#[derive(Debug, Copy, Clone, PartialEq, Eq, Default)]\n644\t#[repr(u8)]\n645\tpub enum DatagramActive {\n646\t    /// Application has nothing more to send.\n647\t    #[default]\n648\t    NotActive = 0,\n649\t    /// Application can send on any path.\n650\t    AnyPath = 1,\n651\t    /// Application can send only on the current path.\n652\t    ThisPathOnly = 2,\n653\t    /// Application can send on the current path *and* others.\n654\t    ThisPathAndOthers = 3,\n655\t}\n656\t\n657\t/// Default stream priority used when none is set explicitly.\n658\tpub const DEFAULT_STREAM_PRIORITY: u8 = 9;\n659\t\n660\t/// Reference packet size used as the cautious upper bound when\n661\t/// queueing datagrams before path MTU is known.  In C this is\n662\t/// defined in terms of `ENFORCED_INITIAL_MTU`, which lives\n663\t/// in the internal header.  The numeric value (1252 bytes, the IPv4\n664\t/// initial MTU floor) is duplicated here to keep the public API\n665\t/// translatable in Phase 1 — the constant will be re-exported from\n666\t/// the internal module once it is translated.\n667\tpub const DATAGRAM_QUEUE_CAUTIOUS_LENGTH: usize = INITIAL_MTU_IPV4;\n668\t\n669\t/// Congestion-control event fed to a [`CongestionControl`]\n670\t/// implementation's `alg_notify` hook.\n671\t#[derive(Debug, Copy, Clone, PartialEq, Eq)]\n672\tpub enum CongestionNotification {\n673\t    /// At least one packet was acknowledged.\n674\t    Acknowledgement,\n675\t    /// A packet was retransmitted.\n676\t    Repeat,\n677\t    /// A retransmission timer expired.\n678\t    Timeout,\n679\t    /// A retransmission was found to have been spurious.\n680\t    SpuriousRepeat,\n681\t    /// A new RTT sample is available.\n682\t    RttMeasurement,\n683\t    /// ECN-marked traffic was acknowledged.\n684\t    EcnEc,\n685\t    /// The send path is blocked by the congestion window.\n686\t    CwinBlocked,\n687\t    /// Seed the congestion window from external knowledge.\n688\t    SeedCwin,\n689\t    /// Reset congestion-control state.\n690\t    Reset,\n691\t    /// Notification of lost feedback.\n692\t    LostFeedback,\n693\t}\n694\t\n695\t/// Per-ACK state passed to the congestion-control algorithm.  C:\n696\t/// `PerAckState`.\n697\t///\n698\t/// Single-bit `unsigned int : 1` bitfields collapse to `bool`.  `pc`\n699\t/// stays an `i32` (the C field used `int` instead of the enum\n700\t/// itself to avoid include dependencies; we follow suit so the\n701\t/// translation can be checked field-by-field).\n702\t#[derive(Debug, Copy, Clone)]\n703\tpub struct PerAckState {\n704\t    pub rtt_measurement: Duration,\n705\t    pub send_delay: Duration,\n706\t    pub one_way_delay: Duration,\n707\t    pub nb_bytes_acknowledged: u64,\n708\t    pub nb_bytes_newly_lost: u64,\n709\t    pub nb_bytes_lost_since_packet_sent: u64,\n710\t    pub nb_bytes_delivered_since_packet_sent: u64,\n711\t    pub inflight_prior: u64,\n712\t    pub lost_packet_number: u64,\n713\t    pub lost_packet_sent_time: Instant,\n714\t    pub pc: i32,\n715\t    pub is_app_limited: bool,\n716\t    pub is_cwnd_limited: bool,\n717\t}\n718\t\n719\timpl Default for PerAckState {\n720\t    fn default() -> Self {\n721\t        Self {\n722\t            rtt_measurement: Duration::from_ticks(0),\n723\t            send_delay: Duration::from_ticks(0),\n724\t            one_way_delay: Duration::from_ticks(0),\n725\t            nb_bytes_acknowledged: 0,\n726\t            nb_bytes_newly_lost: 0,\n727\t            nb_bytes_lost_since_packet_sent: 0,\n728\t            nb_bytes_delivered_since_packet_sent: 0,\n729\t            inflight_prior: 0,\n730\t            lost_packet_number: 0,\n731\t            lost_packet_sent_time: Instant::from_ticks(0),\n732\t            pc: 0,\n733\t            is_app_limited: false,\n734\t            is_cwnd_limited: false,\n735\t        }\n736\t    }\n737\t}\n738\t\n739\t/// Congestion-control algorithm vtable.  In C this is four\n740\t/// independent function-pointer typedefs grouped into a struct\n741\t/// (`congestion_algorithm_init`,\n742\t/// `_notify`, `_delete`, `_observe`).  The C side always installs\n743\t/// the four together, so they collapse to a single Rust trait per\n744\t/// the \"trait grouping is a judgment call\" rule.\n745\t///\n746\t/// `option_string` arrives as an optional borrowed `&str`; the C\n747\t/// version accepted a nullable `char const*` that callers either\n748\t/// owned for the duration of the call or set to `NULL`.\n749\tpub trait CongestionControl {"}]},"parent_tool_use_id":"toolu_01FNJRg8YhsoxF5PXikNyYX1","session_id":"6e30a456-15c0-4e3c-af27-9f4dab375915","uuid":"a4cdb94e-eff9-43f5-9c39-c64da295783f","timestamp":"2026-05-05T21:19:59.691Z"}
