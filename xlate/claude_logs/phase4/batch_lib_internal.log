{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01R2oEUwfbXzf7R1LzkS9s48","type":"tool_result","content":"5730\t}\n5731\t\n5732\timpl Connection {\n5733\t    /// Find the local-CID list for `unique_path_id` (the index into\n5734\t    /// `connection.local_connection_id_lists`), optionally creating one when absent.\n5735\t    pub fn find_or_create_local_connection_id_list(\n5736\t        &self,\n5737\t        unique_path_id: u64,\n5738\t        _do_create: bool,\n5739\t    ) -> Option<usize> {\n5740\t        self.local_connection_id_lists\n5741\t            .iter()\n5742\t            .position(|l| l.unique_path_id == unique_path_id)\n5743\t    }\n5744\t}\n5745\t\n5746\timpl Connection {\n5747\t    pub fn create_local_connection_id(\n5748\t        &mut self,\n5749\t        unique_path_id: u64,\n5750\t        suggested_value: Option<&ConnectionId>,\n5751\t        current_time: Instant,\n5752\t    ) -> Result<LocalConnectionIdToken, crate::Error> {\n5753\t        // Find or create the per-path list.\n5754\t        let list_idx = match self\n5755\t            .local_connection_id_lists\n5756\t            .iter()\n5757\t            .position(|l| l.unique_path_id == unique_path_id)\n5758\t        {\n5759\t            Some(i) => i,\n5760\t            None => {\n5761\t                self.local_connection_id_lists.push(LocalConnectionIdList {\n5762\t                    unique_path_id,\n5763\t                    local_connection_id_sequence_next: 0,\n5764\t                    local_connection_id_retire_before: 0,\n5765\t                    local_connection_id_oldest_created: current_time.ticks(),\n5766\t                    nb_local_connection_id_expired: 0,\n5767\t                    is_demoted: false,\n5768\t                    demotion_time: crate::Instant::from_ticks(u64::MAX),\n5769\t                    connection_ids: Vec::new(),\n5770\t                });\n5771\t                self.local_connection_id_lists.len() - 1\n5772\t            }\n5773\t        };\n5774\t\n5775\t        // Decide on the CID value.\n5776\t        let connection_id = if let Some(suggested) = suggested_value {\n5777\t            *suggested\n5778\t        } else if self.local_cid_length == 0 {\n5779\t            // Zero-length CID: use default (null) connection ID.\n5780\t            ConnectionId::default()\n5781\t        } else {\n5782\t            // Generate a CID.  Phase 4: wire up real RNG from Quic context.\n5783\t            // For now use a deterministic placeholder based on sequence number.\n5784\t            let seq = self.local_connection_id_lists[list_idx]\n5785\t                .local_connection_id_sequence_next;\n5786\t            let mut bytes = [0u8; crate::CONNECTION_ID_MAX_SIZE];\n5787\t            let seq_bytes = seq.to_le_bytes();\n5788\t            let copy_len = self.local_cid_length as usize;\n5789\t            for (i, b) in bytes[..copy_len].iter_mut().enumerate() {\n5790\t                *b = seq_bytes[i % 8];\n5791\t            }\n5792\t            ConnectionId::clone_from_slice(&bytes[..copy_len])\n5793\t                .unwrap_or_default()\n5794\t        };\n5795\t\n5796\t        let seq = self.local_connection_id_lists[list_idx]\n5797\t            .local_connection_id_sequence_next;\n5798\t\n5799\t        let l_cid = LocalConnectionId {\n5800\t            connection_by_id_membership: None,\n5801\t            path_id: unique_path_id,\n5802\t            sequence: seq,\n5803\t            create_time: current_time,\n5804\t            connection_id,\n5805\t            is_acked: false,\n5806\t        };\n5807\t\n5808\t        let token = self\n5809\t            .local_connection_ids\n5810\t            .insert(l_cid)\n5811\t            .map_err(|_| crate::Error::Memory)?;\n5812\t\n5813\t        self.local_connection_id_lists[list_idx]\n5814\t            .local_connection_id_sequence_next += 1;\n5815\t        self.local_connection_id_lists[list_idx]\n5816\t            .connection_ids\n5817\t            .push(token);\n5818\t\n5819\t        if seq == 0 {\n5820\t            self.local_connection_id_lists[list_idx]\n5821\t                .local_connection_id_oldest_created = current_time.ticks();\n5822\t            if unique_path_id > self.max_path_id_in_connection_id_lists {\n5823\t                self.max_path_id_in_connection_id_lists = unique_path_id;\n5824\t            }\n5825\t        }\n5826\t\n5827\t        Ok(token)\n5828\t    }\n5829\t}\n5830\t\n5831\timpl Connection {\n5832\t    pub fn demote_local_connection_id_list(&mut self, unique_path_id: u64, _reason: u64) -> i32 {\n5833\t        if let Some(list) = self\n5834\t            .local_connection_id_lists\n5835\t            .iter_mut()\n5836\t            .find(|l| l.unique_path_id == unique_path_id)\n5837\t        {\n5838\t            if !list.is_demoted {\n5839\t                list.is_demoted = true;\n5840\t                return 1;\n5841\t            }\n5842\t        }\n5843\t        0\n5844\t    }\n5845\t}\n5846\t\n5847\timpl Connection {\n5848\t    pub fn delete_local_connection_id(&mut self, l_cid: LocalConnectionIdToken) {\n5849\t        // Remove from the backing arena.\n5850\t        let removed = self.local_connection_ids.remove(l_cid);\n5851\t        if removed.is_none() {\n5852\t            // Stale token — no-op.\n5853\t            return;\n5854\t        }\n5855\t        // Remove the token from whichever list holds it.\n5856\t        for list in &mut self.local_connection_id_lists {\n5857\t            if let Some(pos) = list.connection_ids.iter().position(|t| *t == l_cid) {\n5858\t                list.connection_ids.swap_remove(pos);\n5859\t                break;\n5860\t            }\n5861\t        }\n5862\t    }\n5863\t}\n5864\t\n5865\timpl Connection {\n5866\t    /// Remove `connection.local_connection_id_lists[list_index]`.\n5867\t    pub fn delete_local_connection_id_list(&mut self, list_index: usize) {\n5868\t        if list_index >= self.local_connection_id_lists.len() {\n5869\t            return;\n5870\t        }\n5871\t        // Remove all CIDs in this list from the arena.\n5872\t        let tokens: Vec<LocalConnectionIdToken> =\n5873\t            self.local_connection_id_lists[list_index].connection_ids.clone();\n5874\t        for tok in tokens {\n5875\t            self.local_connection_ids.remove(tok);\n5876\t        }\n5877\t        self.local_connection_id_lists.swap_remove(list_index);\n5878\t    }\n5879\t}\n5880\t\n5881\timpl Connection {\n5882\t    pub fn delete_local_connection_id_lists(&mut self) {\n5883\t        // Drain all lists, removing all CIDs from the arena.\n5884\t        for list in self.local_connection_id_lists.drain(..) {\n5885\t            for tok in list.connection_ids {\n5886\t                self.local_connection_ids.remove(tok);\n5887\t            }\n5888\t        }\n5889\t    }\n5890\t}\n5891\t\n5892\timpl Connection {\n5893\t    pub fn retire_local_connection_id(&mut self, unique_path_id: u64, sequence: u64) {\n5894\t        // Find the token with matching sequence in the matching list.\n5895\t        // Two-phase: first collect tokens, then look up.\n5896\t        let tokens: Vec<LocalConnectionIdToken> = self\n5897\t            .local_connection_id_lists\n5898\t            .iter()\n5899\t            .find(|l| l.unique_path_id == unique_path_id)\n5900\t            .map(|l| l.connection_ids.clone())\n5901\t            .unwrap_or_default();\n5902\t        let found = tokens.into_iter().find(|&tok| {\n5903\t            self.local_connection_ids\n5904\t                .get(tok)\n5905\t                .map(|l| l.sequence == sequence)\n5906\t                .unwrap_or(false)\n5907\t        });\n5908\t        if let Some(tok) = found {\n5909\t            self.delete_local_connection_id(tok);\n5910\t        }\n5911\t    }\n5912\t}\n5913\t\n5914\timpl Connection {\n5915\t    pub fn check_local_connection_id_ttl(\n5916\t        &mut self,\n5917\t        _local_connection_id_list: &mut LocalConnectionIdList,\n5918\t        _current_time: Instant,\n5919\t        _next_wake_time: &mut Instant,\n5920\t    ) {\n5921\t        // TODO: implement TTL expiry logic when needed.\n5922\t    }\n5923\t}\n5924\t\n5925\timpl Connection {\n5926\t    pub fn find_local_connection_id(\n5927\t        &self,\n5928\t        unique_path_id: u64,\n5929\t        connection_id: &ConnectionId,\n5930\t    ) -> Option<LocalConnectionIdToken> {\n5931\t        let list = self\n5932\t            .local_connection_id_lists\n5933\t            .iter()\n5934\t            .find(|l| l.unique_path_id == unique_path_id)?;\n5935\t        // Clone tokens to avoid simultaneous borrows of self.\n5936\t        let tokens: Vec<LocalConnectionIdToken> = list.connection_ids.clone();\n5937\t        tokens.into_iter().find(|&tok| {\n5938\t            self.local_connection_ids\n5939\t                .get(tok)\n5940\t                .map(|l| &l.connection_id == connection_id)\n5941\t                .unwrap_or(false)\n5942\t        })\n5943\t    }\n5944\t}\n5945\t\n5946\tpub fn format_path_challenge_frame<'a>(\n5947\t    _bytes: &'a mut [u8],\n5948\t    _more_data: &mut i32,\n5949\t    _is_pure_ack: &mut i32,\n5950\t    _challenge: u64,\n5951\t) -> Option<&'a mut [u8]> {\n5952\t    todo!()\n5953\t}\n5954\t\n5955\tpub fn format_path_response_frame<'a>(\n5956\t    _bytes: &'a mut [u8],\n5957\t    _more_data: &mut i32,\n5958\t    _is_pure_ack: &mut i32,\n5959\t    _challenge: u64,\n5960\t) -> Option<&'a mut [u8]> {\n5961\t    todo!()\n5962\t}\n5963\t\n5964\timpl Connection {\n5965\t    pub fn should_repeat_path_response_frame(&self, _bytes: &[u8], _bytes_max: usize) -> bool {\n5966\t        todo!()\n5967\t    }\n5968\t}\n5969\t\n5970\tpub fn format_new_connection_id_frame<'a>(\n5971\t    _connection: &mut Connection,\n5972\t    _local_connection_id_list: &mut LocalConnectionIdList,\n5973\t    _bytes: &'a mut [u8],\n5974\t    _more_data: &mut i32,\n5975\t    _is_pure_ack: &mut i32,\n5976\t    _l_cid: Option<LocalConnectionIdToken>,\n5977\t) -> Option<&'a