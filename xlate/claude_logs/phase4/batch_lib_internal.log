641\t    }\n2642\t\n2643\t    /// Toggle datagram readiness for this connection.\n2644\t    pub fn mark_datagram_ready(&mut self, is_ready: bool) -> Result<(), Error> {\n2645\t        self.is_datagram_ready = is_ready;\n2646\t        Ok(())\n2647\t    }\n2648\t\n2649\t    /// Per-path datagram readiness (multipath connections).\n2650\t    pub fn mark_datagram_ready_path(\n2651\t        &mut self,\n2652\t        unique_path_id: u64,\n2653\t        is_path_ready: bool,\n2654\t    ) -> Result<(), Error> {\n2655\t        if let Some(path) = self\n2656\t            .paths\n2657\t            .iter_mut()\n2658\t            .find(|p| p.unique_path_id == unique_path_id)\n2659\t        {\n2660\t            path.is_datagram_ready = is_path_ready;\n2661\t            Ok(())\n2662\t        } else {\n2663\t            Err(Error::InvalidArgument)\n2664\t        }\n2665\t    }\n2666\t}\n2667\t\n2668\t/// C: `provide_datagram_buffer`.  Old API, prefer\n2669\t/// [`provide_datagram_buffer_ex`].\n2670\tpub fn provide_datagram_buffer<'a>(\n2671\t    context: &'a mut crate::internal::StreamDataBufferArgument<'a>,\n2672\t    length: usize,\n2673\t) -> Option<&'a mut [u8]> {\n2674\t    provide_stream_data_buffer(context, length, false, false)\n2675\t}\n2676\t\n2677\tpub fn provide_datagram_buffer_ex<'a>(\n2678\t    context: &'a mut crate::internal::StreamDataBufferArgument<'a>,\n2679\t    length: usize,\n2680\t    _is_active: DatagramActive,\n2681\t) -> Option<&'a mut [u8]> {\n2682\t    provide_stream_data_buffer(context, length, false, false)\n2683\t}\n2684\t\n2685\t// ---------------------------------------------------------------------------\n2686\t// Misc per-context tunables and per-connection accessors.\n2687\t\n2688\timpl Quic {\n2689\t    /// Configure the optimistic-ACK throttling policy\n2690\t    /// (`sequence_hole_pseudo_period` is the period in packets\n2691\t    /// between intentional ACK gaps used to fingerprint optimistic\n2692\t    /// peers).\n2693\t    pub fn set_optim