2047\t    /// Peer address of the default path.  C side returned an\n2048\t    /// aliasing `struct sockaddr*` into internal storage; the Rust\n2049\t    /// translation returns by value.\n2050\t    pub fn peer_addr(&self) -> SocketAddr {\n2051\t        self.paths\n2052\t            .first()\n2053\t            .and_then(|p| p.tuples.first())\n2054\t            .map(|t| t.peer_addr)\n2055\t            .unwrap_or_else(|| \"0.0.0.0:0\".parse().unwrap())\n2056\t    }\n2057\t\n2058\t    /// Local address of the default path.\n2059\t    pub fn local_addr(&self) -> SocketAddr {\n2060\t        self.paths\n2061\t            .first()\n2062\t            .and_then(|p| p.tuples.first())\n2063\t            .map(|t| t.local_addr)\n2064\t            .unwrap_or_else(|| \"0.0.0.0:0\".parse().unwrap())\n2065\t    }\n2066\t\n2067\t    /// Local interface index for the default path.\n2068\t    pub fn local_if_index(&self) -> u32 {\n2069\t        self.paths\n2070\t            .first()\n2071\t            .and_then(|p| p.tuples.first())\n2072\t            .map(|t| t.if_index as u32)\n2073\t            .unwrap_or(0)\n2074\t    }\n2075\t\n2076\t    /// Set the local address for the default path.\n2077\t    pub fn set_local_addr(&mut self, addr: &SocketAddr) -> Result<(), Error> {\n2078\t        if let Some(path) = self.paths.first_mut() {\n2079\t            if let Some(tuple) = path.tuples.first_mut() {\n2080\t                tuple.local_addr = *addr;\n2081\t                return Ok(());\n2082\t            }\n2083\t        }\n2084\t        Err(Error::InvalidArgument)\n2085\t    }\n2086\t\n2087\t    /// Local connection ID currently in use.\n2088\t    pub fn local_connection_id(&self) -> ConnectionId {\n2089\t        self.initial_connection_id\n2090\t    }\n2091\t\n2092\t    /// Remote connection ID currently in use.\n2093\t    pub fn remote_connection_id(&self) -> ConnectionId {\n2094\t        // Return the initial connection ID as a proxy; full CID rotation is Phase 3.\n2095\t        self.initial_connection_id\n2096\t    }\n2097\t\n2098\t    /// Initial connection ID picked at handshake start.\n2099\t    pub fn initial_connection_id(&self) -> ConnectionId {\n2100\t        self.initial_connection_id\n2101\t    }\n2102\t\n2103\t    /// Client-side initial connection ID (mirrors C\n2104\t    /// `get_client_connection_id`).\n2105\t    pub fn client_connection_id(&self) -> ConnectionId {\n2106\t        if self.client_mode {\n2107\t            self.initial_connection_id\n2108\t        } else {\n2109\t            self.original_connection_id\n2110\t        }\n2111\t    }\n2112\t\n2113\t    /// Server-side initial connection ID (mirrors C\n2114\t    /// `get_server_connection_id`).\n2115\t    pub fn server_connection_id(&self) -> ConnectionId {\n2116\t        if self.client_mode {\n2117\t            self.original_connection_id\n2118\t        } else {\n2119\t            self.initial_connection_id\n2120\t        }\n2121\t    }\n2122\t\n2123\t    /// Connection ID used for log entries on this connection.\n2124\t    pub fn logging_connection_id(&self) -> ConnectionId {\n2125\t        self.initial_connection_id\n2126\t    }\n2127\t\n2128\t    /// Wall-clock start time of this connection.\n2129\t    pub fn start_time(&self) -> u64 {\n2130\t        self.start_time.ticks()\n2131\t    }\n2132\t\n2133\t    /// Whether 0-RTT data may be sent on this connection.\n2134\t    pub fn is_0rtt_available(&self) -> bool {\n2135\t        self.zero_rtt_data_accepted\n2136\t    }\n2137\t\n2138\t    /// Whether the connection has any outstanding data still queued\n2139\t    /// for transmission.\n2140\t    pub fn is_backlog_empty(&self) -> bool {\n2141\t        self.nb_bytes_queued == 0 && self.misc_frames.is_empty() && self.output_streams.is_empty()\n2142\t    }\n2143\t\n2144\t    /// Install a per-connection stream/event callback (the\n2145\t    /// `callback_fn` + `callback_ctx` pair from C collapse to a\n2146\t    /// single trait object).  See [`Quic::set_default_callback`].\n2147\t    pub fn set_callback(&mut self, callback: Option<Box<dyn StreamDataCallback>>) {\n2148\t        self.callback_fn = callback;\n2149\t    }\n2150\t\n2151\t    /// Borrow this connection's callback (`None` when none was\n2152\t    /// installed).\n2153\t    pub fn callback(&self) -> Option<&dyn StreamDataCallback> {\n2154\t        self.callback_fn.as_deref()\n2155\t    }\n2156\t\n2157\t    /// Queue a connection-level frame for transmission.\n2158\t    pub fn queue_misc_frame(\n2159\t        &mut self,\n2160\t        bytes: &[u8],\n2161\t        is_pure_ack: bool,\n2162\t        pc: PacketContext,\n2163\t    ) -> Result<(), Error> {\n2164\t        use crate::internal::MiscFrameHeader;\n2165\t        self.misc_frames.push_back(MiscFrameHeader {\n2166\t            bytes: bytes.to_vec(),\n2167\t            packet_context: pc,\n2168\t            is_pure_ack: is_pure_ack as i32,\n2169\t        });\n2170\t        Ok(())\n2171\t    }\n2172\t\n2173\t    /// Queue a datagram frame for transmission.\n2174\t    pub fn queue_datagram_frame(&mut self, bytes: &[u8]) -> Result<(), Error> {\n2175\t        use crate::internal::MiscFrameHeader;\n2176\t        self.datagrams.push_back(MiscFrameHeader {\n2177\t            bytes: bytes.to_vec(),\n2178\t            packet_context: PacketContext::Application,\n2179\t            is_pure_ack: 0,\n2180\t        });\n2181\t        Ok(())\n2182\t    }\n2183\t\n2184\t    /// `true` when the misc-frame queue is non-empty.\n2185\t    /// C: `cnx->first_misc_frame != NULL`.\n2186\t    pub fn has_misc_frames(&self) -> bool {\n2187\t        !self.misc_frames.is_empty()\n2188\t    }\n2189\t\n2190\t    /// `true` when the misc-frame queue has exactly one entry (no next).\n2191\t    /// C: `cnx->first_misc_frame != NULL && cnx->first_misc_frame->next_misc_frame == NULL`.\n2192\t    pub fn misc_frames_is_singleton(&self) -> bool {\n2193\t        self.misc_frames.len() == 1\n2194\t    }\n2195\t\n2196\t    /// Remove the last entry from the misc-frame queue.\n2197\t    /// C: `picoquic_delete_misc_or_dg(&cnx->first_misc_frame, &cnx->last_misc_frame, cnx->last_misc_frame)`.\n2198\t    pub fn delete_last_misc_frame(&mut self) {\n2199\t        self.misc_frames.pop_back();\n2200\t    }\n2201\t\n2202\t    /// Current simulated (or wall-clock) time from the QUIC context\n2203\t    /// that owns this connection.\n2204\t    /// C: `picoquic_get_quic_time(cnx->quic)`.\n2205\t    pub fn quic_time(&self) -> Instant {\n2206\t        Instant::from_ticks(current_time())\n2207\t    }\n2208\t}\n2209\t\n2210\timpl Quic {\n2211\t    /// Borrow the first connection registered with this context.\n2212\t    pub fn first_connection(&mut self) -> Option<&mut Connection> {\n2213\t        self.connections.iter_mut().next()\n2214\t    }\n2215\t\n2216\t    /// Compute the number of microseconds until *any* connection on\n2217\t    /// this context next needs attention, capped at `delay_max`.\n2218\t    pub fn next_wake_delay(&self, current_time: Instant, delay_max: i64) -> i64 {\n2219\t        let now = current_time.ticks();\n2220\t        // Find the minimum next_wake_time across all connections.\n2221\t        let earliest = self\n2222\t            .connections\n2223\t            .iter()\n2224\t            .map(|c| c.next_wake_time.ticks())\n2225\t            .min();\n2226\t        match earliest {\n2227\t            None => delay_max,\n2228\t            Some(t) if t <= now => 0,\n2229\t            Some(t) => ((t - now) as i64).min(delay_max),\n2230\t        }\n2231\t    }\n2232\t\n2233\t    /// Wall-clock time at which the next event is scheduled.\n2234\t    pub fn next_wake_time(&self, current_time: Instant) -> u64 {\n2235\t        let now = current_time.ticks();\n2236\t        self.connections\n2237\t            .iter()\n2238\t            .map(|c| c.next_wake_time.ticks())\n2239\t            .min()\n2240\t            .unwrap_or(now)\n2241\t    }\n2242\t\n2243\t    /// Return the earliest connection that wakes before `wake_time`,\n2244\t    /// or `None` if none qualify.\n2245\t    /// C: `picoquic_get_earliest_cnx_to_wake`.\n2246\t    pub fn earliest_cnx_to_wake(&mut self, wake_time: Instant) -> Option<&mut Connection> {\n2247\t        let threshold = wake_time.ticks();\n2248\t        self.connections\n2249\t            .iter_mut()\n2250\t            .filter(|c| c.next_wake_time.ticks() <= threshold)\n2251\t            .min_by_key(|c| c.next_wake_time.ticks())\n2252\t    }\n2253\t\n2254\t    /// Borrow the connection currently advancing through its state\n2255\t    /// machine, if any (`get_cnx_in_progress` in C).\n2256\t    pub fn connection_in_progress(&mut self) -> Option<&mut Connection> {\n2257\t        let tok = self.connection_in_progress?;\n2258\t        self.connections.get_mut(tok)\n2259\t    }\n2260\t\n2261\t    /// Default PMTUD policy applied to new connections.\n2262\t    pub fn set_default_pmtud_policy(&mut self, pmtud_policy: PmtudPolicy) {\n2263\t        self.default_pmtud_policy = pmtud_policy;\n2264\t    }\n2265\t\n2266\t    /// Borrow the default stream callback installed on this context.\n2267\t    pub fn default_callback(&self) -> Option<&dyn StreamDataCallback> {\n2268\t        self.default_callback_fn.as_deref()\n2269\t    }\n2270\t}\n2271\t\n2272\t// ---------------------------------------------------------------------------\n2273\t// Packet I/O.\n2274\t\n2275\timpl Quic {\n2276\t    /// Submit a received packet to the QUIC context for dispatch.\n2277\t    /// `addr_from` and `addr_to` are borrowed for the duration of\n2278\t    /// the call; `received_ecn` carries the IP-level ECN code-point\n2279\t    /// byte.\n2280\t    #[allow(clippy::too_many_arguments)]\n2281\t    pub fn incoming_packet(\n2282\t        &mut self,\n2283\t        _bytes: &mut [u8],\n2284\t        _addr_from: &SocketAddr,\n2285\t        _addr_to: &SocketAddr,\n2286\t        _if_index_to: i32,\n2287\t        _received_ecn: u8,\n2288\t        _current_time: Instant,\n2289\t    ) -> Result<(), Error>