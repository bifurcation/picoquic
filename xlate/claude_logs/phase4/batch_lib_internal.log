`.\n5908\t    fn redirect(\n5909\t        &self,\n5910\t        mask_ctx: Option<&mut dyn Any>,\n5911\t        bytes: &[u8],\n5912\t        packet_length: usize,\n5913\t        addr_from: Option<&SocketAddr>,\n5914\t        consumed: &mut usize,\n5915\t    ) -> i32;\n5916\t}\n5917\t\n5918\t// ---------------------------------------------------------------------------\n5919\t// PacketHeader default constructor.\n5920\t\n5921\timpl Default for PacketHeader {\n5922\t    fn default() -> Self {\n5923\t        PacketHeader {\n5924\t            dest_connection_id: crate::ConnectionId::default(),\n5925\t            src_connection_id: crate::ConnectionId::default(),\n5926\t            packet_number_truncated: 0,\n5927\t            version: 0,\n5928\t            offset: 0,\n5929\t            packet_number_offset: 0,\n5930\t            packet_type: PacketType::Error,\n5931\t            packet_number_mask: 0,\n5932\t            packet_number_full: 0,\n5933\t            payload_length: 0,\n5934\t            version_index: -1,\n5935\t            epoch: Epoch::Initial,\n5936\t            packet_context: crate::PacketContext::Initial,\n5937\t            key_phase: false,\n5938\t            spin: false,\n5939\t            has_spin_bit: false,\n5940\t            has_reserved_bit_set: false,\n5941\t            has_loss_bits: false,\n5942\t            loss_bit_q: false,\n5943\t            loss_bit_l: false,\n5944\t            quic_bit_is_zero: false,\n5945\t            token_bytes: Vec::new(),\n5946\t            payload_length_value: 0,\n5947\t            local_connection_id: None,\n5948\t        }\n5949\t    }\n5950\t}\n5951\t\n5952\t// ---------------------------------------------------------------------------\n5953\t// Internal helpers for packet header encoding.\n5954\t\n5955\t/// Write a connection ID's bytes into `buf` and return the number of bytes written.\n5956\tfn write_cid(buf: &mut [u8], cid: crate::ConnectionId) -> usize {\n5957\t    let len = cid.len();\n5958\t    if buf.len() >= len {\n5959\t        buf[..len].copy_from_slice(cid.as_bytes());\n5960\t    }\n5961\t    len\n5962\t}\n5963\t\n5964\t/// Write `sequence_number` as `pn_l` big-endian bytes into `buf`.\n5965\tfn write_pn(buf: &mut [u8], sequence_number: u64, pn_l: usize) {\n5966\t    match pn_l {\n5967\t        1 => buf[0] = sequence_number as u8,\n5968\t        2 => {\n5969\t            let v = sequence_number as u16;\n5970\t            buf[0] = (v >> 8) as u8;\n5971\t            buf[1] = v as u8;\n5972\t        }\n5973\t        3 => {\n5974\t            let v = sequence_number as u32;\n5975\t            buf[0] = (v >> 16) as u8;\n5976\t            buf[1] = (v >> 8) as u8;\n5977\t            buf[2] = v as u8;\n5978\t        }\n5979\t        _ => {\n5980\t            let v = sequence_number as u32;\n5981\t            buf[0] = (v >> 24) as u8;\n5982\t            buf[1] = (v >> 16) as u8;\n5983\t            buf[2] = (v >> 8) as u8;\n5984\t            buf[3] = v as u8;\n5985\t        }\n5986\t    }\n5987\t}\n5988\t\n5989\t// ---------------------------------------------------------------------------\n5990\t// Index-based packet-header helpers (avoid borrow conflicts in tests).\n5991\t\n5992\timpl Connection {\n5993\t    /// Like [`predict_packet_header_length`] but selects the packet context by\n5994\t    /// enum value instead of taking a `&mut PacketContextState`.  This avoids the\n5995\t    /// split-borrow problem in tests that hold `&mut Connection` while computing\n5996\t    /// the header length.\n5997\t    pub fn predict_packet_header_length_for_pc(\n5998\t        &mut self,\n5999\t        packet_type: PacketType,\n6000\t        pc: PacketContext,\n6001\t    ) -> usize {\n6002\t        let pkt_ctx = &self.pkt_ctx[pc as usize];\n6003\t        let send_sequence = pkt_ctx.send_sequence;\n6004\t        let first_pending_seq = pkt_ctx.pending.keys().next().copied();\n6005\t\n6006\t        // Remote CID length: get from path 0, stash for path 0, first CID.\n6007\t        let remote_cid_len = self\n6008\t            .remote_connection_id_stashes\n6009\t            .first()\n6010\t            .and_then(|s| s.connection_ids.first())\n6011\t            .map(|r| r.connection_id.len())\n6012\t            .unwrap_or(8);\n6013\t\n6014\t        // Local CID length: get from path 0 tuple 0's local CID token.\n6015\t        let local_cid_len = self\n6016\t            .paths\n6017\t            .first()\n6018\t            .and_then(|p| p.tuples.first())\n6019\t            .and_then(|t| t.local_connection_id)\n6020\t            .and_then(|tok| self.local_connection_ids.get(tok))\n6021\t            .map(|l| l.connection_id.len())\n6022\t            .unwrap_or(self.local_cid_length as usize);\n6023\t\n6024\t        if packet_type == PacketType::OneRttProtected {\n6025\t            // Short header: 1 byte flags + remote CID + PN\n6026\t            let delta = if let Some(first) = first_pending_seq {\n6027\t                send_sequence.saturating_sub(first) as i64\n6028\t            } else {\n6029\t                send_sequence as i64\n6030\t            };\n6031\t            let pn_l = if delta >= 262144 {\n6032\t                4usize\n6033\t            } else if send_sequence >= 1024 {\n6034\t                3\n6035\t            } else if send_sequence >= 16 {\n6036\t                2\n6037\t            } else {\n6038\t                1\n6039\t            };\n6040\t            1 + remote_cid_len + pn_l\n6041\t        } else {\n6042\t            // Long header: 1 byte + 4 version + 2 CID lengths + dest CID + src CID + 2 payload len + 4 PN\n6043\t            let dest_cid_len = if self.client_mode\n6044\t                && (packet_type == PacketType::Initial\n6045\t                    || packet_type == PacketType::ZeroRttProtected)\n6046\t                && remote_cid_len == 0\n6047\t            {\n6048\t                self.initial_connection_id.len()\n6049\t            } else {\n6050\t                remote_cid_len\n6051\t            };\n6052\t\n6053\t            let mut header_length = 1 + 4 + 2 + dest_cid_len + local_cid_len + 2 + 4;\n6054\t\n6055\t            // Token length for initial packets.\n6056\t            if packet_type == PacketType::Initial {\n6057\t                let token_len = self.retry_token.len();\n6058\t                let vlen = encode_varint_length(token_len as u64);\n6059\t                header_length += vlen + token_len;\n6060\t            }\n6061\t\n6062\t            header_length\n6063\t        }\n6064\t    }\n6065\t\n6066\t    /// Like [`create_packet_header`] but addresses the path and tuple by index\n6067\t    /// instead of by `&mut` reference.  This avoids the split-borrow problem\n6068\t    /// that arises when the path and tuple live inside `&mut self`.\n6069\t    #[allow(clippy::too_many_arguments)]\n6070\t    pub fn create_packet_header_at(\n6071\t        &mut self,\n6072\t        packet_type: PacketType,\n6073\t        sequence_number: u64,\n6074\t        path_idx: usize,\n6075\t        _tuple_idx: usize,\n6076\t        header_length: usize,\n6077\t        bytes: &mut [u8],\n6078\t        pn_offset: &mut usize,"}]},"parent_tool_use_id":"toolu_01FNJRg8YhsoxF5PXikNyYX1","session_id":"6e30a456-15c0-4e3c-af27-9f4dab375915","uuid":"cdfcabec-bec0-4d04-93d0-215c352731ba","timestamp":"2026-05-05T22:12:16.031Z"}
