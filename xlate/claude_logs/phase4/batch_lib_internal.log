{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01K2UzZ3idx5qG3EFzhMSaZD","type":"tool_result","content":"1\t[package]\n2\tname = \"fq\"\n3\tversion = \"0.1.0\"\n4\tedition = \"2024\"\n5\t\n6\t[features]\n7\tdefault = []\n8\t# Each backend lives behind its own feature so a binary only pays\n9\t# for the implementations it actually links.  See `src/sys/`.\n10\tsys-picotls = []\n11\tsys-openssl = [\"dep:openssl\"]\n12\tsys-mbedtls = []\n13\tsys-fusion = []\n14\t\n15\t[dependencies]\n16\tfugit = { version = \"0.3\", default-features = false }\n17\trand = { version = \"0.9\", default-features = false }\n18\trand_core = { version = \"0.9\", default-features = false }\n19\t\n20\t# Rust Crypto trait crates (no implementations -- those come from\n21\t# the active TLS backend's crypto layer, except for header\n22\t# protection which we implement ourselves).\n23\taead = { version = \"0.5\", default-features = false }\n24\tcipher = { version = \"0.4\", default-features = false }\n25\tdigest = { version = \"0.10\", default-features = false }\n26\t\n27\t# Concrete cipher implementations used by header protection\n28\t# (QUIC packet-number encryption is QUIC logic, not TLS).\n29\taes = { version = \"0.8\", default-features = false }\n30\tchacha20 = { version = \"0.9\", default-features = false }\n31\t\n32\t# UDP socket abstraction.  std-only.\n33\tsocket2 = { version = \"0.5\", default-features = false, features = [\"all\"] }\n34\t\n35\t# Optional backend implementations (gated by `sys-*` features).\n36\topenssl = { version = \"0.10\", optional = true }\n37\t"}]},"parent_tool_use_id":"toolu_01FNJRg8YhsoxF5PXikNyYX1","session_id":"6e30a456-15c0-4e3c-af27-9f4dab375915","uuid":"c570809b-2e6e-4cdc-bef0-696f00d26856","timestamp":"2026-05-05T21:31:32.992Z"}
