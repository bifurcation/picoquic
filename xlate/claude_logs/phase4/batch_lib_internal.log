{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01JWkh3CTANVDRepTLGtqnTM","type":"tool_result","content":"350\t        })\n351\t    }\n352\t\n353\t    /// Construct a zero-filled connection id of length `len`.\n354\t    /// Returns `None` when `len` exceeds [`CONNECTION_ID_MAX_SIZE`].\n355\t    pub fn with_size(len: usize) -> Option<Self> {\n356\t        if len > CONNECTION_ID_MAX_SIZE {\n357\t            return None;\n358\t        }\n359\t        Some(Self {\n360\t            id: [0u8; CONNECTION_ID_MAX_SIZE],\n361\t            id_len: len as u8,\n362\t        })\n363\t    }\n364\t\n365\t    /// Borrow the live id bytes (`bytes[..len]`).\n366\t    pub fn as_bytes(&self) -> &[u8] {\n367\t        &self.id[..self.id_len as usize]\n368\t    }\n369\t\n370\t    /// Mutable borrow of the live id bytes.\n371\t    pub fn as_bytes_mut(&mut self) -> &mut [u8] {\n372\t        &mut self.id[..self.id_len as usize]\n373\t    }\n374\t\n375\t    /// Number of bytes in the id.\n376\t    pub fn len(&self) -> usize {\n377\t        self.id_len as usize\n378\t    }\n379\t\n380\t    /// `true` when the id has zero length.  Mirrors the C\n381\t    /// `is_connection_id_null` sentinel check.\n382\t    pub fn is_empty(&self) -> bool {\n383\t        self.id_len == 0\n384\t    }\n385\t\n386\t    /// Hash with a 16-byte seed.  C: `connection_id_hash`.\n387\t    pub fn hash_with_seed(&self, seed: &[u8; 16]) -> u64 {\n388\t        crate::siphash::siphash(seed, self.as_bytes())\n389\t    }\n390\t\n391\t    /// Fold the first up-to-8 bytes of the id into a `u64`.\n392\t    /// C: `val64_connection_id`.\n393\t    pub fn val64(&self) -> u64 {\n394\t        let bytes = self.as_bytes();\n395\t        let len = bytes.len().min(8);\n396\t        let mut buf = [0u8; 8];\n397\t        buf[..len].copy_from_slice(&bytes[..len]);\n398\t        u64::from_be_bytes(buf)\n399\t    }\n400\t}\n401\t\n402\t// ---------------------------------------------------------------------------\n403\t// IO vectors.\n404\t//\n405\t// The C `picoquic_iovec_t` (and the picotls-side `PtlsIovec*` that\n406\t// aliased it) are gone — every place that used to take an iovec\n407\t// pair now takes a `&[u8]` (single buffer) or `&[&[u8]]` /\n408\t// `Vec<Vec<u8>>` (list of buffers), per the project's\n409\t// \"use Rust's slice/vec types\" policy.\n410\t\n411\t// ---------------------------------------------------------------------------\n412\t// Opaque types (forward declarations).\n413\t//\n414\t// `Quic`, `Connection`, and `Path` are\n415\t// defined in `internal.h`.  Phase 1 declares them as empty\n416\t// structs so callers can refer to them; the real layout lands when\n417\t// the internal header is translated.  The `_opaque` field prevents\n418\t// callers from constructing one accidentally, and the `Debug` impl\n419\t// gives the structs a printable shape for log lines.\n420\t\n421\t// Full bodies live in `crate::internal`; pull them in for use within\n422\t// this module's signatures (no re-export — callers reach them as\n423\t// `crate::internal::*`).\n424\tuse crate::internal::{Connection, Path, Quic};\n425\t\n426\t// ---------------------------------------------------------------------------\n427\t// Application callback events.\n428\t\n429\t/// Event type passed to the application's stream / connection\n430\t/// callback (see [`StreamDataCallback`]).  Identifies which sort of\n431\t/// notification the stack is delivering — stream data, lifecycle\n432\t/// transition, datagram event, path event, etc.\n433\t#[derive(Debug, Copy, Clone, PartialEq, Eq)]\n434\tpub enum CallbackEvent {\n435\t    StreamData = 0,\n436\t    StreamFin,\n437\t    StreamReset,\n438\t    StopSending,\n439\t    StatelessReset,\n440\t    Close,\n441\t    ApplicationClose,\n442\t    StreamGap,\n443\t    PrepareToSend,\n444\t    AlmostReady,\n445\t    Ready,\n446\t    Datagram,\n447\t    VersionNegotiation,\n448\t    RequestAlpnList,\n449\t    SetAlpn,\n450\t    PacingChanged,\n451\t    PrepareDatagram,\n452\t    DatagramAcked,\n453\t    DatagramLost,\n454\t    DatagramSpurious,\n455\t    PathAvailable,\n456\t    PathSuspended,\n457\t    PathDeleted,\n458\t    PathQualityChanged,\n459\t    PathAddressObserved,\n460\t    AppWakeup,\n461\t    NextPathAllowed,\n462\t}\n463\t\n464\t// Transport-parameter shapes live in [`crate::tp`].\n465\t\n466\t// Stream-id decomposition lives on [`crate::stream::StreamId`].\n467\t\n468\t// ---------------------------------------------------------------------------\n469\t// Time management.\n470\t\n471\t/// Wall-clock microseconds since the Unix epoch.\n472\t///\n473\t/// The C body reads the OS clock; in Rust this requires the `std`\n474\t/// feature (`std::time::SystemTime`).  The `cfg`-gated split lands\n475\t/// when the crate gains its `std` feature and the rest of the\n476\t/// `no_std + alloc` plumbing — for Phase 1 the function is just a\n477\t/// `todo!()` stub.\n478\tpub fn current_time() -> u64 {\n479\t    use std::time::{SystemTime, UNIX_EPOCH};\n480\t    SystemTime::now()\n481\t        .duration_since(UNIX_EPOCH)\n482\t        .map(|d| d.as_micros() as u64)\n483\t        .unwrap_or(0)\n484\t}\n485\t\n486\timpl Quic {\n487\t    /// Virtual time used by this QUIC context (wall-clock or\n488\t    /// simulated, depending on whether a simulated-time pointer was\n489\t    /// supplied at creation).  C: `get_quic_time`.\n490\t    pub fn time(&self) -> u64 {\n491\t        current_time()\n492\t    }\n493\t}\n494\t\n495\t// ---------------------------------------------------------------------------\n496\t// Application callbacks (function-pointer typedefs → traits).\n497\t\n498\t/// Stream/event callback installed on a QUIC context or connection.\n499\t/// Folds the C `void* callback_ctx` into the trait implementor's\n500\t/// state; `stream_ctx` is per-stream and remains a raw pointer\n501\t/// because it is produced and consumed by the application without\n502\t/// the stack interpreting it.\n503\t///\n504\t/// Returns the C `int` directly: `0` for success, or one of the\n505\t/// `_*` codes (e.g. `STREAM_RECEIVE_COMPLETE`) for\n506\t/// special signalling.  Phase 3 may refine to `Result` once the\n507\t/// crate-level error type lands.\n508\t///\n509\t/// `bytes` is `&[u8]` rather than `*const u8 + size_t`; events that\n510\t/// carry no payload pass `&[]`.\n511\tpub trait StreamDataCallback {\n512\t    fn callback(\n513\t        &mut self,\n514\t        connection: &mut Connection,\n515\t        stream_id: u64,\n516\t        bytes: &[u8],\n517\t        fin_or_event: CallbackEvent,\n518\t        stream_ctx: Option<&mut dyn core::any::Any>,\n519\t    ) -> i32;\n520\t}\n521\t\n522\t/// ALPN-selection callback.  Returns the index of the chosen ALPN\n523\t/// in `list`, or any value `>= list.len()` to signal \"none of the\n524\t/// proposed ALPNs is supported\".  C: `AlpnSelect` (the C `_v2`\n525\t/// flavour is folded in — it only differed in the iovec type, which\n526\t/// is now just `&[u8]`).\n527\t/// Application hook the TLS backend invokes to choose one of the\n528\t/// client's proposed ALPN values.  Returns the chosen index into\n529\t/// `list`, or `None` to reject the handshake.\n530\t///\n531\t/// `list` carries the raw bytes off the wire; mapping to the\n532\t/// strongly-typed [`Alpn`] enum is up to the implementor (most\n533\t/// applications keep a small whitelist by string identifier).\n534\tpub trait AlpnSelect {\n535\t    fn select(&mut self, quic: &mut Quic, list: &[&[u8]]) -> Option<usize>;\n536\t}\n537\t\n538\t/// Callback that produces a server-environment-compatible CID.\n539\t/// Folds the C `void* connection_id_cb_data` into the implementor's state.\n540\t/// C: `ConnectionIdCallback`.\n541\tpub trait ConnectionIdCallback {\n542\t    fn produce(\n543\t        &mut self,\n544\t        quic: &mut Quic,\n545\t        connection_id_local: ConnectionId,\n546\t        connection_id_remote: ConnectionId,\n547\t    ) -> ConnectionId;\n548\t}\n549\t"}]},"parent_tool_use_id":"toolu_01FNJRg8YhsoxF5PXikNyYX1","session_id":"6e30a456-15c0-4e3c-af27-9f4dab375915","uuid":"4e1fa0af-0186-42ec-9062-1118bb32fef3","timestamp":"2026-05-05T21:19:56.580Z"}
