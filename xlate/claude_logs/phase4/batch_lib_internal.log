{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01KaUsjND3BxD6g9mRecqVrb","type":"tool_result","content":"400\t\n401\t/// Spin-bit policy dispatch table.  Replaces `extern SpinbitDef\n402\t/// spin_function_table[]` from the C source.  Each row is a\n403\t/// `&'static dyn` to a stateless policy implementor; the wrapper\n404\t/// `SpinbitDef` struct from C is gone (the trait object carries\n405\t/// the same information).\n406\t///\n407\t/// Indices match [`crate::SpinbitVersion`] values:\n408\t/// * 0 = Basic\n409\t/// * 1 = Random\n410\t/// * 2 = Null\n411\t/// * 3 = On (test-only, server side)\n412\t///\n413\t/// The concrete policy types and the populated table land in\n414\t/// `crate::spinbit` (Phase 4).\n415\tpub static SPIN_FUNCTION_TABLE: &[&dyn SpinBitPolicy] = &[];\n416\t\n417\t// ---------------------------------------------------------------------------\n418\t// Stateless packet, queued at the QUIC context until sendable.\n419\t\n420\tpub struct StatelessPacket {\n421\t    pub addr_to: SocketAddr,\n422\t    pub addr_local: SocketAddr,\n423\t    pub if_index_local: i32,\n424\t    pub received_ecn: u8,\n425\t    pub length: usize,\n426\t    pub receive_time: Instant,\n427\t    pub connection_id_log64: u64,\n428\t    pub initial_connection_id: ConnectionId,\n429\t    pub packet_type: PacketType,\n430\t    pub bytes: [u8; MAX_PACKET_SIZE],\n431\t}\n432\t\n433\timpl Quic {\n434\t    /// Allocate a fresh stateless-packet buffer.  C:\n435\t    /// `create_stateless_packet` plus the per-context pool;\n436\t    /// `Quic.connections.alloc()`-style — Rust uses normal heap\n437\t    /// allocation and lets `Drop` free.\n438\t    pub fn create_stateless_packet(&mut self) -> Result<StatelessPacket, crate::Error> {\n439\t        use core::net::{IpAddr, Ipv4Addr};\n440\t        Ok(StatelessPacket {\n441\t            addr_to: core::net::SocketAddr::new(IpAddr::V4(Ipv4Addr::UNSPECIFIED), 0),\n442\t            addr_local: core::net::SocketAddr::new(IpAddr::V4(Ipv4Addr::UNSPECIFIED), 0),\n443\t            if_index_local: 0,\n444\t            received_ecn: 0,\n445\t            length: 0,\n446\t            receive_time: crate::Instant::from_ticks(0),\n447\t            connection_id_log64: 0,\n448\t            initial_connection_id: crate::ConnectionId::default(),\n449\t            packet_type: crate::internal::PacketType::Error,\n450\t            bytes: [0u8; crate::MAX_PACKET_SIZE],\n451\t        })\n452\t    }\n453\t\n454\t    /// Hand `sp` to the QUIC context's pending stateless-packet\n455\t    /// queue.  C: `queue_stateless_packet`.\n456\t    pub fn queue_stateless_packet(&mut self, sp: StatelessPacket) {\n457\t        self.pending_stateless_packets.push_back(sp);\n458\t    }\n459\t\n460\t    /// Pop the next pending stateless packet.  Returns `None` when\n461\t    /// the queue is empty.  C: `dequeue_stateless_packet`.\n462\t    pub fn dequeue_stateless_packet(&mut self) -> Option<StatelessPacket> {\n463\t        self.pending_stateless_packets.pop_front()\n464\t    }\n465\t}\n466\t\n467\t// `delete_stateless_packet` is gone -- StatelessPacket falls out\n468\t// of scope (the VecDeque drains it); `Drop` does the C `free`.\n469\t\n470\t// ---------------------------------------------------------------------------\n471\t// Stream data nodes (received) and queue nodes (queued for send).\n472\t\n473\tpub struct StreamDataNode {\n474\t    /// Membership in the parent stream's `stream_data_tree`.\n475\t    /// `Some(token)` while in the tree; `None` otherwise.  Phase 4\n476\t    /// uses this for O(1) removal.\n477\t    pub stream_data_membership: Option<SplayToken>,\n478\t    pub offset: u64,\n479\t    /// Inline buffer of payload bytes.  C kept a parallel\n480\t    /// `bytes: *const u8` aliasing into `data` plus a `length`\n481\t    /// field; in Rust the slice subsumes both — `data[..len]` is\n482\t    /// the live payload and `len` is `length`.\n483\t    pub data: [u8; MAX_PACKET_SIZE],\n484\t    pub length: usize,\n485\t}\n486\t\n487\tpub struct StreamQueueNode {\n488\t    pub offset: u64,\n489\t    /// Owned send-queue payload.  C: `bytes: *mut u8` plus paired\n490\t    /// `length: size_t`; both collapse into the vector.\n491\t    pub bytes: Vec<u8>,\n492\t}\n493\t\n494\t// ---------------------------------------------------------------------------\n495\t// Sent packet (kept on retransmit queues until acked).\n496\t\n497\tpub struct Packet {\n498\t    /// Membership in the owning connection's\n499\t    /// `queue_data_repeat_tree`.  Phase 4 uses this for O(1) removal.\n500\t    pub queue_data_repeat_membership: Option<SplayToken>,\n501\t    /// Path the packet was sent on.  C: `*mut Path` back-pointer.\n502\t    pub send_path: Option<PathToken>,\n503\t    pub sequence_number: u64,\n504\t    pub send_time: Instant,\n505\t    pub delivered_prior: u64,\n506\t    pub delivered_time_prior: Instant,\n507\t    pub delivered_sent_prior: u64,\n508\t    pub lost_prior: u64,\n509\t    pub inflight_prior: u64,\n510\t    pub data_repeat_frame: usize,\n511\t    pub data_repeat_index: usize,\n512\t\n513\t    pub data_repeat_priority: u64,\n514\t    pub data_repeat_stream_id: u64,\n515\t    pub data_repeat_stream_offset: u64,\n516\t    pub data_repeat_stream_data_length: usize,\n517\t\n518\t    pub length: usize,\n519\t    pub checksum_overhead: usize,\n520\t    pub offset: usize,\n521\t    pub packet_type: PacketType,\n522\t    pub packet_context: PacketContext,\n523\t\n524\t    pub is_evaluated: bool,\n525\t    pub is_ack_eliciting: bool,\n526\t    pub is_mtu_probe: bool,\n527\t    pub is_multipath_probe: bool,\n528\t    pub is_ack_trap: bool,\n529\t    pub delivered_app_limited: bool,\n530\t    pub sent_cwin_limited: bool,\n531\t    pub is_preemptive_repeat: bool,\n532\t    pub was_preemptively_repeated: bool,\n533\t    pub is_queued_to_path: bool,\n534\t    pub is_queued_for_retransmit: bool,\n535\t    pub is_queued_for_spurious_detection: bool,\n536\t    pub is_queued_for_data_repeat: bool,\n537\t\n538\t    pub bytes: [u8; MAX_PACKET_SIZE],\n539\t}\n540\t\n541\timpl Quic {\n542\t    /// Allocate a fresh outbound packet buffer.  C: `create_packet`\n543\t    /// plus the per-context pool; the Rust port lets the allocator\n544\t    /// handle reuse.  `Drop` replaces `recycle_packet`.\n545\t    pub fn create_packet(&mut self) -> Result<Packet, crate::Error> {\n546\t        self.nb_packets_allocated += 1;\n547\t        Ok(Packet {\n548\t            queue_data_repeat_membership: None,\n549\t            send_path: None,\n550\t            sequence_number: 0,\n551\t            send_time: crate::Instant::from_ticks(0),\n552\t            delivered_prior: 0,\n553\t            delivered_time_prior: crate::Instant::from_ticks(0),\n554\t            delivered_sent_prior: 0,\n555\t            lost_prior: 0,\n556\t            inflight_prior: 0,\n557\t            data_repeat_frame: 0,\n558\t            data_repeat_index: 0,\n559\t            data_repeat_priority: 0,\n560\t            data_repeat_stream_id: 0,\n561\t            data_repeat_stream_offset: 0,\n562\t            data_repeat_stream_data_length: 0,\n563\t            length: 0,\n564\t            checksum_overhead: 0,\n565\t            offset: 0,\n566\t            packet_type: PacketType::Error,\n567\t            packet_context: crate::PacketContext::Application,\n568\t            is_evaluated: false,\n569\t            is_ack_eliciting: false,\n570\t            is_mtu_probe: false,\n571\t            is_multipath_probe: false,\n572\t            is_ack_trap: false,\n573\t            delivered_app_limited: false,\n574\t            sent_cwin_limited: false,\n575\t            is_preemptive_repeat: false,\n576\t            was_preemptively_repeated: false,\n577\t            is_queued_to_path: false,\n578\t            is_queued_for_retransmit: false,\n579\t            is_queued_for_spurious_detection: false,\n580\t            is_queued_for_data_repeat: false,\n581\t            bytes: [0u8; MAX_PACKET_SIZE],\n582\t        })\n583\t    }\n584\t}\n585\t\n586\timpl Connection {\n587\t    /// Pad `bytes[length..]` up to whatever the connection's padding\n588\t    /// policy mandates (or up to `max_length`, whichever is smaller).\n589\t    /// Returns the new buffered length.\n590\t    pub fn pad_to_policy(&mut self, bytes: &mut [u8], length: usize, max_length: u32) -> usize {\n591\t        let mut target = self.padding_minsize as usize;\n592\t        if length > target && self.padding_multiple != 0 {\n593\t            let delta = (length - target) % self.padding_multiple as usize;\n594\t            if delta == 0 {\n595\t                target = length;\n596\t            } else {\n597\t                target = length + self.padding_multiple as usize - delta;\n598\t            }\n599\t        }"}]},"parent_tool_use_id":"toolu_01FNJRg8YhsoxF5PXikNyYX1","session_id":"6e30a456-15c0-4e3c-af27-9f4dab375915","uuid":"843e3f27-f9d5-4252-9c03-25e77e7ff049","timestamp":"2026-05-05T21:20:00.074Z"}
