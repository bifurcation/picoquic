{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01C31MfZb7arTmjsHHmKWcFL","type":"tool_result","content":"236\tpub enum Version {\n237\t    SeventeenthInterop = 0xFF00001B,\n238\t    EighteenthInterop = 0xFF00001C,\n239\t    NineteenthInterop = 0xFF00001D,\n240\t    NineteenthBisInterop = 0xFF00001E,\n241\t    TwentiethPreInterop = 0xFF00001F,\n242\t    TwentiethInterop = 0xFF000020,\n243\t    TwentyFirstInterop = 0xFF000021,\n244\t    PostIesg = 0xFF000022,\n245\t    V1 = 0x00000001,\n246\t    V2 = 0x6b3343cf,\n247\t    V2Draft = 0x709a50c4,\n248\t    InternalTest1 = 0x50435130,\n249\t    InternalTest2 = 0x50435131,\n250\t}\n251\t\n252\t/// First entry in `Version`'s declaration order — the canonical\n253\t/// interop version reported by `INTEROP_VERSION_LATEST` in C.\n254\tpub const INTEROP_VERSION_LATEST: Version = Version::NineteenthInterop;\n255\t\n256\timpl Version {\n257\t    /// Resolve `proposed` to a known [`Version`] (RFC 9000 §15\n258\t    /// \"Versions\").  C: `get_version_index`.\n259\t    pub fn try_from_wire(proposed: u32) -> Option<Self> {\n260\t        // SKIP: try_from_wire: version table requires static crypto byte arrays not yet wired up;\n261\t        // returning None for all until Version::parameters is implemented\n262\t        match proposed {\n263\t            0x00000001 => Some(Version::V1),\n264\t            0x6b3343cf => Some(Version::V2),\n265\t            0x709a50c4 => Some(Version::V2Draft),\n266\t            0xFF00001B => Some(Version::SeventeenthInterop),\n267\t            0xFF00001C => Some(Version::EighteenthInterop),\n268\t            0xFF00001D => Some(Version::NineteenthInterop),\n269\t            0xFF00001E => Some(Version::NineteenthBisInterop),\n270\t            0xFF00001F => Some(Version::TwentiethPreInterop),\n271\t            0xFF000020 => Some(Version::TwentiethInterop),\n272\t            0xFF000021 => Some(Version::TwentyFirstInterop),\n273\t            0xFF000022 => Some(Version::PostIesg),\n274\t            0x50435130 => Some(Version::InternalTest1),\n275\t            0x50435131 => Some(Version::InternalTest2),\n276\t            _ => None,\n277\t        }\n278\t    }\n279\t\n280\t    /// Per-version cryptographic and label parameters.  C:\n281\t    /// `picoquic_supported_versions[]`'s row for this version.\n282\t    pub fn parameters(self) -> VersionParameters {\n283\t        // SKIP: parameters: requires static crypto byte slices from C tables not yet ported\n284\t        // Returning a placeholder V1 parameters for now\n285\t        VersionParameters {\n286\t            version: self,\n287\t            version_aead_key: &[],\n288\t            version_retry_key: &[],\n289\t            tls_prefix_label: \"tls13 quic \",\n290\t            tls_traffic_update_label: \"quic ku\",\n291\t            packet_type_version: self as u32,\n292\t            upgrade_from: &[],\n293\t        }\n294\t    }\n295\t}\n296\t\n297\t/// Per-version cryptographic and label parameters.  C:\n298\t/// `VersionParameters`.\n299\t///\n300\t/// `version_aead_key` and `version_retry_key` are static byte\n301\t/// tables in the C source — Rust models them as borrowed slices.\n302\t/// `upgrade_from` is a `NULL`-terminated list in C; here it is a\n303\t/// borrowed slice, with an empty slice for \"no upgrade path\".\n304\t#[derive(Debug)]\n305\tpub struct VersionParameters {\n306\t    pub version: Version,\n307\t    pub version_aead_key: &'static [u8],\n308\t    pub version_retry_key: &'static [u8],\n309\t    pub tls_prefix_label: &'static str,\n310\t    pub tls_traffic_update_label: &'static str,\n311\t    pub packet_type_version: u32,\n312\t    pub upgrade_from: &'static [Version],\n313\t}\n314\t\n315\t// ---------------------------------------------------------------------------"}]},"parent_tool_use_id":"toolu_01FNJRg8YhsoxF5PXikNyYX1","session_id":"6e30a456-15c0-4e3c-af27-9f4dab375915","uuid":"cf03c1b2-b87f-43dd-8b2b-e253b54ee686","timestamp":"2026-05-05T21:57:12.672Z"}
