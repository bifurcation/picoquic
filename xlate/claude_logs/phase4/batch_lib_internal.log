{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01RUKegDijvmZEGcHSdu6o1P","type":"tool_result","content":"866\timpl Quic {\n867\t    /// Server-side: record metadata for a session ticket we just\n868\t    /// issued, so we can recognize a resumption attempt later.\n869\t    pub fn remember_issued_ticket(\n870\t        &mut self,\n871\t        ticket_id: u64,\n872\t        rtt: Duration,\n873\t        cwin: u64,\n874\t        ip_addr: core::net::IpAddr,\n875\t    ) -> Result<(), crate::Error> {\n876\t        let ticket = IssuedTicket {\n877\t            issued_tickets_membership: None,\n878\t            ticket_id,\n879\t            creation_time: crate::Instant::from_ticks(0),\n880\t            rtt,\n881\t            cwin,\n882\t            ip_addr,\n883\t        };\n884\t        let tok = self.issued_tickets.insert(ticket)?;\n885\t        let (htok, _) = self.issued_tickets_by_id.insert(ticket_id, tok)?;\n886\t        // Store the hash token back into the ticket so we can do O(1) removal later.\n887\t        if let Some(entry) = self.issued_tickets.get_mut(tok) {\n888\t            entry.issued_tickets_membership = Some(htok);\n889\t        }\n890\t        Ok(())\n891\t    }\n892\t\n893\t    /// Look up a previously-remembered issued ticket by id.\n894\t    /// Returns `None` when no such ticket is on file.\n895\t    pub fn retrieve_issued_ticket(&mut self, ticket_id: u64) -> Option<&mut IssuedTicket> {\n896\t        let htok = self.issued_tickets_by_id.lookup(&ticket_id)?;\n897\t        let tok = *self.issued_tickets_by_id.get(htok)?;\n898\t        self.issued_tickets.get_mut(tok)\n899\t    }\n900\t}\n901\t\n902\t// ---------------------------------------------------------------------------\n903\t// Auto-qlog and performance log callbacks (function pointers → traits).\n904\t\n905\t/// C: `autoqlog_fn` — invoked at end of connection to\n906\t/// turn the binlog into a qlog file.  Returns 0 on success, an\n907\t/// errno-style negative on failure.  The callback only reads\n908\t/// connection state, so the borrow is shared.\n909\tpub trait AutoQlog {\n910\t    fn run(&mut self, connection: &Connection) -> i32;\n911\t}\n912\t\n913\t/// C: `performance_log_fn` — emit a per-connection\n914\t/// performance log row.  `should_delete` is `true` on connection\n915\t/// teardown.  Callback is read-only over `quic` / `connection`.\n916\tpub trait PerformanceLog {\n917\t    fn emit(&mut self, quic: &Quic, connection: &Connection, should_delete: bool) -> i32;\n918\t}\n919\t\n920\t// ---------------------------------------------------------------------------\n921\t// Memlog hook (per-connection memory-log callback on `Connection`).\n922\t\n923\t/// C: `void (*memlog_call_back)(Connection*, Path*,\n924\t/// void* v_memlog, int op_code, uint64_t current_time)` field on\n925\t/// `Connection`.  Read-only over `connection`; the path may\n926\t/// mutate (the C body updates per-path counters).\n927\tpub trait MemLogHook {\n928\t    fn callback(\n929\t        &mut self,\n930\t        connection: &Connection,\n931\t        path: &mut Path,\n932\t        op_code: i32,\n933\t        current_time: Instant,\n934\t    );\n935\t}\n936\t\n937\t// ---------------------------------------------------------------------------\n938\t// QUIC context.\n939\t\n940\t/// Top-level QUIC context.  C: `Quic`.  Single-threaded\n941\t/// scope (per the translation plan): no `Send`/`Sync`.\n942\tpub struct Quic {\n943\t    /// Client-side TLS configuration (set when this `Quic` is\n944\t    /// being used to make outbound connections).  Replaces the C\n945\t    /// `tls_master_ctx` opaque handle for the client role.\n946\t    pub tls_client_config: Option<Box<dyn crate::tls::DynClientConfig>>,\n947\t    /// Server-side TLS configuration (set when this `Quic` is\n948\t    /// being used to accept inbound connections).\n949\t    pub tls_server_config: Option<Box<dyn crate::tls::DynServerConfig>>,\n950\t    /// Application-supplied TLS callbacks (ALPN selection, ticket\n951\t    /// store, certificate verification).  Replaces the C-style\n952\t    /// `register_*` global function-pointer registry.\n953\t    pub tls_callbacks: Option<Box<dyn crate::tls::TlsCallbacks>>,\n954\t    pub default_callback_fn: Option<Box<dyn StreamDataCallback>>,\n955\t    /// Application-supplied state forwarded to the default\n956\t    /// stream-data callback.  Opaque to the library (the C side\n957\t    /// passed it through as `void*`).  Phase 4 may push the state\n958\t    /// into the `StreamDataCallback` impl itself, at which point this\n959\t    /// field disappears.\n960\t    pub default_callback_ctx: Option<Box<dyn Any>>,\n961\t    /// State for the DCID-mask callbacks; opaque to the library.\n962\t    pub mask_ctx: Option<Box<dyn Any>>,\n963\t    pub mask_fns: Option<Box<dyn MaskOps>>,\n964\t    pub default_alpn: Option<String>,\n965\t    pub alpn_select_fn: Option<Box<dyn AlpnSelect>>,"}]},"parent_tool_use_id":"toolu_01FNJRg8YhsoxF5PXikNyYX1","session_id":"6e30a456-15c0-4e3c-af27-9f4dab375915","uuid":"eca1a870-0464-4796-9134-7253f7377644","timestamp":"2026-05-05T21:28:20.975Z"}
