{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_014hicmXGWAj62bLw5JpCQEL","type":"tool_result","content":"4236\t        /* Initialize the ACK behavior. By default, picoquic abides with the recommendation to send\n4237\t         * ACK immediately if packets are received out of order (ack_ignore_order_remote = 0),\n4238\t         * but this behavior creates too many ACKS on high speed links, so picoquic will request\n4239\t         * the peer to not do that if the \"delayed ACK\" extension is available (ack_ignore_order_local = 1)\n4240\t         */\n4241\t        cnx->ack_ignore_order_local = 1;\n4242\t        cnx->ack_ignore_order_remote = 0;\n4243\t\n4244\t        cnx->latest_progress_time = start_time;\n4245\t        cnx->latest_receive_time = start_time;\n4246\t\n4247\t        for (int epoch = 0; epoch < PICOQUIC_NUMBER_OF_EPOCHS; epoch++) {\n4248\t            cnx->tls_stream[epoch].stream_id = 0;\n4249\t            cnx->tls_stream[epoch].consumed_offset = 0;\n4250\t            cnx->tls_stream[epoch].fin_offset = 0;\n4251\t            cnx->tls_stream[epoch].stream_node.left = NULL;\n4252\t            cnx->tls_stream[epoch].stream_node.parent = NULL;\n4253\t            cnx->tls_stream[epoch].stream_node.right = NULL;\n4254\t            cnx->tls_stream[epoch].sent_offset = 0;\n4255\t            cnx->tls_stream[epoch].local_error = 0;\n4256\t            cnx->tls_stream[epoch].remote_error = 0;\n4257\t            cnx->tls_stream[epoch].maxdata_local = UINT64_MAX;\n4258\t            cnx->tls_stream[epoch].maxdata_remote = UINT64_MAX;\n4259\t\n4260\t            picosplay_init_tree(&cnx->tls_stream[epoch].stream_data_tree, picoquic_stream_data_node_compare, picoquic_stream_data_node_create, picoquic_stream_data_node_delete, picoquic_stream_data_node_value);\n4261\t            picoquic_sack_list_init(&cnx->tls_stream[epoch].sack_list);\n4262\t            /* No need to reset the state flags, as they are not used for the crypto stream */\n4263\t        }\n4264\t        \n4265\t        cnx->ack_frequency_sequence_local = UINT64_MAX;\n4266\t        cnx->ack_gap_local = 2;\n4267\t        cnx->ack_frequency_delay_local = PICOQUIC_ACK_DELAY_MAX_DEFAULT;\n4268\t        cnx->ack_frequency_sequence_remote = UINT64_MAX;\n4269\t        cnx->ack_gap_remote = 2;\n4270\t        cnx->ack_delay_remote = PICOQUIC_ACK_DELAY_MIN;\n4271\t        cnx->max_ack_delay_remote = cnx->ack_delay_remote;\n4272\t        cnx->max_ack_gap_remote = cnx->ack_gap_remote;\n4273\t        cnx->max_ack_delay_local = cnx->ack_frequency_delay_local;\n4274\t        cnx->max_ack_gap_local = cnx->ack_gap_local;\n4275\t        cnx->min_ack_delay_remote = cnx->ack_delay_remote;\n4276\t        cnx->min_ack_delay_local = cnx->ack_frequency_delay_local;\n4277\t\n4278\t\n4279\t        picosplay_init_tree(&cnx->stream_tree, picoquic_stream_node_compare, picoquic_stream_node_create, picoquic_stream_node_delete, picoquic_stream_node_value);\n4280\t\n4281\t        cnx->congestion_alg = cnx->quic->default_congestion_alg;\n4282\t        cnx->congestion_alg_option_string = cnx->quic->default_congestion_alg_option_string;\n4283\t        if (cnx->congestion_alg != NULL) {\n4284\t            cnx->congestion_alg->alg_init(cnx->path[0], cnx->congestion_alg_option_string, start_time);\n4285\t        }\n4286\t    }\n4287\t\n4288\t    /* Only initialize TLS after all parameters have been set */\n4289\t    if (cnx != NULL && picoquic_tlscontext_create(quic, cnx) != 0) {\n4290\t        /* Cannot just do partial creation! */\n4291\t        picoquic_delete_cnx(cnx);\n4292\t        cnx = NULL;\n4293\t    }\n4294\t\n4295\t    if (cnx != NULL) {\n4296\t        if (initial_aead_dec != NULL && initial_pn_dec != NULL) {\n4297\t            cnx->crypto_context[picoquic_epoch_initial].aead_decrypt = initial_aead_dec;\n4298\t            cnx->crypto_context[picoquic_epoch_initial].pn_dec = initial_pn_dec;\n4299\t            if (picoquic_get_initial_aead_context(quic, cnx->version_index,