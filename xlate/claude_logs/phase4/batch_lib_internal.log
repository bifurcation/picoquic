{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01SkSCPABCJD7Xca66zFWxsf","type":"tool_result","content":"3504\tvoid picoquic_insert_output_stream(picoquic_cnx_t* cnx, picoquic_stream_head_t* stream)\n3505\t{\n3506\t    if (stream->is_output_stream == 0)  \n3507\t    {\n3508\t        if (IS_CLIENT_STREAM_ID(stream->stream_id) == cnx->client_mode) {\n3509\t            if (stream->stream_id > ((IS_BIDIR_STREAM_ID(stream->stream_id)) ? cnx->max_stream_id_bidir_remote : cnx->max_stream_id_unidir_remote)) {\n3510\t                return;\n3511\t            }\n3512\t        }\n3513\t\n3514\t        if (cnx->last_output_stream == NULL) {\n3515\t            /* insert first stream */\n3516\t            cnx->last_output_stream = stream;\n3517\t            cnx->first_output_stream = stream;\n3518\t        }\n3519\t        else if (picoquic_compare_stream_priority(stream, cnx->last_output_stream) >= 0) {\n3520\t            /* insert after last stream. Common case for most applications. */\n3521\t            stream->previous_output_stream = cnx->last_output_stream;\n3522\t            cnx->last_output_stream->next_output_stream = stream;\n3523\t            cnx->last_output_stream = stream;\n3524\t        }\n3525\t        else {\n3526\t            picoquic_stream_head_t* current = cnx->first_output_stream;\n3527\t\n3528\t            while (current != NULL) {\n3529\t                int cmp = picoquic_compare_stream_priority(stream, current);\n3530\t\n3531\t                if (cmp < 0) {\n3532\t                    /* insert before the current stream, then break */\n3533\t                    stream->previous_output_stream = current->previous_output_stream;\n3534\t                    if (stream->previous_output_stream == NULL) {\n3535\t                        cnx->first_output_stream = stream;\n3536\t                    }\n3537\t                    else {\n3538\t                        stream->previous_output_stream->next_output_stream = stream;\n3539\t                    }\n3540\t                    current->previous_output_stream = stream;\n3541\t                    stream->next_output_stream = current;\n3542\t                    break;\n3543\t                }\n3544\t                else if (cmp == 0) {\n3545\t                    /* Stream is already there. This is unexpected */\n3546\t                    break;\n3547\t                }\n3548\t                else {\n3549\t                    current = current->next_output_stream;\n3550\t                }\n3551\t            }\n3552\t            if (current == NULL) {\n3553\t                /* insert after last stream */\n3554\t                stream->previous_output_stream = cnx->last_output_stream;\n3555\t                cnx->last_output_stream->next_output_stream = stream;\n3556\t                cnx->last_output_stream = stream;\n3557\t            }\n3558\t        }\n3559\t\n3560\t        stream->is_output_stream = 1;\n3561\t    }\n3562\t}\n3563\t\n3564\tvoid picoquic_remove_output_stream(picoquic_cnx_t* cnx, picoquic_stream_head_t * stream)\n3565\t{\n3566\t    if (stream->is_output_stream) {\n3567\t        stream->is_output_stream = 0;\n3568\t\n3569\t        if (stream->previous_output_stream == NULL) {\n3570\t            cnx->first_output_stream = stream->next_output_stream;\n3571\t        }\n3572\t        else {\n3573\t            stream->previous_output_stream->next_output_stream = stream->next_output_stream;\n3574\t        }\n3575\t\n3576\t        if (stream->next_output_stream == NULL) {\n3577\t            cnx->last_output_stream = stream->previous_output_stream;\n3578\t        }\n3579\t        else {\n3580\t            stream->next_output_stream->previous_output_stream = stream->previous_output_stream;\n3581\t        }\n3582\t        stream->previous_output_stream = NULL;\n3583\t        stream->next_output_stream = NULL;\n3584\t    }\n3585\t}\n3586\t\n3587\t/* Reorder streams by priorities and rank.\n3588\t * A stream is deemed out of order if:\n3589\t * - th