{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01EFHQWRh5HRa13uCWHbwGA8","type":"tool_result","content":"315\t// Connection ID.\n316\t\n317\tpub const CONNECTION_ID_MIN_SIZE: usize = 0;\n318\tpub const CONNECTION_ID_MAX_SIZE: usize = 20;\n319\t\n320\t/// Fixed-capacity QUIC connection ID.  C: `ConnectionId`.\n321\t///\n322\t/// Stored as a 20-byte buffer plus a length so the type is `Copy`,\n323\t/// matching the C usage where connection IDs are passed by value\n324\t/// in many APIs (`get_local_connection_id`, `create_connection`,\n325\t/// …).  Fields are private — construct via [`Self::clone_from_slice`]\n326\t/// or [`Self::with_size`] and read via [`Self::as_bytes`].\n327\t///\n328\t/// `Ord` is derived as lexicographic over the live bytes (matching\n329\t/// the C `compare_connection_id` shape: per-byte compare under\n330\t/// `min(len_a, len_b)`, then length tie-break).\n331\t#[derive(Debug, Copy, Clone, PartialEq, Eq, PartialOrd, Ord, Hash, Default)]\n332\tpub struct ConnectionId {\n333\t    id: [u8; CONNECTION_ID_MAX_SIZE],\n334\t    id_len: u8,\n335\t}\n336\t\n337\timpl ConnectionId {\n338\t    /// Construct a connection id by copying `bytes`.  Returns `None`\n339\t    /// when `bytes.len()` exceeds [`CONNECTION_ID_MAX_SIZE`].\n340\t    pub fn clone_from_slice(bytes: &[u8]) -> Option<Self> {\n341\t        if bytes.len() > CONNECTION_ID_MAX_SIZE {\n342\t            return None;\n343\t        }\n344\t        let mut id = [0u8; CONNECTION_ID_MAX_SIZE];\n345\t        id[..bytes.len()].copy_from_slice(bytes);\n346\t        Some(Self {\n347\t            id,\n348\t            id_len: bytes.len() as u8,\n349\t        })\n350\t    }\n351\t\n352\t    /// Construct a zero-filled connection id of length `len`.\n353\t    /// Returns `None` when `len` exceeds [`CONNECTION_ID_MAX_SIZE`].\n354\t    pub fn with_size(len: usize) -> Option<Self> {\n355\t        if len > CONNECTION_ID_MAX_SIZE {\n356\t            return None;\n357\t        }\n358\t        Some(Self {\n359\t            id: [0u8; CONNECTION_ID_MAX_SIZE],\n360\t            id_len: len as u8,\n361\t        })\n362\t    }\n363\t\n364\t    /// Borrow the live id bytes (`bytes[..len]`).\n365\t    pub fn as_bytes(&self) -> &[u8] {\n366\t        &self.id[..self.id_len as usize]\n367\t    }\n368\t\n369\t    /// Mutable borrow of the live id bytes.\n370\t    pub fn as_bytes_mut(&mut self) -> &mut [u8] {\n371\t        &mut self.id[..self.id_len as usize]\n372\t    }\n373\t\n374\t    /// Number of bytes in the id.\n375\t    pub fn len(&self) -> usize {\n376\t        self.id_len as usize\n377\t    }\n378\t\n379\t    /// `true` when the id has zero length.  Mirrors the C\n380\t    /// `is_connection_id_null` sentinel check.\n381\t    pub fn is_empty(&self) -> bool {\n382\t        self.id_len == 0\n383\t    }\n384\t\n385\t    /// Hash with a 16-byte seed.  C: `connection_id_hash`.\n386\t    pub fn hash_with_seed(&self, seed: &[u8; 16]) -> u64 {\n387\t        crate::siphash::siphash(self.as_bytes(), seed)\n388\t    }\n389\t\n390\t    /// Fold the first up-to-8 bytes of the id into a `u64`.\n391\t    /// C: `val64_connection_id`.\n392\t    pub fn val64(&self) -> u64 {\n393\t        let bytes = self.as_bytes();\n394\t        let len = bytes.len().min(8);\n395\t        let mut buf = [0u8; 8];\n396\t        buf[..len].copy_from_slice(&bytes[..len]);\n397\t        u64::from_be_bytes(buf)\n398\t    }\n399\t}\n400\t\n401\t// ---------------------------------------------------------------------------\n402\t// IO vectors.\n403\t//\n404\t// The C `picoquic_iovec_t` (and the picotls-side `PtlsIovec*` that\n405\t// aliased it) are gone — every place that used to take an iovec\n406\t// pair now takes a `&[u8]` (single buffer) or `&[&[u8]]` /\n407\t// `Vec<Vec<u8>>` (list of buffers), per the project's\n408\t// \"use Rust's slice/vec types\" policy.\n409\t\n410\t// ---------------------------------------------------------------------------\n411\t// Opaque types (forward declarations).\n412\t//\n413\t// `Quic`, `Connection`, and `Path` are\n414\t// defined in `internal.h`.  Phase 1 declares them as empty"}]},"parent_tool_use_id":null,"session_id":"571f9116-dc3a-4ceb-8913-efe2682e38a2","uuid":"2fc47a76-a5a1-4db7-93c6-514815ef84af","timestamp":"2026-05-06T12:58:47.306Z","tool_use_result":{"type":"text","file":{"filePath":"/Users/richbarn/Projects/picoquic/rs/fq/src/lib.rs","content":"// Connection ID.\n\npub const CONNECTION_ID_MIN_SIZE: usize = 0;\npub const CONNECTION_ID_MAX_SIZE: usize = 20;\n\n/// Fixed-capacity QUIC connection ID.  C: `ConnectionId`.\n///\n/// Stored as a 20-byte buffer plus a length so the type is `Copy`,\n/// matching the C usage where connection IDs are passed by value\n/// in many APIs (`get_local_connection_id`, `create_connection`,\n/// …).  Fields are private — construct via [`Self::clone_from_slice`]\n/// or [`Self::with_size`] and read via [`Self::as_bytes`].\n///\n/// `Ord` is derived as lexicographic over the live bytes (matching\n/// the C `compare_connection_id` shape: per-byte compare under\n/// `min(len_a, len_b)`, then length tie-break).\n#[derive(Debug, Copy, Clone, PartialEq, Eq, PartialOrd, Ord, Hash, Default)]\npub struct ConnectionId {\n    id: [u8; CONNECTION_ID_MAX_SIZE],\n    id_len: u8,\n}\n\nimpl ConnectionId {\n    /// Construct a connection id by copying `bytes`.  Returns `None`\n    /// when `bytes.len()` exceeds [`CONNECTION_ID_MAX_SIZE`].\n    pub fn clone_from_slice(bytes: &[u8]) -> Option<Self> {\n        if bytes.len() > CONNECTION_ID_MAX_SIZE {\n            return None;\n        }\n        let mut id = [0u8; CONNECTION_ID_MAX_SIZE];\n        id[..bytes.len()].copy_from_slice(bytes);\n        Some(Self {\n            id,\n            id_len: bytes.len() as u8,\n        })\n    }\n\n    /// Construct a zero-filled connection id of length `len`.\n    /// Returns `None` when `len` exceeds [`CONNECTION_ID_MAX_SIZE`].\n    pub fn with_size(len: usize) -> Option<Self> {\n        if len > CONNECTION_ID_MAX_SIZE {\n            return None;\n        }\n        Some(Self {\n            id: [0u8; CONNECTION_ID_MAX_SIZE],\n            id_len: len as u8,\n        })\n    }\n\n    /// Borrow the live id bytes (`bytes[..len]`).\n    pub fn as_bytes(&self) -> &[u8] {\n        &self.id[..self.id_len as usize]\n    }\n\n    /// Mutable borrow of the live id bytes.\n    pub fn as_bytes_mut(&mut self) -> &mut [u8] {\n        &mut self.id[..self.id_len as usize]\n    }\n\n    /// Number of bytes in the id.\n    pub fn len(&self) -> usize {\n        self.id_len as usize\n    }\n\n    /// `true` when the id has zero length.  Mirrors the C\n    /// `is_connection_id_null` sentinel check.\n    pub fn is_empty(&self) -> bool {\n        self.id_len == 0\n    }\n\n    /// Hash with a 16-byte seed.  C: `connection_id_hash`.\n    pub fn hash_with_seed(&self, seed: &[u8; 16]) -> u64 {\n        crate::siphash::siphash(self.as_bytes(), seed)\n    }\n\n    /// Fold the first up-to-8 bytes of the id into a `u64`.\n    /// C: `val64_connection_id`.\n    pub fn val64(&self) -> u64 {\n        let bytes = self.as_bytes();\n        let len = bytes.len().min(8);\n        let mut buf = [0u8; 8];\n        buf[..len].copy_from_slice(&bytes[..len]);\n        u64::from_be_bytes(buf)\n    }\n}\n\n// ---------------------------------------------------------------------------\n// IO vectors.\n//\n// The C `picoquic_iovec_t` (and the picotls-side `PtlsIovec*` that\n// aliased it) are gone — every place that used to take an iovec\n// pair now takes a `&[u8]` (single buffer) or `&[&[u8]]` /\n// `Vec<Vec<u8>>` (list of buffers), per the project's\n// \"use Rust's slice/vec types\" policy.\n\n// ---------------------------------------------------------------------------\n// Opaque types (forward declarations).\n//\n// `Quic`, `Connection`, and `Path` are\n// defined in `internal.h`.  Phase 1 declares them as empty","numLines":100,"startLine":315,"totalLines":3705}}}
