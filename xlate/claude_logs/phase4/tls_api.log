{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01FCTB5dhuzcvVL7D6XnoZ3H","type":"tool_result","content":"1\t//! picotls backend.\n2\t//!\n3\t//! Implements the [`crate::tls`] trait surface against picotls\n4\t//! (`https://github.com/h2o/picotls`).  Phase 1 carries skeleton\n5\t//! types; the body lands once Rust bindings exist.  picotls is the\n6\t//! reference TLS for QUIC, so this is the canonical backend.\n7\t//!\n8\t//! Phase 1 contract: signatures only — Phase 4 fills the bodies.\n9\t\n10\textern crate alloc;\n11\tuse alloc::boxed::Box;\n12\tuse alloc::vec::Vec;\n13\t\n14\tuse crate::Error;\n15\tuse crate::tls::{\n16\t    ClientConfig, ConfigError, HandshakeData, KeyPair, PeerIdentity, ServerConfig, Session,\n17\t    TlsBackend,\n18\t};\n19\t\n20\t/// Top-level picotls backend marker.\n21\tpub struct Picotls;\n22\t\n23\timpl TlsBackend for Picotls {\n24\t    type Client = PicotlsClientConfig;\n25\t    type Server = PicotlsServerConfig;\n26\t}\n27\t\n28\t/// Client-side configuration for picotls.  Holds the cert\n29\t/// store, ALPN list, key share preferences, ticket-store hooks,\n30\t/// etc.  Application-side construction goes through a builder\n31\t/// (Phase 4).\n32\tpub struct PicotlsClientConfig;\n33\t\n34\timpl ClientConfig for PicotlsClientConfig {\n35\t    type Session = PicotlsSession;\n36\t\n37\t    fn start_session(\n38\t        &self,\n39\t        _version: u32,\n40\t        _server_name: &str,\n41\t        _transport_params: &[u8],\n42\t    ) -> Result<Self::Session, ConfigError> {\n43\t        Err(ConfigError {\n44\t            message: \"picotls backend not yet implemented\".into(),\n45\t        })\n46\t    }\n47\t}\n48\t\n49\t/// Server-side configuration for picotls.\n50\tpub struct PicotlsServerConfig;\n51\t\n52\timpl ServerConfig for PicotlsServerConfig {\n53\t    type Session = PicotlsSession;\n54\t\n55\t    fn start_session(\n56\t        &self,\n57\t        _version: u32,\n58\t        _transport_params: &[u8],\n59\t    ) -> Result<Self::Session, ConfigError> {\n60\t        Err(ConfigError {\n61\t            message: \"picotls backend not yet implemented\".into(),\n62\t        })\n63\t    }\n64\t}\n65\t\n66\t/// Per-connection picotls session.  Wraps `ptls_t*`.\n67\tpub struct PicotlsSession;\n68\t\n69\timpl Session for PicotlsSession {\n70\t    fn read_handshake(&mut self, _plaintext: &[u8]) -> Result<bool, Error> {\n71\t        Err(Error::Tls)\n72\t    }\n73\t\n74\t    fn write_handshake(&mut self, _buf: &mut Vec<u8>) -> Option<crate::tls::Keys> {\n75\t        None\n76\t    }\n77\t\n78\t    fn is_handshaking(&self) -> bool {\n79\t        true\n80\t    }\n81\t\n82\t    fn next_1rtt_keys(&mut self) -> Option<KeyPair> {\n83\t        None\n84\t    }\n85\t\n86\t    fn handshake_data(&self) -> Option<HandshakeData> {\n87\t        None\n88\t    }\n89\t\n90\t    fn peer_identity(&self) -> Option<PeerIdentity> {\n91\t        None\n92\t    }\n93\t\n94\t    fn early_keys(\n95\t        &self,\n96\t    ) -> Option<(\n97\t        Box<dyn crate::tls::HeaderKey>,\n98\t        Box<dyn crate::tls::PacketKey>,\n99\t    )> {\n100\t        None\n101\t    }\n102\t\n103\t    fn early_data_accepted(&self) -> Option<bool> {\n104\t        None\n105\t    }\n106\t\n107\t    fn transport_parameters(&self) -> Result<Option<Vec<u8>>, Error> {\n108\t        Ok(None)\n109\t    }\n110\t\n111\t    fn export_keying_material(\n112\t        &self,\n113\t        _label: &[u8],\n114\t        _context: &[u8],\n115\t        _output: &mut [u8],\n116\t    ) -> Result<(), Error> {\n117\t        Err(Error::Tls)\n118\t    }\n119\t}\n120\t\n121\t// Safety: picotls is single-threaded per connection; the pointer\n122\t// inside doesn't alias.  Phase 4 wires the actual `ptls_t*` and\n123\t// re-evaluates.\n124\tunsafe impl Send for PicotlsSession {}\n125\t"}]},"parent_tool_use_id":null,"session_id":"571f9116-dc3a-4ceb-8913-efe2682e38a2","uuid":"b8ca2217-aded-40a4-8f8b-ce9a9d66f745","timestamp":"2026-05-06T12:57:11.101Z","t