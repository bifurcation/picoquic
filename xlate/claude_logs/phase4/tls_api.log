{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01MwNubceC6fp4qq15oZ2tMP","type":"tool_result","content":"7370\t// ---------------------------------------------------------------------------\n7371\t// Version accessors needed by packet-header tests.\n7372\t\n7373\timpl Connection {\n7374\t    /// Wire version number of the active protocol version.\n7375\t    /// C: `picoquic_supported_versions[cnx->version_index].version`.\n7376\t    pub fn version_number(&self) -> u32 {\n7377\t        // In the Rust translation, `proposed_version` carries the wire version\n7378\t        // number directly (C: cnx->proposed_version set from the supported-version\n7379\t        // table entry's .version field).\n7380\t        self.proposed_version\n7381\t    }\n7382\t\n7383\t    /// TLS-label prefix string for the active protocol version.\n7384\t    /// C: `picoquic_supported_versions[cnx->version_index].tls_prefix_label`.\n7385\t    pub fn version_tls_prefix_label(&self) -> &'static str {\n7386\t        // Resolve via proposed_version to a Version enum, then use parameters().\n7387\t        Version::try_from_wire(self.proposed_version)\n7388\t            .map(|v| v.parameters().tls_prefix_label)\n7389\t            .unwrap_or(\"tls13 quic \")\n7390\t    }\n7391\t}\n7392\t\n7393\t// ---------------------------------------------------------------------------\n7394\t// LB CID generation / verification helpers.\n7395\t\n7396\timpl Quic {\n7397\t    /// Generate a CID using the installed LB CID callback with `nonce` as the\n7398\t    /// nonce / \"for-server-use\" bytes.  Returns `None` when no callback is\n7399\t    /// installed.  C: direct call to `quic->cnx_id_callback_fn`.\n7400\t    pub fn lb_generate_cid(&mut self, nonce: &ConnectionId) -> Option<ConnectionId> {\n7401\t        let mut ctx_box = self.connection_id_callback_ctx.take()?;\n7402\t        let result = ctx_box\n7403\t            .downcast_mut::<crate::lb::ConnectionIdContext>()\n7404\t            .map(|ctx| ctx.generate(self, nonce));\n7405\t        self.connection_id_callback_ctx = Some(ctx_box);\n7406\t        result\n7407\t    }\n7408\t\n7409\t    /// Verify a CID using the installed LB context and return the embedded\n7410\t    /// server ID.  Returns `None` when no LB context is installed or the CID\n7411\t    /// length mismatches.  C: `lb_compat_cid_verify`.\n7412\t    pub fn lb_verify_cid(&mut self, cid: &ConnectionId) -> Option<u64> {\n7413\t        let mut ctx_box = self.connection_id_callback_ctx.take()?;\n7414\t        let result = if let Some(ctx) = ctx_box.downcast_mut::<crate::lb::ConnectionIdContext>() {\n7415\t            ctx.verify(cid)\n7416\t        } else {\n7417\t            None\n7418\t        };\n7419\t        self.connection_id_callback_ctx = Some(ctx_box);\n7420\t        result\n7421\t    }\n7422\t\n7423\t    /// Return a mutable reference to the first (most-recently-created) live\n7424\t    /// connection in this QUIC context, if any.  C: `quic->cnx_list`.\n7425\t    pub fn first_cnx_mut(&mut self) -> Option<&mut Connection> {\n7426\t        // C uses a head pointer into a doubly-linked list; in Rust we iterate\n7427\t        // the arena and return the first live entry.\n7428\t        self.connections.iter_mut().next()\n7429\t    }"}]},"parent_tool_use_id":null,"session_id":"571f9116-dc3a-4ceb-8913-efe2682e38a2","uuid":"a41c184d-b30b-4129-b456-186c398d2b57","timestamp":"2026-05-06T12:59:23.565Z","tool_use_result":{"type":"text","file":{"filePath":"/Users/richbarn/Projects/picoquic/rs/fq/src/internal.rs","content":"// ---------------------------------------------------------------------------\n// Version accessors needed by packet-header tests.\n\nimpl Connection {\n    /// Wire version number of the active protocol version.\n    /// C: `picoquic_supported_versions[cnx->version_index].version`.\n    pub fn version_number(&self) -> u32 {\n        // In the Rust translation, `proposed_version` carries the wire version\n        // number directly (C: cnx->proposed_version set from the supported-version\n        // table entry's .version field).\n        self.proposed_version\n    }\n\n    /// TLS-label prefix string for the active protocol version.\n    /// C: `picoquic_supported_versions[cnx->version_index].tls_prefix_label`.\n    pub fn version_tls_prefix_label(&self) -> &'static str {\n        // Resolve via proposed_version to a Version enum, then use parameters().\n        Version::try_from_wire(self.proposed_version)\n            .map(|v| v.parameters().tls_prefix_label)\n            .unwrap_or(\"tls13 quic \")\n    }\n}\n\n// ---------------------------------------------------------------------------\n// LB CID generation / verification helpers.\n\nimpl Quic {\n    /// Generate a CID using the installed LB CID callback with `nonce` as the\n    /// nonce / \"for-server-use\" bytes.  Returns `None` when no callback is\n    /// installed.  C: direct call to `quic->cnx_id_callback_fn`.\n    pub fn lb_generate_cid(&mut self, nonce: &ConnectionId) -> Option<ConnectionId> {\n        let mut ctx_box = self.connection_id_callback_ctx.take()?;\n        let result = ctx_box\n            .downcast_mut::<crate::lb::ConnectionIdContext>()\n            .map(|ctx| ctx.generate(self, nonce));\n        self.connection_id_callback_ctx = Some(ctx_box);\n        result\n    }\n\n    /// Verify a CID using the installed LB context and return the embedded\n    /// server ID.  Returns `None` when no LB context is installed or the CID\n    /// length mismatches.  C: `lb_compat_cid_verify`.\n    pub fn lb_verify_cid(&mut self, cid: &ConnectionId) -> Option<u64> {\n        let mut ctx_box = self.connection_id_callback_ctx.take()?;\n        let result = if let Some(ctx) = ctx_box.downcast_mut::<crate::lb::ConnectionIdContext>() {\n            ctx.verify(cid)\n        } else {\n            None\n        };\n        self.connection_id_callback_ctx = Some(ctx_box);\n        result\n    }\n\n    /// Return a mutable reference to the first (most-recently-created) live\n    /// connection in this QUIC context, if any.  C: `quic->cnx_list`.\n    pub fn first_cnx_mut(&mut self) -> Option<&mut Connection> {\n        // C uses a head pointer into a doubly-linked list; in Rust we iterate\n        // the arena and return the first live entry.\n        self.connections.iter_mut().next()\n    }","numLines":60,"startLine":7370,"totalLines":7642}}}
