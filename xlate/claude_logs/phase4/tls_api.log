{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01Fd3g6op5EKev6T1VuJSqCX","type":"tool_result","content":"1\t//! QUIC header protection (packet-number encryption).\n2\t//!\n3\t//! Per RFC 9001 §5.4, header protection masks five bytes of the\n4\t//! packet header (the first byte's low bits plus the packet\n5\t//! number) with output derived from the AEAD-encrypted payload.\n6\t//! The mask comes from running a sample of the ciphertext\n7\t//! through a *non-AEAD* cipher: AES-128/256 ECB for AES suites,\n8\t//! ChaCha20 with the sample as a nonce for ChaCha20 suites.\n9\t//!\n10\t//! Phase 2 decision (per the plan): header protection is QUIC\n11\t//! logic, not TLS-stack logic.  We implement it ourselves in\n12\t//! this crate over the `cipher` crate's primitives, rather\n13\t//! than delegating to the TLS backend.  Backends supply only\n14\t//! the *key bytes* derived from the handshake; this module\n15\t//! holds the algorithm.\n16\t\n17\textern crate alloc;\n18\tuse alloc::boxed::Box;\n19\t\n20\tuse cipher::{BlockEncrypt, KeyInit};\n21\t\n22\tuse crate::Error;\n23\tuse crate::tls::HeaderKey;\n24\t\n25\t// ---------------------------------------------------------------------------\n26\t// AES-based header protection (cipher suites\n27\t// `TLS_AES_128_GCM_SHA256` and `TLS_AES_256_GCM_SHA384`).\n28\t\n29\t/// AES-ECB header protector.  `C` is `aes::Aes128` or\n30\t/// `aes::Aes256`; both implement\n31\t/// [`cipher::BlockEncrypt<BlockSize = U16>`].\n32\tpub struct AesHeaderProtector<C> {\n33\t    cipher: C,\n34\t}\n35\t\n36\timpl<C> AesHeaderProtector<C>\n37\twhere\n38\t    C: KeyInit + BlockEncrypt + Send,\n39\t{\n40\t    /// Construct from a freshly-derived header-protection key.\n41\t    pub fn new(key: &[u8]) -> Result<Self, Error> {\n42\t        let cipher = C::new_from_slice(key).map_err(|_| Error::InvalidArgument)?;\n43\t        Ok(Self { cipher })\n44\t    }\n45\t\n46\t    /// Compute the 16-byte mask from a 16-byte sample.  QUIC\n47\t    /// uses bytes `[0..5]` of the result; the rest are wasted\n48\t    /// but the AES API gives us a full block.\n49\t    pub fn mask(&self, sample: &[u8; 16]) -> [u8; 16] {\n50\t        let mut block = cipher::generic_array::GenericArray::clone_from_slice(sample);\n51\t        self.cipher.encrypt_block(&mut block);\n52\t        let mut out = [0u8; 16];\n53\t        out.copy_from_slice(&block);\n54\t        out\n55\t    }\n56\t}\n57\t\n58\t// ---------------------------------------------------------------------------\n59\t// ChaCha20-based header protection (cipher suite\n60\t// `TLS_CHACHA20_POLY1305_SHA256`).\n61\t//\n62\t// The header-protection cipher for ChaCha20 suites is plain\n63\t// ChaCha20 (no Poly1305): the first 4 bytes of the sample are\n64\t// the block counter, the next 12 bytes are the nonce, and the\n65\t// \"mask\" is the first 16 bytes of the keystream.\n66\t\n67\t/// ChaCha20 header protector.\n68\tpub struct ChaCha20HeaderProtector {\n69\t    key: [u8; 32],\n70\t}\n71\t\n72\timpl ChaCha20HeaderProtector {\n73\t    pub fn new(key: &[u8]) -> Result<Self, Error> {\n74\t        let k: [u8; 32] = key.try_into().map_err(|_| Error::InvalidArgument)?;\n75\t        Ok(Self { key: k })\n76\t    }\n77\t\n78\t    /// RFC 9001 §5.4.4: counter = sample[0..4] LE-u32, nonce = sample[4..16].\n79\t    pub fn mask(&self, sample: &[u8; 16]) -> [u8; 16] {\n80\t        use chacha20::cipher::{KeyIvInit, StreamCipher, StreamCipherSeek};"}]},"parent_tool_use_id":null,"session_id":"571f9116-dc3a-4ceb-8913-efe2682e38a2","uuid":"7126a598-3d98-4def-bf2c-0629b886487d","timestamp":"2026-05-06T12:56:37.991Z","tool_use_result":{"type":"text","file":{"filePath":"/Users/richbarn/Projects/picoquic/rs/fq/src/header_protection.rs","content":"//! QUIC header protection (packet-number encryption).\n//!\n//! Per RFC 9001 §5.4, header protection masks five bytes of the\n//! packet header (the first byte's low bits plus the packet\n//! number) with output derived from the AEAD-encrypted payload.\n//! The mask comes from running a sample of the ciphertext\n//! through a *non-AEAD* cipher: AES-128/256 ECB for AES suites,\n//! ChaCha20 with the sample as a nonce for ChaCha20 suites.\n//!\n//! Phase 2 decision (per the plan): header protection is QUIC\n//! logic, not TLS-stack logic.  We implement it ourselves in\n//! this crate over the `cipher` crate's primitives, rather\n//! than delegating to the TLS backend.  Backends supply only\n//! the *key bytes* derived from the handshake; this module\n//! holds the algorithm.\n\nextern crate alloc;\nuse alloc::boxed::Box;\n\nuse cipher::{BlockEncrypt, KeyInit};\n\nuse crate::Error;\nuse crate::tls::HeaderKey;\n\n// ---------------------------------------------------------------------------\n// AES-based header protection (cipher suites\n// `TLS_AES_128_GCM_SHA256` and `TLS_AES_256_GCM_SHA384`).\n\n/// AES-ECB header protector.  `C` is `aes::Aes128` or\n/// `aes::Aes256`; both implement\n/// [`cipher::BlockEncrypt<BlockSize = U16>`].\npub struct AesHeaderProtector<C> {\n    cipher: C,\n}\n\nimpl<C> AesHeaderProtector<C>\nwhere\n    C: KeyInit + BlockEncrypt + Send,\n{\n    /// Construct from a freshly-derived header-protection key.\n    pub fn new(key: &[u8]) -> Result<Self, Error> {\n        let cipher = C::new_from_slice(key).map_err(|_| Error::InvalidArgument)?;\n        Ok(Self { cipher })\n    }\n\n    /// Compute the 16-byte mask from a 16-byte sample.  QUIC\n    /// uses bytes `[0..5]` of the result; the rest are wasted\n    /// but the AES API gives us a full block.\n    pub fn mask(&self, sample: &[u8; 16]) -> [u8; 16] {\n        let mut block = cipher::generic_array::GenericArray::clone_from_slice(sample);\n        self.cipher.encrypt_block(&mut block);\n        let mut out = [0u8; 16];\n        out.copy_from_slice(&block);\n        out\n    }\n}\n\n// ---------------------------------------------------------------------------\n// ChaCha20-based header protection (cipher suite\n// `TLS_CHACHA20_POLY1305_SHA256`).\n//\n// The header-protection cipher for ChaCha20 suites is plain\n// ChaCha20 (no Poly1305): the first 4 bytes of the sample are\n// the block counter, the next 12 bytes are the nonce, and the\n// \"mask\" is the first 16 bytes of the keystream.\n\n/// ChaCha20 header protector.\npub struct ChaCha20HeaderProtector {\n    key: [u8; 32],\n}\n\nimpl ChaCha20HeaderProtector {\n    pub fn new(key: &[u8]) -> Result<Self, Error> {\n        let k: [u8; 32] = key.try_into().map_err(|_| Error::InvalidArgument)?;\n        Ok(Self { key: k })\n    }\n\n    /// RFC 9001 §5.4.4: counter = sample[0..4] LE-u32, nonce = sample[4..16].\n    pub fn mask(&self, sample: &[u8; 16]) -> [u8; 16] {\n        use chacha20::cipher::{KeyIvInit, StreamCipher, StreamCipherSeek};","numLines":80,"startLine":1,"totalLines":151}}}
