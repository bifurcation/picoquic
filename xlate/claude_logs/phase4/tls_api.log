{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01N3mcpVZAUipgfjW7XSTejA","type":"tool_result","content":"1\t//! Tests from `picoquictest/cleartext_aead_test.c`.\n2\t//!\n3\t//! Covers: Initial-epoch cleartext AEAD round-trip, PN header-protection\n4\t//! primitives (AES-128-CTR known-answer and enc/dec roundtrip), HKDF\n5\t//! label-expansion against draft-17 / QUIC-v1 vectors, and retry-protection\n6\t//! integrity tag for v1 and v2.\n7\t\n8\tuse core::net::SocketAddr;\n9\t\n10\tuse crate::internal::{INTEROP_VERSION_LATEST, Version, format_32};\n11\tuse crate::tls_api::{\n12\t    HASH_SIZE_MAX, LABEL_HP, LABEL_IV, LABEL_KEY, LABEL_QUIC_V1_KEY_BASE, LABEL_V1_TRAFFIC_UPDATE,\n13\t    create_retry_protection_context, encode_retry_protection, hash_create, hkdf_expand_label,\n14\t    rotate_app_secret, setup_initial_master_secret, setup_initial_secrets,\n15\t    test_pn_enc_from_raw_key, verify_retry_protection,\n16\t};\n17\tuse crate::utils::format_connection_id;\n18\tuse crate::{ConnectionId, Instant, MAX_PACKET_SIZE, Quic, RESET_SECRET_SIZE};\n19\t\n20\tuse super::util::{TEST_ALPN, TEST_FILE_CERT_STORE, TEST_FILE_SERVER_CERT, TEST_FILE_SERVER_KEY};\n21\t\n22\t// ---------------------------------------------------------------------------\n23\t// Shared packet-building helper.\n24\t\n25\t/// Serialize a synthetic QUIC-like long-header packet into `buf[..target]`\n26\t/// and return the fixed header length (17 bytes) used as the AEAD AAD.\n27\t/// C: `cleartext_aead_init_packet`.\n28\tfn init_aead_packet(\n29\t    dest_cnx_id: ConnectionId,\n30\t    pn: u32,\n31\t    vn: u32,\n32\t    ptype: u8,\n33\t    buf: &mut [u8],\n34\t    target: usize,\n35\t) -> usize {\n36\t    const OFFSET: usize = 17;\n37\t    let mut idx = 0usize;\n38\t    buf[idx] = 0x80 | ptype;\n39\t    idx += 1;\n40\t    format_32(&mut buf[idx..], vn);\n41\t    idx += 4;\n42\t    idx += format_connection_id(&mut buf[idx..], dest_cnx_id) as usize;\n43\t    idx += format_connection_id(&mut buf[idx..], ConnectionId::with_size(0).unwrap()) as usize;\n44\t    format_32(&mut buf[idx..], pn);\n45\t    idx += 4;\n46\t    // \"silly content\" filler derived from CID and PN.\n47\t    let mut seed = dest_cnx_id.val64() ^ (pn as u64);\n48\t    while idx < target {\n49\t        seed = seed.wrapping_mul(101);\n50\t        buf[idx] = (seed & 0xFF) as u8;\n51\t        idx += 1;\n52\t    }\n53\t    OFFSET\n54\t}\n55\t\n56\t// ---------------------------------------------------------------------------\n57\t// `cleartext_aead_vector_test_one` helper.\n58\t\n59\t/// Create a client connection with `test_id` and `test_vn`, start it, and\n60\t/// assert that the Initial-epoch crypto contexts are populated.\n61\t/// C: `cleartext_aead_vector_test_one`.\n62\t///\n63\t/// The C function also compared the AEAD IVs against expected values, but\n64\t/// that comparison is entirely inside `#if 0` and always succeeds — so the\n65\t/// Rust translation only verifies context presence.\n66\tfn aead_vector_test_one(test_id: ConnectionId, test_vn: u32) {\n67\t    let t0 = Instant::from_ticks(0);\n68\t    let mut qclient = Quic::new(\n69\t        8,\n70\t        None,\n71\t        None,\n72\t        None,\n73\t        None,\n74\t        None,\n75\t        None,\n76\t        [0u8; RESET_SECRET_SIZE],\n77\t        t0,\n78\t        None,\n79\t        None,\n80\t    )\n81\t    .expect(\"client quic\");\n82\t\n83\t    let addr: SocketAddr = SocketAddr::from(([10u8, 0, 0, 1], 12345u16));\n84\t\n85\t    let cnx = qclient\n86\t        .create_connection(\n87\t            test_id,\n88\t            ConnectionId::with_size(0).unwrap(),\n89\t            Some(&addr),\n90\t            t0,\n91\t            test_vn,\n92\t            None,\n93\t            None,\n94\t            true,\n95\t        )\n96\t        .expect(\"client connection\");\n97\t\n98\t    cnx.start_client().expect(\"start client\");\n99\t\n100\t    assert!("}]},"parent_tool_use_id":null,"session_id":"571f9116-dc3a-4ceb-89