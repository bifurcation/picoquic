input);\n685\t        v\n686\t    };\n687\t\n688\t    #[rustfmt::skip]\n689\t    let retry_protection_test_checksum: [u8; 16] = [\n690\t        0xf9, 0x50, 0xf8, 0x85, 0x71, 0x4b, 0xae, 0x7a,\n691\t        0xf1, 0xe2, 0x86, 0x7d, 0xd8, 0xf7, 0x83, 0x92,\n692\t    ];\n693\t\n694\t    // Draft-25 retry packet vector.\n695\t    let retry_protection_odcid_draft25 =\n696\t        ConnectionId::clone_from_slice(&[0x83, 0x94, 0xc8, 0xf0, 0x3e, 0x51, 0x57, 0x08]).unwrap();\n697\t    #[rustfmt::skip]\n698\t    let retry_protection_packet_draft25: [u8; 36] = [\n699\t        0xff, 0xff, 0x00, 0x00, 0x19, 0x00, 0x08, 0xf0, 0x67, 0xa5, 0x50, 0x2a, 0x42, 0x62,\n700\t        0xb5, 0x74, 0x6f, 0x6b, 0x65, 0x6e, 0x1e, 0x5e, 0xc5, 0xb0, 0x14, 0xcb, 0xb1, 0xf0,\n701\t        0xfd, 0x93, 0xdf, 0x40, 0x48, 0xc4, 0x46, 0xa6,\n702\t    ];\n703\t\n704\t    // Obtain the QUIC-v1 retry integrity key via the version parameters.\n705\t    let v1_params = Version::V1.parameters();\n706\t    let retry_key = v1_params.version_retry_key;\n707\t    let prefix_label = v1_params.tls_prefix_label;\n708\t\n709\t    // Phase 1: low-level AEAD encrypt/decrypt against the known checksum.\n710\t    {\n711\t        let protection_ctx = create_retry_protection_context(true, retry_key, prefix_label)\n712\t            .expect(\"create protection ctx\");\n713\t\n714\t        // Encrypt empty plaintext; the only output is the 16-byte AEAD tag.\n715\t        let mut tag: Vec<u8> = Vec::new();\n716\t        protection_ctx.encrypt(0, &retry_protection_pseudo_packet, &mut tag);\n717\t        assert_eq!(tag.len(), 16, \"tag length != 16\");\n718\t        assert_eq!(\n719\t            &tag[..],\n720\t            &retry_protection_test_checksum,\n721\t            \"tag does not match expected\"\n722\t        );\n723\t\n724\t        // Verify: decrypt the tag (should succeed with 0 plaintext bytes).\n725\t        let verification_ctx = create_retry_protection_context(false, retry_key, prefix_label)\n726\t            .expect(\"create verification ctx\");\n727\t\n728\t        let mut tag_verify = tag.clone();\n729\t        verification_ctx\n730\t            .decrypt(0, &retry_protection_pseudo_packet, &mut tag_verify)\n731\t            .expect(\"AEAD decrypt should succeed\");\n732\t        assert!(tag_verify.is_empty(), \"decrypted plaintext should be empty\");\n733\t\n734\t        // Negative test: corrupt one byte → decryption must fail.\n735\t        tag_verify = tag.clone();\n736\t        tag_verify[0] ^= 1;\n737\t        assert!(\n738\t            verification_ctx\n739\t                .decrypt(0, &retry_protection_pseudo_packet, &mut tag_verify)\n740\t                .is_err(),\n741\t            \"corrupted tag should fail verification\"\n742\t        );\n743\t    }\n744\t\n745\t    // Phase 2: encode_retry_protection / verify_retry_protection.\n746\t    {\n747\t        let protection_ctx = create_retry_protection_context(true, retry_key, prefix_label)\n748\t            .expect(\"create protection ctx\");\n749\t\n750\t        let mut packet = vec![0u8; MAX_PACKET_SIZE];\n751\t        let packet_index = retry_protection_test_input.len();\n752\t        packet[..packet_index].copy_from_slice(&retry_protection_test_input);\n753\t\n754\t        let length = encode_retry_protection(\n755\t            protection_ctx.as_ref(),\n756\t            &mut packet,\n757\t            packet_index,\n758\t            &retry_protection_test_odcid,\n759\t        );\n760\t        assert_eq!(length, packet_index + 16, \"encoded length mismatch\");\n761\t        assert_eq!(\n762\t            &packet[packet_index..length],\n763\t            &retry_protection_test_checksum,\n764\t            \"appended checksum mismatch\"\n765\t        );\n766\t\n767\t        let verification_ctx = create_retry_protection_context(false, retry_key, prefix_label)\n768\t            .expect(\"create verification ctx\");\n769\t\n770\t        // Positive verify.\n771\t        let bytes_index = packet_index - RETRY_TOKEN_LENGTH; // = 17\n772\t        let new_length = verify_retry_protection(\n773\t            verification_ctx.as_ref(),\n774\t            &mut packet,\n775\t            length,\n776\t            bytes_index,\n777\t            &retry_protection_test_odcid,\n778\t        )\n779\t        .expect(\"verify retry protection\");\n780\t        assert_eq!(\n781\t            new_length, packet_index,\n782\t            \"verified length should equal input length\"\n783\t        );\n784\t\n785\t        // Bad ODCID → must fail.\n786\t        let mut bad_odcid = retry_protection_test_odcid;\n787\t        bad_odcid.as_bytes_mut()[0] ^= 1;\n788\t        packet[..packet_index].copy_from_slice(&retry_protection_test_input);\n789\t        packet[packet_index..length].copy_from_slice(&retry_protection_test_checksum);\n790\t        assert!(\n791\t            verify_retry_protection(\n792\t                verification_ctx.as_ref(),\n793\t                &mut packet,\n794\t                length,\n795\t                bytes_index,\n796\t                &bad_odcid,\n797\t            )\n798\t            .is_err(),\n799\t            \"bad ODCID should fail verification\"\n800\t        );\n801\t\n802\t        // Draft-25 vector.\n803\t        let draft25_len = retry_protection_packet_draft25.len();\n804\t        packet[..draft25_len].copy_from_slice(&retry_protection_packet_draft25);\n805\t        let draft25_bytes_index = draft25_len - RETRY_TOKEN_LENGTH; // = 12\n806\t        verify_retry_protection(\n807\t            verification_ctx.as_ref(),\n808\t            &mut packet,\n809\t            draft25_len,\n810\t            draft25_bytes_index,\n811\t            &retry_protection_odcid_draft25,\n812\t        )\n813\t        .expect(\"draft-25 vector verification\");\n814\t    }\n815\t}\n816\t\n817\t/// C: `retry_protection_v2_test` in `picoquictest/cleartext_aead_test.c`.\n818\t#[test]\n819\tfn retry_protection_v2() {\n820\t    let v2_sample_odcid =\n821\t        ConnectionId::clone_from_slice(&[0x83, 0x94, 0xc8, 0xf0, 0x3e, 0x51, 0x57, 0x08]).unwrap();\n822\t    #[rustfmt::skip]\n823\t    let v2_sample_retry: [u8; 36] = [\n824\t        0xcf, 0x6b, 0x33, 0x43, 0xcf, 0x00, 0x08, 0xf0,\n825\t        0x67, 0xa5, 0x50, 0x2a, 0x42, 0x62, 0xb5, 0x74,\n826\t        0x6f, 0x6b, 0x65, 0x6e, 0xc8, 0x64, 0x6c, 0xe8,\n827\t        0xbf, 0xe3, 0x39, 0x52, 0xd9, 0x55, 0x54, 0x36,\n828\t        0x65, 0xdc, 0xc7, 0xb6,\n829\t    ];\n830\t\n831\t    let v2_params = Version::V2.parameters();\n832\t    let protection_ctx_v2 = create_retry_protection_context(\n833\t        true,\n834\t        v2_params.version_retry_key,\n835\t        v2_params.tls_prefix_label,\n836\t    )\n837\t    .expect(\"create V2 protection context\");\n838\t\n839\t    // The C test copies v2_sample_retry[..byte_index] into `bytes`, then calls\n840\t    // encode_retry_protection, and compares the full result to v2_sample_retry.\n841\t    let byte_index = v2_sample_retry.len() - 16; // payload before the integrity tag\n842\t    let mut bytes = vec![0u8; MAX_PACKET_SIZE];\n843\t    bytes[..byte_index].copy_from_slice(&v2_sample_retry[..byte_index]);\n844\t\n845\t    let new_index = encode_retry_protection(\n846\t        protection_ctx_v2.as_ref(),\n847\t        &mut bytes,\n848\t        byte_index,\n849\t        &v2_sample_odcid,\n850\t    );\n851\t\n852\t    assert_eq!(\n853\t        new_index,\n854\t        v2_sample_retry.len(),\n855\t        \"V2 retry packet length mismatch\"\n856\t    );\n857\t    assert_eq!(\n858\t        &bytes[..new_index],\n859\t        &v2_sample_retry[..],\n860\t        \"V2 retry packet content mismatch\"\n861\t    );\n862\t}\n863\t\n864\t/// C: `key_rotation_vector_test` in `picoquictest/cleartext_aead_test.c`.\n865\t#[test]\n866\tfn key_rotation_vector() {\n867\t    // Input secret: bytes 1..=64.\n868\t    let key_rotation_test_init: [u8; HASH_SIZE_MAX] = {\n869\t        let mut a = [0u8; HASH_SIZE_MAX];\n870\t        for (i, b) in a.iter_mut().enumerate() {\n871\t            *b = (i + 1) as u8;\n872\t        }\n873\t        a\n874\t    };\n875\t\n876\t    // Expected outputs after rotation with LABEL_V1_TRAFFIC_UPDATE.\n877\t    #[rustfmt::skip]\n878\t    let target_sha384: [u8; 48] = [\n879\t        0xa1, 0xb5, 0xbd, 0xa2, 0x55, 0xf0, 0x7b, 0x68,\n880\t        0xdb, 0xe0, 0xa0, 0x39, 0x86, 0x94, 0xd9, 0x0d,\n881\t        0xe1, 0xf9, 0x46, 0xe4, 0x68, 0xf6, 0x87, 0xeb,\n882\t        0x19, 0x22, 0x5c, 0x92, 0x45, 0xe1, 0xf4, 0xe4,\n883\t        0x17, 0x73, 0xf6, 0x46, 0x5c, 0xb2, 0x24, 0xe0,\n884\t        0x5d, 0xb0, 0x40, 0x7a, 0x9b, 0x67, 0x47, 0xd1,\n885\t    ];\n886\t    #[rustfmt::skip]\n887\t    let target_sha256: [u8; 32] = [\n888\t        0x00, 0x70, 0x0d, 0x33, 0x5b, 0x1c, 0x49, 0xd1,\n889\t        0xe6, 0x37, 0x1e, 0x22, 0xd4, 0xa0, 0x17, 0x6d,\n890\t        0x0e, 0x34, 0x09, 0x19, 0x1b, 0x28, 0x46, 0x3c,\n891\t        0x38, 0xaf, 0x43, 0x34, 0x99, 0x43, 0x72, 0x57,\n892\t    ];\n893\t    // ChaCha20-Poly1305 also uses SHA-256.\n894\t    let target_poly = target_sha256;\n895\t\n896\t    // (hash_algorithm_name, digest_size, expected_output)\n897\t    let cases: &[(&str, usize, &[u8])] = &[\n898\t        (\"sha384\", 48, &target_sha384),\n899\t        (\"sha256\", 32, &target_sha256),\n900\t        (\"sha256\", 32, &target_poly),\n901\t    ];\n902\t\n903\t    for &(hash_name, digest_size, target) in cases {\n904\t        let mut new_secret = [0u8; HASH_SIZE_MAX];\n905\t        new_secret[..digest_size].copy_from_slice(&key_rotation_test_init[..digest_size]);\n906\t\n907\t        let mut hasher = hash_create(hash_name).expect(\"hash_create\");\n908\t        rotate_app_secret(\n909\t            &mut *hasher,\n910\t            &mut new_secret[..digest_size],\n911\t            LABEL_V1_TRAFFIC_UPDATE,\n912\t        )\n913\t        .expect(\"rotate_app_secret\");\n914\t\n915\t        assert_eq!(\n916\t            &new_secret[..digest_size],\n917\t            target,\n918\t            \"key rotation mismatch for {hash_name}\"\n919