{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_014GgXa8K4VeZ8jjTzKgrZSF","type":"tool_result","content":"1\t[package]\n2\tname = \"fq\"\n3\tversion = \"0.1.0\"\n4\tedition = \"2024\"\n5\t\n6\t[features]\n7\tdefault = []\n8\t# Each backend lives behind its own feature so a binary only pays\n9\t# for the implementations it actually links.  See `src/sys/`.\n10\tsys-picotls = []\n11\tsys-openssl = [\"dep:openssl\"]\n12\tsys-mbedtls = []\n13\tsys-fusion = []\n14\t\n15\t[dependencies]\n16\tfugit = { version = \"0.3\", default-features = false }\n17\trand = { version = \"0.9\", default-features = false }\n18\trand_core = { version = \"0.9\", default-features = false }\n19\t\n20\t# Rust Crypto trait crates (no implementations -- those come from\n21\t# the active TLS backend's crypto layer, except for header\n22\t# protection which we implement ourselves).\n23\taead = { version = \"0.5\", default-features = false }\n24\tcipher = { version = \"0.4\", default-features = false }\n25\tdigest = { version = \"0.10\", default-features = false }\n26\t\n27\t# Concrete cipher implementations used by header protection\n28\t# (QUIC packet-number encryption is QUIC logic, not TLS).\n29\taes = { version = \"0.8\", default-features = false }\n30\tchacha20 = { version = \"0.9\", default-features = false }\n31\t\n32\t# UDP socket abstraction.  std-only.\n33\tsocket2 = { version = \"0.5\", default-features = false, features = [\"all\"] }\n34\t\n35\t# Optional backend implementations (gated by `sys-*` features).\n36\topenssl = { version = \"0.10\", optional = true }\n37\t"}]},"parent_tool_use_id":null,"session_id":"571f9116-dc3a-4ceb-8913-efe2682e38a2","uuid":"a03e22ae-84e3-4322-9389-87da7e5b5ea8","timestamp":"2026-05-06T12:56:33.374Z","tool_use_result":{"type":"text","file":{"filePath":"/Users/richbarn/Projects/picoquic/rs/fq/Cargo.toml","content":"[package]\nname = \"fq\"\nversion = \"0.1.0\"\nedition = \"2024\"\n\n[features]\ndefault = []\n# Each backend lives behind its own feature so a binary only pays\n# for the implementations it actually links.  See `src/sys/`.\nsys-picotls = []\nsys-openssl = [\"dep:openssl\"]\nsys-mbedtls = []\nsys-fusion = []\n\n[dependencies]\nfugit = { version = \"0.3\", default-features = false }\nrand = { version = \"0.9\", default-features = false }\nrand_core = { version = \"0.9\", default-features = false }\n\n# Rust Crypto trait crates (no implementations -- those come from\n# the active TLS backend's crypto layer, except for header\n# protection which we implement ourselves).\naead = { version = \"0.5\", default-features = false }\ncipher = { version = \"0.4\", default-features = false }\ndigest = { version = \"0.10\", default-features = false }\n\n# Concrete cipher implementations used by header protection\n# (QUIC packet-number encryption is QUIC logic, not TLS).\naes = { version = \"0.8\", default-features = false }\nchacha20 = { version = \"0.9\", default-features = false }\n\n# UDP socket abstraction.  std-only.\nsocket2 = { version = \"0.5\", default-features = false, features = [\"all\"] }\n\n# Optional backend implementations (gated by `sys-*` features).\nopenssl = { version = \"0.10\", optional = true }\n","numLines":37,"startLine":1,"totalLines":37}}}
