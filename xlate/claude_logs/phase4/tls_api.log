,"+sha2 = { version = \"0.10\", default-features = false }","+hkdf = { version = \"0.12\", default-features = false }","+hmac = { version = \"0.12\", default-features = false }","+aes-gcm = { version = \"0.10\", default-features = false, features = [\"aes\", \"alloc\"] }","+"," # UDP socket abstraction.  std-only."," socket2 = { version = \"0.5\", default-features = false, features = [\"all\"] }"," "]}],"userModified":false,"replaceAll":false}}
