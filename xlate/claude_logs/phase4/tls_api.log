/// Per-version cryptographic and label parameters.  C:\n280\t    /// `picoquic_supported_versions[]`'s row for this version.\n281\t    pub fn parameters(self) -> VersionParameters {\n282\t        // SKIP: parameters: requires static crypto byte slices from C tables not yet ported\n283\t        // Returning a placeholder V1 parameters for now\n284\t        VersionParameters {\n285\t            version: self,\n286\t            version_aead_key: &[],\n287\t            version_retry_key: &[],\n288\t            tls_prefix_label: \"tls13 quic \",\n289\t            tls_traffic_update_label: \"quic ku\",\n290\t            packet_type_version: self as u32,\n291\t            upgrade_from: &[],\n292\t        }\n293\t    }\n294\t}\n295\t\n296\t/// Per-version cryptographic and label parameters.  C:\n297\t/// `VersionParameters`.\n298\t///\n299\t/// `version_aead_key` and `version_retry_key` are static byte\n300\t/// tables in the C source — Rust models them as borrowed slices.\n301\t/// `upgrade_from` is a `NULL`-terminated list in C; here it is a\n302\t/// borrowed slice, with an empty slice for \"no upgrade path\".\n303\t#[derive(Debug)]\n304\tpub struct VersionParameters {\n305\t    pub version: Version,\n306\t    pub version_aead_key: &'static [u8],\n307\t    pub version_retry_key: &'static [u8],\n308\t    pub tls_prefix_label: &'static str,\n309\t    pub tls_traffic_update_label: &'static str,\n310\t    pub packet_type_version: u32,\n311\t    pub upgrade_from: &'static [Version],\n312\t}\n313\t\n314\t// ---------------------------------------------------------------------------\n315\t// Crypto epochs and packet types.\n316\t\n317\t#[derive(Debug, Copy, Clone, PartialEq, Eq)]\n318\t#[repr(u8)]\n319\tpub enum Epoch {\n320\t    Initial = 0,\n321\t    ZeroRtt = 1,\n322\t    Handshake = 2,\n323\t    OneRtt = 3,\n324\t}\n325\t\n326\t#[derive(Debug, Copy, Clone, PartialEq, Eq)]\n327\t#[repr(u8)]\n328\tpub enum PacketType {\n329\t    Error = 0,\n330\t    VersionNegotiation,\n331\t    Initial,\n332\t    Retry,\n333\t    Handshake,\n334\t    ZeroRttProtected,\n335\t    OneRttProtected,\n336\t    TypeMax,\n337\t}\n338\t\n339\t// ---------------------------------------------------------------------------\n340\t// Packet header.\n341\t\n342\t/// Parsed long/short packet header.  C: `PacketHeader`.\n343\t///\n344\t/// The C struct uses a packed bitfield for eight single-bit\n345\t/// flags; Rust stores them as plain `bool` fields (one per flag).\n346\tpub struct PacketHeader {\n347\t    pub dest_connection_id: ConnectionId,\n348\t    pub src_connection_id: ConnectionId,\n349\t    /// Truncated packet number as it appeared on the wire (1-4 bytes,\n350\t    /// extended to `u32`).  Reconstructed full PN is in\n351\t    /// [`Self::packet_number_full`].\n352\t    pub packet_number_truncated: u32,\n353\t    pub version: u32,\n354\t    pub offset: usize,\n355\t    pub packet_number_offset: usize,\n356\t    pub packet_type: PacketType,\n357\t    pub packet_number_mask: u64,\n358\t    pub packet_number_full: u64,\n359\t    pub payload_length: usize,\n360\t    pub version_index: i32,\n361\t    pub epoch: Epoch,\n362\t    pub packet_context: PacketContext,\n363\t\n364\t    pub key_phase: bool,\n365\t    pub spin: bool,\n366\t    pub has_spin_bit: bool,\n367\t    pub has_reserved_bit_set: bool,\n368\t    pub has_loss_bits: bool,\n369\t    pub loss_bit_q: bool,\n370\t    pub loss_bit_l: bool,\n371\t    pub quic_bit_is_zero: bool,\n372\t\n373\t    /// Borrowed token bytes (length implicit in the slice).  Phase\n374\t    /// 4 plan: `IncomingPacket` decoders carry a lifetime; the\n375\t    /// `token_length` field is gone (it lived only as the slice's\n376\t    /// length).\n377\t    pub token_bytes: Vec<u8>,\n378\t    pub payload_length_value: usize,\n379\t    /// Token into [`Quic`]'s arena for the local CID this packet\n380\t    /// targets, if any.  C: `*mut LocalConnectionId` back-pointer.\n381\t    pub local_connection_id: Option<LocalConnectionIdToken>,\n382\t}\n383\t\n384\t// ---------------------------------------------------------------------------\n385\t// Spin-bit policy vtable.\n386\t\n387\t/// Spin-bit policy: how to update the spin bit on an incoming\n388\t/// packet, and what value to emit on outgoing packets.  In C the\n389\t/// policy is two function pointers grouped into\n390\t/// `SpinbitDef`; the two are always installed\n391\t/// together so they share one Rust trait.\n392\tpub trait SpinBitPolicy: Sync {\n393\t    /// C: `spinbit_incoming_fn`.\n394\t    fn incoming(&self, connection: &mut Connection, path_x: &mut Path, ph: &PacketHeader);\n395\t\n396\t    /// C: `spinbit_outgoing_fn`.\n397\t    fn outgoing(&self, connection: &mut Connection) -> u8;\n398\t}\n399\t\n400\t/// Spin-bit policy dispatch table.  Replaces `extern SpinbitDef\n401\t/// spin_function_table[]` from the C source.  Each row is a\n402\t/// `&'static dyn` to a stateless policy implementor; the wrapper\n403\t/// `SpinbitDef` struct from C is gone (the trait object carries\n404\t/// the same information).\n405\t///\n406\t/// Indices match [`crate::SpinbitVersion`] values:\n407\t/// * 0 = Basic\n408\t/// * 1 = Random\n409\t/// * 2 = Null\n410\t/// * 3 = On (test-only, server side)\n411\t///\n412\t/// The concrete policy types and the populated table land in\n413\t/// `crate::spinbit` (Phase 4).\n414\tpub static SPIN_FUNCTION_TABLE: &[&dyn SpinBitPolicy] = &[];\n415\t\n416\t// ---------------------------------------------------------------------------\n417\t// Stateless packet, queued at the QUIC context until sendable.\n418\t\n419\tpub struct StatelessPacket {\n420\t    pub addr_to: SocketAddr,\n421\t    pub addr_local: SocketAddr,\n422\t    pub if_index_local: i32,\n423\t    pub received_ecn: u8,\n424\t    pub length: usize,\n425\t    pub receive_time: Instant,\n426\t    pub connection_id_log64: u64,\n427\t    pub initial_connection_id: ConnectionId,\n428\t    pub packet_type: PacketType,\n429\t    pub bytes: [u8; MAX_PACKET_SIZE],\n430\t}\n431\t\n432\timpl Quic {\n433\t    /// Allocate a fresh stateless-packet buffer.  C:\n434\t    /// `create_stateless_packet` plus the per-context pool;\n435\t    /// `Quic.connections.alloc()`-style — Rust uses normal heap\n436\t    /// allocation and lets `Drop` free.\n437\t    pub fn create_stateless_packet(&mut self) -> Result<StatelessPacket, crate::Error> {\n438\t        use core::net::{IpAddr, Ipv4Addr};\n439\t        Ok(StatelessPacket {\n440\t            addr_to: core::net::SocketAddr::new(IpAddr::V4(Ipv4Addr::UNSPECIFIED), 0),\n441\t            addr_local: core::net::SocketAddr::new(IpAddr::V4(Ipv4Addr::UNSPECIFIED), 0),\n442\t            if_index_local: 0,\n443\t            received_ecn: 0,\n444\t            length: 0,\n445\t            receive_time: crate::Instant::from_ticks(0),\n446\t            connection_id_log64: 0,\n447\t            initial_connection_id: crate::ConnectionId::default(),\n448\t            packet_type: crate::internal::PacketType::Error,\n449\t            bytes: [0u8; crate::MAX_PACKET_SIZE],\n450\t        })\n451\t    }\n452\t\n453\t    /// Hand `sp` to the QUIC context's pending stateless-packet\n454\t    /// queue.  C: `queue_stateless_packet`.\n455\t    pub fn queue_stateless_packet(&mut self, sp: StatelessPacket) {\n456\t        self.pending_stateless_packets.push_back(sp);\n457\t    }\n458\t\n459\t    /// Pop the next pending stateless packet.  Returns `None` when\n460\t    /// the queue is empty.  C: `dequeue_stateless_packet`.\n461\t    pub fn dequeue_stateless_packet(&mut self) -> Option<StatelessPacket> {\n462\t        self.pending_stateless_packets.pop_front()\n463\t    }\n464\t}\n465\t\n466\t// `delete_stateless_packet` is gone -- StatelessPacket falls out\n467\t// of scope (the VecDeque drains it); `Drop` does the C `free`.\n468\t\n469\t// ---------------------------------------------------------------------------\n470\t// Stream data nodes (received) and queue nodes (queued for send).\n471\t\n472\tpub struct StreamDataNode {\n473\t    /// Membership in the parent stream's `stream_data_tree`.\n474\t    /// `Some(token)` while in the tree; `None` otherwise.  Phase 4\n475\t    /// uses this for O(1) removal.\n476\t    pub stream_data_membership: Option<SplayToken>,\n477\t    pub offset: u64,\n478\t    /// Inline buffer of payload bytes.  C kept a parallel\n479\t    /// `bytes: *const u8` aliasing into `data` plus a `length`\n480\t    /// field; in Rust the slice subsumes both — `data[..len]` is\n481\t    /// the live payload and `len` is `length`.\n482\t    pub data: [u8; MAX_PACKET_SIZE],\n483\t    pub length: usize,\n484\t}\n485\t\n486\tpub struct StreamQueueNode {\n487\t    pub offset: u64,\n488\t    /// Owned send-queue payload.  C: `bytes: *mut u8` plus paired\n489\t    /// `length: size_t`; both collapse into the vector.\n490\t    pub bytes: Vec<u8>,\n491\t}\n492\t\n493\t// ---------------------------------------------------------------------------\n494\t// Sent packet (kept on retransmit queues until acked).\n495\t\n496\tpub struct Packet {\n497\t    /// Membership in the owning connection's\n498\t    /// `queue_data_repeat_tree`.  Phase 4 uses this for O(1) removal.\n499\t    pub queue_data_repeat_membership: Option<SplayToken>,\n500\t    /// Path the packet was sent on.  C: `*mut Path` back-pointer.\n501\t    pub send_path: Option<PathToken>,\n502\t    pub sequence_number: u64,\n503\t    pub send_time: Instant,\n504\t    pub delivered_prior: u64,\n505\t    pub delivered_time_prior: Instant,\n506\t    pub delivered_sent_prior: u64,\n507\t    pub lost_prior: u64,\n508\t    pub inflight_prior: u64,\n509\t    pub data_repeat_frame: usize,\n510\t    pub data_repeat_index: usize,\n511\t\n512\t    pub data_repeat_priority: u64,\n513\t    pub data_repeat_stream_id: u64,\n514\t    pub data_repeat_stream_offset: u64,\n515\t    pub data_repeat_stream_data_length: usize,\n516\t\n517\t    pub length: usize,\n518\t    pub checksum_overhead: usize,\n519\t    pub offset: usize,\n520