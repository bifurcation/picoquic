43\t} option_param_t;\n44\t\n45\ttypedef struct st_option_table_line_t {\n46\t    picoquic_option_enum_t option_num;\n47\t    char option_letter;\n48\t    char const* option_name;\n49\t    int nb_params_required;\n50\t    char const* param_sample;\n51\t    char const* option_help;\n52\t} option_table_line_t;\n53\t\n54\tstatic option_table_line_t option_table[] = {\n55\t    { picoquic_option_CERT, 'c', \"cert\", 1, \"file\", \"cert file\" },\n56\t    { picoquic_option_KEY, 'k', \"key\", 1, \"file\", \"key file\" },\n57\t    { picoquic_option_SERVER_PORT, 'p', \"port\", 1, \"number\", \"server port\" },\n58\t    { picoquic_option_PROPOSED_VERSION, 'v', \"proposed_version\", 1, \"\", \"Version proposed by client, e.g. -v ff000012\" },\n59\t    { picoquic_option_OUTDIR, 'o', \"outdir\", 1, \"folder\", \"Folder where client writes downloaded files, defaults to current directory.\" },\n60\t    { picoquic_option_WWWDIR, 'w', \"wwwdir\", 1, \"folder\", \"Folder containing web pages served by server\" },\n61\t    { picoquic_option_MAX_CONNECTIONS, 'x', \"max_connections\", 1, \"number\",\n62\t    \"Maximum number of concurrent connections, default 256\" },\n63\t    { picoquic_option_DO_RETRY, 'r', \"do_retry\", 0, \"\", \"Do Retry Request\" },\n64\t    { picoquic_option_INITIAL_RANDOM, 'R', \"initial_random\", 1, \"option\", \"Randomize packet number spaces: none(0), initial(1, default), all(2).\" },\n65\t    { picoquic_option_RESET_SEED, 's', \"reset_seed\", 1, \"<32 hex chars>\", \"Reset seed\" },\n66\t    { picoquic_option_DisablePortBlocking, 'X', \"disable_block\", 0, \"\", \"Disable the check for blocked ports\"},\n67\t    { picoquic_option_SOLUTION_DIR, 'S', \"solution_dir\", 1, \"folder\", \"Set the path to the source files to find the default files\" },\n68\t    { picoquic_option_CC_ALGO, 'G', \"cc_algo\", 1, \"cc_algorithm\",\n69\t    \"Use the specified congestion control algorithm. Defaults to bbr. Supported values are:\" },\n70\t    { picoquic_option_CC_OPTION, 'H', \"cco\", 1, \"option\", \"Set option string if required by congestion control algorithm.\"},\n71\t    { picoquic_option_SPINBIT, 'P', \"spinbit\", 1, \"number\", \"Set the default spinbit policy\" },\n72\t    { picoquic_option_LOSSBIT, 'O', \"lossbit\", 1, \"number\", \"Set the default lossbit policy\" },\n73\t    { picoquic_option_MULTIPATH, 'M', \"multipath\", 0, \"\", \"Enable QUIC multipath extension\" },\n74\t    { picoquic_option_DEST_IF, 'e', \"dest_if\", 1, \"if\", \"Send on interface (default: -1)\" },\n75\t    { picoquic_option_CIPHER_SUITE, 'C', \"cipher_suite\", 1, \"cipher_suite_id\", \"specify cipher suite (e.g. -C 20 = chacha20)\" },\n76\t    { picoquic_option_INIT_CNXID, 'i', \"cnxid_params\", 1, \"per-text-lb-spec\", \"See documentation for LB compatible CID configuration\" },\n77\t    { picoquic_option_LOG_FILE, 'l', \"text_log\", 1, \"file\", \"Log file, Log to stdout if file = \\\"-\\\". No text logging if absent.\" },\n78\t    { picoquic_option_LONG_LOG, 'L', \"long_log\", 0, \"\", \"Log all packets. If absent, log stops after 100 packets.\" },\n79\t    { picoquic_option_BINLOG_DIR, 'b', \"binlog_dir\", 1, \"folder\", \"Binary logging to this directory. No binary logging if absent.\" },\n80\t    { picoquic_option_QLOG_DIR, 'q', \"qlog_dir\", 1, \"folder\", \n81\t    \"Qlog logging to this directory. No qlog logging if absent, but qlogs could be produced using picolog if binary logs are available.\" },\n82\t    { picoquic_option_MTU_MAX, 'm', \"mtu_max\", 1, \"mtu_max\", \"Largest mtu value that can be tried for discovery.\" },\n83\t    { picoquic_option_SNI, 'n', \"sni\", 1, \"sni\", \"sni (default: server name)\" },\n84\t    { picoquic_option_ALPN, 'a', \"alpn\", 1, \"alpn\", \"alpn (default function of version)\" },\n85\t    { picoquic_option_ROOT_TRUST_FILE, 't', \"root_trust_file\", 1, \"file\", \"root trust file\" },\n86\t    { picoquic_option_FORCE_ZERO_SHARE, 'z', \"force_zero_share\", 0, \"\", \"Set TLS zero share behavior on client, to force HRR\" },\n87\t    { picoquic_option_CNXID_LENGTH, 'I', \"cnxid_length\", 1, \"length\", \"Length of CNX_ID used by the client, default=8\" },\n88\t    { picoquic_option_Idle_Timeout, 'd', \"idle_timeout\", 1, \"ms\", \"Duration of idle timeout in milliseconds (Default 30,000ms)\" },\n89\t    { picoquic_option_NO_DISK, 'D', \"no_disk\", 0, \"\", \"no disk: do not save received files on disk\" },\n90\t    { picoquic_option_LARGE_CLIENT_HELLO, 'Q', \"large_client_hello\", 0, \"\",\n91\t    \"send a large client hello in order to test post quantum readiness\" },\n92\t    { picoquic_option_Ticket_File_Name, 'T', \"ticket_file\", 1, \"file\", \"File storing the session tickets\" },\n93\t    { picoquic_option_Token_File_Name, 'N', \"token_file\", 1, \"file\", \"File storing the new tokens\" },\n94\t    { picoquic_option_Socket_buffer_size, 'B', \"so_buf_size\", 1, \"number\", \"Set buffer size with SO_SNDBUF SO_RCVBUF\" },\n95\t    { picoquic_option_Performance_Log, 'F', \"log_file_name\", 1, \"file\", \"Append performance reports to performance log\" },\n96\t    { picoquic_option_Preemptive_Repeat, 'V', \"preemptive_repeat\", 0, \"\", \"enable preemptive repeat\" },\n97\t    { picoquic_option_Version_Upgrade, 'U', \"version_upgrade\", 1, \"\", \"Version upgrade if server agrees, e.g. -U 6b3343cf\" },\n98\t    { picoquic_option_No_GSO, '0', \"no_gso\", 0, \"\", \"Do not use UDP GSO or equivalent\" },\n99\t    { picoquic_option_BDP_frame, 'j', \"bdp\", 1, \"number\", \"use bdp extension frame(1) or don\\'t (0). Default=0\" },\n100\t    { picoquic_option_CWIN_MAX, 'W', \"cwin_max\", 1, \"bytes\", \"Max value for CWIN. Default=UINT64_MAX\"},\n101\t#ifndef PICOQUIC_WITHOUT_SSLKEYLOG\n102\t    { picoquic_option_SSLKEYLOG, '8', \"sslkeylog\", 0, \"\", \"Enable SSLKEYLOG\" },\n103\t#endif\n104\t    { picoquic_option_AddressDiscovery, 'J', \"addr_disc\", 1, \"mode\", \"provider (0), receiver (1) or both (2).\"},\n105\t    { picoquic_option_ECH_server, 'E' , \"ech_s\", 2, \"key config\", \"ECH private key file, config file. Default= no ECH on server.\"},\n106\t    { picoquic_option_ECH_init, 'y', \"ech_init\", 1, \"public_name\", \"Create an ECH configuration before applying the `ech_s` parameter.\"},\n107\t    { picoquic_option_ECH_client, 'K', \"ech_c\", 1, \"base64\", \"ECH configuration for the client connection, base64 encoded.\"},\n108\t    { picoquic_option_FLOW_CONTROL_MAX, 'Z', \"flow_control_max\", 1, \"bytes\", \"Set the flow control's initial max data.\"},\n109\t    { picoquic_option_Preferred_V4, '4', \"preferred_v4\", 1, \"ip[:port]\", \"Preferred address for v4 connections.\" },\n110\t    { picoquic_option_Preferred_V6, '6', \"preferred_v6\", 1, \"ipv6[:port]\", \"Preferred address for v6 connections.\" },\n111\t    { picoquic_option_HELP, 'h', \"help\", 0, \"\", \"This help message\" }\n112\t};\n113\t\n114\tstatic size_t option_table_size = sizeof(option_table) / sizeof(option_table_line_t);\n115\t\n116\tstatic uint32_t config_parse_target_version(char const* v_arg)\n117\t{\n118\t    /* Expect the version to be encoded in base 16 */\n119\t    uint32_t v = 0;\n120\t    char const* x = v_arg;\n121\t\n122\t    while (*x != 0) {\n123\t        int c = *x;\n124\t\n125\t        if (c >= '0' && c <= '9') {\n126\t            c -= '0';\n127\t        }\n128\t        else if (c >= 'a' && c <= 'f') {\n129\t            c -= 'a';\n130\t            c += 10;\n131\t        }\n132\t        else if (c >= 'A' && c <= 'F') {\n133\t            c -= 'A';\n134\t            c += 10;\n135\t        }\n136\t        else {\n137\t            v = 0;\n138\t            break;\n139\t        }\n140\t        v *= 16;\n141\t        v += c;\n142\t        x++;\n143\t    }\n144\t\n145\t    return v;\n146\t}\n147\t\n148\tstatic int config_set_string_param(char const** v, const option_param_t* params, int nb_param, int x)\n149\t{\n150\t    int ret = 0;\n151\t    char* p_dup = NULL;\n152\t\n153\t    if (*v != NULL) {\n154\t        free((void*)*v);\n155\t        *v = NULL;\n156\t    }\n157\t\n158\t    if (params != NULL && x >= 0 && x < nb_param && params[x].param != NULL)\n159\t    {\n160\t        size_t alloc_length = params[x].length + 1;\n161\t\n162\t        if (params[x].length > 0 && alloc_length > params[x].length) {\n163\t            p_dup = (char *)malloc(alloc_length);\n164\t        }\n165\t        if (p_dup != NULL) {\n166\t            memcpy(p_dup, params[x].param, params[x].length);\n167\t            p_dup[params[x].length] = 0;\n168\t            *v = (char const*)p_dup;\n169\t        }\n170\t        else {\n171\t            fprintf(stderr, \"Cannot allocate %zu characters\\n\", params[x].length);\n172\t            ret = -1;\n173\t        }\n174\t    }\n175\t    else {\n176\t        ret = -1;\n177\t    }\n178\t    return ret;\n179\t}\n180\t\n181\tstatic char* config_optval_string(char* buffer, size_t buffer_max, const char* p, size_t p_length)\n182\t{\n183\t    if (p_length + 1 > buffer_max) {\n184\t        p_length = buffer_max - 1;\n185\t    }\n186\t    memcpy(buffer, p, p_length);\n187\t    buffer[p_length] = 0;\n188\t    return buffer;\n189\t}\n190\t\n191\tstatic char* config_optval_param_string(char* buffer, size_t buffer_max, const option_param_t* params, int nb_param, int x)\n192\t{\n193\t    if (params == NULL || x < 0 || x >= nb_param) {\n194\t        buffer[0] = 0;\n195\t        return buffer;\n196\t    }\n197\t    else {\n198\t        return config_optval_string(buffer, buffer_max, params[x].param, params[x].length);\n199\t    }\n200\t}\n201\t\n202\tint config_atoi(const option_param_t* params, int nb_param, int x, int* ret)\n203\t{\n204\t    int v = 0;\n205\t\n206\t    if (params == NULL || x < 0 || x >= nb_param) {\n207\t        *ret = -1;\n208\t    }\n209\t    else {\n210\t        for (size_t i = 0; i < params[x].length; i++) {\n211\t            int c = params[x].param[i] - '0';\n212\t            if (c < 0 || c > 9) {\n213\t                v = -1;\n214\t                *ret = -1;\n215\t                break;\n216\t            }\n217\t            else {\n218\t                v *= 10;\n219\t                v += c;\n220\t            }\n221\t        }\n222\t    }\n223\t    return v;\n224\t}\n225\t\n226\tint config_set_port(picoquic_quic_config_t* config, char const * port_string)\n227\t{\n228\t    int ret = 0;\n229\t    char opval_buffer[256];\n230\t    char const* p = port_string;\n231\t    int is_port_shared = 0;\n232\t    int p1 = 0;\n233\t    int p2 = 0;\n234\t    int nb_threads = 0;\n235\t\n236\t    if (*p == 'S') {\n237\t        is_port_shared = 1;\n238\t        p++;\n239\t    }\n240\t    while (*p >= '0' && *p <= '9') {\n241\t        p1 *= 10;\n242\t        p1 += (*p - '0');\n243\t        p++;\n244\t    }\n245\t    if (*p == ':') {\n246\t        p++;\n247\t        while (*p >= '0' && *p <= '9') {\n248\t            p2 *= 10;\n249\t            p2 += (*p - '0');\n250\t            p++;\n251\t        }\n252\t    }\n253\t    if (*p == '*') {\n254\t        p++;\n255\t        while (*p >= '0' && *p <= '9') {\n256\t            nb_threads *= 10;\n257\t            nb_threads += (*p - '0');\n258\t            p++;\n259\t        }\n260\t    }\n261\t    if (*p != 0 || p1 < 0 || p1 > 65535 || p2 < 0 || p2 > 65535) {\n262\t        fprintf(stderr, \"Invalid port: %s\\n\", config_optval_string(opval_buffer, 256, port_string, strlen(port_string)));\n263\t        ret = -1;\n264\t    }\n265\t    else {\n266\t        config->server_port = (uint16_t)p1;\n267\t        config->local_port = (uint16_t)p2;\n268\t        config->is_port_shared = is_port_shared;\n269\t        config->nb_threads = nb_threads;\n270\t    }\n271\t    return ret;\n272\t}\n273\t\n274\tstatic int config_set_option(option_table_line_t* option_desc, option_param_t* params, int nb_params, picoquic_quic_config_t* config)\n275\t{\n276\t    int ret = 0;\n277\t    char opval_buffer[256];\n278\t\n279\t    switch (option_desc->option_num) {\n280\t    case picoquic_option_CERT:\n281\t        ret = config_set_string_param(&config->server_cert_file, params, nb_params, 0);\n282\t        break;\n283\t    case picoquic_option_KEY:\n284\t        ret = config_set_string_param(&config->server_key_file, params, nb_params, 0);\n285\t        break;\n286\t    case picoquic_option_SERVER_PORT:\n287\t        ret = config_set_port(config, params->param);\n288\t        if (ret != 0) {\n289\t            fprintf(stderr, \"Invalid port: %s\\n\", config_optval_param_string(opval_buffer, 256, params, nb_params, 0));\n290\t        }\n291\t        break;\n292\t    case picoquic_option_PROPOSED_VERSION:\n293\t        if ((config->proposed_version = config_parse_target_version(config_optval_param_string(opval_buffer, 256, params, nb_params, 0))) <= 0) {\n294\t            fprintf(stderr, \"Invalid version: %s\\n\", config_optval_param_string(opval_buffer, 256, params, nb_params, 0));\n295\t            ret = -1;\n296\t        }\n297\t        break;\n298\t    case picoquic_option_OUTDIR:\n299\t        ret = config_set_string_param(&config->out_dir, params, nb_params, 0);\n300\t        break;\n301\t    case picoquic_option_WWWDIR:\n302\t        ret = config_set_string_param(&config->www_dir, params, nb_params, 0);\n303\t        break;\n304\t    case picoquic_option_MAX_CONNECTIONS: {\n305\t        int v = config_atoi(params, nb_params, 0, &ret);\n306\t        if (ret != 0 || v <= 0 ) {\n307\t            fprintf(stderr, \"Invalid max connections: %s\\n\", config_optval_param_string(opval_buffer, 256, params, nb_params, 0));\n308\t            ret = (ret == 0) ? -1 : ret;\n309\t        }\n310\t        else {\n311\t            config->nb_connections = (uint32_t)v;\n312\t        }\n313\t        break;\n314\t    }\n315\t    case picoquic_option_DO_RETRY:\n316\t        config->do_retry = 1;\n317\t        break;\n318\t    case picoquic_option_INITIAL_RANDOM: {\n319\t        int v = config_atoi(params, nb_params, 0, &ret);\n320\t        if (ret != 0 || v < 0 || v > 2) {\n321\t            fprintf(stderr, \"Invalid initial random value: %s\\n\", config_optval_param_string(opval_buffer, 256, params, nb_params, 0));\n322\t            ret = (ret == 0) ? -1 : ret;\n323\t        }\n324\t        else {\n325\t            config->initial_random = v;\n326\t        }\n327\t        break;\n328\t    }\n329\t    case picoquic_option_RESET_SEED:\n330\t        config->has_reset_seed = 1;\n331\t        ret = (picoquic_parse_hexa(params[0].param, params[0].length, config->reset_seed, sizeof(config->reset_seed)) ==\n332\t            sizeof(config->reset_seed)) ? 0 : -1;\n333\t        if (ret != 0) {\n334\t            fprintf(stderr, \"Invalid reset seed: %s\\n\", config_optval_param_string(opval_buffer, 256, params, nb_params, 0));\n335\t        }\n336\t        break;\n337\t    case picoquic_option_DisablePortBlocking:\n338\t        config->disable_port_blocking = 1;\n339\t        break;\n340\t#ifndef PICOQUIC_WITHOUT_SSLKEYLOG\n341\t    case picoquic_option_SSLKEYLOG:\n342\t        config->enable_sslkeylog = 1;\n343\t        break;\n344\t#endif\n345\t    case picoquic_option_SOLUTION_DIR:\n346\t        ret = config_set_string_param(&config->solution_dir, params, nb_params, 0);\n347\t        break;\n348\t    case picoquic_option_CC_ALGO:\n349\t        ret = config_set_string_param(&config->cc_algo_id, params, nb_params, 0);\n350\t        break;\n351\t    case picoquic_option_CC_OPTION:\n352\t        ret = config_set_string_param(&config->cc_algo_option_string, params, nb_params, 0);\n353\t        break;\n354\t    case picoquic_option_SPINBIT: {\n355\t        int v = config_atoi(params, nb_params, 0, &ret);\n356\t        if (ret != 0 || v < 0 || v > (int)picoquic_spinbit_on) {\n357\t            fprintf(stderr, \"Invalid spinbit policy: %s\\n\", config_optval_param_string(opval_buffer, 256, params, nb_params, 0));\n358\t            ret = (ret == 0) ? -1 : ret;\n359\t        }\n360\t        else {\n361\t            config->spinbit_policy = (picoquic_spinbit_version_enum)v;\n362\t        }\n363\t        break;\n364\t    }\n365\t    case picoquic_option_LOSSBIT: {\n366\t        int v = config_atoi(params, nb_params, 0, &ret);\n367\t        if (ret != 0 || v < 0 || v >(int)picoquic_lossbit_send_receive) {\n368\t            fprintf(stderr, \"Invalid lossbit policy: %s\\n\", config_optval_param_string(opval_buffer, 256, params, nb_params, 0));\n369\t            ret = (ret == 0) ? -1 : ret;\n370\t        }\n371\t        else {\n372\t            config->lossbit_policy = (picoquic_lossbit_version_enum)v;\n373\t        }\n374\t        break;\n375\t    }\n376\t    case picoquic_option_MULTIPATH: \n377\t        config->multipath_option = 1;\n378\t        break;\n379\t    case picoquic_option_DEST_IF:\n380\t        config->dest_if = config_atoi(params, nb_params, 0, &ret);\n381\t        break;\n382\t    case picoquic_option_CIPHER_SUITE:\n383\t        config->cipher_suite_id = config_atoi(params, nb_params, 0, &ret);\n384\t        break;\n385\t    case picoquic_option_INIT_CNXID:\n386\t        ret = config_set_string_param(&config->cnx_id_cbdata, params, nb_params, 0);\n387\t        break;\n388\t    case picoquic_option_LOG_FILE:\n389\t        ret = config_set_string_param(&config->log_file, params, nb_params, 0);\n390\t        break;\n391\t    case picoquic_option_LONG_LOG:\n392\t        config->use_long_log = 1;\n393\t        break;\n394\t    case picoquic_option_BINLOG_DIR:\n395\t        ret = config_set_string_param(&config->bin_dir, params, nb_params, 0);\n396\t        break;\n397\t    case picoquic_option_QLOG_DIR:\n398\t        ret = config_set_string_param(&config->qlog_dir, params, nb_params, 0);\n399\t        break;\n400\t    case picoquic_option_MTU_MAX:\n401\t        config->mtu_max = config_atoi(params, nb_params, 0, &ret);\n402\t        if (config->mtu_max <= 0 || config->mtu_max > PICOQUIC_MAX_PACKET_SIZE) {\n403\t            fprintf(stderr, \"Invalid max mtu: %s\\n\", config_optval_param_string(opval_buffer, 256, params, nb_params, 0));\n404\t            ret = -1;\n405\t        }\n406\t        break;\n407\t    case picoquic_option_SNI:\n408\t        ret = config_set_string_param(&config->sni, params, nb_params, 0);\n409\t        break;\n410\t    case picoquic_option_ALPN:\n411\t        ret = config_set_string_param(&config->alpn, params, nb_params, 0);\n412\t        break;\n413\t    case picoquic_option_ROOT_TRUST_FILE:\n414\t        ret = config_set_string_param(&config->root_trust_file, params, nb_params, 0);\n415\t        break;\n416\t    case picoquic_option_FORCE_ZERO_SHARE:\n417\t        config->force_zero_share = 1;\n418\t        break;\n419\t    case picoquic_option_CNXID_LENGTH:\n420\t        config->cnx_id_length = config_atoi(params, nb_params, 0, &ret);\n421\t        if (config->cnx_id_length < 0 || config->cnx_id_length > PICOQUIC_CONNECTION_ID_MAX_SIZE) {\n422\t            fprintf(stderr, \"Invalid connection id length: %s\\n\", config_optval_param_string(opval_buffer, 256, params, nb_params, 0));\n423\t            ret = -1;\n424\t        }\n425\t        break;\n426\t    case picoquic_option_Idle_Timeout:\n427\t        config->idle_timeout = config_atoi(params, nb_params, 0, &ret);\n428\t        if (config->idle_timeout < 0) {\n429\t            fprintf(stderr, \"Invalid idle timer: %s\\n\", config_optval_param_string(opval_buffer, 256, params, nb_params, 0));\n430\t            ret = -1;\n431\t        }\n432\t        break;\n433\t    case picoquic_option_NO_DISK:\n434\t        config->no_disk = 1;\n435\t        break;\n436\t    case picoquic_option_LARGE_CLIENT_HELLO:\n437\t        config->large_client_hello = 1;\n438\t        break;\n439\t    case picoquic_option_Ticket_File_Name:\n440\t        ret = config_set_string_param(&config->ticket_file_name, params, nb_params, 0);\n441\t        break;\n442\t    case picoquic_option_Token_File_Name:\n443\t        ret = config_set_string_param(&config->token_file_name, params, nb_params, 0);\n444\t        break;\n445\t    case picoquic_option_Socket_buffer_size:\n446\t        config->socket_buffer_size = config_atoi(params, nb_params, 0, &ret);\n447\t        if (config->socket_buffer_size < 0 ) {\n448\t            fprintf(stderr, \"Invalid socket_buffer_size: %s\\n\", config_optval_param_string(opval_buffer, 256, params, nb_params, 0));\n449\t            ret = -1;\n450\t        }\n451\t        break;\n452\t    case picoquic_option_Performance_Log:\n453\t        ret = config_set_string_param(&config->performance_log, params, nb_params, 0);\n454\t        break;\n455\t    case picoquic_option_Preemptive_Repeat:\n456\t        config->do_preemptive_repeat = 1;\n457\t        break;\n458\t    case picoquic_option_Version_Upgrade:\n459\t        if ((config->desired_version = config_parse_target_version(config_optval_param_string(opval_buffer, 256, params, nb_params, 0))) <= 0) {\n460\t            fprintf(stderr, \"Invalid version: %s\\n\", config_optval_param_string(opval_buffer, 256, params, nb_params, 0));\n461\t            ret = -1;\n462\t        }\n463\t        break;\n464\t    case picoquic_option_No_GSO:\n465\t        config->do_not_use_gso = 1;\n466\t        break;\n467\t    case picoquic_option_BDP_frame: {\n468\t        int v = config_atoi(params, nb_params, 0, &ret);\n469\t        if (ret != 0 || v < 0 || v > 1) {\n470\t            fprintf(stderr, \"Invalid bdp option: %s\\n\", config_optval_param_string(opval_buffer, 256, params, nb_params, 0));\n471\t            ret = (ret == 0) ? -1 : ret;\n472\t        }\n473\t        else {\n474\t            config->bdp_frame_option = v;\n475\t        }\n476\t        break;\n477\t    }\n478\t    case picoquic_option_CWIN_MAX:{\n479\t        int v = config_atoi(params, nb_params, 0, &ret);\n480\t        if (ret != 0 || v < 0) {\n481\t            fprintf(stderr, \"Invalid cwin max option: %s\\n\", config_optval_param_string(opval_buffer, 256, params, nb_params, 0));\n482\t            ret = (ret == 0) ? -1 : ret;\n483\t        }\n484\t        else {\n485\t            config->cwin_max = (v==0)?UINT64_MAX:v;\n486\t        }\n487\t        break;\n488\t    }\n489\t    case picoquic_option_AddressDiscovery: {\n490\t        int v = config_atoi(params, nb_params, 0, &ret);\n491\t        if (ret != 0 || v < 0 || v > 2) {\n492\t            fprintf(stderr, \"Invalid address discovery option: %s\\n\", config_optval_param_string(opval_buffer, 256, params, nb_params, 0));\n493\t            ret = (ret == 0) ? -1 : ret;\n494\t        }\n495\t        else {\n496\t            config->address_discovery_mode = v + 1;\n497\t        }\n498\t        break;\n499\t    }\n500\t    case picoquic_option_ECH_server: {\n501\t        ret = config_set_string_param(&config->ech_key_file, params, nb_params, 0);\n502\t        if (ret == 0) {\n503\t            ret = config_set_string_param(&config->ech_config_file, params, nb_params, 1);\n504\t        }\n505\t        break;\n506\t    }\n507\t    case picoquic_option_ECH_init: {\n508\t        ret = config_set_string_param(&config->ech_public_name, params, nb_params, 0);\n509\t        break;\n510\t    }\n511\t    case picoquic_option_ECH_client: {\n512\t        if (nb_params != 1) {\n513\t            ret = -1;\n514\t        }\n515\t        else if (strcmp(params[0].param, \"-\") == 0) {\n516\t            config->ech_target = NULL;\n517\t            config->ech_target_len = SIZE_MAX;\n518\t        }\n519\t        else{\n520\t            ret = picoquic_base64_decode(&config->ech_target, &config->ech_target_len, params[0].param);\n521\t        }\n522\t        if (ret != 0) {\n523\t            fprintf(stderr, \"Incorrect base64 format: %s\\n\", params[0].param);\n524\t            ret = (ret == 0) ? -1 : ret;\n525\t        }\n526\t        break;\n527\t    }\n528\t    case picoquic_option_FLOW_CONTROL_MAX: {\n529\t        int v = config_atoi(params, nb_params, 0, &ret);\n530\t        if (ret != 0 || v < 0) {\n531\t            fprintf(stderr, \"Invalid flow control max option: %s\\n\", config_optval_param_string(opval_buffer, 256, params, nb_params, 0));\n532\t            ret = (ret == 0) ? -1 : ret;\n533\t        }\n534\t        else {\n535\t            config->flow_control_max = v;\n536\t        }\n537\t        break;\n538\t    }\n539\t    case picoquic_option_Preferred_V4:\n540\t        ret = config_set_string_param(&config->preferred_address_v4, params, nb_params, 0);\n541\t        break;\n542\t    case picoquic_option_Preferred_V6:\n543\t        ret = config_set_string_param(&config->preferred_address_v6, params, nb_params, 0);\n544\t        break;\n545\t    case picoquic_option_HELP:\n546\t        ret = -1;\n547\t        break;\n548\t    default:\n549\t        ret = -1;\n550\t        break;\n551\t    }\n552\t    return ret;\n553\t}\n554\t\n555\tint picoquic_config_option_letters(char* option_string, size_t string_max, size_t * string_length)\n556\t{\n557\t    size_t l = 0;\n558\t    int ret = 0;\n559\t\n560\t    for (size_t i = 0; l + 1 < string_max && i < option_table_size; i++) {\n561\t        option_string[l++] = option_table[i].option_letter;\n562\t        if (option_table[i].nb_params_required > 0) {\n563\t            if (l + 1 < string_max) {\n564\t                option_string[l++] = ':';\n565\t            }\n566\t            else {\n567\t                l--;\n568\t                ret = -1;\n569\t                break;\n570\t            }\n571\t        }\n572\t    }\n573\t    option_string[l] = 0;\n574\t    if (string_length != NULL) {\n575\t        *string_length = l;\n576\t    }\n577\t    return ret;\n578\t}\n579\t\n580\tvoid picoquic_config_usage_file(FILE* F)\n581\t{\n582\t    fprintf(F, \"Picoquic options:\\n\");\n583\t    for (size_t i = 0; i < option_table_size; i++) {\n584\t        size_t spacer = strlen(option_table[i].param_sample);\n585\t        fprintf(F, \"  -%c %s\", option_table[i].option_letter, option_table[i].param_sample);\n586\t        while (spacer++ < 12) {\n587\t            putc(' ', F);\n588\t        }\n589\t        fprintf(F, \" %s\\n\", option_table[i].option_help);\n590\t        if (option_table[i].option_num == picoquic_option_CC_ALGO){\n591\t            if (picoquic_congestion_control_algorithms != NULL &&\n592\t                picoquic_nb_congestion_control_algorithms > 0) {\n593\t                /* Add a line with supported values. */\n594\t                for (size_t j = 0; j < 18; j++) {\n595\t                    putc(' ', F);\n596\t                }\n597\t                for (size_t k = 0; k < picoquic_nb_congestion_control_algorithms; k++) {\n598\t                    if (k != 0) {\n599\t                        fprintf(F, \", \");\n600\t                    }\n601\t                    fprintf(F, \"%s\", picoquic_congestion_control_algorithms[k]->congestion_algorithm_id);\n602\t                }\n603\t                fprintf(F, \".\\n\");\n604\t            }\n605\t        }\n606\t    }\n607\t}\n608\t\n609\tvoid picoquic_config_usage(void)\n610\t{\n611\t    picoquic_config_usage_file(stderr);\n612\t}\n613\t\n614\tint picoquic_config_set_option(picoquic_quic_config_t* config, picoquic_option_enum_t option_num, const char * opt_val)\n615\t{\n616\t    int ret = 0;\n617\t    option_table_line_t* option_desc = NULL;\n618\t    option_param_t params[1];\n619\t    int nb_params = 0;\n620\t\n621\t    for (size_t i = 0; i < option_table_size; i++) {\n622\t        if (option_table[i].option_num == option_num) {\n623\t            option_desc = &option_table[i];\n624\t        }\n625\t    }\n626\t    if (option_desc == NULL) {\n627\t        fprintf(stderr, \"Unknow option number: %d\\n\", option_num);\n628\t        ret = -1;\n629\t    }\n630\t    else{\n631\t        if (opt_val != NULL) {\n632\t            params[0].param = opt_val;\n633\t            params[0].length = strlen(opt_val);\n634\t            nb_params = 1;\n635\t        }\n636\t        ret = config_set_option(option_desc, params, nb_params, config);\n637\t    }\n638\t    return ret;\n639\t}\n640\t\n641\tint picoquic_config_get_option_char_index(int opt)\n642\t{\n643\t    int option_index = -1;\n644\t\n645\t    for (size_t i = 0; i < option_table_size; i++) {\n646\t        if (option_table[i].option_letter == opt) {\n647\t            option_index = (int)i;\n648\t            break;\n649\t        }\n650\t    }\n651\t    return option_index;\n652\t}\n653\t\n654\tint picoquic_config_get_option_name_index(char const * s, size_t l)\n655\t{\n656\t    int option_index = -1;\n657\t\n658\t    for (size_t i = 0; i < option_table_size; i++) {\n659\t        if (strncmp(s, option_table[i].option_name, l) == 0) {\n660\t            option_index = (int)i;\n661\t            break;\n662\t        }\n663\t    }\n664\t    return option_index;\n665\t}\n666\t\n667\tint picoquic_config_get_command_line_option_index(char const* opt_string)\n668\t{\n669\t    int option_index = -1;\n670\t\n671\t    if (opt_string[0] == '-' && opt_string[1] != 0) {\n672\t        if (opt_string[2] == 0) {\n673\t            option_index = picoquic_config_get_option_char_index(opt_string[1]);\n674\t        }\n675\t        else if (opt_string[1] == '-' && opt_string[2] != 0) {\n676\t            char const* opt_name = opt_string + 2;\n677\t            option_index = picoquic_config_get_option_name_index(opt_name, strlen(opt_name));\n678\t        }\n679\t    }\n680\t    return option_index;\n681\t}\n682\t\n683\tint picoquic_get_command_line_option_value(int option_index, char const * opt_string, int* p_optind, const char** argv,\n684\t    int argc, char const* optarg, picoquic_quic_config_t* config)\n685\t{\n686\t    int ret = 0;\n687\t    option_param_t params[5];\n688\t    int nb_params = 0;\n689\t\n690\t    if (option_table[option_index].nb_params_required > 0) {\n691\t        params[0].param = optarg;\n692\t        if (optarg == NULL) {\n693\t            fprintf(stderr, \"option %s requires %d arguments\\n\", opt_string, option_table[option_index].nb_params_required);\n694\t            ret = -1;\n695\t        }\n696\t        else {\n697\t            params[0].length = strlen(optarg);\n698\t            nb_params++;\n699\t            while (nb_params < option_table[option_index].nb_params_required) {\n700\t                if (*p_optind + 1 > argc) {\n701\t                    fprintf(stderr, \"option %s requires %d arguments\\n\", opt_string, option_table[option_index].nb_params_required);\n702\t                    ret = -1;\n703\t                    break;\n704\t                }\n705\t                else {\n706\t                    params[nb_params].param = argv[*p_optind];\n707\t                    params[nb_params].length = (int)strlen(argv[*p_optind]);\n708\t                    nb_params++;\n709\t                    *p_optind += 1;\n710\t                }\n711\t            }\n712\t        }\n713\t    }\n714\t\n715\t    if (ret == 0) {\n716\t        ret = config_set_option(&option_table[option_index], params, nb_params, config);\n717\t    }\n718\t\n719\t    return ret;\n720\t}\n721\t\n722\tint picoquic_config_command_line(int opt, int * p_optind, int argc, char const ** argv, char const* optarg, picoquic_quic_config_t * config)\n723\t{\n724\t    int ret = 0;\n725\t    int option_index = -1;\n726\t    char opt_string[3] = { '-', 0, 0 };\n727\t\n728\t    opt_string[1] = (char)opt;\n729\t    option_index = picoquic_config_get_option_char_index(opt);\n730\t\n731\t    if (option_index == -1) {\n732\t        fprintf(stderr, \"Unknown option: -%c\\n\", opt);\n733\t        ret = -1;\n734\t    }\n735\t    else {\n736\t        ret = picoquic_get_command_line_option_value(option_index, opt_string, p_optind,\n737\t            argv, argc, optarg, config);\n738\t    }\n739\t    return ret;\n740\t}\n741\t\n742\tint picoquic_config_command_line_ex(char const * opt_string, int* p_optind, int argc, char const** argv, char const* optarg, picoquic_quic_config_t* config)\n743\t{\n744\t    int ret = 0;\n745\t    int option_index = -1;\n746\t\n747\t    option_index = picoquic_config_get_command_line_option_index(opt_string);\n748\t\n749\t    if (option_index == -1) {\n750\t        fprintf(stderr, \"Unknown option: %s\\n\", opt_string);\n751\t    }\n752\t    else {\n753\t        ret = picoquic_get_command_line_option_value(option_index, opt_string, p_optind,\n754\t            argv, argc, optarg, config);\n755\t    }\n756\t    return ret;\n757\t}\n758\t\n759\t#if 0\n760\t/* Reading parameters from a file instead of the command line.\n761\t* Apparently never used, also not tested.\n762\t */\n763\tint picoquic_config_file(char const* file_name, picoquic_quic_config_t* config)\n764\t{\n765\t    int ret = 0;\n766\t    FILE* F = picoquic_file_open(file_name, \"r\");\n767\t    if (F == NULL) {\n768\t        DBG_PRINTF(\"Could not open configuration file: %s\", file_name);\n769\t        ret = -1;\n770\t    }\n771\t    else {\n772\t        char line[1024];\n773\t        int line_number = 0;\n774\t\n775\t        while (fgets(line, sizeof(line), F) != NULL && ret == 0) {\n776\t            /* Parse the line. Expect format: <arg_id>\":\" spaces* argv1 [space ^spaces argvn]* */\n777\t            int offset = skip_spaces(line, 0);\n778\t            int name_offset;\n779\t            int name_length;\n780\t            option_param_t params[5];\n781\t            int nb_params;\n782\t            int option_index = -1;\n783\t\n784\t            line_number++;\n785\t            name_offset = offset;\n786\t            offset = skip_name(line, name_offset);\n787\t            if (offset <= name_offset) {\n788\t                /* Empty line */\n789\t            }\n790\t            else {\n791\t                name_length = offset - name_offset;\n792\t                /* Parse the option parameters, up to 5 of them */\n793\t                offset = parse_line_params(line, offset, params, 5, &nb_params);\n794\t                /* Recognize the option and apply the parameters  */\n795\t                for (size_t i = 0; i < option_table_size; i++) {\n796\t                    if (compare_option_name(line, name_offset, (size_t)name_length, option_table[i].option_name) == 0) {\n797\t                        option_index = (int)i;\n798\t                        break;\n799\t                    }\n800\t                }\n801\t\n802\t                if (option_index == -1) {\n803\t                    char buffer[256];\n804\t                    fprintf(stderr, \"Line %d, unknown option: -%s\\n\", line_number,\n805\t                        config_optval_string(buffer, 256, line + name_offset, name_length));\n806\t                    ret = -1;\n807\t                }\n808\t                else {\n809\t                    if (option_table[option_index].nb_params_required != nb_params) {\n810\t                        fprintf(stderr, \"Line %d, option %s requires %d arguments, %d present\\n\",\n811\t                            line_number,\n812\t                            option_table[option_index].option_name,\n813\t                            option_table[option_index].nb_params_required,\n814\t                            nb_params);\n815\t                        ret = -1;\n816\t                    }\n817\t                }\n818\t\n819\t                if (ret == 0) {\n820\t                    offset = skip_name(line, offset);\n821\t                    if (line[offset] != 0 && line[offset] != '#') {\n822\t                        fprintf(stderr, \"Line %d, unexpected character at position %d\\n\", line_number, offset);\n823\t                    }\n824\t                }\n825\t\n826\t                if (ret == 0) {\n827\t                    ret = config_set_option(&option_table[option_index], params, nb_params, config);\n828\t                }\n829\t\n830\t\n831\t            }\n832\t        }\n833\t        picoquic_file_close(F);\n834\t    }\n835\t\n836\t    return ret;\n837\t}\n838\t#endif\n839\t\n840\t/* Create a QUIC Context based on configuration data.\n841\t * Arguments from configuration:\n842\t * - uint32_t nb_connections,\n843\t * - char const* cert_file_name,\n844\t * - char const* key_file_name,\n845\t * - char const * cert_root_file_name,\n846\t * - char const* default_alpn,\n847\t * - picoquic_connection_id_cb_fn cnx_id_callback,\n848\t * - void* cnx_id_callback_data,\n849\t * - uint8_t reset_seed[PICOQUIC_RESET_SECRET_SIZE],\n850\t * - char const* ticket_file_name,\n851\t * - const uint8_t* ticket_encryption_key,\n852\t * - size_t ticket_encryption_key_length\n853\t * Arguments from program:\n854\t * - picoquic_stream_data_cb_fn default_callback_fn,\n855\t * - void* default_callback_ctx,\n856\t * - uint64_t current_time,\n857\t * - uint64_t* p_simulated_time,\n858\t */\n859\t\n860\tpicoquic_quic_t* picoquic_create_and_configure(picoquic_quic_config_t* config,\n861\t    picoquic_stream_data_cb_fn default_callback_fn,\n862\t    void* default_callback_ctx,\n863\t    uint64_t current_time,\n864\t    uint64_t* p_simulated_time)\n865\t{\n866\t    /* Create context */\n867\t    /* TODO: padding policy\n868\t     * TODO: mtu max accessor\n869\t     * TODO: set supported CC without linking every option\n870\t     * TODO: set logging option without linking every option\n871\t     * TODO: set key log file option\n872\t     */\n873\t    picoquic_quic_t* quic = picoquic_create(\n874\t        config->nb_connections,\n875\t        config->server_cert_file,\n876\t        config->server_key_file,\n877\t        config->root_trust_file,\n878\t        config->alpn,\n879\t        default_callback_fn,\n880\t        default_callback_ctx,\n881\t        NULL,\n882\t        NULL,\n883\t        (config->has_reset_seed)?(uint8_t*)config->reset_seed : NULL,\n884\t        current_time,\n885\t        p_simulated_time,\n886\t        config->ticket_file_name,\n887\t        config->ticket_encryption_key,\n888\t        config->ticket_encryption_key_length);\n889\t\n890\t    if (quic != NULL) {\n891\t        int ret = 0;\n892\t        picoquic_congestion_algorithm_t const* cc_algo = NULL;\n893\t\n894\t        /* Additional configuration options */\n895\t        /* picoquic_set_alpn_select_fn(qserver, picoquic_demo_server_callback_select_alpn); */\n896\t        if (config->do_retry) {\n897\t            picoquic_set_cookie_mode(quic, 1);\n898\t        }\n899\t        else {\n900\t            /* TODO: option to provide cookie by default or not */\n901\t            picoquic_set_cookie_mode(quic, 2);\n902\t        }\n903\t\n904\t        if (config->cc_algo_id != NULL) {\n905\t            cc_algo = picoquic_get_congestion_algorithm(config->cc_algo_id);\n906\t            if (cc_algo == NULL) {\n907\t                fprintf(stderr, \"Unrecognized congestion algorithm: %s. Using BBR isntead.\\n\", config->cc_algo_id);\n908\t            }\n909\t        }\n910\t        if (cc_algo == NULL) {\n911\t            cc_algo = picoquic_bbr_algorithm;\n912\t        }\n913\t\n914\t        picoquic_set_default_congestion_algorithm_ex(quic, cc_algo, config->cc_algo_option_string);\n915\t\n916\t        picoquic_set_default_spinbit_policy(quic, config->spinbit_policy);\n917\t        picoquic_set_default_lossbit_policy(quic, config->lossbit_policy);\n918\t\n919\t        picoquic_set_default_multipath_option(quic, config->multipath_option);\n920\t        picoquic_set_default_idle_timeout(quic, (uint64_t)config->idle_timeout);\n921\t\n922\t        picoquic_set_cwin_max(quic, config->cwin_max);\n923\t        picoquic_set_default_address_discovery_mode(quic, config->address_discovery_mode);\n924\t\n925\t        picoquic_set_preferred_address(&quic->default_tp.preferred_address,\n926\t            config->preferred_address_v4, config->preferred_address_v6, config->local_port);\n927\t\n928\t        if (config->token_file_name) {\n929\t            if (picoquic_load_retry_tokens(quic, config->token_file_name) != 0) {\n930\t                fprintf(stderr, \"No token file present. Will create one as <%s>.\\n\", config->token_file_name);\n931\t            }\n932\t        }\n933\t\n934\t        if (config->force_zero_share) {\n935\t            quic->client_zero_share = 1;\n936\t        }\n937\t\n938\t        if (config->mtu_max > 0) {\n939\t            picoquic_set_mtu_max(quic, config->mtu_max);\n940\t        }\n941\t\n942\t        if (config->cnx_id_length != -1) {\n943\t            if (picoquic_set_default_connection_id_length(quic, (uint8_t)config->cnx_id_length) != 0) {\n944\t                fprintf(stderr, \"Could not set CNX-ID length #%d.\\n\", config->cnx_id_length);\n945\t            }\n946\t        }\n947\t\n948\t        /* Cannot set the cnx_id callback here, because it requires libraries\n949\t         * that are not linked by default */\n950\t\n951\t         /* TODO: parameters to define padding policy */\n952\t        picoquic_set_padding_policy(quic, 39, 128);\n953\t\n954\t        if (config->bin_dir != NULL) {\n955\t            picoquic_set_binlog(quic, config->bin_dir);\n956\t        }\n957\t\n958\t        if (config->qlog_dir != NULL) {\n959\t            picoquic_set_qlog(quic, config->qlog_dir);\n960\t        }\n961\t\n962\t        if (config->log_file != NULL) {\n963\t            picoquic_set_textlog(quic, config->log_file);\n964\t        }\n965\t\n966\t        picoquic_set_log_level(quic, config->use_long_log);\n967\t\n968\t        picoquic_set_preemptive_repeat_policy(quic, config->do_preemptive_repeat);\n969\t\n970\t        picoquic_disable_port_blocking(quic, config->disable_port_blocking);\n971\t\n972\t#ifndef PICOQUIC_WITHOUT_SSLKEYLOG\n973\t        picoquic_enable_sslkeylog(quic, config->enable_sslkeylog);\n974\t#endif\n975\t\n976\t        if (config->initial_random >= 0 && config->initial_random <= 2) {\n977\t            picoquic_set_random_initial(quic, config->initial_random);\n978\t        }\n979\t\n980\t        if (config->cipher_suite_id != 0) {\n981\t            int iana_cipher_suite_code = config->cipher_suite_id;\n982\t            if (config->cipher_suite_id == 20) {\n983\t                iana_cipher_suite_code = PICOQUIC_CHACHA20_POLY1305_SHA256;\n984\t            }\n985\t            else if (config->cipher_suite_id == 128) {\n986\t                iana_cipher_suite_code = PICOQUIC_AES_128_GCM_SHA256;\n987\t            }\n988\t            else if (config->cipher_suite_id == 256) {\n989\t                iana_cipher_suite_code = PICOQUIC_AES_256_GCM_SHA384;\n990\t            }\n991\t            if (picoquic_set_cipher_suite(quic, iana_cipher_suite_code) != 0) {\n992\t                fprintf(stderr, \"Could not set cipher suite #%d.\\n\", config->cipher_suite_id);\n993\t            }\n994\t        }\n995\t\n996\t        if (config->do_retry != 0) {\n997\t            picoquic_set_cookie_mode(quic, 1);\n998\t        }\n999\t        else {\n1000\t            picoquic_set_cookie_mode(quic, 2);\n1001\t        }\n1002\t        /* TODO: control whether to */\n1003\t        /* picoquic_set_key_log_file_from_env(quic); */\n1004\t\n1005\t        picoquic_set_default_bdp_frame_option(quic, config->bdp_frame_option);\n1006\t\n1007\t        if (config->ech_public_name != NULL) {\n1008\t            if (config->ech_key_file == NULL || config->ech_config_file) {\n1009\t                fprintf(stderr, \"Cannot create a configuration if key and config file are not specified.\\n\");\n1010\t            } else {\n1011\t                ret = picoquic_ech_create_config_file(config->ech_public_name, config->ech_key_file, config->ech_config_file);\n1012\t            }\n1013\t        }\n1014\t\n1015\t        if (ret == 0 && (config->ech_key_file != NULL || config->ech_target != NULL)) {\n1016\t            ret = picoquic_ech_configure_quic_ctx(quic, config->ech_key_file, config->ech_config_file);\n1017\t        }\n1018\t\n1019\t        if (ret == 0 && config->flow_control_max > 0)\n1020\t        {\n1021\t            picoquic_set_max_data_control(quic, config->flow_control_max);\n1022\t        }\n1023\t\n1024\t        if (ret != 0) {\n1025\t            /* Something went wrong */\n1026\t            DBG_PRINTF(\"QUIC configuration fails, ret = %d (0x%x)\", ret, ret);\n1027\t            picoquic_free(quic);\n1028\t            quic = NULL;\n1029\t        }\n1030\t    }\n1031\t\n1032\t    return quic;\n1033\t}\n1034\t\n1035\tvoid picoquic_config_init(picoquic_quic_config_t* config)\n1036\t{\n1037\t    memset(config, 0, sizeof(picoquic_quic_config_t));\n1038\t    config->cnx_id_length = -1;\n1039\t    config->nb_connections = 256;\n1040\t    config->initial_random = 3;\n1041\t    config->cwin_max = UINT64_MAX;\n1042\t    config->idle_timeout = PICOQUIC_MICROSEC_HANDSHAKE_MAX / 1000;\n1043\t    config->flow_control_max = 0;\n1044\t}\n1045\t\n1046\tvoid picoquic_config_clear(picoquic_quic_config_t* config)\n1047\t{\n1048\t    if (config->solution_dir != NULL) {\n1049\t        free((void*)config->solution_dir);\n1050\t    }\n1051\t    if (config->server_cert_file != NULL) {\n1052\t        free((void*)config->server_cert_file);\n1053\t    }\n1054\t    if (config->server_key_file != NULL) {\n1055\t        free((void*)config->server_key_file);\n1056\t    }\n1057\t    if (config->log_file != NULL) {\n1058\t        free((void*)config->log_file);\n1059\t    }\n1060\t    if (config->bin_dir != NULL) {\n1061\t        free((void*)config->bin_dir);\n1062\t    }\n1063\t    if (config->qlog_dir != NULL) {\n1064\t        free((void*)config->qlog_dir);\n1065\t    }\n1066\t    if (config->performance_log != NULL) {\n1067\t        free((void*)config->performance_log);\n1068\t    }\n1069\t    if (config->cc_algo_id != NULL) {\n1070\t        free((void*)config->cc_algo_id);\n1071\t    }\n1072\t    if (config->cc_algo_option_string != NULL) {\n1073\t        free((void*)config->cc_algo_option_string);\n1074\t    }\n1075\t    if (config->cnx_id_cbdata != NULL) {\n1076\t        free((void*)config->cnx_id_cbdata);\n1077\t    }\n1078\t    if (config->multipath_alt_config != NULL) {\n1079\t        free((void*)config->multipath_alt_config);\n1080\t    }\n1081\t    if (config->www_dir != NULL) {\n1082\t        free((void*)config->www_dir);\n1083\t    }\n1084\t    if (config->ticket_file_name != NULL) {\n1085\t        free((void*)config->ticket_file_name);\n1086\t    }\n1087\t    if (config->token_file_name != NULL) {\n1088\t        free((void*)config->token_file_name);\n1089\t    }\n1090\t    if (config->sni != NULL) {\n1091\t        free((void*)config->sni);\n1092\t    }\n1093\t    if (config->alpn != NULL) {\n1094\t        free((void*)config->alpn);\n1095\t    }\n1096\t    if (config->out_dir != NULL) {\n1097\t        free((void*)config->out_dir);\n1098\t    }\n1099\t    if (config->root_trust_file != NULL) {\n1100\t        free((void*)config->root_trust_file);\n1101\t    }\n1102\t    if (config->ech_key_file != NULL) {\n1103\t        free((void*)config->ech_key_file);\n1104\t    }\n1105\t    if (config->ech_config_file != NULL) {\n1106\t        free((void*)config->ech_config_file);\n1107\t    }\n1108\t    if (config->ech_public_name != NULL) {\n1109\t        free((void*)config->ech_public_name);\n1110\t    }\n1111\t    if (config->ech_target != NULL) {\n1112\t        free((void*)config->ech_target);\n1113\t    }\n1114\t    if (config->preferred_address_v4 != NULL) {\n1115\t        free((void*)config->preferred_address_v4);\n1116\t    }\n1117\t    if (config->preferred_address_v6 != NULL) {\n1118\t        free((void*)config->preferred_address_v6);\n1119\t    }\n1120\t    picoquic_config_init(config);\n1121\t}\n1122\t\n1123\t/* Set a server context, using more parameters than the simple\n1124\t* creation from configuration.\n1125\t */\n1126\t"}]},"parent_tool_use_id":null,"session_id":"b0ef721e-e3c5-4ce3-b9f2-772ba297c48d","uuid":"e0a38008-be54-4456-b1c6-c756fe411ea8","timestamp":"2026-05-05T16:02:25.672Z","tool_use_result":{"type":"text","file":{"filePath":"/Users/richbarn/Projects/picoquic/picoquic/config.c","content":"/*\n* Author: Christian Huitema\n* Copyright (c) 2020, Private Octopus, Inc.\n* All rights reserved.\n*\n* Permission to use, copy, modify, and distribute this software for any\n* purpose with or without fee is hereby granted, provided that the above\n* copyright notice and this permission notice appear in all copies.\n*\n* THIS SOFTWARE IS PROVIDED BY THE COPYRIGHT HOLDERS AND CONTRIBUTORS \"AS IS\" AND\n* ANY EXPRESS OR IMPLIED WARRANTIES, INCLUDING, BUT NOT LIMITED TO, THE IMPLIED\n* WARRANTIES OF MERCHANTABILITY AND FITNESS FOR A PARTICULAR PURPOSE ARE\n* DISCLAIMED. IN NO EVENT SHALL Private Octopus, Inc. BE LIABLE FOR ANY\n* DIRECT, INDIRECT, INCIDENTAL, SPECIAL, EXEMPLARY, OR CONSEQUENTIAL DAMAGES\n* (INCLUDING, BUT NOT LIMITED TO, PROCUREMENT OF SUBSTITUTE GOODS OR SERVICES;\n* LOSS OF USE, DATA, OR PROFITS; OR BUSINESS INTERRUPTION) HOWEVER CAUSED AND\n* ON ANY THEORY OF LIABILITY, WHETHER IN CONTRACT, STRICT LIABILITY, OR TORT\n* (INCLUDING NEGLIGENCE OR OTHERWISE) ARISING IN ANY WAY OUT OF THE USE OF THIS\n* SOFTWARE, EVEN IF ADVISED OF THE POSSIBILITY OF SUCH DAMAGE.\n*/\n\n/* Manage the configuration options for the QUIC context\n * TODO: do not force linking of binlog, textlog, qlog\n * TODO: review of connection ID function API. Separate parameters?\n */\n\n#include <stdio.h>\n#include <stdint.h>\n#include <stdlib.h>\n#include \"picoquic.h\"\n#include \"picoquic_utils.h\"\n#include \"picoquic_binlog.h\"\n#include \"picoquic_qlog.h\"\n#include \"picoquic_logger.h\"\n#include \"picoquic_unified_log.h\"\n#include \"tls_api.h\"\n#include \"picoquic_config.h\"\n#include \"picoquic_bbr.h\"\n\ntypedef struct st_option_param_t {\n    char const * param;\n    size_t length;\n} option_param_t;\n\ntypedef struct st_option_table_line_t {\n    picoquic_option_enum_t option_num;\n    char option_letter;\n    char const* option_name;\n    int nb_params_required;\n    char const* param_sample;\n    char const* option_help;\n} option_table_line_t;\n\nstatic option_table_line_t option_table[] = {\n    { picoquic_option_CERT, 'c', \"cert\", 1, \"file\", \"cert file\" },\n    { picoquic_option_KEY, 'k', \"key\", 1, \"file\", \"key file\" },\n    { picoquic_option_SERVER_PORT, 'p', \"port\", 1, \"number\", \"server port\" },\n    { picoquic_option_PROPOSED_VERSION, 'v', \"proposed_version\", 1, \"\", \"Version proposed by client, e.g. -v ff000012\" },\n    { picoquic_option_OUTDIR, 'o', \"outdir\", 1, \"folder\", \"Folder where client writes downloaded files, defaults to current directory.\" },\n    { picoquic_option_WWWDIR, 'w', \"wwwdir\", 1, \"folder\", \"Folder containing web pages served by server\" },\n    { picoquic_option_MAX_CONNECTIONS, 'x', \"max_connections\", 1, \"number\",\n    \"Maximum number of concurrent connections, default 256\" },\n    { picoquic_option_DO_RETRY, 'r', \"do_retry\", 0, \"\", \"Do Retry Request\" },\n    { picoquic_option_INITIAL_RANDOM, 'R', \"initial_random\", 1, \"option\", \"Randomize packet number spaces: none(0), initial(1, default), all(2).\" },\n    { picoquic_option_RESET_SEED, 's', \"reset_seed\", 1, \"<32 hex chars>\", \"Reset seed\" },\n    { picoquic_option_DisablePortBlocking, 'X', \"disable_block\", 0, \"\", \"Disable the check for blocked ports\"},\n    { picoquic_option_SOLUTION_DIR, 'S', \"solution_dir\", 1, \"folder\", \"Set the path to the source files to find the default files\" },\n    { picoquic_option_CC_ALGO, 'G', \"cc_algo\", 1, \"cc_algorithm\",\n    \"Use the specified congestion control algorithm. Defaults to bbr. Supported values are:\" },\n    { picoquic_option_CC_OPTION, 'H', \"cco\", 1, \"option\", \"Set option string if required by congestion control algorithm.\"},\n    { picoquic_option_SPINBIT, 'P', \"spinbit\", 1, \"number\", \"Set the default spinbit policy\" },\n    { picoquic_option_LOSSBIT, 'O', \"lossbit\", 1, \"number\", \"Set the default lossbit policy\" },\n    { picoquic_option_MULTIPATH, 'M', \"multipath\", 0, \"\", \"Enable QUIC multipath extension\" },\n    { picoquic_option_DEST_IF, 'e', \"dest_if\", 1, \"if\", \"Send on interface (default: -1)\" },\n    { picoquic_option_CIPHER_SUITE, 'C', \"cipher_suite\", 1, \"cipher_suite_id\", \"specify cipher suite (e.g. -C 20 = chacha20)\" },\n    { picoquic_option_INIT_CNXID, 'i', \"cnxid_params\", 1, \"per-text-lb-spec\", \"See documentation for LB compatible CID configuration\" },\n    { picoquic_option_LOG_FILE, 'l', \"text_log\", 1, \"file\", \"Log file, Log to stdout if file = \\\"-\\\". No text logging if absent.\" },\n    { picoquic_option_LONG_LOG, 'L', \"long_log\", 0, \"\", \"Log all packets. If absent, log stops after 100 packets.\" },\n    { picoquic_option_BINLOG_DIR, 'b', \"binlog_dir\", 1, \"folder\", \"Binary logging to this directory. No binary logging if absent.\" },\n    { picoquic_option_QLOG_DIR, 'q', \"qlog_dir\", 1, \"folder\", \n    \"Qlog logging to this directory. No qlog logging if absent, but qlogs could be produced using picolog if binary logs are available.\" },\n    { picoquic_option_MTU_MAX, 'm', \"mtu_max\", 1, \"mtu_max\", \"Largest mtu value that can be tried for discovery.\" },\n    { picoquic_option_SNI, 'n', \"sni\", 1, \"sni\", \"sni (default: server name)\" },\n    { picoquic_option_ALPN, 'a', \"alpn\", 1, \"alpn\", \"alpn (default function of version)\" },\n    { picoquic_option_ROOT_TRUST_FILE, 't', \"root_trust_file\", 1, \"file\", \"root trust file\" },\n    { picoquic_option_FORCE_ZERO_SHARE, 'z', \"force_zero_share\", 0, \"\", \"Set TLS zero share behavior on client, to force HRR\" },\n    { picoquic_option_CNXID_LENGTH, 'I', \"cnxid_length\", 1, \"length\", \"Length of CNX_ID used by the client, default=8\" },\n    { picoquic_option_Idle_Timeout, 'd', \"idle_timeout\", 1, \"ms\", \"Duration of idle timeout in milliseconds (Default 30,000ms)\" },\n    { picoquic_option_NO_DISK, 'D', \"no_disk\", 0, \"\", \"no disk: do not save received files on disk\" },\n    { picoquic_option_LARGE_CLIENT_HELLO, 'Q', \"large_client_hello\", 0, \"\",\n    \"send a large client hello in order to test post quantum readiness\" },\n    { picoquic_option_Ticket_File_Name, 'T', \"ticket_file\", 1, \"file\", \"File storing the session tickets\" },\n    { picoquic_option_Token_File_Name, 'N', \"token_file\", 1, \"file\", \"File storing the new tokens\" },\n    { picoquic_option_Socket_buffer_size, 'B', \"so_buf_size\", 1, \"number\", \"Set buffer size with SO_SNDBUF SO_RCVBUF\" },\n    { picoquic_option_Performance_Log, 'F', \"log_file_name\", 1, \"file\", \"Append performance reports to performance log\" },\n    { picoquic_option_Preemptive_Repeat, 'V', \"preemptive_repeat\", 0, \"\", \"enable preemptive repeat\" },\n    { picoquic_option_Version_Upgrade, 'U', \"version_upgrade\", 1, \"\", \"Version upgrade if server agrees, e.g. -U 6b3343cf\" },\n    { picoquic_option_No_GSO, '0', \"no_gso\", 0, \"\", \"Do not use UDP GSO or equivalent\" },\n    { picoquic_option_BDP_frame, 'j', \"bdp\", 1, \"number\", \"use bdp extension frame(1) or don\\'t (0). Default=0\" },\n    { picoquic_option_CWIN_MAX, 'W', \"cwin_max\", 1, \"bytes\", \"Max value for CWIN. Default=UINT64_MAX\"},\n#ifndef PICOQUIC_WITHOUT_SSLKEYLOG\n    { picoquic_option_SSLKEYLOG, '8', \"sslkeylog\", 0, \"\", \"Enable SSLKEYLOG\" },\n#endif\n    { picoquic_option_AddressDiscovery, 'J', \"addr_disc\", 1, \"mode\", \"provider (0), receiver (1) or both (2).\"},\n    { picoquic_option_ECH_server, 'E' , \"ech_s\", 2, \"key config\", \"ECH private key file, config file. Default= no ECH on server.\"},\n    { picoquic_option_ECH_init, 'y', \"ech_init\", 1, \"public_name\", \"Create an ECH configuration before applying the `ech_s` parameter.\"},\n    { picoquic_option_ECH_client, 'K', \"ech_c\", 1, \"base64\", \"ECH configuration for the client connection, base64 encoded.\"},\n    { picoquic_option_FLOW_CONTROL_MAX, 'Z', \"flow_control_max\", 1, \"bytes\", \"Set the flow control's initial max data.\"},\n    { picoquic_option_Preferred_V4, '4', \"preferred_v4\", 1, \"ip[:port]\", \"Preferred address for v4 connections.\" },\n    { picoquic_option_Preferred_V6, '6', \"preferred_v6\", 1, \"ipv6[:port]\", \"Preferred address for v6 connections.\" },\n    { picoquic_option_HELP, 'h', \"help\", 0, \"\", \"This help message\" }\n};\n\nstatic size_t option_table_size = sizeof(option_table) / sizeof(option_table_line_t);\n\nstatic uint32_t config_parse_target_version(char const* v_arg)\n{\n    /* Expect the version to be encoded in base 16 */\n    uint32_t v = 0;\n    char const* x = v_arg;\n\n    while (*x != 0) {\n        int c = *x;\n\n        if (c >= '0' && c <= '9') {\n            c -= '0';\n        }\n        else if (c >= 'a' && c <= 'f') {\n            c -= 'a';\n            c += 10;\n        }\n        else if (c >= 'A' && c <= 'F') {\n            c -= 'A';\n            c += 10;\n        }\n        else {\n            v = 0;\n            break;\n        }\n        v *= 16;\n        v += c;\n        x++;\n    }\n\n    return v;\n}\n\nstatic int config_set_string_param(char const** v, const option_param_t* params, int nb_param, int x)\n{\n    int ret = 0;\n    char* p_dup = NULL;\n\n    if (*v != NULL) {\n        free((void*)*v);\n        *v = NULL;\n    }\n\n    if (params != NULL && x >= 0 && x < nb_param && params[x].param != NULL)\n    {\n        size_t alloc_length = params[x].length + 1;\n\n        if (params[x].length > 0 && alloc_length > params[x].length) {\n            p_dup = (char *)malloc(alloc_length);\n        }\n        if (p_dup != NULL) {\n            memcpy(p_dup, params[x].param, params[x].length);\n            p_dup[params[x].length] = 0;\n            *v = (char const*)p_dup;\n        }\n        else {\n            fprintf(stderr, \"Cannot allocate %zu characters\\n\", params[x].length);\n            ret = -1;\n        }\n    }\n    else {\n        ret = -1;\n    }\n    return ret;\n}\n\nstatic char* config_optval_string(char* buffer, size_t buffer_max, const char* p, size_t p_length)\n{\n    if (p_length + 1 > buffer_max) {\n        p_length = buffer_max - 1;\n    }\n    memcpy(buffer, p, p_length);\n    buffer[p_length] = 0;\n    return buffer;\n}\n\nstatic char* config_optval_param_string(char* buffer, size_t buffer_max, const option_param_t* params, int nb_param, int x)\n{\n    if (params == NULL || x < 0 || x >= nb_param) {\n        buffer[0] = 0;\n        return buffer;\n    }\n    else {\n        return config_optval_string(buffer, buffer_max, params[x].param, params[x].length);\n    }\n}\n\nint config_atoi(const option_param_t* params, int nb_param, int x, int* ret)\n{\n    int v = 0;\n\n    if (params == NULL || x < 0 || x >= nb_param) {\n        *ret = -1;\n    }\n    else {\n        for (size_t i = 0; i < params[x].length; i++) {\n            int c = params[x].param[i] - '0';\n            if (c < 0 || c > 9) {\n                v = -1;\n                *ret = -1;\n                break;\n            }\n            else {\n                v *= 10;\n                v += c;\n            }\n        }\n    }\n    return v;\n}\n\nint config_set_port(picoquic_quic_config_t* config, char const * port_string)\n{\n    int ret = 0;\n    char opval_buffer[256];\n    char const* p = port_string;\n    int is_port_shared = 0;\n    int p1 = 0;\n    int p2 = 0;\n    int nb_threads = 0;\n\n    if (*p == 'S') {\n        is_port_shared = 1;\n        p++;\n    }\n    while (*p >= '0' && *p <= '9') {\n        p1 *= 10;\n        p1 += (*p - '0');\n        p++;\n    }\n    if (*p == ':') {\n        p++;\n        while (*p >= '0' && *p <= '9') {\n            p2 *= 10;\n            p2 += (*p - '0');\n            p++;\n        }\n    }\n    if (*p == '*') {\n        p++;\n        while (*p >= '0' && *p <= '9') {\n            nb_threads *= 10;\n            nb_threads += (*p - '0');\n            p++;\n        }\n    }\n    if (*p != 0 || p1 < 0 || p1 > 65535 || p2 < 0 || p2 > 65535) {\n        fprintf(stderr, \"Invalid port: %s\\n\", config_optval_string(opval_buffer, 256, port_string, strlen(port_string)));\n        ret = -1;\n    }\n    else {\n        config->server_port = (uint16_t)p1;\n        config->local_port = (uint16_t)p2;\n        config->is_port_shared = is_port_shared;\n        config->nb_threads = nb_threads;\n    }\n    return ret;\n}\n\nstatic int config_set_option(option_table_line_t* option_desc, option_param_t* params, int nb_params, picoquic_quic_config_t* config)\n{\n    int ret = 0;\n    char opval_buffer[256];\n\n    switch (option_desc->option_num) {\n    case picoquic_option_CERT:\n        ret = config_set_string_param(&config->server_cert_file, params, nb_params, 0);\n        break;\n    case picoquic_option_KEY:\n        ret = config_set_string_param(&config->server_key_file, params, nb_params, 0);\n        break;\n    case picoquic_option_SERVER_PORT:\n        ret = config_set_port(config, params->param);\n        if (ret != 0) {\n            fprintf(stderr, \"Invalid port: %s\\n\", config_optval_param_string(opval_buffer, 256, params, nb_params, 0));\n        }\n        break;\n    case picoquic_option_PROPOSED_VERSION:\n        if ((config->proposed_version = config_parse_target_version(config_optval_param_string(opval_buffer, 256, params, nb_params, 0))) <= 0) {\n            fprintf(stderr, \"Invalid version: %s\\n\", config_optval_param_string(opval_buffer, 256, params, nb_params, 0));\n            ret = -1;\n        }\n        break;\n    case picoquic_option_OUTDIR:\n        ret = config_set_string_param(&config->out_dir, params, nb_params, 0);\n        break;\n    case picoquic_option_WWWDIR:\n        ret = config_set_string_param(&config->www_dir, params, nb_params, 0);\n        break;\n    case picoquic_option_MAX_CONNECTIONS: {\n        int v = config_atoi(params, nb_params, 0, &ret);\n        if (ret != 0 || v <= 0 ) {\n            fprintf(stderr, \"Invalid max connections: %s\\n\", config_optval_param_string(opval_buffer, 256, params, nb_params, 0));\n            ret = (ret == 0) ? -1 : ret;\n        }\n        else {\n            config->nb_connections = (uint32_t)v;\n        }\n        break;\n    }\n    case picoquic_option_DO_RETRY:\n        config->do_retry = 1;\n        break;\n    case picoquic_option_INITIAL_RANDOM: {\n        int v = config_atoi(params, nb_params, 0, &ret);\n        if (ret != 0 || v < 0 || v > 2) {\n            fprintf(stderr, \"Invalid initial random value: %s\\n\", config_optval_param_string(opval_buffer, 256, params, nb_params, 0));\n            ret = (ret == 0) ? -1 : ret;\n        }\n        else {\n            config->initial_random = v;\n        }\n        break;\n    }\n    case picoquic_option_RESET_SEED:\n        config->has_reset_seed = 1;\n        ret = (picoquic_parse_hexa(params[0].param, params[0].length, config->reset_seed, sizeof(config->reset_seed)) ==\n            sizeof(config->reset_seed)) ? 0 : -1;\n        if (ret != 0) {\n            fprintf(stderr, \"Invalid reset seed: %s\\n\", config_optval_param_string(opval_buffer, 256, params, nb_params, 0));\n        }\n        break;\n    case picoquic_option_DisablePortBlocking:\n        config->disable_port_blocking = 1;\n        break;\n#ifndef PICOQUIC_WITHOUT_SSLKEYLOG\n    case picoquic_option_SSLKEYLOG:\n        config->enable_sslkeylog = 1;\n        break;\n#endif\n    case picoquic_option_SOLUTION_DIR:\n        ret = config_set_string_param(&config->solution_dir, params, nb_params, 0);\n        break;\n    case picoquic_option_CC_ALGO:\n        ret = config_set_string_param(&config->cc_algo_id, params, nb_params, 0);\n        break;\n    case picoquic_option_CC_OPTION:\n        ret = config_set_string_param(&config->cc_algo_option_string, params, nb_params, 0);\n        break;\n    case picoquic_option_SPINBIT: {\n        int v = config_atoi(params, nb_params, 0, &ret);\n        if (ret != 0 || v < 0 || v > (int)picoquic_spinbit_on) {\n            fprintf(stderr, \"Invalid spinbit policy: %s\\n\", config_optval_param_string(opval_buffer, 256, params, nb_params, 0));\n            ret = (ret == 0) ? -1 : ret;\n        }\n        else {\n            config->spinbit_policy = (picoquic_spinbit_version_enum)v;\n        }\n        break;\n    }\n    case picoquic_option_LOSSBIT: {\n        int v = config_atoi(params, nb_params, 0, &ret);\n        if (ret != 0 || v < 0 || v >(int)picoquic_lossbit_send_receive) {\n            fprintf(stderr, \"Invalid lossbit policy: %s\\n\", config_optval_param_string(opval_buffer, 256, params, nb_params, 0));\n            ret = (ret == 0) ? -1 : ret;\n        }\n        else {\n            config->lossbit_policy = (picoquic_lossbit_version_enum)v;\n        }\n        break;\n    }\n    case picoquic_option_MULTIPATH: \n        config->multipath_option = 1;\n        break;\n    case picoquic_option_DEST_IF:\n        config->dest_if = config_atoi(params, nb_params, 0, &ret);\n        break;\n    case picoquic_option_CIPHER_SUITE:\n        config->cipher_suite_id = config_atoi(params, nb_params, 0, &ret);\n        break;\n    case picoquic_option_INIT_CNXID:\n        ret = config_set_string_param(&config->cnx_id_cbdata, params, nb_params, 0);\n        break;\n    case picoquic_option_LOG_FILE:\n        ret = config_set_string_param(&config->log_file, params, nb_params, 0);\n        break;\n    case picoquic_option_LONG_LOG:\n        config->use_long_log = 1;\n        break;\n    case picoquic_option_BINLOG_DIR:\n        ret = config_set_string_param(&config->bin_dir, params, nb_params, 0);\n        break;\n    case picoquic_option_QLOG_DIR:\n        ret = config_set_string_param(&config->qlog_dir, params, nb_params, 0);\n        break;\n    case picoquic_option_MTU_MAX:\n        config->mtu_max = config_atoi(params, nb_params, 0, &ret);\n        if (config->mtu_max <= 0 || config->mtu_max > PICOQUIC_MAX_PACKET_SIZE) {\n            fprintf(stderr, \"Invalid max mtu: %s\\n\", config_optval_param_string(opval_buffer, 256, params, nb_params, 0));\n            ret = -1;\n        }\n        break;\n    case picoquic_option_SNI:\n        ret = config_set_string_param(&config->sni, params, nb_params, 0);\n        break;\n    case picoquic_option_ALPN:\n        ret = config_set_string_param(&config->alpn, params, nb_params, 0);\n        break;\n    case picoquic_option_ROOT_TRUST_FILE:\n        ret = config_set_string_param(&config->root_trust_file, params, nb_params, 0);\n        break;\n    case picoquic_option_FORCE_ZERO_SHARE:\n        config->force_zero_share = 1;\n        break;\n    case picoquic_option_CNXID_LENGTH:\n        config->cnx_id_length = config_atoi(params, nb_params, 0, &ret);\n        if (config->cnx_id_length < 0 || config->cnx_id_length > PICOQUIC_CONNECTION_ID_MAX_SIZE) {\n            fprintf(stderr, \"Invalid connection id length: %s\\n\", config_optval_param_string(opval_buffer, 256, params, nb_params, 0));\n            ret = -1;\n        }\n        break;\n    case picoquic_option_Idle_Timeout:\n        config->idle_timeout = config_atoi(params, nb_params, 0, &ret);\n        if (config->idle_timeout < 0) {\n            fprintf(stderr, \"Invalid idle timer: %s\\n\", config_optval_param_string(opval_buffer, 256, params, nb_params, 0));\n            ret = -1;\n        }\n        break;\n    case picoquic_option_NO_DISK:\n        config->no_disk = 1;\n        break;\n    case picoquic_option_LARGE_CLIENT_HELLO:\n        config->large_client_hello = 1;\n        break;\n    case picoquic_option_Ticket_File_Name:\n        ret = config_set_string_param(&config->ticket_file_name, params, nb_params, 0);\n        break;\n    case picoquic_option_Token_File_Name:\n        ret = config_set_string_param(&config->token_file_name, params, nb_params, 0);\n        break;\n    case picoquic_option_Socket_buffer_size:\n        config->socket_buffer_size = config_atoi(params, nb_params, 0, &ret);\n        if (config->socket_buffer_size < 0 ) {\n            fprintf(stderr, \"Invalid socket_buffer_size: %s\\n\", config_optval_param_string(opval_buffer, 256, params, nb_params, 0));\n            ret = -1;\n        }\n        break;\n    case picoquic_option_Performance_Log:\n        ret = config_set_string_param(&config->performance_log, params, nb_params, 0);\n        break;\n    case picoquic_option_Preemptive_Repeat:\n        config->do_preemptive_repeat = 1;\n        break;\n    case picoquic_option_Version_Upgrade:\n        if ((config->desired_version = config_parse_target_version(config_optval_param_string(opval_buffer, 256, params, nb_params, 0))) <= 0) {\n            fprintf(stderr, \"Invalid version: %s\\n\", config_optval_param_string(opval_buffer, 256, params, nb_params, 0));\n            ret = -1;\n        }\n        break;\n    case picoquic_option_No_GSO:\n        config->do_not_use_gso = 1;\n        break;\n    case picoquic_option_BDP_frame: {\n        int v = config_atoi(params, nb_params, 0, &ret);\n        if (ret != 0 || v < 0 || v > 1) {\n            fprintf(stderr, \"Invalid bdp option: %s\\n\", config_optval_param_string(opval_buffer, 256, params, nb_params, 0));\n            ret = (ret == 0) ? -1 : ret;\n        }\n        else {\n            config->bdp_frame_option = v;\n        }\n        break;\n    }\n    case picoquic_option_CWIN_MAX:{\n        int v = config_atoi(params, nb_params, 0, &ret);\n        if (ret != 0 || v < 0) {\n            fprintf(stderr, \"Invalid cwin max option: %s\\n\", config_optval_param_string(opval_buffer, 256, params, nb_params, 0));\n            ret = (ret == 0) ? -1 : ret;\n        }\n        else {\n            config->cwin_max = (v==0)?UINT64_MAX:v;\n        }\n        break;\n    }\n    case picoquic_option_AddressDiscovery: {\n        int v = config_atoi(params, nb_params, 0, &ret);\n        if (ret != 0 || v < 0 || v > 2) {\n            fprintf(stderr, \"Invalid address discovery option: %s\\n\", config_optval_param_string(opval_buffer, 256, params, nb_params, 0));\n            ret = (ret == 0) ? -1 : ret;\n        }\n        else {\n            config->address_discovery_mode = v + 1;\n        }\n        break;\n    }\n    case picoquic_option_ECH_server: {\n        ret = config_set_string_param(&config->ech_key_file, params, nb_params, 0);\n        if (ret == 0) {\n            ret = config_set_string_param(&config->ech_config_file, params, nb_params, 1);\n        }\n        break;\n    }\n    case picoquic_option_ECH_init: {\n        ret = config_set_string_param(&config->ech_public_name, params, nb_params, 0);\n        break;\n    }\n    case picoquic_option_ECH_client: {\n        if (nb_params != 1) {\n            ret = -1;\n        }\n        else if (strcmp(params[0].param, \"-\") == 0) {\n            config->ech_target = NULL;\n            config->ech_target_len = SIZE_MAX;\n        }\n        else{\n            ret = picoquic_base64_decode(&config->ech_target, &config->ech_target_len, params[0].param);\n        }\n        if (ret != 0) {\n            fprintf(stderr, \"Incorrect base64 format: %s\\n\", params[0].param);\n            ret = (ret == 0) ? -1 : ret;\n        }\n        break;\n    }\n    case picoquic_option_FLOW_CONTROL_MAX: {\n        int v = config_atoi(params, nb_params, 0, &ret);\n        if (ret != 0 || v < 0) {\n            fprintf(stderr, \"Invalid flow control max option: %s\\n\", config_optval_param_string(opval_buffer, 256, params, nb_params, 0));\n            ret = (ret == 0) ? -1 : ret;\n        }\n        else {\n            config->flow_control_max = v;\n        }\n        break;\n    }\n    case picoquic_option_Preferred_V4:\n        ret = config_set_string_param(&config->preferred_address_v4, params, nb_params, 0);\n        break;\n    case picoquic_option_Preferred_V6:\n        ret = config_set_string_param(&config->preferred_address_v6, params, nb_params, 0);\n        break;\n    case picoquic_option_HELP:\n        ret = -1;\n        break;\n    default:\n        ret = -1;\n        break;\n    }\n    return ret;\n}\n\nint picoquic_config_option_letters(char* option_string, size_t string_max, size_t * string_length)\n{\n    size_t l = 0;\n    int ret = 0;\n\n    for (size_t i = 0; l + 1 < string_max && i < option_table_size; i++) {\n        option_string[l++] = option_table[i].option_letter;\n        if (option_table[i].nb_params_required > 0) {\n            if (l + 1 < string_max) {\n                option_string[l++] = ':';\n            }\n            else {\n                l--;\n                ret = -1;\n                break;\n            }\n        }\n    }\n    option_string[l] = 0;\n    if (string_length != NULL) {\n        *string_length = l;\n    }\n    return ret;\n}\n\nvoid picoquic_config_usage_file(FILE* F)\n{\n    fprintf(F, \"Picoquic options:\\n\");\n    for (size_t i = 0; i < option_table_size; i++) {\n        size_t spacer = strlen(option_table[i].param_sample);\n        fprintf(F, \"  -%c %s\", option_table[i].option_letter, option_table[i].param_sample);\n        while (spacer++ < 12) {\n            putc(' ', F);\n        }\n        fprintf(F, \" %s\\n\", option_table[i].option_help);\n        if (option_table[i].option_num == picoquic_option_CC_ALGO){\n            if (picoquic_congestion_control_algorithms != NULL &&\n                picoquic_nb_congestion_control_algorithms > 0) {\n                /* Add a line with supported values. */\n                for (size_t j = 0; j < 18; j++) {\n                    putc(' ', F);\n                }\n                for (size_t k = 0; k < picoquic_nb_congestion_control_algorithms; k++) {\n                    if (k != 0) {\n                        fprintf(F, \", \");\n                    }\n                    fprintf(F, \"%s\", picoquic_congestion_control_algorithms[k]->congestion_algorithm_id);\n                }\n                fprintf(F, \".\\n\");\n            }\n        }\n    }\n}\n\nvoid picoquic_config_usage(void)\n{\n    picoquic_config_usage_file(stderr);\n}\n\nint picoquic_config_set_option(picoquic_quic_config_t* config, picoquic_option_enum_t option_num, const char * opt_val)\n{\n    int ret = 0;\n    option_table_line_t* option_desc = NULL;\n    option_param_t params[1];\n    int nb_params = 0;\n\n    for (size_t i = 0; i < option_table_size; i++) {\n        if (option_table[i].option_num == option_num) {\n            option_desc = &option_table[i];\n        }\n    }\n    if (option_desc == NULL) {\n        fprintf(stderr, \"Unknow option number: %d\\n\", option_num);\n        ret = -1;\n    }\n    else{\n        if (opt_val != NULL) {\n            params[0].param = opt_val;\n            params[0].length = strlen(opt_val);\n            nb_params = 1;\n        }\n        ret = config_set_option(option_desc, params, nb_params, config);\n    }\n    return ret;\n}\n\nint picoquic_config_get_option_char_index(int opt)\n{\n    int option_index = -1;\n\n    for (size_t i = 0; i < option_table_size; i++) {\n        if (option_table[i].option_letter == opt) {\n            option_index = (int)i;\n            break;\n        }\n    }\n    return option_index;\n}\n\nint picoquic_config_get_option_name_index(char const * s, size_t l)\n{\n    int option_index = -1;\n\n    for (size_t i = 0; i < option_table_size; i++) {\n        if (strncmp(s, option_table[i].option_name, l) == 0) {\n            option_index = (int)i;\n            break;\n        }\n    }\n    return option_index;\n}\n\nint picoquic_config_get_command_line_option_index(char const* opt_string)\n{\n    int option_index = -1;\n\n    if (opt_string[0] == '-' && opt_string[1] != 0) {\n        if (opt_string[2] == 0) {\n            option_index = picoquic_config_get_option_char_index(opt_string[1]);\n        }\n        else if (opt_string[1] == '-' && opt_string[2] != 0) {\n            char const* opt_name = opt_string + 2;\n            option_index = picoquic_config_get_option_name_index(opt_name, strlen(opt_name));\n        }\n    }\n    return option_index;\n}\n\nint picoquic_get_command_line_option_value(int option_index, char const * opt_string, int* p_optind, const char** argv,\n    int argc, char const* optarg, picoquic_quic_config_t* config)\n{\n    int ret = 0;\n    option_param_t params[5];\n    int nb_params = 0;\n\n    if (option_table[option_index].nb_params_required > 0) {\n        params[0].param = optarg;\n        if (optarg == NULL) {\n            fprintf(stderr, \"option %s requires %d arguments\\n\", opt_string, option_table[option_index].nb_params_required);\n            ret = -1;\n        }\n        else {\n            params[0].length = strlen(optarg);\n            nb_params++;\n            while (nb_params < option_table[option_index].nb_params_required) {\n                if (*p_optind + 1 > argc) {\n                    fprintf(stderr, \"option %s requires %d arguments\\n\", opt_string, option_table[option_index].nb_params_required);\n                    ret = -1;\n                    break;\n                }\n                else {\n                    params[nb_params].param = argv[*p_optind];\n                    params[nb_params].length = (int)strlen(argv[*p_optind]);\n                    nb_params++;\n                    *p_optind += 1;\n                }\n            }\n        }\n    }\n\n    if (ret == 0) {\n        ret = config_set_option(&option_table[option_index], params, nb_params, config);\n    }\n\n    return ret;\n}\n\nint picoquic_config_command_line(int opt, int * p_optind, int argc, char const ** argv, char const* optarg, picoquic_quic_config_t * config)\n{\n    int ret = 0;\n    int option_index = -1;\n    char opt_string[3] = { '-', 0, 0 };\n\n    opt_string[1] = (char)opt;\n    option_index = picoquic_config_get_option_char_index(opt);\n\n    if (option_index == -1) {\n        fprintf(stderr, \"Unknown option: -%c\\n\", opt);\n        ret = -1;\n    }\n    else {\n        ret = picoquic_get_command_line_option_value(option_index, opt_string, p_optind,\n            argv, argc, optarg, config);\n    }\n    return ret;\n}\n\nint picoquic_config_command_line_ex(char const * opt_string, int* p_optind, int argc, char const** argv, char const* optarg, picoquic_quic_config_t* config)\n{\n    int ret = 0;\n    int option_index = -1;\n\n    option_index = picoquic_config_get_command_line_option_index(opt_string);\n\n    if (option_index == -1) {\n        fprintf(stderr, \"Unknown option: %s\\n\", opt_string);\n    }\n    else {\n        ret = picoquic_get_command_line_option_value(option_index, opt_string, p_optind,\n            argv, argc, optarg, config);\n    }\n    return ret;\n}\n\n#if 0\n/* Reading parameters from a file instead of the command line.\n* Apparently never used, also not tested.\n */\nint picoquic_config_file(char const* file_name, picoquic_quic_config_t* config)\n{\n    int ret = 0;\n    FILE* F = picoquic_file_open(file_name, \"r\");\n    if (F == NULL) {\n        DBG_PRINTF(\"Could not open configuration file: %s\", file_name);\n        ret = -1;\n    }\n    else {\n        char line[1024];\n        int line_number = 0;\n\n        while (fgets(line, sizeof(line), F) != NULL && ret == 0) {\n            /* Parse the line. Expect format: <arg_id>\":\" spaces* argv1 [space ^spaces argvn]* */\n            int offset = skip_spaces(line, 0);\n            int name_offset;\n            int name_length;\n            option_param_t params[5];\n            int nb_params;\n            int option_index = -1;\n\n            line_number++;\n            name_offset = offset;\n            offset = skip_name(line, name_offset);\n            if (offset <= name_offset) {\n                /* Empty line */\n            }\n            else {\n                name_length = offset - name_offset;\n                /* Parse the option parameters, up to 5 of them */\n                offset = parse_line_params(line, offset, params, 5, &nb_params);\n                /* Recognize the option and apply the parameters  */\n                for (size_t i = 0; i < option_table_size; i++) {\n                    if (compare_option_name(line, name_offset, (size_t)name_length, option_table[i].option_name) == 0) {\n                        option_index = (int)i;\n                        break;\n                    }\n                }\n\n                if (option_index == -1) {\n                    char buffer[256];\n                    fprintf(stderr, \"Line %d, unknown option: -%s\\n\", line_number,\n                        config_optval_string(buffer, 256, line + name_offset, name_length));\n                    ret = -1;\n                }\n                else {\n                    if (option_table[option_index].nb_params_required != nb_params) {\n                        fprintf(stderr, \"Line %d, option %s requires %d arguments, %d present\\n\",\n                            line_number,\n                            option_table[option_index].option_name,\n                            option_table[option_index].nb_params_required,\n                            nb_params);\n                        ret = -1;\n                    }\n                }\n\n                if (ret == 0) {\n                    offset = skip_name(line, offset);\n                    if (line[offset] != 0 && line[offset] != '#') {\n                        fprintf(stderr, \"Line %d, unexpected character at position %d\\n\", line_number, offset);\n                    }\n                }\n\n                if (ret == 0) {\n                    ret = config_set_option(&option_table[option_index], params, nb_params, config);\n                }\n\n\n            }\n        }\n        picoquic_file_close(F);\n    }\n\n    return ret;\n}\n#endif\n\n/* Create a QUIC Context based on configuration data.\n * Arguments from configuration:\n * - uint32_t nb_connections,\n * - char const* cert_file_name,\n * - char const* key_file_name,\n * - char const * cert_root_file_name,\n * - char const* default_alpn,\n * - picoquic_connection_id_cb_fn cnx_id_callback,\n * - void* cnx_id_callback_data,\n * - uint8_t reset_seed[PICOQUIC_RESET_SECRET_SIZE],\n * - char const* ticket_file_name,\n * - const uint8_t* ticket_encryption_key,\n * - size_t ticket_encryption_key_length\n * Arguments from program:\n * - picoquic_stream_data_cb_fn default_callback_fn,\n * - void* default_callback_ctx,\n * - uint64_t current_time,\n * - uint64_t* p_simulated_time,\n */\n\npicoquic_quic_t* picoquic_create_and_configure(picoquic_quic_config_t* config,\n    picoquic_stream_data_cb_fn default_callback_fn,\n    void* default_callback_ctx,\n    uint64_t current_time,\n    uint64_t* p_simulated_time)\n{\n    /* Create context */\n    /* TODO: padding policy\n     * TODO: mtu max accessor\n     * TODO: set supported CC without linking every option\n     * TODO: set logging option without linking every option\n     * TODO: set key log file option\n     */\n    picoquic_quic_t* quic = picoquic_create(\n        config->nb_connections,\n        config->server_cert_file,\n        config->server_key_file,\n        config->root_trust_file,\n        config->alpn,\n        default_callback_fn,\n        default_callback_ctx,\n        NULL,\n        NULL,\n        (config->has_reset_seed)?(uint8_t*)config->reset_seed : NULL,\n        current_time,\n        p_simulated_time,\n        config->ticket_file_name,\n        config->ticket_encryption_key,\n        config->ticket_encryption_key_length);\n\n    if (quic != NULL) {\n        int ret = 0;\n        picoquic_congestion_algorithm_t const* cc_algo = NULL;\n\n        /* Additional configuration options */\n        /* picoquic_set_alpn_select_fn(qserver, picoquic_demo_server_callback_select_alpn); */\n        if (config->do_retry) {\n            picoquic_set_cookie_mode(quic, 1);\n        }\n        else {\n            /* TODO: option to provide cookie by default or not */\n            picoquic_set_cookie_mode(quic, 2);\n        }\n\n        if (config->cc_algo_id != NULL) {\n            cc_algo = picoquic_get_congestion_algorithm(config->cc_algo_id);\n            if (cc_algo == NULL) {\n                fprintf(stderr, \"Unrecognized congestion algorithm: %s. Using BBR isntead.\\n\", config->cc_algo_id);\n            }\n        }\n        if (cc_algo == NULL) {\n            cc_algo = picoquic_bbr_algorithm;\n        }\n\n        picoquic_set_default_congestion_algorithm_ex(quic, cc_algo, config->cc_algo_option_string);\n\n        picoquic_set_default_spinbit_policy(quic, config->spinbit_policy);\n        picoquic_set_default_lossbit_policy(quic, config->lossbit_policy);\n\n        picoquic_set_default_multipath_option(quic, config->multipath_option);\n        picoquic_set_default_idle_timeout(quic, (uint64_t)config->idle_timeout);\n\n        picoquic_set_cwin_max(quic, config->cwin_max);\n        picoquic_set_default_address_discovery_mode(quic, config->address_discovery_mode);\n\n        picoquic_set_preferred_address(&quic->default_tp.preferred_address,\n            config->preferred_address_v4, config->preferred_address_v6, config->local_port);\n\n        if (config->token_file_name) {\n            if (picoquic_load_retry_tokens(quic, config->token_file_name) != 0) {\n                fprintf(stderr, \"No token file present. Will create one as <%s>.\\n\", config->token_file_name);\n            }\n        }\n\n        if (config->force_zero_share) {\n            quic->client_zero_share = 1;\n        }\n\n        if (config->mtu_max > 0) {\n            picoquic_set_mtu_max(quic, config->mtu_max);\n        }\n\n        if (config->cnx_id_length != -1) {\n            if (picoquic_set_default_connection_id_length(quic, (uint8_t)config->cnx_id_length) != 0) {\n                fprintf(stderr, \"Could not set CNX-ID length #%d.\\n\", config->cnx_id_length);\n            }\n        }\n\n        /* Cannot set the cnx_id callback here, because it requires libraries\n         * that are not linked by default */\n\n         /* TODO: parameters to define padding policy */\n        picoquic_set_padding_policy(quic, 39, 128);\n\n        if (config->bin_dir != NULL) {\n            picoquic_set_binlog(quic, config->bin_dir);\n        }\n\n        if (config->qlog_dir != NULL) {\n            picoquic_set_qlog(quic, config->qlog_dir);\n        }\n\n        if (config->log_file != NULL) {\n            picoquic_set_textlog(quic, config->log_file);\n        }\n\n        picoquic_set_log_level(quic, config->use_long_log);\n\n        picoquic_set_preemptive_repeat_policy(quic, config->do_preemptive_repeat);\n\n        picoquic_disable_port_blocking(quic, config->disable_port_blocking);\n\n#ifndef PICOQUIC_WITHOUT_SSLKEYLOG\n        picoquic_enable_sslkeylog(quic, config->enable_sslkeylog);\n#endif\n\n        if (config->initial_random >= 0 && config->initial_random <= 2) {\n            picoquic_set_random_initial(quic, config->initial_random);\n        }\n\n        if (config->cipher_suite_id != 0) {\n            int iana_cipher_suite_code = config->cipher_suite_id;\n            if (config->cipher_suite_id == 20) {\n                iana_cipher_suite_code = PICOQUIC_CHACHA20_POLY1305_SHA256;\n            }\n            else if (config->cipher_suite_id == 128) {\n                iana_cipher_suite_code = PICOQUIC_AES_128_GCM_SHA256;\n            }\n            else if (config->cipher_suite_id == 256) {\n                iana_cipher_suite_code = PICOQUIC_AES_256_GCM_SHA384;\n            }\n            if (picoquic_set_cipher_suite(quic, iana_cipher_suite_code) != 0) {\n                fprintf(stderr, \"Could not set cipher suite #%d.\\n\", config->cipher_suite_id);\n            }\n        }\n\n        if (config->do_retry != 0) {\n            picoquic_set_cookie_mode(quic, 1);\n        }\n        else {\n            picoquic_set_cookie_mode(quic, 2);\n        }\n        /* TODO: control whether to */\n        /* picoquic_set_key_log_file_from_env(quic); */\n\n        picoquic_set_default_bdp_frame_option(quic, config->bdp_frame_option);\n\n        if (config->ech_public_name != NULL) {\n            if (config->ech_key_file == NULL || config->ech_config_file) {\n                fprintf(stderr, \"Cannot create a configuration if key and config file are not specified.\\n\");\n            } else {\n                ret = picoquic_ech_create_config_file(config->ech_public_name, config->ech_key_file, config->ech_config_file);\n            }\n        }\n\n        if (ret == 0 && (config->ech_key_file != NULL || config->ech_target != NULL)) {\n            ret = picoquic_ech_configure_quic_ctx(quic, config->ech_key_file, config->ech_config_file);\n        }\n\n        if (ret == 0 && config->flow_control_max > 0)\n        {\n            picoquic_set_max_data_control(quic, config->flow_control_max);\n        }\n\n        if (ret != 0) {\n            /* Something went wrong */\n            DBG_PRINTF(\"QUIC configuration fails, ret = %d (0x%x)\", ret, ret);\n            picoquic_free(quic);\n            quic = NULL;\n        }\n    }\n\n    return quic;\n}\n\nvoid picoquic_config_init(picoquic_quic_config_t* config)\n{\n    memset(config, 0, sizeof(picoquic_quic_config_t));\n    config->cnx_id_length = -1;\n    config->nb_connections = 256;\n    config->initial_random = 3;\n    config->cwin_max = UINT64_MAX;\n    config->idle_timeout = PICOQUIC_MICROSEC_HANDSHAKE_MAX / 1000;\n    config->flow_control_max = 0;\n}\n\nvoid picoquic_config_clear(picoquic_quic_config_t* config)\n{\n    if (config->solution_dir != NULL) {\n        free((void*)config->solution_dir);\n    }\n    if (config->server_cert_file != NULL) {\n        free((void*)config->server_cert_file);\n    }\n    if (config->server_key_file != NULL) {\n        free((void*)config->server_key_file);\n    }\n    if (config->log_file != NULL) {\n        free((void*)config->log_file);\n    }\n    if (config->bin_dir != NULL) {\n        free((void*)config->bin_dir);\n    }\n    if (config->qlog_dir != NULL) {\n        free((void*)config->qlog_dir);\n    }\n    if (config->performance_log != NULL) {\n        free((void*)config->performance_log);\n    }\n    if (config->cc_algo_id != NULL) {\n        free((void*)config->cc_algo_id);\n    }\n    if (config->cc_algo_option_string != NULL) {\n        free((void*)config->cc_algo_option_string);\n    }\n    if (config->cnx_id_cbdata != NULL) {\n        free((void*)config->cnx_id_cbdata);\n    }\n    if (config->multipath_alt_config != NULL) {\n        free((void*)config->multipath_alt_config);\n    }\n    if (config->www_dir != NULL) {\n        free((void*)config->www_dir);\n    }\n    if (config->ticket_file_name != NULL) {\n        free((void*)config->ticket_file_name);\n    }\n    if (config->token_file_name != NULL) {\n        free((void*)config->token_file_name);\n    }\n    if (config->sni != NULL) {\n        free((void*)config->sni);\n    }\n    if (config->alpn != NULL) {\n        free((void*)config->alpn);\n    }\n    if (config->out_dir != NULL) {\n        free((void*)config->out_dir);\n    }\n    if (config->root_trust_file != NULL) {\n        free((void*)config->root_trust_file);\n    }\n    if (config->ech_key_file != NULL) {\n        free((void*)config->ech_key_file);\n    }\n    if (config->ech_config_file != NULL) {\n        free((void*)config->ech_config_file);\n    }\n    if (config->ech_public_name != NULL) {\n        free((void*)config->ech_public_name);\n    }\n    if (config->ech_target != NULL) {\n        free((void*)config->ech_target);\n    }\n    if (config->preferred_address_v4 != NULL) {\n        free((void*)config->preferred_address_v4);\n    }\n    if (config->preferred_address_v6 != NULL) {\n        free((void*)config->preferred_address_v6);\n    }\n    picoquic_config_init(config);\n}\n\n/* Set a server context, using more parameters than the simple\n* creation from configuration.\n */\n","numLines":1126,"startLine":1,"totalLines":1126}}}
