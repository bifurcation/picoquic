{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01VgxecKFYnWnAzyYE22Nyx8","type":"tool_result","content":"1\t//! Translation of `quic/lb.h`.\n2\t//!\n3\t//! Server-side support for the QUIC load-balancer draft\n4\t//! (<https://datatracker.ietf.org/doc/draft-ietf-quic-load-balancers/>):\n5\t//! parse the LB-supplied configuration string into a [`Config`],\n6\t//! then install a per-server CID-generation / -verification context\n7\t//! ([`ConnectionIdContext`]) on a [`Quic`] via the connection-ID\n8\t//! callback hook.\n9\t//!\n10\t//! ## API shape\n11\t//!\n12\t//! * [`Config::parse`] takes the LB string as `&str` and returns\n13\t//!   the populated config; the C `(char const* txt, size_t\n14\t//!   txt_length)` pair plus zeroed out-parameter collapse to a\n15\t//!   normal Rust constructor.\n16\t//! * [`Quic::set_lb_cid_config`] applies a `Config` to the QUIC\n17\t//!   context, installing the per-server CID context.\n18\t//! * [`Quic::clear_lb_cid_config`] tears the installed context back\n19\t//!   down (no-op when none is installed).\n20\t//! * [`ConnectionIdContext::generate`] / [`ConnectionIdContext::verify`]\n21\t//!   are the per-CID callback bodies.  They are exposed as inherent methods\n22\t//!   so the eventual [`crate::ConnectionIdCallback`] trait impl can\n23\t//!   delegate to them; the C `void* connection_id_cb_data` parameter is\n24\t//!   recovered as `&mut self`.\n25\t//!\n26\t//! ## Field-shape decisions\n27\t//!\n28\t//! * `rotation_bits : 2` — multi-bit C bitfield, kept as `u8`\n29\t//!   (legal range `0..=3`) per the Phase 1 bitfield rule.\n30\t//! * `first_byte_encodes_length : 1` — single-bit C bitfield used\n31\t//!   as a Boolean flag throughout the C body, promoted to `bool`\n32\t//!   (matching the `config.rs` precedent).\n33\t//! * `cid_encryption_context` / `cid_decryption_context` were\n34\t//!   `void*` in C, holding AES-128-ECB contexts produced by\n35\t//!   `aes128_ecb_create` and freed by `aes128_ecb_free` (both\n36\t//!   declared in `tls_api.h`, which has not been translated yet).\n37\t//!   The fields own their contexts in C (the clear path explicitly\n38\t//!   calls the AES destructor), so Rust models them as\n39\t//!   `Option<Box<Aes128EcbContext>>`, with the AES-context type\n40\t//!   forward-declared here as an opaque struct.  `Box::drop` will\n41\t//!   subsume the explicit `aes128_ecb_free` call once Phase 3 gives\n42\t//!   the type a `Drop` impl.\n43\t//! * `server_id: [u8; 16]` and `cid_encryption_key: [u8; 16]` stay\n44\t//!   as fixed-capacity byte arrays — the C declarations are size-16\n45\t//!   arrays and the algorithms are AES-128, so the capacity *is*\n46\t//!   part of the contract.\n47\t\n48\tuse crate::Error;\n49\tuse crate::tls_api::Aes128EcbContext;\n50\tuse crate::{ConnectionId, Quic};\n51\t\n52\t/// CID-encoding method selected by the load-balancer config.\n53\t/// C: `load_balancer_cid_method_enum`.\n54\t#[derive(Debug, Copy, Clone, PartialEq, Eq, Default)]\n55\tpub enum ConnectionIdMethod {\n56\t    /// Server ID copied in clear after the first byte.\n57\t    /// C: `load_balancer_cid_clear`.\n58\t    #[default]\n59\t    Clear,\n60\t    /// Server ID encrypted with an AES-128-ECB stream cipher keyed\n61\t    /// off a per-CID nonce.\n62\t    /// C: `load_balancer_cid_stream_cipher`.\n63\t    StreamCipher,\n64\t    /// Server ID encrypted with a single AES-128-ECB block.\n65\t    /// C: `load_balancer_cid_block_cipher`.\n66\t    BlockCipher,\n67\t}\n68\t\n69\t/// Number of low bits of the first CID byte that select between\n70\t/// short-lived configurations.  C: `unsigned int rotation_bits : 2`.\n71\t#[derive(Debug, Copy, Clone, PartialEq, Eq, Default)]\n72\t#[repr(u8)]\n73\tpub enum RotationBits {\n74\t    #[default]\n75\t    Zero = 0,\n76\t    One = 1,\n77\t    Two = 2,\n78\t    Three = 3,\n79\t}\n80\t\n81\t/// Configuration parsed from an LB-supplied string and applied to\n82\t/// a [`Quic`] via [`Quic::set_lb_cid_config`].\n83\t/// C: `load_balancer_config_t`.\n84\t///\n85\t/// `repr(C)` is dropped — the struct is purely an internal shape,\n86\t/// never inspected by an LB or another process.\n87\t///\n88\t/// Lives in `crate::lb`; consumers that also import the demo-app\n89\t/// [`crate::config::Config`] should rename one at the import\n90\t/// site (`use crate::lb::Config as LbConfig;`).\n91\t#[derive(Debug, Default)]\n92\tpub struct Config {\n93\t    pub method: ConnectionIdMethod,\n94\t    pub rotation_bits: RotationBits,\n95\t    /// 1-bit field in C; promoted to `bool` to match call-site usage.\n96\t    pub first_byte_encodes_length: bool,\n97\t    pub server_id_length: usize,\n98\t    /// Used in stream-cipher mode.\n99\t    pub nonce_length: usize,\n100\t    pub connection_id_length: usize,\n101\t    pub server_id: u64,\n102\t    pub cid_encryption_key: [u8; 16],\n103\t}\n104\t\n105\timpl Config {\n106\t    /// Parse an LB-format configuration string into a fresh\n107\t    /// [`Config`].  Returns `Err` when the string is malformed,\n108\t    /// the embedded server ID overflows 8 bytes, or the encoded CID\n109\t    /// length is incompatible with the chosen method.\n110\t    /// C: `lb_compat_cid_config_parse`.\n111\t    ///\n112\t    /// The C signature took an out-parameter and a `(char const*\n113\t    /// txt, size_t txt_length)` pair returning an `int`; the Rust\n114\t    /// signature returns the populated struct in the success arm\n115\t    /// and folds the explicit length into the `&str` slice.\n116\t    pub fn parse(_txt: &str) -> Result<Self, Error> {\n117\t        todo!()\n118\t    }\n119\t}\n120\t\n121\t// ---------------------------------------------------------------------------\n122\t// Per-server CID context.\n123\t\n124\t/// Per-server context attached to a [`Quic`] once a load-balancer\n125\t/// config has been applied.  Built from a [`Config`] by\n126\t/// [`Quic::set_lb_cid_config`] and consumed by the\n127\t/// [`crate::ConnectionIdCallback`] hook.\n128\t/// C: `load_balancer_cid_context_t`.\n129\t///\n130\t/// The two AES contexts are method-dependent: [`ConnectionIdMethod::Clear`]\n131\t/// uses neither, [`ConnectionIdMethod::StreamCipher`] uses only the\n132\t/// encryption context (the verify path re-encrypts the nonce and XORs),\n133\t/// and [`ConnectionIdMethod::BlockCipher`] uses both.  Hence the\n134\t/// `Option<Box<…>>` wrappers — they encode method-dependence rather\n135\t/// than an init-time gap.\n136\t#[derive(Debug, Default)]\n137\tpub struct ConnectionIdContext {\n138\t    pub method: ConnectionIdMethod,\n139\t    pub rotation_bits: RotationBits,\n140\t    /// 1-bit field in C; promoted to `bool`.\n141\t    pub first_byte_encodes_length: bool,\n142\t    pub server_id_length: usize,\n143\t    /// Used in stream-cipher mode.\n144\t    pub nonce_length: usize,\n145\t    pub connection_id_length: usize,\n146\t    pub server_id: u64,\n147\t    /// Big-endian encoding of `server_id`, padded to\n148\t    /// `server_id_length` bytes.\n149\t    pub server_id_encoded: [u8; 16],\n150\t    /// Used in stream- and block-cipher modes.  Owned by this\n151\t    /// struct: the C clear path calls `aes128_ecb_free` on it.\n152\t    pub cid_encryption_context: Option<Box<Aes128EcbContext>>,\n153\t    /// Used in block-cipher mode for the verify path.  Owned the\n154\t    /// same way.\n155\t    pub cid_decryption_context: Option<Box<Aes128EcbContext>>,\n156\t}\n157\t\n158\timpl ConnectionIdContext {\n159\t    /// Encode a CID from `nonce` per `self.method` and return it.\n160\t    /// C: `lb_compat_cid_generate`.\n161\t    ///\n162\t    /// The C signature took a `connection_id_returned` out parameter that\n163\t    /// the body both read (for the nonce / \"for-server use\" bytes)\n164\t    /// and wrote (for the encoded CID); the Rust signature splits\n165\t    /// those two roles — the input nonce comes in by reference and\n166\t    /// the encoded CID is the return value.  `&mut self` because the\n167\t    /// underlying AES contexts mutate cipher state in place.  `quic`\n168\t    /// is read for `local_connection_id_length`; the unused `connection_id_local` /\n169\t    /// `connection_id_remote` parameters of the C signature are dropped\n170\t    /// here and reintroduced (if needed) by the\n171\t    /// [`crate::ConnectionIdCallback`] adapter.\n172\t    pub fn generate(&mut self, _quic: &Quic, _nonce: &ConnectionId) -> ConnectionId {\n173\t        todo!()\n174\t    }\n175\t\n176\t    /// Decode the server ID embedded in `connection_id`.  Returns `None`\n177\t    /// when the CID length doesn't match `self.connection_id_length`\n178\t    /// or when `self.method` is unrecognised; the C sentinel\n179\t    /// `UINT64_MAX` is folded into `Option`.\n180\t    /// C: `lb_compat_cid_verify`.\n181\t    ///\n182\t    /// `&mut self` because the underlying AES contexts mutate\n183\t    /// cipher state in place.\n184\t    pub fn verify(&mut self, _cnx_id: &ConnectionId) -> Option<u64> {\n185\t        todo!()\n186\t    }\n187\t}\n188\t\n189\timpl Quic {\n190\t    /// Apply `lb_config` to `self`, installing a [`ConnectionIdContext`]\n191\t    /// as the connection-ID callback context.\n192\t    /// C: `lb_compat_cid_config`.\n193\t    ///\n194\t    /// Returns `Err` when `self` already has a different CID\n195\t    /// callback configured, when the requested CID length doesn't\n196\t    /// fit the chosen method, or when the AES context allocation\n197\t    /// fails.\n198\t    pub fn set_lb_cid_config(&mut self, _lb_config: &Config) -> Result<(), Error> {\n199\t        todo!()\n200\t    }\n201\t\n202\t    /// Tear down the [`ConnectionIdContext`] previously installed by\n203\t    /// [`Quic::set_lb_cid_config`], releasing the AES-ECB\n204\t    /// encryption contexts and clearing the callback slot on\n205\t    /// `self`.  No-op when no LB CID context is installed.\n206\t    /// C: `lb_compat_cid_config_free`.\n207\t    pub fn clear_lb_cid_config(&mut self) {\n208\t        todo!()\n209\t    }\n210\t}\n211\t\n212\t#[cfg(test)]\n213\tmod test {}\n214\t"}]},"parent_tool_use_id":null,"session_id":"b0ef721e-e3c5-4ce3-b9f2-772ba297c48d","uuid":"2c47b3d1-e891-4ae3-a1e1-edb33538f920","timestamp":"2026-05-05T16:02:13.907Z","tool_use_result":{"type":"text","file":{"filePath":"/Users/richbarn/Projects/picoquic/rs/fq/src/lb.rs","content":"//! Translation of `quic/lb.h`.\n//!\n//! Server-side support for the QUIC load-balancer draft\n//! (<https://datatracker.ietf.org/doc/draft-ietf-quic-load-balancers/>):\n//! parse the LB-supplied configuration string into a [`Config`],\n//! then install a per-server CID-generation / -verification context\n//! ([`ConnectionIdContext`]) on a [`Quic`] via the connection-ID\n//! callback hook.\n//!\n//! ## API shape\n//!\n//! * [`Config::parse`] takes the LB string as `&str` and returns\n//!   the populated config; the C `(char const* txt, size_t\n//!   txt_length)` pair plus zeroed out-parameter collapse to a\n//!   normal Rust constructor.\n//! * [`Quic::set_lb_cid_config`] applies a `Config` to the QUIC\n//!   context, installing the per-server CID context.\n//! * [`Quic::clear_lb_cid_config`] tears the installed context back\n//!   down (no-op when none is installed).\n//! * [`ConnectionIdContext::generate`] / [`ConnectionIdContext::verify`]\n//!   are the per-CID callback bodies.  They are exposed as inherent methods\n//!   so the eventual [`crate::ConnectionIdCallback`] trait impl can\n//!   delegate to them; the C `void* connection_id_cb_data` parameter is\n//!   recovered as `&mut self`.\n//!\n//! ## Field-shape decisions\n//!\n//! * `rotation_bits : 2` — multi-bit C bitfield, kept as `u8`\n//!   (legal range `0..=3`) per the Phase 1 bitfield rule.\n//! * `first_byte_encodes_length : 1` — single-bit C bitfield used\n//!   as a Boolean flag throughout the C body, promoted to `bool`\n//!   (matching the `config.rs` precedent).\n//! * `cid_encryption_context` / `cid_decryption_context` were\n//!   `void*` in C, holding AES-128-ECB contexts produced by\n//!   `aes128_ecb_create` and freed by `aes128_ecb_free` (both\n//!   declared in `tls_api.h`, which has not been translated yet).\n//!   The fields own their contexts in C (the clear path explicitly\n//!   calls the AES destructor), so Rust models them as\n//!   `Option<Box<Aes128EcbContext>>`, with the AES-context type\n//!   forward-declared here as an opaque struct.  `Box::drop` will\n//!   subsume the explicit `aes128_ecb_free` call once Phase 3 gives\n//!   the type a `Drop` impl.\n//! * `server_id: [u8; 16]` and `cid_encryption_key: [u8; 16]` stay\n//!   as fixed-capacity byte arrays — the C declarations are size-16\n//!   arrays and the algorithms are AES-128, so the capacity *is*\n//!   part of the contract.\n\nuse crate::Error;\nuse crate::tls_api::Aes128EcbContext;\nuse crate::{ConnectionId, Quic};\n\n/// CID-encoding method selected by the load-balancer config.\n/// C: `load_balancer_cid_method_enum`.\n#[derive(Debug, Copy, Clone, PartialEq, Eq, Default)]\npub enum ConnectionIdMethod {\n    /// Server ID copied in clear after the first byte.\n    /// C: `load_balancer_cid_clear`.\n    #[default]\n    Clear,\n    /// Server ID encrypted with an AES-128-ECB stream cipher keyed\n    /// off a per-CID nonce.\n    /// C: `load_balancer_cid_stream_cipher`.\n    StreamCipher,\n    /// Server ID encrypted with a single AES-128-ECB block.\n    /// C: `load_balancer_cid_block_cipher`.\n    BlockCipher,\n}\n\n/// Number of low bits of the first CID byte that select between\n/// short-lived configurations.  C: `unsigned int rotation_bits : 2`.\n#[derive(Debug, Copy, Clone, PartialEq, Eq, Default)]\n#[repr(u8)]\npub enum RotationBits {\n    #[default]\n    Zero = 0,\n    One = 1,\n    Two = 2,\n    Three = 3,\n}\n\n/// Configuration parsed from an LB-supplied string and applied to\n/// a [`Quic`] via [`Quic::set_lb_cid_config`].\n/// C: `load_balancer_config_t`.\n///\n/// `repr(C)` is dropped — the struct is purely an internal shape,\n/// never inspected by an LB or another process.\n///\n/// Lives in `crate::lb`; consumers that also import the demo-app\n/// [`crate::config::Config`] should rename one at the import\n/// site (`use crate::lb::Config as LbConfig;`).\n#[derive(Debug, Default)]\npub struct Config {\n    pub method: ConnectionIdMethod,\n    pub rotation_bits: RotationBits,\n    /// 1-bit field in C; promoted to `bool` to match call-site usage.\n    pub first_byte_encodes_length: bool,\n    pub server_id_length: usize,\n    /// Used in stream-cipher mode.\n    pub nonce_length: usize,\n    pub connection_id_length: usize,\n    pub server_id: u64,\n    pub cid_encryption_key: [u8; 16],\n}\n\nimpl Config {\n    /// Parse an LB-format configuration string into a fresh\n    /// [`Config`].  Returns `Err` when the string is malformed,\n    /// the embedded server ID overflows 8 bytes, or the encoded CID\n    /// length is incompatible with the chosen method.\n    /// C: `lb_compat_cid_config_parse`.\n    ///\n    /// The C signature took an out-parameter and a `(char const*\n    /// txt, size_t txt_length)` pair returning an `int`; the Rust\n    /// signature returns the populated struct in the success arm\n    /// and folds the explicit length into the `&str` slice.\n    pub fn parse(_txt: &str) -> Result<Self, Error> {\n        todo!()\n    }\n}\n\n// ---------------------------------------------------------------------------\n// Per-server CID context.\n\n/// Per-server context attached to a [`Quic`] once a load-balancer\n/// config has been applied.  Built from a [`Config`] by\n/// [`Quic::set_lb_cid_config`] and consumed by the\n/// [`crate::ConnectionIdCallback`] hook.\n/// C: `load_balancer_cid_context_t`.\n///\n/// The two AES contexts are method-dependent: [`ConnectionIdMethod::Clear`]\n/// uses neither, [`ConnectionIdMethod::StreamCipher`] uses only the\n/// encryption context (the verify path re-encrypts the nonce and XORs),\n/// and [`ConnectionIdMethod::BlockCipher`] uses both.  Hence the\n/// `Option<Box<…>>` wrappers — they encode method-dependence rather\n/// than an init-time gap.\n#[derive(Debug, Default)]\npub struct ConnectionIdContext {\n    pub method: ConnectionIdMethod,\n    pub rotation_bits: RotationBits,\n    /// 1-bit field in C; promoted to `bool`.\n    pub first_byte_encodes_length: bool,\n    pub server_id_length: usize,\n    /// Used in stream-cipher mode.\n    pub nonce_length: usize,\n    pub connection_id_length: usize,\n    pub server_id: u64,\n    /// Big-endian encoding of `server_id`, padded to\n    /// `server_id_length` bytes.\n    pub server_id_encoded: [u8; 16],\n    /// Used in stream- and block-cipher modes.  Owned by this\n    /// struct: the C clear path calls `aes128_ecb_free` on it.\n    pub cid_encryption_context: Option<Box<Aes128EcbContext>>,\n    /// Used in block-cipher mode for the verify path.  Owned the\n    /// same way.\n    pub cid_decryption_context: Option<Box<Aes128EcbContext>>,\n}\n\nimpl ConnectionIdContext {\n    /// Encode a CID from `nonce` per `self.method` and return it.\n    /// C: `lb_compat_cid_generate`.\n    ///\n    /// The C signature took a `connection_id_returned` out parameter that\n    /// the body both read (for the nonce / \"for-server use\" bytes)\n    /// and wrote (for the encoded CID); the Rust signature splits\n    /// those two roles — the input nonce comes in by reference and\n    /// the encoded CID is the return value.  `&mut self` because the\n    /// underlying AES contexts mutate cipher state in place.  `quic`\n    /// is read for `local_connection_id_length`; the unused `connection_id_local` /\n    /// `connection_id_remote` parameters of the C signature are dropped\n    /// here and reintroduced (if needed) by the\n    /// [`crate::ConnectionIdCallback`] adapter.\n    pub fn generate(&mut self, _quic: &Quic, _nonce: &ConnectionId) -> ConnectionId {\n        todo!()\n    }\n\n    /// Decode the server ID embedded in `connection_id`.  Returns `None`\n    /// when the CID length doesn't match `self.connection_id_length`\n    /// or when `self.method` is unrecognised; the C sentinel\n    /// `UINT64_MAX` is folded into `Option`.\n    /// C: `lb_compat_cid_verify`.\n    ///\n    /// `&mut self` because the underlying AES contexts mutate\n    /// cipher state in place.\n    pub fn verify(&mut self, _cnx_id: &ConnectionId) -> Option<u64> {\n        todo!()\n    }\n}\n\nimpl Quic {\n    /// Apply `lb_config` to `self`, installing a [`ConnectionIdContext`]\n    /// as the connection-ID callback context.\n    /// C: `lb_compat_cid_config`.\n    ///\n    /// Returns `Err` when `self` already has a different CID\n    /// callback configured, when the requested CID length doesn't\n    /// fit the chosen method, or when the AES context allocation\n    /// fails.\n    pub fn set_lb_cid_config(&mut self, _lb_config: &Config) -> Result<(), Error> {\n        todo!()\n    }\n\n    /// Tear down the [`ConnectionIdContext`] previously installed by\n    /// [`Quic::set_lb_cid_config`], releasing the AES-ECB\n    /// encryption contexts and clearing the callback slot on\n    /// `self`.  No-op when no LB CID context is installed.\n    /// C: `lb_compat_cid_config_free`.\n    pub fn clear_lb_cid_config(&mut self) {\n        todo!()\n    }\n}\n\n#[cfg(test)]\nmod test {}\n","numLines":214,"startLine":1,"totalLines":214}}}
{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01VbtJX2ayWee1wei2PkfgaV","type":"tool_result","content":"1\t//! Translation of `picoquic/picosocks.h` plus the Phase 2 socket\n2\t//! abstraction.\n3\t//!\n4\t//! Phase 2 reshape: the C `SOCKET_TYPE` (a Linux file descriptor)\n5\t//! is replaced by a [`Socket`] *trait* that the host platform\n6\t//! implements.  The default implementation wraps\n7\t//! [`socket2::Socket`] (the canonical cross-platform UDP socket\n8\t//! crate); other backends (no-std embedded, Windows-specific,\n9\t//! the test simulator) implement the same trait.\n10\t//! [`ServerSockets<S>`] is generic over the implementor.\n11\t//!\n12\t//! Phase 1 contract: signatures only — every method body is\n13\t//! `todo!()`.\n14\t\n15\tuse core::net::SocketAddr;\n16\t\n17\tuse crate::Error;\n18\tuse crate::Instant;\n19\t\n20\t// ---------------------------------------------------------------------------\n21\t// Constants and supporting types.\n22\t\n23\t/// Number of UDP sockets a server context owns — one IPv4, one\n24\t/// IPv6.  C: `PICOQUIC_NB_SERVER_SOCKETS`.\n25\tpub const SERVER_SOCKET_COUNT: usize = 2;\n26\t\n27\t/// `MessageHeader` is a re-export of [`socket2::MsgHdr`] — the\n28\t/// canonical cross-platform `msghdr` wrapper.  Phase 4 fills in\n29\t/// the bodies that thread one through the cmsg helpers.\n30\tpub type MessageHeader<'addr, 'bufs, 'control> = socket2::MsgHdr<'addr, 'bufs, 'control>;\n31\t\n32\t/// OS error code surfaced by socket sends when the underlying\n33\t/// syscall fails.  Wraps the raw Linux `errno` (or its Windows\n34\t/// equivalent on other targets) and exposes\n35\t/// [`OsError::is_unreachable`] for the path-abandon decision the\n36\t/// C `picoquic_socket_error_implies_unreachable` helper made.\n37\t#[derive(Debug, Copy, Clone, PartialEq, Eq)]\n38\tpub struct OsError(pub i32);\n39\t\n40\timpl OsError {\n41\t    /// Whether this errno implies the destination is unreachable\n42\t    /// and the owning path should be abandoned.  C:\n43\t    /// `picoquic_socket_error_implies_unreachable`.\n44\t    pub fn is_unreachable(self) -> bool {\n45\t        todo!()\n46\t    }\n47\t}\n48\t\n49\t// ---------------------------------------------------------------------------\n50\t// `Socket` trait.\n51\t\n52\t/// One UDP socket on the application's network stack.  Replaces\n53\t/// the C `SOCKET_TYPE` (a raw file descriptor); the host\n54\t/// implementation supplies open / bind / send / recv operations\n55\t/// while the rest of picoquic stays platform-agnostic.\n56\t///\n57\t/// The default [`socket2::Socket`] implementation is in\n58\t/// [`crate::socks_socket2`] (gated on the `std` feature).\n59\tpub trait Socket {\n60\t    /// Local address bound to this socket (`getsockname`).\n61\t    /// C: `picoquic_get_local_address`.\n62\t    fn local_address(&self) -> Result<SocketAddr, Error>;\n63\t\n64\t    /// Receive one UDP datagram into `buffer`.  Output parameters\n65\t    /// (source / dest address, interface index, ECN, byte count)\n66\t    /// fold into [`RecvInfo`]; the slice length subsumes the C\n67\t    /// `buffer_max` parameter.  C: `picoquic_recvmsg`.\n68\t    fn recv(&mut self, buffer: &mut [u8]) -> Result<RecvInfo, Error>;\n69\t\n70\t    /// Send `bytes` to `addr_dest` from `addr_from` with an\n71\t    /// optional GSO segmentation hint `gso_size` (`UDP_SEGMENT`).\n72\t    /// `addr_from = None` lets the kernel choose the source\n73\t    /// address.  `Ok(n)` reports bytes sent; `Err` carries the\n74\t    /// OS error.  C: `picoquic_sendmsg`.\n75\t    fn send(\n76\t        &mut self,\n77\t        addr_dest: &SocketAddr,\n78\t        addr_from: Option<&SocketAddr>,\n79\t        dest_if: i32,\n80\t        bytes: &[u8],\n81\t        gso_size: i32,\n82\t    ) -> Result<usize, OsError>;\n83\t\n84\t    /// Enable per-packet destination-info delivery on this\n85\t    /// socket (`IP_PKTINFO` / `IPV6_RECVPKTINFO`).  Default:\n86\t    /// no-op for backends that don't surface pktinfo.\n87\t    fn set_pkt_info(&mut self) -> Result<(), Error> {\n88\t        Ok(())\n89\t    }\n90\t\n91\t    /// Enable ECN reception (and request `ECN_ECT_1` outbound).\n92\t    /// Returns `(recv_set, send_set)` indicating whether the\n93\t    /// kernel honored each socket option.  Default: no-op,\n94\t    /// returns `(false, false)`.\n95\t    fn set_ecn_options(&mut self) -> Result<(bool, bool), Error> {\n96\t        Ok((false, false))\n97\t    }\n98\t\n99\t    /// Like [`Self::set_ecn_options`] but with an explicit\n100\t    /// outbound TOS / ECN value (`ecn` is one of the 2-bit\n101\t    /// `EcnCodepoint` codes).  Default: delegates to the\n102\t    /// no-op `set_ecn_options`.\n103\t    fn set_ecn_options_ex(&mut self, _ecn: EcnCodepoint) -> Result<(bool, bool), Error> {\n104\t        self.set_ecn_options()\n105\t    }\n106\t\n107\t    /// Enable Path-MTU-Discovery probing on this socket\n108\t    /// (Linux-only; no-op on other platforms by default).\n109\t    fn set_pmtud_options(&mut self) -> Result<(), Error> {\n110\t        Ok(())\n111\t    }\n112\t}\n113\t\n114\t// ---------------------------------------------------------------------------\n115\t// `ServerSockets` -- generic over the socket implementation.\n116\t\n117\t/// Pair of UDP sockets owned by a server (one IPv4, one IPv6).\n118\t/// C: `picoquic_server_sockets_t`.  Generic over the active\n119\t/// [`Socket`] implementation.\n120\tpub struct ServerSockets<S: Socket> {\n121\t    /// One UDP socket per address family.  `None` slots are\n122\t    /// uninitialised — see [`ServerSockets::open`] /\n123\t    /// [`ServerSockets::close`].\n124\t    pub sockets: [Option<S>; SERVER_SOCKET_COUNT],\n125\t}\n126\t\n127\timpl<S: Socket> Default for ServerSockets<S> {\n128\t    fn default() -> Self {\n129\t        Self {\n130\t            sockets: [None, None],\n131\t        }\n132\t    }\n133\t}\n134\t\n135\timpl<S: Socket> ServerSockets<S> {\n136\t    /// Open the IPv4 + IPv6 server-side UDP socket pair listening\n137\t    /// on `port`.  C: `picoquic_open_server_sockets`.  The\n138\t    /// concrete `S` implementor is chosen at the call site;\n139\t    /// the default `crate::socks_socket2::Socket2Udp` wraps\n140\t    /// [`socket2::Socket`].\n141\t    pub fn open(_port: i32) -> Result<Self, Error> {\n142\t        todo!()\n143\t    }\n144\t\n145\t    /// Close every socket in the pair, leaving each slot `None`.\n146\t    /// C: `picoquic_close_server_sockets`.\n147\t    pub fn close(&mut self) {\n148\t        todo!()\n149\t    }\n150\t\n151\t    /// Pick the matching socket (v4 / v6, dispatched by\n152\t    /// `addr_dest`'s family) and send through it.\n153\t    /// C: `picoquic_send_through_server_sockets`.\n154\t    pub fn send_through(\n155\t        &mut self,\n156\t        _addr_dest: &SocketAddr,\n157\t        _addr_from: Option<&SocketAddr>,\n158\t        _from_if: i32,\n159\t        _bytes: &[u8],\n160\t    ) -> Result<usize, OsError> {\n161\t        todo!()\n162\t    }\n163\t}\n164\t\n165\t// ---------------------------------------------------------------------------\n166\t// Receive metadata.\n167\t\n168\t/// Receive metadata returned by [`Socket::recv`].  Mirrors the\n169\t/// C output parameters folded into a single struct.\n170\t#[derive(Debug, Default, Copy, Clone)]\n171\tpub struct RecvInfo {\n172\t    /// Source address; `None` matches the C `addr_from->ss_family\n173\t    /// = 0` written when `recvmsg` returned `<= 0`.\n174\t    pub addr_from: Option<SocketAddr>,\n175\t    /// Destination address parsed out of `IP_PKTINFO` /\n176\t    /// `IPV6_PKTINFO` cmsg; `None` when no pktinfo was attached.\n177\t    pub addr_dest: Option<SocketAddr>,\n178\t    /// Receiving interface index from the same cmsg.\n179\t    pub dest_if: i32,\n180\t    /// `IP_TOS` / `IPV6_TCLASS` ECN code-point byte.\n181\t    pub received_ecn: u8,\n182\t    /// Number of bytes written into the caller's buffer.\n183\t    pub bytes_recv: usize,\n184\t}\n185\t\n186\t/// Result of [`select`].\n187\t///\n188\t/// Folds the seven nullable out-parameters of the C\n189\t/// `picoquic_select_ex` helper into one struct: source / destination\n190\t/// address, interface index, ECN code-point, byte count,\n191\t/// post-receive timestamp, and the index of the socket that fired.\n192\t#[derive(Debug, Copy, Clone)]\n193\tpub struct SelectInfo {\n194\t    pub addr_from: Option<SocketAddr>,\n195\t    pub addr_dest: Option<SocketAddr>,\n196\t    pub dest_if: i32,\n197\t    pub received_ecn: u8,\n198\t    pub bytes_recv: usize,\n199\t    pub current_time: Instant,\n200\t    pub socket_rank: usize,\n201\t}\n202\t\n203\timpl Default for SelectInfo {\n204\t    fn default() -> Self {\n205\t        Self {\n206\t            addr_from: None,\n207\t            addr_dest: None,\n208\t            dest_if: 0,\n209\t            received_ecn: 0,\n210\t            bytes_recv: 0,\n211\t            current_time: Instant::from_ticks(0),\n212\t            socket_rank: 0,\n213\t        }\n214\t    }\n215\t}\n216\t\n217\t/// Wait up to `delta_t` microseconds for a packet on any socket\n218\t/// in `sockets`, then read at most `buffer.len()` bytes.\n219\t///\n220\t/// Generic over the [`Socket`] implementation.  C:\n221\t/// `picoquic_select` and `picoquic_select_ex` are merged here —\n222\t/// the `_ex` form is the more general one; the rank lives in\n223\t/// [`SelectInfo`].\n224\tpub fn select<S: Socket>(\n225\t    _sockets: &mut [S],\n226\t    _buffer: &mut [u8],\n227\t    _delta_t: i64,\n228\t) -> Result<SelectInfo, Error> {\n229\t    todo!()\n230\t}\n231\t\n232\t// ---------------------------------------------------------------------------\n233\t// Address resolution.\n234\t\n235\t/// Resolved server address plus the \"was the input a hostname?\"\n236\t/// hint the TLS layer needs to choose an SNI value.\n237\t#[derive(Debug, Copy, Clone)]\n238\tpub struct ServerAddress {\n239\t    pub addr: SocketAddr,\n240\t    pub is_name: bool,\n241\t}\n242\t\n243\timpl ServerAddress {\n244\t    /// Parse `ip_address_text` (numeric IPv4 / IPv6 or hostname)\n245\t    /// and combine with `server_port` into a [`ServerAddress`].\n246\t    /// C: `picoquic_get_server_address`.\n247\t    pub fn resolve(_ip_address_text: &str, _server_port: i32) -> Result<Self, Error> {\n248\t        todo!()\n249\t    }\n250\t}\n251\t\n252\t// ---------------------------------------------------------------------------\n253\t// Control-message helpers (cmsg parse / format).\n254\t\n255\t/// Result of cmsg parsing.  Folds the four nullable\n256\t/// out-parameters of the C helper into one struct.\n257\t#[derive(Debug, Default, Copy, Clone)]\n258\tpub struct CmsgInfo {\n259\t    /// Destination address parsed from `IP_PKTINFO` / `IPV6_PKTINFO`;\n260\t    /// `None` when no pktinfo was attached.\n261\t    pub addr_dest: Option<SocketAddr>,\n262\t    /// Receiving interface index from the same cmsg.\n263\t    pub dest_if: Option<i32>,\n264\t    /// `IP_TOS` / `IPV6_TCLASS` ECN code-point.\n265\t    pub received_ecn: Option<EcnCodepoint>,\n266\t    /// `UDP_GRO` segment size; always `0` on Linux.\n267\t    pub udp_coalesced_size: usize,\n268\t}\n269\t\n270\t/// IP / IPv6 ECN code-point reported by the kernel on receive.\n271\t/// Mirrors the two-bit `IP_TOS` / `IPV6_TCLASS` ECN field.\n272\t#[derive(Debug, Default, Copy, Clone, PartialEq, Eq)]\n273\t#[repr(u8)]\n274\tpub enum EcnCodepoint {\n275\t    #[default]\n276\t    NotEct = 0b00,\n277\t    Ect1 = 0b01,\n278\t    Ect0 = 0b10,\n279\t    Ce = 0b11,\n280\t}\n281\t\n282\t/// Parse the control-message ancillary data attached to a\n283\t/// received `msghdr`.  C: `picoquic_socks_cmsg_parse`.\n284\tpub fn parse_cmsg(_header: &MessageHeader<'_, '_, '_>) -> CmsgInfo {\n285\t    todo!()\n286\t}\n287\t\n288\t/// Write `IP_PKTINFO` / `IPV6_PKTINFO` / `UDP_SEGMENT` control\n289\t/// messages into `header` for an outgoing datagram.  C:\n290\t/// `picoquic_socks_cmsg_format`.\n291\tpub fn format_cmsg(\n292\t    _header: &mut MessageHeader<'_, '_, '_>,\n293\t    _message_length: usize,\n294\t    _send_msg_size: usize,\n295\t    _addr_from: Option<&SocketAddr>,\n296\t    _dest_if: i32,\n297\t) {\n298\t    todo!()\n299\t}\n300\t\n301\t#[cfg(test)]\n302\tmod test {}\n303\t"}]},"parent_tool_use_id":null,"session_id":"b0ef721e-e3c5-4ce3-b9f2-772ba297c48d","uuid":"55f993f0-2d5d-44a7-a81a-af12b84e825b","timestamp":"2026-05-05T16:02:13.908Z","tool_use_result":{"type":"text","file":{"filePath":"/Users/richbarn/Projects/picoquic/rs/fq/src/socks.rs","content":"//! Translation of `picoquic/picosocks.h` plus the Phase 2 socket\n//! abstraction.\n//!\n//! Phase 2 reshape: the C `SOCKET_TYPE` (a Linux file descriptor)\n//! is replaced by a [`Socket`] *trait* that the host platform\n//! implements.  The default implementation wraps\n//! [`socket2::Socket`] (the canonical cross-platform UDP socket\n//! crate); other backends (no-std embedded, Windows-specific,\n//! the test simulator) implement the same trait.\n//! [`ServerSockets<S>`] is generic over the implementor.\n//!\n//! Phase 1 contract: signatures only — every method body is\n//! `todo!()`.\n\nuse core::net::SocketAddr;\n\nuse crate::Error;\nuse crate::Instant;\n\n// ---------------------------------------------------------------------------\n// Constants and supporting types.\n\n/// Number of UDP sockets a server context owns — one IPv4, one\n/// IPv6.  C: `PICOQUIC_NB_SERVER_SOCKETS`.\npub const SERVER_SOCKET_COUNT: usize = 2;\n\n/// `MessageHeader` is a re-export of [`socket2::MsgHdr`] — the\n/// canonical cross-platform `msghdr` wrapper.  Phase 4 fills in\n/// the bodies that thread one through the cmsg helpers.\npub type MessageHeader<'addr, 'bufs, 'control> = socket2::MsgHdr<'addr, 'bufs, 'control>;\n\n/// OS error code surfaced by socket sends when the underlying\n/// syscall fails.  Wraps the raw Linux `errno` (or its Windows\n/// equivalent on other targets) and exposes\n/// [`OsError::is_unreachable`] for the path-abandon decision the\n/// C `picoquic_socket_error_implies_unreachable` helper made.\n#[derive(Debug, Copy, Clone, PartialEq, Eq)]\npub struct OsError(pub i32);\n\nimpl OsError {\n    /// Whether this errno implies the destination is unreachable\n    /// and the owning path should be abandoned.  C:\n    /// `picoquic_socket_error_implies_unreachable`.\n    pub fn is_unreachable(self) -> bool {\n        todo!()\n    }\n}\n\n// ---------------------------------------------------------------------------\n// `Socket` trait.\n\n/// One UDP socket on the application's network stack.  Replaces\n/// the C `SOCKET_TYPE` (a raw file descriptor); the host\n/// implementation supplies open / bind / send / recv operations\n/// while the rest of picoquic stays platform-agnostic.\n///\n/// The default [`socket2::Socket`] implementation is in\n/// [`crate::socks_socket2`] (gated on the `std` feature).\npub trait Socket {\n    /// Local address bound to this socket (`getsockname`).\n    /// C: `picoquic_get_local_address`.\n    fn local_address(&self) -> Result<SocketAddr, Error>;\n\n    /// Receive one UDP datagram into `buffer`.  Output parameters\n    /// (source / dest address, interface index, ECN, byte count)\n    /// fold into [`RecvInfo`]; the slice length subsumes the C\n    /// `buffer_max` parameter.  C: `picoquic_recvmsg`.\n    fn recv(&mut self, buffer: &mut [u8]) -> Result<RecvInfo, Error>;\n\n    /// Send `bytes` to `addr_dest` from `addr_from` with an\n    /// optional GSO segmentation hint `gso_size` (`UDP_SEGMENT`).\n    /// `addr_from = None` lets the kernel choose the source\n    /// address.  `Ok(n)` reports bytes sent; `Err` carries the\n    /// OS error.  C: `picoquic_sendmsg`.\n    fn send(\n        &mut self,\n        addr_dest: &SocketAddr,\n        addr_from: Option<&SocketAddr>,\n        dest_if: i32,\n        bytes: &[u8],\n        gso_size: i32,\n    ) -> Result<usize, OsError>;\n\n    /// Enable per-packet destination-info delivery on this\n    /// socket (`IP_PKTINFO` / `IPV6_RECVPKTINFO`).  Default:\n    /// no-op for backends that don't surface pktinfo.\n    fn set_pkt_info(&mut self) -> Result<(), Error> {\n        Ok(())\n    }\n\n    /// Enable ECN reception (and request `ECN_ECT_1` outbound).\n    /// Returns `(recv_set, send_set)` indicating whether the\n    /// kernel honored each socket option.  Default: no-op,\n    /// returns `(false, false)`.\n    fn set_ecn_options(&mut self) -> Result<(bool, bool), Error> {\n        Ok((false, false))\n    }\n\n    /// Like [`Self::set_ecn_options`] but with an explicit\n    /// outbound TOS / ECN value (`ecn` is one of the 2-bit\n    /// `EcnCodepoint` codes).  Default: delegates to the\n    /// no-op `set_ecn_options`.\n    fn set_ecn_options_ex(&mut self, _ecn: EcnCodepoint) -> Result<(bool, bool), Error> {\n        self.set_ecn_options()\n    }\n\n    /// Enable Path-MTU-Discovery probing on this socket\n    /// (Linux-only; no-op on other platforms by default).\n    fn set_pmtud_options(&mut self) -> Result<(), Error> {\n        Ok(())\n    }\n}\n\n// ---------------------------------------------------------------------------\n// `ServerSockets` -- generic over the socket implementation.\n\n/// Pair of UDP sockets owned by a server (one IPv4, one IPv6).\n/// C: `picoquic_server_sockets_t`.  Generic over the active\n/// [`Socket`] implementation.\npub struct ServerSockets<S: Socket> {\n    /// One UDP socket per address family.  `None` slots are\n    /// uninitialised — see [`ServerSockets::open`] /\n    /// [`ServerSockets::close`].\n    pub sockets: [Option<S>; SERVER_SOCKET_COUNT],\n}\n\nimpl<S: Socket> Default for ServerSockets<S> {\n    fn default() -> Self {\n        Self {\n            sockets: [None, None],\n        }\n    }\n}\n\nimpl<S: Socket> ServerSockets<S> {\n    /// Open the IPv4 + IPv6 server-side UDP socket pair listening\n    /// on `port`.  C: `picoquic_open_server_sockets`.  The\n    /// concrete `S` implementor is chosen at the call site;\n    /// the default `crate::socks_socket2::Socket2Udp` wraps\n    /// [`socket2::Socket`].\n    pub fn open(_port: i32) -> Result<Self, Error> {\n        todo!()\n    }\n\n    /// Close every socket in the pair, leaving each slot `None`.\n    /// C: `picoquic_close_server_sockets`.\n    pub fn close(&mut self) {\n        todo!()\n    }\n\n    /// Pick the matching socket (v4 / v6, dispatched by\n    /// `addr_dest`'s family) and send through it.\n    /// C: `picoquic_send_through_server_sockets`.\n    pub fn send_through(\n        &mut self,\n        _addr_dest: &SocketAddr,\n        _addr_from: Option<&SocketAddr>,\n        _from_if: i32,\n        _bytes: &[u8],\n    ) -> Result<usize, OsError> {\n        todo!()\n    }\n}\n\n// ---------------------------------------------------------------------------\n// Receive metadata.\n\n/// Receive metadata returned by [`Socket::recv`].  Mirrors the\n/// C output parameters folded into a single struct.\n#[derive(Debug, Default, Copy, Clone)]\npub struct RecvInfo {\n    /// Source address; `None` matches the C `addr_from->ss_family\n    /// = 0` written when `recvmsg` returned `<= 0`.\n    pub addr_from: Option<SocketAddr>,\n    /// Destination address parsed out of `IP_PKTINFO` /\n    /// `IPV6_PKTINFO` cmsg; `None` when no pktinfo was attached.\n    pub addr_dest: Option<SocketAddr>,\n    /// Receiving interface index from the same cmsg.\n    pub dest_if: i32,\n    /// `IP_TOS` / `IPV6_TCLASS` ECN code-point byte.\n    pub received_ecn: u8,\n    /// Number of bytes written into the caller's buffer.\n    pub bytes_recv: usize,\n}\n\n/// Result of [`select`].\n///\n/// Folds the seven nullable out-parameters of the C\n/// `picoquic_select_ex` helper into one struct: source / destination\n/// address, interface index, ECN code-point, byte count,\n/// post-receive timestamp, and the index of the socket that fired.\n#[derive(Debug, Copy, Clone)]\npub struct SelectInfo {\n    pub addr_from: Option<SocketAddr>,\n    pub addr_dest: Option<SocketAddr>,\n    pub dest_if: i32,\n    pub received_ecn: u8,\n    pub bytes_recv: usize,\n    pub current_time: Instant,\n    pub socket_rank: usize,\n}\n\nimpl Default for SelectInfo {\n    fn default() -> Self {\n        Self {\n            addr_from: None,\n            addr_dest: None,\n            dest_if: 0,\n            received_ecn: 0,\n            bytes_recv: 0,\n            current_time: Instant::from_ticks(0),\n            socket_rank: 0,\n        }\n    }\n}\n\n/// Wait up to `delta_t` microseconds for a packet on any socket\n/// in `sockets`, then read at most `buffer.len()` bytes.\n///\n/// Generic over the [`Socket`] implementation.  C:\n/// `picoquic_select` and `picoquic_select_ex` are merged here —\n/// the `_ex` form is the more general one; the rank lives in\n/// [`SelectInfo`].\npub fn select<S: Socket>(\n    _sockets: &mut [S],\n    _buffer: &mut [u8],\n    _delta_t: i64,\n) -> Result<SelectInfo, Error> {\n    todo!()\n}\n\n// ---------------------------------------------------------------------------\n// Address resolution.\n\n/// Resolved server address plus the \"was the input a hostname?\"\n/// hint the TLS layer needs to choose an SNI value.\n#[derive(Debug, Copy, Clone)]\npub struct ServerAddress {\n    pub addr: SocketAddr,\n    pub is_name: bool,\n}\n\nimpl ServerAddress {\n    /// Parse `ip_address_text` (numeric IPv4 / IPv6 or hostname)\n    /// and combine with `server_port` into a [`ServerAddress`].\n    /// C: `picoquic_get_server_address`.\n    pub fn resolve(_ip_address_text: &str, _server_port: i32) -> Result<Self, Error> {\n        todo!()\n    }\n}\n\n// ---------------------------------------------------------------------------\n// Control-message helpers (cmsg parse / format).\n\n/// Result of cmsg parsing.  Folds the four nullable\n/// out-parameters of the C helper into one struct.\n#[derive(Debug, Default, Copy, Clone)]\npub struct CmsgInfo {\n    /// Destination address parsed from `IP_PKTINFO` / `IPV6_PKTINFO`;\n    /// `None` when no pktinfo was attached.\n    pub addr_dest: Option<SocketAddr>,\n    /// Receiving interface index from the same cmsg.\n    pub dest_if: Option<i32>,\n    /// `IP_TOS` / `IPV6_TCLASS` ECN code-point.\n    pub received_ecn: Option<EcnCodepoint>,\n    /// `UDP_GRO` segment size; always `0` on Linux.\n    pub udp_coalesced_size: usize,\n}\n\n/// IP / IPv6 ECN code-point reported by the kernel on receive.\n/// Mirrors the two-bit `IP_TOS` / `IPV6_TCLASS` ECN field.\n#[derive(Debug, Default, Copy, Clone, PartialEq, Eq)]\n#[repr(u8)]\npub enum EcnCodepoint {\n    #[default]\n    NotEct = 0b00,\n    Ect1 = 0b01,\n    Ect0 = 0b10,\n    Ce = 0b11,\n}\n\n/// Parse the control-message ancillary data attached to a\n/// received `msghdr`.  C: `picoquic_socks_cmsg_parse`.\npub fn parse_cmsg(_header: &MessageHeader<'_, '_, '_>) -> CmsgInfo {\n    todo!()\n}\n\n/// Write `IP_PKTINFO` / `IPV6_PKTINFO` / `UDP_SEGMENT` control\n/// messages into `header` for an outgoing datagram.  C:\n/// `picoquic_socks_cmsg_format`.\npub fn format_cmsg(\n    _header: &mut MessageHeader<'_, '_, '_>,\n    _message_length: usize,\n    _send_msg_size: usize,\n    _addr_from: Option<&SocketAddr>,\n    _dest_if: i32,\n) {\n    todo!()\n}\n\n#[cfg(test)]\nmod test {}\n","numLines":303,"startLine":1,"totalLines":303}}}
