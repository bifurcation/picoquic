meBufferTooSmall = ERROR_CLASS + 16,\n43\t    InvalidFrame = ERROR_CLASS + 17,\n44\t    CannotControlStreamZero = ERROR_CLASS + 18,\n45\t    Retry = ERROR_CLASS + 19,\n46\t    Disconnected = ERROR_CLASS + 20,\n47\t    Detected = ERROR_CLASS + 21,\n48\t    InvalidTicket = ERROR_CLASS + 23,\n49\t    InvalidFile = ERROR_CLASS + 24,\n50\t    SendBufferTooSmall = ERROR_CLASS + 25,\n51\t    UnexpectedState = ERROR_CLASS + 26,\n52\t    UnexpectedError = ERROR_CLASS + 27,\n53\t    TlsServerConWithoutCert = ERROR_CLASS + 28,\n54\t    NoSuchFile = ERROR_CLASS + 29,\n55\t    StatelessReset = ERROR_CLASS + 30,\n56\t    ConnectionDeleted = ERROR_CLASS + 31,\n57\t    CnxidSegment = ERROR_CLASS + 32,\n58\t    CnxidNotAvailable = ERROR_CLASS + 33,\n59\t    MigrationDisabled = ERROR_CLASS + 34,\n60\t    CannotComputeKey = ERROR_CLASS + 35,\n61\t    CannotSetActiveStream = ERROR_CLASS + 36,\n62\t    CannotChangeActiveContext = ERROR_CLASS + 37,\n63\t    InvalidToken = ERROR_CLASS + 38,\n64\t    InitialCidTooShort = ERROR_CLASS + 39,\n65\t    KeyRotationNotReady = ERROR_CLASS + 40,\n66\t    AeadNotReady = ERROR_CLASS + 41,\n67\t    NoAlpnProvided = ERROR_CLASS + 42,\n68\t    NoCallbackProvided = ERROR_CLASS + 43,\n69\t    /// Not actually an error: signals that the stream-receive\n70\t    /// callback consumed all available bytes.\n71\t    StreamReceiveComplete = ERROR_CLASS + 44,\n72\t    PacketHeaderParsing = ERROR_CLASS + 45,\n73\t    QuicBitMissing = ERROR_CLASS + 46,\n74\t    /// Not an error: terminates the packet loop cleanly.\n75\t    NoErrorTerminatePacketLoop = ERROR_CLASS + 47,\n76\t    /// Not an error: simulated NAT for tests.\n77\t    NoErrorSimulateNat = ERROR_CLASS + 48,\n78\t    /// Not an error: simulated migration for tests.\n79\t    NoErrorSimulateMigration = ERROR_CLASS + 49,\n80\t    VersionNotSupported = ERROR_CLASS + 50,\n81\t    IdleTimeout = ERROR_CLASS + 51,\n82\t    RepeatTimeout = ERROR_CLASS + 52,\n83\t    HandshakeTimeout = ERROR_CLASS + 53,\n84\t    SocketError = ERROR_CLASS + 54,\n85\t    VersionNegotiation = ERROR_CLASS + 55,\n86\t    PacketTooLong = ERROR_CLASS + 56,\n87\t    PacketWrongVersion = ERROR_CLASS + 57,\n88\t    PortBlocked = ERROR_CLASS + 58,\n89\t    DatagramTooLong = ERROR_CLASS + 59,\n90\t    PathIdInvalid = ERROR_CLASS + 60,\n91\t    RetryNeeded = ERROR_CLASS + 61,\n92\t    ServerBusy = ERROR_CLASS + 62,\n93\t    PathDuplicate = ERROR_CLASS + 63,\n94\t    PathIdBlocked = ERROR_CLASS + 64,\n95\t    PathCidBlocked = ERROR_CLASS + 65,\n96\t    PathAddressFamily = ERROR_CLASS + 66,\n97\t    PathNotReady = ERROR_CLASS + 67,\n98\t    PathLimitExceeded = ERROR_CLASS + 68,\n99\t    /// Not an error: the packet was captured by a proxy and needs\n100\t    /// no further processing.\n101\t    Redirected = ERROR_CLASS + 69,\n102\t    PaddingPacket = ERROR_CLASS + 70,\n103\t}\n104\t\n105\timpl InternalError {\n106\t    /// Short textual name for `error_code`, taking a raw `u64` so\n107\t    /// callers can also name unknown / extension codes.  C:\n108\t    /// `error_name`.\n109\t    pub fn name(error_code: u64) -> Option<&'static str> {\n110\t        match error_code {\n111\t            0x1 => Some(\"internal\"),\n112\t            0x2 => Some(\"server busy\"),\n113\t            0x3 => Some(\"flow control\"),\n114\t            0x4 => Some(\"stream limit\"),\n115\t            0x5 => Some(\"stream state\"),\n116\t            0x6 => Some(\"final offset\"),\n117\t            0x7 => Some(\"frame format\"),\n118\t            0x8 => Some(\"parameter\"),\n119\t            0x9 => Some(\"connection_id limit\"),\n120\t            0xA => Some(\"protocol violation\"),\n121\t            0xB => Some(\"invalid token\"),\n122\t            0xC => Some(\"application\"),\n123\t            0xD => Some(\"crypto buffer exceeded\"),\n124\t            0xE => Some(\"key update\"),\n125\t            0xF => Some(\"aead limit\"),\n126\t            0x11 => Some(\"version negotiation\"),\n127\t            0x178 => Some(\"wrong alpn\"),\n1