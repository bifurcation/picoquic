hing socket (v4 / v6, dispatched by\n    /// `addr_dest`'s family) and send through it.\n    /// C: `picoquic_send_through_server_sockets`.\n    pub fn send_through(\n        &mut self,\n        addr_dest: &SocketAddr,\n        addr_from: Option<&SocketAddr>,\n        from_if: i32,\n        bytes: &[u8],\n    ) -> Result<usize, OsError> {\n        let idx = if addr_dest.is_ipv4() { 1 } else { 0 };\n        match &mut self.sockets[idx] {\n            Some(s) => s.send(addr_dest, addr_from, from_if, bytes, 0),\n            None => Err(OsError(-1)),\n        }\n    }\n}"},"caller":{"type":"direct"}}],"stop_reason":null,"stop_sequence":null,"stop_details":null,"usage":{"input_tokens":1,"cache_creation_input_tokens":520,"cache_read_input_tokens":61263,"cache_creation":{"ephemeral_5m_input_tokens":0,"ephemeral_1h_input_tokens":520},"output_tokens":4,"service_tier":"standard","inference_geo":"not_available"},"diagnostics":null,"context_management":null},"parent_tool_use_id":null,"session_id":"b0ef721e-e3c5-4ce3-b9f2-772ba297c48d","uuid":"21268e53-4470-4197-bfca-7183e2d95d52"}
