{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01DBKXFtJjf6JRshMfphMoqR","type":"tool_result","content":"1\t/*\n2\t* Author: Christian Huitema\n3\t* Copyright (c) 2019, Private Octopus, Inc.\n4\t* All rights reserved.\n5\t*\n6\t* Permission to use, copy, modify, and distribute this software for any\n7\t* purpose with or without fee is hereby granted, provided that the above\n8\t* copyright notice and this permission notice appear in all copies.\n9\t*\n10\t* THIS SOFTWARE IS PROVIDED BY THE COPYRIGHT HOLDERS AND CONTRIBUTORS \"AS IS\" AND\n11\t* ANY EXPRESS OR IMPLIED WARRANTIES, INCLUDING, BUT NOT LIMITED TO, THE IMPLIED\n12\t* WARRANTIES OF MERCHANTABILITY AND FITNESS FOR A PARTICULAR PURPOSE ARE\n13\t* DISCLAIMED. IN NO EVENT SHALL Private Octopus, Inc. BE LIABLE FOR ANY\n14\t* DIRECT, INDIRECT, INCIDENTAL, SPECIAL, EXEMPLARY, OR CONSEQUENTIAL DAMAGES\n15\t* (INCLUDING, BUT NOT LIMITED TO, PROCUREMENT OF SUBSTITUTE GOODS OR SERVICES;\n16\t* LOSS OF USE, DATA, OR PROFITS; OR BUSINESS INTERRUPTION) HOWEVER CAUSED AND\n17\t* ON ANY THEORY OF LIABILITY, WHETHER IN CONTRACT, STRICT LIABILITY, OR TORT\n18\t* (INCLUDING NEGLIGENCE OR OTHERWISE) ARISING IN ANY WAY OUT OF THE USE OF THIS\n19\t* SOFTWARE, EVEN IF ADVISED OF THE POSSIBILITY OF SUCH DAMAGE.\n20\t*/\n21\t\n22\t#include \"picoquic_internal.h\"\n23\t#include <stdlib.h>\n24\t#include <string.h>\n25\t#include \"cc_common.h\"\n26\t\n27\tuint64_t picoquic_cc_get_sequence_number(picoquic_cnx_t* cnx, picoquic_path_t* path_x)\n28\t{\n29\t    uint64_t sequence_number;\n30\t\n31\t    if (cnx->is_multipath_enabled) {\n32\t            sequence_number = path_x->pkt_ctx.send_sequence;\n33\t        }\n34\t    else {\n35\t       sequence_number = cnx->pkt_ctx[picoquic_packet_context_application].send_sequence;\n36\t    }\n37\t\n38\t    return sequence_number;\n39\t}\n40\t\n41\tuint64_t picoquic_cc_get_ack_number(picoquic_cnx_t* cnx, picoquic_path_t* path_x)\n42\t{\n43\t    uint64_t highest_acknowledged;\n44\t\n45\t    if (cnx->is_multipath_enabled) {\n46\t        highest_acknowledged = path_x->pkt_ctx.highest_acknowledged;\n47\t    }\n48\t    else {\n49\t        highest_acknowledged = cnx->pkt_ctx[picoquic_packet_context_application].highest_acknowledged;\n50\t    }\n51\t\n52\t    return highest_acknowledged;\n53\t}\n54\t\n55\tuint64_t picoquic_cc_get_lowest_not_ack(picoquic_path_t* path_x)\n56\t{\n57\t    picoquic_packet_context_t* pkt_ctx = (path_x->cnx->is_multipath_enabled) ? &path_x->pkt_ctx : &path_x->cnx->pkt_ctx[picoquic_packet_context_application];\n58\t    uint64_t lowest_not_ack = (pkt_ctx->pending_first != NULL) ? pkt_ctx->pending_first->sequence_number : pkt_ctx->highest_acknowledged + 1;\n59\t\n60\t    return lowest_not_ack;\n61\t}\n62\t\n63\tuint64_t picoquic_cc_get_ack_sent_time(picoquic_cnx_t* cnx, picoquic_path_t* path_x)\n64\t{\n65\t    uint64_t latest_time_acknowledged;\n66\t\n67\t    if (cnx->is_multipath_enabled) {\n68\t        latest_time_acknowledged = path_x->pkt_ctx.latest_time_acknowledged;\n69\t    }\n70\t    else {\n71\t        latest_time_acknowledged = cnx->pkt_ctx[picoquic_packet_context_application].latest_time_acknowledged;\n72\t    }\n73\t\n74\t    return latest_time_acknowledged;\n75\t}\n76\t\n77\t\n78\tvoid picoquic_cc_filter_rtt_min_max(picoquic_min_max_rtt_t * rtt_track, uint64_t rtt)\n79\t{\n80\t    int x = rtt_track->sample_current;\n81\t    int x_max;\n82\t\n83\t    rtt_track->samples[x] = rtt;\n84\t\n85\t    rtt_track->sample_current = x + 1;\n86\t    if (rtt_track->sample_current >= PICOQUIC_MIN_MAX_RTT_SCOPE) {\n87\t        rtt_track->is_init = 1;\n88\t        rtt_track->sample_current = 0;\n89\t    }\n90\t    \n91\t    x_max = (rtt_track->is_init) ? PICOQUIC_MIN_MAX_RTT_SCOPE : x + 1;\n92\t\n93\t    rtt_track->sample_min = rtt_track->samples[0];\n94\t    rtt_track->sample_max = rtt_track->samples[0];\n95\t\n96\t    for (int i = 1; i < x_max; i++) {\n97\t        if (rtt_track->samples[i] < rtt_track->sample_min) {\n98\t            rtt_track->sample_min = rtt_track->samples[i];\n99\t        } else if (rtt_track->samples[i] > rtt_track->sample_max) {\n100\t            rtt_track->sample_max = rtt_track->samples[i];\n101\t        }\n102\t    }\n103\t}\n104\t\n105\tint picoquic_cc_hystart_loss_test(picoquic_min_max_rtt_t* rtt_track, picoquic_congestion_notification_t event,\n106\t    uint64_t lost_packet_number, double error_rate_max)\n107\t{\n108\t    int ret = 0;\n109\t    uint64_t next_number = rtt_track->last_lost_packet_number;\n110\t\n111\t    if (lost_packet_number > next_number) {\n112\t        if (next_number + PICOQUIC_SMOOTHED_LOSS_SCOPE < lost_packet_number) {\n113\t            next_number = lost_packet_number - PICOQUIC_SMOOTHED_LOSS_SCOPE;\n114\t        }\n115\t\n116\t        while (next_number < lost_packet_number) {\n117\t            rtt_track->smoothed_drop_rate *= (1.0 - PICOQUIC_SMOOTHED_LOSS_FACTOR);\n118\t            next_number++;\n119\t        }\n120\t\n121\t        rtt_track->smoothed_drop_rate += (1.0 - rtt_track->smoothed_drop_rate) * PICOQUIC_SMOOTHED_LOSS_FACTOR;\n122\t        rtt_track->last_lost_packet_number = lost_packet_number;\n123\t\n124\t        switch (event) {\n125\t        case picoquic_congestion_notification_repeat:\n126\t            ret = rtt_track->smoothed_drop_rate > error_rate_max;\n127\t            break;\n128\t        case picoquic_congestion_notification_timeout:\n129\t            ret = 1;\n130\t        default:\n131\t            break;\n132\t        }\n133\t    }\n134\t\n135\t    return ret;\n136\t}\n137\t\n138\tint picoquic_cc_hystart_loss_volume_test(picoquic_min_max_rtt_t* rtt_track, picoquic_congestion_notification_t event,  uint64_t nb_bytes_newly_acked, uint64_t nb_bytes_newly_lost)\n139\t{\n140\t    int ret = 0;\n141\t\n142\t    rtt_track->smoothed_bytes_lost_16 -= rtt_track->smoothed_bytes_lost_16 / 16;\n143\t    rtt_track->smoothed_bytes_lost_16 += nb_bytes_newly_lost;\n144\t    rtt_track->smoothed_bytes_sent_16 -= rtt_track->smoothed_bytes_sent_16 / 16;\n145\t    rtt_track->smoothed_bytes_sent_16 += nb_bytes_newly_acked + nb_bytes_newly_lost;\n146\t\n147\t    if (rtt_track->smoothed_bytes_sent_16 > 0) {\n148\t        rtt_track->smoothed_drop_rate = ((double)rtt_track->smoothed_bytes_lost_16) / ((double)rtt_track->smoothed_bytes_sent_16);\n149\t    }\n150\t    else {\n151\t        rtt_track->smoothed_drop_rate = 0;\n152\t    }\n153\t\n154\t    switch (event) {\n155\t    case picoquic_congestion_notification_acknowledgement:\n156\t        ret = rtt_track->smoothed_drop_rate > PICOQUIC_SMOOTHED_LOSS_THRESHOLD;\n157\t        break;\n158\t    case picoquic_congestion_notification_timeout:\n159\t        ret = 1;\n160\t    default:\n161\t        break;\n162\t    }\n163\t\n164\t    return ret;\n165\t}\n166\t\n167\tint picoquic_cc_hystart_test(picoquic_min_max_rtt_t* rtt_track, uint64_t rtt_measurement, uint64_t packet_time, uint64_t current_time, int is_one_way_delay_enabled)\n168\t{\n169\t    int ret = 0;\n170\t\n171\t    /* Add silly instruction to bypass \"argument not use\" warning without changing the signature */\n172\t    if (is_one_way_delay_enabled && rtt_measurement == 0) {\n173\t        return 0;\n174\t    }\n175\t\n176\t    if(current_time > rtt_track->last_rtt_sample_time + 1000) {\n177\t        picoquic_cc_filter_rtt_min_max(rtt_track, rtt_measurement);\n178\t        rtt_track->last_rtt_sample_time = current_time;\n179\t\n180\t        if (rtt_track->is_init) {\n181\t            uint64_t delta_max;\n182\t\n183\t            if (rtt_track->rtt_filtered_min == 0 ||\n184\t                rtt_track->rtt_filtered_min > rtt_track->sample_max) {\n185\t                rtt_track->rtt_filtered_min = rtt_track->sample_max;\n186\t            }\n187\t            delta_max = rtt_track->rtt_filtered_min / 4;\n188\t            if (delta_max < packet_time) {\n189\t                delta_max = packet_time;\n190\t            }\n191\t\n192\t            if (rtt_track->sample_min > rtt_track->rtt_filtered_min) {\n193\t                if (rtt_track->sample_min > rtt_track->rtt_filtered_min + delta_max) {\n194\t                    rtt_track->nb_rtt_excess++;\n195\t                    if (rtt_track->nb_rtt_excess >= PICOQUIC_MIN_MAX_RTT_SCOPE) {\n196\t                        /* RTT increased too much, get out of slow start! */\n197\t                        ret = 1;\n198\t                    }\n199\t                }\n200\t            }\n201\t            else {\n202\t                rtt_track->nb_rtt_excess = 0;\n203\t            }\n204\t        }\n205\t    }\n206\t\n207\t    return ret;\n208\t}\n209\t\n210\tuint64_t picoquic_cc_slow_start_increase(picoquic_path_t * path_x, uint64_t nb_delivered) {\n211\t    /* App limited. */\n212\t    /* TODO discuss\n213\t     * path_x->cwin < path_x->bytes_in_transit returns false in cc code\n214\t     * path_x->cnx->cwin_blocked is set to true\n215\t     * (path_x->cwin < path_x->bytes_in_transit) != path_x->cnx->cwin_blocked?\n216\t     */\n217\t    if (!path_x->cnx->cwin_blocked) {\n218\t        return 0;\n219\t    }\n220\t\n221\t    return nb_delivered;\n222\t}\n223\t\n224\tuint64_t picoquic_cc_slow_start_increase_ex(picoquic_path_t * path_x, uint64_t nb_delivered, int in_css)\n225\t{\n226\t    if (in_css) {\n227\t        /* In consecutive Slow Start. */\n228\t        return picoquic_cc_slow_start_increase(path_x, nb_delivered / PICOQUIC_HYSTART_PP_CSS_GROWTH_DIVISOR);\n229\t    }\n230\t\n231\t    /* Fallback to traditional Slow Start. */\n232\t    return picoquic_cc_slow_start_increase(path_x, nb_delivered); /* nb_delivered; */\n233\t}\n234\t\n235\tuint64_t picoquic_cc_slow_start_increase_ex2(picoquic_path_t* path_x, uint64_t nb_delivered, int in_css, uint64_t prague_alpha) {\n236\t    if (prague_alpha != 0) { /* monitoring of ECN */\n237\t        uint64_t delta = nb_delivered;\n238\t\n239\t        /* Calculate delta based on prague_ahpha. */\n240\t        if (path_x->smoothed_rtt <= PICOQUIC_TARGET_RENO_RTT) {\n241\t            /* smoothed_rtt <= 100ms */\n242\t            delta *= (1024 - prague_alpha);\n243\t            delta /= 1024;\n244\t        } else {\n245\t            delta *= path_x->smoothed_rtt;\n246\t            delta *= (1024 - prague_alpha);\n247\t            delta /= PICOQUIC_TARGET_RENO_RTT;\n248\t            delta /= 1024;\n249\t        }\n250\t\n251\t        return picoquic_cc_slow_start_increase_ex(path_x, delta, in_css);\n252\t    }\n253\t\n254\t    /* Fallback to HyStart++ Consecutive Slow Start. */\n255\t    return picoquic_cc_slow_start_increase_ex(path_x, nb_delivered, in_css);\n256\t}\n257\t\n258\tuint64_t picoquic_cc_update_target_cwin_estimation(picoquic_path_t* path_x) {\n259\t    /* RTT measurements will happen after the bandwidth is estimated. */\n260\t    uint64_t max_win = PICOQUIC_BYTES_FROM_RATE(path_x->smoothed_rtt, path_x->peak_bandwidth_estimate);\n261\t    uint64_t min_win = max_win / 2;\n262\t\n263\t    /* Return increased cwin, if larger than current cwin. */\n264\t    if (min_win > path_x->cwin) {\n265\t        return min_win;\n266\t    }\n267\t\n268\t    /* Otherwise, return current cwin. */\n269\t    return path_x->cwin;\n270\t}\n271\t\n272\tuint64_t picoquic_cc_update_cwin_for_long_rtt(picoquic_path_t * path_x) {\n273\t    uint64_t min_cwnd;\n274\t\n275\t    if (path_x->rtt_min > PICOQUIC_TARGET_SATELLITE_RTT) {\n276\t        min_cwnd = (uint64_t)((double)PICOQUIC_CWIN_INITIAL * (double)PICOQUIC_TARGET_SATELLITE_RTT / (double)PICOQUIC_TARGET_RENO_RTT);\n277\t    }\n278\t    else {\n279\t        min_cwnd = (uint64_t)((double)PICOQUIC_CWIN_INITIAL * (double)path_x->rtt_min / (double)PICOQUIC_TARGET_RENO_RTT);\n280\t    }\n281\t\n282\t    /* Return increased cwin, if larger than current cwin. */\n283\t    if (min_cwnd > path_x->cwin) {\n284\t        return min_cwnd;\n285\t    }\n286\t\n287\t    /* Otherwise, return current cwin. */\n288\t    return path_x->cwin;\n289\t}\n290\t\n291\tuint64_t picoquic_cc_increased_window(picoquic_cnx_t* cnx, uint64_t previous_window)\n292\t{\n293\t    uint64_t new_window;\n294\t    if (cnx->path[0]->rtt_min <= PICOQUIC_TARGET_RENO_RTT) {\n295\t        new_window = previous_window * 2;\n296\t    }\n297\t    else {\n298\t        double w = (double)previous_window;\n299\t        w /= (double)PICOQUIC_TARGET_RENO_RTT;\n300\t        w *= (cnx->path[0]->rtt_min > PICOQUIC_TARGET_SATELLITE_RTT) ? PICOQUIC_TARGET_SATELLITE_RTT : (double)cnx->path[0]->rtt_min;\n301\t        new_window = (uint64_t)w;\n302\t    }\n303\t    return new_window;\n304\t}\n305\t"}]},"parent_tool_use_id":"toolu_01XSHuotdUztNsUFSZAT9Qwd","session_id":"b0ef721e-e3c5-4ce3-b9f2-772ba297c48d","uuid":"4eb18285-7ca5-49fe-b1a2-e7eb4f06298c","timestamp":"2026-05-05T16:12:52.059Z"}
{"type":"assistant","message":{"model":"claude-haiku-4-5-20251001","id":"msg_01LahdXwgvULn1UPRSY4tZUF","type":"message","role":"assistant","content":[{"type":"tool_use","id":"toolu_01KhhLPM3wg8tYcaJo7McBaf","name":"Read","input":{"file_path":"/Users/richbarn/Projects/picoquic/picoquic/newreno.c"},"caller":{"type":"direct"}}],"stop_reason":null,"stop_sequence":null,"stop_details":null,"usage":{"input_tokens":2,"cache_creation_input_tokens":16533,"cache_read_input_tokens":0,"cache_creation":{"ephemeral_5m_input_tokens":16533,"ephemeral_1h_input_tokens":0},"output_tokens":4,"service_tier":"standard","inference_geo":"not_available"},"diagnostics":null,"context_management":null},"parent_tool_use_id":"toolu_01XSHuotdUztNsUFSZAT9Qwd","session_id":"b0ef721e-e3c5-4ce3-b9f2-772ba297c48d","uuid":"52452b22-968d-4825-aa3a-7522b891a84d"}
{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01KhhLPM3wg8tYcaJo7McBaf","type":"tool_result","content":"1\t/*\n2\t* Author: Christian Huitema\n3\t* Copyright (c) 2017, Private Octopus, Inc.\n4\t* All rights reserved.\n5\t*\n6\t* Permission to use, copy, modify, and distribute this software for any\n7\t* purpose with or without fee is hereby granted, provided that the above\n8\t* copyright notice and this permission notice appear in all copies.\n9\t*\n10\t* THIS SOFTWARE IS PROVIDED BY THE COPYRIGHT HOLDERS AND CONTRIBUTORS \"AS IS\" AND\n11\t* ANY EXPRESS OR IMPLIED WARRANTIES, INCLUDING, BUT NOT LIMITED TO, THE IMPLIED\n12\t* WARRANTIES OF MERCHANTABILITY AND FITNESS FOR A PARTICULAR PURPOSE ARE\n13\t* DISCLAIMED. IN NO EVENT SHALL Private Octopus, Inc. BE LIABLE FOR ANY\n14\t* DIRECT, INDIRECT, INCIDENTAL, SPECIAL, EXEMPLARY, OR CONSEQUENTIAL DAMAGES\n15\t* (INCLUDING, BUT NOT LIMITED TO, PROCUREMENT OF SUBSTITUTE GOODS OR SERVICES;\n16\t* LOSS OF USE, DATA, OR PROFITS; OR BUSINESS INTERRUPTION) HOWEVER CAUSED AND\n17\t* ON ANY THEORY OF LIABILITY, WHETHER IN CONTRACT, STRICT LIABILITY, OR TORT\n18\t* (INCLUDING NEGLIGENCE OR OTHERWISE) ARISING IN ANY WAY OUT OF THE USE OF THIS\n19\t* SOFTWARE, EVEN IF ADVISED OF THE POSSIBILITY OF SUCH DAMAGE.\n20\t*/\n21\t\n22\t#include \"picoquic_internal.h\"\n23\t#include <stdlib.h>\n24\t#include <string.h>\n25\t#include \"cc_common.h\"\n26\t\n27\t#define NB_RTT_RENO 4\n28\t\n29\t/* Many congestion control algorithms run a parallel version of new reno in order\n30\t * to provide a lower bound estimate of either the congestion window or the\n31\t * the minimal bandwidth. This implementation of new reno does not directly\n32\t * refer to the connection and path variables (e.g. cwin) but instead sets\n33\t * its entire state in memory.\n34\t */\n35\t\n36\tvoid picoquic_newreno_sim_reset(picoquic_newreno_sim_state_t * nrss)\n37\t{\n38\t    /* Initialize the state of the congestion control algorithm */\n39\t    memset(nrss, 0, sizeof(picoquic_newreno_sim_state_t));\n40\t    nrss->alg_state = picoquic_newreno_alg_slow_start;\n41\t    nrss->ssthresh = UINT64_MAX;\n42\t    nrss->cwin = PICOQUIC_CWIN_INITIAL;\n43\t}\n44\t\n45\t/* The recovery state last 1 RTT, during which parameters will be frozen\n46\t */\n47\tstatic void picoquic_newreno_sim_enter_recovery(\n48\t    picoquic_newreno_sim_state_t* nr_state,\n49\t    picoquic_cnx_t* cnx,\n50\t    picoquic_path_t * path_x,\n51\t    picoquic_congestion_notification_t notification,\n52\t    uint64_t current_time)\n53\t{\n54\t    nr_state->ssthresh = nr_state->cwin / 2;\n55\t    if (nr_state->ssthresh < PICOQUIC_CWIN_MINIMUM) {\n56\t        nr_state->ssthresh = PICOQUIC_CWIN_MINIMUM;\n57\t    }\n58\t\n59\t    if (notification == picoquic_congestion_notification_timeout) {\n60\t        nr_state->cwin = PICOQUIC_CWIN_MINIMUM;\n61\t        nr_state->alg_state = picoquic_newreno_alg_slow_start;\n62\t    }\n63\t    else {\n64\t        nr_state->cwin = nr_state->ssthresh;\n65\t        nr_state->alg_state = picoquic_newreno_alg_congestion_avoidance;\n66\t    }\n67\t\n68\t    nr_state->recovery_start = current_time;\n69\t    nr_state->recovery_sequence = picoquic_cc_get_sequence_number(cnx, path_x);\n70\t    nr_state->residual_ack = 0;\n71\t}\n72\t\n73\t/* Update cwin per signaled bandwidth\n74\t */\n75\tstatic void picoquic_newreno_sim_seed_cwin(picoquic_newreno_sim_state_t* nr_state, uint64_t seed_cwin)\n76\t{\n77\t    if (nr_state->alg_state == picoquic_newreno_alg_slow_start &&\n78\t        nr_state->ssthresh == UINT64_MAX) {\n79\t        if (seed_cwin > nr_state->cwin) {\n80\t            nr_state->cwin = seed_cwin;\n81\t            nr_state->ssthresh = seed_cwin;\n82\t            nr_state->alg_state = picoquic_newreno_alg_congestion_avoidance;\n83\t        }\n84\t    }\n85\t}\n86\t\n87\t\n88\t/* Notification API for new Reno simulations.\n89\t */\n90\tvoid picoquic_newreno_sim_notify(\n91\t    picoquic_newreno_sim_state_t* nr_state,\n92\t    picoquic_cnx_t* cnx,\n93\t    picoquic_path_t* path_x,\n94\t    picoquic_congestion_notification_t notification,\n95\t    picoquic_per_ack_state_t * ack_state,\n96\t    uint64_t current_time)\n97\t{\n98\t    switch (notification) {\n99\t    case picoquic_congestion_notification_acknowledgement: {\n100\t        switch (nr_state->alg_state) {\n101\t        case picoquic_newreno_alg_slow_start:\n102\t            /* TODO discuss app limited for pure reno too? */\n103\t            /* following tests will fail:\n104\t             * memlog keylog_test packet_trace ready_to_send ready_to_skip ready_to_zfin ready_to_zero pacing_update\n105\t             * quality_update multipath_callback multipath_quality multipath_stream_af\n106\t             */\n107\t            nr_state->cwin += ack_state->nb_bytes_acknowledged;\n108\t            /* nr_state->cwin += picoquic_cc_slow_start_increase(path_x, ack_state->nb_bytes_acknowledged); */\n109\t\n110\t            /* if cnx->cwin exceeds SSTHRESH, exit and go to CA */\n111\t            if (nr_state->cwin >= nr_state->ssthresh) {\n112\t                nr_state->alg_state = picoquic_newreno_alg_congestion_avoidance;\n113\t            }\n114\t            break;\n115\t        case picoquic_newreno_alg_congestion_avoidance: {\n116\t            uint64_t complete_delta = ack_state->nb_bytes_acknowledged * path_x->send_mtu + nr_state->residual_ack;\n117\t            nr_state->residual_ack = complete_delta % nr_state->cwin;\n118\t            nr_state->cwin += complete_delta / nr_state->cwin;\n119\t            break;\n120\t        }\n121\t        }\n122\t        break;\n123\t    }\n124\t    case picoquic_congestion_notification_ecn_ec:\n125\t    case picoquic_congestion_notification_repeat:\n126\t    case picoquic_congestion_notification_timeout:\n127\t        /* if the loss happened in this period, enter recovery */\n128\t        if (nr_state->recovery_sequence <= ack_state->lost_packet_number) {\n129\t        /* if (nr_state->recovery_sequence <= ack_state->lost_packet_number) { */\n130\t            picoquic_newreno_sim_enter_recovery(nr_state, cnx, path_x, notification, current_time);\n131\t        }\n132\t        break;\n133\t    case picoquic_congestion_notification_spurious_repeat:\n134\t        if (!cnx->is_multipath_enabled) {\n135\t            if (current_time - nr_state->recovery_start < path_x->smoothed_rtt &&\n136\t                nr_state->recovery_sequence > picoquic_cc_get_ack_number(cnx, path_x)) {\n137\t                /* If spurious repeat of initial loss detected,\n138\t                 * exit recovery and reset threshold to pre-entry cwin.\n139\t                 */\n140\t                if (nr_state->ssthresh != UINT64_MAX &&\n141\t                    nr_state->cwin < 2 * nr_state->ssthresh) {\n142\t                    nr_state->cwin = 2 * nr_state->ssthresh;\n143\t                    nr_state->alg_state = picoquic_newreno_alg_congestion_avoidance;\n144\t                }\n145\t            }\n146\t        }\n147\t        else {\n148\t            if (current_time - nr_state->recovery_start < path_x->smoothed_rtt &&\n149\t                nr_state->recovery_start > picoquic_cc_get_ack_sent_time(cnx, path_x)) {\n150\t                /* If spurious repeat of initial loss detected,\n151\t                 * exit recovery and reset threshold to pre-entry cwin.\n152\t                 */\n153\t                if (nr_state->ssthresh != UINT64_MAX &&\n154\t                    nr_state->cwin < 2 * nr_state->ssthresh) {\n155\t                    nr_state->cwin = 2 * nr_state->ssthresh;\n156\t                    nr_state->alg_state = picoquic_newreno_alg_congestion_avoidance;\n157\t                }\n158\t            }\n159\t        }\n160\t        break;\n161\t    case picoquic_congestion_notification_reset:\n162\t        picoquic_newreno_sim_reset(nr_state);\n163\t        break;\n164\t    case picoquic_congestion_notification_seed_cwin:\n165\t        picoquic_newreno_sim_seed_cwin(nr_state, ack_state->nb_bytes_acknowledged);\n166\t        break;\n167\t    default:\n168\t        /* ignore */\n169\t        break;\n170\t    }\n171\t}\n172\t\n173\t\n174\t/* Actual implementation of New Reno, when used as a stand alone algorithm\n175\t */\n176\t\n177\ttypedef struct st_picoquic_newreno_state_t {\n178\t    picoquic_newreno_sim_state_t nrss;\n179\t    picoquic_min_max_rtt_t rtt_filter;\n180\t} picoquic_newreno_state_t;\n181\t\n182\tstatic void picoquic_newreno_reset(picoquic_newreno_state_t* nr_state, picoquic_path_t* path_x)\n183\t{\n184\t    memset(nr_state, 0, sizeof(picoquic_newreno_state_t));\n185\t    picoquic_newreno_sim_reset(&nr_state->nrss);\n186\t    path_x->cwin = nr_state->nrss.cwin;\n187\t}\n188\t\n189\tstatic void picoquic_newreno_init(picoquic_path_t* path_x, char const* UNUSED(option_string), uint64_t UNUSED(current_time))\n190\t{\n191\t    /* Initialize the state of the congestion control algorithm */\n192\t    picoquic_newreno_state_t* nr_state = (picoquic_newreno_state_t*)malloc(sizeof(picoquic_newreno_state_t));\n193\t#ifdef _WINDOWS\n194\t    UNREFERENCED_PARAMETER(current_time);\n195\t    UNREFERENCED_PARAMETER(option_string);\n196\t#endif\n197\t\n198\t    if (nr_state != NULL) {\n199\t        picoquic_newreno_reset(nr_state, path_x);\n200\t        path_x->congestion_alg_state = nr_state;\n201\t    }\n202\t    else {\n203\t        path_x->congestion_alg_state = NULL;\n204\t    }\n205\t}\n206\t\n207\t/*\n208\t * Properly implementing New Reno requires managing a number of\n209\t * signals, such as packet losses or acknowledgements. We attempt\n210\t * to condensate all that in a single API, which could be shared\n211\t * by many different congestion control algorithms.\n212\t */\n213\tstatic void picoquic_newreno_notify(\n214\t    picoquic_cnx_t * cnx,\n215\t    picoquic_path_t* path_x,\n216\t    picoquic_congestion_notification_t notification,\n217\t    picoquic_per_ack_state_t * ack_state,\n218\t    uint64_t current_time)\n219\t{\n220\t    picoquic_newreno_state_t* nr_state = (picoquic_newreno_state_t*)path_x->congestion_alg_state;\n221\t\n222\t    path_x->is_cc_data_updated = 1;\n223\t\n224\t    if (nr_state != NULL) {\n225\t        switch (notification) {\n226\t        /* RTT measurements will happen before acknowledgement is signalled */\n227\t        case picoquic_congestion_notification_acknowledgement:\n228\t            if (nr_state->nrss.alg_state == picoquic_newreno_alg_slow_start &&\n229\t                nr_state->nrss.ssthresh == UINT64_MAX) {\n230\t                /* Increase cwin based on bandwidth estimation. */\n231\t                path_x->cwin = picoquic_cc_update_target_cwin_estimation(path_x);\n232\t                nr_state->nrss.cwin = path_x->cwin;\n233\t            }\n234\t\n235\t            if (path_x->last_time_acked_data_frame_sent > path_x->last_sender_limited_time) {\n236\t                /* TODO app limited. */\n237\t                picoquic_newreno_sim_notify(&nr_state->nrss, cnx, path_x, notification, ack_state, current_time);\n238\t                path_x->cwin = nr_state->nrss.cwin;\n239\t            }\n240\t            break;\n241\t        case picoquic_congestion_notification_seed_cwin:\n242\t            picoquic_newreno_sim_notify(&nr_state->nrss, cnx, path_x, notification, ack_state, current_time);\n243\t            path_x->cwin = nr_state->nrss.cwin;\n244\t            break;\n245\t        case picoquic_congestion_notification_ecn_ec:\n246\t        case picoquic_congestion_notification_repeat:\n247\t        case picoquic_congestion_notification_timeout:\n248\t            /* TODO fix test cases first. */\n249\t            /* packet_trace qlog_trace qlog_trace_auto qlog_trace_only qlog_trace_ecn l4s_reno pacing_update\n250\t             * quality_update app_limited_reno multipath_callback multipath_quality  */\n251\t            /* if (picoquic_cc_hystart_loss_test(&nr_state->rtt_filter, notification, ack_state->lost_packet_number,\n252\t                PICOQUIC_SMOOTHED_LOSS_THRESHOLD)) { */\n253\t                picoquic_newreno_sim_notify(&nr_state->nrss, cnx, path_x, notification, ack_state, current_time);\n254\t                path_x->cwin = nr_state->nrss.cwin;\n255\t            /* } */\n256\t            break;\n257\t        case picoquic_congestion_notification_spurious_repeat:\n258\t            picoquic_newreno_sim_notify(&nr_state->nrss, cnx, path_x, notification, ack_state, current_time);\n259\t            path_x->cwin = nr_state->nrss.cwin;\n260\t            path_x->is_ssthresh_initialized = 1;\n261\t            break;\n262\t        case picoquic_congestion_notification_rtt_measurement:\n263\t            if (nr_state->nrss.alg_state == picoquic_newreno_alg_slow_start &&\n264\t                nr_state->nrss.ssthresh == UINT64_MAX){\n265\t\n266\t                /* if in slow start, increase the window for long delay RTT */\n267\t                if (path_x->rtt_min > PICOQUIC_TARGET_RENO_RTT) {\n268\t                    path_x->cwin = picoquic_cc_update_cwin_for_long_rtt(path_x);\n269\t                    nr_state->nrss.cwin = path_x->cwin;\n270\t                }\n271\t\n272\t                /* HyStart. */\n273\t                /* Using RTT increases as signal to get out of initial slow start */\n274\t                if (picoquic_cc_hystart_test(&nr_state->rtt_filter, (cnx->is_time_stamp_enabled) ? ack_state->one_way_delay : ack_state->rtt_measurement,\n275\t                    cnx->path[0]->pacing.packet_time_microsec, current_time, cnx->is_time_stamp_enabled)) {\n276\t                    /* RTT increased too much, get out of slow start! */\n277\t                    nr_state->nrss.ssthresh = nr_state->nrss.cwin;\n278\t                    nr_state->nrss.alg_state = picoquic_newreno_alg_congestion_avoidance;\n279\t                    path_x->cwin = nr_state->nrss.cwin;\n280\t                    path_x->is_ssthresh_initialized = 1;\n281\t                }\n282\t            }\n283\t            break;\n284\t        case picoquic_congestion_notification_reset:\n285\t            picoquic_newreno_reset(nr_state, path_x);\n286\t            break;\n287\t        default:\n288\t            /* ignore */\n289\t            break;\n290\t        }\n291\t\n292\t        /* Compute pacing data */\n293\t        picoquic_update_pacing_data(path_x, nr_state->nrss.alg_state == picoquic_newreno_alg_slow_start &&\n294\t            nr_state->nrss.ssthresh == UINT64_MAX);\n295\t    }\n296\t}\n297\t\n298\t/* Release the state of the congestion control algorithm */\n299\tstatic void picoquic_newreno_delete(picoquic_path_t* path_x)\n300\t{\n301\t    if (path_x->congestion_alg_state != NULL) {\n302\t        free(path_x->congestion_alg_state);\n303\t        path_x->congestion_alg_state = NULL;\n304\t    }\n305\t}\n306\t\n307\t/* Observe the state of congestion control */\n308\t\n309\tvoid picoquic_newreno_observe(picoquic_path_t* path_x, uint64_t* cc_state, uint64_t* cc_param)\n310\t{\n311\t    picoquic_newreno_state_t* nr_state = (picoquic_newreno_state_t*)path_x->congestion_alg_state;\n312\t    *cc_state = (uint64_t)nr_state->nrss.alg_state;\n313\t    *cc_param = (nr_state->nrss.ssthresh == UINT64_MAX) ? 0 : nr_state->nrss.ssthresh;\n314\t}\n315\t\n316\t/* Definition record for the New Reno algorithm */\n317\t\n318\t#define PICOQUIC_NEWRENO_ID \"newreno\" /* NR88 */\n319\t\n320\tpicoquic_congestion_algorithm_t picoquic_newreno_algorithm_struct = {\n321\t    PICOQUIC_NEWRENO_ID, PICOQUIC_CC_ALGO_NUMBER_NEW_RENO, PICOQUIC_ECN_ECT_0,\n322\t    picoquic_newreno_init,\n323\t    picoquic_newreno_notify,\n324\t    picoquic_newreno_delete,\n325\t    picoquic_newreno_observe\n326\t};\n327\t\n328\tpicoquic_congestion_algorithm_t* picoquic_newreno_algorithm = &picoquic_newreno_algorithm_struct;\n329\t"}]},"parent_tool_use_id":"toolu_01XSHuotdUztNsUFSZAT9Qwd","session_id":"b0ef721e-e3c5-4ce3-b9f2-772ba297c48d","uuid":"675bfa2c-cf68-43d5-96e0-86935de3387b","timestamp":"2026-05-05T16:12:52.101Z"}
