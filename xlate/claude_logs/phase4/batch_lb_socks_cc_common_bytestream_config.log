f paced, L = 8 if non-paced\n47\t */\n48\t/* Take a look at the draft for more information. */\n49\t#define PICOQUIC_HYSTART_PP_MIN_RTT_THRESH 4000 /* msec */\n50\t#define PICOQUIC_HYSTART_PP_MAX_RTT_THRESH 16000 /* msec */\n51\t#define PICOQUIC_HYSTART_PP_MIN_RTT_DIVISOR 8\n52\t#define PICOQUIC_HYSTART_PP_N_RTT_SAMPLE 8\n53\t#define PICOQUIC_HYSTART_PP_CSS_GROWTH_DIVISOR 4\n54\t#define PICOQUIC_HYSTART_PP_CSS_ROUNDS 5\n55\t/* Since picoquic is always paced, L is set to infinity (UINT64_MAX).\n56\t * Because L is only used to limit the increase function, we don't need it at all. For more information, take a look at\n57\t * the picoquic_hystart_pp_increase() function.\n58\t */\n59\t/* #define PICOQUIC_HYSTART_PP_L UINT64_MAX */ /* infinity if paced, L = 8 if non-paced */\n60\t\n61\ttypedef struct st_picoquic_min_max_rtt_t {\n62\t    uint64_t last_rtt_sample_time;\n63\t    uint64_t rtt_filtered_min;\n64\t    int nb_rtt_excess;\n65\t    int sample_current;\n66\t    int is_init;\n67\t    double smoothed_drop_rate;\n68\t    uint64_t smoothed_bytes_sent_16;\n69\t    uint64_t smoothed_bytes_lost_16;\n70\t    uint64_t last_lost_packet_number;\n71\t    uint64_t sample_min;\n72\t    uint64_t sample_max;\n73\t    uint64_t samples[PICOQUIC_MIN_MAX_RTT_SCOPE];\n74\t} picoquic_min_max_rtt_t;\n75\t\n76\tuint64_t picoquic_cc_get_sequence_number(picoquic_cnx_t* cnx, picoquic_path_t* path_x);\n77\t\n78\tuint64_t picoquic_cc_get_ack_number(picoquic_cnx_t* cnx, picoquic_path_t * path_x);\n79\tuint64_t picoquic_cc_get_lowest_not_ack(picoquic_path_t* path_x);\n80\t"}]},"parent_tool_use_id":null,"session_id":"b0ef721e-e3c5-4ce3-b9f2-772ba297c48d","uuid":"dfdab4d2-93af-43c6-b57e-623c69e1978b","timestamp":"2026-05-05T16:09:38.372Z","tool_use_result":{"type":"text","file":{"filePath":"/Users/richbarn/Projects/picoquic/picoquic/cc_common.h","content":"/*\n* Author: Christian Huitema\n* Copyright (c) 2019, Private Octopus, Inc.\n* All rights reserved.\n*\n* Permission to use, copy, modify, and