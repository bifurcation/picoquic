 &s->s;\n50\t}\n51\t\n52\tbytestream * bytestream_alloc(bytestream * s, size_t nb_bytes)\n53\t{\n54\t    s->data = (uint8_t*)malloc(nb_bytes);\n55\t    if (s->data == NULL) {\n56\t        free(s);\n57\t        return NULL;\n58\t    }\n59\t    s->size = nb_bytes;\n60\t    s->ptr = 0;\n61\t\n62\t    return s;\n63\t}\n64\t\n65\tvoid bytestream_delete(bytestream * s)\n66\t{\n67\t    if (s->data != NULL) {\n68\t        free(s->data);\n69\t        s->data = NULL;\n70\t    }\n71\t}\n72\t\n73\tconst uint8_t * bytestream_data(bytestream * s)\n74\t{\n75\t    return s->data;\n76\t}\n77\t\n78\tconst uint8_t * bytestream_ptr(bytestream * s)\n79\t{\n80\t    return s->data + s->ptr;\n81\t}\n82\t\n83\tsize_t bytestream_size(bytestream * s)\n84\t{\n85\t    return s->size;\n86\t}\n87\t\n88\tsize_t bytestream_length(bytestream * s)\n89\t{\n90\t    return s->ptr;\n91\t}\n92\t\n93\tsize_t bytestream_remain(bytestream * s)\n94\t{\n95\t    return s->size - s->ptr;\n96\t}\n97\t\n98\tvoid bytestream_reset(bytestream * s)\n99\t{\n100\t    s->ptr = 0;\n101\t}\n102\t\n103\tvoid bytestream_clear(bytestream * s)\n104\t{\n105\t    s->ptr = 0;\n106\t    memset(s->data, 0, s->size);\n107\t}\n108\t\n109\tint bytestream_finished(bytestream * s)\n110\t{\n111\t    return s->ptr >= s->size;\n112\t}\n113\t\n114\tint bytestream_skip(bytestream * s, size_t nb_bytes)\n115\t{\n116\t    size_t max_bytes = s->size - s->ptr;\n117\t    if (max_bytes < nb_bytes) {\n118\t        return bytestream_error(s);\n119\t    } else {\n120\t        s->ptr += nb_bytes;\n121\t        return 0;\n122\t    }\n123\t}\n124\t\n125\tint byteread_skip_vint(bytestream * s)\n126\t{\n127\t    size_t max_bytes = s->size - s->ptr;\n128\t    if (max_bytes < 1) {\n129\t        return bytestream_error(s);\n130\t    }\n131\t\n132\t    size_t len = picoquic_decode_varint_length(s->data[s->ptr]);\n133\t    return bytestream_skip(s, len);\n134\t}\n135\t\n136\tint bytewrite_vint(bytestream * s, uint64_t value)\n137\t{\n138\t    size_t len = picoquic_varint_encode(s->data + s->ptr, s->size - s->ptr, value);\n139\t    if (len == 0) {\n140\t        return bytestream_error(s);\n141\t    } else {\n142\t        s->ptr += len;\n143\t        return 0;\n144\t    }\n145\t}\n146\t\n147\tint byteread_vint(bytestream * s, uint64_t * value)\n148\t{\n149\t    size_t max_bytes = s->size - s->ptr;\n150\t    if (max_bytes < 1) {\n151\t        return bytestream_error(s);\n152\t    }\n153\t\n154\t    size_t len = picoquic_varint_decode(s->data + s->ptr, s->size - s->ptr, value);\n155\t    if (len == 0) {\n156\t        return bytestream_error(s);\n157\t    } else {\n158\t        s->ptr += len;\n159\t        return 0;\n160\t    }\n161\t}\n162\t\n163\tsize_t bytestream_vint_len(uint64_t value)\n164\t{\n165\t    return picoquic_encode_varint_length(value);\n166\t}\n167\t\n168\tint byteread_vlen(bytestream * s, size_t * value)\n169\t{\n170\t    uint64_t val_read = 0;\n171\t    int ret = byteread_vint(s, &val_read);\n172\t\n173\t    *value = (size_t)val_read;\n174\t    return *value != val_read ? -1 : ret;\n175\t}\n176\t\n177\tint bytewrite_int8(bytestream * s, uint8_t value)\n178\t{\n179\t    size_t max_bytes = s->size - s->ptr;\n180\t    if (max_bytes < 1) {\n181\t        return bytestream_error(s);\n182\t    } else {\n183\t        s->data[s->ptr++] = value;\n184\t        return 0;\n185\t    }\n186\t}\n187\t\n188\tint byteread_int8(bytestream * s, uint8_t * value)\n189\t{\n190\t    size_t max_bytes = s->size - s->ptr;\n191\t    if (max_bytes < 1) {\n192\t        return bytestream_error(s);\n193\t    } else {\n194\t        *value = s->data[s->ptr++];\n195\t        return 0;\n196\t    }\n197\t}\n198\t\n199\tint byteshow_int8(bytestream * s, uint8_t * value)\n200\t{\n201\t    size_t max_bytes = s->size - s->ptr;\n202\t    if (max_bytes < 1) {\n203\t        return -1;\n204\t    } else {\n205\t        *value = s->data[s->ptr];\n206\t        return 0;\n207\t    }\n208\t}\n209\t\n210\tint bytewrite_int16(bytestream * s, uint16_t value)\n211\t{\n212\t    size_t max_bytes = s->size - s->ptr;\n213\t    if (max_bytes < 2) {\n214\t        return bytestream_error(s);\n215\t    } else {\n216\t        picoformat_16(s->data + s->ptr, value);\n217\t        s->ptr += 2;\n218\t        return 0;\n219\t    }\n220\t}\n221\t\n222\tint byteread_int16(bytestream * s, uint16_t * value)\n223\t{\n224\t    size_t max_bytes = s->size - s->ptr;\n225\t    if (max_bytes < 2) {\n226\t        return bytestream_error(s);\n227\t    }\n228\t    else {\n229\t        const uint8_t * ptr = s->data + s->ptr;\n230\t        *value = (ptr[0] << 8) | ptr[1];\n231\t        s->ptr += 2;\n232\t        return 0;\n233\t    }\n234\t}\n235\t\n236\tint bytewrite_int32(bytestream * s, uint32_t value)\n237\t{\n238\t    size_t max_bytes = s->size - s->ptr;\n239\t    if (max_bytes < 4) {\n240\t        return bytestream_error(s);\n241\t    } else {\n242\t        picoformat_32(s->data + s->ptr, value);\n243\t        s->ptr += 4;\n244\t        return 0;\n245\t    }\n246\t}\n247\t\n248\tint byteread_int32(bytestream * s, uint32_t * value)\n249\t{\n250\t    size_t max_bytes = s->size - s->ptr;\n251\t    if (max_bytes < 4) {\n252\t        return bytestream_error(s);\n253\t    }\n254\t    else {\n255\t        const uint8_t * ptr = s->data + s->ptr;\n256\t        *value = (((uint32_t)ptr[0]) << 24) | (((uint32_t)ptr[1]) << 16) | (((uint32_t)ptr[2]) << 8) | ptr[3];\n257\t        s->ptr += 4;\n258\t        return 0;\n259\t    }\n260\t}\n261\t\n262\tint bytewrite_int64(bytestream * s, uint64_t value)\n263\t{\n264\t    size_t max_bytes = s->size - s->ptr;\n265\t    if (max_bytes < 8) {\n266\t        return bytestream_error(s);\n267\t    } else {\n268\t        picoformat_64(s->data + s->ptr, value);\n269\t        s->ptr += 8;\n270\t        return 0;\n271\t    }\n272\t}\n273\t\n274\tint byteread_int64(bytestream * s, uint64_t * value)\n275\t{\n276\t    size_t max_bytes = s->size - s->ptr;\n277\t    if (max_bytes < 8) {\n278\t        return bytestream_error(s);\n