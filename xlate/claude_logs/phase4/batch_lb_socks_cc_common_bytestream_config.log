d;\n44\t\n45\t    if (cnx->is_multipath_enabled) {\n46\t        highest_acknowledged = path_x->pkt_ctx.highest_acknowledged;\n47\t    }\n48\t    else {\n49\t        highest_acknowledged = cnx->pkt_ctx[picoquic_packet_context_application].highest_acknowledged;\n50\t    }\n51\t\n52\t    return highest_acknowledged;\n53\t}\n54\t\n55\tuint64_t picoquic_cc_get_lowest_not_ack(picoquic_path_t* path_x)\n56\t{\n57\t    picoquic_packet_context_t* pkt_ctx = (path_x->cnx->is_multipath_enabled) ? &path_x->pkt_ctx : &path_x->cnx->pkt_ctx[picoquic_packet_context_application];\n58\t    uint64_t lowest_not_ack = (pkt_ctx->pending_first != NULL) ? pkt_ctx->pending_first->sequence_number : pkt_ctx->highest_acknowledged + 1;\n59\t\n60\t    return lowest_not_ack;\n61\t}\n62\t\n63\tuint64_t picoquic_cc_get_ack_sent_time(picoquic_cnx_t* cnx, picoquic_path_t* path_x)\n64\t{\n65\t    uint64_t latest_time_acknowledged;\n66\t\n67\t    if (cnx->is_multipath_enabled) {\n68\t        latest_time_acknowledged = path_x->pkt_ctx.latest_time_acknowledged;\n69\t    }\n70\t    else {\n71\t        latest_time_acknowledged = cnx->pkt_ctx[picoquic_packet_context_application].latest_time_acknowledged;\n72\t    }\n73\t\n74\t    return latest_time_acknowledged;\n75\t}\n76\t\n77\t\n78\tvoid picoquic_cc_filter_rtt_min_max(picoquic_min_max_rtt_t * rtt_track, uint64_t rtt)\n79\t{\n80\t    int x = rtt_track->sample_current;\n81\t    int x_max;\n82\t\n83\t    rtt_track->samples[x] = rtt;\n84\t\n85\t    rtt_track->sample_current = x + 1;\n86\t    if (rtt_track->sample_current >= PICOQUIC_MIN_MAX_RTT_SCOPE) {\n87\t        rtt_track->is_init = 1;\n88\t        rtt_track->sample_current = 0;\n89\t    }\n90\t    \n91\t    x_max = (rtt_track->is_init) ? PICOQUIC_MIN_MAX_RTT_SCOPE : x + 1;\n92\t\n93\t    rtt_track->sample_min = rtt_track->samples[0];\n94\t    rtt_track->sample_max = rtt_track->samples[0];\n95\t\n96\t    for (int i = 1; i < x_max; i++) {\n97\t        if (rtt_track->samples[i] < rtt_track->sample_min) {\n98\t            rtt_track->sample_min = rtt_track->samples[i];\n99\t        } else if (rtt_track->samples[i] > rtt_track->sample_max) {\n100\t            rtt_track->sample_max = rtt_track->samples[i];\n101\t        }\n102\t    }\n103\t}\n104\t\n105\tint picoquic_cc_hystart_loss_test(picoquic_min_max_rtt_t* rtt_track, picoquic_congestion_notification_t event,\n106\t    uint64_t lost_packet_number, double error_rate_max)\n107\t{\n108\t    int ret = 0;\n109\t    uint64_t next_number = rtt_track->last_lost_packet_number;\n110\t\n111\t    if (lost_packet_number > next_number) {\n112\t        if (next_number + PICOQUIC_SMOOTHED_LOSS_SCOPE < lost_packet_number) {\n113\t            next_number = lost_packet_number - PICOQUIC_SMOOTHED_LOSS_SCOPE;\n114\t        }\n115\t\n116\t        while (next_number < lost_packet_number) {\n117\t            rtt_track->smoothed_drop_rate *= (1.0 - PICOQUIC_SMOOTHED_LOSS_FACTOR);\n118\t            next_number++;\n119\t        }\n120\t\n121\t        rtt_track->smoothed_drop_rate += (1.0 - rtt_track->smoothed_drop_rate) * PICOQUIC_SMOOTHED_LOSS_FACTOR;\n122\t        rtt_track->last_lost_packet_number = lost_packet_number;\n123\t\n124\t        switch (event) {\n125\t        case picoquic_congestion_notification_repeat:\n126\t            ret = rtt_track->smoothed_drop_rate > error_rate_max;\n127\t            break;\n128\t        case picoquic_congestion_notification_timeout:\n129\t            ret = 1;\n130\t        default:\n131\t            break;\n132\t        }\n133\t    }\n134\t\n135\t    return ret;\n136\t}\n137\t\n138\tint picoquic_cc_hystart_loss_volume_test(picoquic_min_max_rtt_t* rtt_track, picoquic_congestion_notification_t event,  uint64_t nb_bytes_newly_acked, uint64_t nb_bytes_newly_lost)\n139\t{\n140\t    int ret = 0;\n141\t\n142\t    rtt_track->smoothed_bytes_lost_16 -= rtt_track->smoothed_bytes_lost_16 / 16;\n143\t    rtt_track->smoothed_bytes_lost_16 += nb_bytes_newly_lost;\n144\t    rtt_track->smoothed_bytes_sent_16 -= rtt_track->smoothed_bytes_sent_16 / 16;\n145\t    rtt_track->smoothed_bytes_sent_16 += nb_bytes_newly_acked + nb_bytes_newly_lost;\n146\t\n147\t    if (rtt_track->smoothed_bytes_sent_16 > 0) {\n148\t        rtt_track->smoothed_drop_rate = ((double)rtt_track->smoothed_bytes_lost_16) / ((double)rtt_track->smoothed_bytes_sent_16);\n149\t    }\n150\t    else {\n151\t        rtt_track->smoothed_drop_rate = 0;\n152\t    }\n153\t\n154\t    switch (event) {\n155\t    case picoquic_congestion_notification_acknowledgement:\n156\t        ret = rtt_track->smoothed_drop_rate > PICOQUIC_SMOOTHED_LOSS_THRESHOLD;\n157\t        break;\n158\t    case picoquic_congestion_notification_timeout:\n159\t        ret = 1;\n160\t    default:\n161\t        break;\n162\t    }\n163\t\n164\t    return ret;\n165\t}\n166\t\n167\tint picoquic_cc_hystart_test(picoquic_min_max_rtt_t* rtt_track, uint64_t rtt_measurement, uint64_t packet_time, uint64_t current_time, int is_one_way_delay_enabled)\n168\t{\n169\t    int ret = 0;\n170\t\n171\t    /* Add silly instruction to bypass \"argument not use\" warning without changing the signature */\n172\t    if (is_one_way_delay_enabled && rtt_measurement == 0) {\n173\t        return 0;\n174\t    }\n175\t\n176\t    if(current_time > rtt_track->last_rtt_sample_time + 1000) {\n177\t        picoquic_cc_filter_rtt_min_max(rtt_track, rtt_measurement);\n178\t        rtt_track->last_rtt_sample_time = current_time;\n179\t\n180\t        if (rtt_track->is_init) {\n181\t            uint64_t delta_max;\n182\t\n183\t            if (rtt_track->rtt_filtered_min == 0 ||\n184\t                rtt_track->rtt_filtered_min > rtt_track->sample_max) {\n185\t                rtt_track->rtt_filtered_min = rtt_track->sample_max;\n186\t            }\n187\t            delta_max = rtt_track->rtt_filtered_min / 4;\n188\t            if (delta_max < packet_time) {\n189\t                delta_max = packet_time;\n190\t            }\n191\t\n192\t            if (rtt_track->sample_min > rtt_track->rtt_filtered_min) {\n193\t                if (rtt_track->sample_min > rtt_track->rtt_filtered_min + delta_max) {\n194\t                    rtt_track->nb_rtt_excess++;\n195\t                    if (rtt_track->nb_rtt_excess >= PICOQUIC_MIN_MAX_RTT_SCOPE) {\n196\t                        /* RTT increased too much, get out of slow start! */\n197\t                        ret = 1;\n198\t                    }\n199\t                }\n200\t            }\n201\t            else {\n202\t                rtt_track->nb_rtt_excess = 0;\n203\t            }\n204\t        }\n205\t    }\n206\t\n207\t    return ret;\n208\t}\n209\t\n210\tuint64_t picoquic_cc_slow_start_increase(picoquic_path_t * path_x, uint64_t nb_delivered) {\n211\t    /* App limited. */\n212\t    /* TODO discuss\n213\t     * path_x->cwin < path_x->bytes_in_transit returns false in cc code\n214\t     * path_x->cnx->cwin_blocked is set to true\n215\t     * (path_x->cwin < path_x->bytes_in_transit) != path_x->cnx->cwin_blocked?\n216\t     */\n217\t    if (!path_x->cnx->cwin_blocked) {\n218\t        return 0;\n219\t    }\n220\t\n221\t    return nb_delivered;\n222\t}\n223\t\n224\tuint64_t picoquic_cc_slow_start_increase_ex(picoquic_path_t * path_x, uint64_t nb_delivered, int in_css)\n225\t{\n226\t    if (in_css) {\n227\t        /* In consecutive Slow Start. */\n228\t        return picoquic_cc_slow_start_increase(path_x, nb_delivered / PICOQUIC_HYSTART_PP_CSS_GROWTH_DIVISOR);\n229\t    }\n230\t\n231\t    /* Fallback to traditional Slow Start. */\n232\t    return picoquic_cc_slow_start_increase(path_x, nb_delivered); /* nb_delivered; */\n233\t}\n234\t\n235\tuint64_t picoquic_cc_slow_start_increase_ex2(picoquic_path_t* path_x, uint64_t nb_delivered, int in_css, uint64_t prague_alpha) {\n236\t    if (prague_alpha != 0) { /* monitoring of ECN */\n237\t        uint64_t delta = nb_delivered;\n238\t\n239\t        /* Calculate delta based on prague_ahpha. */\n240\t        if (path_x->smoothed_rtt <= PICOQUIC_TARGET_RENO_RTT) {\n241\t            /* smoothed_rtt <= 100ms */\n242\t            delta *= (1024 - prague_alpha);\n243\t            delta /= 1024;\n244\t        } else {\n245\t            delta *= path_x->smoothed_rtt;\n246\t            delta *= (1024 - prague_alpha);\n247\t            delta /= PICOQUIC_TARGET_RENO_RTT;\n248\t            delta /= 1024;\n249\t        }\n250\t\n251\t        return picoquic_cc_slow_start_increase_ex(path_x, delta, in_css);\n252\t    }\n253\t\n254\t    /* Fallback to HyStart++ Consecutive Slow Start. */\n255\t    return picoquic_cc_slow_start_increase_ex(path_x, nb_delivered, in_css);\n256\t}\n257\t\n258\tuint64_t picoquic_cc_update_target_cwin_estimation(picoquic_path_t* path_x) {\n259\t    /* RTT measurements will happen after the bandwidth is estimated. */\n260\t    uint64_t max_win = PICOQUIC_BYTES_FROM_RATE(path_x->smoothed_rtt, path_x->peak_bandwidth_estimate);\n261\t    uint64_t min_win = max_win / 2;\n262\t\n263\t    /* Return increased cwin, if larger than current cwin. */\n264\t    if (min_win > path_x->cwin) {\n265\t        return min_win;\n266\t    }\n267\t\n268\t    /* Otherwise, return current cwin. */\n269\t    return path_x->cwin;\n270\t}\n271\t\n272\tuint64_t picoquic_cc_update_cwin_for_long_rtt(picoquic_path_t * path_x) {\n273\t    uint64_t min_cwnd;\n274\t\n275\t    if (path_x->rtt_min > PICOQUIC_TARGET_SATELLITE_RTT) {\n276\t        min_cwnd = (uint64_t)((double)PICOQUIC_CWIN_INITIAL * (double)PICOQUIC_TARGET_SATELLITE_RTT / (double)PICOQUIC_TARGET_RENO_RTT);\n277\t    }\n278\t    else {\n279\t        min_cwnd = (uint64_t)((double)PICOQUIC_CWIN_INITIAL * (double)path_x->rtt_min / (double)PICOQUIC_TARGET_RENO_RTT);\n280\t    }\n281\t\n282\t    /* Return increased cwin, if larger than current cwin. */\n283\t    if (min_cwnd > path_x->cwin) {\n284\t        return min_cwnd;\n285\t    }\n286\t\n287\t    /* Otherwise, return current cwin. */\n288\t    return path_x->cwin;\n289\t}\n290\t\n291\tuint64_t picoquic_cc_increased_window(picoquic_cnx_t* cnx, uint64_t previous_window)\n292\t{\n293\t    uint64_t new_window;\n294\t    if (cnx->path[0]->rtt_min <= PICOQUIC_TARGET_RENO_RTT) {\n295\t        new_window = previous_window * 2;\n296\t    }\n297\t    else {\n298\t        double w = (double)previous_window;\n299\t        w /= (double)PICOQUIC_TARGET_RENO_RTT;\n300\t        w *= (cnx->path[0]->rtt_min > PICOQUIC_TARGET_SATELLITE_RTT) ? PICOQUIC_TARGET_SATELLITE_RTT : (double)cnx->path[0]->rtt_min;\n301\t        new_window = (uint64_t)w;\n302\t    }\n303\t    return new_window;\n304\t}\n305\t"}]},"parent_tool_use_id":null,"session_id":"b0ef721e-e3c5-4ce3-b9f2-772ba297c48d","uuid":"e697af52-4315-431a-ab54-5b4a1c5f7c35","timestamp":"2026-05-05T16:02:25.128Z","tool_use_result":{"type":"text","file":{"filePath":"/Users/richbarn/Projects/picoquic/picoquic/cc_common.c","content":"/*\n* Author: Christian Huitema\n* Copyright (c) 2019, Private Octopus, Inc.\n* All rights reserved.\n*\n* Permission to use, copy, modify, and distribute this software for any\n* purpose with or without fee is hereby granted, provided that the above\n* copyright notice and this permission notice appear in all copies.\n*\n* THIS SOFTWARE IS PROVIDED BY THE COPYRIGHT HOLDERS AND CONTRIBUTORS \"AS IS\" AND\n* ANY EXPRESS OR IMPLIED WARRANTIES, INCLUDING, BUT NOT LIMITED TO, THE IMPLIED\n* WARRANTIES OF MERCHANTABILITY AND FITNESS FOR A PARTICULAR PURPOSE ARE\n* DISCLAIMED. IN NO EVENT SHALL Private Octopus, Inc. BE LIABLE FOR ANY\n* DIRECT, INDIRECT, INCIDENTAL, SPECIAL, EXEMPLARY, OR CONSEQUENTIAL DAMAGES\n* (INCLUDING, BUT NOT LIMITED TO, PROCUREMENT OF SUBSTITUTE GOODS OR SERVICES;\n* LOSS OF USE, DATA, OR PROFITS; OR BUSINESS INTERRUPTION) HOWEVER CAUSED AND\n* ON ANY THEORY OF LIABILITY, WHETHER IN CONTRACT, STRICT LIABILITY, OR TORT\n* (INCLUDING NEGLIGENCE OR OTHERWISE) ARISING IN ANY WAY OUT OF THE USE OF THIS\n* SOFTWARE, EVEN IF ADVISED OF THE POSSIBILITY OF SUCH DAMAGE.\n*/\n\n#include \"picoquic_internal.h\"\n#include <stdlib.h>\n#include <string.h>\n#include \"cc_common.h\"\n\nuint64_t picoquic_cc_get_sequence_number(picoquic_cnx_t* cnx, picoquic_path_t* path_x)\n{\n    uint64_t sequence_number;\n\n    if (cnx->is_multipath_enabled) {\n            sequence_number = path_x->pkt_ctx.send_sequence;\n        }\n    else {\n       sequence_number = cnx->pkt_ctx[picoquic_packet_context_application].send_sequence;\n    }\n\n    return sequence_number;\n}\n\nuint64_t picoquic_cc_get_ack_number(picoquic_cnx_t* cnx, picoquic_path_t* path_x)\n{\n    uint64_t highest_acknowledged;\n\n    if (cnx->is_multipath_enabled) {\n        highest_acknowledged = path_x->pkt_ctx.highest_acknowledged;\n    }\n    else {\n        highest_acknowledged = cnx->pkt_ctx[picoquic_packet_context_application].highest_acknowledged;\n    }\n\n    return highest_acknowledged;\n}\n\nuint64_t picoquic_cc_get_lowest_not_ack(picoquic_path_t* path_x)\n{\n    picoquic_packet_context_t* pkt_ctx = (path_x->cnx->is_multipath_enabled) ? &path_x->pkt_ctx : &path_x->cnx->pkt_ctx[picoquic_packet_context_application];\n    uint64_t lowest_not_ack = (pkt_ctx->pending_first != NULL) ? pkt_ctx->pending_first->sequence_number : pkt_ctx->highest_acknowledged + 1;\n\n    return lowest_not_ack;\n}\n\nuint64_t picoquic_cc_get_ack_sent_time(picoquic_cnx_t* cnx, picoquic_path_t* path_x)\n{\n    uint64_t latest_time_acknowledged;\n\n    if (cnx->is_multipath_enabled) {\n        latest_time_acknowledged = path_x->pkt_ctx.latest_time_acknowledged;\n    }\n    else {\n        latest_time_acknowledged = cnx->pkt_ctx[picoquic_packet_context_application].latest_time_acknowledged;\n    }\n\n    return latest_time_acknowledged;\n}\n\n\nvoid picoquic_cc_filter_rtt_min_max(picoquic_min_max_rtt_t * rtt_track, uint64_t rtt)\n{\n    int x = rtt_track->sample_current;\n    int x_max;\n\n    rtt_track->samples[x] = rtt;\n\n    rtt_track->sample_current = x + 1;\n    if (rtt_track->sample_current >= PICOQUIC_MIN_MAX_RTT_SCOPE) {\n        rtt_track->is_init = 1;\n        rtt_track->sample_current = 0;\n    }\n    \n    x_max = (rtt_track->is_init) ? PICOQUIC_MIN_MAX_RTT_SCOPE : x + 1;\n\n    rtt_track->sample_min = rtt_track->samples[0];\n    rtt_track->sample_max = rtt_track->samples[0];\n\n    for (int i = 1; i < x_max; i++) {\n        if (rtt_track->samples[i] < rtt_track->sample_min) {\n            rtt_track->sample_min = rtt_track->samples[i];\n        } else if (rtt_track->samples[i] > rtt_track->sample_max) {\n            rtt_track->sample_max = rtt_track->samples[i];\n        }\n    }\n}\n\nint picoquic_cc_hystart_loss_test(picoquic_min_max_rtt_t* rtt_track, picoquic_congestion_notification_t event,\n    uint64_t lost_packet_number, double error_rate_max)\n{\n    int ret = 0;\n    uint64_t next_number = rtt_track->last_lost_packet_number;\n\n    if (lost_packet_number > next_number) {\n        if (next_number + PICOQUIC_SMOOTHED_LOSS_SCOPE < lost_packet_number) {\n            next_number = lost_packet_number - PICOQUIC_SMOOTHED_LOSS_SCOPE;\n        }\n\n        while (next_number < lost_packet_number) {\n            rtt_track->smoothed_drop_rate *= (1.0 - PICOQUIC_SMOOTHED_LOSS_FACTOR);\n            next_number++;\n        }\n\n        rtt_track->smoothed_drop_rate += (1.0 - rtt_track->smoothed_drop_rate) * PICOQUIC_SMOOTHED_LOSS_FACTOR;\n        rtt_track->last_lost_packet_number = lost_packet_number;\n\n        switch (event) {\n        case picoquic_congestion_notification_repeat:\n            ret = rtt_track->smoothed_drop_rate > error_rate_max;\n            break;\n        case picoquic_congestion_notification_timeout:\n            ret = 1;\n        default:\n            break;\n        }\n    }\n\n    return ret;\n}\n\nint picoquic_cc_hystart_loss_volume_test(picoquic_min_max_rtt_t* rtt_track, picoquic_congestion_notification_t event,  uint64_t nb_bytes_newly_acked, uint64_t nb_bytes_newly_lost)\n{\n    int ret = 0;\n\n    rtt_track->smoothed_bytes_lost_16 -= rtt_track->smoothed_bytes_lost_16 / 16;\n    rtt_track->smoothed_bytes_lost_16 += nb_bytes_newly_lost;\n    rtt_track->smoothed_bytes_sent_16 -= rtt_track->smoothed_bytes_sent_16 / 16;\n    rtt_track->smoothed_bytes_sent_16 += nb_bytes_newly_acked + nb_bytes_newly_lost;\n\n    if (rtt_track->smoothed_bytes_sent_16 > 0) {\n        rtt_track->smoothed_drop_rate = ((double)rtt_track->smoothed_bytes_lost_16) / ((double)rtt_track->smoothed_bytes_sent_16);\n    }\n    else {\n        rtt_track->smoothed_drop_rate = 0;\n    }\n\n    switch (event) {\n    case picoquic_congestion_notification_acknowledgement:\n        ret = rtt_track->smoothed_drop_rate > PICOQUIC_SMOOTHED_LOSS_THRESHOLD;\n        break;\n    case picoquic_congestion_notification_timeout:\n        ret = 1;\n    default:\n        break;\n    }\n\n    return ret;\n}\n\nint picoquic_cc_hystart_test(picoquic_min_max_rtt_t* rtt_track, uint64_t rtt_measurement, uint64_t packet_time, uint64_t current_time, int is_one_way_delay_enabled)\n{\n    int ret = 0;\n\n    /* Add silly instruction to bypass \"argument not use\" warning without changing the signature */\n    if (is_one_way_delay_enabled && rtt_measurement == 0) {\n        return 0;\n    }\n\n    if(current_time > rtt_track->last_rtt_sample_time + 1000) {\n        picoquic_cc_filter_rtt_min_max(rtt_track, rtt_measurement);\n        rtt_track->last_rtt_sample_time = current_time;\n\n        if (rtt_track->is_init) {\n            uint64_t delta_max;\n\n            if (rtt_track->rtt_filtered_min == 0 ||\n                rtt_track->rtt_filtered_min > rtt_track->sample_max) {\n                rtt_track->rtt_filtered_min = rtt_track->sample_max;\n            }\n            delta_max = rtt_track->rtt_filtered_min / 4;\n            if (delta_max < packet_time) {\n                delta_max = packet_time;\n            }\n\n            if (rtt_track->sample_min > rtt_track->rtt_filtered_min) {\n                if (rtt_track->sample_min > rtt_track->rtt_filtered_min + delta_max) {\n                    rtt_track->nb_rtt_excess++;\n                    if (rtt_track->nb_rtt_excess >= PICOQUIC_MIN_MAX_RTT_SCOPE) {\n                        /* RTT increased too much, get out of slow start! */\n                        ret = 1;\n                    }\n                }\n            }\n            else {\n                rtt_track->nb_rtt_excess = 0;\n            }\n        }\n    }\n\n    return ret;\n}\n\nuint64_t picoquic_cc_slow_start_increase(picoquic_path_t * path_x, uint64_t nb_delivered) {\n    /* App limited. */\n    /* TODO discuss\n     * path_x->cwin < path_x->bytes_in_transit returns false in cc code\n     * path_x->cnx->cwin_blocked is set to true\n     * (path_x->cwin < path_x->bytes_in_transit) != path_x->cnx->cwin_blocked?\n     */\n    if (!path_x->cnx->cwin_blocked) {\n        return 0;\n    }\n\n    return nb_delivered;\n}\n\nuint64_t picoquic_cc_slow_start_increase_ex(picoquic_path_t * path_x, uint64_t nb_delivered, int in_css)\n{\n    if (in_css) {\n        /* In consecutive Slow Start. */\n        return picoquic_cc_slow_start_increase(path_x, nb_delivered / PICOQUIC_HYSTART_PP_CSS_GROWTH_DIVISOR);\n    }\n\n    /* Fallback to traditional Slow Start. */\n    return picoquic_cc_slow_start_increase(path_x, nb_delivered); /* nb_delivered; */\n}\n\nuint64_t picoquic_cc_slow_start_increase_ex2(picoquic_path_t* path_x, uint64_t nb_delivered, int in_css, uint64_t prague_alpha) {\n    if (prague_alpha != 0) { /* monitoring of ECN */\n        uint64_t delta = nb_delivered;\n\n        /* Calculate delta based on prague_ahpha. */\n        if (path_x->smoothed_rtt <= PICOQUIC_TARGET_RENO_RTT) {\n            /* smoothed_rtt <= 100ms */\n            delta *= (1024 - prague_alpha);\n            delta /= 1024;\n        } else {\n            delta *= path_x->smoothed_rtt;\n            delta *= (1024 - prague_alpha);\n            delta /= PICOQUIC_TARGET_RENO_RTT;\n            delta /= 1024;\n        }\n\n        return picoquic_cc_slow_start_increase_ex(path_x, delta, in_css);\n    }\n\n    /* Fallback to HyStart++ Consecutive Slow Start. */\n    return picoquic_cc_slow_start_increase_ex(path_x, nb_delivered, in_css);\n}\n\nuint64_t picoquic_cc_update_target_cwin_estimation(picoquic_path_t* path_x) {\n    /* RTT measurements will happen after the bandwidth is estimated. */\n    uint64_t max_win = PICOQUIC_BYTES_FROM_RATE(path_x->smoothed_rtt, path_x->peak_bandwidth_estimate);\n    uint64_t min_win = max_win / 2;\n\n    /* Return increased cwin, if larger than current cwin. */\n    if (min_win > path_x->cwin) {\n        return min_win;\n    }\n\n    /* Otherwise, return current cwin. */\n    return path_x->cwin;\n}\n\nuint64_t picoquic_cc_update_cwin_for_long_rtt(picoquic_path_t * path_x) {\n    uint64_t min_cwnd;\n\n    if (path_x->rtt_min > PICOQUIC_TARGET_SATELLITE_RTT) {\n        min_cwnd = (uint64_t)((double)PICOQUIC_CWIN_INITIAL * (double)PICOQUIC_TARGET_SATELLITE_RTT / (double)PICOQUIC_TARGET_RENO_RTT);\n    }\n    else {\n        min_cwnd = (uint64_t)((double)PICOQUIC_CWIN_INITIAL * (double)path_x->rtt_min / (double)PICOQUIC_TARGET_RENO_RTT);\n    }\n\n    /* Return increased cwin, if larger than current cwin. */\n    if (min_cwnd > path_x->cwin) {\n        return min_cwnd;\n    }\n\n    /* Otherwise, return current cwin. */\n    return path_x->cwin;\n}\n\nuint64_t picoquic_cc_increased_window(picoquic_cnx_t* cnx, uint64_t previous_window)\n{\n    uint64_t new_window;\n    if (cnx->path[0]->rtt_min <= PICOQUIC_TARGET_RENO_RTT) {\n        new_window = previous_window * 2;\n    }\n    else {\n        double w = (double)previous_window;\n        w /= (double)PICOQUIC_TARGET_RENO_RTT;\n        w *= (cnx->path[0]->rtt_min > PICOQUIC_TARGET_SATELLITE_RTT) ? PICOQUIC_TARGET_SATELLITE_RTT : (double)cnx->path[0]->rtt_min;\n        new_window = (uint64_t)w;\n    }\n    return new_window;\n}\n","numLines":305,"startLine":1,"totalLines":305}}}
