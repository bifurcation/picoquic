{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01GVQLZvc7Dh4RB7UF4LKJik","type":"tool_result","content":"1\t//! Test cases for `picoquictest/socket_test.c`.\n2\t//!\n3\t//! Exercises OS UDP socket open/send/receive and ECN option\n4\t//! configuration using the [`crate::socks`] / [`crate::socks_socket2`]\n5\t//! abstractions.\n6\t\n7\t#![allow(non_snake_case)]\n8\t\n9\tuse core::net::SocketAddr;\n10\t\n11\tuse crate::socks::ServerSockets;\n12\tuse crate::socks_socket2::Socket2Udp;\n13\t\n14\t// AF_INET / AF_INET6 raw values (POSIX; matches Linux and macOS).\n15\tconst AF_INET: i32 = 2;\n16\tconst AF_INET6: i32 = 10;\n17\t\n18\t// ---------------------------------------------------------------------------\n19\t// Helper: resolve a text address into a SocketAddr.\n20\t// C: `picoquic_get_server_address`.\n21\t\n22\tfn get_server_address(addr_text: &str, port: u16) -> crate::Result<(SocketAddr, bool)> {\n23\t    let sa = crate::socks::ServerAddress::resolve(addr_text, port as i32)?;\n24\t    Ok((sa.addr, sa.is_name))\n25\t}\n26\t\n27\t// ---------------------------------------------------------------------------\n28\t// Ping-pong over a single port.\n29\t// C: `socket_ping_pong` + `socket_test_one` + `socket_test_port`.\n30\t\n31\tfn socket_ping_pong(\n32\t    _client: &mut Socket2Udp,\n33\t    _server_addr: SocketAddr,\n34\t    _server_sockets: &mut ServerSockets<Socket2Udp>,\n35\t) -> crate::Result<()> {\n36\t    todo!(\"socket_ping_pong\")\n37\t}\n38\t\n39\tfn socket_test_one(\n40\t    addr_text: &str,\n41\t    port: u16,\n42\t    should_be_name: bool,\n43\t    server_sockets: &mut ServerSockets<Socket2Udp>,\n44\t) -> crate::Result<()> {\n45\t    let (server_addr, is_name) = get_server_address(addr_text, port)?;\n46\t    assert_eq!(is_name, should_be_name, \"is_name mismatch for {addr_text}\");\n47\t\n48\t    let af = match server_addr {\n49\t        SocketAddr::V4(_) => AF_INET,\n50\t        SocketAddr::V6(_) => AF_INET6,\n51\t    };\n52\t    let mut client = Socket2Udp::open_client(af)?;\n53\t    socket_ping_pong(&mut client, server_addr, server_sockets)\n54\t}\n55\t\n56\tfn socket_test_port(\n57\t    server_sockets: &mut ServerSockets<Socket2Udp>,\n58\t    test_port: u16,\n59\t) -> crate::Result<()> {\n60\t    socket_test_one(\"127.0.0.1\", test_port, false, server_sockets)?;\n61\t    socket_test_one(\"::1\", test_port, false, server_sockets)?;\n62\t    socket_test_one(\"localhost\", test_port, true, server_sockets)?;\n63\t    Ok(())\n64\t}\n65\t\n66\t// ---------------------------------------------------------------------------\n67\t// ECN test helper.\n68\t// C: `socket_ecn_test_one`.\n69\t\n70\tfn socket_ecn_test_one(_af: i32) -> crate::Result<()> {\n71\t    todo!(\"socket_ecn_test_one\")\n72\t}\n73\t\n74\t// ---------------------------------------------------------------------------\n75\t// Exported tests.\n76\t\n77\t/// C: `socket_test` in `picoquictest/socket_test.c`.\n78\t#[test]\n79\tfn sockets() {\n80\t    let test_port: u16 = 12345;\n81\t    let test_port2: u16 = 1234;\n82\t\n83\t    let mut server_sockets =\n84\t        ServerSockets::<Socket2Udp>::open(test_port as i32).expect(\"open server sockets\");\n85\t\n86\t    socket_test_port(&mut server_sockets, test_port).expect(\"ping-pong on port 12345\");\n87\t\n88\t    let mut server_sockets2 =\n89\t        ServerSockets::<Socket2Udp>::open(test_port2 as i32).expect(\"open server sockets 2\");\n90\t\n91\t    socket_test_port(&mut server_sockets2, test_port2).expect(\"ping-pong on port 1234\");\n92\t\n93\t    server_sockets2.close();\n94\t    server_sockets.close();\n95\t}\n96\t\n97\t/// C: `socket_ecn_test` in `picoquictest/socket_test.c`.\n98\t#[test]\n99\tfn socket_ecn() {\n100\t    socket_ecn_test_one(AF_INET).expect(\"ECN on IPv4\");\n101\t    socket_ecn_test_one(AF_INET6).expect(\"ECN on IPv6\");\n102\t}\n103\t"}]},"parent_tool_use_id":null,"session_id":"b0ef721e-e3c5-4ce3-b9f2-772ba297c48d","uuid":"6b44ef38-9749-4603-800f-aacdcb6f6a71","timestamp":"2026-05-05T16:52:03.617Z","tool_use_result":{"type":"text","file":{"filePath":"/Users/richbarn/Projects/picoquic/rs/fq/src/tests/socket.rs","content":"//! Test cases for `picoquictest/socket_test.c`.\n//!\n//! Exercises OS UDP socket open/send/receive and ECN option\n//! configuration using the [`crate::socks`] / [`crate::socks_socket2`]\n//! abstractions.\n\n#![allow(non_snake_case)]\n\nuse core::net::SocketAddr;\n\nuse crate::socks::ServerSockets;\nuse crate::socks_socket2::Socket2Udp;\n\n// AF_INET / AF_INET6 raw values (POSIX; matches Linux and macOS).\nconst AF_INET: i32 = 2;\nconst AF_INET6: i32 = 10;\n\n// ---------------------------------------------------------------------------\n// Helper: resolve a text address into a SocketAddr.\n// C: `picoquic_get_server_address`.\n\nfn get_server_address(addr_text: &str, port: u16) -> crate::Result<(SocketAddr, bool)> {\n    let sa = crate::socks::ServerAddress::resolve(addr_text, port as i32)?;\n    Ok((sa.addr, sa.is_name))\n}\n\n// ---------------------------------------------------------------------------\n// Ping-pong over a single port.\n// C: `socket_ping_pong` + `socket_test_one` + `socket_test_port`.\n\nfn socket_ping_pong(\n    _client: &mut Socket2Udp,\n    _server_addr: SocketAddr,\n    _server_sockets: &mut ServerSockets<Socket2Udp>,\n) -> crate::Result<()> {\n    todo!(\"socket_ping_pong\")\n}\n\nfn socket_test_one(\n    addr_text: &str,\n    port: u16,\n    should_be_name: bool,\n    server_sockets: &mut ServerSockets<Socket2Udp>,\n) -> crate::Result<()> {\n    let (server_addr, is_name) = get_server_address(addr_text, port)?;\n    assert_eq!(is_name, should_be_name, \"is_name mismatch for {addr_text}\");\n\n    let af = match server_addr {\n        SocketAddr::V4(_) => AF_INET,\n        SocketAddr::V6(_) => AF_INET6,\n    };\n    let mut client = Socket2Udp::open_client(af)?;\n    socket_ping_pong(&mut client, server_addr, server_sockets)\n}\n\nfn socket_test_port(\n    server_sockets: &mut ServerSockets<Socket2Udp>,\n    test_port: u16,\n) -> crate::Result<()> {\n    socket_test_one(\"127.0.0.1\", test_port, false, server_sockets)?;\n    socket_test_one(\"::1\", test_port, false, server_sockets)?;\n    socket_test_one(\"localhost\", test_port, true, server_sockets)?;\n    Ok(())\n}\n\n// ---------------------------------------------------------------------------\n// ECN test helper.\n// C: `socket_ecn_test_one`.\n\nfn socket_ecn_test_one(_af: i32) -> crate::Result<()> {\n    todo!(\"socket_ecn_test_one\")\n}\n\n// ---------------------------------------------------------------------------\n// Exported tests.\n\n/// C: `socket_test` in `picoquictest/socket_test.c`.\n#[test]\nfn sockets() {\n    let test_port: u16 = 12345;\n    let test_port2: u16 = 1234;\n\n    let mut server_sockets =\n        ServerSockets::<Socket2Udp>::open(test_port as i32).expect(\"open server sockets\");\n\n    socket_test_port(&mut server_sockets, test_port).expect(\"ping-pong on port 12345\");\n\n    let mut server_sockets2 =\n        ServerSockets::<Socket2Udp>::open(test_port2 as i32).expect(\"open server sockets 2\");\n\n    socket_test_port(&mut server_sockets2, test_port2).expect(\"ping-pong on port 1234\");\n\n    server_sockets2.close();\n    server_sockets.close();\n}\n\n/// C: `socket_ecn_test` in `picoquictest/socket_test.c`.\n#[test]\nfn socket_ecn() {\n    socket_ecn_test_one(AF_INET).expect(\"ECN on IPv4\");\n    socket_ecn_test_one(AF_INET6).expect(\"ECN on IPv6\");\n}\n","numLines":103,"startLine":1,"totalLines":103}}}
