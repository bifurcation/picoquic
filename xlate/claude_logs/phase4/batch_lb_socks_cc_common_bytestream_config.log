ome(\"path limit exceeded\"),\n198\t            0x445 => Some(\"redirected to proxy (not an error)\"),\n199\t            0x446 => Some(\"padding_packet\"),\n200\t            e if e > 0x100 && e < 0x200 => Some(\"crypto error alert\"),\n201\t            e if e > 0x400 && e < 0x500 => Some(\"unknown picoquic error\"),\n202\t            _ => None,\n203\t        }\n204\t    }\n205\t}\n206\t\n207\t// ---------------------------------------------------------------------------\n208\t// QUIC transport / TLS-alert protocol errors.\n209\t\n210\t/// QUIC transport-layer error code (RFC 9000 §20.1) or TLS-alert\n211\t/// code routed through the QUIC `CRYPTO_ERROR(0x0100..=0x01ff)`\n212\t/// range.  Wire values fit in `u62` but extension drafts go above\n213\t/// `u32`, so the discriminant is `u64`.\n214\t#[derive(Debug, Copy, Clone, PartialEq, Eq)]\n215\t#[repr(u64)]\n216\tpub enum TransportError {\n217\t    InternalError = 0x1,\n218\t    ServerBusy = 0x2,\n219\t    FlowControlError = 0x3,\n220\t    StreamLimitError = 0x4,\n221\t    StreamStateError = 0x5,\n222\t    FinalOffsetError = 0x6,\n223\t    FrameFormatError = 0x7,\n224\t    ParameterError = 0x8,\n225\t    ConnectionIdLimitError = 0x9,\n226\t    ProtocolViolation = 0xA,\n227\t    InvalidToken = 0xB,\n228\t    ApplicationError = 0xC,\n229\t    CryptoBufferExceeded = 0xD,\n230\t    KeyUpdateError = 0xE,\n231\t    AeadLimitReached = 0xF,\n232\t\n233\t    VersionNegotiationError = 0x11,\n234\t\n235\t    TlsAlertWrongAlpn = 0x178,\n236\t    TlsHandshakeFailed = 0x201,\n237\t\n238\t    /// Per draft quic-multipath 20.\n239\t    ApplicationAbandon = 0x3e,\n240\t    ResourceLimitReached = 0x3e75,\n241\t    UnstableInterface = 0x3e76,\n242\t    NoCidAvailable = 0x3e77,\n243\t}\n244\t\n245\t/// Build a `CRYPTO_ERROR` transport code from a TLS alert byte.\n246\t/// C macro: `TRANSPORT_CRYPTO_ERROR(alert)`.\n247\tpub const fn transport_crypto_error(alert: u8) -> u16 {\n248\t    0x100 | (alert as u16)\n249\t}\n250\t\n251\t#[cfg(test