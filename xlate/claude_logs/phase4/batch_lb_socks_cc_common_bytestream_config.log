{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01HGSqbrc1ZT1k3aLnnm92tH","type":"tool_result","content":"1\t//! Test cases for `picoquictest/bytestream_test.c`.\n2\t//!\n3\t//! Covers: integer read/write (fixed-width and varint), buffer\n4\t//! read/write, connection-id encode/decode, length-prefixed string\n5\t//! encode/decode, socket-address encode/decode, boundary-condition\n6\t//! failures, varint-length-encoding table, and stream-metadata\n7\t//! helpers (size / length / remaining / finished).\n8\t\n9\t#![allow(non_snake_case)]\n10\t\n11\tuse core::net::{Ipv4Addr, Ipv6Addr, SocketAddr, SocketAddrV4, SocketAddrV6};\n12\t\n13\tuse crate::CONNECTION_ID_MAX_SIZE;\n14\tuse crate::ConnectionId;\n15\tuse crate::bytestream::{ByteStream, ByteStreamBuf};\n16\t\n17\t/// Reference 16-byte encoding shared by all write sub-tests.\n18\tconst EXPECTED_STREAM: [u8; 16] = [\n19\t    0x09, 0x01, 0x42, 0x03, 0x84, 0x05, 0x06, 0x07, 0xc8, 0x09, 0x05, 0x0b, 0x0c, 0x0d, 0x0e, 0x0f,\n20\t];\n21\t\n22\t// ── Private write helpers ─────────────────────────────────────────────────────\n23\t\n24\t/// C: `verify_bytestream_write_intXX`.\n25\tfn write_intxx(s: &mut ByteStream<'_>) {\n26\t    s.write_u8(0x09).unwrap();\n27\t    s.write_u8(0x01).unwrap();\n28\t    s.write_u16(0x4203).unwrap();\n29\t    s.write_u32(0x8405_0607).unwrap();\n30\t    s.write_u64(0xc809_050b_0c0d_0e0f).unwrap();\n31\t    assert_eq!(s.len(), EXPECTED_STREAM.len(), \"bytewrite_intXX: length\");\n32\t    assert_eq!(s.as_bytes(), &EXPECTED_STREAM, \"bytewrite_intXX: content\");\n33\t}\n34\t\n35\t/// C: `verify_bytestream_write_int` (varints).\n36\tfn write_vint(s: &mut ByteStream<'_>) {\n37\t    s.write_varint(0x09).unwrap();\n38\t    s.write_varint(0x01).unwrap();\n39\t    s.write_varint(0x0203).unwrap();\n40\t    s.write_varint(0x0405_0607).unwrap();\n41\t    s.write_varint(0x0809_050b_0c0d_0e0f).unwrap();\n42\t    assert_eq!(s.len(), EXPECTED_STREAM.len(), \"bytewrite_vint: length\");\n43\t    assert_eq!(s.as_bytes(), &EXPECTED_STREAM, \"bytewrite_vint: content\");\n44\t}\n45\t\n46\t/// C: `verify_bytestream_write_buffer`.\n47\tfn write_buf(s: &mut ByteStream<'_>) {\n48\t    s.write_bytes(&EXPECTED_STREAM[..2]).unwrap();\n49\t    s.write_bytes(&EXPECTED_STREAM[2..]).unwrap();\n50\t    assert_eq!(s.len(), EXPECTED_STREAM.len(), \"bytewrite_buffer: length\");\n51\t    assert_eq!(s.as_bytes(), &EXPECTED_STREAM, \"bytewrite_buffer: content\");\n52\t}\n53\t\n54\t/// C: `verify_bytestream_write_cid`.\n55\tfn write_cid(s: &mut ByteStream<'_>) {\n56\t    let cid0 =\n57\t        ConnectionId::clone_from_slice(&[0x01, 0x42, 0x03, 0x84, 0x05, 0x06, 0x07, 0xc8, 0x09])\n58\t            .unwrap();\n59\t    let cid1 = ConnectionId::clone_from_slice(&[0x0b, 0x0c, 0x0d, 0x0e, 0x0f]).unwrap();\n60\t    s.write_cid(&cid0).unwrap();\n61\t    s.write_cid(&cid1).unwrap();\n62\t    assert_eq!(s.len(), EXPECTED_STREAM.len(), \"bytewrite_cid: length\");\n63\t    assert_eq!(s.as_bytes(), &EXPECTED_STREAM, \"bytewrite_cid: content\");\n64\t}\n65\t\n66\t/// C: `verify_bytestream_write_cstr`.\n67\t///\n68\t/// C `bytewrite_cstr` encodes as `varint(strlen(str)) + raw bytes`.\n69\t/// `write_str` takes `&str` (UTF-8); the C strings are binary data\n70\t/// so we decompose into `write_varint + write_bytes` to achieve the\n71\t/// identical on-wire encoding.\n72\tfn write_cstr(s: &mut ByteStream<'_>) {\n73\t    let str0: &[u8] = b\"\\x01\\x42\\x03\\x84\\x05\\x06\\x07\\xc8\\x09\";\n74\t    let str1: &[u8] = b\"\\x0b\\x0c\\x0d\\x0e\\x0f\";\n75\t    s.write_varint(str0.len() as u64).unwrap();\n76\t    s.write_bytes(str0).unwrap();\n77\t    s.write_varint(str1.len() as u64).unwrap();\n78\t    s.write_bytes(str1).unwrap();\n79\t    assert_eq!(s.len(), EXPECTED_STREAM.len(), \"bytewrite_cstr: length\");\n80\t    assert_eq!(s.as_bytes(), &EXPECTED_STREAM, \"bytewrite_cstr: content\");"}]},"parent_tool_use_id":null,"session_id":"b0ef721e-e3c5-4ce3-b9f2-772ba297c48d","uuid":"1bfd28e2-3447-47b8-95ab-ab8a046ab95a","timestamp":"2026-05-05T16:04:27.292Z","tool_use_result":{"type":"text","file":{"filePath":"/Users/richbarn/Projects/picoquic/rs/fq/src/tests/bytestream.rs","content":"//! Test cases for `picoquictest/bytestream_test.c`.\n//!\n//! Covers: integer read/write (fixed-width and varint), buffer\n//! read/write, connection-id encode/decode, length-prefixed string\n//! encode/decode, socket-address encode/decode, boundary-condition\n//! failures, varint-length-encoding table, and stream-metadata\n//! helpers (size / length / remaining / finished).\n\n#![allow(non_snake_case)]\n\nuse core::net::{Ipv4Addr, Ipv6Addr, SocketAddr, SocketAddrV4, SocketAddrV6};\n\nuse crate::CONNECTION_ID_MAX_SIZE;\nuse crate::ConnectionId;\nuse crate::bytestream::{ByteStream, ByteStreamBuf};\n\n/// Reference 16-byte encoding shared by all write sub-tests.\nconst EXPECTED_STREAM: [u8; 16] = [\n    0x09, 0x01, 0x42, 0x03, 0x84, 0x05, 0x06, 0x07, 0xc8, 0x09, 0x05, 0x0b, 0x0c, 0x0d, 0x0e, 0x0f,\n];\n\n// ── Private write helpers ─────────────────────────────────────────────────────\n\n/// C: `verify_bytestream_write_intXX`.\nfn write_intxx(s: &mut ByteStream<'_>) {\n    s.write_u8(0x09).unwrap();\n    s.write_u8(0x01).unwrap();\n    s.write_u16(0x4203).unwrap();\n    s.write_u32(0x8405_0607).unwrap();\n    s.write_u64(0xc809_050b_0c0d_0e0f).unwrap();\n    assert_eq!(s.len(), EXPECTED_STREAM.len(), \"bytewrite_intXX: length\");\n    assert_eq!(s.as_bytes(), &EXPECTED_STREAM, \"bytewrite_intXX: content\");\n}\n\n/// C: `verify_bytestream_write_int` (varints).\nfn write_vint(s: &mut ByteStream<'_>) {\n    s.write_varint(0x09).unwrap();\n    s.write_varint(0x01).unwrap();\n    s.write_varint(0x0203).unwrap();\n    s.write_varint(0x0405_0607).unwrap();\n    s.write_varint(0x0809_050b_0c0d_0e0f).unwrap();\n    assert_eq!(s.len(), EXPECTED_STREAM.len(), \"bytewrite_vint: length\");\n    assert_eq!(s.as_bytes(), &EXPECTED_STREAM, \"bytewrite_vint: content\");\n}\n\n/// C: `verify_bytestream_write_buffer`.\nfn write_buf(s: &mut ByteStream<'_>) {\n    s.write_bytes(&EXPECTED_STREAM[..2]).unwrap();\n    s.write_bytes(&EXPECTED_STREAM[2..]).unwrap();\n    assert_eq!(s.len(), EXPECTED_STREAM.len(), \"bytewrite_buffer: length\");\n    assert_eq!(s.as_bytes(), &EXPECTED_STREAM, \"bytewrite_buffer: content\");\n}\n\n/// C: `verify_bytestream_write_cid`.\nfn write_cid(s: &mut ByteStream<'_>) {\n    let cid0 =\n        ConnectionId::clone_from_slice(&[0x01, 0x42, 0x03, 0x84, 0x05, 0x06, 0x07, 0xc8, 0x09])\n            .unwrap();\n    let cid1 = ConnectionId::clone_from_slice(&[0x0b, 0x0c, 0x0d, 0x0e, 0x0f]).unwrap();\n    s.write_cid(&cid0).unwrap();\n    s.write_cid(&cid1).unwrap();\n    assert_eq!(s.len(), EXPECTED_STREAM.len(), \"bytewrite_cid: length\");\n    assert_eq!(s.as_bytes(), &EXPECTED_STREAM, \"bytewrite_cid: content\");\n}\n\n/// C: `verify_bytestream_write_cstr`.\n///\n/// C `bytewrite_cstr` encodes as `varint(strlen(str)) + raw bytes`.\n/// `write_str` takes `&str` (UTF-8); the C strings are binary data\n/// so we decompose into `write_varint + write_bytes` to achieve the\n/// identical on-wire encoding.\nfn write_cstr(s: &mut ByteStream<'_>) {\n    let str0: &[u8] = b\"\\x01\\x42\\x03\\x84\\x05\\x06\\x07\\xc8\\x09\";\n    let str1: &[u8] = b\"\\x0b\\x0c\\x0d\\x0e\\x0f\";\n    s.write_varint(str0.len() as u64).unwrap();\n    s.write_bytes(str0).unwrap();\n    s.write_varint(str1.len() as u64).unwrap();\n    s.write_bytes(str1).unwrap();\n    assert_eq!(s.len(), EXPECTED_STREAM.len(), \"bytewrite_cstr: length\");\n    assert_eq!(s.as_bytes(), &EXPECTED_STREAM, \"bytewrite_cstr: content\");","numLines":80,"startLine":1,"totalLines":559}}}
