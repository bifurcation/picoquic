out platform-specific compatibility.","signature":""}],"stop_reason":null,"stop_sequence":null,"stop_details":null,"usage":{"input_tokens":1,"cache_creation_input_tokens":1332,"cache_read_input_tokens":129873,"cache_creation":{"ephemeral_5m_input_tokens":0,"ephemeral_1h_input_tokens":1332},"output_tokens":8,"service_tier":"standard","inference_geo":"not_available"},"diagnostics":null,"context_management":null},"parent_tool_use_id":null,"session_id":"b0ef721e-e3c5-4ce3-b9f2-772ba297c48d","uuid":"7475c6bc-3ccd-47b2-befc-41de391c02cc"}
