{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_017kVLt6x2KNHbpD6m8TxPMq","type":"tool_result","content":"1\t//! Translation of `quic/cc_common.h`.\n2\t//!\n3\t//! Shared helpers used by every congestion-control module: RTT\n4\t//! filtering, HyStart / HyStart++ slow-start exit tests, slow-start\n5\t//! window-growth helpers, and the standalone New Reno simulator that\n6\t//! several other algorithms run as a lower-bound estimator.\n7\t//!\n8\t//! Phase 1: signatures only — every function body is `todo!()`.\n9\t\n10\tuse crate::internal::{Connection, Path};\n11\tuse crate::{CongestionNotification, Duration, Instant, PerAckState};\n12\t\n13\t// ---------------------------------------------------------------------------\n14\t// Tunable constants (`#define`s in the header).\n15\t\n16\t/// Window size of the min/max RTT filter, counted in RTT\n17\t/// measurements.  Doubles as the threshold of consecutive\n18\t/// RTT-excess measurements that trigger slow-start exit.  Used as\n19\t/// an array dimension below, hence `usize`.\n20\tpub const MIN_MAX_RTT_SCOPE: usize = 7;\n21\t\n22\t/// Lookback window for the smoothed packet-loss filter, in packets.\n23\tpub const SMOOTHED_LOSS_SCOPE: u64 = 32;\n24\t\n25\t/// Per-step decay factor for the smoothed loss-rate EMA.  Equivalent\n26\t/// to `1.0 / 16.0`, written explicitly for parity with the C macro.\n27\tpub const SMOOTHED_LOSS_FACTOR: f64 = 1.0 / 16.0;\n28\t\n29\t/// Drop-rate threshold above which the volume-based HyStart loss\n30\t/// test triggers slow-start exit.\n31\tpub const SMOOTHED_LOSS_THRESHOLD: f64 = 0.15;\n32\t\n33\t// HyStart++ tuning constants.  Values come from the IETF HyStart++\n34\t// draft (RFC 9406-equivalent); see the C header for the full\n35\t// rationale, including why `L` is omitted (quic is always paced).\n36\t\n37\tpub const HYSTART_PP_MIN_RTT_THRESH: u64 = 4_000;\n38\tpub const HYSTART_PP_MAX_RTT_THRESH: u64 = 16_000;\n39\tpub const HYSTART_PP_MIN_RTT_DIVISOR: u64 = 8;\n40\tpub const HYSTART_PP_N_RTT_SAMPLE: u64 = 8;\n41\tpub const HYSTART_PP_CSS_GROWTH_DIVISOR: u64 = 4;\n42\tpub const HYSTART_PP_CSS_ROUNDS: u64 = 5;\n43\t\n44\t// ---------------------------------------------------------------------------\n45\t// RTT filter and HyStart-related state.\n46\t\n47\t/// Rolling min/max RTT filter plus smoothed-loss bookkeeping shared\n48\t/// by HyStart exit tests.  C: `picoquic_min_max_rtt_t`.\n49\t///\n50\t/// Type deviations from C: `is_init` (`int` → `bool`);\n51\t/// `sample_current` (`int` → `usize`, used as array index);\n52\t/// `nb_rtt_excess` (`int` → `u32`, always non-negative; safety wins).\n53\t#[derive(Debug, Clone)]\n54\tpub struct MinMaxRtt {\n55\t    /// `None` until the first RTT measurement arrives.\n56\t    pub last_rtt_sample_time: Option<Instant>,\n57\t    pub rtt_filtered_min: Duration,\n58\t    pub nb_rtt_excess: u32,\n59\t    pub sample_current: usize,\n60\t    pub is_init: bool,\n61\t    pub smoothed_drop_rate: f64,\n62\t    /// Smoothed byte-count EMA stored in fixed-point with an\n63\t    /// implicit ×16 multiplier (each step is `prev - prev/16 + new`,\n64\t    /// see `picoquic_cc_hystart_loss_volume_test`); the extra range\n65\t    /// avoids precision loss in integer EMA arithmetic.\n66\t    pub smoothed_bytes_sent_16: u64,\n67\t    /// Same fixed-point convention as [`Self::smoothed_bytes_sent_16`].\n68\t    pub smoothed_bytes_lost_16: u64,\n69\t    pub last_lost_packet_number: u64,\n70\t    pub sample_min: Duration,\n71\t    pub sample_max: Duration,\n72\t    pub samples: [Duration; MIN_MAX_RTT_SCOPE],\n73\t}\n74\t\n75\timpl Default for MinMaxRtt {\n76\t    fn default() -> Self {\n77\t        Self {\n78\t            last_rtt_sample_time: None,\n79\t            rtt_filtered_min: Duration::from_ticks(0),\n80\t            nb_rtt_excess: 0,\n81\t            sample_current: 0,\n82\t            is_init: false,\n83\t            smoothed_drop_rate: 0.0,\n84\t            smoothed_bytes_sent_16: 0,\n85\t            smoothed_bytes_lost_16: 0,\n86\t            last_lost_packet_number: 0,\n87\t            sample_min: Duration::from_ticks(0),\n88\t            sample_max: Duration::from_ticks(0),\n89\t            samples: [Duration::from_ticks(0); MIN_MAX_RTT_SCOPE],\n90\t        }\n91\t    }\n92\t}\n93\t\n94\timpl MinMaxRtt {\n95\t    /// Append `rtt` to the rolling sample window and recompute\n96\t    /// `sample_min` / `sample_max`.  C: `picoquic_cc_filter_rtt_min_max`.\n97\t    pub fn filter_rtt_min_max(&mut self, _rtt: Duration) {\n98\t        todo!()\n99\t    }\n100\t\n101\t    /// HyStart loss-count test: `true` when the smoothed loss rate\n102\t    /// has exceeded `error_rate_max` (or a timeout was observed),\n103\t    /// signalling that slow start should end.  C:\n104\t    /// `picoquic_cc_hystart_loss_test` — the C `int` return is\n105\t    /// purely boolean here.\n106\t    pub fn hystart_loss_test(\n107\t        &mut self,\n108\t        _event: CongestionNotification,\n109\t        _lost_packet_number: u64,\n110\t        _error_rate_max: f64,\n111\t    ) -> bool {\n112\t        todo!()\n113\t    }\n114\t\n115\t    /// HyStart loss-volume test, parallel to [`Self::hystart_loss_test`]\n116\t    /// but driven by byte counts rather than packet sequence numbers.\n117\t    /// C: `picoquic_cc_hystart_loss_volume_test`.\n118\t    pub fn hystart_loss_volume_test(\n119\t        &mut self,\n120\t        _event: CongestionNotification,\n121\t        _nb_bytes_newly_acked: u64,\n122\t        _nb_bytes_newly_lost: u64,\n123\t    ) -> bool {\n124\t        todo!()\n125\t    }\n126\t\n127\t    /// HyStart RTT-rise test: `true` when the filtered RTT has grown\n128\t    /// enough above its minimum to call slow-start over.\n129\t    /// C: `picoquic_cc_hystart_test`.  `is_one_way_delay_enabled`\n130\t    /// was an `int` in C; promoted to `bool`.\n131\t    pub fn hystart_test(\n132\t        &mut self,\n133\t        _rtt_measurement: Duration,\n134\t        _packet_time: Instant,\n135\t        _current_time: Instant,\n136\t        _is_one_way_delay_enabled: bool,\n137\t    ) -> bool {\n138\t        todo!()\n139\t    }\n140\t}\n141\t\n142\t// ---------------------------------------------------------------------------\n143\t// Helpers that read QUIC connection and path state.\n144\t//\n145\t// These are pure reads in the C source, so the receivers are `&self`\n146\t// rather than `&mut self`.  Each was a free function whose primary\n147\t// argument is a connection or path; the surface lifts into two\n148\t// capability traits (one rooted on `Connection`, one on `Path`) so\n149\t// callers opt into them with `use crate::cc_common::{ConnectionCc,\n150\t// PathCc}` and the `cc_*` prefix on the C names drops — the trait\n151\t// names already say \"this is the cc surface\".\n152\t\n153\t/// Connection-rooted congestion-control read accessors.  C: the\n154\t/// `picoquic_cc_get_*` family that takes a connection plus a path.\n155\tpub trait ConnectionCc {\n156\t    /// Next-to-send packet sequence number for the relevant packet\n157\t    /// context — per-path under multipath, otherwise the connection's\n158\t    /// application context.  C: `picoquic_cc_get_sequence_number`.\n159\t    fn sequence_number(&self, path_x: &Path) -> u64;\n160\t\n161\t    /// Highest acknowledged packet sequence number for the relevant\n162\t    /// packet context.  C: `picoquic_cc_get_ack_number`.\n163\t    fn ack_number(&self, path_x: &Path) -> u64;\n164\t\n165\t    /// Wall-clock time at which the most recent ACK was received for\n166\t    /// the relevant packet context.  C: `picoquic_cc_get_ack_sent_time`.\n167\t    fn ack_sent_time(&self, path_x: &Path) -> Instant;\n168\t}\n169\t\n170\timpl ConnectionCc for Connection {\n171\t    fn sequence_number(&self, _path_x: &Path) -> u64 {\n172\t        todo!()\n173\t    }\n174\t\n175\t    fn ack_number(&self, _path_x: &Path) -> u64 {\n176\t        todo!()\n177\t    }\n178\t\n179\t    fn ack_sent_time(&self, _path_x: &Path) -> Instant {\n180\t        todo!()\n181\t    }\n182\t}\n183\t\n184\t/// Path-rooted congestion-control read accessors.  C: the\n185\t/// `picoquic_cc_*` family that takes a path (and reaches the\n186\t/// connection through the path's back-pointer when needed).\n187\tpub trait PathCc {\n188\t    /// Lowest sequence number not yet acknowledged on this path: the\n189\t    /// pending-list head if any, else `highest_acknowledged + 1`.\n190\t    /// C: `picoquic_cc_get_lowest_not_ack`.\n191\t    fn lowest_not_ack(&self) -> u64;\n192\t\n193\t    /// Bytes to add to CWIN while in classic slow start.  Returns\n194\t    /// `nb_delivered` if the path is currently CWIN-blocked, else\n195\t    /// zero (no growth without back-pressure).\n196\t    /// C: `picoquic_cc_slow_start_increase`.\n197\t    fn slow_start_increase(&self, nb_delivered: u64) -> u64;\n198\t\n199\t    /// Bytes to add to CWIN, with HyStart++ Conservative Slow Start\n200\t    /// support: when `in_css` is true, growth is divided by\n201\t    /// [`HYSTART_PP_CSS_GROWTH_DIVISOR`].\n202\t    /// C: `picoquic_cc_slow_start_increase_ex`.\n203\t    fn slow_start_increase_ex(&self, nb_delivered: u64, in_css: bool) -> u64;\n204\t\n205\t    /// Bytes to add to CWIN, with Prague-style ECN damping.\n206\t    /// `prague_alpha` is an integer fraction over 1024 (so `0` means\n207\t    /// no ECN signal and the call falls back to\n208\t    /// [`Self::slow_start_increase_ex`]).\n209\t    /// C: `picoquic_cc_slow_start_increase_ex2`.\n210\t    fn slow_start_increase_ex2(&self, nb_delivered: u64, in_css: bool, prague_alpha: u64) -> u64;\n211\t\n212\t    /// Bandwidth-derived target CWIN: returns the half-BDP estimate\n213\t    /// if it exceeds the current CWIN, otherwise the current CWIN.\n214\t    /// C: `picoquic_cc_update_target_cwin_estimation`.\n215\t    fn update_target_cwin_estimation(&self) -> u64;\n216\t\n217\t    /// CWIN floor for long-RTT paths: scales `CWIN_INITIAL` by the\n218\t    /// path's `rtt_min` (capped at the satellite RTT target).\n219\t    /// Returns the floor if it exceeds the current CWIN, otherwise\n220\t    /// the current CWIN.  C: `picoquic_cc_update_cwin_for_long_rtt`.\n221\t    fn update_cwin_for_long_rtt(&self) -> u64;\n222\t}\n223\t\n224\timpl PathCc for Path {\n225\t    fn lowest_not_ack(&self) -> u64 {\n226\t        todo!()\n227\t    }\n228\t\n229\t    fn slow_start_increase(&self, _nb_delivered: u64) -> u64 {\n230\t        todo!()\n231\t    }\n232\t\n233\t    fn slow_start_increase_ex(&self, _nb_delivered: u64, _in_css: bool) -> u64 {\n234\t        todo!()\n235\t    }\n236\t\n237\t    fn slow_start_increase_ex2(\n238\t        &self,\n239\t        _nb_delivered: u64,\n240\t        _in_css: bool,\n241\t        _prague_alpha: u64,\n242\t    ) -> u64 {\n243\t        todo!()\n244\t    }\n245\t\n246\t    fn update_target_cwin_estimation(&self) -> u64 {\n247\t        todo!()\n248\t    }\n249\t\n250\t    fn update_cwin_for_long_rtt(&self) -> u64 {\n251\t        todo!()\n252\t    }\n253\t}\n254\t\n255\t// ---------------------------------------------------------------------------\n256\t// Embedded New Reno simulator.\n257\t//\n258\t// Several congestion controllers run a parallel New Reno instance to\n259\t// derive a lower bound on the congestion window or minimum\n260\t// bandwidth.  This simulator does not touch the connection or path\n261\t// state directly; everything lives in `NewRenoSimState`.\n262\t\n263\t/// Internal phase of the embedded New Reno simulator.\n264\t/// C: `picoquic_newreno_alg_state_t`.\n265\t#[derive(Debug, Copy, Clone, PartialEq, Eq, Default)]\n266\tpub enum NewRenoAlgState {\n267\t    #[default]\n268\t    SlowStart,\n269\t    CongestionAvoidance,\n270\t}\n271\t\n272\t/// Simulator state for the embedded New Reno instance.\n273\t/// C: `picoquic_newreno_sim_state_t`.\n274\t#[derive(Debug, Clone, Default)]\n275\tpub struct NewRenoSimState {\n276\t    pub alg_state: NewRenoAlgState,\n277\t    pub cwin: u64,\n278\t    pub residual_ack: u64,\n279\t    pub ssthresh: u64,\n280\t    pub recovery_start: u64,\n281\t    pub recovery_sequence: u64,\n282\t}\n283\t\n284\timpl NewRenoSimState {\n285\t    /// Reset the simulator to its initial state.\n286\t    /// C: `picoquic_newreno_sim_reset`.\n287\t    pub fn reset(&mut self) {\n288\t        todo!()\n289\t    }\n290\t\n291\t    /// Drive the simulator with a congestion-control event.\n292\t    ///\n293\t    /// `connection` and `path_x` are read-only here: the C body only mutates\n294\t    /// `self`, reading the connection and path to resolve sequence\n295\t    /// numbers and timestamps via the `cc_*` accessors.  C:\n296\t    /// `picoquic_newreno_sim_notify`.\n297\t    pub fn notify(\n298\t        &mut self,\n299\t        _connection: &Connection,\n300\t        _path_x: &Path,\n301\t        _notification: CongestionNotification,\n302\t        _ack_state: &PerAckState,\n303\t        _current_time: Instant,\n304\t    ) {\n305\t        todo!()\n306\t    }\n307\t}\n308\t\n309\t#[cfg(test)]\n310\tmod test {}\n311\t"}]},"parent_tool_use_id":null,"session_id":"b0ef721e-e3c5-4ce3-b9f2-772ba297c48d","uuid":"1c68ef7b-93ba-485b-906e-cf9eae34b3a6","timestamp":"2026-05-05T16:02:14.323Z","tool_use_result":{"type":"text","file":{"filePath":"/Users/richbarn/Projects/picoquic/rs/fq/src/cc_common.rs","content":"//! Translation of `quic/cc_common.h`.\n//!\n//! Shared helpers used by every congestion-control module: RTT\n//! filtering, HyStart / HyStart++ slow-start exit tests, slow-start\n//! window-growth helpers, and the standalone New Reno simulator that\n//! several other algorithms run as a lower-bound estimator.\n//!\n//! Phase 1: signatures only — every function body is `todo!()`.\n\nuse crate::internal::{Connection, Path};\nuse crate::{CongestionNotification, Duration, Instant, PerAckState};\n\n// ---------------------------------------------------------------------------\n// Tunable constants (`#define`s in the header).\n\n/// Window size of the min/max RTT filter, counted in RTT\n/// measurements.  Doubles as the threshold of consecutive\n/// RTT-excess measurements that trigger slow-start exit.  Used as\n/// an array dimension below, hence `usize`.\npub const MIN_MAX_RTT_SCOPE: usize = 7;\n\n/// Lookback window for the smoothed packet-loss filter, in packets.\npub const SMOOTHED_LOSS_SCOPE: u64 = 32;\n\n/// Per-step decay factor for the smoothed loss-rate EMA.  Equivalent\n/// to `1.0 / 16.0`, written explicitly for parity with the C macro.\npub const SMOOTHED_LOSS_FACTOR: f64 = 1.0 / 16.0;\n\n/// Drop-rate threshold above which the volume-based HyStart loss\n/// test triggers slow-start exit.\npub const SMOOTHED_LOSS_THRESHOLD: f64 = 0.15;\n\n// HyStart++ tuning constants.  Values come from the IETF HyStart++\n// draft (RFC 9406-equivalent); see the C header for the full\n// rationale, including why `L` is omitted (quic is always paced).\n\npub const HYSTART_PP_MIN_RTT_THRESH: u64 = 4_000;\npub const HYSTART_PP_MAX_RTT_THRESH: u64 = 16_000;\npub const HYSTART_PP_MIN_RTT_DIVISOR: u64 = 8;\npub const HYSTART_PP_N_RTT_SAMPLE: u64 = 8;\npub const HYSTART_PP_CSS_GROWTH_DIVISOR: u64 = 4;\npub const HYSTART_PP_CSS_ROUNDS: u64 = 5;\n\n// ---------------------------------------------------------------------------\n// RTT filter and HyStart-related state.\n\n/// Rolling min/max RTT filter plus smoothed-loss bookkeeping shared\n/// by HyStart exit tests.  C: `picoquic_min_max_rtt_t`.\n///\n/// Type deviations from C: `is_init` (`int` → `bool`);\n/// `sample_current` (`int` → `usize`, used as array index);\n/// `nb_rtt_excess` (`int` → `u32`, always non-negative; safety wins).\n#[derive(Debug, Clone)]\npub struct MinMaxRtt {\n    /// `None` until the first RTT measurement arrives.\n    pub last_rtt_sample_time: Option<Instant>,\n    pub rtt_filtered_min: Duration,\n    pub nb_rtt_excess: u32,\n    pub sample_current: usize,\n    pub is_init: bool,\n    pub smoothed_drop_rate: f64,\n    /// Smoothed byte-count EMA stored in fixed-point with an\n    /// implicit ×16 multiplier (each step is `prev - prev/16 + new`,\n    /// see `picoquic_cc_hystart_loss_volume_test`); the extra range\n    /// avoids precision loss in integer EMA arithmetic.\n    pub smoothed_bytes_sent_16: u64,\n    /// Same fixed-point convention as [`Self::smoothed_bytes_sent_16`].\n    pub smoothed_bytes_lost_16: u64,\n    pub last_lost_packet_number: u64,\n    pub sample_min: Duration,\n    pub sample_max: Duration,\n    pub samples: [Duration; MIN_MAX_RTT_SCOPE],\n}\n\nimpl Default for MinMaxRtt {\n    fn default() -> Self {\n        Self {\n            last_rtt_sample_time: None,\n            rtt_filtered_min: Duration::from_ticks(0),\n            nb_rtt_excess: 0,\n            sample_current: 0,\n            is_init: false,\n            smoothed_drop_rate: 0.0,\n            smoothed_bytes_sent_16: 0,\n            smoothed_bytes_lost_16: 0,\n            last_lost_packet_number: 0,\n            sample_min: Duration::from_ticks(0),\n            sample_max: Duration::from_ticks(0),\n            samples: [Duration::from_ticks(0); MIN_MAX_RTT_SCOPE],\n        }\n    }\n}\n\nimpl MinMaxRtt {\n    /// Append `rtt` to the rolling sample window and recompute\n    /// `sample_min` / `sample_max`.  C: `picoquic_cc_filter_rtt_min_max`.\n    pub fn filter_rtt_min_max(&mut self, _rtt: Duration) {\n        todo!()\n    }\n\n    /// HyStart loss-count test: `true` when the smoothed loss rate\n    /// has exceeded `error_rate_max` (or a timeout was observed),\n    /// signalling that slow start should end.  C:\n    /// `picoquic_cc_hystart_loss_test` — the C `int` return is\n    /// purely boolean here.\n    pub fn hystart_loss_test(\n        &mut self,\n        _event: CongestionNotification,\n        _lost_packet_number: u64,\n        _error_rate_max: f64,\n    ) -> bool {\n        todo!()\n    }\n\n    /// HyStart loss-volume test, parallel to [`Self::hystart_loss_test`]\n    /// but driven by byte counts rather than packet sequence numbers.\n    /// C: `picoquic_cc_hystart_loss_volume_test`.\n    pub fn hystart_loss_volume_test(\n        &mut self,\n        _event: CongestionNotification,\n        _nb_bytes_newly_acked: u64,\n        _nb_bytes_newly_lost: u64,\n    ) -> bool {\n        todo!()\n    }\n\n    /// HyStart RTT-rise test: `true` when the filtered RTT has grown\n    /// enough above its minimum to call slow-start over.\n    /// C: `picoquic_cc_hystart_test`.  `is_one_way_delay_enabled`\n    /// was an `int` in C; promoted to `bool`.\n    pub fn hystart_test(\n        &mut self,\n        _rtt_measurement: Duration,\n        _packet_time: Instant,\n        _current_time: Instant,\n        _is_one_way_delay_enabled: bool,\n    ) -> bool {\n        todo!()\n    }\n}\n\n// ---------------------------------------------------------------------------\n// Helpers that read QUIC connection and path state.\n//\n// These are pure reads in the C source, so the receivers are `&self`\n// rather than `&mut self`.  Each was a free function whose primary\n// argument is a connection or path; the surface lifts into two\n// capability traits (one rooted on `Connection`, one on `Path`) so\n// callers opt into them with `use crate::cc_common::{ConnectionCc,\n// PathCc}` and the `cc_*` prefix on the C names drops — the trait\n// names already say \"this is the cc surface\".\n\n/// Connection-rooted congestion-control read accessors.  C: the\n/// `picoquic_cc_get_*` family that takes a connection plus a path.\npub trait ConnectionCc {\n    /// Next-to-send packet sequence number for the relevant packet\n    /// context — per-path under multipath, otherwise the connection's\n    /// application context.  C: `picoquic_cc_get_sequence_number`.\n    fn sequence_number(&self, path_x: &Path) -> u64;\n\n    /// Highest acknowledged packet sequence number for the relevant\n    /// packet context.  C: `picoquic_cc_get_ack_number`.\n    fn ack_number(&self, path_x: &Path) -> u64;\n\n    /// Wall-clock time at which the most recent ACK was received for\n    /// the relevant packet context.  C: `picoquic_cc_get_ack_sent_time`.\n    fn ack_sent_time(&self, path_x: &Path) -> Instant;\n}\n\nimpl ConnectionCc for Connection {\n    fn sequence_number(&self, _path_x: &Path) -> u64 {\n        todo!()\n    }\n\n    fn ack_number(&self, _path_x: &Path) -> u64 {\n        todo!()\n    }\n\n    fn ack_sent_time(&self, _path_x: &Path) -> Instant {\n        todo!()\n    }\n}\n\n/// Path-rooted congestion-control read accessors.  C: the\n/// `picoquic_cc_*` family that takes a path (and reaches the\n/// connection through the path's back-pointer when needed).\npub trait PathCc {\n    /// Lowest sequence number not yet acknowledged on this path: the\n    /// pending-list head if any, else `highest_acknowledged + 1`.\n    /// C: `picoquic_cc_get_lowest_not_ack`.\n    fn lowest_not_ack(&self) -> u64;\n\n    /// Bytes to add to CWIN while in classic slow start.  Returns\n    /// `nb_delivered` if the path is currently CWIN-blocked, else\n    /// zero (no growth without back-pressure).\n    /// C: `picoquic_cc_slow_start_increase`.\n    fn slow_start_increase(&self, nb_delivered: u64) -> u64;\n\n    /// Bytes to add to CWIN, with HyStart++ Conservative Slow Start\n    /// support: when `in_css` is true, growth is divided by\n    /// [`HYSTART_PP_CSS_GROWTH_DIVISOR`].\n    /// C: `picoquic_cc_slow_start_increase_ex`.\n    fn slow_start_increase_ex(&self, nb_delivered: u64, in_css: bool) -> u64;\n\n    /// Bytes to add to CWIN, with Prague-style ECN damping.\n    /// `prague_alpha` is an integer fraction over 1024 (so `0` means\n    /// no ECN signal and the call falls back to\n    /// [`Self::slow_start_increase_ex`]).\n    /// C: `picoquic_cc_slow_start_increase_ex2`.\n    fn slow_start_increase_ex2(&self, nb_delivered: u64, in_css: bool, prague_alpha: u64) -> u64;\n\n    /// Bandwidth-derived target CWIN: returns the half-BDP estimate\n    /// if it exceeds the current CWIN, otherwise the current CWIN.\n    /// C: `picoquic_cc_update_target_cwin_estimation`.\n    fn update_target_cwin_estimation(&self) -> u64;\n\n    /// CWIN floor for long-RTT paths: scales `CWIN_INITIAL` by the\n    /// path's `rtt_min` (capped at the satellite RTT target).\n    /// Returns the floor if it exceeds the current CWIN, otherwise\n    /// the current CWIN.  C: `picoquic_cc_update_cwin_for_long_rtt`.\n    fn update_cwin_for_long_rtt(&self) -> u64;\n}\n\nimpl PathCc for Path {\n    fn lowest_not_ack(&self) -> u64 {\n        todo!()\n    }\n\n    fn slow_start_increase(&self, _nb_delivered: u64) -> u64 {\n        todo!()\n    }\n\n    fn slow_start_increase_ex(&self, _nb_delivered: u64, _in_css: bool) -> u64 {\n        todo!()\n    }\n\n    fn slow_start_increase_ex2(\n        &self,\n        _nb_delivered: u64,\n        _in_css: bool,\n        _prague_alpha: u64,\n    ) -> u64 {\n        todo!()\n    }\n\n    fn update_target_cwin_estimation(&self) -> u64 {\n        todo!()\n    }\n\n    fn update_cwin_for_long_rtt(&self) -> u64 {\n        todo!()\n    }\n}\n\n// ---------------------------------------------------------------------------\n// Embedded New Reno simulator.\n//\n// Several congestion controllers run a parallel New Reno instance to\n// derive a lower bound on the congestion window or minimum\n// bandwidth.  This simulator does not touch the connection or path\n// state directly; everything lives in `NewRenoSimState`.\n\n/// Internal phase of the embedded New Reno simulator.\n/// C: `picoquic_newreno_alg_state_t`.\n#[derive(Debug, Copy, Clone, PartialEq, Eq, Default)]\npub enum NewRenoAlgState {\n    #[default]\n    SlowStart,\n    CongestionAvoidance,\n}\n\n/// Simulator state for the embedded New Reno instance.\n/// C: `picoquic_newreno_sim_state_t`.\n#[derive(Debug, Clone, Default)]\npub struct NewRenoSimState {\n    pub alg_state: NewRenoAlgState,\n    pub cwin: u64,\n    pub residual_ack: u64,\n    pub ssthresh: u64,\n    pub recovery_start: u64,\n    pub recovery_sequence: u64,\n}\n\nimpl NewRenoSimState {\n    /// Reset the simulator to its initial state.\n    /// C: `picoquic_newreno_sim_reset`.\n    pub fn reset(&mut self) {\n        todo!()\n    }\n\n    /// Drive the simulator with a congestion-control event.\n    ///\n    /// `connection` and `path_x` are read-only here: the C body only mutates\n    /// `self`, reading the connection and path to resolve sequence\n    /// numbers and timestamps via the `cc_*` accessors.  C:\n    /// `picoquic_newreno_sim_notify`.\n    pub fn notify(\n        &mut self,\n        _connection: &Connection,\n        _path_x: &Path,\n        _notification: CongestionNotification,\n        _ack_state: &PerAckState,\n        _current_time: Instant,\n    ) {\n        todo!()\n    }\n}\n\n#[cfg(test)]\nmod test {}\n","numLines":311,"startLine":1,"totalLines":311}}}
