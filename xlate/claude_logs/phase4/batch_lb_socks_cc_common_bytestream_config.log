{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_013AdbpcWT2qLf5UgcLXVLMw","type":"tool_result","content":"1\t#include \"picoquic_internal.h\"\n2\t#include \"picoquic_internal.h\"\n3\t\n4\t/*\n5\t* Author: Christian Huitema\n6\t* Copyright (c) 2021, Private Octopus, Inc.\n7\t* All rights reserved.\n8\t*\n9\t* Permission to use, copy, modify, and distribute this software for any\n10\t* purpose with or without fee is hereby granted, provided that the above\n11\t* copyright notice and this permission notice appear in all copies.\n12\t*\n13\t* THIS SOFTWARE IS PROVIDED BY THE COPYRIGHT HOLDERS AND CONTRIBUTORS \"AS IS\" AND\n14\t* ANY EXPRESS OR IMPLIED WARRANTIES, INCLUDING, BUT NOT LIMITED TO, THE IMPLIED\n15\t* WARRANTIES OF MERCHANTABILITY AND FITNESS FOR A PARTICULAR PURPOSE ARE\n16\t* DISCLAIMED. IN NO EVENT SHALL Private Octopus, Inc. BE LIABLE FOR ANY\n17\t* DIRECT, INDIRECT, INCIDENTAL, SPECIAL, EXEMPLARY, OR CONSEQUENTIAL DAMAGES\n18\t* (INCLUDING, BUT NOT LIMITED TO, PROCUREMENT OF SUBSTITUTE GOODS OR SERVICES;\n19\t* LOSS OF USE, DATA, OR PROFITS; OR BUSINESS INTERRUPTION) HOWEVER CAUSED AND\n20\t* ON ANY THEORY OF LIABILITY, WHETHER IN CONTRACT, STRICT LIABILITY, OR TORT\n21\t* (INCLUDING NEGLIGENCE OR OTHERWISE) ARISING IN ANY WAY OUT OF THE USE OF THIS\n22\t* SOFTWARE, EVEN IF ADVISED OF THE POSSIBILITY OF SUCH DAMAGE.\n23\t*/\n24\t\n25\t#include <stdlib.h>\n26\t#include <string.h>\n27\t#include \"picoquic.h\"\n28\t#include \"picoquic_internal.h\"\n29\t#include \"picoquic_utils.h\"\n30\t#include \"tls_api.h\"\n31\t#include \"picoquic_lb.h\"\n32\t\n33\t/* Load balancer support is defined in https://datatracker.ietf.org/doc/draft-ietf-quic-load-balancers/\n34\t * The draft defines methods for encoding a server ID in a connection identifier, and optionally\n35\t * obfuscating or encrypting the CID value. The CID are generated by the individual servers,\n36\t * based on configuration options provided by the load balancer. The draft also defines\n37\t * methods for generating retry tokens either by a protection box colocated with the\n38\t * load balancer, or at the individual server, with methods for letting individual\n39\t * servers retrieve information from the tokens.\n40\t */\n41\t\n42\tstatic void picoquic_lb_compat_cid_generate_first_byte(picoquic_quic_t* quic,\n43\t    picoquic_load_balancer_cid_context_t* lb_ctx, picoquic_connection_id_t* cnx_id_returned)\n44\t{\n45\t    if (lb_ctx->first_byte_encodes_length){\n46\t        cnx_id_returned->id[0] = ((uint8_t)lb_ctx->rotation_bits << 6) | ((uint8_t)quic->local_cnxid_length - 1);\n47\t    }\n48\t    else {\n49\t        cnx_id_returned->id[0] &= 0x3F;\n50\t        cnx_id_returned->id[0] |= ((uint8_t)lb_ctx->rotation_bits << 6);\n51\t    }\n52\t}\n53\t\n54\tstatic void picoquic_lb_compat_cid_generate_clear(picoquic_quic_t* quic,\n55\t    picoquic_load_balancer_cid_context_t * lb_ctx, picoquic_connection_id_t* cnx_id_returned)\n56\t{\n57\t    picoquic_lb_compat_cid_generate_first_byte(quic, lb_ctx, cnx_id_returned);\n58\t    memcpy(cnx_id_returned->id + 1, lb_ctx->server_id, lb_ctx->server_id_length);\n59\t}\n60\t\n61\tstatic void picoquic_lb_compat_cid_one_pass_stream(void * enc_ctx, uint8_t * nonce, size_t nonce_length, uint8_t * target, size_t target_length)\n62\t{\n63\t    uint8_t mask[16];\n64\t    /* Set the obfuscation value */\n65\t    memset(mask, 0, sizeof(mask));\n66\t    memcpy(mask, nonce, nonce_length);\n67\t    /* Encrypt with ECB */\n68\t    picoquic_aes128_ecb_encrypt(enc_ctx, mask, mask, sizeof(mask));\n69\t    /* Apply the mask */\n70\t    for (size_t i = 0; i < target_length; i++) {\n71\t        target[i] ^= mask[i];\n72\t    }\n73\t}\n74\t\n75\t/* Per specification:\n76\t * Stream Cipher CID {\n77\t *    First Octet (8),\n78\t *    Nonce (64..120),\n79\t *    Encrypted Server ID (8..128-len(Nonce)),\n80\t *    For Server Use (0..152-len(Nonce)-len(Encrypted Server ID)),\n81\t * }\n82\t */\n83\t\n84\tstatic void picoquic_lb_compat_cid_generate_stream_cipher(picoquic_quic_t* quic,\n85\t    picoquic_load_balancer_cid_context_t* lb_ctx, picoquic_connection_id_t* cnx_id_returned)\n86\t{\n87\t    size_t id_offset = ((size_t)1) + lb_ctx->nonce_length;\n88\t    /* Prepare a clear text server ID */\n89\t    picoquic_lb_compat_cid_generate_first_byte(quic, lb_ctx, cnx_id_returned);\n90\t    memcpy(cnx_id_returned->id + id_offset, lb_ctx->server_id, lb_ctx->server_id_length);\n91\t    /* First pass -- obtain intermediate server ID */\n92\t    picoquic_lb_compat_cid_one_pass_stream(lb_ctx->cid_encryption_context, cnx_id_returned->id + 1, lb_ctx->nonce_length,\n93\t        cnx_id_returned->id + id_offset, lb_ctx->server_id_length);\n94\t    /* Second pass -- obtain encrypted nonce */\n95\t    picoquic_lb_compat_cid_one_pass_stream(lb_ctx->cid_encryption_context, \n96\t        cnx_id_returned->id + id_offset, lb_ctx->server_id_length,\n97\t        cnx_id_returned->id + 1, lb_ctx->nonce_length);\n98\t    /* Third pass -- obtain encrypted server-id */\n99\t    picoquic_lb_compat_cid_one_pass_stream(lb_ctx->cid_encryption_context, cnx_id_returned->id + 1, lb_ctx->nonce_length,\n100\t        cnx_id_returned->id + id_offset, lb_ctx->server_id_length);\n101\t}\n102\t\n103\t/* Per specification:\n104\t * Block Cipher CID {\n105\t *    First Octet (8),\n106\t *    Encrypted Server ID (8..128),\n107\t *    Encrypted Bits for Server Use (128-len(Encrypted Server ID)),\n108\t *    Unencrypted Bits for Server Use (0..24),\n109\t * }\n110\t * In theory, the \"server use\" bits should just be set to a random value.\n111\t * For tests, the server use bits have to be set to a specific value.\n112\t */\n113\tstatic void picoquic_lb_compat_cid_generate_block_cipher(picoquic_quic_t* quic,\n114\t    picoquic_load_balancer_cid_context_t* lb_ctx, picoquic_connection_id_t* cnx_id_returned)\n115\t{\n116\t    picoquic_lb_compat_cid_generate_first_byte(quic, lb_ctx, cnx_id_returned);\n117\t    /* Copy the server ID */\n118\t    memcpy(cnx_id_returned->id + 1, lb_ctx->server_id, lb_ctx->server_id_length);\n119\t    /* encrypt 16 bytes */\n120\t    picoquic_aes128_ecb_encrypt(lb_ctx->cid_encryption_context, cnx_id_returned->id + 1, cnx_id_returned->id + 1, 16);\n121\t}\n122\t\n123\t/* This code assumes that the cnx_id_returned value is pre-filled with\n124\t * the expected values of nonces or local-use content.\n125\t */\n126\tvoid picoquic_lb_compat_cid_generate(picoquic_quic_t* quic, picoquic_connection_id_t UNUSED(cnx_id_local),\n127\t    picoquic_connection_id_t UNUSED(cnx_id_remote), void* cnx_id_cb_data, picoquic_connection_id_t* cnx_id_returned)\n128\t{\n129\t    picoquic_load_balancer_cid_context_t* lb_ctx = (picoquic_load_balancer_cid_context_t*)cnx_id_cb_data;\n130\t#ifdef _WINDOWS\n131\t    UNREFERENCED_PARAMETER(cnx_id_local);\n132\t    UNREFERENCED_PARAMETER(cnx_id_remote);\n133\t#endif\n134\t    switch (lb_ctx->method) {\n135\t    case picoquic_load_balancer_cid_clear:\n136\t        picoquic_lb_compat_cid_generate_clear(quic, lb_ctx, cnx_id_returned);\n137\t        break;\n138\t    case picoquic_load_balancer_cid_stream_cipher:\n139\t        picoquic_lb_compat_cid_generate_stream_cipher(quic, lb_ctx, cnx_id_returned);\n140\t        break;\n141\t    case picoquic_load_balancer_cid_block_cipher:\n142\t        picoquic_lb_compat_cid_generate_block_cipher(quic, lb_ctx, cnx_id_returned);\n143\t        break;\n144\t    default:\n145\t        /* Error, unknown method */\n146\t        break;\n147\t    }\n148\t}\n149\t\n150\tstatic uint64_t picoquic_lb_compat_cid_verify_clear(\n151\t    picoquic_load_balancer_cid_context_t* lb_ctx, picoquic_connection_id_t const* cnx_id)\n152\t{\n153\t    uint64_t s_id64 = 0;\n154\t\n155\t    for (size_t i = 0; i < lb_ctx->server_id_length; i++) {\n156\t        s_id64 <<= 8;\n157\t        s_id64 += cnx_id->id[i + 1];\n158\t    }\n159\t\n160\t    return s_id64;\n161\t}\n162\t\n163\tstatic uint64_t picoquic_lb_compat_cid_verify_stream_cipher(\n164\t    picoquic_load_balancer_cid_context_t* lb_ctx, picoquic_connection_id_t const* cnx_id)\n165\t{\n166\t    size_t id_offset = ((size_t)1) + lb_ctx->nonce_length;\n167\t    uint64_t s_id64 = 0;\n168\t    picoquic_connection_id_t target = *cnx_id;\n169\t    /* First pass -- obtain intermediate server ID */\n170\t    picoquic_lb_compat_cid_one_pass_stream(lb_ctx->cid_encryption_context, target.id + 1, lb_ctx->nonce_length,\n171\t        target.id + id_offset, lb_ctx->server_id_length);\n172\t    /* Second pass -- obtain nonce */\n173\t    picoquic_lb_compat_cid_one_pass_stream(lb_ctx->cid_encryption_context,\n174\t        target.id + id_offset, lb_ctx->server_id_length, target.id + 1, lb_ctx->nonce_length);\n175\t    /* First pass -- obtain server-id */\n176\t    picoquic_lb_compat_cid_one_pass_stream(lb_ctx->cid_encryption_context, target.id + 1, lb_ctx->nonce_length,\n177\t        target.id + id_offset, lb_ctx->server_id_length);\n178\t\n179\t    /* decode the server ID */\n180\t    for (size_t i = 0; i < lb_ctx->server_id_length; i++) {\n181\t        s_id64 <<= 8;\n182\t        s_id64 += target.id[id_offset + i];\n183\t    }\n184\t\n185\t    return s_id64;\n186\t}\n187\t\n188\tstatic uint64_t picoquic_lb_compat_cid_verify_block_cipher(\n189\t    picoquic_load_balancer_cid_context_t* lb_ctx, picoquic_connection_id_t const* cnx_id)\n190\t{\n191\t    uint8_t decoded[16];\n192\t    uint64_t s_id64 = 0;\n193\t\n194\t    /* decrypt 16 bytes */\n195\t    picoquic_aes128_ecb_encrypt(lb_ctx->cid_decryption_context, decoded, cnx_id->id + 1, 16);\n196\t    /* Decode the server ID */\n197\t    if (s_id64 == 0) {\n198\t        for (size_t i = 0; i < lb_ctx->server_id_length; i++) {\n199\t            s_id64 <<= 8;\n200\t            s_id64 += decoded[i];\n201\t        }\n202\t    }\n203\t\n204\t    return s_id64;\n205\t}\n206\t\n207\tuint64_t picoquic_lb_compat_cid_verify(void* cnx_id_cb_data, picoquic_connection_id_t const* cnx_id)\n208\t{\n209\t    picoquic_load_balancer_cid_context_t* lb_ctx = (picoquic_load_balancer_cid_context_t*)cnx_id_cb_data;\n210\t    uint64_t server_id64;\n211\t\n212\t    if (cnx_id->id_len != lb_ctx->connection_id_length) {\n213\t        server_id64 = UINT64_MAX;\n214\t    }\n215\t    else {\n216\t        switch (lb_ctx->method) {\n217\t        case picoquic_load_balancer_cid_clear:\n218\t            server_id64 = picoquic_lb_compat_cid_verify_clear(lb_ctx, cnx_id);\n219\t            break;\n220\t        case picoquic_load_balancer_cid_stream_cipher:\n221\t            server_id64 = picoquic_lb_compat_cid_verify_stream_cipher(lb_ctx, cnx_id);\n222\t            break;\n223\t        case picoquic_load_balancer_cid_block_cipher:\n224\t            server_id64 = picoquic_lb_compat_cid_verify_block_cipher(lb_ctx, cnx_id);\n225\t            break;\n226\t        default:\n227\t            /* Error, unknown method */\n228\t            server_id64 = UINT64_MAX;\n229\t            break;\n230\t        }\n231\t    }\n232\t\n233\t    return server_id64;\n234\t}\n235\t\n236\tint picoquic_lb_compat_cid_config_parse(picoquic_load_balancer_config_t* lb_config, char const* txt, size_t txt_length)\n237\t{\n238\t    int ret = 0;\n239\t    size_t parsed = 0;\n240\t    size_t s_id_len;\n241\t    size_t cid_len = 0;\n242\t    size_t nonce_len = 0;\n243\t    /**/\n244\t    /* separator \"-\" */\n245\t    /* server_id -- string of 2xserver_id_length hex, max 16 */\n246\t    /* separator \"-\" */\n247\t    /* cid_encryption_key -- 32 hex digits*/\n248\t    memset(lb_config, 0, sizeof(*lb_config));\n249\t    if (txt_length < 4) {\n250\t        ret = -1;\n251\t    }\n252\t    else {\n253\t        /* rotation_bits: 0, 1 or 2 -- 3 is indefinite */\n254\t        if (txt[0] >= '0' && txt[0] <= '3') {\n255\t            lb_config->rotation_bits = (unsigned int)(txt[0] - '0');\n256\t        }\n257\t        else {\n258\t            ret = -1;\n259\t        }\n260\t        /* first_byte_encodes_length: Y or N */\n261\t        if (txt[1] == 'Y' || txt[1] == 'y') {\n262\t            lb_config->first_byte_encodes_length = 1;\n263\t        }\n264\t        else if (txt[1] != 'N' && txt[1] != 'n') {\n265\t            ret = -1;\n266\t        }\n267\t        parsed = 2;\n268\t        /* CID length as number, default to zero, in which case will be filled from QUIC context.\n269\t         * need to be careful because value is stored as uint8_t.\n270\t         */\n271\t        while (parsed < txt_length && txt[parsed] >= '0' && txt[parsed] <= '9') {\n272\t            cid_len *= 10;\n273\t            cid_len += txt[parsed] - '0';\n274\t            parsed++;\n275\t            if (cid_len < 256) {\n276\t                lb_config->connection_id_length = (uint8_t)cid_len;\n277\t            }\n278\t            else {\n279\t                ret = -1;\n280\t                break;\n281\t            }\n282\t        }\n283\t        /* method: C, S or B -- clear, stream-encrypted or block encrypted */\n284\t        if (parsed >= txt_length) {\n285\t            ret = -1;\n286\t        }\n287\t        else if (ret == 0) {\n288\t            char c = txt[parsed];\n289\t            parsed++;\n290\t            switch (c) {\n291\t            case 'c':\n292\t            case 'C':\n293\t                lb_config->method = picoquic_load_balancer_cid_clear;\n294\t                break;\n295\t            case 's':\n296\t            case 'S':\n297\t                lb_config->method = picoquic_load_balancer_cid_stream_cipher;\n298\t                while (parsed < txt_length && txt[parsed] >= '0' && txt[parsed] <= '9') {\n299\t                    nonce_len *= 10;\n300\t                    nonce_len += txt[parsed] - '0';\n301\t                    parsed++;\n302\t                    if (nonce_len < 256) {\n303\t                        lb_config->nonce_length = (uint8_t)nonce_len;\n304\t                    }\n305\t                    else {\n306\t                        ret = -1;\n307\t                        break;\n308\t                    }\n309\t                }\n310\t                break;\n311\t            case 'b':\n312\t            case 'B':\n313\t                lb_config->method = picoquic_load_balancer_cid_block_cipher;\n314\t                break;\n315\t            default:\n316\t                ret = -1;\n317\t                break;\n318\t            }\n319\t        }\n320\t        /* Skip hyphen */\n321\t        if (txt[parsed] == '-') {\n322\t            parsed++;\n323\t        }\n324\t        else {\n325\t            ret = -1;\n326\t        }\n327\t    }\n328\t    if (txt_length <= parsed) {\n329\t        ret = -1;\n330\t    }\n331\t    else if (ret == 0) {\n332\t        /* Parsing S_ID as hex string. */\n333\t        uint8_t s_id_bin[8];\n334\t        size_t hex_length = 0;\n335\t        while (parsed + hex_length < txt_length && txt[parsed + hex_length] != '-') {\n336\t            hex_length++;\n337\t        }\n338\t        s_id_len = picoquic_parse_hexa(txt + parsed, hex_length, s_id_bin, 8);\n339\t        if (s_id_len == 0 || s_id_len > 255) {\n340\t            ret = 1;\n341\t        }\n342\t        else {\n343\t            lb_config->server_id_length = (uint8_t)s_id_len;\n344\t            for (size_t i = 0; i < s_id_len; i++) {\n345\t                lb_config->server_id64 <<= 8;\n346\t                lb_config->server_id64 |= s_id_bin[i];\n347\t            }\n348\t        }\n349\t        parsed += 2 * s_id_len;\n350\t    }\n351\t    if (ret == 0 &&\n352\t        (lb_config->method == picoquic_load_balancer_cid_stream_cipher ||\n353\t            lb_config->method == picoquic_load_balancer_cid_block_cipher)) {\n354\t        /* Skip hyphen */\n355\t        if (txt[parsed] == '-') {\n356\t            parsed++;\n357\t        }\n358\t        else {\n359\t            ret = -1;\n360\t        }\n361\t        if (ret == 0) {\n362\t            if (txt_length < parsed + 32) {\n363\t                ret = -1;\n364\t            }\n365\t            else {\n366\t                /* Parse key as 32 bytes string */\n367\t                size_t key_length = picoquic_parse_hexa(txt + parsed, txt_length - parsed, lb_config->cid_encryption_key, 16);\n368\t                if (key_length != 16) {\n369\t                    ret = -1;\n370\t                }\n371\t                parsed += 2 * key_length;\n372\t            }\n373\t        }\n374\t    }\n375\t    if (ret == 0 && parsed != txt_length) {\n376\t        ret = -1;\n377\t    }\n378\t\n379\t    if (ret == 0 && lb_config->connection_id_length != 0) {\n380\t        size_t min_length = 1 + lb_config->server_id_length + lb_config->nonce_length;\n381\t        if (lb_config->connection_id_length < min_length ||\n382\t            (lb_config->method == picoquic_load_balancer_cid_block_cipher && lb_config->connection_id_length < 17)) {\n383\t            ret = -1;\n384\t        }\n385\t    }\n386\t    return ret;\n387\t}\n388\t\n389\tint picoquic_lb_compat_cid_config(picoquic_quic_t* quic, picoquic_load_balancer_config_t * lb_config)\n390\t{\n391\t    int ret = 0;\n392\t\n393\t    if (quic->cnx_list != NULL && quic->local_cnxid_length != lb_config->connection_id_length) {\n394\t        /* Error. Changing the CID length now will break existing connections */\n395\t        ret = -1;\n396\t    }\n397\t    else if (quic->cnx_id_callback_fn != NULL && quic->cnx_id_callback_ctx != NULL){\n398\t        /* Error. Some other CID generation is configured, cannot be changed */\n399\t        ret = -1;\n400\t    }\n401\t    else {\n402\t        /* Verify that the method is supported and the parameters are compatible.\n403\t         * If valid, configure the connection ID generation */\n404\t        if (lb_config->connection_id_length > PICOQUIC_CONNECTION_ID_MAX_SIZE) {\n405\t            ret = -1;\n406\t        }\n407\t        else {\n408\t            switch (lb_config->method) {\n409\t            case picoquic_load_balancer_cid_clear:\n410\t                if (lb_config->server_id_length + 1 > lb_config->connection_id_length) {\n411\t                    ret = -1;\n412\t                }\n413\t                break;\n414\t            case picoquic_load_balancer_cid_stream_cipher:\n415\t                /* Nonce length must be 8 to 16 bytes, CID should be long enough */\n416\t                if (lb_config->nonce_length < 8 || lb_config->nonce_length > 16 ||\n417\t                    lb_config->nonce_length + lb_config->server_id_length + 1 > lb_config->connection_id_length) {\n418\t                    ret = -1;\n419\t                }\n420\t                break;\n421\t            case picoquic_load_balancer_cid_block_cipher:\n422\t                /* CID should include a whole AES-ECB block,\n423\t                 * there should be at least 2 bytes available for uniqueness,\n424\t                 * zero padding length should be 4 bytes for security */\n425\t                if (lb_config->connection_id_length < 17 ||\n426\t                    lb_config->server_id_length > 15) {\n427\t                    ret = -1;\n428\t                }\n429\t                break;\n430\t            default:\n431\t                /* Error, unknown method */\n432\t                ret = -1;\n433\t                break;\n434\t            }\n435\t        }\n436\t        if (ret == 0) {\n437\t            /* Create a copy */\n438\t            picoquic_load_balancer_cid_context_t* lb_ctx = (picoquic_load_balancer_cid_context_t*)malloc(sizeof(picoquic_load_balancer_cid_context_t));\n439\t\n440\t            if (lb_ctx == NULL) {\n441\t                ret = -1;\n442\t            }\n443\t            else {\n444\t                /* if allocated, create the necessary encryption contexts or variables */\n445\t                uint64_t s_id64 = lb_config->server_id64;\n446\t                memset(lb_ctx, 0, sizeof(picoquic_load_balancer_cid_context_t));\n447\t                lb_ctx->method = lb_config->method;\n448\t                lb_ctx->rotation_bits = lb_config->rotation_bits;\n449\t                lb_ctx->first_byte_encodes_length = lb_config->first_byte_encodes_length;\n450\t                lb_ctx->server_id_length = lb_config->server_id_length;\n451\t                lb_ctx->nonce_length = lb_config->nonce_length;\n452\t                lb_ctx->connection_id_length = lb_config->connection_id_length;\n453\t                lb_ctx->server_id64 = lb_config->server_id64;\n454\t                lb_ctx->cid_encryption_context = NULL;\n455\t                lb_ctx->cid_decryption_context = NULL;\n456\t                /* Compute the server ID bytes and set encryption contexts */\n457\t                for (size_t i = 0; i < lb_ctx->server_id_length; i++) {\n458\t                    size_t j = lb_ctx->server_id_length - i - 1;\n459\t                    lb_ctx->server_id[j] = (uint8_t)s_id64;\n460\t                    s_id64 >>= 8;\n461\t                }\n462\t                if (s_id64 != 0) {\n463\t                    /* Server ID not long enough to encode actual value */\n464\t                    ret = -1;\n465\t                } else if (lb_config->method == picoquic_load_balancer_cid_stream_cipher ||\n466\t                    lb_config->method == picoquic_load_balancer_cid_block_cipher) {\n467\t                    lb_ctx->cid_encryption_context = picoquic_aes128_ecb_create(1, lb_config->cid_encryption_key);\n468\t                    if (lb_ctx->cid_encryption_context == NULL) {\n469\t                        ret = -1;\n470\t                    }\n471\t                    else if (lb_config->method == picoquic_load_balancer_cid_block_cipher) {\n472\t                        lb_ctx->cid_decryption_context = picoquic_aes128_ecb_create(0, lb_config->cid_encryption_key);\n473\t                        if (lb_ctx->cid_decryption_context == NULL) {\n474\t                            picoquic_aes128_ecb_free(lb_ctx->cid_encryption_context);\n475\t                            lb_ctx->cid_encryption_context = NULL;\n476\t                            ret = -1;\n477\t                        }\n478\t                    }\n479\t                }\n480\t                if (ret != 0) {\n481\t                    /* if context allocation failed, free the copy */\n482\t                    free(lb_ctx);\n483\t                    lb_ctx = NULL;\n484\t                } else {\n485\t                    /* Configure the CID generation */\n486\t                    quic->local_cnxid_length = lb_ctx->connection_id_length;\n487\t                    quic->cnx_id_callback_fn = picoquic_lb_compat_cid_generate;\n488\t                    quic->cnx_id_callback_ctx = (void*)lb_ctx;\n489\t                }\n490\t            }\n491\t        }\n492\t    }\n493\t\n494\t    return ret;\n495\t}\n496\t\n497\tvoid picoquic_lb_compat_cid_config_free(picoquic_quic_t* quic)\n498\t{\n499\t    if (quic->cnx_id_callback_fn == picoquic_lb_compat_cid_generate &&\n500\t        quic->cnx_id_callback_ctx != NULL) {\n501\t        picoquic_load_balancer_cid_context_t* lb_ctx = (picoquic_load_balancer_cid_context_t*)quic->cnx_id_callback_ctx;\n502\t        /* Release the encryption contexts so as to avoid memory leaks */\n503\t        if (lb_ctx->cid_encryption_context != NULL) {\n504\t            picoquic_aes128_ecb_free(lb_ctx->cid_encryption_context);\n505\t        }\n506\t        if (lb_ctx->cid_decryption_context != NULL) {\n507\t            picoquic_aes128_ecb_free(lb_ctx->cid_decryption_context);\n508\t        }\n509\t        /* Free the data */\n510\t        free(lb_ctx);\n511\t        /* Reset the Quic context */\n512\t        quic->cnx_id_callback_fn = NULL;\n513\t        quic->cnx_id_callback_ctx = NULL;\n514\t    }\n515\t}\n516\t"}]},"parent_tool_use_id":null,"session_id":"b0ef721e-e3c5-4ce3-b9f2-772ba297c48d","uuid":"f4ec0d66-4c39-414b-9bf5-333fddd559f8","timestamp":"2026-05-05T16:17:15.990Z","tool_use_result":{"type":"text","file":{"filePath":"/Users/richbarn/Projects/picoquic/picoquic/picoquic_lb.c","content":"#include \"picoquic_internal.h\"\n#include \"picoquic_internal.h\"\n\n/*\n* Author: Christian Huitema\n* Copyright (c) 2021, Private Octopus, Inc.\n* All rights reserved.\n*\n* Permission to use, copy, modify, and distribute this software for any\n* purpose with or without fee is hereby granted, provided that the above\n* copyright notice and this permission notice appear in all copies.\n*\n* THIS SOFTWARE IS PROVIDED BY THE COPYRIGHT HOLDERS AND CONTRIBUTORS \"AS IS\" AND\n* ANY EXPRESS OR IMPLIED WARRANTIES, INCLUDING, BUT NOT LIMITED TO, THE IMPLIED\n* WARRANTIES OF MERCHANTABILITY AND FITNESS FOR A PARTICULAR PURPOSE ARE\n* DISCLAIMED. IN NO EVENT SHALL Private Octopus, Inc. BE LIABLE FOR ANY\n* DIRECT, INDIRECT, INCIDENTAL, SPECIAL, EXEMPLARY, OR CONSEQUENTIAL DAMAGES\n* (INCLUDING, BUT NOT LIMITED TO, PROCUREMENT OF SUBSTITUTE GOODS OR SERVICES;\n* LOSS OF USE, DATA, OR PROFITS; OR BUSINESS INTERRUPTION) HOWEVER CAUSED AND\n* ON ANY THEORY OF LIABILITY, WHETHER IN CONTRACT, STRICT LIABILITY, OR TORT\n* (INCLUDING NEGLIGENCE OR OTHERWISE) ARISING IN ANY WAY OUT OF THE USE OF THIS\n* SOFTWARE, EVEN IF ADVISED OF THE POSSIBILITY OF SUCH DAMAGE.\n*/\n\n#include <stdlib.h>\n#include <string.h>\n#include \"picoquic.h\"\n#include \"picoquic_internal.h\"\n#include \"picoquic_utils.h\"\n#include \"tls_api.h\"\n#include \"picoquic_lb.h\"\n\n/* Load balancer support is defined in https://datatracker.ietf.org/doc/draft-ietf-quic-load-balancers/\n * The draft defines methods for encoding a server ID in a connection identifier, and optionally\n * obfuscating or encrypting the CID value. The CID are generated by the individual servers,\n * based on configuration options provided by the load balancer. The draft also defines\n * methods for generating retry tokens either by a protection box colocated with the\n * load balancer, or at the individual server, with methods for letting individual\n * servers retrieve information from the tokens.\n */\n\nstatic void picoquic_lb_compat_cid_generate_first_byte(picoquic_quic_t* quic,\n    picoquic_load_balancer_cid_context_t* lb_ctx, picoquic_connection_id_t* cnx_id_returned)\n{\n    if (lb_ctx->first_byte_encodes_length){\n        cnx_id_returned->id[0] = ((uint8_t)lb_ctx->rotation_bits << 6) | ((uint8_t)quic->local_cnxid_length - 1);\n    }\n    else {\n        cnx_id_returned->id[0] &= 0x3F;\n        cnx_id_returned->id[0] |= ((uint8_t)lb_ctx->rotation_bits << 6);\n    }\n}\n\nstatic void picoquic_lb_compat_cid_generate_clear(picoquic_quic_t* quic,\n    picoquic_load_balancer_cid_context_t * lb_ctx, picoquic_connection_id_t* cnx_id_returned)\n{\n    picoquic_lb_compat_cid_generate_first_byte(quic, lb_ctx, cnx_id_returned);\n    memcpy(cnx_id_returned->id + 1, lb_ctx->server_id, lb_ctx->server_id_length);\n}\n\nstatic void picoquic_lb_compat_cid_one_pass_stream(void * enc_ctx, uint8_t * nonce, size_t nonce_length, uint8_t * target, size_t target_length)\n{\n    uint8_t mask[16];\n    /* Set the obfuscation value */\n    memset(mask, 0, sizeof(mask));\n    memcpy(mask, nonce, nonce_length);\n    /* Encrypt with ECB */\n    picoquic_aes128_ecb_encrypt(enc_ctx, mask, mask, sizeof(mask));\n    /* Apply the mask */\n    for (size_t i = 0; i < target_length; i++) {\n        target[i] ^= mask[i];\n    }\n}\n\n/* Per specification:\n * Stream Cipher CID {\n *    First Octet (8),\n *    Nonce (64..120),\n *    Encrypted Server ID (8..128-len(Nonce)),\n *    For Server Use (0..152-len(Nonce)-len(Encrypted Server ID)),\n * }\n */\n\nstatic void picoquic_lb_compat_cid_generate_stream_cipher(picoquic_quic_t* quic,\n    picoquic_load_balancer_cid_context_t* lb_ctx, picoquic_connection_id_t* cnx_id_returned)\n{\n    size_t id_offset = ((size_t)1) + lb_ctx->nonce_length;\n    /* Prepare a clear text server ID */\n    picoquic_lb_compat_cid_generate_first_byte(quic, lb_ctx, cnx_id_returned);\n    memcpy(cnx_id_returned->id + id_offset, lb_ctx->server_id, lb_ctx->server_id_length);\n    /* First pass -- obtain intermediate server ID */\n    picoquic_lb_compat_cid_one_pass_stream(lb_ctx->cid_encryption_context, cnx_id_returned->id + 1, lb_ctx->nonce_length,\n        cnx_id_returned->id + id_offset, lb_ctx->server_id_length);\n    /* Second pass -- obtain encrypted nonce */\n    picoquic_lb_compat_cid_one_pass_stream(lb_ctx->cid_encryption_context, \n        cnx_id_returned->id + id_offset, lb_ctx->server_id_length,\n        cnx_id_returned->id + 1, lb_ctx->nonce_length);\n    /* Third pass -- obtain encrypted server-id */\n    picoquic_lb_compat_cid_one_pass_stream(lb_ctx->cid_encryption_context, cnx_id_returned->id + 1, lb_ctx->nonce_length,\n        cnx_id_returned->id + id_offset, lb_ctx->server_id_length);\n}\n\n/* Per specification:\n * Block Cipher CID {\n *    First Octet (8),\n *    Encrypted Server ID (8..128),\n *    Encrypted Bits for Server Use (128-len(Encrypted Server ID)),\n *    Unencrypted Bits for Server Use (0..24),\n * }\n * In theory, the \"server use\" bits should just be set to a random value.\n * For tests, the server use bits have to be set to a specific value.\n */\nstatic void picoquic_lb_compat_cid_generate_block_cipher(picoquic_quic_t* quic,\n    picoquic_load_balancer_cid_context_t* lb_ctx, picoquic_connection_id_t* cnx_id_returned)\n{\n    picoquic_lb_compat_cid_generate_first_byte(quic, lb_ctx, cnx_id_returned);\n    /* Copy the server ID */\n    memcpy(cnx_id_returned->id + 1, lb_ctx->server_id, lb_ctx->server_id_length);\n    /* encrypt 16 bytes */\n    picoquic_aes128_ecb_encrypt(lb_ctx->cid_encryption_context, cnx_id_returned->id + 1, cnx_id_returned->id + 1, 16);\n}\n\n/* This code assumes that the cnx_id_returned value is pre-filled with\n * the expected values of nonces or local-use content.\n */\nvoid picoquic_lb_compat_cid_generate(picoquic_quic_t* quic, picoquic_connection_id_t UNUSED(cnx_id_local),\n    picoquic_connection_id_t UNUSED(cnx_id_remote), void* cnx_id_cb_data, picoquic_connection_id_t* cnx_id_returned)\n{\n    picoquic_load_balancer_cid_context_t* lb_ctx = (picoquic_load_balancer_cid_context_t*)cnx_id_cb_data;\n#ifdef _WINDOWS\n    UNREFERENCED_PARAMETER(cnx_id_local);\n    UNREFERENCED_PARAMETER(cnx_id_remote);\n#endif\n    switch (lb_ctx->method) {\n    case picoquic_load_balancer_cid_clear:\n        picoquic_lb_compat_cid_generate_clear(quic, lb_ctx, cnx_id_returned);\n        break;\n    case picoquic_load_balancer_cid_stream_cipher:\n        picoquic_lb_compat_cid_generate_stream_cipher(quic, lb_ctx, cnx_id_returned);\n        break;\n    case picoquic_load_balancer_cid_block_cipher:\n        picoquic_lb_compat_cid_generate_block_cipher(quic, lb_ctx, cnx_id_returned);\n        break;\n    default:\n        /* Error, unknown method */\n        break;\n    }\n}\n\nstatic uint64_t picoquic_lb_compat_cid_verify_clear(\n    picoquic_load_balancer_cid_context_t* lb_ctx, picoquic_connection_id_t const* cnx_id)\n{\n    uint64_t s_id64 = 0;\n\n    for (size_t i = 0; i < lb_ctx->server_id_length; i++) {\n        s_id64 <<= 8;\n        s_id64 += cnx_id->id[i + 1];\n    }\n\n    return s_id64;\n}\n\nstatic uint64_t picoquic_lb_compat_cid_verify_stream_cipher(\n    picoquic_load_balancer_cid_context_t* lb_ctx, picoquic_connection_id_t const* cnx_id)\n{\n    size_t id_offset = ((size_t)1) + lb_ctx->nonce_length;\n    uint64_t s_id64 = 0;\n    picoquic_connection_id_t target = *cnx_id;\n    /* First pass -- obtain intermediate server ID */\n    picoquic_lb_compat_cid_one_pass_stream(lb_ctx->cid_encryption_context, target.id + 1, lb_ctx->nonce_length,\n        target.id + id_offset, lb_ctx->server_id_length);\n    /* Second pass -- obtain nonce */\n    picoquic_lb_compat_cid_one_pass_stream(lb_ctx->cid_encryption_context,\n        target.id + id_offset, lb_ctx->server_id_length, target.id + 1, lb_ctx->nonce_length);\n    /* First pass -- obtain server-id */\n    picoquic_lb_compat_cid_one_pass_stream(lb_ctx->cid_encryption_context, target.id + 1, lb_ctx->nonce_length,\n        target.id + id_offset, lb_ctx->server_id_length);\n\n    /* decode the server ID */\n    for (size_t i = 0; i < lb_ctx->server_id_length; i++) {\n        s_id64 <<= 8;\n        s_id64 += target.id[id_offset + i];\n    }\n\n    return s_id64;\n}\n\nstatic uint64_t picoquic_lb_compat_cid_verify_block_cipher(\n    picoquic_load_balancer_cid_context_t* lb_ctx, picoquic_connection_id_t const* cnx_id)\n{\n    uint8_t decoded[16];\n    uint64_t s_id64 = 0;\n\n    /* decrypt 16 bytes */\n    picoquic_aes128_ecb_encrypt(lb_ctx->cid_decryption_context, decoded, cnx_id->id + 1, 16);\n    /* Decode the server ID */\n    if (s_id64 == 0) {\n        for (size_t i = 0; i < lb_ctx->server_id_length; i++) {\n            s_id64 <<= 8;\n            s_id64 += decoded[i];\n        }\n    }\n\n    return s_id64;\n}\n\nuint64_t picoquic_lb_compat_cid_verify(void* cnx_id_cb_data, picoquic_connection_id_t const* cnx_id)\n{\n    picoquic_load_balancer_cid_context_t* lb_ctx = (picoquic_load_balancer_cid_context_t*)cnx_id_cb_data;\n    uint64_t server_id64;\n\n    if (cnx_id->id_len != lb_ctx->connection_id_length) {\n        server_id64 = UINT64_MAX;\n    }\n    else {\n        switch (lb_ctx->method) {\n        case picoquic_load_balancer_cid_clear:\n            server_id64 = picoquic_lb_compat_cid_verify_clear(lb_ctx, cnx_id);\n            break;\n        case picoquic_load_balancer_cid_stream_cipher:\n            server_id64 = picoquic_lb_compat_cid_verify_stream_cipher(lb_ctx, cnx_id);\n            break;\n        case picoquic_load_balancer_cid_block_cipher:\n            server_id64 = picoquic_lb_compat_cid_verify_block_cipher(lb_ctx, cnx_id);\n            break;\n        default:\n            /* Error, unknown method */\n            server_id64 = UINT64_MAX;\n            break;\n        }\n    }\n\n    return server_id64;\n}\n\nint picoquic_lb_compat_cid_config_parse(picoquic_load_balancer_config_t* lb_config, char const* txt, size_t txt_length)\n{\n    int ret = 0;\n    size_t parsed = 0;\n    size_t s_id_len;\n    size_t cid_len = 0;\n    size_t nonce_len = 0;\n    /**/\n    /* separator \"-\" */\n    /* server_id -- string of 2xserver_id_length hex, max 16 */\n    /* separator \"-\" */\n    /* cid_encryption_key -- 32 hex digits*/\n    memset(lb_config, 0, sizeof(*lb_config));\n    if (txt_length < 4) {\n        ret = -1;\n    }\n    else {\n        /* rotation_bits: 0, 1 or 2 -- 3 is indefinite */\n        if (txt[0] >= '0' && txt[0] <= '3') {\n            lb_config->rotation_bits = (unsigned int)(txt[0] - '0');\n        }\n        else {\n            ret = -1;\n        }\n        /* first_byte_encodes_length: Y or N */\n        if (txt[1] == 'Y' || txt[1] == 'y') {\n            lb_config->first_byte_encodes_length = 1;\n        }\n        else if (txt[1] != 'N' && txt[1] != 'n') {\n            ret = -1;\n        }\n        parsed = 2;\n        /* CID length as number, default to zero, in which case will be filled from QUIC context.\n         * need to be careful because value is stored as uint8_t.\n         */\n        while (parsed < txt_length && txt[parsed] >= '0' && txt[parsed] <= '9') {\n            cid_len *= 10;\n            cid_len += txt[parsed] - '0';\n            parsed++;\n            if (cid_len < 256) {\n                lb_config->connection_id_length = (uint8_t)cid_len;\n            }\n            else {\n                ret = -1;\n                break;\n            }\n        }\n        /* method: C, S or B -- clear, stream-encrypted or block encrypted */\n        if (parsed >= txt_length) {\n            ret = -1;\n        }\n        else if (ret == 0) {\n            char c = txt[parsed];\n            parsed++;\n            switch (c) {\n            case 'c':\n            case 'C':\n                lb_config->method = picoquic_load_balancer_cid_clear;\n                break;\n            case 's':\n            case 'S':\n                lb_config->method = picoquic_load_balancer_cid_stream_cipher;\n                while (parsed < txt_length && txt[parsed] >= '0' && txt[parsed] <= '9') {\n                    nonce_len *= 10;\n                    nonce_len += txt[parsed] - '0';\n                    parsed++;\n                    if (nonce_len < 256) {\n                        lb_config->nonce_length = (uint8_t)nonce_len;\n                    }\n                    else {\n                        ret = -1;\n                        break;\n                    }\n                }\n                break;\n            case 'b':\n            case 'B':\n                lb_config->method = picoquic_load_balancer_cid_block_cipher;\n                break;\n            default:\n                ret = -1;\n                break;\n            }\n        }\n        /* Skip hyphen */\n        if (txt[parsed] == '-') {\n            parsed++;\n        }\n        else {\n            ret = -1;\n        }\n    }\n    if (txt_length <= parsed) {\n        ret = -1;\n    }\n    else if (ret == 0) {\n        /* Parsing S_ID as hex string. */\n        uint8_t s_id_bin[8];\n        size_t hex_length = 0;\n        while (parsed + hex_length < txt_length && txt[parsed + hex_length] != '-') {\n            hex_length++;\n        }\n        s_id_len = picoquic_parse_hexa(txt + parsed, hex_length, s_id_bin, 8);\n        if (s_id_len == 0 || s_id_len > 255) {\n            ret = 1;\n        }\n        else {\n            lb_config->server_id_length = (uint8_t)s_id_len;\n            for (size_t i = 0; i < s_id_len; i++) {\n                lb_config->server_id64 <<= 8;\n                lb_config->server_id64 |= s_id_bin[i];\n            }\n        }\n        parsed += 2 * s_id_len;\n    }\n    if (ret == 0 &&\n        (lb_config->method == picoquic_load_balancer_cid_stream_cipher ||\n            lb_config->method == picoquic_load_balancer_cid_block_cipher)) {\n        /* Skip hyphen */\n        if (txt[parsed] == '-') {\n            parsed++;\n        }\n        else {\n            ret = -1;\n        }\n        if (ret == 0) {\n            if (txt_length < parsed + 32) {\n                ret = -1;\n            }\n            else {\n                /* Parse key as 32 bytes string */\n                size_t key_length = picoquic_parse_hexa(txt + parsed, txt_length - parsed, lb_config->cid_encryption_key, 16);\n                if (key_length != 16) {\n                    ret = -1;\n                }\n                parsed += 2 * key_length;\n            }\n        }\n    }\n    if (ret == 0 && parsed != txt_length) {\n        ret = -1;\n    }\n\n    if (ret == 0 && lb_config->connection_id_length != 0) {\n        size_t min_length = 1 + lb_config->server_id_length + lb_config->nonce_length;\n        if (lb_config->connection_id_length < min_length ||\n            (lb_config->method == picoquic_load_balancer_cid_block_cipher && lb_config->connection_id_length < 17)) {\n            ret = -1;\n        }\n    }\n    return ret;\n}\n\nint picoquic_lb_compat_cid_config(picoquic_quic_t* quic, picoquic_load_balancer_config_t * lb_config)\n{\n    int ret = 0;\n\n    if (quic->cnx_list != NULL && quic->local_cnxid_length != lb_config->connection_id_length) {\n        /* Error. Changing the CID length now will break existing connections */\n        ret = -1;\n    }\n    else if (quic->cnx_id_callback_fn != NULL && quic->cnx_id_callback_ctx != NULL){\n        /* Error. Some other CID generation is configured, cannot be changed */\n        ret = -1;\n    }\n    else {\n        /* Verify that the method is supported and the parameters are compatible.\n         * If valid, configure the connection ID generation */\n        if (lb_config->connection_id_length > PICOQUIC_CONNECTION_ID_MAX_SIZE) {\n            ret = -1;\n        }\n        else {\n            switch (lb_config->method) {\n            case picoquic_load_balancer_cid_clear:\n                if (lb_config->server_id_length + 1 > lb_config->connection_id_length) {\n                    ret = -1;\n                }\n                break;\n            case picoquic_load_balancer_cid_stream_cipher:\n                /* Nonce length must be 8 to 16 bytes, CID should be long enough */\n                if (lb_config->nonce_length < 8 || lb_config->nonce_length > 16 ||\n                    lb_config->nonce_length + lb_config->server_id_length + 1 > lb_config->connection_id_length) {\n                    ret = -1;\n                }\n                break;\n            case picoquic_load_balancer_cid_block_cipher:\n                /* CID should include a whole AES-ECB block,\n                 * there should be at least 2 bytes available for uniqueness,\n                 * zero padding length should be 4 bytes for security */\n                if (lb_config->connection_id_length < 17 ||\n                    lb_config->server_id_length > 15) {\n                    ret = -1;\n                }\n                break;\n            default:\n                /* Error, unknown method */\n                ret = -1;\n                break;\n            }\n        }\n        if (ret == 0) {\n            /* Create a copy */\n            picoquic_load_balancer_cid_context_t* lb_ctx = (picoquic_load_balancer_cid_context_t*)malloc(sizeof(picoquic_load_balancer_cid_context_t));\n\n            if (lb_ctx == NULL) {\n                ret = -1;\n            }\n            else {\n                /* if allocated, create the necessary encryption contexts or variables */\n                uint64_t s_id64 = lb_config->server_id64;\n                memset(lb_ctx, 0, sizeof(picoquic_load_balancer_cid_context_t));\n                lb_ctx->method = lb_config->method;\n                lb_ctx->rotation_bits = lb_config->rotation_bits;\n                lb_ctx->first_byte_encodes_length = lb_config->first_byte_encodes_length;\n                lb_ctx->server_id_length = lb_config->server_id_length;\n                lb_ctx->nonce_length = lb_config->nonce_length;\n                lb_ctx->connection_id_length = lb_config->connection_id_length;\n                lb_ctx->server_id64 = lb_config->server_id64;\n                lb_ctx->cid_encryption_context = NULL;\n                lb_ctx->cid_decryption_context = NULL;\n                /* Compute the server ID bytes and set encryption contexts */\n                for (size_t i = 0; i < lb_ctx->server_id_length; i++) {\n                    size_t j = lb_ctx->server_id_length - i - 1;\n                    lb_ctx->server_id[j] = (uint8_t)s_id64;\n                    s_id64 >>= 8;\n                }\n                if (s_id64 != 0) {\n                    /* Server ID not long enough to encode actual value */\n                    ret = -1;\n                } else if (lb_config->method == picoquic_load_balancer_cid_stream_cipher ||\n                    lb_config->method == picoquic_load_balancer_cid_block_cipher) {\n                    lb_ctx->cid_encryption_context = picoquic_aes128_ecb_create(1, lb_config->cid_encryption_key);\n                    if (lb_ctx->cid_encryption_context == NULL) {\n                        ret = -1;\n                    }\n                    else if (lb_config->method == picoquic_load_balancer_cid_block_cipher) {\n                        lb_ctx->cid_decryption_context = picoquic_aes128_ecb_create(0, lb_config->cid_encryption_key);\n                        if (lb_ctx->cid_decryption_context == NULL) {\n                            picoquic_aes128_ecb_free(lb_ctx->cid_encryption_context);\n                            lb_ctx->cid_encryption_context = NULL;\n                            ret = -1;\n                        }\n                    }\n                }\n                if (ret != 0) {\n                    /* if context allocation failed, free the copy */\n                    free(lb_ctx);\n                    lb_ctx = NULL;\n                } else {\n                    /* Configure the CID generation */\n                    quic->local_cnxid_length = lb_ctx->connection_id_length;\n                    quic->cnx_id_callback_fn = picoquic_lb_compat_cid_generate;\n                    quic->cnx_id_callback_ctx = (void*)lb_ctx;\n                }\n            }\n        }\n    }\n\n    return ret;\n}\n\nvoid picoquic_lb_compat_cid_config_free(picoquic_quic_t* quic)\n{\n    if (quic->cnx_id_callback_fn == picoquic_lb_compat_cid_generate &&\n        quic->cnx_id_callback_ctx != NULL) {\n        picoquic_load_balancer_cid_context_t* lb_ctx = (picoquic_load_balancer_cid_context_t*)quic->cnx_id_callback_ctx;\n        /* Release the encryption contexts so as to avoid memory leaks */\n        if (lb_ctx->cid_encryption_context != NULL) {\n            picoquic_aes128_ecb_free(lb_ctx->cid_encryption_context);\n        }\n        if (lb_ctx->cid_decryption_context != NULL) {\n            picoquic_aes128_ecb_free(lb_ctx->cid_decryption_context);\n        }\n        /* Free the data */\n        free(lb_ctx);\n        /* Reset the Quic context */\n        quic->cnx_id_callback_fn = NULL;\n        quic->cnx_id_callback_ctx = NULL;\n    }\n}\n","numLines":516,"startLine":1,"totalLines":516}}}
