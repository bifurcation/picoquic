{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01HJCBXAHZdMBvS1mrRV58yK","type":"tool_result","content":"1\t//! Test cases for `picoquictest/qlog_test.c`.\n2\t\n3\t#![allow(non_snake_case)]\n4\t\n5\tuse std::path::PathBuf;\n6\t\n7\tuse super::util::test_set_minimal_cnx_with_time;\n8\tuse crate::Instant;\n9\tuse crate::binlog::Binlog as _;\n10\tuse crate::qlog::{\n11\t    qlog_chars, qlog_preferred_address, qlog_string, qlog_tp_version_negotiation,\n12\t    qlog_transport_extensions,\n13\t};\n14\t\n15\t// ---------------------------------------------------------------------------\n16\t// autoqlog helpers.\n17\t\n18\tconst AUTOQLOG_BAD_QLOG: &str = \"no_such_folder/bad\\\\folder\";\n19\t\n20\tfn autoqlog_bad_file() -> crate::Result<()> {\n21\t    let mut simulated_time = Instant::from_ticks(0);\n22\t    let mut quic = test_set_minimal_cnx_with_time(&mut simulated_time)?;\n23\t    quic.set_binlog(Some(\".\"))?;\n24\t    quic.set_qlog(AUTOQLOG_BAD_QLOG)?;\n25\t    quic.first_cnx_mut()\n26\t        .expect(\"connection exists\")\n27\t        .start_client()?;\n28\t    Ok(())\n29\t}\n30\t\n31\tfn autoqlog_no_binlog() -> crate::Result<()> {\n32\t    let mut simulated_time = Instant::from_ticks(0);\n33\t    let mut quic = test_set_minimal_cnx_with_time(&mut simulated_time)?;\n34\t    quic.set_binlog(Some(\".\"))?;\n35\t    quic.set_qlog(\".\")?;\n36\t    {\n37\t        let cnx = quic.first_cnx_mut().expect(\"connection exists\");\n38\t        cnx.binlog_file_name = Some(PathBuf::from(AUTOQLOG_BAD_QLOG));\n39\t        cnx.start_client()?;\n40\t    }\n41\t    Ok(())\n42\t}\n43\t\n44\tfn autoqlog_longdir() -> crate::Result<()> {\n45\t    let long_qlog = \"x\".repeat(511);\n46\t    let mut simulated_time = Instant::from_ticks(0);\n47\t    let mut quic = test_set_minimal_cnx_with_time(&mut simulated_time)?;\n48\t    quic.set_binlog(Some(\".\"))?;\n49\t    quic.set_qlog(long_qlog.as_str())?;\n50\t    quic.first_cnx_mut()\n51\t        .expect(\"connection exists\")\n52\t        .start_client()?;\n53\t    Ok(())\n54\t}\n55\t\n56\tfn autoqlog_unique() -> crate::Result<()> {\n57\t    let long_qlog = \"x\".repeat(511);\n58\t    let mut simulated_time = Instant::from_ticks(0);\n59\t    let mut quic = test_set_minimal_cnx_with_time(&mut simulated_time)?;\n60\t    quic.set_use_unique_log_names(true);\n61\t    quic.set_binlog(Some(\".\"))?;\n62\t    quic.set_qlog(long_qlog.as_str())?;\n63\t    {\n64\t        let cnx = quic.first_cnx_mut().expect(\"connection exists\");\n65\t        cnx.new_connection();\n66\t        cnx.start_client()?;\n67\t    }\n68\t    Ok(())\n69\t}\n70\t\n71\t/// C: `qlog_auto_test` in `picoquictest/qlog_test.c`.\n72\t#[test]\n73\tfn qlog_auto() {\n74\t    autoqlog_bad_file().expect(\"autoqlog_bad_file\");\n75\t    autoqlog_no_binlog().expect(\"autoqlog_no_binlog\");\n76\t    autoqlog_longdir().expect(\"autoqlog_longdir\");\n77\t    autoqlog_unique().expect(\"autoqlog_unique\");\n78\t}\n79\t\n80\t// ---------------------------------------------------------------------------\n81\t// qlog_error helpers.\n82\t\n83\tconst QLOG_ERROR_FILE: &str = \"qlog_error_test.txt\";\n84\t\n85\tfn qlog_error_string(out: &mut Vec<u8>) -> crate::Result<()> {\n86\t    // 15 bytes of data (C: data[16] with bs.size = sizeof(data)-1 = 15).\n87\t    let data = b\"xxxxxxxxxxxxxxx\";\n88\t    // Request 2*16=32 bytes, only 15 available → Err (truncation).\n89\t    assert!(\n90\t        qlog_string(out, data, 32).is_err(),\n91\t        \"qlog_string truncation should return Err\"\n92\t    );\n93\t\n94\t    out.push(b'\\n');\n95\t\n96\t    let char_data: &[u8] = &[b'\"', b'\\\\', 0xFF, b' ', b'z', 127];\n97\t    // Request 2*6=12 bytes, only 6 available → Err.\n98\t    assert!(\n99\t        qlog_chars(out, char_data, 12).is_err(),\n100\t        \"qlog_chars truncation should return Err\""}]},"parent_tool_use_id":null,"session_id":"f8748440-59b5-4ac8-a898-54be0860e8a3","uuid":"37f8e75d-3f16-4c1d-8050-8bd24d9aac18","timestamp":"2026-05-06T12:49:30.048Z","tool_use_result":{"type":"text","file":{"filePath":"/Users/richbarn/Projects/picoquic/rs/fq/src/tests/qlog.rs","content":"//! Test cases for `picoquictest/qlog_test.c`.\n\n#![allow(non_snake_case)]\n\nuse std::path::PathBuf;\n\nuse super::util::test_set_minimal_cnx_with_time;\nuse crate::Instant;\nuse crate::binlog::Binlog as _;\nuse crate::qlog::{\n    qlog_chars, qlog_preferred_address, qlog_string, qlog_tp_version_negotiation,\n    qlog_transport_extensions,\n};\n\n// ---------------------------------------------------------------------------\n// autoqlog helpers.\n\nconst AUTOQLOG_BAD_QLOG: &str = \"no_such_folder/bad\\\\folder\";\n\nfn autoqlog_bad_file() -> crate::Result<()> {\n    let mut simulated_time = Instant::from_ticks(0);\n    let mut quic = test_set_minimal_cnx_with_time(&mut simulated_time)?;\n    quic.set_binlog(Some(\".\"))?;\n    quic.set_qlog(AUTOQLOG_BAD_QLOG)?;\n    quic.first_cnx_mut()\n        .expect(\"connection exists\")\n        .start_client()?;\n    Ok(())\n}\n\nfn autoqlog_no_binlog() -> crate::Result<()> {\n    let mut simulated_time = Instant::from_ticks(0);\n    let mut quic = test_set_minimal_cnx_with_time(&mut simulated_time)?;\n    quic.set_binlog(Some(\".\"))?;\n    quic.set_qlog(\".\")?;\n    {\n        let cnx = quic.first_cnx_mut().expect(\"connection exists\");\n        cnx.binlog_file_name = Some(PathBuf::from(AUTOQLOG_BAD_QLOG));\n        cnx.start_client()?;\n    }\n    Ok(())\n}\n\nfn autoqlog_longdir() -> crate::Result<()> {\n    let long_qlog = \"x\".repeat(511);\n    let mut simulated_time = Instant::from_ticks(0);\n    let mut quic = test_set_minimal_cnx_with_time(&mut simulated_time)?;\n    quic.set_binlog(Some(\".\"))?;\n    quic.set_qlog(long_qlog.as_str())?;\n    quic.first_cnx_mut()\n        .expect(\"connection exists\")\n        .start_client()?;\n    Ok(())\n}\n\nfn autoqlog_unique() -> crate::Result<()> {\n    let long_qlog = \"x\".repeat(511);\n    let mut simulated_time = Instant::from_ticks(0);\n    let mut quic = test_set_minimal_cnx_with_time(&mut simulated_time)?;\n    quic.set_use_unique_log_names(true);\n    quic.set_binlog(Some(\".\"))?;\n    quic.set_qlog(long_qlog.as_str())?;\n    {\n        let cnx = quic.first_cnx_mut().expect(\"connection exists\");\n        cnx.new_connection();\n        cnx.start_client()?;\n    }\n    Ok(())\n}\n\n/// C: `qlog_auto_test` in `picoquictest/qlog_test.c`.\n#[test]\nfn qlog_auto() {\n    autoqlog_bad_file().expect(\"autoqlog_bad_file\");\n    autoqlog_no_binlog().expect(\"autoqlog_no_binlog\");\n    autoqlog_longdir().expect(\"autoqlog_longdir\");\n    autoqlog_unique().expect(\"autoqlog_unique\");\n}\n\n// ---------------------------------------------------------------------------\n// qlog_error helpers.\n\nconst QLOG_ERROR_FILE: &str = \"qlog_error_test.txt\";\n\nfn qlog_error_string(out: &mut Vec<u8>) -> crate::Result<()> {\n    // 15 bytes of data (C: data[16] with bs.size = sizeof(data)-1 = 15).\n    let data = b\"xxxxxxxxxxxxxxx\";\n    // Request 2*16=32 bytes, only 15 available → Err (truncation).\n    assert!(\n        qlog_string(out, data, 32).is_err(),\n        \"qlog_string truncation should return Err\"\n    );\n\n    out.push(b'\\n');\n\n    let char_data: &[u8] = &[b'\"', b'\\\\', 0xFF, b' ', b'z', 127];\n    // Request 2*6=12 bytes, only 6 available → Err.\n    assert!(\n        qlog_chars(out, char_data, 12).is_err(),\n        \"qlog_chars truncation should return Err\"","numLines":100,"startLine":1,"totalLines":200}}}
