t = -1;\n            }\n            else {\n                ret = 0;\n            }\n        }\n        else {\n            ret = -1;\n        }\n\n        if (ret != 0) {\n            free(memlog);\n        }\n        else {\n            cnx->memlog_call_back = memlog_call_back;\n            cnx->memlog_ctx = memlog;\n        }\n    }\n    return(ret);\n}\n```\n\n### 3. `picoquic_public_random_seed_64`\n**File:** `/Users/richbarn/Projects/picoquic/picoquic/tls_api.c` (lines 841-856)\n\n```c\nvoid picoquic_public_random_seed_64(uint64_t seed, int reset)\n{\n    if (reset) {\n        public_random_index = 0;\n        for (uint64_t i = 0; i < 16; i++) {\n            public_random_seed[i] = i + 1u;\n        }\n        public_random_obfuscator = 0x5555555555555555ull;\n    }\n\n    public_random_seed[public_random_index] ^= seed;\n\n    for (int i = 0; i < 16; i++) {\n        (void)picoquic_public_random_step();\n    }\n}\n```\n\n### 4. `picoquic_log_new_connection`\n**File:** `/Users/richbarn/Projects/picoquic/picoquic/unified_log.c` (lines 285-298)\n\n```c\nvoid picoquic_log_new_connection(picoquic_cnx_t* cnx)\n{\n    if (cnx->quic->F_log != NULL) {\n        cnx->quic->text_log_fns->log_new_connection(cnx);\n    }\n\n    if (cnx->quic->bin_log_fns != NULL) {\n        cnx->quic->bin_log_fns->log_new_connection(cnx);\n    }\n\n    if (cnx->quic->qlog_fns != NULL) {\n        cnx->quic->qlog_fns->log_new_connection(cnx);\n    }\n}\n```\n\n### 5. `picoquic_log_app_message`\n**File:** `/Users/richbarn/Projects/picoquic/picoquic/unified_log.c` (lines 75-98)\n\n```c\nvoid picoquic_log_app_message(picoquic_cnx_t* cnx, const char* fmt, ...)\n{\n    PICOQUIC_THREAD_CHECK(cnx->quic);\n    if (cnx->quic->F_log != NULL) {\n        va_list args;\n        va_start(args, fmt);\n        cnx->quic->text_log_fns->log_app_message(cnx, fmt, args);\n        va_end(args);\n    }\n\n    if (cnx->f_binlog != NULL) {\n        va_list args;\n        va_start(args, fmt);\n        cnx->quic->bin_l