{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_012Pm5U9gcMZ5wAGAbC56FTL","type":"tool_result","content":"1\t//! QUIC transport-parameter shapes and helpers.\n2\t//!\n3\t//! Wire-format identifiers ([`TransportParameter`]), the value\n4\t//! structs that travel inside a TP block ([`PreferredAddress`],\n5\t//! [`VersionNegotiation`]), and the aggregate the handshake hands\n6\t//! to the application ([`TransportParameters`]).\n7\t\n8\tuse core::net::SocketAddr;\n9\t\n10\tuse crate::{ConnectionId, Duration};\n11\t\n12\t// ---------------------------------------------------------------------------\n13\t// Wire identifiers.\n14\t\n15\t/// QUIC transport-parameter identifiers.  Wire values exceed `u32`\n16\t/// for several extension parameters, hence `#[repr(u64)]`.\n17\t#[derive(Debug, Copy, Clone, PartialEq, Eq)]\n18\t#[repr(u64)]\n19\tpub enum TransportParameter {\n20\t    OriginalConnectionId = 0,\n21\t    IdleTimeout = 1,\n22\t    StatelessResetToken = 2,\n23\t    MaxPacketSize = 3,\n24\t    InitialMaxData = 4,\n25\t    InitialMaxStreamDataBidiLocal = 5,\n26\t    InitialMaxStreamDataBidiRemote = 6,\n27\t    InitialMaxStreamDataUni = 7,\n28\t    InitialMaxStreamsBidi = 8,\n29\t    InitialMaxStreamsUni = 9,\n30\t    AckDelayExponent = 10,\n31\t    MaxAckDelay = 11,\n32\t    DisableMigration = 12,\n33\t    ServerPreferredAddress = 13,\n34\t    ActiveConnectionIdLimit = 14,\n35\t    HandshakeConnectionId = 15,\n36\t    RetryConnectionId = 16,\n37\t    /// Per `draft-quic-multipath 20`.\n38\t    InitialMaxPathId = 0x3e,\n39\t    VersionNegotiation = 0x11,\n40\t    /// Per `draft-pauly-quic-datagram-05`.\n41\t    MaxDatagramFrameSize = 32,\n42\t    TestLargeChello = 3127,\n43\t    EnableLossBit = 0x1057,\n44\t    /// `(x & 1)` ↔ \"want timestamps\", `(x & 2)` ↔ \"can send timestamps\".\n45\t    EnableTimeStamp = 0x7158,\n46\t    GreaseQuicBit = 0x2ab2,\n47\t    /// Per `draft-kuhn-quic-0rtt-bdp-09`.\n48\t    EnableBdpFrame = 0xebd9,\n49\t    MinAckDelay = 0xff04de1b,\n50\t    /// Per `draft-seemann-quic-address-discovery`.\n51\t    AddressDiscovery = 0x9f81a176,\n52\t    /// Per `draft-ietf-quic-reliable-stream-reset-07`.\n53\t    ResetStreamAt = 0x17f7586d2cb571,\n54\t}\n55\t\n56\timpl TransportParameter {\n57\t    /// Textual name for `tp_number`, taking a raw `u64` so callers\n58\t    /// can name unknown / extension parameter IDs too.  C: `tp_name`.\n59\t    pub fn name(_tp_number: u64) -> Option<&'static str> {\n60\t        todo!()\n61\t    }\n62\t}\n63\t\n64\t/// 0-RTT-remembered transport-parameter slots.  Indexes into the\n65\t/// `tp_0rtt: [u64; NB_TP_0RTT]` table on a stored ticket.  C:\n66\t/// `Tp0rttKind`.\n67\t#[derive(Debug, Copy, Clone, PartialEq, Eq)]\n68\t#[repr(u8)]\n69\tpub enum TransportParameter0RttKind {\n70\t    MaxData = 0,\n71\t    MaxStreamDataBidiLocal = 1,\n72\t    MaxStreamDataBidiRemote = 2,\n73\t    MaxStreamDataUni = 3,\n74\t    MaxStreamsIdBidir = 4,\n75\t    MaxStreamsIdUnidir = 5,\n76\t    RttLocal = 6,\n77\t    CwinLocal = 7,\n78\t    RttRemote = 8,\n79\t    CwinRemote = 9,\n80\t}\n81\t\n82\t/// C: `nb_tp_0rtt`.  Number of variants in\n83\t/// [`TransportParameter0RttKind`].\n84\tpub const NB_TP_0RTT: usize = 10;\n85\t\n86\t// ---------------------------------------------------------------------------\n87\t// Preferred-address TP value.\n88\t\n89\t/// Server's preferred address advertised in transport parameters.\n90\t/// At most one IPv4 and at most one IPv6 endpoint may be present;\n91\t/// each socket address (the C `ipvNAddress[]` + `ipvNPort` pair)\n92\t/// folds into an `Option<SocketAddr>`.  C: `TpPreferredAddress`.\n93\t#[derive(Debug, Default, Copy, Clone)]\n94\tpub struct PreferredAddress {\n95\t    /// IPv4 address + port, if the server advertised one.\n96\t    pub v4: Option<SocketAddr>,\n97\t    /// IPv6 address + port, if the server advertised one.\n98\t    pub v6: Option<SocketAddr>,\n99\t    pub connection_id: ConnectionId,\n100\t    pub stateless_reset_token: [u8; 16],\n101\t}\n102\t\n103\t// ---------------------------------------------------------------------------\n104\t// Version-negotiation TP value.\n105\t\n106\t/// Version-negotiation TP payload.  C: `TpVersionNegotiation`.\n107\t/// The C `nb_received` / `nb_supported` length fields disappear\n108\t/// (the `Vec`s carry their lengths).\n109\t#[derive(Debug, Default, Clone)]\n110\tpub struct VersionNegotiation {\n111\t    /// Version found in TP, should match envelope.\n112\t    pub current: u32,\n113\t    /// Version that triggered a previous version negotiation.\n114\t    pub previous: u32,\n115\t    /// Versions received in a prior VN packet (client side only).\n116\t    pub received: Vec<u32>,\n117\t    /// Compatible versions supported by the peer (client side only).\n118\t    pub supported: Vec<u32>,\n119\t}\n120\t\n121\t// ---------------------------------------------------------------------------\n122\t// Aggregate.\n123\t\n124\t/// Full set of QUIC transport parameters carried during the\n125\t/// handshake.  C: `TransportParameters`.\n126\t///\n127\t/// `migration_disabled`, `do_grease_quic_bit`, `enable_bdp_frame`,\n128\t/// `is_reset_stream_at_enabled` were `unsigned int` Booleans in C;\n129\t/// promoted to `bool`.  `enable_loss_bit`, `enable_time_stamp`,\n130\t/// `address_discovery_mode` are kept as integers because callers\n131\t/// inspect the low bits separately (\"want / can\" flags).\n132\t#[derive(Debug, Clone)]\n133\tpub struct TransportParameters {\n134\t    pub initial_max_stream_data_bidi_local: u64,\n135\t    pub initial_max_stream_data_bidi_remote: u64,\n136\t    pub initial_max_stream_data_uni: u64,\n137\t    pub initial_max_data: u64,\n138\t    pub initial_max_stream_id_bidir: u64,\n139\t    pub initial_max_stream_id_unidir: u64,\n140\t    pub max_idle_timeout: Duration,\n141\t    pub max_packet_size: u32,\n142\t    pub max_ack_delay: u32,\n143\t    pub active_connection_id_limit: u32,\n144\t    pub ack_delay_exponent: u8,\n145\t  