{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01JCY1v7zvvQCYDfV1pfgNmt","type":"tool_result","content":"1\t//! Numeric error codes used over the QUIC wire and inside picoquic.\n2\t//!\n3\t//! Two distinct ranges:\n4\t//!\n5\t//! * [`InternalError`] — picoquic-private codes allocated in the\n6\t//!   `0x400`+ range so they never collide with QUIC transport or\n7\t//!   TLS alert codes.  Surface inside the library; never put on the\n8\t//!   wire.\n9\t//! * [`TransportError`] — QUIC transport / TLS-alert codes from\n10\t//!   RFC 9000 §20 (and various drafts).  These cross the wire in\n11\t//!   CONNECTION_CLOSE frames.\n12\t//!\n13\t//! The `crate::Error` enum (defined in `lib.rs`) is the richer Rust\n14\t//! error surface used by fallible APIs; these enums provide the\n15\t//! numeric on-wire / on-log codes those errors map to.\n16\t\n17\t// ---------------------------------------------------------------------------\n18\t// Picoquic-internal errors.\n19\t\n20\t/// Base offset for picoquic's internal error codes.  Allocated in\n21\t/// the `0x400`+ range so they never collide with QUIC transport or\n22\t/// TLS alert codes.\n23\tpub const ERROR_CLASS: u64 = 0x400;\n24\t\n25\t/// Picoquic-internal error code.  Numeric values follow C source.\n26\t#[derive(Debug, Copy, Clone, PartialEq, Eq)]\n27\t#[repr(u64)]\n28\tpub enum InternalError {\n29\t    Duplicate = ERROR_CLASS + 1,\n30\t    AeadCheck = ERROR_CLASS + 3,\n31\t    UnexpectedPacket = ERROR_CLASS + 4,\n32\t    Memory = ERROR_CLASS + 5,\n33\t    CnxidCheck = ERROR_CLASS + 7,\n34\t    InitialTooShort = ERROR_CLASS + 8,\n35\t    VersionNegotiationSpoofed = ERROR_CLASS + 9,\n36\t    MalformedTransportExtension = ERROR_CLASS + 10,\n37\t    ExtensionBufferTooSmall = ERROR_CLASS + 11,\n38\t    IllegalTransportExtension = ERROR_CLASS + 12,\n39\t    CannotResetStreamZero = ERROR_CLASS + 13,\n40\t    InvalidStreamId = ERROR_CLASS + 14,\n41\t    StreamAlreadyClosed = ERROR_CLASS + 15,\n42\t    FrameBufferTooSmall = ERROR_CLASS + 16,\n43\t    InvalidFrame = ERROR_CLASS + 17,\n44\t    CannotControlStreamZero = ERROR_CLASS + 18,\n45\t    Retry = ERROR_CLASS + 19,\n46\t    Disconnected = ERROR_CLASS + 20,\n47\t    Detected = ERROR_CLASS + 21,\n48\t    InvalidTicket = ERROR_CLASS + 23,\n49\t    InvalidFile = ERROR_CLASS + 24,\n50\t    SendBufferTooSmall = ERROR_CLASS + 25,\n51\t    UnexpectedState = ERROR_CLASS + 26,\n52\t    UnexpectedError = ERROR_CLASS + 27,\n53\t    TlsServerConWithoutCert = ERROR_CLASS + 28,\n54\t    NoSuchFile = ERROR_CLASS + 29,\n55\t    StatelessReset = ERROR_CLASS + 30,\n56\t    ConnectionDeleted = ERROR_CLASS + 31,\n57\t    CnxidSegment = ERROR_CLASS + 32,\n58\t    CnxidNotAvailable = ERROR_CLASS + 33,\n59\t    MigrationDisabled = ERROR_CLASS + 34,\n60\t    CannotComputeKey = ERROR_CLASS + 35,\n61\t    CannotSetActiveStream = ERROR_CLASS + 36,\n62\t    CannotChangeActiveContext = ERROR_CLASS + 37,\n63\t    InvalidToken = ERROR_CLASS + 38,\n64\t    InitialCidTooShort = ERROR_CLASS + 39,\n65\t    KeyRotationNotReady = ERROR_CLASS + 40,\n66\t    AeadNotReady = ERROR_CLASS + 41,\n67\t    NoAlpnProvided = ERROR_CLASS + 42,\n68\t    NoCallbackProvided = ERROR_CLASS + 43,\n69\t    /// Not actually an error: signals that the stream-receive\n70\t    /// callback consumed all available bytes.\n71\t    StreamReceiveComplete = ERROR_CLASS + 44,\n72\t    PacketHeaderParsing = ERROR_CLASS + 45,\n73\t    QuicBitMissing = ERROR_CLASS + 46,\n74\t    /// Not an error: terminates the packet loop cleanly.\n75\t    NoErrorTerminatePacketLoop = ERROR_CLASS + 47,\n76\t    /// Not an error: simulated NAT for tests.\n77\t    NoErrorSimulateNat = ERROR_CLASS + 48,\n78\t    /// Not an error: simulated migration for tests.\n79\t    NoErrorSimulateMigration = ERROR_CLASS + 49,\n80\t    VersionNotSupported = ERROR_CLASS + 50,\n81\t    IdleTimeout = ERROR_CLASS + 51,\n82\t    RepeatTimeout = ERROR_CLASS + 52,\n83\t    HandshakeTimeout = ERROR_CLASS + 53,\n84\t    SocketError = ERROR_CLASS + 54,\n85\t    VersionNegotiation = ERROR_CLASS + 55,\n86\t    PacketTooLong = ERROR_CLASS + 56,\n87\t    PacketWrongVersion = ERROR_CLASS + 57,\n88\t    PortBlocked = ERROR_CLASS + 58,\n89\t    DatagramTooLong = ERROR_CLASS + 59,\n90\t    PathIdInvalid = ERROR_CLASS + 60,\n91\t    RetryNeeded = ERROR_CLASS + 61,\n92\t    ServerBusy = ERROR_CLASS + 62,\n93\t    PathDuplicate = ERROR_CLASS + 63,\n94\t    PathIdBlocked = ERROR_CLASS + 64,\n95\t    PathCidBlocked = ERROR_CLASS + 65,\n96\t    PathAddressFamily = ERROR_CLASS + 66,\n97\t    PathNotReady = ERROR_CLASS + 67,\n98\t    PathLimitExceeded = ERROR_CLASS + 68,\n99\t    /// Not an error: the packet was captured by a proxy and needs\n100\t    /// no further processing.\n101\t    Redirected = ERROR_CLASS + 69,\n102\t    PaddingPacket = ERROR_CLASS + 70,\n103\t}\n104\t\n105\timpl InternalError {\n106\t    /// Short textual name for `error_code`, taking a raw `u64` so\n107\t    /// callers can also name unknown / extension codes.  C:\n108\t    /// `error_name`.\n109\t    pub fn name(_error_code: u64) -> Option<&'static str> {\n110\t        todo!()\n111\t    }\n112\t}\n113\t\n114\t// ---------------------------------------------------------------------------\n115\t// QUIC transport / TLS-alert protocol errors.\n116\t\n117\t/// QUIC transport-layer error code (RFC 9000 §20.1) or TLS-alert\n118\t/// code routed through the QUIC `CRYPTO_ERROR(0x0100..=0x01ff)`\n119\t/// range.  Wire values fit in `u62` but extension drafts go above\n120\t/// `u32`, so the discriminant is `u64`.\n121\t#[derive(Debug, Copy, Clone, PartialEq, Eq)]\n122\t#[repr(u64)]\n123\tpub enum TransportError {\n124\t    InternalError = 0x1,\n125\t    ServerBusy = 0x2,\n126\t    FlowControlError = 0x3,\n127\t    StreamLimitError = 0x4,\n128\t    StreamStateError = 0x5,\n129\t    FinalOffsetError = 0x6,\n130\t    FrameFormatError = 0x7,\n131\t    ParameterError = 0x8,\n132\t    ConnectionIdLimitError = 0x9,\n133\t    ProtocolViolation = 0xA,\n134\t    InvalidToken = 0xB,\n135\t    ApplicationError = 0xC,\n136\t    CryptoBufferExceeded = 0xD,\n137\t    KeyUpdateError = 0xE,\n138\t    AeadLimitReached = 0xF,\n139\t\n140\t    VersionNegotiationError = 0x11,\n141\t\n142\t    TlsAlertWrongAlpn = 0x178,\n143\t    TlsHandshakeFailed = 0x201,\n144\t\n145\t    /// Per draft quic-multipath 20.\n146\t    ApplicationAbandon = 0x3e,\n147\t    ResourceLimitReached = 0x3e75,\n148\t    UnstableInterface = 0x3e76,\n149\t    NoCidAvailable = 0x3e77,\n150\t}\n151\t\n152\t/// Build a `CRYPTO_ERROR` transport code from a TLS alert byte.\n153\t/// C macro: `TRANSPORT_CRYPTO_ERROR(alert)`.\n154\tpub const fn transport_crypto_error(alert: u8) -> u16 {\n155\t    0x100 | (alert as u16)\n156\t}\n157\t\n158\t#[cfg(test)]\n159\tmod test {}\n160\t"}]},"parent_tool_use_id":null,"session_id":"cc182de5-19b4-4aa4-aa90-d021cc9bedf5","uuid":"899e1b7d-c345-400e-bf40-c261398083d9","timestamp":"2026-05-05T13:14:29.154Z","tool_use_result":{"type":"text","file":{"filePath":"/Users/richbarn/Projects/picoquic/rs/fq/src/errors.rs","content":"//! Numeric error codes used over the QUIC wire and inside picoquic.\n//!\n//! Two distinct ranges:\n//!\n//! * [`InternalError`] — picoquic-private codes allocated in the\n//!   `0x400`+ range so they never collide with QUIC transport or\n//!   TLS alert codes.  Surface inside the library; never put on the\n//!   wire.\n//! * [`TransportError`] — QUIC transport / TLS-alert codes from\n//!   RFC 9000 §20 (and various drafts).  These cross the wire in\n//!   CONNECTION_CLOSE frames.\n//!\n//! The `crate::Error` enum (defined in `lib.rs`) is the richer Rust\n//! error surface used by fallible APIs; these enums provide the\n//! numeric on-wire / on-log codes those errors map to.\n\n// ---------------------------------------------------------------------------\n// Picoquic-internal errors.\n\n/// Base offset for picoquic's internal error codes.  Allocated in\n/// the `0x400`+ range so they never collide with QUIC transport or\n/// TLS alert codes.\npub const ERROR_CLASS: u64 = 0x400;\n\n/// Picoquic-internal error code.  Numeric values follow C source.\n#[derive(Debug, Copy, Clone, PartialEq, Eq)]\n#[repr(u64)]\npub enum InternalError {\n    Duplicate = ERROR_CLASS + 1,\n    AeadCheck = ERROR_CLASS + 3,\n    UnexpectedPacket = ERROR_CLASS + 4,\n    Memory = ERROR_CLASS + 5,\n    CnxidCheck = ERROR_CLASS + 7,\n    InitialTooShort = ERROR_CLASS + 8,\n    VersionNegotiationSpoofed = ERROR_CLASS + 9,\n    MalformedTransportExtension = ERROR_CLASS + 10,\n    ExtensionBufferTooSmall = ERROR_CLASS + 11,\n    IllegalTransportExtension = ERROR_CLASS + 12,\n    CannotResetStreamZero = ERROR_CLASS + 13,\n    InvalidStreamId = ERROR_CLASS + 14,\n    StreamAlreadyClosed = ERROR_CLASS + 15,\n    FrameBufferTooSmall = ERROR_CLASS + 16,\n    InvalidFrame = ERROR_CLASS + 17,\n    CannotControlStreamZero = ERROR_CLASS + 18,\n    Retry = ERROR_CLASS + 19,\n    Disconnected = ERROR_CLASS + 20,\n    Detected = ERROR_CLASS + 21,\n    InvalidTicket = ERROR_CLASS + 23,\n    InvalidFile = ERROR_CLASS + 24,\n    SendBufferTooSmall = ERROR_CLASS + 25,\n    UnexpectedState = ERROR_CLASS + 26,\n    UnexpectedError = ERROR_CLASS + 27,\n    TlsServerConWithoutCert = ERROR_CLASS + 28,\n    NoSuchFile = ERROR_CLASS + 29,\n    StatelessReset = ERROR_CLASS + 30,\n    ConnectionDeleted = ERROR_CLASS + 31,\n    CnxidSegment = ERROR_CLASS + 32,\n    CnxidNotAvailable = ERROR_CLASS + 33,\n    MigrationDisabled = ERROR_CLASS + 34,\n    CannotComputeKey = ERROR_CLASS + 35,\n    CannotSetActiveStream = ERROR_CLASS + 36,\n    CannotChangeActiveContext = ERROR_CLASS + 37,\n    InvalidToken = ERROR_CLASS + 38,\n    InitialCidTooShort = ERROR_CLASS + 39,\n    KeyRotationNotReady = ERROR_CLASS + 40,\n    AeadNotReady = ERROR_CLASS + 41,\n    NoAlpnProvided = ERROR_CLASS + 42,\n    NoCallbackProvided = ERROR_CLASS + 43,\n    /// Not actually an error: signals that the stream-receive\n    /// callback consumed all available bytes.\n    StreamReceiveComplete = ERROR_CLASS + 44,\n    PacketHeaderParsing = ERROR_CLASS + 45,\n    QuicBitMissing = ERROR_CLASS + 46,\n    /// Not an error: terminates the packet loop cleanly.\n    NoErrorTerminatePacketLoop = ERROR_CLASS + 47,\n    /// Not an error: simulated NAT for tests.\n    NoErrorSimulateNat = ERROR_CLASS + 48,\n    /// Not an error: simulated migration for tests.\n    NoErrorSimulateMigration = ERROR_CLASS + 49,\n    VersionNotSupported = ERROR_CLASS + 50,\n    IdleTimeout = ERROR_CLASS + 51,\n    RepeatTimeout = ERROR_CLASS + 52,\n    HandshakeTimeout = ERROR_CLASS + 53,\n    SocketError = ERROR_CLASS + 54,\n    VersionNegotiation = ERROR_CLASS + 55,\n    PacketTooLong = ERROR_CLASS + 56,\n    PacketWrongVersion = ERROR_CLASS + 57,\n    PortBlocked = ERROR_CLASS + 58,\n    DatagramTooLong = ERROR_CLASS + 59,\n    PathIdInvalid = ERROR_CLASS + 60,\n    RetryNeeded = ERROR_CLASS + 61,\n    ServerBusy = ERROR_CLASS + 62,\n    PathDuplicate = ERROR_CLASS + 63,\n    PathIdBlocked = ERROR_CLASS + 64,\n    PathCidBlocked = ERROR_CLASS + 65,\n    PathAddressFamily = ERROR_CLASS + 66,\n    PathNotReady = ERROR_CLASS + 67,\n    PathLimitExceeded = ERROR_CLASS + 68,\n    /// Not an error: the packet was captured by a proxy and needs\n    /// no further processing.\n    Redirected = ERROR_CLASS + 69,\n    PaddingPacket = ERROR_CLASS + 70,\n}\n\nimpl InternalError {\n    /// Short textual name for `error_code`, taking a raw `u64` so\n    /// callers can also name unknown / extension codes.  C:\n    /// `error_name`.\n    pub fn name(_error_code: u64) -> Option<&'static str> {\n        todo!()\n    }\n}\n\n// ---------------------------------------------------------------------------\n// QUIC transport / TLS-alert protocol errors.\n\n/// QUIC transport-layer error code (RFC 9000 §20.1) or TLS-alert\n/// code routed through the QUIC `CRYPTO_ERROR(0x0100..=0x01ff)`\n/// range.  Wire values fit in `u62` but extension drafts go above\n/// `u32`, so the discriminant is `u64`.\n#[derive(Debug, Copy, Clone, PartialEq, Eq)]\n#[repr(u64)]\npub enum TransportError {\n    InternalError = 0x1,\n    ServerBusy = 0x2,\n    FlowControlError = 0x3,\n    StreamLimitError = 0x4,\n    StreamStateError = 0x5,\n    FinalOffsetError = 0x6,\n    FrameFormatError = 0x7,\n    ParameterError = 0x8,\n    ConnectionIdLimitError = 0x9,\n    ProtocolViolation = 0xA,\n    InvalidToken = 0xB,\n    ApplicationError = 0xC,\n    CryptoBufferExceeded = 0xD,\n    KeyUpdateError = 0xE,\n    AeadLimitReached = 0xF,\n\n    VersionNegotiationError = 0x11,\n\n    TlsAlertWrongAlpn = 0x178,\n    TlsHandshakeFailed = 0x201,\n\n    /// Per draft quic-multipath 20.\n    ApplicationAbandon = 0x3e,\n    ResourceLimitReached = 0x3e75,\n    UnstableInterface = 0x3e76,\n    NoCidAvailable = 0x3e77,\n}\n\n/// Build a `CRYPTO_ERROR` transport code from a TLS alert byte.\n/// C macro: `TRANSPORT_CRYPTO_ERROR(alert)`.\npub const fn transport_crypto_error(alert: u8) -> u16 {\n    0x100 | (alert as u16)\n}\n\n#[cfg(test)]\nmod test {}\n","numLines":160,"startLine":1,"totalLines":160}}}
