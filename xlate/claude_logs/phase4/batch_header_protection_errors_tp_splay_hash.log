{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01E5By4RQhA64Wozrp8SkMiH","type":"tool_result","content":"1\t//! QUIC header protection (packet-number encryption).\n2\t//!\n3\t//! Per RFC 9001 §5.4, header protection masks five bytes of the\n4\t//! packet header (the first byte's low bits plus the packet\n5\t//! number) with output derived from the AEAD-encrypted payload.\n6\t//! The mask comes from running a sample of the ciphertext\n7\t//! through a *non-AEAD* cipher: AES-128/256 ECB for AES suites,\n8\t//! ChaCha20 with the sample as a nonce for ChaCha20 suites.\n9\t//!\n10\t//! Phase 2 decision (per the plan): header protection is QUIC\n11\t//! logic, not TLS-stack logic.  We implement it ourselves in\n12\t//! this crate over the `cipher` crate's primitives, rather\n13\t//! than delegating to the TLS backend.  Backends supply only\n14\t//! the *key bytes* derived from the handshake; this module\n15\t//! holds the algorithm.\n16\t\n17\textern crate alloc;\n18\tuse alloc::boxed::Box;\n19\t\n20\tuse cipher::{BlockEncrypt, KeyInit};\n21\t\n22\tuse crate::Error;\n23\tuse crate::tls::HeaderKey;\n24\t\n25\t// ---------------------------------------------------------------------------\n26\t// AES-based header protection (cipher suites\n27\t// `TLS_AES_128_GCM_SHA256` and `TLS_AES_256_GCM_SHA384`).\n28\t\n29\t/// AES-ECB header protector.  `C` is `aes::Aes128` or\n30\t/// `aes::Aes256`; both implement\n31\t/// [`cipher::BlockEncrypt<BlockSize = U16>`].\n32\tpub struct AesHeaderProtector<C> {\n33\t    #[allow(dead_code)] // Phase 4 wires this through to the body.\n34\t    cipher: C,\n35\t}\n36\t\n37\timpl<C> AesHeaderProtector<C>\n38\twhere\n39\t    C: KeyInit + BlockEncrypt + Send,\n40\t{\n41\t    /// Construct from a freshly-derived header-protection key.\n42\t    pub fn new(_key: &[u8]) -> Result<Self, Error> {\n43\t        todo!()\n44\t    }\n45\t\n46\t    /// Compute the 16-byte mask from a 16-byte sample.  QUIC\n47\t    /// uses bytes `[0..5]` of the result; the rest are wasted\n48\t    /// but the AES API gives us a full block.\n49\t    pub fn mask(&self, _sample: &[u8; 16]) -> [u8; 16] {\n50\t        todo!()\n51\t    }\n52\t}\n53\t\n54\t// ---------------------------------------------------------------------------\n55\t// ChaCha20-based header protection (cipher suite\n56\t// `TLS_CHACHA20_POLY1305_SHA256`).\n57\t//\n58\t// The header-protection cipher for ChaCha20 suites is plain\n59\t// ChaCha20 (no Poly1305): the first 4 bytes of the sample are\n60\t// the block counter, the next 12 bytes are the nonce, and the\n61\t// \"mask\" is the first 16 bytes of the keystream.\n62\t\n63\t/// ChaCha20 header protector.\n64\tpub struct ChaCha20HeaderProtector {\n65\t    #[allow(dead_code)] // Phase 4 wires this through to the body.\n66\t    key: [u8; 32],\n67\t}\n68\t\n69\timpl ChaCha20HeaderProtector {\n70\t    pub fn new(_key: &[u8]) -> Result<Self, Error> {\n71\t        todo!()\n72\t    }\n73\t\n74\t    pub fn mask(&self, _sample: &[u8; 16]) -> [u8; 16] {\n75\t        todo!()\n76\t    }\n77\t}\n78\t\n79\t// ---------------------------------------------------------------------------\n80\t// `HeaderKey` impls.\n81\t//\n82\t// Each protector implements [`crate::tls::HeaderKey`] so it can\n83\t// be used through the TLS abstraction.  The encrypt / decrypt\n84\t// methods walk the packet header per RFC 9001 §5.4.\n85\t\n86\t/// One direction of AES-based header protection wrapped as a\n87\t/// [`HeaderKey`].\n88\tpub struct AesHeaderKey<C> {\n89\t    #[allow(dead_code)]\n90\t    protector: AesHeaderProtector<C>,\n91\t}\n92\t\n93\timpl<C> AesHeaderKey<C>\n94\twhere\n95\t    C: KeyInit + BlockEncrypt + Send + 'static,\n96\t{\n97\t    /// Construct an [`AesHeaderKey`] boxed as a `HeaderKey`\n98\t    /// trait object.  Named `boxed` (not `new`) so clippy\n99\t    /// doesn't grumble that `new` should return `Self`.\n100\t    pub fn boxed(key: &[u8]) -> Result<Box<dyn HeaderKey>, Error> {\n101\t        Ok(Box::new(Self {\n102\t            protector: AesHeaderProtector::<C>::new(key)?,\n103\t        }))\n104\t    }\n105\t}\n106\t\n107\timpl<C> HeaderKey for AesHeaderKey<C>\n108\twhere\n109\t    C: KeyInit + BlockEncrypt + Send,\n110\t{\n111\t    fn mask(&self, sample: [u8; 16]) -> [u8; 16] {\n112\t        self.protector.mask(&sample)\n113\t    }\n114\t}\n115\t\n116\t/// One direction of ChaCha20-based header protection wrapped\n117\t/// as a [`HeaderKey`].\n118\tpub struct ChaCha20HeaderKey {\n119\t    #[allow(dead_code)]\n120\t    protector: ChaCha20HeaderProtector,\n121\t}\n122\t\n123\timpl ChaCha20HeaderKey {\n124\t    /// Construct a [`ChaCha20HeaderKey`] boxed as a `HeaderKey`\n125\t    /// trait object.\n126\t    pub fn boxed(key: &[u8]) -> Result<Box<dyn HeaderKey>, Error> {\n127\t        Ok(Box::new(Self {\n128\t            protector: ChaCha20HeaderProtector::new(key)?,\n129\t        }))\n130\t    }\n131\t}\n132\t\n133\timpl HeaderKey for ChaCha20HeaderKey {\n134\t    fn mask(&self, sample: [u8; 16]) -> [u8; 16] {\n135\t        self.protector.mask(&sample)\n136\t    }\n137\t}\n138\t\n139\t#[cfg(test)]\n140\tmod test {}\n141\t"}]},"parent_tool_use_id":null,"session_id":"cc182de5-19b4-4aa4-aa90-d021cc9bedf5","uuid":"1c3aeee0-94ae-4716-818f-52035b2ec6bf","timestamp":"2026-05-05T13:14:28.930Z","tool_use_result":{"type":"text","file":{"filePath":"/Users/richbarn/Projects/picoquic/rs/fq/src/header_protection.rs","content":"//! QUIC header protection (packet-number encryption).\n//!\n//! Per RFC 9001 §5.4, header protection masks five bytes of the\n//! packet header (the first byte's low bits plus the packet\n//! number) with output derived from the AEAD-encrypted payload.\n//! The mask comes from running a sample of the ciphertext\n//! through a *non-AEAD* cipher: AES-128/256 ECB for AES suites,\n//! ChaCha20 with the sample as a nonce for ChaCha20 suites.\n//!\n//! Phase 2 decision (per the plan): header protection is QUIC\n//! logic, not TLS-stack logic.  We implement it ourselves in\n//! this crate over the `cipher` crate's primitives, rather\n//! than delegating to the TLS backend.  Backends supply only\n//! the *key bytes* derived from the handshake; this module\n//! holds the algorithm.\n\nextern crate alloc;\nuse alloc::boxed::Box;\n\nuse cipher::{BlockEncrypt, KeyInit};\n\nuse crate::Error;\nuse crate::tls::HeaderKey;\n\n// ---------------------------------------------------------------------------\n// AES-based header protection (cipher suites\n// `TLS_AES_128_GCM_SHA256` and `TLS_AES_256_GCM_SHA384`).\n\n/// AES-ECB header protector.  `C` is `aes::Aes128` or\n/// `aes::Aes256`; both implement\n/// [`cipher::BlockEncrypt<BlockSize = U16>`].\npub struct AesHeaderProtector<C> {\n    #[allow(dead_code)] // Phase 4 wires this through to the body.\n    cipher: C,\n}\n\nimpl<C> AesHeaderProtector<C>\nwhere\n    C: KeyInit + BlockEncrypt + Send,\n{\n    /// Construct from a freshly-derived header-protection key.\n    pub fn new(_key: &[u8]) -> Result<Self, Error> {\n        todo!()\n    }\n\n    /// Compute the 16-byte mask from a 16-byte sample.  QUIC\n    /// uses bytes `[0..5]` of the result; the rest are wasted\n    /// but the AES API gives us a full block.\n    pub fn mask(&self, _sample: &[u8; 16]) -> [u8; 16] {\n        todo!()\n    }\n}\n\n// ---------------------------------------------------------------------------\n// ChaCha20-based header protection (cipher suite\n// `TLS_CHACHA20_POLY1305_SHA256`).\n//\n// The header-protection cipher for ChaCha20 suites is plain\n// ChaCha20 (no Poly1305): the first 4 bytes of the sample are\n// the block counter, the next 12 bytes are the nonce, and the\n// \"mask\" is the first 16 bytes of the keystream.\n\n/// ChaCha20 header protector.\npub struct ChaCha20HeaderProtector {\n    #[allow(dead_code)] // Phase 4 wires this through to the body.\n    key: [u8; 32],\n}\n\nimpl ChaCha20HeaderProtector {\n    pub fn new(_key: &[u8]) -> Result<Self, Error> {\n        todo!()\n    }\n\n    pub fn mask(&self, _sample: &[u8; 16]) -> [u8; 16] {\n        todo!()\n    }\n}\n\n// ---------------------------------------------------------------------------\n// `HeaderKey` impls.\n//\n// Each protector implements [`crate::tls::HeaderKey`] so it can\n// be used through the TLS abstraction.  The encrypt / decrypt\n// methods walk the packet header per RFC 9001 §5.4.\n\n/// One direction of AES-based header protection wrapped as a\n/// [`HeaderKey`].\npub struct AesHeaderKey<C> {\n    #[allow(dead_code)]\n    protector: AesHeaderProtector<C>,\n}\n\nimpl<C> AesHeaderKey<C>\nwhere\n    C: KeyInit + BlockEncrypt + Send + 'static,\n{\n    /// Construct an [`AesHeaderKey`] boxed as a `HeaderKey`\n    /// trait object.  Named `boxed` (not `new`) so clippy\n    /// doesn't grumble that `new` should return `Self`.\n    pub fn boxed(key: &[u8]) -> Result<Box<dyn HeaderKey>, Error> {\n        Ok(Box::new(Self {\n            protector: AesHeaderProtector::<C>::new(key)?,\n        }))\n    }\n}\n\nimpl<C> HeaderKey for AesHeaderKey<C>\nwhere\n    C: KeyInit + BlockEncrypt + Send,\n{\n    fn mask(&self, sample: [u8; 16]) -> [u8; 16] {\n        self.protector.mask(&sample)\n    }\n}\n\n/// One direction of ChaCha20-based header protection wrapped\n/// as a [`HeaderKey`].\npub struct ChaCha20HeaderKey {\n    #[allow(dead_code)]\n    protector: ChaCha20HeaderProtector,\n}\n\nimpl ChaCha20HeaderKey {\n    /// Construct a [`ChaCha20HeaderKey`] boxed as a `HeaderKey`\n    /// trait object.\n    pub fn boxed(key: &[u8]) -> Result<Box<dyn HeaderKey>, Error> {\n        Ok(Box::new(Self {\n            protector: ChaCha20HeaderProtector::new(key)?,\n        }))\n    }\n}\n\nimpl HeaderKey for ChaCha20HeaderKey {\n    fn mask(&self, sample: [u8; 16]) -> [u8; 16] {\n        self.protector.mask(&sample)\n    }\n}\n\n#[cfg(test)]\nmod test {}\n","numLines":141,"startLine":1,"totalLines":141}}}
