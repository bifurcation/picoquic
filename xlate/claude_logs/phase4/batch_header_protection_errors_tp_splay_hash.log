igzag(picosplay_node_t *x);\n40\tstatic void splay(picosplay_tree_t *tree, picosplay_node_t *x) {\n41\t    while(1) {\n42\t        picosplay_node_t *p = x->parent;\n43\t        if(p == NULL) {\n44\t            tree->root = x;\n45\t            return;\n46\t        }\n47\t        picosplay_node_t *g = p->parent;\n48\t        if(p->parent == NULL)\n49\t            zig(x);\n50\t        else\n51\t            if((x == p->left && p == g->left) ||\n52\t                    (x == p->right && p == g->right))\n53\t                zigzig(x, p);\n54\t            else\n55\t                zigzag(x);\n56\t    }\n57\t}\n58\t\n59\t/* When p is root, rotate on the edge between x and p.*/\n60\tstatic void zig(picosplay_node_t *x) {\n61\t    rotate(x);\n62\t}\n63\t\n64\t/* When both x and p are left (or both right) children,\n65\t * rotate on edge between p and g, then on edge between x and p.\n66\t */\n67\tstatic void zigzig(picosplay_node_t *x, picosplay_node_t *p) {\n68\t    rotate(p);\n69\t    rotate(x);\n70\t}\n71\t\n72\t/* When one of x and p is a left child and the other a right child,\n73\t * rotate on the edge between x and p, then on the new edge between x and g.\n74\t */\n75\tstatic void zigzag(picosplay_node_t *x) {\n76\t    rotate(x);\n77\t    rotate(x);\n78\t}\n79\t\n80\t/* Initialize an empty tree, storing the picosplay_comparator. */\n81\tvoid picosplay_init_tree(picosplay_tree_t* tree, picosplay_comparator comp, picosplay_create create, picosplay_delete_node delete_node, picosplay_node_value node_value) {\n82\t    tree->comp = comp;\n83\t    tree->create = create;\n84\t    tree->delete_node = delete_node;\n85\t    tree->node_value = node_value;\n86\t    tree->root = NULL;\n87\t    tree->size = 0;\n88\t}\n89\t\n90\t/* Return an empty tree, storing the picosplay_comparator. */\n91\tpicosplay_tree_t* picosplay_new_tree(picosplay_comparator comp, picosplay_create create, picosplay_delete_node delete_node, picosplay_node_value node_value) {\n92\t    picosplay_tree_t *new = m