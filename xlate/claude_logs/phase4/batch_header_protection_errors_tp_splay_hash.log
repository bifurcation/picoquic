   case PICOQUIC_ERROR_HANDSHAKE_TIMEOUT: e_name = \"handshake timeout\"; break;\n103\t    case PICOQUIC_ERROR_SOCKET_ERROR: e_name = \"socket\"; break;\n104\t    case PICOQUIC_ERROR_VERSION_NEGOTIATION: e_name = \"version negotiation\"; break;\n105\t    case PICOQUIC_ERROR_PACKET_TOO_LONG: e_name = \"packet too long\"; break;\n106\t    case PICOQUIC_ERROR_PACKET_WRONG_VERSION: e_name = \"wrong version\"; break;\n107\t    case PICOQUIC_ERROR_PORT_BLOCKED: e_name = \"port blocked\"; break;\n108\t    case PICOQUIC_ERROR_DATAGRAM_TOO_LONG: e_name = \"datagram too long\"; break;\n109\t    case PICOQUIC_ERROR_PATH_ID_INVALID: e_name = \"invalid path ID\"; break;\n110\t    case PICOQUIC_ERROR_RETRY_NEEDED: e_name = \"retry needed\"; break;\n111\t    case PICOQUIC_ERROR_SERVER_BUSY: e_name = \"server busy\"; break;\n112\t    case PICOQUIC_ERROR_PATH_DUPLICATE: e_name = \"duplicate path\"; break;\n113\t    case PICOQUIC_ERROR_PATH_ID_BLOCKED: e_name = \"blocked by lack of path ID\"; break;\n114\t    case PICOQUIC_ERROR_PATH_CID_BLOCKED: e_name = \"blocked by lack of CID\"; break;\n115\t    case PICOQUIC_ERROR_PATH_ADDRESS_FAMILY: e_name = \"path address family\"; break;\n116\t    case PICOQUIC_ERROR_PATH_NOT_READY: e_name = \"path not ready\"; break;\n117\t    case PICOQUIC_ERROR_PATH_LIMIT_EXCEEDED: e_name = \"path limit exceeded\"; break;\n118\t    case PICOQUIC_ERROR_REDIRECTED: e_name = \"redirected to proxy (not an error)\"; break; /* Not an error: the packet was captured by a proxy, no further processing needed */\n119\t    case PICOQUIC_ERROR_PADDING_PACKET: e_name = \"padding_packet\"; break; /* Random bytes at end of datagram */\n120\t    default:\n121\t        if (error_code > 0x100 && error_code < 0x200) {\n122\t            /* Protocol errors defined in the QUIC spec */\n123\t            e_name = \"crypto error alert\";\n124\t        }\n125\t        else if (error_code > 0x400 && error_code < 0x500) {\n126\t            /* Picoquic error codes */\n127\t           