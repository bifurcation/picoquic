        self.textlog_close();\n\n        let Some(path) = textlog_file else {\n            return Ok(());\n        };\n        let path = path.as_ref();\n\n        if path == Path::new(\"-\") {\n            self.f_log = Some(Box::new(std::io::stdout()));\n            self.should_close_log = false;\n        } else {\n            match OpenOptions::new()\n                .write(true)\n                .create(true)\n                .truncate(true)\n                .open(path)\n            {\n                Ok(f) => {\n                    self.f_log = Some(Box::new(f));\n                    self.should_close_log = true;\n                }\n                Err(_) => return Err(Error::MemoryError),\n            }\n        }\n\n        Ok(())\n    }\n\n    /// Close the text log, e.g., when closing the QUIC context.\n    /// Safe to call when no text log is currently installed — the C\n    /// body guards on `quic->F_log != NULL` and on the\n    /// `quic->should_close_log` flag (so an external `stdout`\n    /// handle is left alone).\n    ///\n    /// C: `void picoquic_textlog_close(picoquic_quic_t*)`.\n    pub fn textlog_close(&mut self) {\n        self.f_log = None;\n        self.should_close_log = false;\n    }\n}"},"caller":{"type":"direct"}}],"stop_reason":null,"stop_sequence":null,"stop_details":null,"usage":{"input_tokens":1,"cache_creation_input_tokens":510,"cache_read_input_tokens":71466,"cache_creation":{"ephemeral_5m_input_tokens":0,"ephemeral_1h_input_tokens":510},"output_tokens":8,"service_tier":"standard","inference_geo":"not_available"},"context_management":null},"parent_tool_use_id":null,"session_id":"10159e53-50f7-4a86-9fa2-f9d37dbda0b1","uuid":"6deddea5-0609-43d5-880c-9c747eebae53"}
