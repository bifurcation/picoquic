{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01PchKz15Y8hEapxwhrcWgJj","type":"tool_result","content":"2040\t/**\n2041\t * Sets the output file handle for writing traffic secrets in a format that can\n2042\t * be recognized by Wireshark.\n2043\t */\n2044\tvoid picoquic_set_key_log_file(picoquic_quic_t *quic, char const * keylog_filename)\n2045\t{\n2046\t    PICOQUIC_THREAD_CHECK(quic);\n2047\t    ptls_context_t* ctx = (ptls_context_t*)quic->tls_master_ctx;\n2048\t    struct st_picoquic_log_event_t* log_event = (struct st_picoquic_log_event_t*)ctx->log_event;\n2049\t\n2050\t    if (log_event == NULL) {\n2051\t        log_event = (struct st_picoquic_log_event_t*)malloc(sizeof(struct st_picoquic_log_event_t));\n2052\t        if (log_event != NULL) {\n2053\t            log_event->super.cb = picoquic_log_event_call_back;\n2054\t        }\n2055\t    }\n2056\t    else {\n2057\t        if (log_event->fp != NULL) {\n2058\t            picoquic_file_close(log_event->fp);\n2059\t            log_event->fp = NULL;\n2060\t        }\n2061\t    }\n2062\t\n2063\t    if (log_event != NULL) {\n2064\t        log_event->fp = picoquic_file_open(keylog_filename, \"a\");\n2065\t        log_event->super.cb = picoquic_log_event_call_back;\n2066\t        ctx->log_event = (ptls_log_event_t*)log_event;\n2067\t    }\n2068\t\n2069\t    ctx->log_event = (ptls_log_event_t*)log_event;"}]},"parent_tool_use_id":null,"session_id":"10159e53-50f7-4a86-9fa2-f9d37dbda0b1","uuid":"5b3b05dc-f913-4890-88fe-17294d2a46c4","timestamp":"2026-05-06T11:52:16.474Z","tool_use_result":{"type":"text","file":{"filePath":"/Users/richbarn/Projects/picoquic/picoquic/tls_api.c","content":"/**\n * Sets the output file handle for writing traffic secrets in a format that can\n * be recognized by Wireshark.\n */\nvoid picoquic_set_key_log_file(picoquic_quic_t *quic, char const * keylog_filename)\n{\n    PICOQUIC_THREAD_CHECK(quic);\n    ptls_context_t* ctx = (ptls_context_t*)quic->tls_master_ctx;\n    struct st_picoquic_log_event_t* log_event = (struct st_picoquic_log_event_t*)ctx->log_event;\n\n    if (log_event == NULL) {\n        log_event = (struct st_picoquic_log_event_t*)malloc(sizeof(struct st_picoquic_log_event_t));\n        if (log_event != NULL) {\n            log_event->super.cb = picoquic_log_event_call_back;\n        }\n    }\n    else {\n        if (log_event->fp != NULL) {\n            picoquic_file_close(log_event->fp);\n            log_event->fp = NULL;\n        }\n    }\n\n    if (log_event != NULL) {\n        log_event->fp = picoquic_file_open(keylog_filename, \"a\");\n        log_event->super.cb = picoquic_log_event_call_back;\n        ctx->log_event = (ptls_log_event_t*)log_event;\n    }\n\n    ctx->log_event = (ptls_log_event_t*)log_event;","numLines":30,"startLine":2040,"totalLines":3219}}}
