{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_016qWPmaqT9jtyaxgJQQBjVE","type":"tool_result","content":"2395\t\n2396\t    /// Remove the last entry from the misc-frame queue.\n2397\t    /// C: `picoquic_delete_misc_or_dg(&cnx->first_misc_frame, &cnx->last_misc_frame, cnx->last_misc_frame)`.\n2398\t    pub fn delete_last_misc_frame(&mut self) {\n2399\t        self.misc_frames.pop_back();\n2400\t    }\n2401\t\n2402\t    /// Current simulated (or wall-clock) time from the QUIC context\n2403\t    /// that owns this connection.\n2404\t    /// C: `picoquic_get_quic_time(cnx->quic)`.\n2405\t    pub fn quic_time(&self) -> Instant {\n2406\t        Instant::from_ticks(current_time())\n2407\t    }\n2408\t}\n2409\t\n2410\timpl Quic {\n2411\t    /// Borrow the first connection registered with this context.\n2412\t    pub fn first_connection(&mut self) -> Option<&mut Connection> {\n2413\t        self.connections.iter_mut().next()\n2414\t    }\n2415\t\n2416\t    /// Compute the number of microseconds until *any* connection on\n2417\t    /// this context next needs attention, capped at `delay_max`.\n2418\t    pub fn next_wake_delay(&self, current_time: Instant, delay_max: i64) -> i64 {\n2419\t        let now = current_time.ticks();\n2420\t        // Find the minimum next_wake_time across all connections.\n2421\t        let earliest = self\n2422\t            .connections\n2423\t            .iter()\n2424\t            .map(|c| c.next_wake_time.ticks())\n2425\t            .min();\n2426\t        match earliest {\n2427\t            None => delay_max,\n2428\t            Some(t) if t <= now => 0,\n2429\t            Some(t) => ((t - now) as i64).min(delay_max),"}]},"parent_tool_use_id":null,"session_id":"621e8ef5-6ea2-41f7-92c8-884ed614789d","uuid":"5e764e12-5117-4bf4-8f1e-f53984f5c45f","timestamp":"2026-05-06T12:25:39.885Z","tool_use_result":{"type":"text","file":{"filePath":"/Users/richbarn/Projects/picoquic/rs/fq/src/lib.rs","content":"\n    /// Remove the last