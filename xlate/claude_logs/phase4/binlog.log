{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01YFcYvMYVaKbjZr8xGkmRsT","type":"tool_result","content":"1\t//! Translation of `quic/quic.h`.\n2\t//!\n3\t//! `quic.h` is the kitchen-sink public header for the\n4\t//! quic-core library: it defines the protocol error codes, the\n5\t//! transport-parameter identifiers, the application-facing enums, the\n6\t//! opaque QUIC / connection / path types, the public structs that\n7\t//! cross the API boundary (`TransportParameters`, `PathQuality`,\n8\t//! `PerAckState`, `CongestionAlgorithm`, …)\n9\t//! and the dozens of free functions that make up the application API.\n10\t//!\n11\t//! Phase 4: all function bodies have been filled in.\n12\t//!\n13\t//! Pointer-shape and translation policy notes that apply throughout\n14\t//! this module:\n15\t//!\n16\t//! * `Quic`, `Connection`, `Path` are\n17\t//!   opaque types defined in `internal.h`.  Phase 1 declares\n18\t//!   them as empty structs here so the public API can refer to them;\n19\t//!   the real layout lands when the internal header is translated.\n20\t//! * `struct sockaddr*` parameters and fields map to\n21\t//!   [`core::net::SocketAddr`].  The C source uses tagged unions of\n22\t//!   `sockaddr_in` / `sockaddr_in6`, which `SocketAddr` models\n23\t//!   directly.  Output parameters of type `struct sockaddr_storage*`\n24\t//!   become a `SocketAddr` returned by value.\n25\t//! * Function-pointer typedefs become traits (one trait per typedef\n26\t//!   by default).  Trait grouping is used for the four-function\n27\t//!   `CongestionAlgorithm` vtable, where the C side\n28\t//!   always installs the four together.\n29\t//! * `void*` \"callback context\" arguments are folded into the trait\n30\t//!   implementor's state.  Per-stream / per-path application\n31\t//!   contexts that flow through the stack (e.g. `stream_ctx`,\n32\t//!   `app_stream_ctx`) become `Option<Box<dyn core::any::Any>>` —\n33\t//!   the application produces them, downcasts on retrieval.\n34\t//! * C `int` / `int64_t` return values that encode 0/-1 or 0/error\n35\t//!   status become `Result<T, Error>` — the crate-level `Error` enum\n36\t//!   doesn't exist yet, so `()` is a placeholder per the Phase 1\n37\t//!   contract.  `i32` / `i64` are kept where the C value is a real\n38\t//!   integer (e.g., wake delays in microseconds, interface index).\n39\t//! * Single-bit `unsigned int : 1` bitfields collapse to `bool`.\n40\t//! * `va_list` has no Rust counterpart; the `_v` log helpers are\n41\t//!   omitted in favour of one entry point that takes\n42\t//!   `core::fmt::Arguments<'_>`.\n43\t//! * `extern` global state (`congestion_control_algorithms`)\n44\t//!   becomes accessor functions that hand out a borrowed slice; the\n45\t//!   companion `_nb_` length variable disappears (the slice carries\n46\t//!   its length).\n47\t\n48\t// Many translated functions mirror C signatures with >7 parameters.\n49\t// Builder patterns or shape changes are out of scope for Phase 1.\n50\t#![allow(clippy::too_many_arguments)]\n51\t\n52\tpub mod arena;\n53\tpub mod binlog;\n54\tpub mod bytestream;\n55\tpub mod cc_common;\n56\tpub mod config;\n57\tpub mod crypto;\n58\tpub mod errors;\n59\tpub mod frames;\n60\tpub mod hash;\n61\tpub mod header_protection;\n62\tpub mod internal;\n63\tpub mod lb;\n64\tpub mod logger;\n65\tpub mod packet_loop;\n66\tpub mod performance_log;\n67\tpub mod qlog;\n68\tpub mod siphash;\n69\tpub mod socks;\n70\tpub mod socks_socket2;\n71\tpub mod splay;\n72\tpub mod stream;\n73\tpub mod sys;\n74\t#[cfg(test)]\n75\tpub mod tests;\n76\tpub mod textlog;\n77\tpub mod tls;\n78\tpub mod tls_api;\n79\tpub mod tp;\n80\tpub mod utils;\n81\t\n82\t// Re-export the TP shapes from the public crate root for backwards\n83\t// compatibility with callers that already wrote `crate::TransportParameters`.\n84\tpub use tp::{PreferredAddress, TransportParameter, TransportParameters, VersionNegotiation};\n85\t\n86\tuse core::net::SocketAddr;\n87\t\n88\t// ---------------------------------------------------------------------------\n89\t// Version string and error class.\n90\t//\n91\t// Error values come straight from `#define` and would naturally be\n92\t// untyped in C; in Rust we commit to `u64` because the application\n93\t// API takes them as `uint64_t error_code` parameters and returns\n94\t// them in `get_local_error` etc.\n95\t\n96\t/// Library version string.  C: `VERSION`.\n97\tpub const VERSION: &str = \"1.1.48.0\";\n98\t\n99\t/// Crate-level error type for fallible operations.\n100\t///\n101\t/// Phase 4 implementations return specific variants based on the C\n102\t/// control flow.  The initial variant set covers the broad failure\n103\t/// shapes; additional variants may be added as needed.  Marked\n104\t/// `#[non_exhaustive]` so adding\n105\t/// variants later isn't a breaking change.\n106\t#[derive(Debug, Clone, Copy, PartialEq, Eq)]\n107\t#[non_exhaustive]\n108\tpub enum Error {\n109\t    /// Catch-all placeholder for paths Phase 1 has not yet\n110\t    /// distinguished.  Phase 3 should narrow these.\n111\t    Generic,\n112\t    /// Allocation failed.\n113\t    Memory,\n114\t    /// Caller supplied an invalid argument.\n115\t    InvalidArgument,\n116\t    /// A buffer the caller supplied was too small.\n117\t    BufferTooSmall,\n118\t    /// Caller-supplied file does not exist.\n119\t    NoSuchFile,\n120\t    /// Caller-supplied file was malformed.\n121\t    InvalidFile,\n122\t    /// Connection has been disconnected.\n123\t    Disconnected,\n124\t    /// Connection state didn't permit the requested operation.\n125\t    InvalidState,\n126\t    /// Operation produced or received a malformed QUIC frame.\n127\t    InvalidFrame,\n128\t    /// TLS / crypto error.\n129\t    Tls,\n130\t    /// Other QUIC protocol error; the wrapped value is the\n131\t    /// numeric `ERROR_*` code defined in this module.\n132\t    Protocol(u64),\n133\t}\n134\t\n135\timpl core::fmt::Display for Error {\n136\t    fn fmt(&self, f: &mut core::fmt::Formatter<'_>) -> core::fmt::Result {\n137\t        write!(f, \"{:?}\", self)\n138\t    }\n139\t}\n140\t\n141\timpl core::error::Error for Error {}\n142\t\n143\t/// Crate-wide `Result` alias defaulting the error type to [`Error`].\n144\tpub type Result<T, E = Error> = core::result::Result<T, E>;\n145\t\n146\t/// Wall-clock instant in microseconds since some application-defined\n147\t/// epoch.  Replaces the C `uint64_t current_time` parameter that\n148\t/// threads through every API call needing \"now\".  The type is\n149\t/// `Copy`, supports arithmetic with [`Duration`], and converts to\n150\t/// `u64` cheaply via `.ticks()` when crossing wire boundaries."}]},"parent_tool_use_id":"toolu_016DZDUH2eYQjeMuJdCzNWgY","session_id":"621e8ef5-6ea2-41f7-92c8-884ed614789d","uuid":"d59cc936-ce69-435c-a26e-17e10a9a321a","timestamp":"2026-05-06T12:24:05.185Z"}
