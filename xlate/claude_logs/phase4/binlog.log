{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01BesUrnzWpC1Ay2Q2iMD5jj","type":"tool_result","content":"1378\tpub struct PacketContextState {\n1379\t    pub send_sequence: u64,\n1380\t    pub next_sequence_hole: u64,\n1381\t    pub retransmit_sequence: u64,\n1382\t    pub highest_acknowledged: u64,\n1383\t    pub latest_time_acknowledged: Instant,\n1384\t    pub highest_acknowledged_time: Instant,\n1385\t    /// Packets in flight, keyed by sequence number.  Replaces the\n1386\t    /// C `pending_first/pending_last` doubly-linked list; the map\n1387\t    /// gives O(log N) middle removal on ACK (the dominant op) and\n1388\t    /// O(1) for FIFO drain via `iter`.  Values are\n1389\t    /// [`PacketToken`]s into the connection's `queued_packets`\n1390\t    /// arena.\n1391\t    pub pending: BTreeMap<u64, PacketToken>,\n1392\t    /// Packets that have been retransmitted, keyed by sequence\n1393\t    /// number.  Replaces `retransmitted_newest/oldest`.\n1394\t    pub retransmitted: BTreeMap<u64, PacketToken>,\n1395\t    /// Cursor into `pending` used by the preemptive-repeat scan.\n1396\t    /// `None` when the scan is between passes.\n1397\t    pub preemptive_repeat_seq: Option<u64>,\n1398\t    pub retransmitted_queue_size: u64,\n1399\t    pub ecn_ect0_total_remote: u64,\n1400\t    pub ecn_ect1_total_remote: u64,\n1401\t    pub ecn_ce_total_remote: u64,\n1402\t    pub ack_of_ack_requested: bool,\n1403\t}\n1404\t\n1405\tpub struct AckContextTrack {\n1406\t    pub highest_ack_sent: u64,\n1407\t    pub highest_ack_sent_time: Instant,\n1408\t    pub time_oldest_unack_packet_received: Instant,\n1409\t\n1410\t    pub ack_needed: bool,\n1411\t    pub ack_after_fin: bool,\n1412\t    pub out_of_order_received: bool,\n1413\t    pub is_immediate_ack_required: bool,\n1414\t}\n1415\t\n1416\tpub struct AckContext {\n1417\t    pub sack_list: SackList,\n1418\t    pub time_stamp_largest_received: Instant,\n1419\t    pub act: [AckContextTrack; 2],\n1420\t    pub crypto_rotation_sequence: u64,\n1421\t\n1422\t    pub ecn_ect0_total_local: u64,\n1423\t    pub ecn_ect1_total_local: u64,\n1424\t    pub ecn_ce_total_local: u64,\n1425\t    pub sending_ecn_ack: bool,\n1426\t}\n1427\t\n1428\t// ---------------------------------------------------------------------------\n1429\t// CID state — local and remote.\n1430\t\n1431\tpub struct LocalConnectionId {\n1432\t    /// Membership in `Quic::connection_by_id`.  Phase 4 uses this for\n1433\t    /// O(1) removal when a CID is retired.\n1434\t    pub connection_by_id_membership: Option<HashToken>,\n1435\t    pub path_id: u64,\n1436\t    pub sequence: u64,\n1437\t    pub create_time: Instant,\n1438\t    pub connection_id: ConnectionId,\n1439\t    pub is_acked: bool,\n1440\t}\n1441\t\n1442\tpub struct LocalConnectionIdList {\n1443\t    pub unique_path_id: u64,\n1444\t    pub local_connection_id_sequence_next: u64,\n1445\t    pub local_connection_id_retire_before: u64,\n1446\t    pub local_connection_id_oldest_created: u64,\n1447\t    pub nb_local_connection_id_expired: i32,\n1448\t    pub is_demoted: bool,\n1449\t    pub demotion_time: Instant,\n1450\t    /// Local CIDs registered for this path (replaces the C\n1451\t    /// `local_connection_id_first` head + per-node `next` chain plus the\n1452\t    /// redundant `nb_local_connection_id` count, which is now `len()`).\n1453\t    pub connection_ids: Vec<LocalConnectionIdToken>,\n1454\t}\n1455\t\n1456\tpub struct RemoteConnectionId {\n1457\t    pub sequence: u64,\n1458\t    pub connection_id: ConnectionId,\n1459\t    pub reset_secret: [u8; RESET_SECRET_SIZE],\n1460\t    pub nb_path_references: i32,\n1461\t    pub needs_removal: bool,\n1462\t    pub retire_sent: bool,\n1463\t    pub retire_acked: bool,\n1464\t    pub pkt_ctx: PacketContextState,\n1465\t}\n1466\t\n1467\tpub struct RemoteConnectionIdStash {\n1468\t    pub unique_path_id: u64,\n1469\t    pub retire_connection_id_before: u64,\n1470\t    /// Remote CIDs stashed for this path.  Replaces the C\n1471\t    /// `connection_id_stash_first` head + per-node `next` chain.\n1472\t    pub connection_ids: Vec<RemoteConnectionId>,\n1473\t    pub is_in_use: bool,\n1474\t}\n1475\t\n1476\t// ---------------------------------------------------------------------------\n1477\t// Pacing and tuple/path state.\n1478\t\n1479\tpub struct Pacing {\n1480\t    pub rate: u64,\n1481\t    pub evaluation_time: Instant,\n1482\t    pub bucket_max: i64,\n1483\t    pub packet_time_microsec: Duration,\n1484\t    pub quantum_max: u64,\n1485\t    pub rate_max: u64,\n1486\t    pub bandwidth_pause: i32,\n1487\t    pub bucket_nanosec: i64,\n1488\t    pub packet_time_nanosec: i64,\n1489\t}\n1490\t\n1491\tpub struct Tuple {\n1492\t    pub unique_path_id: u64,\n1493\t    pub peer_addr: SocketAddr,\n1494\t    pub local_addr: SocketAddr,\n1495\t    pub if_index: core::ffi::c_ulong,\n1496\t    pub observed_addr: SocketAddr,\n1497\t    pub remote_connection_id_index: Option<usize>,\n1498\t    pub local_connection_id: Option<LocalConnectionIdToken>,\n1499\t    pub nb_observed_repeat: i32,\n1500\t    pub observed_time: Instant,\n1501\t    pub challenge_response: u64,\n1502\t    pub challenge: [u64; CHALLENGE_REPEAT_MAX],\n1503\t    pub challenge_time: Instant,\n1504\t    pub demotion_time: Instant,\n1505\t    pub challenge_time_first: Instant,\n1506\t    pub is_nat_rebinding: u64,\n1507\t    pub challenge_repeat_count: u8,\n1508\t    pub is_backup: u32,\n1509\t    pub challenge_required: bool,\n1510\t    pub challenge_verified: bool,\n1511\t    pub challenge_failed: bool,\n1512\t    pub response_required: bool,\n1513\t    pub to_preferred_address: bool,\n1514\t}\n1515\t\n1516\tpub struct Path {\n1517\t    pub registered_peer_addr: SocketAddr,\n1518\t    /// Membership in `Quic::connection_by_net`.  Phase 4 uses this for\n1519\t    /// O(1) removal on path teardown / migration.\n1520\t    pub connection_by_net_membership: Option<HashToken>,\n1521\t    pub unique_path_id: u64,\n1522\t    /// Application-supplied state attached to this path.\n1523\t    pub app_path_ctx: Option<Box<dyn Any>>,\n1524\t    pub ack_ctx: AckContext,\n1525\t    pub pkt_ctx: PacketContextState,\n1526\t    /// Tuples (peer-addr × local-addr × if-index) currently bound\n1527\t    /// to this path.  Replaces the C `first_tuple` head + per-node"}]},"parent_tool_use_id":"toolu_016DZDUH2eYQjeMuJdCzNWgY","session_id":"621e8ef5-6ea2-41f7-92c8-884ed614789d","uuid":"83f7eccf-7d40-4df5-bc71-528b53edaeb9","timestamp":"2026-05-06T12:24:09.867Z"}
