(&mut self) {\n269\t        todo!()\n270\t    }\n271\t}\n272\t\n273\t/// Per-connection logging dispatcher.  Bringing this trait into\n274\t/// scope opts a caller into the unified-logging surface; each\n275\t/// method fans the event out to whichever [`Logger`] backends the\n276\t/// QUIC context has installed.  The C names (`picoquic_log_*`) drop\n277\t/// their `log_` prefix here — the trait name carries the verb.\n278\tpub trait Log {\n279\t    /// Append `args` to the connection's text log.  In C this exists\n280\t    /// in two flavours (`picoquic_log_app_message` and a `_v`/\n281\t    /// `va_list` twin); Rust folds them into one entry point — the\n282\t    /// `format_args!` macro at the call site is the variadic\n283\t    /// substitute.\n284\t    ///\n285\t    /// C: `picoquic_log_app_message`.\n286\t    fn app_message(&mut self, args: core::fmt::Arguments<'_>);\n287\t\n288\t    /// Log arrival or departure of a UDP datagram on this\n289\t    /// connection.\n290\t    ///\n291\t    /// C: `picoquic_log_pdu`.\n292\t    fn pdu(\n293\t        &mut self,\n294\t        receiving: bool,\n295\t        current_time: Instant,\n296\t        addr_peer: &SocketAddr,\n297\t        addr_local: &SocketAddr,\n298\t        packet_length: usize,\n299\t        unique_path_id: u64,\n300\t        ecn: u8,\n301\t    );\n302\t\n303\t    /// Log a decrypted packet.  `receiving == true` for an arrival.\n304\t    /// `path_x` is `None` when the path lookup failed (C source\n305\t    /// passes NULL).\n306\t    ///\n307\t    /// C: `picoquic_log_packet`.\n308\t    fn packet(\n309\t        &mut self,\n310\t        path_x: Option<&mut Path>,\n311\t        receiving: bool,\n312\t        current_time: Instant,\n313\t        ph: &PacketHeader,\n314\t        bytes: &[u8],\n315\t    );\n316\t\n317\t    /// Report that a packet was dropped due to some error.  The C\n318\t    /// wrapper takes a `raw_data` buffer that it then ignores\n319\t    /// (`UNUSED(raw_data)`); the parameter is dropped here.\n320\t    ///\n321\t    /// C: `picoquic_log_dropped_packet`.\n322\t    fn dropped_packet(\n323\t        &mut self,\n324\t        path_x: Option<&mut Path>,\n325\t        ph: &PacketHeader,\n326\t        packet_size: usize,\n327\t        err: i32,\n328\t        current_time: Instant,\n329\t    );\n330\t\n331\t    /// Report that a packet was buffered waiting for decryption.\n332\t    ///\n333\t    /// C: `picoquic_log_buffered_packet`.\n334\t    fn buffered_packet(&mut self, path_x: &mut Path, ptype: PacketType, current_time: Instant);\n335\t\n336\t    /// Log that a packet was formatted, ready to be sent.  `bytes`\n337\t    /// is the unencrypted packet (slice length subsumes the C\n338\t    /// `length` parameter); `send_buffer` is the encrypted wire\n339\t    /// form.  `pn_length` is the length of the packet-number field\n340\t    /// within `bytes`.\n341\t    ///\n342\t    /// C: `picoquic_log_outgoing_packet`.\n343\t    fn outgoing_packet(\n344\t        &mut self,\n345\t        path_x: &mut Path,\n346\t        bytes: &[u8],\n347\t        sequence_number: u64,\n348\t        pn_length: usize,\n349\t        send_buffer: &[u8],\n350\t        current_time: Instant,\n351\t    );\n352\t\n353\t    /// Log a packet-lost event.  `dcid` is `None` when the remote\n354\t    /// connection ID is unknown.\n355\t    ///\n356\t    /// C: `picoquic_log_packet_lost`.\n357\t    fn packet_lost(\n358\t        &mut self,\n359\t        path_x: &mut Path,\n360\t        ptype: PacketType,\n361\t        sequence_number: u64,\n362\t        trigger: &str,\n363\t        dcid: Option<&ConnectionId>,\n364\t        packet_size: usize,\n365\t        current_time: Instant,\n366\t    );\n367\t\n368\t    /// Log negotiated SNI/ALPN.  Empty `sni`/`alpn` slices match the\n369\t    /// C callers that pass `(NULL, 0)`.\n370\t    ///\n371\t    /// C: `picoquic_log_negotiated_alpn`.\n372\t    fn negotiated_alpn(&mut self, is_local: bool, sni: &[u8], alpn: &[u8], alpn_list: &[&[u8]]);\n373\t\n374\t    /// Log a transport-extension blob.  `is_local == true` when the\n375\t    /// extension was formatted by the local peer; `false` when it\n376\t    /// was received.\n377\t    ///\n378\t    /// C: `picoquic_log_transport_extension`.\n379\t    fn transport_extension(&mut self, is_local: bool, params: &[u8]);\n380\t\n381\t    /// Log a TLS session ticket.\n382\t    ///\n383\t    /// C: `picoquic_log_tls_ticket`.\n384\t    fn tls_ticket(&mut self, ticket: &[u8]);\n385\t\n386\t    /// Log the start of this connection.\n387\t    ///\n388\t    /// C: `picoquic_log_new_connection`.\n389\t    fn new_connection(&mut self);\n390\t\n391\t    /// Log the end of this connection.\n392\t    ///\n393\t    /// C: `picoquic_log_close_connection`.\n394\t    fn close_connection(&mut self);\n395\t\n396\t    /// Log a snapshot of congestion-control parameters across every\n397\t    /// path on the connection.  Iterates `connection->path[…]`\n398\t    /// internally and dispatches per-path through\n399\t    /// [`Logger::cc_dump`].\n400\t    ///\n401\t    /// C: `picoquic_log_cc_dump`.\n402\t    fn cc_dump(&mut self, current_time: Instant);\n403\t}\n404\t\n405\timpl Log for Connection {\n406\t    fn app_message(&mut self, _args: core::fmt::Arguments<'_>) {\n407\t        todo!()\n408\t    }\n409\t\n410\t    fn pdu(\n411\t        &mut self,\n412\t        _receiving: bool,\n413\t        _current_time: Instant,\n414\t        _addr_peer: &SocketAddr,\n415\t        _addr_local: &SocketAddr,\n416\t        _packet_length: usize,\n417\t        _unique_path_id: u64,\n418\t        _ecn: u8,\n419\t    ) {\n420\t        todo!()\n421\t    }\n422\t\n423\t    fn packet(\n424\t        &mut self,\n425\t        _path_x: Option<&mut Path>,\n426\t        _receiving: bool,\n427\t        _current_time: Instant,\n428\t        _ph: &PacketHeader,\n429\t        _bytes: &[u8],\n430\t    ) {\n431\t        todo!()\n432\t    }\n433\t\n434\t    fn dropped_packet(\n435\t        &mut self,\n436\t        _path_x: Option<&mut Path>,\n437\t        _ph: &PacketHeader,\n438\t        _packet_size: usize,\n439\t        _err: i32,\n440\t        _current_time: Instant,\n441\t    ) {\n442\t        todo!()\n443\t    }\n444\t\n445\t    fn buffered_packet(&mut self, _path_x: &mut Path, _ptype: PacketType, _current_time: Instant) {\n446\t        todo!()\n447\t    }\n448\t\n449\t    fn outgoing_packet(\n450\t        &mut self,\n451\t        _path_x: &mut Path,\n452\t        _bytes: &[u8],\n453\t        _sequence_number: u64,\n454\t        _pn_length: usize,\n455\t        _send_buffer: &[u8],\n456\t        _current_time: Instant,\n457\t    ) {\n458\t        todo!()\n459\t    }\n460\t\n461\t    fn packet_lost(\n462\t        &mut self,\n463\t        _path_x: &mut Path,\n464\t        _ptype: PacketType,\n465\t        _sequence_number: u64,\n466\t        _trigger: &str,\n467\t        _dcid: Option<&ConnectionId>,\n468\t        _packet_size: usize,\n469\t        _current_time: Instant,\n470\t    ) {\n471\t        todo!()\n472\t    }\n473\t\n474\t    fn negotiated_alpn(\n475\t        &mut self,\n476\t        _is_local: bool,\n477\t        _sni: &[u8],\n478\t        _alpn: &[u8],\n479\t        _alpn_list: &[&[u8]],\n480\t    ) {\n481\t        todo!()\n482\t    }\n483\t\n484\t    fn transport_extension(&mut self, _is_local: bool, _params: &[u8]) {\n485\t        todo!()\n486\t    }\n487\t\n488\t    fn tls_ticket(&mut self, _ticket: &[u8]) {\n489\t        todo!()\n490\t    }\n491\t\n492\t    fn new_connection(&mut self) {\n493\t        todo!()\n494\t    }\n495\t\n496\t    fn close_connection(&mut self) {\n497\t        todo!()\n498\t    }\n499\t\n500\t    fn cc_dump(&mut self, _current_time: Instant) {\n501\t        todo!()\n502\t    }\n503\t}\n504\t"}]},"parent_tool_use_id":null,"session_id":"621e8ef5-6ea2-41f7-92c8-884ed614789d","uuid":"5e2caf73-0cc5-4d14-8998-ba19744a271a","timestamp":"2026-05-06T12:26:33.521Z","tool_use_result":{"type":"text","file":{"filePath":"/Users/richbarn/Projects/picoquic/rs/fq/src/logger.rs","content":"//! Translation of `quic/unified_log.h`.\n//!\n//! Logging API.  The quic library can produce three complementary\n//! logs per QUIC context — a textual trace (see [`crate::textlog`]),\n//! a structured binary trace (see [`crate::binlog`]), and a qlog\n//! (see [`crate::qlog`]) — but most applications only enable a\n//! subset.  Each backend is described by a single [`Logger`] trait\n//! object that the application optionally installs on the QUIC\n//! context.  Per-connection dispatch happens through the [`Log`]\n//! trait (implemented on [`Connection`]); per-context dispatch\n//! happens through inherent methods on [`Quic`].  Either layer\n//! fans the event out to whichever backends are registered.\n//!\n//! Phase 1 contract: signatures only — every body is `todo!()`.\n//!\n//! Pointer-shape and translation policy notes for this module:\n//!\n//! * The C `picoquic_unified_logging_t` is a 16-slot vtable.  Per\n//!   the Phase 1 rule \"function pointers map to traits\" we collapse\n//!   the whole vtable into a single trait, [`Logger`],\n//!   because every backend installs all sixteen entries together.\n//!   A QUIC context will eventually hold three optional\n//!   `Box<dyn Logger>` slots (`text_log_fns` / `bin_log_fns`\n//!   / `qlog_fns`); that restructuring lands when `internal.h` is\n//!   translated.\n//! * `Quic*` / `Connection*` — every observed caller passes a non-NULL\n//!   pointer and the logger callbacks may mutate internal state.\n//!   Free functions keyed on `Quic*` become inherent methods on\n//!   [`Quic`]; those keyed on `Connection*` become methods on the\n//!   [`Log`] trait (implemented for [`Connection`]).\n//! * `Path*` — non-NULL for every per-path log event except\n//!   [`Logger::dropped_packet`] and\n//!   [`Logger::packet`], where `packet.c` may pass NULL when\n//!   the path lookup failed.  Those two get `Option<&mut Path>`; the\n//!   rest get `&mut Path`.\n//! * `ConnectionId*` — `dcid` in [`Logger::packet_lost`] is\n//!   nullable per `loss_recovery.c` (the call site explicitly\n//!   substitutes NULL when no remote CID is known); the `cid`\n//!   parameter to [`Logger::quic_app_message`] is always\n//!   non-NULL and read-only.  `Option<&ConnectionId>` and\n//!   `&ConnectionId` respectively.\n//! * `struct sockaddr*` → `&core::net::SocketAddr`, matching the\n//!   convention established in [`crate`].\n//! * `va_list` / variadic — collapsed to [`core::fmt::Arguments`].\n//!   The C `_v` variants disappear: the `format_args!` macro at the\n//!   call site is the Rust substitute for both the variadic and the\n//!   `va_list` flavours.\n//! * `int receiving` / `int is_local` — pure 0/1 flags, promoted to\n//!   `bool`.\n//! * `const uint8_t* + size_t` pairs collapse to `&[u8]`; a NULL\n//!   pointer with len 0 in C maps cleanly to an empty Rust slice.\n//! * `picoquic_log_dropped_packet`'s `raw_data` parameter is\n//!   `UNUSED` in the C wrapper and never reaches the trait, so it is\n//!   dropped from the Rust API entirely.\n\nuse core::net::SocketAddr;\n\nuse crate::Instant;\nuse crate::internal::{PacketHeader, PacketType};\nuse crate::{Connection, ConnectionId, Path, Quic};\n\n// ---------------------------------------------------------------------------\n// Unified-logger vtable.\n//\n// One trait covers all sixteen function-pointer slots of\n// `picoquic_unified_logging_t`.  Every concrete logger (text /\n// binary / qlog) implements the full trait — the C source enforces\n// \"if a logging type is documented, all three functions for that\n// type shall be documented as well\" by convention; the trait\n// requirement makes that explicit.\n//\n// Method names drop the `log_` prefix from the C function-pointer\n// typedefs since the trait name already conveys \"logging\".\n\n/// One installable logging backend.  Each method emits one record\n/// of the named kind into whatever sink the backend owns (text\n/// file, binary trace, qlog).\npub trait Logger {\n    /// Emit a free-form application message routed by a connection-id\n    /// hint rather than a live `Connection` handle.  C:\n    /// `picoquic_log_quic_app_message_fn`.\n    fn quic_app_message(\n        &mut self,\n        quic: &mut Quic,\n        cid: &ConnectionId,\n        args: core::fmt::Arguments<'_>,\n    );\n\n    /// Emit a context-level UDP-datagram arrival or departure for\n    /// an unknown connection.  C: `picoquic_log_quic_pdu_fn`.\n    fn quic_pdu(\n        &mut self,\n        quic: &mut Quic,\n        receiving: bool,\n        current_time: Instant,\n        cid64: u64,\n        addr_peer: &SocketAddr,\n        addr_local: &SocketAddr,\n        packet_length: usize,\n    );\n\n    /// Release any QUIC-context-level resource the backend owns\n    /// (file handles, qlog buffers, …).  Invoked at context\n    /// teardown.  C: `picoquic_log_quic_close`.\n    fn quic_close(&mut self, quic: &mut Quic);\n\n    /// Emit a free-form application message attached to a live\n    /// connection.  C: `picoquic_log_app_message_fn` — the `va_list`\n    /// flavour collapses to [`core::fmt::Arguments`].\n    fn app_message(&mut self, connection: &mut Connection, args: core::fmt::Arguments<'_>);\n\n    /// Emit a per-connection UDP-datagram arrival or departure\n    /// record.  C: `picoquic_log_pdu_fn`.\n    fn pdu(\n        &mut self,\n        connection: &mut Connection,\n        receiving: bool,\n        current_time: Instant,\n        addr_peer: &SocketAddr,\n        addr_local: &SocketAddr,\n        packet_length: usize,\n        unique_path_id: u64,\n        ecn: u8,\n    );\n\n    /// Emit a decrypted-packet record.  `receiving == true` for\n    /// arrivals.  C: `picoquic_log_packet_fn`.\n    fn packet(\n        &mut self,\n        connection: &mut Connection,\n        path_x: Option<&mut Path>,\n        receiving: bool,\n        current_time: Instant,\n        ph: &PacketHeader,\n        bytes: &[u8],\n    );\n\n    /// Emit a record that the packet was dropped due to some error.\n    /// C: `picoquic_log_dropped_packet_fn`.\n    fn dropped_packet(\n        &mut self,\n        connection: &mut Connection,\n        path_x: Option<&mut Path>,\n        ph: &PacketHeader,\n        packet_size: usize,\n        err: i32,\n        current_time: Instant,\n    );\n\n    /// Emit a record that the packet was buffered waiting for\n    /// decryption.  C: `picoquic_log_buffered_packet_fn`.\n    fn buffered_packet(\n        &mut self,\n        connection: &mut Connection,\n        path_x: &mut Path,\n        ptype: PacketType,\n        current_time: Instant,\n    );\n\n    /// Emit a record that a packet was formatted, ready to be sent.\n    /// `bytes` is the unencrypted form (length carried in the\n    /// slice); `send_buffer` is the encrypted-and-padded wire form.\n    /// `pn_length` is the length of the packet-number field within\n    /// `bytes`.  C: `picoquic_log_outgoing_packet_fn`.\n    fn outgoing_packet(\n        &mut self,\n        connection: &mut Connection,\n        path_x: &mut Path,\n        bytes: &[u8],\n        sequence_number: u64,\n        pn_length: usize,\n        send_buffer: &[u8],\n        current_time: Instant,\n    );\n\n    /// Emit a packet-lost record.  `dcid` may be `None` when the\n    /// remote connection ID is not known at the time of detection.\n    /// C: `picoquic_log_packet_lost_fn`.\n    fn packet_lost(\n        &mut self,\n        connection: &mut Connection,\n        path_x: &mut Path,\n        ptype: PacketType,\n        sequence_number: u64,\n        trigger: &str,\n        dcid: Option<&ConnectionId>,\n        packet_size: usize,\n        current_time: Instant,\n    );\n\n    /// Emit a negotiated-ALPN record.  Empty `sni` / `alpn` slices\n    /// stand in for the C `(NULL, 0)` callers.  C:\n    /// `picoquic_log_negotiated_alpn_fn`.\n    fn negotiated_alpn(\n        &mut self,\n        connection: &mut Connection,\n        is_local: bool,\n        sni: &[u8],\n        alpn: &[u8