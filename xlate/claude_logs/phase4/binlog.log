{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01Uc6TULLaCdHyhKUY3bQn1Q","type":"tool_result","content":"1\t//! QUIC frame types and (eventually) frame encode/decode logic.\n2\t\n3\t/// QUIC frame-type tags.\n4\t///\n5\t/// Wire values exceed `u32` for some extension frame types, hence\n6\t/// the `#[repr(u64)]`.  `StreamRangeMin`/`StreamRangeMax` mark the\n7\t/// inclusive bounds of the eight-variant STREAM frame block\n8\t/// (0x08-0x0f); the bit-flag-encoded variants in between aren't\n9\t/// individually named.\n10\t#[derive(Debug, Copy, Clone, PartialEq, Eq)]\n11\t#[repr(u64)]\n12\tpub enum FrameType {\n13\t    Padding = 0,\n14\t    Ping = 1,\n15\t    Ack = 0x02,\n16\t    AckEcn = 0x03,\n17\t    ResetStream = 0x04,\n18\t    StopSending = 0x05,\n19\t    CryptoHs = 0x06,\n20\t    NewToken = 0x07,\n21\t    StreamRangeMin = 0x08,\n22\t    StreamRangeMax = 0x0f,\n23\t    MaxData = 0x10,\n24\t    MaxStreamData = 0x11,\n25\t    MaxStreamsBidir = 0x12,\n26\t    MaxStreamsUnidir = 0x13,\n27\t    DataBlocked = 0x14,\n28\t    StreamDataBlocked = 0x15,\n29\t    StreamsBlockedBidir = 0x16,\n30\t    StreamsBlockedUnidir = 0x17,\n31\t    NewConnectionId = 0x18,\n32\t    RetireConnectionId = 0x19,\n33\t    PathChallenge = 0x1a,\n34\t    PathResponse = 0x1b,\n35\t    ConnectionClose = 0x1c,\n36\t    ApplicationClose = 0x1d,\n37\t    HandshakeDone = 0x1e,\n38\t    ImmediateAck = 0x1F,\n39\t    ResetStreamAt = 0x24,\n40\t    Datagram = 0x30,\n41\t    DatagramL = 0x31,\n42\t    PathAck = 0x3e,\n43\t    PathAckEcn = 0x3f,\n44\t    AckFrequency = 0xAF,\n45\t    TimeStamp = 757,\n46\t    PathAbandon = 0x3e75,\n47\t    PathBackup = 0x3e76,\n48\t    PathAvailable = 0x3e77,\n49\t    PathNewConnectionId = 0x3e78,\n50\t    PathRetireConnectionId = 0x3e79,\n51\t    MaxPathId = 0x3e7a,\n52\t    PathsBlocked = 0x3e7b,\n53\t    PathCidBlocked = 0x3e7c,\n54\t    Bdp = 0xebd9,\n55\t    ObservedAddressV4 = 0x9f81a6,\n56\t    ObservedAddressV6 = 0x9f81a7,\n57\t}\n58\t\n59\timpl FrameType {\n60\t    /// Textual name for `frame_type`, taking a raw `u64` so callers\n61\t    /// can pass extension or unknown wire values too.  C:\n62\t    /// `frame_name`.\n63\t    pub fn name(frame_type: u64) -> Option<&'static str> {\n64\t        if frame_type >= FrameType::StreamRangeMin as u64\n65\t            && frame_type <= FrameType::StreamRangeMax as u64\n66\t        {\n67\t            return Some(\"stream\");\n68\t        }\n69\t        match frame_type {\n70\t            0x00 => Some(\"padding\"),\n71\t            0x01 => Some(\"ping\"),\n72\t            0x02 | 0x03 => Some(\"ack\"),\n73\t            0x04 => Some(\"reset_stream\"),\n74\t            0x05 => Some(\"stop_sending\"),\n75\t            0x06 => Some(\"crypto\"),\n76\t            0x07 => Some(\"new_token\"),\n77\t            0x10 => Some(\"max_data\"),\n78\t            0x11 => Some(\"max_stream_data\"),\n79\t            0x12 | 0x13 => Some(\"max_streams\"),\n80\t            0x14 => Some(\"data_blocked\"),\n81\t            0x15 => Some(\"stream_data_blocked\"),\n82\t            0x16 | 0x17 => Some(\"streams_blocked\"),\n83\t            0x18 => Some(\"new_connection_id\"),\n84\t            0x19 => Some(\"retire_connection_id\"),\n85\t            0x1a => Some(\"path_challenge\"),\n86\t            0x1b => Some(\"path_response\"),\n87\t            0x1c | 0x1d => Some(\"connection_close\"),\n88\t            0x1e => Some(\"handshake_done\"),\n89\t            0x1f => Some(\"immediate_ack\"),\n90\t            0x24 => Some(\"reset_stream_at\"),\n91\t            0x30 | 0x31 => Some(\"datagram\"),\n92\t            0x3e | 0x3f => Some(\"path_ack\"),\n93\t            0xaf => Some(\"ack_frequency\"),\n94\t            757 => Some(\"time_stamp\"),\n95\t            0x3e75 => Some(\"path_abandon\"),\n96\t            0x3e76 => Some(\"path_backup\"),\n97\t            0x3e77 => Some(\"path_available\"),\n98\t            0x3e78 => Some(\"path_new_connection_id\"),\n99\t            0x3e79 => Some(\"path_retire_connection_id\"),\n100\t            0x3e7a => Some(\"max_path_id\"),\n101\t            0x3e7b => Some(\"paths_blocked\"),\n102\t            0x3e7c => Some(\"path_cid_blocked\"),\n103\t            0xebd9 => Some(\"bdp\"),\n104\t            0x9f81a6 => Some(\"observed_address_v4\"),\n105\t            0x9f81a7 => Some(\"observed_address_v6\"),\n106\t            _ => None,\n107\t        }\n108\t    }\n109\t}\n110\t\n111\t#[cfg(test)]\n112\tmod test {}\n113\t"}]},"parent_tool_use_id":null,"session_id":"621e8ef5-6ea2-41f7-92c8-884ed614789d","uuid":"6aa46c90-a635-4b7c-a367-36e457fd950e","timestamp":"2026-05-06T12:26:29.848Z","tool_use_result":{"type":"text","file":{"filePath":"/Users/richbarn/Projects/picoquic/rs/fq/src/frames.rs","content":"//! QUIC frame types and (eventually) frame encode/decode logic.\n\n/// QUIC frame-type tags.\n///\n/// Wire values exceed `u32` for some extension frame types, hence\n/// the `#[repr(u64)]`.  `StreamRangeMin`/`StreamRangeMax` mark the\n/// inclusive bounds of the eight-variant STREAM frame block\n/// (0x08-0x0f); the bit-flag-encoded variants in between aren't\n/// individually named.\n#[derive(Debug, Copy, Clone, PartialEq, Eq)]\n#[repr(u64)]\npub enum FrameType {\n    Padding = 0,\n    Ping = 1,\n    Ack = 0x02,\n    AckEcn = 0x03,\n    ResetStream = 0x04,\n    StopSending = 0x05,\n    CryptoHs = 0x06,\n    NewToken = 0x07,\n    StreamRangeMin = 0x08,\n    StreamRangeMax = 0x0f,\n    MaxData = 0x10,\n    MaxStreamData = 0x11,\n    MaxStreamsBidir = 0x12,\n    MaxStreamsUnidir = 0x13,\n    DataBlocked = 0x14,\n    StreamDataBlocked = 0x15,\n    StreamsBlockedBidir = 0x16,\n    StreamsBlockedUnidir = 0x17,\n    NewConnectionId = 0x18,\n    RetireConnectionId = 0x19,\n    PathChallenge = 0x1a,\n    PathResponse = 0x1b,\n    ConnectionClose = 0x1c,\n    ApplicationClose = 0x1d,\n    HandshakeDone = 0x1e,\n    ImmediateAck = 0x1F,\n    ResetStreamAt = 0x24,\n    Datagram = 0x30,\n    DatagramL = 0x31,\n    PathAck = 0x3e,\n    PathAckEcn = 0x3f,\n    AckFrequency = 0xAF,\n    TimeStamp = 757,\n    PathAbandon = 0x3e75,\n    PathBackup = 0x3e76,\n    PathAvailable = 0x3e77,\n    PathNewConnectionId = 0x3e78,\n    PathRetireConnectionId = 0x3e79,\n    MaxPathId = 0x3e7a,\n    PathsBlocked = 0x3e7b,\n    PathCidBlocked = 0x3e7c,\n    Bdp = 0xebd9,\n    ObservedAddressV4 = 0x9f81a6,\n    ObservedAddressV6 = 0x9f81a7,\n}\n\nimpl FrameType {\n    /// Textual name for `frame_type`, taking a raw `u64` so callers\n    /// can pass extension or unknown wire values too.  C:\n    /// `frame_name`.\n    pub fn name(frame_type: u64) -> Option<&'static str> {\n        if frame_type >= FrameType::StreamRangeMin as u64\n            && frame_type <= FrameType::StreamRangeMax as u64\n        {\n            return Some(\"stream\");\n        }\n        match frame_type {\n            0x00 => Some(\"padding\"),\n            0x01 => Some(\"ping\"),\n            0x02 | 0x03 => Some(\"ack\"),\n            0x04 => Some(\"reset_stream\"),\n            0x05 => Some(\"stop_sending\"),\n            0x06 => Some(\"crypto\"),\n            0x07 => Some(\"new_token\"),\n            0x10 => Some(\"max_data\"),\n            0x11 => Some(\"max_stream_data\"),\n            0x12 | 0x13 => Some(\"max_streams\"),\n            0x14 => Some(\"data_blocked\"),\n            0x15 => Some(\"stream_data_blocked\"),\n            0x16 | 0x17 => Some(\"streams_blocked\"),\n            0x18 => Some(\"new_connection_id\"),\n            0x19 => Some(\"retire_connection_id\"),\n            0x1a => Some(\"path_challenge\"),\n            0x1b => Some(\"path_response\"),\n            0x1c | 0x1d => Some(\"connection_close\"),\n            0x1e => Some(\"handshake_done\"),\n            0x1f => Some(\"immediate_ack\"),\n            0x24 => Some(\"reset_stream_at\"),\n            0x30 | 0x31 => Some(\"datagram\"),\n            0x3e | 0x3f => Some(\"path_ack\"),\n            0xaf => Some(\"ack_frequency\"),\n            757 => Some(\"time_stamp\"),\n            0x3e75 => Some(\"path_abandon\"),\n            0x3e76 => Some(\"path_backup\"),\n            0x3e77 => Some(\"path_available\"),\n            0x3e78 => Some(\"path_new_connection_id\"),\n            0x3e79 => Some(\"path_retire_connection_id\"),\n            0x3e7a => Some(\"max_path_id\"),\n            0x3e7b => Some(\"paths_blocked\"),\n            0x3e7c => Some(\"path_cid_blocked\"),\n            0xebd9 => Some(\"bdp\"),\n            0x9f81a6 => Some(\"observed_address_v4\"),\n            0x9f81a7 => Some(\"observed_address_v6\"),\n            _ => None,\n        }\n    }\n}\n\n#[cfg(test)]\nmod test {}\n","numLines":113,"startLine":1,"totalLines":113}}}
