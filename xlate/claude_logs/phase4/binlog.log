{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01XCV8jYhTcYPvnRLikn8Lsi","type":"tool_result","content":"1\t//! Translation of `quic/logger.h`.\n2\t//!\n3\t//! Public surface of the quic *text* logger backend.  Once a text\n4\t//! log file is installed on a [`Quic`] context, the context's\n5\t//! text-log slot points at the textlog implementation of\n6\t//! [`crate::logger::Logger`] and every per-event log\n7\t//! call fans out through that vtable.  The install/teardown entry\n8\t//! points hang as inherent methods on [`Quic`]\n9\t//! ([`Quic::set_textlog`] / [`Quic::textlog_close`]).\n10\t//!\n11\t//! Pointer-shape and translation policy notes for this module:\n12\t//!\n13\t//! * `Quic*` — every observed caller (`config.c::963`,\n14\t//!   the recursive call in `logger.c::set_textlog`) passes\n15\t//!   a non-NULL, mutable context handle.  Maps to `&mut\n16\t//!   Quic`.\n17\t//! * `char const* textlog_file` — the C contract uses `NULL` as the\n18\t//!   \"stop the text log\" sentinel, so the parameter maps to\n19\t//!   `Option<&str>`.  `Some(\"-\")` is the established\n20\t//!   redirect-to-stdout shortcut and is preserved as-is.\n21\t//! * The C return is `int` (0 on success, `-1` on file-open\n22\t//!   failure).  Mapped to `Result<(), Error>` per the project's\n23\t//!   error-handling convention.\n24\t//! * `picoquic_textlog_picotls_ticket` was the textlog backend's\n25\t//!   TLS-ticket pretty-printer.  Phase 4 reintroduces it as a\n26\t//!   private helper inside the textlog `Logger` impl; no public\n27\t//!   API needs it.\n28\t//! * `picoquic_log_fin_or_event_name` is declared in the C header\n29\t//!   but never defined or referenced — dropped from the Rust API.\n30\t\n31\tuse std::fs::OpenOptions;\n32\tuse std::path::Path;\n33\t\n34\tuse crate::Error;\n35\tuse crate::Quic;\n36\t\n37\timpl Quic {\n38\t    /// Set the text log file and start tracing into it.\n39\t    ///\n40\t    /// Pass `None` to stop the text log (the C \"set to NULL\"\n41\t    /// sentinel).  `Some(\"-\")` redirects output to stdout without\n42\t    /// taking ownership of the handle, matching the C body in\n43\t    /// `logger.c::set_textlog`.\n44\t    ///\n45\t    /// C: `int picoquic_set_textlog(picoquic_quic_t*, char const*)`.\n46\t    pub fn set_textlog(\n47\t        &mut self,\n48\t        textlog_file: Option<&(impl AsRef<Path> + ?Sized)>,\n49\t    ) -> Result<(), Error> {\n50\t        self.textlog_close();\n51\t\n52\t        let Some(path) = textlog_file else {\n53\t            return Ok(());\n54\t        };\n55\t        let path = path.as_ref();\n56\t\n57\t        if path == Path::new(\"-\") {\n58\t            self.f_log = Some(Box::new(std::io::stdout()));\n59\t            self.should_close_log = false;\n60\t        } else {\n61\t            match OpenOptions::new()\n62\t                .write(true)\n63\t                .create(true)\n64\t                .truncate(true)\n65\t                .open(path)\n66\t            {\n67\t                Ok(f) => {\n68\t                    self.f_log = Some(Box::new(f));\n69\t                    self.should_close_log = true;\n70\t                }\n71\t                Err(_) => return Err(Error::NoSuchFile),\n72\t            }\n73\t        }\n74\t\n75\t        Ok(())\n76\t    }\n77\t\n78\t    /// Close the text log, e.g., when closing the QUIC context.\n79\t    /// Safe to call when no text log is currently installed — the C\n80\t    /// body guards on `quic->F_log != NULL` and on the\n81\t    /// `quic->should_close_log` flag (so an external `stdout`\n82\t    /// handle is left alone).\n83\t    ///\n84\t    /// C: `void picoquic_textlog_close(picoquic_quic_t*)`.\n85\t    pub fn textlog_close(&mut self) {\n86\t        self.f_log = None;\n87\t        self.should_close_log = false;\n88\t    }\n89\t}\n90\t\n91\t#[cfg(test)]\n92\tmod test {}\n93\t"}]},"parent_tool_use_id":null,"session_id":"621e8ef5-6ea2-41f7-92c8-884ed614789d","uuid":"8d4cd1ce-5e9b-4773-ac5d-21c519763150","timestamp":"2026-05-06T12:27:36.342Z","tool_use_result":{"type":"text","file":{"filePath":"/Users/richbarn/Projects/picoquic/rs/fq/src/textlog.rs","content":"//! Translation of `quic/logger.h`.\n//!\n//! Public surface of the quic *text* logger backend.  Once a text\n//! log file is installed on a [`Quic`] context, the context's\n//! text-log slot points at the textlog implementation of\n//! [`crate::logger::Logger`] and every per-event log\n//! call fans out through that vtable.  The install/teardown entry\n//! points hang as inherent methods on [`Quic`]\n//! ([`Quic::set_textlog`] / [`Quic::textlog_close`]).\n//!\n//! Pointer-shape and translation policy notes for this module:\n//!\n//! * `Quic*` — every observed caller (`config.c::963`,\n//!   the recursive call in `logger.c::set_textlog`) passes\n//!   a non-NULL, mutable context handle.  Maps to `&mut\n//!   Quic`.\n//! * `char const* textlog_file` — the C contract uses `NULL` as the\n//!   \"stop the text log\" sentinel, so the parameter maps to\n//!   `Option<&str>`.  `Some(\"-\")` is the established\n//!   redirect-to-stdout shortcut and is preserved as-is.\n//! * The C return is `int` (0 on success, `-1` on file-open\n//!   failure).  Mapped to `Result<(), Error>` per the project's\n//!   error-handling convention.\n//! * `picoquic_textlog_picotls_ticket` was the textlog backend's\n//!   TLS-ticket pretty-printer.  Phase 4 reintroduces it as a\n//!   private helper inside the textlog `Logger` impl; no public\n//!   API needs it.\n//! * `picoquic_log_fin_or_event_name` is declared in the C header\n//!   but never defined or referenced — dropped from the Rust API.\n\nuse std::fs::OpenOptions;\nuse std::path::Path;\n\nuse crate::Error;\nuse crate::Quic;\n\nimpl Quic {\n    /// Set the text log file and start tracing into it.\n    ///\n    /// Pass `None` to stop the text log (the C \"set to NULL\"\n    /// sentinel).  `Some(\"-\")` redirects output to stdout without\n    /// taking ownership of the handle, matching the C body in\n    /// `logger.c::set_textlog`.\n    ///\n    /// C: `int picoquic_set_textlog(picoquic_quic_t*, char const*)`.\n    pub fn set_textlog(\n        &mut self,\n        textlog_file: Option<&(impl AsRef<Path> + ?Sized)>,\n    ) -> Result<(), Error> {\n        self.textlog_close();\n\n        let Some(path) = textlog_file else {\n            return Ok(());\n        };\n        let path = path.as_ref();\n\n        if path == Path::new(\"-\") {\n            self.f_log = Some(Box::new(std::io::stdout()));\n            self.should_close_log = false;\n        } else {\n            match OpenOptions::new()\n                .write(true)\n                .create(true)\n                .truncate(true)\n                .open(path)\n            {\n                Ok(f) => {\n                    self.f_log = Some(Box::new(f));\n                    self.should_close_log = true;\n                }\n                Err(_) => return Err(Error::NoSuchFile),\n            }\n        }\n\n        Ok(())\n    }\n\n    /// Close the text log, e.g., when closing the QUIC context.\n    /// Safe to call when no text log is currently installed — the C\n    /// body guards on `quic->F_log != NULL` and on the\n    /// `quic->should_close_log` flag (so an external `stdout`\n    /// handle is left alone).\n    ///\n    /// C: `void picoquic_textlog_close(picoquic_quic_t*)`.\n    pub fn textlog_close(&mut self) {\n        self.f_log = None;\n        self.should_close_log = false;\n    }\n}\n\n#[cfg(test)]\nmod test {}\n","numLines":93,"startLine":1,"totalLines":93}}}
