{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01K7gLfaWLjjeft7AMF1omiL","type":"tool_result","content":"1\t//! Translation of `quic/qlog.h` plus the qlog encoding helpers\n2\t//! mirrored from `loglib/qlog.c` and `loglib/qlog_frames.c`.\n3\t//!\n4\t//! The C library splits qlog into two layers: the public hook\n5\t//! `picoquic_set_qlog` that turns on per-connection qlog writers\n6\t//! (the unified-logging vtable in `loglib/qlog_fns.c`), and a body\n7\t//! of pure formatting helpers that JSON-encode bytestreams into a\n8\t//! qlog file.  This module exposes both: the [`Quic::set_qlog`]\n9\t//! entry point stores the directory on the context, and the free\n10\t//! functions below implement the byte-stream formatters that the\n11\t//! `qlog_error_test` suite exercises directly.\n12\t\n13\tuse std::io::Write;\n14\tuse std::path::{Path, PathBuf};\n15\t\n16\tuse crate::frames::FrameType;\n17\tuse crate::internal::{frames_varint_decode, varint_decode};\n18\tuse crate::tp::TransportParameter;\n19\tuse crate::{Error, Quic, Result};\n20\t\n21\timpl Quic {\n22\t    /// Enable qlog tracing on this context, writing one qlog file per\n23\t    /// connection into `qlog_dir`.  Installs the unified-logging\n24\t    /// vtable; subsequent connections on this context will stream\n25\t    /// qlog records until the context is dropped.\n26\t    ///\n27\t    /// Both observed call sites guard on the directory being set\n28\t    /// before calling, so the parameter is borrowed (no\n29\t    /// `Option<…>`); the C `int` status (0 / -1) becomes\n30\t    /// `Result<()>`.\n31\t    ///\n32\t    /// C: `int set_qlog(Quic*, char const*)`.\n33\t    pub fn set_qlog(&mut self, qlog_dir: &(impl AsRef<Path> + ?Sized)) -> Result<()> {\n34\t        // C: quic->qlog_fns = &qlog_fns; quic->qlog_dir = strdup(qlog_dir).\n35\t        // The vtable install lives in `loglib/qlog_fns.c` (out of v1\n36\t        // scope); store the directory so connections that look at\n37\t        // `quic->qlog_dir` for the autoqlog filename find it.\n38\t        self.qlog_dir = Some(PathBuf::from(qlog_dir.as_ref()));\n39\t        Ok(())\n40\t    }\n41\t}\n42\t\n43\t// ---------------------------------------------------------------------------\n44\t// Internal qlog encoding helpers (used by qlog_error_test).\n45\t\n46\tfn io<W: Write>(out: &mut W, args: core::fmt::Arguments<'_>) -> Result<()> {\n47\t    out.write_fmt(args).map_err(|_| Error::Generic)\n48\t}\n49\t\n50\t/// Write a QLOG-escaped string of `l` bytes from `s`.  Returns `Err` when\n51\t/// the stream had fewer bytes available than `l` (truncation).\n52\t/// C: `qlog_string` in `loglib/qlog.c`.\n53\tpub fn qlog_string<W: Write>(out: &mut W, s: &[u8], l: usize) -> Result<()> {\n54\t    let error_found = l > s.len();\n55\t    let avail = s.len().min(l);\n56\t    io(out, format_args!(\"\\\"\"))?;\n57\t    for &b in &s[..avail] {\n58\t        io(out, format_args!(\"{:02x}\", b))?;\n59\t    }\n60\t    if error_found {\n61\t        io(out, format_args!(\"... coding error!\"))?;\n62\t    }\n63\t    io(out, format_args!(\"\\\"\"))?;\n64\t    if error_found {\n65\t        Err(Error::InvalidFrame)\n66\t    } else {\n67\t        Ok(())\n68\t    }\n69\t}\n70\t\n71\t/// Write printable-ASCII QLOG characters from `s` up to `l` bytes.  Returns\n72\t/// `Err` when the stream had fewer bytes than `l`.\n73\t/// C: `qlog_chars` in `loglib/qlog.c`.\n74\tpub fn qlog_chars<W: Write>(out: &mut W, s: &[u8], l: usize) -> Result<()> {\n75\t    let error_found = l > s.len();\n76\t    let avail = s.len().min(l);\n77\t    io(out, format_args!(\"\\\"\"))?;\n78\t    for &c in &s[..avail] {\n79\t        if c == b'\"' || c == b'\\\\' {\n80\t            io(out, format_args!(\"\\\\{}\", c as char))?;\n81\t        } else if (b' '..127).contains(&c) {\n82\t            io(out, format_args!(\"{}\", c as char))?;\n83\t        } else {\n84\t            io(out, format_args!(\"\\\\{:02x}\", c))?;\n85\t        }\n86\t    }\n87\t    if error