Replaces\n971\t    /// the C `register_crypto_random_provider` global registry plus\n972\t    /// `Connection::crypto_random` / `crypto_uniform_random` /\n973\t    /// `seed_public_random` accessors.  Used for handshake nonces,\n974\t    /// connection IDs, retry-token integrity nonces, and so on.\n975\t    /// The application installs this at construction time;\n976\t    /// `rand::rngs::OsRng` (wrapped in a `Box`) is the canonical\n977\t    /// default.  Phase 4 may push it down to per-`Connection` if\n978\t    /// per-connection determinism is needed for tests.\n979\t    pub rng: Box<dyn rand::CryptoRng + Send>,\n980\t    pub hash_seed: [u8; 16],\n981\t    pub ticket_file_name: Option<PathBuf>,\n982\t    pub token_file_name: Option<PathBuf>,\n983\t    /// Cached session tickets (replaces the C `p_first_ticket`\n984\t    /// head + per-node `next_ticket` chain).\n985\t    pub stored_tickets: Vec<StoredTicket>,\n986\t    /// Cached retry tokens (replaces the C `p_first_token`\n987\t    /// head + per-node `next_token` chain).\n988\t    pub stored_tokens: Vec<StoredToken>,\n989\t    /// Replay-protection register for new-tokens / retry-tokens.\n990\t    /// Keyed by `token_hash`; values are tokens into the\n991\t    /// per-`Quic` `RegisteredToken` arena.  C: `token_reuse_tree`.\n992\t    pub token_reuse_tree: SplayTree<u64, RegisteredTokenToken>,\n993\t    /// Owning arena for [`RegisteredToken`] entries reachable\n994\t    /// through [`Self::token_reuse_tree`].\n995\t    pub registered_tokens: Arena<RegisteredToken>,\n996\t    pub local_connection_id_length: u8,\n997\t    pub default_stream_priority: u8,\n998\t    pub default_datagram_priority: u8,\n999\t    pub local_connection_id_ttl: u64,\n1000\t    pub mtu_max: u32,\n1001\t    pub padding_multiple_default: u32,\n1002\t    pub padding_minsize_default: u32,\n1003\t    pub sequence_hole_pseudo_period: u32,\n1004\t    pub default_pmtud_policy: PmtudPolicy,\n1005\t    pub default_spin_policy: SpinbitVersion,\n1006