{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_011xJQkhc1Wcko6FisTeur2t","type":"tool_result","content":"1\t//! QUIC frame types and (eventually) frame encode/decode logic.\n2\t\n3\t/// QUIC frame-type tags.\n4\t///\n5\t/// Wire values exceed `u32` for some extension frame types, hence\n6\t/// the `#[repr(u64)]`.  `StreamRangeMin`/`StreamRangeMax` mark the\n7\t/// inclusive bounds of the eight-variant STREAM frame block\n8\t/// (0x08-0x0f); the bit-flag-encoded variants in between aren't\n9\t/// individually named.\n10\t#[derive(Debug, Copy, Clone, PartialEq, Eq)]\n11\t#[repr(u64)]\n12\tpub enum FrameType {\n13\t    Padding = 0,\n14\t    Ping = 1,\n15\t    Ack = 0x02,\n16\t    AckEcn = 0x03,\n17\t    ResetStream = 0x04,\n18\t    StopSending = 0x05,\n19\t    CryptoHs = 0x06,\n20\t    NewToken = 0x07,\n21\t    StreamRangeMin = 0x08,\n22\t    StreamRangeMax = 0x0f,\n23\t    MaxData = 0x10,\n24\t    MaxStreamData = 0x11,\n25\t    MaxStreamsBidir = 0x12,\n26\t    MaxStreamsUnidir = 0x13,\n27\t    DataBlocked = 0x14,\n28\t    StreamDataBlocked = 0x15,\n29\t    StreamsBlockedBidir = 0x16,\n30\t    StreamsBlockedUnidir = 0x17,\n31\t    NewConnectionId = 0x18,\n32\t    RetireConnectionId = 0x19,\n33\t    PathChallenge = 0x1a,\n34\t    PathResponse = 0x1b,\n35\t    ConnectionClose = 0x1c,\n36\t    ApplicationClose = 0x1d,\n37\t    HandshakeDone = 0x1e,\n38\t    ImmediateAck = 0x1F,\n39\t    ResetStreamAt = 0x24,\n40\t    Datagram = 0x30,\n41\t    DatagramL = 0x31,\n42\t    PathAck = 0x3e,\n43\t    PathAckEcn = 0x3f,\n44\t    AckFrequency = 0xAF,\n45\t    TimeStamp = 757,\n46\t    PathAbandon = 0x3e75,\n47\t    PathBackup = 0x3e76,\n48\t    PathAvailable = 0x3e77,\n49\t    PathNewConnectionId = 0x3e78,\n50\t    PathRetireConnectionId = 0x3e79,\n51\t    MaxPathId = 0x3e7a,\n52\t    PathsBlocked = 0x3e7b,\n53\t    PathCidBlocked = 0x3e7c,\n54\t    Bdp = 0xebd9,\n55\t    ObservedAddressV4 = 0x9f81a6,\n56\t    ObservedAddressV6 = 0x9f81a7,\n57\t}\n58\t\n59\timpl FrameType {\n60\t    /// Textual name for `frame_type`, taking a raw `u64` so callers\n61\t    /// can pass extension or unknown wire values too.  C:\n62\t    /// `frame_name`.\n63\t    pub fn name(frame_type: u64) -> Option<&'static str> {\n64\t        if frame_type >= FrameType::StreamRangeMin as u64\n65\t            && frame_type <= FrameType::StreamRangeMax as u64\n66\t        {\n67\t            return Some(\"stream\");\n68\t        }\n69\t        match frame_type {\n70\t            0x00 => Some(\"padding\"),\n71\t            0x01 => Some(\"ping\"),\n72\t            0x02 | 0x03 => Some(\"ack\"),\n73\t            0x04 => Some(\"reset_stream\"),\n74\t            0x05 => Some(\"stop_sending\"),\n75\t            0x06 => Some(\"crypto\"),\n76\t            0x07 => Some(\"new_token\"),\n77\t            0x10 => Some(\"max_data\"),\n78\t            0x11 => Some(\"max_stream_data\"),\n79\t            0x12 | 0x13 => Some(\"max_streams\"),\n80\t            0x14 => Some(\"data_blocked\"),\n81\t            0x15 => Some(\"stream_data_blocked\"),\n82\t            0x16 | 0x17 => Some(\"streams_blocked\"),\n83\t            0x18 => Some(\"new_connection_id\"),\n84\t            0x19 => Some(\"retire_connection_id\"),\n85\t            0x1a => Some(\"path_challenge\"),\n86\t            0x1b => Some(\"path_response\"),\n87\t            0x1c | 0x1d => Some(\"connection_close\"),\n88\t            0x1e => Some(\"handshake_done\"),\n89\t            0x1f => Some(\"immediate_ack\"),\n90\t            0x24 => Some(\"reset_stream_at\"),\n91\t            0x30 | 0x31 => Some(\"datagram\"),\n92\t            0x3e | 0x3f => Some(\"path_ack\"),\n93\t            0xaf => Some(\"ack_frequency\"),\n94\t            757 => Some(\"time_stamp\"),\n95\t            0x3e75 => Some(\"path_abandon\"),\n96\t            0x3e76 => Some(\"path_backup\"),\n97\t            0x3e77 => Some(\"path_available\"),\n98\t            0x3e78 => Some(\"path_new_connection_id\"),\n99\t            0x3e79 => Some(\"path_retire_connection_id\"),\n100\t            0x3e7a => Some(\"max_path_id\"),"}]},"parent_tool_use_id":"toolu_016DZDUH2eYQjeMuJdCzNWgY","session_id":"621e8ef5-6ea2-41f7-92c8-884ed614789d","uuid":"746f0771-4cd7-46ec-b4ab-91fc525b1366","timestamp":"2026-05-06T12:24:28.960Z"}
