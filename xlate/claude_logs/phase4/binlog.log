{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01Sc6gywKtdPnidVoBfF1sf1","type":"tool_result","content":"100\t// See `ByteStream` for the rationale on the dead-code allow.\n101\t#[allow(dead_code)]\n102\tpub struct ByteStreamBuf {\n103\t    buf: [u8; BYTESTREAM_MAX_BUFFER_SIZE],\n104\t}\n105\t\n106\timpl Default for ByteStreamBuf {\n107\t    fn default() -> Self {\n108\t        Self {\n109\t            buf: [0; BYTESTREAM_MAX_BUFFER_SIZE],\n110\t        }\n111\t    }\n112\t}\n113\t\n114\timpl ByteStreamBuf {\n115\t    /// Initialize a [`ByteStream`] backed by this inline buffer,\n116\t    /// with active capacity `nb_bytes`.  Returns `None` when\n117\t    /// `nb_bytes` exceeds [`BYTESTREAM_MAX_BUFFER_SIZE`] (matching\n118\t    /// the C `NULL` return).  C: `bytestream_buf_init`.\n119\t    pub fn stream(&mut self, nb_bytes: usize) -> Option<ByteStream<'_>> {\n120\t        if nb_bytes > BYTESTREAM_MAX_BUFFER_SIZE {\n121\t            return None;\n122\t        }\n123\t        Some(ByteStream {\n124\t            data: ByteStreamData::Borrowed(&mut self.buf[..nb_bytes]),\n125\t            ptr: 0,\n126\t        })\n127\t    }\n128\t}\n129\t\n130\timpl<'a> ByteStream<'a> {\n131\t    fn data_ref(&self) -> &[u8] {\n132\t        match &self.data {\n133\t            ByteStreamData::Borrowed(s) => s,\n134\t            ByteStreamData::Owned(v) => v.as_slice(),\n135\t        }\n136\t    }\n137\t\n138\t    fn data_mut(&mut self) -> &mut [u8] {\n139\t        match &mut self.data {\n140\t            ByteStreamData::Borrowed(s) => s,\n141\t            ByteStreamData::Owned(v) => v.as_mut_slice(),\n142\t        }\n143\t    }\n144\t\n145\t    fn set_error(&mut self) {\n146\t        let cap = self.data_ref().len();\n147\t        self.ptr = cap;\n148\t    }\n149\t\n150\t    /// Wrap a caller-owned mutable byte slice as a bytestream\n151\t    /// cursor.  C: `bytestream_ref_init`.\n152\t    ///\n153\t    /// The C function took `const void*` and cast away the const\n154\t    /// because the same struct served read and write callers.\n155\t    /// Rust takes `&mut [u8]` for both — read-only callers can\n156\t    /// still pass `&mut` to a buffer they treat as read-only.  A\n157\t    /// read-only-only refactor is deferred until the read/write\n158\t    /// split is clearer.\n159\t    pub fn from_slice(bytes: &'a mut [u8]) -> Self {\n160\t        ByteStream {\n161\t            data: ByteStreamData::Borrowed(bytes),\n162\t            ptr: 0,\n163\t        }\n164\t    }\n165\t\n166\t    /// Full underlying buffer (offsets `0..size`).  C:\n167\t    /// `bytestream_data` returning `const uint8_t*`.\n168\t    pub fn as_bytes(&self) -> &[u8] {\n169\t        &self.data_ref()[..self.ptr]\n170\t    }\n171\t\n172\t    /// Slice from the cursor to the end of the buffer (offsets\n173\t    /// `len()..capacity()`).  C: `bytestream_ptr` returning\n174\t    /// `const uint8_t*`.\n175\t    ///\n176\t    /// REVIEW(open): only the encrypt/decrypt helpers in\n177\t    /// `quic/quicctx.c` use this — they want a writable tail to\n178\t    /// hand to the AEAD layer.  Keep until those callers are\n179\t    /// translated; if Phase 4 finds no users, drop it.\n180\t    pub fn tail(&self) -> &[u8] {\n181\t        &self.data_ref()[self.ptr..]\n182\t    }\n183\t\n184\t    /// Total active capacity (the C `size` field).  C:\n185\t    /// `bytestream_size`.\n186\t    pub fn capacity(&self) -> usize {\n187\t        self.data_ref().len()\n188\t    }\n189\t\n190\t    /// Bytes consumed so far (the C `ptr` field).  C:\n191\t    /// `bytestream_length`.\n192\t    pub fn len(&self) -> usize {\n193\t        self.ptr\n194\t    }\n195\t\n196\t    /// `true` when no bytes have been consumed yet.\n197\t    pub fn is_empty(&self) -> bool {\n198\t        self.len() == 0\n199\t    }\n200\t\n201\t    /// Bytes left between the cursor and the end of the buffer.\n202\t    /// C: `bytestream_remain`.\n203\t    pub fn remaining(&self) -> usize {\n204\t        self.data_