bytes, const uint8_t* bytes_max)\n345\t{\n346\t    const uint8_t* bytes_begin = bytes;\n347\t\n348\t    bytes = picoquic_log_fixed_skip(bytes, bytes_max, 1);\n349\t    bytes = picoquic_log_varint_skip(bytes, bytes_max);\n350\t\n351\t    picoquic_binlog_frame(f, bytes_begin, bytes);\n352\t    return bytes;\n353\t}\n354\t\n355\tstatic const uint8_t* picoquic_log_path_retire_connection_id_frame(FILE* f, const uint8_t* bytes, const uint8_t* bytes_max)\n356\t{\n357\t    const uint8_t* bytes_begin = bytes;\n358\t\n359\t    bytes = picoquic_log_varint_skip(bytes, bytes_max);\n360\t    bytes = picoquic_log_varint_skip(bytes, bytes_max);\n361\t    bytes = picoquic_log_varint_skip(bytes, bytes_max);\n362\t\n363\t    picoquic_binlog_frame(f, bytes_begin, bytes);\n364\t    return bytes;\n365\t}\n366\t\n367\tstatic const uint8_t* picoquic_log_new_token_frame(FILE* f, const uint8_t* bytes, const uint8_t* bytes_max)\n368\t{\n369\t    const uint8_t* bytes_begin = bytes;\n370\t    size_t length = 0;\n371\t\n372\t    bytes = picoquic_log_fixed_skip(bytes, bytes_max, 1);\n373\t    bytes = picoquic_log_length(bytes, bytes_max, &length);\n374\t\n375\t    bytes = picoquic_log_fixed_skip(bytes, bytes_max, length);\n376\t\n377\t    picoquic_binlog_frame(f, bytes_begin, bytes);\n378\t    return bytes;\n379\t}\n380\t\n381\tstatic const uint8_t* picoquic_log_path_frame(FILE* f, const uint8_t* bytes, const uint8_t* bytes_max)\n382\t{\n383\t    const uint8_t* bytes_begin = bytes;\n384\t\n385\t    bytes = picoquic_log_fixed_skip(bytes, bytes_max, 1 + 8);\n386\t\n387\t    picoquic_binlog_frame(f, bytes_begin, bytes);\n388\t    return bytes;\n389\t}\n390\t\n391\tstatic const uint8_t* picoquic_log_crypto_hs_frame(FILE* f, const uint8_t* bytes, const uint8_t* bytes_max)\n392\t{\n393\t    const uint8_t* bytes_begin = bytes;\n394\t    size_t length = 0;\n395\t\n396\t    bytes = picoquic_log_fixed_skip(bytes, bytes_max, 1);\n397\t    bytes = picoquic_log_varint_skip(bytes, bytes_max);\n398\t    bytes = picoquic_log_length(bytes, bytes_max, &length);\n399\t\n400\t    picoquic_binlog_frame(f, bytes_begin, bytes);\n401\t\n402\t    bytes = picoquic_log_fixed_skip(bytes, bytes_max, length);\n403\t    return bytes;\n404\t}\n405\t\n406\t\n407\tstatic const uint8_t* picoquic_log_handshake_done_frame(FILE* f, const uint8_t* bytes, const uint8_t* bytes_max)\n408\t{\n409\t    const uint8_t* bytes_begin = bytes;\n410\t\n411\t    bytes = picoquic_log_fixed_skip(bytes, bytes_max, 1);\n412\t\n413\t    picoquic_binlog_frame(f, bytes_begin, bytes);\n414\t    return bytes;\n415\t}\n416\t\n417\tstatic const uint8_t* picoquic_log_datagram_frame(FILE* f, const uint8_t* bytes, const uint8_t* bytes_max)\n418\t{\n419\t    const uint8_t* bytes_begin = bytes;\n420\t    uint8_t ftype = bytes[0];\n421\t    size_t length = 0;\n422\t\n423\t    bytes = picoquic_log_fixed_skip(bytes, bytes_max, 1);\n424\t\n425\t    if (ftype & 1) {\n426\t        bytes = picoquic_log_length(bytes, bytes_max, &length);\n427\t    } else {\n428\t        length = bytes_max - bytes;\n429\t    }\n430\t\n431\t    picoquic_binlog_frame(f, bytes_begin, bytes);\n432\t\n433\t    bytes = picoquic_log_fixed_skip(bytes, bytes_max, length);\n434\t    return bytes;\n435\t}\n436\t\n437\tstatic const uint8_t* picoquic_log_time_stamp_frame(FILE* f, const uint8_t* bytes, const uint8_t* bytes_max)\n438\t{\n439\t    const uint8_t* bytes_begin = bytes;\n440\t\n441\t    bytes = picoquic_log_varint_skip(bytes, bytes_max); /* frame type as varint */\n442\t    bytes = picoquic_log_varint_skip(bytes, bytes_max); /* time stamp as varint */\n443\t\n444\t    picoquic_binlog_frame(f, bytes_begin, bytes);\n445\t\n446\t    return bytes;\n447\t}\n448\t\n449\tstatic const uint8_t* picoquic_log_path_abandon_frame(FILE* f, const uint8_t* bytes, const uint8_t* bytes_max)\n450\t{\n451\t    const uint8_t* bytes_begin = bytes;\n452\t    bytes = picoquic_log_varint_skip(bytes, bytes_max); /* frame type as varint */\n453\t    bytes = picoquic_skip_path_abandon_frame(bytes, bytes_max); /* skip abandon frame */\n454\t    picoquic_binlog_frame(f, bytes_begin, bytes);\n455\t\n456\t    return bytes;\n457\t}\n458\t\n459\tstatic const uint8_t* picoquic_log_path_available_or_backup_frame(FILE* f, const uint8_t* bytes, const uint8_t* bytes_max)\n460\t{\n461\t    const uint8_t* bytes_begin = bytes;\n462\t    bytes = picoquic_log_varint_skip(bytes, bytes_max); /* frame type as varint */\n463\t    bytes = picoquic_skip_path_available_or_backup_frame(bytes, bytes_max); /* skip available or backup frame */\n464\t    picoquic_binlog_frame(f, bytes_begin, bytes);\n465\t\n466\t    return bytes;\n467\t}\n468\t\n469\t\n470\tstatic const uint8_t* picoquic_log_ack_frequency_frame(FILE* f, const uint8_t* bytes, const uint8_t* bytes_max)\n471\t{\n472\t    const uint8_t* bytes_begin = bytes;\n473\t\n474\t    bytes = picoquic_log_varint_skip(bytes, bytes_max); /* frame type as varint */\n475\t    bytes = picoquic_log_varint_skip(bytes, bytes_max); /* Seq num */\n476\t    bytes = picoquic_log_varint_skip(bytes, bytes_max); /* Packet tolerance */\n477\t    bytes = picoquic_log_varint_skip(bytes, bytes_max); /* Max ACK delay */\n478\t    bytes = picoquic_log_varint_skip(bytes, bytes_max); /* Reordering threshold */\n479\t\n480\t    picoquic_binlog_frame(f, bytes_begin, bytes);\n481\t\n482\t    return bytes;\n483\t}\n484\t\n485\tstatic const uint8_t* picoquic_log_immediate_ack_frame(FILE* f, const uint8_t* bytes, const uint8_t* bytes_max)\n486\t{\n487\t    const uint8_t* bytes_begin = bytes;\n488\t\n489\t    bytes = picoquic_log_varint_skip(bytes, bytes_max); /* frame type as varint */\n490\t    picoquic_binlog_frame(f, bytes_begin, bytes);\n491\t\n492\t    return bytes;\n493\t}\n494\t\n495\tstatic const uint8_t* picoquic_log_erroring_frame(FILE* f, const uint8_t* bytes, const uint8_t* bytes_max)\n496\t{\n497\t    size_t frame_size = bytes_max - bytes;\n498\t    size_t copied = (frame_size > 8) ? 8 : frame_size;\n499\t\n500\t    picoquic_binlog_frame(f, bytes, bytes + copied);\n501\t\n502\t    return NULL;\n503\t}\n504\t\n505\tstatic const uint8_t* picoquic_log_padding(FILE* f, const uint8_t* bytes, const uint8_t* bytes_max)\n506\t{\n507\t    picoquic_binlog_frame(f, bytes, bytes + 1);\n508\t\n509\t    uint8_t ftype = bytes[0];\n510\t    while (bytes < bytes_max && bytes[0] == ftype) {\n511\t        bytes++;\n512\t    }\n513\t\n514\t    return bytes;\n515\t}\n516\t\n517\tstatic const uint8_t* picoquic_log_bdp_frame(FILE* f, const uint8_t* bytes, const uint8_t* bytes_max)\n518\t{\n519\t    const uint8_t* bytes_begin = bytes;\n520\t    size_t ip_len = 0;\n521\t\n522\t    bytes = picoquic_log_varint_skip(bytes, bytes_max); /* Frame type */\n523\t    bytes = picoquic_log_varint_skip(bytes, bytes_max); /* Life time */\n524\t    bytes = picoquic_log_varint_skip(bytes, bytes_max); /* Bytes in flight */\n525\t    bytes = picoquic_log_varint_skip(bytes, bytes_max); /* min rtt */\n526\t    bytes = picoquic_log_length(bytes, bytes_max, &ip_len); /*  IP Address length */\n527\t    bytes = picoquic_log_fixed_skip(bytes, bytes_max, ip_len); /* IP address value */\n528\t\n529\t    picoquic_binlog_frame(f, bytes_begin, bytes);\n530\t\n531\t    return bytes;\n532\t}\n533\t\n534\tstatic const uint8_t* picoquic_log_observed_address_frame(FILE* f, const uint8_t* bytes, const uint8_t* bytes_max, uint64_t ftype)\n535\t{\n536\t    const uint8_t* bytes_begin = bytes;\n537\t    size_t ip_len = ((ftype & 1) == 0) ? 4 : 16;\n538\t    size_t data_len = ip_len + 2;\n539\t\n540\t\n541\t    bytes = picoquic_log_varint_skip(bytes, bytes_max); /* Frame type */\n542\t    bytes = picoquic_log_varint_skip(bytes, bytes_max); /* Sequence number */\n543\t    bytes = picoquic_log_fixed_skip(bytes, bytes_max, data_len); /* IP address and port */\n544\t\n545\t    picoquic_binlog_frame(f, bytes_begin, bytes);\n546\t\n547\t    return bytes;\n548\t}\n549\t\n550\tvoid picoquic_binlog_frames(FILE * f, const uint8_t* bytes, size_t length)\n551\t{\n552\t    const uint8_t* bytes_max = bytes + length;\n553\t\n554\t    while (bytes != NULL && bytes < bytes_max) {\n555\t        uint64_t ftype= 0;\n556\t        size_t ftype_ll = picoquic_varint_decode(bytes, length, &ftype);\n557\t\n558\t        if (ftype_ll == 0) {\n559\t            /* Error, incorrect frame type encoding */\n560\t            bytes = NULL;\n561\t            break;\n562\t        }\n563\t        else if (ftype < 64 && ftype_ll != 1) {\n564\t            /* Error, incorrect frame type encoding */\n565\t            bytes = NULL;\n566\t            break;\n567\t        }\n568\t\n569\t        if (PICOQUIC_IN_RANGE(ftype, picoquic_frame_type_stream_range_min, picoquic_frame_type_stream_range_max)) {\n570\t            bytes = picoquic_log_stream_frame(f, bytes, bytes_max);\n571\t            continue;\n572\t        }\n573\t\n574\t        switch (ftype) {\n575\t        case picoquic_frame_type_ack:\n576\t        case picoquic_frame_type_ack_ecn:\n577\t        case picoquic_frame_type_path_ack:\n578\t        case picoquic_frame_type_path_ack_ecn:\n579\t            bytes = picoquic_log_ack_frame(f, bytes, bytes_max);\n580\t            break;\n581\t        case picoquic_frame_type_retire_connection_id:\n582\t            bytes = picoquic_log_retire_connection_id_frame(f, bytes, bytes_max);\n583\t            break;\n584\t        case picoquic_frame_type_path_retire_connection_id:\n585\t            bytes = picoquic_log_path_retire_connection_id_frame(f, bytes, bytes_max);\n586\t            break;\n587\t        case picoquic_frame_type_padding:\n588\t        case picoquic_frame_type_ping:\n589\t            bytes = picoquic_log_padding(f, bytes, bytes_max);\n590\t            break;\n591\t        case picoquic_frame_type_reset_stream:\n592\t            bytes = picoquic_log_reset_stream_frame(f, bytes, bytes_max);\n593\t            break;\n594\t        case picoquic_frame_type_reset_stream_at:\n595\t            bytes = picoquic_log_reset_stream_at_frame(f, bytes, bytes_max);\n596\t            break;\n597\t        case picoquic_frame_type_connection_close:\n598\t            bytes = picoquic_log_close_frame(f, bytes, bytes_max);\n599\t            break;\n600\t        case picoquic_frame_type_application_close:\n601\t            bytes = picoquic_log_app_close_frame(f, bytes, bytes_max);\n602\t            break;\n603\t        case picoquic_frame_type_max_data:\n604\t            bytes = picoquic_log_max_data_frame(f, bytes, bytes_max);\n605\t            break;\n606\t        case picoquic_frame_type_max_stream_data:\n607\t            bytes = picoquic_log_max_stream_data_frame(f, bytes, bytes_max);\n608\t            break;\n609\t        case picoquic_frame_type_max_streams_bidir:\n610\t        case picoquic_frame_type_max_streams_unidir:\n611\t            bytes = picoquic_log_max_stream_id_frame(f, bytes, bytes_max);\n612\t            break;\n613\t        case picoquic_frame_type_data_blocked:\n614\t            bytes = picoquic_log_blocked_frame(f, bytes, bytes_max);\n615\t            break;\n616\t        case picoquic_frame_type_stream_data_blocked:\n617\t            bytes = picoquic_log_stream_blocked_frame(f, bytes, bytes_max);\n618\t            break;\n619\t        case picoquic_frame_type_streams_blocked_bidir:\n620\t        case picoquic_frame_type_streams_blocked_unidir:\n621\t            bytes = picoquic_log_streams_blocked_frame(f, bytes, bytes_max);\n622\t            break;\n623\t        case picoquic_frame_type_new_connection_id:\n624\t            bytes = picoquic_log_new_connection_id_frame(f, bytes, bytes_max);\n625\t            break;\n626\t        case picoquic_frame_type_path_new_connection_id:\n627\t            bytes = picoquic_log_path_new_connection_id_frame(f, bytes, bytes_max);\n628\t            break;\n629\t        case picoquic_frame_type_stop_sending:\n630\t            bytes = picoquic_log_stop_sending_frame(f, bytes, bytes_max);\n631\t            break;\n632\t        case picoquic_frame_type_path_challenge:\n633\t        case picoquic_frame_type_path_response:\n634\t            bytes = picoquic_log_path_frame(f, bytes, bytes_max);\n635\t            break;\n636\t        case picoquic_frame_type_crypto_hs:\n637\t            bytes = picoquic_log_crypto_hs_frame(f, bytes, bytes_max);\n638\t            break;\n639\t        case picoquic_frame_type_new_token:\n640\t            bytes = picoquic_log_new_token_frame(f, bytes, bytes_max);\n641\t            break;\n642\t        case picoquic_frame_type_handshake_done:\n643\t            bytes = picoquic_log_handshake_done_frame(f, bytes, bytes_max);\n644\t            break;\n645\t        case picoquic_frame_type_datagram:\n646\t        case picoquic_frame_type_datagram_l:\n647\t            bytes = picoquic_log_datagram_frame(f, bytes, bytes_max);\n648\t            break;\n649\t        case picoquic_frame_type_ack_frequency:\n650\t            bytes = picoquic_log_ack_frequency_frame(f, bytes, bytes_max);\n651\t            break;\n652\t        case picoquic_frame_type_immediate_ack:\n653\t            bytes = picoquic_log_immediate_ack_frame(f, bytes, bytes_max);\n654\t            break;\n655\t        case picoquic_frame_type_time_stamp:\n656\t            bytes = picoquic_log_time_stamp_frame(f, bytes, bytes_max);\n657\t            break;\n658\t        case picoquic_frame_type_path_abandon:\n659\t            bytes = picoquic_log_path_abandon_frame(f, bytes, bytes_max);\n660\t            break;\n661\t        case picoquic_frame_type_path_backup:\n662\t        case picoquic_frame_type_path_available:\n663\t            bytes = picoquic_log_path_available_or_backup_frame(f, bytes, bytes_max);\n664\t            break;\n665\t        case picoquic_frame_type_bdp:\n666\t            bytes = picoquic_log_bdp_frame(f, bytes, bytes_max);\n667\t            break;\n668\t        case picoquic_frame_type_observed_address_v4:\n669\t        case picoquic_frame_type_observed_address_v6:\n670\t            bytes = picoquic_log_observed_address_frame(f, bytes, bytes_max, ftype);\n671\t            break;\n672\t        default:\n673\t            bytes = picoquic_log_erroring_frame(f, bytes, bytes_max);\n674\t            break;\n675\t        }\n676\t    }\n677\t}\n678\t\n679\tstatic void binlog_compose_event_header(bytestream* msg, const picoquic_connection_id_t* cid, uint64_t current_time,\n680\t    uint64_t path_id, picoquic_log_event_type event_type)\n681\t{\n682\t    /* Common chunk header */\n683\t    bytewrite_cid(msg, cid);\n684\t    bytewrite_vint(msg, current_time);\n685\t    bytewrite_vint(msg, path_id);\n686\t    bytewrite_vint(msg, (uint64_t)event_type);\n687\t}\n688\t\n689\tstatic uint64_t binlog_get_path_id(picoquic_cnx_t* cnx, picoquic_path_t* path_x)\n690\t{\n691\t    uint64_t path_id = 0;\n692\t\n693\t    if (cnx->is_multipath_enabled && path_x != NULL) {\n694\t        path_id = path_x->unique_path_id;\n695\t    }\n696\t\n697\t    return path_id;\n698\t}\n699\t\n700\tvoid binlog_pdu(FILE* f, const picoquic_connection_id_t* cid, int receiving, uint64_t current_time,\n701\t    const struct sockaddr* addr_peer, const struct sockaddr* addr_local, size_t packet_length,\n702\t    uint64_t unique_path_id, unsigned char ecn)\n703\t{\n704\t    bytestream_buf stream_msg;\n705\t    bytestream* msg = bytestream_buf_init(&stream_msg, BYTESTREAM_MAX_BUFFER_SIZE);\n706\t\n707\t    /* Common chunk header */\n708\t    binlog_compose_event_header(msg, cid, current_time, 0, picoquic_log_event_pdu_sent + receiving);\n709\t\n710\t    /* PDU information */\n711\t    bytewrite_addr(msg, addr_peer);\n712\t    bytewrite_vint(msg, packet_length);\n713\t    bytewrite_addr(msg, addr_local);\n714\t    bytewrite_vint(msg, unique_path_id);\n715\t    bytewrite_int8(msg, ecn);\n716\t\n717\t    uint8_t head[4] = { 0 };\n718\t    picoformat_32(head, (uint32_t)bytestream_length(msg));\n719\t\n720\t    (void)fwrite(head, sizeof(head), 1, f);\n721\t    (void)fwrite(bytestream_data(msg), bytestream_length(msg), 1, f);\n722\t}\n723\t\n724\tstatic void binlog_pdu_ex(picoquic_cnx_t* cnx, int receiving, uint64_t current_time,\n725\t    const struct sockaddr* addr_peer, const struct sockaddr* addr_local, size_t packet_length,\n726\t    uint64_t unique_path_id, unsigned char ecn)\n727\t{\n728\t    if (cnx != NULL && cnx->f_binlog != NULL && picoquic_cnx_is_still_logging(cnx)) {\n729\t        binlog_pdu(cnx->f_binlog, &cnx->initial_cnxid, receiving, current_time, addr_peer, addr_local, packet_length,\n730\t            unique_path_id, ecn);\n731\t    }\n732\t}\n733\t\n734\tvoid binlog_packet(FILE* f, const picoquic_connection_id_t* cid, uint64_t path_id, int receiving, uint64_t current_time,\n735\t    const picoquic_packet_header* ph, const uint8_t* bytes, size_t bytes_max)\n736\t{\n737\t    long fpos0 = ftell(f);\n738\t\n739\t    uint8_t head[4] = { 0 };\n740\t    (void)fwrite(head, 4, 1, f);\n741\t\n742\t    bytestream_buf stream_msg;\n743\t    bytestream* msg = bytestream_buf_init(&stream_msg, BYTESTREAM_MAX_BUFFER_SIZE);\n744\t\n745\t    /* Common chunk header */\n746\t    binlog_compose_event_header(msg, cid, current_time, path_id, picoquic_log_event_packet_sent + receiving);\n747\t\n748\t    /* packet information */\n749\t    bytewrite_vint(msg, bytes_max);\n750\t\n751\t    /* packet header */\n752\t    bytewrite_int8(msg, (uint8_t)(64*ph->quic_bit_is_zero + 2 * ph->spin + ph->key_phase));\n753\t    bytewrite_vint(msg, ph->payload_length);\n754\t    bytewrite_vint(msg, ph->ptype);\n755\t    bytewrite_vint(msg, ph->pn64);\n756\t\n757\t    bytewrite_cid(msg, &ph->dest_cnx_id);\n758\t    bytewrite_cid(msg, &ph->srce_cnx_id);\n759\t\n760\t    if (ph->ptype != picoquic_packet_1rtt_protected &&\n761\t        ph->ptype != picoquic_packet_version_negotiation) {\n762\t        bytewrite_int32(msg, ph->vn);\n763\t    }\n764\t\n765\t    if (ph->ptype == picoquic_packet_initial) {\n766\t        bytewrite_vint(msg, ph->token_length);\n767\t        bytewrite_buffer(msg, ph->token_bytes, ph->token_length);\n768\t    }\n769\t\n770\t    (void)fwrite(bytestream_data(msg), bytestream_length(msg), 1, f);\n771\t\n772\t    /* frame information */\n773\t    if (ph->ptype == picoquic_packet_version_negotiation || ph->ptype == picoquic_packet_retry) {\n774\t        picoquic_binlog_frame(f, bytes + ph->offset, bytes + bytes_max);\n775\t    }\n776\t    else if (ph->ptype != picoquic_packet_error) {\n777\t        picoquic_binlog_frames(f, bytes + ph->offset, ph->payload_length);\n778\t    }\n779\t\n780\t    /* re-write chunk size field */\n781\t    long fpos1 = ftell(f);\n782\t\n783\t    picoformat_32(head, (uint32_t)(fpos1 - fpos0 - 4));\n784\t\n785\t    (void)fseek(f, fpos0, SEEK_SET);\n786\t    (void)fwrite(head, 4, 1, f);\n787\t    (void)fseek(f, 0, SEEK_END);\n788\t}\n789\t\n790\tstatic void binlog_packet_ex(picoquic_cnx_t* cnx, picoquic_path_t * path_x, int receiving, uint64_t current_time,\n791\t    picoquic_packet_header* ph, const uint8_t* bytes, size_t bytes_max)\n792\t{\n793\t    if (cnx != NULL && cnx->f_binlog != NULL && picoquic_cnx_is_still_logging(cnx)) {\n794\t        binlog_packet(cnx->f_binlog, &cnx->initial_cnxid, binlog_get_path_id(cnx, path_x),\n795\t            receiving, current_time, ph, bytes, bytes_max);\n796\t    }\n797\t}\n798\t\n799\tvoid binlog_dropped_packet(picoquic_cnx_t* cnx, picoquic_path_t* path_x,\n800\t    picoquic_packet_header* ph, size_t packet_size, int err, uint64_t current_time)\n801\t{\n802\t    FILE* f = cnx->f_binlog;\n803\t    bytestream_buf stream_msg;\n804\t    bytestream* msg = bytestream_buf_init(&stream_msg, BYTESTREAM_MAX_BUFFER_SIZE);\n805\t\n806\t    bytewrite_int32(msg, 0);\n807\t    /* Common chunk header */\n808\t    binlog_compose_event_header(msg, &cnx->initial_cnxid, current_time, binlog_get_path_id(cnx, path_x),\n809\t        picoquic_log_event_packet_dropped);\n810\t    /* Event header */\n811\t    bytewrite_vint(msg, ph->ptype);\n812\t    bytewrite_vint(msg, packet_size);\n813\t    bytewrite_vint(msg, err);\n814\t\n815\t    /* write the frame length at the reserved spot, and save to log file*/\n816\t    picoformat_32(msg->data, (uint32_t)(msg->ptr - 4));\n817\t    (void)fwrite(bytestream_data(msg), bytestream_length(msg), 1, f);\n818\t}\n819\t\n820\tvoid binlog_buffered_packet(picoquic_cnx_t* cnx, picoquic_path_t* path_x, \n821\t    picoquic_packet_type_enum ptype, uint64_t current_time)\n822\t{\n823\t    FILE* f = cnx->f_binlog;\n824\t    bytestream_buf stream_msg;\n825\t    bytestream* msg = bytestream_buf_init(&stream_msg, BYTESTREAM_MAX_BUFFER_SIZE);\n826\t\n827\t    bytewrite_int32(msg, 0);\n828\t    /* Common chunk header */\n829\t    binlog_compose_event_header(msg, &cnx->initial_cnxid, current_time, binlog_get_path_id(cnx, path_x),\n830\t        picoquic_log_event_packet_buffered);\n831\t    /* Event header */\n832\t    bytewrite_vint(msg, ptype);\n833\t    (void)bytewrite_cstr(msg, \"keys_unavailable\");\n834\t\n835\t    /* write the frame length at the reserved spot, and save to log file*/\n836\t    picoformat_32(msg->data, (uint32_t)(msg->ptr - 4));\n837\t    (void)fwrite(bytestream_data(msg), bytestream_length(msg), 1, f);\n838\t}\n839\t\n840\t\n841\tvoid binlog_outgoing_packet(picoquic_cnx_t* cnx, picoquic_path_t * path_x,\n842\t    uint8_t * bytes, uint64_t sequence_number, size_t pn_length, size_t length,\n843\t    uint8_t* send_buffer, size_t send_length, uint64_t current_time)\n844\t{\n845\t    FILE* f = cnx->f_binlog;\n846\t\n847\t    picoquic_cnx_t* pcnx = cnx;\n848\t    picoquic_packet_header ph;\n849\t    size_t checksum_length = 16;\n850\t    struct sockaddr_in default_addr;\n851\t\n852\t    const picoquic_connection_id_t * cnxid = (cnx != NULL) ? &cnx->initial_cnxid : &picoquic_null_connection_id;\n853\t\n854\t    memset(&default_addr, 0, sizeof(struct sockaddr_in));\n855\t    default_addr.sin_family = AF_INET;\n856\t\n857\t    picoquic_parse_packet_header((cnx == NULL) ? NULL : cnx->quic, send_buffer, send_length,\n858\t        ((cnx == NULL || cnx->path[0] == NULL) ? (struct sockaddr *)&default_addr :\n859\t        (struct sockaddr *)&cnx->path[0]->first_tuple->local_addr), &ph, &pcnx, 0);\n860\t\n861\t    if (cnx != NULL) {\n862\t        picoquic_epoch_enum epoch = (ph.ptype == picoquic_packet_1rtt_protected) ? picoquic_epoch_1rtt :\n863\t            ((ph.ptype == picoquic_packet_0rtt_protected) ? picoquic_epoch_0rtt :\n864\t            ((ph.ptype == picoquic_packet_handshake) ? picoquic_epoch_handshake : picoquic_epoch_initial));\n865\t        if (cnx->crypto_context[epoch].aead_encrypt != NULL) {\n866\t            checksum_length = picoquic_get_checksum_length(cnx, epoch);\n867\t        }\n868\t    }\n869\t\n870\t    ph.pn64 = sequence_number;\n871\t    ph.pn = (uint32_t)ph.pn64;\n872\t    if (ph.ptype != picoquic_packet_retry) {\n873\t        if (ph.pn_offset != 0) {\n874\t            ph.offset = ph.pn_offset + pn_length;\n875\t            ph.payload_length -= pn_length;\n876\t        }\n877\t    }\n878\t    if (ph.ptype != picoquic_packet_version_negotiation) {\n879\t        if (ph.payload_length > checksum_length) {\n880\t            ph.payload_length -= (uint16_t)checksum_length;\n881\t        }\n882\t        else {\n883\t            ph.payload_length = 0;\n884\t        }\n885\t    }\n886\t\n887\t    binlog_packet(f, cnxid, binlog_get_path_id(cnx, path_x),  0, current_time, &ph, bytes, length);\n888\t}\n889\t\n890\tvoid binlog_packet_lost(picoquic_cnx_t* cnx, picoquic_path_t* path_x,\n891\t    picoquic_packet_type_enum ptype,  uint64_t sequence_number, char const * trigger,\n892\t    picoquic_connection_id_t * dcid, size_t packet_size,\n893\t    uint64_t current_time)\n894\t{\n895\t    FILE* f = cnx->f_binlog;\n896\t\n897\t    bytestream_buf stream_msg;\n898\t    bytestream* msg = bytestream_buf_init(&stream_msg, BYTESTREAM_MAX_BUFFER_SIZE);\n899\t\n900\t    bytewrite_int32(msg, 0);\n901\t    /* Common chunk header */\n902\t    binlog_compose_event_header(msg, &cnx->initial_cnxid, current_time, binlog_get_path_id(cnx, path_x), picoquic_log_event_packet_lost);\n903\t    /* Event header */\n904\t    bytewrite_vint(msg, ptype);\n905\t    bytewrite_vint(msg, sequence_number);\n906\t    bytewrite_cstr(msg, trigger);\n907\t    if (dcid != NULL) {\n908\t        bytewrite_cid(msg, dcid);\n909\t    }\n910\t    else {\n911\t        bytewrite_int8(msg, 0);\n912\t    }\n913\t    bytewrite_vint(msg, packet_size);\n914\t\n915\t    /* write the frame length at the reserved spot, and save to log file*/\n916\t    picoformat_32(msg->data, (uint32_t)(msg->ptr - 4));\n917\t    (void)fwrite(bytestream_data(msg), bytestream_length(msg), 1, f);\n918\t}\n919\t\n920\t\n921\tvoid binlog_negotiated_alpn(picoquic_cnx_t* cnx, int is_local,\n922\t    uint8_t const * sni, size_t sni_len, uint8_t const* alpn, size_t alpn_len,\n923\t    const ptls_iovec_t* alpn_list, size_t alpn_count)\n924\t{\n925\t    FILE* f = cnx->f_binlog;\n926\t\n927\t    bytestream_buf stream_msg;\n928\t    bytestream* msg = bytestream_buf_init(&stream_msg, BYTESTREAM_MAX_BUFFER_SIZE);\n929\t    /* Common chunk header */\n930\t    binlog_compose_event_header(msg, &cnx->initial_cnxid, picoquic_get_quic_time(cnx->quic), 0, picoquic_log_event_alpn_update);\n931\t    /* Event header */\n932\t    bytewrite_vint(msg, is_local);\n933\t    bytewrite_vint(msg, sni_len);\n934\t    if (sni_len > 0) {\n935\t        bytewrite_buffer(msg, sni, sni_len);\n936\t    }\n937\t\n938\t    bytewrite_vint(msg, alpn_count);\n939\t    if (alpn_count > 0) {\n940\t        for (size_t i = 0; i < alpn_count; i++) {\n941\t            bytewrite_vint(msg, alpn_list[i].len);\n942\t            bytewrite_buffer(msg, alpn_list[i].base, alpn_list[i].len);\n943\t        }\n944\t    }\n945\t\n946\t    bytewrite_vint(msg, alpn_len);\n947\t    if (alpn_len > 0) {\n948\t        bytewrite_buffer(msg, alpn, alpn_len);\n949\t    }\n950\t\n951\t    bytestream_buf stream_head;\n952\t    bytestream* head = bytestream_buf_init(&stream_head, 4);\n953\t    bytewrite_int32(head, (uint32_t)bytestream_length(msg));\n954\t\n955\t    (void)fwrite(bytestream_data(head), bytestream_length(head), 1, f);\n956\t    (void)fwrite(bytestream_data(msg), bytestream_length(msg), 1, f);\n957\t}\n958\t\n959\tvoid binlog_transport_extension(picoquic_cnx_t* cnx, int is_local,\n960\t    size_t param_length, uint8_t* params)\n961\t{\n962\t    FILE* f = cnx->f_binlog;\n963\t\n964\t    bytestream_buf stream_msg;\n965\t    bytestream* msg = bytestream_buf_init(&stream_msg, BYTESTREAM_MAX_BUFFER_SIZE);\n966\t    /* Common chunk header */\n967\t    binlog_compose_event_header(msg, &cnx->initial_cnxid, picoquic_get_quic_time(cnx->quic), 0, picoquic_log_event_param_update);\n968\t    /* Event header */\n969\t    bytewrite_vint(msg, is_local);\n970\t    bytewrite_vint(msg, param_length);\n971\t\n972\t    if (param_length > 0) {\n973\t        bytewrite_buffer(msg, params, param_length);\n974\t    }\n975\t\n976\t    bytestream_buf stream_head;\n977\t    bytestream* head = bytestream_buf_init(&stream_head, 4);\n978\t    bytewrite_int32(head, (uint32_t)bytestream_length(msg));\n979\t\n980\t    (void)fwrite(bytestream_data(head), bytestream_length(head), 1, f);\n981\t    (void)fwrite(bytestream_data(msg), bytestream_length(msg), 1, f);\n982\t}\n983\t\n984\tvoid binlog_picotls_ticket(FILE* f, picoquic_connection_id_t cnx_id,\n985\t    uint8_t* ticket, uint16_t ticket_length)\n986\t{\n987\t    bytestream_buf stream_msg;\n988\t    bytestream * msg = bytestream_buf_init(&stream_msg, BYTESTREAM_MAX_BUFFER_SIZE);\n989\t    /* Common chunk header */\n990\t    binlog_compose_event_header(msg, &cnx_id, 0, 0, picoquic_log_event_tls_key_update);\n991\t\n992\t    bytewrite_vint(msg, ticket_length);\n993\t    bytewrite_buffer(msg, ticket, ticket_length);\n994\t\n995\t    bytestream_buf stream_head;\n996\t    bytestream * head = bytestream_buf_init(&stream_head, 8);\n997\t    bytewrite_int32(head, (uint32_t)bytestream_length(msg));\n998\t\n999\t    (void)fwrite(bytestream_data(head), bytestream_length(head), 1, f);\n1000\t    (void)fwrite(bytestream_data(msg), bytestream_length(msg), 1, f);\n1001\t}\n1002\t\n1003\tstatic void binlog_picotls_ticket_ex(picoquic_cnx_t* cnx,\n1004\t    uint8_t* ticket, uint16_t ticket_length)\n1005\t{\n1006\t    if (cnx != NULL && cnx->f_binlog != NULL && picoquic_cnx_is_still_logging(cnx)) {\n1007\t        binlog_picotls_ticket(cnx->f_binlog, cnx->initial_cnxid, ticket, ticket_length);\n1008\t    }\n1009\t}\n1010\t\n1011\tFILE* create_binlog(char const* binlog_file, uint64_t creation_time, unsigned int multipath_enabled);\n1012\t\n1013\tvoid binlog_new_connection(picoquic_cnx_t * cnx)\n1014\t{\n1015\t    char const* bin_dir = (cnx->quic->binlog_dir == NULL) ? cnx->quic->qlog_dir : cnx->quic->binlog_dir;\n1016\t\n1017\t    if (bin_dir == NULL || cnx->quic->bin_log_fns == NULL) {\n1018\t        return;\n1019\t    }\n1020\t\n1021\t    if (cnx->quic->current_number_of_open_logs >= cnx->quic->max_simultaneous_logs) {\n1022\t        return;\n1023\t    }\n1024\t\n1025\t    int ret = 0;\n1026\t\n1027\t    cnx->f_binlog = picoquic_file_close(cnx->f_binlog);\n1028\t    \n1029\t    char cid_name[2 * PICOQUIC_CONNECTION_ID_MAX_SIZE + 1];\n1030\t    if (picoquic_print_connection_id_hexa(cid_name, sizeof(cid_name), &cnx->initial_cnxid) != 0) {\n1031\t        ret = -1;\n1032\t    }\n1033\t\n1034\t    char log_filename[512];\n1035\t    if (ret == 0) {\n1036\t        int sprintf_ret = -1;\n1037\t        if (cnx->quic->use_unique_log_names) {\n1038\t            sprintf_ret = picoquic_sprintf(log_filename, sizeof(log_filename), NULL, \"%s%s%s.%x.%s.log\",\n1039\t                bin_dir, PICOQUIC_FILE_SEPARATOR, cid_name, cnx->log_unique,\n1040\t                (cnx->client_mode) ? \"client\" : \"server\");\n1041\t        }\n1042\t        else {\n1043\t            sprintf_ret = picoquic_sprintf(log_filename, sizeof(log_filename), NULL, \"%s%s%s.%s.log\",\n1044\t                bin_dir, PICOQUIC_FILE_SEPARATOR, cid_name,\n1045\t                (cnx->client_mode) ? \"client\" : \"server\");\n1046\t        }\n1047\t        if (sprintf_ret != 0) {\n1048\t            ret = -1;\n1049\t        }\n1050\t        else {\n1051\t            picoquic_string_free(cnx->binlog_file_name);\n1052\t            cnx->binlog_file_name = picoquic_string_duplicate(log_filename);\n1053\t        }\n1054\t    }\n1055\t\n1056\t    if (ret == 0) {\n1057\t        cnx->f_binlog = create_binlog(log_filename, picoquic_get_quic_time(cnx->quic),\n1058\t           cnx->local_parameters.initial_max_path_id > 0);\n1059\t        if (cnx->f_binlog == NULL) {\n1060\t            cnx->binlog_file_name = picoquic_string_free(cnx->binlog_file_name);\n1061\t            ret = -1;\n1062\t        }\n1063\t        else {\n1064\t            cnx->quic->current_number_of_open_logs++;\n1065\t        }\n1066\t    }\n1067\t\n1068\t    if (ret == 0) {\n1069\t        bytestream_buf stream_msg;\n1070\t        bytestream * msg = bytestream_buf_init(&stream_msg, BYTESTREAM_MAX_BUFFER_SIZE);\n1071\t        /* Common chunk header */\n1072\t        binlog_compose_event_header(msg, &cnx->initial_cnxid, cnx->start_time, 0, picoquic_log_event_new_connection);\n1073\t\n1074\t        bytewrite_int8(msg, cnx->client_mode != 0);\n1075\t        bytewrite_int32(msg, cnx->proposed_version);\n1076\t        bytewrite_cid(msg, &cnx->path[0]->first_tuple->p_remote_cnxid->cnx_id);\n1077\t\n1078\t        /* Algorithms used */\n1079\t        bytewrite_cstr(msg, cnx->congestion_alg->congestion_algorithm_id);\n1080\t        bytewrite_vint(msg, cnx->spin_policy);\n1081\t\n1082\t        bytestream_buf stream_head;\n1083\t        bytestream * head = bytestream_buf_init(&stream_head, 8);\n1084\t        bytewrite_int32(head, (uint32_t)bytestream_length(msg));\n1085\t\n1086\t        (void)fwrite(bytestream_data(head), bytestream_length(head), 1, cnx->f_binlog);\n1087\t        (void)fwrite(bytestream_data(msg), bytestream_length(msg), 1, cnx->f_binlog);\n1088\t    }\n1089\t}\n1090\t\n1091\tvoid binlog_close_connection(picoquic_cnx_t * cnx)\n1092\t{\n1093\t    FILE * f = cnx->f_binlog;\n1094\t    if (f == NULL) {\n1095\t        return;\n1096\t    }\n1097\t\n1098\t    bytestream_buf stream_msg;\n1099\t    bytestream * msg = bytestream_buf_init(&stream_msg, BYTESTREAM_MAX_BUFFER_SIZE);\n1100\t    /* Common chunk header */\n1101\t    binlog_compose_event_header(msg, &cnx->initial_cnxid, picoquic_get_quic_time(cnx->quic), 0, picoquic_log_event_connection_close);\n1102\t\n1103\t    bytestream_buf stream_head;\n1104\t    bytestream * head = bytestream_buf_init(&stream_head, 8);\n1105\t    bytewrite_int32(head, (uint32_t)bytestream_length(msg));\n1106\t\n1107\t    (void)fwrite(bytestream_data(head), bytestream_length(head), 1, f);\n1108\t    (void)fwrite(bytestream_data(msg), bytestream_length(msg), 1, f);\n1109\t\n1110\t    fflush(f);\n1111\t\n1112\t    cnx->f_binlog = picoquic_file_close(cnx->f_binlog);\n1113\t\n1114\t    if (cnx->quic->qlog_dir != NULL && cnx->quic->autoqlog_fn != NULL) {\n1115\t        (void)cnx->quic->autoqlog_fn(cnx);\n1116\t    }\n1117\t    cnx->binlog_file_name = picoquic_string_free(cnx->binlog_file_name);\n1118\t    if (cnx->quic->current_number_of_open_logs > 0) {\n1119\t        cnx->quic->current_number_of_open_logs--;\n1120\t    }\n1121\t}\n1122\t\n1123\tFILE* create_binlog(char const* binlog_file, uint64_t creation_time, unsigned int is_multipath_supported)\n1124\t{\n1125\t    FILE* f_binlog = picoquic_file_open(binlog_file, \"wb\");\n1126\t    if (f_binlog == NULL) {\n1127\t        DBG_PRINTF(\"Cannot open file %s for write.\\n\", binlog_file);\n1128\t    }\n1129\t    else {\n1130\t        /* Write a header text with version identifier and current date  */\n1131\t        bytestream_buf stream;\n1132\t        bytestream* ps = bytestream_buf_init(&stream, 16);\n1133\t        bytewrite_int32(ps, FOURCC('q', 'l', 'o', 'g'));\n1134\t        bytewrite_int16(ps, (is_multipath_supported) ? 0x01 : 0); /* flags */\n1135\t        bytewrite_int16(ps, 0x01); /* version */\n1136\t        bytewrite_int64(ps, creation_time);\n1137\t\n1138\t        if (fwrite(bytestream_data(ps), bytestream_length(ps), 1, f_binlog) <= 0) {\n1139\t            DBG_PRINTF(\"Cannot write header for file %s.\\n\", binlog_file);\n1140\t            f_binlog = picoquic_file_close(f_binlog);\n1141\t        }\n1142\t    }\n1143\t\n1144\t    return f_binlog;\n1145\t}\n1146\t\n1147\t/*\n1148\t * Log the state of the congestion management, retransmission, etc.\n1149\t * Call either just after processing a received packet, or just after\n1150\t * sending a packet.\n1151\t */\n1152\t\n1153\tvoid binlog_cc_dump(picoquic_cnx_t* cnx, picoquic_path_t* path_x, uint64_t current_time)\n1154\t{\n1155\t    bytestream_buf stream_msg;\n1156\t    bytestream* ps_msg = bytestream_buf_init(&stream_msg, BYTESTREAM_MAX_BUFFER_SIZE);\n1157\t\n1158\t    picoquic_packet_context_t* pkt_ctx = &cnx->pkt_ctx[picoquic_packet_context_application];\n1159\t\n1160\t    if (cnx->is_multipath_enabled) {\n1161\t        pkt_ctx = &path_x->pkt_ctx;\n1162\t    }\n1163\t\n1164\t    /* Common chunk header */\n1165\t    /* TODO: understand how to provide per path data -- most probably do a loop on\n1166\t     * all available paths, and write the data for each path if multipath is enabled.\n1167\t     * verify that it works for CSV and QLOG formats.\n1168\t     */\n1169\t    binlog_compose_event_header(ps_msg, &cnx->initial_cnxid, current_time,\n1170\t        binlog_get_path_id(cnx, path_x), picoquic_log_event_cc_update);\n1171\t\n1172\t    bytewrite_vint(ps_msg, pkt_ctx->send_sequence);\n1173\t\n1174\t    if (pkt_ctx->highest_acknowledged != UINT64_MAX) {\n1175\t        bytewrite_vint(ps_msg, 1);\n1176\t        bytewrite_vint(ps_msg, pkt_ctx->highest_acknowledged);\n1177\t        bytewrite_vint(ps_msg, pkt_ctx->highest_acknowledged_time - cnx->start_time);\n1178\t        bytewrite_vint(ps_msg, pkt_ctx->latest_time_acknowledged - cnx->start_time);\n1179\t    }\n1180\t    else {\n1181\t        bytewrite_vint(ps_msg, 0);\n1182\t    }\n1183\t\n1184\t    bytewrite_vint(ps_msg, path_x->cwin);\n1185\t    bytewrite_vint(ps_msg, path_x->one_way_delay_sample);\n1186\t    bytewrite_vint(ps_msg, path_x->rtt_sample);\n1187\t    bytewrite_vint(ps_msg, path_x->smoothed_rtt);\n1188\t    bytewrite_vint(ps_msg, path_x->rtt_min);\n1189\t    bytewrite_vint(ps_msg, path_x->bandwidth_estimate);\n1190\t    bytewrite_vint(ps_msg, path_x->receive_rate_estimate);\n1191\t    bytewrite_vint(ps_msg, path_x->send_mtu);\n1192\t    bytewrite_vint(ps_msg, path_x->pacing.packet_time_microsec);\n1193\t    if (cnx->is_multipath_enabled) {\n1194\t        bytewrite_vint(ps_msg, path_x->nb_losses_found);\n1195\t        bytewrite_vint(ps_msg, path_x->nb_spurious);\n1196\t    }\n1197\t    else {\n1198\t        bytewrite_vint(ps_msg, cnx->nb_retransmission_total);\n1199\t        bytewrite_vint(ps_msg, cnx->nb_spurious);\n1200\t    }\n1201\t    bytewrite_vint(ps_msg, cnx->cwin_blocked);\n1202\t    bytewrite_vint(ps_msg, cnx->flow_blocked);\n1203\t    bytewrite_vint(ps_msg, cnx->stream_blocked);\n1204\t\n1205\t    if (cnx->congestion_alg == NULL) {\n1206\t        bytewrite_vint(ps_msg, 0);\n1207\t        bytewrite_vint(ps_msg, 0);\n1208\t    }\n1209\t    else {\n1210\t        uint64_t cc_state = 0;\n1211\t        uint64_t cc_param = 0;\n1212\t\n1213\t        if (cnx->path[0]->congestion_alg_state != NULL) {\n1214\t            cnx->congestion_alg->alg_observe(cnx->path[0], &cc_state, &cc_param);\n1215\t        }\n1216\t        bytewrite_vint(ps_msg, cc_state);\n1217\t        bytewrite_vint(ps_msg, cc_param);\n1218\t    }\n1219\t\n1220\t    bytewrite_vint(ps_msg, path_x->peak_bandwidth_estimate);\n1221\t    bytewrite_vint(ps_msg, path_x->bytes_in_transit);\n1222\t    bytewrite_vint(ps_msg, path_x->last_bw_estimate_path_limited);\n1223\t\n1224\t    bytestream_buf stream_head;\n1225\t    bytestream* ps_head = bytestream_buf_init(&stream_head, BYTESTREAM_MAX_BUFFER_SIZE);\n1226\t\n1227\t    bytewrite_int32(ps_head, (uint32_t)bytestream_length(ps_msg));\n1228\t\n1229\t    (void)fwrite(bytestream_data(ps_head), bytestream_length(ps_head), 1, cnx->f_binlog);\n1230\t    (void)fwrite(bytestream_data(ps_msg), bytestream_length(ps_msg), 1, cnx->f_binlog);\n1231\t}\n1232\t\n1233\t/*\n1234\t * Write an information message frame, for free form debugging.\n1235\t */\n1236\t\n1237\tvoid picoquic_binlog_message_v(picoquic_cnx_t* cnx, const char* fmt, va_list vargs)\n1238\t{\n1239\t    if (cnx->f_binlog == NULL) {\n1240\t        return;\n1241\t    }\n1242\t    bytestream_buf stream_msg;\n1243\t    bytestream* ps_msg = bytestream_buf_init(&stream_msg, BYTESTREAM_MAX_BUFFER_SIZE);\n1244\t    size_t message_len;\n1245\t    char* message_text;\n1246\t    int written = -1;\n1247\t    /* Common chunk header */\n1248\t    binlog_compose_event_header(ps_msg, &cnx->initial_cnxid, picoquic_get_quic_time(cnx->quic), 0, picoquic_log_event_info_message);\n1249\t\n1250\t    message_text = (char*)(ps_msg->data + ps_msg->ptr);\n1251\t#ifdef _WINDOWS\n1252\t    written = vsnprintf_s(message_text,\n1253\t        ps_msg->size - ps_msg->ptr, _TRUNCATE, fmt, vargs);\n1254\t    message_len = (written < 0) ? ps_msg->size - ps_msg->ptr - 1 : (size_t)written;\n1255\t#else\n1256\t    written = vsnprintf(message_text, ps_msg->size - ps_msg->ptr, fmt, vargs);\n1257\t    if (written < 0 || (size_t)written >= ps_msg->size - ps_msg->ptr){\n1258\t        message_len = ps_msg->size - ps_msg->ptr - 1;\n1259\t    } else {\n1260\t        message_len = (size_t)written;\n1261\t    }\n1262\t#endif\n1263\t    ps_msg->ptr += message_len;\n1264\t\n1265\t    bytestream_buf stream_head;\n1266\t    bytestream* ps_head = bytestream_buf_init(&stream_head, BYTESTREAM_MAX_BUFFER_SIZE);\n1267\t\n1268\t    bytewrite_int32(ps_head, (uint32_t)bytestream_length(ps_msg));\n1269\t\n1270\t    (void)fwrite(bytestream_data(ps_head), bytestream_length(ps_head), 1, cnx->f_binlog);\n1271\t    (void)fwrite(bytestream_data(ps_msg), bytestream_length(ps_msg), 1, cnx->f_binlog);\n1272\t}\n1273\t\n1274\t#if 0\n1275\t/* Log an event that cannot be attached to a specific connection */\n1276\tvoid binlog_ignore_quic_app_message(picoquic_quic_t* UNUSED(quic), const picoquic_connection_id_t* UNUSED(cid), const char* UNUSED(fmt), va_list(vargs))\n1277\t{\n1278\t#ifdef _WINDOWS\n1279\t    UNREFERENCED_PARAMETER(quic);\n1280\t    UNREFERENCED_PARAMETER(cid);\n1281\t    UNREFERENCED_PARAMETER(fmt);\n1282\t#endif\n1283\t}\n1284\t#endif\n1285\t#if 0\n1286\t/* Log arrival or departure of an UDP datagram for an unknown connection */\n1287\tvoid binlog_ignore_quic_pdu(picoquic_quic_t* UNUSED(quic), int UNUSED(receiving), uint64_t UNUSED(current_time), uint64_t UNUSED(cid64),\n1288\t    const struct sockaddr* UNUSED(addr_peer), const struct sockaddr* UNUSED(addr_local), size_t UNUSED(packet_length))\n1289\t{\n1290\t#ifdef _WINDOWS\n1291\t    UNREFERENCED_PARAMETER(quic);\n1292\t\n1293\t    UNREFERENCED_PARAMETER(receiving);\n1294\t    UNREFERENCED_PARAMETER(current_time);\n1295\t    UNREFERENCED_PARAMETER(addr_peer);\n1296\t    UNREFERENCED_PARAMETER(addr_local);\n1297\t    UNREFERENCED_PARAMETER(packet_length);\n1298\t#endif\n1299\t}\n1300\t#endif\n1301\t/* Log an event relating to a specific connection */\n1302\tstatic void binlog_app_message(picoquic_cnx_t* cnx, const char* fmt, va_list vargs)\n1303\t{\n1304\t    if (cnx->f_binlog != NULL) {\n1305\t        picoquic_binlog_message_v(cnx, fmt, vargs);\n1306\t    }\n1307\t}\n1308\t\n1309\t/* Return from close with nothing, as this is per connection only */\n1310\tvoid binlog_close(picoquic_quic_t* UNUSED(quic))\n1311\t{\n1312\t#ifdef _WINDOWS\n1313\t    UNREFERENCED_PARAMETER(quic);\n1314\t#endif\n1315\t}\n1316\t\n1317\tstruct st_picoquic_unified_logging_t binlog_functions = {\n1318\t    /* Per context log function */\n1319\t    NULL, /* binlog_ignore_quic_app_message, */\n1320\t    NULL, /* binlog_ignore_quic_pdu*/\n1321\t    binlog_close,\n1322\t    /* Per connection functions */\n1323\t    binlog_app_message,\n1324\t    binlog_pdu_ex,\n1325\t    binlog_packet_ex,\n1326\t    binlog_dropped_packet,\n1327\t    binlog_buffered_packet,\n1328\t    binlog_outgoing_packet,\n1329\t    binlog_packet_lost,\n1330\t    binlog_negotiated_alpn,\n1331\t    binlog_transport_extension,\n1332\t    binlog_picotls_ticket_ex,\n1333\t    binlog_new_connection,\n1334\t    binlog_close_connection,\n1335\t    binlog_cc_dump\n1336\t};\n1337\t\n1338\tint picoquic_set_binlog(picoquic_quic_t* quic, char const* binlog_dir)\n1339\t{\n1340\t    quic->binlog_dir = picoquic_string_free(quic->binlog_dir);\n1341\t    quic->binlog_dir = picoquic_string_duplicate(binlog_dir);\n1342\t    quic->bin_log_fns = &binlog_functions;\n1343\t    return 0;\n1344\t}\n1345\t\n1346\tvoid picoquic_enable_binlog(picoquic_quic_t* quic)\n1347\t{\n1348\t    quic->bin_log_fns = &binlog_functions;\n1349\t}\n1350\t"}]},"parent_tool_use_id":null,"session_id":"621e8ef5-6ea2-41f7-92c8-884ed614789d","uuid":"6b624158-285d-45ca-9f41-1ee7de883f07","timestamp":"2026-05-06T12:22:55.026Z","tool_use_result":{"type":"text","file":{"filePath":"/Users/richbarn/Projects/picoquic/picoquic/logwriter.c","content":"/*\n* Author: Christian Huitema\n* Copyright (c) 2019, Private Octopus, Inc.\n* All rights reserved.\n*\n* Permission to use, copy, modify, and distribute this software for any\n* purpose with or without fee is hereby granted, provided that the above\n* copyright notice and this permission notice appear in all copies.\n*\n* THIS SOFTWARE IS PROVIDED BY THE COPYRIGHT HOLDERS AND CONTRIBUTORS \"AS IS\" AND\n* ANY EXPRESS OR IMPLIED WARRANTIES, INCLUDING, BUT NOT LIMITED TO, THE IMPLIED\n* WARRANTIES OF MERCHANTABILITY AND FITNESS FOR A PARTICULAR PURPOSE ARE\n* DISCLAIMED. IN NO EVENT SHALL Private Octopus, Inc. BE LIABLE FOR ANY\n* DIRECT, INDIRECT, INCIDENTAL, SPECIAL, EXEMPLARY, OR CONSEQUENTIAL DAMAGES\n* (INCLUDING, BUT NOT LIMITED TO, PROCUREMENT OF SUBSTITUTE GOODS OR SERVICES;\n* LOSS OF USE, DATA, OR PROFITS; OR BUSINESS INTERRUPTION) HOWEVER CAUSED AND\n* ON ANY THEORY OF LIABILITY, WHETHER IN CONTRACT, STRICT LIABILITY, OR TORT\n* (INCLUDING NEGLIGENCE OR OTHERWISE) ARISING IN ANY WAY OUT OF THE USE OF THIS\n* SOFTWARE, EVEN IF ADVISED OF THE POSSIBILITY OF SUCH DAMAGE.\n*/\n\n/*\n* Packet logging.\n*/\n\n#include <stdarg.h>\n#include \"picoquic_binlog.h\"\n#include \"bytestream.h\"\n#ifdef _WINDOWS\n#pragma warning(disable:4204)\n#endif\n#include \"tls_api.h\"\n#include \"picotls.h\"\n#include \"picoquic_unified_log.h\"\n#include \"picoquic_binlog.h\"\n\nstatic const uint8_t* picoquic_log_fixed_skip(const uint8_t* bytes, const uint8_t* bytes_max, size_t size)\n{\n    return bytes == NULL ? NULL : ((bytes += size) <= bytes_max ? bytes : NULL);\n}\n\nstatic const uint8_t* picoquic_log_varint_skip(const uint8_t* bytes, const uint8_t* bytes_max)\n{\n    return bytes == NULL ? NULL : (bytes < bytes_max ? picoquic_log_fixed_skip(bytes, bytes_max, VARINT_LEN_T(bytes, size_t)) : NULL);\n}\n\nstatic const uint8_t* picoquic_log_varint(const uint8_t* bytes, const uint8_t* bytes_max, uint64_t* n64)\n{\n    size_t len = (bytes == NULL) ? 0 : picoquic_varint_decode(bytes, bytes_max - bytes, n64);\n    return len == 0 ? NULL : bytes + len;\n}\n\nstatic const uint8_t* picoquic_log_length(const uint8_t* bytes, const uint8_t* bytes_max, size_t* nsz)\n{\n    uint64_t n64 = 0;\n    size_t len = 0;\n    if (bytes != NULL) {\n        len = picoquic_varint_decode(bytes, bytes_max - bytes, &n64);\n    }\n    *nsz = (size_t)n64;\n    return (len == 0 || *nsz != n64) ? NULL : bytes + len;\n}\n\nstatic void picoquic_binlog_frame(FILE* f, const uint8_t* bytes, const uint8_t* bytes_max)\n{\n    if (bytes != NULL && bytes_max != NULL) {\n        size_t len = bytes_max - bytes;\n        uint8_t varlen[8];\n        size_t l_varlen = picoquic_varint_encode(varlen, 8, len);\n        fwrite(varlen, 1, l_varlen, f);\n        fwrite(bytes, 1, len, f);\n    }\n}\n\nstatic const uint8_t* picoquic_log_stream_frame(FILE* f, const uint8_t* bytes, const uint8_t* bytes_max)\n{\n    const uint8_t* bytes_begin = bytes;\n    uint8_t ftype = bytes[0];\n    size_t length = 0;\n    uint8_t log_buffer[256];\n    int has_length = 0;\n    size_t extra_bytes = 8;\n\n    bytes = picoquic_log_fixed_skip(bytes, bytes_max, 1); /* type */\n    bytes = picoquic_log_varint_skip(bytes, bytes_max); /* stream */\n\n    if ((ftype & 4) != 0) {\n        bytes = picoquic_log_varint_skip(bytes, bytes_max); /* offset */\n    }\n\n    if (bytes != NULL) {\n        if ((ftype & 2) != 0) {\n            bytes = picoquic_log_length(bytes, bytes_max, &length); /* length */\n            has_length = 1;\n        }\n        else {\n            length = bytes_max - bytes;\n        }\n    }\n\n    if (bytes != NULL) {\n        if (length < extra_bytes) {\n            /* Add up to 8 bytes of content that can be documented in the qlog */\n            extra_bytes = length;\n        }\n        if (has_length) {\n            picoquic_binlog_frame(f, bytes_begin, bytes + extra_bytes);\n        }\n        else {\n            uint8_t* log_next = log_buffer;\n            size_t l_head = bytes - bytes_begin;\n\n            memcpy(log_buffer, bytes_begin, l_head);\n            log_next += l_head;\n            if ((log_next = picoquic_frames_varint_encode(log_next, log_buffer + 256, length)) != NULL) {\n                memcpy(log_next, bytes, extra_bytes);\n                log_next += extra_bytes;\n                picoquic_binlog_frame(f, log_buffer, log_next);\n            }\n            else {\n                picoquic_binlog_frame(f, log_buffer, log_buffer + l_head);\n            }\n        }\n\n        bytes = picoquic_log_fixed_skip(bytes, bytes_max, length);\n    }\n    else {\n        /* Cautiously log the beginning of the erroneous frame */\n        length = bytes_max - bytes_begin;\n        if (length > 26) {\n            length = 26;\n        }\n        picoquic_binlog_frame(f, bytes_begin, bytes_begin + length);\n    }\n    return bytes;\n}\n\nstatic const uint8_t* picoquic_log_ack_frame(FILE* f, const uint8_t* bytes, const uint8_t* bytes_max)\n{\n    const uint8_t* bytes_begin = bytes;\n    uint64_t ftype = 0;\n    uint64_t nb_blocks;\n\n    (void) picoquic_varint_decode(bytes, bytes_max - bytes, &ftype);\n\n    bytes = picoquic_log_varint_skip(bytes, bytes_max); /* Logging the frame type, maybe multiple bytes */\n\n    if (ftype == picoquic_frame_type_path_ack || ftype == picoquic_frame_type_path_ack_ecn) {\n        bytes = picoquic_log_varint_skip(bytes, bytes_max); /* Log the path_id */\n    }\n\n    bytes = picoquic_log_varint_skip(bytes, bytes_max);\n    bytes = picoquic_log_varint_skip(bytes, bytes_max);\n    bytes = picoquic_log_varint(bytes, bytes_max, &nb_blocks);\n\n    for (uint64_t i = 0; bytes != NULL && i <= nb_blocks; i++) {\n        if (i != 0) {\n            bytes = picoquic_log_varint_skip(bytes, bytes_max);\n        }\n        bytes = picoquic_log_varint_skip(bytes, bytes_max);\n    }\n    \n    if (ftype == picoquic_frame_type_ack_ecn || ftype == picoquic_frame_type_path_ack_ecn) {\n        bytes = picoquic_log_varint_skip(bytes, bytes_max);\n        bytes = picoquic_log_varint_skip(bytes, bytes_max);\n        bytes = picoquic_log_varint_skip(bytes, bytes_max);\n    }\n\n    picoquic_binlog_frame(f, bytes_begin, bytes);\n    return bytes;\n}\n\nstatic const uint8_t* picoquic_log_reset_stream_frame(FILE* f, const uint8_t* bytes, const uint8_t* bytes_max)\n{\n    const uint8_t * bytes_begin = bytes;\n\n    bytes = picoquic_log_fixed_skip(bytes, bytes_max, 1);\n    bytes = picoquic_log_varint_skip(bytes, bytes_max);\n    bytes = picoquic_log_varint_skip(bytes, bytes_max);\n    bytes = picoquic_log_varint_skip(bytes, bytes_max);\n\n    picoquic_binlog_frame(f, bytes_begin, bytes);\n    return bytes;\n}\n\nstatic const uint8_t* picoquic_log_reset_stream_at_frame(FILE* f, const uint8_t* bytes, const uint8_t* bytes_max)\n{\n    const uint8_t* bytes_begin = bytes;\n\n    bytes = picoquic_log_fixed_skip(bytes, bytes_max, 1);\n    bytes = picoquic_log_varint_skip(bytes, bytes_max);\n    bytes = picoquic_log_varint_skip(bytes, bytes_max);\n    bytes = picoquic_log_varint_skip(bytes, bytes_max);\n    bytes = picoquic_log_varint_skip(bytes, bytes_max);\n\n    picoquic_binlog_frame(f, bytes_begin, bytes);\n    return bytes;\n}\n\nstatic const uint8_t* picoquic_log_stop_sending_frame(FILE* f, const uint8_t* bytes, const uint8_t* bytes_max)\n{\n    const uint8_t* bytes_begin = bytes;\n\n    bytes = picoquic_log_fixed_skip(bytes, bytes_max, 1);\n    bytes = picoquic_log_varint_skip(bytes, bytes_max);\n    bytes = picoquic_log_varint_skip(bytes, bytes_max);\n\n    picoquic_binlog_frame(f, bytes_begin, bytes);\n    return bytes;\n}\n\nstatic const uint8_t* picoquic_log_close_frame(FILE* f, const uint8_t* bytes, const uint8_t* bytes_max)\n{\n    const uint8_t* bytes_begin = bytes;\n    size_t length = 0;\n\n    bytes = picoquic_log_fixed_skip(bytes, bytes_max, 1);\n    bytes = picoquic_log_varint_skip(bytes, bytes_max);\n    bytes = picoquic_log_varint_skip(bytes, bytes_max);\n    bytes = picoquic_log_length(bytes, bytes_max, &length);\n    bytes = picoquic_log_fixed_skip(bytes, bytes_max, length);\n\n    picoquic_binlog_frame(f, bytes_begin, bytes);\n    return bytes;\n}\n\nstatic const uint8_t* picoquic_log_app_close_frame(FILE* f, const uint8_t* bytes, const uint8_t* bytes_max)\n{\n    const uint8_t* bytes_begin = bytes;\n    size_t length = 0;\n\n    bytes = picoquic_log_fixed_skip(bytes, bytes_max, 1);\n    bytes = picoquic_log_varint_skip(bytes, bytes_max);\n    bytes = picoquic_log_length(bytes, bytes_max, &length);\n    bytes = picoquic_log_fixed_skip(bytes, bytes_max, length);\n\n    picoquic_binlog_frame(f, bytes_begin, bytes);\n    return bytes;\n}\n\nstatic const uint8_t* picoquic_log_max_data_frame(FILE* f, const uint8_t* bytes, const uint8_t* bytes_max)\n{\n    const uint8_t* bytes_begin = bytes;\n\n    bytes = picoquic_log_fixed_skip(bytes, bytes_max, 1);\n    bytes = picoquic_log_varint_skip(bytes, bytes_max);\n\n    picoquic_binlog_frame(f, bytes_begin, bytes);\n    return bytes;\n}\n\nstatic const uint8_t* picoquic_log_max_stream_data_frame(FILE* f, const uint8_t* bytes, const uint8_t* bytes_max)\n{\n    const uint8_t* bytes_begin = bytes;\n\n    bytes = picoquic_log_fixed_skip(bytes, bytes_max, 1);\n    bytes = picoquic_log_varint_skip(bytes, bytes_max);\n    bytes = picoquic_log_varint_skip(bytes, bytes_max);\n\n    picoquic_binlog_frame(f, bytes_begin, bytes);\n    return bytes;\n}\n\nstatic const uint8_t* picoquic_log_max_stream_id_frame(FILE* f, const uint8_t* bytes, const uint8_t* bytes_max)\n{\n    const uint8_t* bytes_begin = bytes;\n\n    bytes = picoquic_log_fixed_skip(bytes, bytes_max, 1);\n    bytes = picoquic_log_varint_skip(bytes, bytes_max);\n\n    picoquic_binlog_frame(f, bytes_begin, bytes);\n    return bytes;\n}\n\nstatic const uint8_t* picoquic_log_blocked_frame(FILE* f, const uint8_t* bytes, const uint8_t* bytes_max)\n{\n    const uint8_t* bytes_begin = bytes;\n\n    bytes = picoquic_log_fixed_skip(bytes, bytes_max, 1);\n    bytes = picoquic_log_varint_skip(bytes, bytes_max);\n\n    picoquic_binlog_frame(f, bytes_begin, bytes);\n    return bytes;\n}\n\nstatic const uint8_t* picoquic_log_stream_blocked_frame(FILE* f, const uint8_t* bytes, const uint8_t* bytes_max)\n{\n    const uint8_t* bytes_begin = bytes;\n\n    bytes = picoquic_log_fixed_skip(bytes, bytes_max, 1);\n    bytes = picoquic_log_varint_skip(bytes, bytes_max);\n    bytes = picoquic_log_varint_skip(bytes, bytes_max);\n\n    picoquic_binlog_frame(f, bytes_begin, bytes);\n    return bytes;\n}\n\nstatic const uint8_t* picoquic_log_streams_blocked_frame(FILE* f, const uint8_t* bytes, const uint8_t* bytes_max)\n{\n    const uint8_t* bytes_begin = bytes;\n\n    bytes = picoquic_log_fixed_skip(bytes, bytes_max, 1);\n    bytes = picoquic_log_varint_skip(bytes, bytes_max);\n\n    picoquic_binlog_frame(f, bytes_begin, bytes);\n    return bytes;\n}\n\nstatic const uint8_t* picoquic_log_new_connection_id_frame(FILE* f, const uint8_t* bytes, const uint8_t* bytes_max)\n{\n    const uint8_t* bytes_begin = bytes;\n\n    bytes = picoquic_log_fixed_skip(bytes, bytes_max, 1);\n    bytes = picoquic_log_varint_skip(bytes, bytes_max);\n    bytes = picoquic_log_varint_skip(bytes, bytes_max);\n    if (bytes != NULL) {\n        bytes = picoquic_log_fixed_skip(bytes, bytes_max, ((size_t)1) + bytes[0]);\n    }\n\n    bytes = picoquic_log_fixed_skip(bytes, bytes_max, PICOQUIC_RESET_SECRET_SIZE);\n\n    picoquic_binlog_frame(f, bytes_begin, bytes);\n    return bytes;\n}\n\nstatic const uint8_t* picoquic_log_path_new_connection_id_frame(FILE* f, const uint8_t* bytes, const uint8_t* bytes_max)\n{\n    const uint8_t* bytes_begin = bytes;\n\n    bytes = picoquic_log_varint_skip(bytes, bytes_max);\n    bytes = picoquic_log_varint_skip(bytes, bytes_max);\n    bytes = picoquic_log_varint_skip(bytes, bytes_max);\n    bytes = picoquic_log_varint_skip(bytes, bytes_max);\n    if (bytes != NULL) {\n        bytes = picoquic_log_fixed_skip(bytes, bytes_max, ((size_t)1) + bytes[0]);\n    }\n\n    bytes = picoquic_log_fixed_skip(bytes, bytes_max, PICOQUIC_RESET_SECRET_SIZE);\n\n    picoquic_binlog_frame(f, bytes_begin, bytes);\n    return bytes;\n}\n\nstatic const uint8_t* picoquic_log_retire_connection_id_frame(FILE* f, const uint8_t* bytes, const uint8_t* bytes_max)\n{\n    const uint8_t* bytes_begin = bytes;\n\n    bytes = picoquic_log_fixed_skip(bytes, bytes_max, 1);\n    bytes = picoquic_log_varint_skip(bytes, bytes_max);\n\n    picoquic_binlog_frame(f, bytes_begin, bytes);\n    return bytes;\n}\n\nstatic const uint8_t* picoquic_log_path_retire_connection_id_frame(FILE* f, const uint8_t* bytes, const uint8_t* bytes_max)\n{\n    const uint8_t* bytes_begin = bytes;\n\n    bytes = picoquic_log_varint_skip(bytes, bytes_max);\n    bytes = picoquic_log_varint_skip(bytes, bytes_max);\n    bytes = picoquic_log_varint_skip(bytes, bytes_max);\n\n    picoquic_binlog_frame(f, bytes_begin, bytes);\n    return bytes;\n}\n\nstatic const uint8_t* picoquic_log_new_token_frame(FILE* f, const uint8_t* bytes, const uint8_t* bytes_max)\n{\n    const uint8_t* bytes_begin = bytes;\n    size_t length = 0;\n\n    bytes = picoquic_log_fixed_skip(bytes, bytes_max, 1);\n    bytes = picoquic_log_length(bytes, bytes_max, &length);\n\n    bytes = picoquic_log_fixed_skip(bytes, bytes_max, length);\n\n    picoquic_binlog_frame(f, bytes_begin, bytes);\n    return bytes;\n}\n\nstatic const uint8_t* picoquic_log_path_frame(FILE* f, const uint8_t* bytes, const uint8_t* bytes_max)\n{\n    const uint8_t* bytes_begin = bytes;\n\n    bytes = picoquic_log_fixed_skip(bytes, bytes_max, 1 + 8);\n\n    picoquic_binlog_frame(f, bytes_begin, bytes);\n    return bytes;\n}\n\nstatic const uint8_t* picoquic_log_crypto_hs_frame(FILE* f, const uint8_t* bytes, const uint8_t* bytes_max)\n{\n    const uint8_t* bytes_begin = bytes;\n    size_t length = 0;\n\n    bytes = picoquic_log_fixed_skip(bytes, bytes_max, 1);\n    bytes = picoquic_log_varint_skip(bytes, bytes_max);\n    bytes = picoquic_log_length(bytes, bytes_max, &length);\n\n    picoquic_binlog_frame(f, bytes_begin, bytes);\n\n    bytes = picoquic_log_fixed_skip(bytes, bytes_max, length);\n    return bytes;\n}\n\n\nstatic const uint8_t* picoquic_log_handshake_done_frame(FILE* f, const uint8_t* bytes, const uint8_t* bytes_max)\n{\n    const uint8_t* bytes_begin = bytes;\n\n    bytes = picoquic_log_fixed_skip(bytes, bytes_max, 1);\n\n    picoquic_binlog_frame(f, bytes_begin, bytes);\n    return bytes;\n}\n\nstatic const uint8_t* picoquic_log_datagram_frame(FILE* f, const uint8_t* bytes, const uint8_t* bytes_max)\n{\n    const uint8_t* bytes_begin = bytes;\n    uint8_t ftype = bytes[0];\n    size_t length = 0;\n\n    bytes = picoquic_log_fixed_skip(bytes, bytes_max, 1);\n\n    if (ftype & 1) {\n        bytes = picoquic_log_length(bytes, bytes_max, &length);\n    } else {\n        length = bytes_max - bytes;\n    }\n\n    picoquic_binlog_frame(f, bytes_begin, bytes);\n\n    bytes = picoquic_log_fixed_skip(bytes, bytes_max, length);\n    return bytes;\n}\n\nstatic const uint8_t* picoquic_log_time_stamp_frame(FILE* f, const uint8_t* bytes, const uint8_t* bytes_max)\n{\n    const uint8_t* bytes_begin = bytes;\n\n    bytes = picoquic_log_varint_skip(bytes, bytes_max); /* frame type as varint */\n    bytes = picoquic_log_varint_skip(bytes, bytes_max); /* time stamp as varint */\n\n    picoquic_binlog_frame(f, bytes_begin, bytes);\n\n    return bytes;\n}\n\nstatic const uint8_t* picoquic_log_path_abandon_frame(FILE* f, const uint8_t* bytes, const uint8_t* bytes_max)\n{\n    const uint8_t* bytes_begin = bytes;\n    bytes = picoquic_log_varint_skip(bytes, bytes_max); /* frame type as varint */\n    bytes = picoquic_skip_path_abandon_frame(bytes, bytes_max); /* skip abandon frame */\n    picoquic_binlog_frame(f, bytes_begin, bytes);\n\n    return bytes;\n}\n\nstatic const uint8_t* picoquic_log_path_available_or_backup_frame(FILE* f, const uint8_t* bytes, const uint8_t* bytes_max)\n{\n    const uint8_t* bytes_begin = bytes;\n    bytes = picoquic_log_varint_skip(bytes, bytes_max); /* frame type as varint */\n    bytes = picoquic_skip_path_available_or_backup_frame(bytes, bytes_max); /* skip available or backup frame */\n    picoquic_binlog_frame(f, bytes_begin, bytes);\n\n    return bytes;\n}\n\n\nstatic const uint8_t* picoquic_log_ack_frequency_frame(FILE* f, const uint8_t* bytes, const uint8_t* bytes_max)\n{\n    const uint8_t* bytes_begin = bytes;\n\n    bytes = picoquic_log_varint_skip(bytes, bytes_max); /* frame type as varint */\n    bytes = picoquic_log_varint_skip(bytes, bytes_max); /* Seq num */\n    bytes = picoquic_log_varint_skip(bytes, bytes_max); /* Packet tolerance */\n    bytes = picoquic_log_varint_skip(bytes, bytes_max); /* Max ACK delay */\n    bytes = picoquic_log_varint_skip(bytes, bytes_max); /* Reordering threshold */\n\n    picoquic_binlog_frame(f, bytes_begin, bytes);\n\n    return bytes;\n}\n\nstatic const uint8_t* picoquic_log_immediate_ack_frame(FILE* f, const uint8_t* bytes, const uint8_t* bytes_max)\n{\n    const uint8_t* bytes_begin = bytes;\n\n    bytes = picoquic_log_varint_skip(bytes, bytes_max); /* frame type as varint */\n    picoquic_binlog_frame(f, bytes_begin, bytes);\n\n    return bytes;\n}\n\nstatic const uint8_t* picoquic_log_erroring_frame(FILE* f, const uint8_t* bytes, const uint8_t* bytes_max)\n{\n    size_t frame_size = bytes_max - bytes;\n    size_t copied = (frame_size > 8) ? 8 : frame_size;\n\n    picoquic_binlog_frame(f, bytes, bytes + copied);\n\n    return NULL;\n}\n\nstatic const uint8_t* picoquic_log_padding(FILE* f, const uint8_t* bytes, const uint8_t* bytes_max)\n{\n    picoquic_binlog_frame(f, bytes, bytes + 1);\n\n    uint8_t ftype = bytes[0];\n    while (bytes < bytes_max && bytes[0] == ftype) {\n        bytes++;\n    }\n\n    return bytes;\n}\n\nstatic const uint8_t* picoquic_log_bdp_frame(FILE* f, const uint8_t* bytes, const uint8_t* bytes_max)\n{\n    const uint8_t* bytes_begin = bytes;\n    size_t ip_len = 0;\n\n    bytes = picoquic_log_varint_skip(bytes, bytes_max); /* Frame type */\n    bytes = picoquic_log_varint_skip(bytes, bytes_max); /* Life time */\n    bytes = picoquic_log_varint_skip(bytes, bytes_max); /* Bytes in flight */\n    bytes = picoquic_log_varint_skip(bytes, bytes_max); /* min rtt */\n    bytes = picoquic_log_length(bytes, bytes_max, &ip_len); /*  IP Address length */\n    bytes = picoquic_log_fixed_skip(bytes, bytes_max, ip_len); /* IP address value */\n\n    picoquic_binlog_frame(f, bytes_begin, bytes);\n\n    return bytes;\n}\n\nstatic const uint8_t* picoquic_log_observed_address_frame(FILE* f, const uint8_t* bytes, const uint8_t* bytes_max, uint64_t ftype)\n{\n    const uint8_t* bytes_begin = bytes;\n    size_t ip_len = ((ftype & 1) == 0) ? 4 : 16;\n    size_t data_len = ip_len + 2;\n\n\n    bytes = picoquic_log_varint_skip(bytes, bytes_max); /* Frame type */\n    bytes = picoquic_log_varint_skip(bytes, bytes_max); /* Sequence number */\n    bytes = picoquic_log_fixed_skip(bytes, bytes_max, data_len); /* IP address and port */\n\n    picoquic_binlog_frame(f, bytes_begin, bytes);\n\n    return bytes;\n}\n\nvoid picoquic_binlog_frames(FILE * f, const uint8_t* bytes, size_t length)\n{\n    const uint8_t* bytes_max = bytes + length;\n\n    while (bytes != NULL && bytes < bytes_max) {\n        uint64_t ftype= 0;\n        size_t ftype_ll = picoquic_varint_decode(bytes, length, &ftype);\n\n        if (ftype_ll == 0) {\n            /* Error, incorrect frame type encoding */\n            bytes = NULL;\n            break;\n        }\n        else if (ftype < 64 && ftype_ll != 1) {\n            /* Error, incorrect frame type encoding */\n            bytes = NULL;\n            break;\n        }\n\n        if (PICOQUIC_IN_RANGE(ftype, picoquic_frame_type_stream_range_min, picoquic_frame_type_stream_range_max)) {\n            bytes = picoquic_log_stream_frame(f, bytes, bytes_max);\n            continue;\n        }\n\n        switch (ftype) {\n        case picoquic_frame_type_ack:\n        case picoquic_frame_type_ack_ecn:\n        case picoquic_frame_type_path_ack:\n        case picoquic_frame_type_path_ack_ecn:\n            bytes = picoquic_log_ack_frame(f, bytes, bytes_max);\n            break;\n        case picoquic_frame_type_retire_connection_id:\n            bytes = picoquic_log_retire_connection_id_frame(f, bytes, bytes_max);\n            break;\n        case picoquic_frame_type_path_retire_connection_id:\n            bytes = picoquic_log_path_retire_connection_id_frame(f, bytes, bytes_max);\n            break;\n        case picoquic_frame_type_padding:\n        case picoquic_frame_type_ping:\n            bytes = picoquic_log_padding(f, bytes, bytes_max);\n            break;\n        case picoquic_frame_type_reset_stream:\n            bytes = picoquic_log_reset_stream_frame(f, bytes, bytes_max);\n            break;\n        case picoquic_frame_type_reset_stream_at:\n            bytes = picoquic_log_reset_stream_at_frame(f, bytes, bytes_max);\n            break;\n        case picoquic_frame_type_connection_close:\n            bytes = picoquic_log_close_frame(f, bytes, bytes_max);\n            break;\n        case picoquic_frame_type_application_close:\n            bytes = picoquic_log_app_close_frame(f, bytes, bytes_max);\n            break;\n        case picoquic_frame_type_max_data:\n            bytes = picoquic_log_max_data_frame(f, bytes, bytes_max);\n            break;\n        case picoquic_frame_type_max_stream_data:\n            bytes = picoquic_log_max_stream_data_frame(f, bytes, bytes_max);\n            break;\n        case picoquic_frame_type_max_streams_bidir:\n        case picoquic_frame_type_max_streams_unidir:\n            bytes = picoquic_log_max_stream_id_frame(f, bytes, bytes_max);\n            break;\n        case picoquic_frame_type_data_blocked:\n            bytes = picoquic_log_blocked_frame(f, bytes, bytes_max);\n            break;\n        case picoquic_frame_type_stream_data_blocked:\n            bytes = picoquic_log_stream_blocked_frame(f, bytes, bytes_max);\n            break;\n        case picoquic_frame_type_streams_blocked_bidir:\n        case picoquic_frame_type_streams_blocked_unidir:\n            bytes = picoquic_log_streams_blocked_frame(f, bytes, bytes_max);\n            break;\n        case picoquic_frame_type_new_connection_id:\n            bytes = picoquic_log_new_connection_id_frame(f, bytes, bytes_max);\n            break;\n        case picoquic_frame_type_path_new_connection_id:\n            bytes = picoquic_log_path_new_connection_id_frame(f, bytes, bytes_max);\n            break;\n        case picoquic_frame_type_stop_sending:\n            bytes = picoquic_log_stop_sending_frame(f, bytes, bytes_max);\n            break;\n        case picoquic_frame_type_path_challenge:\n        case picoquic_frame_type_path_response:\n            bytes = picoquic_log_path_frame(f, bytes, bytes_max);\n            break;\n        case picoquic_frame_type_crypto_hs:\n            bytes = picoquic_log_crypto_hs_frame(f, bytes, bytes_max);\n            break;\n        case picoquic_frame_type_new_token:\n            bytes = picoquic_log_new_token_frame(f, bytes, bytes_max);\n            break;\n        case picoquic_frame_type_handshake_done:\n            bytes = picoquic_log_handshake_done_frame(f, bytes, bytes_max);\n            break;\n        case picoquic_frame_type_datagram:\n        case picoquic_frame_type_datagram_l:\n            bytes = picoquic_log_datagram_frame(f, bytes, bytes_max);\n            break;\n        case picoquic_frame_type_ack_frequency:\n            bytes = picoquic_log_ack_frequency_frame(f, bytes, bytes_max);\n            break;\n        case picoquic_frame_type_immediate_ack:\n            bytes = picoquic_log_immediate_ack_frame(f, bytes, bytes_max);\n            break;\n        case picoquic_frame_type_time_stamp:\n            bytes = picoquic_log_time_stamp_frame(f, bytes, bytes_max);\n            break;\n        case picoquic_frame_type_path_abandon:\n            bytes = picoquic_log_path_abandon_frame(f, bytes, bytes_max);\n            break;\n        case picoquic_frame_type_path_backup:\n        case picoquic_frame_type_path_available:\n            bytes = picoquic_log_path_available_or_backup_frame(f, bytes, bytes_max);\n            break;\n        case picoquic_frame_type_bdp:\n            bytes = picoquic_log_bdp_frame(f, bytes, bytes_max);\n            break;\n        case picoquic_frame_type_observed_address_v4:\n        case picoquic_frame_type_observed_address_v6:\n            bytes = picoquic_log_observed_address_frame(f, bytes, bytes_max, ftype);\n            break;\n        default:\n            bytes = picoquic_log_erroring_frame(f, bytes, bytes_max);\n            break;\n        }\n    }\n}\n\nstatic void binlog_compose_event_header(bytestream* msg, const picoquic_connection_id_t* cid, uint64_t current_time,\n    uint64_t path_id, picoquic_log_event_type event_type)\n{\n    /* Common chunk header */\n    bytewrite_cid(msg, cid);\n    bytewrite_vint(msg, current_time);\n    bytewrite_vint(msg, path_id);\n    bytewrite_vint(msg, (uint64_t)event_type);\n}\n\nstatic uint64_t binlog_get_path_id(picoquic_cnx_t* cnx, picoquic_path_t* path_x)\n{\n    uint64_t path_id = 0;\n\n    if (cnx->is_multipath_enabled && path_x != NULL) {\n        path_id = path_x->unique_path_id;\n    }\n\n    return path_id;\n}\n\nvoid binlog_pdu(FILE* f, const picoquic_connection_id_t* cid, int receiving, uint64_t current_time,\n    const struct sockaddr* addr_peer, const struct sockaddr* addr_local, size_t packet_length,\n    uint64_t unique_path_id, unsigned char ecn)\n{\n    bytestream_buf stream_msg;\n    bytestream* msg = bytestream_buf_init(&stream_msg, BYTESTREAM_MAX_BUFFER_SIZE);\n\n    /* Common chunk header */\n    binlog_compose_event_header(msg, cid, current_time, 0, picoquic_log_event_pdu_sent + receiving);\n\n    /* PDU information */\n    bytewrite_addr(msg, addr_peer);\n    bytewrite_vint(msg, packet_length);\n    bytewrite_addr(msg, addr_local);\n    bytewrite_vint(msg, unique_path_id);\n    bytewrite_int8(msg, ecn);\n\n    uint8_t head[4] = { 0 };\n    picoformat_32(head, (uint32_t)bytestream_length(msg));\n\n    (void)fwrite(head, sizeof(head), 1, f);\n    (void)fwrite(bytestream_data(msg), bytestream_length(msg), 1, f);\n}\n\nstatic void binlog_pdu_ex(picoquic_cnx_t* cnx, int receiving, uint64_t current_time,\n    const struct sockaddr* addr_peer, const struct sockaddr* addr_local, size_t packet_length,\n    uint64_t unique_path_id, unsigned char ecn)\n{\n    if (cnx != NULL && cnx->f_binlog != NULL && picoquic_cnx_is_still_logging(cnx)) {\n        binlog_pdu(cnx->f_binlog, &cnx->initial_cnxid, receiving, current_time, addr_peer, addr_local, packet_length,\n            unique_path_id, ecn);\n    }\n}\n\nvoid binlog_packet(FILE* f, const picoquic_connection_id_t* cid, uint64_t path_id, int receiving, uint64_t current_time,\n    const picoquic_packet_header* ph, const uint8_t* bytes, size_t bytes_max)\n{\n    long fpos0 = ftell(f);\n\n    uint8_t head[4] = { 0 };\n    (void)fwrite(head, 4, 1, f);\n\n    bytestream_buf stream_msg;\n    bytestream* msg = bytestream_buf_init(&stream_msg, BYTESTREAM_MAX_BUFFER_SIZE);\n\n    /* Common chunk header */\n    binlog_compose_event_header(msg, cid, current_time, path_id, picoquic_log_event_packet_sent + receiving);\n\n    /* packet information */\n    bytewrite_vint(msg, bytes_max);\n\n    /* packet header */\n    bytewrite_int8(msg, (uint8_t)(64*ph->quic_bit_is_zero + 2 * ph->spin + ph->key_phase));\n    bytewrite_vint(msg, ph->payload_length);\n    bytewrite_vint(msg, ph->ptype);\n    bytewrite_vint(msg, ph->pn64);\n\n    bytewrite_cid(msg, &ph->dest_cnx_id);\n    bytewrite_cid(msg, &ph->srce_cnx_id);\n\n    if (ph->ptype != picoquic_packet_1rtt_protected &&\n        ph->ptype != picoquic_packet_version_negotiation) {\n        bytewrite_int32(msg, ph->vn);\n    }\n\n    if (ph->ptype == picoquic_packet_initial) {\n        bytewrite_vint(msg, ph->token_length);\n        bytewrite_buffer(msg, ph->token_bytes, ph->token_length);\n    }\n\n    (void)fwrite(bytestream_data(msg), bytestream_length(msg), 1, f);\n\n    /* frame information */\n    if (ph->ptype == picoquic_packet_version_negotiation || ph->ptype == picoquic_packet_retry) {\n        picoquic_binlog_frame(f, bytes + ph->offset, bytes + bytes_max);\n    }\n    else if (ph->ptype != picoquic_packet_error) {\n        picoquic_binlog_frames(f, bytes + ph->offset, ph->payload_length);\n    }\n\n    /* re-write chunk size field */\n    long fpos1 = ftell(f);\n\n    picoformat_32(head, (uint32_t)(fpos1 - fpos0 - 4));\n\n    (void)fseek(f, fpos0, SEEK_SET);\n    (void)fwrite(head, 4, 1, f);\n    (void)fseek(f, 0, SEEK_END);\n}\n\nstatic void binlog_packet_ex(picoquic_cnx_t* cnx, picoquic_path_t * path_x, int receiving, uint64_t current_time,\n    picoquic_packet_header* ph, const uint8_t* bytes, size_t bytes_max)\n{\n    if (cnx != NULL && cnx->f_binlog != NULL && picoquic_cnx_is_still_logging(cnx)) {\n        binlog_packet(cnx->f_binlog, &cnx->initial_cnxid, binlog_get_path_id(cnx, path_x),\n            receiving, current_time, ph, bytes, bytes_max);\n    }\n}\n\nvoid binlog_dropped_packet(picoquic_cnx_t* cnx, picoquic_path_t* path_x,\n    picoquic_packet_header* ph, size_t packet_size, int err, uint64_t current_time)\n{\n    FILE* f = cnx->f_binlog;\n    bytestream_buf stream_msg;\n    bytestream* msg = bytestream_buf_init(&stream_msg, BYTESTREAM_MAX_BUFFER_SIZE);\n\n    bytewrite_int32(msg, 0);\n    /* Common chunk header */\n    binlog_compose_event_header(msg, &cnx->initial_cnxid, current_time, binlog_get_path_id(cnx, path_x),\n        picoquic_log_event_packet_dropped);\n    /* Event header */\n    bytewrite_vint(msg, ph->ptype);\n    bytewrite_vint(msg, packet_size);\n    bytewrite_vint(msg, err);\n\n    /* write the frame length at the reserved spot, and save to log file*/\n    picoformat_32(msg->data, (uint32_t)(msg->ptr - 4));\n    (void)fwrite(bytestream_data(msg), bytestream_length(msg), 1, f);\n}\n\nvoid binlog_buffered_packet(picoquic_cnx_t* cnx, picoquic_path_t* path_x, \n    picoquic_packet_type_enum ptype, uint64_t current_time)\n{\n    FILE* f = cnx->f_binlog;\n    bytestream_buf stream_msg;\n    bytestream* msg = bytestream_buf_init(&stream_msg, BYTESTREAM_MAX_BUFFER_SIZE);\n\n    bytewrite_int32(msg, 0);\n    /* Common chunk header */\n    binlog_compose_event_header(msg, &cnx->initial_cnxid, current_time, binlog_get_path_id(cnx, path_x),\n        picoquic_log_event_packet_buffered);\n    /* Event header */\n    bytewrite_vint(msg, ptype);\n    (void)bytewrite_cstr(msg, \"keys_unavailable\");\n\n    /* write the frame length at the reserved spot, and save to log file*/\n    picoformat_32(msg->data, (uint32_t)(msg->ptr - 4));\n    (void)fwrite(bytestream_data(msg), bytestream_length(msg), 1, f);\n}\n\n\nvoid binlog_outgoing_packet(picoquic_cnx_t* cnx, picoquic_path_t * path_x,\n    uint8_t * bytes, uint64_t sequence_number, size_t pn_length, size_t length,\n    uint8_t* send_buffer, size_t send_length, uint64_t current_time)\n{\n    FILE* f = cnx->f_binlog;\n\n    picoquic_cnx_t* pcnx = cnx;\n    picoquic_packet_header ph;\n    size_t checksum_length = 16;\n    struct sockaddr_in default_addr;\n\n    const picoquic_connection_id_t * cnxid = (cnx != NULL) ? &cnx->initial_cnxid : &picoquic_null_connection_id;\n\n    memset(&default_addr, 0, sizeof(struct sockaddr_in));\n    default_addr.sin_family = AF_INET;\n\n    picoquic_parse_packet_header((cnx == NULL) ? NULL : cnx->quic, send_buffer, send_length,\n        ((cnx == NULL || cnx->path[0] == NULL) ? (struct sockaddr *)&default_addr :\n        (struct sockaddr *)&cnx->path[0]->first_tuple->local_addr), &ph, &pcnx, 0);\n\n    if (cnx != NULL) {\n        picoquic_epoch_enum epoch = (ph.ptype == picoquic_packet_1rtt_protected) ? picoquic_epoch_1rtt :\n            ((ph.ptype == picoquic_packet_0rtt_protected) ? picoquic_epoch_0rtt :\n            ((ph.ptype == picoquic_packet_handshake) ? picoquic_epoch_handshake : picoquic_epoch_initial));\n        if (cnx->crypto_context[epoch].aead_encrypt != NULL) {\n            checksum_length = picoquic_get_checksum_length(cnx, epoch);\n        }\n    }\n\n    ph.pn64 = sequence_number;\n    ph.pn = (uint32_t)ph.pn64;\n    if (ph.ptype != picoquic_packet_retry) {\n        if (ph.pn_offset != 0) {\n            ph.offset = ph.pn_offset + pn_length;\n            ph.payload_length -= pn_length;\n        }\n    }\n    if (ph.ptype != picoquic_packet_version_negotiation) {\n        if (ph.payload_length > checksum_length) {\n            ph.payload_length -= (uint16_t)checksum_length;\n        }\n        else {\n            ph.payload_length = 0;\n        }\n    }\n\n    binlog_packet(f, cnxid, binlog_get_path_id(cnx, path_x),  0, current_time, &ph, bytes, length);\n}\n\nvoid binlog_packet_lost(picoquic_cnx_t* cnx, picoquic_path_t* path_x,\n    picoquic_packet_type_enum ptype,  uint64_t sequence_number, char const * trigger,\n    picoquic_connection_id_t * dcid, size_t packet_size,\n    uint64_t current_time)\n{\n    FILE* f = cnx->f_binlog;\n\n    bytestream_buf stream_msg;\n    bytestream* msg = bytestream_buf_init(&stream_msg, BYTESTREAM_MAX_BUFFER_SIZE);\n\n    bytewrite_int32(msg, 0);\n    /* Common chunk header */\n    binlog_compose_event_header(msg, &cnx->initial_cnxid, current_time, binlog_get_path_id(cnx, path_x), picoquic_log_event_packet_lost);\n    /* Event header */\n    bytewrite_vint(msg, ptype);\n    bytewrite_vint(msg, sequence_number);\n    bytewrite_cstr(msg, trigger);\n    if (dcid != NULL) {\n        bytewrite_cid(msg, dcid);\n    }\n    else {\n        bytewrite_int8(msg, 0);\n    }\n    bytewrite_vint(msg, packet_size);\n\n    /* write the frame length at the reserved spot, and save to log file*/\n    picoformat_32(msg->data, (uint32_t)(msg->ptr - 4));\n    (void)fwrite(bytestream_data(msg), bytestream_length(msg), 1, f);\n}\n\n\nvoid binlog_negotiated_alpn(picoquic_cnx_t* cnx, int is_local,\n    uint8_t const * sni, size_t sni_len, uint8_t const* alpn, size_t alpn_len,\n    const ptls_iovec_t* alpn_list, size_t alpn_count)\n{\n    FILE* f = cnx->f_binlog;\n\n    bytestream_buf stream_msg;\n    bytestream* msg = bytestream_buf_init(&stream_msg, BYTESTREAM_MAX_BUFFER_SIZE);\n    /* Common chunk header */\n    binlog_compose_event_header(msg, &cnx->initial_cnxid, picoquic_get_quic_time(cnx->quic), 0, picoquic_log_event_alpn_update);\n    /* Event header */\n    bytewrite_vint(msg, is_local);\n    bytewrite_vint(msg, sni_len);\n    if (sni_len > 0) {\n        bytewrite_buffer(msg, sni, sni_len);\n    }\n\n    bytewrite_vint(msg, alpn_count);\n    if (alpn_count > 0) {\n        for (size_t i = 0; i < alpn_count; i++) {\n            bytewrite_vint(msg, alpn_list[i].len);\n            bytewrite_buffer(msg, alpn_list[i].base, alpn_list[i].len);\n        }\n    }\n\n    bytewrite_vint(msg, alpn_len);\n    if (alpn_len > 0) {\n        bytewrite_buffer(msg, alpn, alpn_len);\n    }\n\n    bytestream_buf stream_head;\n    bytestream* head = bytestream_buf_init(&stream_head, 4);\n    bytewrite_int32(head, (uint32_t)bytestream_length(msg));\n\n    (void)fwrite(bytestream_data(head), bytestream_length(head), 1, f);\n    (void)fwrite(bytestream_data(msg), bytestream_length(msg), 1, f);\n}\n\nvoid binlog_transport_extension(picoquic_cnx_t* cnx, int is_local,\n    size_t param_length, uint8_t* params)\n{\n    FILE* f = cnx->f_binlog;\n\n    bytestream_buf stream_msg;\n    bytestream* msg = bytestream_buf_init(&stream_msg, BYTESTREAM_MAX_BUFFER_SIZE);\n    /* Common chunk header */\n    binlog_compose_event_header(msg, &cnx->initial_cnxid, picoquic_get_quic_time(cnx->quic), 0, picoquic_log_event_param_update);\n    /* Event header */\n    bytewrite_vint(msg, is_local);\n    bytewrite_vint(msg, param_length);\n\n    if (param_length > 0) {\n        bytewrite_buffer(msg, params, param_length);\n    }\n\n    bytestream_buf stream_head;\n    bytestream* head = bytestream_buf_init(&stream_head, 4);\n    bytewrite_int32(head, (uint32_t)bytestream_length(msg));\n\n    (void)fwrite(bytestream_data(head), bytestream_length(head), 1, f);\n    (void)fwrite(bytestream_data(msg), bytestream_length(msg), 1, f);\n}\n\nvoid binlog_picotls_ticket(FILE* f, picoquic_connection_id_t cnx_id,\n    uint8_t* ticket, uint16_t ticket_length)\n{\n    bytestream_buf stream_msg;\n    bytestream * msg = bytestream_buf_init(&stream_msg, BYTESTREAM_MAX_BUFFER_SIZE);\n    /* Common chunk header */\n    binlog_compose_event_header(msg, &cnx_id, 0, 0, picoquic_log_event_tls_key_update);\n\n    bytewrite_vint(msg, ticket_length);\n    bytewrite_buffer(msg, ticket, ticket_length);\n\n    bytestream_buf stream_head;\n    bytestream * head = bytestream_buf_init(&stream_head, 8);\n    bytewrite_int32(head, (uint32_t)bytestream_length(msg));\n\n    (void)fwrite(bytestream_data(head), bytestream_length(head), 1, f);\n    (void)fwrite(bytestream_data(msg), bytestream_length(msg), 1, f);\n}\n\nstatic void binlog_picotls_ticket_ex(picoquic_cnx_t* cnx,\n    uint8_t* ticket, uint16_t ticket_length)\n{\n    if (cnx != NULL && cnx->f_binlog != NULL && picoquic_cnx_is_still_logging(cnx)) {\n        binlog_picotls_ticket(cnx->f_binlog, cnx->initial_cnxid, ticket, ticket_length);\n    }\n}\n\nFILE* create_binlog(char const* binlog_file, uint64_t creation_time, unsigned int multipath_enabled);\n\nvoid binlog_new_connection(picoquic_cnx_t * cnx)\n{\n    char const* bin_dir = (cnx->quic->binlog_dir == NULL) ? cnx->quic->qlog_dir : cnx->quic->binlog_dir;\n\n    if (bin_dir == NULL || cnx->quic->bin_log_fns == NULL) {\n        return;\n    }\n\n    if (cnx->quic->current_number_of_open_logs >= cnx->quic->max_simultaneous_logs) {\n        return;\n    }\n\n    int ret = 0;\n\n    cnx->f_binlog = picoquic_file_close(cnx->f_binlog);\n    \n    char cid_name[2 * PICOQUIC_CONNECTION_ID_MAX_SIZE + 1];\n    if (picoquic_print_connection_id_hexa(cid_name, sizeof(cid_name), &cnx->initial_cnxid) != 0) {\n        ret = -1;\n    }\n\n    char log_filename[512];\n    if (ret == 0) {\n        int sprintf_ret = -1;\n        if (cnx->quic->use_unique_log_names) {\n            sprintf_ret = picoquic_sprintf(log_filename, sizeof(log_filename), NULL, \"%s%s%s.%x.%s.log\",\n                bin_dir, PICOQUIC_FILE_SEPARATOR, cid_name, cnx->log_unique,\n                (cnx->client_mode) ? \"client\" : \"server\");\n        }\n        else {\n            sprintf_ret = picoquic_sprintf(log_filename, sizeof(log_filename), NULL, \"%s%s%s.%s.log\",\n                bin_dir, PICOQUIC_FILE_SEPARATOR, cid_name,\n                (cnx->client_mode) ? \"client\" : \"server\");\n        }\n        if (sprintf_ret != 0) {\n            ret = -1;\n        }\n        else {\n            picoquic_string_free(cnx->binlog_file_name);\n            cnx->binlog_file_name = picoquic_string_duplicate(log_filename);\n        }\n    }\n\n    if (ret == 0) {\n        cnx->f_binlog = create_binlog(log_filename, picoquic_get_quic_time(cnx->quic),\n           cnx->local_parameters.initial_max_path_id > 0);\n        if (cnx->f_binlog == NULL) {\n            cnx->binlog_file_name = picoquic_string_free(cnx->binlog_file_name);\n            ret = -1;\n        }\n        else {\n            cnx->quic->current_number_of_open_logs++;\n        }\n    }\n\n    if (ret == 0) {\n        bytestream_buf stream_msg;\n        bytestream * msg = bytestream_buf_init(&stream_msg, BYTESTREAM_MAX_BUFFER_SIZE);\n        /* Common chunk header */\n        binlog_compose_event_header(msg, &cnx->initial_cnxid, cnx->start_time, 0, picoquic_log_event_new_connection);\n\n        bytewrite_int8(msg, cnx->client_mode != 0);\n        bytewrite_int32(msg, cnx->proposed_version);\n        bytewrite_cid(msg, &cnx->path[0]->first_tuple->p_remote_cnxid->cnx_id);\n\n        /* Algorithms used */\n        bytewrite_cstr(msg, cnx->congestion_alg->congestion_algorithm_id);\n        bytewrite_vint(msg, cnx->spin_policy);\n\n        bytestream_buf stream_head;\n        bytestream * head = bytestream_buf_init(&stream_head, 8);\n        bytewrite_int32(head, (uint32_t)bytestream_length(msg));\n\n        (void)fwrite(bytestream_data(head), bytestream_length(head), 1, cnx->f_binlog);\n        (void)fwrite(bytestream_data(msg), bytestream_length(msg), 1, cnx->f_binlog);\n    }\n}\n\nvoid binlog_close_connection(picoquic_cnx_t * cnx)\n{\n    FILE * f = cnx->f_binlog;\n    if (f == NULL) {\n        return;\n    }\n\n    bytestream_buf stream_msg;\n    bytestream * msg = bytestream_buf_init(&stream_msg, BYTESTREAM_MAX_BUFFER_SIZE);\n    /* Common chunk header */\n    binlog_compose_event_header(msg, &cnx->initial_cnxid, picoquic_get_quic_time(cnx->quic), 0, picoquic_log_event_connection_close);\n\n    bytestream_buf stream_head;\n    bytestream * head = bytestream_buf_init(&stream_head, 8);\n    bytewrite_int32(head, (uint32_t)bytestream_length(msg));\n\n    (void)fwrite(bytestream_data(head), bytestream_length(head), 1, f);\n    (void)fwrite(bytestream_data(msg), bytestream_length(msg), 1, f);\n\n    fflush(f);\n\n    cnx->f_binlog = picoquic_file_close(cnx->f_binlog);\n\n    if (cnx->quic->qlog_dir != NULL && cnx->quic->autoqlog_fn != NULL) {\n        (void)cnx->quic->autoqlog_fn(cnx);\n    }\n    cnx->binlog_file_name = picoquic_string_free(cnx->binlog_file_name);\n    if (cnx->quic->current_number_of_open_logs > 0) {\n        cnx->quic->current_number_of_open_logs--;\n    }\n}\n\nFILE* create_binlog(char const* binlog_file, uint64_t creation_time, unsigned int is_multipath_supported)\n{\n    FILE* f_binlog = picoquic_file_open(binlog_file, \"wb\");\n    if (f_binlog == NULL) {\n        DBG_PRINTF(\"Cannot open file %s for write.\\n\", binlog_file);\n    }\n    else {\n        /* Write a header text with version identifier and current date  */\n        bytestream_buf stream;\n        bytestream* ps = bytestream_buf_init(&stream, 16);\n        bytewrite_int32(ps, FOURCC('q', 'l', 'o', 'g'));\n        bytewrite_int16(ps, (is_multipath_supported) ? 0x01 : 0); /* flags */\n        bytewrite_int16(ps, 0x01); /* version */\n        bytewrite_int64(ps, creation_time);\n\n        if (fwrite(bytestream_data(ps), bytestream_length(ps), 1, f_binlog) <= 0) {\n            DBG_PRINTF(\"Cannot write header for file %s.\\n\", binlog_file);\n            f_binlog = picoquic_file_close(f_binlog);\n        }\n    }\n\n    return f_binlog;\n}\n\n/*\n * Log the state of the congestion management, retransmission, etc.\n * Call either just after processing a received packet, or just after\n * sending a packet.\n */\n\nvoid binlog_cc_dump(picoquic_cnx_t* cnx, picoquic_path_t* path_x, uint64_t current_time)\n{\n    bytestream_buf stream_msg;\n    bytestream* ps_msg = bytestream_buf_init(&stream_msg, BYTESTREAM_MAX_BUFFER_SIZE);\n\n    picoquic_packet_context_t* pkt_ctx = &cnx->pkt_ctx[picoquic_packet_context_application];\n\n    if (cnx->is_multipath_enabled) {\n        pkt_ctx = &path_x->pkt_ctx;\n    }\n\n    /* Common chunk header */\n    /* TODO: understand how to provide per path data -- most probably do a loop on\n     * all available paths, and write the data for each path if multipath is enabled.\n     * verify that it works for CSV and QLOG formats.\n     */\n    binlog_compose_event_header(ps_msg, &cnx->initial_cnxid, current_time,\n        binlog_get_path_id(cnx, path_x), picoquic_log_event_cc_update);\n\n    bytewrite_vint(ps_msg, pkt_ctx->send_sequence);\n\n    if (pkt_ctx->highest_acknowledged != UINT64_MAX) {\n        bytewrite_vint(ps_msg, 1);\n        bytewrite_vint(ps_msg, pkt_ctx->highest_acknowledged);\n        bytewrite_vint(ps_msg, pkt_ctx->highest_acknowledged_time - cnx->start_time);\n        bytewrite_vint(ps_msg, pkt_ctx->latest_time_acknowledged - cnx->start_time);\n    }\n    else {\n        bytewrite_vint(ps_msg, 0);\n    }\n\n    bytewrite_vint(ps_msg, path_x->cwin);\n    bytewrite_vint(ps_msg, path_x->one_way_delay_sample);\n    bytewrite_vint(ps_msg, path_x->rtt_sample);\n    bytewrite_vint(ps_msg, path_x->smoothed_rtt);\n    bytewrite_vint(ps_msg, path_x->rtt_min);\n    bytewrite_vint(ps_msg, path_x->bandwidth_estimate);\n    bytewrite_vint(ps_msg, path_x->receive_rate_estimate);\n    bytewrite_vint(ps_msg, path_x->send_mtu);\n    bytewrite_vint(ps_msg, path_x->pacing.packet_time_microsec);\n    if (cnx->is_multipath_enabled) {\n        bytewrite_vint(ps_msg, path_x->nb_losses_found);\n        bytewrite_vint(ps_msg, path_x->nb_spurious);\n    }\n    else {\n        bytewrite_vint(ps_msg, cnx->nb_retransmission_total);\n        bytewrite_vint(ps_msg, cnx->nb_spurious);\n    }\n    bytewrite_vint(ps_msg, cnx->cwin_blocked);\n    bytewrite_vint(ps_msg, cnx->flow_blocked);\n    bytewrite_vint(ps_msg, cnx->stream_blocked);\n\n    if (cnx->congestion_alg == NULL) {\n        bytewrite_vint(ps_msg, 0);\n        bytewrite_vint(ps_msg, 0);\n    }\n    else {\n        uint64_t cc_state = 0;\n        uint64_t cc_param = 0;\n\n        if (cnx->path[0]->congestion_alg_state != NULL) {\n            cnx->congestion_alg->alg_observe(cnx->path[0], &cc_state, &cc_param);\n        }\n        bytewrite_vint(ps_msg, cc_state);\n        bytewrite_vint(ps_msg, cc_param);\n    }\n\n    bytewrite_vint(ps_msg, path_x->peak_bandwidth_estimate);\n    bytewrite_vint(ps_msg, path_x->bytes_in_transit);\n    bytewrite_vint(ps_msg, path_x->last_bw_estimate_path_limited);\n\n    bytestream_buf stream_head;\n    bytestream* ps_head = bytestream_buf_init(&stream_head, BYTESTREAM_MAX_BUFFER_SIZE);\n\n    bytewrite_int32(ps_head, (uint32_t)bytestream_length(ps_msg));\n\n    (void)fwrite(bytestream_data(ps_head), bytestream_length(ps_head), 1, cnx->f_binlog);\n    (void)fwrite(bytestream_data(ps_msg), bytestream_length(ps_msg), 1, cnx->f_binlog);\n}\n\n/*\n * Write an information message frame, for free form debugging.\n */\n\nvoid picoquic_binlog_message_v(picoquic_cnx_t* cnx, const char* fmt, va_list vargs)\n{\n    if (cnx->f_binlog == NULL) {\n        return;\n    }\n    bytestream_buf stream_msg;\n    bytestream* ps_msg = bytestream_buf_init(&stream_msg, BYTESTREAM_MAX_BUFFER_SIZE);\n    size_t message_len;\n    char* message_text;\n    int written = -1;\n    /* Common chunk header */\n    binlog_compose_event_header(ps_msg, &cnx->initial_cnxid, picoquic_get_quic_time(cnx->quic), 0, picoquic_log_event_info_message);\n\n    message_text = (char*)(ps_msg->data + ps_msg->ptr);\n#ifdef _WINDOWS\n    written = vsnprintf_s(message_text,\n        ps_msg->size - ps_msg->ptr, _TRUNCATE, fmt, vargs);\n    message_len = (written < 0) ? ps_msg->size - ps_msg->ptr - 1 : (size_t)written;\n#else\n    written = vsnprintf(message_text, ps_msg->size - ps_msg->ptr, fmt, vargs);\n    if (written < 0 || (size_t)written >= ps_msg->size - ps_msg->ptr){\n        message_len = ps_msg->size - ps_msg->ptr - 1;\n    } else {\n        message_len = (size_t)written;\n    }\n#endif\n    ps_msg->ptr += message_len;\n\n    bytestream_buf stream_head;\n    bytestream* ps_head = bytestream_buf_init(&stream_head, BYTESTREAM_MAX_BUFFER_SIZE);\n\n    bytewrite_int32(ps_head, (uint32_t)bytestream_length(ps_msg));\n\n    (void)fwrite(bytestream_data(ps_head), bytestream_length(ps_head), 1, cnx->f_binlog);\n    (void)fwrite(bytestream_data(ps_msg), bytestream_length(ps_msg), 1, cnx->f_binlog);\n}\n\n#if 0\n/* Log an event that cannot be attached to a specific connection */\nvoid binlog_ignore_quic_app_message(picoquic_quic_t* UNUSED(quic), const picoquic_connection_id_t* UNUSED(cid), const char* UNUSED(fmt), va_list(vargs))\n{\n#ifdef _WINDOWS\n    UNREFERENCED_PARAMETER(quic);\n    UNREFERENCED_PARAMETER(cid);\n    UNREFERENCED_PARAMETER(fmt);\n#endif\n}\n#endif\n#if 0\n/* Log arrival or departure of an UDP datagram for an unknown connection */\nvoid binlog_ignore_quic_pdu(picoquic_quic_t* UNUSED(quic), int UNUSED(receiving), uint64_t UNUSED(current_time), uint64_t UNUSED(cid64),\n    const struct sockaddr* UNUSED(addr_peer), const struct sockaddr* UNUSED(addr_local), size_t UNUSED(packet_length))\n{\n#ifdef _WINDOWS\n    UNREFERENCED_PARAMETER(quic);\n\n    UNREFERENCED_PARAMETER(receiving);\n    UNREFERENCED_PARAMETER(current_time);\n    UNREFERENCED_PARAMETER(addr_peer);\n    UNREFERENCED_PARAMETER(addr_local);\n    UNREFERENCED_PARAMETER(packet_length);\n#endif\n}\n#endif\n/* Log an event relating to a specific connection */\nstatic void binlog_app_message(picoquic_cnx_t* cnx, const char* fmt, va_list vargs)\n{\n    if (cnx->f_binlog != NULL) {\n        picoquic_binlog_message_v(cnx, fmt, vargs);\n    }\n}\n\n/* Return from close with nothing, as this is per connection only */\nvoid binlog_close(picoquic_quic_t* UNUSED(quic))\n{\n#ifdef _WINDOWS\n    UNREFERENCED_PARAMETER(quic);\n#endif\n}\n\nstruct st_picoquic_unified_logging_t binlog_functions = {\n    /* Per context log function */\n    NULL, /* binlog_ignore_quic_app_message, */\n    NULL, /* binlog_ignore_quic_pdu*/\n    binlog_close,\n    /* Per connection functions */\n    binlog_app_message,\n    binlog_pdu_ex,\n    binlog_packet_ex,\n    binlog_dropped_packet,\n    binlog_buffered_packet,\n    binlog_outgoing_packet,\n    binlog_packet_lost,\n    binlog_negotiated_alpn,\n    binlog_transport_extension,\n    binlog_picotls_ticket_ex,\n    binlog_new_connection,\n    binlog_close_connection,\n    binlog_cc_dump\n};\n\nint picoquic_set_binlog(picoquic_quic_t* quic, char const* binlog_dir)\n{\n    quic->binlog_dir = picoquic_string_free(quic->binlog_dir);\n    quic->binlog_dir = picoquic_string_duplicate(binlog_dir);\n    quic->bin_log_fns = &binlog_functions;\n    return 0;\n}\n\nvoid picoquic_enable_binlog(picoquic_quic_t* quic)\n{\n    quic->bin_log_fns = &binlog_functions;\n}\n","numLines":1350,"startLine":1,"totalLines":1350}}}
