= NULL ? NULL : (bytes < bytes_max ? picoquic_log_fixed_skip(bytes, bytes_max, VARINT_LEN_T(bytes, size_t)) : NULL);\n45\t}\n46\t\n47\tstatic const uint8_t* picoquic_log_varint(const uint8_t* bytes, const uint8_t* bytes_max, uint64_t* n64)\n48\t{\n49\t    size_t len = (bytes == NULL) ? 0 : picoquic_varint_decode(bytes, bytes_max - bytes, n64);\n50\t    return len == 0 ? NULL : bytes + len;\n51\t}\n52\t\n53\tstatic const uint8_t* picoquic_log_length(const uint8_t* bytes, const uint8_t* bytes_max, size_t* nsz)\n54\t{\n55\t    uint64_t n64 = 0;\n56\t    size_t len = 0;\n57\t    if (bytes != NULL) {\n58\t        len = picoquic_varint_decode(bytes, bytes_max - bytes, &n64);\n59\t    }\n60\t    *nsz = (size_t)n64;\n61\t    return (len == 0 || *nsz != n64) ? NULL : bytes + len;\n62\t}\n63\t\n64\tstatic void picoquic_binlog_frame(FILE* f, const uint8_t* bytes, const uint8_t* bytes_max)\n65\t{\n66\t    if (bytes != NULL && bytes_max != NULL) {\n67\t        size_t len = bytes_max - bytes;\n68\t        uint8_t varlen[8];\n69\t        size_t l_varlen = picoquic_varint_encode(varlen, 8, len);\n70\t        fwrite(varlen, 1, l_varlen, f);\n71\t        fwrite(bytes, 1, len, f);\n72\t    }\n73\t}\n74\t\n75\tstatic const uint8_t* picoquic_log_stream_frame(FILE* f, const uint8_t* bytes, const uint8_t* bytes_max)\n76\t{\n77\t    const uint8_t* bytes_begin = bytes;\n78\t    uint8_t ftype = bytes[0];\n79\t    size_t length = 0;\n80\t    uint8_t log_buffer[256];\n81\t    int has_length = 0;\n82\t    size_t extra_bytes = 8;\n83\t\n84\t    bytes = picoquic_log_fixed_skip(bytes, bytes_max, 1); /* type */\n85\t    bytes = picoquic_log_varint_skip(bytes, bytes_max); /* stream */\n86\t\n87\t    if ((ftype & 4) != 0) {\n88\t        bytes = picoquic_log_varint_skip(bytes, bytes_max); /* offset */\n89\t    }\n90\t\n91\t    if (bytes != NULL) {\n92\t        if ((ftype & 2) != 0) {\n93\t            bytes = picoquic_log_length(bytes, bytes_max, &length); /* length */\n94\t            has_length = 1;\n95\t        }\n96\t        else {\n97\t            length = bytes_max - bytes;\n98\t        }\n99\t    }\n100\t\n101\t    if (bytes != NULL) {\n102\t        if (length < extra_bytes) {\n103\t            /* Add up to 8 bytes of content that can be documented in the qlog */\n104\t            extra_bytes = length;\n105\t        }\n106\t        if (has_length) {\n107\t            picoquic_binlog_frame(f, bytes_begin, bytes + extra_bytes);\n108\t        }\n109\t        else {\n110\t            uint8_t* log_next = log_buffer;\n111\t            size_t l_head = bytes - bytes_begin;\n112\t\n113\t            memcpy(log_buffer, bytes_begin, l_head);\n114\t            log_next += l_head;\n115\t            if ((log_next = picoquic_frames_varint_encode(log_next, log_buffer + 256, length)) != NULL) {\n116\t                memcpy(log_next, bytes, extra_bytes);\n117\t                log_next += extra_bytes;\n118\t                picoquic_binlog_frame(f, log_buffer, log_next);\n119\t            }\n120\t            else {\n121\t                picoquic_binlog_frame(f, log_buffer, log_buffer + l_head);\n122\t            }\n123\t        }\n124\t\n125\t        bytes = picoquic_log_fixed_skip(bytes, bytes_max, length);\n126\t    }\n127\t    else {\n128\t        /* Cautiously log the beginning of the erroneous frame */\n129\t        length = bytes_max - bytes_begin;\n130\t        if (length > 26) {\n131\t            length = 26;\n132\t        }\n133\t        picoquic_binlog_frame(f, bytes_begin, bytes_begin + length);\n134\t    }\n135\t    return bytes;\n136\t}\n137\t\n138\tstatic const uint8_t* picoquic_log_ack_frame(FILE* f, const uint8_t* bytes, const uint8_t* bytes_max)\n139\t{\n140\t    const uint8_t* bytes_begin = bytes;\n141\t    uint64_t ftype = 0;\n142\t    uint64_t nb_blocks;\n143\t\n144\t    (void) picoquic_varint_decode(bytes, bytes_max - bytes, &ftype);\n145\t\n146\t    bytes = picoquic_log_varint_skip(bytes, bytes_max); /* Logging the frame type, maybe multiple bytes */\n147\t\n148\t    if (ftype == picoquic_frame_type_path_ack || ftype == picoquic_frame_type_path_ack_ecn) {\n149\t        bytes = picoquic_log_varint_skip(bytes, bytes_max); /* Log the path_id */\n150\t    }\n151\t\n152\t    bytes = picoquic_log_varint_skip(bytes, bytes_max);\n153\t    bytes = picoquic_log_varint_skip(bytes, bytes_max);\n154\t    bytes = picoquic_log_varint(bytes, bytes_max, &nb_blocks);\n155\t\n156\t    for (uint64_t i = 0; bytes != NULL && i <= nb_blocks; i++) {\n157\t        if (i != 0) {\n158\t            bytes = picoquic_log_varint_skip(bytes, bytes_max);\n159\t        }\n160\t        bytes = picoquic_log_varint_skip(bytes, bytes_max);\n161\t    }\n162\t    \n163\t    if (ftype == picoquic_frame_type_ack_ecn || ftype == picoquic_frame_type_path_ack_ecn) {\n164\t        bytes = picoquic_log_varint_skip(bytes, bytes_max);\n165\t        bytes = picoquic_log_varint_skip(bytes, bytes_max);\n166\t        bytes = picoquic_log_varint_skip(bytes, bytes_max);\n167\t    }\n168\t\n169\t    picoquic_binlog_frame(f, bytes_begin, bytes);\n170\t    return bytes;\n171\t}\n172\t\n173\tstatic const uint8_t* picoquic_log_reset_stream_frame(FILE* f, const uint8_t* bytes, const uint8_t* bytes_max)\n174\t{\n175\t    const uint8_t * bytes_begin = bytes;\n176\t\n177\t    bytes = picoquic_log_fixed_skip(bytes, bytes_max, 1);\n178\t    bytes = picoquic_log_varint_skip(bytes, bytes_max);\n179\t    bytes = picoquic_log_varint_skip(bytes, bytes_max);\n180\t    bytes = picoquic_log_varint_skip(bytes, bytes_max);\n181\t\n182\t    picoquic_binlog_frame(f, bytes_begin, bytes);\n183\t    return bytes;\n184\t}\n185\t\n186\tstatic const uint8_t* picoquic_log_reset_stream_at_frame(FILE* f, const uint8_t* bytes, const uint8_t* bytes_max)\n187\t{\n188\t    const uint8_t* bytes_begin = bytes;\n189\t\n190\t    bytes = picoquic_log_fixed_skip(bytes, bytes_max, 1);\n191\t    bytes = picoquic_log_varint_skip(bytes, bytes_max);\n192\t    bytes = picoquic_log_varint_skip(bytes, bytes_max);\n193\t    bytes = picoquic_log_varint_skip(bytes, bytes_max);\n194\t    bytes = picoquic_log_varint_skip(bytes, bytes_max);\n195\t\n196\t    picoquic_binlog_frame(f, bytes_begin, bytes);\n197\t    return bytes;\n198\t}\n199\t\n200\tstatic const uint8_t* picoquic_log_stop_sending_frame(FILE* f, const uint8_t* bytes, const uint8_t* bytes_max)\n201\t{\n202\t    const uint8_t* bytes_begin = bytes;\n203\t\n204\t    bytes = picoquic_log_fixed_skip(bytes, bytes_max, 1);\n205\t    bytes = picoquic_log_varint_skip(bytes, bytes_max);\n206\t    bytes = picoquic_log_varint_skip(bytes, bytes_max);\n207\t\n208\t    picoquic_binlog_frame(f, bytes_begin, bytes);\n209\t    return bytes;\n210\t}\n211\t\n212\tstatic const uint8_t* picoquic_log_close_frame(FILE* f, const uint8_t* bytes, const uint8_t* bytes_max)\n213\t{\n214\t    const uint8_t* bytes_begin = bytes;\n215\t    size_t length = 0;\n216\t\n217\t    bytes = picoquic_log_fixed_skip(bytes, bytes_max, 1);\n218\t    bytes = picoquic_log_varint_skip(bytes, bytes_max);\n219\t    bytes = picoquic_log_varint_skip(bytes, bytes_max);\n220\t    bytes = picoquic_log_length(bytes, bytes_max, &length);\n221\t    bytes = picoquic_log_fixed_skip(bytes, bytes_max, length);\n222\t\n223\t    picoquic_binlog_frame(f, bytes_begin, bytes);\n224\t    return bytes;\n225\t}\n226\t\n227\tstatic const uint8_t* picoquic_log_app_close_frame(FILE* f, const uint8_t* bytes, const uint8_t* bytes_max)\n228\t{\n229\t    const uint8_t* bytes_begin = bytes;\n230\t    size_t length = 0;\n231\t\n232\t    bytes = picoquic_log_fixed_skip(bytes, bytes_max, 1);\n233\t    bytes = picoquic_log_varint_skip(bytes, bytes_max);\n234\t    bytes = picoquic_log_length(bytes, bytes_max, &length);\n235\t    bytes = picoquic_log_fixed_skip(bytes, bytes_max, length);\n236\t\n237\t    picoquic_binlog_frame(f, bytes_begin, bytes);\n238\t    return bytes;\n239\t}\n240\t\n241\tstatic const uint8_t* picoquic_log_max_data_frame(FILE* f, const uint8_t* bytes, const uint8_t* bytes_max)\n242\t