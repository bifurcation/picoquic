t    pub peak_bandwidth_estimate: u64,\n1611\t\n1612\t    pub bytes_sent: u64,\n1613\t    pub received: u64,\n1614\t    pub receive_rate_epoch: u64,\n1615\t    pub received_prior: u64,\n1616\t    pub receive_rate_estimate: u64,\n1617\t    pub receive_rate_max: u64,\n1618\t\n1619\t    pub cwin: u64,\n1620\t    pub bytes_in_transit: u64,\n1621\t    pub last_sender_limited_time: Instant,\n1622\t    pub last_cwin_blocked_time: Instant,\n1623\t    pub last_time_acked_data_frame_sent: Instant,\n1624\t    /// Per-path state owned by the congestion-control algorithm.\n1625\t    /// The C side stored an opaque `void*`; in Rust each algo impl\n1626\t    /// stashes its own typed state in a `Box<dyn Any>` so we get\n1627\t    /// type-erasure without `unsafe`.  Phase 2 may push this onto\n1628\t    /// `CongestionControl` as an associated `State` type.\n1629\t    pub congestion_alg_state: Option<Box<dyn Any>>,\n1630\t    pub pacing: Pacing,\n1631\t\n1632\t    pub nb_mtu_losses: u64,\n1633\t\n1634\t    pub lost_after_delivered: i32,\n1635\t    pub responder: i32,\n1636\t    pub challenger: i32,\n1637\t    pub polled: i32,\n1638\t    pub paced: i32,\n1639\t    pub congested: i32,\n1640\t    pub selected: i32,\n1641\t    pub nb_delay_outliers: i32,\n1642\t\n1643\t    pub rtt_update_delta: Duration,\n1644\t    pub pacing_rate_update_delta: u64,\n1645\t    pub rtt_threshold_low: Duration,\n1646\t    pub rtt_threshold_high: Duration,\n1647\t    pub pacing_rate_threshold_low: u64,\n1648\t    pub pacing_rate_threshold_high: u64,\n1649\t    pub receive_rate_threshold_low: u64,\n1650\t    pub receive_rate_threshold_high: u64,\n1651\t\n1652\t    pub rtt_min_remote: Duration,\n1653\t    pub cwin_remote: u64,\n1654\t    pub ip_client_remote: [u8; 16],\n1655\t    pub ip_client_remote_length: u8,\n1656\t}\n1657\t\n1658\t// ---------------------------------------------------------------------------\n1659\t// Crypto context (per-epoch, four total).\n1660\t\n1661\tpub struct CryptoContext {\n1662\t    /// Outbound packet protection (encrypt direction).  Replaces\n1663\t    /// the C `aead_encrypt: void*`.\n1664\t    pub aead_encrypt: Option<Box<dyn crate::tls::PacketKey>>,\n1665\t    /// Inbound packet protection (decrypt direction).  Replaces\n1666\t    /// the C `aead_decrypt: void*`.\n1667\t    pub aead_decrypt: Option<Box<dyn crate::tls::PacketKey>>,\n1668\t    /// Outbound header protection.  Replaces the C `pn_enc: void*`.\n1669\t    pub pn_enc: Option<Box<dyn crate::tls::HeaderKey>>,\n1670\t    /// Inbound header protection.  Replaces the C `pn_dec: void*`.\n1671\t    pub pn_dec: Option<Box<dyn crate::tls::HeaderKey>>,\n1672\t}\n1673\t\n1674\t// ---------------------------------------------------------------------------\n1675\t// Connection context.\n1676\t\n1677\t/// Per-connection state.  C: `Connection`.  This is the\n1678\t/// largest and longest-lived structure in the library; almost\n1679\t/// every internal function takes `connection` as its first argument.\n1680\tpub struct Connection {\n1681\t    pub proposed_version: u32,\n1682\t    pub rejected_version: u32,\n1683\t    pub desired_version: u32,\n1684\t    pub version_index: i32,\n1685\t\n1686\t    pub is_0rtt_accepted: bool,\n1687\t    pub remote_parameters_received: bool,\n1688\t    pub client_mode: bool,\n1689\t    pub key_phase_enc: bool,\n1690\t    pub key_phase_dec: bool,\n1691\t    pub zero_rtt_data_accepted: bool,\n1692\t    pub sending_ecn_ack: bool,\n1693\t    pub sent_blocked_frame: bool,\n1694\t    pub stream_blocked_bidir_sent: bool,\n1695\t    pub stream_blocked_unidir_sent: bool,\n1696\t    pub max_stream_data_needed: bool,\n1697\t    pub path_demotion_needed: bool,\n1698\t    pub tuple_demotion_needed: bool,\n1699\t    pub alt_path_challenge_needed: bool,\n1700\t    pub is_handshake_finished: bool,\n1701\t    pub is_handshake_done_acked: bool,\n1702\t    pub is_new_token_acked: bool,\n1703\t    pub is_1rtt_received: bool,\n1704\t    pub is_1rtt_acked: bool,\n1705\t    pub has_successful_probe: bool,\n1706\t    pub grease_transport_parameters: bool,\n1707\t    pub test_large_chello: bool,\n1708\t    pub initial_validated: bool,\n1709\t    pub initial_repeat_needed: bool,\n1710\t    pub is_loss_bit_enabled_incoming: bool,\n1711\t    pub is_loss_bit_enabled_outgoing: bool,\n1712\t    pub is_ack_frequency_negotiated: bool,\n1713\t    pub is_ack_frequency_updated: bool,\n1714\t    pub recycle_sooner_needed: bool,\n1715\t    pub is_time_stamp_enabled: bool,"}]},"parent_tool_use_id":"toolu_016DZDUH2eYQjeMuJdCzNWgY","session_id":"621e8ef5-6ea2-41f7-92c8-884ed614789d","uuid":"75c4a1d1-6806-43e8-adac-4c1c05b1bf97","timestamp":"2026-05-06T12:24:00.261Z"}
