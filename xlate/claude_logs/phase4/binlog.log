{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01QcN9am3eZ5G1LVooisYSQu","type":"tool_result","content":"776\tpub struct CongestionAlgorithm {\n777\t    pub congestion_algorithm_id: &'static str,\n778\t    pub congestion_algorithm_number: u8,\n779\t    pub ecn_mark: u8,\n780\t    pub algorithm: &'static dyn CongestionControl,\n781\t}\n782\t\n783\timpl core::fmt::Debug for CongestionAlgorithm {\n784\t    fn fmt(&self, f: &mut core::fmt::Formatter<'_>) -> core::fmt::Result {\n785\t        f.debug_struct(\"CongestionAlgorithm\")\n786\t            .field(\"congestion_algorithm_id\", &self.congestion_algorithm_id)\n787\t            .field(\n788\t                \"congestion_algorithm_number\",\n789\t                &self.congestion_algorithm_number,\n790\t            )\n791\t            .field(\"ecn_mark\", &self.ecn_mark)\n792\t            .finish_non_exhaustive()\n793\t    }\n794\t}\n795\t\n796\t/// Return the registered congestion-control algorithm table.  In\n797\t/// C this was a pair of `extern` globals\n798\t/// (`congestion_control_algorithms` and\n799\t/// `nb_congestion_control_algorithms`); the Rust API\n800\t/// exposes a single accessor returning a borrowed slice — the\n801\t/// length is implicit.  The slice is empty until\n802\t/// [`register_congestion_control_algorithms`] (or its\n803\t/// `_all_` convenience wrapper) is called.\n804\tpub fn congestion_control_algorithms() -> &'static [&'static CongestionAlgorithm] {\n805\t    CC_ALGORITHM_REGISTRY\n806\t        .get()\n807\t        .map(|v| v.as_slice())\n808\t        .unwrap_or(&[])\n809\t}\n810\t\n811\t/// Process-wide congestion-control algorithm registry.  Filled by\n812\t/// [`register_congestion_control_algorithms`].  `OnceLock` is used\n813\t/// so the registry can be set once (or never) without locking on\n814\t/// every read after the first call to `congestion_control_algorithms`.\n815\tstatic CC_ALGORITHM_REGISTRY: std::sync::OnceLock<Vec<&'static CongestionAlgorithm>> =\n816\t    std::sync::OnceLock::new();\n817\t\n818\t// ---------------------------------------------------------------------------\n819\t// ALPN list.\n820\t\n821\t/// Application-protocol identifiers used during session\n822\t/// negotiation.\n823\t#[derive(Debug, Copy, Clone, PartialEq, Eq, Default)]\n824\tpub enum Alpn {\n825\t    /// No ALPN selected / unrecognised."}]},"parent_tool_use_id":"toolu_016DZDUH2eYQjeMuJdCzNWgY","session_id":"621e8ef5-6ea2-41f7-92c8-884ed614789d","uuid":"33a5bb32-5ddb-46fd-8b1e-304fc8852c47","timestamp":"2026-05-06T12:24:16.275Z"}
