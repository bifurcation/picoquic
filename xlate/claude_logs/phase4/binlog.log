{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_017XwzQUiymakE9TuVzJ8Jri","type":"tool_result","content":"747\tpub trait CongestionControl: Sync {\n748\t    fn alg_init(&self, path_x: &mut Path, option_string: Option<&str>, current_time: Instant);\n749\t\n750\t    fn alg_notify(\n751\t        &self,\n752\t        connection: &mut Connection,\n753\t        path_x: &mut Path,\n754\t        notification: CongestionNotification,\n755\t        ack_state: &PerAckState,\n756\t        current_time: Instant,\n757\t    );\n758\t\n759\t    fn alg_delete(&self, path_x: &mut Path);\n760\t\n761\t    /// Optional observation hook — many algorithms leave this\n762\t    /// unimplemented (`NULL` in C).  Callers that don't care can\n763\t    /// rely on the default `None` return.\n764\t    fn alg_observe(&self, _path_x: &Path) -> Option<(u64, u64)> {\n765\t        None\n766\t    }\n767\t}\n768\t\n769\t/// Congestion-control algorithm descriptor.  C:\n770\t/// `CongestionAlgorithm`.\n771\t///\n772\t/// The four function pointers from the C struct fold into a single\n773\t/// trait-object reference; the algorithm identifier and numeric tag\n774\t/// stay alongside it.  `congestion_algorithm_id` is `&'static str`\n775\t/// because the C side stores compile-time string literals.\n776\tpub struct CongestionAlgorithm {\n777\t    pub congestion_algorithm_id: &'static str,\n778\t    pub congestion_algorithm_number: u8,\n779\t    pub ecn_mark: u8,\n780\t    pub algorithm: &'static dyn CongestionControl,\n781\t}\n782\t\n783\timpl core::fmt::Debug for CongestionAlgorithm {\n784\t    fn fmt(&self, f: &mut core::fmt::Formatter<'_>) -> core::fmt::Result {\n785\t        f.debug_struct(\"CongestionAlgorithm\")\n786\t            .field(\"congestion_algorithm_id\", &self.congestion_algorithm_id)\n787\t            .field(\n788\t                \"congestion_algorithm_number\",\n789\t                &self.congestion_algorithm_number,\n790\t            )\n791\t            .field(\"ecn_mark\", &self.ecn_mark)\n792\t            .finish_non_exhaustive()\n793\t    }\n794\t}\n795\t\n796\t/// Return the registered congestion-control algorithm table.  In"}]},"parent_tool_use_id":"toolu_016DZDUH2eYQjeMuJdCzNWgY","session_id":"621e8ef5-6ea2-41f7-92c8-884ed614789d","uuid":"7df192d5-8993-47da-9c83-5bbf72847fa8","timestamp":"2026-05-06T12:24:21.962Z"}
