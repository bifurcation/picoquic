  \\\n48\t    (((uint64_t)((p)[0])) | ((uint64_t)((p)[1]) << 8) |                        \\\n49\t     ((uint64_t)((p)[2]) << 16) | ((uint64_t)((p)[3]) << 24) |                 \\\n50\t     ((uint64_t)((p)[4]) << 32) | ((uint64_t)((p)[5]) << 40) |                 \\\n51\t     ((uint64_t)((p)[6]) << 48) | ((uint64_t)((p)[7]) << 56))\n52\t\n53\t#define SIPROUND                                                               \\\n54\t    do {                                                                       \\\n55\t        v0 += v1;                                                              \\\n56\t        v1 = ROTL(v1, 13);                                                     \\\n57\t        v1 ^= v0;                                                              \\\n58\t        v0 = ROTL(v0, 32);                                                     \\\n59\t        v2 += v3;                                                              \\\n60\t        v3 = ROTL(v3, 16);                                                     \\\n61\t        v3 ^= v2;                                                              \\\n62\t        v0 += v3;                                                              \\\n63\t        v3 = ROTL(v3, 21);                                                     \\\n64\t        v3 ^= v0;                                                              \\\n65\t        v2 += v1;                                                              \\\n66\t        v1 = ROTL(v1, 17);                                                     \\\n67\t        v1 ^= v2;                                                              \\\n68\t        v2 = ROTL(v2, 32);                                                     \\\n69\t    } while (0)\n70\t\n71\t#ifdef DEBUG_SIPHASH\n72\t#include <stdio.h>\n73\t\n74\t#define TRACE                                                                  \\\n75\t    do {                                                                       \\\n76\t       