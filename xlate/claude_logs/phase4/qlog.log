tf(f, \"\\\"%s\\\": %s\", key, (value == 0) ? \"false\" : \"true\");\n41\t}\n42\t\n43\t/* Helper: write a binary string parameter */\n44\tconst uint8_t * qlog_frame_hex_string(FILE* f, const uint8_t* bytes, const uint8_t* bytes_max, uint64_t l)\n45\t{\n46\t    int error_found = (bytes + l > bytes_max);\n47\t\n48\t    fprintf(f, \"\\\"\");\n49\t    if (error_found) {\n50\t        fprintf(f, \"... coding error!\");\n51\t        bytes = NULL;\n52\t    }\n53\t    else {\n54\t        for (uint64_t x = 0; x < l; x++) {\n55\t            fprintf(f, \"%02x\", bytes[x]);\n56\t        }\n57\t        bytes += l;\n58\t    }\n59\t\n60\t    fprintf(f, \"\\\"\");\n61\t    return bytes;\n62\t}\n63\t\n64\t\n65\t/* QLOG for frames with one parameter */\n66\tconst uint8_t* qlog_frame_one_param(FILE* f, const uint8_t* bytes, const uint8_t* bytes_max, char const * p_name)\n67\t{\n68\t    uint64_t param_value;\n69\t    if ((bytes = picoquic_frames_varint_decode(bytes, bytes_max, &param_value)) != NULL) {\n70\t        fprintf(f, \", \");\n71\t        qlog_json_uint(f, p_name, param_value);\n72\t    }\n73\t    return bytes;\n74\t}\n75\t\n76\t/* QLOG for frames with two parameters */\n77\tconst uint8_t* qlog_frame_two_params(FILE* f, const uint8_t* bytes, const uint8_t* bytes_max, char const* p_name1, char const* p_name2)\n78\t{\n79\t    uint64_t param_value1;\n80\t    uint64_t param_value2;\n81\t    if ((bytes = picoquic_frames_varint_decode(bytes, bytes_max, &param_value1)) != NULL &&\n82\t        (bytes = picoquic_frames_varint_decode(bytes, bytes_max, &param_value2)) != NULL) {\n83\t        fprintf(f, \", \");\n84\t        qlog_json_uint(f, p_name1, param_value1);\n85\t        fprintf(f, \", \");\n86\t        qlog_json_uint(f, p_name2, param_value2);\n87\t    }\n88\t    return bytes;\n89\t}\n90\t\n91\tconst uint8_t* qlog_frame_stream(FILE* f, const uint8_t* first_byte, const uint8_t* bytes_max)\n92\t{\n93\t    uint64_t stream_id;\n94\t    size_t data_length;\n95\t    uint64_t offset;\n96\t    size_t consumed;\n97\t    const uint8_t* bytes = first_byte;\n98\t    int fin;\n99\t    int ret = picoquic_parse_stream_header(\n100\t        first_byte, bytes_max - first_byte, &stream_id, &offset, &data_length, &fin, &consumed);\n101\t    if (ret != 0) {\n102\t        bytes = NULL;\n103\t    }\n104\t    else {\n105\t        size_t extra_bytes = 8;\n106\t        bytes += consumed;\n107\t        fprintf(f, \", \");\n108\t        qlog_json_uint(f, \"id\", stream_id);\n109\t        fprintf(f, \", \");\n110\t        qlog_json_uint(f, \"offset\", offset);\n111\t        fprintf(f, \", \");\n112\t        qlog_json_uint(f, \"length\", data_length);\n113\t        fprintf(f, \", \");\n114\t        qlog_json_boolean(f, \"fin\", fin);\n115\t#if 1\n116\t        /* Bug compatibility with old version */\n117\t        fprintf(f, \" \");\n118\t#endif\n119\t\n120\t        if ((*first_byte & 2) == 0) {\n121\t            fprintf(f, \", \\\"has_length\\\": false\");\n122\t        }\n123\t        if (extra_bytes > data_length) {\n124\t            extra_bytes = data_length;\n125\t        }\n126\t\n127\t        if (extra_bytes > 0) {\n128\t            fprintf(f, \", \\\"begins_with\\\": \");\n129\t            qlog_frame_hex_string(f, bytes, bytes_max, extra_bytes);\n130\t        }\n131\t        bytes += data_length;\n132\t    }\n133\t    return bytes;\n134\t}\n135\t\n136\tconst uint8_t* qlog_frame_ack(FILE* f, const uint8_t* bytes, const uint8_t* bytes_max, int has_path_id, int has_ecn)\n137\t{\n138\t    uint64_t path_id = 0;\n139\t    uint64_t num_block;\n140\t    uint64_t largest;\n141\t    uint64_t ack_delay;\n142\t    size_t   consumed;\n143\t\n144\t    if (picoquic_parse_ack_header(bytes, bytes_max - bytes, &num_block,\n145\t        (has_path_id) ? &path_id : NULL,\n146\t        &largest, &ack_delay, &consumed,\n147\t        0) != 0) {\n148\t        bytes = NULL;\n149\t    }\n150\t    else {\n151\t        bytes += consumed;\n152\t        /* write the header part */\n153\t        if (has_path_id) {\n154\t            fprintf(f, \", \\\"path_id\\\": %\"PRIu64\"\", path_id);\n155\t        }\n156\t        fprintf(f, \", \\\"ack_delay\\\": %\"PRIu64\"\", ack_delay);\n157\t        fprintf(f, \", \\\"acked_ranges\\\": [\");\n158\t        for (uint64_t i = 0; i <= num_block; i++) {\n159\t            uint64_t skip = 0;\n160\t            int64_t start_range;\n161\t            int64_t end_range;\n162\t            uint64_t range = 0;\n163\t\n164\t            if ((i != 0 &&\n165\t                (bytes = picoquic_frames_varint_decode(bytes, bytes_max, &skip)) == NULL) ||\n166\t                (bytes = picoquic_frames_varint_decode(bytes, bytes_max, &range)) == NULL ||\n167\t                largest < skip + range) {\n168\t                /* error in encoding of range */\n169\t                fprintf(f, \"[-1, -1]\");\n170\t                break;\n171\t            }\n172\t            else {\n173\t                if (i != 0) {\n174\t                    /* Skip the gap */\n175\t                    skip++;\n176\t                    largest -= skip;\n177\t                    fprintf(f, \", \");\n178\t                }\n179\t                start_range = largest - range;\n180\t                end_range = (int64_t)largest;\n181\t                fprintf(f, \"[%\"PRId64\", %\"PRId64\"]\", start_range, end_range);\n182\t                largest -= range + 1;\n183\t            }\n184\t        }\n185\t        fprintf(f, \"]\");\n186\t\n187\t        if (has_ecn && bytes != NULL) {\n188\t            char const* ecn_name[3] = { \"ect0\", \"ect1\", \"ce\" };\n189\t            for (int ecnx = 0; ecnx < 3; ecnx++) {\n190\t                uint64_t ecn_v = 0;\n191\t                if ((bytes = picoquic_frames_varint_decode(bytes, bytes_max, &ecn_v)) != NULL) {\n192\t                    fprintf(f, \", \\\"%s\\\": %\"PRIu64, ecn_name[ecnx], ecn_v);\n193\t                }\n194\t                else {\n195\t                    break;\n196\t                }\n197\t            }\n198\t        }\n199\t    }\n200\t    return bytes;\n201\t}\n202\t\n203\tconst uint8_t* qlog_frame_reset(FILE * f, const uint8_t * bytes, const uint8_t * bytes_max, int is_at)\n204\t{\n205\t    uint64_t stream_id;\n206\t    uint64_t error_code;\n207\t    uint64_t final_size = 0;\n208\t    uint64_t reliable_size = 0;\n209\t\n210\t    if ((bytes = picoquic_frames_varint_decode(bytes, bytes_max, &stream_id)) != NULL &&\n211\t        (bytes = picoquic_frames_varint_decode(bytes, bytes_max, &error_code)) != NULL &&\n212\t        (bytes = picoquic_frames_varint_decode(bytes, bytes_max, &final_size)) != NULL &&\n213\t        (is_at == 0 || (bytes = picoquic_frames_varint_decode(bytes, bytes_max, &reliable_size)) != NULL)\n214\t        ) {\n215\t        fprintf(f, \", \");\n216\t        qlog_json_uint(f, \"stream_id\", stream_id);\n217\t        fprintf(f, \", \");\n218\t        qlog_json_uint(f, \"error_code\", error_code);\n219\t        fprintf(f, \", \");\n220\t        qlog_json_uint(f, \"final_size\", final_size);\n221\t        if (is_at) {\n222\t            fprintf(f, \", \");\n223\t            qlog_json_uint(f, \"reliable_size\", reliable_size);\n224\t        }\n225\t    }\n226\t    return bytes;\n227\t}\n228\t\n229\tconst uint8_t* qlog_frame_connection_close(FILE* f, const uint8_t* bytes, const uint8_t* bytes_max, int app_error)\n230\t{\n231\t    uint64_t error_code;\n232\t    uint64_t trigger_frame_type = 0;\n233\t    uint64_t reason_length = 0;\n234\t\n235\t    if ((bytes = picoquic_frames_varint_decode(bytes, bytes_max, &error_code)) != NULL &&\n236\t        (app_error || (bytes = picoquic_frames_varint_decode(bytes, bytes_max, &trigger_frame_type)) != NULL) &&\n237\t        (bytes = picoquic_frames_varint_decode(bytes, bytes_max, &reason_length)) != NULL) {\n238\t        fprintf(f, \", \\\"error_space\\\": \\\"%s\\\", \",\n239\t            (app_error) ? \"application\" : \"transport\");\n240\t        qlog_json_uint(f, \"error_code\", error_code);\n241\t        if (!app_error && trigger_frame_type != 0) {\n242\t            /* Document the offending frame type */\n243\t            char const* trigger_frame_type_name = picoquic_frame_name(trigger_frame_type); \n244\t            if (strcmp(trigger_frame_type_name, \"unknown\") == 0) {\n245\t                fprintf(f, \", \\\"trigger_frame_type\\\": \\\"%\"PRIx64\"\\\"\", trigger_frame_type);\n246\t            }\n247\t            else {\n248\t                fprintf(f, \", \\\"trigger_frame_type\\\": \\\"%s\\\"\", trigger_frame_type_name);\n249\t            }\n250\t        }\n251\t        if (reason_length > 0){\n252\t            if ((size_t)(bytes_max - bytes) >= reason_length) {\n253\t                fprintf(f, \", \\\"reason\\\": \\\"\");\n254\t                for (uint64_t i = 0; i < reason_length; i++) {\n255\t                    int c = (int)bytes[i];\n256\t\n257\t                    if (c < 0x20 || c > 0x7E) {\n258\t                        c = '.';\n259\t                    }\n260\t                    fprintf(f, \"%c\", c);\n261\t                }\n262\t                fprintf(f, \"\\\"\");\n263\t                bytes += reason_length;\n264\t            }\n265\t            else {\n266\t                /* error in encoding of reason phrase */\n267\t                fprintf(f, \", \\\"reason\\\": \\\"encoding error\\\"\");\n268\t                bytes = NULL;\n269\t            }\n270\t        }\n271\t    }\n272\t    return bytes;\n273\t}\n274\t\n275\tconst uint8_t* qlog_frame_max_streams(FILE* f, const uint8_t* bytes, const uint8_t* bytes_max, int is_bidir, int is_blocked)\n276\t{\n277\t    uint64_t max_streams;\n278\t    fprintf(f, \", \");\n279\t    if (is_bidir){\n280\t        qlog_json_str(f, \"stream_type\", \"bidirectional\");\n281\t    }\n282\t    else {\n283\t        qlog_json_str(f, \"stream_type\", \"unidirectional\");\n284\t    }\n285\t    if ((bytes = picoquic_frames_varint_decode(bytes, bytes_max, &max_streams)) != NULL) {\n286\t        fprintf(f, \", \");\n287\t        qlog_json_uint(f, (is_blocked)?\"limit\":\"maximum\", max_streams);\n288\t    }\n289\t    return bytes;\n290\t}\n291\t\n292\tconst uint8_t* picoquic_frame_new_connection_id(FILE* f, const uint8_t* bytes, const uint8_t* bytes_max, int has_path_id)\n293\t{\n294\t    uint64_t path_id = 0;\n295\t    uint64_t sequence_number;\n296\t    uint64_t retire_prior_to;\n297\t    uint8_t cid_length;\n298\t\n299\t    if (has_path_id) {\n300\t        if ((bytes = picoquic_frames_varint_decode(bytes, bytes_max, &path_id)) == NULL) {\n301\t            return NULL;\n302\t        }\n303\t        fprintf(f, \", \");\n304\t        qlog_json_uint(f, \"path_id\", path_id);\n305\t    }\n306\t    if ((bytes = picoquic_frames_varint_decode(bytes, bytes_max, &sequence_number)) == NULL ||\n307\t        (bytes = picoquic_frames_varint_decode(bytes, bytes_max, &retire_prior_to)) == NULL ||\n308\t        (bytes = picoquic_frames_uint8_decode(bytes, bytes_max, &cid_length)) == NULL) {\n309\t        return NULL;\n310\t    }\n311\t    fprintf(f, \", \");\n312\t    qlog_json_uint(f, \"sequence_number\", sequence_number);\n313\t    fprintf(f, \", \");\n314\t    qlog_json_uint(f, \"retire_before\", retire_prior_to);\n315\t    fprintf(f, \", \");\n316\t    fprintf(f, \"\\\"connection_id\\\": \");\n317\t    bytes = qlog_frame_hex_string(f, bytes, bytes_max, cid_length);\n318\t    if (bytes != NULL) {\n319\t        fprintf(f, \", \\\"reset_token\\\": \");\n320\t        bytes = qlog_frame_hex_string(f, bytes, bytes_max, 16);\n321\t    }\n322\t    return bytes;\n323\t}\n324\t\n325\tconst uint8_t* qlog_frame_crypto_hs(FILE* f, const uint8_t* bytes, const uint8_t* bytes_max)\n326\t{\n327\t    uint64_t offset;\n328\t    uint64_t length;\n329\t\n330\t    if ((bytes = picoquic_frames_varint_decode(bytes, bytes_max, &offset)) != NULL &&\n331\t        (bytes = picoquic_frames_varint_decode(bytes, bytes_max, &length)) != NULL) {\n332\t        fprintf(f, \", \");\n333\t        qlog_json_uint(f, \"offset\", offset);\n334\t        fprintf(f, \", \");\n335\t        qlog_json_uint(f, \"length\", length);\n336\t        if (bytes + length <= bytes_max) {\n337\t            bytes += length;\n338\t        }\n339\t        else {\n340\t            bytes = NULL;\n341\t        }\n342\t    }\n343\t    return bytes;\n344\t}\n345\t\n346\tconst uint8_t* qlog_frame_new_token(FILE* f, const uint8_t* bytes, const uint8_t* bytes_max)\n347\t{\n348\t    uint64_t token_length;\n349\t\n350\t    if ((bytes = picoquic_frames_varint_decode(bytes, bytes_max, &token_length)) != NULL) {\n351\t        fprintf(f, \", \\\"new_token\\\": \");\n352\t        bytes = qlog_frame_hex_string(f, bytes, bytes_max, token_length);\n353\t    }\n354\t    return bytes;\n355\t}\n356\t\n357\tconst uint8_t* qlog_frame_path_challenge_response(FILE* f, const uint8_t* bytes, const uint8_t* bytes_max, int is_challenge)\n358\t{\n359\t    if (bytes + 8 > bytes_max) {\n360\t        bytes = NULL;\n361\t    }\n362\t    else {\n363\t        fprintf(f, \", \\\"%s\\\": \", (is_challenge)?\"path_challenge\":\"path_response\");\n364\t        bytes = qlog_frame_hex_string(f, bytes, bytes_max, 8);\n365\t    }\n366\t    return bytes;\n367\t}\n368\t\n369\t\n370\tconst uint8_t* qlog_frame_datagram(FILE* f, const uint8_t* bytes, const uint8_t* bytes_max, int has_length)\n371\t{\n372\t\n373\t    if (has_length) {\n374\t        uint64_t length;\n375\t        if ((bytes = picoquic_frames_varint_decode(bytes, bytes_max, &length)) == NULL ||\n376\t            bytes + length > bytes_max) {\n377\t            return NULL;\n378\t        }\n379\t        fprintf(f, \", \");\n380\t        qlog_json_uint(f, \"length\", length);\n381\t        bytes += length;\n382\t    }\n383\t    else {\n384\t        bytes = bytes_max;\n385\t    }\n386\t    return bytes;\n387\t}\n388\t\n389\tconst uint8_t* qlog_frame_ack_frequency(FILE* f, const uint8_t* bytes, const uint8_t* bytes_max)\n390\t{\n391\t    uint64_t sequence_number;\n392\t    uint64_t packet_tolerance;\n393\t    uint64_t max_ack_delay;\n394\t    uint64_t reordering_threshold;\n395\t    if ((bytes = picoquic_frames_varint_decode(bytes, bytes_max, &sequence_number)) == NULL ||\n396\t        (bytes = picoquic_frames_varint_decode(bytes, bytes_max, &packet_tolerance)) == NULL ||\n397\t        (bytes = picoquic_frames_varint_decode(bytes, bytes_max, &max_ack_delay)) == NULL ||\n398\t        (bytes = picoquic_frames_varint_decode(bytes, bytes_max, &reordering_threshold)) == NULL) {\n399\t        return NULL;\n400\t    }\n401\t    fprintf(f, \", \");\n402\t    qlog_json_uint(f, \"sequence_number\", sequence_number);\n403\t    fprintf(f, \", \");\n404\t    qlog_json_uint(f, \"packet_tolerance\", packet_tolerance);\n405\t    fprintf(f, \", \");\n406\t    qlog_json_uint(f, \"max_ack_delay\", max_ack_delay);\n407\t    fprintf(f, \", \");\n408\t    qlog_json_uint(f, \"reordering_threshold\", reordering_threshold);\n409\t    return bytes;\n410\t}\n411\t\n412\tvoid qlog_frame_ip_address(FILE* f, const uint8_t* addr, uint64_t addr_length)\n413\t{\n414\t    fprintf(f, \"\\\"\");\n415\t    if (addr_length == 4) {\n416\t        /* IPv4 address */\n417\t        for (int x = 0; x < 4; x++) {\n418\t            if (x != 0) {\n419\t                fprintf(f, \".\");\n420\t            }\n421\t            fprintf(f, \"%d\", addr[x]);\n422\t        }\n423\t    }\n424\t    else if (addr_length == 16) {\n425\t        /* IPv6 address */\n426\t        for (int x = 0; x < 8; x++) {\n427\t            uint16_t w = 0;\n428\t            for (int y = 0; y < 2; y++) {\n429\t                w <<= 8;\n430\t                w += addr[x * 2 + y];\n431\t            }\n432\t            if (x != 0) {\n433\t                fprintf(f, \":\");\n434\t            }\n435\t            fprintf(f, \"%x\", w);\n436\t        }\n437\t    }\n438\t    else {\n439\t        fprintf(f, \"invalid address length %\" PRIu64, addr_length);\n440\t    }\n441\t    fprintf(f, \"\\\"\");\n442\t}\n443\t\n444\tconst uint8_t* qlog_frame_bdp(FILE* f, const uint8_t* bytes, const uint8_t* bytes_max)\n445\t{\n446\t    uint64_t lifetime;\n447\t    uint64_t recon_bytes_in_flight;\n448\t    uint64_t recon_min_rtt;\n449\t    uint64_t saved_ip_length;\n450\t    const uint8_t* saved_ip;\n451\t\n452\t    if ((bytes = picoquic_frames_varint_decode(bytes, bytes_max, &lifetime)) == NULL ||\n453\t        (bytes = picoquic_frames_varint_decode(bytes, bytes_max, &recon_bytes_in_flight)) == NULL ||\n454\t        (bytes = picoquic_frames_varint_decode(bytes, bytes_max, &recon_min_rtt)) == NULL ||\n455\t        (bytes = picoquic_frames_varint_decode(bytes, bytes_max, &saved_ip_length)) == NULL ||\n456\t        (saved_ip_length != 4 && saved_ip_length != 4) ||\n457\t        (bytes + saved_ip_length > bytes_max)) {\n458\t        return NULL;\n459\t    }\n460\t    saved_ip = bytes;\n461\t    bytes += saved_ip_length;\n462\t\n463\t    fprintf(f, \", \");\n464\t    qlog_json_uint(f, \"lifetime\", lifetime);\n465\t    fprintf(f, \", \");\n466\t    qlog_json_uint(f, \"recon_bytes_in_flight\", recon_bytes_in_flight);\n467\t    fprintf(f, \", \");\n468\t    qlog_json_uint(f, \"recon_min_rtt\", recon_min_rtt);\n469\t    fprintf(f, \", \");\n470\t    fprintf(f, \"\\\"saved_ip\\\": \");\n471\t    qlog_frame_ip_address(f, saved_ip, saved_ip_length);\n472\t\n473\t    return bytes;\n474\t}\n475\t\n476\tconst uint8_t* qlog_frame_observed_address(FILE* f, const uint8_t* bytes, const uint8_t* bytes_max, picoquic_frame_type_enum_t ftype)\n477\t{\n478\t    uint64_t sequence;\n479\t    const uint8_t* addr;\n480\t    uint16_t port;\n481\t\n482\t    if ((bytes = picoquic_parse_observed_address_frame(bytes, bytes_max, ftype,\n483\t        &sequence, &addr, &port)) != NULL) {\n484\t        uint64_t addr_length = (ftype & 1) == 0 ? 4 : 16;\n485\t        fprintf(f, \", \");\n486\t        qlog_json_uint(f, \"sequence\", sequence);\n487\t        fprintf(f, \", \");\n488\t        fprintf(f, \"\\\"address\\\": \");\n489\t        qlog_frame_ip_address(f, addr, addr_length);\n490\t        fprintf(f, \", \");\n491\t        qlog_json_uint(f, \"port\", port);\n492\t    }\n493\t    return bytes;\n494\t}\n495\t\n496\tvoid qlog_frames(FILE* f, const uint8_t* bytes, const uint8_t* bytes_max, int skip_padding)\n497\t{\n498\t    int ret = 0;\n499\t    char const* comma_if_needed = \"\";\n500\t\n501\t    while (ret == 0 && bytes != NULL && bytes < bytes_max) {\n502\t        const uint8_t* first_byte = bytes;\n503\t        uint64_t frame_id;\n504\t        if ((bytes = picoquic_frames_varint_decode(bytes, bytes_max, &frame_id)) == NULL) {\n505\t            break;\n506\t        }\n507\t        /* For compatibility with the old version, do not log padding */\n508\t        if (frame_id == picoquic_frame_type_padding && skip_padding) {\n509\t            while (bytes < bytes_max && *bytes == picoquic_frame_type_padding) {\n510\t                bytes++;\n511\t            }\n512\t            continue;\n513\t        }\n514\t        /* Open the logging line for the frame */\n515\t        fprintf(f, \"%s{ \\n    \\\"frame_type\\\": \\\"%s\\\"\", comma_if_needed, picoquic_frame_name(frame_id));\n516\t        comma_if_needed = \", \";\n517\t\n518\t        if (PICOQUIC_IN_RANGE(frame_id, picoquic_frame_type_stream_range_min, picoquic_frame_type_stream_range_max)) {\n519\t            bytes = qlog_frame_stream(f, first_byte, bytes_max);\n520\t        }\n521\t        else {\n522\t            switch (frame_id) {\n523\t            case picoquic_frame_type_padding:\n524\t                while (bytes < bytes_max && *bytes == picoquic_frame_type_padding) {\n525\t                    bytes++;\n526\t                }\n527\t                break;\n528\t            case picoquic_frame_type_ping:\n529\t                break;\n530\t            case picoquic_frame_type_ack:\n531\t                bytes = qlog_frame_ack(f, first_byte, bytes_max, 0, 0);\n532\t                break;\n533\t            case picoquic_frame_type_ack_ecn:\n534\t                bytes = qlog_frame_ack(f, first_byte, bytes_max, 0, 1);\n535\t                break;\n536\t            case picoquic_frame_type_path_ack:\n537\t                bytes = qlog_frame_ack(f, first_byte, bytes_max, 1, 0);\n538\t                break;\n539\t            case picoquic_frame_type_path_ack_ecn:\n540\t                bytes = qlog_frame_ack(f, first_byte, bytes_max, 1, 1);\n541\t                break;\n542\t            case picoquic_frame_type_reset_stream:\n543\t                bytes = qlog_frame_reset(f, bytes, bytes_max, 0);\n544\t                break;\n545\t            case picoquic_frame_type_reset_stream_at:\n546\t                bytes = qlog_frame_reset(f, bytes, bytes_max, 1);\n547\t                break;\n548\t            case picoquic_frame_type_connection_close:\n549\t                bytes = qlog_frame_connection_close(f, bytes, bytes_max, 0);\n550\t                break;\n551\t            case picoquic_frame_type_application_close:\n552\t                bytes = qlog_frame_connection_close(f, bytes, bytes_max, 1);\n553\t                break;\n554\t            case picoquic_frame_type_max_data:\n555\t                bytes = qlog_frame_one_param(f, bytes, bytes_max, \"maximum\");\n556\t                break;\n557\t            case picoquic_frame_type_max_stream_data:\n558\t                bytes = qlog_frame_two_params(f, bytes, bytes_max, \"stream_id\", \"maximum\");\n559\t                break;\n560\t            case picoquic_frame_type_max_streams_bidir:\n561\t                bytes = qlog_frame_max_streams(f, bytes, bytes_max, 1, 0);\n562\t                break;\n563\t            case picoquic_frame_type_max_streams_unidir:\n564\t                bytes = qlog_frame_max_streams(f, bytes, bytes_max, 0, 0);\n565\t                break;\n566\t            case picoquic_frame_type_data_blocked:\n567\t                bytes = qlog_frame_one_param(f, bytes, bytes_max, \"limit\");\n568\t                break;\n569\t            case picoquic_frame_type_stream_data_blocked:\n570\t                bytes = qlog_frame_two_params(f, bytes, bytes_max, \"stream_id\", \"limit\");\n571\t                break;\n572\t            case picoquic_frame_type_streams_blocked_bidir:\n573\t                bytes = qlog_frame_max_streams(f, bytes, bytes_max, 1, 1);\n574\t                break;\n575\t            case picoquic_frame_type_streams_blocked_unidir:\n576\t                bytes = qlog_frame_max_streams(f, bytes, bytes_max, 0, 1);\n577\t                break;\n578\t            case picoquic_frame_type_new_connection_id:\n579\t                bytes = picoquic_frame_new_connection_id(f, bytes, bytes_max, 0);\n580\t                break;\n581\t            case picoquic_frame_type_path_new_connection_id:\n582\t                bytes = picoquic_frame_new_connection_id(f, bytes, bytes_max, 1);\n583\t                break;\n584\t            case picoquic_frame_type_stop_sending:\n585\t                bytes = qlog_frame_two_params(f, bytes, bytes_max, \"stream_id\", \"error_code\");\n586\t                break;\n587\t            case picoquic_frame_type_path_challenge:\n588\t                bytes = qlog_frame_path_challenge_response(f, bytes, bytes_max, 1);\n589\t                break;\n590\t            case picoquic_frame_type_path_response:\n591\t                bytes = qlog_frame_path_challenge_response(f, bytes, bytes_max, 0);\n592\t                break;\n593\t            case picoquic_frame_type_crypto_hs:\n594\t                bytes = qlog_frame_crypto_hs(f, bytes, bytes_max);\n595\t                break;\n596\t            case picoquic_frame_type_new_token:\n597\t                bytes = qlog_frame_new_token(f, bytes, bytes_max);\n598\t                break;\n599\t            case picoquic_frame_type_retire_connection_id:\n600\t                bytes = qlog_frame_one_param(f, bytes, bytes_max, \"sequence_number\");\n601\t                break;\n602\t            case picoquic_frame_type_path_retire_connection_id:\n603\t                bytes = qlog_frame_two_params(f, bytes, bytes_max, \"path_id\", \"sequence_number\");\n604\t                break;\n605\t            case picoquic_frame_type_handshake_done:\n606\t                break;\n607\t            case picoquic_frame_type_datagram:\n608\t                bytes = qlog_frame_datagram(f, bytes, bytes_max, 0);\n609\t                break;\n610\t            case picoquic_frame_type_datagram_l:\n611\t                bytes = qlog_frame_datagram(f, bytes, bytes_max, 1);\n612\t                break;\n613\t            case picoquic_frame_type_ack_frequency:\n614\t                bytes = qlog_frame_ack_frequency(f, bytes, bytes_max);\n615\t                break;\n616\t            case picoquic_frame_type_immediate_ack:\n617\t                break;\n618\t            case picoquic_frame_type_time_stamp:\n619\t                bytes = qlog_frame_one_param(f, bytes, bytes_max, \"time_stamp\");\n620\t                break;\n621\t            case picoquic_frame_type_path_abandon:\n622\t                bytes = qlog_frame_two_params(f, bytes, bytes_max, \"path_id\", \"reason\");\n623\t                break;\n624\t            case picoquic_frame_type_path_backup:\n625\t                bytes = qlog_frame_two_params(f, bytes, bytes_max, \"path_id\", \"sequence\");\n626\t                break;\n627\t            case picoquic_frame_type_path_available:\n628\t                bytes = qlog_frame_two_params(f, bytes, bytes_max, \"path_id\", \"sequence\");\n629\t                break;\n630\t            case picoquic_frame_type_bdp:\n631\t                bytes = qlog_frame_bdp(f, bytes, bytes_max);\n632\t                break;\n633\t            case picoquic_frame_type_max_path_id:\n634\t                bytes = qlog_frame_one_param(f, bytes, bytes_max, \"max_path_id\");\n635\t                break;\n636\t            case picoquic_frame_type_paths_blocked:\n637\t                bytes = qlog_frame_one_param(f, bytes, bytes_max, \"max_path_id\");\n638\t                break;\n639\t            case picoquic_frame_type_path_cid_blocked:\n640\t                bytes = qlog_frame_two_params(f, bytes, bytes_max, \"path_id\", \"next_sequence_number\");\n641\t                break;\n642\t            case picoquic_frame_type_observed_address_v4:\n643\t            case picoquic_frame_type_observed_address_v6:\n644\t                bytes = qlog_frame_observed_address(f, bytes, bytes_max, frame_id);\n645\t                break;\n646\t            default:\n647\t                fprintf(f, \", \");\n648\t                qlog_json_uint(f, \"unknown_frame_type\", frame_id);\n649\t            }\n650\t        }\n651\t        fprintf(f, \"}\");\n652\t    };\n653\t}\n654\t"}]},"parent_tool_use_id":null,"session_id":"49016d8b-074a-4ac9-aa66-ab3c58354a86","uuid":"50c71e57-f364-4ef9-9518-1f6e6006d96b","timestamp":"2026-05-06T12:00:45.786Z","tool_use_result":{"type":"text","file":{"filePath":"/Users/richbarn/Projects/picoquic/loglib/qlog_frames.c","content":"/*\n* Author: Christian Huitema\n* Copyright (c) 2019, Private Octopus, Inc.\n* All rights reserved.\n*\n* Permission to use, copy, modify, and distribute this software for any\n* purpose with or without fee is hereby granted, provided that the above\n* copyright notice and this permission notice appear in all copies.\n*\n* THIS SOFTWARE IS PROVIDED BY THE COPYRIGHT HOLDERS AND CONTRIBUTORS \"AS IS\" AND\n* ANY EXPRESS OR IMPLIED WARRANTIES, INCLUDING, BUT NOT LIMITED TO, THE IMPLIED\n* WARRANTIES OF MERCHANTABILITY AND FITNESS FOR A PARTICULAR PURPOSE ARE\n* DISCLAIMED. IN NO EVENT SHALL Private Octopus, Inc. BE LIABLE FOR ANY\n* DIRECT, INDIRECT, INCIDENTAL, SPECIAL, EXEMPLARY, OR CONSEQUENTIAL DAMAGES\n* (INCLUDING, BUT NOT LIMITED TO, PROCUREMENT OF SUBSTITUTE GOODS OR SERVICES;\n* LOSS OF USE, DATA, OR PROFITS; OR BUSINESS INTERRUPTION) HOWEVER CAUSED AND\n* ON ANY THEORY OF LIABILITY, WHETHER IN CONTRACT, STRICT LIABILITY, OR TORT\n* (INCLUDING NEGLIGENCE OR OTHERWISE) ARISING IN ANY WAY OUT OF THE USE OF THIS\n* SOFTWARE, EVEN IF ADVISED OF THE POSSIBILITY OF SUCH DAMAGE.\n*/\n\n#include <stdio.h>\n#include <stdint.h>\n#include <string.h>\n#include \"picoquic.h\"\n#include \"picoquic_internal.h\"\n#include \"picoquic_utils.h\"\n\n/* Helper: Write a JSON key-value pair for an integer */\nstatic void qlog_json_uint(FILE* f, const char* key, uint64_t value) {\n    fprintf(f, \"\\\"%s\\\": %\" PRIu64, key, value);\n}\n\n/* Helper: Write a JSON key-value pair for a string */\nstatic void qlog_json_str(FILE* f, const char* key, const char* value) {\n    fprintf(f, \"\\\"%s\\\": \\\"%s\\\"\", key, value);\n}\n\nstatic void qlog_json_boolean(FILE* f, const char* key, int value) {\n    fprintf(f, \"\\\"%s\\\": %s\", key, (value == 0) ? \"false\" : \"true\");\n}\n\n/* Helper: write a binary string parameter */\nconst uint8_t * qlog_frame_hex_string(FILE* f, const uint8_t* bytes, const uint8_t* bytes_max, uint64_t l)\n{\n    int error_found = (bytes + l > bytes_max);\n\n    fprintf(f, \"\\\"\");\n    if (error_found) {\n        fprintf(f, \"... coding error!\");\n        bytes = NULL;\n    }\n    else {\n        for (uint64_t x = 0; x < l; x++) {\n            fprintf(f, \"%02x\", bytes[x]);\n        }\n        bytes += l;\n    }\n\n    fprintf(f, \"\\\"\");\n    return bytes;\n}\n\n\n/* QLOG for frames with one parameter */\nconst uint8_t* qlog_frame_one_param(FILE* f, const uint8_t* bytes, const uint8_t* bytes_max, char const * p_name)\n{\n    uint64_t param_value;\n    if ((bytes = picoquic_frames_varint_decode(bytes, bytes_max, &param_value)) != NULL) {\n        fprintf(f, \", \");\n        qlog_json_uint(f, p_name, param_value);\n    }\n    return bytes;\n}\n\n/* QLOG for frames with two parameters */\nconst uint8_t* qlog_frame_two_params(FILE* f, const uint8_t* bytes, const uint8_t* bytes_max, char const* p_name1, char const* p_name2)\n{\n    uint64_t param_value1;\n    uint64_t param_value2;\n    if ((bytes = picoquic_frames_varint_decode(bytes, bytes_max, &param_value1)) != NULL &&\n        (bytes = picoquic_frames_varint_decode(bytes, bytes_max, &param_value2)) != NULL) {\n        fprintf(f, \", \");\n        qlog_json_uint(f, p_name1, param_value1);\n        fprintf(f, \", \");\n        qlog_json_uint(f, p_name2, param_value2);\n    }\n    return bytes;\n}\n\nconst uint8_t* qlog_frame_stream(FILE* f, const uint8_t* first_byte, const uint8_t* bytes_max)\n{\n    uint64_t stream_id;\n    size_t data_length;\n    uint64_t offset;\n    size_t consumed;\n    const uint8_t* bytes = first_byte;\n    int fin;\n    int ret = picoquic_parse_stream_header(\n        first_byte, bytes_max - first_byte, &stream_id, &offset, &data_length, &fin, &consumed);\n    if (ret != 0) {\n        bytes = NULL;\n    }\n    else {\n        size_t extra_bytes = 8;\n        bytes += consumed;\n        fprintf(f, \", \");\n        qlog_json_uint(f, \"id\", stream_id);\n        fprintf(f, \", \");\n        qlog_json_uint(f, \"offset\", offset);\n        fprintf(f, \", \");\n        qlog_json_uint(f, \"length\", data_length);\n        fprintf(f, \", \");\n        qlog_json_boolean(f, \"fin\", fin);\n#if 1\n        /* Bug compatibility with old version */\n        fprintf(f, \" \");\n#endif\n\n        if ((*first_byte & 2) == 0) {\n            fprintf(f, \", \\\"has_length\\\": false\");\n        }\n        if (extra_bytes > data_length) {\n            extra_bytes = data_length;\n        }\n\n        if (extra_bytes > 0) {\n            fprintf(f, \", \\\"begins_with\\\": \");\n            qlog_frame_hex_string(f, bytes, bytes_max, extra_bytes);\n        }\n        bytes += data_length;\n    }\n    return bytes;\n}\n\nconst uint8_t* qlog_frame_ack(FILE* f, const uint8_t* bytes, const uint8_t* bytes_max, int has_path_id, int has_ecn)\n{\n    uint64_t path_id = 0;\n    uint64_t num_block;\n    uint64_t largest;\n    uint64_t ack_delay;\n    size_t   consumed;\n\n    if (picoquic_parse_ack_header(bytes, bytes_max - bytes, &num_block,\n        (has_path_id) ? &path_id : NULL,\n        &largest, &ack_delay, &consumed,\n        0) != 0) {\n        bytes = NULL;\n    }\n    else {\n        bytes += consumed;\n        /* write the header part */\n        if (has_path_id) {\n            fprintf(f, \", \\\"path_id\\\": %\"PRIu64\"\", path_id);\n        }\n        fprintf(f, \", \\\"ack_delay\\\": %\"PRIu64\"\", ack_delay);\n        fprintf(f, \", \\\"acked_ranges\\\": [\");\n        for (uint64_t i = 0; i <= num_block; i++) {\n            uint64_t skip = 0;\n            int64_t start_range;\n            int64_t end_range;\n            uint64_t range = 0;\n\n            if ((i != 0 &&\n                (bytes = picoquic_frames_varint_decode(bytes, bytes_max, &skip)) == NULL) ||\n                (bytes = picoquic_frames_varint_decode(bytes, bytes_max, &range)) == NULL ||\n                largest < skip + range) {\n                /* error in encoding of range */\n                fprintf(f, \"[-1, -1]\");\n                break;\n            }\n            else {\n                if (i != 0) {\n                    /* Skip the gap */\n                    skip++;\n                    largest -= skip;\n                    fprintf(f, \", \");\n                }\n                start_range = largest - range;\n                end_range = (int64_t)largest;\n                fprintf(f, \"[%\"PRId64\", %\"PRId64\"]\", start_range, end_range);\n                largest -= range + 1;\n            }\n        }\n        fprintf(f, \"]\");\n\n        if (has_ecn && bytes != NULL) {\n            char const* ecn_name[3] = { \"ect0\", \"ect1\", \"ce\" };\n            for (int ecnx = 0; ecnx < 3; ecnx++) {\n                uint64_t ecn_v = 0;\n                if ((bytes = picoquic_frames_varint_decode(bytes, bytes_max, &ecn_v)) != NULL) {\n                    fprintf(f, \", \\\"%s\\\": %\"PRIu64, ecn_name[ecnx], ecn_v);\n                }\n                else {\n                    break;\n                }\n            }\n        }\n    }\n    return bytes;\n}\n\nconst uint8_t* qlog_frame_reset(FILE * f, const uint8_t * bytes, const uint8_t * bytes_max, int is_at)\n{\n    uint64_t stream_id;\n    uint64_t error_code;\n    uint64_t final_size = 0;\n    uint64_t reliable_size = 0;\n\n    if ((bytes = picoquic_frames_varint_decode(bytes, bytes_max, &stream_id)) != NULL &&\n        (bytes = picoquic_frames_varint_decode(bytes, bytes_max, &error_code)) != NULL &&\n        (bytes = picoquic_frames_varint_decode(bytes, bytes_max, &final_size)) != NULL &&\n        (is_at == 0 || (bytes = picoquic_frames_varint_decode(bytes, bytes_max, &reliable_size)) != NULL)\n        ) {\n        fprintf(f, \", \");\n        qlog_json_uint(f, \"stream_id\", stream_id);\n        fprintf(f, \", \");\n        qlog_json_uint(f, \"error_code\", error_code);\n        fprintf(f, \", \");\n        qlog_json_uint(f, \"final_size\", final_size);\n        if (is_at) {\n            fprintf(f, \", \");\n            qlog_json_uint(f, \"reliable_size\", reliable_size);\n        }\n    }\n    return bytes;\n}\n\nconst uint8_t* qlog_frame_connection_close(FILE* f, const uint8_t* bytes, const uint8_t* bytes_max, int app_error)\n{\n    uint64_t error_code;\n    uint64_t trigger_frame_type = 0;\n    uint64_t reason_length = 0;\n\n    if ((bytes = picoquic_frames_varint_decode(bytes, bytes_max, &error_code)) != NULL &&\n        (app_error || (bytes = picoquic_frames_varint_decode(bytes, bytes_max, &trigger_frame_type)) != NULL) &&\n        (bytes = picoquic_frames_varint_decode(bytes, bytes_max, &reason_length)) != NULL) {\n        fprintf(f, \", \\\"error_space\\\": \\\"%s\\\", \",\n            (app_error) ? \"application\" : \"transport\");\n        qlog_json_uint(f, \"error_code\", error_code);\n        if (!app_error && trigger_frame_type != 0) {\n            /* Document the offending frame type */\n            char const* trigger_frame_type_name = picoquic_frame_name(trigger_frame_type); \n            if (strcmp(trigger_frame_type_name, \"unknown\") == 0) {\n                fprintf(f, \", \\\"trigger_frame_type\\\": \\\"%\"PRIx64\"\\\"\", trigger_frame_type);\n            }\n            else {\n                fprintf(f, \", \\\"trigger_frame_type\\\": \\\"%s\\\"\", trigger_frame_type_name);\n            }\n        }\n        if (reason_length > 0){\n            if ((size_t)(bytes_max - bytes) >= reason_length) {\n                fprintf(f, \", \\\"reason\\\": \\\"\");\n                for (uint64_t i = 0; i < reason_length; i++) {\n                    int c = (int)bytes[i];\n\n                    if (c < 0x20 || c > 0x7E) {\n                        c = '.';\n                    }\n                    fprintf(f, \"%c\", c);\n                }\n                fprintf(f, \"\\\"\");\n                bytes += reason_length;\n            }\n            else {\n                /* error in encoding of reason phrase */\n                fprintf(f, \", \\\"reason\\\": \\\"encoding error\\\"\");\n                bytes = NULL;\n            }\n        }\n    }\n    return bytes;\n}\n\nconst uint8_t* qlog_frame_max_streams(FILE* f, const uint8_t* bytes, const uint8_t* bytes_max, int is_bidir, int is_blocked)\n{\n    uint64_t max_streams;\n    fprintf(f, \", \");\n    if (is_bidir){\n        qlog_json_str(f, \"stream_type\", \"bidirectional\");\n    }\n    else {\n        qlog_json_str(f, \"stream_type\", \"unidirectional\");\n    }\n    if ((bytes = picoquic_frames_varint_decode(bytes, bytes_max, &max_streams)) != NULL) {\n        fprintf(f, \", \");\n        qlog_json_uint(f, (is_blocked)?\"limit\":\"maximum\", max_streams);\n    }\n    return bytes;\n}\n\nconst uint8_t* picoquic_frame_new_connection_id(FILE* f, const uint8_t* bytes, const uint8_t* bytes_max, int has_path_id)\n{\n    uint64_t path_id = 0;\n    uint64_t sequence_number;\n    uint64_t retire_prior_to;\n    uint8_t cid_length;\n\n    if (has_path_id) {\n        if ((bytes = picoquic_frames_varint_decode(bytes, bytes_max, &path_id)) == NULL) {\n            return NULL;\n        }\n        fprintf(f, \", \");\n        qlog_json_uint(f, \"path_id\", path_id);\n    }\n    if ((bytes = picoquic_frames_varint_decode(bytes, bytes_max, &sequence_number)) == NULL ||\n        (bytes = picoquic_frames_varint_decode(bytes, bytes_max, &retire_prior_to)) == NULL ||\n        (bytes = picoquic_frames_uint8_decode(bytes, bytes_max, &cid_length)) == NULL) {\n        return NULL;\n    }\n    fprintf(f, \", \");\n    qlog_json_uint(f, \"sequence_number\", sequence_number);\n    fprintf(f, \", \");\n    qlog_json_uint(f, \"retire_before\", retire_prior_to);\n    fprintf(f, \", \");\n    fprintf(f, \"\\\"connection_id\\\": \");\n    bytes = qlog_frame_hex_string(f, bytes, bytes_max, cid_length);\n    if (bytes != NULL) {\n        fprintf(f, \", \\\"reset_token\\\": \");\n        bytes = qlog_frame_hex_string(f, bytes, bytes_max, 16);\n    }\n    return bytes;\n}\n\nconst uint8_t* qlog_frame_crypto_hs(FILE* f, const uint8_t* bytes, const uint8_t* bytes_max)\n{\n    uint64_t offset;\n    uint64_t length;\n\n    if ((bytes = picoquic_frames_varint_decode(bytes, bytes_max, &offset)) != NULL &&\n        (bytes = picoquic_frames_varint_decode(bytes, bytes_max, &length)) != NULL) {\n        fprintf(f, \", \");\n        qlog_json_uint(f, \"offset\", offset);\n        fprintf(f, \", \");\n        qlog_json_uint(f, \"length\", length);\n        if (bytes + length <= bytes_max) {\n            bytes += length;\n        }\n        else {\n            bytes = NULL;\n        }\n    }\n    return bytes;\n}\n\nconst uint8_t* qlog_frame_new_token(FILE* f, const uint8_t* bytes, const uint8_t* bytes_max)\n{\n    uint64_t token_length;\n\n    if ((bytes = picoquic_frames_varint_decode(bytes, bytes_max, &token_length)) != NULL) {\n        fprintf(f, \", \\\"new_token\\\": \");\n        bytes = qlog_frame_hex_string(f, bytes, bytes_max, token_length);\n    }\n    return bytes;\n}\n\nconst uint8_t* qlog_frame_path_challenge_response(FILE* f, const uint8_t* bytes, const uint8_t* bytes_max, int is_challenge)\n{\n    if (bytes + 8 > bytes_max) {\n        bytes = NULL;\n    }\n    else {\n        fprintf(f, \", \\\"%s\\\": \", (is_challenge)?\"path_challenge\":\"path_response\");\n        bytes = qlog_frame_hex_string(f, bytes, bytes_max, 8);\n    }\n    return bytes;\n}\n\n\nconst uint8_t* qlog_frame_datagram(FILE* f, const uint8_t* bytes, const uint8_t* bytes_max, int has_length)\n{\n\n    if (has_length) {\n        uint64_t length;\n        if ((bytes = picoquic_frames_varint_decode(bytes, bytes_max, &length)) == NULL ||\n            bytes + length > bytes_max) {\n            return NULL;\n        }\n        fprintf(f, \", \");\n        qlog_json_uint(f, \"length\", length);\n        bytes += length;\n    }\n    else {\n        bytes = bytes_max;\n    }\n    return bytes;\n}\n\nconst uint8_t* qlog_frame_ack_frequency(FILE* f, const uint8_t* bytes, const uint8_t* bytes_max)\n{\n    uint64_t sequence_number;\n    uint64_t packet_tolerance;\n    uint64_t max_ack_delay;\n    uint64_t reordering_threshold;\n    if ((bytes = picoquic_frames_varint_decode(bytes, bytes_max, &sequence_number)) == NULL ||\n        (bytes = picoquic_frames_varint_decode(bytes, bytes_max, &packet_tolerance)) == NULL ||\n        (bytes = picoquic_frames_varint_decode(bytes, bytes_max, &max_ack_delay)) == NULL ||\n        (bytes = picoquic_frames_varint_decode(bytes, bytes_max, &reordering_threshold)) == NULL) {\n        return NULL;\n    }\n    fprintf(f, \", \");\n    qlog_json_uint(f, \"sequence_number\", sequence_number);\n    fprintf(f, \", \");\n    qlog_json_uint(f, \"packet_tolerance\", packet_tolerance);\n    fprintf(f, \", \");\n    qlog_json_uint(f, \"max_ack_delay\", max_ack_delay);\n    fprintf(f, \", \");\n    qlog_json_uint(f, \"reordering_threshold\", reordering_threshold);\n    return bytes;\n}\n\nvoid qlog_frame_ip_address(FILE* f, const uint8_t* addr, uint64_t addr_length)\n{\n    fprintf(f, \"\\\"\");\n    if (addr_length == 4) {\n        /* IPv4 address */\n        for (int x = 0; x < 4; x++) {\n            if (x != 0) {\n                fprintf(f, \".\");\n            }\n            fprintf(f, \"%d\", addr[x]);\n        }\n    }\n    else if (addr_length == 16) {\n        /* IPv6 address */\n        for (int x = 0; x < 8; x++) {\n            uint16_t w = 0;\n            for (int y = 0; y < 2; y++) {\n                w <<= 8;\n                w += addr[x * 2 + y];\n            }\n            if (x != 0) {\n                fprintf(f, \":\");\n            }\n            fprintf(f, \"%x\", w);\n        }\n    }\n    else {\n        fprintf(f, \"invalid address length %\" PRIu64, addr_length);\n    }\n    fprintf(f, \"\\\"\");\n}\n\nconst uint8_t* qlog_frame_bdp(FILE* f, const uint8_t* bytes, const uint8_t* bytes_max)\n{\n    uint64_t lifetime;\n    uint64_t recon_bytes_in_flight;\n    uint64_t recon_min_rtt;\n    uint64_t saved_ip_length;\n    const uint8_t* saved_ip;\n\n    if ((bytes = picoquic_frames_varint_decode(bytes, bytes_max, &lifetime)) == NULL ||\n        (bytes = picoquic_frames_varint_decode(bytes, bytes_max, &recon_bytes_in_flight)) == NULL ||\n        (bytes = picoquic_frames_varint_decode(bytes, bytes_max, &recon_min_rtt)) == NULL ||\n        (bytes = picoquic_frames_varint_decode(bytes, bytes_max, &saved_ip_length)) == NULL ||\n        (saved_ip_length != 4 && saved_ip_length != 4) ||\n        (bytes + saved_ip_length > bytes_max)) {\n        return NULL;\n    }\n    saved_ip = bytes;\n    bytes += saved_ip_length;\n\n    fprintf(f, \", \");\n    qlog_json_uint(f, \"lifetime\", lifetime);\n    fprintf(f, \", \");\n    qlog_json_uint(f, \"recon_bytes_in_flight\", recon_bytes_in_flight);\n    fprintf(f, \", \");\n    qlog_json_uint(f, \"recon_min_rtt\", recon_min_rtt);\n    fprintf(f, \", \");\n    fprintf(f, \"\\\"saved_ip\\\": \");\n    qlog_frame_ip_address(f, saved_ip, saved_ip_length);\n\n    return bytes;\n}\n\nconst uint8_t* qlog_frame_observed_address(FILE* f, const uint8_t* bytes, const uint8_t* bytes_max, picoquic_frame_type_enum_t ftype)\n{\n    uint64_t sequence;\n    const uint8_t* addr;\n    uint16_t port;\n\n    if ((bytes = picoquic_parse_observed_address_frame(bytes, bytes_max, ftype,\n        &sequence, &addr, &port)) != NULL) {\n        uint64_t addr_length = (ftype & 1) == 0 ? 4 : 16;\n        fprintf(f, \", \");\n        qlog_json_uint(f, \"sequence\", sequence);\n        fprintf(f, \", \");\n        fprintf(f, \"\\\"address\\\": \");\n        qlog_frame_ip_address(f, addr, addr_length);\n        fprintf(f, \", \");\n        qlog_json_uint(f, \"port\", port);\n    }\n    return bytes;\n}\n\nvoid qlog_frames(FILE* f, const uint8_t* bytes, const uint8_t* bytes_max, int skip_padding)\n{\n    int ret = 0;\n    char const* comma_if_needed = \"\";\n\n    while (ret == 0 && bytes != NULL && bytes < bytes_max) {\n        const uint8_t* first_byte = bytes;\n        uint64_t frame_id;\n        if ((bytes = picoquic_frames_varint_decode(bytes, bytes_max, &frame_id)) == NULL) {\n            break;\n        }\n        /* For compatibility with the old version, do not log padding */\n        if (frame_id == picoquic_frame_type_padding && skip_padding) {\n            while (bytes < bytes_max && *bytes == picoquic_frame_type_padding) {\n                bytes++;\n            }\n            continue;\n        }\n        /* Open the logging line for the frame */\n        fprintf(f, \"%s{ \\n    \\\"frame_type\\\": \\\"%s\\\"\", comma_if_needed, picoquic_frame_name(frame_id));\n        comma_if_needed = \", \";\n\n        if (PICOQUIC_IN_RANGE(frame_id, picoquic_frame_type_stream_range_min, picoquic_frame_type_stream_range_max)) {\n            bytes = qlog_frame_stream(f, first_byte, bytes_max);\n        }\n        else {\n            switch (frame_id) {\n            case picoquic_frame_type_padding:\n                while (bytes < bytes_max && *bytes == picoquic_frame_type_padding) {\n                    bytes++;\n                }\n                break;\n            case picoquic_frame_type_ping:\n                break;\n            case picoquic_frame_type_ack:\n                bytes = qlog_frame_ack(f, first_byte, bytes_max, 0, 0);\n                break;\n            case picoquic_frame_type_ack_ecn:\n                bytes = qlog_frame_ack(f, first_byte, bytes_max, 0, 1);\n                break;\n            case picoquic_frame_type_path_ack:\n                bytes = qlog_frame_ack(f, first_byte, bytes_max, 1, 0);\n                break;\n            case picoquic_frame_type_path_ack_ecn:\n                bytes = qlog_frame_ack(f, first_byte, bytes_max, 1, 1);\n                break;\n            case picoquic_frame_type_reset_stream:\n                bytes = qlog_frame_reset(f, bytes, bytes_max, 0);\n                break;\n            case picoquic_frame_type_reset_stream_at:\n                bytes = qlog_frame_reset(f, bytes, bytes_max, 1);\n                break;\n            case picoquic_frame_type_connection_close:\n                bytes = qlog_frame_connection_close(f, bytes, bytes_max, 0);\n                break;\n            case picoquic_frame_type_application_close:\n                bytes = qlog_frame_connection_close(f, bytes, bytes_max, 1);\n                break;\n            case picoquic_frame_type_max_data:\n                bytes = qlog_frame_one_param(f, bytes, bytes_max, \"maximum\");\n                break;\n            case picoquic_frame_type_max_stream_data:\n                bytes = qlog_frame_two_params(f, bytes, bytes_max, \"stream_id\", \"maximum\");\n                break;\n            case picoquic_frame_type_max_streams_bidir:\n                bytes = qlog_frame_max_streams(f, bytes, bytes_max, 1, 0);\n                break;\n            case picoquic_frame_type_max_streams_unidir:\n                bytes = qlog_frame_max_streams(f, bytes, bytes_max, 0, 0);\n                break;\n            case picoquic_frame_type_data_blocked:\n                bytes = qlog_frame_one_param(f, bytes, bytes_max, \"limit\");\n                break;\n            case picoquic_frame_type_stream_data_blocked:\n                bytes = qlog_frame_two_params(f, bytes, bytes_max, \"stream_id\", \"limit\");\n                break;\n            case picoquic_frame_type_streams_blocked_bidir:\n                bytes = qlog_frame_max_streams(f, bytes, bytes_max, 1, 1);\n                break;\n            case picoquic_frame_type_streams_blocked_unidir:\n                bytes = qlog_frame_max_streams(f, bytes, bytes_max, 0, 1);\n                break;\n            case picoquic_frame_type_new_connection_id:\n                bytes = picoquic_frame_new_connection_id(f, bytes, bytes_max, 0);\n                break;\n            case picoquic_frame_type_path_new_connection_id:\n                bytes = picoquic_frame_new_connection_id(f, bytes, bytes_max, 1);\n                break;\n            case picoquic_frame_type_stop_sending:\n                bytes = qlog_frame_two_params(f, bytes, bytes_max, \"stream_id\", \"error_code\");\n                break;\n            case picoquic_frame_type_path_challenge:\n                bytes = qlog_frame_path_challenge_response(f, bytes, bytes_max, 1);\n                break;\n            case picoquic_frame_type_path_response:\n                bytes = qlog_frame_path_challenge_response(f, bytes, bytes_max, 0);\n                break;\n            case picoquic_frame_type_crypto_hs:\n                bytes = qlog_frame_crypto_hs(f, bytes, bytes_max);\n                break;\n            case picoquic_frame_type_new_token:\n                bytes = qlog_frame_new_token(f, bytes, bytes_max);\n                break;\n            case picoquic_frame_type_retire_connection_id:\n                bytes = qlog_frame_one_param(f, bytes, bytes_max, \"sequence_number\");\n                break;\n            case picoquic_frame_type_path_retire_connection_id:\n                bytes = qlog_frame_two_params(f, bytes, bytes_max, \"path_id\", \"sequence_number\");\n                break;\n            case picoquic_frame_type_handshake_done:\n                break;\n            case picoquic_frame_type_datagram:\n                bytes = qlog_frame_datagram(f, bytes, bytes_max, 0);\n                break;\n            case picoquic_frame_type_datagram_l:\n                bytes = qlog_frame_datagram(f, bytes, bytes_max, 1);\n                break;\n            case picoquic_frame_type_ack_frequency:\n                bytes = qlog_frame_ack_frequency(f, bytes, bytes_max);\n                break;\n            case picoquic_frame_type_immediate_ack:\n                break;\n            case picoquic_frame_type_time_stamp:\n                bytes = qlog_frame_one_param(f, bytes, bytes_max, \"time_stamp\");\n                break;\n            case picoquic_frame_type_path_abandon:\n                bytes = qlog_frame_two_params(f, bytes, bytes_max, \"path_id\", \"reason\");\n                break;\n            case picoquic_frame_type_path_backup:\n                bytes = qlog_frame_two_params(f, bytes, bytes_max, \"path_id\", \"sequence\");\n                break;\n            case picoquic_frame_type_path_available:\n                bytes = qlog_frame_two_params(f, bytes, bytes_max, \"path_id\", \"sequence\");\n                break;\n            case picoquic_frame_type_bdp:\n                bytes = qlog_frame_bdp(f, bytes, bytes_max);\n                break;\n            case picoquic_frame_type_max_path_id:\n                bytes = qlog_frame_one_param(f, bytes, bytes_max, \"max_path_id\");\n                break;\n            case picoquic_frame_type_paths_blocked:\n                bytes = qlog_frame_one_param(f, bytes, bytes_max, \"max_path_id\");\n                break;\n            case picoquic_frame_type_path_cid_blocked:\n                bytes = qlog_frame_two_params(f, bytes, bytes_max, \"path_id\", \"next_sequence_number\");\n                break;\n            case picoquic_frame_type_observed_address_v4:\n            case picoquic_frame_type_observed_address_v6:\n                bytes = qlog_frame_observed_address(f, bytes, bytes_max, frame_id);\n                break;\n            default:\n                fprintf(f, \", \");\n                qlog_json_uint(f, \"unknown_frame_type\", frame_id);\n            }\n        }\n        fprintf(f, \"}\");\n    };\n}\n","numLines":654,"startLine":1,"totalLines":654}}}
