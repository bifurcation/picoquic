  byteread_vint(s, &limit);\n957\t    fprintf(f, \", \\\"limit\\\": %\"PRIu64\"\", limit);\n958\t}\n959\t\n960\tvoid qlog_streams_blocked_frame(uint64_t ftype, FILE* f, bytestream* s)\n961\t{\n962\t    uint64_t limit;\n963\t\n964\t    fprintf(f, \", \\\"stream_type\\\": \\\"%s\\\"\", \n965\t        (ftype == picoquic_frame_type_streams_blocked_bidir)?\n966\t        \"bidirectional\":\"unidirectional\");\n967\t\n968\t    byteread_vint(s, &limit);\n969\t    fprintf(f, \", \\\"limit\\\": %\"PRIu64\"\", limit);\n970\t}\n971\t\n972\tvoid qlog_new_connection_id_frame(uint64_t ftype, FILE* f, bytestream* s)\n973\t{\n974\t    uint64_t sequence_number = 0;\n975\t    uint64_t retire_before = 0;\n976\t    uint64_t cid_length = 0;\n977\t\n978\t    if (ftype == picoquic_frame_type_path_new_connection_id) {\n979\t        uint64_t path_id;\n980\t        byteread_vint(s, &path_id);\n981\t        fprintf(f, \", \\\"path_id\\\": %\"PRIu64\"\", path_id);\n982\t    }\n983\t\n984\t    byteread_vint(s, &sequence_number);\n985\t    fprintf(f, \", \\\"sequence_number\\\": %\"PRIu64\"\", sequence_number);\n986\t    byteread_vint(s, &retire_before);\n987\t    fprintf(f, \", \\\"retire_before\\\": %\"PRIu64\"\", retire_before);\n988\t    byteread_vint(s, &cid_length);\n989\t    fprintf(f, \", \\\"connection_id\\\": \");\n990\t    qlog_string(f, s, cid_length);\n991\t    fprintf(f, \", \\\"reset_token\\\": \");\n992\t    qlog_string(f, s, 16);\n993\t}\n994\t\n995\tvoid qlog_retire_connection_id_frame(uint64_t ftype, FILE* f, bytestream* s)\n996\t{\n997\t    uint64_t sequence_number = 0;\n998\t\n999\t    if (ftype == picoquic_frame_type_path_retire_connection_id) {\n1000\t        uint64_t path_id = 0;\n1001\t        byteread_vint(s, &path_id);\n1002\t        fprintf(f, \", \\\"path_id\\\": %\"PRIu64\"\", path_id);\n1003\t    }\n1004\t\n1005\t    byteread_vint(s, &sequence_number);\n1006\t    fprintf(f, \", \\\"sequence_number\\\": %\"PRIu64\"\", sequence_number);\n1007\t}\n1008\t\n1009\tvoid qlog_new_token_frame(FILE* f, bytestream* s)\n1010\t{\n1011\t    uint64_t toklen = 0;\n1012\t\n1013\t    fprintf(f, \", \\\"new_token\\\": \");\n1014\t    byteread_vint(s, &toklen);\n1015\t    qlog_string(f, s, toklen);\n1016\t}\n1017\t\n1018\tvoid qlog_path_frame(uint64_t ftype, FILE* f, bytestream* s)\n1019\t{\n1020\t    if (ftype == picoquic_frame_type_path_challenge) {\n1021\t        fprintf(f, \", \\\"path_challenge\\\": \");\n1022\t    }\n1023\t    else {\n1024\t        fprintf(f, \", \\\"path_response\\\": \");\n1025\t    }\n1026\t    qlog_string(f, s, 8);\n1027\t}\n1028\t\n1029\tvoid qlog_crypto_hs_frame(FILE* f, bytestream* s)\n1030\t{\n1031\t    uint64_t offset = 0;\n1032\t    uint64_t data_length = 0;\n1033\t\n1034\t\n1035\t    byteread_vint(s, &offset);\n1036\t    fprintf(f, \", \\\"offset\\\": %\"PRIu64\"\", offset);\n1037\t    byteread_vint(s, &data_length);\n1038\t    fprintf(f, \", \\\"length\\\": %\"PRIu64\"\", data_length);\n1039\t}\n1040\t\n1041\tvoid qlog_datagram_frame(uint64_t ftype, FILE* f, bytestream* s)\n1042\t{\n1043\t    unsigned int has_length = ftype & 1;\n1044\t    uint64_t length = 0;\n1045\t\n1046\t    if (has_length) {\n1047\t        byteread_vint(s, &length);\n1048\t        fprintf(f, \", \\\"length\\\": %\"PRIu64\"\", length);\n1049\t    }\n1050\t}\n1051\t\n1052\tvoid qlog_ack_frequency_frame(FILE* f, bytestream* s)\n1053\t{\n1054\t    uint64_t sequence_number = 0;\n1055\t    uint64_t packet_tolerance = 0;\n1056\t    uint64_t max_ack_delay = 0;\n1057\t    uint64_t reordering_threshold = 0;\n1058\t    byteread_vint(s, &sequence_number);\n1059\t    fprintf(f, \", \\\"sequence_number\\\": %\"PRIu64\"\", sequence_number);\n1060\t    byteread_vint(s, &packet_tolerance);\n1061\t    fprintf(f, \", \\\"packet_tolerance\\\": %\"PRIu64\"\", packet_tolerance);\n1062\t    byteread_vint(s, &max_ack_delay);\n1063\t    fprintf(f, \", \\\"max_ack_delay\\\": %\"PRIu64\"\", max_ack_delay);\n1064\t    byteread_vint(s, &reordering_threshold);\n1065\t    fprintf(f, \", \\\"reordering_threshold\\\": %\"PRIu64\"\", reordering_threshold);\n1066\t}\n1067\t\n1068\tvoid qlog_ack_frame(uint64_t ftype, FILE * f, bytestream* s)\n1069\t{\n1070\t    uint64_t largest = 0;\n1071\t    uint64_t ack_delay = 0;\n1072\t    uint64_t num = 0;\n1073\t    uint64_t path_id = 0;\n1074\t    if (ftype == picoquic_frame_type_path_ack || ftype == picoquic_frame_type_path_ack_ecn) {\n1075\t        byteread_vint(s, &path_id);\n1076\t        fprintf(f, \", \\\"path_id\\\": %\"PRIu64\"\", path_id);\n1077\t    }\n1078\t    byteread_vint(s, &largest);\n1079\t    byteread_vint(s, &ack_delay);\n1080\t    fprintf(f, \", \\\"ack_delay\\\": %\"PRIu64\"\", ack_delay);\n1081\t    byteread_vint(s, &num);\n1082\t    fprintf(f, \", \\\"acked_ranges\\\": [\");\n1083\t    for (uint64_t i = 0; i <= num; i++) {\n1084\t        uint64_t skip = 0;\n1085\t        int64_t start_range;\n1086\t        int64_t end_range;\n1087\t\n1088\t        if (i != 0) {\n1089\t            byteread_vint(s, &skip);\n1090\t            skip++;\n1091\t\n1092\t            largest -= skip;\n1093\t            fprintf(f, \", \");\n1094\t        }\n1095\t        uint64_t range = 0;\n1096\t        byteread_vint(s, &range);\n1097\t\n1098\t        start_range = largest - range;\n1099\t        end_range = (int64_t)largest;\n1100\t        fprintf(f, \"[%\"PRId64\", %\"PRId64\"]\", start_range, end_range);\n1101\t\n1102\t        largest -= range + 1;\n1103\t    }\n1104\t    fprintf(f, \"]\");\n1105\t    if (ftype == picoquic_frame_type_ack_ecn || ftype == picoquic_frame_type_path_ack_ecn) {\n1106\t        char const* ecn_name[3] = { \"ect0\", \"ect1\", \"ce\" };\n1107\t        for (int ecnx = 0; ecnx < 3; ecnx++) {\n1108\t            uint64_t ecn_v = 0;\n1109\t            byteread_vint(s, &ecn_v);\n1110\t            fprintf(f, \", \\\"%s\\\": %\"PRIu64, ecn_name[ecnx], ecn_v);\n1111\t        }\n1112\t    }\n1113\t}\n1114\t\n1115\tvoid qlog_erroring_frame(FILE* f, bytestream* s, uint64_t ftype)\n1116\t{\n1117\t    size_t extra_bytes = s->size - s->ptr;\n1118\t\n1119\t    fprintf(f, \",\\\"unknown_type\\\": %\" PRIu64 \",\", ftype);\n1120\t\n1121\t    fprintf(f, \"\\\"begins_with\\\": \");\n1122\t\n1123\t    qlog_string(f, s, (extra_bytes > 8) ? 8 : extra_bytes);\n1124\t}\n1125\t\n1126\tint qlog_proposed_versions(FILE* f, bytestream* s)\n1127\t{\n1128\t    int nb_versions = 0;\n1129\t    fprintf(f, \",\\n    \\\"proposed_versions\\\": [\");\n1130\t\n1131\t    while (bytestream_remain(s) > 0) {\n1132\t        if (nb_versions > 0) {\n1133\t            fprintf(f, \", \");\n1134\t        }\n1135\t        qlog_string(f, s, 4);\n1136\t        nb_versions++;\n1137\t    }\n1138\t    fprintf(f, \"]\");\n1139\t    return 0;\n1140\t}\n1141\t\n1142\tint qlog_retry_token(FILE* f, bytestream* s)\n1143\t{\n1144\t    size_t l = bytestream_remain(s);\n1145\t\n1146\t    if (l > 0) {\n1147\t        fprintf(f, \",\\n    \\\"retry_token\\\": \");\n1148\t        qlog_string(f, s, l);\n1149\t    }\n1150\t    return 0;\n1151\t}\n1152\t\n1153\tvoid qlog_bdp_frame(FILE* f, bytestream* s)\n1154\t{\n1155\t    uint64_t lifetime = 0;\n1156\t    uint64_t recon_bytes_in_flight = 0;\n1157\t    uint64_t recon_min_rtt = 0;\n1158\t    uint64_t ip_len = 0;\n1159\t\n1160\t    byteread_vint(s, &lifetime);\n1161\t    byteread_vint(s, &recon_bytes_in_flight);\n1162\t    byteread_vint(s, &recon_min_rtt);\n1163\t    byteread_vint(s, &ip_len);\n1164\t    fprintf(f, \", \\\"lifetime\\\": %\"PRIu64\", \\\"bytes_in_flight\\\": %\"PRIu64\", \\\"min_rtt\\\": %\"PRIu64\", \\\"ip\\\": \", lifetime, recon_bytes_in_flight, recon_min_rtt);\n1165\t    qlog_string(f, s, ip_len);\n1166\t}\n1167\t\n1168\tvoid qlog_observed_address_frame(uint64_t ftype, FILE* f, bytestream* s)\n1169\t{\n1170\t    unsigned int port = 0;\n1171\t    uint64_t sequence = 0;\n1172\t\n1173\t    byteread_vint(s, &sequence);\n1174\t    fprintf(f, \", \\\"sequence\\\": %\"PRIu64\", \\\"address\\\": \\\"\", sequence);\n1175\t    if ((ftype & 1) == 0) {\n1176\t        /* IPv4 address */\n1177\t        for (int x = 0; x < 4 && s->ptr < s->size; x++) {\n1178\t            if (x != 0) {\n1179\t                fprintf(f, \".\");\n1180\t            }\n1181\t            fprintf(f, \"%d\", s->data[s->ptr++]);\n1182\t        }\n1183\t    }\n1184\t    else {\n1185\t        /* IPv6 address */\n1186\t        for (int x = 0; x < 8 && s->ptr < s->size; x++) {\n1187\t            uint16_t w = 0;\n1188\t            for (int y = 0; y < 2 && s->ptr < s->size; y++) {\n1189\t                w <<= 8;\n1190\t                w += s->data[s->ptr++];\n1191\t            }\n1192\t            if (x != 0) {\n1193\t                fprintf(f, \":\");\n1194\t            }\n1195\t            fprintf(f, \"%x\", w);\n1196\t        }\n1197\t    }\n1198\t    for (int y = 0; y < 2 && s->ptr < s->size; y++) {\n1199\t        port <<= 8;\n1200\t        port += s->data[s->ptr++];\n1201\t    }\n1202\t    fprintf(f, \"\\\", \\\"port\\\": %u\", port);\n1203\t}\n1204\t\n1205\tint qlog_packet_frame(bytestream * s, void * ptr)\n1206\t{\n1207\t    qlog_context_t * ctx = (qlog_context_t*)ptr;\n1208\t    FILE * f = ctx->f_txtlog;\n1209\t\n1210\t    if (ctx->packet_type == picoquic_packet_version_negotiation) {\n1211\t        return qlog_proposed_versions(f, s);\n1212\t    }\n1213\t    else if (ctx->packet_type == picoquic_packet_retry) {\n1214\t        return qlog_retry_token(f, s);\n1215\t    }\n1216\t\n1217\t    if (ctx->frame_count != 0) {\n1218\t        fprintf(f, \", \");\n1219\t    }\n1220\t\n1221\t    fprintf(f, \"{ \");\n1222\t\n1223\t    uint64_t ftype = 0;\n1224\t    size_t ptr_before_type = s->ptr;\n1225\t    byteread_vint(s, &ftype);\n1226\t\n1227\t    fprintf(f, \"\\n    \\\"frame_type\\\": \\\"%s\\\"\", picoquic_frame_name((picoquic_frame_type_enum_t)ftype));\n1228\t\n1229\t    if (ftype >= picoquic_frame_type_stream_range_min &&\n1230\t        ftype <= picoquic_frame_type_stream_range_max) {\n1231\t        uint64_t stream_id = 0;\n1232\t      