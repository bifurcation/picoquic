{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01AgnXqW69V5iZ9tp4AwCpEP","type":"tool_result","content":"1\t/*\n2\t* Author: Christian Huitema\n3\t* Copyright (c) 2019, Private Octopus, Inc.\n4\t* All rights reserved.\n5\t*\n6\t* Permission to use, copy, modify, and distribute this software for any\n7\t* purpose with or without fee is hereby granted, provided that the above\n8\t* copyright notice and this permission notice appear in all copies.\n9\t*\n10\t* THIS SOFTWARE IS PROVIDED BY THE COPYRIGHT HOLDERS AND CONTRIBUTORS \"AS IS\" AND\n11\t* ANY EXPRESS OR IMPLIED WARRANTIES, INCLUDING, BUT NOT LIMITED TO, THE IMPLIED\n12\t* WARRANTIES OF MERCHANTABILITY AND FITNESS FOR A PARTICULAR PURPOSE ARE\n13\t* DISCLAIMED. IN NO EVENT SHALL Private Octopus, Inc. BE LIABLE FOR ANY\n14\t* DIRECT, INDIRECT, INCIDENTAL, SPECIAL, EXEMPLARY, OR CONSEQUENTIAL DAMAGES\n15\t* (INCLUDING, BUT NOT LIMITED TO, PROCUREMENT OF SUBSTITUTE GOODS OR SERVICES;\n16\t* LOSS OF USE, DATA, OR PROFITS; OR BUSINESS INTERRUPTION) HOWEVER CAUSED AND\n17\t* ON ANY THEORY OF LIABILITY, WHETHER IN CONTRACT, STRICT LIABILITY, OR TORT\n18\t* (INCLUDING NEGLIGENCE OR OTHERWISE) ARISING IN ANY WAY OUT OF THE USE OF THIS\n19\t* SOFTWARE, EVEN IF ADVISED OF THE POSSIBILITY OF SUCH DAMAGE.\n20\t*/\n21\t#include <stdio.h>\n22\t#include <stdlib.h>\n23\t#include <string.h>\n24\t#include <inttypes.h>\n25\t#include <errno.h>\n26\t\n27\t#include \"picoquic.h\"\n28\t#include \"picoquic_internal.h\"\n29\t#include \"bytestream.h\"\n30\t#include \"logreader.h\"\n31\t#include \"logconvert.h\"\n32\t\n33\ttypedef struct qlog_context_st {\n34\t\n35\t    FILE * f_txtlog;      /*!< The file handle of the opened output file. */\n36\t\n37\t    uint32_t version_number;\n38\t    const char * cid_name; /*!< Name of the connection, default = initial connection id */\n39\t    struct sockaddr_storage addr_peer;\n40\t    struct sockaddr_storage addr_local;\n41\t    uint8_t ecn_sent;\n42\t    uint8_t ecn_received;\n43\t\n44\t\n45\t    uint64_t start_time;  /*!< Timestamp is very first log event reported. */\n46\t    int event_count;\n47\t    int packet_count;\n48\t    int frame_count;\n49\t    picoquic_packet_type_enum packet_type;\n50\t\n51\t    uint64_t cwin;\n52\t    uint64_t rtt_sample;\n53\t    uint64_t SRTT;\n54\t    uint64_t RTT_min;\n55\t    uint64_t bytes_in_transit;\n56\t    uint64_t pacing_packet_time;\n57\t\n58\t    unsigned int trace_flow_id : 1;\n59\t    unsigned int key_phase_sent_last : 1;\n60\t    unsigned int key_phase_sent : 1;\n61\t    unsigned int key_phase_received_last : 1;\n62\t    unsigned int key_phase_received : 1;\n63\t    unsigned int spin_bit_sent_last : 1;\n64\t    unsigned int spin_bit_sent : 1;\n65\t    unsigned int app_limited : 1;\n66\t\n67\t    int state;\n68\t} qlog_context_t;\n69\t\n70\tint qlog_string(FILE* f, bytestream* s, uint64_t l)\n71\t{\n72\t    uint64_t x;\n73\t    int error_found = (s->ptr + (size_t)l > s->size);\n74\t\n75\t    fprintf(f, \"\\\"\");\n76\t\n77\t    for (x = 0; x < l && s->ptr < s->size; x++) {\n78\t        fprintf(f, \"%02x\", s->data[s->ptr++]);\n79\t    }\n80\t\n81\t    if (error_found) {\n82\t        fprintf(f, \"... coding error!\");\n83\t    }\n84\t\n85\t    fprintf(f, \"\\\"\");\n86\t    return (error_found) ? -1 : 0;\n87\t}\n88\t\n89\tint qlog_chars(FILE* f, bytestream* s, uint64_t l)\n90\t{\n91\t    uint64_t x;\n92\t    int error_found = (s->ptr + (size_t)l > s->size);\n93\t\n94\t    fprintf(f, \"\\\"\");\n95\t\n96\t    for (x = 0; x < l && s->ptr < s->size; x++) {\n97\t        int c = s->data[s->ptr++];\n98\t        if (c == '\"' || c == '\\\\') {\n99\t            fprintf(f, \"\\\\%c\", c);\n100\t        }\n101\t        else if (c >= ' ' && c < 127) {\n102\t            fprintf(f, \"%c\", c);\n103\t        }\n104\t        else {\n105\t            fprintf(f, \"\\\\%02x\", c);\n106\t        }\n107\t    }\n108\t\n109\t    if (error_found) {\n110\t        fprintf(f, \"... coding error!\");\n111\t    }\n112\t\n113\t    fprintf(f, \"\\\"\");\n114\t    return (error_found) ? -1 : 0;\n115\t}\n116\t\n117\tstatic void qlog_log_addr(FILE* f, struct sockaddr* addr_peer)\n118\t{\n119\t    if (addr_peer->sa_family == AF_INET) {\n120\t        struct sockaddr_in* s4 = (struct sockaddr_in*)addr_peer;\n121\t        uint8_t* addr = (uint8_t*)&s4->sin_addr;\n122\t\n123\t        fprintf(f, \"\\\"ip_v4\\\": \\\"%d.%d.%d.%d\\\", \\\"port_v4\\\":%d\",\n124\t            addr[0], addr[1], addr[2], addr[3],\n125\t            s4->sin_port);\n126\t    }\n127\t    else {\n128\t        struct sockaddr_in6* s6 = (struct sockaddr_in6*)addr_peer;\n129\t        uint8_t* addr = (uint8_t*)&s6->sin6_addr;\n130\t\n131\t        fprintf(f, \" \\\"ip_v6\\\": \\\"\");\n132\t        for (int i = 0; i < 8; i++) {\n133\t            if (i != 0) {\n134\t                fprintf(f, \":\");\n135\t            }\n136\t\n137\t            if (addr[2 * i] != 0) {\n138\t                fprintf(f, \"%x%02x\", addr[2 * i], addr[(2 * i) + 1]);\n139\t            }\n140\t            else {\n141\t                fprintf(f, \"%x\", addr[(2 * i) + 1]);\n142\t            }\n143\t        }\n144\t        fprintf(f, \"\\\", \\\"port_v6\\\" :%d\", s6->sin6_port);\n145\t    }\n146\t}\n147\t\n148\tvoid qlog_event_header(FILE * f, qlog_context_t* ctx, int64_t delta_time, uint64_t path_id, char const * event_class, char const * event_name)\n149\t{\n150\t    fprintf(f, \"[%\"PRId64\", \", delta_time);\n151\t    if (ctx->trace_flow_id) {\n152\t        fprintf(f, \"%\"PRId64\", \", path_id);\n153\t    }\n154\t    fprintf(f, \"\\\"%s\\\", \\\"%s\\\", {\", event_class, event_name);\n155\t}\n156\t\n157\tvoid qlog_vint_transport_extension(FILE* f, char const* ext_name, bytestream* s, uint64_t len)\n158\t{\n159\t    uint64_t val;\n160\t    size_t current_ptr = s->ptr;\n161\t    int ret = byteread_vint(s, &val);\n162\t\n163\t    fprintf(f, \"\\\"%s\\\" : \", ext_name);\n164\t    if (ret != 0 || current_ptr + (size_t)len != s->ptr) {\n165\t        s->ptr = current_ptr;\n166\t        qlog_string(f, s, len);\n167\t    }\n168\t    else {\n169\t        fprintf(f, \"%\" PRIu64, val);\n170\t    }\n171\t}\n172\t\n173\tvoid qlog_boolean_transport_extension(FILE* f, char const* ext_name, bytestream* s, uint64_t len)\n174\t{\n175\t    fprintf(f, \"\\\"%s\\\" : \", ext_name);\n176\t    if (len != 0) {\n177\t        qlog_string(f, s, len);\n178\t    }\n179\t    else {\n180\t        fprintf(f, \"\\\"\\\"\");\n181\t    }\n182\t}\n183\t\n184\tvoid qlog_preferred_address(FILE* f, bytestream* s, uint64_t len)\n185\t{\n186\t    uint16_t port4 =0;\n187\t    uint16_t port6 = 0;\n188\t    uint8_t cid_len;\n189\t    size_t old_size = s->size;\n190\t\n191\t    s->size = s->ptr + (size_t) len;\n192\t\n193\t    fprintf(f, \"\\\"ip_v4\\\": \\\"\");\n194\t    for (int i = 0; i < 4 && s->ptr < s->size; i++, s->ptr++) {\n195\t        fprintf(f, \"%s%d\", (i == 0) ? \"\" : \".\", s->data[s->ptr]);\n196\t    }\n197\t    byteread_int16(s, &port4);\n198\t    fprintf(f, \"\\\", \\\"port_v4\\\":%d\", port4);\n199\t    fprintf(f, \", \\\"ip_v6\\\": \\\"\");\n200\t    for (int i = 0; i < 8; i++) {\n201\t        uint16_t chunk = 0;\n202\t        byteread_int16(s, &chunk);\n203\t        fprintf(f, \"%s%x\", (i == 0) ? \"\" : \":\", chunk);\n204\t    }\n205\t    byteread_int16(s, &port6);\n206\t    fprintf(f, \"\\\", \\\"port_v6\\\" : %d\", port6);\n207\t    byteread_int8(s, &cid_len);\n208\t    fprintf(f, \", \\\"connection_id\\\": \");\n209\t    qlog_string(f, s, cid_len);\n210\t    fprintf(f, \", \\\"stateless_reset_token\\\": \");\n211\t    qlog_string(f, s, 16);\n212\t    if (s->ptr < s->size) {\n213\t        fprintf(f, \"\\\", \\\"extra_bytes\\\": \");\n214\t        qlog_string(f, s, bytestream_remain(s));\n215\t    }\n216\t    s->size = old_size;\n217\t}\n218\t\n219\tvoid qlog_tp_version_negotiation(FILE* f, bytestream* s, uint64_t len)\n220\t{\n221\t    size_t old_size = s->size;\n222\t    size_t ptr_max = s->ptr + (size_t)len;\n223\t\n224\t    if (ptr_max > s->size) {\n225\t        fprintf(f, \",\\n    \\\"vnego_parameter_length\\\": %zu\", (size_t)len);\n226\t        fprintf(f, \",\\n    \\\"bytes_available\\\": %zu\", s->size - s->ptr);\n227\t    }\n228\t    else {\n229\t        s->size = s->ptr + (size_t)len;\n230\t        fprintf(f, \"{ \");\n231\t        if ((len & 3) != 0 || len == 0) {\n232\t            fprintf(f, \"\\\"bad_length\\\": \\\"%\" PRIu64, len);\n233\t        }\n234\t        else {\n235\t            fprintf(f, \"\\\"chosen\\\": \\\"\");\n236\t            for (int i = 0; i < 4 && s->ptr < s->size; i++, s->ptr++) {\n237\t                fprintf(f, \"%02x\", s->data[s->ptr]);\n238\t            }\n239\t            fprintf(f, \"\\\"\");\n240\t            if (s->ptr < s->size) {\n241\t                int is_first = 1;\n242\t                fprintf(f, \", \\\"others\\\": [\");\n243\t                do {\n244\t                    fprintf(f, \"%s\", (is_first) ? \"\\\"\" : \", \\\"\");\n245\t                    is_first = 0;\n246\t                    for (int i = 0; i < 4 && s->ptr < s->size; i++, s->ptr++) {\n247\t                        fprintf(f, \"%02x\", s->data[s->ptr]);\n248\t                    }\n249\t                    fprintf(f, \"\\\"\");\n250\t                } while (s->ptr < s->size);\n251\t                fprintf(f, \"]\");\n252\t            }\n253\t        }\n254\t        fprintf(f, \"}\");\n255\t        s->size = old_size;\n256\t    }\n257\t}\n258\t\n259\t\n260\tint qlog_transport_extensions(FILE* f, bytestream* v, size_t tp_length)\n261\t{\n262\t    int ret = 0;\n263\t    size_t ptr_max = v->ptr + tp_length;\n264\t\n265\t    if (ptr_max > v->size) {\n266\t        fprintf(f, \",\\n    \\\"transport_parameter_length\\\": %zu\", tp_length);\n267\t        fprintf(f, \",\\n    \\\"bytes_available\\\": %zu\" PRIu64, v->size - v->ptr);\n268\t    } else {\n269\t        bytestream bs = { 0 };\n270\t        bytestream* s = &bs;\n271\t        bs.data = v->data;\n272\t        bs.size = v->ptr + tp_length;\n273\t        bs.ptr = v->ptr;\n274\t        v->size += tp_length;\n275\t\n276\t        while (ret == 0 && s->ptr < ptr_max) {\n277\t            uint64_t extension_type = UINT64_MAX;\n278\t            uint64_t extension_length = 0;\n279\t            size_t current_ptr = s->ptr;\n280\t\n281\t            ret |= byteread_vint(s, &extension_type);\n282\t            ret |= byteread_vint(s, &extension_length);\n283\t\n284\t            fprintf(f, \",\\n    \");\n285\t\n286\t            if (ret != 0 || bytestream_remain(s) < extension_length) {\n287\t                size_t len = 0;\n288\t                ret = -1;\n289\t                s->ptr = current_ptr;\n290\t                len = bytestream_remain(s);\n291\t                /* Print invalid parameter there */\n292\t                fprintf(f, \"\\\"Parameter_coding_error\\\": \");\n293\t                qlog_string(f, s, len);\n294\t                break;\n295\t            }\n296\t            else {\n297\t                switch ((picoquic_tp_enum)extension_type) {\n298\t                case picoquic_tp_initial_max_stream_data_bidi_local:\n299\t                case picoquic_tp_initial_max_stream_data_bidi_remote:\n300\t                case picoquic_tp_initial_max_stream_data_uni:\n301\t                case picoquic_tp_initial_max_data:\n302\t                case picoquic_tp_initial_max_streams_bidi:\n303\t                case picoquic_tp_idle_timeout:\n304\t                case picoquic_tp_max_packet_size:\n305\t                case picoquic_tp_ack_delay_exponent:\n306\t                case picoquic_tp_initial_max_streams_uni:\n307\t                case picoquic_tp_max_ack_delay:\n308\t                case picoquic_tp_active_connection_id_limit:\n309\t                case picoquic_tp_max_datagram_frame_size:\n310\t                case picoquic_tp_enable_loss_bit:\n311\t                case picoquic_tp_min_ack_delay:\n312\t                case picoquic_tp_enable_bdp_frame:\n313\t                case picoquic_tp_initial_max_path_id:\n314\t                case picoquic_tp_address_discovery:\n315\t                case picoquic_tp_reset_stream_at:\n316\t                    qlog_vint_transport_extension(f, picoquic_tp_name(extension_type), s, extension_length);\n317\t                    break;\n318\t\n319\t                case picoquic_tp_stateless_reset_token:\n320\t                case picoquic_tp_original_connection_id:\n321\t                case picoquic_tp_retry_connection_id:\n322\t                case picoquic_tp_handshake_connection_id:\n323\t                    fprintf(f, \"\\\"%s\\\": \", picoquic_tp_name(extension_type));\n324\t                    qlog_string(f, s, extension_length);\n325\t                    break;\n326\t                case picoquic_tp_server_preferred_address: \n327\t                    fprintf(f, \"\\\"%s\\\": \", picoquic_tp_name(extension_type));\n328\t                    qlog_preferred_address(f, s, extension_length);\n329\t                    fprintf(f, \"}\");\n330\t                    break;\n331\t                case picoquic_tp_disable_migration:\n332\t                case picoquic_tp_enable_time_stamp:\n333\t                case picoquic_tp_grease_quic_bit:\n334\t                    qlog_boolean_transport_extension(f, picoquic_tp_name((picoquic_tp_enum)extension_type), s, extension_length);\n335\t                    break;\n336\t                case picoquic_tp_version_negotiation:\n337\t                    fprintf(f, \"\\\"%s\\\": \", picoquic_tp_name(extension_type));\n338\t                    qlog_tp_version_negotiation(f, s, extension_length);\n339\t                    break;\n340\t                default:\n341\t                    /* dump unknown extensions */\n342\t                    fprintf(f, \"\\\"%\" PRIx64 \"\\\": \", extension_type);\n343\t                    qlog_string(f, s, extension_length);\n344\t                    break;\n345\t                }\n346\t            }\n347\t        }\n348\t    }\n349\t\n350\t    return ret;\n351\t}\n352\t\n353\t\n354\tint qlog_alpn_update(uint64_t time, bytestream* s, void* ptr)\n355\t{\n356\t    qlog_context_t* ctx = (qlog_context_t*)ptr;\n357\t    int64_t delta_time = time - ctx->start_time;\n358\t    FILE* f = ctx->f_txtlog;\n359\t    uint64_t owner = 0;\n360\t    uint64_t sni_length = 0;\n361\t    uint64_t alpn_length = 0;\n362\t    uint64_t alpn_count = 0;\n363\t    int ret = 0;\n364\t\n365\t    ret |= byteread_vint(s, &owner);\n366\t\n367\t    if (ctx->event_count != 0) {\n368\t        fprintf(f, \",\\n\");\n369\t    }\n370\t    else {\n371\t        fprintf(f, \"\\n\");\n372\t    }\n373\t\n374\t    ret |= byteread_vint(s, &sni_length);\n375\t    qlog_event_header(f, ctx, delta_time, 0, \"transport\", \"parameters_set\");\n376\t    fprintf(f, \"\\n    \\\"owner\\\": \\\"%s\\\"\", (owner) ? \"local\" : \"remote\");\n377\t    if (sni_length > 0) {\n378\t        fprintf(f, \",\\n    \\\"sni\\\": \");\n379\t        ret |= qlog_chars(f, s, sni_length);\n380\t    }\n381\t\n382\t    ret |= byteread_vint(s, &alpn_count);\n383\t    if (ret == 0 && alpn_count > 0) {\n384\t        fprintf(f, \",\\n    \\\"proposed_alpn\\\": [\");\n385\t\n386\t        for (size_t i = 0; i < alpn_count; i++) {\n387\t            uint64_t len;\n388\t            if (i != 0) {\n389\t                fprintf(f, \", \");\n390\t            }\n391\t            ret |= byteread_vint(s, &len);\n392\t            ret |= qlog_chars(f, s, len);\n393\t        }\n394\t        fprintf(f, \"]\");\n395\t    }\n396\t\n397\t\n398\t    ret |= byteread_vint(s, &alpn_length);\n399\t    if (ret == 0 && alpn_length > 0) {\n400\t        fprintf(f, \",\\n    \\\"alpn\\\": \");\n401\t        qlog_chars(f, s, alpn_length);\n402\t    }\n403\t\n404\t    fprintf(f, \"}]\");\n405\t\n406\t    ctx->event_count++;\n407\t\n408\t    return 0;\n409\t}\n410\t\n411\t\n412\tint qlog_param_update(uint64_t time, bytestream* s, void* ptr)\n413\t{\n414\t    qlog_context_t* ctx = (qlog_context_t*)ptr;\n415\t    int64_t delta_time = time - ctx->start_time;\n416\t    FILE* f = ctx->f_txtlog;\n417\t    uint64_t owner = 0;\n418\t    uint64_t tp_length = 0;\n419\t    int ret = 0;\n420\t\n421\t    ret |= byteread_vint(s, &owner);\n422\t\n423\t    if (ctx->event_count != 0) {\n424\t        fprintf(f, \",\\n\");\n425\t    }\n426\t    else {\n427\t        fprintf(f, \"\\n\");\n428\t    }\n429\t\n430\t    qlog_event_header(f, ctx, delta_time, 0, \"transport\", \"parameters_set\");\n431\t\n432\t    fprintf(f, \"\\n    \\\"owner\\\": \\\"%s\\\"\", (owner)?\"local\":\"remote\");\n433\t\n434\t    ret |= byteread_vint(s, &tp_length);\n435\t\n436\t    if (ret == 0 && tp_length > 0) {\n437\t        qlog_transport_extensions(f, s, (size_t)tp_length);\n438\t    }\n439\t    \n440\t    fprintf(f, \"}]\");\n441\t\n442\t    ctx->event_count++;\n443\t\n444\t    return 0;\n445\t}\n446\t\n447\tint qlog_packet_lost(uint64_t time, uint64_t path_id, bytestream* s, void* ptr)\n448\t{\n449\t    qlog_context_t* ctx = (qlog_context_t*)ptr;\n450\t    int64_t delta_time = time - ctx->start_time;\n451\t    FILE* f = ctx->f_txtlog;\n452\t    uint64_t packet_type = 0;\n453\t    uint64_t sequence = 0;\n454\t    uint64_t trigger_length;\n455\t    uint64_t packet_size = 0;\n456\t    uint8_t cid_len = 0;\n457\t    int ret = 0;\n458\t\n459\t    ret |= byteread_vint(s, &packet_type);\n460\t    ret |= byteread_vint(s, &sequence);\n461\t    ret |= byteread_vint(s, &trigger_length);\n462\t\n463\t    if (ctx->event_count != 0) {\n464\t        fprintf(f, \",\\n\");\n465\t    }\n466\t    else {\n467\t        fprintf(f, \"\\n\");\n468\t    }\n469\t\n470\t    qlog_event_header(f, ctx, delta_time, path_id, \"recovery\", \"packet_lost\");\n471\t    fprintf(f, \"\\n    \\\"packet_type\\\" : \\\"%s\\\"\", ptype2str((picoquic_packet_type_enum)packet_type));\n472\t    fprintf(f, \",\\n    \\\"packet_number\\\" : %\" PRIu64, sequence);\n473\t    if (trigger_length > 0) {\n474\t        fprintf(f, \",\\n    \\\"trigger\\\": \");\n475\t        ret |= qlog_chars(f, s, trigger_length);\n476\t    }\n477\t    fprintf(f, \",\\n    \\\"header\\\": {\");\n478\t    fprintf(f, \"\\n        \\\"packet_type\\\" : \\\"%s\\\"\", ptype2str((picoquic_packet_type_enum)packet_type));\n479\t    fprintf(f, \",\\n        \\\"packet_number\\\" : %\" PRIu64, sequence);\n480\t    ret |= byteread_int8(s, &cid_len);\n481\t    if (ret == 0 && cid_len > 0) {\n482\t        fprintf(f, \",\\n        \\\"dcid\\\" : \");\n483\t        qlog_string(f, s, cid_len);\n484\t    }\n485\t    ret |= byteread_vint(s, &packet_size);\n486\t    if (ret == 0) {\n487\t        fprintf(f, \",\\n        \\\"packet_size\\\" : %\" PRIu64, packet_size);\n488\t    }\n489\t    fprintf(f, \"}}]\");\n490\t\n491\t    ctx->event_count++;\n492\t\n493\t    return 0;\n494\t}\n495\t\n496\tint qlog_packet_dropped(uint64_t time, uint64_t path_id, bytestream* s, void* ptr)\n497\t{\n498\t    qlog_context_t* ctx = (qlog_context_t*)ptr;\n499\t    int64_t delta_time = time - ctx->start_time;\n500\t    FILE* f = ctx->f_txtlog;\n501\t    uint64_t packet_type = 0;\n502\t    uint64_t err_code;\n503\t    uint64_t packet_size = 0;\n504\t#if 1\n505\t#else\n506\t    char const* str;\n507\t#endif\n508\t    int ret = 0;\n509\t\n510\t    ret |= byteread_vint(s, &packet_type);\n511\t    ret |= byteread_vint(s, &packet_size);\n512\t    ret |= byteread_vint(s, &err_code);\n513\t\n514\t    if (ctx->event_count != 0) {\n515\t        fprintf(f, \",\\n\");\n516\t    }\n517\t    else {\n518\t        fprintf(f, \"\\n\");\n519\t    }\n520\t\n521\t    qlog_event_header(f, ctx, delta_time, path_id, \"transport\", \"packet_dropped\");\n522\t    if (err_code != PICOQUIC_ERROR_PADDING_PACKET){\n523\t        fprintf(f, \"\\n    \\\"packet_type\\\" : \\\"%s\\\",\", ptype2str((picoquic_packet_type_enum)packet_type));\n524\t    }\n525\t    fprintf(f, \"\\n    \\\"packet_size\\\" : %\" PRIu64, packet_size);\n526\t\n527\t#if 1\n528\t    fprintf(f, \",\\n    \\\"trigger\\\": \\\"%s\\\"\", picoquic_error_name(err_code));\n529\t#else\n530\t    switch (err_code) {\n531\t    case PICOQUIC_ERROR_DUPLICATE:\n532\t        str = \"dos_prevention\";\n533\t        break;\n534\t    case PICOQUIC_ERROR_AEAD_CHECK:\n535\t        str = \"payload_decrypt_error\";\n536\t        break;\n537\t    case PICOQUIC_ERROR_CNXID_CHECK:\n538\t        str = \"unknown_connection_id\";\n539\t        break;\n540\t    case PICOQUIC_ERROR_INITIAL_TOO_SHORT:\n541\t        str = \"dos_prevention\";\n542\t        break;\n543\t    case PICOQUIC_ERROR_CNXID_NOT_AVAILABLE:\t\n544\t        str = \"unknown_connection_id\";\n545\t        break;\n546\t    case PICOQUIC_ERROR_KEY_ROTATION_NOT_READY:\n547\t        str = \"key_unavailable\";\n548\t        break;\n549\t    case PICOQUIC_ERROR_AEAD_NOT_READY:\n550\t        str = \"key_unavailable\";\n551\t        break;\n552\t    case PICOQUIC_ERROR_STATELESS_RESET:\n553\t        str = \"stateless_reset\";\n554\t        break;\n555\t    case PICOQUIC_ERROR_PADDING_PACKET:\n556\t        str = \"padding_packet\";\n557\t        break;\n558\t    default:\n559\t        str = \"protocol_violation\";\n560\t        break;\n561\t    }\n562\t    fprintf(f, \",\\n    \\\"trigger\\\": \\\"%s\\\"\", str);\n563\t#endif\n564\t\n565\t    fprintf(f, \"}]\");\n566\t\n567\t    ctx->event_count++;\n568\t\n569\t    return ret;\n570\t}\n571\t\n572\tint qlog_packet_buffered(uint64_t time, uint64_t path_id, bytestream* s, void* ptr)\n573\t{\n574\t    qlog_context_t* ctx = (qlog_context_t*)ptr;\n575\t    int64_t delta_time = time - ctx->start_time;\n576\t    FILE* f = ctx->f_txtlog;\n577\t    uint64_t packet_type = 0;\n578\t    uint64_t trigger_length = 0;\n579\t    int ret = 0;\n580\t\n581\t    ret |= byteread_vint(s, &packet_type);\n582\t    ret |= byteread_vint(s, &trigger_length);\n583\t\n584\t    if (ctx->event_count != 0) {\n585\t        fprintf(f, \",\\n\");\n586\t    }\n587\t    else {\n588\t        fprintf(f, \"\\n\");\n589\t    }\n590\t\n591\t    qlog_event_he