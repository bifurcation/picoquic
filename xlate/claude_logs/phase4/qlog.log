{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_0191f2vhyjFYQ5Ve3vDgPRx8","type":"tool_result","content":"105\t/// variants later isn't a breaking change.\n106\t#[derive(Debug, Clone, Copy, PartialEq, Eq)]\n107\t#[non_exhaustive]\n108\tpub enum Error {\n109\t    /// Catch-all placeholder for paths Phase 1 has not yet\n110\t    /// distinguished.  Phase 3 should narrow these.\n111\t    Generic,\n112\t    /// Allocation failed.\n113\t    Memory,\n114\t    /// Caller supplied an invalid argument.\n115\t    InvalidArgument,\n116\t    /// A buffer the caller supplied was too small.\n117\t    BufferTooSmall,\n118\t    /// Caller-supplied file does not exist.\n119\t    NoSuchFile,\n120\t    /// Caller-supplied file was malformed.\n121\t    InvalidFile,\n122\t    /// Connection has been disconnected.\n123\t    Disconnected,\n124\t    /// Connection state didn't permit the requested operation.\n125\t    InvalidState,\n126\t    /// Operation produced or received a malformed QUIC frame.\n127\t    InvalidFrame,\n128\t    /// TLS / crypto error.\n129\t    Tls,\n130\t    /// Other QUIC protocol error; the wrapped value is the\n131\t    /// numeric `ERROR_*` code defined in this module.\n132\t    Protocol(u64),\n133\t}\n134\t\n135\timpl core::fmt::Display for Error {\n136\t    fn fmt(&self, f: &mut core::fmt::Formatter<'_>) -> core::fmt::Result {\n137\t        write!(f, \"{:?}\", self)\n138\t    }\n139\t}\n140\t\n141\timpl core::error::Error for Error {}\n142\t\n143\t/// Crate-wide `Result` alias defaulting the error type to [`Error`].\n144\tpub type Result<T, E = Error> = core::result::Result<T, E>;\n145\t\n146\t/// Wall-clock instant in microseconds since some application-defined\n147\t/// epoch.  Replaces the C `uint64_t current_time` parameter that\n148\t/// threads through every API call needing \"now\".  The type is\n149\t/// `Copy`, supports arithmetic with [`Duration`], and converts to\n150\t/// `u64` cheaply via `.ticks()` when crossing wire boundaries.\n151\t///\n152\t/// Phase 2 decision: per-call `current_time: Instant` parameters\n153\t/// stay (matches the C source's design — caller decides what time\n154\t/// it is).  No `Clock` trait at the library level; applications\n155\t/// can build a clock-injecting wrapper around the calls if they\n156\t/// want that style.\n157\tpub type Instant = fugit::Instant<u64, 1, 1_000_000>;\n158\t\n159\t/// Duration in microseconds.  Companion to [`Instant`].  Use for\n160\t/// timeouts, RTTs, jitter, etc.  In the C source these are bare\n161\t/// `uint64_t` values labelled by context (`idle_timeout`,\n162\t/// `microsec_latency`, …); the typed alias makes the unit explicit.\n163\tpub type Duration = fugit::Duration<u64, 1, 1_000_000>;\n164\t"}]},"parent_tool_use_id":null,"session_id":"49016d8b-074a-4ac9-aa66-ab3c58354a86","uuid":"337b4ad4-9249-4245-8a9a-6606e8c399df","timestamp":"2026-05-06T11:59:51.923Z","tool_use_result":{"type":"text","file":{"filePath":"/Users/richbarn/Projects/picoquic/rs/fq/src/lib.rs","content":"/// variants later isn't a breaking change.\n#[derive(Debug, Clone, Copy, PartialEq, Eq)]\n#[non_exhaustive]\npub enum Error {\n    /// Catch-all placeholder for paths Phase 1 has not yet\n    /// distinguished.  Phase 3 should narrow these.\n    Generic,\n    /// Allocation failed.\n    Memory,\n    /// Caller supplied an invalid argument.\n    InvalidArgument,\n    /// A buffer the caller supplied was too small.\n    BufferTooSmall,\n    /// Caller-supplied file does not exist.\n    NoSuchFile,\n    /// Caller-supplied file was malformed.\n    InvalidFile,\n    /// Connection has been disconnected.\n    Disconnected,\n    /// Connection state didn't permit the requested operation.\n    InvalidState,\n    /// Operation produced or received a malformed QUIC frame.\n    InvalidFrame,\n    /// TLS / crypto error.\n    Tls,\n    /// Other QUIC protocol error; the wrapped value is the\n    /// numeric `ERROR_*` code defined in this module.\n    Protocol(u64),\n}\n\nimpl core::fmt::Display for Error {\n    fn fmt(&self, f: &mut core::fmt::Formatter<'_>) -> core::fmt::Result {\n        write!(f, \"{:?}\", self)\n    }\n}\n\nimpl core::error::Error for Error {}\n\n/// Crate-wide `Result` alias defaulting the error type to [`Error`].\npub type Result<T, E = Error> = core::result::Result<T, E>;\n\n/// Wall-clock instant in microseconds since some application-defined\n/// epoch.  Replaces the C `uint64_t current_time` parameter that\n/// threads through every API call needing \"now\".  The type is\n/// `Copy`, supports arithmetic with [`Duration`], and converts to\n/// `u64` cheaply via `.ticks()` when crossing wire boundaries.\n///\n/// Phase 2 decision: per-call `current_time: Instant` parameters\n/// stay (matches the C source's design — caller decides what time\n/// it is).  No `Clock` trait at the library level; applications\n/// can build a clock-injecting wrapper around the calls if they\n/// want that style.\npub type Instant = fugit::Instant<u64, 1, 1_000_000>;\n\n/// Duration in microseconds.  Companion to [`Instant`].  Use for\n/// timeouts, RTTs, jitter, etc.  In the C source these are bare\n/// `uint64_t` values labelled by context (`idle_timeout`,\n/// `microsec_latency`, …); the typed alias makes the unit explicit.\npub type Duration = fugit::Duration<u64, 1, 1_000_000>;\n","numLines":60,"startLine":105,"totalLines":3705}}}
