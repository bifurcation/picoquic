{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01VfF3bQQomjunGE1xRTbgXx","type":"tool_result","content":"1\t//! Translation of `picoquic/picosocks.h` plus the Phase 2 socket\n2\t//! abstraction.\n3\t//!\n4\t//! Phase 2 reshape: the C `SOCKET_TYPE` (a Linux file descriptor)\n5\t//! is replaced by a [`Socket`] *trait* that the host platform\n6\t//! implements.  The default implementation wraps\n7\t//! [`socket2::Socket`] (the canonical cross-platform UDP socket\n8\t//! crate); other backends (no-std embedded, Windows-specific,\n9\t//! the test simulator) implement the same trait.\n10\t//! [`ServerSockets<S>`] is generic over the implementor.\n11\t//!\n12\t//! Phase 1 contract: signatures only — every method body is\n13\t//! `todo!()`.\n14\t\n15\tuse core::net::SocketAddr;\n16\t\n17\tuse crate::Error;\n18\tuse crate::Instant;\n19\t\n20\t// ---------------------------------------------------------------------------\n21\t// Constants and supporting types.\n22\t\n23\t/// Number of UDP sockets a server context owns — one IPv4, one\n24\t/// IPv6.  C: `PICOQUIC_NB_SERVER_SOCKETS`.\n25\tpub const SERVER_SOCKET_COUNT: usize = 2;\n26\t\n27\t/// `MessageHeader` is a re-export of [`socket2::MsgHdr`] — the\n28\t/// canonical cross-platform `msghdr` wrapper.  Phase 4 fills in\n29\t/// the bodies that thread one through the cmsg helpers.\n30\tpub type MessageHeader<'addr, 'bufs, 'control> = socket2::MsgHdr<'addr, 'bufs, 'control>;\n31\t\n32\t/// OS error code surfaced by socket sends when the underlying\n33\t/// syscall fails.  Wraps the raw Linux `errno` (or its Windows\n34\t/// equivalent on other targets) and exposes\n35\t/// [`OsError::is_unreachable`] for the path-abandon decision the\n36\t/// C `picoquic_socket_error_implies_unreachable` helper made.\n37\t#[derive(Debug, Copy, Clone, PartialEq, Eq)]\n38\tpub struct OsError(pub i32);\n39\t\n40\timpl OsError {\n41\t    /// Whether this errno implies the destination is unreachable\n42\t    /// and the owning path should be abandoned.  C:\n43\t    /// `picoquic_socket_error_implies_unreachable`.\n44\t    pub fn is_unreachable(self) -> bool {\n45\t        use std::io::ErrorKind;\n46\t        let kind = std::io::Error::from_raw_os_error(self.0).kind();\n47\t        matches!(\n48\t            kind,\n49\t            ErrorKind::ConnectionReset\n50\t                | ErrorKind::HostUnreachable\n51\t                | ErrorKind::NetworkDown\n52\t                | ErrorKind::NetworkUnreachable\n53\t        )\n54\t    }\n55\t}\n56\t\n57\t// ---------------------------------------------------------------------------\n58\t// `Socket` trait.\n59\t\n60\t/// One UDP socket on the application's network stack.  Replaces\n61\t/// the C `SOCKET_TYPE` (a raw file descriptor); the host\n62\t/// implementation supplies open / bind / send / recv operations\n63\t/// while the rest of picoquic stays platform-agnostic.\n64\t///\n65\t/// The default [`socket2::Socket`] implementation is in\n66\t/// [`crate::socks_socket2`] (gated on the `std` feature).\n67\tpub trait Socket {\n68\t    /// Local address bound to this socket (`getsockname`).\n69\t    /// C: `picoquic_get_local_address`.\n70\t    fn local_address(&self) -> Result<SocketAddr, Error>;\n71\t\n72\t    /// Receive one UDP datagram into `buffer`.  Output parameters\n73\t    /// (source / dest address, interface index, ECN, byte count)\n74\t    /// fold into [`RecvInfo`]; the slice length subsumes the C\n75\t    /// `buffer_max` parameter.  C: `picoquic_recvmsg`.\n76\t    fn recv(&mut self, buffer: &mut [u8]) -> Result<RecvInfo, Error>;\n77\t\n78\t    /// Send `bytes` to `addr_dest` from `addr_from` with an\n79\t    /// optional GSO segmentation hint `gso_size` (`UDP_SEGMENT`).\n80\t    /// `addr_from = None` lets the kernel choose the source\n81\t    /// address.  `Ok(n)` reports bytes sent; `Err` carries the\n82\t    /// OS error.  C: `picoquic_sendmsg`.\n83\t    fn send(\n84\t        &mut self,\n85\t        addr_dest: &SocketAddr,\n86\t        addr_from: Option<&SocketAddr>,\n87\t        dest_if: i32,\n88\t        bytes: &[u8],\n89\t        gso_size: i32,\n90\t    ) -> Result<usize, OsError>;\n91\t\n92\t    /// Enable per-packet destination-info delivery on this\n93\t    /// socket (`IP_PKTINFO` / `IPV6_RECVPKTINFO`).  Default:\n94\t    /// no-op for backends that don't surface pktinfo.\n95\t    fn set_pkt_info(&mut self) -> Result<(), Error> {\n96\t        Ok(())\n97\t    }\n98\t\n99\t    /// Enable ECN reception (and request `ECN_ECT_1` outbound).\n100\t    /// Returns `(recv_set, send_set)` indicating whether the\n101\t    /// kernel honored each socket option.  Default: no-op,\n102\t    /// returns `(false, false)`.\n103\t    fn set_ecn_options(&mut self) -> Result<(bool, bool), Error> {\n104\t        Ok((false, false))\n105\t    }\n106\t\n107\t    /// Like [`Self::set_ecn_options`] but with an explicit\n108\t    /// outbound TOS / ECN value (`ecn` is one of the 2-bit\n109\t    /// `EcnCodepoint` codes).  Default: delegates to the\n110\t    /// no-op `set_ecn_options`.\n111\t    fn set_ecn_options_ex(&mut self, _ecn: EcnCodepoint) -> Result<(bool, bool), Error> {\n112\t        self.set_ecn_options()\n113\t    }\n114\t\n115\t    /// Enable Path-MTU-Discovery probing on this socket\n116\t    /// (Linux-only; no-op on other platforms by default).\n117\t    fn set_pmtud_options(&mut self) -> Result<(), Error> {\n118\t        Ok(())\n119\t    }\n120\t\n121\t    /// Open and bind an IPv4 server socket on `port`.  Called by\n122\t    /// [`ServerSockets::open`]; concrete implementations override\n123\t    /// this to use their socket backend.\n124\t    fn open_server_v4(_port: i32) -> Result<Self, Error>\n125\t    where\n126\t        Self: Sized,\n127\t    {\n128\t        Err(Error::Generic)\n129\t    }\n130\t\n131\t    /// Open and bind an IPv6 server socket on `port`.  Called by\n132\t    /// [`ServerSockets::open`]; concrete implementations override\n133\t    /// this to use their socket backend.\n134\t    fn open_server_v6(_port: i32) -> Result<Self, Error>\n135\t    where\n136\t        Self: Sized,\n137\t    {\n138\t        Err(Error::Generic)\n139\t    }\n140\t}\n141\t\n142\t// ---------------------------------------------------------------------------\n143\t// `ServerSockets` -- generic over the socket implementation.\n144\t\n145\t/// Pair of UDP sockets owned by a server (one IPv4, one IPv6).\n146\t/// C: `picoquic_server_sockets_t`.  Generic over the active\n147\t/// [`Socket`] implementation.\n148\tpub struct ServerSockets<S: Socket> {\n149\t    /// One UDP socket per address family.  `None` slots are\n150\t    /// uninitialised — see [`ServerSockets::open`] /\n151\t    /// [`ServerSockets::close`].\n152\t    pub sockets: [Option<S>; SERVER_SOCKET_COUNT],\n153\t}\n154\t\n155\timpl<S: Socket> Default for ServerSockets<S> {\n156\t    fn default() -> Self {\n157\t        Self {\n158\t            sockets: [None, None],\n159\t        }\n160\t    }\n161\t}\n162\t\n163\timpl<S: Socket> ServerSockets<S> {\n164\t    /// Open the IPv4 + IPv6 server-side UDP socket pair listening\n165\t    /// on `port`.  C: `picoquic_open_server_sockets`.  The\n166\t    /// concrete `S` implementor is chosen at the call site;\n167\t    /// the default `crate::socks_socket2::Socket2Udp` wraps\n168\t    /// [`socket2::Socket`].\n169\t    pub fn open(port: i32) -> Result<Self, Error> {\n170\t        let s6 = S::open_server_v6(port)?;\n171\t        let s4 = S::open_server_v4(port)?;\n172\t        Ok(Self {\n173\t            sockets: [Some(s6), Some(s4)],\n174\t        })\n175\t    }\n176\t\n177\t    /// Close every socket in the pair, leaving each slot `None`.\n178\t    /// C: `picoquic_close_server_sockets`.\n179\t    pub fn close(&mut self) {\n180\t        for slot in &mut self.sockets {\n181\t            *slot = None;\n182\t        }\n183\t    }\n184\t\n185\t    /// Pick the matching socket (v4 / v6, dispatched by\n186\t    /// `addr_dest`'s family) and send through it.\n187\t    /// C: `picoquic_send_through_server_sockets`.\n188\t    pub fn send_through(\n189\t        &mut self,\n190\t        addr_dest: &SocketAddr,\n191\t        addr_from: Option<&SocketAddr>,\n192\t        from_if: i32,\n193\t        bytes: &[u8],\n194\t    ) -> Result<usize, OsError> {\n195\t        let idx = if addr_dest.is_ipv4() { 1 } else { 0 };\n196\t        match &mut self.sockets[idx] {\n197\t            Some(s) => s.send(addr_dest, addr_from, from_if, bytes, 0),\n198\t            None => Err(OsError(-1)),\n199\t        }\n200\t    }\n201\t}\n202\t\n203\t// ---------------------------------------------------------------------------\n204\t// Receive metadata.\n205\t\n206\t/// Receive metadata returned by [`Socket::recv`].  Mirrors the\n207\t/// C output parameters folded into a single struct.\n208\t#[derive(Debug, Default, Copy, Clone)]\n209\tpub struct RecvInfo {\n210\t    /// Source address; `None` matches the C `addr_from->ss_family\n211\t    /// = 0` written when `recvmsg` returned `<= 0`.\n212\t    pub addr_from: Option<SocketAddr>,\n213\t    /// Destination address parsed out of `IP_PKTINFO` /\n214\t    /// `IPV6_PKTINFO` cmsg; `None` when no pktinfo was attached.\n215\t    pub addr_dest: Option<SocketAddr>,\n216\t    /// Receiving interface index from the same cmsg.\n217\t    pub dest_if: i32,\n218\t    /// `IP_TOS` / `IPV6_TCLASS` ECN code-point byte.\n219\t    pub received_ecn: u8,\n220\t    /// Number of bytes written into the caller's buffer.\n221\t    pub bytes_recv: usize,\n222\t}\n223\t\n224\t/// Result of [`select`].\n225\t///\n226\t/// Folds the seven nullable out-parameters of the C\n227\t/// `picoquic_select_ex` helper into one struct: source / destination\n228\t/// address, interface index, ECN code-point, byte count,\n229\t/// post-receive timestamp, and the index of the socket that fired.\n230\t#[derive(Debug, Copy, Clone)]\n231\tpub struct SelectInfo {\n232\t    pub addr_from: Option<SocketAddr>,\n233\t    pub addr_dest: Option<SocketAddr>,\n234\t    pub dest_if: i32,\n235\t    pub received_ecn: u8,\n236\t    pub bytes_recv: usize,\n237\t    pub current_time: Instant,\n238\t    pub socket_rank: usize,\n239\t}\n240\t\n241\timpl Default for SelectInfo {\n242\t    fn default() -> Self {\n243\t        Self {\n244\t            addr_from: None,\n245\t            addr_dest: None,\n246\t            dest_if: 0,\n247\t            received_ecn: 0,\n248\t            bytes_recv: 0,\n249\t            current_time: Instant::from_ticks(0),\n250\t            socket_rank: 0,\n251\t        }\n252\t    }\n253\t}\n254\t\n255\t/// Wait up to `delta_t` microseconds for a packet on any socket\n256\t/// in `sockets`, then read at most `buffer.len()` bytes.\n257\t///\n258\t/// Generic over the [`Socket`] implementation.  C:\n259\t/// `picoquic_select` and `picoquic_select_ex` are merged here —\n260\t/// the `_ex` form is the more general one; the rank lives in\n261\t/// [`SelectInfo`].\n262\tpub fn select<S: Socket>(\n263\t    _sockets: &mut [S],\n264\t    _buffer: &mut [u8],\n265\t    _delta_t: i64,\n266\t) -> Result<SelectInfo, Error> {\n267\t    todo!()\n268\t}\n269\t\n270\t// ---------------------------------------------------------------------------\n271\t// Address resolution.\n272\t\n273\t/// Resolved server address plus the \"was the input a hostname?\"\n274\t/// hint the TLS layer needs to choose an SNI value.\n275\t#[derive(Debug, Copy, Clone)]\n276\tpub struct ServerAddress {\n277\t    pub addr: SocketAddr,\n278\t    pub is_name: bool,\n279\t}\n280\t\n281\timpl ServerAddress {\n282\t    /// Parse `ip_address_text` (numeric IPv4 / IPv6 or hostname)\n283\t    /// and combine with `server_port` into a [`ServerAddress`].\n284\t    /// C: `picoquic_get_server_address`.\n285\t    pub fn resolve(ip_address_text: &str, server_port: i32) -> Result<Self, Error> {\n286\t        let port = server_port as u16;\n287\t        // Try numeric IPv4.\n288\t        if let Ok(ipv4) = ip_address_text.parse::<std::net::Ipv4Addr>() {\n289\t            return Ok(Self {\n290\t                addr: SocketAddr::V4(std::net::SocketAddrV4::new(ipv4, port)),\n291\t                is_name: false,\n292\t            });\n293\t        }\n294\t        // Try numeric IPv6.\n295\t        if let Ok(ipv6) = ip_address_text.parse::<std::net::Ipv6Addr>() {\n296\t            return Ok(Self {\n297\t                addr: SocketAddr::V6(std::net::SocketAddrV6::new(ipv6, port, 0, 0)),\n298\t                is_name: false,\n299\t            });\n300\t        }\n301\t        // Hostname: DNS lookup.\n302\t        use std::net::ToSocketAddrs;\n303\t        let addr = (ip_address_text, port)\n304\t            .to_socket_addrs()\n305\t            .map_err(|_| Error::Generic)?\n306\t            .next()\n307\t            .ok_or(Error::Generic)?;\n308\t        Ok(Self {\n309\t            addr,\n310\t            is_name: true,\n311\t        })\n312\t    }\n313\t}\n314\t\n315\t// ---------------------------------------------------------------------------\n316\t// Control-message helpers (cmsg parse / format).\n317\t\n318\t/// Result of cmsg parsing.  Folds the four nullable\n319\t/// out-parameters of the C helper into one struct.\n320\t#[derive(Debug, Default, Copy, Clone)]\n321\tpub struct CmsgInfo {\n322\t    /// Destination address parsed from `IP_PKTINFO` / `IPV6_PKTINFO`;\n323\t    /// `None` when no pktinfo was attached.\n324\t    pub addr_dest: Option<SocketAddr>,\n325\t    /// Receiving interface index from the same cmsg.\n326\t    pub dest_if: Option<i32>,\n327\t    /// `IP_TOS` / `IPV6_TCLASS` ECN code-point.\n328\t    pub received_ecn: Option<EcnCodepoint>,\n329\t    /// `UDP_GRO` segment size; always `0` on Linux.\n330\t    pub udp_coalesced_size: usize,\n331\t}\n332\t\n333\t/// IP / IPv6 ECN code-point reported by the kernel on receive.\n334\t/// Mirrors the two-bit `IP_TOS` / `IPV6_TCLASS` ECN field.\n335\t#[derive(Debug, Default, Copy, Clone, PartialEq, Eq)]\n336\t#[repr(u8)]\n337\tpub enum EcnCodepoint {\n338\t    #[default]\n339\t    NotEct = 0b00,\n340\t    Ect1 = 0b01,\n341\t    Ect0 = 0b10,\n342\t    Ce = 0b11,\n343\t}\n344\t\n345\t/// Parse the control-message ancillary data attached to a\n346\t/// received `msghdr`.  C: `picoquic_socks_cmsg_parse`.\n347\tpub fn parse_cmsg(_header: &MessageHeader<'_, '_, '_>) -> CmsgInfo {\n348\t    todo!()\n349\t}\n350\t\n351\t/// Write `IP_PKTINFO` / `IPV6_PKTINFO` / `UDP_SEGMENT` control\n352\t/// messages into `header` for an outgoing datagram.  C:\n353\t/// `picoquic_socks_cmsg_format`.\n354\tpub fn format_cmsg(\n355\t    _header: &mut MessageHeader<'_, '_, '_>,\n356\t    _message_length: usize,\n357\t    _send_msg_size: usize,\n358\t    _addr_from: Option<&SocketAddr>,\n359\t    _dest_if: i32,\n360\t) {\n361\t    todo!()\n362\t}\n363\t\n364\t#[cfg(test)]\n365\tmod test {}\n366\t"}]},"parent_tool_use_id":null,"session_id":"3d42c661-040a-4c4c-a3b8-7304c8a33988","uuid":"0222326c-40a1-41a9-94ba-801c72076324","timestamp":"2026-05-05T21:07:19.778Z","tool_use_result":{"type":"text","file":{"filePath":"/Users/richbarn/Projects/picoquic/rs/fq/src/socks.rs","content":"//! Translation of `picoquic/picosocks.h` plus the Phase 2 socket\n//! abstraction.\n//!\n//! Phase 2 reshape: the C `SOCKET_TYPE` (a Linux file descriptor)\n//! is replaced by a [`Socket`] *trait* that the host platform\n//! implements.  The default implementation wraps\n//! [`socket2::Socket`] (the canonical cross-platform UDP socket\n//! crate); other backends (no-std embedded, Windows-specific,\n//! the test simulator) implement the same trait.\n//! [`ServerSockets<S>`] is generic over the implementor.\n//!\n//! Phase 1 contract: signatures only — every method body is\n//! `todo!()`.\n\nuse core::net::SocketAddr;\n\nuse crate::Error;\nuse crate::Instant;\n\n// ---------------------------------------------------------------------------\n// Constants and supporting types.\n\n/// Number of UDP sockets a server context owns — one IPv4, one\n/// IPv6.  C: `PICOQUIC_NB_SERVER_SOCKETS`.\npub const SERVER_SOCKET_COUNT: usize = 2;\n\n/// `MessageHeader` is a re-export of [`socket2::MsgHdr`] — the\n/// canonical cross-platform `msghdr` wrapper.  Phase 4 fills in\n/// the bodies that thread one through the cmsg helpers.\npub type MessageHeader<'addr, 'bufs, 'control> = socket2::MsgHdr<'addr, 'bufs, 'control>;\n\n/// OS error code surfaced by socket sends when the underlying\n/// syscall fails.  Wraps the raw Linux `errno` (or its Windows\n/// equivalent on other targets) and exposes\n/// [`OsError::is_unreachable`] for the path-abandon decision the\n/// C `picoquic_socket_error_implies_unreachable` helper made.\n#[derive(Debug, Copy, Clone, PartialEq, Eq)]\npub struct OsError(pub i32);\n\nimpl OsError {\n    /// Whether this errno implies the destination is unreachable\n    /// and the owning path should be abandoned.  C:\n    /// `picoquic_socket_error_implies_unreachable`.\n    pub fn is_unreachable(self) -> bool {\n        use std::io::ErrorKind;\n        let kind = std::io::Error::from_raw_os_error(self.0).kind();\n        matches!(\n            kind,\n            ErrorKind::ConnectionReset\n                | ErrorKind::HostUnreachable\n                | ErrorKind::NetworkDown\n                | ErrorKind::NetworkUnreachable\n        )\n    }\n}\n\n// ---------------------------------------------------------------------------\n// `Socket` trait.\n\n/// One UDP socket on the application's network stack.  Replaces\n/// the C `SOCKET_TYPE` (a raw file descriptor); the host\n/// implementation supplies open / bind / send / recv operations\n/// while the rest of picoquic stays platform-agnostic.\n///\n/// The default [`socket2::Socket`] implementation is in\n/// [`crate::socks_socket2`] (gated on the `std` feature).\npub trait Socket {\n    /// Local address bound to this socket (`getsockname`).\n    /// C: `picoquic_get_local_address`.\n    fn local_address(&self) -> Result<SocketAddr, Error>;\n\n    /// Receive one UDP datagram into `buffer`.  Output parameters\n    /// (source / dest address, interface index, ECN, byte count)\n    /// fold into [`RecvInfo`]; the slice length subsumes the C\n    /// `buffer_max` parameter.  C: `picoquic_recvmsg`.\n    fn recv(&mut self, buffer: &mut [u8]) -> Result<RecvInfo, Error>;\n\n    /// Send `bytes` to `addr_dest` from `addr_from` with an\n    /// optional GSO segmentation hint `gso_size` (`UDP_SEGMENT`).\n    /// `addr_from = None` lets the kernel choose the source\n    /// address.  `Ok(n)` reports bytes sent; `Err` carries the\n    /// OS error.  C: `picoquic_sendmsg`.\n    fn send(\n        &mut self,\n        addr_dest: &SocketAddr,\n        addr_from: Option<&SocketAddr>,\n        dest_if: i32,\n        bytes: &[u8],\n        gso_size: i32,\n    ) -> Result<usize, OsError>;\n\n    /// Enable per-packet destination-info delivery on this\n    /// socket (`IP_PKTINFO` / `IPV6_RECVPKTINFO`).  Default:\n    /// no-op for backends that don't surface pktinfo.\n    fn set_pkt_info(&mut self) -> Result<(), Error> {\n        Ok(())\n    }\n\n    /// Enable ECN reception (and request `ECN_ECT_1` outbound).\n    /// Returns `(recv_set, send_set)` indicating whether the\n    /// kernel honored each socket option.  Default: no-op,\n    /// returns `(false, false)`.\n    fn set_ecn_options(&mut self) -> Result<(bool, bool), Error> {\n        Ok((false, false))\n    }\n\n    /// Like [`Self::set_ecn_options`] but with an explicit\n    /// outbound TOS / ECN value (`ecn` is one of the 2-bit\n    /// `EcnCodepoint` codes).  Default: delegates to the\n    /// no-op `set_ecn_options`.\n    fn set_ecn_options_ex(&mut self, _ecn: EcnCodepoint) -> Result<(bool, bool), Error> {\n        self.set_ecn_options()\n    }\n\n    /// Enable Path-MTU-Discovery probing on this socket\n    /// (Linux-only; no-op on other platforms by default).\n    fn set_pmtud_options(&mut self) -> Result<(), Error> {\n        Ok(())\n    }\n\n    /// Open and bind an IPv4 server socket on `port`.  Called by\n    /// [`ServerSockets::open`]; concrete implementations override\n    /// this to use their socket backend.\n    fn open_server_v4(_port: i32) -> Result<Self, Error>\n    where\n        Self: Sized,\n    {\n        Err(Error::Generic)\n    }\n\n    /// Open and bind an IPv6 server socket on `port`.  Called by\n    /// [`ServerSockets::open`]; concrete implementations override\n    /// this to use their socket backend.\n    fn open_server_v6(_port: i32) -> Result<Self, Error>\n    where\n        Self: Sized,\n    {\n        Err(Error::Generic)\n    }\n}\n\n// ---------------------------------------------------------------------------\n// `ServerSockets` -- generic over the socket implementation.\n\n/// Pair of UDP sockets owned by a server (one IPv4, one IPv6).\n/// C: `picoquic_server_sockets_t`.  Generic over the active\n/// [`Socket`] implementation.\npub struct ServerSockets<S: Socket> {\n    /// One UDP socket per address family.  `None` slots are\n    /// uninitialised — see [`ServerSockets::open`] /\n    /// [`ServerSockets::close`].\n    pub sockets: [Option<S>; SERVER_SOCKET_COUNT],\n}\n\nimpl<S: Socket> Default for ServerSockets<S> {\n    fn default() -> Self {\n        Self {\n            sockets: [None, None],\n        }\n    }\n}\n\nimpl<S: Socket> ServerSockets<S> {\n    /// Open the IPv4 + IPv6 server-side UDP socket pair listening\n    /// on `port`.  C: `picoquic_open_server_sockets`.  The\n    /// concrete `S` implementor is chosen at the call site;\n    /// the default `crate::socks_socket2::Socket2Udp` wraps\n    /// [`socket2::Socket`].\n    pub fn open(port: i32) -> Result<Self, Error> {\n        let s6 = S::open_server_v6(port)?;\n        let s4 = S::open_server_v4(port)?;\n        Ok(Self {\n            sockets: [Some(s6), Some(s4)],\n        })\n    }\n\n    /// Close every socket in the pair, leaving each slot `None`.\n    /// C: `picoquic_close_server_sockets`.\n    pub fn close(&mut self) {\n        for slot in &mut self.sockets {\n            *slot = None;\n        }\n    }\n\n    /// Pick the matching socket (v4 / v6, dispatched by\n    /// `addr_dest`'s family) and send through it.\n    /// C: `picoquic_send_through_server_sockets`.\n    pub fn send_through(\n        &mut self,\n        addr_dest: &SocketAddr,\n        addr_from: Option<&SocketAddr>,\n        from_if: i32,\n        bytes: &[u8],\n    ) -> Result<usize, OsError> {\n        let idx = if addr_dest.is_ipv4() { 1 } else { 0 };\n        match &mut self.sockets[idx] {\n            Some(s) => s.send(addr_dest, addr_from, from_if, bytes, 0),\n            None => Err(OsError(-1)),\n        }\n    }\n}\n\n// ---------------------------------------------------------------------------\n// Receive metadata.\n\n/// Receive metadata returned by [`Socket::recv`].  Mirrors the\n/// C output parameters folded into a single struct.\n#[derive(Debug, Default, Copy, Clone)]\npub struct RecvInfo {\n    /// Source address; `None` matches the C `addr_from->ss_family\n    /// = 0` written when `recvmsg` returned `<= 0`.\n    pub addr_from: Option<SocketAddr>,\n    /// Destination address parsed out of `IP_PKTINFO` /\n    /// `IPV6_PKTINFO` cmsg; `None` when no pktinfo was attached.\n    pub addr_dest: Option<SocketAddr>,\n    /// Receiving interface index from the same cmsg.\n    pub dest_if: i32,\n    /// `IP_TOS` / `IPV6_TCLASS` ECN code-point byte.\n    pub received_ecn: u8,\n    /// Number of bytes written into the caller's buffer.\n    pub bytes_recv: usize,\n}\n\n/// Result of [`select`].\n///\n/// Folds the seven nullable out-parameters of the C\n/// `picoquic_select_ex` helper into one struct: source / destination\n/// address, interface index, ECN code-point, byte count,\n/// post-receive timestamp, and the index of the socket that fired.\n#[derive(Debug, Copy, Clone)]\npub struct SelectInfo {\n    pub addr_from: Option<SocketAddr>,\n    pub addr_dest: Option<SocketAddr>,\n    pub dest_if: i32,\n    pub received_ecn: u8,\n    pub bytes_recv: usize,\n    pub current_time: Instant,\n    pub socket_rank: usize,\n}\n\nimpl Default for SelectInfo {\n    fn default() -> Self {\n        Self {\n            addr_from: None,\n            addr_dest: None,\n            dest_if: 0,\n            received_ecn: 0,\n            bytes_recv: 0,\n            current_time: Instant::from_ticks(0),\n            socket_rank: 0,\n        }\n    }\n}\n\n/// Wait up to `delta_t` microseconds for a packet on any socket\n/// in `sockets`, then read at most `buffer.len()` bytes.\n///\n/// Generic over the [`Socket`] implementation.  C:\n/// `picoquic_select` and `picoquic_select_ex` are merged here —\n/// the `_ex` form is the more general one; the rank lives in\n/// [`SelectInfo`].\npub fn select<S: Socket>(\n    _sockets: &mut [S],\n    _buffer: &mut [u8],\n    _delta_t: i64,\n) -> Result<SelectInfo, Error> {\n    todo!()\n}\n\n// ---------------------------------------------------------------------------\n// Address resolution.\n\n/// Resolved server address plus the \"was the input a hostname?\"\n/// hint the TLS layer needs to choose an SNI value.\n#[derive(Debug, Copy, Clone)]\npub struct ServerAddress {\n    pub addr: SocketAddr,\n    pub is_name: bool,\n}\n\nimpl ServerAddress {\n    /// Parse `ip_address_text` (numeric IPv4 / IPv6 or hostname)\n    /// and combine with `server_port` into a [`ServerAddress`].\n    /// C: `picoquic_get_server_address`.\n    pub fn resolve(ip_address_text: &str, server_port: i32) -> Result<Self, Error> {\n        let port = server_port as u16;\n        // Try numeric IPv4.\n        if let Ok(ipv4) = ip_address_text.parse::<std::net::Ipv4Addr>() {\n            return Ok(Self {\n                addr: SocketAddr::V4(std::net::SocketAddrV4::new(ipv4, port)),\n                is_name: false,\n            });\n        }\n        // Try numeric IPv6.\n        if let Ok(ipv6) = ip_address_text.parse::<std::net::Ipv6Addr>() {\n            return Ok(Self {\n                addr: SocketAddr::V6(std::net::SocketAddrV6::new(ipv6, port, 0, 0)),\n                is_name: false,\n            });\n        }\n        // Hostname: DNS lookup.\n        use std::net::ToSocketAddrs;\n        let addr = (ip_address_text, port)\n            .to_socket_addrs()\n            .map_err(|_| Error::Generic)?\n            .next()\n            .ok_or(Error::Generic)?;\n        Ok(Self {\n            addr,\n            is_name: true,\n        })\n    }\n}\n\n// ---------------------------------------------------------------------------\n// Control-message helpers (cmsg parse / format).\n\n/// Result of cmsg parsing.  Folds the four nullable\n/// out-parameters of the C helper into one struct.\n#[derive(Debug, Default, Copy, Clone)]\npub struct CmsgInfo {\n    /// Destination address parsed from `IP_PKTINFO` / `IPV6_PKTINFO`;\n    /// `None` when no pktinfo was attached.\n    pub addr_dest: Option<SocketAddr>,\n    /// Receiving interface index from the same cmsg.\n    pub dest_if: Option<i32>,\n    /// `IP_TOS` / `IPV6_TCLASS` ECN code-point.\n    pub received_ecn: Option<EcnCodepoint>,\n    /// `UDP_GRO` segment size; always `0` on Linux.\n    pub udp_coalesced_size: usize,\n}\n\n/// IP / IPv6 ECN code-point reported by the kernel on receive.\n/// Mirrors the two-bit `IP_TOS` / `IPV6_TCLASS` ECN field.\n#[derive(Debug, Default, Copy, Clone, PartialEq, Eq)]\n#[repr(u8)]\npub enum EcnCodepoint {\n    #[default]\n    NotEct = 0b00,\n    Ect1 = 0b01,\n    Ect0 = 0b10,\n    Ce = 0b11,\n}\n\n/// Parse the control-message ancillary data attached to a\n/// received `msghdr`.  C: `picoquic_socks_cmsg_parse`.\npub fn parse_cmsg(_header: &MessageHeader<'_, '_, '_>) -> CmsgInfo {\n    todo!()\n}\n\n/// Write `IP_PKTINFO` / `IPV6_PKTINFO` / `UDP_SEGMENT` control\n/// messages into `header` for an outgoing datagram.  C:\n/// `picoquic_socks_cmsg_format`.\npub fn format_cmsg(\n    _header: &mut MessageHeader<'_, '_, '_>,\n    _message_length: usize,\n    _send_msg_size: usize,\n    _addr_from: Option<&SocketAddr>,\n    _dest_if: i32,\n) {\n    todo!()\n}\n\n#[cfg(test)]\nmod test {}\n","numLines":366,"startLine":1,"totalLines":366}}}
