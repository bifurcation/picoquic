{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01TbZQT96umZhKjX1ThrvvWQ","type":"tool_result","content":"1\t//! Translation of `picoquic/bytestream.h`.\n2\t//!\n3\t//! A small cursor-over-buffer helper used by `logwriter.c` /\n4\t//! `logreader.c` (binlog) and the connection-id encoding paths.\n5\t//! Three storage modes share a single [`ByteStream`] type:\n6\t//!\n7\t//! * **Borrowed** — wrap a caller-owned slice via\n8\t//!   [`ByteStream::from_slice`].  C: `bytestream_ref_init`.\n9\t//! * **Inline** — a stack-allocated [`ByteStreamBuf`] holds 2560\n10\t//!   bytes of inline storage; [`ByteStreamBuf::stream`] hands out a\n11\t//!   [`ByteStream`] borrowing from it.  C: `bytestream_buf` +\n12\t//!   `bytestream_buf_init`.\n13\t//! * **Owned** — [`ByteStream::with_capacity`] returns a\n14\t//!   `ByteStream<'static>` that owns its heap buffer.  C:\n15\t//!   `bytestream_alloc` + `bytestream_delete` (the latter folds\n16\t//!   into `Drop`).\n17\t//!\n18\t//! ## Shape choices\n19\t//!\n20\t//! C: `bytestream { uint8_t* data; size_t size; size_t ptr; }`.\n21\t//! Rust: `ByteStream<'a> { data: ByteStreamData<'a>, ptr: usize }`.\n22\t//! `data` collapses the C `(uint8_t*, size_t)` pair into one slice\n23\t//! whose `.len()` subsumes `size`; the enum variant distinguishes\n24\t//! borrowed from owned storage so all three constructors produce\n25\t//! the same type.\n26\t//!\n27\t//! C `bytestream_buf { bytestream s; uint8_t buf[2560]; }` aliased\n28\t//! `s.data` against `buf` after init — a self-referential pair.\n29\t//! The Rust shape avoids that: [`ByteStreamBuf`] is just storage,\n30\t//! and [`ByteStreamBuf::stream`] returns a `ByteStream<'_>`\n31\t//! borrowing from the inline buffer for the duration of one I/O\n32\t//! pass.\n33\t//!\n34\t//! Operations are methods on [`ByteStream`].  C `int` 0/-1 returns\n35\t//! become `Result<T, Error>`; out-parameters fold into the `Ok`\n36\t//! variant (e.g., C `int byteread_int8(bytestream*, uint8_t*)`\n37\t//! becomes `fn read_u8(&mut self) -> Result<u8, Error>`).\n38\t//!\n39\t//! Phase 1 contract: signatures only; every body is `todo!()`.\n40\t\n41\tuse core::net::SocketAddr;\n42\t\n43\tuse crate::ConnectionId;\n44\tuse crate::Error;\n45\t\n46\t/// Inline-buffer capacity carried by [`ByteStreamBuf`].  C:\n47\t/// `BYTESTREAM_MAX_BUFFER_SIZE`.\n48\tpub const BYTESTREAM_MAX_BUFFER_SIZE: usize = 2560;\n49\t\n50\t/// Wire-format family tag for IPv4 (matches Linux AF_INET = 2).\n51\tconst WIRE_AF_INET: u64 = 2;\n52\t/// Wire-format family tag for IPv6 (matches Linux AF_INET6 = 10).\n53\tconst WIRE_AF_INET6: u64 = 10;\n54\t\n55\t/// Backing storage for a [`ByteStream`].\n56\t///\n57\t/// An enum so that all three C constructors (ref / buf / alloc)\n58\t/// produce a single [`ByteStream`] type rather than splitting into\n59\t/// \"borrowed\" and \"owned\" variants.\n60\tpub enum ByteStreamData<'a> {\n61\t    /// Slice borrowed from external storage — caller-supplied\n62\t    /// buffer ([`ByteStream::from_slice`]) or the inline buffer of\n63\t    /// a [`ByteStreamBuf`] ([`ByteStreamBuf::stream`]).\n64\t    Borrowed(&'a mut [u8]),\n65\t    /// Heap-allocated buffer owned by the bytestream.  Used by\n66\t    /// [`ByteStream::with_capacity`].  Freed by the [`Drop`] impl\n67\t    /// on the vector — replaces the explicit `bytestream_delete`\n68\t    /// call in C.\n69\t    Owned(Vec<u8>),\n70\t}\n71\t\n72\t/// Cursor over a byte buffer.  C: `bytestream`.\n73\t///\n74\t/// The cursor advances monotonically as bytes are read or written.\n75\t/// `data.len()` (under whichever variant) corresponds to the C\n76\t/// `size` field; the cursor offset corresponds to the C `ptr`\n77\t/// field.\n78\t// Phase 1: fields are private (encapsulated) but every method body\n79\t// is `todo!()`, so nothing reads them yet.  The allow drops in\n80\t// Phase 3 once bodies land.\n81\t#[allow(dead_code)]\n82\tpub struct ByteStream<'a> {\n83\t    data: ByteStreamData<'a>,\n84\t    ptr: usize,\n85\t}\n86\t\n87\t/// Inline 2560-byte storage for a stack-allocated bytestream.\n88\t/// C: `bytestream_buf`.\n89\t///\n90\t/// Pair with [`ByteStreamBuf::stream`] to get a usable cursor:\n91\t///\n92\t/// ```ignore\n93\t/// let mut buf = ByteStreamBuf::default();\n94\t/// let s = buf.stream(128).unwrap();\n95\t/// // …read/write through `s`…\n96\t/// ```\n97\t///\n98\t/// Unlike the C struct this does not embed a `bytestream` field;\n99\t/// the cursor lives in the [`ByteStream`] returned by\n100\t/// [`stream`](Self::stream), borrowing from this inline buffer.\n101\t// See `ByteStream` for the rationale on the dead-code allow.\n102\t#[allow(dead_code)]\n103\tpub struct ByteStreamBuf {\n104\t    buf: [u8; BYTESTREAM_MAX_BUFFER_SIZE],\n105\t}\n106\t\n107\timpl Default for ByteStreamBuf {\n108\t    fn default() -> Self {\n109\t        Self {\n110\t            buf: [0; BYTESTREAM_MAX_BUFFER_SIZE],\n111\t        }\n112\t    }\n113\t}\n114\t\n115\timpl ByteStreamBuf {\n116\t    /// Initialize a [`ByteStream`] backed by this inline buffer,\n117\t    /// with active capacity `nb_bytes`.  Returns `None` when\n118\t    /// `nb_bytes` exceeds [`BYTESTREAM_MAX_BUFFER_SIZE`] (matching\n119\t    /// the C `NULL` return).  C: `bytestream_buf_init`.\n120\t    pub fn stream(&mut self, nb_bytes: usize) -> Option<ByteStream<'_>> {\n121\t        if nb_bytes > BYTESTREAM_MAX_BUFFER_SIZE {\n122\t            return None;\n123\t        }\n124\t        Some(ByteStream {\n125\t            data: ByteStreamData::Borrowed(&mut self.buf[..nb_bytes]),\n126\t            ptr: 0,\n127\t        })\n128\t    }\n129\t}\n130\t\n131\timpl<'a> ByteStream<'a> {\n132\t    fn data_ref(&self) -> &[u8] {\n133\t        match &self.data {\n134\t            ByteStreamData::Borrowed(s) => s,\n135\t            ByteStreamData::Owned(v) => v.as_slice(),\n136\t        }\n137\t    }\n138\t\n139\t    fn data_mut(&mut self) -> &mut [u8] {\n140\t        match &mut self.data {\n141\t            ByteStreamData::Borrowed(s) => s,\n142\t            ByteStreamData::Owned(v) => v.as_mut_slice(),\n143\t        }\n144\t    }\n145\t\n146\t    fn set_error(&mut self) {\n147\t        let cap = self.data_ref().len();\n148\t        self.ptr = cap;\n149\t    }\n150\t\n151\t    /// Wrap a caller-owned mutable byte slice as a bytestream\n152\t    /// cursor.  C: `bytestream_ref_init`.\n153\t    ///\n154\t    /// The C function took `const void*` and cast away the const\n155\t    /// because the same struct served read and write callers.\n156\t    /// Rust takes `&mut [u8]` for both — read-only callers can\n157\t    /// still pass `&mut` to a buffer they treat as read-only.  A\n158\t    /// read-only-only refactor is deferred until the read/write\n159\t    /// split is clearer.\n160\t    pub fn from_slice(bytes: &'a mut [u8]) -> Self {\n161\t        ByteStream {\n162\t            data: ByteStreamData::Borrowed(bytes),\n163\t            ptr: 0,\n164\t        }\n165\t    }\n166\t\n167\t    /// Full underlying buffer (offsets `0..size`).  C:\n168\t    /// `bytestream_data` returning `const uint8_t*`.\n169\t    pub fn as_bytes(&self) -> &[u8] {\n170\t        &self.data_ref()[..self.ptr]\n171\t    }\n172\t\n173\t    /// Slice from the cursor to the end of the buffer (offsets\n174\t    /// `len()..capacity()`).  C: `bytestream_ptr` returning\n175\t    /// `const uint8_t*`.\n176\t    ///\n177\t    /// REVIEW(open): only the encrypt/decrypt helpers in\n178\t    /// `quic/quicctx.c` use this — they want a writable tail to\n179\t    /// hand to the AEAD layer.  Keep until those callers are\n180\t    /// translated; if Phase 4 finds no users, drop it.\n181\t    pub fn tail(&self) -> &[u8] {\n182\t        &self.data_ref()[self.ptr..]\n183\t    }\n184\t\n185\t    /// Total active capacity (the C `size` field).  C:\n186\t    /// `bytestream_size`.\n187\t    pub fn capacity(&self) -> usize {\n188\t        self.data_ref().len()\n189\t    }\n190\t\n191\t    /// Bytes consumed so far (the C `ptr` field).  C:\n192\t    /// `bytestream_length`.\n193\t    pub fn len(&self) -> usize {\n194\t        self.ptr\n195\t    }\n196\t\n197\t    /// `true` when no bytes have been consumed yet.\n198\t    pub fn is_empty(&self) -> bool {\n199\t        self.len() == 0\n200\t    }\n201\t\n202\t    /// Bytes left between the cursor and the end of the buffer.\n203\t    /// C: `bytestream_remain`.\n204\t    pub fn remaining(&self) -> usize {\n205\t        self.data_ref().len() - self.ptr\n206\t    }\n207\t\n208\t    /// Rewind the cursor to offset 0 without touching the buffer.\n209\t    /// C: `bytestream_reset`.\n210\t    pub fn reset(&mut self) {\n211\t        self.ptr = 0;\n212\t    }\n213\t\n214\t    /// Rewind and zero the entire buffer.  C: `bytestream_clear` —\n215\t    /// `memset(s->data, 0, s->size)` then `s->ptr = 0`.\n216\t    pub fn clear(&mut self) {\n217\t        self.ptr = 0;\n218\t        self.data_mut().fill(0);\n219\t    }\n220\t\n221\t    /// `true` when the cursor has reached the end of the buffer.\n222\t    /// C: `bytestream_finished` returning `int` (0/1).\n223\t    pub fn is_finished(&self) -> bool {\n224\t        self.ptr >= self.data_ref().len()\n225\t    }\n226\t\n227\t    /// Advance the cursor by `nb_bytes` without reading or\n228\t    /// writing.  On underflow, the C version sets `ptr = size`\n229\t    /// (forcing all subsequent operations to fail) and returns\n230\t    /// `-1`; the Rust version preserves that side effect and\n231\t    /// returns `Err`.  C: `bytestream_skip`.\n232\t    pub fn skip(&mut self, nb_bytes: usize) -> Result<(), Error> {\n233\t        if self.data_ref().len() - self.ptr < nb_bytes {\n234\t            self.set_error();\n235\t            return Err(Error::BufferTooSmall);\n236\t        }\n237\t        self.ptr += nb_bytes;\n238\t        Ok(())\n239\t    }\n240\t\n241\t    /// Write one byte.  C: `bytewrite_int8`.\n242\t    pub fn write_u8(&mut self, value: u8) -> Result<(), Error> {\n243\t        if self.ptr >= self.data_ref().len() {\n244\t            self.set_error();\n245\t            return Err(Error::BufferTooSmall);\n246\t        }\n247\t        let ptr = self.ptr;\n248\t        self.data_mut()[ptr] = value;\n249\t        self.ptr += 1;\n250\t        Ok(())\n251\t    }\n252\t\n253\t    /// Read one byte, advancing the cursor.  C: `byteread_int8`.\n254\t    pub fn read_u8(&mut self) -> Result<u8, Error> {\n255\t        if self.ptr >= self.data_ref().len() {\n256\t            self.set_error();\n257\t            return Err(Error::BufferTooSmall);\n258\t        }\n259\t        let v = self.data_ref()[self.ptr];\n260\t        self.ptr += 1;\n261\t        Ok(v)\n262\t    }\n263\t\n264\t    /// Read one byte without advancing the cursor.  C:\n265\t    /// `byteshow_int8`.\n266\t    ///\n267\t    /// The C version took a non-`const` pointer because every\n268\t    /// other function did; the Rust version takes `&self`.\n269\t    pub fn peek_u8(&self) -> Result<u8, Error> {\n270\t        if self.ptr >= self.data_ref().len() {\n271\t            return Err(Error::BufferTooSmall);\n272\t        }\n273\t        Ok(self.data_ref()[self.ptr])\n274\t    }\n275\t\n276\t    /// Write a big-endian `u16`.  C: `bytewrite_int16`.\n277\t    pub fn write_u16(&mut self, value: u16) -> Result<(), Error> {\n278\t        if self.data_ref().len() - self.ptr < 2 {\n279\t            self.set_error();\n280\t            return Err(Error::BufferTooSmall);\n281\t        }\n282\t        let ptr = self.ptr;\n283\t        self.data_mut()[ptr..ptr + 2].copy_from_slice(&value.to_be_bytes());\n284\t        self.ptr += 2;\n285\t        Ok(())\n286\t    }\n287\t\n288\t    /// Read a big-endian `u16`.  C: `byteread_int16`.\n289\t    pub fn read_u16(&mut self) -> Result<u16, Error> {\n290\t        if self.data_ref().len() - self.ptr < 2 {\n291\t            self.set_error();\n292\t            return Err(Error::BufferTooSmall);\n293\t        }\n294\t        let p = self.ptr;\n295\t        let d = self.data_ref();\n296\t        let v = u16::from_be_bytes([d[p], d[p + 1]]);\n297\t        self.ptr += 2;\n298\t        Ok(v)\n299\t    }\n300\t\n301\t    /// Write a big-endian `u32`.  C: `bytewrite_int32`.\n302\t    pub fn write_u32(&mut self, value: u32) -> Result<(), Error> {\n303\t        if self.data_ref().len() - self.ptr < 4 {\n304\t            self.set_error();\n305\t            return Err(Error::BufferTooSmall);\n306\t        }\n307\t        let ptr = self.ptr;\n308\t        self.data_mut()[ptr..ptr + 4].copy_from_slice(&value.to_be_bytes());\n309\t        self.ptr += 4;\n310\t        Ok(())\n311\t    }\n312\t\n313\t    /// Read a big-endian `u32`.  C: `byteread_int32`.\n314\t    pub fn read_u32(&mut self) -> Result<u32, Error> {\n315\t        if self.data_ref().len() - self.ptr < 4 {\n316\t            self.set_error();\n317\t            return Err(Error::BufferTooSmall);\n318\t        }\n319\t        let p = self.ptr;\n320\t        let d = self.data_ref();\n321\t        let v = u32::from_be_bytes([d[p], d[p + 1], d[p + 2], d[p + 3]]);\n322\t        self.ptr += 4;\n323\t        Ok(v)\n324\t    }\n325\t\n326\t    /// Write a big-endian `u64`.  C: `bytewrite_int64`.\n327\t    pub fn write_u64(&mut self, value: u64) -> Result<(), Error> {\n328\t        if self.data_ref().len() - self.ptr < 8 {\n329\t            self.set_error();\n330\t            return Err(Error::BufferTooSmall);\n331\t        }\n332\t        let ptr = self.ptr;\n333\t        self.data_mut()[ptr..ptr + 8].copy_from_slice(&value.to_be_bytes());\n334\t        self.ptr += 8;\n335\t        Ok(())\n336\t    }\n337\t\n338\t    /// Read a big-endian `u64`.  C: `byteread_int64`.\n339\t    pub fn read_u64(&mut self) -> Result<u64, Error> {\n340\t        if self.data_ref().len() - self.ptr < 8 {\n341\t            self.set_error();\n342\t            return Err(Error::BufferTooSmall);\n343\t        }\n344\t        let p = self.ptr;\n345\t        let d = self.data_ref();\n346\t        let v = u64::from_be_bytes([\n347\t            d[p],\n348\t            d[p + 1],\n349\t            d[p + 2],\n350\t            d[p + 3],\n351\t            d[p + 4],\n352\t            d[p + 5],\n353\t            d[p + 6],\n354\t            d[p + 7],\n355\t        ]);\n356\t        self.ptr += 8;\n357\t        Ok(v)\n358\t    }\n359\t\n360\t    /// Write a QUIC variable-length integer (RFC 9000 §16).  C:\n361\t    /// `bytewrite_vint`.\n362\t    pub fn write_varint(&mut self, value: u64) -> Result<(), Error> {\n363\t        let len = Self::varint_encoded_len(value);\n364\t        if self.data_ref().len() - self.ptr < len {\n365\t            self.set_error();\n366\t            return Err(Error::BufferTooSmall);\n367\t        }\n368\t        let ptr = self.ptr;\n369\t        let d = self.data_mut();\n370\t        match len {\n371\t            1 => d[ptr] = value as u8,\n372\t            2 => {\n373\t                d[ptr] = 0x40 | (value >> 8) as u8;\n374\t                d[ptr + 1] = value as u8;\n375\t            }\n376\t            4 => {\n377\t                d[ptr] = 0x80 | (value >> 24) as u8;\n378\t                d[ptr + 1] = (value >> 16) as u8;\n379\t                d[ptr + 2] = (value >> 8) as u8;\n380\t                d[ptr + 3] = value as u8;\n381\t            }\n382\t            _ => {\n383\t                d[ptr] = 0xC0 | (value >> 56) as u8;\n384\t                d[ptr + 1] = (value >> 48) as u8;\n385\t                d[ptr + 2] = (value >> 40) as u8;\n386\t                d[ptr + 3] = (value >> 32) as u8;\n387\t                d[ptr + 4] = (value >> 24) as u8;\n388\t                d[ptr + 5] = (value >> 16) as u8;\n389\t                d[ptr + 6] = (value >> 8) as u8;\n390\t                d[ptr + 7] = value as u8;\n391\t            }\n392\t        }\n393\t        self.ptr += len;\n394\t        Ok(())\n395\t    }\n396\t\n397\t    /// Read a QUIC variable-length integer.  C: `byteread_varint`.\n398\t    pub fn read_varint(&mut self) -> Result<u64, Error> {\n399\t        if self.ptr >= self.data_ref().len() {\n400\t            self.set_error();\n401\t            return Err(Error::BufferTooSmall);\n402\t        }\n403\t        let first = self.data_ref()[self.ptr];\n404\t        let len = 1usize << ((first >> 6) & 3);\n405\t        if self.data_ref().len() - self.ptr < len {\n406\t            self.set_error();\n407\t            return Err(Error::BufferTooSmall);\n408\t        }\n409\t        let p = self.ptr;\n410\t        let d = self.data_ref();\n411\t        let value = match len {\n412\t            1 => (first & 0x3F) as u64,\n413\t            2 => (((first & 0x3F) as u64) << 8) | (d[p + 1] as u64),\n414\t            4 => {\n415\t                (((first & 0x3F) as u64) << 24)\n416\t                    | ((d[p + 1] as u64) << 16)\n417\t                    | ((d[p + 2] as u64) << 8)\n418\t                    | (d[p + 3] as u64)\n419\t            }\n420\t            _ => {\n421\t                (((first & 0x3F) as u64) << 56)\n422\t                    | ((d[p + 1] as u64) << 48)\n423\t                    | ((d[p + 2] as u64) << 40)\n424\t                    | ((d[p + 3] as u64) << 32)\n425\t                    | ((d[p + 4] as u64) << 24)\n426\t                    | ((d[p + 5] as u64) << 16)\n427\t                    | ((d[p + 6] as u64) << 8)\n428\t                    | (d[p + 7] as u64)\n429\t            }\n430\t        };\n431\t        self.ptr += len;\n432\t        Ok(value)\n433\t    }\n434\t\n435\t    /// Skip past a QUIC variable-length integer without decoding\n436\t    /// it.  C: `byteread_skip_varint`.\n437\t    pub fn skip_varint(&mut self) -> Result<(), Error> {\n438\t        if self.ptr >= self.data_ref().len() {\n439\t            self.set_error();\n440\t            return Err(Error::BufferTooSmall);\n441\t        }\n442\t        let first = self.data_ref()[self.ptr];\n443\t        let len = 1usize << ((first >> 6) & 3);\n444\t        self.skip(len)\n445\t    }\n446\t\n447\t    /// Read a varint and downcast to `usize`.  C: `byteread_vlen`.\n448\t    /// Returns `Err` when the value doesn't fit in a `usize` on\n449\t    /// the target.  Mirrors the C check `*value != val_read`.\n450\t    pub fn read_vlen(&mut self) -> Result<usize, Error> {\n451\t        let val = self.read_varint()?;\n452\t        let as_usize = val as usize;\n453\t        if as_usize as u64 != val {\n454\t            return Err(Error::InvalidArgument);\n455\t        }\n456\t        Ok(as_usize)\n457\t    }\n458\t\n459\t    /// Copy `buffer.len()` bytes into the stream.  C:\n460\t    /// `bytewrite_buffer(s, buffer, length)` — the explicit\n461\t    /// `length` is taken from the slice.\n462\t    pub fn write_bytes(&mut self, buffer: &[u8]) -> Result<(), Error> {\n463\t        let length = buffer.len();\n464\t        if self.data_ref().len() - self.ptr < length {\n465\t            self.set_error();\n466\t            return Err(Error::BufferTooSmall);\n467\t        }\n468\t        let ptr = self.ptr;\n469\t        self.data_mut()[ptr..ptr + length].copy_from_slice(buffer);\n470\t        self.ptr += length;\n471\t        Ok(())\n472\t    }\n473\t\n474\t    /// Copy `buffer.len()` bytes out of the stream.  C:\n475\t    /// `byteread_buffer`.\n476\t    pub fn read_bytes(&mut self, buffer: &mut [u8]) -> Result<(), Error> {\n477\t        let length = buffer.len();\n478\t        if self.data_ref().len() - self.ptr < length {\n479\t            self.set_error();\n480\t            return Err(Error::BufferTooSmall);\n481\t        }\n482\t        buffer.copy_from_slice(&self.data_ref()[self.ptr..self.ptr + length]);\n483\t        self.ptr += length;\n484\t        Ok(())\n485\t    }\n486\t\n487\t    /// Encode a connection id as `u8` length + `id_len` raw bytes.\n488\t    /// C: `bytewrite_cid`.\n489\t    pub fn write_cid(&mut self, cid: &ConnectionId) -> Result<(), Error> {\n490\t        self.write_u8(cid.id_len)?;\n491\t        self.write_bytes(&cid.id[..cid.id_len as usize])\n492\t    }\n493\t\n494\t    /// Decode a connection id.  C: `byteread_cid` (the C version\n495\t    /// filled an out parameter; the Rust version returns the\n496\t    /// value).  Returns `Err` when the encoded length exceeds\n497\t    /// [`crate::CONNECTION_ID_MAX_SIZE`].\n498\t    pub fn read_cid(&mut self) -> Result<ConnectionId, Error> {\n499\t        let id_len = self.read_u8()?;\n500\t        if id_len as usize > crate::CONNECTION_ID_MAX_SIZE {\n501\t            self.set_error();\n502\t            return Err(Error::InvalidArgument);\n503\t        }\n504\t        let mut cid = ConnectionId {\n505\t            id_len,\n506\t            ..ConnectionId::default()\n507\t        };\n508\t        self.read_bytes(&mut cid.id[..id_len as usize])?;\n509\t        Ok(cid)\n510\t    }\n511\t\n512\t    /// Skip past an encoded connection id.  C: `byteskip_cid`.\n513\t    pub fn skip_cid(&mut self) -> Result<(), Error> {\n514\t        let id_len = self.read_u8()?;\n515\t        self.skip(id_len as usize)\n516\t    }\n517\t\n518\t    /// Encode a string as varint-length + raw bytes (no NUL on the\n519\t    /// wire).  C: `bytewrite_cstr` — took a `const char*` and\n520\t    /// called `strlen`; the Rust version takes a `&str` and uses\n521\t    /// its length directly.\n522\t    pub fn write_str(&mut self, s: &str) -> Result<(), Error> {\n523\t        let bytes = s.as_bytes();\n524\t        self.write_varint(bytes.len() as u64)?;\n525\t        self.write_bytes(bytes)\n526\t    }\n527\t\n528\t    /// Decode a length-prefixed string into `dst`, returning the\n529\t    /// number of bytes written.  C: `byteread_cstr(s, char* cstr,\n530\t    /// size_t max_len)` wrote a NUL-terminated string and required\n531\t    /// `length + 1 <= max_len`; the Rust version writes raw bytes\n532\t    /// (callers reconstruct a `&str`/`&CStr` themselves) and\n533\t    /// returns `Err` when `length > dst.len()`.\n534\t    pub fn read_str(&mut self, dst: &mut [u8]) -> Result<usize, Error> {\n535\t        let l_read = self.read_varint()?;\n536\t        let l = l_read as usize;\n537\t        if (l_read as usize as u64) != l_read {\n538\t            self.set_error();\n539\t            return Err(Error::InvalidArgument);\n540\t        }\n541\t        if l > dst.len() {\n542\t            self.set_error();\n543\t            return Err(Error::BufferTooSmall);\n544\t        }\n545\t        self.read_bytes(&mut dst[..l])?;\n546\t        Ok(l)\n547\t    }\n548\t\n549\t    /// Skip past a length-prefixed string.  C: `byteskip_cstr`.\n550\t    pub fn skip_str(&mut self) -> Result<(), Error> {\n551\t        let l_read = self.read_varint()?;\n552\t        let l = l_read as usize;\n553\t        if (l_read as usize as u64) != l_read {\n554\t            self.set_error();\n555\t            return Err(Error::InvalidArgument);\n556\t        }\n557\t        self.skip(l)\n558\t    }\n559\t\n560\t    /// Encode a socket address as varint(family) + 4 or 16 raw\n561\t    /// bytes (address) + big-endian `u16` (port).  C:\n562\t    /// `bytewrite_addr`, which branched on `sa_family`; the Rust\n563\t    /// version uses [`SocketAddr`].\n564\t    pub fn write_addr(&mut self, addr: &SocketAddr) -> Result<(), Error> {\n565\t        match addr {\n566\t            SocketAddr::V4(a) => {\n567\t                self.write_varint(WIRE_AF_INET)?;\n568\t                self.write_bytes(&a.ip().octets())?;\n569\t                self.write_u16(a.port())?;\n570\t            }\n571\t            SocketAddr::V6(a) => {\n572\t                self.write_varint(WIRE_AF_INET6)?;\n573\t                self.write_bytes(&a.ip().octets())?;\n574\t                self.write_u16(a.port())?;\n575\t            }\n576\t        }\n577\t        Ok(())\n578\t    }\n579\t\n580\t    /// Decode a socket address.  C: `byteread_addr` (the C version\n581\t    /// filled a `sockaddr_storage` out parameter; the Rust version\n582\t    /// returns the value).\n583\t    pub fn read_addr(&mut self) -> Result<SocketAddr, Error> {\n584\t        let family = self.read_varint()?;\n585\t        if family == WIRE_AF_INET {\n586\t            let mut octets = [0u8; 4];\n587\t            self.read_bytes(&mut octets)?;\n588\t            let port = self.read_u16()?;\n589\t            Ok(SocketAddr::from((octets, port)))\n590\t        } else {\n591\t            let mut octets = [0u8; 16];\n592\t            self.read_bytes(&mut octets)?;\n593\t            let port = self.read_u16()?;\n594\t            Ok(SocketAddr::from((octets, port)))\n595\t        }\n596\t    }\n597\t\n598\t    /// Skip past an encoded socket address.  C: `byteskip_addr`.\n599\t    pub fn skip_addr(&mut self) -> Result<(), Error> {\n600\t        let family = self.read_varint()?;\n601\t        if family == WIRE_AF_INET {\n602\t            self.skip(4 + 2)\n603\t        } else {\n604\t            self.skip(16 + 2)\n605\t        }\n606\t    }\n607\t}\n608\t\n609\timpl ByteStream<'static> {\n610\t    /// Allocate a fresh `nb_bytes`-byte heap buffer and return a\n611\t    /// bytestream that owns it.  Returns `None` on allocation\n612\t    /// failure.  C: `bytestream_alloc`.\n613\t    ///\n614\t    /// The C signature took a pre-existing `bytestream*` and only\n615\t    /// allocated `s->data`; the Rust version bundles construction\n616\t    /// and allocation, since the bytestream now owns the buffer\n617\t    /// through [`ByteStreamData::Owned`].  The matching C\n618\t    /// `bytestream_delete` has no Rust equivalent — drop the\n619\t    /// `ByteStream` to free.\n620\t    pub fn with_capacity(nb_bytes: usize) -> Option<Self> {\n621\t        let mut v = Vec::new();\n622\t        v.try_reserve_exact(nb_bytes).ok()?;\n623\t        v.resize(nb_bytes, 0);\n624\t        Some(ByteStream {\n625\t            data: ByteStreamData::Owned(v),\n626\t            ptr: 0,\n627\t        })\n628\t    }\n629\t}\n630\t\n631\timpl ByteStream<'_> {\n632\t    /// Encoded byte-length of `value` as a QUIC varint (1, 2, 4,\n633\t    /// or 8 bytes).  C: `bytestream_varint_len`.\n634\t    pub fn varint_encoded_len(value: u64) -> usize {\n635\t        if value <= 0x3F {\n636\t            1\n637\t        } else if value <= 0x3FFF {\n638\t            2\n639\t        } else if value <= 0x3FFF_FFFF {\n640\t            4\n641\t        } else {\n642\t            8\n643\t        }\n644\t    }\n645\t}\n646\t\n647\t#[cfg(test)]\n648\tmod test {}\n649\t"}]},"parent_tool_use_id":null,"session_id":"3d42c661-040a-4c4c-a3b8-7304c8a33988","uuid":"257b1ffd-61ef-44f0-a3c6-a3cf703011ec","timestamp":"2026-05-05T21:07:20.488Z","tool_use_result":{"type":"text","file":{"filePath":"/Users/richbarn/Projects/picoquic/rs/fq/src/bytestream.rs","content":"//! Translation of `picoquic/bytestream.h`.\n//!\n//! A small cursor-over-buffer helper used by `logwriter.c` /\n//! `logreader.c` (binlog) and the connection-id encoding paths.\n//! Three storage modes share a single [`ByteStream`] type:\n//!\n//! * **Borrowed** — wrap a caller-owned slice via\n//!   [`ByteStream::from_slice`].  C: `bytestream_ref_init`.\n//! * **Inline** — a stack-allocated [`ByteStreamBuf`] holds 2560\n//!   bytes of inline storage; [`ByteStreamBuf::stream`] hands out a\n//!   [`ByteStream`] borrowing from it.  C: `bytestream_buf` +\n//!   `bytestream_buf_init`.\n//! * **Owned** — [`ByteStream::with_capacity`] returns a\n//!   `ByteStream<'static>` that owns its heap buffer.  C:\n//!   `bytestream_alloc` + `bytestream_delete` (the latter folds\n//!   into `Drop`).\n//!\n//! ## Shape choices\n//!\n//! C: `bytestream { uint8_t* data; size_t size; size_t ptr; }`.\n//! Rust: `ByteStream<'a> { data: ByteStreamData<'a>, ptr: usize }`.\n//! `data` collapses the C `(uint8_t*, size_t)` pair into one slice\n//! whose `.len()` subsumes `size`; the enum variant distinguishes\n//! borrowed from owned storage so all three constructors produce\n//! the same type.\n//!\n//! C `bytestream_buf { bytestream s; uint8_t buf[2560]; }` aliased\n//! `s.data` against `buf` after init — a self-referential pair.\n//! The Rust shape avoids that: [`ByteStreamBuf`] is just storage,\n//! and [`ByteStreamBuf::stream`] returns a `ByteStream<'_>`\n//! borrowing from the inline buffer for the duration of one I/O\n//! pass.\n//!\n//! Operations are methods on [`ByteStream`].  C `int` 0/-1 returns\n//! become `Result<T, Error>`; out-parameters fold into the `Ok`\n//! variant (e.g., C `int byteread_int8(bytestream*, uint8_t*)`\n//! becomes `fn read_u8(&mut self) -> Result<u8, Error>`).\n//!\n//! Phase 1 contract: signatures only; every body is `todo!()`.\n\nuse core::net::SocketAddr;\n\nuse crate::ConnectionId;\nuse crate::Error;\n\n/// Inline-buffer capacity carried by [`ByteStreamBuf`].  C:\n/// `BYTESTREAM_MAX_BUFFER_SIZE`.\npub const BYTESTREAM_MAX_BUFFER_SIZE: usize = 2560;\n\n/// Wire-format family tag for IPv4 (matches Linux AF_INET = 2).\nconst WIRE_AF_INET: u64 = 2;\n/// Wire-format family tag for IPv6 (matches Linux AF_INET6 = 10).\nconst WIRE_AF_INET6: u64 = 10;\n\n/// Backing storage for a [`ByteStream`].\n///\n/// An enum so that all three C constructors (ref / buf / alloc)\n/// produce a single [`ByteStream`] type rather than splitting into\n/// \"borrowed\" and \"owned\" variants.\npub enum ByteStreamData<'a> {\n    /// Slice borrowed from external storage — caller-supplied\n    /// buffer ([`ByteStream::from_slice`]) or the inline buffer of\n    /// a [`ByteStreamBuf`] ([`ByteStreamBuf::stream`]).\n    Borrowed(&'a mut [u8]),\n    /// Heap-allocated buffer owned by the bytestream.  Used by\n    /// [`ByteStream::with_capacity`].  Freed by the [`Drop`] impl\n    /// on the vector — replaces the explicit `bytestream_delete`\n    /// call in C.\n    Owned(Vec<u8>),\n}\n\n/// Cursor over a byte buffer.  C: `bytestream`.\n///\n/// The cursor advances monotonically as bytes are read or written.\n/// `data.len()` (under whichever variant) corresponds to the C\n/// `size` field; the cursor offset corresponds to the C `ptr`\n/// field.\n// Phase 1: fields are private (encapsulated) but every method body\n// is `todo!()`, so nothing reads them yet.  The allow drops in\n// Phase 3 once bodies land.\n#[allow(dead_code)]\npub struct ByteStream<'a> {\n    data: ByteStreamData<'a>,\n    ptr: usize,\n}\n\n/// Inline 2560-byte storage for a stack-allocated bytestream.\n/// C: `bytestream_buf`.\n///\n/// Pair with [`ByteStreamBuf::stream`] to get a usable cursor:\n///\n/// ```ignore\n/// let mut buf = ByteStreamBuf::default();\n/// let s = buf.stream(128).unwrap();\n/// // …read/write through `s`…\n/// ```\n///\n/// Unlike the C struct this does not embed a `bytestream` field;\n/// the cursor lives in the [`ByteStream`] returned by\n/// [`stream`](Self::stream), borrowing from this inline buffer.\n// See `ByteStream` for the rationale on the dead-code allow.\n#[allow(dead_code)]\npub struct ByteStreamBuf {\n    buf: [u8; BYTESTREAM_MAX_BUFFER_SIZE],\n}\n\nimpl Default for ByteStreamBuf {\n    fn default() -> Self {\n        Self {\n            buf: [0; BYTESTREAM_MAX_BUFFER_SIZE],\n        }\n    }\n}\n\nimpl ByteStreamBuf {\n    /// Initialize a [`ByteStream`] backed by this inline buffer,\n    /// with active capacity `nb_bytes`.  Returns `None` when\n    /// `nb_bytes` exceeds [`BYTESTREAM_MAX_BUFFER_SIZE`] (matching\n    /// the C `NULL` return).  C: `bytestream_buf_init`.\n    pub fn stream(&mut self, nb_bytes: usize) -> Option<ByteStream<'_>> {\n        if nb_bytes > BYTESTREAM_MAX_BUFFER_SIZE {\n            return None;\n        }\n        Some(ByteStream {\n            data: ByteStreamData::Borrowed(&mut self.buf[..nb_bytes]),\n            ptr: 0,\n        })\n    }\n}\n\nimpl<'a> ByteStream<'a> {\n    fn data_ref(&self) -> &[u8] {\n        match &self.data {\n            ByteStreamData::Borrowed(s) => s,\n            ByteStreamData::Owned(v) => v.as_slice(),\n        }\n    }\n\n    fn data_mut(&mut self) -> &mut [u8] {\n        match &mut self.data {\n            ByteStreamData::Borrowed(s) => s,\n            ByteStreamData::Owned(v) => v.as_mut_slice(),\n        }\n    }\n\n    fn set_error(&mut self) {\n        let cap = self.data_ref().len();\n        self.ptr = cap;\n    }\n\n    /// Wrap a caller-owned mutable byte slice as a bytestream\n    /// cursor.  C: `bytestream_ref_init`.\n    ///\n    /// The C function took `const void*` and cast away the const\n    /// because the same struct served read and write callers.\n    /// Rust takes `&mut [u8]` for both — read-only callers can\n    /// still pass `&mut` to a buffer they treat as read-only.  A\n    /// read-only-only refactor is deferred until the read/write\n    /// split is clearer.\n    pub fn from_slice(bytes: &'a mut [u8]) -> Self {\n        ByteStream {\n            data: ByteStreamData::Borrowed(bytes),\n            ptr: 0,\n        }\n    }\n\n    /// Full underlying buffer (offsets `0..size`).  C:\n    /// `bytestream_data` returning `const uint8_t*`.\n    pub fn as_bytes(&self) -> &[u8] {\n        &self.data_ref()[..self.ptr]\n    }\n\n    /// Slice from the cursor to the end of the buffer (offsets\n    /// `len()..capacity()`).  C: `bytestream_ptr` returning\n    /// `const uint8_t*`.\n    ///\n    /// REVIEW(open): only the encrypt/decrypt helpers in\n    /// `quic/quicctx.c` use this — they want a writable tail to\n    /// hand to the AEAD layer.  Keep until those callers are\n    /// translated; if Phase 4 finds no users, drop it.\n    pub fn tail(&self) -> &[u8] {\n        &self.data_ref()[self.ptr..]\n    }\n\n    /// Total active capacity (the C `size` field).  C:\n    /// `bytestream_size`.\n    pub fn capacity(&self) -> usize {\n        self.data_ref().len()\n    }\n\n    /// Bytes consumed so far (the C `ptr` field).  C:\n    /// `bytestream_length`.\n    pub fn len(&self) -> usize {\n        self.ptr\n    }\n\n    /// `true` when no bytes have been consumed yet.\n    pub fn is_empty(&self) -> bool {\n        self.len() == 0\n    }\n\n    /// Bytes left between the cursor and the end of the buffer.\n    /// C: `bytestream_remain`.\n    pub fn remaining(&self) -> usize {\n        self.data_ref().len() - self.ptr\n    }\n\n    /// Rewind the cursor to offset 0 without touching the buffer.\n    /// C: `bytestream_reset`.\n    pub fn reset(&mut self) {\n        self.ptr = 0;\n    }\n\n    /// Rewind and zero the entire buffer.  C: `bytestream_clear` —\n    /// `memset(s->data, 0, s->size)` then `s->ptr = 0`.\n    pub fn clear(&mut self) {\n        self.ptr = 0;\n        self.data_mut().fill(0);\n    }\n\n    /// `true` when the cursor has reached the end of the buffer.\n    /// C: `bytestream_finished` returning `int` (0/1).\n    pub fn is_finished(&self) -> bool {\n        self.ptr >= self.data_ref().len()\n    }\n\n    /// Advance the cursor by `nb_bytes` without reading or\n    /// writing.  On underflow, the C version sets `ptr = size`\n    /// (forcing all subsequent operations to fail) and returns\n    /// `-1`; the Rust version preserves that side effect and\n    /// returns `Err`.  C: `bytestream_skip`.\n    pub fn skip(&mut self, nb_bytes: usize) -> Result<(), Error> {\n        if self.data_ref().len() - self.ptr < nb_bytes {\n            self.set_error();\n            return Err(Error::BufferTooSmall);\n        }\n        self.ptr += nb_bytes;\n        Ok(())\n    }\n\n    /// Write one byte.  C: `bytewrite_int8`.\n    pub fn write_u8(&mut self, value: u8) -> Result<(), Error> {\n        if self.ptr >= self.data_ref().len() {\n            self.set_error();\n            return Err(Error::BufferTooSmall);\n        }\n        let ptr = self.ptr;\n        self.data_mut()[ptr] = value;\n        self.ptr += 1;\n        Ok(())\n    }\n\n    /// Read one byte, advancing the cursor.  C: `byteread_int8`.\n    pub fn read_u8(&mut self) -> Result<u8, Error> {\n        if self.ptr >= self.data_ref().len() {\n            self.set_error();\n            return Err(Error::BufferTooSmall);\n        }\n        let v = self.data_ref()[self.ptr];\n        self.ptr += 1;\n        Ok(v)\n    }\n\n    /// Read one byte without advancing the cursor.  C:\n    /// `byteshow_int8`.\n    ///\n    /// The C version took a non-`const` pointer because every\n    /// other function did; the Rust version takes `&self`.\n    pub fn peek_u8(&self) -> Result<u8, Error> {\n        if self.ptr >= self.data_ref().len() {\n            return Err(Error::BufferTooSmall);\n        }\n        Ok(self.data_ref()[self.ptr])\n    }\n\n    /// Write a big-endian `u16`.  C: `bytewrite_int16`.\n    pub fn write_u16(&mut self, value: u16) -> Result<(), Error> {\n        if self.data_ref().len() - self.ptr < 2 {\n            self.set_error();\n            return Err(Error::BufferTooSmall);\n        }\n        let ptr = self.ptr;\n        self.data_mut()[ptr..ptr + 2].copy_from_slice(&value.to_be_bytes());\n        self.ptr += 2;\n        Ok(())\n    }\n\n    /// Read a big-endian `u16`.  C: `byteread_int16`.\n    pub fn read_u16(&mut self) -> Result<u16, Error> {\n        if self.data_ref().len() - self.ptr < 2 {\n            self.set_error();\n            return Err(Error::BufferTooSmall);\n        }\n        let p = self.ptr;\n        let d = self.data_ref();\n        let v = u16::from_be_bytes([d[p], d[p + 1]]);\n        self.ptr += 2;\n        Ok(v)\n    }\n\n    /// Write a big-endian `u32`.  C: `bytewrite_int32`.\n    pub fn write_u32(&mut self, value: u32) -> Result<(), Error> {\n        if self.data_ref().len() - self.ptr < 4 {\n            self.set_error();\n            return Err(Error::BufferTooSmall);\n        }\n        let ptr = self.ptr;\n        self.data_mut()[ptr..ptr + 4].copy_from_slice(&value.to_be_bytes());\n        self.ptr += 4;\n        Ok(())\n    }\n\n    /// Read a big-endian `u32`.  C: `byteread_int32`.\n    pub fn read_u32(&mut self) -> Result<u32, Error> {\n        if self.data_ref().len() - self.ptr < 4 {\n            self.set_error();\n            return Err(Error::BufferTooSmall);\n        }\n        let p = self.ptr;\n        let d = self.data_ref();\n        let v = u32::from_be_bytes([d[p], d[p + 1], d[p + 2], d[p + 3]]);\n        self.ptr += 4;\n        Ok(v)\n    }\n\n    /// Write a big-endian `u64`.  C: `bytewrite_int64`.\n    pub fn write_u64(&mut self, value: u64) -> Result<(), Error> {\n        if self.data_ref().len() - self.ptr < 8 {\n            self.set_error();\n            return Err(Error::BufferTooSmall);\n        }\n        let ptr = self.ptr;\n        self.data_mut()[ptr..ptr + 8].copy_from_slice(&value.to_be_bytes());\n        self.ptr += 8;\n        Ok(())\n    }\n\n    /// Read a big-endian `u64`.  C: `byteread_int64`.\n    pub fn read_u64(&mut self) -> Result<u64, Error> {\n        if self.data_ref().len() - self.ptr < 8 {\n            self.set_error();\n            return Err(Error::BufferTooSmall);\n        }\n        let p = self.ptr;\n        let d = self.data_ref();\n        let v = u64::from_be_bytes([\n            d[p],\n            d[p + 1],\n            d[p + 2],\n            d[p + 3],\n            d[p + 4],\n            d[p + 5],\n            d[p + 6],\n            d[p + 7],\n        ]);\n        self.ptr += 8;\n        Ok(v)\n    }\n\n    /// Write a QUIC variable-length integer (RFC 9000 §16).  C:\n    /// `bytewrite_vint`.\n    pub fn write_varint(&mut self, value: u64) -> Result<(), Error> {\n        let len = Self::varint_encoded_len(value);\n        if self.data_ref().len() - self.ptr < len {\n            self.set_error();\n            return Err(Error::BufferTooSmall);\n        }\n        let ptr = self.ptr;\n        let d = self.data_mut();\n        match len {\n            1 => d[ptr] = value as u8,\n            2 => {\n                d[ptr] = 0x40 | (value >> 8) as u8;\n                d[ptr + 1] = value as u8;\n            }\n            4 => {\n                d[ptr] = 0x80 | (value >> 24) as u8;\n                d[ptr + 1] = (value >> 16) as u8;\n                d[ptr + 2] = (value >> 8) as u8;\n                d[ptr + 3] = value as u8;\n            }\n            _ => {\n                d[ptr] = 0xC0 | (value >> 56) as u8;\n                d[ptr + 1] = (value >> 48) as u8;\n                d[ptr + 2] = (value >> 40) as u8;\n                d[ptr + 3] = (value >> 32) as u8;\n                d[ptr + 4] = (value >> 24) as u8;\n                d[ptr + 5] = (value >> 16) as u8;\n                d[ptr + 6] = (value >> 8) as u8;\n                d[ptr + 7] = value as u8;\n            }\n        }\n        self.ptr += len;\n        Ok(())\n    }\n\n    /// Read a QUIC variable-length integer.  C: `byteread_varint`.\n    pub fn read_varint(&mut self) -> Result<u64, Error> {\n        if self.ptr >= self.data_ref().len() {\n            self.set_error();\n            return Err(Error::BufferTooSmall);\n        }\n        let first = self.data_ref()[self.ptr];\n        let len = 1usize << ((first >> 6) & 3);\n        if self.data_ref().len() - self.ptr < len {\n            self.set_error();\n            return Err(Error::BufferTooSmall);\n        }\n        let p = self.ptr;\n        let d = self.data_ref();\n        let value = match len {\n            1 => (first & 0x3F) as u64,\n            2 => (((first & 0x3F) as u64) << 8) | (d[p + 1] as u64),\n            4 => {\n                (((first & 0x3F) as u64) << 24)\n                    | ((d[p + 1] as u64) << 16)\n                    | ((d[p + 2] as u64) << 8)\n                    | (d[p + 3] as u64)\n            }\n            _ => {\n                (((first & 0x3F) as u64) << 56)\n                    | ((d[p + 1] as u64) << 48)\n                    | ((d[p + 2] as u64) << 40)\n                    | ((d[p + 3] as u64) << 32)\n                    | ((d[p + 4] as u64) << 24)\n                    | ((d[p + 5] as u64) << 16)\n                    | ((d[p + 6] as u64) << 8)\n                    | (d[p + 7] as u64)\n            }\n        };\n        self.ptr += len;\n        Ok(value)\n    }\n\n    /// Skip past a QUIC variable-length integer without decoding\n    /// it.  C: `byteread_skip_varint`.\n    pub fn skip_varint(&mut self) -> Result<(), Error> {\n        if self.ptr >= self.data_ref().len() {\n            self.set_error();\n            return Err(Error::BufferTooSmall);\n        }\n        let first = self.data_ref()[self.ptr];\n        let len = 1usize << ((first >> 6) & 3);\n        self.skip(len)\n    }\n\n    /// Read a varint and downcast to `usize`.  C: `byteread_vlen`.\n    /// Returns `Err` when the value doesn't fit in a `usize` on\n    /// the target.  Mirrors the C check `*value != val_read`.\n    pub fn read_vlen(&mut self) -> Result<usize, Error> {\n        let val = self.read_varint()?;\n        let as_usize = val as usize;\n        if as_usize as u64 != val {\n            return Err(Error::InvalidArgument);\n        }\n        Ok(as_usize)\n    }\n\n    /// Copy `buffer.len()` bytes into the stream.  C:\n    /// `bytewrite_buffer(s, buffer, length)` — the explicit\n    /// `length` is taken from the slice.\n    pub fn write_bytes(&mut self, buffer: &[u8]) -> Result<(), Error> {\n        let length = buffer.len();\n        if self.data_ref().len() - self.ptr < length {\n            self.set_error();\n            return Err(Error::BufferTooSmall);\n        }\n        let ptr = self.ptr;\n        self.data_mut()[ptr..ptr + length].copy_from_slice(buffer);\n        self.ptr += length;\n        Ok(())\n    }\n\n    /// Copy `buffer.len()` bytes out of the stream.  C:\n    /// `byteread_buffer`.\n    pub fn read_bytes(&mut self, buffer: &mut [u8]) -> Result<(), Error> {\n        let length = buffer.len();\n        if self.data_ref().len() - self.ptr < length {\n            self.set_error();\n            return Err(Error::BufferTooSmall);\n        }\n        buffer.copy_from_slice(&self.data_ref()[self.ptr..self.ptr + length]);\n        self.ptr += length;\n        Ok(())\n    }\n\n    /// Encode a connection id as `u8` length + `id_len` raw bytes.\n    /// C: `bytewrite_cid`.\n    pub fn write_cid(&mut self, cid: &ConnectionId) -> Result<(), Error> {\n        self.write_u8(cid.id_len)?;\n        self.write_bytes(&cid.id[..cid.id_len as usize])\n    }\n\n    /// Decode a connection id.  C: `byteread_cid` (the C version\n    /// filled an out parameter; the Rust version returns the\n    /// value).  Returns `Err` when the encoded length exceeds\n    /// [`crate::CONNECTION_ID_MAX_SIZE`].\n    pub fn read_cid(&mut self) -> Result<ConnectionId, Error> {\n        let id_len = self.read_u8()?;\n        if id_len as usize > crate::CONNECTION_ID_MAX_SIZE {\n            self.set_error();\n            return Err(Error::InvalidArgument);\n        }\n        let mut cid = ConnectionId {\n            id_len,\n            ..ConnectionId::default()\n        };\n        self.read_bytes(&mut cid.id[..id_len as usize])?;\n        Ok(cid)\n    }\n\n    /// Skip past an encoded connection id.  C: `byteskip_cid`.\n    pub fn skip_cid(&mut self) -> Result<(), Error> {\n        let id_len = self.read_u8()?;\n        self.skip(id_len as usize)\n    }\n\n    /// Encode a string as varint-length + raw bytes (no NUL on the\n    /// wire).  C: `bytewrite_cstr` — took a `const char*` and\n    /// called `strlen`; the Rust version takes a `&str` and uses\n    /// its length directly.\n    pub fn write_str(&mut self, s: &str) -> Result<(), Error> {\n        let bytes = s.as_bytes();\n        self.write_varint(bytes.len() as u64)?;\n        self.write_bytes(bytes)\n    }\n\n    /// Decode a length-prefixed string into `dst`, returning the\n    /// number of bytes written.  C: `byteread_cstr(s, char* cstr,\n    /// size_t max_len)` wrote a NUL-terminated string and required\n    /// `length + 1 <= max_len`; the Rust version writes raw bytes\n    /// (callers reconstruct a `&str`/`&CStr` themselves) and\n    /// returns `Err` when `length > dst.len()`.\n    pub fn read_str(&mut self, dst: &mut [u8]) -> Result<usize, Error> {\n        let l_read = self.read_varint()?;\n        let l = l_read as usize;\n        if (l_read as usize as u64) != l_read {\n            self.set_error();\n            return Err(Error::InvalidArgument);\n        }\n        if l > dst.len() {\n            self.set_error();\n            return Err(Error::BufferTooSmall);\n        }\n        self.read_bytes(&mut dst[..l])?;\n        Ok(l)\n    }\n\n    /// Skip past a length-prefixed string.  C: `byteskip_cstr`.\n    pub fn skip_str(&mut self) -> Result<(), Error> {\n        let l_read = self.read_varint()?;\n        let l = l_read as usize;\n        if (l_read as usize as u64) != l_read {\n            self.set_error();\n            return Err(Error::InvalidArgument);\n        }\n        self.skip(l)\n    }\n\n    /// Encode a socket address as varint(family) + 4 or 16 raw\n    /// bytes (address) + big-endian `u16` (port).  C:\n    /// `bytewrite_addr`, which branched on `sa_family`; the Rust\n    /// version uses [`SocketAddr`].\n    pub fn write_addr(&mut self, addr: &SocketAddr) -> Result<(), Error> {\n        match addr {\n            SocketAddr::V4(a) => {\n                self.write_varint(WIRE_AF_INET)?;\n                self.write_bytes(&a.ip().octets())?;\n                self.write_u16(a.port())?;\n            }\n            SocketAddr::V6(a) => {\n                self.write_varint(WIRE_AF_INET6)?;\n                self.write_bytes(&a.ip().octets())?;\n                self.write_u16(a.port())?;\n            }\n        }\n        Ok(())\n    }\n\n    /// Decode a socket address.  C: `byteread_addr` (the C version\n    /// filled a `sockaddr_storage` out parameter; the Rust version\n    /// returns the value).\n    pub fn read_addr(&mut self) -> Result<SocketAddr, Error> {\n        let family = self.read_varint()?;\n        if family == WIRE_AF_INET {\n            let mut octets = [0u8; 4];\n            self.read_bytes(&mut octets)?;\n            let port = self.read_u16()?;\n            Ok(SocketAddr::from((octets, port)))\n        } else {\n            let mut octets = [0u8; 16];\n            self.read_bytes(&mut octets)?;\n            let port = self.read_u16()?;\n            Ok(SocketAddr::from((octets, port)))\n        }\n    }\n\n    /// Skip past an encoded socket address.  C: `byteskip_addr`.\n    pub fn skip_addr(&mut self) -> Result<(), Error> {\n        let family = self.read_varint()?;\n        if family == WIRE_AF_INET {\n            self.skip(4 + 2)\n        } else {\n            self.skip(16 + 2)\n        }\n    }\n}\n\nimpl ByteStream<'static> {\n    /// Allocate a fresh `nb_bytes`-byte heap buffer and return a\n    /// bytestream that owns it.  Returns `None` on allocation\n    /// failure.  C: `bytestream_alloc`.\n    ///\n    /// The C signature took a pre-existing `bytestream*` and only\n    /// allocated `s->data`; the Rust version bundles construction\n    /// and allocation, since the bytestream now owns the buffer\n    /// through [`ByteStreamData::Owned`].  The matching C\n    /// `bytestream_delete` has no Rust equivalent — drop the\n    /// `ByteStream` to free.\n    pub fn with_capacity(nb_bytes: usize) -> Option<Self> {\n        let mut v = Vec::new();\n        v.try_reserve_exact(nb_bytes).ok()?;\n        v.resize(nb_bytes, 0);\n        Some(ByteStream {\n            data: ByteStreamData::Owned(v),\n            ptr: 0,\n        })\n    }\n}\n\nimpl ByteStream<'_> {\n    /// Encoded byte-length of `value` as a QUIC varint (1, 2, 4,\n    /// or 8 bytes).  C: `bytestream_varint_len`.\n    pub fn varint_encoded_len(value: u64) -> usize {\n        if value <= 0x3F {\n            1\n        } else if value <= 0x3FFF {\n            2\n        } else if value <= 0x3FFF_FFFF {\n            4\n        } else {\n            8\n        }\n    }\n}\n\n#[cfg(test)]\nmod test {}\n","numLines":649,"startLine":1,"totalLines":649}}}
