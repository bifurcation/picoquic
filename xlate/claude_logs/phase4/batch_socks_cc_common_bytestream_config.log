{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_018MCmehA4b6fHaLyshgoaYy","type":"tool_result","content":"1\t//! Default [`crate::socks::Socket`] implementation backed by\n2\t//! [`socket2::Socket`].\n3\t//!\n4\t//! This is the canonical UDP-socket implementation for\n5\t//! Linux / macOS / Windows.  Other backends (no-std embedded,\n6\t//! the test simulator) implement the same trait against their\n7\t//! own platform abstractions.\n8\t//!\n9\t//! Phase 1 contract: signatures only — every method body is\n10\t//! stubs.  Phase 4 wires them through `socket2`'s\n11\t//! `recv_from`/`send_to`/`set_*` calls.\n12\t\n13\tuse core::net::SocketAddr;\n14\t\n15\tuse crate::Error;\n16\tuse crate::socks::{OsError, RecvInfo, Socket};\n17\t\n18\t/// Newtype around [`socket2::Socket`] so we can implement\n19\t/// the [`crate::socks::Socket`] trait on it locally (the\n20\t/// orphan-rules forbid `impl crate::Socket for socket2::Socket`\n21\t/// directly, since neither type belongs to this crate before\n22\t/// the trait moves in).\n23\tpub struct Socket2Udp(pub socket2::Socket);\n24\t\n25\timpl Socket2Udp {\n26\t    /// Open a UDP client socket on address family `af`\n27\t    /// (`AF_INET` / `AF_INET6`).  Applies pktinfo / ECN /\n28\t    /// PMTUD options before returning.  C:\n29\t    /// `picoquic_open_client_socket`.\n30\t    pub fn open_client(af: i32) -> Result<Self, Error> {\n31\t        let domain = socket2::Domain::from(af);\n32\t        let sock = socket2::Socket::new(domain, socket2::Type::DGRAM, Some(socket2::Protocol::UDP))\n33\t            .map_err(|_| Error::Generic)?;\n34\t        let mut udp = Socket2Udp(sock);\n35\t        let _ = udp.set_pkt_info();\n36\t        let _ = udp.set_ecn_options();\n37\t        let _ = udp.set_pmtud_options();\n38\t        Ok(udp)\n39\t    }\n40\t\n41\t    /// Bind this socket to `port` on `af`.\n42\t    /// C: `picoquic_bind_to_port`.\n43\t    pub fn bind_to_port(&mut self, af: i32, port: i32) -> Result<(), Error> {\n44\t        use core::net::{Ipv4Addr, Ipv6Addr, SocketAddrV4, SocketAddrV6};\n45\t        let addr = if socket2::Domain::from(af) == socket2::Domain::IPV6 {\n46\t            SocketAddr::V6(SocketAddrV6::new(Ipv6Addr::UNSPECIFIED, port as u16, 0, 0))\n47\t        } else {\n48\t            SocketAddr::V4(SocketAddrV4::new(Ipv4Addr::UNSPECIFIED, port as u16))\n49\t        };\n50\t        self.0\n51\t            .bind(&socket2::SockAddr::from(addr))\n52\t            .map_err(|_| Error::Generic)\n53\t    }\n54\t\n55\t    fn open_bound(domain: socket2::Domain, port: i32) -> Result<Self, Error> {\n56\t        use core::net::{Ipv4Addr, Ipv6Addr, SocketAddrV4, SocketAddrV6};\n57\t        let sock = socket2::Socket::new(domain, socket2::Type::DGRAM, Some(socket2::Protocol::UDP))\n58\t            .map_err(|_| Error::Generic)?;\n59\t        let mut udp = Socket2Udp(sock);\n60\t        let _ = udp.set_pkt_info();\n61\t        let _ = udp.set_ecn_options();\n62\t        let _ = udp.set_pmtud_options();\n63\t        let addr = if domain == socket2::Domain::IPV6 {\n64\t            SocketAddr::V6(SocketAddrV6::new(Ipv6Addr::UNSPECIFIED, port as u16, 0, 0))\n65\t        } else {\n66\t            SocketAddr::V4(SocketAddrV4::new(Ipv4Addr::UNSPECIFIED, port as u16))\n67\t        };\n68\t        udp.0\n69\t            .bind(&socket2::SockAddr::from(addr))\n70\t            .map_err(|_| Error::Generic)?;\n71\t        Ok(udp)\n72\t    }\n73\t}\n74\t\n75\timpl Socket for Socket2Udp {\n76\t    fn local_address(&self) -> Result<SocketAddr, Error> {\n77\t        let sa = self.0.local_addr().map_err(|_| Error::Generic)?;\n78\t        sa.as_socket().ok_or(Error::Generic)\n79\t    }\n80\t\n81\t    fn recv(&mut self, buffer: &mut [u8]) -> Result<RecvInfo, Error> {\n82\t        use std::io::Read;\n83\t        let bytes_recv = self.0.read(buffer).map_err(|_| Error::Generic)?;\n84\t        Ok(RecvInfo {\n85\t            bytes_recv,\n86\t            ..RecvInfo::default()\n87\t        })\n88\t    }\n89\t\n90\t    fn send(\n91\t        &mut self,\n92\t        addr_dest: &SocketAddr,\n93\t        _addr_from: Option<&SocketAddr>,\n94\t        _dest_if: i32,\n95\t        bytes: &[u8],\n96\t        _gso_size: i32,\n97\t    ) -> Result<usize, OsError> {\n98\t        let sa = socket2::SockAddr::from(*addr_dest);\n99\t        self.0\n100\t            .send_to(bytes, &sa)\n101\t            .map_err(|e| OsError(e.raw_os_error().unwrap_or(-1)))\n102\t    }\n103\t\n104\t    fn set_pkt_info(&mut self) -> Result<(), Error> {\n105\t        // IPV6_V6ONLY is the part socket2 exposes; IP_PKTINFO /\n106\t        // IPV6_RECVPKTINFO require direct setsockopt (not in socket2 0.5).\n107\t        let _ = self.0.set_only_v6(true);\n108\t        Ok(())\n109\t    }\n110\t\n111\t    fn set_ecn_options(&mut self) -> Result<(bool, bool), Error> {\n112\t        // Full ECN option setting (IP_TOS/IP_RECVTOS, IPV6_TCLASS/\n113\t        // IPV6_RECVTCLASS) is platform-specific and not uniformly\n114\t        // exposed by socket2 0.5.  Report unsupported for now.\n115\t        Ok((false, false))\n116\t    }\n117\t\n118\t    fn set_pmtud_options(&mut self) -> Result<(), Error> {\n119\t        // IP_MTU_DISCOVER / IPV6_MTU_DISCOVER are Linux-only and not\n120\t        // exposed by socket2 0.5; no-op on other platforms.\n121\t        Ok(())\n122\t    }\n123\t\n124\t    fn open_server_v4(port: i32) -> Result<Self, Error> {\n125\t        Self::open_bound(socket2::Domain::IPV4, port)\n126\t    }\n127\t\n128\t    fn open_server_v6(port: i32) -> Result<Self, Error> {\n129\t        Self::open_bound(socket2::Domain::IPV6, port)\n130\t    }\n131\t}\n132\t\n133\t#[cfg(test)]\n134\tmod test {}\n135\t"}]},"parent_tool_use_id":null,"session_id":"3d42c661-040a-4c4c-a3b8-7304c8a33988","uuid":"3f4a9b68-9b18-4394-9b32-8bce99445cf8","timestamp":"2026-05-05T21:11:03.633Z","tool_use_result":{"type":"text","file":{"filePath":"/Users/richbarn/Projects/picoquic/rs/fq/src/socks_socket2.rs","content":"//! Default [`crate::socks::Socket`] implementation backed by\n//! [`socket2::Socket`].\n//!\n//! This is the canonical UDP-socket implementation for\n//! Linux / macOS / Windows.  Other backends (no-std embedded,\n//! the test simulator) implement the same trait against their\n//! own platform abstractions.\n//!\n//! Phase 1 contract: signatures only — every method body is\n//! stubs.  Phase 4 wires them through `socket2`'s\n//! `recv_from`/`send_to`/`set_*` calls.\n\nuse core::net::SocketAddr;\n\nuse crate::Error;\nuse crate::socks::{OsError, RecvInfo, Socket};\n\n/// Newtype around [`socket2::Socket`] so we can implement\n/// the [`crate::socks::Socket`] trait on it locally (the\n/// orphan-rules forbid `impl crate::Socket for socket2::Socket`\n/// directly, since neither type belongs to this crate before\n/// the trait moves in).\npub struct Socket2Udp(pub socket2::Socket);\n\nimpl Socket2Udp {\n    /// Open a UDP client socket on address family `af`\n    /// (`AF_INET` / `AF_INET6`).  Applies pktinfo / ECN /\n    /// PMTUD options before returning.  C:\n    /// `picoquic_open_client_socket`.\n    pub fn open_client(af: i32) -> Result<Self, Error> {\n        let domain = socket2::Domain::from(af);\n        let sock = socket2::Socket::new(domain, socket2::Type::DGRAM, Some(socket2::Protocol::UDP))\n            .map_err(|_| Error::Generic)?;\n        let mut udp = Socket2Udp(sock);\n        let _ = udp.set_pkt_info();\n        let _ = udp.set_ecn_options();\n        let _ = udp.set_pmtud_options();\n        Ok(udp)\n    }\n\n    /// Bind this socket to `port` on `af`.\n    /// C: `picoquic_bind_to_port`.\n    pub fn bind_to_port(&mut self, af: i32, port: i32) -> Result<(), Error> {\n        use core::net::{Ipv4Addr, Ipv6Addr, SocketAddrV4, SocketAddrV6};\n        let addr = if socket2::Domain::from(af) == socket2::Domain::IPV6 {\n            SocketAddr::V6(SocketAddrV6::new(Ipv6Addr::UNSPECIFIED, port as u16, 0, 0))\n        } else {\n            SocketAddr::V4(SocketAddrV4::new(Ipv4Addr::UNSPECIFIED, port as u16))\n        };\n        self.0\n            .bind(&socket2::SockAddr::from(addr))\n            .map_err(|_| Error::Generic)\n    }\n\n    fn open_bound(domain: socket2::Domain, port: i32) -> Result<Self, Error> {\n        use core::net::{Ipv4Addr, Ipv6Addr, SocketAddrV4, SocketAddrV6};\n        let sock = socket2::Socket::new(domain, socket2::Type::DGRAM, Some(socket2::Protocol::UDP))\n            .map_err(|_| Error::Generic)?;\n        let mut udp = Socket2Udp(sock);\n        let _ = udp.set_pkt_info();\n        let _ = udp.set_ecn_options();\n        let _ = udp.set_pmtud_options();\n        let addr = if domain == socket2::Domain::IPV6 {\n            SocketAddr::V6(SocketAddrV6::new(Ipv6Addr::UNSPECIFIED, port as u16, 0, 0))\n        } else {\n            SocketAddr::V4(SocketAddrV4::new(Ipv4Addr::UNSPECIFIED, port as u16))\n        };\n        udp.0\n            .bind(&socket2::SockAddr::from(addr))\n            .map_err(|_| Error::Generic)?;\n        Ok(udp)\n    }\n}\n\nimpl Socket for Socket2Udp {\n    fn local_address(&self) -> Result<SocketAddr, Error> {\n        let sa = self.0.local_addr().map_err(|_| Error::Generic)?;\n        sa.as_socket().ok_or(Error::Generic)\n    }\n\n    fn recv(&mut self, buffer: &mut [u8]) -> Result<RecvInfo, Error> {\n        use std::io::Read;\n        let bytes_recv = self.0.read(buffer).map_err(|_| Error::Generic)?;\n        Ok(RecvInfo {\n            bytes_recv,\n            ..RecvInfo::default()\n        })\n    }\n\n    fn send(\n        &mut self,\n        addr_dest: &SocketAddr,\n        _addr_from: Option<&SocketAddr>,\n        _dest_if: i32,\n        bytes: &[u8],\n        _gso_size: i32,\n    ) -> Result<usize, OsError> {\n        let sa = socket2::SockAddr::from(*addr_dest);\n        self.0\n            .send_to(bytes, &sa)\n            .map_err(|e| OsError(e.raw_os_error().unwrap_or(-1)))\n    }\n\n    fn set_pkt_info(&mut self) -> Result<(), Error> {\n        // IPV6_V6ONLY is the part socket2 exposes; IP_PKTINFO /\n        // IPV6_RECVPKTINFO require direct setsockopt (not in socket2 0.5).\n        let _ = self.0.set_only_v6(true);\n        Ok(())\n    }\n\n    fn set_ecn_options(&mut self) -> Result<(bool, bool), Error> {\n        // Full ECN option setting (IP_TOS/IP_RECVTOS, IPV6_TCLASS/\n        // IPV6_RECVTCLASS) is platform-specific and not uniformly\n        // exposed by socket2 0.5.  Report unsupported for now.\n        Ok((false, false))\n    }\n\n    fn set_pmtud_options(&mut self) -> Result<(), Error> {\n        // IP_MTU_DISCOVER / IPV6_MTU_DISCOVER are Linux-only and not\n        // exposed by socket2 0.5; no-op on other platforms.\n        Ok(())\n    }\n\n    fn open_server_v4(port: i32) -> Result<Self, Error> {\n        Self::open_bound(socket2::Domain::IPV4, port)\n    }\n\n    fn open_server_v6(port: i32) -> Result<Self, Error> {\n        Self::open_bound(socket2::Domain::IPV6, port)\n    }\n}\n\n#[cfg(test)]\nmod test {}\n","numLines":135,"startLine":1,"totalLines":135}}}
