{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01LjcJC7vNCd6NxNXNmhnVPR","type":"tool_result","content":"250\t/// the [`NB_PACKET_CONTEXT`] constant below.\n251\t#[derive(Debug, Copy, Clone, PartialEq, Eq)]\n252\t#[repr(u8)]\n253\tpub enum PacketContext {\n254\t    Application = 0,\n255\t    Handshake = 1,\n256\t    Initial = 2,\n257\t}\n258\t\n259\t/// Number of packet contexts (matches the variant count of\n260\t/// [`PacketContext`]).\n261\tpub const NB_PACKET_CONTEXT: usize = 3;\n262\t\n263\t/// Path-MTU-discovery policy for a connection.\n264\t#[derive(Debug, Copy, Clone, PartialEq, Eq, Default)]\n265\t#[repr(u8)]\n266\tpub enum PmtudPolicy {\n267\t    /// Default opportunistic PMTUD.\n268\t    #[default]\n269\t    Basic = 0,\n270\t    /// Force PMTUD as soon as possible.\n271\t    Required = 1,\n272\t    /// Only do PMTUD if a lot of data has to be sent.\n273\t    Delayed = 2,\n274\t    /// Never do PMTUD.\n275\t    Blocked = 3,\n276\t}\n277\t\n278\t/// Spin-bit variant policy.\n279\t#[derive(Debug, Copy, Clone, PartialEq, Eq, Default)]\n280\t#[repr(u8)]\n281\tpub enum SpinbitVersion {\n282\t    /// Default behaviour, per the spin-bit draft.\n283\t    #[default]\n284\t    Basic = 0,\n285\t    /// Randomise per packet.\n286\t    Random = 1,\n287\t    /// Null behaviour, randomised per path.\n288\t    Null = 2,\n289\t    /// Test-only \"always on\" mode.  Not valid as a per-connection\n290\t    /// override (server only; see [`Quic::set_default_spinbit_policy`]).\n291\t    On = 3,\n292\t}\n293\t\n294\t/// Loss-bit support level.\n295\t#[derive(Debug, Copy, Clone, PartialEq, Eq, Default)]\n296\t#[repr(u8)]\n297\tpub enum LossbitVersion {\n298\t    /// Loss bits disabled.\n299\t    #[default]\n300\t    None = 0,\n301\t    /// This endpoint sets the loss bits but does not interpret peer's.\n302\t    SendOnly = 1,\n303\t    /// This endpoint both sets and receives loss bits.\n304\t    SendReceive = 2,\n305\t}\n306\t\n307\t/// Path scheduling status — whether a path participates in normal\n308\t/// scheduling or is held in reserve.\n309\t#[derive(Debug, Copy, Clone, PartialEq, Eq, Default)]\n310\t#[repr(u8)]\n311\tpub enum PathStatus {\n312\t    /// Path is available for sending.\n313\t    #[default]\n314\t    Available = 0,\n315\t    /// Path is held as a backup; data only flows when no Available\n316\t    /// path remains.\n317\t    Backup = 1,\n318\t}\n319\t\n320\t// ---------------------------------------------------------------------------\n321\t// Connection ID.\n322\t\n323\tpub const CONNECTION_ID_MIN_SIZE: usize = 0;\n324\tpub const CONNECTION_ID_MAX_SIZE: usize = 20;\n325\t\n326\t/// Fixed-capacity QUIC connection ID.  C: `ConnectionId`.\n327\t///\n328\t/// Stored as a 20-byte buffer plus a length so the type is `Copy`,\n329\t/// matching the C usage where connection IDs are passed by value\n330\t/// in many APIs (`get_local_connection_id`, `create_connection`,\n331\t/// …).  Fields are private — construct via [`Self::clone_from_slice`]\n332\t/// or [`Self::with_size`] and read via [`Self::as_bytes`].\n333\t///\n334\t/// `Ord` is derived as lexicographic over the live bytes (matching\n335\t/// the C `compare_connection_id` shape: per-byte compare under\n336\t/// `min(len_a, len_b)`, then length tie-break).\n337\t#[derive(Debug, Copy, Clone, PartialEq, Eq, PartialOrd, Ord, Hash, Default)]\n338\tpub struct ConnectionId {\n339\t    id: [u8; CONNECTION_ID_MAX_SIZE],\n340\t    id_len: u8,\n341\t}\n342\t\n343\timpl ConnectionId {\n344\t    /// Construct a connection id by copying `bytes`.  Returns `None`\n345\t    /// when `bytes.len()` exceeds [`CONNECTION_ID_MAX_SIZE`].\n346\t    pub fn clone_from_slice(bytes: &[u8]) -> Option<Self> {\n347\t        if bytes.len() > CONNECTION_ID_MAX_SIZE {\n348\t            return None;\n349\t        }\n350\t        let mut id = [0u8; CONNECTION_ID_MAX_SIZE];\n351\t        id[..bytes.len()].copy_from_slice(bytes);\n352\t        Some(Self {\n353\t            id,\n354\t            id_len: bytes.len() as u8,\n355\t        })\n356\t    }\n357\t\n358\t    /// Construct a zero-filled connection id of length `len`.\n359\t    /// Returns `None` when `len` exceeds [`CONNECTION_ID_MAX_SIZE`].\n360\t    pub fn with_size(len: usize) -> Option<Self> {\n361\t        if len > CONNECTION_ID_MAX_SIZE {\n362\t            return None;\n363\t        }\n364\t        Some(Self {\n365\t            id: [0u8; CONNECTION_ID_MAX_SIZE],\n366\t            id_len: len as u8,\n367\t        })\n368\t    }\n369\t\n370\t    /// Borrow the live id bytes (`bytes[..len]`).\n371\t    pub fn as_bytes(&self) -> &[u8] {\n372\t        &self.id[..self.id_len as usize]\n373\t    }\n374\t\n375\t    /// Mutable borrow of the live id bytes.\n376\t    pub fn as_bytes_mut(&mut self) -> &mut [u8] {\n377\t        &mut self.id[..self.id_len as usize]\n378\t    }\n379\t\n380\t    /// Number of bytes in the id.\n381\t    pub fn len(&self) -> usize {\n382\t        self.id_len as usize\n383\t    }\n384\t\n385\t    /// `true` when the id has zero length.  Mirrors the C\n386\t    /// `is_connection_id_null` sentinel check.\n387\t    pub fn is_empty(&self) -> bool {\n388\t        self.id_len == 0\n389\t    }\n390\t\n391\t    /// Hash with a 16-byte seed.  C: `connection_id_hash`.\n392\t    pub fn hash_with_seed(&self, seed: &[u8; 16]) -> u64 {\n393\t        crate::siphash::siphash(self.as_bytes(), seed)\n394\t    }\n395\t\n396\t    /// Fold the first up-to-8 bytes of the id into a `u64`.\n397\t    /// C: `val64_connection_id`.\n398\t    pub fn val64(&self) -> u64 {\n399\t        let bytes = self.as_bytes();"}]},"parent_tool_use_id":null,"session_id":"c245b9be-ba7b-43bb-a602-6ddd8ff5d9c1","uuid":"e03999f6-27c0-40bb-8828-ffe4d5c9f702","timestamp":"2026-05-07T08:45:15.775Z","tool_use_result":{"type":"text","file":{"filePath":"/Users/richbarn/Projects/picoquic/rs/fq/src/lib.rs","content":"/// the [`NB_PACKET_CONTEXT`] constant below.\n#[derive(Debug, Copy, Clone, PartialEq, Eq)]\n#[repr(u8)]\npub enum PacketContext {\n    Application = 0,\n    Handshake = 1,\n    Initial = 2,\n}\n\n/// Number of packet contexts (matches the variant count of\n/// [`PacketContext`]).\npub const NB_PACKET_CONTEXT: usize = 3;\n\n/// Path-MTU-discovery policy for a connection.\n#[derive(Debug, Copy, Clone, PartialEq, Eq, Default)]\n#[repr(u8)]\npub enum PmtudPolicy {\n    /// Default opportunistic PMTUD.\n    #[default]\n    Basic = 0,\n    /// Force PMTUD as soon as possible.\n    Required = 1,\n    /// Only do PMTUD if a lot of data has to be sent.\n    Delayed = 2,\n    /// Never do PMTUD.\n    Blocked = 3,\n}\n\n/// Spin-bit variant policy.\n#[derive(Debug, Copy, Clone, PartialEq, Eq, Default)]\n#[repr(u8)]\npub enum SpinbitVersion {\n    /// Default behaviour, per the spin-bit draft.\n    #[default]\n    Basic = 0,\n    /// Randomise per packet.\n    Random = 1,\n    /// Null behaviour, randomised per path.\n    Null = 2,\n    /// Test-only \"always on\" mode.  Not valid as a per-connection\n    /// override (server only; see [`Quic::set_default_spinbit_policy`]).\n    On = 3,\n}\n\n/// Loss-bit support level.\n#[derive(Debug, Copy, Clone, PartialEq, Eq, Default)]\n#[repr(u8)]\npub enum LossbitVersion {\n    /// Loss bits disabled.\n    #[default]\n    None = 0,\n    /// This endpoint sets the loss bits but does not interpret peer's.\n    SendOnly = 1,\n    /// This endpoint both sets and receives loss bits.\n    SendReceive = 2,\n}\n\n/// Path scheduling status — whether a path participates in normal\n/// scheduling or is held in reserve.\n#[derive(Debug, Copy, Clone, PartialEq, Eq, Default)]\n#[repr(u8)]\npub enum PathStatus {\n    /// Path is available for sending.\n    #[default]\n    Available = 0,\n    /// Path is held as a backup; data only flows when no Available\n    /// path remains.\n    Backup = 1,\n}\n\n// ---------------------------------------------------------------------------\n// Connection ID.\n\npub const CONNECTION_ID_MIN_SIZE: usize = 0;\npub const CONNECTION_ID_MAX_SIZE: usize = 20;\n\n/// Fixed-capacity QUIC connection ID.  C: `ConnectionId`.\n///\n/// Stored as a 20-byte buffer plus a length so the type is `Copy`,\n/// matching the C usage where connection IDs are passed by value\n/// in many APIs (`get_local_connection_id`, `create_connection`,\n/// …).  Fields are private — construct via [`Self::clone_from_slice`]\n/// or [`Self::with_size`] and read via [`Self::as_bytes`].\n///\n/// `Ord` is derived as lexicographic over the live bytes (matching\n/// the C `compare_connection_id` shape: per-byte compare under\n/// `min(len_a, len_b)`, then length tie-break).\n#[derive(Debug, Copy, Clone, PartialEq, Eq, PartialOrd, Ord, Hash, Default)]\npub struct ConnectionId {\n    id: [u8; CONNECTION_ID_MAX_SIZE],\n    id_len: u8,\n}\n\nimpl ConnectionId {\n    /// Construct a connection id by copying `bytes`.  Returns `None`\n    /// when `bytes.len()` exceeds [`CONNECTION_ID_MAX_SIZE`].\n    pub fn clone_from_slice(bytes: &[u8]) -> Option<Self> {\n        if bytes.len() > CONNECTION_ID_MAX_SIZE {\n            return None;\n        }\n        let mut id = [0u8; CONNECTION_ID_MAX_SIZE];\n        id[..bytes.len()].copy_from_slice(bytes);\n        Some(Self {\n            id,\n            id_len: bytes.len() as u8,\n        })\n    }\n\n    /// Construct a zero-filled connection id of length `len`.\n    /// Returns `None` when `len` exceeds [`CONNECTION_ID_MAX_SIZE`].\n    pub fn with_size(len: usize) -> Option<Self> {\n        if len > CONNECTION_ID_MAX_SIZE {\n            return None;\n        }\n        Some(Self {\n            id: [0u8; CONNECTION_ID_MAX_SIZE],\n            id_len: len as u8,\n        })\n    }\n\n    /// Borrow the live id bytes (`bytes[..len]`).\n    pub fn as_bytes(&self) -> &[u8] {\n        &self.id[..self.id_len as usize]\n    }\n\n    /// Mutable borrow of the live id bytes.\n    pub fn as_bytes_mut(&mut self) -> &mut [u8] {\n        &mut self.id[..self.id_len as usize]\n    }\n\n    /// Number of bytes in the id.\n    pub fn len(&self) -> usize {\n        self.id_len as usize\n    }\n\n    /// `true` when the id has zero length.  Mirrors the C\n    /// `is_connection_id_null` sentinel check.\n    pub fn is_empty(&self) -> bool {\n        self.id_len == 0\n    }\n\n    /// Hash with a 16-byte seed.  C: `connection_id_hash`.\n    pub fn hash_with_seed(&self, seed: &[u8; 16]) -> u64 {\n        crate::siphash::siphash(self.as_bytes(), seed)\n    }\n\n    /// Fold the first up-to-8 bytes of the id into a `u64`.\n    /// C: `val64_connection_id`.\n    pub fn val64(&self) -> u64 {\n        let bytes = self.as_bytes();","numLines":150,"startLine":250,"totalLines":4161}}}
