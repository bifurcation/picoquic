 autoqlog_fn: Option<Box<dyn AutoQlog>>,\n1642\t    pub text_log_fns: Option<LoggerRef>,\n1643\t    pub bin_log_fns: Option<LoggerRef>,\n1644\t    pub qlog_fns: Option<LoggerRef>,\n1645\t    pub perflog_fn: Option<Box<dyn PerformanceLog>>,\n1646\t    /// Application state for the performance-log callback.\n1647\t    pub v_perflog_ctx: Option<Box<dyn Any>>,\n1648\t    /// Application state for the thread callbacks.\n1649\t    pub v_thread_ctx: Option<Box<dyn Any>>,\n1650\t}\n1651\t\n1652\t/// Map a crypto epoch (0-3) to its packet-number-space context.\n1653\t/// C: `picoquic_context_from_epoch`.\n1654\t///\n1655\t/// Epoch 0 = Initial → Initial\n1656\t/// Epoch 1 = 0-RTT   → Application\n1657\t/// Epoch 2 = Handshake → Handshake\n1658\t/// Epoch 3 = 1-RTT   → Application\n1659\tpub fn context_from_epoch(epoch: i32) -> PacketContext {\n1660\t    const PC: [PacketContext; 4] = [\n1661\t        PacketContext::Initial,\n1662\t        PacketContext::Application,\n1663\t        PacketContext::Handshake,\n1664\t        PacketContext::Application,\n1665\t    ];\n1666\t    if (0..4).contains(&epoch) {\n1667\t        PC[epoch as usize]\n1668\t    } else {\n1669\t        PacketContext::Application"}]},"parent_tool_use_id":"toolu_01EXTpzBJZpKaWrM8qzGF4pg","session_id":"c245b9be-ba7b-43bb-a602-6ddd8ff5d9c1","uuid":"9d149813-79c0-4164-9b16-841495d02458","timestamp":"2026-05-07T08:45:37.845Z"}
