{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_017TLbguh737CV5uCjU2JRDR","type":"tool_result","content":"1\t//! QUIC transport-parameter shapes and helpers.\n2\t//!\n3\t//! Wire-format identifiers ([`TransportParameter`]), the value\n4\t//! structs that travel inside a TP block ([`PreferredAddress`],\n5\t//! [`VersionNegotiation`]), and the aggregate the handshake hands\n6\t//! to the application ([`TransportParameters`]).\n7\t\n8\tuse core::net::SocketAddr;\n9\t\n10\tuse crate::{ConnectionId, Duration};\n11\t\n12\t// ---------------------------------------------------------------------------\n13\t// Wire identifiers.\n14\t\n15\t/// QUIC transport-parameter identifiers.  Wire values exceed `u32`\n16\t/// for several extension parameters, hence `#[repr(u64)]`.\n17\t#[derive(Debug, Copy, Clone, PartialEq, Eq)]\n18\t#[repr(u64)]\n19\tpub enum TransportParameter {\n20\t    OriginalConnectionId = 0,\n21\t    IdleTimeout = 1,\n22\t    StatelessResetToken = 2,\n23\t    MaxPacketSize = 3,\n24\t    InitialMaxData = 4,\n25\t    InitialMaxStreamDataBidiLocal = 5,\n26\t    InitialMaxStreamDataBidiRemote = 6,\n27\t    InitialMaxStreamDataUni = 7,\n28\t    InitialMaxStreamsBidi = 8,\n29\t    InitialMaxStreamsUni = 9,\n30\t    AckDelayExponent = 10,\n31\t    MaxAckDelay = 11,\n32\t    DisableMigration = 12,\n33\t    ServerPreferredAddress = 13,\n34\t    ActiveConnectionIdLimit = 14,\n35\t    HandshakeConnectionId = 15,\n36\t    RetryConnectionId = 16,\n37\t    /// Per `draft-quic-multipath 20`.\n38\t    InitialMaxPathId = 0x3e,\n39\t    VersionNegotiation = 0x11,\n40\t    /// Per `draft-pauly-quic-datagram-05`.\n41\t    MaxDatagramFrameSize = 32,\n42\t    TestLargeChello = 3127,\n43\t    EnableLossBit = 0x1057,\n44\t    /// `(x & 1)` ↔ \"want timestamps\", `(x & 2)` ↔ \"can send timestamps\".\n45\t    EnableTimeStamp = 0x7158,\n46\t    GreaseQuicBit = 0x2ab2,\n47\t    /// Per `draft-kuhn-quic-0rtt-bdp-09`.\n48\t    EnableBdpFrame = 0xebd9,\n49\t    MinAck