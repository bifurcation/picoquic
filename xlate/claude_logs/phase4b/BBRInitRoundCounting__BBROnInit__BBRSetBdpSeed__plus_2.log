{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01MG6Ev5JrqwB3us5m6uv7t3","type":"tool_result","content":"500\t        headroom.max(BBR_MIN_PIPE_CWND * path_x.send_mtu as u64)\n501\t    }\n502\t\n503\t    /// C: `BBRIsProbingBW` (picoquic/bbr.c:1532)\n504\t    ///\n505\t    /// Returns `true` when the state is actively probing for more bandwidth\n506\t    /// (i.e. NOT in one of the non-probing states: ProbeBwDown, ProbeBwCruise,\n507\t    /// Drain, or ProbeRtt).\n508\t    pub fn is_probing_bw(&self) -> bool {\n509\t        !matches!(\n510\t            self.state,\n511\t            BbrAlgState::ProbeBwDown\n512\t                | BbrAlgState::ProbeBwCruise\n513\t                | BbrAlgState::Drain\n514\t                | BbrAlgState::ProbeRtt\n515\t        )\n516\t    }\n517\t\n518\t    /// C: `BBRLossLowerBounds` (picoquic/bbr.c:1035)\n519\t    ///\n520\t    /// Apply a `BBRBeta` (0.7) multiplicative decrease to `bw_lo` and\n521\t    /// `inflight_lo`, then floor each at the latest sample so the model\n522\t    /// cannot shrink below what was actually observed this round.\n523\t    pub fn loss_lower_bounds(&mut self) {\n524\t        self.bw_lo = ((BBR_BETA * self.bw_lo as f64) as u64).max(self.bw_latest);\n525\t        self.inflight_lo = ((BBR_BETA * self.inflight_lo as f64) as u64).max(self.inflight_latest);\n526\t    }\n527\t\n528\t    /// C: `BBRModulateCwndForRecovery` (picoquic/bbr.c:627)\n529\t    ///\n530\t    /// On packet loss, shrink `cwin` by the number of bytes lost (floored at\n531\t    /// one MTU).  When `packet_conservation` is active, ensure `cwin` is at\n532\t    /// least `bytes_in_transit + newly_acked` so the pipe stays full.\n533\t    pub fn modulate_cwnd_for_recovery(&self, path_x: &mut Path, rs: &BbrPerAckState) {\n534\t        if rs.newly_lost > 0 {\n535\t            if path_x.cwin > rs.newly_lost + path_x.send_mtu as u64 {\n536\t                path_x.cwin -= rs.newly_lost;\n537\t            } else {\n538\t                path_x.cwin = path_x.send_mtu as u64;\n539\t            }\n540\t        }\n541\t        if self.packet_conservation && path_x.cwin < path_x.bytes_in_transit + rs.newly_acked {\n542\t            path_x.cwin = path_x.bytes_in_transit + rs.newly_acked;\n543\t        }\n544\t    }\n545\t\n546\t    /// C: `BBRRaiseInflightHiSlope` (picoquic/bbr.c:1561)\n547\t    ///\n548\t    /// Recompute how aggressively `inflight_hi` is raised during ProbeBwUp.\n549\t    /// Each round the slope doubles (shift by `bw_probe_up_rounds`, capped at\n550\t    /// 30), and `bw_probe_up_cnt` is set to the number of MTU-sized ACKs\n551\t    /// required to justify a one-MTU increase (minimum 1).\n552\t    pub fn raise_inflight_hi_slope(&mut self, path_x: &Path) {\n553\t        let growth_this_round = (path_x.send_mtu as u64) << self.bw_probe_up_rounds;\n554\t        self.bw_probe_up_rounds = (self.bw_probe_up_rounds + 1).min(30);\n555\t        let up_cnt = (path_x.cwin / growth_this_round) as u32;\n556\t        self.bw_probe_up_cnt = up_cnt.max(1);\n557\t    }\n558\t\n559\t    /// C: `BBRResetCongestionSignals` (picoquic/bbr.c:1014)\n560\t    ///\n561\t    /// Clear the per-round congestion signals so the next round starts with\n562\t    /// a clean slate.  Called at the start of each new round.\n563\t    pub fn reset_congestion_signals(&mut self) {\n564\t        self.loss_in_round = false;\n565\t        self.bw_latest = 0;\n566\t        self.inflight_latest = 0;\n567\t    }\n568\t\n569\t    /// C: `BBRResetLowerBounds` (picoquic/bbr.c:1088)\n570\t    ///\n571\t    /// Reset `bw_lo` and `inflight_lo` to their uninitialized sentinel\n572\t    /// (`u64::MAX`), indicating no congestion episode has been seen yet.\n573\t    pub fn reset_lower_bounds(&mut self) {\n574\t        self.bw_lo = u64::MAX;\n575\t        self.inflight_lo = u64::MAX;\n576\t    }\n577\t\n578\t    /// C: `BBRResetRTTJitterBuffer` (picoquic/bbr.c:1322)\n579\t    ///\n580\t    /// Reinitialise the RTT jitter-buffer metadata to `rtt_init_value` and\n581\t    /// reset the cycle counter and excess counter.  The sample array itself\n582\t    /// is not cleared here (the caller's prior `memset` zeroes it on first\n583\t    /// call, and valid entries are overwritten as `rtt_jitter_cycle` advances).\n584\t    pub fn reset_rtt_jitter_buffer(&mut self, rtt_init_value: u64, current_time: u64) {\n585\t        self.rtt_jitter_cycle = 0;\n586\t        self.last_rtt_sample_stamp = current_time;\n587\t        self.rtt_short_term_min = rtt_init_value;\n588\t        self.rtt_short_term_max = rtt_init_value;\n589\t        self.probe_rtt_min_delay = rtt_init_value;\n590\t        self.nb_rtt_excess = 0;\n591\t    }\n592\t\n593\t    /// C: `BBRRestoreCwnd` (picoquic/bbr.c:736)\n594\t    ///\n595\t    /// Returns whichever is larger: the cwnd saved before recovery\n596\t    /// (`prior_cwnd`) or the current `path_x.cwin`.  Used when exiting\n597\t    /// recovery to avoid shrinking the window below what it was before.\n598\t    pub fn restore_cwnd(&self, path_x: &Path) -> u64 {\n599\t        self.prior_cwnd.max(path_x.cwin)\n600\t    }\n601\t\n602\t    /// C: `BBRSetPacingRateWithGain` (picoquic/bbr.c:944)\n603\t    ///\n604\t    /// Compute the target pacing rate as `pacing_gain × bw × (1 − margin%)`.\n605\t    /// In `StartupResume` with a BDP seed, the rate is floored at the seed\n606\t    /// rate to avoid sending slower than the measured path capacity.\n607\t    /// The rate is only applied when the pipe is full or the new rate exceeds\n608\t    /// the current one (prevents backward steps during slow-start).\n609\t    pub fn set_pacing_rate_with_gain(&mut self, pacing_gain: f64) {\n610\t        let rate = pacing_gain * (self.bw * (100 - BBR_PACING_MARGIN_PERCENT)) as f64 / 100.0;\n611\t        let rate = if self.state == BbrAlgState::StartupResume\n612\t            && !self.filled_pipe\n613\t            && self.bdp_seed > 0\n614\t            && self.min_rtt > 0\n615\t            && self.min