atic void picoquic_bbr_reset(picoquic_bbr_state_t* bbr_state, picoquic_path_t* path_x, uint64_t current_time)\n599\t{\n600\t    BBROnInit(bbr_state, path_x, current_time, bbr_state->option_string);\n601\t}\n602\t\n603\tstatic void picoquic_bbr_init(picoquic_path_t* path_x, char const* option_string, uint64_t current_time)\n604\t{\n605\t    /* Initialize the state of the congestion control algorithm */\n606\t    picoquic_bbr_state_t* bbr_state = (picoquic_bbr_state_t*)malloc(sizeof(picoquic_bbr_state_t));\n607\t\n608\t    path_x->congestion_alg_state = (void*)bbr_state;\n609\t    if (bbr_state != NULL) {\n610\t        BBROnInit(bbr_state, path_x, current_time, option_string);\n611\t    }\n612\t}\n613\t\n614\t/* End of init processes for BBr v3 */\n615\t\n616\t/* Release the state of the congestion control algorithm */\n617\tstatic void picoquic_bbr_delete(picoquic_path_t* path_x)\n618\t{\n619\t    if (path_x->congestion_alg_state != NULL) {\n620\t        free(path_x->congestion_alg_state);\n621\t        path_x->congestion_alg_state = NULL;\n622\t    }\n623\t}\n624\t\n625\t/* Path model functions */\n626\t\n627\t/* Managing PTO and recovery */\n628\t/* Discuss. This is already largely handled by the transport code.\n629\t * How much of this is needed?\n630\t */\n631\tstatic void BBRModulateCwndForRecovery(picoquic_bbr_state_t* bbr_state, picoquic_path_t* path_x, bbr_per_ack_state_t * rs)\n632\t{\n633\t    if (rs->newly_lost > 0) {\n634\t        if (path_x->cwin > rs->newly_lost + path_x->send_mtu) {\n635\t            path_x->cwin = path_x->cwin - rs->newly_lost;\n636\t        }\n637\t        else {\n638\t            path_x->cwin = path_x->send_mtu;\n639\t        }\n640\t    }\n641\t    if (bbr_state->packet_conservation && path_x->cwin < (path_x->bytes_in_transit + rs->newly_acked)) {\n642\t        path_x->cwin = path_x->bytes_in_transit + rs->newly_acked;\n643\t    }\n644\t}\n645\t  \n646\t\n647\tstatic void BBRBoundCwndForModel(picoquic_bbr_state_t* bbr_state, picoquic_path_t* path_x)\n648\t{\n649\t    uint64_t cap = UINT64_MAX;\n650\t    if (IsInAProbeBWState(bbr_state) &&\n651\t        bbr_state->state != picoquic_bbr_alg_probe_bw_cruise) {\n652\t        if (bbr_state->inflight_hi > 0) {\n653\t            cap = bbr_state->inflight_hi;\n654\t        }\n655\t    }\n656\t    else if (bbr_state->state == picoquic_bbr_alg_probe_rtt ||\n657\t        bbr_state->state == picoquic_bbr_alg_probe_bw_cruise) {\n658\t        cap = BBRInflightWithHeadroom(bbr_state, path_x);\n659\t    }\n660\t\n661\t    /* apply inflight_lo (possibly infinite): */\n662\t    if (cap > bbr_state->inflight_lo) {\n663\t        cap = bbr_state->inflight_lo;\n664\t    }\n665\t    if (cap < BBRMinPipeCwnd * path_x->send_mtu) {\n666\t        cap = BBRMinPipeCwnd * path_x->send_mtu;\n667\t    }\n668\t    if (path_x->cwin > cap) {\n669\t        path_x->cwin = cap;\n670\t    }\n671\t}\n672\t\n673\tstatic uint64_t BBRProbeRTTCwnd(picoquic_bbr_state_t* bbr_state, picoquic_path_t* path_x)\n674\t{\n675\t    uint64_t probe_rtt_cwnd = BBRBDPMultiple( bbr_state, path_x, BBRProbeRTTCwndGain);\n676\t    if (probe_rtt_cwnd < BBRMinPipeCwnd * path_x->send_mtu) {\n677\t        probe_rtt_cwnd = BBRMinPipeCwnd * path_x->send_mtu;\n678\t    }\n679\t    return probe_rtt_cwnd;\n680\t}\n681\t\n682\tstatic void BBRBoundCwndForProbeRTT(picoquic_bbr_state_t* bbr_state, picoquic_path_t* path_x)\n683\t{\n684\t    if (bbr_state->state == picoquic_bbr_alg_probe_rtt) {\n685\t        uint64_t cap = BBRProbeRTTCwnd(bbr_state, path_x);\n686\t        if (path_x->cwin > cap) {\n687\t            path_x->cwin = cap;\n688\t        }\n689\t    }\n690\t}\n691\t\n692\tstatic void BBRSetCwnd(picoquic_bbr_state_t* bbr_state, picoquic_path_t* path_x, bbr_per_ack_state_t * rs)\n693\t{\n694\t    BBRUpdateMaxInflight(bbr_state, path_x);\n695\t    /* TODO: check whether this should be done in every state */\n696\t    BBRModulateCwndForRecovery(bbr_state, path_x, rs);\n697\t    if (!bbr_state->packet_conservation) {\n698\t        if (bbr_state->filled_pipe) {\n699\t            path_x->cwin += rs->newly_acked;\n700\t            if (path_x->cwin > bbr_state->max_inflight) {\n701\t                path_x->cwin = bbr_state->max_inflight;\n702\t            }\n703\t        }\n704\t        else if (bbr_state->state == picoquic_bbr_alg_startup_resume &&\n705\t            bbr_state->bdp_seed > path_x->cwin) {\n706\t            path_x->cwin = bbr_state->bdp_seed;\n707\t        }\n708\t        else if (path_x->cwin < bbr_state->max_inflight || path_x->delivered < PICOQUIC_CWIN_INITIAL) {\n709\t            path_x->cwin = path_x->cwin+ rs->newly_acked;\n710\t        }\n711\t        if (path_x->cwin < BBRMinPipeCwnd * path_x->send_mtu) {\n712\t            path_x->cwin = BBRMinPipeCwnd * path_x->send_mtu;\n713\t        }\n714\t    }\n715\t    BBRBoundCwndForProbeRTT(bbr_state, path_x);\n716\t    BBRBoundCwndForModel(bbr_state, path_x);\n717\t}\n718\t\n719\t\n720\tstatic uint64_t BBRSaveCwnd(picoquic_bbr_state_t* bbr_state, picoquic_path_t* path_x)\n721\t{\n722\t\n723\t    if ( !InLossRecovery(bbr_state) && bbr_state->state != picoquic_bbr_alg_probe_rtt) {\n724\t        return path_x->cwin;\n725\t    }\n726\t    else {\n727\t        if (bbr_state->prior_cwnd > path_x->cwin) {\n728\t            return bbr_state->prior_cwnd;\n729\t        }\n730\t        else {\n731\t            return path_x->cwin;\n732\t        }\n733\t    }\n734\t}\n735\t\n736\tstatic uint64_t BBRRestoreCwnd(picoquic_bbr_state_t* bbr_state, picoquic_path_t* path_x)\n737\t{\n738\t    if (bbr_state->prior_cwnd > path_x->cwin) {\n739\t        return bbr_state->prior_cwnd;\n740\t    }\n741\t    else {\n742\t        return path_x->cwin;\n743\t    }\n744\t}\n745\t\n746\t/* \n747\t* Entering recovery sets the \"packet_conservation\" bit on.\n748\t* It is reset to 0 after one round trip. \n749\t */"}]},"parent_tool_use_id":null,"session_id":"c28b985a-b758-4cfb-a6d1-abf4d9917987","uuid":"ae51b9fd-56c2-4176-ba03-b56770b96381","ti