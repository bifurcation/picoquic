       }\n247\t    }\n248\t\n249\t    /// C: `BBRBDPMultipleWithBw` (picoquic/bbr.c:869)\n250\t    ///\n251\t    /// Returns `gain × BDP` computed at the supplied `bw` rather than\n252\t    /// `self.bw`.  When `min_rtt` has never been measured (`u64::MAX`),\n253\t    /// returns the initial congestion window as a safe floor.\n254\t    ///\n255\t    /// Side-effect: writes `self.bdp` so callers can read the raw BDP\n256\t    /// estimate after the call (mirrors C's write-through of\n257\t    /// `bbr_state->bdp`).\n258\t    pub fn bdp_multiple_with_bw(&mut self, path_x: &Path, gain: f64, bw: u64) -> u64 {\n259\t        if self.min_rtt == u64::MAX {\n260\t            return CWIN_INITIAL * path_x.send_mtu as u64;\n261\t        }\n262\t        // PICOQUIC_BYTES_FROM_RATE(min_rtt_us, bps) = min_rtt * bps / 1_000_000\n263\t        self.bdp = self.min_rtt * bw / 1_000_000;\n264\t        (gain * self.bdp as f64) as u64\n265\t    }\n266\t\n267\t    /// C: `BBRBoundBWForModel` (picoquic/bbr.c:1094)\n268\t    ///\n269\t    /// Set `self.bw = min(max_bw, bw_lo, bw_hi)`.  `bw_hi` is only\n270\t    /// applied when non-zero; the zero check preserves compatibility\n271\t    /// with states where `bw_hi` is not yet initialised (noted as a\n272\t    /// TODO in the C source).\n273\t    pub fn bound_bw_for_model(&mut self) {\n274\t        self.bw = self.max_bw;\n275\t        if self.bw > self.bw_lo {\n276\t            self.bw = self.bw_lo;\n277\t        }\n278\t        // TODO: remove the bw_hi != 0 guard once variables are properly\n279\t        // initialised (mirrors the C-side TODO at bbr.c:1100).\n280\t        if self.bw > self.bw_hi && self.bw_hi != 0 {\n281\t            self.bw = self.bw_hi;\n282\t        }\n283\t    }\n284\t\n285\t    /// C: `BBREnterProbeRTT` (picoquic/bbr.c:1487)\n286\t    pub fn enter_probe_rtt(&mut self, path_x: &mut Path) {\n287\t        self.state = BbrAlgState::ProbeRtt;\n288\t        self.pacing_gain = 1.0;\n289\t        self.cwnd_gain = BBR_PROBE_RT