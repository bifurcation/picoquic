lf.bw_probe_ceiling = self.bw + self.bw / 2;\n1231\t        self.start_probe_bw_down(connection, path_x, current_time);\n1232\t    }\n1233\t\n1234\t    /// C: `BBRExitProbeRTT` (picoquic/bbr.c:1431)\n1235\t    ///\n1236\t    /// Exit ProbeRTT: reset lower bounds, record the new `rtt_min` on the\n1237\t    /// path, then enter ProbeBW-DOWN/CRUISE (if the pipe is full) or\n1238\t    /// re-enter Startup.\n1239\t    fn exit_probe_rtt(&mut self, connection: &Connection, path_x: &mut Path, current_time: u64) {\n1240\t        self.reset_lower_bounds();\n1241\t        path_x.rtt_min = crate::Duration::from_ticks(self.min_rtt);\n1242\t        if self.filled_pipe {\n1243\t            self.enter_probe_bw(connection, path_x, current_time);\n1244\t            self.start_probe_bw_cruise();\n1245\t        } else {\n1246\t            self.enter_startup(path_x);\n1247\t        }\n1248\t    }\n1249\t\n1250\t    /// C: `BBROnEnterFastRecovery` (picoquic/bbr.c:750)\n1251\t    ///\n1252\t    /// Begin fast recovery: save cwnd, shrink window to bytes-in-transit\n1253\t    /// plus one packet (or newly-acked, whichever is larger), latch the\n1254\t    /// recovery watermark, and enable packet conservation.\n1255\t    fn on_enter_fast_recovery(\n1256\t        &mut self,\n1257\t        connection: &Connection,\n1258\t        path_x: &mut Path,\n1259\t        rs: &BbrPerAckState,\n1260\t    ) {\n1261\t        self.prior_cwnd = self.save_cwnd(path_x);\n1262\t        let additional_cwnd = rs.newly_acked.max(path_x.send_mtu as u64);\n1263\t        path_x.cwin = path_x.bytes_in_transit + additional_cwnd;\n1264\t        // Mirror cc_get_sequence_number multipath logic (same as start_round).\n1265\t        self.recovery_packet_number = if connection.is_multipath_enabled {\n1266\t            path_x.pkt_ctx.send_sequence\n1267\t        } else {\n1268\t            connection.pkt_ctx[PacketContext::Application as usize].send_sequence\n1269\t        };\n1270\t        self.packet_conservation = true;\n