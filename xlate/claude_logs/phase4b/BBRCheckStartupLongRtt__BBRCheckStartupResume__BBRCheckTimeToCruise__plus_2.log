{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01S9w38yCEwrN5Dae5EmwgGj","type":"tool_result","content":"840\tstatic void BBROnSpuriousLoss(picoquic_bbr_state_t* bbr_state, picoquic_path_t* path_x, uint64_t lost_packet_number, uint64_t current_time)\n841\t{\n842\t    if (bbr_state->recovery_packet_number <= lost_packet_number && bbr_state->is_pto_recovery) {\n843\t        BBROnExitRecovery(bbr_state, path_x, current_time);\n844\t    }\n845\t}\n846\t\n847\tstatic int InLossRecovery(picoquic_bbr_state_t* bbr_state)\n848\t{\n849\t    return (bbr_state->is_in_recovery);\n850\t}\n851\t\n852\tstatic void BBRCheckRecovery(picoquic_bbr_state_t* bbr_state, picoquic_path_t* path_x, bbr_per_ack_state_t* rs, uint64_t current_time)\n853\t{\n854\t    if (InLossRecovery(bbr_state)) {\n855\t        /* Exit loss recovery if full roundtrip expired */\n856\t        if (picoquic_cc_get_ack_number(path_x->cnx, path_x) >= bbr_state->recovery_packet_number) {\n857\t            BBROnExitRecovery(bbr_state, path_x, current_time);\n858\t        }\n859\t    }\n860\t    else {\n861\t        /* Enter loss recovery if new losses */\n862\t        if (IsInflightTooHigh(bbr_state, path_x, rs)) {\n863\t            BBROnEnterFastRecovery(bbr_state, path_x, rs);\n864\t        }\n865\t    }\n866\t}\n867\t\n868\t/* Computing the congestion window */\n869\tstatic uint64_t BBRBDPMultipleWithBw(picoquic_bbr_state_t* bbr_state, picoquic_path_t* path_x, double gain, uint64_t bw)\n870\t{\n871\t    if (bbr_state->min_rtt == UINT64_MAX) {\n872\t        return PICOQUIC_CWIN_INITIAL*path_x->send_mtu; /* no valid RTT samples yet */\n873\t    }\n874\t    bbr_state->bdp = PICOQUIC_BYTES_FROM_RATE(bbr_state->min_rtt, bw);\n875\t    return (uint64_t)(gain * (double)bbr_state->bdp);\n876\t}\n877\t\n878\tstatic uint64_t BBRBDPMultiple(picoquic_bbr_state_t* bbr_state, picoquic_path_t* path_x, double gain)\n879\t{"}]},"parent_tool_use_id":null,"session_id":"9f812e07-a4f7-4714-a4da-eb4436fecbda","