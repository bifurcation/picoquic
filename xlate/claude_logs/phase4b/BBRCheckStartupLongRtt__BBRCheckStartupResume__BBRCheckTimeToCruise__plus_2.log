{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01QBS4hHVUqdoNP2FbYgwV4c","type":"tool_result","content":"1000\t    ///\n1001\t    /// Cap `path_x.cwin` to the model's inflight limits.  In any ProbeBW\n1002\t    /// state other than Cruise, `inflight_hi` (when non-zero) is the ceiling.\n1003\t    /// In ProbeRtt or ProbeBwCruise the ceiling is the headroom-adjusted\n1004\t    /// `inflight_hi`.  `inflight_lo` is then applied as a secondary cap,\n1005\t    /// and finally `BBRMinPipeCwnd * MTU` is enforced as a floor.\n1006\t    pub fn bound_cwnd_for_model(&mut self, path_x: &mut Path) {\n1007\t        const BBR_MIN_PIPE_CWND: u64 = 4;\n1008\t        let mut cap = u64::MAX;\n1009\t        if self.is_in_a_probe_bw_state() && self.state != BbrAlgState::ProbeBwCruise {\n1010\t            if self.inflight_hi > 0 {\n1011\t                cap = self.inflight_hi;\n1012\t            }\n1013\t        } else if self.state == BbrAlgState::ProbeRtt || self.state == BbrAlgState::ProbeBwCruise {\n1014\t            cap = self.inflight_with_headroom(path_x);\n1015\t        }\n1016\t        if cap > self.inflight_lo {\n1017\t            cap = self.inflight_lo;\n1018\t        }\n1019\t        let floor = BBR_MIN_PIPE_CWND * path_x.send_mtu as u64;\n1020\t        if cap < floor {\n1021\t            cap = floor;\n1022\t        }\n1023\t        if path_x.cwin > cap {\n1024\t            path_x.cwin = cap;\n1025\t        }\n1026\t    }\n1027\t\n1028\t    /// C: `BBRAdvanceEcnFrac` (picoquic/bbr.c:2288)\n1029\t    ///\n1030\t    /// At the start of each new round, update `ecn_alpha` from the current\n1031\t    /// ECN fraction and latch the new ECN counters.  If the remote counters\n1032\t    /// have gone backwards (counter reset or path change) we reset alpha to\n1033\t    /// zero to avoid using stale ECN feedback.  No-op outside round starts or\n1034\t    /// when no valid ECN packet-context is available for this path.\n1035\t    pub fn advance_ecn_frac(\n1036\t        &mut self,\n1037\t        connection: &Connection,\n1038\t        path_x: &Path,\n1039\t        rs: &BbrPerAckState,\n1040\t    ) {\n1041\t        if !self.round_start {\n1042\t            return;\n1043\t        }\n1044\t        if let Some(pkt_ctx) = access_ecn_packet_context(connection, path_x) {\n1045\t            if pkt_ctx.ecn_ect1_total_remote < self.ecn_ect1_last_round\n1046\t                || pkt_ctx.ecn_ce_total_remote < self.ecn_ce_last_round\n1047\t            {\n1048\t                self.ecn_alpha = 0.0;\n1049\t            } else {\n1050\t                self.ecn_alpha = (rs.ecn_frac + 15.0 * self.ecn_alpha) / 16.0;\n1051\t            }\n1052\t            self.ecn_ect1_last_round = pkt_ctx.ecn_ect1_total_remote;\n1053\t            self.ecn_ce_last_round = pkt_ctx.ecn_ce_total_remote;\n1054\t        }\n1055\t    }\n1056\t\n1057\t    /// C: `BBRCheckPathSaturated` (picoquic/bbr.c:1699, `#ifdef RTTJitterBufferProbe`)\n1058\t    ///\n1059\t    /// Detect a saturated path during a bandwidth probe: if we are in a ProbeBW\n1060\t    /// state and the RTT has more than doubled relative to `min_rtt`, the\n1061\t    /// delivery rate is well below the pacing rate, and there is no WiFi shadow\n1062\t    /// RTT, then the path is congested.  In that case reset the bandwidth filter\n1063\t    /// to the current delivery rate, enter Drain, and start a new round.\n1064\t    /// Returns `true` when saturation was detected (caller should abort the probe).\n1065\t    pub fn check_path_saturated(\n1066\t        &mut self,\n1067\t        connection: &Connection,\n1068\t        path_x: &mut Path,\n1069\t        rs: &BbrPerAckState,\n1070\t    ) -> bool {\n1071\t        if self.is_in_a_probe_bw_state()\n1072\t            && rs.rtt_sample > 2 * self.min_rtt\n1073\t            && self.rounds_since_bw_probe >= 1\n1074\t            && self.pacing_rate > 3.0 * rs.delivery_rate as f64\n1075\t            && self.wifi_shadow_rtt == 0\n1076\t        {\n1077\t            self.prior_cwnd = rs.delivered;\n1078\t            self.probe_rtt_done_stamp = 0;\n1079\t            self.ack_phase = BbrAckPhase::ProbeStopping;\n1080\t            self.max_bw_filter[0] = rs.delivery_rate;\n1081\t            self.max_bw_filter[1] = rs.delivery_rate;\n1082\t            self.max_bw = rs.delivery_rate;\n1083\t            self.full_bw = rs.delivery_rate;\n1084\t            self.enter_drain(path_x);\n1085\t            self.start_round(connection, path_x);\n1086\t            true\n1087\t        } else {\n1088\t            false\n1089\t        }\n1090\t    }\n1091\t\n1092\t    /// React to inflight being too high: record the new inflight ceiling and,\n1093\t    /// if currently in ProbeBW-UP, transition to DOWN.\n1094\t    /// C: `BBRHandleInflightTooHigh` (picoquic/bbr.c:1174).\n1095\t    fn handle_inflight_too_high(\n1096\t        &mut self,\n1097\t        connection: &Connection,\n1098\t        path_x: &mut Path,\n1099\t        rs: &BbrPerAckState,\n1100\t        current_time: u64,\n1101\t    ) {\n1102\t        self.bw_probe_samples = 0; // only react once per bw probe\n1103\t        if !rs.is_app_limited {\n1104\t            let beta_target = (self.target_inflight(path_x) as f64 * BBR_BETA) as u64;\n1105\t            self.inflight_hi = rs.tx_in_flight.max(beta_target);\n1106\t        }\n1107\t        if self.state == BbrAlgState::ProbeBwUp {\n1108\t            self.start_probe_bw_down(connection, path_x, current_time);\n1109\t        }\n1110\t    }\n1111\t\n1112\t    /// Test whether inflight is too high and respond; returns `true` when\n1113\t    /// the inflight ceiling was triggered.\n1114\t    /// C: `CheckInflightTooHigh` (picoquic/bbr.c:1188).\n1115\t    fn check_inflight_too_high(\n1116\t        &mut self,\n1117\t        connection: &Connection,\n1118\t        path_x: &mut Path,\n1119\t        rs: &BbrPerAckState,\n1120\t        current_time: u64,\n1121\t    ) -> bool {\n1122\t        if self.is_inflight_too_high(path_x, rs) {\n1123\t            if self.bw_probe_samples != 0 {\n1124\t                self.handle_inflight_too_high(connection, path_x, rs, current_time);\n1125\t            }\n1126\t            true\n1127\t        } else {\n1128\t            false\n1129\t        }\n1130\t    }\n1131\t\n1132\t    /// Increase `inflight_hi` when the congestion window is cwnd-limited and\n1133\t    /// we are in ProbeBW-UP.  Called when loss rate is safe.\n1134\t    /// C: `BBRProbeInflightHiUpward` (picoquic/bbr.c:1571).\n1135\t    pub(crate) fn probe_inflight_hi_upward(&mut self, path_x: &Path, rs: &BbrPerAckState) {\n1136\t        if !rs.is_cwnd_limited || path_x.cwin < self.inflight_hi {\n1137\t            return; // not fully using inflight_hi, so don't grow it\n1138\t        }\n1139\t        self.bw_probe_up_acks += rs.newly_acked;\n1140\t        if self.bw_probe_up_acks >= self.bw_probe_up_cnt as u64 * path_x.send_mtu as u64 {\n1141\t            let delta = self.bw_probe_up_acks / self.bw_probe_up_cnt as u64;\n1142\t            self.bw_probe_up_acks -= delta * self.bw_probe_up_cnt as u64;\n1143\t            self.inflight_hi += delta;\n1144\t        }\n1145\t        if self.round_start {\n1146\t            self.raise_inflight_hi_slope(path_x);\n1147\t        }\n1148\t    }\n1149\t"}]},"parent_tool_use_id":null,"session_id":"9f812e07-a4f7-4714-a4da-eb4436fecbda","uuid":"37081497-d109-42f1-b2b4-ee1bd2a526eb","timestamp":"2026-05-07T10:32:21.601Z","tool_use_result":{"type":"text","file":{"filePath":"/Users/richbarn/Projects/picoquic/rs/fq/src/bbr.rs","content":"    ///\n    /// Cap `path_x.cwin` to the model's inflight limits.  In any ProbeBW\n    /// state other than Cruise, `inflight_hi` (when non-zero) is the ceiling.\n    /// In ProbeRtt or ProbeBwCruise the ceiling is the headroom-adjusted\n    /// `inflight_hi`.  `inflight_lo` is then applied as a secondary cap,\n    /// and finally `BBRMinPipeCwnd * MTU` is enforced as a floor.\n    pub fn bound_cwnd_for_model(&mut self, path_x: &mut Path) {\n        const BBR_MIN_PIPE_CWND: u64 = 4;\n        let mut cap = u64::MAX;\n        if self.is_in_a_probe_bw_state() && self.state != BbrAlgState::ProbeBwCruise {\n            if self.inflight_hi > 0 {\n                cap = self.inflight_hi;\n            }\n        } else if self.state == BbrAlgState::ProbeRtt || self.state == BbrAlgState::ProbeBwCruise {\n            cap = self.inflight_with_headroom(path_x);\n        }\n        if cap > self.inflight_lo {\n            cap = self.inflight_lo;\n        }\n        let floor = BBR_MIN_PIPE_CWND * path_x.send_mtu as u64;\n        if cap < floor {\n            cap = floor;\n        }\n        if path_x.cwin > cap {\n            path_x.cwin = cap;\n        }\n    }\n\n    /// C: `BBRAdvanceEcnFrac` (picoquic/bbr.c:2288)\n    ///\n    /// At the start of each new round, update `ecn_alpha` from the current\n    /// ECN fraction and latch the new ECN counters.  If the remote counters\n    /// have gone backwards (counter reset or path change) we reset alpha to\n    /// zero to avoid using stale ECN feedback.  No-op outside round starts or\n    /// when no valid ECN packet-context is available for this path.\n    pub fn advance_ecn_frac(\n        &mut self,\n        connection: &Connection,\n        path_x: &Path,\n        rs: &BbrPerAckState,\n    ) {\n        if !self.round_start {\n            return;\n        }\n        if let Some(pkt_ctx) = access_ecn_packet_context(connection, path_x) {\n            if pkt_ctx.ecn_ect1_total_remote < self.ecn_ect1_last_round\n                || pkt_ctx.ecn_ce_total_remote < self.ecn_ce_last_round\n            {\n                self.ecn_alpha = 0.0;\n            } else {\n                self.ecn_alpha = (rs.ecn_frac + 15.0 * self.ecn_alpha) / 16.0;\n            }\n            self.ecn_ect1_last_round = pkt_ctx.ecn_ect1_total_remote;\n            self.ecn_ce_last_round = pkt_ctx.ecn_ce_total_remote;\n        }\n    }\n\n    /// C: `BBRCheckPathSaturated` (picoquic/bbr.c:1699, `#ifdef RTTJitterBufferProbe`)\n    ///\n    /// Detect a saturated path during a bandwidth probe: if we are in a ProbeBW\n    /// state and the RTT has more than doubled relative to `min_rtt`, the\n    /// delivery rate is well below the pacing rate, and there is no WiFi shadow\n    /// RTT, then the path is congested.  In that case reset the bandwidth filter\n    /// to the current delivery rate, enter Drain, and start a new round.\n    /// Returns `true` when saturation was detected (caller should abort the probe).\n    pub fn check_path_saturated(\n        &mut self,\n        connection: &Connection,\n        path_x: &mut Path,\n        rs: &BbrPerAckState,\n    ) -> bool {\n        if self.is_in_a_probe_bw_state()\n            && rs.rtt_sample > 2 * self.min_rtt\n            && self.rounds_since_bw_probe >= 1\n            && self.pacing_rate > 3.0 * rs.delivery_rate as f64\n            && self.wifi_shadow_rtt == 0\n        {\n            self.prior_cwnd = rs.delivered;\n            self.probe_rtt_done_stamp = 0;\n            self.ack_phase = BbrAckPhase::ProbeStopping;\n            self.max_bw_filter[0] = rs.delivery_rate;\n            self.max_bw_filter[1] = rs.delivery_rate;\n            self.max_bw = rs.delivery_rate;\n            self.full_bw = rs.delivery_rate;\n            self.enter_drain(path_x);\n            self.start_round(connection, path_x);\n            true\n        } else {\n            false\n        }\n    }\n\n    /// React to inflight being too high: record the new inflight ceiling and,\n    /// if currently in ProbeBW-UP, transition to DOWN.\n    /// C: `BBRHandleInflightTooHigh` (picoquic/bbr.c:1174).\n    fn handle_inflight_too_high(\n        &mut self,\n        connection: &Connection,\n        path_x: &mut Path,\n        rs: &BbrPerAckState,\n        current_time: u64,\n    ) {\n        self.bw_probe_samples = 0; // only react once per bw probe\n        if !rs.is_app_limited {\n            let beta_target = (self.target_inflight(path_x) as f64 * BBR_BETA) as u64;\n            self.inflight_hi = rs.tx_in_flight.max(beta_target);\n        }\n        if self.state == BbrAlgState::ProbeBwUp {\n            self.start_probe_bw_down(connection, path_x, current_time);\n        }\n    }\n\n    /// Test whether inflight is too high and respond; returns `true` when\n    /// the inflight ceiling was triggered.\n    /// C: `CheckInflightTooHigh` (picoquic/bbr.c:1188).\n    fn check_inflight_too_high(\n        &mut self,\n        connection: &Connection,\n        path_x: &mut Path,\n        rs: &BbrPerAckState,\n        current_time: u64,\n    ) -> bool {\n        if self.is_inflight_too_high(path_x, rs) {\n            if self.bw_probe_samples != 0 {\n                self.handle_inflight_too_high(connection, path_x, rs, current_time);\n            }\n            true\n        } else {\n            false\n        }\n    }\n\n    /// Increase `inflight_hi` when the congestion window is cwnd-limited and\n    /// we are in ProbeBW-UP.  Called when loss rate is safe.\n    /// C: `BBRProbeInflightHiUpward` (picoquic/bbr.c:1571).\n    pub(crate) fn probe_inflight_hi_upward(&mut self, path_x: &Path, rs: &BbrPerAckState) {\n        if !rs.is_cwnd_limited || path_x.cwin < self.inflight_hi {\n            return; // not fully using inflight_hi, so don't grow it\n        }\n        self.bw_probe_up_acks += rs.newly_acked;\n        if self.bw_probe_up_acks >= self.bw_probe_up_cnt as u64 * path_x.send_mtu as u64 {\n            let delta = self.bw_probe_up_acks / self.bw_probe_up_cnt as u64;\n            self.bw_probe_up_acks -= delta * self.bw_probe_up_cnt as u64;\n            self.inflight_hi += delta;\n        }\n        if self.round_start {\n            self.raise_inflight_hi_slope(path_x);\n        }\n    }\n","numLines":150,"startLine":1000,"totalLines":2027}}}
