{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01ThTYT7o17uVymYZnQByyst","type":"tool_result","content":"300\t    }\n301\t\n302\t    /// C: `BBRCheckStartupFullBandwidthGeneric` (picoquic/bbr.c:1952)\n303\t    pub fn check_startup_full_bandwidth_generic(&mut self, rs: &BbrPerAckState, threshold: f64) {\n304\t        if self.filled_pipe || !self.round_start || rs.is_app_limited {\n305\t            return;\n306\t        }\n307\t        if self.max_bw as f64 >= threshold * self.full_bw as f64 {\n308\t            // still growing\n309\t            self.full_bw = self.max_bw;\n310\t            self.full_bw_count = 0;\n311\t            return;\n312\t        }\n313\t        self.full_bw_count += 1; // another round without much growth\n314\t        if self.full_bw_count >= 3 {\n315\t            self.filled_pipe = true;\n316\t        }\n317\t    }\n318\t\n319\t    /// C: `BBRCheckStartupFullBandwidth` (picoquic/bbr.c:2020)\n320\t    pub fn check_startup_full_bandwidth(&mut self, rs: &BbrPerAckState) {\n321\t        if self.filled_pipe || !self.round_start || rs.is_app_limited {\n322\t            return;\n323\t        }\n324\t        // 5/4 integer approximation of ×1.25 avoids floating-point drift.\n325\t        if 4 * self.max_bw >= 5 * self.full_bw {\n326\t            // still growing\n327\t            self.full_bw = self.max_bw;\n328\t            self.full_bw_count = 0;\n329\t            if rs.ecn_frac < 0.2 {\n330\t                return;\n331\t            }\n332\t        }\n333\t        self.full_bw_count += 1; // another round without much growth\n334\t        if self.full_bw_count >= 3 || rs.ecn_frac >= BBR_EXCESSIVE_ECN_CE {\n335\t            self.filled_pipe = true;\n336\t        }\n337\t    }\n338\t\n339\t    /// C: `BBRCheckAppLimitedEnded` (picoquic/bbr.c:1747)\n340\t    ///\n341\t    /// Tracks per-round app-limited state.  Returns `true` on the first\n342\t    /// round where the app is *not* limited after having been limited for\n343\t    /// more than `BBR_APP_LIMITED_ROUNDS_THRESHOLD` consecutive rounds.\n344\t    pub fn check_app_limited_ended(&mut self, rs: &BbrPerAckState) -> bool {\n345\t        let mut app_limited_ended = false;\n346\t        if self.round_start {\n347\t            if self.app_limited_this_round != 0 {\n348\t                self.app_limited_round_count += 1;\n349\t            } else {\n350\t                app_limited_ended = self.app_limited_round_count > BBR_APP_LIMITED_ROUNDS_THRESHOLD;\n351\t                self.app_limited_round_count = 0;\n352\t            }\n353\t            self.app_limited_this_round = 0;\n354\t        } else {\n355\t            self.app_limited_this_round |= rs.is_app_limited as i32;\n356\t        }\n357\t        app_limited_ended\n358\t    }\n359\t\n360\t    /// C: `BBRExitLostFeedback` (picoquic/bbr.c:782)\n361\t    ///\n362\t    /// Restore the congestion window saved by `BBREnterLostFeedback` and\n363\t    /// clear the lost-feedback flag.  No-op if the flag is not set.\n364\t    pub fn exit_lost_feedback(&mut self, path_x: &mut Path) {\n365\t        if self.is_handling_lost_feedback {\n366\t            path_x.cwin = self.cwin_before_lost_feedback;\n367\t            self.is_handling_lost_feedback = false;\n368\t        }\n369\t    }\n370\t\n371\t    /// C: `BBRHasElapsedInPhase` (picoquic/bbr.c:1776)\n372\t    ///\n373\t    /// Returns `true` when `current_time` has advanced past\n374\t    /// `cycle_stamp + interval`.  Used to decide when to transition from\n375\t    /// DOWN/CRUISE to REFILL in the probe-BW cycle.\n376\t    pub(crate) fn has_elapsed_in_phase(&self, interval: u64, current_time: u64) -> bool {\n377\t        current_time > self.cycle_stamp + interval\n378\t    }\n379\t\n380\t    /// C: `BBREnterStartupResume` (picoquic/bbr.c:1972)\n381\t    ///\n382\t    /// Enter `StartupResume` state, which uses Hystart-like pacing gains\n383\t    /// to resume quickly after a suspension.  Called either when a BDP\n384\t    /// seed is set or on the initial `EnterStartup` path when a seed\n385\t    /// exists.\n386\t    pub(crate) fn enter_startup_resume(&mut self) {\n387\t        self.state = BbrAlgState::StartupResume;\n388\t        self.pacing_gain = BBR_STARTUP_RESUME_PACING_GAIN;\n389\t        self.cwnd_gain = BBR_STARTUP_RESUME_CWND_GAIN;\n390\t    }\n391\t\n392\t    /// C: `BBREnterStartup` (picoquic/bbr.c:2061)\n393\t    ///\n394\t    /// Enter normal `Startup` state with the standard pacing and cwnd\n395\t    /// gains.  Sets `is_cca_probing_up` to inform the transport that the\n396\t    /// congestion controller is actively probing for more bandwidth.\n397\t    pub fn enter_startup(&mut self, path_x: &mut Path) {\n398\t        self.state = BbrAlgState::Startup;\n399\t        self.pacing_gain = BBR_STARTUP_PACING_GAIN;\n400\t        self.cwnd_gain = BBR_STARTUP_CWND_GAIN;\n401\t        path_x.is_cca_probing_up = true;\n402\t    }\n403\t\n404\t    /// C: `BBREnterStartupLongRTT` (picoquic/bbr.c:2080)\n405\t    ///\n406\t    /// Enter `StartupLongRTT` state, which uses Hystart rather than the\n407\t    /// normal BBR Startup algorithm.  The initial congestion window is\n408\t    /// scaled up from `CWIN_INITIAL` proportional to `rtt_min` (capped at\n409\t    /// the satellite-RTT ceiling) and then further boosted by the BDP seed\n410\t    /// when available.\n411\t    pub fn enter_startup_long_rtt(&mut self, path_x: &mut Path) {\n412\t        let mut cwnd = CWIN_INITIAL;\n413\t        self.state = BbrAlgState::StartupLongRtt;\n414\t        if path_x.rtt_min > TARGET_RENO_RTT {\n415\t            let rtt_cap = if path_x.rtt_min > TARGET_SATELLITE_RTT {\n416\t                TARGET_SATELLITE_RTT\n417\t            } else {\n418\t                path_x.rtt_min\n419\t            };\n420\t            cwnd = (cwnd as f64 * rtt_cap.ticks() as f64 / TARGET_RENO_RTT.ticks() as f64) as u64;\n421\t        }\n422\t        if cwnd < self.bdp_seed {\n423\t            cwnd = self.bdp_seed;\n424\t        }\n425