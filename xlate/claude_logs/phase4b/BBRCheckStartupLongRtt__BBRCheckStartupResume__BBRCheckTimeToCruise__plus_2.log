\t}\n2001\t\n2002\t/* Startup specific processes for BBRv3 */\n2003\tstatic void BBRCheckStartupHighLoss(picoquic_bbr_state_t* bbr_state, picoquic_path_t * path_x, bbr_per_ack_state_t * rs)\n2004\t{\n2005\t    /* TODO: no sample code provided */\n2006\t    /*\n2007\t    * A second method BBR uses for estimating the bottleneck is full is by looking at sustained packet losses.\n2008\t    Specifically for a case where the following criteria are all met:\n2009\t    The connection has been in fast recovery for at least one full round trip.\n2010\t    The loss rate over the time scale of a single full round trip exceeds BBRLossThresh (2%).\n2011\t    There are at least BBRStartupFullLossCnt=3 discontiguous sequence ranges lost in that round trip.\n2012\t\n2013\t    If these criteria are all met, then BBRCheckStartupHighLoss() sets BBR.filled_pipe = true, which will cause exit Startup and enters Drain\n2014\t    */\n2015\t    if (IsInflightTooHigh(bbr_state, path_x, rs)) {\n2016\t        bbr_state->filled_pipe = 1;\n2017\t    }\n2018\t}\n2019\t\n2020\tstatic void BBRCheckStartupFullBandwidth(picoquic_bbr_state_t* bbr_state,\n2021\t    bbr_per_ack_state_t * rs)\n2022\t{\n2023\t    if (bbr_state->filled_pipe ||\n2024\t        !bbr_state->round_start || rs->is_app_limited) {\n2025\t        return;  /* no need to check for a full pipe now */\n2026\t    }\n2027\t    /* Using here 5/4 test instead of double 1.25 */\n2028\t    if (4*bbr_state->max_bw >= 5*bbr_state->full_bw) {\n2029\t        /* still growing? */\n2030\t        bbr_state->full_bw = bbr_state->max_bw;    /* record new baseline level */\n2031\t        bbr_state->full_bw_count = 0;\n2032\t        if (rs->ecn_frac < 0.2) {\n2033\t            return;\n2034\t        }\n2035\t    }\n2036\t    bbr_state->full_bw_count++; /* another round w/o much growth */\n2037\t    if (bbr_state->full_bw_count >= 3 || rs->ecn_frac >= BBRExcessiveEcnCE) {\n2038\t        bbr_state->filled_pipe = 1;\n2039\t    }\n2040\t}\n2041\t\n2042\tstatic void BBRCheckStartupDone(picoquic_bbr_state_t* bbr_state,\n2043\t    picoquic_path_t * path_x, bbr_per_ack_state_t * rs)\n2044\t{\n2045\t    if (bbr_state->state == picoquic_bbr_alg_startup) {\n2046\t        BBRCheckStartupFullBandwidth(bbr_state, rs);\n2047\t        BBRCheckStartupHighLoss(bbr_state, path_x, rs);\n2048\t#ifdef RTTJitterBufferStartup\n2049\t        if (bbr_state->min_rtt > PICOQUIC_MINRTT_THRESHOLD && IsRTTTooHigh(bbr_state)) {\n2050\t            bbr_state->filled_pipe = 1;\n2051\t        }\n2052\t#endif\n2053\t        if (bbr_state->filled_pipe) {\n2054\t            bbr_state->probe_probe_bw_quickly = 1;\n2055\t            bbr_state->full_bw_count = 0;\n2056\t            BBREnterDrain(bbr_state, path_x);\n2057\t        }\n2058\t    }\n2059\t}"}]},"parent_tool_use_id":null,"session_id":"9f812e07-a4f7-4714-a4da-eb4436fecbda","uuid":"4e1cf44b-8611-47c3-9699-16908bff3445","timestamp":"2026-05-07T10:32:04.052Z","tool_use_result":{"type":"text","file":{"filePath":"/Users/richbarn/Projects/picoquic/picoquic/bbr.c","content":"    if ((double)bbr_state->max_bw >= threshold*((double)bbr_state->full_bw)) {\n        /* still growing? */\n        bbr_state->full_bw = bbr_state->max_bw;    /* record new baseline level */\n        bbr_state->full_bw_count = 0;\n        return;\n    }\n    bbr_state->full_bw_count++; /* another round w/o much growth */\n    if (bbr_state->full_bw_count >= 3) {\n        bbr_state->filled_pipe = 1;\n    }\n}\n\nstatic void BBREnterStartupResume(picoquic_bbr_state_t* bbr_state)\n{\n    /* This code is called either when the \"bdp seed\" is set, or\n     * upon \"Enter Startup\"\n     */\n    bbr_state->state = picoquic_bbr_alg_startup_resume;\n    bbr_state->pacing_gain = BBRStartupResumePacingGain;\n    bbr_state->cwnd_gain = BBRStartupResumeCwndGain;\n}\n\nstatic void BBRCheckStartupResume(picoquic_bbr_state_t* bbr_state, picoquic_path_t* path_x, bbr_per_ack_state_t* rs)\n{\n    if (bbr_state->state == picoquic_bbr_alg_startup_