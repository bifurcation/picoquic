{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01KZs8PActa4iNFTG2WkTwuK","type":"tool_result","content":"193\t    /// C: `picoquic_cc_hystart_test`.  `is_one_way_delay_enabled`\n194\t    /// was an `int` in C; promoted to `bool`.\n195\t    pub fn hystart_test(\n196\t        &mut self,\n197\t        rtt_measurement: Duration,\n198\t        packet_time: Instant,\n199\t        current_time: Instant,\n200\t        is_one_way_delay_enabled: bool,\n201\t    ) -> bool {\n202\t        if is_one_way_delay_enabled && rtt_measurement == Duration::from_ticks(0) {\n203\t            return false;\n204\t        }\n205\t\n206\t        let threshold = match self.last_rtt_sample_time {\n207\t            None => true,\n208\t            Some(t) => current_time > t + Duration::from_ticks(1000),\n209\t        };\n210\t\n211\t        if !threshold {\n212\t            return false;\n213\t        }\n214\t\n215\t        self.filter_rtt_min_max(rtt_measurement);\n216\t        self.last_rtt_sample_time = Some(current_time);\n217\t\n218\t        if !self.is_init {\n219\t            return false;\n220\t        }\n221\t\n222\t        let mut ret = false;\n223\t        if self.rtt_filtered_min == Duration::from_ticks(0)\n224\t            || self.rtt_filtered_min > self.sample_max\n225\t        {\n226\t            self.rtt_filtered_min = self.sample_max;\n227\t        }\n228\t\n229\t        let delta_max = {\n230\t            let q = self.rtt_filtered_min / 4;\n231\t            // packet_time is an Instant; treat it as a Duration value\n232\t            // for the comparison (both are ticks-based u64 wrappers)\n233\t            let pt = Duration::from_ticks(packet_time.ticks());\n234\t            if q < pt { pt } else { q }\n235\t        };\n236\t\n237\t        if self.sample_min > self.rtt_filtered_min {\n238\t            if self.sample_min > self.rtt_filtered_min + delta_max {\n239\t                self.nb_rtt_excess += 1;\n240\t                if self.nb_rtt_excess >= MIN_MAX_RTT_SCOPE as u32 {\n241\t                    ret = true;\n242\t                }\n243\t            }\n244\t        } else {\n245\t            self.nb_rtt_excess = 0;\n246\t        }\n247\t\n248\t        ret\n249\t    }\n250\t}\n251\t\n252\t// ---------------------------------------------------------------------------"}]},"parent_tool_use_id":null,"session_id":"9f812e07-a4f7-4714-a4da-eb4436fecbda","uuid":"8b1a929f-fc98-4016-a653-ee74c3d1744e","timestamp":"2026-05-07T10:33:47.841Z","tool_use_result":{"type":"text","file":{"filePath":"/Users/richbarn/Projects/picoquic/rs/fq/src/cc_common.rs","content":"    /// C: `picoquic_cc_hystart_test`.  `is_one_way_delay_enabled`\n    /// was an `int` in C; promoted to `bool`.\n    pub fn hystart_test(\n        &mut self,\n        rtt_measurement: Duration,\n        packet_time: Instant,\n        current_time: Instant,\n        is_one_way_delay_enabled: bool,\n    ) -> bool {\n        if is_one_way_delay_enabled && rtt_measurement == Duration::from_ticks(0) {\n            return false;\n        }\n\n        let threshold = match self.last_rtt_sample_time {\n            None => true,\n            Some(t) => current_time > t + Duration::from_ticks(1000),\n        };\n\n        if !threshold {\n            return false;\n        }\n\n        self.filter_rtt_min_max(rtt_measurement);\n        self.last_rtt_sample_time = Some(current_time);\n\n        if !self.is_init {\n            return false;\n        }\n\n        let mut ret = false;\n        if self.rtt_filtered_min == Duration::from_ticks(0)\n            || self.rtt_filtered_min > self.sample_max\n        {\n            self.rtt_filtered_min = self.sample_max;\n        }\n\n        let delta_max = {\n            let q = self.rtt_filtered_min / 4;\n            // packet_time is an Instant; treat it as a Duration value\n            // for the comparison (both are ticks-based u64 wrappers)\n            let pt = Duration::from_ticks(packet_time.ticks());\n            if q < pt { pt } else { q }\n        };\n\n        if self.sample_min > self.rtt_filtered_min {\n            if self.sample_min > self.rtt_filtered_min + delta_max {\n                self.nb_rtt_excess += 1;\n                if self.nb_rtt_excess >= MIN_MAX_RTT_SCOPE as u32 {\n                    ret = true;\n                }\n            }\n        } else {\n            self.nb_rtt_excess = 0;\n        }\n\n        ret\n    }\n}\n\n// ---------------------------------------------------------------------------","numLines":60,"startLine":193,"totalLines":569}}}
