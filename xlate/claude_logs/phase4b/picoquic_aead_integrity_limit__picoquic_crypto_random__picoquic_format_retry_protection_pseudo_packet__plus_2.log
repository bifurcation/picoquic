{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01SPsxKPnGSoYxQgFDcbG4v5","type":"tool_result","content":"1540\t\n1541\t/// Construct a streaming hash context for the named algorithm\n1542\t/// (e.g. `\"sha256\"`).  Returns a `digest::DynDigest` trait\n1543\t/// object so callers feed bytes via `update` and read out via\n1544\t/// `finalize` (the canonical Rust Crypto shape).\n1545\t///\n1546\t/// Backends supply concrete digest types (e.g. `sha2::Sha256`)\n1547\t/// and lift them through this entry point.\n1548\tpub fn hash_create(algorithm_name: &str) -> Option<Box<dyn digest::DynDigest>> {\n1549\t    use digest::Digest;\n1550\t\n1551\t    match algorithm_name {\n1552\t        \"sha256\" | \"SHA256\" | \"SHA-256\" => Some(Box::new(sha2::Sha256::new())),\n1553\t        \"sha384\" | \"SHA384\" | \"SHA-384\" => Some(Box::new(sha2::Sha384::new())),\n1554\t        \"sha512\" | \"SHA512\" | \"SHA-512\" => Some(Box::new(sha2::Sha512::new())),\n1555\t        _ => None,\n1556\t    }\n1557\t}\n1558\t\n1559\t/// Digest length (bytes) of the named hash algorithm, or 0 when\n1560\t/// the algorithm is unknown.  C: `hash_get_length`.\n1561\tpub fn hash_get_length(algorithm_name: &str) -> usize {\n1562\t    match algorithm_name {\n1563\t        \"sha256\" | \"SHA256\" | \"SHA-256\" => 32,\n1564\t        \"sha384\" | \"SHA384\" | \"SHA-384\" => 48,\n1565\t        \"sha512\" | \"SHA512\" | \"SHA-512\" => 64,\n1566\t        _ => 0,\n1567\t    }\n1568\t}\n1569\t\n1570\t// `hash_update` and `hash_finalize` are gone -- callers use\n1571\t// `digest::DynDigest`'s `update` and `finalize_into` methods on\n1572\t// the boxed trait object returned by `hash_create`.\n1573\t\n1574\t// ---------------------------------------------------------------------------\n1575\t// Private-key / certificate file loaders.\n1576\t\n1577\timpl Quic {\n1578\t    /// Load a PEM-encoded private key from `file_name` and install\n1579\t    /// it in this context's master TLS context.  C:\n1580\t    /// `set_private_key_from_file`.\n1581\t    pub fn set_private_key_from_file(&mut self, file_name: &str) -> Result<(), Error> {\n1582\t        let contents = std::fs::read_to_string(file_name).map_err(|_| Error::NoSuchFile)?;\n1583\t        if contents.contains(\"-----BEGIN \") && contents.contains(\"PRIVATE KEY-----\") {\n1584\t            Ok(())\n1585\t        } else {\n1586\t            Err(Error::InvalidFile)\n1587\t        }\n1588\t    }\n1589\t}"}]},"parent_tool_use_id":null,"session_id":"c83abba6-1d49-4ee8-837e-74d6c23d507c","uuid":"0ab88472-b646-497c-b41e-63247c054ff3","timestamp":"2026-05-07T09:46:54.010Z","tool_use_result":{"type":"text","file":{"filePath":"/Users/richbarn/Projects/picoquic/rs/fq/src/tls_api.rs","content":"\n/// Construct a streaming hash context for the named algorithm\n/// (e.g. `\"sha256\"`).  Returns a `digest::DynDigest` trait\n/// object so callers feed bytes via `update` and read out via\n/// `finalize` (the canonical Rust Crypto shape).\n///\n/// Backends supply concrete digest types (e.g. `sha2::Sha256`)\n/// and lift them through this entry point.\npub fn hash_create(algorithm_name: &str) -> Option<Box<dyn digest::DynDigest>> {\n    use digest::Digest;\n\n    match algorithm_name {\n        \"sha256\" | \"SHA256\" | \"SHA-256\" => Some(Box::new(sha2::Sha256::new())),\n        \"sha384\" | \"SHA384\" | \"SHA-384\" => Some(Box::new(sha2::Sha384::new())),\n        \"sha512\" | \"SHA512\" | \"SHA-512\" => Some(Box::new(sha2::Sha512::new())),\n        _ => None,\n    }\n}\n\n/// Digest length (bytes) of the named hash algorithm, or 0 when\n/// the algorithm is unknown.  C: `hash_get_length`.\npub fn hash_get_length(algorithm_name: &str) -> usize {\n    match algorithm_name {\n        \"sha256\" | \"SHA256\" | \"SHA-256\" => 32,\n        \"sha384\" | \"SHA384\" | \"SHA-384\" => 48,\n        \"sha512\" | \"SHA512\" | \"SHA-512\" => 64,\n        _ => 0,\n    }\n}\n\n// `hash_update` and `hash_finalize` are gone -- callers use\n// `digest::DynDigest`'s `update` and `finalize_into` methods on\n// the boxed trait object returned by `hash_create`.\n\n// ---------------------------------------------------------------------------\n// Private-key / certificate file loaders.\n\nimpl Quic {\n    /// Load a PEM-encoded private key from `file_name` and install\n    /// it in this context's master TLS context.  C:\n    /// `set_private_key_from_file`.\n    pub fn set_private_key_from_file(&mut self, file_name: &str) -> Result<(), Error> {\n        let contents = std::fs::read_to_string(file_name).map_err(|_| Error::NoSuchFile)?;\n        if contents.contains(\"-----BEGIN \") && contents.contains(\"PRIVATE KEY-----\") {\n            Ok(())\n        } else {\n            Err(Error::InvalidFile)\n        }\n    }\n}","numLines":50,"startLine":1540,"totalLines":1891}}}
