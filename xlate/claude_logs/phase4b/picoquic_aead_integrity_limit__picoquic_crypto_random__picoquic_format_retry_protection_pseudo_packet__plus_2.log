{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_0138tpBHaqPhxBxFXXrYiK6q","type":"tool_result","content":"888\t// [`crate::tls::PacketKey`] trait — backends supply implementations,\n889\t// the rest of the crate is generic over them.  This module\n890\t// retains only the constant `QUIC_AEAD_TAG_LEN` (the fixed\n891\t// 16-byte tag QUIC mandates).\n892\t\n893\t/// Length of the QUIC AEAD authentication tag.  All TLS 1.3\n894\t/// cipher suites used by QUIC (RFC 9001 §5.3) produce a 16-byte\n895\t/// tag, so the value is fixed.  Replaces the C\n896\t/// `aead_get_checksum_length(void*)` accessor; once a\n897\t/// [`crate::tls::PacketKey`] exists, prefer `key.tag_len()`.\n898\tpub const QUIC_AEAD_TAG_LEN: usize = 16;\n899\t\n900\t/// Return the AEAD authentication tag length, capped at 16 bytes.\n901\t/// The C function read `algo->tag_size` from a `ptls_aead_context_t`\n902\t/// and clamped it to 16; in Rust the cap is preserved for parity even\n903\t/// though all QUIC cipher suites already produce exactly 16 bytes.\n904\t/// C: `picoquic_aead_get_checksum_length`\n905\tpub fn aead_get_checksum_length(aead_ctx: &dyn crate::tls::PacketKey) -> usize {\n906\t    aead_ctx.tag_len().min(16)\n907\t}\n908\t\n909\t/// Return the confidentiality limit for the AEAD algorithm: the\n910\t/// maximum number of packets that may be sent before a key update is\n911\t/// required (RFC 9001 §6.6).\n912\t/// C: `picoquic_aead_confidentiality_limit`\n913\tpub fn aead_confidentiality_limit(aead_ctx: &dyn crate::tls::PacketKey) -> u64 {\n914\t    aead_ctx.confidentiality_limit()\n915\t}\n916\t\n917\t/// Decrypt `input` and write the plaintext to `output`, verifying the\n918\t/// authentication tag.  Returns the number of plaintext bytes written.\n919\t/// The C function accepted a nullable `void* aead_ctx` and returned\n920\t/// `SIZE_MAX` when the pointer was null or decryption failed; here\n921\t/// a missing context is represented as `None` and both failure modes\n922\t/// become `Err(Error::Protocol(AeadCheck))`.\n923\t/// C: `picoquic_aead_decrypt_generic`\n924\tpub fn aead_decrypt_generic(\n925\t    output: &mut [u8],\n926\t    input: &[u8],\n927\t    seq_num: u64,\n928\t    auth_data: &[u8],\n929\t    aead_ctx: Option<&dyn crate::tls::PacketKey>,\n930\t) -> Result<usize, Error> {\n931\t    let aead_ctx = aead_ctx.ok_or(Error::Protocol(\n932\t        crate::errors::InternalError::AeadCheck as u64,\n933\t    ))?;\n934\t    let mut buf = input.to_vec();\n935\t    aead_ctx.decrypt(seq_num, auth_data, &mut buf)?;\n936\t    if buf.len() > output.len() {\n937\t        return Err(Error::BufferTooSmall);\n938\t    }\n939\t    output[..buf.len()].copy_from_slice(&buf);\n940\t    Ok(buf.len())\n941\t}\n942\t\n943\t/// Encrypt `input` and write ciphertext + authentication tag to\n944\t/// `output`.  Returns the total number of bytes written (plaintext\n945\t/// length + tag length).\n946\t/// C: `picoquic_aead_encrypt_generic`\n947\tpub fn aead_encrypt_generic(\n948\t    output: &mut [u8],\n949\t    input: &[u8],\n950\t    seq_num: u64,\n951\t    auth_data: &[u8],\n952\t    aead_ctx: &dyn crate::tls::PacketKey,\n953\t) -> usize {\n954\t    let mut buf = input.to_vec();\n955\t    aead_ctx.encrypt(seq_num, auth_data, &mut buf);\n956\t    let len = buf.len();\n957\t    let copy_len = len.min(output.len());\n958\t    output[..copy_len].copy_from_slice(&buf[..copy_len]);\n959\t    len\n960\t}\n961\t\n962\t// `aead_encrypt_mp` / `aead_decrypt_mp` fold into `PacketKey::encrypt_mp` /\n963\t// `decrypt_mp` which XOR the path id into the nonce inside the implementor.\n964\t// `aead_integrity_limit` delegates to `PacketKey::integrity_limit`.\n965\t// `aead_free` and `cipher_free` are gone -- `Drop` on the boxed trait object\n966\t// replaces them.\n967\t// `pn_iv_size` and `pn_encrypt` are gone -- header protection is in\n968\t// `crate::header_protection`, exposed through `crate::tls::HeaderKey`.\n969\t\n970\t// --------------------------