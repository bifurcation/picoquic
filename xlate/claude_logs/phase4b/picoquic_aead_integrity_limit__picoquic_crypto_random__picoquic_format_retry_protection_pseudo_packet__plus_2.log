{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01X1VTXnKzHU3RqppvHnS2TD","type":"tool_result","content":"440\t    int nb_suites = picoquic_set_cipher_suite_list(selected_suites, cipher_suite_id, use_low_memory);\n441\t    if (nb_suites <= 0) {\n442\t        cipher = NULL;\n443\t    }\n444\t    else {\n445\t        cipher = selected_suites[0];\n446\t    }\n447\t\n448\t    return cipher;\n449\t}\n450\t\n451\tstatic ptls_cipher_algorithm_t* picoquic_get_ecb_cipher_by_id(const char* ecb_cipher_name)\n452\t{\n453\t    ptls_cipher_algorithm_t* ecb_cipher = NULL;\n454\t\n455\t    for (int j = 0; j < 2 && ecb_cipher == NULL; j++) {\n456\t        for (int i = 0; i < PICOQUIC_CIPHER_SUITES_NB_MAX && ecb_cipher == NULL; i++) {\n457\t            ptls_cipher_suite_t* suite = (j == 0) ?\n458\t                picoquic_cipher_suites[i].high_memory_suite :\n459\t                picoquic_cipher_suites[i].low_memory_suite;\n460\t\n461\t            if (suite != NULL && suite->aead != NULL && suite->aead->ecb_cipher != NULL &&\n462\t                strcmp(suite->aead->ecb_cipher->name, ecb_cipher_name) == 0){\n463\t                ecb_cipher = suite->aead->ecb_cipher;\n464\t                break;\n465\t            }\n466\t        }\n467\t    }\n468\t    return ecb_cipher;\n469\t}\n470\t\n471\t/* Obtain an AES128 ECB cipher, which is required for CID encryption\n472\t* according to the CID for load balancer specification.\n473\t* TODO: rewrite this as a call to the generic \"get cipher suite\" API,\n474\t* then derive the ECB function from the selection of the AEAD function.\n475\t* This will obviate the need of providing a specific API.\n476\t*/\n477\t\n478\tvoid* picoquic_ecb_create_by_name(int is_enc, const void* ecb_key, char const* alg_name)\n479\t{\n480\t    void* created = NULL;\n481\t    ptls_cipher_algorithm_t* ecb_cipher = picoquic_get_ecb_cipher_by_id(alg_name);\n482\t\n483\t    if (ecb_cipher != NULL) {\n484\t        created = (void*)ptls_cipher_new(ecb_cipher, is_enc, ecb_key);\n485\t    }\n486\t    \n487\t    return created;\n488\t}\n489\tvoid* picoquic_aes128_ecb_create(int is_enc, const void* ecb_key) {\n490\t    return picoquic_ecb_create_by_name(is_enc, ecb_key, \"AES128-ECB\");\n491\t}\n492\t\n493\t/* Obtain a hash algorithm from the table of supported cipher suites.*/\n494\tptls_hash_algorithm_t* picoquic_get_hash_algorithm_by_name(const char* hash_algorithm_name)\n495\t{\n496\t    ptls_hash_algorithm_t* hash = NULL;\n497\t\n498\t    for (int i = 0; i < PICOQUIC_CIPHER_SUITES_NB_MAX && hash == NULL; i++) {\n499\t        if (picoquic_cipher_suites[i].high_memory_suite == NULL) {\n500\t            break;\n501\t        }\n502\t        if (strcmp(picoquic_cipher_suites[i].high_memory_suite->hash->name, hash_algorithm_name) == 0) {\n503\t            hash = picoquic_cipher_suites[i].high_memory_suite->hash;\n504\t            break;\n505\t        }\n506\t    }\n507\t    return hash;\n508\t}\n509\t\n510\t/* Obtain the SHA256 hash, used to derive some secrets\n511\t*/\n512\tptls_hash_algorithm_t* picoquic_get_sha256(void)\n513\t{\n514\t    return picoquic_get_hash_algorithm_by_name(\"sha256\");\n515\t}\n516\t\n517\t/* Export hash functions so applications do not need to access picotls.\n518\t* It is not clear that these functions are actually used by applications.\n519\t*/"}]},"parent_tool_use_id":null,"session_id":"c83abba6-1d49-4ee8-837e-74d6c23d507c","uuid":"53f940bc-8cb0-44f0-86bc-9957a20560ce","timestamp":"2026-05-07T09:44:57.898Z","tool_use_result":{"type":"text","file":{"filePath":"/Users/richbarn/Projects/picoquic/picoquic/tls_api.c","content":"    int nb_suites = picoquic_set_cipher_suite_list(selected_suites, cipher_suite_id, use_low_memory);\n    if (nb_suites <= 0) {\n        cipher = NULL;\n    }\n    else {\n        cipher = selected_suites[0];\n    }\n\n    return cipher;\n}\n\nstatic ptls_cipher_algorithm_t* picoquic_get_ecb_cipher_by_id(const char* ecb_cipher_name)\n{\n    ptls_cipher_algorithm_t* ecb_cipher = NULL;\n\n    for (int j = 0; j < 2 && ecb_cipher == NULL; j++) {\n        for (int i = 0; i < PICOQUIC_CIPHER_SUITES_NB_MAX && ecb_cipher == NULL; i++) {\n            ptls_cipher_suite_t* suite = (j == 0) ?\n                picoquic_cipher_suites[i].high_memory_suite :\n                picoquic_cipher_suites[i].low_memory_suite;\n\n            if (suite != NULL && suite->aead != NULL && suite->aead->ecb_cipher != NULL &&\n                strcmp(suite->aead->ecb_cipher->name, ecb_cipher_name) == 0){\n                ecb_cipher = suite->aead->ecb_cipher;\n                break;\n            }\n        }\n    }\n    return ecb_cipher;\n}\n\n/* Obtain an AES128 ECB cipher, which is required for CID encryption\n* according to the CID for load balancer specification.\n* TODO: rewrite this as a call to the generic \"get cipher suite\" API,\n* then derive the ECB function from the selection of the AEAD function.\n* This will obviate the need of providing a specific API.\n*/\n\nvoid* picoquic_ecb_create_by_name(int is_enc, const void* ecb_key, char const* alg_name)\n{\n    void* created = NULL;\n    ptls_cipher_algorithm_t* ecb_cipher = picoquic_get_ecb_cipher_by_id(alg_name);\n\n    if (ecb_cipher != NULL) {\n        created = (void*)ptls_cipher_new(ecb_cipher, is_enc, ecb_key);\n    }\n    \n    return created;\n}\nvoid* picoquic_aes128_ecb_create(int is_enc, const void* ecb_key) {\n    return picoquic_ecb_create_by_name(is_enc, ecb_key, \"AES128-ECB\");\n}\n\n/* Obtain a hash algorithm from the table of supported cipher suites.*/\nptls_hash_algorithm_t* picoquic_get_hash_algorithm_by_name(const char* hash_algorithm_name)\n{\n    ptls_hash_algorithm_t* hash = NULL;\n\n    for (int i = 0; i < PICOQUIC_CIPHER_SUITES_NB_MAX && hash == NULL; i++) {\n        if (picoquic_cipher_suites[i].high_memory_suite == NULL) {\n            break;\n        }\n        if (strcmp(picoquic_cipher_suites[i].high_memory_suite->hash->name, hash_algorithm_name) == 0) {\n            hash = picoquic_cipher_suites[i].high_memory_suite->hash;\n            break;\n        }\n    }\n    return hash;\n}\n\n/* Obtain the SHA256 hash, used to derive some secrets\n*/\nptls_hash_algorithm_t* picoquic_get_sha256(void)\n{\n    return picoquic_get_hash_algorithm_by_name(\"sha256\");\n}\n\n/* Export hash functions so applications do not need to access picotls.\n* It is not clear that these functions are actually used by applications.\n*/","numLines":80,"startLine":440,"totalLines":3219}}}
