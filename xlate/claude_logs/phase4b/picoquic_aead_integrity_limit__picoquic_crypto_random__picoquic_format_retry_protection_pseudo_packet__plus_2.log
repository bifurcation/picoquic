\t    /// context.  C: `delete_retry_protection_contexts`.\n1667\t    pub fn delete_retry_protection_contexts(&mut self) {\n1668\t        self.retry_integrity_sign_ctx.clear();\n1669\t        self.retry_integrity_verify_ctx.clear();\n1670\t    }\n1671\t}\n1672\t\n1673\t/// Append the integrity tag to the bytes already written into the\n1674\t/// retry packet buffer.  Returns the new write index.  C:\n1675\t/// `encode_retry_protection`.\n1676\tpub fn encode_retry_protection(\n1677\t    integrity_aead: &dyn crate::tls::PacketKey,\n1678\t    bytes: &mut [u8],\n1679\t    byte_index: usize,\n1680\t    odcid: &ConnectionId,\n1681\t) -> usize {\n1682\t    if byte_index > bytes.len() || byte_index + integrity_aead.tag_len() > bytes.len() {\n1683\t        return byte_index;\n1684\t    }\n1685\t    let Some(pseudo_packet) = retry_protection_pseudo_packet(bytes, byte_index, odcid) else {\n1686\t        return byte_index;\n1687\t    };\n1688\t    let mut tag = Vec::new();\n1689\t    integrity_aead.encrypt(0, &pseudo_packet, &mut tag);\n1690\t    if byte_index + tag.len() > bytes.len() {\n1691\t        return byte_index;\n1692\t    }\n1693\t    bytes[byte_index..byte_index + tag.len()].copy_from_slice(&tag);\n1694\t    byte_index + tag.len()\n1695\t}\n1696\t\n1697\t/// Verify the integrity tag at the end of an inbound retry packet.\n1698\t/// Returns the new payload length (with the tag stripped).\n1699\t/// C: `verify_retry_protection`.\n1700\tpub fn verify_retry_protection(\n1701\t    integrity_aead: &dyn crate::tls::PacketKey,\n1702\t    bytes: &mut [u8],\n1703\t    length: usize,\n1704\t    byte_index: usize,\n1705\t    odcid: &ConnectionId,\n1706\t) -> Result<usize, Error> {\n1707\t    let tag_len = integrity_aead.tag_len();\n1708\t    if length > bytes.len() || length < tag_len || byte_index + tag_len >= length {\n1709\t        return Err(Error::Protocol(InternalError::AeadCheck as u64));\n1710\t    }\n1711\t    let payload_len = length - tag_len;\n1712\t    let pseudo_pa