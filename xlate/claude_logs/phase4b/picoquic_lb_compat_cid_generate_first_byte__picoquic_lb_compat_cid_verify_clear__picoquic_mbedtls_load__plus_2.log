{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01UydFhqqpbxwkKCF9Svp2Zt","type":"tool_result","content":"1\t//! Translation of `quic/lb.h`.\n2\t//!\n3\t//! Server-side support for the QUIC load-balancer draft\n4\t//! (<https://datatracker.ietf.org/doc/draft-ietf-quic-load-balancers/>):\n5\t//! parse the LB-supplied configuration string into a [`Config`],\n6\t//! then install a per-server CID-generation / -verification context\n7\t//! ([`ConnectionIdContext`]) on a [`Quic`] via the connection-ID\n8\t//! callback hook.\n9\t//!\n10\t//! ## API shape\n11\t//!\n12\t//! * [`Config::parse`] takes the LB string as `&str` and returns\n13\t//!   the populated config; the C `(char const* txt, size_t\n14\t//!   txt_length)` pair plus zeroed out-parameter collapse to a\n15\t//!   normal Rust constructor.\n16\t//! * [`Quic::set_lb_cid_config`] applies a `Config` to the QUIC\n17\t//!   context, installing the per-server CID context.\n18\t//! * [`Quic::clear_lb_cid_config`] tears the installed context back\n19\t//!   down (no-op when none is installed).\n20\t//! * [`ConnectionIdContext::generate`] / [`ConnectionIdContext::verify`]\n21\t//!   are the per-CID callback bodies.  They are exposed as inherent methods\n22\t//!   so the eventual [`crate::ConnectionIdCallback`] trait impl can\n23\t//!   delegate to them; the C `void* connection_id_cb_data` parameter is\n24\t//!   recovered as `&mut self`.\n25\t//!\n26\t//! ## Field-shape decisions\n27\t//!\n28\t//! * `rotation_bits : 2` — multi-bit C bitfield, kept as `u8`\n29\t//!   (legal range `0..=3`) per the Phase 1 bitfield rule.\n30\t//! * `first_byte_encodes_length : 1` — single-bit C bitfield used\n31\t//!   as a Boolean flag throughout the C body, promoted to `bool`\n32\t//!   (matching the `config.rs` precedent).\n33\t//! * `cid_encryption_context` / `cid_decryption_context` were\n34\t//!   `void*` in C, holding AES-128-ECB contexts produced by\n35\t//!   `aes128_ecb_create` and freed by `aes128_ecb_free` (both\n36\t//!   declared in `tls_api.h`, which has not been translated yet).\n37\t//!   The fields own their contexts in C (the clear path explicitly\n38\t//!   calls the AES destructor), so Rust models them as\n39\t//!   `Option<Box<Aes128EcbContext>>`, with the AES-context type\n40\t//!   forward-declared here as an opaque struct.  `Box::drop` will\n41\t//!   subsume the explicit `aes128_ecb_free` call once Phase 3 gives\n42\t//!   the type a `Drop` impl.\n43\t//! * `server_id: [u8; 16]` and `cid_encryption_key: [u8; 16]` stay\n44\t//!   as fixed-capacity byte arrays — the C declarations are size-16\n45\t//!   arrays and the algorithms are AES-128, so the capacity *is*\n46\t//!   part of the contract.\n47\t\n48\tuse crate::Error;\n49\tuse crate::tls_api::Aes128EcbContext;\n50\tuse crate::{CONNECTION_ID_MAX_SIZE, ConnectionId, Quic};\n51\t\n52\t// ---------------------------------------------------------------------------\n53\t// Private hex-parsing helpers.\n54\t\n55\tfn hex_nibble(b: u8) -> Option<u8> {\n56\t    match b {\n57\t        b'0'..=b'9' => Some(b - b'0'),\n58\t        b'a'..=b'f' => Some(b - b'a' + 10),\n59\t        b'A'..=b'F' => Some(b - b'A' + 10),\n60\t        _ => None,\n61\t    }\n62\t}\n63\t\n64\t/// Decode hex bytes from `hex` into `out`, returning bytes written.\n65\t/// C: `picoquic_parse_hexa`.\n66\tfn parse_hex_bytes(hex: &[u8], out: &mut [u8]) -> usize {\n67\t    let mut i = 0;\n68\t    let mut written = 0;\n69\t    while i + 1 < hex.len() && written < out.len() {\n70\t        match (hex_nibble(hex[i]), hex_nibble(hex[i + 1])) {\n71\t            (Some(hi), Some(lo)) => {\n72\t                out[written] = (hi << 4) | lo;\n73\t                written += 1;\n74\t                i += 2;\n75\t            }\n76\t            _ => break,\n77\t        }\n78\t    }\n79\t    written\n80\t}\n81\t\n82\t/// CID-encoding method selected by the load-balancer config.\n83\t/// C: `load_balancer_cid_method_enum`.\n84\t#[derive(Debug, Copy, Clone, PartialEq, Eq, Default)]\n85\tpub enum ConnectionIdMethod {\n86\t    /// Server ID copied in clear after the first byte.\n87\t    /// C: `load_balancer_cid_clear`.\n88\t    #[default]\n89\t    Clear,\n90\t    /// Server ID encrypted with an AES-128-ECB stream cipher keyed\n91\t    /// off a per-CID nonce.\n92\t    /// C: `load_balancer_cid_stream_cipher`.\n93\t    StreamCipher,\n94\t    /// Server ID encrypted with a single AES-128-ECB block.\n95\t    /// C: `load_balancer_cid_block_cipher`.\n96\t    BlockCipher,\n97\t}\n98\t\n99\t/// Number of low bits of the first CID byte that select between\n100\t/// short-lived configurations.  C: `unsigned int rotation_bits : 2`.\n101\t#[derive(Debug, Copy, Clone, PartialEq, Eq, Default)]\n102\t#[repr(u8)]\n103\tpub enum RotationBits {\n104\t    #[default]\n105\t    Zero = 0,\n106\t    One = 1,\n107\t    Two = 2,\n108\t    Three = 3,\n109\t}\n110\t\n111\t/// Configuration parsed from an LB-supplied string and applied to\n112\t/// a [`Quic`] via [`Quic::set_lb_cid_config`].\n113\t/// C: `load_balancer_config_t`.\n114\t///\n115\t/// `repr(C)` is dropped — the struct is purely an internal shape,\n116\t/// never inspected by an LB or another process.\n117\t///\n118\t/// Lives in `crate::lb`; consumers that also import the demo-app\n119\t/// [`crate::config::Config`] should rename one at the import\n120\t/// site (`use crate::lb::Config as LbConfig;`).\n121\t#[derive(Debug, Default)]\n122\tpub struct Config {\n123\t    pub method: ConnectionIdMethod,\n124\t    pub rotation_bits: RotationBits,\n125\t    /// 1-bit field in C; promoted to `bool` to match call-site usage.\n126\t    pub first_byte_encodes_length: bool,\n127\t    pub server_id_length: usize,\n128\t    /// Used in stream-cipher mode.\n129\t    pub nonce_length: usize,\n130\t    pub connection_id_length: usize,\n131\t    pub server_id: u64,\n132\t    pub cid_encryption_key: [u8; 16],\n133\t}\n134\t\n135\timpl Config {\n136\t    /// Parse an LB-format configuration string into a fresh\n137\t    /// [`Config`].  Returns `Err` when the string is malformed,\n138\t    /// the embedded server ID overflows 8 bytes, or the encoded CID\n139\t    /// length is incompatible with the chosen method.\n140\t    /// C: `lb_compat_cid_config_parse`.\n141\t    ///\n142\t    /// The C signature took an out-parameter and a `(char const*\n143\t    /// txt, size_t txt_length)` pair returning an `int`; the Rust\n144\t    /// signature returns the populated struct in the success arm\n145\t    /// and folds the explicit length into the `&str` slice.\n146\t    pub fn parse(txt: &str) -> Result<Self, Error> {\n147\t        let bytes = txt.as_bytes();\n148\t        if bytes.len() < 4 {\n149\t            return Err(Error::InvalidArgument);\n150\t        }\n151\t\n152\t        let rotation_bits = match bytes[0] {\n153\t            b'0' => RotationBits::Zero,\n154\t            b'1' => RotationBits::One,\n155\t            b'2' => RotationBits::Two,\n156\t            b'3' => RotationBits::Three,\n157\t            _ => return Err(Error::InvalidArgument),\n158\t        };\n159\t\n160\t        let first_byte_encodes_length = match bytes[1] {\n161\t            b'Y' | b'y' => true,\n162\t            b'N' | b'n' => false,\n163\t            _ => return Err(Error::InvalidArgument),\n164\t        };\n165\t\n166\t        let mut config = Config {\n167\t            rotation_bits,\n168\t            first_byte_encodes_length,\n169\t            ..Config::default()\n170\t        };\n171\t\n172\t        let mut parsed = 2usize;\n173\t\n174\t        // Optional decimal connection_id_length.\n175\t        let mut cid_len: usize = 0;\n176\t        while parsed < bytes.len() && bytes[parsed].is_ascii_digit() {\n177\t            cid_len = cid_len * 10 + (bytes[parsed] - b'0') as usize;\n178\t            parsed += 1;\n179\t            if cid_len >= 256 {\n180\t                return Err(Error::InvalidArgument);\n181\t            }\n182\t            config.connection_id_length = cid_len;\n183\t        }\n184\t\n185\t        if parsed >= bytes.len() {\n186\t            return Err(Error::InvalidArgument);\n187\t        }\n188\t        let method_char = bytes[parsed];\n189\t        parsed += 1;\n190\t        match method_char {\n191\t            b'c' | b'C' => {\n192\t                config.method = ConnectionIdMethod::Clear;\n193\t            }\n194\t            b's' | b'S' => {\n195\t                config.method = ConnectionIdMethod::StreamCipher;\n196\t                let mut nonce_len: usize = 0;\n197\t                while parsed < bytes.len() && bytes[parsed].is_ascii_digit() {\n198\t                    nonce_len = nonce_len * 10 + (bytes[parsed] - b'0') as usize;\n199\t                    parsed += 1;\n200\t                    if nonce_len >= 256 {\n201\t                        return Err(Error::InvalidArgument);\n202\t                    }\n203\t                    config.nonce_length = nonce_len;\n204\t                }\n205\t            }\n206\t            b'b' | b'B' => {\n207\t                config.method = ConnectionIdMethod::BlockCipher;\n208\t            }\n209\t            _ => return Err(Error::InvalidArgument),\n210\t        }\n211\t\n212\t        // Hyphen before server ID.\n213\t        if parsed >= bytes.len() || bytes[parsed] != b'-' {\n214\t            return Err(Error::InvalidArgument);\n215\t        }\n216\t        parsed += 1;\n217\t\n218\t        if parsed >= bytes.len() {\n219\t            return Err(Error::InvalidArgument);\n220\t        }\n221\t\n222\t        // Server ID hex (scan to next '-' or end).\n223\t        let hex_len = bytes[parsed..]\n224\t            .iter()\n225\t            .position(|&b| b == b'-')\n226\t            .unwrap_or(bytes.len() - parsed);\n227\t        let hex_end = parsed + hex_len;\n228\t        let mut s_id_bin = [0u8; 8];\n229\t        let s_id_len = parse_hex_bytes(&bytes[parsed..hex_end], &mut s_id_bin);\n230\t        if s_id_len == 0 {\n231\t            return Err(Error::InvalidArgument);\n232\t        }\n233\t        config.server_id_length = s_id_len;\n234\t        for b in s_id_bin.iter().take(s_id_len) {\n235\t            config.server_id <<= 8;\n236\t            config.server_id |= *b as u64;\n237\t        }\n238\t        parsed += 2 * s_id_len;\n239\t\n240\t        // Encryption key for stream/block cipher.\n241\t        if matches!(\n242\t            config.method,\n243\t            ConnectionIdMethod::StreamCipher | ConnectionIdMethod::BlockCipher\n244\t        ) {\n245\t            if parsed >= bytes.len() || bytes[parsed] != b'-' {\n246\t                return Err(Error::InvalidArgument);\n247\t            }\n248\t            parsed += 1;\n249\t            if bytes.len() < parsed + 32 {\n250\t                return Err(Error::InvalidArgument);\n251\t            }\n252\t            let key_len = parse_hex_bytes(&bytes[parsed..], &mut config.cid_encryption_key);\n253\t            if key_len != 16 {\n254\t                return Err(Error::InvalidArgument);\n255\t            }\n256\t            parsed += 32;\n257\t        }\n258\t\n259\t        if parsed != bytes.len() {\n260\t            return Err(Error::InvalidArgument);\n261\t        }\n262\t\n263\t        // Validate connection_id_length if explicitly set.\n264\t        if config.connection_id_length != 0 {\n265\t            let min_length = 1 + config.server_id_length + config.nonce_length;\n266\t            if config.connection_id_length < min_length {\n267\t                return Err(Error::InvalidArgument);\n268\t            }\n269\t            if matches!(config.method, ConnectionIdMethod::BlockCipher)\n270\t                && config.connection_id_length < 17\n271\t            {\n272\t                return Err(Error::InvalidArgument);\n273\t            }\n274\t        }\n275\t\n276\t        Ok(config)\n277\t    }\n278\t}\n279\t\n280\t// ---------------------------------------------------------------------------\n281\t// Per-server CID context.\n282\t\n283\t/// Per-server context attached to a [`Quic`] once a load-balancer\n284\t/// config has been applied.  Built from a [`Config`] by\n285\t/// [`Quic::set_lb_cid_config`] and consumed by the\n286\t/// [`crate::ConnectionIdCallback`] hook.\n287\t/// C: `load_balancer_cid_context_t`.\n288\t///\n289\t/// The two AES contexts are method-dependent: [`ConnectionIdMethod::Clear`]\n290\t/// uses neither, [`ConnectionIdMethod::StreamCipher`] uses only the\n291\t/// encryption context (the verify path re-encrypts the nonce and XORs),\n292\t/// and [`ConnectionIdMethod::BlockCipher`] uses both.  Hence the\n293\t/// `Option<Box<…>>` wrappers — they encode method-dependence rather\n294\t/// than an init-time gap.\n295\t#[derive(Debug, Default)]\n296\tpub struct ConnectionIdContext {\n297\t    pub method: ConnectionIdMethod,\n298\t    pub rotation_bits: RotationBits,\n299\t    /// 1-bit field in C; promoted to `bool`.\n300\t    pub first_byte_encodes_length: bool,\n301\t    pub server_id_length: usize,\n302\t    /// Used in stream-cipher mode.\n303\t    pub nonce_length: usize,\n304\t    pub connection_id_length: usize,\n305\t    pub server_id: u64,\n306\t    /// Big-endian encoding of `server_id`, padded to\n307\t    /// `server_id_length` bytes.\n308\t    pub server_id_encoded: [u8; 16],\n309\t    /// Used in stream- and block-cipher modes.  Owned by this\n310\t    /// struct: the C clear path calls `aes128_ecb_free` on it.\n311\t    pub cid_encryption_context: Option<Box<Aes128EcbContext>>,\n312\t    /// Used in block-cipher mode for the verify path.  Owned the\n313\t    /// same way.\n314\t    pub cid_decryption_context: Option<Box<Aes128EcbContext>>,\n315\t}\n316\t\n317\timpl ConnectionIdContext {\n318\t    fn set_first_byte(&self, quic: &Quic, bytes: &mut [u8]) {\n319\t        if self.first_byte_encodes_length {\n320\t            bytes[0] = (self.rotation_bits as u8) << 6 | (quic.local_connection_id_length - 1);\n321\t        } else {\n322\t            bytes[0] &= 0x3F;\n323\t            bytes[0] |= (self.rotation_bits as u8) << 6;\n324\t        }\n325\t    }\n326\t\n327\t    /// One pass of the stream-cipher: fill `mask` from `bytes[nonce_start..]`,\n328\t    /// AES-encrypt it, then XOR `mask` into `bytes[target_start..]`.\n329\t    /// C: `picoquic_lb_compat_cid_one_pass_stream`.\n330\t    fn one_pass_stream(\n331\t        enc: &Aes128EcbContext,\n332\t        bytes: &mut [u8],\n333\t        nonce_start: usize,\n334\t        nonce_len: usize,\n335\t        target_start: usize,\n336\t        target_len: usize,\n337\t    ) {\n338\t        let mut mask = [0u8; 16];\n339\t        let copy_len = nonce_len.min(16);\n340\t        mask[..copy_len].copy_from_slice(&bytes[nonce_start..nonce_start + copy_len]);\n341\t        enc.process(&mut mask);\n342\t        for i in 0..target_len {\n343\t            bytes[target_start + i] ^= mask[i];\n344\t        }\n345\t    }\n346\t\n347\t    /// Encode a CID from `nonce` per `self.method` and return it.\n348\t    /// C: `lb_compat_cid_generate`.\n349\t    ///\n350\t    /// The C signature took a `connection_id_returned` out parameter that\n351\t    /// the body both read (for the nonce / \"for-server use\" bytes)\n352\t    /// and wrote (for the encoded CID); the Rust signature splits\n353\t    /// those two roles — the input nonce comes in by reference and\n354\t    /// the encoded CID is the return value.  `&mut self` because the\n355\t    /// underlying AES contexts mutate cipher state in place.  `quic`\n356\t    /// is read for `local_connection_id_length`; the unused `connection_id_local` /\n357\t    /// `connection_id_remote` parameters of the C signature are dropped\n358\t    /// here and reintroduced (if needed) by the\n359\t    /// [`crate::ConnectionIdCallback`] adapter.\n360\t    pub fn generate(&mut self, quic: &Quic, nonce: &ConnectionId) -> ConnectionId {\n361\t        let mut cid = *nonce;\n362\t        {\n363\t            let bytes = cid.as_bytes_mut();\n364\t            self.set_first_byte(quic, bytes);\n365\t            match self.method {\n366\t                ConnectionIdMethod::Clear => {\n367\t                    bytes[1..1 + self.server_id_length]\n368\t                        .copy_from_slice(&self.server_id_encoded[..self.server_id_length]);\n369\t                }\n370\t                ConnectionIdMethod::StreamCipher => {\n371\t                    let id_offset = 1 + self.nonce_length;\n372\t                    bytes[id_offset..id_offset + self.server_id_length]\n373\t                        .copy_from_slice(&self.server_id_encoded[..self.server_id_length]);\n374\t                    let enc = self.cid_encryption_context.as_ref().unwrap();\n375\t                    Self::one_pass_stream(\n376\t                        enc,\n377\t                        bytes,\n378\t                        1,\n379\t                        self.nonce_length,\n380\t                        id_offset,\n381\t                        self.server_id_length,\n382\t                    );\n383\t                    Self::one_pass_stream(\n384\t                        enc,\n385\t                        bytes,\n386\t                        id_offset,\n387\t                        self.server_id_length,\n388\t                        1,\n389\t                        self.nonce_length,\n390\t                    );\n391\t                    Self::one_pass_stream(\n392\t                        enc,\n393\t                        bytes,\n394\t                        1,\n395\t                        self.nonce_length,\n396\t                        id_offset,\n397\t                        self.server_id_length,\n398\t                    );\n399\t                }\n400\t                ConnectionIdMethod::BlockCipher => {\n401\t                    bytes[1..1 + self.server_id_length]\n402\t                        .copy_from_slice(&self.server_id_encoded[..self.server_id_length]);\n403\t                    let enc = self.cid_encryption_context.as_ref().unwrap();\n404\t                    let block = <&mut [u8; 16]>::try_from(&mut bytes[1..17]).unwrap();\n405\t                    enc.process(block);\n406\t                }\n407\t            }\n408\t        }\n409\t        cid\n410\t    }\n411\t\n412\t    /// Decode the server ID embedded in `connection_id`.  Returns `None`\n413\t    /// when the CID length doesn't match `self.connection_id_length`\n414\t    /// or when `self.method` is unrecognised; the C sentinel\n415\t    /// `UINT64_MAX` is folded into `Option`.\n416\t    /// C: `lb_compat_cid_verify`.\n417\t    ///\n418\t    /// `&mut self` because the underlying AES contexts mutate\n419\t    /// cipher state in place.\n420\t    pub fn verify(&mut self, cnx_id: &ConnectionId) -> Option<u64> {\n421\t        if cnx_id.len() != self.connection_id_length {\n422\t            return None;\n423\t        }\n424\t        let s_id64 = match self.method {\n425\t            ConnectionIdMethod::Clear => {\n426\t                let bytes = cnx_id.as_bytes();\n427\t                let mut s_id64: u64 = 0;\n428\t                for i in 0..self.server_id_length {\n429\t                    s_id64 <<= 8;\n430\t                    s_id64 += bytes[i + 1] as u64;\n431\t                }\n432\t                s_id64\n433\t            }\n434\t            ConnectionIdMethod::StreamCipher => {\n435\t                let id_offset = 1 + self.nonce_length;\n436\t                let mut target = [0u8; CONNECTION_ID_MAX_SIZE];\n437\t                let len = cnx_id.len();\n438\t                target[..len].copy_from_slice(cnx_id.as_bytes());\n439\t                let enc = self.cid_encryption_context.as_ref().unwrap();\n440\t                Self::one_pass_stream(\n441\t                    enc,\n442\t                    &mut target[..len],\n443\t                    1,\n444\t                    self.nonce_length,\n445\t                    id_offset,\n446\t                    self.server_id_length,\n447\t                );\n448\t                Self::one_pass_stream(\n449\t                    enc,\n450\t                    &mut target[..len],\n451\t                    id_offset,\n452\t                    self.server_id_length,\n453\t                    1,\n454\t                    self.nonce_length,\n455\t                );\n456\t                Self::one_pass_stream(\n457\t                    enc,\n458\t                    &mut target[..len],\n459\t                    1,\n460\t                    self.nonce_length,\n461\t                    id_offset,\n462\t                    self.server_id_length,\n463\t                );\n464\t                let mut s_id64: u64 = 0;\n465\t                for i in 0..self.server_id_length {\n466\t                    s_id64 <<= 8;\n467\t                    s_id64 += target[id_offset + i] as u64;\n468\t                }\n469\t                s_id64\n470\t            }\n471\t            ConnectionIdMethod::BlockCipher => {\n472\t                let bytes = cnx_id.as_bytes();\n473\t                let mut decoded = [0u8; 16];\n474\t                decoded.copy_from_slice(&bytes[1..17]);\n475\t                let dec = self.cid_decryption_context.as_ref().unwrap();\n476\t                dec.process(&mut decoded);\n477\t                let mut s_id64: u64 = 0;\n478\t                for b in decoded.iter().take(self.server_id_length) {\n479\t                    s_id64 <<= 8;\n480\t                    s_id64 += *b as u64;\n481\t                }\n482\t                s_id64\n483\t            }\n484\t        };\n485\t        Some(s_id64)\n486\t    }\n487\t}\n488\t\n489\timpl Quic {\n490\t    /// Apply `lb_config` to `self`, installing a [`ConnectionIdContext`]\n491\t    /// as the connection-ID callback context.\n492\t    /// C: `lb_compat_cid_config`.\n493\t    ///\n494\t    /// Returns `Err` when `self` already has a different CID\n495\t    /// callback configured, when the requested CID length doesn't\n496\t    /// fit the chosen method, or when the AES context allocation\n497\t    /// fails.\n498\t    pub fn set_lb_cid_config(&mut self, lb_config: &Config) -> Result<(), Error> {\n499\t        if !self.connections.is_empty()\n500\t            && self.local_connection_id_length as usize != lb_config.connection_id_length\n501\t        {\n502\t            return Err(Error::InvalidState);\n503\t        }\n504\t        if self.connection_id_callback_fn.is_some() && self.connection_id_callback_ctx.is_some() {\n505\t            return Err(Error::InvalidState);\n506\t        }\n507\t        if lb_config.connection_id_length > CONNECTION_ID_MAX_SIZE {\n508\t            return Err(Error::InvalidArgument);\n509\t        }\n510\t        match lb_config.method {\n511\t            ConnectionIdMethod::Clear => {\n512\t                if lb_config.server_id_length + 1 > lb_config.connection_id_length {\n513\t                    return Err(Error::InvalidArgument);\n514\t                }\n515\t            }\n516\t            ConnectionIdMethod::StreamCipher => {\n517\t                if lb_config.nonce_length < 8\n518\t                    || lb_config.nonce_length > 16\n519\t                    || lb_config.nonce_length + lb_config.server_id_length + 1\n520\t                        > lb_config.connection_id_length\n521\t                {\n522\t                    return Err(Error::InvalidArgument);\n523\t                }\n524\t            }\n525\t            ConnectionIdMethod::BlockCipher => {\n526\t                if lb_config.connection_id_length < 17 || lb_config.server_id_length > 15 {\n527\t                    return Err(Error::InvalidArgument);\n528\t                }\n529\t            }\n530\t        }\n531\t\n532\t        // Encode server_id as big-endian bytes.\n533\t        let mut server_id_encoded = [0u8; 16];\n534\t        let mut s_id64 = lb_config.server_id;\n535\t        for i in 0..lb_config.server_id_length {\n536\t            let j = lb_config.server_id_length - i - 1;\n537\t            server_id_encoded[j] = s_id64 as u8;\n538\t            s_id64 >>= 8;\n539\t        }\n540\t        if s_id64 != 0 {\n541\t            return Err(Error::InvalidArgument);\n542\t        }\n543\t\n544\t        let cid_encryption_context = match lb_config.method {\n545\t            ConnectionIdMethod::StreamCipher | ConnectionIdMethod::BlockCipher => Some(Box::new(\n546\t                Aes128EcbContext::new(true, &lb_config.cid_encryption_key),\n547\t            )),\n548\t            ConnectionIdMethod::Clear => None,\n549\t        };\n550\t        let cid_decryption_context = match lb_config.method {\n551\t            ConnectionIdMethod::BlockCipher => Some(Box::new(Aes128EcbContext::new(\n552\t                false,\n553\t                &lb_config.cid_encryption_key,\n554\t            ))),\n555\t            _ => None,\n556\t        };\n557\t\n558\t        let context = ConnectionIdContext {\n559\t            method: lb_config.method,\n560\t            rotation_bits: lb_config.rotation_bits,\n561\t            first_byte_encodes_length: lb_config.first_byte_encodes_length,\n562\t            server_id_length: lb_config.server_id_length,\n563\t            nonce_length: lb_config.nonce_length,\n564\t            connection_id_length: lb_config.connection_id_length,\n565\t            server_id: lb_config.server_id,\n566\t            server_id_encoded,\n567\t            cid_encryption_context,\n568\t            cid_decryption_context,\n569\t        };\n570\t\n571\t        self.local_connection_id_length = lb_config.connection_id_length as u8;\n572\t        self.connection_id_callback_ctx = Some(Box::new(context));\n573\t        Ok(())\n574\t    }\n575\t\n576\t    /// Tear down the [`ConnectionIdContext`] previously installed by\n577\t    /// [`Quic::set_lb_cid_config`], releasing the AES-ECB\n578\t    /// encryption contexts and clearing the callback slot on\n579\t    /// `self`.  No-op when no LB CID context is installed.\n580\t    /// C: `lb_compat_cid_config_free`.\n581\t    pub fn clear_lb_cid_config(&mut self) {\n582\t        let is_lb = self\n583\t            .connection_id_callback_ctx\n584\t            .as_ref()\n585\t            .is_some_and(|c| c.is::<ConnectionIdContext>());\n586\t        if is_lb {\n587\t            self.connection_id_callback_ctx = None;\n588\t            self.connection_id_callback_fn = None;\n589\t        }\n590\t    }\n591\t}\n592\t\n593\t#[cfg(test)]\n594\tmod test {}\n595\t"}]},"parent_tool_use_id":null,"session_id":"7a2ce5ec-3f9a-4edb-bf74-55e2a91d488d","uuid":"3c5c0b10-3f1e-4386-b6d0-4818229318d2","timestamp":"2026-05-07T06:39:34.727Z","tool_use_result":{"type":"text","file":{"filePath":"/Users/richbarn/Projects/picoquic/rs/fq/src/lb.rs","content":"//! Translation of `quic/lb.h`.\n//!\n//! Server-side support for the QUIC load-balancer draft\n//! (<https://datatracker.ietf.org/doc/draft-ietf-quic-load-balancers/>):\n//! parse the LB-supplied configuration string into a [`Config`],\n//! then install a per-server CID-generation / -verification context\n//! ([`ConnectionIdContext`]) on a [`Quic`] via the connection-ID\n//! callback hook.\n//!\n//! ## API shape\n//!\n//! * [`Config::parse`] takes the LB string as `&str` and returns\n//!   the populated config; the C `(char const* txt, size_t\n//!   txt_length)` pair plus zeroed out-parameter collapse to a\n//!   normal Rust constructor.\n//! * [`Quic::set_lb_cid_config`] applies a `Config` to the QUIC\n//!   context, installing the per-server CID context.\n//! * [`Quic::clear_lb_cid_config`] tears the installed context back\n//!   down (no-op when none is installed).\n//! * [`ConnectionIdContext::generate`] / [`ConnectionIdContext::verify`]\n//!   are the per-CID callback bodies.  They are exposed as inherent methods\n//!   so the eventual [`crate::ConnectionIdCallback`] trait impl can\n//!   delegate to them; the C `void* connection_id_cb_data` parameter is\n//!   recovered as `&mut self`.\n//!\n//! ## Field-shape decisions\n//!\n//! * `rotation_bits : 2` — multi-bit C bitfield, kept as `u8`\n//!   (legal range `0..=3`) per the Phase 1 bitfield rule.\n//! * `first_byte_encodes_length : 1` — single-bit C bitfield used\n//!   as a Boolean flag throughout the C body, promoted to `bool`\n//!   (matching the `config.rs` precedent).\n//! * `cid_encryption_context` / `cid_decryption_context` were\n//!   `void*` in C, holding AES-128-ECB contexts produced by\n//!   `aes128_ecb_create` and freed by `aes128_ecb_free` (both\n//!   declared in `tls_api.h`, which has not been translated yet).\n//!   The fields own their contexts in C (the clear path explicitly\n//!   calls the AES destructor), so Rust models them as\n//!   `Option<Box<Aes128EcbContext>>`, with the AES-context type\n//!   forward-declared here as an opaque struct.  `Box::drop` will\n//!   subsume the explicit `aes128_ecb_free` call once Phase 3 gives\n//!   the type a `Drop` impl.\n//! * `server_id: [u8; 16]` and `cid_encryption_key: [u8; 16]` stay\n//!   as fixed-capacity byte arrays — the C declarations are size-16\n//!   arrays and the algorithms are AES-128, so the capacity *is*\n//!   part of the contract.\n\nuse crate::Error;\nuse crate::tls_api::Aes128EcbContext;\nuse crate::{CONNECTION_ID_MAX_SIZE, ConnectionId, Quic};\n\n// ---------------------------------------------------------------------------\n// Private hex-parsing helpers.\n\nfn hex_nibble(b: u8) -> Option<u8> {\n    match b {\n        b'0'..=b'9' => Some(b - b'0'),\n        b'a'..=b'f' => Some(b - b'a' + 10),\n        b'A'..=b'F' => Some(b - b'A' + 10),\n        _ => None,\n    }\n}\n\n/// Decode hex bytes from `hex` into `out`, returning bytes written.\n/// C: `picoquic_parse_hexa`.\nfn parse_hex_bytes(hex: &[u8], out: &mut [u8]) -> usize {\n    let mut i = 0;\n    let mut written = 0;\n    while i + 1 < hex.len() && written < out.len() {\n        match (hex_nibble(hex[i]), hex_nibble(hex[i + 1])) {\n            (Some(hi), Some(lo)) => {\n                out[written] = (hi << 4) | lo;\n                written += 1;\n                i += 2;\n            }\n            _ => break,\n        }\n    }\n    written\n}\n\n/// CID-encoding method selected by the load-balancer config.\n/// C: `load_balancer_cid_method_enum`.\n#[derive(Debug, Copy, Clone, PartialEq, Eq, Default)]\npub enum ConnectionIdMethod {\n    /// Server ID copied in clear after the first byte.\n    /// C: `load_balancer_cid_clear`.\n    #[default]\n    Clear,\n    /// Server ID encrypted with an AES-128-ECB stream cipher keyed\n    /// off a per-CID nonce.\n    /// C: `load_balancer_cid_stream_cipher`.\n    StreamCipher,\n    /// Server ID encrypted with a single AES-128-ECB block.\n    /// C: `load_balancer_cid_block_cipher`.\n    BlockCipher,\n}\n\n/// Number of low bits of the first CID byte that select between\n/// short-lived configurations.  C: `unsigned int rotation_bits : 2`.\n#[derive(Debug, Copy, Clone, PartialEq, Eq, Default)]\n#[repr(u8)]\npub enum RotationBits {\n    #[default]\n    Zero = 0,\n    One = 1,\n    Two = 2,\n    Three = 3,\n}\n\n/// Configuration parsed from an LB-supplied string and applied to\n/// a [`Quic`] via [`Quic::set_lb_cid_config`].\n/// C: `load_balancer_config_t`.\n///\n/// `repr(C)` is dropped — the struct is purely an internal shape,\n/// never inspected by an LB or another process.\n///\n/// Lives in `crate::lb`; consumers that also import the demo-app\n/// [`crate::config::Config`] should rename one at the import\n/// site (`use crate::lb::Config as LbConfig;`).\n#[derive(Debug, Default)]\npub struct Config {\n    pub method: ConnectionIdMethod,\n    pub rotation_bits: RotationBits,\n    /// 1-bit field in C; promoted to `bool` to match call-site usage.\n    pub first_byte_encodes_length: bool,\n    pub server_id_length: usize,\n    /// Used in stream-cipher mode.\n    pub nonce_length: usize,\n    pub connection_id_length: usize,\n    pub server_id: u64,\n    pub cid_encryption_key: [u8; 16],\n}\n\nimpl Config {\n    /// Parse an LB-format configuration string into a fresh\n    /// [`Config`].  Returns `Err` when the string is malformed,\n    /// the embedded server ID overflows 8 bytes, or the encoded CID\n    /// length is incompatible with the chosen method.\n    /// C: `lb_compat_cid_config_parse`.\n    ///\n    /// The C signature took an out-parameter and a `(char const*\n    /// txt, size_t txt_length)` pair returning an `int`; the Rust\n    /// signature returns the populated struct in the success arm\n    /// and folds the explicit length into the `&str` slice.\n    pub fn parse(txt: &str) -> Result<Self, Error> {\n        let bytes = txt.as_bytes();\n        if bytes.len() < 4 {\n            return Err(Error::InvalidArgument);\n        }\n\n        let rotation_bits = match bytes[0] {\n            b'0' => RotationBits::Zero,\n            b'1' => RotationBits::One,\n            b'2' => RotationBits::Two,\n            b'3' => RotationBits::Three,\n            _ => return Err(Error::InvalidArgument),\n        };\n\n        let first_byte_encodes_length = match bytes[1] {\n            b'Y' | b'y' => true,\n            b'N' | b'n' => false,\n            _ => return Err(Error::InvalidArgument),\n        };\n\n        let mut config = Config {\n            rotation_bits,\n            first_byte_encodes_length,\n            ..Config::default()\n        };\n\n        let mut parsed = 2usize;\n\n        // Optional decimal connection_id_length.\n        let mut cid_len: usize = 0;\n        while parsed < bytes.len() && bytes[parsed].is_ascii_digit() {\n            cid_len = cid_len * 10 + (bytes[parsed] - b'0') as usize;\n            parsed += 1;\n            if cid_len >= 256 {\n                return Err(Error::InvalidArgument);\n            }\n            config.connection_id_length = cid_len;\n        }\n\n        if parsed >= bytes.len() {\n            return Err(Error::InvalidArgument);\n        }\n        let method_char = bytes[parsed];\n        parsed += 1;\n        match method_char {\n            b'c' | b'C' => {\n                config.method = ConnectionIdMethod::Clear;\n            }\n            b's' | b'S' => {\n                config.method = ConnectionIdMethod::StreamCipher;\n                let mut nonce_len: usize = 0;\n                while parsed < bytes.len() && bytes[parsed].is_ascii_digit() {\n                    nonce_len = nonce_len * 10 + (bytes[parsed] - b'0') as usize;\n                    parsed += 1;\n                    if nonce_len >= 256 {\n                        return Err(Error::InvalidArgument);\n                    }\n                    config.nonce_length = nonce_len;\n                }\n            }\n            b'b' | b'B' => {\n                config.method = ConnectionIdMethod::BlockCipher;\n            }\n            _ => return Err(Error::InvalidArgument),\n        }\n\n        // Hyphen before server ID.\n        if parsed >= bytes.len() || bytes[parsed] != b'-' {\n            return Err(Error::InvalidArgument);\n        }\n        parsed += 1;\n\n        if parsed >= bytes.len() {\n            return Err(Error::InvalidArgument);\n        }\n\n        // Server ID hex (scan to next '-' or end).\n        let hex_len = bytes[parsed..]\n            .iter()\n            .position(|&b| b == b'-')\n            .unwrap_or(bytes.len() - parsed);\n        let hex_end = parsed + hex_len;\n        let mut s_id_bin = [0u8; 8];\n        let s_id_len = parse_hex_bytes(&bytes[parsed..hex_end], &mut s_id_bin);\n        if s_id_len == 0 {\n            return Err(Error::InvalidArgument);\n        }\n        config.server_id_length = s_id_len;\n        for b in s_id_bin.iter().take(s_id_len) {\n            config.server_id <<= 8;\n            config.server_id |= *b as u64;\n        }\n        parsed += 2 * s_id_len;\n\n        // Encryption key for stream/block cipher.\n        if matches!(\n            config.method,\n            ConnectionIdMethod::StreamCipher | ConnectionIdMethod::BlockCipher\n        ) {\n            if parsed >= bytes.len() || bytes[parsed] != b'-' {\n                return Err(Error::InvalidArgument);\n            }\n            parsed += 1;\n            if bytes.len() < parsed + 32 {\n                return Err(Error::InvalidArgument);\n            }\n            let key_len = parse_hex_bytes(&bytes[parsed..], &mut config.cid_encryption_key);\n            if key_len != 16 {\n                return Err(Error::InvalidArgument);\n            }\n            parsed += 32;\n        }\n\n        if parsed != bytes.len() {\n            return Err(Error::InvalidArgument);\n        }\n\n        // Validate connection_id_length if explicitly set.\n        if config.connection_id_length != 0 {\n            let min_length = 1 + config.server_id_length + config.nonce_length;\n            if config.connection_id_length < min_length {\n                return Err(Error::InvalidArgument);\n            }\n            if matches!(config.method, ConnectionIdMethod::BlockCipher)\n                && config.connection_id_length < 17\n            {\n                return Err(Error::InvalidArgument);\n            }\n        }\n\n        Ok(config)\n    }\n}\n\n// ---------------------------------------------------------------------------\n// Per-server CID context.\n\n/// Per-server context attached to a [`Quic`] once a load-balancer\n/// config has been applied.  Built from a [`Config`] by\n/// [`Quic::set_lb_cid_config`] and consumed by the\n/// [`crate::ConnectionIdCallback`] hook.\n/// C: `load_balancer_cid_context_t`.\n///\n/// The two AES contexts are method-dependent: [`ConnectionIdMethod::Clear`]\n/// uses neither, [`ConnectionIdMethod::StreamCipher`] uses only the\n/// encryption context (the verify path re-encrypts the nonce and XORs),\n/// and [`ConnectionIdMethod::BlockCipher`] uses both.  Hence the\n/// `Option<Box<…>>` wrappers — they encode method-dependence rather\n/// than an init-time gap.\n#[derive(Debug, Default)]\npub struct ConnectionIdContext {\n    pub method: ConnectionIdMethod,\n    pub rotation_bits: RotationBits,\n    /// 1-bit field in C; promoted to `bool`.\n    pub first_byte_encodes_length: bool,\n    pub server_id_length: usize,\n    /// Used in stream-cipher mode.\n    pub nonce_length: usize,\n    pub connection_id_length: usize,\n    pub server_id: u64,\n    /// Big-endian encoding of `server_id`, padded to\n    /// `server_id_length` bytes.\n    pub server_id_encoded: [u8; 16],\n    /// Used in stream- and block-cipher modes.  Owned by this\n    /// struct: the C clear path calls `aes128_ecb_free` on it.\n    pub cid_encryption_context: Option<Box<Aes128EcbContext>>,\n    /// Used in block-cipher mode for the verify path.  Owned the\n    /// same way.\n    pub cid_decryption_context: Option<Box<Aes128EcbContext>>,\n}\n\nimpl ConnectionIdContext {\n    fn set_first_byte(&self, quic: &Quic, bytes: &mut [u8]) {\n        if self.first_byte_encodes_length {\n            bytes[0] = (self.rotation_bits as u8) << 6 | (quic.local_connection_id_length - 1);\n        } else {\n            bytes[0] &= 0x3F;\n            bytes[0] |= (self.rotation_bits as u8) << 6;\n        }\n    }\n\n    /// One pass of the stream-cipher: fill `mask` from `bytes[nonce_start..]`,\n    /// AES-encrypt it, then XOR `mask` into `bytes[target_start..]`.\n    /// C: `picoquic_lb_compat_cid_one_pass_stream`.\n    fn one_pass_stream(\n        enc: &Aes128EcbContext,\n        bytes: &mut [u8],\n        nonce_start: usize,\n        nonce_len: usize,\n        target_start: usize,\n        target_len: usize,\n    ) {\n        let mut mask = [0u8; 16];\n        let copy_len = nonce_len.min(16);\n        mask[..copy_len].copy_from_slice(&bytes[nonce_start..nonce_start + copy_len]);\n        enc.process(&mut mask);\n        for i in 0..target_len {\n            bytes[target_start + i] ^= mask[i];\n        }\n    }\n\n    /// Encode a CID from `nonce` per `self.method` and return it.\n    /// C: `lb_compat_cid_generate`.\n    ///\n    /// The C signature took a `connection_id_returned` out parameter that\n    /// the body both read (for the nonce / \"for-server use\" bytes)\n    /// and wrote (for the encoded CID); the Rust signature splits\n    /// those two roles — the input nonce comes in by reference and\n    /// the encoded CID is the return value.  `&mut self` because the\n    /// underlying AES contexts mutate cipher state in place.  `quic`\n    /// is read for `local_connection_id_length`; the unused `connection_id_local` /\n    /// `connection_id_remote` parameters of the C signature are dropped\n    /// here and reintroduced (if needed) by the\n    /// [`crate::ConnectionIdCallback`] adapter.\n    pub fn generate(&mut self, quic: &Quic, nonce: &ConnectionId) -> ConnectionId {\n        let mut cid = *nonce;\n        {\n            let bytes = cid.as_bytes_mut();\n            self.set_first_byte(quic, bytes);\n            match self.method {\n                ConnectionIdMethod::Clear => {\n                    bytes[1..1 + self.server_id_length]\n                        .copy_from_slice(&self.server_id_encoded[..self.server_id_length]);\n                }\n                ConnectionIdMethod::StreamCipher => {\n                    let id_offset = 1 + self.nonce_length;\n                    bytes[id_offset..id_offset + self.server_id_length]\n                        .copy_from_slice(&self.server_id_encoded[..self.server_id_length]);\n                    let enc = self.cid_encryption_context.as_ref().unwrap();\n                    Self::one_pass_stream(\n                        enc,\n                        bytes,\n                        1,\n                        self.nonce_length,\n                        id_offset,\n                        self.server_id_length,\n                    );\n                    Self::one_pass_stream(\n                        enc,\n                        bytes,\n                        id_offset,\n                        self.server_id_length,\n                        1,\n                        self.nonce_length,\n                    );\n                    Self::one_pass_stream(\n                        enc,\n                        bytes,\n                        1,\n                        self.nonce_length,\n                        id_offset,\n                        self.server_id_length,\n                    );\n                }\n                ConnectionIdMethod::BlockCipher => {\n                    bytes[1..1 + self.server_id_length]\n                        .copy_from_slice(&self.server_id_encoded[..self.server_id_length]);\n                    let enc = self.cid_encryption_context.as_ref().unwrap();\n                    let block = <&mut [u8; 16]>::try_from(&mut bytes[1..17]).unwrap();\n                    enc.process(block);\n                }\n            }\n        }\n        cid\n    }\n\n    /// Decode the server ID embedded in `connection_id`.  Returns `None`\n    /// when the CID length doesn't match `self.connection_id_length`\n    /// or when `self.method` is unrecognised; the C sentinel\n    /// `UINT64_MAX` is folded into `Option`.\n    /// C: `lb_compat_cid_verify`.\n    ///\n    /// `&mut self` because the underlying AES contexts mutate\n    /// cipher state in place.\n    pub fn verify(&mut self, cnx_id: &ConnectionId) -> Option<u64> {\n        if cnx_id.len() != self.connection_id_length {\n            return None;\n        }\n        let s_id64 = match self.method {\n            ConnectionIdMethod::Clear => {\n                let bytes = cnx_id.as_bytes();\n                let mut s_id64: u64 = 0;\n                for i in 0..self.server_id_length {\n                    s_id64 <<= 8;\n                    s_id64 += bytes[i + 1] as u64;\n                }\n                s_id64\n            }\n            ConnectionIdMethod::StreamCipher => {\n                let id_offset = 1 + self.nonce_length;\n                let mut target = [0u8; CONNECTION_ID_MAX_SIZE];\n                let len = cnx_id.len();\n                target[..len].copy_from_slice(cnx_id.as_bytes());\n                let enc = self.cid_encryption_context.as_ref().unwrap();\n                Self::one_pass_stream(\n                    enc,\n                    &mut target[..len],\n                    1,\n                    self.nonce_length,\n                    id_offset,\n                    self.server_id_length,\n                );\n                Self::one_pass_stream(\n                    enc,\n                    &mut target[..len],\n                    id_offset,\n                    self.server_id_length,\n                    1,\n                    self.nonce_length,\n                );\n                Self::one_pass_stream(\n                    enc,\n                    &mut target[..len],\n                    1,\n                    self.nonce_length,\n                    id_offset,\n                    self.server_id_length,\n                );\n                let mut s_id64: u64 = 0;\n                for i in 0..self.server_id_length {\n                    s_id64 <<= 8;\n                    s_id64 += target[id_offset + i] as u64;\n                }\n                s_id64\n            }\n            ConnectionIdMethod::BlockCipher => {\n                let bytes = cnx_id.as_bytes();\n                let mut decoded = [0u8; 16];\n                decoded.copy_from_slice(&bytes[1..17]);\n                let dec = self.cid_decryption_context.as_ref().unwrap();\n                dec.process(&mut decoded);\n                let mut s_id64: u64 = 0;\n                for b in decoded.iter().take(self.server_id_length) {\n                    s_id64 <<= 8;\n                    s_id64 += *b as u64;\n                }\n                s_id64\n            }\n        };\n        Some(s_id64)\n    }\n}\n\nimpl Quic {\n    /// Apply `lb_config` to `self`, installing a [`ConnectionIdContext`]\n    /// as the connection-ID callback context.\n    /// C: `lb_compat_cid_config`.\n    ///\n    /// Returns `Err` when `self` already has a different CID\n    /// callback configured, when the requested CID length doesn't\n    /// fit the chosen method, or when the AES context allocation\n    /// fails.\n    pub fn set_lb_cid_config(&mut self, lb_config: &Config) -> Result<(), Error> {\n        if !self.connections.is_empty()\n            && self.local_connection_id_length as usize != lb_config.connection_id_length\n        {\n            return Err(Error::InvalidState);\n        }\n        if self.connection_id_callback_fn.is_some() && self.connection_id_callback_ctx.is_some() {\n            return Err(Error::InvalidState);\n        }\n        if lb_config.connection_id_length > CONNECTION_ID_MAX_SIZE {\n            return Err(Error::InvalidArgument);\n        }\n        match lb_config.method {\n            ConnectionIdMethod::Clear => {\n                if lb_config.server_id_length + 1 > lb_config.connection_id_length {\n                    return Err(Error::InvalidArgument);\n                }\n            }\n            ConnectionIdMethod::StreamCipher => {\n                if lb_config.nonce_length < 8\n                    || lb_config.nonce_length > 16\n                    || lb_config.nonce_length + lb_config.server_id_length + 1\n                        > lb_config.connection_id_length\n                {\n                    return Err(Error::InvalidArgument);\n                }\n            }\n            ConnectionIdMethod::BlockCipher => {\n                if lb_config.connection_id_length < 17 || lb_config.server_id_length > 15 {\n                    return Err(Error::InvalidArgument);\n                }\n            }\n        }\n\n        // Encode server_id as big-endian bytes.\n        let mut server_id_encoded = [0u8; 16];\n        let mut s_id64 = lb_config.server_id;\n        for i in 0..lb_config.server_id_length {\n            let j = lb_config.server_id_length - i - 1;\n            server_id_encoded[j] = s_id64 as u8;\n            s_id64 >>= 8;\n        }\n        if s_id64 != 0 {\n            return Err(Error::InvalidArgument);\n        }\n\n        let cid_encryption_context = match lb_config.method {\n            ConnectionIdMethod::StreamCipher | ConnectionIdMethod::BlockCipher => Some(Box::new(\n                Aes128EcbContext::new(true, &lb_config.cid_encryption_key),\n            )),\n            ConnectionIdMethod::Clear => None,\n        };\n        let cid_decryption_context = match lb_config.method {\n            ConnectionIdMethod::BlockCipher => Some(Box::new(Aes128EcbContext::new(\n                false,\n                &lb_config.cid_encryption_key,\n            ))),\n            _ => None,\n        };\n\n        let context = ConnectionIdContext {\n            method: lb_config.method,\n            rotation_bits: lb_config.rotation_bits,\n            first_byte_encodes_length: lb_config.first_byte_encodes_length,\n            server_id_length: lb_config.server_id_length,\n            nonce_length: lb_config.nonce_length,\n            connection_id_length: lb_config.connection_id_length,\n            server_id: lb_config.server_id,\n            server_id_encoded,\n            cid_encryption_context,\n            cid_decryption_context,\n        };\n\n        self.local_connection_id_length = lb_config.connection_id_length as u8;\n        self.connection_id_callback_ctx = Some(Box::new(context));\n        Ok(())\n    }\n\n    /// Tear down the [`ConnectionIdContext`] previously installed by\n    /// [`Quic::set_lb_cid_config`], releasing the AES-ECB\n    /// encryption contexts and clearing the callback slot on\n    /// `self`.  No-op when no LB CID context is installed.\n    /// C: `lb_compat_cid_config_free`.\n    pub fn clear_lb_cid_config(&mut self) {\n        let is_lb = self\n            .connection_id_callback_ctx\n            .as_ref()\n            .is_some_and(|c| c.is::<ConnectionIdContext>());\n        if is_lb {\n            self.connection_id_callback_ctx = None;\n            self.connection_id_callback_fn = None;\n        }\n    }\n}\n\n#[cfg(test)]\nmod test {}\n","numLines":595,"startLine":1,"tot