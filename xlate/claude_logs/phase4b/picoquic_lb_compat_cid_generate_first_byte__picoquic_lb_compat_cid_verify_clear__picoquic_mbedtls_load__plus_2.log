o defines\n37\t * methods for generating retry tokens either by a protection box colocated with the\n38\t * load balancer, or at the individual server, with methods for letting individual\n39\t * servers retrieve information from the tokens.\n40\t */\n41\t\n42\tstatic void picoquic_lb_compat_cid_generate_first_byte(picoquic_quic_t* quic,\n43\t    picoquic_load_balancer_cid_context_t* lb_ctx, picoquic_connection_id_t* cnx_id_returned)\n44\t{\n45\t    if (lb_ctx->first_byte_encodes_length){\n46\t        cnx_id_returned->id[0] = ((uint8_t)lb_ctx->rotation_bits << 6) | ((uint8_t)quic->local_cnxid_length - 1);\n47\t    }\n48\t    else {\n49\t        cnx_id_returned->id[0] &= 0x3F;\n50\t        cnx_id_returned->id[0] |= ((uint8_t)lb_ctx->rotation_bits << 6);\n51\t    }\n52\t}\n53\t\n54\tstatic void picoquic_lb_compat_cid_generate_clear(picoquic_quic_t* quic,\n55\t    picoquic_load_balancer_cid_context_t * lb_ctx, picoquic_connection_id_t* cnx_id_returned)\n56\t{\n57\t    picoquic_lb_compat_cid_generate_first_byte(quic, lb_ctx, cnx_id_returned);\n58\t    memcpy(cnx_id_returned->id + 1, lb_ctx->server_id, lb_ctx->server_id_length);\n59\t}\n60\t\n61\tstatic void picoquic_lb_compat_cid_one_pass_stream(void * enc_ctx, uint8_t * nonce, size_t nonce_length, uint8_t * target, size_t target_length)\n62\t{\n63\t    uint8_t mask[16];\n64\t    /* Set the obfuscation value */\n65\t    memset(mask, 0, sizeof(mask));\n66\t    memcpy(mask, nonce, nonce_length);\n67\t    /* Encrypt with ECB */\n68\t    picoquic_aes128_ecb_encrypt(enc_ctx, mask, mask, sizeof(mask));\n69\t    /* Apply the mask */\n70\t    for (size_t i = 0; i < target_length; i++) {\n71\t        target[i] ^= mask[i];\n72\t    }\n73\t}\n74\t\n75\t/* Per specification:\n76\t * Stream Cipher CID {\n77\t *    First Octet (8),\n78\t *    Nonce (64..120),\n79\t *    Encrypted Server ID (8..128-len(Nonce)),\n80\t *    For Server Use (0..152-len(Nonce)-len(Encrypted Server ID)),\n81\t * }\n82\t */\n83\t\n84\tstatic void picoquic_lb_compat_cid_generate_stream_cipher(picoquic_quic_t* quic,\n85\t    picoquic_load_balancer_cid_context_t* lb_ctx, picoquic_connection_id_t* cnx_id_returned)\n86\t{\n87\t    size_t id_offset = ((size_t)1) + lb_ctx->nonce_length;\n88\t    /* Prepare a clear text server ID */\n89\t    picoquic_lb_compat_cid_generate_first_byte(quic, lb_ctx, cnx_id_returned);\n90\t    memcpy(cnx_id_returned->id + id_offset, lb_ctx->server_id, lb_ctx->server_id_length);\n91\t    /* First pass -- obtain intermediate server ID */\n92\t    picoquic_lb_compat_cid_one_pass_stream(lb_ctx->cid_encryption_context, cnx_id_returned->id + 1, lb_ctx->nonce_length,\n93\t        cnx_id_returned->id + id_offset, lb_ctx->server_id_length);\n94\t    /* Second pass -- obtain encrypted nonce */\n95\t    picoquic_lb_compat_cid_one_pass_stream(lb_ctx->cid_encryption_context, \n96\t        cnx_id_returned->id + id_offset, lb_ctx->server_id_length,\n97\t        cnx_id_returned->id + 1, lb_ctx->nonce_length);\n98\t    /* Third pass -- obtain encrypted server-id */\n99\t    picoquic_lb_compat_cid_one_pass_stream(lb_ctx->cid_encryption_context, cnx_id_returned->id + 1, lb_ctx->nonce_length,\n100\t        cnx_id_returned->id + id_offset, lb_ctx->server_id_length);\n101\t}\n102\t\n103\t/* Per specification:\n104\t * Block Cipher CID {\n105\t *    First Octet (8),\n106\t *    Encrypted Server ID (8..128),\n107\t *    Encrypted Bits for Server Use (128-len(Encrypted Server ID)),\n108\t *    Unencrypted Bits for Server Use (0..24),\n109\t * }\n110\t * In theory, the \"server use\" bits should just be set to a random value.\n111\t * For tests, the server use bits have to be set to a specific value.\n112\t */\n113\tstatic void picoquic_lb_compat_cid_generate_block_cipher(picoquic_quic_t* quic,\n114\t    picoquic_load_balancer_cid_context_t* lb_ctx, picoquic_connection_id_t* cnx_id_returned)\n115\t{\n116\t    picoquic_lb_compat_cid_generate_first_byte(quic, lb_ctx, cnx_id_returned);\n117\t    /* Copy the server ID */\n118\t    memcpy(cnx_id_returned->id + 1, lb_ctx->server_id, lb_ctx->server_id_length);\n119\t    /* encrypt 16 bytes */\n120\t    picoquic_aes128_ecb_encrypt(lb_ctx->cid_encryption_context, cnx_id_returned->id + 1, cnx_id_returned->id + 1, 16);\n121\t}\n122\t\n123\t/* This code assumes that the cnx_id_returned value is pre-filled with\n124\t * the expected values of nonces or local-use content.\n125\t */\n126\tvoid picoquic_lb_compat_cid_generate(picoquic_quic_t* quic, picoquic_connection_id_t UNUSED(cnx_id_local),\n127\t    picoquic_connection_id_t UNUSED(cnx_id_remote), void* cnx_id_cb_data, picoquic_connection_id_t* cnx_id_returned)\n128\t{\n129\t    picoquic_load_balancer_cid_context_t* lb_ctx = (picoquic_load_balancer_cid_context_t*)cnx_id_cb_data;\n130\t#ifdef _WINDOWS\n131\t    UNREFERENCED_PARAMETER(cnx_id_local);\n132\t    UNREFERENCED_PARAMETER(cnx_id_remote);\n133\t#endif\n134\t    switch (lb_ctx->method) {\n135\t    case picoquic_load_balancer_cid_clear:\n136\t        picoquic_lb_compat_cid_generate_clear(quic, lb_ctx, cnx_id_returned);\n137\t        break;\n138\t    case picoquic_load_balancer_cid_stream_cipher:\n139\t        picoquic_lb_compat_cid_generate_stream_cipher(quic, lb_ctx, cnx_id_returned);\n140\t        break;\n141\t    case picoquic_load_balancer_cid_block_cipher:\n142\t        picoquic_lb_compat_cid_generate_block_cipher(quic, lb_ctx, cnx_id_returned);\n143\t        break;\n144\t    default:\n145\t        /* Error, unknown method */\n146\t        break;\n147\t    }\n148\t}\n149\t\n150\tstatic uint64_t picoquic_lb_compat_cid_verify_clear(\n151\t    picoquic_load_balancer_cid_context_t* lb_ctx, picoquic_connection_id_t const* cnx_id)\n152\t{\n153\t    uint64_t s_id64 = 0;\n154\t\n155\t    for (size_t i = 0; i < lb_ctx->server_id_length; i++) {\n156\t        s_id64 <<= 8;\n157\t        s_id64 += cnx_id->id[i + 1];\n158\t    }\n159\t\n160\t    return s_id64;\n161\t}\n162\t\n163\tstatic uint64_t picoquic_lb_compat_cid_verify_stream_cipher(\n164\t    picoquic_load_balancer_cid_context_t* lb_ctx, picoquic_connection_id_t const* cnx_id)\n165\t{\n166\t    size_t id_offset = ((size_t)1) + lb_ctx->nonce_length;\n167\t    uint64_t s_id64 = 0;\n168\t    picoquic_connection_id_t target = *cnx_id;\n169\t    /* First pass -- obtain intermediate server ID */\n170\t    picoquic_lb_compat_cid_one_pass_stream(lb_ctx->cid_encryption_context, target.id + 1, lb_ctx->nonce_length,\n171\t        target.id + id_offset, lb_ctx->server_id_length);\n172\t    /* Second pass -- obtain nonce */\n173\t    picoquic_lb_compat_cid_one_pass_stream(lb_ctx->cid_encryption_context,\n174\t        target.id + id_offset, lb_ctx->server_id_length, target.id + 1, lb_ctx->nonce_length);\n175\t    /* First pass -- obtain server-id */\n176\t    picoquic_lb_compat_cid_one_pass_stream(lb_ctx->cid_encryption_context, target.id + 1, lb_ctx->nonce_length,\n177\t        target.id + id_offset, lb_ctx->server_id_length);\n178\t\n179\t    /* decode the server ID */\n180\t    for (size_t i = 0; i < lb_ctx->server_id_length; i++) {\n181\t        s_id64 <<= 8;\n182\t        s_id64 += target.id[id_offset + i];\n183\t    }\n184\t\n185\t    return s_id64;\n186\t}\n187\t\n188\tstatic uint64_t picoquic_lb_compat_cid_verify_block_cipher(\n189\t    picoquic_load_balancer_cid_context_t* lb_ctx, picoquic_connection_id_t const* cnx_id)\n190\t{\n191\t    uint8_t decoded[16];\n192\t    uint64_t s_id64 = 0;\n193\t\n194\t    /* decrypt 16 bytes */\n195\t    picoquic_aes128_ecb_encrypt(lb_ctx->cid_decryption_context, decoded, cnx_id->id + 1, 16);\n196\t    /* Decode the server ID */\n197\t    if (s_id64 == 0) {\n198\t        for (size_t i = 0; i < lb_ctx->server_id_length; i++) {\n199\t            s_id64 <<= 8;\n200\t            s_id64 += decoded[i];"}]},"parent_tool_use_id":null,"session_id":"7a2ce5ec-3f9a-4edb-bf74-55e2a91d488d","uuid":"24270173-1f2d-425e-8d55-0171d328d7d8","timestamp":"2026-05-07T06:39:29.510Z","tool_use_result":{"type":"text","file":{"filePath":"/Users/ri