fined(PTLS_WITHOUT_FUSION)\n43\t#ifdef _WINDOWS\n44\t#pragma warning(disable:4324)\n45\t#endif\n46\t#include \"picotls/fusion.h\"\n47\t\n48\t/* Declaration of the function `picoquic_get_hash_algorithm_by_name`, which the code\n49\t* uses to complete the declaration of the cipher suites. This is a bit of a hack: it\n50\t* only works if `picoquic_ptls_fusion_load` is called after loading other providers\n51\t* like `openssl` or `minicrypto`, that will have registered ciphersuites for\n52\t* AES_128_GCM_SHA256 and AES_256_GCM_SHA384.\n53\t*/\n54\tptls_hash_algorithm_t* picoquic_get_hash_algorithm_by_name(const char* hash_algorithm_name);\n55\t\n56\tstruct st_ptls_cipher_suite_t picoquic_fusion_aes128gcmsha256 = { PTLS_CIPHER_SUITE_AES_128_GCM_SHA256, &ptls_fusion_aes128gcm,\n57\tNULL };\n58\tstruct st_ptls_cipher_suite_t picoquic_fusion_aes256gcmsha384 = { PTLS_CIPHER_SUITE_AES_256_GCM_SHA384, &ptls_fusion_aes256gcm,\n59\tNULL };\n60\t\n61\tvoid picoquic_ptls_fusion_load(int unload)\n62\t{\n63\t    if (unload) {\n64\t        /* Nothing to do */\n65\t    }\n66\t    else {\n67\t        if (ptls_fusion_is_supported_by_cpu()) {\n68\t            if ((picoquic_fusion_aes128gcmsha256.hash = picoquic_get_hash_algorithm_by_name(\"SHA256\")) != NULL) {\n69\t                picoquic_register_ciphersuite((ptls_cipher_suite_t*)&picoquic_fusion_aes128gcmsha256, 0);\n70\t            }\n71\t            if ((picoquic_fusion_aes256gcmsha384.hash = picoquic_get_hash_algorithm_by_name(\"SHA384\")) != NULL) {\n72\t                picoquic_register_ciphersuite(&picoquic_fusion_aes256gcmsha384, 0);\n73\t            }\n74\t        }\n75\t    }\n76\t}\n77\t#else\n78\tvoid picoquic_ptls_fusion_load(int UNUSED(unload))\n79\t{\n80\t#ifdef _WINDOWS\n81\t    UNREFERENCED_PARAMETER(unload);\n82\t#endif\n83\t    /* Nothing to do, as the module is not loaded. */\n84\t}\n85\t#endif\n86\t"}]},"parent_tool_use_id":null,"session_id":"7a2ce5ec-3f9a-4edb-bf74-55e2a91d488d","uuid":"7a84ac8d-bf3d-4b96-8f8e-f8