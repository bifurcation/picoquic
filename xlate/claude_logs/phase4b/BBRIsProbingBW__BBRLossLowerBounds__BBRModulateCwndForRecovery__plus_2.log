{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_012f3pnqxq4yS9tV17ihiXnJ","type":"tool_result","content":"300\t    }\n301\t\n302\t    /// C: `BBRCheckStartupFullBandwidth` (picoquic/bbr.c:2020)\n303\t    pub fn check_startup_full_bandwidth(&mut self, rs: &BbrPerAckState) {\n304\t        if self.filled_pipe || !self.round_start || rs.is_app_limited {\n305\t            return;\n306\t        }\n307\t        // 5/4 integer approximation of ×1.25 avoids floating-point drift.\n308\t        if 4 * self.max_bw >= 5 * self.full_bw {\n309\t            // still growing\n310\t            self.full_bw = self.max_bw;\n311\t            self.full_bw_count = 0;\n312\t            if rs.ecn_frac < 0.2 {\n313\t                return;\n314\t            }\n315\t        }\n316\t        self.full_bw_count += 1; // another round without much growth\n317\t        if self.full_bw_count >= 3 || rs.ecn_frac >= BBR_EXCESSIVE_ECN_CE {\n318\t            self.filled_pipe = true;\n319\t        }\n320\t    }\n321\t\n322\t    /// C: `BBRCheckAppLimitedEnded` (picoquic/bbr.c:1747)\n323\t    ///\n324\t    /// Tracks per-round app-limited state.  Returns `true` on the first\n325\t    /// round where the app is *not* limited after having been limited for\n326\t    /// more than `BBR_APP_LIMITED_ROUNDS_THRESHOLD` consecutive rounds.\n327\t    pub fn check_app_limited_ended(&mut self, rs: &BbrPerAckState) -> bool {\n328\t        let mut app_limited_ended = false;\n329\t        if self.round_start {\n330\t            if self.app_limited_this_round != 0 {\n331\t                self.app_limited_round_count += 1;\n332\t            } else {\n333\t                app_limited_ended = self.app_limited_round_count > BBR_APP_LIMITED_ROUNDS_THRESHOLD;\n334\t                self.app_limited_round_count = 0;\n335\t            }\n336\t            self.app_limited_this_round = 0;\n337\t        } else {\n338\t            self.app_limited_this_round |= rs.is_app_limited as i32;\n339\t        }\n340\t        app_limited_ended\n341\t    }\n342\t\n343\t    /// C: `BBRExitLostFeedback` (picoquic/bbr.c:782)\n344\t    ///\n345\t    /// Restore the congestion window saved by `BBREnterLostFeedback` and\n346\t    /// clear the lost-feedback flag.  No-op if the flag is not set.\n347\t    pub fn exit_lost_feedback(&mut self, path_x: &mut Path) {\n348\t        if self.is_handling_lost_feedback {\n349\t            path_x.cwin = self.cwin_before_lost_feedback;\n350\t            self.is_handling_lost_feedback = false;\n351\t        }\n352\t    }\n353\t\n354\t    /// C: `BBRHasElapsedInPhase` (picoquic/bbr.c:1776)\n355\t    ///\n356\t    /// Returns `true` when `current_time` has advanced past\n357\t    /// `cycle_stamp + interval`.  Used to decide when to transition from\n358\t    /// DOWN/CRUISE to REFILL in the probe-BW cycle.\n359\t    pub(crate) fn has_elapsed_in_phase(&self, interval: u64, current_time: u64) -> bool {\n360\t        current_time > self.cycle_stamp + interval\n361\t    }\n362\t\n363\t    /// C: `BBREnterStartupResume` (picoquic/bbr.c:1972)\n364\t    ///\n365\t    /// Enter `StartupResume` state, which uses Hystart-like pacing gains\n366\t    /// to resume quickly after a suspension.  Called either when a BDP\n367\t    /// seed is set or on the initial `EnterStartup` path when a seed\n368\t    /// exists.\n369\t    pub(crate) fn enter_startup_resume(&mut self) {\n370\t        self.state = BbrAlgState::StartupResume;\n371\t        self.pacing_gain = BBR_STARTUP_RESUME_PACING_GAIN;\n372\t        self.cwnd_gain = BBR_STARTUP_RESUME_CWND_GAIN;\n373\t    }\n374\t\n375\t    /// C: `BBREnterStartup` (picoquic/bbr.c:2061)\n376\t    ///\n377\t    /// Enter normal `Startup` state with the standard pacing and cwnd\n378\t    /// gains.  Sets `is_cca_probing_up` to inform the transport that the\n379\t    /// congestion controller is actively probing for more bandwidth.\n380\t    pub fn enter_startup(&mut self, path_x: &mut Path) {\n381\t        self.state = BbrAlgState::Startup;\n382\t        self.pacing_gain = BBR_STARTUP_PACING_GAIN;\n383\t        self.cwnd_gain = BBR_STARTUP_CWND_GAIN;\n384\t        path_x.is_cca_probing_up = true;\n385\t    }\n386\t\n387\t    /// C: `BBREnterStartupLongRTT` (picoquic/bbr.c:2080)\n388\t    ///\n389\t    /// Enter `StartupLongRTT` state, which uses Hystart rather than the\n390\t    /// normal BBR Startup algorithm.  The initial congestion window is\n391\t    /// scaled up from `CWIN_INITIAL` proportional to `rtt_min` (capped at\n392\t    /// the satellite-RTT ceiling) and then further boosted by the BDP seed\n393\t    /// when available.\n394\t    pub fn enter_startup_long_rtt(&mut self, path_x: &mut Path) {\n395\t        let mut cwnd = CWIN_INITIAL;\n396\t        self.state = BbrAlgState::StartupLongRtt;\n397\t        if path_x.rtt_min > TARGET_RENO_RTT {\n398\t            let rtt_cap = if path_x.rtt_min > TARGET_SATELLITE_RTT {\n399\t                TARGET_SATELLITE_RTT\n400\t            } else {\n401\t                path_x.rtt_min\n402\t            };\n403\t            cwnd = (cwnd as f64 * rtt_cap.ticks() as f64 / TARGET_RENO_RTT.ticks() as f64) as u64;\n404\t        }\n405\t        if cwnd < self.bdp_seed {\n406\t            cwnd = self.bdp_seed;\n407\t        }\n408\t        if cwnd > path_x.cwin {\n409\t            path_x.cwin = cwnd;\n410\t        }\n411\t        path_x.is_cca_probing_up = true;\n412\t    }\n413\t\n414\t    /// C: `BBRInitFullPipe` (picoquic/bbr.c:434)\n415\t    ///\n416\t    /// Reset the \"pipe full\" bandwidth-growth detector to its initial state.\n417\t    pub fn init_full_pipe(&mut self) {\n418\t        self.filled_pipe = false;\n419\t        self.full_bw = 0;\n420\t        self.full_bw_count = 0;\n421\t    }\n422\t\n423\t    /// C: `BBRInitLowerBounds` (picoquic/bbr.c:1025)\n424\t    ///\n425\t    /// On the first congestion episode in a cycle, latch `bw_lo` to\n426\t    /// `max_bw` and `inflight_lo` to `cwin` (the UINT64_MAX sentinel\n427\t    /// means \"not yet initialised\").\n428\t    pub fn init_lower_bounds(&mut self, path_x: &Path) {\n429\t        if self.bw_lo == u64::MAX {\n430\t            self.bw_lo = self.max_bw;\n431\t        }\n432\t        if self.inflight_lo == u64::MAX {\n433\t            self.inflight_lo = path_x.cwin;\n434\t        }\n435\t    }\n436\t\n437\t    /// C: `BBRInitPacingRate` (picoquic/bbr.c:933)\n438\t    ///\n439\t    /// Set the initial pacing rate based on the nominal bandwidth at\n440\t    /// `INITIAL_RTT` (250 ms), unless the path already has a real RTT\n441\t    /// estimate, in which case that estimate is used instead.\n442\t    pub fn init_pacing_rate(&mut self, path_x: &Path) {\n443\t        let initial_rtt = if path_x.smoothed_rtt != INITIAL_RTT || path_x.rtt_variant.ticks() != 0 {\n444\t            path_x.smoothed_rtt.ticks()\n445\t        } else {\n446\t            INITIAL_RTT.ticks()\n447\t        };\n448\t        let nominal_bandwidth = (1_000_000u64 * CWIN_INITIAL) as f64 / initial_rtt as f64;\n449\t        self.pacing_rate = BBR_STARTUP_PACING_GAIN * nominal_bandwidth;\n450\t    }\n451\t\n452\t    /// C: `BBRInitRandom` (picoquic/bbr.c:421)\n453\t    ///\n454\t    /// Seed `random_context` from the current time, connection role, and\n455\t    /// path ID so that tests remain deterministic while production runs\n456\t    /// diverge.  `connection` is passed separately because `Path` carries\n457\t    /// no back-pointer to its owning `Connection` in Rust.\n458\t    pub fn init_random(&mut self, connection: &Connection, path_x: &Path, current_time: u64) {\n459\t        let mut ctx: u64 = 0xfedcba9876543210;\n460\t        ctx ^= current_time;\n461\t        if connection.client_mode {\n462\t            ctx = ctx.wrapping_add(0x0123456789abcdef);\n463\t        }\n464\t        if path_x.unique_path_id > 0 && path_x.unique_path_id != u64::MAX {\n465\t            ctx = ctx.wrapping_mul(path_x.unique_path_id.wrapping_add(1));\n466\t        }\n467\t        self.random_context = ctx;