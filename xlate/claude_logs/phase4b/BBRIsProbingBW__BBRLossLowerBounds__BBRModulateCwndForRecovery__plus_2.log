anceLatestDeliverySignals` (picoquic/bbr.c:1007)\n220\t    ///\n221\t    /// Called near the end of ACK processing: if this ACK completed a\n222\t    /// loss round, reset `bw_latest` and `inflight_latest` to the\n223\t    /// current sample so the next round starts fresh.\n224\t    pub fn advance_latest_delivery_signals(&mut self, rs: &BbrPerAckState) {\n225\t        if self.loss_round_start {\n226\t            self.bw_latest = rs.delivery_rate;\n227\t            self.inflight_latest = rs.delivered;\n228\t        }\n229\t    }\n230\t\n231\t    /// C: `BBRBDPMultipleWithBw` (picoquic/bbr.c:869)\n232\t    ///\n233\t    /// Returns `gain × BDP` computed at the supplied `bw` rather than\n234\t    /// `self.bw`.  When `min_rtt` has never been measured (`u64::MAX`),\n235\t    /// returns the initial congestion window as a safe floor.\n236\t    ///\n237\t    /// Side-effect: writes `self.bdp` so callers can read the raw BDP\n238\t    /// estimate after the call (mirrors C's write-through of\n239\t    /// `bbr_state->bdp`).\n240\t    pub fn bdp_multiple_with_bw(&mut self, path_x: &Path, gain: f64, bw: u64) -> u64 {\n241\t        if self.min_rtt == u64::MAX {\n242\t            return CWIN_INITIAL * path_x.send_mtu as u64;\n243\t        }\n244\t        // PICOQUIC_BYTES_FROM_RATE(min_rtt_us, bps) = min_rtt * bps / 1_000_000\n245\t        self.bdp = self.min_rtt * bw / 1_000_000;\n246\t        (gain * self.bdp as f64) as u64\n247\t    }\n248\t\n249\t    /// C: `BBRBoundBWForModel` (picoquic/bbr.c:1094)\n250\t    ///\n251\t    /// Set `self.bw = min(max_bw, bw_lo, bw_hi)`.  `bw_hi` is only\n252\t    /// applied when non-zero; the zero check preserves compatibility\n253\t    /// with states where `bw_hi` is not yet initialised (noted as a\n254\t    /// TODO in the C source).\n255\t    pub fn bound_bw_for_model(&mut self) {\n256\t        self.bw = self.max_bw;\n257\t        if self.bw > self.bw_lo {\n258\t            self.bw = self.bw_lo;\n259\t        }\n260\t        // TODO: r