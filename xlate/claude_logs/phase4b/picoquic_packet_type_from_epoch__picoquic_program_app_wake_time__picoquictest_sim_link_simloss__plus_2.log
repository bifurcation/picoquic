ckets) {\n                    ctx.close();\n                }\n                return Err(error);\n            }\n            if current_port == 0 {\n                current_port = s_ctx[nb_sockets].port;\n                s_ctx[nb_sockets].n_port = current_port.to_be();\n            }\n            nb_sockets += 1;\n\n            if public_port != 0 {\n                if nb_sockets >= s_ctx.len() {\n                    for ctx in s_ctx.iter_mut().take(nb_sockets) {\n                        ctx.close();\n                    }\n                    return Err(Error::BufferTooSmall);\n                }\n                s_ctx[nb_sockets] = SocketCtx::default();\n                s_ctx[nb_sockets].af = socket_af;\n                s_ctx[nb_sockets].port = public_port;\n                s_ctx[nb_sockets].n_port = public_port.to_be();\n                s_ctx[nb_sockets].is_port_shared = is_shared;\n\n                if let Err(error) = open_socket(\n                    socket_buffer_size,\n                    do_not_use_gso,\n                    &mut s_ctx[nb_sockets],\n                    ecn_value,\n                ) {\n                    for ctx in s_ctx.iter_mut().take(nb_sockets) {\n                        ctx.close();\n                    }\n                    return Err(error);\n                }\n                nb_sockets += 1;\n            }\n        }\n        current_port = 0;\n    }\n\n    Ok(nb_sockets)\n}\n\n#[cfg(test)]\nmod test {}\n","structuredPatch":[{"oldStart":674,"oldLines":6,"newStart":674,"newLines":18,"lines":["     Ok(None)"," }"," ","+/// Close the wake-up channel for the network thread context and mark it","+/// as undefined.","+///","+/// C: `picoquic/sockloop.c:picoquic_close_network_wake_up`.","+fn close_network_wake_up(thread_ctx: &mut NetworkThreadCtx) {","+    if thread_ctx.wake_up_defined {","+        thread_ctx.wake_up_sender = None;","+        thread_ctx.wake_up_receiver = None;","+        thread_ctx.wake_up_defined = false;","+    }","+}"