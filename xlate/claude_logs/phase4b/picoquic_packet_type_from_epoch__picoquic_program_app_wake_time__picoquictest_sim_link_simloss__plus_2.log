{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_014nfEKW2KHCXndDmGcr1VZW","type":"tool_result","content":"248\t}\n249\t\n250\timpl TestSimLink {\n251\t    // -----------------------------------------------------------------------\n252\t    // Private helpers.\n253\t\n254\t    fn sim_testloss(&mut self) -> bool {\n255\t        if let Some(mask) = self.loss_mask.as_mut() {\n256\t            let loss_bit = *mask & 1;\n257\t            *mask = (*mask >> 1) | (loss_bit << 63);\n258\t            loss_bit != 0\n259\t        } else {\n260\t            false\n261\t        }\n262\t    }\n263\t\n264\t    fn sim_simloss(&mut self, current_time: Instant) -> bool {\n265\t        if self.nb_loss_in_burst == 0 {\n266\t            return false;\n267\t        }\n268\t        let ct = current_time.ticks();\n269\t        if self.packets_sent > self.packets_sent_next_burst {\n270\t            let picosec_wait = self.nb_loss_in_burst * self.picosec_per_byte * 1536;\n271\t            self.packets_sent_next_burst = self.packets_sent + self.packets_between_losses;\n272\t            self.nb_losses_this_burst = self.nb_loss_in_burst - 1;\n273\t            self.end_of_burst_time = Instant::from_ticks(ct + picosec_wait / 1_000_000);\n274\t            true\n275\t        } else if self.nb_losses_this_burst > 0 {\n276\t            if ct > self.end_of_burst_time.ticks() {\n277\t                self.nb_losses_this_burst = 0;\n278\t                false\n279\t            } else {\n280\t                self.nb_losses_this_burst -= 1;\n281\t                true\n282\t            }\n283\t        } else {\n284\t            false\n285\t        }\n286\t    }\n287\t\n288\t    fn sim_wifi_jitter(&mut self) -> u64 {\n289\t        const EXP_MINUS_1: u64 = 395007542;\n290\t        const PRIMARY: u64 = 1000;\n291\t        let n1 = test_poisson_random(&mut self.jitter_seed, EXP_MINUS_1);\n292\t        let mut jitter = n1 * PRIMARY;\n293\t        if n1 > 0 {\n294\t            jitter = jitter.saturating_sub(test_uniform_random(&mut self.jitter_seed, PRIMARY));\n295\t        }\n296\t        if self.jitter > 1000 {\n297\t            let r = test_random(&mut self.jitter_seed);\n298\t            let r = (r ^ (r >> 30)) & 0x3fffffff;\n299\t            let r_scaled = r.wrapping_mul(84000);\n300\t            if r_scaled < ((self.jitter - 1000) << 30) {\n301\t                const EXP_MINUS_12: u64 = 6597;\n302\t                const SECONDARY: u64 = 7500;\n303\t                let n2 = test_poisson_random(&mut self.jitter_seed, EXP_MINUS_12);\n304\t                jitter += n2 * SECONDARY;\n305\t                if n2 > 1 {\n306\t                    jitter = jitter\n307\t                        .saturating_sub(test_uniform_random(&mut self.jitter_seed, SECONDARY));\n308\t                }\n309\t            }\n310\t        }\n311\t        jitter\n312\t    }\n313\t\n314\t    fn sim_jitter(&mut self) -> u64 {\n315\t        if self.jitter_mode == JitterMode::Wifi {\n316\t            self.sim_wifi_jitter()\n317\t        } else {\n318\t            let x = test_gauss_random(&mut self.jitter_seed).max(-3.0) / 3.0;\n319\t            let j = self.jitter as i64;\n320\t            (j + (x * j as f64) as i64).max(0) as u64\n321\t        }\n322\t    }\n323\t\n324\t    // -----------------------------------------------------------------------\n325\t    // Public API.\n326\t\n327\t    /// Create a sim link at `current_time`, with the given data\n328\t    /// rate (in gigabits per second) and one-way latency (in\n329\t    /// microseconds).  C: `picoquictest_sim_link_create`.\n330\t    ///\n331\t    /// `loss_mask` is the test's 64-bit error mask; `None` matches\n332\t    /// the C `NULL` (no mask).\n333\t    pub fn create(\n334\t        data_rate_in_gbps: f64,\n335\t        microsec_latency: u64,\n336\t        loss_mask: Option<u64>,\n337\t        queue_delay_max: u64,\n338\t        current_time: Instant,\n339\t    ) -> Result<Self, crate::Error> {\n340\t        let pico_d =