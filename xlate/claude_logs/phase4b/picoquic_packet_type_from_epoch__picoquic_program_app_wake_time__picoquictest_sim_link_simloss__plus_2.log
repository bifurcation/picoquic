{"type":"assistant","message":{"model":"claude-sonnet-4-6","id":"msg_018ikYaf3ZbNPELJGXnyDtK3","type":"message","role":"assistant","content":[{"type":"tool_use","id":"toolu_01VLaCwF8mgKF2aSTUn8XsUL","name":"Edit","input":{"replace_all":false,"file_path":"/Users/richbarn/Projects/picoquic/rs/fq/src/tests/harness.rs","old_string":"//! Test cases for the simulator harness in `picoquic/sim_link.c`.\n\n#![allow(non_snake_case)]\n\nuse crate::tests::util::{TestSimLink, TestSimPacket};\nuse crate::{Instant, MAX_PACKET_SIZE};","new_string":"//! Test cases for the simulator harness in `picoquic/sim_link.c`.\n\n#![allow(non_snake_case)]\n\nuse crate::tests::util::{TestSimLink, TestSimPacket};\nuse crate::{Instant, MAX_PACKET_SIZE};\n\n/// Consume one bit of the 64-bit rotating loss mask and return whether\n/// this packet should be lost.  Returns `false` when `loss_mask` is\n/// `None` (matching the C `NULL` case).\n///\n/// C: `picoquic/sim_link.c:picoquictest_sim_link_testloss`.\nfn testloss(loss_mask: &mut Option<u64>) -> bool {\n    if let Some(mask) = loss_mask.as_mut() {\n        let loss_bit = *mask & 1;\n        *mask = (*mask >> 1) | (loss_bit << 63);\n        loss_bit != 0\n    } else {\n        false\n    }\n}\n\n/// Determine whether the current packet should be dropped according to\n/// the link's burst-loss model.\n///\n/// C: `picoquic/sim_link.c:picoquictest_sim_link_simloss`.\nfn simloss(link: &mut TestSimLink, current_time: Instant) -> bool {\n    if link.nb_loss_in_burst == 0 {\n        return false;\n    }\n    let ct = current_time.ticks();\n    if link.packets_sent > link.packets_sent_next_burst {\n        let picosec_wait = link.nb_loss_in_burst * link.picosec_per_byte * 1536;\n        link.packets_sent_next_burst = link.packets_sent + link.packets_between_losses;\n        link.nb_losses_this_burst = link.nb_loss_in_burst - 1;\n        link.end_of_burst_time = Instant::from_ticks(ct + picosec_wait / 1_000_000);\n        true\n    } else if link.nb_losses_this_burst > 0 {\n        if ct > link.end_of_burst_time.ticks() {\n            link.nb_losses_this_burst = 0;\n            false\n        } else {\n            link.nb_losses_this_burst -= 1;\n            true\n        }\n    } else {\n        false\n    }\n}"},"caller":{"type":"direct"}}],"stop_reason":null,"stop_sequence":null,"stop_details":null,"usage":{"input_tokens":1,"cache_creation_input_tokens":156,"cache_read_input_tokens":57307,"cache_creation":{"ephemeral_5m_input_tokens":0,"ephemeral_1h_input_tokens":156},"output_tokens":72,"service_tier":"standard","inference_geo":"not_available"},"context_management":null},"parent_tool_use_id":null,"session_id":"a55e6d46-26e5-49d5-b365-b1275ce83ce6","uuid":"74641224-bc82-4b10-abbe-ea27fbc65e99"}
{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01VLaCwF8mgKF2aSTUn8XsUL","type":"tool_result","content":"The file /Users/richbarn/Projects/picoquic/rs/fq/src/tests/harness.rs has been updated successfully. (file state is current in your context — no need to Read it back)"}]},"parent_tool_use_id":null,"session_id":"a55e6d46-26e5-49d5-b365-b1275ce83ce6","uuid":"6a6815db-f32f-4779-8d8d-42b40a592283","timestamp":"2026-05-07T09:20:19.487Z","tool_use_result":{"filePath":"/Users/richbarn/Projects/picoquic/rs/fq/src/tests/harness.rs","oldString":"//! Test cases for the simulator harness in `picoquic/sim_link.c`.\n\n#![allow(non_snake_case)]\n\nuse crate::tests::util::{TestSimLink, TestSimPacket};\nuse crate::{Instant, MAX_PACKET_SIZE};","newString":"//! Test cases for the simulator harness in `picoquic/sim_link.c`.\n\n#![allow(non_snake_case)]\n\nuse crate::tests::util::{TestSimLink, TestSimPacket};\nuse crate::{Instant, MAX_PACKET_SIZE};\n\n/// Consume one bit of the 64-bit rotating loss mask and return whether\n/// this packet should be lost.  Returns `false` when `loss_mask` is\n/// `None` (matching the C `NULL` case).\n///\n/// C: `picoquic/sim_link.c:picoquictest_sim_link_testloss`.\nfn testloss(loss_mask: &mut Option<u64>) -> bool {\n    if let Some(mask) = loss_mask.as_mut() {\n        let loss_bit = *mask & 1;\n        *mask = (*mask >> 1) | (loss_bit << 63);\n        loss_bit != 0\n    } else {\n        false\n    }\n}\n\n/// Determine whether the current packet should be dropped according to\n/// the link's burst-loss model.\n///\n/// C: `picoquic/sim_link.c:picoquictest_sim_link_simloss`.\nfn simloss(link: &mut TestSimLink, current_time: Instant) -> bool {\n    if link.nb_loss_in_burst == 0 {\n        return false;\n    }\n    let ct = current_time.ticks();\n    if link.packets_sent > link.packets_sent_next_burst {\n        let picosec_wait = link.nb_loss_in_burst * link.picosec_per_byte * 1536;\n        link.packets_sent_next_burst = link.packets_sent + link.packets_between_losses;\n        link.nb_losses_this_burst = link.nb_loss_in_burst - 1;\n        link.end_of_burst_time = Instant::from_ticks(ct + picosec_wait / 1_000_000);\n        true\n    } else if link.nb_losses_this_burst > 0 {\n        if ct > link.end_of_burst_time.ticks() {\n            link.nb_losses_this_burst = 0;\n            false\n        } else {\n            link.nb_losses_this_burst -= 1;\n            true\n        }\n    } else {\n        false\n    }\n}","originalFile":"//! Test cases for the simulator harness in `picoquic/sim_link.c`.\n\n#![allow(non_snake_case)]\n\nuse crate::tests::util::{TestSimLink, TestSimPacket};\nuse crate::{Instant, MAX_PACKET_SIZE};\n\n/// C: `sim_link_one_test` in `picoquic/sim_link.c`.\nfn sim_link_one_test(loss_mask: Option<u64>, queue_delay_max: u64, nb_losses: u64) {\n    let mut departure_time = Instant::from_ticks(0);\n    let mut link = TestSimLink::create(\n        0.01,\n        10_000,\n        loss_mask,\n        queue_delay_max,\n        Instant::from_ticks(0),\n    )\n    .expect(\"sim link allocation\");\n    let mut dequeued = 0u64;\n    let mut queued = 0u64;\n    const NB_PACKETS: u64 = 16;\n\n    loop {\n        if queued >= NB_PACKETS {\n            departure_time = Instant::from_ticks(u64::MAX);\n        }\n\n        let current_time = Instant::from_ticks(link.next_arrival(departure_time));\n\n        if let Some(_packet) = link.dequeue(current_time) {\n            dequeued += 1;\n        } else if queued < NB_PACKETS {\n            let mut packet = TestSimPacket::create().expect(\"sim packet allocation\");\n            packet.length = MAX_PACKET_SIZE;\n            link.submit(packet, departure_time);\n            departure_time = Instant::from_ticks(departure_time.ticks() + 250);\n            queued += 1;\n        } else {\n            break;\n        }\n    }\n\n    assert_eq!(\n        dequeued + nb_losses,\n        NB_PACKETS,\n        \"unexpected sim-link delivery count\",\n    );\n}\n\n/// C: `sim_link_test` in `picoquictest/<harness>.c`.\n#[test]\nfn sim_link() {\n    sim_link_one_test(Some(0), 0, 0);\n    sim_link_one_test(Some(8), 0, 1);\n    sim_link_one_test(Some(0x18), 0, 2);\n}\n","structuredPatch":[{"oldStart":5,"oldLines":6,"newStart":5,"newLines":49,"lines":[" use crate::tests::util::{TestSimLink, TestSimPacket};"," use crate::{Instant, MAX_PACKET_SIZE};"," ","+/// Consume one bit of the 64-bit rotating loss mask and return whether","+/// this packet should be lost.  Returns `false` when `loss_mask` is","+/// `None` (matching the C `NULL` case).","+///","+/// C: `picoquic/sim_link.c:picoquictest_sim_link_testloss`.","+fn testloss(loss_mask: &mut Option<u64>) -> bool {","+    if let Some(mask) = loss_mask.as_mut() {","+        let loss_bit = *mask & 1;","+        *mask = (*mask >> 1) | (loss_bit << 63);","+        loss_bit != 0","+    } else {","+        false","+    }","+}","+","+/// Determine whether the current packet should be dropped according to","+/// the link's burst-loss model.","+///","+/// C: `picoquic/sim_link.c:picoquictest_sim_link_simloss`.","+fn simloss(link: &mut TestSimLink, current_time: Instant) -> bool {","+    if link.nb_loss_in_burst == 0 {","+        return false;","+    }","+    let ct = current_time.ticks();","+    if link.packets_sent > link.packets_sent_next_burst {","+        let picosec_wait = link.nb_loss_in_burst * link.picosec_per_byte * 1536;","+        link.packets_sent_next_burst = link.packets_sent + link.packets_between_losses;","+        link.nb_losses_this_burst = link.nb_loss_in_burst - 1;","+        link.end_of_burst_time = Instant::from_ticks(ct + picosec_wait / 1_000_000);","+        true","+    } else if link.nb_losses_this_burst > 0 {","+        if ct > link.end_of_burst_time.ticks() {","+            link.nb_losses_this_burst = 0;","+            false","+        } else {","+            link.nb_losses_this_burst -= 1;","+            true","+        }","+    } else {","+        false","+    }","+}","+"," /// C: `sim_link_one_test` in `picoquic/sim_link.c`."," fn sim_link_one_test(loss_mask: Option<u64>, queue_delay_max: u64, nb_losses: u64) {","     let mut departure_time = Instant::from_ticks(0);"]}],"userModified":false,"replaceAll":false}}
