{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01WWopgP8khuQfMi5EDHm3Nx","type":"tool_result","content":"1\t//! Test cases for the simulator harness in `picoquic/sim_link.c`.\n2\t\n3\t#![allow(non_snake_case)]\n4\t\n5\tuse crate::tests::util::{TestSimLink, TestSimPacket};\n6\tuse crate::{Instant, MAX_PACKET_SIZE};\n7\t\n8\t/// C: `sim_link_one_test` in `picoquic/sim_link.c`.\n9\tfn sim_link_one_test(loss_mask: Option<u64>, queue_delay_max: u64, nb_losses: u64) {\n10\t    let mut departure_time = Instant::from_ticks(0);\n11\t    let mut link = TestSimLink::create(\n12\t        0.01,\n13\t        10_000,\n14\t        loss_mask,\n15\t        queue_delay_max,\n16\t        Instant::from_ticks(0),\n17\t    )\n18\t    .expect(\"sim link allocation\");\n19\t    let mut dequeued = 0u64;\n20\t    let mut queued = 0u64;\n21\t    const NB_PACKETS: u64 = 16;\n22\t\n23\t    loop {\n24\t        if queued >= NB_PACKETS {\n25\t            departure_time = Instant::from_ticks(u64::MAX);\n26\t        }\n27\t\n28\t        let current_time = Instant::from_ticks(link.next_arrival(departure_time));\n29\t\n30\t        if let Some(_packet) = link.dequeue(current_time) {\n31\t            dequeued += 1;\n32\t        } else if queued < NB_PACKETS {\n33\t            let mut packet = TestSimPacket::create().expect(\"sim packet allocation\");\n34\t            packet.length = MAX_PACKET_SIZE;\n35\t            link.submit(packet, departure_time);\n36\t            departure_time = Instant::from_ticks(departure_time.ticks() + 250);\n37\t            queued += 1;\n38\t        } else {\n39\t            break;\n40\t        }\n41\t    }\n42\t\n43\t    assert_eq!(\n44\t        dequeued + nb_losses,\n45\t        NB_PACKETS,\n46\t        \"unexpected sim-link delivery count\",\n47\t    );\n48\t}\n49\t\n50\t/// C: `sim_link_test` in `picoquictest/<harness>.c`.\n51\t#[test]\n52\tfn sim_link() {\n53\t    sim_link_one_test(Some(0), 0, 0);\n54\t    sim_link_one_test(Some(8), 0, 1);\n55\t    sim_link_one_test(Some(0x18), 0, 2);\n56\t}\n57\t"}]},"parent_tool_use_id":null,"session_id":"a55e6d46-26e5-49d5-b365-b1275ce83ce6","uuid":"412f34d5-49c6-4588-a1f8-651e7038c69e","timestamp":"2026-05-07T09:15:26.035Z","tool_use_result":{"type":"text","file":{"filePath":"/Users/richbarn/Projects/picoquic/rs/fq/src/tests/harness.rs","content":"//! Test cases for the simulator harness in `picoquic/sim_link.c`.\n\n#![allow(non_snake_case)]\n\nuse crate::tests::util::{TestSimLink, TestSimPacket};\nuse crate::{Instant, MAX_PACKET_SIZE};\n\n/// C: `sim_link_one_test` in `picoquic/sim_link.c`.\nfn sim_link_one_test(loss_mask: Option<u64>, queue_delay_max: u64, nb_losses: u64) {\n    let mut departure_time = Instant::from_ticks(0);\n    let mut link = TestSimLink::create(\n        0.01,\n        10_000,\n        loss_mask,\n        queue_delay_max,\n        Instant::from_ticks(0),\n    )\n    .expect(\"sim link allocation\");\n    let mut dequeued = 0u64;\n    let mut queued = 0u64;\n    const NB_PACKETS: u64 = 16;\n\n    loop {\n        if queued >= NB_PACKETS {\n            departure_time = Instant::from_ticks(u64::MAX);\n        }\n\n        let current_time = Instant::from_ticks(link.next_arrival(departure_time));\n\n        if let Some(_packet) = link.dequeue(current_time) {\n            dequeued += 1;\n        } else if queued < NB_PACKETS {\n            let mut packet = TestSimPacket::create().expect(\"sim packet allocation\");\n            packet.length = MAX_PACKET_SIZE;\n            link.submit(packet, departure_time);\n            departure_time = Instant::from_ticks(departure_time.ticks() + 250);\n            queued += 1;\n        } else {\n            break;\n        }\n    }\n\n    assert_eq!(\n        dequeued + nb_losses,\n        NB_PACKETS,\n        \"unexpected sim-link delivery count\",\n    );\n}\n\n/// C: `sim_link_test` in `picoquictest/<harness>.c`.\n#[test]\nfn sim_link() {\n    sim_link_one_test(Some(0), 0, 0);\n    sim_link_one_test(Some(8), 0, 