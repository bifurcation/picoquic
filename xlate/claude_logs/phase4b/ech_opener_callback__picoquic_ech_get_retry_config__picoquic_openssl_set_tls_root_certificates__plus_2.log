{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01QzF5YeyG75bENPi3es5MLo","type":"tool_result","content":"400\t    /// OpenSSL library component name (e.g. \"PEM routines\").\n401\t    pub library: Option<String>,\n402\t    /// OpenSSL source file where the error was recorded.\n403\t    pub file: String,\n404\t    /// Line number in the OpenSSL source file.\n405\t    pub line: u32,\n406\t}\n407\t\n408\t/// Dequeue all pending OpenSSL errors and return them.\n409\t/// C callers loop over `picoquic_open_ssl_explain_crypto_error` until the\n410\t/// return code is 0; Rust collects the full queue in one shot.\n411\t/// C: `picoquic_open_ssl_explain_crypto_error`.\n412\tpub fn explain_crypto_error() -> Vec<CryptoError> {\n413\t    openssl::error::ErrorStack::get()\n414\t        .errors()\n415\t        .iter()\n416\t        .map(|e| CryptoError {\n417\t            code: e.code(),\n418\t            reason: e.reason().map(str::to_owned),\n419\t            library: e.library().map(str::to_owned),\n420\t            file: e.file().to_owned(),\n421\t            line: e.line(),\n422\t        })\n423\t        .collect()\n424\t}\n425\t\n426\t/// Clear the OpenSSL error queue, discarding all pending errors.\n427\t/// C: `picoquic_openssl_clear_crypto_errors`.\n428\tpub fn clear_crypto_errors() {\n429\t    drop(openssl::error::ErrorStack::get());\n430\t}\n431\t\n432\t// ---------------------------------------------------------------------------\n433\t// Root-certificate injection into a live verifier context.\n434\t\n435\timpl CertificateVerifier {\n436\t    /// Add additional root certificates (DER-encoded) to the trust store.\n437\t    ///\n438\t    /// Parses each cert and calls `X509StoreRef::add_cert` to insert it.\n439\t    /// Returns `Err(Generic)` on parse failure (mirrors C return value `-1`)\n440\t    /// or store-insertion failure (mirrors `-2`).\n441\t    ///\n442\t    /// C: `picoquic_openssl_set_tls_root_certificates`\n443\t    pub fn set_root_certificates(&mut self, certs: &[&[u8]]) -> Result<(), crate::Error> {\n444\t        for &cert_der in certs {\n445\t            let cert =\n446\t                openssl::x509::X509::from_der(cert_der).map_err(|_| crate::Error::Generic)?;\n447\t            // X509Store derefs to X509StoreRef; add_cert takes &self because\n448\t            // OpenSSL manages internal mutability on the C side.\n449\t            self.store\n450\t                .add_cert(cert)\n451\t                .map_err(|_| crate::Error::Generic)?;\n452\t            self.is_cert_store_not_empty = true;\n453\t        }\n454\t        Ok(())\n455\t    }\n456\t}\n457\t\n458\t// ---------------------------------------------------------------------------\n459\t// Certificate signing context.\n460\t\n461\t/// Certificate signing context backed by an OpenSSL private key.\n462\t///\n463\t/// Wraps the key that picotls would store in a\n464\t/// `ptls_openssl_sign_certificate_t`; the actual signing algorithm\n465\t/// (RSA-PSS, ECDSA, Ed25519, …) is selected by OpenSSL at sign time.\n466\t///\n467\t/// C: `ptls_openssl_sign_certificate_t`\n468\tpub struct SignCertificate {\n469\t    /// The private key used for TLS certificate signing.\n470\t    pub key: openssl::pkey::PKey<openssl::pkey::Private>,\n471\t}\n472\t\n473\t/// Wrap an OpenSSL `PKey` in a [`SignCertificate`] signing context,\n474\t/// consuming the key (mirrors `EVP_PKEY_free(pkey)` at the end of the\n475\t/// C helper — picotls takes ownership and the caller's reference is\n476\t/// released).  Returns `Err(Generic)` when `key` is `None` (the C\n477\t/// function checks for a null `pkey` and returns `-1`).\n478\t///\n479\t/// C: `set_openssl_sign_certificate_from_key` (static helper in\n480\t/// `picoquic_ptls_openssl.c`).\n481\tpub(crate) fn set_sign_certificate_from_key(\n482\t    key: Option<openssl::pkey::PKey<openssl::pkey::Private>>,\n483\t) -> Result<SignCertificate, crate::Error> {\n484\t    let key = key.ok_or(crate::Error::Generic)?;\n485\t    // ptls_openssl_init_sign_certificate stores the key pointer in the\n486\t    // signer struct and sets `ctx->sign_certificate`.  In Rust we simply\n487\t    // move the key into the struct — no additional initialisation is\n488\t    // needed because the signing algorithm is chosen dynamically by\n489\t    // OpenSSL when a signature is requested.\n490\t    Ok(SignCertificate { key })\n491\t}"}]},"parent_tool_use_id":null,"session_id":"ce9760c1-0503-4891-9073-2bbfbb3810ec","uuid":"1f650667-50a7-4265-8477-c33ddba0093c","timestamp":"2026-05-07T08:08:15.282Z","tool_use_result":{"type":"text","file":{"filePath":"/Users/richbarn/Projects/picoquic/rs/fq/src/sys/openssl.rs","content":"    /// OpenSSL library component name (e.g. \"PEM routines\").\n    pub library: Option<String>,\n    /// OpenSSL source file where the error was recorded.\n    pub file: String,\n    /// Line number in the OpenSSL source file.\n    pub line: u32,\n}\n\n/// Dequeue all pending OpenSSL errors and return them.\n/// C callers loop over `picoquic_open_ssl_explain_crypto_error` until the\n/// return code is 0; Rust collects the full queue in one shot.\n/// C: `picoquic_open_ssl_explain_crypto_error`.\npub fn explain_crypto_error() -> Vec<CryptoError> {\n    openssl::error::ErrorStack::get()\n        .errors()\n        .iter()\n        .map(|e| CryptoError {\n            code: e.code(),\n            reason: e.reason().map(str::to_owned),\n            library: e.library().map(str::to_owned),\n            file: e.file().to_owned(),\n            line: e.line(),\n        })\n        .collect()\n}\n\n/// Clear the OpenSSL error queue, discarding all pending errors.\n/// C: `picoquic_openssl_clear_crypto_errors`.\npub fn clear_crypto_errors() {\n    drop(openssl::error::ErrorStack::get());\n}\n\n// ---------------------------------------------------------------------------\n// Root-certificate injection into a live verifier context.\n\nimpl CertificateVerifier {\n    /// Add additional root certificates (DER-encoded) to the trust store.\n    ///\n    /// Parses each cert and calls `X509StoreRef::add_cert` to insert it.\n    /// Returns `Err(Generic)` on parse failure (mirrors C return value `-1`)\n    /// or store-insertion failure (mirrors `-2`).\n    ///\n    /// C: `picoquic_openssl_set_tls_root_certificates`\n    pub fn set_root_certificates(&mut self, certs: &[&[u8]]) -> Result<(), crate::Error> {\n        for &cert_der in certs {\n            let cert =\n                openssl::x509::X509::from_der(cert_der).map_err(|_| crate::Error::Generic)?;\n            // X509Store derefs to X509StoreRef; add_cert takes &self because\n            // OpenSSL manages internal mutability on the C side.\n            self.store\n                .add_cert(cert)\n                .map_err(|_| crate::Error::Generic)?;\n            self.is_cert_store_not_empty = true;\n        }\n        Ok(())\n    }\n}\n\n// ---------------------------------------------------------------------------\n// Certificate signing context.\n\n/// Certificate signing context backed by an OpenSSL private key.\n///\n/// Wraps the key that picotls would store in a\n/// `ptls_openssl_sign_certificate_t`; the actual signing algorithm\n/// (RSA-PSS, ECDSA, Ed25519, …) is selected by OpenSSL at sign time.\n///\n/// C: `ptls_openssl_sign_certificate_t`\npub struct SignCertificate {\n    /// The private key used for TLS certificate signing.\n    pub key: openssl::pkey::PKey<openssl::pkey::Private>,\n}\n\n/// Wrap an OpenSSL `PKey` in a [`SignCertificate`] signing context,\n/// consuming the key (mirrors `EVP_PKEY_free(pkey)` at the end of the\n/// C helper — picotls takes ownership and the caller's reference is\n/// released).  Returns `Err(Generic)` when `key` is `None` (the C\n/// function checks for a null `pkey` and returns `-1`).\n///\n/// C: `set_openssl_sign_certificate_from_key` (static helper in\n/// `picoquic_ptls_openssl.c`).\npub(crate) fn set_sign_certificate_from_key(\n    key: Option<openssl::pkey::PKey<openssl::pkey::Private>>,\n) -> Result<SignCertificate, crate::Error> {\n    let key = key.ok_or(crate::Error::Generic)?;\n    // ptls_openssl_init_sign_certificate stores the key pointer in the\n    // signer struct and sets `ctx->sign_certificate`.  In Rust we simply\n    // move the key into the struct — no additional initialisation is\n    // needed because the signing algorithm is chosen dynamically by\n    // OpenSSL when a signature is requested.\n    Ok(SignCertificate { key })\n}","numLines":92,"startLine":400,"totalLines":492}}}
