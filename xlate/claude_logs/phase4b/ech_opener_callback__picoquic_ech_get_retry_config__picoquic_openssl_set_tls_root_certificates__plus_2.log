{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_013Vu3vDi9D8X5sKotXgjRVd","type":"tool_result","content":"The file /Users/richbarn/Projects/picoquic/rs/fq/Cargo.toml has been updated successfully. (file state is current in your context — no need to Read it back)"}]},"parent_tool_use_id":null,"session_id":"ce9760c1-0503-4891-9073-2bbfbb3810ec","uuid":"6ef1246d-c6ac-4d77-b164-0ee43fc2ed5f","timestamp":"2026-05-07T08:08:41.166Z","tool_use_result":{"filePath":"/Users/richbarn/Projects/picoquic/rs/fq/Cargo.toml","oldString":"sys-openssl = [\"dep:openssl\"]","newString":"sys-openssl = [\"dep:openssl\", \"dep:openssl-sys\", \"dep:foreign-types\"]","originalFile":"[package]\nname = \"fq\"\nversion = \"0.1.0\"\nedition = \"2024\"\n\n[features]\ndefault = []\n# Each backend lives behind its own feature so a binary only pays\n# for the implementations it actually links.  See `src/sys/`.\nsys-picotls = []\nsys-openssl = [\"dep:openssl\"]\nsys-mbedtls = []\nsys-fusion = []\n\n[dependencies]\nfugit = { version = \"0.3\", default-features = false }\nrand = { version = \"0.9\", default-features = false }\nrand_core = { version = \"0.9\", default-features = false }\n\n# Rust Crypto trait crates (no implementations -- those come from\n# the active TLS backend's crypto layer, except for header\n# protection which we implement ourselves).\naead = { version = \"0.5\", default-features = false }\ncipher = { version = \"0.4\", default-features = false }\ndigest = { version = \"0.10\", default-features = false }\n\n# Concrete cipher implementations used by header protection\n# (QUIC packet-number encryption is QUIC logic, not TLS).\naes = { version = \"0.8\", default-features = false }\nchacha20 = { version = \"0.9\", default-features = false }\n\n# Hash, HKDF, and AEAD implementations used by the QUIC initial-secret\n# derivation, retry-protection AEAD, and test-only crypto helpers in\n# `tls_api`.  These are pure-Rust algorithms not specific to any TLS\n# backend.\nsha2 = { version = \"0.10\", default-features = false }\nhkdf = { version = \"0.12\", default-features = false }\nhmac = { version = \"0.12\", default-features = false }\naes-gcm = { version = \"0.10\", default-features = false, features = [\"aes\", \"alloc\"] }\n\n# UDP socket abstraction.  std-only.\nsocket2 = { version = \"0.5\", default-features = false, features = [\"all\"] }\n\n# HPKE (RFC 9180) — used by the ECH opener callback to perform DHKEM\n# decapsulation.  KEM algorithm support is gated per feature below.\nhpke = { version = \"0.12\", features = [\"x25519\", \"p256\", \"p384\"] }\n\n# Platform socket ancillary-data (cmsg) helpers.  Used only on Unix via\n# `#[cfg(unix)]`; safe to list unconditionally.\nlibc = \"0.2\"\n\n# Optional backend implementations (gated by `sys-*` features).\nopenssl = { version = \"0.10\", optional = true }\n","structuredPatch":[{"oldStart":8,"oldLines":7,"newStart":8,"newLines":7,"lines":[" # Each backend lives behind its own feature so a binary only pays"," # for the implementations it actually links.  See `src/sys/`."," sys-picotls = []","-sys-openssl = [\"dep:openssl\"]","+sys-openssl = [\"dep:openssl\", \"dep:openssl-sys\", \"dep:foreign-types\"]"," sys-mbedtls = []"," sys-fusion = []"," "]}],"userModified":false,"replaceAll":false}}
