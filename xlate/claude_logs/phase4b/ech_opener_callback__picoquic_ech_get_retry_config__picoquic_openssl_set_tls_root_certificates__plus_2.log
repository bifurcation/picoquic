{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_013DgYFz8MbkNgAtKzWAv4jD","type":"tool_result","content":"1\t//! Encrypted ClientHello (ECH) helpers.\n2\t//!\n3\t//! Pure-Rust portion of the ECH support layer.  The HPKE key-exchange\n4\t//! operations that require ECDH primitives (DHKEM-X25519, DHKEM-P256,\n5\t//! DHKEM-P384) are currently `todo!()` pending the addition of the `hpke`\n6\t//! crate to Cargo.toml.  Everything else — the cipher-suite selector, the\n7\t//! config-ID digest, base64 encoding, and the opener-state plumbing — is\n8\t//! fully translated from `picoquic/ech.c`.\n9\t\n10\textern crate alloc;\n11\tuse alloc::vec::Vec;\n12\t\n13\tuse crate::Error;\n14\t\n15\t// ---------------------------------------------------------------------------\n16\t// HPKE constants (IANA registries, RFC 9180).\n17\t\n18\t/// HPKE KEM algorithm identifiers (RFC 9180 §7.1).\n19\tpub mod kem_id {\n20\t    /// DHKEM(P-256, HKDF-SHA256)\n21\t    pub const P256_SHA256: u16 = 0x0010;\n22\t    /// DHKEM(P-384, HKDF-SHA384)\n23\t    pub const P384_SHA384: u16 = 0x0011;\n24\t    /// DHKEM(X25519, HKDF-SHA256)\n25\t    pub const X25519_SHA256: u16 = 0x0020;\n26\t}\n27\t\n28\t/// HPKE KDF algorithm identifiers (RFC 9180 §7.2).\n29\tpub mod kdf_id {\n30\t    /// HKDF-SHA256\n31\t    pub const HKDF_SHA256: u16 = 0x0001;\n32\t    /// HKDF-SHA384\n33\t    pub const HKDF_SHA384: u16 = 0x0002;\n34\t    /// HKDF-SHA512\n35\t    pub const HKDF_SHA512: u16 = 0x0003;\n36\t}\n37\t\n38\t/// HPKE AEAD algorithm identifiers (RFC 9180 §7.3).\n39\tpub mod aead_id {\n40\t    /// AES-128-GCM\n41\t    pub const AES_128_GCM: u16 = 0x0001;\n42\t    /// AES-256-GCM\n43\t    pub const AES_256_GCM: u16 = 0x0002;\n44\t    /// ChaCha20-Poly1305\n45\t    pub const CHACHA20_POLY1305: u16 = 0x0003;\n46\t}\n47\t\n48\t// ---------------------------------------------------------------------------\n49\t// Cipher-suite identifier.\n50\t\n51\t/// HPKE symmetric cipher-suite: (KDF id, AEAD id) pair.\n52\t///\n53\t/// C: `ptls_hpke_cipher_suite_id_t`\n54\t#[derive(Debug, Clone, Copy, PartialEq, Eq)]\n55\tpub struct HpkeCipherSuiteId {\n56\t    pub kdf: u16,\n57\t    pub aead: u16,\n58\t}\n59\t\n60\t/// The three cipher suites we advertise as supported, mirroring the\n61\t/// `picoquic_hpke_cipher_suites[]` array that the C picotls backend\n62\t/// populates at startup.\n63\tconst SUPPORTED_CIPHER_SUITES: &[HpkeCipherSuiteId] = &[\n64\t    HpkeCipherSuiteId {\n65\t        kdf: kdf_id::HKDF_SHA256,\n66\t        aead: aead_id::AES_128_GCM,\n67\t    },\n68\t    HpkeCipherSuiteId {\n69\t        kdf: kdf_id::HKDF_SHA256,\n70\t        aead: aead_id::CHACHA20_POLY1305,\n71\t    },\n72\t    HpkeCipherSuiteId {\n73\t        kdf: kdf_id::HKDF_SHA384,\n74\t        aead: aead_id::AES_256_GCM,\n75\t    },\n76\t];\n77\t\n78\t// ---------------------------------------------------------------------------\n79\t// Base64 encoding.\n80\t\n81\tconst BASE64_ALPHABET: &[u8; 64] =\n82\t    b\"ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789+/\";\n83\t\n84\t/// Return the number of base64 characters needed to encode `input_len` bytes,\n85\t/// not counting a NUL terminator.  Mirrors `ptls_base64_howlong`.\n86\t#[inline]\n87\tpub fn base64_encoded_len(input_len: usize) -> usize {\n88\t    input_len.div_ceil(3) * 4\n89\t}\n90\t\n91\t/// Encode `input` as standard RFC 4648 base64 into `out`.\n92\t///\n93\t/// `out` must be at least `base64_encoded_len(input.len()) + 1` bytes long\n94\t/// (the extra byte is for the NUL terminator written to match picotls\n95\t/// convention).  Returns the number of base64 characters written (excluding\n96\t/// the NUL).  Returns `Err(Error::Generic)` when `out` is too small.\n97\t///\n98\t/// C: `picoquic_base64_encode`\n99\tpub fn base64_encode(input: &[u8], out: &mut [u8]) -> Result<usize, Error> {\n100\t    let len = base64_encoded_len(input.len());\n101\t    if len + 1 > out.len() {\n102\t        return Err(Error::Generic);\n103\t    }\n104\t    let mut pos = 0usize;\n105\t    let mut chunks = input.chunks_exact(3);\n106\t    for chunk in &mut chunks {\n107\t        let b = ((chunk[0] as u32) << 16) | ((chunk[1] as u32) << 8) | (chunk[2] as u32);\n108\t        out[pos] = BASE64_ALPHABET[((b >> 18) & 0x3f) as usize];\n109\t        out[pos + 1] = BASE64_ALPHABET[((b >> 12) & 0x3f) as usize];\n110\t        out[pos + 2] = BASE64_ALPHABET[((b >> 6) & 0x3f) as usize];\n111\t        out[pos + 3] = BASE64_ALPHABET[(b & 0x3f) as usize];\n112\t        pos += 4;\n113\t    }\n114\t    match chunks.remainder() {\n115\t        [a] => {\n116\t            let b = (*a as u32) << 16;\n117\t            out[pos] = BASE64_ALPHABET[((b >> 18) & 0x3f) as usize];\n118\t            out[pos + 1] = BASE64_ALPHABET[((b >> 12) & 0x3f) as usize];\n119\t            out[pos + 2] = b'=';\n120\t            out[pos + 3] = b'=';\n121\t            pos += 4;\n122\t        }\n123\t        [a, b] => {\n124\t            let v = ((*a as u32) << 16) | ((*b as u32) << 8);\n125\t            out[pos] = BASE64_ALPHABET[((v >> 18) & 0x3f) as usize];\n126\t            out[pos + 1] = BASE64_ALPHABET[((v >> 12) & 0x3f) as usize];\n127\t            out[pos + 2] = BASE64_ALPHABET[((v >> 6) & 0x3f) as usize];\n128\t            out[pos + 3] = b'=';\n129\t            pos += 4;\n130\t        }\n131\t        _ => {}\n132\t    }\n133\t    out[pos] = 0; // NUL terminator (mirrors ptls_base64_encode convention)\n134\t    Ok(len)\n135\t}\n136\t\n137\t// ---------------------------------------------------------------------------\n138\t// Cipher-suite selector.\n139\t\n140\t/// Fill `out` with HPKE cipher suites appropriate for `kem_id`, returning\n141\t/// the number of entries written.\n142\t///\n143\t/// The first entry is the preferred suite for the given KEM; when there is\n144\t/// also a suitable default suite (AES-128-GCM + HKDF-SHA256) that differs\n145\t/// from the preferred one and `out.len() > 2`, it is appended as the second\n146\t/// entry.\n147\t///\n148\t/// Returns `Err(Error::Generic)` if `out.len() < 2` (mirrors the C guard\n149\t/// `cipher_vec_nb_max < 2`) or if no suite can be found.\n150\t///\n151\t/// C: `picoquic_ech_get_ciphers_from_kem`\n152\tpub fn ech_get_ciphers_from_kem(\n153\t    kem_id: u16,\n154\t    out: &mut [HpkeCipherSuiteId],\n155\t) -> Result<usize, Error> {\n156\t    if out.len() < 2 {\n157\t        return Err(Error::Generic);\n158\t    }\n159\t\n160\t    let (target_kdf, target_aead) = match kem_id {\n161\t        kem_id::P256_SHA256 => (kdf_id::HKDF_SHA256, aead_id::AES_128_GCM),\n162\t        kem_id::P384_SHA384 => (kdf_id::HKDF_SHA384, aead_id::AES_256_GCM),\n163\t        kem_id::X25519_SHA256 => (kdf_id::HKDF_SHA256, aead_id::CHACHA20_POLY1305),\n164\t        _ => (kdf_id::HKDF_SHA256, aead_id::AES_128_GCM),\n165\t    };\n166\t    let target = HpkeCipherSuiteId {\n167\t        kdf: target_kdf,\n168\t        aead: target_aead,\n169\t    };\n170\t    let default_suite = HpkeCipherSuiteId {\n171\t        kdf: kdf_id::HKDF_SHA256,\n172\t        aead: aead_id::AES_128_GCM,\n173\t    };\n174\t\n175\t    let mut target_cipher: Option<HpkeCipherSuiteId> = None;\n176\t    let mut default_cipher: Option<HpkeCipherSuiteId> = None;\n177\t\n178\t    for &suite in SUPPORTED_CIPHER_SUITES {\n179\t        if target_cipher.is_none() && suite == target {\n180\t            target_cipher = Some(suite);\n181\t        }\n182\t        if default_cipher.is_none() && suite == default_suite {\n183\t            default_cipher = Some(suite);\n184\t        }\n185\t    }\n186\t\n187\t    // Mirrors the C branching: target first; fall back to default; error if neither.\n188\t    // C: `cipher_vec_nb_max > 2` guards adding the default as a second entry.\n189\t    let nb_ciphers = match (target_cipher, default_cipher) {\n190\t        (Some(t), def) => {\n191\t            out[0] = t;\n192\t            if let Some(d) = def {\n193\t                if d != t && out.len() > 2 {\n194\t                    out[1] = d;\n195\t                    2\n196\t                } else {\n197\t                    1\n198\t                }\n199\t            } else {\n200\t                1\n201\t            }\n202\t        }\n203\t        (None, Some(d)) => {\n204\t            out[0] = d;\n205\t            1\n206\t        }\n207\t        (None, None) => return Err(Error::Generic),\n208\t    };\n209\t    Ok(nb_ciphers)\n210\t}\n211\t\n212\t// ---------------------------------------------------------------------------\n213\t// Config-ID derivation (private helper).\n214\t\n215\t/// Compute the one-byte ECH config-ID from the public key material, KEM id,\n216\t/// cipher suites, and the server public name.\n217\t///\n218\t/// The algorithm accumulates all bytes into a `u64` then XOR-folds the\n219\t/// result down to a single byte.\n220\t///\n221\t/// C: `ech_config_id_from_config` (file-static)\n222\tfn ech_config_id_from_config(\n223\t    public_key_bits: &[u8],\n224\t    kem_id: u16,\n225\t    cipher_suites: &[HpkeCipherSuiteId],\n226\t    public_name: &str,\n227\t) -> u8 {\n228\t    let mut config_sum: u64 = 0;\n229\t    for &b in public_key_bits {\n230\t        config_sum = config_sum.wrapping_add(b as u64);\n231\t    }\n232\t    config_sum = config_sum.wrapping_add(kem_id as u64);\n233\t    for cs in cipher_suites {\n234\t        config_sum = config_sum.wrapping_add(cs.aead as u64);\n235\t        config_sum = config_sum.wrapping_add(cs.kdf as u64);\n236\t    }\n237\t    for b in public_name.bytes() {\n238\t        config_sum = config_sum.wrapping_add(b as u64);\n239\t    }\n240\t    let mut config_id: u8 = 0;\n241\t    while config_sum > 0 {\n242\t        config_id ^= (config_sum & 0xff) as u8;\n243\t        config_sum >>= 8;\n244\t    }\n245\t    config_id\n246\t}\n247\t\n248\t// ---------------------------------------------------------------------------\n249\t// Server-side ECH opener state.\n250\t\n251\t/// Result returned by a successful [`EchOpenerState::open`] call.\n252\t///\n253\t/// When the HPKE decapsulation step is complete, `key_material` will hold\n254\t/// the derived AEAD key bytes; callers build the concrete AEAD context from\n255\t/// it together with `cipher`.\n256\tpub struct EchOpenResult {\n257\t    /// The negotiated cipher suite.\n258\t    pub cipher: HpkeCipherSuiteId,\n259\t    /// HPKE-derived key material for the AEAD context.  Empty until the\n260\t    /// DHKEM decapsulation is implemented.\n261\t    pub key_material: Vec<u8>,\n262\t}\n263\t\n264\t/// Server-side ECH opener callback state.\n265\t///\n266\t/// Holds the KEM id, the private key bytes used for HPKE decapsulation,\n267\t/// and the serialised ECH config bytes (used to reconstruct the HPKE `info`\n268\t/// string during opening).\n269\t///\n270\t/// C: `ech_opener_callback_t`\n271\tpub struct EchOpenerState {\n272\t    /// HPKE KEM identifier, e.g. `kem_id::X25519_SHA256`.\n273\t    /// C: `kem` (`ptls_hpke_kem_t*`; we store only the numeric id).\n274\t    pub kem_id: u16,\n275\t    /// Raw private key bytes for HPKE decapsulation.\n276\t    /// C: `keyex` (`ptls_key_exchange_context_t*` loaded from a PEM file).\n277\t    pub private_key: Vec<u8>,\n278\t    /// Serialised ECH config bytes including the two-byte outer length prefix.\n279\t    /// C: `config` (`ptls_buffer_t`).\n280\t    pub config: Vec<u8>,\n281\t}\n282\t\n283\timpl EchOpenerState {\n284\t    /// Attempt to open (decapsulate) an incoming ECH extension.\n285\t    ///\n286\t    /// Finds the cipher suite matching `cipher_id` in the supported list,\n287\t    /// builds the HPKE `info` string as `info_prefix || config[2..]`, and\n288\t    /// then performs the HPKE recipient setup to derive the AEAD key.\n289\t    ///\n290\t    /// Returns `Some(EchOpenResult)` on success, `None` when `cipher_id` is\n291\t    /// not in the supported list.\n292\t    ///\n293\t    /// # Blocker\n294\t    ///\n295\t    /// The HPKE decapsulation step (`ptls_hpke_setup_base_r` equivalent)\n296\t    /// requires DHKEM primitives.  Add the `hpke` crate with the\n297\t    /// `x25519`/`p256`/`p384` features to Cargo.toml and replace the\n298\t    /// `todo!()` below with the corresponding `hpke::setup_receiver` call.\n299\t    ///\n300\t    /// C: `ech_opener_callback`\n301\t    pub fn open(\n302\t        &self,\n303\t        cipher_id: HpkeCipherSuiteId,\n304\t        enc: &[u8],\n305\t        info_prefix: &[u8],\n306\t    ) -> Option<EchOpenResult> {\n307\t        // Find the matching cipher suite in the supported list.\n308\t        let cipher = SUPPORTED_CIPHER_SUITES\n309\t            .iter()\n310\t            .copied()\n311\t            .find(|c| c.kdf == cipher_id.kdf && c.aead == cipher_id.aead)?;\n312\t\n313\t        // Build info = info_prefix || config[2..]\n314\t        // (config[0..2] is the two-byte ECHConfigList outer length prefix,\n315\t        // skipped to match the `ptls_buffer_pushv(&infobuf, config.base+2, …)`\n316\t        // call in the C implementation.)\n317\t        let config_payload = self.config.get(2..).unwrap_or(&[]);\n318\t        let mut info = Vec::with_capacity(info_prefix.len() + config_payload.len());\n319\t        info.extend_from_slice(info_prefix);\n320\t        info.extend_from_slice(config_payload);\n321\t\n322\t        // blocked: DHKEM decapsulation (ptls_hpke_setup_base_r equivalent).\n323\t        // Add `hpke` crate with x25519/p256/p384 feature to Cargo.toml, then\n324\t        // call hpke::setup_receiver(self.kem_id, cipher, &self.private_key, enc, &info)\n325\t        // to obtain the exported key material.\n326\t        let _ = (enc, &info, &self.private_key, self.kem_id, cipher);\n327\t        todo!(\n328\t            \"blocked: HPKE recipient setup for ech_opener_callback requires DHKEM — \\\n329\t             add the `hpke` crate (x25519/p256/p384 features) to Cargo.toml\"\n330\t        )\n331\t    }\n332\t}\n333\t\n334\t// ---------------------------------------------------------------------------\n335\t// TLS group-id → HPKE KEM-id mapping.\n336\t\n337\t/// TLS named-group identifiers (RFC 8446 §4.2.7, as used by picotls).\n338\tpub mod group_id {\n339\t    /// secp256r1 / P-256  (`PTLS_GROUP_SECP256R1`)\n340\t    pub const SECP256R1: u16 = 23;\n341\t    /// secp384r1 / P-384  (`PTLS_GROUP_SECP384R1`)\n342\t    pub const SECP384R1: u16 = 24;\n343\t    /// X25519             (`PTLS_GROUP_X25519`)\n344\t    pub const X25519: u16 = 29;\n345\t}\n346\t\n347\t/// Find the HPKE KEM identifier for the given TLS named-group id.\n348\t///\n349\t/// Mirrors the C loop over `picoquic_hpke_kems[]` that matches on\n350\t/// `picoquic_hpke_kems[i]->keyex->id == group_id`.\n351\t///\n352\t/// Returns `Some(kem_id)` on success, `None` when the group is not\n353\t/// one of the three supported curves.\n354\t///\n355\t/// C: `picoquic_ech_get_kem_from_curve`\n356\tpub fn ech_get_kem_from_curve(group_id: u16) -> Option<u16> {\n357\t    match group_id {\n358\t        group_id::SECP256R1 => Some(kem_id::P256_SHA256),\n359\t        group_id::SECP384R1 => Some(kem_id::P384_SHA384),\n360\t        group_id::X25519 => Some(kem_id::X25519_SHA256),\n361\t        _ => None,\n362\t    }\n363\t}\n364\t\n365\t// ---------------------------------------------------------------------------\n366\t// ASN.1 DER SubjectPublicKeyInfo parser.\n367\t\n368\t/// Parsed fields extracted from a DER-encoded SubjectPublicKeyInfo blob.\n369\t///\n370\t/// All slices borrow from the original input passed to\n371\t/// [`parse_public_key_asn1`], so their lifetime is tied to that input.\n372\t///\n373\t/// C: the four output parameters of `picoquic_parse_public_key_asn1`.\n374\tpub struct PublicKeyAsn1<'a> {\n375\t    /// Algorithm OID value bytes (tag + length stripped).\n376\t    ///\n377\t    /// C: `public_key_algo.{base,len}`\n378\t    pub algo: &'a [u8],\n379\t    /// Parameters field: raw bytes from after the algorithm OID to the\n380\t    /// end of the inner AlgorithmIdentifier SEQUENCE.  Includes the\n381\t    /// tag + length of any nested TLV; empty when there are no parameters\n382\t    /// (e.g. X25519 keys).\n383\t    ///\n384\t    /// C: `public_key_param.{base,len}`\n385\t    pub param: &'a [u8],\n386\t    /// BIT STRING value bytes.  The first byte is the padding-count\n387\t    /// (always `0x00` for the curves picoquic supports); the key bytes\n388\t    /// follow immediately.\n389\t    ///\n390\t    /// C: `public_key_bit_string.{base,len}`\n391\t    pub bit_string: &'a [u8],\n392\t    /// Total number of bytes consumed from the input.\n393\t    pub consumed: usize,\n394\t}\n395\t\n396\t/// Parse a DER TLV header at `pos` within `bytes[..bytes_max]`.\n397\t///\n398\t/// `expected_type` must match the tag byte.  Returns `(value_start, value_end)`\n399\t/// on success, `Err` on type mismatch, truncation, or overflow.\n400\tfn asn1_tlv(\n401\t    bytes: &[u8],\n402\t    bytes_max: usize,\n403\t    pos: usize,\n404\t    expected_type: u8,\n405\t) -> Result<(usize, usize), Error> {\n406\t    if pos >= bytes_max || bytes[pos] != expected_type {\n407\t        return Err(Error::Generic);\n408\t    }\n409\t    let pos = pos + 1;\n410\t    if pos >= bytes_max {\n411\t        return Err(Error::Generic);\n412\t    }\n413\t    let first = bytes[pos];\n414\t    let (length, val_start) = if first < 0x80 {\n415\t        (first as usize, pos + 1)\n416\t    } else {\n417\t        let n = (first & 0x7F) as usize;\n418\t        if n == 0 || pos + 1 + n > bytes_max {\n419\t            return Err(Error::Generic);\n420\t        }\n421\t        let mut len = 0usize;\n422\t        for i in 0..n {\n423\t            len = (len << 8) | (bytes[pos + 1 + i] as usize);\n424\t        }\n425\t        (len, pos + 1 + n)\n426\t    };\n427\t    let val_end = val_start + length;\n428\t    if val_end > bytes_max {\n429\t        return Err(Error::Generic);\n430\t    }\n431\t    Ok((val_start, val_end))\n432\t}\n433\t\n434\t/// Parse a DER-encoded SubjectPublicKeyInfo structure.\n435\t///\n436\t/// Walks the outer SEQUENCE → AlgorithmIdentifier SEQUENCE → OID +\n437\t/// optional parameters → BIT STRING layout described in RFC 5480 and\n438\t/// RFC 8410, returning zero-copy sub-slices into `input`.\n439\t///\n440\t/// Returns `Err(Error::Generic)` for any structural violation (wrong tag,\n441\t/// truncated length field, outer-sequence length mismatch, or trailing\n442\t/// bytes after the BIT STRING).\n443\t///\n444\t/// C: `picoquic_parse_public_key_asn1`\n445\tpub fn parse_public_key_asn1(input: &[u8]) -> Result<PublicKeyAsn1<'_>, Error> {\n446\t    let bytes_max = input.len();\n447\t\n448\t    // Outer SEQUENCE must span the entire buffer.\n449\t    let (outer_val, outer_end) = asn1_tlv(input, bytes_max, 0, 0x30)?;\n450\t    if outer_end != bytes_max {\n451\t        return Err(Error::Generic); // PTLS_ERROR_BER_EXCESSIVE_LENGTH\n452\t    }\n453\t\n454\t    // AlgorithmIdentifier SEQUENCE.\n455\t    let (inner_val, inner_end) = asn1_tlv(input, outer_end, outer_val, 0x30)?;\n456\t\n457\t    // Algorithm OID — value bytes only (tag + length consumed by asn1_tlv).\n458\t    let (oid_val, oid_end) = asn1_tlv(input, inner_end, inner_val, 0x06)?;\n459\t    let algo = &input[oid_val..oid_end];\n460\t\n461\t    // Parameters: everything remaining in the inner SEQUENCE after the OID.\n462\t    let param = if inner_end <= oid_end {\n463\t        &input[0..0]\n464\t    } else {\n465\t        &input[oid_end..inner_end]\n466\t    };\n467\t\n468\t    // BIT STRING (public key), must consume the rest of the outer SEQUENCE.\n469\t    let (bs_val, bs_end) = asn1_tlv(input, outer_end, inner_end, 0x03)?;\n470\t    if bs_end != outer_end {\n471\t        return Err(Error::Generic); // PTLS_ERROR_BER_ELEMENT_TOO_SHORT\n472\t    }\n473\t    let bit_string = &input[bs_val..bs_end];\n474\t\n475\t    Ok(PublicKeyAsn1 {\n476\t        algo,\n477\t        param,\n478\t        bit_string,\n479\t        consumed: bs_end,\n480\t    })\n481\t}\n482\t\n483\t// ---------------------------------------------------------------------------\n484\t// Tests.\n485\t\n486\t#[cfg(test)]\n487\tmod tests {\n488\t    use super::*;\n489\t\n490\t    #[test]\n491\t    fn base64_encode_empty() {\n492\t        let mut buf = [0u8; 1];\n493\t        let n = base64_encode(&[], &mut buf).unwrap();\n494\t        assert_eq!(n, 0);\n495\t        assert_eq!(buf[0], 0);\n496\t    }\n497\t\n498\t    #[test]\n499\t    fn base64_encode_three_bytes() {\n500\t        // \"Man\" → \"TWFu\"\n501\t        let mut buf = [0u8; 5];\n502\t        let n = base64_encode(b\"Man\", &mut buf).unwrap();\n503\t        assert_eq!(n, 4);\n504\t        assert_eq!(&buf[..4], b\"TWFu\");\n505\t        assert_eq!(buf[4], 0);\n506\t    }\n507\t\n508\t    #[test]\n509\t    fn base64_encode_padding_one() {\n510\t        // \"M\" → \"TQ==\"\n511\t        let mut buf = [0u8; 5];\n512\t        let n = base64_encode(b\"M\", &mut buf).unwrap();\n513\t        assert_eq!(n, 4);\n514\t        assert_eq!(&buf[..4], b\"TQ==\");\n515\t    }\n516\t\n517\t    #[test]\n518\t    fn base64_encode_padding_two() {\n519\t        // \"Ma\" → \"TWE=\"\n520\t        let mut buf = [0u8; 5];\n521\t        let n = base64_encode(b\"Ma\", &mut buf).unwrap();\n522\t        assert_eq!(n, 4);\n523\t        assert_eq!(&buf[..4], b\"TWE=\");\n524\t    }\n525\t\n526\t    #[test]\n527\t    fn base64_encode_buffer_too_small() {\n528\t        let mut buf = [0u8; 4]; // needs 5 (4 chars + NUL)\n529\t        assert!(base64_encode(b\"Man\", &mut buf).is_err());\n530\t    }\n531\t\n532\t    #[test]\n533\t    fn base64_encoded_len_values() {\n534\t        assert_eq!(base64_encoded_len(0), 0);\n535\t        assert_eq!(base64_encoded_len(1), 4);\n536\t        assert_eq!(base64_encoded_len(2), 4);\n537\t        assert_eq!(base64_encoded_len(3), 4);\n538\t        assert_eq!(base64_encoded_len(4), 8);\n539\t        assert_eq!(base64_encoded_len(6), 8);\n540\t    }\n541\t\n542\t    #[test]\n543\t    fn ech_get_ciphers_p256() {\n544\t        let mut out = [HpkeCipherSuiteId { kdf: 0, aead: 0 }; 4];\n545\t        let n = ech_get_ciphers_from_kem(kem_id::P256_SHA256, &mut out).unwrap();\n546\t        assert!(n >= 1);\n547\t        assert_eq!(out[0].kdf, kdf_id::HKDF_SHA256);\n548\t        assert_eq!(out[0].aead, aead_id::AES_128_GCM);\n549\t    }\n550\t\n551\t    #[test]\n552\t    fn ech_get_ciphers_p384() {\n553\t        let mut out = [HpkeCipherSuiteId { kdf: 0, aead: 0 }; 4];\n554\t        let n = ech_get_ciphers_from_kem(kem_id::P384_SHA384, &mut out).unwrap();\n555\t        assert!(n >= 1);\n556\t        assert_eq!(out[0].kdf, kdf_id::HKDF_SHA384);\n557\t        assert_eq!(out[0].aead, aead_id::AES_256_GCM);\n558\t    }\n559\t\n560\t    #[test]\n561\t    fn ech_get_ciphers_x25519() {\n562\t        let mut out = [HpkeCipherSuiteId { kdf: 0, aead: 0 }; 4];\n563\t        let n = ech_get_ciphers_from_kem(kem_id::X25519_SHA256, &mut out).unwrap();\n564\t        assert!(n >= 1);\n565\t        assert_eq!(out[0].kdf, kdf_id::HKDF_SHA256);\n566\t        assert_eq!(out[0].aead, aead_id::CHACHA20_POLY1305);\n567\t    }\n568\t\n569\t    #[test]\n570\t    fn ech_get_ciphers_out_too_small() {\n571\t        let mut out = [HpkeCipherSuiteId { kdf: 0, aead: 0 }; 1];\n572\t        assert!(ech_get_ciphers_from_kem(kem_id::P256_SHA256, &mut out).is_err());\n573\t    }\n574\t\n575\t    #[test]\n576\t    fn config_id_is_deterministic() {\n577\t        let key = [1u8, 2, 3, 4];\n578\t        let suites = [HpkeCipherSuiteId {\n579\t            kdf: kdf_id::HKDF_SHA256,\n580\t            aead: aead_id::AES_128_GCM,\n581\t        }];\n582\t        let id1 = ech_config_id_from_config(&key, kem_id::X25519_SHA256, &suites, \"example.com\");\n583\t        let id2 = ech_config_id_from_config(&key, kem_id::X25519_SHA256, &suites, \"example.com\");\n584\t        assert_eq!(id1, id2);\n585\t    }\n586\t\n587\t    #[test]\n588\t    fn config_id_changes_with_key() {\n589\t        let suites = [HpkeCipherSuiteId {\n590\t            kdf: kdf_id::HKDF_SHA256,\n591\t            aead: aead_id::AES_128_GCM,\n592\t        }];\n593\t        let id1 =\n594\t            ech_config_id_from_config(&[1, 2, 3], kem_id::X25519_SHA256, &suites, \"example.com\");\n595\t        let id2 =\n596\t            ech_config_id_from_config(&[4, 5, 6], kem_id::X25519_SHA256, &suites, \"example.com\");\n597\t        assert_ne!(id1, id2);\n598\t    }\n599\t\n600\t    #[test]\n601\t    fn kem_from_curve_known_groups() {\n602\t        assert_eq!(\n603\t            ech_get_kem_from_curve(group_id::SECP256R1),\n604\t            Some(kem_id::P256_SHA256)\n605\t        );\n606\t        assert_eq!(\n607\t            ech_get_kem_from_curve(group_id::SECP384R1),\n608\t            Some(kem_id::P384_SHA384)\n609\t        );\n610\t        assert_eq!(\n611\t            ech_get_kem_from_curve(group_id::X25519),\n612\t            Some(kem_id::X25519_SHA256)\n613\t        );\n614\t    }\n615\t\n616\t    #[test]\n617\t    fn kem_from_curve_unknown() {\n618\t        assert_eq!(ech_get_kem_from_curve(0xFFFF), None);\n619\t    }\n620\t\n621\t    // Minimal DER-encoded SubjectPublicKeyInfo for X25519 (RFC 8410):\n622\t    // SEQUENCE {\n623\t    //   SEQUENCE { OID 1.3.101.110 }        -- id-X25519\n624\t    //   BIT STRING { 0x00 <32 zero bytes> }  -- fake key, padding=0\n625\t    // }\n626\t    fn x25519_spki() -> Vec<u8> {\n627\t        let oid: &[u8] = &[0x2b, 0x65, 0x6e]; // 1.3.101.110\n628\t        // inner SEQUENCE: OID TLV\n629\t        let mut inner = Vec::new();\n630\t        inner.push(0x06);\n631\t        inner.push(oid.len() as u8);\n632\t        inner.extend_from_slice(oid);\n633\t        // BIT STRING: padding byte + 32-byte key\n634\t        let mut bs_val = vec![0x00u8]; // padding count\n635\t        bs_val.extend_from_slice(&[0xABu8; 32]);\n636\t        let mut outer = Vec::new();\n637\t        // inner SEQUENCE TLV\n638\t        outer.push(0x30);\n639\t        outer.push(inner.len() as u8);\n640\t        outer.extend_from_slice(&inner);\n641\t        // BIT STRING TLV\n642\t        outer.push(0x03);\n643\t        outer.push(bs_val.len() as u8);\n644\t        outer.extend_from_slice(&bs_val);\n645\t        // wrap in outer SEQUENCE\n646\t        let mut spki = Vec::new();\n647\t        spki.push(0x30);\n648\t        spki.push(outer.len() as u8);\n649\t        spki.extend_from_slice(&outer);\n650\t        spki\n651\t    }\n652\t\n653\t    #[test]\n654\t    fn parse_public_key_asn1_x25519() {\n655\t        let spki = x25519_spki();\n656\t        let r = parse_public_key_asn1(&spki).unwrap();\n657\t        assert_eq!(r.algo, &[0x2b, 0x65, 0x6e]);\n658\t        assert_eq!(r.param, &[] as &[u8]); // X25519 has no parameters\n659\t        assert_eq!(r.bit_string[0], 0x00); // padding byte\n660\t        assert_eq!(r.bit_string.len(), 33); // 1 + 32 key bytes\n661\t        assert_eq!(r.consumed, spki.len());\n662\t    }\n663\t\n664\t    #[test]\n665\t    fn parse_public_key_asn1_truncated() {\n666\t        let spki = x25519_spki();\n667\t        assert!(parse_public_key_asn1(&spki[..4]).is_err());\n668\t    }\n669\t\n670\t    #[test]\n671\t    fn parse_public_key_asn1_wrong_outer_tag() {\n672\t        let mut spki = x25519_spki();\n673\t        spki[0] = 0x31; // SET instead of SEQUENCE\n674\t        assert!(parse_public_key_asn1(&spki).is_err());\n675\t    }\n676\t}\n677\t"}]},"parent_tool_use_id":null,"session_id":"ce9760c1-0503-4891-9073-2bbfbb3810ec","uuid":"3c1d2c92-a4c5-45d4-82d4-893c70e3f2df","timestamp":"2026-05-07T07:43:42.620Z","tool_use_result":{"type":"text","file":{"filePath":"/Users/richbarn/Projects/picoquic/rs/fq/src/ech.rs","content":"//! Encrypted ClientHello (ECH) helpers.\n//!\n//! Pure-Rust portion of the ECH support layer.  The HPKE key-exchange\n//! operations that require ECDH primitives (DHKEM-X25519, DHKEM-P256,\n//! DHKEM-P384) are currently `todo!()` pending the addition of the `hpke`\n//! crate to Cargo.toml.  Everything else — the cipher-suite selector, the\n//! config-ID digest, base64 encoding, and the opener-state plumbing — is\n//! fully translated from `picoquic/ech.c`.\n\nextern crate alloc;\nuse alloc::vec::Vec;\n\nuse crate::Error;\n\n// ---------------------------------------------------------------------------\n// HPKE constants (IANA registries, RFC 9180).\n\n/// HPKE KEM algorithm identifiers (RFC 9180 §7.1).\npub mod kem_id {\n    /// DHKEM(P-256, HKDF-SHA256)\n    pub const P256_SHA256: u16 = 0x0010;\n    /// DHKEM(P-384, HKDF-SHA384)\n    pub const P384_SHA384: u16 = 0x0011;\n    /// DHKEM(X25519, HKDF-SHA256)\n    pub const X25519_SHA256: u16 = 0x0020;\n}\n\n/// HPKE KDF algorithm identifiers (RFC 9180 §7.2).\npub mod kdf_id {\n    /// HKDF-SHA256\n    pub const HKDF_SHA256: u16 = 0x0001;\n    /// HKDF-SHA384\n    pub const HKDF_SHA384: u16 = 0x0002;\n    /// HKDF-SHA512\n    pub const HKDF_SHA512: u16 = 0x0003;\n}\n\n/// HPKE AEAD algorithm identifiers (RFC 9180 §7.3).\npub mod aead_id {\n    /// AES-128-GCM\n    pub const AES_128_GCM: u16 = 0x0001;\n    /// AES-256-GCM\n    pub const AES_256_GCM: u16 = 0x0002;\n    /// ChaCha20-Poly1305\n    pub const CHACHA20_POLY1305: u16 = 0x0003;\n}\n\n// ---------------------------------------------------------------------------\n// Cipher-suite identifier.\n\n/// HPKE symmetric cipher-suite: (KDF id, AEAD id) pair.\n///\n/// C: `ptls_hpke_cipher_suite_id_t`\n#[derive(Debug, Clone, Copy, PartialEq, Eq)]\npub struct HpkeCipherSuiteId {\n    pub kdf: u16,\n    pub aead: u16,\n}\n\n/// The three cipher suites we advertise as supported, mirroring the\n/// `picoquic_hpke_cipher_suites[]` array that the C picotls backend\n/// populates at startup.\nconst SUPPORTED_CIPHER_SUITES: &[HpkeCipherSuiteId] = &[\n    HpkeCipherSuiteId {\n        kdf: kdf_id::HKDF_SHA256,\n        aead: aead_id::AES_128_GCM,\n    },\n    HpkeCipherSuiteId {\n        kdf: kdf_id::HKDF_SHA256,\n        aead: aead_id::CHACHA20_POLY1305,\n    },\n    HpkeCipherSuiteId {\n        kdf: kdf_id::HKDF_SHA384,\n        aead: aead_id::AES_256_GCM,\n    },\n];\n\n// ---------------------------------------------------------------------------\n// Base64 encoding.\n\nconst BASE64_ALPHABET: &[u8; 64] =\n    b\"ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789+/\";\n\n/// Return the number of base64 characters needed to encode `input_len` bytes,\n/// not counting a NUL terminator.  Mirrors `ptls_base64_howlong`.\n#[inline]\npub fn base64_encoded_len(input_len: usize) -> usize {\n    input_len.div_ceil(3) * 4\n}\n\n/// Encode `input` as standard RFC 4648 base64 into `out`.\n///\n/// `out` must be at least `base64_encoded_len(input.len()) + 1` bytes long\n/// (the extra byte is for the NUL terminator written to match picotls\n/// convention).  Returns the number of base64 characters written (excluding\n/// the NUL).  Returns `Err(Error::Generic)` when `out` is too small.\n///\n/// C: `picoquic_base64_encode`\npub fn base64_encode(input: &[u8], out: &mut [u8]) -> Result<usize, Error> {\n    let len = base64_encoded_len(input.len());\n    if len + 1 > out.len() {\n        return Err(Error::Generic);\n    }\n    let mut pos = 0usize;\n    let mut chunks = input.chunks_exact(3);\n    for chunk in &mut chunks {\n        let b = ((chunk[0] as u32) << 16) | ((chunk[1] as u32) << 8) | (chunk[2] as u32);\n        out[pos] = BASE64_ALPHABET[((b >> 18) & 0x3f) as usize];\n        out[pos + 1] = BASE64_ALPHABET[((b >> 12) & 0x3f) as usize];\n        out[pos + 2] = BASE64_ALPHABET[((b >> 6) & 0x3f) as usize];\n        out[pos + 3] = BASE64_ALPHABET[(b & 0x3f) as usize];\n        pos += 4;\n    }\n    match chunks.remainder() {\n        [a] => {\n            let b = (*a as u32) << 16;\n            out[pos] = BASE64_ALPHABET[((b >> 18) & 0x3f) as usize];\n            out[pos + 1] = BASE64_ALPHABET[((b >> 12) & 0x3f) as usize];\n            out[pos + 2] = b'=';\n            out[pos + 3] = b'=';\n            pos += 4;\n        }\n        [a, b] => {\n            let v = ((*a as u32) << 16) | ((*b as u32) << 8);\n            out[pos] = BASE64_ALPHABET[((v >> 18) & 0x3f) as usize];\n            out[pos + 1] = BASE64_ALPHABET[((v >> 12) & 0x3f) as usize];\n            out[pos + 2] = BASE64_ALPHABET[((v >> 6) & 0x3f) as usize];\n            out[pos + 3] = b'=';\n            pos += 4;\n        }\n        _ => {}\n    }\n    out[pos] = 0; // NUL terminator (mirrors ptls_base64_encode convention)\n    Ok(len)\n}\n\n// ---------------------------------------------------------------------------\n// Cipher-suite selector.\n\n/// Fill `out` with HPKE cipher suites appropriate for `kem_id`, returning\n/// the number of entries written.\n///\n/// The first entry is the preferred suite for the given KEM; when there is\n/// also a suitable default suite (AES-128-GCM + HKDF-SHA256) that differs\n/// from the preferred one and `out.len() > 2`, it is appended as the second\n/// entry.\n///\n/// Returns `Err(Error::Generic)` if `out.len() < 2` (mirrors the C guard\n/// `cipher_vec_nb_max < 2`) or if no suite can be found.\n///\n/// C: `picoquic_ech_get_ciphers_from_kem`\npub fn ech_get_ciphers_from_kem(\n    kem_id: u16,\n    out: &mut [HpkeCipherSuiteId],\n) -> Result<usize, Error> {\n    if out.len() < 2 {\n        return Err(Error::Generic);\n    }\n\n    let (target_kdf, target_aead) = match kem_id {\n        kem_id::P256_SHA256 => (kdf_id::HKDF_SHA256, aead_id::AES_128_GCM),\n        kem_id::P384_SHA384 => (kdf_id::HKDF_SHA384, aead_id::AES_256_GCM),\n        kem_id::X25519_SHA256 => (kdf_id::HKDF_SHA256, aead_id::CHACHA20_POLY1305),\n        _ => (kdf_id::HKDF_SHA256, aead_id::AES_128_GCM),\n    };\n    let target = HpkeCipherSuiteId {\n        kdf: target_kdf,\n        aead: target_aead,\n    };\n    let default_suite = HpkeCipherSuiteId {\n        kdf: kdf_id::HKDF_SHA256,\n        aead: aead_id::AES_128_GCM,\n    };\n\n    let mut target_cipher: Option<HpkeCipherSuiteId> = None;\n    let mut default_cipher: Option<HpkeCipherSuiteId> = None;\n\n    for &suite in SUPPORTED_CIPHER_SUITES {\n        if target_cipher.is_none() && suite == target {\n            target_cipher = Some(suite);\n        }\n        if default_cipher.is_none() && suite == default_suite {\n            default_cipher = Some(suite);\n        }\n    }\n\n    // Mirrors the C branching: target first; fall back to default; error if neither.\n    // C: `cipher_vec_nb_max > 2` guards adding the default as a second entry.\n    let nb_ciphers = match (target_cipher, default_cipher) {\n        (Some(t), def) => {\n            out[0] = t;\n            if let Some(d) = def {\n                if d != t && out.len() > 2 {\n                    out[1] = d;\n                    2\n                } else {\n                    1\n                }\n            } else {\n                1\n            }\n        }\n        (None, Some(d)) => {\n            out[0] = d;\n            1\n        }\n        (None, None) => return Err(Error::Generic),\n    };\n    Ok(nb_ciphers)\n}\n\n// ---------------------------------------------------------------------------\n// Config-ID derivation (private helper).\n\n/// Compute the one-byte ECH config-ID from the public key material, KEM id,\n/// cipher suites, and the server public name.\n///\n/// The algorithm accumulates all bytes into a `u64` then XOR-folds the\n/// result down to a single byte.\n///\n/// C: `ech_config_id_from_config` (file-static)\nfn ech_config_id_from_config(\n    public_key_bits: &[u8],\n    kem_id: u16,\n    cipher_suites: &[HpkeCipherSuiteId],\n    public_name: &str,\n) -> u8 {\n    let mut config_sum: u64 = 0;\n    for &b in public_key_bits {\n        config_sum = config_sum.wrapping_add(b as u64);\n    }\n    config_sum = config_sum.wrapping_add(kem_id as u64);\n    for cs in cipher_suites {\n        config_sum = config_sum.wrapping_add(cs.aead as u64);\n        config_sum = config_sum.wrapping_add(cs.kdf as u64);\n    }\n    for b in public_name.bytes() {\n        config_sum = config_sum.wrapping_add(b as u64);\n    }\n    let mut config_id: u8 = 0;\n    while config_sum > 0 {\n        config_id ^= (config_sum & 0xff) as u8;\n        config_sum >>= 8;\n    }\n    config_id\n}\n\n// ---------------------------------------------------------------------------\n// Server-side ECH opener state.\n\n/// Result returned by a successful [`EchOpenerState::open`] call.\n///\n/// When the HPKE decapsulation step is complete, `key_material` will hold\n/// the derived AEAD key bytes; callers build the concrete AEAD context from\n/// it together with `cipher`.\npub struct EchOpenResult {\n    /// The negotiated cipher suite.\n    pub cipher: HpkeCipherSuiteId,\n    /// HPKE-derived key material for the AEAD context.  Empty until the\n    /// DHKEM decapsulation is implemented.\n    pub key_material: Vec<u8>,\n}\n\n/// Server-side ECH opener callback state.\n///\n/// Holds the KEM id, the private key bytes used for HPKE decapsulation,\n/// and the serialised ECH config bytes (used to reconstruct the HPKE `info`\n/// string during opening).\n///\n/// C: `ech_opener_callback_t`\npub struct EchOpenerState {\n    /// HPKE KEM identifier, e.g. `kem_id::X25519_SHA256`.\n    /// C: `kem` (`ptls_hpke_kem_t*`; we store only the numeric id).\n    pub kem_id: u16,\n    /// Raw private key bytes for HPKE decapsulation.\n    /// C: `keyex` (`ptls_key_exchange_context_t*` loaded from a PEM file).\n    pub private_key: Vec<u8>,\n    /// Serialised ECH config bytes including the two-byte outer length prefix.\n    /// C: `config` (`ptls_buffer_t`).\n    pub config: Vec<u8>,\n}\n\nimpl EchOpenerState {\n    /// Attempt to open (decapsulate) an incoming ECH extension.\n    ///\n    /// Finds the cipher suite matching `cipher_id` in the supported list,\n    /// builds the HPKE `info` string as `info_prefix || config[2..]`, and\n    /// then performs the HPKE recipient setup to derive the AEAD key.\n    ///\n    /// Returns `Some(EchOpenResult)` on success, `None` when `cipher_id` is\n    /// not in the supported list.\n    ///\n    /// # Blocker\n    ///\n    /// The HPKE decapsulation step (`ptls_hpke_setup_base_r` equivalent)\n    /// requires DHKEM primitives.  Add the `hpke` crate with the\n    /// `x25519`/`p256`/`p384` features to Cargo.toml and replace the\n    /// `todo!()` below with the corresponding `hpke::setup_receiver` call.\n    ///\n    /// C: `ech_opener_callback`\n    pub fn open(\n        &self,\n        cipher_id: HpkeCipherSuiteId,\n        enc: &[u8],\n        info_prefix: &[u8],\n    ) -> Option<EchOpenResult> {\n        // Find the matching cipher suite in the supported list.\n        let cipher = SUPPORTED_CIPHER_SUITES\n            .iter()\n            .copied()\n            .find(|c| c.kdf == cipher_id.kdf && c.aead == cipher_id.aead)?;\n\n        // Build info = info_prefix || config[2..]\n        // (config[0..2] is the two-byte ECHConfigList outer length prefix,\n        // skipped to match the `ptls_buffer_pushv(&infobuf, config.base+2, …)`\n        // call in the C implementation.)\n        let config_payload = self.config.get(2..).unwrap_or(&[]);\n        let mut info = Vec::with_capacity(info_prefix.len() + config_payload.len());\n        info.extend_from_slice(info_prefix);\n        info.extend_from_slice(config_payload);\n\n        // blocked: DHKEM decapsulation (ptls_hpke_setup_base_r equivalent).\n        // Add `hpke` crate with x25519/p256/p384 feature to Cargo.toml, then\n        // call hpke::setup_receiver(self.kem_id, cipher, &self.private_key, enc, &info)\n        // to obtain the exported key material.\n        let _ = (enc, &info, &self.private_key, self.kem_id, cipher);\n        todo!(\n            \"blocked: HPKE recipient setup for ech_opener_callback requires DHKEM — \\\n             add the `hpke` crate (x25519/p256/p384 features) to Cargo.toml\"\n        )\n    }\n}\n\n// ---------------------------------------------------------------------------\n// TLS group-id → HPKE KEM-id mapping.\n\n/// TLS named-group identifiers (RFC 8446 §4.2.7, as used by picotls).\npub mod group_id {\n    /// secp256r1 / P-256  (`PTLS_GROUP_SECP256R1`)\n    pub const SECP256R1: u16 = 23;\n    /// secp384r1 / P-384  (`PTLS_GROUP_SECP384R1`)\n    pub const SECP384R1: u16 = 24;\n    /// X25519             (`PTLS_GROUP_X25519`)\n    pub const X25519: u16 = 29;\n}\n\n/// Find the HPKE KEM identifier for the given TLS named-group id.\n///\n/// Mirrors the C loop over `picoquic_hpke_kems[]` that matches on\n/// `picoquic_hpke_kems[i]->keyex->id == group_id`.\n///\n/// Returns `Some(kem_id)` on success, `None` when the group is not\n/// one of the three supported curves.\n///\n/// C: `picoquic_ech_get_kem_from_curve`\npub fn ech_get_kem_from_curve(group_id: u16) -> Option<u16> {\n    match group_id {\n        group_id::SECP256R1 => Some(kem_id::P256_SHA256),\n        group_id::SECP384R1 => Some(kem_id::P384_SHA384),\n        group_id::X25519 => Some(kem_id::X25519_SHA256),\n        _ => None,\n    }\n}\n\n// ---------------------------------------------------------------------------\n// ASN.1 DER SubjectPublicKeyInfo parser.\n\n/// Parsed fields extracted from a DER-encoded SubjectPublicKeyInfo blob.\n///\n/// All slices borrow from the original input passed to\n/// [`parse_public_key_asn1`], so their lifetime is tied to that input.\n///\n/// C: the four output parameters of `picoquic_parse_public_key_asn1`.\npub struct PublicKeyAsn1<'a> {\n    /// Algorithm OID value bytes (tag + length stripped).\n    ///\n    /// C: `public_key_algo.{base,len}`\n    pub algo: &'a [u8],\n    /// Parameters field: raw bytes from after the algorithm OID to the\n    /// end of the inner AlgorithmIdentifier SEQUENCE.  Includes the\n    /// tag + length of any nested TLV; empty when there are no parameters\n    /// (e.g. X25519 keys).\n    ///\n    /// C: `public_key_param.{base,len}`\n    pub param: &'a [u8],\n    /// BIT STRING value bytes.  The first byte is the padding-count\n    /// (always `0x00` for the curves picoquic supports); the key bytes\n    /// follow immediately.\n    ///\n    /// C: `public_key_bit_string.{base,len}`\n    pub bit_string: &'a [u8],\n    /// Total number of bytes consumed from the input.\n    pub consumed: usize,\n}\n\n/// Parse a DER TLV header at `pos` within `bytes[..bytes_max]`.\n///\n/// `expected_type` must match the tag byte.  Returns `(value_start, value_end)`\n/// on success, `Err` on type mismatch, truncation, or overflow.\nfn asn1_tlv(\n    bytes: &[u8],\n    bytes_max: usize,\n    pos: usize,\n    expected_type: u8,\n) -> Result<(usize, usize), Error> {\n    if pos >= bytes_max || bytes[pos] != expected_type {\n        return Err(Error::Generic);\n    }\n    let pos = pos + 1;\n    if pos >= bytes_max {\n        return Err(Error::Generic);\n    }\n    let first = bytes[pos];\n    let (length, val_start) = if first < 0x80 {\n        (first as usize, pos + 1)\n    } else {\n        let n = (first & 0x7F) as usize;\n        if n == 0 || pos + 1 + n > bytes_max {\n            return Err(Error::Generic);\n        }\n        let mut len = 0usize;\n        for i in 0..n {\n            len = (len << 8) | (bytes[pos + 1 + i] as usize);\n        }\n        (len, pos + 1 + n)\n    };\n    let val_end = val_start + length;\n    if val_end > bytes_max {\n        return Err(Error::Generic);\n    }\n    Ok((val_start, val_end))\n}\n\n/// Parse a DER-encoded SubjectPublicKeyInfo structure.\n///\n/// Walks the outer SEQUENCE → AlgorithmIdentifier SEQUENCE → OID +\n/// optional parameters → BIT STRING layout described in RFC 5480 and\n/// RFC 8410, returning zero-copy sub-slices into `input`.\n///\n/// Returns `Err(Error::Generic)` for any structural violation (wrong tag,\n/// truncated length field, outer-sequence length mismatch, or trailing\n/// bytes after the BIT STRING).\n///\n/// C: `picoquic_parse_public_key_asn1`\npub fn parse_public_key_asn1(input: &[u8]) -> Result<PublicKeyAsn1<'_>, Error> {\n    let bytes_max = input.len();\n\n    // Outer SEQUENCE must span the entire buffer.\n    let (outer_val, outer_end) = asn1_tlv(input, bytes_max, 0, 0x30)?;\n    if outer_end != bytes_max {\n        return Err(Error::Generic); // PTLS_ERROR_BER_EXCESSIVE_LENGTH\n    }\n\n    // AlgorithmIdentifier SEQUENCE.\n    let (inner_val, inner_end) = asn1_tlv(input, outer_end, outer_val, 0x30)?;\n\n    // Algorithm OID — value bytes only (tag + length consumed by asn1_tlv).\n    let (oid_val, oid_end) = asn1_tlv(input, inner_end, inner_val, 0x06)?;\n    let algo = &input[oid_val..oid_end];\n\n    // Parameters: everything remaining in the inner SEQUENCE after the OID.\n    let param = if inner_end <= oid_end {\n        &input[0..0]\n    } else {\n        &input[oid_end..inner_end]\n    };\n\n    // BIT STRING (public key), must consume the rest of the outer SEQUENCE.\n    let (bs_val, bs_end) = asn1_tlv(input, outer_end, inner_end, 0x03)?;\n    if bs_end != outer_end {\n        return Err(Error::Generic); // PTLS_ERROR_BER_ELEMENT_TOO_SHORT\n    }\n    let bit_string = &input[bs_val..bs_end];\n\n    Ok(PublicKeyAsn1 {\n        algo,\n        param,\n        bit_string,\n        consumed: bs_end,\n    })\n}\n\n// ---------------------------------------------------------------------------\n// Tests.\n\n#[cfg(test)]\nmod tests {\n    use super::*;\n\n    #[test]\n    fn base64_encode_empty() {\n        let mut buf = [0u8; 1];\n        let n = base64_encode(&[], &mut buf).unwrap();\n        assert_eq!(n, 0);\n        assert_eq!(buf[0], 0);\n    }\n\n    #[test]\n    fn base64_encode_three_bytes() {\n        // \"Man\" → \"TWFu\"\n        let mut buf = [0u8; 5];\n        let n = base64_encode(b\"Man\", &mut buf).unwrap();\n        assert_eq!(n, 4);\n        assert_eq!(&buf[..4], b\"TWFu\");\n        assert_eq!(buf[4], 0);\n    }\n\n    #[test]\n    fn base64_encode_padding_one() {\n        // \"M\" → \"TQ==\"\n        let mut buf = [0u8; 5];\n        let n = base64_encode(b\"M\", &mut buf).unwrap();\n        assert_eq!(n, 4);\n        assert_eq!(&buf[..4], b\"TQ==\");\n    }\n\n    #[test]\n    fn base64_encode_padding_two() {\n        // \"Ma\" → \"TWE=\"\n        let mut buf = [0u8; 5];\n        let n = base64_encode(b\"Ma\", &mut buf).unwrap();\n        assert_eq!(n, 4);\n        assert_eq!(&buf[..4], b\"TWE=\");\n    }\n\n    #[test]\n    fn base64_encode_buffer_too_small() {\n        let mut buf = [0u8; 4]; // needs 5 (4 chars + NUL)\n        assert!(base64_encode(b\"Man\", &mut buf).is_err());\n    }\n\n    #[test]\n    fn base64_encoded_len_values() {\n        assert_eq!(base64_encoded_len(0), 0);\n        assert_eq!(base64_encoded_len(1), 4);\n        assert_eq!(base64_encoded_len(2), 4);\n        assert_eq!(base64_encoded_len(3), 4);\n        assert_eq!(base64_encoded_len(4), 8);\n        assert_eq!(base64_encoded_len(6), 8);\n    }\n\n    #[test]\n    fn ech_get_ciphers_p256() {\n        let mut out = [HpkeCipherSuiteId { kdf: 0, aead: 0 }; 4];\n        let n = ech_get_ciphers_from_kem(kem_id::P256_SHA256, &mut out).unwrap();\n        assert!(n >= 1);\n        assert_eq!(out[0].kdf, kdf_id::HKDF_SHA256);\n        assert_eq!(out[0].aead, aead_id::AES_128_GCM);\n    }\n\n    #[test]\n    fn ech_get_ciphers_p384() {\n        let mut out = [HpkeCipherSuiteId { kdf: 0, aead: 0 }; 4];\n        let n = ech_get_ciphers_from_kem(kem_id::P384_SHA384, &mut out).unwrap();\n        assert!(n >= 1);\n        assert_eq!(out[0].kdf, kdf_id::HKDF_SHA384);\n        assert_eq!(out[0].aead, aead_id::AES_256_GCM);\n    }\n\n    #[test]\n    fn ech_get_ciphers_x25519() {\n        let mut out = [HpkeCipherSuiteId { kdf: 0, aead: 0 }; 4];\n        let n = ech_get_ciphers_from_kem(kem_id::X25519_SHA256, &mut out).unwrap();\n        assert!(n >= 1);\n        assert_eq!(out[0].kdf, kdf_id::HKDF_SHA256);\n        assert_eq!(out[0].aead, aead_id::CHACHA20_POLY1305);\n    }\n\n    #[test]\n    fn ech_get_ciphers_out_too_small() {\n        let mut out = [HpkeCipherSuiteId { kdf: 0, aead: 0 }; 1];\n        assert!(ech_get_ciphers_from_kem(kem_id::P256_SHA256, &mut out).is_err());\n    }\n\n    #[test]\n    fn config_id_is_deterministic() {\n        let key = [1u8, 2, 3, 4];\n        let suites = [HpkeCipherSuiteId {\n            kdf: kdf_id::HKDF_SHA256,\n            aead: aead_id::AES_128_GCM,\n        }];\n        let id1 = ech_config_id_from_config(&key, kem_id::X25519_SHA256, &suites, \"example.com\");\n        let id2 = ech_config_id_from_config(&key, kem_id::X25519_SHA256, &suites, \"example.com\");\n        assert_eq!(id1, id2);\n    }\n\n    #[test]\n    fn config_id_changes_with_key() {\n        let suites = [HpkeCipherSuiteId {\n            kdf: kdf_id::HKDF_SHA256,\n            aead: aead_id::AES_128_GCM,\n        }];\n        let id1 =\n            ech_config_id_from_config(&[1, 2, 3], kem_id::X25519_SHA256, &suites, \"example.com\");\n        let id2 =\n            ech_config_id_from_config(&[4, 5, 6], kem_id::X25519_SHA256, &suites, \"example.com\");\n        assert_ne!(id1, id2);\n    }\n\n    #[test]\n    fn kem_from_curve_known_groups() {\n        assert_eq!(\n            ech_get_kem_from_curve(group_id::SECP256R1),\n            Some(kem_id::P256_SHA256)\n        );\n        assert_eq!(\n            ech_get_kem_from_curve(group_id::SECP384R1),\n            Some(kem_id::P384_SHA384)\n        );\n        assert_eq!(\n            ech_get_kem_from_curve(group_id::X25519),\n            Some(kem_id::X25519_SHA256)\n        );\n    }\n\n    #[test]\n    fn kem_from_curve_unknown() {\n        assert_eq!(ech_get_kem_from_curve(0xFFFF), None);\n    }\n\n    // Minimal DER-encoded SubjectPublicKeyInfo for X25519 (RFC 8410):\n    // SEQUENCE {\n    //   SEQUENCE { OID 1.3.101.110 }        -- id-X25519\n    //   BIT STRING { 0x00 <32 zero bytes> }  -- fake key, padding=0\n    // }\n    fn x25519_spki() -> Vec<u8> {\n        let oid: &[u8] = &[0x2b, 0x65, 0x6e]; // 1.3.101.110\n        // inner SEQUENCE: OID TLV\n        let mut inner = Vec::new();\n        inner.push(0x06);\n        inner.push(oid.len() as u8);\n        inner.extend_from_slice(oid);\n        // BIT STRING: padding byte + 32-byte key\n        let mut bs_val = vec![0x00u8]; // padding count\n        bs_val.extend_from_slice(&[0xABu8; 32]);\n        let mut outer = Vec::new();\n        // inner SEQUENCE TLV\n        outer.push(0x30);\n        outer.push(inner.len() as u8);\n        outer.extend_from_slice(&inner);\n        // BIT STRING TLV\n        outer.push(0x03);\n        outer.push(bs_val.len() as u8);\n        outer.extend_from_slice(&bs_val);\n        // wrap in outer SEQUENCE\n        let mut spki = Vec::new();\n        spki.push(0x30);\n        spki.push(outer.len() as u8);\n        spki.extend_from_slice(&outer);\n        spki\n    }\n\n    #[test]\n    fn parse_public_key_asn1_x25519() {\n        let spki = x25519_spki();\n        let r = parse_public_key_asn1(&spki).unwrap();\n        assert_eq!(r.algo, &[0x2b, 0x65, 0x6e]);\n        assert_eq!(r.param, &[] as &[u8]); // X25519 has no parameters\n        assert_eq!(r.bit_string[0], 0x00); // padding byte\n        assert_eq!(r.bit_string.len(), 33); // 1 + 32 key bytes\n        assert_eq!(r.consumed, spki.len());\n    }\n\n    #[test]\n    fn parse_public_key_asn1_truncated() {\n        let spki = x25519_spki();\n        assert!(parse_public_key_asn1(&spki[..4]).is_err());\n    }\n\n    #[test]\n    fn parse_public_key_asn1_wrong_outer_tag() {\n        let mut spki = x25519_spki();\n        spki[0] = 0x31; // SET instead of SEQUENCE\n        assert!(parse_public_key_asn1(&spki).is_err());\n    }\n}\n","numLines":677,"startLine":1,"totalLines":677}}}
