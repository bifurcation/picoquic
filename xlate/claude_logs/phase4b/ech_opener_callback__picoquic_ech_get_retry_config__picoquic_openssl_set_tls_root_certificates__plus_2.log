{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_0182tzk6Go1yPYsd1qTtdySW","type":"tool_result","content":"1\t//! Test case for `picoquictest/openssl_test.c`.\n2\t//!\n3\t//! Exercises the OpenSSL certificate-loading helper by verifying that\n4\t//! PEM files with one, one, and two certificates are parsed correctly.\n5\t\n6\t#![allow(non_snake_case)]\n7\t\n8\tuse crate::tls_api::get_certs_from_file;\n9\t\n10\t/// Load a certificate file and assert the correct number of DER blobs.\n11\t/// C: `openssl_cert_test_one`.\n12\tfn openssl_cert_test_one(cert_file_name: &str, expected_count: usize) {\n13\t    let base = std::path::Path::new(env!(\"CARGO_MANIFEST_DIR\"))\n14\t        .join(\"../../certs/tests\")\n15\t        .join(cert_file_name);\n16\t    let path = base.to_string_lossy();\n17\t    let certs = get_certs_from_file(&path);\n18\t    let count = certs.as_ref().map(|v| v.len()).unwrap_or(0);\n19\t    if count != expected_count {\n20\t        panic!(\"Expected {expected_count} certs for {cert_file_name}, got {count}\");\n21\t    }\n22\t}\n23\t\n24\t/// C: `openssl_cert_test`.\n25\t#[test]\n26\tfn openssl_cert() {\n27\t    openssl_cert_test_one(\"cert.pem\", 1);\n28\t    openssl_cert_test_one(\"chain.pem\", 1);\n29\t    openssl_cert_test_one(\"fullchain.pem\", 2);\n30\t}\n31\t"}]},"parent_tool_use_id":"toolu_01HUvr9rnNYfbmjJkXiGVZwB","session_id":"ce9760c1-0503-4891-9073-2bbfbb3810ec","uuid":"4703b61d-478c-41fb-8b47-a7032fb66d85","timestamp":"2026-05-07T08:05:47.947Z"}
