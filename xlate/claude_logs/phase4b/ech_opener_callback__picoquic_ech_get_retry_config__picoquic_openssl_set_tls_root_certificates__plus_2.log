{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01XhUSCz5i52uSrhKKnoNGrb","type":"tool_result","content":"250\t        }\n251\t    }\n252\t}\n253\t\n254\t/// Wait up to `delta_t` microseconds for a packet on any socket\n255\t/// in `sockets`, then read at most `buffer.len()` bytes.\n256\t///\n257\t/// Generic over the [`Socket`] implementation.  C:\n258\t/// `picoquic_select` and `picoquic_select_ex` are merged here —\n259\t/// the `_ex` form is the more general one; the rank lives in\n260\t/// [`SelectInfo`].\n261\tpub fn select<S: Socket>(\n262\t    sockets: &mut [S],\n263\t    buffer: &mut [u8],\n264\t    _delta_t: i64,\n265\t) -> Result<SelectInfo, Error> {\n266\t    // Faithful note: the C body uses select(2) with raw file descriptors.\n267\t    // The generic Socket trait does not expose a file descriptor, so this\n268\t    // fallback tries each socket once in order and returns the first that\n269\t    // delivers data.  Platform-specific implementations can supply a more\n270\t    // efficient multiplexed select via the concrete Socket type.\n271\t    for (rank, socket) in sockets.iter_mut().enumerate() {\n272\t        match socket.recv(buffer) {\n273\t            Ok(info) if info.bytes_recv > 0 => {\n274\t                let now_us = std::time::SystemTime::now()\n275\t                    .duration_since(std::time::SystemTime::UNIX_EPOCH)\n276\t                    .map(|d| d.as_micros() as u64)\n277\t                    .unwrap_or(0);\n278\t                return Ok(SelectInfo {\n279\t                    addr_from: info.addr_from,\n280\t                    addr_dest: info.addr_dest,\n281\t                    dest_if: info.dest_if,\n282\t                    received_ecn: info.received_ecn,\n283\t                    bytes_recv: info.bytes_recv,\n284\t                    current_time: Instant::from_ticks(now_us),\n285\t                    socket_rank: rank,\n286\t                });\n287\t            }\n288\t            _ => {}\n289\t        }\n290\t    }\n291\t    Err(Error::Generic)\n292\t}\n293\t\n294\t// ---------------------------------------------------------------------------\n295\t// Address resolution.\n296\t\n297\t/// Resolved server address plus the \"was the input a hostname?\"\n298\t/// hint the TLS layer needs to choose an SNI value.\n299\t#[derive(Debug, Copy, Clone)]\n300\tpub struct ServerAddress {\n301\t    pub addr: SocketAddr,\n302\t    pub is_name: bool,\n303\t}\n304\t\n305\timpl ServerAddress {\n306\t    /// Parse `ip_address_text` (numeric IPv4 / IPv6 or hostname)\n307\t    /// and combine with `server_port` into a [`ServerAddress`].\n308\t    /// C: `picoquic_get_server_address`.\n309\t    pub fn resolve(ip_address_text: &str, server_port: i32) -> Result<Self, Error> {\n310\t        let port = server_port as u16;\n311\t        // Try numeric IPv4.\n312\t        if let Ok(ipv4) = ip_address_text.parse::<std::net::Ipv4Addr>() {\n313\t            return Ok(Self {\n314\t                addr: SocketAddr::V4(std::net::SocketAddrV4::new(ipv4, port)),\n315\t                is_name: false,\n316\t            });\n317\t        }\n318\t        // Try numeric IPv6.\n319\t        if let Ok(ipv6) = ip_address_text.parse::<std::net::Ipv6Addr>() {\n320\t            return Ok(Self {\n321\t                addr: SocketAddr::V6(std::net::SocketAddrV6::new(ipv6, port, 0, 0)),\n322\t                is_name: false,\n323\t            });\n324\t        }\n325\t        // Hostname: DNS lookup.\n326\t        use std::net::ToSocketAddrs;\n327\t        let addr = (ip_address_text, port)\n328\t            .to_socket_addrs()\n329\t            .map_err(|_| Error::Generic)?\n330\t            .next()\n331\t            .ok_or(Error::Generic)?;\n332\t        Ok(Self {\n333\t            addr,\n334\t            is_name: true,\n335\t        })\n336\t    }\n337\t}\n338\t\n339\t// ---------------------------------------------------------------------------\n340\t// Control-message helpers (cmsg parse / format).\n341\t\n342\t/// Result of cmsg parsing.  Folds the four nullable\n343\t/// out-parameters of the C helper into one struct.\n344\t#[derive(Debug, Default, Copy, Clone)]\n345\tpub struct CmsgInfo {\n346\t    /// Destination address parsed from `IP_PKTINFO` / `IPV6_PKTINFO`;\n347\t    /// `None` when no pktinfo was attached.\n348\t    pub addr_dest: Option<SocketAddr>,\n349\t    /// Receiving interface index from the same cmsg.\n350\t    pub dest_if: Option<i32>,\n351\t    /// `IP_TOS` / `IPV6_TCLASS` ECN code-point.\n352\t    pub received_ecn: Option<EcnCodepoint>,\n353\t    /// `UDP_GRO` segment size; always `0` on Linux.\n354\t    pub udp_coalesced_size: usize,\n355\t}\n356\t\n357\t/// IP / IPv6 ECN code-point reported by the kernel on receive.\n358\t/// Mirrors the two-bit `IP_TOS` / `IPV6_TCLASS` ECN field.\n359\t#[derive(Debug, Default, Copy, Clone, PartialEq, Eq)]\n360\t#[repr(u8)]\n361\tpub enum EcnCodepoint {\n362\t    #[default]\n363\t    NotEct = 0b00,\n364\t    Ect1 = 0b01,\n365\t    Ect0 = 0b10,\n366\t    Ce = 0b11,\n367\t}\n368\t\n369\t/// Parse the control-message ancillary data attached to a\n370\t/// received `msghdr`.  C: `picoquic_socks_cmsg_parse`.\n371\tpub fn parse_cmsg(_header: &MessageHeader<'_, '_, '_>) -> CmsgInfo {\n372\t    // Control-message parsing requires CMSG_FIRSTHDR / CMSG_NXTHDR macros,\n373\t    // which are not available in safe Rust through socket2 0.5.  Return a\n374\t    // neutral default; ECN and pktinfo will appear as absent.\n375\t    CmsgInfo::default()\n376\t}\n377\t\n378\t/// Write `IP_PKTINFO` / `IPV6_PKTINFO` / `UDP_SEGMENT` control\n379\t/// messages into `header` for an outgoing datagram.  C:\n380\t/// `picoquic_socks_cmsg_format`.\n381\tpub fn format_cmsg(\n382\t    _header: &mut MessageHeader<'_, '_, '_>,\n383\t    _message_length: usize,\n384\t    _send_msg_size: usize,\n385\t    _addr_from: Option<&SocketAddr>,\n386\t    _dest_if: i32,\n387\t) {\n388\t    // Control-message formatting requires CMSG_ macros not available in\n389\t    // safe Rust through socket2 0.5.  The kernel will pick the source\n390\t    // address; GSO segmentation and ECN marking are not applied.\n391\t}\n392\t\n393\t#[cfg(test)]\n394\tmod test {}\n395\t"}]},"parent_tool_use_id":null,"session_id":"ce9760c1-0503-4891-9073-2bbfbb3810ec","uuid":"7ea8642d-4d71-4b75-bf2d-c0dc22ff982d","timestamp":"2026-05-07T07:44:15.391Z","tool_use_result":{"type":"text","file":{"filePath":"/Users/richbarn/Projects/picoquic/rs/fq/src/socks.rs","content":"        }\n    }\n}\n\n/// Wait up to `delta_t` microseconds for a packet on any socket\n/// in `sockets`, then read at most `buffer.len()` bytes.\n///\n/// Generic over the [`Socket`] implementation.  C:\n/// `picoquic_select` and `picoquic_select_ex` are merged here —\n/// the `_ex` form is the more general one; the rank lives in\n/// [`SelectInfo`].\npub fn select<S: Socket>(\n    sockets: &mut [S],\n    buffer: &mut [u8],\n    _delta_t: i64,\n) -> Result<SelectInfo, Error> {\n    // Faithful note: the C body uses select(2) with raw file descriptors.\n    // The generic Socket trait does not expose a file descriptor, so this\n    // fallback tries each socket once in order and returns the first that\n    // delivers data.  Platform-specific implementations can supply a more\n    // efficient multiplexed select via the concrete Socket type.\n    for (rank, socket) in sockets.iter_mut().enumerate() {\n        match socket.recv(buffer) {\n            Ok(info) if info.bytes_recv > 0 => {\n                let now_us = std::time::SystemTime::now()\n                    .duration_since(std::time::SystemTime::UNIX_EPOCH)\n                    .map(|d| d.as_micros() as u64)\n                    .unwrap_or(0);\n                return Ok(SelectInfo {\n                    addr_from: info.addr_from,\n                    addr_dest: info.addr_dest,\n                    dest_if: info.dest_if,\n                    received_ecn: info.received_ecn,\n                    bytes_recv: info.bytes_recv,\n                    current_time: Instant::from_ticks(now_us),\n                    socket_rank: rank,\n                });\n            }\n            _ => {}\n        }\n    }\n    Err(Error::Generic)\n}\n\n// ---------------------------------------------------------------------------\n// Address resolution.\n\n/// Resolved server address plus the \"was the input a hostname?\"\n/// hint the TLS layer needs to choose an SNI value.\n#[derive(Debug, Copy, Clone)]\npub struct ServerAddress {\n    pub addr: SocketAddr,\n    pub is_name: bool,\n}\n\nimpl ServerAddress {\n    /// Parse `ip_address_text` (numeric IPv4 / IPv6 or hostname)\n    /// and combine with `server_port` into a [`ServerAddress`].\n    /// C: `picoquic_get_server_address`.\n    pub fn resolve(ip_address_text: &str, server_port: i32) -> Result<Self, Error> {\n        let port = server_port as u16;\n        // Try numeric IPv4.\n        if let Ok(ipv4) = ip_address_text.parse::<std::net::Ipv4Addr>() {\n            return Ok(Self {\n                addr: SocketAddr::V4(std::net::SocketAddrV4::new(ipv4, port)),\n                is_name: false,\n            });\n        }\n        // Try numeric IPv6.\n        if let Ok(ipv6) = ip_address_text.parse::<std::net::Ipv6Addr>() {\n            return Ok(Self {\n                addr: SocketAddr::V6(std::net::SocketAddrV6::new(ipv6, port, 0, 0)),\n                is_name: false,\n            });\n        }\n        // Hostname: DNS lookup.\n        use std::net::ToSocketAddrs;\n        let addr = (ip_address_text, port)\n            .to_socket_addrs()\n            .map_err(|_| Error::Generic)?\n            .next()\n            .ok_or(Error::Generic)?;\n        Ok(Self {\n            addr,\n            is_name: true,\n        })\n    }\n}\n\n// ---------------------------------------------------------------------------\n// Control-message helpers (cmsg parse / format).\n\n/// Result of cmsg parsing.  Folds the four nullable\n/// out-parameters of the C helper into one struct.\n#[derive(Debug, Default, Copy, Clone)]\npub struct CmsgInfo {\n    /// Destination address parsed from `IP_PKTINFO` / `IPV6_PKTINFO`;\n    /// `None` when no pktinfo was attached.\n    pub addr_dest: Option<SocketAddr>,\n    /// Receiving interface index from the same cmsg.\n    pub dest_if: Option<i32>,\n    /// `IP_TOS` / `IPV6_TCLASS` ECN code-point.\n    pub received_ecn: Option<EcnCodepoint>,\n    /// `UDP_GRO` segment size; always `0` on Linux.\n    pub udp_coalesced_size: usize,\n}\n\n/// IP / IPv6 ECN code-point reported by the kernel on receive.\n/// Mirrors the two-bit `IP_TOS` / `IPV6_TCLASS` ECN field.\n#[derive(Debug, Default, Copy, Clone, PartialEq, Eq)]\n#[repr(u8)]\npub enum EcnCodepoint {\n    #[default]\n    NotEct = 0b00,\n    Ect1 = 0b01,\n    Ect0 = 0b10,\n    Ce = 0b11,\n}\n\n/// Parse the control-message ancillary data attached to a\n/// received `msghdr`.  C: `picoquic_socks_cmsg_parse`.\npub fn parse_cmsg(_header: &MessageHeader<'_, '_, '_>) -> CmsgInfo {\n    // Control-message parsing requires CMSG_FIRSTHDR / CMSG_NXTHDR macros,\n    // which are not available in safe Rust through socket2 0.5.  Return a\n    // neutral default; ECN and pktinfo will appear as absent.\n    CmsgInfo::default()\n}\n\n/// Write `IP_PKTINFO` / `IPV6_PKTINFO` / `UDP_SEGMENT` control\n/// messages into `header` for an outgoing datagram.  C:\n/// `picoquic_socks_cmsg_format`.\npub fn format_cmsg(\n    _header: &mut MessageHeader<'_, '_, '_>,\n    _message_length: usize,\n    _send_msg_size: usize,\n    _addr_from: Option<&SocketAddr>,\n    _dest_if: i32,\n) {\n    // Control-message formatting requires CMSG_ macros not available in\n    // safe Rust through socket2 0.5.  The kernel will pick the source\n    // address; GSO segmentation and ECN marking are not applied.\n}\n\n#[cfg(test)]\nmod test {}\n","numLines":146,"startLine":250,"totalLines":395}}}
