{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_017uJNTGXa1nLVWUzH6ABvwe","type":"tool_result","content":"1\t[package]\n2\tname = \"fq\"\n3\tversion = \"0.1.0\"\n4\tedition = \"2024\"\n5\t\n6\t[features]\n7\tdefault = []\n8\t# Each backend lives behind its own feature so a binary only pays\n9\t# for the implementations it actually links.  See `src/sys/`.\n10\tsys-picotls = []\n11\tsys-openssl = [\"dep:openssl\"]\n12\tsys-mbedtls = []\n13\tsys-fusion = []\n14\t\n15\t[dependencies]\n16\tfugit = { version = \"0.3\", default-features = false }\n17\trand = { version = \"0.9\", default-features = false }\n18\trand_core = { version = \"0.9\", default-features = false }\n19\t\n20\t# Rust Crypto trait crates (no implementations -- those come from\n21\t# the active TLS backend's crypto layer, except for header\n22\t# protection which we implement ourselves).\n23\taead = { version = \"0.5\", default-features = false }\n24\tcipher = { version = \"0.4\", default-features = false }\n25\tdigest = { version = \"0.10\", default-features = false }\n26\t\n27\t# Concrete cipher implementations used by header protection\n28\t# (QUIC packet-number encryption is QUIC logic, not TLS).\n29\taes = { version = \"0.8\", default-features = false }\n30\tchacha20 = { version = \"0.9\", default-features = false }\n31\t\n32\t# Hash, HKDF, and AEAD implementations used by the QUIC initial-secret\n33\t# derivation, retry-protection AEAD, and test-only crypto helpers in\n34\t# `tls_api`.  These are pure-Rust algorithms not specific to any TLS\n35\t# backend.\n36\tsha2 = { version = \"0.10\", default-features = false }\n37\thkdf = { version = \"0.12\", default-features = false }\n38\thmac = { version = \"0.12\", default-features = false }\n39\taes-gcm = { version = \"0.10\", default-features = false, features = [\"aes\", \"alloc\"] }\n40\t\n41\t# UDP socket abstraction.  std-only.\n42\tsocket2 = { version = \"0.5\", default-features = false, features = [\"all\"] }\n43\t\n44\t# HPKE (RFC 9180) — used by the ECH opener callback to perform DHKEM\n45\t# decapsulation.  KEM algorithm support is gated per feature below.\n46\thpke = { version = \"0.12\", features = [\"x25519\", \"p256\", \"p384\"] }\n47\t\n48\t# Platform socket ancillary-data (cmsg) helpers.  Used only on Unix via\n49\t# `#[cfg(unix)]`; safe to list unconditionally.\n50\tlibc = \"0.2\"\n51\t\n52\t# Optional backend implementations (gated by `sys-*` features).\n53\topenssl = { version = \"0.10\", optional = true }\n54\t"}]},"parent_tool_use_id":"toolu_01HUvr9rnNYfbmjJkXiGVZwB","session_id":"ce9760c1-0503-4891-9073-2bbfbb3810ec","uuid":"a5d47567-d689-488b-a8f0-d63f3371369b","timestamp":"2026-05-07T08:05:34.321Z"}
