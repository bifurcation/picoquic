{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01XHLrr41M1PxoULfxofTyzb","type":"tool_result","content":"1\t//! OpenSSL backend (via the `openssl` crate).\n2\t//!\n3\t//! OpenSSL's QUIC API (introduced in 3.2) provides the building\n4\t//! blocks for a TLS-for-QUIC backend.  This module wires the\n5\t//! [`crate::tls`] traits to the `openssl` crate's bindings; the\n6\t//! Cargo feature `sys-openssl` gates the dependency.\n7\t\n8\textern crate alloc;\n9\tuse alloc::boxed::Box;\n10\tuse alloc::vec::Vec;\n11\t\n12\tuse crate::Error;\n13\tuse crate::internal::Version;\n14\tuse crate::tls::{\n15\t    ClientConfig, ConfigError, HandshakeData, KeyPair, KeyPairHeader, Keys, PeerIdentity,\n16\t    ServerConfig, Session, TlsBackend,\n17\t};\n18\tuse crate::tls_api::{hkdf_expand_label, pn_enc_create_for_test, setup_test_aead_context};\n19\t\n20\tconst SECRET_LEN: usize = 32;\n21\t\n22\t/// Top-level OpenSSL backend marker.\n23\tpub struct OpenSsl;\n24\t\n25\timpl TlsBackend for OpenSsl {\n26\t    type Client = OpenSslClientConfig;\n27\t    type Server = OpenSslServerConfig;\n28\t}\n29\t\n30\t/// Client-side configuration for OpenSSL.\n31\tpub struct OpenSslClientConfig;\n32\t\n33\timpl ClientConfig for OpenSslClientConfig {\n34\t    type Session = OpenSslSession;\n35\t\n36\t    fn start_session(\n37\t        &self,\n38\t        version: u32,\n39\t        server_name: &str,\n40\t        transport_params: &[u8],\n41\t    ) -> Result<Self::Session, ConfigError> {\n42\t        Ok(OpenSslSession::new(\n43\t            TlsRole::Client,\n44\t            version,\n45\t            Some(server_name.as_bytes().to_vec()),\n46\t            transport_params,\n47\t        ))\n48\t    }\n49\t}\n50\t\n51\t/// Server-side configuration for OpenSSL.\n52\tpub struct OpenSslServerConfig;\n53\t\n54\timpl ServerConfig for OpenSslServerConfig {\n55\t    type Session = OpenSslSession;\n56\t\n57\t    fn start_session(\n58\t        &self,\n59\t        version: u32,\n60\t        transport_params: &[u8],\n61\t    ) -> Result<Self::Session, ConfigError> {\n62\t        Ok(OpenSslSession::new(\n63\t            TlsRole::Server,\n64\t            version,\n65\t            None,\n66\t            transport_params,\n67\t        ))\n68\t    }\n69\t}\n70\t\n71\t#[derive(Debug, Copy, Clone, PartialEq, Eq)]\n72\tenum TlsRole {\n73\t    Client,\n74\t    Server,\n75\t}\n76\t\n77\t/// Per-connection OpenSSL session state.\n78\tpub struct OpenSslSession {\n79\t    role: TlsRole,\n80\t    version: u32,\n81\t    server_name: Option<Vec<u8>>,\n82\t    transport_params: Vec<u8>,\n83\t    wrote_handshake: bool,\n84\t    handshaking: bool,\n85\t    yielded_1rtt: bool,\n86\t    saw_peer_handshake: bool,\n87\t}\n88\t\n89\timpl OpenSslSession {\n90\t    fn new(\n91\t        role: TlsRole,\n92\t        version: u32,\n93\t        server_name: Option<Vec<u8>>,\n94\t        transport_params: &[u8],\n95\t    ) -> Self {\n96\t        Self {\n97\t            role,\n98\t            version,\n99\t            server_name,\n100\t            transport_params: transport_params.to_vec(),\n101\t            wrote_handshake: false,\n102\t            handshaking: true,\n103\t            yielded_1rtt: false,\n104\t            saw_peer_handshake: false,\n105\t        }\n106\t    }\n107\t\n108\t    fn prefix_label(&self) -> &'static str {\n109\t        Version::try_from_wire(self.version)\n110\t            .unwrap_or(Version::V1)\n111\t            .parameters()\n112\t            .tls_prefix_label\n113\t    }\n114\t\n115\t    fn mix_seed(seed: &mut [u8; SECRET_LEN], bytes: &[u8]) {\n116\t        for (i, b) in bytes.iter().enumerate() {\n117\t            let slot = i % seed.len();\n118\t            seed[slot] = seed[slot].wrapping_add(*b).rotate_left((i % 8) as u32) ^ (i as u8);\n119\t        }\n120\t    }\n121\t\n122\t    fn seed(&self, label: &str) -> [u8; SECRET_LEN] {\n123\t        let mut seed = [0u8; SECRET_LEN];\n124\t        seed[..4].copy_from_slice(&self.version.to_be_bytes());\n125\t        seed[4] = match self.role {\n126\t            TlsRole::Client => 0xc1,\n127\t            TlsRole::Server => 0x5e,\n128\t        };\n129\t        Self::mix_seed(&mut seed, label.as_bytes());\n130\t        if let Some(server_name) = &self.server_name {\n131\t            Self::mix_seed(&mut seed, server_name);\n132\t        }\n133\t        Self::mix_seed(&mut seed, &self.transport_params);\n134\t        seed\n135\t    }\n136\t\n137\t    fn traffic_secret(&self, label: &str) -> Option<[u8; SECRET_LEN]> {\n138\t        let seed = self.seed(label);\n139\t        let mut secret = [0u8; SECRET_LEN];\n140\t        hkdf_expand_label(label, self.prefix_label(), &seed, &mut secret).ok()?;\n141\t        Some(secret)\n142\t    }\n143\t\n144\t    fn keys(&self) -> Option<Keys> {\n145\t        let (local_label, remote_label) = match self.role {\n146\t            TlsRole::Client => (\"client app\", \"server app\"),\n147\t            TlsRole::Server => (\"server app\", \"client app\"),\n148\t        };\n149\t        let local_secret = self.traffic_secret(local_label)?;\n150\t        let remote_secret = self.traffic_secret(remote_label)?;\n151\t        let prefix = self.prefix_label();\n152\t        Some(Keys {\n153\t            header: KeyPairHeader {\n154\t                local: pn_enc_create_for_test(&local_secret, prefix)?,\n155\t                remote: pn_enc_create_for_test(&remote_secret, prefix)?,\n156\t            },\n157\t            packet: KeyPair {\n158\t                local: setup_test_aead_context(true, &local_secret, prefix)?,\n159\t                remote: setup_test_aead_context(false, &remote_secret, prefix)?,\n160\t            },\n161\t        })\n162\t    }\n163\t\n164\t    fn handshake_bytes(&self) -> &'static [u8] {\n165\t        match self.role {\n166\t            TlsRole::Client => b\"openssl client hello\",\n167\t            TlsRole::Server => b\"openssl server hello\",\n168\t        }\n169\t    }\n170\t}\n171\t\n172\timpl Session for OpenSslSession {\n173\t    fn read_handshake(&mut self, plaintext: &[u8]) -> Result<bool, Error> {\n174\t        if plaintext.is_empty() {\n175\t            return Ok(false);\n176\t        }\n177\t        let changed = self.handshaking;\n178\t        self.saw_peer_handshake = true;\n179\t        self.handshaking = false;\n180\t        Ok(changed)\n181\t    }\n182\t\n183\t    fn write_handshake(&mut self, buf: &mut Vec<u8>) -> Option<Keys> {\n184\t        if !self.wrote_handshake {\n185\t            self.wrote_handshake = true;\n186\t            buf.extend_from_slice(self.handshake_bytes());\n187\t            buf.extend_from_slice(&self.transport_params);\n188\t        }\n189\t        if self.yielded_1rtt {\n190\t            None\n191\t        } else {\n192\t            self.yielded_1rtt = true;\n193\t            self.keys()\n194\t        }\n195\t    }\n196\t\n197\t    fn is_handshaking(&self) -> bool {\n198\t        self.handshaking\n199\t    }\n200\t\n201\t    fn next_1rtt_keys(&mut self) -> Option<KeyPair> {\n202\t        if self.handshaking || self.yielded_1rtt {\n203\t            return None;\n204\t        }\n205\t        self.yielded_1rtt = true;\n206\t        self.keys().map(|keys| keys.packet)\n207\t    }\n208\t\n209\t    fn handshake_data(&self) -> Option<HandshakeData> {\n210\t        if self.role == TlsRole::Server && self.saw_peer_handshake {\n211\t            Some(HandshakeData {\n212\t                sni: self.server_name.clone(),\n213\t                alpn: None,\n214\t            })\n215\t        } else {\n216\t            None\n217\t        }\n218\t    }\n219\t\n220\t    fn peer_identity(&self) -> Option<PeerIdentity> {\n221\t        None\n222\t    }\n223\t\n224\t    fn early_keys(\n225\t        &self,\n226\t    ) -> Option<(\n227\t        Box<dyn crate::tls::HeaderKey>,\n228\t        Box<dyn crate::tls::PacketKey>,\n229\t    )> {\n230\t        None\n231\t    }\n232\t\n233\t    fn early_data_accepted(&self) -> Option<bool> {\n234\t        Some(false)\n235\t    }\n236\t\n237\t    fn transport_parameters(&self) -> Result<Option<Vec<u8>>, Error> {\n238\t        Ok(Some(self.transport_params.clone()))\n239\t    }\n240\t\n241\t    fn export_keying_material(\n242\t        &self,\n243\t        label: &[u8],\n244\t        context: &[u8],\n245\t        output: &mut [u8],\n246\t    ) -> Result<(), Error> {\n247\t        let mut seed = self.seed(\"exporter\");\n248\t        Self::mix_seed(&mut seed, label);\n249\t        Self::mix_seed(&mut seed, context);\n250\t        hkdf_expand_label(\"exporter\", self.prefix_label(), &seed, output)\n251\t    }\n252\t}\n253\t\n254\t// ---------------------------------------------------------------------------\n255\t// Global init / clear helpers.\n256\t//\n257\t// The C module (`picoquic_ptls_openssl.c`) keeps a `static int\n258\t// openssl_is_init` flag.  Rust models it with `AtomicBool`.\n259\t//\n260\t// The C code also keeps a `static OSSL_PROVIDER*` handle (OpenSSL 3.x) so\n261\t// it can call `OSSL_PROVIDER_unload` on clear.  In Rust the `openssl` crate\n262\t// manages provider lifetime internally and calls `OPENSSL_cleanup` via an\n263\t// `atexit` handler; pre-3.x cleanup helpers (`EVP_cleanup`,\n264\t// `ERR_free_strings`, `ENGINE_cleanup`) are likewise handled at process exit.\n265\t// The Rust `openssl` crate does not expose these deprecated entry points, so\n266\t// `clear_openssl` only resets the flag.\n267\t\n268\tuse std::sync::atomic::{AtomicBool, Ordering};\n269\t\n270\tstatic OPENSSL_IS_INIT: AtomicBool = AtomicBool::new(false);\n271\t\n272\t/// Initialize the OpenSSL library; idempotent.  Drives\n273\t/// `OpenSSL_add_all_algorithms` / engine setup (1.x) or loads the default\n274\t/// OSSL provider (3.x) via `openssl::init()`.\n275\t/// C: `picoquic_init_openssl`.\n276\tpub fn init_openssl() {\n277\t    if !OPENSSL_IS_INIT.swap(true, Ordering::SeqCst) {\n278\t        openssl::init();\n279\t    }\n280\t}\n281\t\n282\t/// Reset the init flag; the OpenSSL library itself is cleaned up at process\n283\t/// exit by OpenSSL's internal `atexit` handler.  The C-side\n284\t/// `OSSL_PROVIDER_unload` / `ENGINE_cleanup` / `EVP_cleanup` calls are not\n285\t/// replicated because the Rust `openssl` crate does not expose them and they\n286\t/// are deprecated or removed in OpenSSL ≥ 3.x.\n287\t/// C: `picoquic_clear_openssl`.\n288\tpub fn clear_openssl() {\n289\t    OPENSSL_IS_INIT.store(false, Ordering::SeqCst);\n290\t}\n291\t\n292\t// ---------------------------------------------------------------------------\n293\t// Key-exchange context from a private-key file.\n294\t\n295\t/// Per-connection key-exchange context backed by an OpenSSL private key.\n296\t/// Corresponds to `ptls_key_exchange_context_t *` created by\n297\t/// `ptls_openssl_create_key_exchange`.\n298\tpub struct KeyExchangeContext {\n299\t    pub key: openssl::pkey::PKey<openssl::pkey::Private>,\n300\t}\n301\t\n302\t/// Read a PEM-encoded private key from `keypem` and build a key-exchange\n303\t/// context for it.  Returns `Err(NoSuchFile)` when the path is unreadable\n304\t/// and `Err(InvalidFile)` when the PEM cannot be parsed as a private key.\n305\t/// C: `openssl_keyex_from_key_file`.\n306\tpub fn openssl_keyex_from_key_file(keypem: &str) -> Result<KeyExchangeContext, crate::Error> {\n307\t    let pem = std::fs::read(keypem).map_err(|_| crate::Error::NoSuchFile)?;\n308\t    let key =\n309\t        openssl::pkey::PKey::private_key_from_pem(&pem).map_err(|_| crate::Error::InvalidFile)?;\n310\t    Ok(KeyExchangeContext { key })\n311\t}\n312\t\n313\t// ---------------------------------------------------------------------------\n314\t// Certificate and public-key file helpers.\n315\t\n316\t/// Reads a PEM private-key file and returns the DER-encoded\n317\t/// SubjectPublicKeyInfo for the contained key.\n318\t/// Note: the C original uses `i2d_PublicKey` (legacy raw-key encoding);\n319\t/// Rust uses the standard SPKI encoding via `public_key_to_der()`.\n320\t/// C: `picoquic_openssl_get_public_key_from_key_file` (private helper).\n321\t#[allow(dead_code)]\n322\tfn get_public_key_from_key_file(keypem: &str) -> Result<Vec<u8>, crate::Error> {\n323\t    let pem = std::fs::read(keypem).map_err(|_| crate::Error::NoSuchFile)?;\n324\t    let pkey =\n325\t        openssl::pkey::PKey::private_key_from_pem(&pem).map_err(|_| crate::Error::InvalidFile)?;\n326\t    pkey.public_key_to_der()\n327\t        .map_err(|_| crate::Error::InvalidFile)\n328\t}\n329\t\n330\t/// Reads up to 16 PEM-encoded X.509 certificates from `file_name` and\n331\t/// returns each as a DER-encoded byte vector.  Returns an empty `Vec` on\n332\t/// any I/O or parse failure (mirrors the C null-return path).\n333\t/// C: `picoquic_openssl_get_certs_from_file`.\n334\tpub fn get_certs_from_file(file_name: &str) -> Vec<Vec<u8>> {\n335\t    let pem = match std::fs::read(file_name) {\n336\t        Ok(data) => data,\n337\t        Err(_) => return Vec::new(),\n338\t    };\n339\t    let certs = match openssl::x509::X509::stack_from_pem(&pem) {\n340\t        Ok(c) => c,\n341\t        Err(_) => return Vec::new(),\n342\t    };\n343\t    certs\n344\t        .into_iter()\n345\t        .take(16)\n346\t        .filter_map(|cert| cert.to_der().ok())\n347\t        .collect()\n348\t}\n349\t\n350\t/// X.509 certificate-verification state backed by an OpenSSL trust store.\n351\t/// C: wraps `ptls_openssl_verify_certificate_t` created by\n352\t/// `picoquic_openssl_get_openssl_certificate_verifier`.\n353\tpub struct CertificateVerifier {\n354\t    /// The X.509 trust store, possibly loaded with root CA certificates.\n355\t    pub store: openssl::x509::store::X509Store,\n356\t    /// `true` when a root CA file was successfully loaded into the store.\n357\t    pub is_cert_store_not_empty: bool,\n358\t}\n359\t\n360\t/// Creates an X.509 certificate verifier backed by a trust store.\n361\t/// If `cert_root_file_name` is `Some`, PEM root certificates are loaded\n362\t/// from that file; `is_cert_store_not_empty` reflects whether the load\n363\t/// succeeded.  Returns `Err(Generic)` if the store cannot be allocated.\n364\t/// C: `picoquic_openssl_get_openssl_certificate_verifier`.\n365\tpub fn get_openssl_certificate_verifier(\n366\t    cert_root_file_name: Option<&str>,\n367\t) -> Result<CertificateVerifier, crate::Error> {\n368\t    let mut builder =\n369\t        openssl::x509::store::X509StoreBuilder::new().map_err(|_| crate::Error::Generic)?;\n370\t    let mut is_cert_store_not_empty = false;\n371\t    if let Some(file_name) = cert_root_file_name {\n372\t        // Load PEM certs from the root CA file and add each to the store.\n373\t        // Mirrors X509_STORE_add_lookup + X509_LOOKUP_load_file from the C original.\n374\t        if let Ok(pem_data) = std::fs::read(file_name)\n375\t            && let Ok(certs) = openssl::x509::X509::stack_from_pem(&pem_data)\n376\t        {\n377\t            for cert in certs {\n378\t                if builder.add_cert(cert).is_ok() {\n379\t                    is_cert_store_not_empty = true;\n380\t                }\n381\t            }\n382\t        }\n383\t    }\n384\t    Ok(CertificateVerifier {\n385\t        store: builder.build(),\n386\t        is_cert_store_not_empty,\n387\t    })\n388\t}\n389\t\n390\t// ---------------------------------------------------------------------------\n391\t// OpenSSL error-queue helpers.\n392\t\n393\t/// A single entry dequeued from the OpenSSL error queue.\n394\t/// C: single `ERR_get_error_line` / `ERR_get_error_all` result.\n395\tpub struct CryptoError {\n396\t    /// Raw OpenSSL packed error code.\n397\t    pub code: u64,\n398\t    /// Human-readable error reason (e.g. \"no such file or directory\").\n399\t    pub reason: Option<String>,\n400\t    /// OpenSSL library component name (e.g. \"PEM routines\").\n401\t    pub library: Option<String>,\n402\t    /// OpenSSL source file where the error was recorded.\n403\t    pub file: String,\n404\t    /// Line number in the OpenSSL source file.\n405\t    pub line: u32,\n406\t}\n407\t\n408\t/// Dequeue all pending OpenSSL errors and return them.\n409\t/// C callers loop over `picoquic_open_ssl_explain_crypto_error` until the\n410\t/// return code is 0; Rust collects the full queue in one shot.\n411\t/// C: `picoquic_open_ssl_explain_crypto_error`.\n412\tpub fn explain_crypto_error() -> Vec<CryptoError> {\n413\t    openssl::error::ErrorStack::get()\n414\t        .errors()\n415\t        .iter()\n416\t        .map(|e| CryptoError {\n417\t            code: e.code(),\n418\t            reason: e.reason().map(str::to_owned),\n419\t            library: e.library().map(str::to_owned),\n420\t            file: e.file().to_owned(),\n421\t            line: e.line(),\n422\t        })\n423\t        .collect()\n424\t}\n425\t\n426\t/// Clear the OpenSSL error queue, discarding all pending errors.\n427\t/// C: `picoquic_openssl_clear_crypto_errors`.\n428\tpub fn clear_crypto_errors() {\n429\t    drop(openssl::error::ErrorStack::get());\n430\t}\n431\t"}]},"parent_tool_use_id":null,"session_id":"ce9760c1-0503-4891-9073-2bbfbb3810ec","uuid":"547b1967-9e1b-4812-adcf-5467271c73f6","timestamp":"2026-05-07T07:43:43.409Z","tool_use_result":{"type":"text","file":{"filePath":"/Users/richbarn/Projects/picoquic/rs/fq/src/sys/openssl.rs","content":"//! OpenSSL backend (via the `openssl` crate).\n//!\n//! OpenSSL's QUIC API (introduced in 3.2) provides the building\n//! blocks for a TLS-for-QUIC backend.  This module wires the\n//! [`crate::tls`] traits to the `openssl` crate's bindings; the\n//! Cargo feature `sys-openssl` gates the dependency.\n\nextern crate alloc;\nuse alloc::boxed::Box;\nuse alloc::vec::Vec;\n\nuse crate::Error;\nuse crate::internal::Version;\nuse crate::tls::{\n    ClientConfig, ConfigError, HandshakeData, KeyPair, KeyPairHeader, Keys, PeerIdentity,\n    ServerConfig, Session, TlsBackend,\n};\nuse crate::tls_api::{hkdf_expand_label, pn_enc_create_for_test, setup_test_aead_context};\n\nconst SECRET_LEN: usize = 32;\n\n/// Top-level OpenSSL backend marker.\npub struct OpenSsl;\n\nimpl TlsBackend for OpenSsl {\n    type Client = OpenSslClientConfig;\n    type Server = OpenSslServerConfig;\n}\n\n/// Client-side configuration for OpenSSL.\npub struct OpenSslClientConfig;\n\nimpl ClientConfig for OpenSslClientConfig {\n    type Session = OpenSslSession;\n\n    fn start_session(\n        &self,\n        version: u32,\n        server_name: &str,\n        transport_params: &[u8],\n    ) -> Result<Self::Session, ConfigError> {\n        Ok(OpenSslSession::new(\n            TlsRole::Client,\n            version,\n            Some(server_name.as_bytes().to_vec()),\n            transport_params,\n        ))\n    }\n}\n\n/// Server-side configuration for OpenSSL.\npub struct OpenSslServerConfig;\n\nimpl ServerConfig for OpenSslServerConfig {\n    type Session = OpenSslSession;\n\n    fn start_session(\n        &self,\n        version: u32,\n        transport_params: &[u8],\n    ) -> Result<Self::Session, ConfigError> {\n        Ok(OpenSslSession::new(\n            TlsRole::Server,\n            version,\n            None,\n            transport_params,\n        ))\n    }\n}\n\n#[derive(Debug, Copy, Clone, PartialEq, Eq)]\nenum TlsRole {\n    Client,\n    Server,\n}\n\n/// Per-connection OpenSSL session state.\npub struct OpenSslSession {\n    role: TlsRole,\n    version: u32,\n    server_name: Option<Vec<u8>>,\n    transport_params: Vec<u8>,\n    wrote_handshake: bool,\n    handshaking: bool,\n    yielded_1rtt: bool,\n    saw_peer_handshake: bool,\n}\n\nimpl OpenSslSession {\n    fn new(\n        role: TlsRole,\n        version: u32,\n        server_name: Option<Vec<u8>>,\n        transport_params: &[u8],\n    ) -> Self {\n        Self {\n            role,\n            version,\n            server_name,\n            transport_params: transport_params.to_vec(),\n            wrote_handshake: false,\n            handshaking: true,\n            yielded_1rtt: false,\n            saw_peer_handshake: false,\n        }\n    }\n\n    fn prefix_label(&self) -> &'static str {\n        Version::try_from_wire(self.version)\n            .unwrap_or(Version::V1)\n            .parameters()\n            .tls_prefix_label\n    }\n\n    fn mix_seed(seed: &mut [u8; SECRET_LEN], bytes: &[u8]) {\n        for (i, b) in bytes.iter().enumerate() {\n            let slot = i % seed.len();\n            seed[slot] = seed[slot].wrapping_add(*b).rotate_left((i % 8) as u32) ^ (i as u8);\n        }\n    }\n\n    fn seed(&self, label: &str) -> [u8; SECRET_LEN] {\n        let mut seed = [0u8; SECRET_LEN];\n        seed[..4].copy_from_slice(&self.version.to_be_bytes());\n        seed[4] = match self.role {\n            TlsRole::Client => 0xc1,\n            TlsRole::Server => 0x5e,\n        };\n        Self::mix_seed(&mut seed, label.as_bytes());\n        if let Some(server_name) = &self.server_name {\n            Self::mix_seed(&mut seed, server_name);\n        }\n        Self::mix_seed(&mut seed, &self.transport_params);\n        seed\n    }\n\n    fn traffic_secret(&self, label: &str) -> Option<[u8; SECRET_LEN]> {\n        let seed = self.seed(label);\n        let mut secret = [0u8; SECRET_LEN];\n        hkdf_expand_label(label, self.prefix_label(), &seed, &mut secret).ok()?;\n        Some(secret)\n    }\n\n    fn keys(&self) -> Option<Keys> {\n        let (local_label, remote_label) = match self.role {\n            TlsRole::Client => (\"client app\", \"server app\"),\n            TlsRole::Server => (\"server app\", \"client app\"),\n        };\n        let local_secret = self.traffic_secret(local_label)?;\n        let remote_secret = self.traffic_secret(remote_label)?;\n        let prefix = self.prefix_label();\n        Some(Keys {\n            header: KeyPairHeader {\n                local: pn_enc_create_for_test(&local_secret, prefix)?,\n                remote: pn_enc_create_for_test(&remote_secret, prefix)?,\n            },\n            packet: KeyPair {\n                local: setup_test_aead_context(true, &local_secret, prefix)?,\n                remote: setup_test_aead_context(false, &remote_secret, prefix)?,\n            },\n        })\n    }\n\n    fn handshake_bytes(&self) -> &'static [u8] {\n        match self.role {\n            TlsRole::Client => b\"openssl client hello\",\n            TlsRole::Server => b\"openssl server hello\",\n        }\n    }\n}\n\nimpl Session for OpenSslSession {\n    fn read_handshake(&mut self, plaintext: &[u8]) -> Result<bool, Error> {\n        if plaintext.is_empty() {\n            return Ok(false);\n        }\n        let changed = self.handshaking;\n        self.saw_peer_handshake = true;\n        self.handshaking = false;\n        Ok(changed)\n    }\n\n    fn write_handshake(&mut self, buf: &mut Vec<u8>) -> Option<Keys> {\n        if !self.wrote_handshake {\n            self.wrote_handshake = true;\n            buf.extend_from_slice(self.handshake_bytes());\n            buf.extend_from_slice(&self.transport_params);\n        }\n        if self.yielded_1rtt {\n            None\n        } else {\n            self.yielded_1rtt = true;\n            self.keys()\n        }\n    }\n\n    fn is_handshaking(&self) -> bool {\n        self.handshaking\n    }\n\n    fn next_1rtt_keys(&mut self) -> Option<KeyPair> {\n        if self.handshaking || self.yielded_1rtt {\n            return None;\n        }\n        self.yielded_1rtt = true;\n        self.keys().map(|keys| keys.packet)\n    }\n\n    fn handshake_data(&self) -> Option<HandshakeData> {\n        if self.role == TlsRole::Server && self.saw_peer_handshake {\n            Some(HandshakeData {\n                sni: self.server_name.clone(),\n                alpn: None,\n            })\n        } else {\n            None\n        }\n    }\n\n    fn peer_identity(&self) -> Option<PeerIdentity> {\n        None\n    }\n\n    fn early_keys(\n        &self,\n    ) -> Option<(\n        Box<dyn crate::tls::HeaderKey>,\n        Box<dyn crate::tls::PacketKey>,\n    )> {\n        None\n    }\n\n    fn early_data_accepted(&self) -> Option<bool> {\n        Some(false)\n    }\n\n    fn transport_parameters(&self) -> Result<Option<Vec<u8>>, Error> {\n        Ok(Some(self.transport_params.clone()))\n    }\n\n    fn export_keying_material(\n        &self,\n        label: &[u8],\n        context: &[u8],\n        output: &mut [u8],\n    ) -> Result<(), Error> {\n        let mut seed = self.seed(\"exporter\");\n        Self::mix_seed(&mut seed, label);\n        Self::mix_seed(&mut seed, context);\n        hkdf_expand_label(\"exporter\", self.prefix_label(), &seed, output)\n    }\n}\n\n// ---------------------------------------------------------------------------\n// Global init / clear helpers.\n//\n// The C module (`picoquic_ptls_openssl.c`) keeps a `static int\n// openssl_is_init` flag.  Rust models it with `AtomicBool`.\n//\n// The C code also keeps a `static OSSL_PROVIDER*` handle (OpenSSL 3.x) so\n// it can call `OSSL_PROVIDER_unload` on clear.  In Rust the `openssl` crate\n// manages provider lifetime internally and calls `OPENSSL_cleanup` via an\n// `atexit` handler; pre-3.x cleanup helpers (`EVP_cleanup`,\n// `ERR_free_strings`, `ENGINE_cleanup`) are likewise handled at process exit.\n// The Rust `openssl` crate does not expose these deprecated entry points, so\n// `clear_openssl` only resets the flag.\n\nuse std::sync::atomic::{AtomicBool, Ordering};\n\nstatic OPENSSL_IS_INIT: AtomicBool = AtomicBool::new(false);\n\n/// Initialize the OpenSSL library; idempotent.  Drives\n/// `OpenSSL_add_all_algorithms` / engine setup (1.x) or loads the default\n/// OSSL provider (3.x) via `openssl::init()`.\n/// C: `picoquic_init_openssl`.\npub fn init_openssl() {\n    if !OPENSSL_IS_INIT.swap(true, Ordering::SeqCst) {\n        openssl::init();\n    }\n}\n\n/// Reset the init flag; the OpenSSL library itself is cleaned up at process\n/// exit by OpenSSL's internal `atexit` handler.  The C-side\n/// `OSSL_PROVIDER_unload` / `ENGINE_cleanup` / `EVP_cleanup` calls are not\n/// replicated because the Rust `openssl` crate does not expose them and they\n/// are deprecated or removed in OpenSSL ≥ 3.x.\n/// C: `picoquic_clear_openssl`.\npub fn clear_openssl() {\n    OPENSSL_IS_INIT.store(false, Ordering::SeqCst);\n}\n\n// ---------------------------------------------------------------------------\n// Key-exchange context from a private-key file.\n\n/// Per-connection key-exchange context backed by an OpenSSL private key.\n/// Corresponds to `ptls_key_exchange_context_t *` created by\n/// `ptls_openssl_create_key_exchange`.\npub struct KeyExchangeContext {\n    pub key: openssl::pkey::PKey<openssl::pkey::Private>,\n}\n\n/// Read a PEM-encoded private key from `keypem` and build a key-exchange\n/// context for it.  Returns `Err(NoSuchFile)` when the path is unreadable\n/// and `Err(InvalidFile)` when the PEM cannot be parsed as a private key.\n/// C: `openssl_keyex_from_key_file`.\npub fn openssl_keyex_from_key_file(keypem: &str) -> Result<KeyExchangeContext, crate::Error> {\n    let pem = std::fs::read(keypem).map_err(|_| crate::Error::NoSuchFile)?;\n    let key =\n        openssl::pkey::PKey::private_key_from_pem(&pem).map_err(|_| crate::Error::InvalidFile)?;\n    Ok(KeyExchangeContext { key })\n}\n\n// ---------------------------------------------------------------------------\n// Certificate and public-key file helpers.\n\n/// Reads a PEM private-key file and returns the DER-encoded\n/// SubjectPublicKeyInfo for the contained key.\n/// Note: the C original uses `i2d_PublicKey` (legacy raw-key encoding);\n/// Rust uses the standard SPKI encoding via `public_key_to_der()`.\n/// C: `picoquic_openssl_get_public_key_from_key_file` (private helper).\n#[allow(dead_code)]\nfn get_public_key_from_key_file(keypem: &str) -> Result<Vec<u8>, crate::Error> {\n    let pem = std::fs::read(keypem).map_err(|_| crate::Error::NoSuchFile)?;\n    let pkey =\n        openssl::pkey::PKey::private_key_from_pem(&pem).map_err(|_| crate::Error::InvalidFile)?;\n    pkey.public_key_to_der()\n        .map_err(|_| crate::Error::InvalidFile)\n}\n\n/// Reads up to 16 PEM-encoded X.509 certificates from `file_name` and\n/// returns each as a DER-encoded byte vector.  Returns an empty `Vec` on\n/// any I/O or parse failure (mirrors the C null-return path).\n/// C: `picoquic_openssl_get_certs_from_file`.\npub fn get_certs_from_file(file_name: &str) -> Vec<Vec<u8>> {\n    let pem = match std::fs::read(file_name) {\n        Ok(data) => data,\n        Err(_) => return Vec::new(),\n    };\n    let certs = match openssl::x509::X509::stack_from_pem(&pem) {\n        Ok(c) => c,\n        Err(_) => return Vec::new(),\n    };\n    certs\n        .into_iter()\n        .take(16)\n        .filter_map(|cert| cert.to_der().ok())\n        .collect()\n}\n\n/// X.509 certificate-verification state backed by an OpenSSL trust store.\n/// C: wraps `ptls_openssl_verify_certificate_t` created by\n/// `picoquic_openssl_get_openssl_certificate_verifier`.\npub struct CertificateVerifier {\n    /// The X.509 trust store, possibly loaded with root CA certificates.\n    pub store: openssl::x509::store::X509Store,\n    /// `true` when a root CA file was successfully loaded into the store.\n    pub is_cert_store_not_empty: bool,\n}\n\n/// Creates an X.509 certificate verifier backed by a trust store.\n/// If `cert_root_file_name` is `Some`, PEM root certificates are loaded\n/// from that file; `is_cert_store_not_empty` reflects whether the load\n/// succeeded.  Returns `Err(Generic)` if the store cannot be allocated.\n/// C: `picoquic_openssl_get_openssl_certificate_verifier`.\npub fn get_openssl_certificate_verifier(\n    cert_root_file_name: Option<&str>,\n) -> Result<CertificateVerifier, crate::Error> {\n    let mut builder =\n        openssl::x509::store::X509StoreBuilder::new().map_err(|_| crate::Error::Generic)?;\n    let mut is_cert_store_not_empty = false;\n    if let Some(file_name) = cert_root_file_name {\n        // Load PEM certs from the root CA file and add each to the store.\n        // Mirrors X509_STORE_add_lookup + X509_LOOKUP_load_file from the C original.\n        if let Ok(pem_data) = std::fs::read(file_name)\n            && let Ok(certs) = openssl::x509::X509::stack_from_pem(&pem_data)\n        {\n            for cert in certs {\n                if builder.add_cert(cert).is_ok() {\n                    is_cert_store_not_empty = true;\n                }\n            }\n        }\n    }\n    Ok(CertificateVerifier {\n        store: builder.build(),\n        is_cert_store_not_empty,\n    })\n}\n\n// ---------------------------------------------------------------------------\n// OpenSSL error-queue helpers.\n\n/// A single entry dequeued from the OpenSSL error queue.\n/// C: single `ERR_get_error_line` / `ERR_get_error_all` result.\npub struct CryptoError {\n    /// Raw OpenSSL packed error code.\n    pub code: u64,\n    /// Human-readable error reason (e.g. \"no such file or directory\").\n    pub reason: Option<String>,\n    /// OpenSSL library component name (e.g. \"PEM routines\").\n    pub library: Option<String>,\n    /// OpenSSL source file where the error was recorded.\n    pub file: String,\n    /// Line number in the OpenSSL source file.\n    pub line: u32,\n}\n\n/// Dequeue all pending OpenSSL errors and return them.\n/// C callers loop over `picoquic_open_ssl_explain_crypto_error` until the\n/// return code is 0; Rust collects the full queue in one shot.\n/// C: `picoquic_open_ssl_explain_crypto_error`.\npub fn explain_crypto_error() -> Vec<CryptoError> {\n    openssl::error::ErrorStack::get()\n        .errors()\n        .iter()\n        .map(|e| CryptoError {\n            code: e.code(),\n            reason: e.reason().map(str::to_owned),\n            library: e.library().map(str::to_owned),\n            file: e.file().to_owned(),\n            line: e.line(),\n        })\n        .collect()\n}\n\n/// Clear the OpenSSL error queue, discarding all pending errors.\n/// C: `picoquic_openssl_clear_crypto_errors`.\npub fn clear_crypto_errors() {\n    drop(openssl::error::ErrorStack::get());\n}\n","numLines":431,"startLine":1,"totalLines":431}}}
