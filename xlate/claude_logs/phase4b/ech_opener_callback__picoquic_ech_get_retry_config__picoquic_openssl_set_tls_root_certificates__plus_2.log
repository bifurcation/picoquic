from_slice(config_payload);\n\n        // HPKE base-mode receiver setup (equivalent to ptls_hpke_setup_base_r).\n        let key_material =\n            hpke_setup_receiver(self.kem_id, cipher, &self.private_key, enc, &info)?;\n        Some(EchOpenResult { cipher, key_material })\n    }\n}"},"caller":{"type":"direct"}}],"stop_reason":null,"stop_sequence":null,"stop_details":null,"usage":{"input_tokens":1,"cache_creation_input_tokens":530,"cache_read_input_tokens":125176,"cache_creation":{"ephemeral_5m_input_tokens":0,"ephemeral_1h_input_tokens":530},"output_tokens":72,"service_tier":"standard","inference_geo":"not_available"},"context_management":null},"parent_tool_use_id":null,"session_id":"ce9760c1-0503-4891-9073-2bbfbb3810ec","uuid":"4f8dd1e9-acf8-4ef1-bd66-28484e24430a"}
