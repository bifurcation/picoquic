\n153\t    cubic_state->previous_start_of_epoch = cubic_state->start_of_epoch;\n154\t    cubic_state->previous_alg_state = cubic_state->alg_state;\n155\t    cubic_state->previous_ssthresh = cubic_state->ssthresh;\n156\t    cubic_state->previous_cwin = path_x->cwin;\n157\t    /* Update similar to new reno, but different beta */\n158\t    cubic_state->W_max = (double)path_x->cwin / (double)path_x->send_mtu;\n159\t    /* Apply fast convergence */\n160\t    if (cubic_state->W_max < cubic_state->W_last_max) {\n161\t        cubic_state->W_last_max = cubic_state->W_max;\n162\t        cubic_state->W_max = cubic_state->W_max * PICOQUIC_CUBIC_BETA_ECN;\n163\t    }\n164\t    else {\n165\t        cubic_state->W_last_max = cubic_state->W_max;\n166\t    }\n167\t    /* Compute the new ssthresh */\n168\t    cubic_state->ssthresh = (uint64_t)(cubic_state->W_max * PICOQUIC_CUBIC_BETA_ECN * (double)path_x->send_mtu);\n169\t    if (cubic_state->ssthresh < PICOQUIC_CWIN_MINIMUM) {\n170\t        /* If things are that bad, fall back to slow start */\n171\t\n172\t        cubic_state->alg_state = picoquic_cubic_alg_slow_start;\n173\t        cubic_state->ssthresh = UINT64_MAX;\n174\t        path_x->is_ssthresh_initialized = 0;\n175\t        cubic_state->previous_start_of_epoch = cubic_state->start_of_epoch;\n176\t        cubic_state->start_of_epoch = current_time;\n177\t        cubic_state->W_reno = PICOQUIC_CWIN_MINIMUM;\n178\t        path_x->cwin = PICOQUIC_CWIN_MINIMUM;\n179\t    }"}]},"parent_tool_use_id":null,"session_id":"e717f4e2-96a7-4752-b6de-ede097ef17e8","uuid":"9a8cfc12-78bf-4a5e-98ee-5f825778ddde","timestamp":"2026-05-07T05:38:29.155Z","tool_use_result":{"type":"text","file":{"filePath":"/Users/richbarn/Projects/picoquic/picoquic/cubic.c","content":"     * cubic_state->W_max < 2/5\n     */\n    while (v > x * 8) {\n        v /= 8;\n        y /= 2;\n    }\n\n    while (v < x) {\n        v *= 8;\n        y *= 2;\n    }\n\n    for (int i = 0; i < 3; i++) {\n        y2 = y * y;\n   