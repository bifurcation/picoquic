{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01GHYRarp1cPU1kSQHdz3Gu3","type":"tool_result","content":"180\t    else {\n181\t        if (notification == picoquic_congestion_notification_timeout) {\n182\t            path_x->cwin = PICOQUIC_CWIN_MINIMUM;\n183\t            cubic_state->previous_start_of_epoch = cubic_state->start_of_epoch;\n184\t            cubic_state->start_of_epoch = current_time;\n185\t            cubic_state->alg_state = picoquic_cubic_alg_slow_start;\n186\t        }\n187\t        else {\n188\t            /* Enter congestion avoidance immediately */\n189\t            cubic_enter_avoidance(cubic_state, current_time);\n190\t            /* Compute the initial window for both Reno and Cubic */\n191\t            double W_cubic = cubic_W_cubic(cubic_state, current_time);\n192\t            uint64_t win_cubic = (uint64_t)(W_cubic * (double)path_x->send_mtu);\n193\t            cubic_state->W_reno = ((double)path_x->cwin) / 2.0;\n194\t\n195\t            /* The formulas that compute \"W_cubic\" at the beginning of congestion avoidance\n196\t            * guarantee that \"w_cubic\" is larger than \"w_reno\" even if \"fast convergence\"\n197\t            * is applied as long as \"beta_cubic\" is greater than\n198\t            * (-1 + sqrt(1+4))/2, about 0.618033988749895.\n199\t            * Since beta_cubic is set to 3/4, we do not need to compare \"w_cubic\" and\n200\t            * \"w_reno\" to pick the largest. */\n201\t            path_x->cwin = win_cubic;\n202\t        }\n203\t    }\n204\t}\n205\t\n206\t/* On spurious repeat notification, restore the previous congestion control.\n207\t * If the previous state was slow start, we get back to slow start with\n208\t * exactly the initial parameters. Otherwise,\n209\t * we assume that K is still valid -- we only update it after exiting recovery.\n210\t * Set cwin to the value of W_max before the recovery event\n211\t * Set W_max to W_max_last, i.e. the value before the recovery event\n212\t * Set the epoch back to where it was, by computing the inverse of the\n213\t * W_cubic formula */\n214\tstatic void cubic_correct_spurious(picoquic_path_t* path_x,\n215\t    picoquic_cubic_state_t* cubic_state,\n216\t    uint64_t current_time)\n217\t{\n218\t    if (cubic_state->ssthresh != UINT64_MAX) {\n219\t        cubic_state->W_max = cubic_state->W_last_max;\n220\t        cubic_state->start_of_epoch = cubic_state->previous_start_of_epoch;\n221\t        cubic_state->alg_state = cubic_state->previous_alg_state;\n222\t        if (cubic_state->alg_state != picoquic_cubic_alg_slow_start) {\n223\t            cubic_enter_avoidance(cubic_state, cubic_state->previous_start_of_epoch);\n224\t            double W_cubic = cubic_W_cubic(cubic_state, current_time);\n225\t            cubic_state->W_reno = W_cubic * (double)path_x->send_mtu;\n226\t            cubic_state->ssthresh = (uint64_t)(cubic_state->W_max * PICOQUIC_CUBIC_BETA * (double)path_x->send_mtu);\n227\t            path_x->cwin = (uint64_t)cubic_state->W_reno;\n228\t        }\n229\t        else {\n230\t            cubic_state->ssthresh = cubic_state->previous_ssthresh;\n231\t            path_x->cwin = cubic_state->previous_cwin;\n232\t            cubic_state->W_reno = (double)cubic_state->previous_cwin;\n233\t        }\n234\t    }\n235\t}\n236\t\n237\t/*\n238\t * Properly implementing Cubic requires managing a number of\n239\t * signals, such as packet losses or acknowledgements. We attempt\n240\t * to condensate all that in a single API, which could be shared\n241\t * by many different congestion control algorithms.\n242\t */\n243\tstatic void cubic_notify(\n244\t    picoquic_cnx_t* cnx, picoquic_path_t* path_x,\n245\t    picoquic_congestion_notification_t notification,\n246\t    picoquic_per_ack_state_t * ack_state,\n247\t    uint64_t current_time)\n248\t{\n249\t    picoquic_cubic_state_t* cubic_state = (picoquic_cubic_state_t*)path_x->congestion_alg_state;\n250\t    path_x->is_cc_data_updated = 1;\n251\t\n252\t    if (cubic_state != NULL) {\n253\t        switch (notification) {\n254\t            /* RTT measurements will happen before acknowledgement is signalled */\n255\t            case picoquic_congestion_notification_acknowledgement:\n256\t                switch (cubic_state->alg_state) {\n257\t                    case picoquic_cubic_alg_slow_start:\n258\t                        /* Increase cwin based on bandwidth estimation. */\n259\t                        path_x->cwin = picoquic_cc_update_target_cwin_estimation(path_x);\n260\t\n261\t                        if (path_x->last_time_acked_data_frame_sent > path_x->last_sender_limited_time) {\n262\t                            //if (path_x->bytes_in_transit > path_x->cwin) {\n263\t                                path_x->cwin += picoquic_cc_slow_start_increase_ex(path_x, ack_state->nb_bytes_acknowledged, 0);\n264\t\n265\t                                /* if cnx->cwin exceeds SSTHRESH, exit and go to CA */\n266\t                                if (path_x->cwin >= cubic_state->ssthresh) {\n267\t                                    cubic_state->W_reno = ((double)path_x->cwin) / 2.0;\n268\t                                    path_x->is_ssthresh_initialized = 1;\n269\t                                    cubic_enter_avoidance(cubic_state, current_time);\n270\t                                }\n271\t                            //}\n272\t                        }\n273\t                        break;\n274\t                    /* TODO discuss\n275\t                     * picoquic_cubic_alg_recovery is not entered anyway\n276\t                     */\n277\t                    case picoquic_cubic_alg_recovery:\n278\t                        /* exit recovery, move to CA or SS, depending on CWIN */\n279\t                        cubic_state->alg_state = picoquic_cubic_alg_slow_start;"}]},"parent_tool_use_id":null,"session_id":"e717f4e2-96a7-4752-b6de-ede097ef17e8","uuid":"369a4b91-d930-4d10-83e7-09b6e710f48a","timestamp":"2026-05-07T05:39:30.008Z","tool_use_result":{"type":"text","file":{"filePath":"/Users/richbarn/Projects/picoquic/picoquic/cubic.c","content":"    else {\n        if (notification == picoquic_congestion_notification_timeout) {\n            path_x->cwin = PICOQUIC_CWIN_MINIMUM;\n            cubic_state->previous_start_of_epoch = cubic_state->start_of_epoch;\n            cubic_state->start_of_epoch = current_time;\n            cubic_state->alg_state = picoquic_cubic_alg_slow_start;\n        }\n        else {\n            /* Enter congestion avoidance immediately */\n            cubic_enter_avoidance(cubic_state, current_time);\n            /* Compute the initial window for both Reno and Cubic */\n            double W_cubic = cubic_W_cubic(cubic_state, current_time);\n            uint64_t win_cubic = (uint64_t)(W_cubic * (double)path_x->send_mtu);\n            cubic_state->W_reno = ((double)path_x->cwin) / 2.0;\n\n            /* The formulas that compute \"W_cubic\" at the beginning of congestion avoidance\n            * guarantee that \"w_cubic\" is larger than \"w_reno\" even if \"fast convergence\"\n            * is applied as long as \"beta_cubic\" is greater than\n            * (-1 + sqrt(1+4))/2, about 0.618033988749895.\n            * Since beta_cubic is set to 3/4, we do not need to compare \"w_cubic\" and\n            * \"w_reno\" to pick the largest. */\n            path_x->cwin = win_cubic;\n        }\n    }\n}\n\n/* On spurious repeat notification, restore the previous congestion control.\n * If the previous state was slow start, we get back to slow start with\n * exactly the initial parameters. Otherwise,\n * we assume that K is still valid -- we only update it after exiting recovery.\n * Set cwin to the value of W_max before the recovery event\n * Set W_max to W_max_last, i.e. the value before the recovery event\n * Set the epoch back to where it was, by computing the inverse of the\n * W_cubic formula */\nstatic void cubic_correct_spurious(picoquic_path_t* path_x,\n    picoquic_cubic_state_t* cubic_state,\n    uint64_t current_time)\n{\n    if (cubic_state->ssthresh != UINT64_MAX) {\n        cubic_state->W_max = cubic_state->W_last_max;\n        cubic_state->start_of_epoch = cubic_state->previous_start_of_epoch;\n        cubic_state->alg_state = cubic_state->previous_alg_state;\n        if (cubic_state->alg_state != picoquic_cubic_alg_slow_start) {\n            cubic_enter_avoidance(cubic_state, cubic_state->previous_start_of_epoch);\n            double W_cubic = cubic_W_cubic(cubic_state, current_time);\n            cubic_state->W_reno = W_cubic * (double)path_x->send_mtu;\n            cubic_state->ssthresh = (uint64_t)(cubic_state->W_max * PICOQUIC_CUBIC_BETA * (double)path_x->send_mtu);\n            path_x->cwin = (uint64_t)cubic_state->W_reno;\n        }\n        else {\n            cubic_state->ssthresh = cubic_state->previous_ssthresh;\n            path_x->cwin = cubic_state->previous_cwin;\n            cubic_state->W_reno = (double)cubic_state->previous_cwin;\n        }\n    }\n}\n\n/*\n * Properly implementing Cubic requires managing a number of\n * signals, such as packet losses or acknowledgements. We attempt\n * to condensate all that in a single API, which could be shared\n * by many different congestion control algorithms.\n */\nstatic void cubic_notify(\n    picoquic_cnx_t* cnx, picoquic_path_t* path_x,\n    picoquic_congestion_notification_t notification,\n    picoquic_per_ack_state_t * ack_state,\n    uint64_t current_time)\n{\n    picoquic_cubic_state_t* cubic_state = (picoquic_cubic_state_t*)path_x->congestion_alg_state;\n    path_x->is_cc_data_updated = 1;\n\n    if (cubic_state != NULL) {\n        switch (notification) {\n            /* RTT measurements will happen before acknowledgement is signalled */\n            case picoquic_congestion_notification_acknowledgement:\n                switch (cubic_state->alg_state) {\n                    case picoquic_cubic_alg_slow_start:\n                        /*