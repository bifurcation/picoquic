{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01SQY82wdK2DiN3GDe9PznT7","type":"tool_result","content":"80\tpub mod tls_api;\n81\tpub mod tp;\n82\tpub mod utils;\n83\t\n84\t// Re-export the TP shapes from the public crate root for backwards\n85\t// compatibility with callers that already wrote `crate::TransportParameters`.\n86\tpub use tp::{PreferredAddress, TransportParameter, TransportParameters, VersionNegotiation};\n87\t\n88\tuse core::net::SocketAddr;\n89\t\n90\t// ---------------------------------------------------------------------------\n91\t// Version string and error class.\n92\t//\n93\t// Error values come straight from `#define` and would naturally be\n94\t// untyped in C; in Rust we commit to `u64` because the application\n95\t// API takes them as `uint64_t error_code` parameters and returns\n96\t// them in `get_local_error` etc.\n97\t\n98\t/// Library version string.  C: `VERSION`.\n99\tpub const VERSION: &str = \"1.1.48.0\";\n100\t\n101\t/// Crate-level error type for fallible operations.\n102\t///\n103\t/// Phase 4 implementations return specific variants based on the C\n104\t/// control flow.  The initial variant set covers the broad failure\n105\t/// shapes; additional variants may be added as needed.  Marked\n106\t/// `#[non_exhaustive]` so adding\n107\t/// variants later isn't a breaking change.\n108\t#[derive(Debug, Clone, Copy, PartialEq, Eq)]\n109\t#[non_exhaustive]\n110\tpub enum Error {\n111\t    /// Catch-all for C paths that collapse to a generic failure.\n112\t    Generic,\n113\t    /// Allocation failed.\n114\t    Memory,\n115\t    /// Caller supplied an invalid argument.\n116\t    InvalidArgument,\n117\t    /// A buffer the caller supplied was too small.\n118\t    BufferTooSmall,\n119\t    /// Caller-supplied file does not exist.\n120\t    NoSuchFile,\n121\t    /// Caller-supplied file was malformed.\n122\t    InvalidFile,\n123\t    /// Connection has been disconnected.\n124\t    Disconnected,\n125\t    /// Co