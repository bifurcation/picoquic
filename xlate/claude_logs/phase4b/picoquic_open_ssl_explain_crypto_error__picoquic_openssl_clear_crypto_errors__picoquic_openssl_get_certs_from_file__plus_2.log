{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01Kumw2JXLooZj2gyp1d6NWR","type":"tool_result","content":"1\t[package]\n2\tname = \"fq\"\n3\tversion = \"0.1.0\"\n4\tedition = \"2024\"\n5\t\n6\t[features]\n7\tdefault = []\n8\t# Each backend lives behind its own feature so a binary only pays\n9\t# for the implementations it actually links.  See `src/sys/`.\n10\tsys-picotls = []\n11\tsys-openssl = [\"dep:openssl\"]\n12\tsys-mbedtls = []\n13\tsys-fusion = []\n14\t\n15\t[dependencies]\n16\tfugit = { version = \"0.3\", default-features = false }\n17\trand = { version = \"0.9\", default-features = false }\n18\trand_core = { version = \"0.9\", default-features = false }\n19\t\n20\t# Rust Crypto trait crates (no implementations -- those come from\n21\t# the active TLS backend's crypto layer, except for header\n22\t# protection which we implement ourselves).\n23\taead = { version = \"0.5\", default-features = false }\n24\tcipher = { version = \"0.4\", default-features = false }\n25\tdigest = { version = \"0.10\", default-features = false }\n26\t\n27\t# Concrete cipher implementations used by header protection\n28\t# (QUIC packet-number encryption is QUIC logic, not TLS).\n29\taes = { version = \"0.8\", default-features = false }\n30\tchacha20 = { version = \"0.9\", default-features = false }\n31\t\n32\t# Hash, HKDF, and AEAD implementations used by the QUIC initial-secret\n33\t# derivation, retry-protection AEAD, and test-only crypto helpers in\n34\t# `tls_api`.  These are pure-Rust algorithms not specific to any TLS\n35\t# backend.\n36\tsha2 = { version = \"0.10\", default-features = false }\n37\thkdf = { version = \"0.12\", default-features = false }\n38\thmac = { version = \"0.12\", default-features = false }\n39\taes-gcm = { version = \"0.10\", default-features = false, features = [\"aes\", \"alloc\"] }\n40\t\n41\t# UDP socket abstraction.  std-only.\n42\tsocket2 = { version = \"0.5\", default-features = false, features = [\"all\"] }\n43\t\n44\t# Optional backend implementations (gated by `sys-*` features).\n45\topenssl = { version = \"0.10\", optional = true }\n46\t"}]},"parent_tool_use_id":null,"session_id":"1a5c7007-b115-47e8-a801-5bdd15835036","uuid":"d8e514f4-491b-4663-b55b-a3194399f27f","timestamp":"2026-05-07T06:49:56.987Z","tool_use_result":{"type":"text","file":{"filePath":"/Users/richbarn/Projects/picoquic/rs/fq/Cargo.toml","content":"[package]\nname = \"fq\"\nversion = \"0.1.0\"\nedition = \"2024\"\n\n[features]\ndefault = []\n# Each backend lives behind its own feature so a binary only pays\n# for the implementations it actually links.  See `src/sys/`.\nsys-picotls = []\nsys-openssl = [\"dep:openssl\"]\nsys-mbedtls = []\nsys-fusion = []\n\n[dependencies]\nfugit = { version = \"0.3\", default-features = false }\nrand = { version = \"0.9\", default-features = false }\nrand_core = { version = \"0.9\", default-features = false }\n\n# Rust Crypto trait crates (no implementations -- those come from\n# the active TLS backend's crypto layer, except for header\n# protection which we implement ourselves).\naead = { version = \"0.5\", default-features = false }\ncipher = { version = \"0.4\", default-features = false }\ndigest = { version = \"0.10\", default-features = false }\n\n# Concrete cipher implementations used by header protection\n# (QUIC packet-number encryption is QUIC logic, not TLS).\naes = { version = \"0.8\", default-features = false }\nchacha20 = { version = \"0.9\", default-features = false }\n\n# Hash, HKDF, and AEAD implementations used by the QUIC initial-secret\n# derivation, retry-protection AEAD, and test-only crypto helpers in\n# `tls_api`.  These are pure-Rust algorithms not specific to any TLS\n# backend.\nsha2 = { version = \"0.10\", default-features = false }\nhkdf = { version = \"0.12\", default-features = false }\nhmac = { version = \"0.12\", default-features = false }\naes-gcm = { version = \"0.10\", default-features = false, features = [\"aes\", \"alloc\"] }\n\n# UDP socket abstraction.  std-only.\nsocket2 = { version = \"0.5\", default-features = false, features = [\"all\"] }\n\n# Optional backend implementations (gated by `sys-*` features).\nopenssl = { version = \"0.10\", optional = true }\n","numLines":46,"startLine":1,"totalLines":46}}}
