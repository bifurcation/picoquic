{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01JJD8wSF8LC4gF6K4qVDFZH","type":"tool_result","content":"315\t\n316\t/// Reads a PEM private-key file and returns the DER-encoded\n317\t/// SubjectPublicKeyInfo for the contained key.\n318\t/// Note: the C original uses `i2d_PublicKey` (legacy raw-key encoding);\n319\t/// Rust uses the standard SPKI encoding via `public_key_to_der()`.\n320\t/// C: `picoquic_openssl_get_public_key_from_key_file` (private helper).\n321\tfn get_public_key_from_key_file(keypem: &str) -> Result<Vec<u8>, crate::Error> {\n322\t    let pem = std::fs::read(keypem).map_err(|_| crate::Error::NoSuchFile)?;\n323\t    let pkey =\n324\t        openssl::pkey::PKey::private_key_from_pem(&pem).map_err(|_| crate::Error::InvalidFile)?;\n325\t    pkey.public_key_to_der()\n326\t        .map_err(|_| crate::Error::InvalidFile)\n327\t}\n328\t\n329\t/// Reads up to 16 PEM-encoded X.509 certificates from `file_name` and\n330\t/// returns each as a DER-encoded byte vector.  Returns an empty `Vec` on\n331\t/// any I/O or parse failure (mirrors the C null-return path).\n332\t/// C: `picoquic_openssl_get_certs_from_file`.\n333\tpub fn get_certs_from_file(file_name: &str) -> Vec<Vec<u8>> {\n334\t    let pem = match std::fs::read(file_name) {\n335\t        Ok(data) => data,\n336\t        Err(_) => return Vec::new(),\n337\t    };\n338\t    let certs = match openssl::x509::X509::stack_from_pem(&pem) {\n339\t        Ok(c) => c,\n340\t        Err(_) => return Vec::new(),\n341\t    };\n342\t    certs\n343\t        .into_iter()\n344\t        .take(16)\n345\t        .filter_map(|cert| cert.to_der().ok())\n346\t        .collect()\n347\t}\n348\t\n349\t/// X.509 certificate-verification state backed by an OpenSSL trust store.\n350\t/// C: wraps `ptls_openssl_verify_certificate_t` created by\n351\t/// `picoquic_openssl_get_openssl_certificate_verifier`.\n352\tpub struct CertificateVerifier {\n353\t    /// The X.509 trust store, possibly loaded with root CA certificates.\n354\t    pub store: openssl::x509::store::X509Store,\n355\t    /// `true` when a root CA file was successfully loaded into the store.\n356\t    pub is_cert_store_not_empty: bool,\n357\t}\n358\t\n359\t/// Creates an X.509 certificate verifier backed by a trust store.\n360\t/// If `cert_root_file_name` is `Some`, PEM root certificates are loaded\n361\t/// from that file; `is_cert_store_not_empty` reflects whether the load\n362\t/// succeeded.  Returns `Err(Generic)` if the store cannot be allocated.\n363\t/// C: `picoquic_openssl_get_openssl_certificate_verifier`.\n364\tpub fn get_openssl_certificate_verifier(\n365\t    cert_root_file_name: Option<&str>,\n366\t) -> Result<CertificateVerifier, crate::Error> {\n367\t    let mut builder =\n368\t        openssl::x509::store::X509StoreBuilder::new().map_err(|_| crate::Error::Generic)?;\n369\t    let mut is_cert_store_not_empty = false;\n370\t    if let Some(file_name) = cert_root_file_name {\n371\t        // Load PEM certs from the root CA file and add each to the store.\n372\t        // Mirrors X509_STORE_add_lookup + X509_LOOKUP_load_file from the C original.\n373\t        if let Ok(pem_data) = std::fs::read(file_name) {\n374\t            if let Ok(certs) = openssl::x509::X509::stack_from_pem(&pem_data) {\n375\t                for cert in certs {\n376\t                    if builder.add_cert(cert).is_ok() {\n377\t                        is_cert_store_not_empty = true;\n378\t                    }\n379\t                }\n380\t            }\n381\t        }\n382\t    }\n383\t    Ok(CertificateVerifier {\n384\t        store: builder.build(),\n385\t        is_cert_store_not_empty,\n386\t    })\n387\t}\n388\t\n389\t// ---------------------------------------------------------------------------\n390\t// OpenSSL error-queue helpers.\n391\t\n392\t/// A single entry dequeued from the OpenSSL error queue.\n393\t/// C: single `ERR_get_error_line` / `ERR_get_error_all` result.\n394\tpub struct CryptoError {\n395\t    /// Raw OpenSSL packed error code.\n396\t    pub code: u64,\n397\t    /// Human-readable error reason (e.g. \"no such file or directory\").\n398\t    pub reason: Option<String>,\n399\t    /// OpenSSL library component name (e.g. \"PEM routines\").\n400\t    pub library: Option<String>,\n401\t    /// OpenSSL source file where the error was recorded.\n402\t    pub file: String,\n403\t    /// Line number in the OpenSSL source file.\n404\t    pub line: u32,\n405\t}\n406\t\n407\t/// Dequeue all pending OpenSSL errors and return them.\n408\t/// C callers loop over `picoquic_open_ssl_explain_crypto_error` until the\n409\t/// return code is 0; Rust collects the full queue in one shot.\n410\t/// C: `picoquic_open_ssl_explain_crypto_error`.\n411\tpub fn explain_crypto_error() -> Vec<CryptoError> {\n412\t    openssl::error::ErrorStack::get()\n413\t        .errors()\n414\t        .iter()\n415\t        .map(|e| CryptoError {\n416\t            code: e.code() as u64,\n417\t            reason: e.reason().map(str::to_owned),\n418\t            library: e.library().map(str::to_owned),\n419\t            file: e.file().to_owned(),\n420\t            line: e.line() as u32,\n421\t        })\n422\t        .collect()\n423\t}\n424\t\n425\t/// Clear the OpenSSL error queue, discarding all pending errors.\n426\t/// C: `picoquic_openssl_clear_crypto_errors`.\n427\tpub fn clear_crypto_errors() {\n428\t    drop(openssl::error::ErrorStack::get());\n429\t}\n430\t"}]},"parent_tool_use_id":null,"session_id":"1a5c7007-b115-47e8-a801-5bdd15835036","uuid":"aa89e22a-d59c-4a8b-958a-33c03f58ef59","timestamp":"2026-05-07T06:57:08.028Z","tool_use_result":{"type":"text","file":{"filePath":"/Users/richbarn/Projects/picoquic/rs/fq/src/sys/openssl.rs","content":"\n/// Reads a PEM private-key file and returns the DER-encoded\n/// SubjectPublicKeyInfo for the contained key.\n/// Note: the C original uses `i2d_PublicKey` (legacy raw-key encoding);\n/// Rust uses the standard SPKI encoding via `public_key_to_der()`.\n/// C: `picoquic_openssl_get_public_key_from_key_file` (private helper).\nfn get_public_key_from_key_file(keypem: &str) -> Result<Vec<u8>, crate::Error> {\n    let pem = std::fs::read(keypem).map_err(|_| crate::Error::NoSuchFile)?;\n    let pkey =\n        openssl::pkey::PKey::private_key_from_pem(&pem).map_err(|_| crate::Error::InvalidFile)?;\n    pkey.public_key_to_der()\n        .map_err(|_| crate::Error::InvalidFile)\n}\n\n/// Reads up to 16 PEM-encoded X.509 certificates from `file_name` and\n/// returns each as a DER-encoded byte vector.  Returns an empty `Vec` on\n/// any I/O or parse failure (mirrors the C null-return path).\n/// C: `picoquic_openssl_get_certs_from_file`.\npub fn get_certs_from_file(file_name: &str) -> Vec<Vec<u8>> {\n    let pem = match std::fs::read(file_name) {\n        Ok(data) => data,\n        Err(_) => return Vec::new(),\n    };\n    let certs = match openssl::x509::X509::stack_from_pem(&pem) {\n        Ok(c) => c,\n        Err(_) => return Vec::new(),\n    };\n    certs\n        .into_iter()\n        .take(16)\n        .filter_map(|cert| cert.to_der().ok())\n        .collect()\n}\n\n/// X.509 certificate-verification state backed by an OpenSSL trust store.\n/// C: wraps `ptls_openssl_verify_certificate_t` created by\n/// `picoquic_openssl_get_openssl_certificate_verifier`.\npub struct CertificateVerifier {\n    /// The X.509 trust store, possibly loaded with root CA certificates.\n    pub store: openssl::x509::store::X509Store,\n    /// `true` when a root CA file was successfully loaded into the store.\n    pub is_cert_store_not_empty: bool,\n}\n\n/// Creates an X.509 certificate verifier backed by a trust store.\n/// If `cert_root_file_name` is `Some`, PEM root certificates are loaded\n/// from that file; `is_cert_store_not_empty` reflects whether the load\n/// succeeded.  Returns `Err(Generic)` if the store cannot be allocated.\n/// C: `picoquic_openssl_get_openssl_certificate_verifier`.\npub fn get_openssl_certificate_verifier(\n    cert_root_file_name: Option<&str>,\n) -> Result<CertificateVerifier, crate::Error> {\n    let mut builder =\n        openssl::x509::store::X509StoreBuilder::new().map_err(|_| crate::Error::Generic)?;\n    let mut is_cert_store_not_empty = false;\n    if let Some(file_name) = cert_root_file_name {\n        // Load PEM certs from the root CA file and add each to the store.\n        // Mirrors X509_STORE_add_lookup + X509_LOOKUP_load_file from the C original.\n        if let Ok(pem_data) = std::fs::read(file_name) {\n            if let Ok(certs) = openssl::x509::X509::stack_from_pem(&pem_data) {\n                for cert in certs {\n                    if builder.add_cert(cert).is_ok() {\n                        is_cert_store_not_empty = true;\n                    }\n                }\n            }\n        }\n    }\n    Ok(CertificateVerifier {\n        store: builder.build(),\n        is_cert_store_not_empty,\n    })\n}\n\n// ---------------------------------------------------------------------------\n// OpenSSL error-queue helpers.\n\n/// A single entry dequeued from the OpenSSL error queue.\n/// C: single `ERR_get_error_line` / `ERR_get_error_all` result.\npub struct CryptoError {\n    /// Raw OpenSSL packed error code.\n    pub code: u64,\n    /// Human-readable error reason (e.g. \"no such file or directory\").\n    pub reason: Option<String>,\n    /// OpenSSL library component name (e.g. \"PEM routines\").\n    pub library: Option<String>,\n    /// OpenSSL source file where the error was recorded.\n    pub file: String,\n    /// Line number in the OpenSSL source file.\n    pub line: u32,\n}\n\n/// Dequeue all pending OpenSSL errors and return them.\n/// C callers loop over `picoquic_open_ssl_explain_crypto_error` until the\n/// return code is 0; Rust collects the full queue in one shot.\n/// C: `picoquic_open_ssl_explain_crypto_error`.\npub fn explain_crypto_error() -> Vec<CryptoError> {\n    openssl::error::ErrorStack::get()\n        .errors()\n        .iter()\n        .map(|e| CryptoError {\n            code: e.code() as u64,\n            reason: e.reason().map(str::to_owned),\n            library: e.library().map(str::to_owned),\n            file: e.file().to_owned(),\n            line: e.line() as u32,\n        })\n        .collect()\n}\n\n/// Clear the OpenSSL error queue, discarding all pending errors.\n/// C: `picoquic_openssl_clear_crypto_errors`.\npub fn clear_crypto_errors() {\n    drop(openssl::error::ErrorStack::get());\n}\n","numLines":116,"startLine":315,"totalLines":430}}}
