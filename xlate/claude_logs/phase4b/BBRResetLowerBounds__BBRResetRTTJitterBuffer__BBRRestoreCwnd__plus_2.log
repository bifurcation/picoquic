{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01MhxZ3jP39ZGVMK1LsWtj8B","type":"tool_result","content":"1\t//! Translation of `picoquic/bbr.c` — BBRv3 congestion control.\n2\t//!\n3\t//! Phase 4: private helper batch (BBRAccessEcnPacketContext,\n4\t//! BBRAdaptMinRttMargin, BBRAdvanceLatestDeliverySignals,\n5\t//! BBRBDPMultipleWithBw, BBRBoundBWForModel, BBREnterStartup,\n6\t//! BBREnterStartupLongRTT, BBREnterStartupResume,\n7\t//! BBRExitLostFeedback, BBRHasElapsedInPhase).\n8\t\n9\tuse crate::PacketContext;\n10\tuse crate::cc_common::MinMaxRtt;\n11\tuse crate::internal::{\n12\t    CWIN_INITIAL, Connection, INITIAL_RTT, PacketContextState, Path, TARGET_RENO_RTT,\n13\t    TARGET_SATELLITE_RTT,\n14\t};\n15\t\n16\t// ---------------------------------------------------------------------------\n17\t// Constants from bbr.c `#define`s.\n18\t\n19\tconst BBR_MIN_RTT_MARGIN_PERCENT: u64 = 5;\n20\tconst BBR_APP_LIMITED_ROUNDS_THRESHOLD: i32 = 3; // C: BBRAppLimitedRoundsThreshold\n21\tconst BBR_STARTUP_PACING_GAIN: f64 = 2.77; // C: BBRStartupPacingGain (4·ln 2)\n22\tconst BBR_STARTUP_CWND_GAIN: f64 = 2.0; // C: BBRStartupCwndGain\n23\tconst BBR_STARTUP_RESUME_PACING_GAIN: f64 = 1.25; // C: BBRStartupResumePacingGain\n24\tconst BBR_STARTUP_RESUME_CWND_GAIN: f64 = 1.25; // C: BBRStartupResumeCwndGain\n25\tconst BBR_PROBE_RTT_CWND_GAIN: f64 = 0.5; // C: BBRProbeRTTCwndGain\n26\tconst BBR_EXCESSIVE_ECN_CE: f64 = 0.2; // C: BBRExcessiveEcnCE\n27\tconst BBR_BETA: f64 = 0.7; // C: BBRBeta — multiplicative decrease on loss\n28\t\n29\t// ---------------------------------------------------------------------------\n30\t// Algorithm-state enum.  C: `picoquic_bbr_alg_state_t`.\n31\t\n32\t#[derive(Debug, Copy, Clone, PartialEq, Eq, Default)]\n33\tpub enum BbrAlgState {\n34\t    #[default]\n35\t    Startup = 0,\n36\t    Drain,\n37\t    ProbeBwDown,\n38\t    ProbeBwCruise,\n39\t    ProbeBwRefill,\n40\t    ProbeBwUp,\n41\t    ProbeRtt,\n42\t    StartupLongRtt,\n43\t    StartupResume,\n44\t}\n45\t\n46\t// ---------------------------------------------------------------------------\n47\t// ACK-phase enum.  C: `picoquic_bbr_ack_phase_t`.\n48\t\n49\t#[derive(Debug, Copy, Clone, PartialEq, Eq, Default)]\n50\tpub enum BbrAckPhase {\n51\t    #[default]\n52\t    ProbeStarting = 0,\n53\t    ProbeStopping,\n54\t    Refilling,\n55\t    ProbeFeedback,\n56\t}\n57\t\n58\t// ---------------------------------------------------------------------------\n59\t// Experimental-flag struct.  C: `bbr_exp` (always enabled via\n60\t// `#define BBRExperiment on`).\n61\t\n62\t#[derive(Debug, Clone, Default)]\n63\tpub struct BbrExp {\n64\t    pub do_early_exit: bool,\n65\t    pub do_rapid_start: bool,\n66\t    pub do_handle_suspension: bool,\n67\t    pub do_control_lost: bool,\n68\t    pub do_exit_probe_bw_up_on_delay: bool,\n69\t    pub do_enter_probe_bw_after_limited: bool,\n70\t}\n71\t\n72\t// ---------------------------------------------------------------------------\n73\t// Per-ACK state.  C: `bbr_per_ack_state_t`.\n74\t\n75\t#[derive(Debug, Clone, Default)]\n76\tpub struct BbrPerAckState {\n77\t    pub delivered: u64,\n78\t    pub delivery_rate: u64,\n79\t    pub rtt_sample: u64,\n80\t    pub newly_acked: u64,\n81\t    pub newly_lost: u64,\n82\t    pub tx_in_flight: u64,\n83\t    pub lost: u64,\n84\t    pub ecn_ce: u64,\n85\t    pub ecn_frac: f64,\n86\t    pub ecn_alpha: f64,\n87\t    pub is_app_limited: bool,\n88\t    pub is_cwnd_limited: bool,\n89\t}\n90\t\n91\t// ---------------------------------------------------------------------------\n92\t// BBR state.  C: `picoquic_bbr_state_t`.\n93\t//\n94\t// Type deviations from C:\n95\t//   * single-bit `unsigned int x : 1` bitfields → `bool`\n96\t//   * non-negative `int` counters → `u32`\n97\t//   * `char const* option_string` → `Option<String>` (owned copy)\n98\t//   * `picoquic_min_max_rtt_t rtt_filter` → `MinMaxRtt`\n99\t//   * fixed arrays keep their C dimensions as Rust `[T; N]`\n100\t\n101\tpub struct BbrState {\n102\t    pub state: BbrAlgState,\n103\t    pub round_start_pn: u64,\n104\t    pub round_count: u32,\n105\t    pub rounds_since_probe: u32,\n106\t    pub round_start: bool,\n107\t    pub next_round_delivered: u64,\n108\t\n109\t    pub pacing_rate: f64,\n110\t    pub send_quantum: u64,\n111\t    pub prior_cwnd: u64,\n112\t\n113\t    pub pacing_gain: f64,\n114\t    pub next_departure_time: u64,\n115\t\n116\t    pub cwnd_gain: f64,\n117\t    pub packet_conservation: bool,\n118\t\n119\t    pub max_bw: u64,\n120\t    pub bw_hi: u64,\n121\t    pub bw_lo: u64,\n122\t    pub bw: u64,\n123\t\n124\t    // min_rtt uses u64::MAX as the sentinel \"no valid sample yet\".\n125\t    pub min_rtt: u64,\n126\t\n127\t    pub bdp: u64,\n128\t    pub extra_acked: u64,\n129\t    pub offload_budget: u64,\n130\t    pub max_inflight: u64,\n131\t    pub inflight_hi: u64,\n132\t    pub inflight_lo: u64,\n133\t\n134\t    pub bw_latest: u64,\n135\t    pub inflight_latest: u64,\n136\t\n137\t    // BBRMaxBwFilterLen = 2\n138\t    pub max_bw_filter: [u64; 2],\n139\t    pub cycle_count: u32,\n140\t\n141\t    pub extra_acked_interval_start: u64,\n142\t    pub extra_acked_delivered: u64,\n143\t    // BBRExtraAckedFilterLen = 10\n144\t    pub extra_acked_filter: [u64; 10],\n145\t\n146\t    pub filled_pipe: bool,\n147\t    pub full_bw: u64,\n148\t    pub full_bw_count: u32,\n149\t\n150\t    pub min_rtt_stamp: u64,\n151\t    pub probe_rtt_min_delay: u64,\n152\t    pub probe_rtt_min_stamp: u64,\n153\t    pub probe_rtt_done_stamp: u64,\n154\t    pub min_rtt_margin: u64,\n155\t    pub probe_rtt_expired: bool,\n156\t    pub probe_rtt_round_done: bool,\n157\t    pub idle_restart: bool,\n158\t    pub path_is_app_limited: bool,\n159\t\n160\t    pub probe_probe_bw_quickly: bool,\n161\t    pub bw_probe_wait: u64,\n162\t    pub bw_probe_ceiling: u64,\n163\t    pub cycle_stamp: u64,\n164\t    pub rounds_since_bw_probe: u32,\n165\t    pub bw_probe_up_cnt: u32,\n166\t    pub bw_probe_up_rounds: u32,\n167\t    pub bw_probe_samples: u32,\n168\t    pub bw_probe_up_acks: u64,\n169\t    pub ack_phase: BbrAckPhase,\n170\t\n171\t    pub loss_in_round: bool,\n172\t    pub loss_round_start: bool,\n173\t    pub loss_round_delivered: u64,\n174\t\n175\t    pub is_in_recovery: bool,\n176\t    pub is_pto_recovery: bool,\n177\t    pub recovery_packet_number: u64,\n178\t    pub recovery_delivered: u64,\n179\t\n180\t    pub is_handling_lost_feedback: bool,\n181\t    pub cwin_before_lost_feedback: u64,\n182\t\n183\t    pub app_limited_round_count: i32,\n184\t    pub app_limited_this_round: i32,\n185\t\n186\t    pub ecn_ect1_last_round: u64,\n187\t    pub ecn_ce_last_round: u64,\n188\t    pub ecn_alpha: f64,\n189\t\n190\t    pub random_context: u64,\n191\t\n192\t    pub rtt_filter: MinMaxRtt,\n193\t    pub bdp_seed: u64,\n194\t    pub probe_bdp_seed: bool,\n195\t\n196\t    pub option_string: Option<String>,\n197\t    pub wifi_shadow_rtt: u64,\n198\t    pub quantum_ratio: f64,\n199\t\n200\t    pub exp_flags: BbrExp,\n201\t}\n202\t\n203\timpl BbrState {\n204\t    /// C: `BBRAdaptMinRttMargin` (picoquic/bbr.c:1290)\n205\t    ///\n206\t    /// Recompute `min_rtt_margin` as a fixed percentage of `min_rtt`\n207\t    /// plus the transmission time of two MTU-sized packets at `max_bw`.\n208\t    /// The margin prevents the probe-RTT timer from firing too early\n209\t    /// when only a small amount of queuing is present.\n210\t    pub fn adapt_min_rtt_margin(&mut self, path_x: &Path) {\n211\t        let margin = (self.min_rtt * BBR_MIN_RTT_MARGIN_PERCENT) * 100 / 1_000_000;\n212\t        let margin = if self.max_bw > 0 {\n213\t            margin + 2 * path_x.send_mtu as u64 * 1_000_000 / self.max_bw\n214\t        } else {\n215\t            margin\n216\t        };\n217\t        self.min_rtt_margin = margin;\n218\t    }\n219\t\n220\t    /// C: `BBRAdvanceLatestDeliverySignals` (picoquic/bbr.c:1007)\n221\t    ///\n222\t    /// Called near the end of ACK processing: if this ACK completed a\n223\t    /// loss round, reset `bw_latest` and `inflight_latest` to the\n224\t    /// current sample so the next round starts fresh.\n225\t    pub fn advance_latest_delivery_signals(&mut self, rs: &BbrPerAckState) {\n226\t        if self.loss_round_start {\n227\t            self.bw_latest = rs.delivery_rate;\n228\t            self.inflight_latest = rs.delivered;\n229\t        }\n230\t    }\n231\t\n232\t    /// C: `BBRBDPMultipleWithBw` (picoquic/bbr.c:869)\n233\t    ///\n234\t    /// Returns `gain × BDP` computed at the supplied `bw` rather than\n235\t    /// `self.bw`.  When `min_rtt` has never been measured (`u64::MAX`),\n236\t    /// returns the initial congestion window as a safe floor.\n237\t    ///\n238\t    /// Side-effect: writes `self.bdp` so callers can read the raw BDP\n239\t    /// estimate after the call (mirrors C's write-through of\n240\t    /// `bbr_state->bdp`).\n241\t    pub fn bdp_multiple_with_bw(&mut self, path_x: &Path, gain: f64, bw: u64) -> u64 {\n242\t        if self.min_rtt == u64::MAX {\n243\t            return CWIN_INITIAL * path_x.send_mtu as u64;\n244\t        }\n245\t        // PICOQUIC_BYTES_FROM_RATE(min_rtt_us, bps) = min_rtt * bps / 1_000_000\n246\t        self.bdp = self.min_rtt * bw / 1_000_000;\n247\t        (gain * self.bdp as f64) as u64\n248\t    }\n249\t\n250\t    /// C: `BBRBoundBWForModel` (picoquic/bbr.c:1094)\n251\t    ///\n252\t    /// Set `self.bw = min(max_bw, bw_lo, bw_hi)`.  `bw_hi` is only\n253\t    /// applied when non-zero; the zero check preserves compatibility\n254\t    /// with states where `bw_hi` is not yet initialised (noted as a\n255\t    /// TODO in the C source).\n256\t    pub fn bound_bw_for_model(&mut self) {\n257\t        self.bw = self.max_bw;\n258\t        if self.bw > self.bw_lo {\n259\t            self.bw = self.bw_lo;\n260\t        }\n261\t        // TODO: remove the bw_hi != 0 guard once variables are properly\n262\t        // initialised (mirrors the C-side TODO at bbr.c:1100).\n263\t        if self.bw > self.bw_hi && self.bw_hi != 0 {\n264\t            self.bw = self.bw_hi;\n265\t        }\n266\t    }\n267\t\n268\t    /// C: `BBREnterProbeRTT` (picoquic/bbr.c:1487)\n269\t    pub fn enter_probe_rtt(&mut self, path_x: &mut Path) {\n270\t        self.state = BbrAlgState::ProbeRtt;\n271\t        self.pacing_gain = 1.0;\n272\t        self.cwnd_gain = BBR_PROBE_RTT_CWND_GAIN;\n273\t        path_x.is_cca_probing_up = false;\n274\t    }\n275\t\n276\t    /// C: `BBREnterDrain` (picoquic/bbr.c:1933)\n277\t    pub fn enter_drain(&mut self, path_x: &mut Path) {\n278\t        // Picoquic-specific: notify transport that the startup phase is complete.\n279\t        path_x.is_ssthresh_initialized = true;\n280\t        self.state = BbrAlgState::Drain;\n281\t        self.pacing_gain = 1.0 / BBR_STARTUP_CWND_GAIN; // pace slowly\n282\t        self.cwnd_gain = BBR_STARTUP_CWND_GAIN; // maintain cwnd\n283\t        path_x.is_cca_probing_up = false;\n284\t    }\n285\t\n286\t    /// C: `BBRCheckStartupFullBandwidthGeneric` (picoquic/bbr.c:1952)\n287\t    pub fn check_startup_full_bandwidth_generic(&mut self, rs: &BbrPerAckState, threshold: f64) {\n288\t        if self.filled_pipe || !self.round_start || rs.is_app_limited {\n289\t            return;\n290\t        }\n291\t        if self.max_bw as f64 >= threshold * self.full_bw as f64 {\n292\t            // still growing\n293\t            self.full_bw = self.max_bw;\n294\t            self.full_bw_count = 0;\n295\t            return;\n296\t        }\n297\t        self.full_bw_count += 1; // another round without much growth\n298\t        if self.full_bw_count >= 3 {\n299\t            self.filled_pipe = true;\n300\t        }\n301\t    }\n302\t\n303\t    /// C: `BBRCheckStartupFullBandwidth` (picoquic/bbr.c:2020)\n304\t    pub fn check_startup_full_bandwidth(&mut self, rs: &BbrPerAckState) {\n305\t        if self.filled_pipe || !self.round_start || rs.is_app_limited {\n306\t            return;\n307\t        }\n308\t        // 5/4 integer approximation of ×1.25 avoids floating-point drift.\n309\t        if 4 * self.max_bw >= 5 * self.full_bw {\n310\t            // still growing\n311\t            self.full_bw = self.max_bw;\n312\t            self.full_bw_count = 0;\n313\t            if rs.ecn_frac < 0.2 {\n314\t                return;\n315\t            }\n316\t        }\n317\t        self.full_bw_count += 1; // another round without much growth\n318\t        if self.full_bw_count >= 3 || rs.ecn_frac >= BBR_EXCESSIVE_ECN_CE {\n319\t            self.filled_pipe = true;\n320\t        }\n321\t    }\n322\t\n323\t    /// C: `BBRCheckAppLimitedEnded` (picoquic/bbr.c:1747)\n324\t    ///\n325\t    /// Tracks per-round app-limited state.  Returns `true` on the first\n326\t    /// round where the app is *not* limited after having been limited for\n327\t    /// more than `BBR_APP_LIMITED_ROUNDS_THRESHOLD` consecutive rounds.\n328\t    pub fn check_app_limited_ended(&mut self, rs: &BbrPerAckState) -> bool {\n329\t        let mut app_limited_ended = false;\n330\t        if self.round_start {\n331\t            if self.app_limited_this_round != 0 {\n332\t                self.app_limited_round_count += 1;\n333\t            } else {\n334\t                app_limited_ended = self.app_limited_round_count > BBR_APP_LIMITED_ROUNDS_THRESHOLD;\n335\t                self.app_limited_round_count = 0;\n336\t            }\n337\t            self.app_limited_this_round = 0;\n338\t        } else {\n339\t            self.app_limited_this_round |= rs.is_app_limited as i32;\n340\t        }\n341\t        app_limited_ended\n342\t    }\n343\t\n344\t    /// C: `BBRExitLostFeedback` (picoquic/bbr.c:782)\n345\t    ///\n346\t    /// Restore the congestion window saved by `BBREnterLostFeedback` and\n347\t    /// clear the lost-feedback flag.  No-op if the flag is not set.\n348\t    pub fn exit_lost_feedback(&mut self, path_x: &mut Path) {\n349\t        if self.is_handling_lost_feedback {\n350\t            path_x.cwin = self.cwin_before_lost_feedback;\n351\t            self.is_handling_lost_feedback = false;\n352\t        }\n353\t    }\n354\t\n355\t    /// C: `BBRHasElapsedInPhase` (picoquic/bbr.c:1776)\n356\t    ///\n357\t    /// Returns `true` when `current_time` has advanced past\n358\t    /// `cycle_stamp + interval`.  Used to decide when to transition from\n359\t    /// DOWN/CRUISE to REFILL in the probe-BW cycle.\n360\t    pub(crate) fn has_elapsed_in_phase(&self, interval: u64, current_time: u64) -> bool {\n361\t        current_time > self.cycle_stamp + interval\n362\t    }\n363\t\n364\t    /// C: `BBREnterStartupResume` (picoquic/bbr.c:1972)\n365\t    ///\n366\t    /// Enter `StartupResume` state, which uses Hystart-like pacing gains\n367\t    /// to resume quickly after a suspension.  Called either when a BDP\n368\t    /// seed is set or on the initial `EnterStartup` path when a seed\n369\t    /// exists.\n370\t    pub(crate) fn enter_startup_resume(&mut self) {\n371\t        self.state = BbrAlgState::StartupResume;\n372\t        self.pacing_gain = BBR_STARTUP_RESUME_PACING_GAIN;\n373\t        self.cwnd_gain = BBR_STARTUP_RESUME_CWND_GAIN;\n374\t    }\n375\t\n376\t    /// C: `BBREnterStartup` (picoquic/bbr.c:2061)\n377\t    ///\n378\t    /// Enter normal `Startup` state with the standard pacing and cwnd\n379\t    /// gains.  Sets `is_cca_probing_up` to inform the transport that the\n380\t    /// congestion controller is actively probing for more bandwidth.\n381\t    pub fn enter_startup(&mut self, path_x: &mut Path) {\n382\t        self.state = BbrAlgState::Startup;\n383\t        self.pacing_gain = BBR_STARTUP_PACING_GAIN;\n384\t        self.cwnd_gain = BBR_STARTUP_CWND_GAIN;\n385\t        path_x.is_cca_probing_up = true;\n386\t    }\n387\t\n388\t    /// C: `BBREnterStartupLongRTT` (picoquic/bbr.c:2080)\n389\t    ///\n390\t    /// Enter `StartupLongRTT` state, which uses Hystart rather than the\n391\t    /// normal BBR Startup algorithm.  The initial congestion window is\n392\t    /// scaled up from `CWIN_INITIAL` proportional to `rtt_min` (capped at\n393\t    /// the satellite-RTT ceiling) and then further boosted by the BDP seed\n394\t    /// when available.\n395\t    pub fn enter_startup_long_rtt(&mut self, path_x: &mut Path) {\n396\t        let mut cwnd = CWIN_INITIAL;\n397\t        self.state = BbrAlgState::StartupLongRtt;\n398\t        if path_x.rtt_min > TARGET_RENO_RTT {\n399\t            let rtt_cap = if path_x.rtt_min > TARGET_SATELLITE_RTT {\n400\t                TARGET_SATELLITE_RTT\n401\t            } else {\n402\t                path_x.rtt_min\n403\t            };\n404\t            cwnd = (cwnd as f64 * rtt_cap.ticks() as f64 / TARGET_RENO_RTT.ticks() as f64) as u64;\n405\t        }\n406\t        if cwnd < self.bdp_seed {\n407\t            cwnd = self.bdp_seed;\n408\t        }\n409\t        if cwnd > path_x.cwin {\n410\t            path_x.cwin = cwnd;\n411\t        }\n412\t        path_x.is_cca_probing_up = true;\n413\t    }\n414\t\n415\t    /// C: `BBRInitFullPipe` (picoquic/bbr.c:434)\n416\t    ///\n417\t    /// Reset the \"pipe full\" bandwidth-growth detector to its initial state.\n418\t    pub fn init_full_pipe(&mut self) {\n419\t        self.filled_pipe = false;\n420\t        self.full_bw = 0;\n421\t        self.full_bw_count = 0;\n422\t    }\n423\t\n424\t    /// C: `BBRInitLowerBounds` (picoquic/bbr.c:1025)\n425\t    ///\n426\t    /// On the first congestion episode in a cycle, latch `bw_lo` to\n427\t    /// `max_bw` and `inflight_lo` to `cwin` (the UINT64_MAX sentinel\n428\t    /// means \"not yet initialised\").\n429\t    pub fn init_lower_bounds(&mut self, path_x: &Path) {\n430\t        if self.bw_lo == u64::MAX {\n431\t            self.bw_lo = self.max_bw;\n432\t        }\n433\t        if self.inflight_lo == u64::MAX {\n434\t            self.inflight_lo = path_x.cwin;\n435\t        }\n436\t    }\n437\t\n438\t    /// C: `BBRInitPacingRate` (picoquic/bbr.c:933)\n439\t    ///\n440\t    /// Set the initial pacing rate based on the nominal bandwidth at\n441\t    /// `INITIAL_RTT` (250 ms), unless the path already has a real RTT\n442\t    /// estimate, in which case that estimate is used instead.\n443\t    pub fn init_pacing_rate(&mut self, path_x: &Path) {\n444\t        let initial_rtt = if path_x.smoothed_rtt != INITIAL_RTT || path_x.rtt_variant.ticks() != 0 {\n445\t            path_x.smoothed_rtt.ticks()\n446\t        } else {\n447\t            INITIAL_RTT.ticks()\n448\t        };\n449\t        let nominal_bandwidth = (1_000_000u64 * CWIN_INITIAL) as f64 / initial_rtt as f64;\n450\t        self.pacing_rate = BBR_STARTUP_PACING_GAIN * nominal_bandwidth;\n451\t    }\n452\t\n453\t    /// C: `BBRInitRandom` (picoquic/bbr.c:421)\n454\t    ///\n455\t    /// Seed `random_context` from the current time, connection role, and\n456\t    /// path ID so that tests remain deterministic while production runs\n457\t    /// diverge.  `connection` is passed separately because `Path` carries\n458\t    /// no back-pointer to its owning `Connection` in Rust.\n459\t    pub fn init_random(&mut self, connection: &Connection, path_x: &Path, current_time: u64) {\n460\t        let mut ctx: u64 = 0xfedcba9876543210;\n461\t        ctx ^= current_time;\n462\t        if connection.client_mode {\n463\t            ctx = ctx.wrapping_add(0x0123456789abcdef);\n464\t        }\n465\t        if path_x.unique_path_id > 0 && path_x.unique_path_id != u64::MAX {\n466\t            ctx = ctx.wrapping_mul(path_x.unique_path_id.wrapping_add(1));\n467\t        }\n468\t        self.random_context = ctx;\n469\t    }\n470\t\n471\t    /// C: `BBRInflightWithHeadroom` (picoquic/bbr.c:1547)\n472\t    ///\n473\t    /// Returns the inflight limit that leaves `BBRHeadroom` (15%) of the\n474\t    /// bottleneck buffer free for competing flows.  Returns `u64::MAX`\n475\t    /// when `inflight_hi` has not yet been measured.\n476\t    pub fn inflight_with_headroom(&self, path_x: &Path) -> u64 {\n477\t        const BBR_HEADROOM: f64 = 0.15;\n478\t        const BBR_MIN_PIPE_CWND: u64 = 4;\n479\t        if self.inflight_hi == u64::MAX {\n480\t            return u64::MAX;\n481\t        }\n482\t        let headroom = ((1.0 - BBR_HEADROOM) * self.inflight_hi as f64) as u64;\n483\t        headroom.max(BBR_MIN_PIPE_CWND * path_x.send_mtu as u64)\n484\t    }\n485\t\n486\t    /// C: `BBRIsProbingBW` (picoquic/bbr.c:1532)\n487\t    ///\n488\t    /// Returns `true` when the state is actively probing for more bandwidth\n489\t    /// (i.e. NOT in one of the non-probing states: ProbeBwDown, ProbeBwCruise,\n490\t    /// Drain, or ProbeRtt).\n491\t    pub fn is_probing_bw(&self) -> bool {\n492\t        !matches!(\n493\t            self.state,\n494\t            BbrAlgState::ProbeBwDown\n495\t                | BbrAlgState::ProbeBwCruise\n496\t                | BbrAlgState::Drain\n497\t                | BbrAlgState::ProbeRtt\n498\t        )\n499\t    }\n500\t\n501\t    /// C: `BBRLossLowerBounds` (picoquic/bbr.c:1035)\n502\t    ///\n503\t    /// Apply a `BBRBeta` (0.7) multiplicative decrease to `bw_lo` and\n504\t    /// `inflight_lo`, then floor each at the latest sample so the model\n505\t    /// cannot shrink below what was actually observed this round.\n506\t    pub fn loss_lower_bounds(&mut self) {\n507\t        self.bw_lo = ((BBR_BETA * self.bw_lo as f64) as u64).max(self.bw_latest);\n508\t        self.inflight_lo = ((BBR_BETA * self.inflight_lo as f64) as u64).max(self.inflight_latest);\n509\t    }\n510\t\n511\t    /// C: `BBRModulateCwndForRecovery` (picoquic/bbr.c:627)\n512\t    ///\n513\t    /// On packet loss, shrink `cwin` by the number of bytes lost (floored at\n514\t    /// one MTU).  When `packet_conservation` is active, ensure `cwin` is at\n515\t    /// least `bytes_in_transit + newly_acked` so the pipe stays full.\n516\t    pub fn modulate_cwnd_for_recovery(&self, path_x: &mut Path, rs: &BbrPerAckState) {\n517\t        if rs.newly_lost > 0 {\n518\t            if path_x.cwin > rs.newly_lost + path_x.send_mtu as u64 {\n519\t                path_x.cwin -= rs.newly_lost;\n520\t            } else {\n521\t                path_x.cwin = path_x.send_mtu as u64;\n522\t            }\n523\t        }\n524\t        if self.packet_conservation && path_x.cwin < path_x.bytes_in_transit + rs.newly_acked {\n525\t            path_x.cwin = path_x.bytes_in_transit + rs.newly_acked;\n526\t        }\n527\t    }\n528\t\n529\t    /// C: `BBRRaiseInflightHiSlope` (picoquic/bbr.c:1561)\n530\t    ///\n531\t    /// Recompute how aggressively `inflight_hi` is raised during ProbeBwUp.\n532\t    /// Each round the slope doubles (shift by `bw_probe_up_rounds`, capped at\n533\t    /// 30), and `bw_probe_up_cnt` is set to the number of MTU-sized ACKs\n534\t    /// required to justify a one-MTU increase (minimum 1).\n535\t    pub fn raise_inflight_hi_slope(&mut self, path_x: &Path) {\n536\t        let growth_this_round = (path_x.send_mtu as u64) << self.bw_probe_up_rounds;\n537\t        self.bw_probe_up_rounds = (self.bw_probe_up_rounds + 1).min(30);\n538\t        let up_cnt = (path_x.cwin / growth_this_round) as u32;\n539\t        self.bw_probe_up_cnt = up_cnt.max(1);\n540\t    }\n541\t\n542\t    /// C: `BBRResetCongestionSignals` (picoquic/bbr.c:1014)\n543\t    ///\n544\t    /// Clear the per-round congestion signals so the next round starts with\n545\t    /// a clean slate.  Called at the start of each new round.\n546\t    pub fn reset_congestion_signals(&mut self) {\n547\t        self.loss_in_round = false;\n548\t        self.bw_latest = 0;\n549\t        self.inflight_latest = 0;\n550\t    }\n551\t}\n552\t\n553\t/// C: `BBRAccessEcnPacketContext` (picoquic/bbr.c:2245)\n554\t///\n555\t/// Return the packet-context that carries ECN counts for `path_x`.\n556\t///\n557\t/// Under multipath each path has its own context; under single-path\n558\t/// only the default path (`unique_path_id == 0`, corresponding to\n559\t/// `cnx->path[0]` in C) participates in ECN tracking — other paths\n560\t/// return `None`.\n561\t///\n562\t/// Note: in C the path held a back-pointer to its connection\n563\t/// (`path_x->cnx`); in Rust there is no back-pointer, so the caller\n564\t/// must supply both `connection` and `path_x`.\n565\tpub fn access_ecn_packet_context<'a>(\n566\t    connection: &'a Connection,\n567\t    path_x: &'a Path,\n568\t) -> Option<&'a PacketContextState> {\n569\t    if connection.is_multipath_enabled {\n570\t        Some(&path_x.pkt_ctx)\n571\t    } else if path_x.unique_path_id != 0 {\n572\t        // Non-default path in single-path mode: ECN counts are not\n573\t        // tracked per-path here; the caller should use the default path.\n574\t        None\n575\t    } else {\n576\t        Some(&connection.pkt_ctx[PacketContext::Application as usize])\n577\t    }\n578\t}\n579\t\n580\t#[cfg(test)]\n581\tmod tests {\n582\t    use super::*;\n583\t\n584\t    fn make_state() -> BbrState {\n585\t        BbrState {\n586\t            state: BbrAlgState::default(),\n587\t            round_start_pn: 0,\n588\t            round_count: 0,\n589\t            rounds_since_probe: 0,\n590\t            round_start: false,\n591\t            next_round_delivered: 0,\n592\t            pacing_rate: 0.0,\n593\t            send_quantum: 0,\n594\t            prior_cwnd: 0,\n595\t            pacing_gain: 1.0,\n596\t            next_departure_time: 0,\n597\t            cwnd_gain: 1.0,\n598\t            packet_conservation: false,\n599\t            max_bw: 0,\n600\t            bw_hi: u64::MAX,\n601\t            bw_lo: u64::MAX,\n602\t            bw: 0,\n603\t            min_rtt: u64::MAX,\n604\t            bdp: 0,\n605\t            extra_acked: 0,\n606\t            offload_budget: 0,\n607\t            max_inflight: 0,\n608\t            inflight_hi: u64::MAX,\n609\t            inflight_lo: u64::MAX,\n610\t            bw_latest: 0,\n611\t            inflight_latest: 0,\n612\t            max_bw_filter: [0; 2],\n613\t            cycle_count: 0,\n614\t            extra_acked_interval_start: 0,\n615\t            extra_acked_delivered: 0,\n616\t            extra_acked_filter: [0; 10],\n617\t            filled_pipe: false,\n618\t            full_bw: 0,\n619\t            full_bw_count: 0,\n620\t            min_rtt_stamp: 0,\n621\t            probe_rtt_min_delay: 0,\n622\t            probe_rtt_min_stamp: 0,\n623\t            probe_rtt_done_stamp: 0,\n624\t            min_rtt_margin: 0,\n625\t            probe_rtt_expired: false,\n626\t            probe_rtt_round_done: false,\n627\t            idle_restart: false,\n628\t            path_is_app_limited: false,\n629\t            probe_probe_bw_quickly: false,\n630\t            bw_probe_wait: 0,\n631\t            bw_probe_ceiling: 0,\n632\t            cycle_stamp: 0,\n633\t            rounds_since_bw_probe: 0,\n634\t            bw_probe_up_cnt: 0,\n635\t            bw_probe_up_rounds: 0,\n636\t            bw_probe_samples: 0,\n637\t            bw_probe_up_acks: 0,\n638\t            ack_phase: BbrAckPhase::default(),\n639\t            loss_in_round: false,\n640\t            loss_round_start: false,\n641\t            loss_round_delivered: 0,\n642\t            is_in_recovery: false,\n643\t            is_pto_recovery: false,\n644\t            recovery_packet_number: 0,\n645\t            recovery_delivered: 0,\n646\t            is_handling_lost_feedback: false,\n647\t            cwin_before_lost_feedback: 0,\n648\t            app_limited_round_count: 0,\n649\t            app_limited_this_round: 0,\n650\t            ecn_ect1_last_round: 0,\n651\t            ecn_ce_last_round: 0,\n652\t            ecn_alpha: 0.0,\n653\t            random_context: 0,\n654\t            rtt_filter: MinMaxRtt::default(),\n655\t            bdp_seed: 0,\n656\t            probe_bdp_seed: false,\n657\t            option_string: None,\n658\t            wifi_shadow_rtt: 0,\n659\t            quantum_ratio: 0.001,\n660\t            exp_flags: BbrExp::default(),\n661\t        }\n662\t    }\n663\t\n664\t    #[test]\n665\t    fn bound_bw_for_model_clamps_to_lo() {\n666\t        let mut s = make_state();\n667\t        s.max_bw = 1000;\n668\t        s.bw_lo = 800;\n669\t        s.bw_hi = 0; // not yet initialised → ignored\n670\t        s.bound_bw_for_model();\n671\t        assert_eq!(s.bw, 800);\n672\t    }\n673\t\n674\t    #[test]\n675\t    fn bound_bw_for_model_clamps_to_hi() {\n676\t        let mut s = make_state();\n677\t        s.max_bw = 1000;\n678\t        s.bw_lo = u64::MAX;\n679\t        s.bw_hi = 900;\n680\t        s.bound_bw_for_model();\n681\t        assert_eq!(s.bw, 900);\n682\t    }\n683\t\n684\t    #[test]\n685\t    fn bdp_multiple_with_bw_no_rtt_sample() {\n686\t        let mut s = make_state();\n687\t        s.min_rtt = u64::MAX;\n688\t        // Need a Path-like shape; use a zero send_mtu to simplify.\n689\t        // A real Path cannot be constructed in a unit test without the full\n690\t        // internal machinery, so we only verify the guard path indirectly via\n691\t        // the public interface.  The guard returns CWIN_INITIAL * send_mtu;\n692\t        // with send_mtu = 0 we get 0.\n693\t        // (Full integration coverage comes from the cargo test suite.)\n694\t        let _ = s.min_rtt; // use s so the compiler is happy\n695\t    }\n696\t\n697\t    #[test]\n698\t    fn advance_latest_delivery_signals_round_start() {\n699\t        let mut s = make_state();\n700\t        s.loss_round_start = true;\n701\t        s.bw_latest = 0;\n702\t        s.inflight_latest = 0;\n703\t        let rs = BbrPerAckState {\n704\t            delivery_rate: 500,\n705\t            delivered: 1200,\n706\t            ..BbrPerAckState::default()\n707\t        };\n708\t        s.advance_latest_delivery_signals(&rs);\n709\t        assert_eq!(s.bw_latest, 500);\n710\t        assert_eq!(s.inflight_latest, 1200);\n711\t    }\n712\t\n713\t    #[test]\n714\t    fn advance_latest_delivery_signals_no_round_start() {\n715\t        let mut s = make_state();\n716\t        s.loss_round_start = false;\n717\t        s.bw_latest = 42;\n718\t        s.inflight_latest = 99;\n719\t        let rs = BbrPerAckState {\n720\t            delivery_rate: 500,\n721\t            delivered: 1200,\n722\t            ..BbrPerAckState::default()\n723\t        };\n724\t        s.advance_latest_delivery_signals(&rs);\n725\t        // Not a round start: values must be unchanged.\n726\t        assert_eq!(s.bw_latest, 42);\n727\t        assert_eq!(s.inflight_latest, 99);\n728\t    }\n729\t\n730\t    // enter_probe_rtt and enter_drain write only to Path and BbrState fields;\n731\t    // constructing a full Path in unit tests requires heavy internal machinery,\n732\t    // so those functions are covered by the cargo compilation gate (--no-run)\n733\t    // and by higher-level integration tests.\n734\t\n735\t    #[test]\n736\t    fn check_startup_full_bandwidth_generic_growing() {\n737\t        let mut s = make_state();\n738\t        s.round_start = true;\n739\t        s.full_bw = 1000;\n740\t        s.max_bw = 1300; // >= threshold(1.25) * 1000 = 1250 → still growing\n741\t        let rs = BbrPerAckState::default();\n742\t        s.check_startup_full_bandwidth_generic(&rs, 1.25);\n743\t        assert_eq!(s.full_bw, 1300);\n744\t        assert_eq!(s.full_bw_count, 0);\n745\t        assert!(!s.filled_pipe);\n746\t    }\n747\t\n748\t    #[test]\n749\t    fn check_startup_full_bandwidth_generic_fills_after_3_rounds() {\n750\t        let mut s = make_state();\n751\t        s.round_start = true;\n752\t        s.full_bw = 1000;\n753\t        s.max_bw = 900; // < 1.25 * 1000 → not growing\n754\t        let rs = BbrPerAckState::default();\n755\t        s.check_startup_full_bandwidth_generic(&rs, 1.25);\n756\t        assert_eq!(s.full_bw_count, 1);\n757\t        assert!(!s.filled_pipe);\n758\t        s.check_startup_full_bandwidth_generic(&rs, 1.25);\n759\t        assert_eq!(s.full_bw_count, 2);\n760\t        s.check_startup_full_bandwidth_generic(&rs, 1.25);\n761\t        assert_eq!(s.full_bw_count, 3);\n762\t        assert!(s.filled_pipe);\n763\t    }\n764\t\n765\t    #[test]\n766\t    fn check_startup_full_bandwidth_skips_when_app_limited() {\n767\t        let mut s = make_state();\n768\t        s.round_start = true;\n769\t        s.full_bw = 1000;\n770\t        s.max_bw = 900;\n771\t        let rs = BbrPerAckState {\n772\t            is_app_limited: true,\n773\t            ..BbrPerAckState::default()\n774\t        };\n775\t        s.check_startup_full_bandwidth(&rs);\n776\t        assert_eq!(s.full_bw_count, 0); // skipped\n777\t    }\n778\t\n779\t    #[test]\n780\t    fn check_startup_full_bandwidth_ecn_triggers_fill() {\n781\t        let mut s = make_state();\n782\t        s.round_start = true;\n783\t        s.full_bw = 1000;\n784\t        s.max_bw = 900;\n785\t        // ecn_frac >= 0.2 should trigger filled_pipe even on first stall\n786\t        let rs = BbrPerAckState {\n787\t            ecn_frac: 0.3,\n788\t            ..BbrPerAckState::default()\n789\t        };\n790\t        s.check_startup_full_bandwidth(&rs);\n791\t        assert!(s.filled_pipe);\n792\t    }\n793\t\n794\t    #[test]\n795\t    fn check_app_limited_ended_accumulates_and_detects() {\n796\t        let mut s = make_state();\n797\t        // Simulate 4 app-limited rounds (> threshold of 3).\n798\t        for _ in 0..4 {\n799\t            s.round_start = true;\n800\t            s.app_limited_this_round = 1;\n801\t            let rs = BbrPerAckState::default();\n802\t            let ended = s.check_app_limited_ended(&rs);\n803\t            assert!(!ended);\n804\t        }\n805\t        // Now a non-app-limited round at round_start should return true.\n806\t        s.round_start = true;\n807\t        s.app_limited_this_round = 0;\n808\t        let rs = BbrPerAckState::default();\n809\t        let ended = s.check_app_limited_ended(&rs);\n810\t        assert!(ended);\n811\t        assert_eq!(s.app_limited_round_count, 0);\n812\t    }\n813\t\n814\t    #[test]\n815\t    fn check_app_limited_ended_mid_round_accumulates_flag() {\n816\t        let mut s = make_state();\n817\t        s.round_start = false;\n818\t        s.app_limited_this_round = 0;\n819\t        let rs = BbrPerAckState {\n820\t            is_app_limited: true,\n821\t            ..BbrPerAckState::default()\n822\t        };\n823\t        let ended = s.check_app_limited_ended(&rs);\n824\t        assert!(!ended);\n825\t        assert_eq!(s.app_limited_this_round, 1);\n826\t    }\n827\t\n828\t    #[test]\n829\t    fn has_elapsed_in_phase_true_when_past_deadline() {\n830\t        let s = make_state(); // cycle_stamp = 0\n831\t        assert!(s.has_elapsed_in_phase(100, 101));\n832\t    }\n833\t\n834\t    #[test]\n835\t    fn has_elapsed_in_phase_false_when_at_deadline() {\n836\t        let s = make_state(); // cycle_stamp = 0\n837\t        assert!(!s.has_elapsed_in_phase(100, 100)); // current_time must be strictly >\n838\t    }\n839\t\n840\t    #[test]\n841\t    fn has_elapsed_in_phase_respects_cycle_stamp() {\n842\t        let mut s = make_state();\n843\t        s.cycle_stamp = 500;\n844\t        assert!(!s.has_elapsed_in_phase(100, 599));\n845\t        assert!(s.has_elapsed_in_phase(100, 601));\n846\t    }\n847\t\n848\t    #[test]\n849\t    fn exit_lost_feedback_restores_cwin_and_clears_flag() {\n850\t        // exit_lost_feedback requires Path, so we only test the BbrState\n851\t        // side-effect that is path-independent: when the flag is already\n852\t        // clear the function must be a no-op (no panic).\n853\t        let mut s = make_state();\n854\t        s.is_handling_lost_feedback = false;\n855\t        s.cwin_before_lost_feedback = 9999;\n856\t        // We cannot call exit_lost_feedback here without a Path, but we can\n857\t        // verify the guard: the function reads `is_handling_lost_feedback`\n858\t        // first.  Full coverage comes from the integration tests.\n859\t        let _ = s.cwin_before_lost_feedback; // used\n860\t    }\n861\t\n862\t    #[test]\n863\t    fn enter_startup_resume_sets_state_and_gains() {\n864\t        let mut s = make_state();\n865\t        s.enter_startup_resume();\n866\t        assert_eq!(s.state, BbrAlgState::StartupResume);\n867\t        assert!((s.pacing_gain - BBR_STARTUP_RESUME_PACING_GAIN).abs() < f64::EPSILON);\n868\t        assert!((s.cwnd_gain - BBR_STARTUP_RESUME_CWND_GAIN).abs() < f64::EPSILON);\n869\t    }\n870\t\n871\t    // enter_startup and enter_startup_long_rtt mutate Path fields\n872\t    // (is_cca_probing_up, cwin); constructing a full Path requires\n873\t    // the heavy internal machinery.  Those are covered by the cargo\n874\t    // compilation gate and integration tests.\n875\t}\n876\t"}]},"parent_tool_use_id":null,"session_id":"5ddefae6-f153-4d96-b056-bf697eabbe22","uuid":"f27194e1-f3ce-46e1-962b-ab29fb3f9200","timestamp":"2026-05-07T04:54:54.975Z","tool_use_result":{"type":"text","file":{"filePath":"/Users/richbarn/Projects/picoquic/rs/fq/src/bbr.rs","content":"//! Translation of `picoquic/bbr.c` — BBRv3 congestion control.\n//!\n//! Phase 4: private helper batch (BBRAccessEcnPacketContext,\n//! BBRAdaptMinRttMargin, BBRAdvanceLatestDeliverySignals,\n//! BBRBDPMultipleWithBw, BBRBoundBWForModel, BBREnterStartup,\n//! BBREnterStartupLongRTT, BBREnterStartupResume,\n//! BBRExitLostFeedback, BBRHasElapsedInPhase).\n\nuse crate::PacketContext;\nuse crate::cc_common::MinMaxRtt;\nuse crate::internal::{\n    CWIN_INITIAL, Connection, INITIAL_RTT, PacketContextState, Path, TARGET_RENO_RTT,\n    TARGET_SATELLITE_RTT,\n};\n\n// ---------------------------------------------------------------------------\n// Constants from bbr.c `#define`s.\n\nconst BBR_MIN_RTT_MARGIN_PERCENT: u64 = 5;\nconst BBR_APP_LIMITED_ROUNDS_THRESHOLD: i32 = 3; // C: BBRAppLimitedRoundsThreshold\nconst BBR_STARTUP_PACING_GAIN: f64 = 2.77; // C: BBRStartupPacingGain (4·ln 2)\nconst BBR_STARTUP_CWND_GAIN: f64 = 2.0; // C: BBRStartupCwndGain\nconst BBR_STARTUP_RESUME_PACING_GAIN: f64 = 1.25; // C: BBRStartupResumePacingGain\nconst BBR_STARTUP_RESUME_CWND_GAIN: f64 = 1.25; // C: BBRStartupResumeCwndGain\nconst BBR_PROBE_RTT_CWND_GAIN: f64 = 0.5; // C: BBRProbeRTTCwndGain\nconst BBR_EXCESSIVE_ECN_CE: f64 = 0.2; // C: BBRExcessiveEcnCE\nconst BBR_BETA: f64 = 0.7; // C: BBRBeta — multiplicative decrease on loss\n\n// ---------------------------------------------------------------------------\n// Algorithm-state enum.  C: `picoquic_bbr_alg_state_t`.\n\n#[derive(Debug, Copy, Clone, PartialEq, Eq, Default)]\npub enum BbrAlgState {\n    #[default]\n    Startup = 0,\n    Drain,\n    ProbeBwDown,\n    ProbeBwCruise,\n    ProbeBwRefill,\n    ProbeBwUp,\n    ProbeRtt,\n    StartupLongRtt,\n    StartupResume,\n}\n\n// ---------------------------------------------------------------------------\n// ACK-phase enum.  C: `picoquic_bbr_ack_phase_t`.\n\n#[derive(Debug, Copy, Clone, PartialEq, Eq, Default)]\npub enum BbrAckPhase {\n    #[default]\n    ProbeStarting = 0,\n    ProbeStopping,\n    Refilling,\n    ProbeFeedback,\n}\n\n// ---------------------------------------------------------------------------\n// Experimental-flag struct.  C: `bbr_exp` (always enabled via\n// `#define BBRExperiment on`).\n\n#[derive(Debug, Clone, Default)]\npub struct BbrExp {\n    pub do_early_exit: bool,\n    pub do_rapid_start: bool,\n    pub do_handle_suspension: bool,\n    pub do_control_lost: bool,\n    pub do_exit_probe_bw_up_on_delay: bool,\n    pub do_enter_probe_bw_after_limited: bool,\n}\n\n// ---------------------------------------------------------------------------\n// Per-ACK state.  C: `bbr_per_ack_state_t`.\n\n#[derive(Debug, Clone, Default)]\npub struct BbrPerAckState {\n    pub delivered: u64,\n    pub delivery_rate: u64,\n    pub rtt_sample: u64,\n    pub newly_acked: u64,\n    pub newly_lost: u64,\n    pub tx_in_flight: u64,\n    pub lost: u64,\n    pub ecn_ce: u64,\n    pub ecn_frac: f64,\n    pub ecn_alpha: f64,\n    pub is_app_limited: bool,\n    pub is_cwnd_limited: bool,\n}\n\n// ---------------------------------------------------------------------------\n// BBR state.  C: `picoquic_bbr_state_t`.\n//\n// Type deviations from C:\n//   * single-bit `unsigned int x : 1` bitfields → `bool`\n//   * non-negative `int` counters → `u32`\n//   * `char const* option_string` → `Option<String>` (owned copy)\n//   * `picoquic_min_max_rtt_t rtt_filter` → `MinMaxRtt`\n//   * fixed arrays keep their C dimensions as Rust `[T; N]`\n\npub struct BbrState {\n    pub state: BbrAlgState,\n    pub round_start_pn: u64,\n    pub round_count: u32,\n    pub rounds_since_probe: u32,\n    pub round_start: bool,\n    pub next_round_delivered: u64,\n\n    pub pacing_rate: f64,\n    pub send_quantum: u64,\n    pub prior_cwnd: u64,\n\n    pub pacing_gain: f64,\n    pub next_departure_time: u64,\n\n    pub cwnd_gain: f64,\n    pub packet_conservation: bool,\n\n    pub max_bw: u64,\n    pub bw_hi: u64,\n    pub bw_lo: u64,\n    pub bw: u64,\n\n    // min_rtt uses u64::MAX as the sentinel \"no valid sample yet\".\n    pub min_rtt: u64,\n\n    pub bdp: u64,\n    pub extra_acked: u64,\n    pub offload_budget: u64,\n    pub max_inflight: u64,\n    pub inflight_hi: u64,\n    pub inflight_lo: u64,\n\n    pub bw_latest: u64,\n    pub inflight_latest: u64,\n\n    // BBRMaxBwFilterLen = 2\n    pub max_bw_filter: [u64; 2],\n    pub cycle_count: u32,\n\n    pub extra_acked_interval_start: u64,\n    pub extra_acked_delivered: u64,\n    // BBRExtraAckedFilterLen = 10\n    pub extra_acked_filter: [u64; 10],\n\n    pub filled_pipe: bool,\n    pub full_bw: u64,\n    pub full_bw_count: u32,\n\n    pub min_rtt_stamp: u64,\n    pub probe_rtt_min_delay: u64,\n    pub probe_rtt_min_stamp: u64,\n    pub probe_rtt_done_stamp: u64,\n    pub min_rtt_margin: u64,\n    pub probe_rtt_expired: bool,\n    pub probe_rtt_round_done: bool,\n    pub idle_restart: bool,\n    pub path_is_app_limited: bool,\n\n    pub probe_probe_bw_quickly: bool,\n    pub bw_probe_wait: u64,\n    pub bw_probe_ceiling: u64,\n    pub cycle_stamp: u64,\n    pub rounds_since_bw_probe: u32,\n    pub bw_probe_up_cnt: u32,\n    pub bw_probe_up_rounds: u32,\n    pub bw_probe_samples: u32,\n    pub bw_probe_up_acks: u64,\n    pub ack_phase: BbrAckPhase,\n\n    pub loss_in_round: bool,\n    pub loss_round_start: bool,\n    pub loss_round_delivered: u64,\n\n    pub is_in_recovery: bool,\n    pub is_pto_recovery: bool,\n    pub recovery_packet_number: u64,\n    pub recovery_delivered: u64,\n\n    pub is_handling_lost_feedback: bool,\n    pub cwin_before_lost_feedback: u64,\n\n    pub app_limited_round_count: i32,\n    pub app_limited_this_round: i32,\n\n    pub ecn_ect1_last_round: u64,\n    pub ecn_ce_last_round: u64,\n    pub ecn_alpha: f64,\n\n    pub random_context: u64,\n\n    pub rtt_filter: MinMaxRtt,\n    pub bdp_seed: u64,\n    pub probe_bdp_seed: bool,\n\n    pub option_string: Option<String>,\n    pub wifi_shadow_rtt: u64,\n    pub quantum_ratio: f64,\n\n    pub exp_flags: BbrExp,\n}\n\nimpl BbrState {\n    /// C: `BBRAdaptMinRttMargin` (picoquic/bbr.c:1290)\n    ///\n    /// Recompute `min_rtt_margin` as a fixed percentage of `min_rtt`\n    /// plus the transmission time of two MTU-sized packets at `max_bw`.\n    /// The margin prevents the probe-RTT timer from firing too early\n    /// when only a small amount of queuing is present.\n    pub fn adapt_min_rtt_margin(&mut self, path_x: &Path) {\n        let margin = (self.min_rtt * BBR_MIN_RTT_MARGIN_PERCENT) * 100 / 1_000_000;\n        let margin = if self.max_bw > 0 {\n            margin + 2 * path_x.send_mtu as u64 * 1_000_000 / self.max_bw\n        } else {\n            margin\n        };\n        self.min_rtt_margin = margin;\n    }\n\n    /// C: `BBRAdvanceLatestDeliverySignals` (picoquic/bbr.c:1007)\n    ///\n    /// Called near the end of ACK processing: if this ACK completed a\n    /// loss round, reset `bw_latest` and `inflight_latest` to the\n    /// current sample so the next round starts fresh.\n    pub fn advance_latest_delivery_signals(&mut self, rs: &BbrPerAckState) {\n        if self.loss_round_start {\n            self.bw_latest = rs.delivery_rate;\n            self.inflight_latest = rs.delivered;\n        }\n    }\n\n    /// C: `BBRBDPMultipleWithBw` (picoquic/bbr.c:869)\n    ///\n    /// Returns `gain × BDP` computed at the supplied `bw` rather than\n    /// `self.bw`.  When `min_rtt` has never been measured (`u64::MAX`),\n    /// returns the initial congestion window as a safe floor.\n    ///\n    /// Side-effect: writes `self.bdp` so callers can read the raw BDP\n    /// estimate after the call (mirrors C's write-through of\n    /// `bbr_state->bdp`).\n    pub fn bdp_multiple_with_bw(&mut self, path_x: &Path, gain: f64, bw: u64) -> u64 {\n        if self.min_rtt == u64::MAX {\n            return CWIN_INITIAL * path_x.send_mtu as u64;\n        }\n        // PICOQUIC_BYTES_FROM_RATE(min_rtt_us, bps) = min_rtt * bps / 1_000_000\n        self.bdp = self.min_rtt * bw / 1_000_000;\n        (gain * self.bdp as f64) as u64\n    }\n\n    /// C: `BBRBoundBWForModel` (picoquic/bbr.c:1094)\n    ///\n    /// Set `self.bw = min(max_bw, bw_lo, bw_hi)`.  `bw_hi` is only\n    /// applied when non-zero; the zero check preserves compatibility\n    /// with states where `bw_hi` is not yet initialised (noted as a\n    /// TODO in the C source).\n    pub fn bound_bw_for_model(&mut self) {\n        self.bw = self.max_bw;\n        if self.bw > self.bw_lo {\n            self.bw = self.bw_lo;\n        }\n        // TODO: remove the bw_hi != 0 guard once variables are properly\n        // initialised (mirrors the C-side TODO at bbr.c:1100).\n        if self.bw > self.bw_hi && self.bw_hi != 0 {\n            self.bw = self.bw_hi;\n        }\n    }\n\n    /// C: `BBREnterProbeRTT` (picoquic/bbr.c:1487)\n    pub fn enter_probe_rtt(&mut self, path_x: &mut Path) {\n        self.state = BbrAlgState::ProbeRtt;\n        self.pacing_gain = 1.0;\n        self.cwnd_gain = BBR_PROBE_RTT_CWND_GAIN;\n        path_x.is_cca_probing_up = false;\n    }\n\n    /// C: `BBREnterDrain` (picoquic/bbr.c:1933)\n    pub fn enter_drain(&mut self, path_x: &mut Path) {\n        // Picoquic-specific: notify transport that the startup phase is complete.\n        path_x.is_ssthresh_initialized = true;\n        self.state = BbrAlgState::Drain;\n        self.pacing_gain = 1.0 / BBR_STARTUP_CWND_GAIN; // pace slowly\n        self.cwnd_gain = BBR_STARTUP_CWND_GAIN; // maintain cwnd\n        path_x.is_cca_probing_up = false;\n    }\n\n    /// C: `BBRCheckStartupFullBandwidthGeneric` (picoquic/bbr.c:1952)\n    pub fn check_startup_full_bandwidth_generic(&mut self, rs: &BbrPerAckState, threshold: f64) {\n        if self.filled_pipe || !self.round_start || rs.is_app_limited {\n            return;\n        }\n        if self.max_bw as f64 >= threshold * self.full_bw as f64 {\n            // still growing\n            self.full_bw = self.max_bw;\n            self.full_bw_count = 0;\n            return;\n        }\n        self.full_bw_count += 1; // another round without much growth\n        if self.full_bw_count >= 3 {\n            self.filled_pipe = true;\n        }\n    }\n\n    /// C: `BBRCheckStartupFullBandwidth` (picoquic/bbr.c:2020)\n    pub fn check_startup_full_bandwidth(&mut self, rs: &BbrPerAckState) {\n        if self.filled_pipe || !self.round_start || rs.is_app_limited {\n            return;\n        }\n        // 5/4 integer approximation of ×1.25 avoids floating-point drift.\n        if 4 * self.max_bw >= 5 * self.full_bw {\n            // still growing\n            self.full_bw = self.max_bw;\n            self.full_bw_count = 0;\n            if rs.ecn_frac < 0.2 {\n                return;\n            }\n        }\n        self.full_bw_count += 1; // another round without much growth\n        if self.full_bw_count >= 3 || rs.ecn_frac >= BBR_EXCESSIVE_ECN_CE {\n            self.filled_pipe = true;\n        }\n    }\n\n    /// C: `BBRCheckAppLimitedEnded` (picoquic/bbr.c:1747)\n    ///\n    /// Tracks per-round app-limited state.  Returns `true` on the first\n    /// round where the app is *not* limited after having been limited for\n    /// more than `BBR_APP_LIMITED_ROUNDS_THRESHOLD` consecutive rounds.\n    pub fn check_app_limited_ended(&mut self, rs: &BbrPerAckState) -> bool {\n        let mut app_limited_ended = false;\n        if self.round_start {\n            if self.app_limited_this_round != 0 {\n                self.app_limited_round_count += 1;\n            } else {\n                app_limited_ended = self.app_limited_round_count > BBR_APP_LIMITED_ROUNDS_THRESHOLD;\n                self.app_limited_round_count = 0;\n            }\n            self.app_limited_this_round = 0;\n        } else {\n            self.app_limited_this_round |= rs.is_app_limited as i32;\n        }\n        app_limited_ended\n    }\n\n    /// C: `BBRExitLostFeedback` (picoquic/bbr.c:782)\n    ///\n    /// Restore the congestion window saved by `BBREnterLostFeedback` and\n    /// clear the lost-feedback flag.  No-op if the flag is not set.\n    pub fn exit_lost_feedback(&mut self, path_x: &mut Path) {\n        if self.is_handling_lost_feedback {\n            path_x.cwin = self.cwin_before_lost_feedback;\n            self.is_handling_lost_feedback = false;\n        }\n    }\n\n    /// C: `BBRHasElapsedInPhase` (picoquic/bbr.c:1776)\n    ///\n    /// Returns `true` when `current_time` has advanced past\n    /// `cycle_stamp + interval`.  Used to decide when to transition from\n    /// DOWN/CRUISE to REFILL in the probe-BW cycle.\n    pub(crate) fn has_elapsed_in_phase(&self, interval: u64, current_time: u64) -> bool {\n        current_time > self.cycle_stamp + interval\n    }\n\n    /// C: `BBREnterStartupResume` (picoquic/bbr.c:1972)\n    ///\n    /// Enter `StartupResume` state, which uses Hystart-like pacing gains\n    /// to resume quickly after a suspension.  Called either when a BDP\n    /// seed is set or on the initial `EnterStartup` path when a seed\n    /// exists.\n    pub(crate) fn enter_startup_resume(&mut self) {\n        self.state = BbrAlgState::StartupResume;\n        self.pacing_gain = BBR_STARTUP_RESUME_PACING_GAIN;\n        self.cwnd_gain = BBR_STARTUP_RESUME_CWND_GAIN;\n    }\n\n    /// C: `BBREnterStartup` (picoquic/bbr.c:2061)\n    ///\n    /// Enter normal `Startup` state with the standard pacing and cwnd\n    /// gains.  Sets `is_cca_probing_up` to inform the transport that the\n    /// congestion controller is actively probing for more bandwidth.\n    pub fn enter_startup(&mut self, path_x: &mut Path) {\n        self.state = BbrAlgState::Startup;\n        self.pacing_gain = BBR_STARTUP_PACING_GAIN;\n        self.cwnd_gain = BBR_STARTUP_CWND_GAIN;\n        path_x.is_cca_probing_up = true;\n    }\n\n    /// C: `BBREnterStartupLongRTT` (picoquic/bbr.c:2080)\n    ///\n    /// Enter `StartupLongRTT` state, which uses Hystart rather than the\n    /// normal BBR Startup algorithm.  The initial congestion window is\n    /// scaled up from `CWIN_INITIAL` proportional to `rtt_min` (capped at\n    /// the satellite-RTT ceiling) and then further boosted by the BDP seed\n    /// when available.\n    pub fn enter_startup_long_rtt(&mut self, path_x: &mut Path) {\n        let mut cwnd = CWIN_INITIAL;\n        self.state = BbrAlgState::StartupLongRtt;\n        if path_x.rtt_min > TARGET_RENO_RTT {\n            let rtt_cap = if path_x.rtt_min > TARGET_SATELLITE_RTT {\n                TARGET_SATELLITE_RTT\n            } else {\n                path_x.rtt_min\n            };\n            cwnd = (cwnd as f64 * rtt_cap.ticks() as f64 / TARGET_RENO_RTT.ticks() as f64) as u64;\n        }\n        if cwnd < self.bdp_seed {\n            cwnd = self.bdp_seed;\n        }\n        if cwnd > path_x.cwin {\n            path_x.cwin = cwnd;\n        }\n        path_x.is_cca_probing_up = true;\n    }\n\n    /// C: `BBRInitFullPipe` (picoquic/bbr.c:434)\n    ///\n    /// Reset the \"pipe full\" bandwidth-growth detector to its initial state.\n    pub fn init_full_pipe(&mut self) {\n        self.filled_pipe = false;\n        self.full_bw = 0;\n        self.full_bw_count = 0;\n    }\n\n    /// C: `BBRInitLowerBounds` (picoquic/bbr.c:1025)\n    ///\n    /// On the first congestion episode in a cycle, latch `bw_lo` to\n    /// `max_bw` and `inflight_lo` to `cwin` (the UINT64_MAX sentinel\n    /// means \"not yet initialised\").\n    pub fn init_lower_bounds(&mut self, path_x: &Path) {\n        if self.bw_lo == u64::MAX {\n            self.bw_lo = self.max_bw;\n        }\n        if self.inflight_lo == u64::MAX {\n            self.inflight_lo = path_x.cwin;\n        }\n    }\n\n    /// C: `BBRInitPacingRate` (picoquic/bbr.c:933)\n    ///\n    /// Set the initial pacing rate based on the nominal bandwidth at\n    /// `INITIAL_RTT` (250 ms), unless the path already has a real RTT\n    /// estimate, in which case that estimate is used instead.\n    pub fn init_pacing_rate(&mut self, path_x: &Path) {\n        let initial_rtt = if path_x.smoothed_rtt != INITIAL_RTT || path_x.rtt_variant.ticks() != 0 {\n            path_x.smoothed_rtt.ticks()\n        } else {\n            INITIAL_RTT.ticks()\n        };\n        let nominal_bandwidth = (1_000_000u64 * CWIN_INITIAL) as f64 / initial_rtt as f64;\n        self.pacing_rate = BBR_STARTUP_PACING_GAIN * nominal_bandwidth;\n    }\n\n    /// C: `BBRInitRandom` (picoquic/bbr.c:421)\n    ///\n    /// Seed `random_context` from the current time, connection role, and\n    /// path ID so that tests remain deterministic while production runs\n    /// diverge.  `connection` is passed separately because `Path` carries\n    /// no back-pointer to its owning `Connection` in Rust.\n    pub fn init_random(&mut self, connection: &Connection, path_x: &Path, current_time: u64) {\n        let mut ctx: u64 = 0xfedcba9876543210;\n        ctx ^= current_time;\n        if connection.client_mode {\n            ctx = ctx.wrapping_add(0x0123456789abcdef);\n        }\n        if path_x.unique_path_id > 0 && path_x.unique_path_id != u64::MAX {\n            ctx = ctx.wrapping_mul(path_x.unique_path_id.wrapping_add(1));\n        }\n        self.random_context = ctx;\n    }\n\n    /// C: `BBRInflightWithHeadroom` (picoquic/bbr.c:1547)\n    ///\n    /// Returns the inflight limit that leaves `BBRHeadroom` (15%) of the\n    /// bottleneck buffer free for competing flows.  Returns `u64::MAX`\n    /// when `inflight_hi` has not yet been measured.\n    pub fn inflight_with_headroom(&self, path_x: &Path) -> u64 {\n        const BBR_HEADROOM: f64 = 0.15;\n        const BBR_MIN_PIPE_CWND: u64 = 4;\n        if self.inflight_hi == u64::MAX {\n            return u64::MAX;\n        }\n        let headroom = ((1.0 - BBR_HEADROOM) * self.inflight_hi as f64) as u64;\n        headroom.max(BBR_MIN_PIPE_CWND * path_x.send_mtu as u64)\n    }\n\n    /// C: `BBRIsProbingBW` (picoquic/bbr.c:1532)\n    ///\n    /// Returns `true` when the state is actively probing for more bandwidth\n    /// (i.e. NOT in one of the non-probing states: ProbeBwDown, ProbeBwCruise,\n    /// Drain, or ProbeRtt).\n    pub fn is_probing_bw(&self) -> bool {\n        !matches!(\n            self.state,\n            BbrAlgState::ProbeBwDown\n                | BbrAlgState::ProbeBwCruise\n                | BbrAlgState::Drain\n                | BbrAlgState::ProbeRtt\n        )\n    }\n\n    /// C: `BBRLossLowerBounds` (picoquic/bbr.c:1035)\n    ///\n    /// Apply a `BBRBeta` (0.7) multiplicative decrease to `bw_lo` and\n    /// `inflight_lo`, then floor each at the latest sample so the model\n    /// cannot shrink below what was actually observed this round.\n    pub fn loss_lower_bounds(&mut self) {\n        self.bw_lo = ((BBR_BETA * self.bw_lo as f64) as u64).max(self.bw_latest);\n        self.inflight_lo = ((BBR_BETA * self.inflight_lo as f64) as u64).max(self.inflight_latest);\n    }\n\n    /// C: `BBRModulateCwndForRecovery` (picoquic/bbr.c:627)\n    ///\n    /// On packet loss, shrink `cwin` by the number of bytes lost (floored at\n    /// one MTU).  When `packet_conservation` is active, ensure `cwin` is at\n    /// least `bytes_in_transit + newly_acked` so the pipe stays full.\n    pub fn modulate_cwnd_for_recovery(&self, path_x: &mut Path, rs: &BbrPerAckState) {\n        if rs.newly_lost > 0 {\n            if path_x.cwin > rs.newly_lost + path_x.send_mtu as u64 {\n                path_x.cwin -= rs.newly_lost;\n            } else {\n                path_x.cwin = path_x.send_mtu as u64;\n            }\n        }\n        if self.packet_conservation && path_x.cwin < path_x.bytes_in_transit + rs.newly_acked {\n            path_x.cwin = path_x.bytes_in_transit + rs.newly_acked;\n        }\n    }\n\n    /// C: `BBRRaiseInflightHiSlope` (picoquic/bbr.c:1561)\n    ///\n    /// Recompute how aggressively `inflight_hi` is raised during ProbeBwUp.\n    /// Each round the slope doubles (shift by `bw_probe_up_rounds`, capped at\n    /// 30), and `bw_probe_up_cnt` is set to the number of MTU-sized ACKs\n    /// required to justify a one-MTU increase (minimum 1).\n    pub fn raise_inflight_hi_slope(&mut self, path_x: &Path) {\n        let growth_this_round = (path_x.send_mtu as u64) << self.bw_probe_up_rounds;\n        self.bw_probe_up_rounds = (self.bw_probe_up_rounds + 1).min(30);\n        let up_cnt = (path_x.cwin / growth_this_round) as u32;\n        self.bw_probe_up_cnt = up_cnt.max(1);\n    }\n\n    /// C: `BBRResetCongestionSignals` (picoquic/bbr.c:1014)\n    ///\n    /// Clear the per-round congestion signals so the next round starts with\n    /// a clean slate.  Called at the start of each new round.\n    pub fn reset_congestion_signals(&mut self) {\n        self.loss_in_round = false;\n        self.bw_latest = 0;\n        self.inflight_latest = 0;\n    }\n}\n\n/// C: `BBRAccessEcnPacketContext` (picoquic/bbr.c:2245)\n///\n/// Return the packet-context that carries ECN counts for `path_x`.\n///\n/// Under multipath each path has its own context; under single-path\n/// only the default path (`unique_path_id == 0`, corresponding to\n/// `cnx->path[0]` in C) participates in ECN tracking — other paths\n/// return `None`.\n///\n/// Note: in C the path held a back-pointer to its connection\n/// (`path_x->cnx`); in Rust there is no back-pointer, so the caller\n/// must supply both `connection` and `path_x`.\npub fn access_ecn_packet_context<'a>(\n    connection: &'a Connection,\n    path_x: &'a Path,\n) -> Option<&'a PacketContextState> {\n    if connection.is_multipath_enabled {\n        Some(&path_x.pkt_ctx)\n    } else if path_x.unique_path_id != 0 {\n        // Non-default path in single-path mode: ECN counts are not\n        // tracked per-path here; the caller should use the default path.\n        None\n    } else {\n        Some(&connection.pkt_ctx[PacketContext::Application as usize])\n    }\n}\n\n#[cfg(test)]\nmod tests {\n    use super::*;\n\n    fn make_state() -> BbrState {\n        BbrState {\n            state: BbrAlgState::default(),\n            round_start_pn: 0,\n            round_count: 0,\n            rounds_since_probe: 0,\n            round_start: false,\n            next_round_delivered: 0,\n            pacing_rate: 0.0,\n            send_quantum: 0,\n            prior_cwnd: 0,\n            pacing_gain: 1.0,\n            next_departure_time: 0,\n            cwnd_gain: 1.0,\n            packet_conservation: false,\n            max_bw: 0,\n            bw_hi: u64::MAX,\n            bw_lo: u64::MAX,\n            bw: 0,\n            min_rtt: u64::MAX,\n            bdp: 0,\n            extra_acked: 0,\n            offload_budget: 0,\n            max_inflight: 0,\n            inflight_hi: u64::MAX,\n            inflight_lo: u64::MAX,\n            bw_latest: 0,\n            inflight_latest: 0,\n            max_bw_filter: [0; 2],\n            cycle_count: 0,\n            extra_acked_interval_start: 0,\n            extra_acked_delivered: 0,\n            extra_acked_filter: [0; 10],\n            filled_pipe: false,\n            full_bw: 0,\n            full_bw_count: 0,\n            min_rtt_stamp: 0,\n            probe_rtt_min_delay: 0,\n            probe_rtt_min_stamp: 0,\n            probe_rtt_done_stamp: 0,\n            min_rtt_margin: 0,\n            probe_rtt_expired: false,\n            probe_rtt_round_done: false,\n            idle_restart: false,\n            path_is_app_limited: false,\n            probe_probe_bw_quickly: false,\n            bw_probe_wait: 0,\n            bw_probe_ceiling: 0,\n            cycle_stamp: 0,\n            rounds_since_bw_probe: 0,\n            bw_probe_up_cnt: 0,\n            bw_probe_up_rounds: 0,\n            bw_probe_samples: 0,\n            bw_probe_up_acks: 0,\n            ack_phase: BbrAckPhase::default(),\n            loss_in_round: false,\n            loss_round_start: false,\n            loss_round_delivered: 0,\n            is_in_recovery: false,\n            is_pto_recovery: false,\n            recovery_packet_number: 0,\n            recovery_delivered: 0,\n            is_handling_lost_feedback: false,\n            cwin_before_lost_feedback: 0,\n            app_limited_round_count: 0,\n            app_limited_this_round: 0,\n            ecn_ect1_last_round: 0,\n            ecn_ce_last_round: 0,\n            ecn_alpha: 0.0,\n            random_context: 0,\n            rtt_filter: MinMaxRtt::default(),\n            bdp_seed: 0,\n            probe_bdp_seed: false,\n            option_string: None,\n            wifi_shadow_rtt: 0,\n            quantum_ratio: 0.001,\n            exp_flags: BbrExp::default(),\n        }\n    }\n\n    #[test]\n    fn bound_bw_for_model_clamps_to_lo() {\n        let mut s = make_state();\n        s.max_bw = 1000;\n        s.bw_lo = 800;\n        s.bw_hi = 0; // not yet initialised → ignored\n        s.bound_bw_for_model();\n        assert_eq!(s.bw, 800);\n    }\n\n    #[test]\n    fn bound_bw_for_model_clamps_to_hi() {\n        let mut s = make_state();\n        s.max_bw = 1000;\n        s.bw_lo = u64::MAX;\n        s.bw_hi = 900;\n        s.bound_bw_for_model();\n        assert_eq!(s.bw, 900);\n    }\n\n    #[test]\n    fn bdp_multiple_with_bw_no_rtt_sample() {\n        let mut s = make_state();\n        s.min_rtt = u64::MAX;\n        // Need a Path-like shape; use a zero send_mtu to simplify.\n        // A real Path cannot be constructed in a unit test without the full\n        // internal machinery, so we only verify the guard path indirectly via\n        // the public interface.  The guard returns CWIN_INITIAL * send_mtu;\n        // with send_mtu = 0 we get 0.\n        // (Full integration coverage comes from the cargo test suite.)\n        let _ = s.min_rtt; // use s so the compiler is happy\n    }\n\n    #[test]\n    fn advance_latest_delivery_signals_round_start() {\n        let mut s = make_state();\n        s.loss_round_start = true;\n        s.bw_latest = 0;\n        s.inflight_latest = 0;\n        let rs = BbrPerAckState {\n            delivery_rate: 500,\n            delivered: 1200,\n            ..BbrPerAckState::default()\n        };\n        s.advance_latest_delivery_signals(&rs);\n        assert_eq!(s.bw_latest, 500);\n        assert_eq!(s.inflight_latest, 1200);\n    }\n\n    #[test]\n    fn advance_latest_delivery_signals_no_round_start() {\n        let mut s = make_state();\n        s.loss_round_start = false;\n        s.bw_latest = 42;\n        s.inflight_latest = 99;\n        let rs = BbrPerAckState {\n            delivery_rate: 500,\n            delivered: 1200,\n            ..BbrPerAckState::default()\n        };\n        s.advance_latest_delivery_signals(&rs);\n        // Not a round start: values must be unchanged.\n        assert_eq!(s.bw_latest, 42);\n        assert_eq!(s.inflight_latest, 99);\n    }\n\n    // enter_probe_rtt and enter_drain write only to Path and BbrState fields;\n    // constructing a full Path in unit tests requires heavy internal machinery,\n    // so those functions are covered by the cargo compilation gate (--no-run)\n    // and by higher-level integration tests.\n\n    #[test]\n    fn check_startup_full_bandwidth_generic_growing() {\n        let mut s = make_state();\n        s.round_start = true;\n        s.full_bw = 1000;\n        s.max_bw = 1300; // >= threshold(1.25) * 1000 = 1250 → still growing\n        let rs = BbrPerAckState::default();\n        s.check_startup_full_bandwidth_generic(&rs, 1.25);\n        assert_eq!(s.full_bw, 1300);\n        assert_eq!(s.full_bw_count, 0);\n        assert!(!s.filled_pipe);\n    }\n\n    #[test]\n    fn check_startup_full_bandwidth_generic_fills_after_3_rounds() {\n        let mut s = make_state();\n        s.round_start = true;\n        s.full_bw = 1000;\n        s.max_bw = 900; // < 1.25 * 1000 → not growing\n        let rs = BbrPerAckState::default();\n        s.check_startup_full_bandwidth_generic(&rs, 1.25);\n        assert_eq!(s.full_bw_count, 1);\n        assert!(!s.filled_pipe);\n        s.check_startup_full_bandwidth_generic(&rs, 1.25);\n        assert_eq!(s.full_bw_count, 2);\n        s.check_startup_full_bandwidth_generic(&rs, 1.25);\n        assert_eq!(s.full_bw_count, 3);\n        assert!(s.filled_pipe);\n    }\n\n    #[test]\n    fn check_startup_full_bandwidth_skips_when_app_limited() {\n        let mut s = make_state();\n        s.round_start = true;\n        s.full_bw = 1000;\n        s.max_bw = 900;\n        let rs = BbrPerAckState {\n            is_app_limited: true,\n            ..BbrPerAckState::default()\n        };\n        s.check_startup_full_bandwidth(&rs);\n        assert_eq!(s.full_bw_count, 0); // skipped\n    }\n\n    #[test]\n    fn check_startup_full_bandwidth_ecn_triggers_fill() {\n        let mut s = make_state();\n        s.round_start = true;\n        s.full_bw = 1000;\n        s.max_bw = 900;\n        // ecn_frac >= 0.2 should trigger filled_pipe even on first stall\n        let rs = BbrPerAckState {\n            ecn_frac: 0.3,\n            ..BbrPerAckState::default()\n        };\n        s.check_startup_full_bandwidth(&rs);\n        assert!(s.filled_pipe);\n    }\n\n    #[test]\n    fn check_app_limited_ended_accumulates_and_detects() {\n        let mut s = make_state();\n        // Simulate 4 app-limited rounds (> threshold of 3).\n        for _ in 0..4 {\n            s.round_start = true;\n            s.app_limited_this_round = 1;\n            let rs = BbrPerAckState::default();\n            let ended = s.check_app_limited_ended(&rs);\n            assert!(!ended);\n        }\n        // Now a non-app-limited round at round_start should return true.\n        s.round_start = true;\n        s.app_limited_this_round = 0;\n        let rs = BbrPerAckState::default();\n        let ended = s.check_app_limited_ended(&rs);\n        assert!(ended);\n        assert_eq!(s.app_limited_round_count, 0);\n    }\n\n    #[test]\n    fn check_app_limited_ended_mid_round_accumulates_flag() {\n        let mut s = make_state();\n        s.round_start = false;\n        s.app_limited_this_round = 0;\n        let rs = BbrPerAckState {\n            is_app_limited: true,\n            ..BbrPerAckState::default()\n        };\n        let ended = s.check_app_limited_ended(&rs);\n        assert!(!ended);\n        assert_eq!(s.app_limited_this_round, 1);\n    }\n\n    #[test]\n    fn has_elapsed_in_phase_true_when_past_deadline() {\n        let s = make_state(); // cycle_stamp = 0\n        assert!(s.has_elapsed_in_phase(100, 101));\n    }\n\n    #[test]\n    fn has_elapsed_in_phase_false_when_at_deadline() {\n        let s = make_state(); // cycle_stamp = 0\n        assert!(!s.has_elapsed_in_phase(100, 100)); // current_time must be strictly >\n    }\n\n    #[test]\n    fn has_elapsed_in_phase_respects_cycle_stamp() {\n        let mut s = make_state();\n        s.cycle_stamp = 500;\n        assert!(!s.has_elapsed_in_phase(100, 599));\n        assert!(s.has_elapsed_in_phase(100, 601));\n    }\n\n    #[test]\n    fn exit_lost_feedback_restores_cwin_and_clears_flag() {\n        // exit_lost_feedback requires Path, so we only test the BbrState\n        // side-effect that is path-independent: when the flag is already\n        // clear the function must be a no-op (no panic).\n        let mut s = make_state();\n        s.is_handling_lost_feedback = false;\n        s.cwin_before_lost_feedback = 9999;\n        // We cannot call exit_lost_feedback here without a Path, but we can\n        // verify the guard: the function reads `is_handling_lost_feedback`\n        // first.  Full coverage comes from the integration tests.\n        let _ = s.cwin_before_lost_feedback; // used\n    }\n\n    #[test]\n    fn enter_startup_resume_sets_state_and_gains() {\n        let mut s = make_state();\n        s.enter_startup_resume();\n        assert_eq!(s.state, BbrAlgState::StartupResume);\n        assert!((s.pacing_gain - BBR_STARTUP_RESUME_PACING_GAIN).abs() < f64::EPSILON);\n        assert!((s.cwnd_gain - BBR_STARTUP_RESUME_CWND_GAIN).abs() < f64::EPSILON);\n    }\n\n    // enter_startup and enter_startup_long_rtt mutate Path fields\n    // (is_cca_probing_up, cwin); constructing a full Path requires\n    // the heavy internal machinery.  Those are covered by the cargo\n    // compilation gate and integration tests.\n}\n","numLines":876,"startLine":1,"totalLines":876}}}
