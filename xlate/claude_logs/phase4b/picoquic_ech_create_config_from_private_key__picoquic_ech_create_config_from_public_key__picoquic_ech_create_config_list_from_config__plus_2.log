{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01U4AXtstnGgNq8xxesXdMbJ","type":"tool_result","content":"590\t        log_ctx->fn(log_ctx->ctx, \"\\n\");\n591\t    }\n592\t    return byte_index;\n593\t}\n594\t\n595\t\n596\tstatic uint8_t oid_algo_secp[] = { 0x2a, 0x86, 0x48, 0xce, 0x3d, 0x02, 0x01 };\n597\tstatic uint8_t oid_pr_secp256r1[] = { 0x06, 0x08, 0x2a, 0x86, 0x48, 0xce, 0x3d, 0x03, 0x01, 0x07 };\n598\tstatic uint8_t oid_pr_secp384r1[] = { 0x06, 0x05, 0x2b, 0x81, 0x04, 0x00, 0x22 };\n599\tstatic uint8_t oid_x25519[] = { 0x2b, 0x65, 0x6e };\n600\t\n601\tint picoquic_ech_parse_public_key(ptls_iovec_t public_key_asn1,\n602\t    uint16_t* group_id,\n603\t    ptls_iovec_t* public_key_bits)\n604\t{\n605\t    int ret = 0;\n606\t    ptls_iovec_t public_key_algo;\n607\t    ptls_iovec_t public_key_param;\n608\t    ptls_iovec_t public_key_bit_string;\n609\t    size_t expected_key_length = 0;\n610\t    (void)picoquic_parse_public_key_asn1(public_key_asn1,\n611\t        &public_key_algo, &public_key_param,\n612\t        &public_key_bit_string, &ret, NULL);\n613\t    if (ret == 0) {\n614\t        if (public_key_algo.len == sizeof(oid_algo_secp) &&\n615\t            memcmp(public_key_algo.base, oid_algo_secp, sizeof(oid_algo_secp)) == 0) {\n616\t            if (public_key_param.len == sizeof(oid_pr_secp256r1) &&\n617\t                memcmp(public_key_param.base, oid_pr_secp256r1, sizeof(oid_pr_secp256r1)) == 0) {\n618\t                *group_id = PTLS_GROUP_SECP256R1;\n619\t                expected_key_length = 0x41;\n620\t            }\n621\t            else if (public_key_param.len == sizeof(oid_pr_secp384r1) &&\n622\t                memcmp(public_key_param.base, oid_pr_secp384r1, sizeof(oid_pr_secp384r1)) == 0) {\n623\t                *group_id = PTLS_GROUP_SECP384R1;\n624\t                expected_key_length = 0x61;\n625\t            }\n626\t            else {\n627\t                DBG_PRINTF(\"%s\", \"Unsupported SecP Group ID\");\n628\t                ret = -1;\n629\t            }\n630\t        }\n631\t        else if (public_key_algo.len == sizeof(oid_x25519) &&\n632\t            memcmp(public_key_algo.base, oid_x25519, sizeof(oid_x25519)) == 0) {\n633\t            *group_id = PTLS_GROUP_X25519;\n634\t            expected_key_length = 0x20;\n635\t        }\n636\t    }\n637\t    else {\n638\t        DBG_PRINTF(\"%s\", \"Unsupported Algorithm ID\");\n639\t        ret = -1;\n640\t    }\n641\t    if (ret == 0) {\n642\t        if (public_key_bit_string.len > 1 && public_key_bit_string.base[0] == 0) {\n643\t            public_key_bits->base = public_key_bit_string.base + 1;\n644\t            public_key_bits->len = public_key_bit_string.len - 1;\n645\t            if (public_key_bits->len != expected_key_length) {\n646\t                DBG_PRINTF(\"Invalid length for curve 0x%04x: %zu, expected %zu\",\n647\t                    *group_id, public_key_bits->len, expected_key_length);\n648\t                ret = -1;\n649\t            }\n650\t        }\n651\t    }\n652\t    return ret;\n653\t}\n654\t\n655\tint picoquic_ech_get_kem_from_curve(ptls_hpke_kem_t **kem, uint16_t group_id)\n656\t{\n657\t    int ret = -1;\n658\t\n659\t    for (int i = 0; i < PICOQUIC_HPKE_KEM_NB_MAX; i++) {\n660\t        if (picoquic_hpke_kems[i] == NULL) {\n661\t            break;\n662\t        }\n663\t        else if (picoquic_hpke_kems[i]->keyex->id == group_id) {\n664\t            *kem = picoquic_hpke_kems[i];\n665\t            ret = 0;\n666\t            break;\n667\t        }\n668\t    }\n669\t    return ret;\n670\t}\n671\t\n672\tint picoquic_ech_get_ciphers_from_kem(ptls_hpke_cipher_suite_t** cipher_vec, size_t cipher_vec_nb_max, uint16_t kem_id)\n673\t{\n674\t    int ret = 0;\n675\t    size_t nb_ciphers = 0;\n676\t    uint16_t target_kdf_id = PTLS_HPKE_HKDF_SHA256;\n677\t    uint16_t target_aead_id = PTLS_HPKE_AEAD_AES_128_GCM;\n678\t    ptls_hpke_cipher_suite_t* target_cipher = NULL;\n679\t    ptls_hpke_cipher_suite_t* default_cipher = NULL;\n680\t\n681\t    if (cipher_vec_nb_max < 2) {\n682\t        return -1;\n683\t    }\n684\t\n685\t    switch (kem_id) {\n686\t    case PTLS_HPKE_KEM_P256_SHA256:\n687\t        target_kdf_id = PTLS_HPKE_HKDF_SHA256;\n688\t        target_aead_id = PTLS_HPKE_AEAD_AES_128_GCM;\n689\t        break;\n690\t    case PTLS_HPKE_KEM_P384_SHA384:\n691\t        target_kdf_id = PTLS_HPKE_HKDF_SHA384;\n692\t        target_aead_id = PTLS_HPKE_AEAD_AES_256_GCM;\n693\t        break;\n694\t    case PTLS_HPKE_KEM_X25519_SHA256:\n695\t        target_kdf_id = PTLS_HPKE_HKDF_SHA256;\n696\t        target_aead_id = PTLS_HPKE_AEAD_CHACHA20POLY1305;\n697\t        break;\n698\t    default:\n699\t        break;\n700\t    }\n701\t\n702\t    for (size_t i = 0; i < PICOQUIC_HPKE_CIPHER_SUITE_NB_MAX; i++) {\n703\t        if (picoquic_hpke_cipher_suites[i] == NULL) {\n704\t            break;\n705\t        }\n706\t        else if (picoquic_hpke_cipher_suites[i]->id.aead == target_aead_id &&\n707\t            picoquic_hpke_cipher_suites[i]->id.kdf == target_kdf_id) {\n708\t            target_cipher = picoquic_hpke_cipher_suites[i];\n709\t            break;\n710\t        }\n711\t        else if (picoquic_hpke_cipher_suites[i]->id.aead == PTLS_HPKE_AEAD_AES_128_GCM &&\n712\t            picoquic_hpke_cipher_suites[i]->id.kdf == PTLS_HPKE_HKDF_SHA256) {\n713\t            default_cipher = picoquic_hpke_cipher_suites[i];\n714\t        }\n715\t    }\n716\t    if (target_cipher == NULL) {\n717\t        if (default_cipher != NULL) {\n718\t            cipher_vec[0] = default_cipher;\n719\t            nb_ciphers = 1;\n720\t        }\n721\t        else {\n722\t            ret = -1;\n723\t        }\n724\t    } else {\n725\t        cipher_vec[0] = target_cipher;\n726\t        nb_ciphers = 1;\n727\t        if (default_cipher != NULL && default_cipher != target_cipher && cipher_vec_nb_max > 2) {\n728\t            cipher_vec[1] = default_cipher;\n729\t            nb_ciphers++;\n730\t        }\n731\t    }\n732\t    for (size_t i = nb_ciphers; i < cipher_vec_nb_max; i++) {\n733\t        cipher_vec[i] = NULL;\n734\t    }\n735\t    return ret;\n736\t}\n737\t\n738\tstatic uint8_t ech_config_id_from_config(ptls_iovec_t public_key_bits, ptls_hpke_kem_t* kem, ptls_hpke_cipher_suite_t** cipher_vec, char const* public_name)\n739\t{\n740\t    /* compute the config ID */\n741\t    uint64_t config_sum = 0;\n742\t    uint8_t config_id = 0;\n743\t    for (size_t i = 0; i < public_key_bits.len; i++) {\n744\t        config_sum += public_key_bits.base[i];\n745\t    }\n746\t    config_sum += kem->id;\n747\t    for (size_t i = 0; cipher_vec[i] != NULL; i++) {\n748\t        config_sum += cipher_vec[i]->id.aead;\n749\t        config_sum += cipher_vec[i]->id.kdf;\n750\t    }\n751\t    for (size_t i = 0; public_name[i] != 0; i++) {\n752\t        config_sum += (uint8_t)public_name[i];\n753\t    }\n754\t    while (config_sum > 0) {\n755\t        config_id ^= (uint8_t)(config_sum & 0xff);\n756\t        config_sum >>= 8;\n757\t    }\n758\t    return config_id;\n759\t}\n760\t\n761\t/* Server side support.\n762\t*\n763\t* The server need two parameters: an ECH encryption key, and an\n764\t* ECH configuration.\n765\t*\n766\t* The ECH configuration has several parameters:\n767\t* - configuration ID,\n768\t* - identifier of the HPKE key encapsulation mechanism (KEM),\n769\t* - server public name, i.e., the DNS name of the client facing server,\n770\t* - server public key, i.e., the public key of the client facing server.\n771\t* - supported HPKE cipher suites.\n772\t*\n773\t* If the configuration is not available, it will have to be created.\n774\t* The server admin will have to provide the parameters.\n775\t* Many picoquic deployments use small servers with limited management.\n776\t* In that case, we may use default values such as the DNS name of\n777\t* the local server, the public key found in the local server certificate,\n778\t* a locally supported HPKE-KEM compatible with the public key,\n779\t* the list of locally supported HPKE symmetric cipher suites,\n780\t* and a configuration ID computed as combination of these local\n781\t* parameters.\n782\t*/\n783\tstatic int picoquic_ech_create_config_list_from_config(ptls_buffer_t* config_buf, uint8_t** config_list, size_t* config_list_len)\n784\t{\n785\t    int ret = 0;\n786\t    size_t bin_size = config_buf->off + 2;\n787\t    uint8_t* bin_val = (uint8_t*)malloc(bin_size);\n788\t    if (bin_val == NULL) {\n789\t        DBG_PRINTF(\"Cannot allocate %d bytes for config bin buffer\", bin_size);\n790\t        ret = -1;\n791\t    }\n792\t    else {\n793\t        bin_val[0] = (uint8_t)(((config_buf->off) >> 8) & 0xff);\n794\t        bin_val[1] = (uint8_t)(config_buf->off & 0xff);\n795\t        memcpy(bin_val + 2, config_buf->base, config_buf->off);\n796\t        *config_list = bin_val;\n797\t        *config_list_len = bin_size;\n798\t    }\n799\t    return ret;\n800\t}\n801\t\n802\tstatic int picoquic_ech_create_config_from_pk(ptls_buffer_t* config_buf, uint16_t group_id, ptls_iovec_t public_key_bits, char const* public_name)\n803\t{\n804\t    int ret = 0;\n805\t    ptls_hpke_kem_t* kem = NULL;\n806\t    ptls_hpke_cipher_suite_t* cipher_vec[PICOQUIC_HPKE_CIPHER_SUITE_NB_MAX + 1];\n807\t\n808\t    if ((ret = picoquic_ech_get_kem_from_curve(&kem, group_id)) != 0) {\n809\t        DBG_PRINTF(\"Could not find KEM for group = 0x%04x\", group_id);\n810\t    }\n811\t    /* Find the list of locally supported cipher suites, retaining only the most common */\n812\t    else if ((ret = picoquic_ech_get_ciphers_from_kem(cipher_vec, PICOQUIC_HPKE_CIPHER_SUITE_NB_MAX + 1, kem->id)) != 0) {\n813\t        DBG_PRINTF(\"Could not find Ciphers for kem = 0x%04x\", kem->id);\n814\t    }\n815\t    else {\n816\t        /* Compute a config ID from public key bytes, kem-id, cipher-suite IDs and public name */\n817\t        uint8_t config_id = ech_config_id_from_config(public_key_bits, kem, cipher_vec, public_name);\n818\t        /* Encode the key config */\n819\t        if ((ret = ptls_ech_encode_config(config_buf, config_id, kem, public_key_bits,\n820\t            cipher_vec, 255, public_name)) != 0) {\n821\t            DBG_PRINTF(\"Could not encode the configuration, err: %x\", ret);\n822\t        }\n823\t    }\n824\t    return ret;\n825\t}\n826\t\n827\tstatic int picoquic_ech_create_rr_from_binary(ptls_buffer_t* config_buf, ptls_iovec_t public_key_asn1, char const* public_name)\n828\t{\n829\t    int ret = 0;\n830\t    ptls_iovec_t public_key_bits = ptls_iovec_init(NULL, 0);\n831\t    uint16_t group_id = 0;\n832\t\n833\t    /* Parse the ASN1 public key to extract the key type and the key bytes */\n834\t    if ((ret = picoquic_ech_parse_public_key(public_key_asn1, &group_id, &public_key_bits)) != 0) {\n835\t        DBG_PRINTF(\"Cannot get group and pubkey from ASN1, err: %x\", ret);\n836\t    }\n837\t    /* Build config from group id and key bits */\n838\t    else {\n839\t        ret = picoquic_ech_create_config_from_pk(config_buf, group_id, public_key_bits, public_name);\n840\t    }\n841\t    return ret;\n842\t}\n843\t\n844\tint picoquic_ech_create_config_from_binary(uint8_t ** config, size_t * config_len, ptls_iovec_t public_key_asn1, char const* public_name)\n845\t{\n846\t    int ret = 0;\n847\t    ptls_buffer_t config_buf;\n848\t    ptls_buffer_init(&config_buf, \"\", 0);\n849\t\n850\t    if ((ret = picoquic_ech_create_rr_from_binary(&config_buf, public_key_asn1, public_name)) == 0) {\n851\t        ret = picoquic_ech_create_config_list_from_config(&config_buf, config, config_len);\n852\t    }\n853\t    ptls_buffer_dispose(&config_buf);\n854\t    return ret;\n855\t}\n856\t\n857\tint picoquic_ech_create_config_from_public_key(uint8_t** config, size_t* config_len, char const * public_key_file, char const* public_name)\n858\t{\n859\t    int ret = 0;\n860\t    ptls_iovec_t public_key_asn1 = ptls_iovec_init(NULL, 0);\n861\t    size_t pub_key_objects = 0;\n862\t\n863\t    /* Read the public key from a file. */\n864\t    ret = ptls_load_pem_objects(public_key_file, \"PUBLIC KEY\", &public_key_asn1, 1, &pub_key_objects);\n865\t    if (ret != 0) {\n866\t        DBG_PRINTF(\"Cannot load pubkey from <%s>, err: %x\", public_key_file, ret);\n867\t    }\n868\t    else\n869\t    {\n870\t        ret = picoquic_ech_create_config_from_binary(config, config_len, public_key_asn1, public_name);\n871\t    }\n872\t    if (public_key_asn1.base != NULL) {\n873\t        free(public_key_asn1.base);\n874\t    }\n875\t    return ret;\n876\t}\n877\t\n878\t\n879\tint picoquic_ech_create_config_from_private_key(uint8_t** config, size_t* config_len, char const* private_key_file, char const* public_name)\n880\t{\n881\t    int ret = 0;\n882\t\n883\t    *config = NULL;\n884\t    *config_len = 0;\n885\t\n886\t    if (picoquic_get_public_key_from_private_fn != NULL) {\n887\t        uint16_t group_id = 0;\n888\t        ptls_iovec_t public_key_bits = ptls_iovec_init(NULL, 0);\n889\t\n890\t        ret = picoquic_get_public_key_from_private_fn(private_key_file, &public_key_bits.base, &public_key_bits.len);\n891\t\n892\t        if (ret == 0) {\n893\t            switch (public_key_bits.len) {\n894\t            case 0x21: /* x25519 */\n895\t                group_id = 0x001d;\n896\t                break;\n897\t            case 0x41: /* secp265r1 */\n898\t                group_id = 0x0017;\n899\t                break;\n900\t            case 0x61: /* x25519 */\n901\t                group_id = 0x0018;\n902\t                break;\n903\t            default:\n904\t                DBG_PRINTF(\"Cannot find group ID from pubkey length 0x%02x from %s\",\n905\t                    public_key_bits.len, private_key_file);\n906\t                ret = -1;\n907\t                break;\n908\t            }\n909\t        }\n910\t\n911\t        if (ret == 0) {\n912\t            ptls_buffer_t config_buf;\n913\t            ptls_buffer_init(&config_buf, \"\", 0);\n914\t            ret = picoquic_ech_create_config_from_pk(&config_buf, group_id, public_key_bits, public_name);\n915\t            if (ret == 0) {\n916\t                ret = picoquic_ech_create_config_list_from_config(&config_buf, config, config_len);\n917\t            }\n918\t            ptls_buffer_dispose(&config_buf);\n919\t        }\n920\t        if (public_key_bits.base != NULL) {\n921\t            free(public_key_bits.base);\n922\t        }\n923\t    }\n924\t    return ret;\n925\t}\n926\t\n927\tint picoquic_ech_create_config_file(char const* public_name, char const* private_key_file, char const* ech_config_file)\n928\t{\n929\t    uint8_t* config = NULL;\n930\t    size_t config_len = 0;\n931\t    int ret = picoquic_ech_create_config_from_private_key(&config, &config_len, private_key_file, public_name);\n932\t\n933\t    if (ret == 0) {\n934\t        ret = picoquic_ech_save_config(config, config_len, ech_config_file);\n935\t    }\n936\t    if (config != NULL) {\n937\t        free(config);\n938\t    }\n939\t    return ret;"}]},"parent_tool_use_id":null,"session_id":"83fff6f3-c332-4b5d-b717-1fbf70423982","uuid":"b6a51820-b09c-46b8-a162-37c0998a95bb","timestamp":"2026-05-07T14:31:19.775Z","tool_use_result":{"type":"text","file":{"filePath":"/Users/richbarn/Projects/picoquic/picoquic/ech.c","content":"        log_ctx->fn(log_ctx->ctx, \"\\n\");\n    }\n    return byte_index;\n}\n\n\nstatic uint8_t oid_algo_secp[] = { 0x2a, 0x86, 0x48, 0xce, 0x3d, 0x02, 0x01 };\nstatic uint8_t oid_pr_secp256r1[] = { 0x06, 0x08, 0x2a, 0x86, 0x48, 0xce, 0x3d, 0x03, 0x01, 0x07 };\nstatic uint8_t oid_pr_secp384r1[] = { 0x06, 0x05, 0x2b, 0x81, 0x04, 0x00, 0x22 };\nstatic uint8_t oid_x25519[] = { 0x2b, 0x65, 0x6e };\n\nint picoquic_ech_parse_public_key(ptls_iovec_t public_key_asn1,\n    uint16_t* group_id,\n    ptls_iovec_t* public_key_bits)\n{\n    int ret = 0;\n    ptls_iovec_t public_key_algo;\n    ptls_iovec_t public_key_param;\n    ptls_iovec_t public_key_bit_string;\n    size_t expected_key_length = 0;\n    (void)picoquic_parse_public_key_asn1(public_key_asn1,\n        &public_key_algo, &public_key_param,\n        &public_key_bit_string, &ret, NULL);\n    if (ret == 0) {\n        if (public_key_algo.len == sizeof(oid_algo_secp) &&\n            memcmp(public_key_algo.base, oid_algo_secp, sizeof(oid_algo_secp)) == 0) {\n            if (public_key_param.len == sizeof(oid_pr_secp256r1) &&\n                memcmp(public_key_param.base, oid_pr_secp256r1, sizeof(oid_pr_secp256r1)) == 0) {\n                *group_id = PTLS_GROUP_SECP256R1;\n                expected_key_length = 0x41;\n            }\n            else if (public_key_param.len == sizeof(oid_pr_secp384r1) &&\n                memcmp(public_key_param.base, oid_pr_secp384r1, sizeof(oid_pr_secp384r1)) == 0) {\n                *group_id = PTLS_GROUP_SECP384R1;\n                expected_key_length = 0x61;\n            }\n            else {\n                DBG_PRINTF(\"%s\", \"Unsupported SecP Group ID\");\n                ret = -1;\n            }\n        }\n        else if (public_key_algo.len == sizeof(oid_x25519) &&\n            memcmp(public_key_algo.base, oid_x25519, sizeof(oid_x25519)) == 0) {\n            *group_id = PTLS_GROUP_X25519;\n            expected_key_length = 0x20;\n        }\n    }\n    else {\n        DBG_PRINTF(\"%s\", \"Unsupported Algorithm ID\");\n        ret = -1;\n    }\n    if (ret == 0) {\n        if (public_key_bit_string.len > 1 && public_key_bit_string.base[0] == 0) {\n            public_key_bits->base = public_key_bit_string.base + 1;\n            public_key_bits->len = public_key_bit_string.len - 1;\n            if (public_key_bits->len != expected_key_length) {\n                DBG_PRINTF(\"Invalid length for curve 0x%04x: %zu, expected %zu\",\n                    *group_id, public_key_bits->len, expected_key_length);\n                ret = -1;\n            }\n        }\n    }\n    return ret;\n}\n\nint picoquic_ech_get_kem_from_curve(ptls_hpke_kem_t **kem, uint16_t group_id)\n{\n    int ret = -1;\n\n    for (int i = 0; i < PICOQUIC_HPKE_KEM_NB_MAX; i++) {\n        if (picoquic_hpke_kems[i] == NULL) {\n            break;\n        }\n        else if (picoquic_hpke_kems[i]->keyex->id == group_id) {\n            *kem = picoquic_hpke_kems[i];\n            ret = 0;\n            break;\n        }\n    }\n    return ret;\n}\n\nint picoquic_ech_get_ciphers_from_kem(ptls_hpke_cipher_suite_t** cipher_vec, size_t cipher_vec_nb_max, uint16_t kem_id)\n{\n    int ret = 0;\n    size_t nb_ciphers = 0;\n    uint16_t target_kdf_id = PTLS_HPKE_HKDF_SHA256;\n    uint16_t target_aead_id = PTLS_HPKE_AEAD_AES_128_GCM;\n    ptls_hpke_cipher_suite_t* target_cipher = NULL;\n    ptls_hpke_cipher_suite_t* default_cipher = NULL;\n\n    if (cipher_vec_nb_max < 2) {\n        return -1;\n    }\n\n    switch (kem_id) {\n    case PTLS_HPKE_KEM_P256_SHA256:\n        target_kdf_id = PTLS_HPKE_HKDF_SHA256;\n        target_aead_id = PTLS_HPKE_AEAD_AES_128_GCM;\n        break;\n    case PTLS_HPKE_KEM_P384_SHA384:\n        target_kdf_id = PTLS_HPKE_HKDF_SHA384;\n        target_aead_id = PTLS_HPKE_AEAD_AES_256_GCM;\n        break;\n    case PTLS_HPKE_KEM_X25519_SHA256:\n        target_kdf_id = PTLS_HPKE_HKDF_SHA256;\n        target_aead_id = PTLS_HPKE_AEAD_CHACHA20POLY1305;\n        break;\n    default:\n        break;\n    }\n\n    for (size_t i = 0; i < PICOQUIC_HPKE_CIPHER_SUITE_NB_MAX; i++) {\n        if (picoquic_hpke_cipher_suites[i] == NULL) {\n            break;\n        }\n        else if (picoquic_hpke_cipher_suites[i]->id.aead == target_aead_id &&\n            picoquic_hpke_cipher_suites[i]->id.kdf == target_kdf_id) {\n            target_cipher = picoquic_hpke_cipher_suites[i];\n            break;\n        }\n        else if (picoquic_hpke_cipher_suites[i]->id.aead == PTLS_HPKE_AEAD_AES_128_GCM &&\n            picoquic_hpke_cipher_suites[i]->id.kdf == PTLS_HPKE_HKDF_SHA256) {\n            default_cipher = picoquic_hpke_cipher_suites[i];\n        }\n    }\n    if (target_cipher == NULL) {\n        if (default_cipher != NULL) {\n            cipher_vec[0] = default_cipher;\n            nb_ciphers = 1;\n        }\n        else {\n            ret = -1;\n        }\n    } else {\n        cipher_vec[0] = target_cipher;\n        nb_ciphers = 1;\n        if (default_cipher != NULL && default_cipher != target_cipher && cipher_vec_nb_max > 2) {\n            cipher_vec[1] = default_cipher;\n            nb_ciphers++;\n        }\n    }\n    for (size_t i = nb_ciphers; i < cipher_vec_nb_max; i++) {\n        cipher_vec[i] = NULL;\n    }\n    return ret;\n}\n\nstatic uint8_t ech_config_id_from_config(ptls_iovec_t public_key_bits, ptls_hpke_kem_t* kem, ptls_hpke_cipher_suite_t** cipher_vec, char const* public_name)\n{\n    /* compute the config ID */\n    uint64_t config_sum = 0;\n    uint8_t config_id = 0;\n    for (size_t i = 0; i < public_key_bits.len; i++) {\n        config_sum += public_key_bits.base[i];\n    }\n    config_sum += kem->id;\n    for (size_t i = 0; cipher_vec[i] != NULL; i++) {\n        config_sum += cipher_vec[i]->id.aead;\n        config_sum += cipher_vec[i]->id.kdf;\n    }\n    for (size_t i = 0; public_name[i] != 0; i++) {\n        config_sum += (uint8_t)public_name[i];\n    }\n    while (config_sum > 0) {\n        config_id ^= (uint8_t)(config_sum & 0xff);\n        config_sum >>= 8;\n    }\n    return config_id;\n}\n\n/* Server side support.\n*\n* The server need two parameters: an ECH encryption key, and an\n* ECH configuration.\n*\n* The ECH configuration has several parameters:\n* - configuration ID,\n* - identifier of the HPKE key encapsulation mechanism (KEM),\n* - server public name, i.e., the DNS name of the client facing server,\n* - server public key, i.e., the public key of the client facing server.\n* - supported HPKE cipher suites.\n*\n* If the configuration is not available, it will have to be created.\n* The server admin will have to provide the parameters.\n* Many picoquic deployments use small servers with limited management.\n* In that case, we may use default values such as the DNS name of\n* the local server, the public key found in the local server certificate,\n* a locally supported HPKE-KEM compatible with the public key,\n* the list of locally supported HPKE symmetric cipher suites,\n* and a configuration ID computed as combination of these local\n* parameters.\n*/\nstatic int picoquic_ech_create_config_list_from_config(ptls_buffer_t* config_buf, uint8_t** config_list, size_t* config_list_len)\n{\n    int ret = 0;\n    size_t bin_size = config_buf->off + 2;\n    uint8_t* bin_val = (uint8_t*)malloc(bin_size);\n    if (bin_val == NULL) {\n        DBG_PRINTF(\"Cannot allocate %d bytes for config bin buffer\", bin_size);\n        ret = -1;\n    }\n    else {\n        bin_val[0] = (uint8_t)(((config_buf->off) >> 8) & 0xff);\n        bin_val[1] = (uint8_t)(config_buf->off & 0xff);\n        memcpy(bin_val + 2, config_buf->base, config_buf->off);\n        *config_list = bin_val;\n        *config_list_len = bin_size;\n    }\n    return ret;\n}\n\nstatic int picoquic_ech_create_config_from_pk(ptls_buffer_t* config_buf, uint16_t group_id, ptls_iovec_t public_key_bits, char const* public_name)\n{\n    int ret = 0;\n    ptls_hpke_kem_t* kem = NULL;\n    ptls_hpke_cipher_suite_t* cipher_vec[PICOQUIC_HPKE_CIPHER_SUITE_NB_MAX + 1];\n\n    if ((ret = picoquic_ech_get_kem_from_curve(&kem, group_id)) != 0) {\n        DBG_PRINTF(\"Could not find KEM for group = 0x%04x\", group_id);\n    }\n    /* Find the list of locally supported cipher suites, retaining only the most common */\n    else if ((ret = picoquic_ech_get_ciphers_from_kem(cipher_vec, PICOQUIC_HPKE_CIPHER_SUITE_NB_MAX + 1, kem->id)) != 0) {\n        DBG_PRINTF(\"Could not find Ciphers for kem = 0x%04x\", kem->id);\n    }\n    else {\n        /* Compute a config ID from public key bytes, kem-id, cipher-suite IDs and public name */\n        uint8_t config_id = ech_config_id_from_config(public_key_bits, kem, cipher_vec, public_name);\n        /* Encode the key config */\n        if ((ret = ptls_ech_encode_config(config_buf, config_id, kem, public_key_bits,\n            cipher_vec, 255, public_name)) != 0) {\n            DBG_PRINTF(\"Could not encode the configuration, err: %x\", ret);\n        }\n    }\n    return ret;\n}\n\nstatic int picoquic_ech_create_rr_from_binary(ptls_buffer_t* config_buf, ptls_iovec_t public_key_asn1, char const* public_name)\n{\n    int ret = 0;\n    ptls_iovec_t public_key_bits = ptls_iovec_init(NULL, 0);\n    uint16_t group_id = 0;\n\n    /* Parse the ASN1 public key to extract the key type and the key bytes */\n    if ((ret = picoquic_ech_parse_public_key(public_key_asn1, &group_id, &public_key_bits)) != 0) {\n        DBG_PRINTF(\"Cannot get group and pubkey from ASN1, err: %x\", ret);\n    }\n    /* Build config from group id and key bits */\n    else {\n        ret = picoquic_ech_create_config_from_pk(config_buf, group_id, public_key_bits, public_name);\n    }\n    return ret;\n}\n\nint picoquic_ech_create_config_from_binary(uint8_t ** config, size_t * config_len, ptls_iovec_t public_key_asn1, char const* public_name)\n{\n    int ret = 0;\n    ptls_buffer_t config_buf;\n    ptls_buffer_init(&config_buf, \"\", 0);\n\n    if ((ret = picoquic_ech_create_rr_from_binary(&config_buf, public_key_asn1, public_name)) == 0) {\n        ret = picoquic_ech_create_config_list_from_config(&config_buf, config, config_len);\n    }\n    ptls_buffer_dispose(&config_buf);\n    return ret;\n}\n\nint picoquic_ech_create_config_from_public_key(uint8_t** config, size_t* config_len, char const * public_key_file, char const* public_name)\n{\n    int ret = 0;\n    ptls_iovec_t public_key_asn1 = ptls_iovec_init(NULL, 0);\n    size_t pub_key_objects = 0;\n\n    /* Read the public key from a file. */\n    ret = ptls_load_pem_objects(public_key_file, \"PUBLIC KEY\", &public_key_asn1, 1, &pub_key_objects);\n    if (ret != 0) {\n        DBG_PRINTF(\"Cannot load pubkey from <%s>, err: %x\", public_key_file, ret);\n    }\n    else\n    {\n        ret = picoquic_ech_create_config_from_binary(config, config_len, public_key_asn1, public_name);\n    }\n    if (public_key_asn1.base != NULL) {\n        free(public_key_asn1.base);\n    }\n    return ret;\n}\n\n\nint picoquic_ech_create_config_from_private_key(uint8_t** config, size_t* config_len, char const* private_key_file, char const* public_name)\n{\n    int ret = 0;\n\n    *config = NULL;\n    *config_len = 0;\n\n    if (picoquic_get_public_key_from_private_fn != NULL) {\n        uint16_t group_id = 0;\n        ptls_iovec_t public_key_bits = ptls_iovec_init(NULL, 0);\n\n        ret = picoquic_get_public_key_from_private_fn(private_key_file, &public_key_bits.base, &public_key_bits.len);\n\n        if (ret == 0) {\n            switch (public_key_bits.len) {\n            case 0x21: /* x25519 */\n                group_id = 0x001d;\n                break;\n            case 0x41: /* secp265r1 */\n                group_id = 0x0017;\n                break;\n            case 0x61: /* x25519 */\n                group_id = 0x0018;\n                break;\n            default:\n                DBG_PRINTF(\"Cannot find group ID from pubkey length 0x%02x from %s\",\n                    public_key_bits.len, private_key_file);\n                ret = -1;\n                break;\n            }\n        }\n\n        if (ret == 0) {\n            ptls_buffer_t config_buf;\n            ptls_buffer_init(&config_buf, \"\", 0);\n            ret = picoquic_ech_create_config_from_pk(&config_buf, group_id, public_key_bits, public_name);\n            if (ret == 0) {\n                ret = picoquic_ech_create_config_list_from_config(&config_buf, config, config_len);\n            }\n            ptls_buffer_dispose(&config_buf);\n        }\n        if (public_key_bits.base != NULL) {\n            free(public_key_bits.base);\n        }\n    }\n    return ret;\n}\n\nint picoquic_ech_create_config_file(char const* public_name, char const* private_key_file, char const* ech_config_file)\n{\n    uint8_t* config = NULL;\n    size_t config_len = 0;\n    int ret = picoquic_ech_create_config_from_private_key(&config, &config_len, private_key_file, public_name);\n\n    if (ret == 0) {\n        ret = picoquic_ech_save_config(config, config_len, ech_config_file);\n    }\n    if (config != NULL) {\n        free(config);\n    }\n    return ret;","numLines":350,"startLine":590,"totalLines":1076}}}
{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01LzHmPRbxPXyYu8gE3AN1WP","type":"tool_result","content":"1\t//! Encrypted ClientHello (ECH) helpers.\n2\t//!\n3\t//! Pure-Rust portion of the ECH support layer, fully translated from\n4\t//! `picoquic/ech.c`.  HPKE key-exchange (DHKEM-X25519, DHKEM-P256,\n5\t//! DHKEM-P384) is implemented via the `hpke` crate; the remaining logic\n6\t//! — cipher-suite selection, config-ID derivation, base64 encoding, and\n7\t//! opener-state plumbing — is translated directly.\n8\t\n9\textern crate alloc;\n10\tuse alloc::vec::Vec;\n11\t\n12\tuse crate::Error;\n13\t\n14\t// ---------------------------------------------------------------------------\n15\t// HPKE constants (IANA registries, RFC 9180).\n16\t\n17\t/// HPKE KEM algorithm identifiers (RFC 9180 §7.1).\n18\tpub mod kem_id {\n19\t    /// DHKEM(P-256, HKDF-SHA256)\n20\t    pub const P256_SHA256: u16 = 0x0010;\n21\t    /// DHKEM(P-384, HKDF-SHA384)\n22\t    pub const P384_SHA384: u16 = 0x0011;\n23\t    /// DHKEM(X25519, HKDF-SHA256)\n24\t    pub const X25519_SHA256: u16 = 0x0020;\n25\t}\n26\t\n27\t/// HPKE KDF algorithm identifiers (RFC 9180 §7.2).\n28\tpub mod kdf_id {\n29\t    /// HKDF-SHA256\n30\t    pub const HKDF_SHA256: u16 = 0x0001;\n31\t    /// HKDF-SHA384\n32\t    pub const HKDF_SHA384: u16 = 0x0002;\n33\t    /// HKDF-SHA512\n34\t    pub const HKDF_SHA512: u16 = 0x0003;\n35\t}\n36\t\n37\t/// HPKE AEAD algorithm identifiers (RFC 9180 §7.3).\n38\tpub mod aead_id {\n39\t    /// AES-128-GCM\n40\t    pub const AES_128_GCM: u16 = 0x0001;\n41\t    /// AES-256-GCM\n42\t    pub const AES_256_GCM: u16 = 0x0002;\n43\t    /// ChaCha20-Poly1305\n44\t    pub const CHACHA20_POLY1305: u16 = 0x0003;\n45\t}\n46\t\n47\t// ---------------------------------------------------------------------------\n48\t// Cipher-suite identifier.\n49\t\n50\t/// HPKE symmetric cipher-suite: (KDF id, AEAD id) pair.\n51\t///\n52\t/// C: `ptls_hpke_cipher_suite_id_t`\n53\t#[derive(Debug, Clone, Copy, PartialEq, Eq)]\n54\tpub struct HpkeCipherSuiteId {\n55\t    pub kdf: u16,\n56\t    pub aead: u16,\n57\t}\n58\t\n59\t/// The three cipher suites we advertise as supported, mirroring the\n60\t/// `picoquic_hpke_cipher_suites[]` array that the C picotls backend\n61\t/// populates at startup.\n62\tconst SUPPORTED_CIPHER_SUITES: &[HpkeCipherSuiteId] = &[\n63\t    HpkeCipherSuiteId {\n64\t        kdf: kdf_id::HKDF_SHA256,\n65\t        aead: aead_id::AES_128_GCM,\n66\t    },\n67\t    HpkeCipherSuiteId {\n68\t        kdf: kdf_id::HKDF_SHA256,\n69\t        aead: aead_id::CHACHA20_POLY1305,\n70\t    },\n71\t    HpkeCipherSuiteId {\n72\t        kdf: kdf_id::HKDF_SHA384,\n73\t        aead: aead_id::AES_256_GCM,\n74\t    },\n75\t];\n76\t\n77\t// ---------------------------------------------------------------------------\n78\t// Base64 encoding.\n79\t\n80\tconst BASE64_ALPHABET: &[u8; 64] =\n81\t    b\"ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789+/\";\n82\t\n83\t/// Return the number of base64 characters needed to encode `input_len` bytes,\n84\t/// not counting a NUL terminator.  Mirrors `ptls_base64_howlong`.\n85\t#[inline]\n86\tpub fn base64_encoded_len(input_len: usize) -> usize {\n87\t    input_len.div_ceil(3) * 4\n88\t}\n89\t\n90\t/// Encode `input` as standard RFC 4648 base64 into `out`.\n91\t///\n92\t/// `out` must be at least `base64_encoded_len(input.len()) + 1` bytes long\n93\t/// (the extra byte is for the NUL terminator written to match picotls\n94\t/// convention).  Returns the number of base64 characters written (excluding\n95\t/// the NUL).  Returns `Err(Error::Generic)` when `out` is too small.\n96\t///\n97\t/// C: `picoquic_base64_encode`\n98\tpub fn base64_encode(input: &[u8], out: &mut [u8]) -> Result<usize, Error> {\n99\t    let len = base64_encoded_len(input.len());\n100\t    if len + 1 > out.len() {\n101\t        return Err(Error::Generic);\n102\t    }\n103\t    let mut pos = 0usize;\n104\t    let mut chunks = input.chunks_exact(3);\n105\t    for chunk in &mut chunks {\n106\t        let b = ((chunk[0] as u32) << 16) | ((chunk[1] as u32) << 8) | (chunk[2] as u32);\n107\t        out[pos] = BASE64_ALPHABET[((b >> 18) & 0x3f) as usize];\n108\t        out[pos + 1] = BASE64_ALPHABET[((b >> 12) & 0x3f) as usize];\n109\t        out[pos + 2] = BASE64_ALPHABET[((b >> 6) & 0x3f) as usize];\n110\t        out[pos + 3] = BASE64_ALPHABET[(b & 0x3f) as usize];\n111\t        pos += 4;\n112\t    }\n113\t    match chunks.remainder() {\n114\t        [a] => {\n115\t            let b = (*a as u32) << 16;\n116\t            out[pos] = BASE64_ALPHABET[((b >> 18) & 0x3f) as usize];\n117\t            out[pos + 1] = BASE64_ALPHABET[((b >> 12) & 0x3f) as usize];\n118\t            out[pos + 2] = b'=';\n119\t            out[pos + 3] = b'=';\n120\t            pos += 4;\n121\t        }\n122\t        [a, b] => {\n123\t            let v = ((*a as u32) << 16) | ((*b as u32) << 8);\n124\t            out[pos] = BASE64_ALPHABET[((v >> 18) & 0x3f) as usize];\n125\t            out[pos + 1] = BASE64_ALPHABET[((v >> 12) & 0x3f) as usize];\n126\t            out[pos + 2] = BASE64_ALPHABET[((v >> 6) & 0x3f) as usize];\n127\t            out[pos + 3] = b'=';\n128\t            pos += 4;\n129\t        }\n130\t        _ => {}\n131\t    }\n132\t    out[pos] = 0; // NUL terminator (mirrors ptls_base64_encode convention)\n133\t    Ok(len)\n134\t}\n135\t\n136\t// ---------------------------------------------------------------------------\n137\t// Cipher-suite selector.\n138\t\n139\t/// Fill `out` with HPKE cipher suites appropriate for `kem_id`, returning\n140\t/// the number of entries written.\n141\t///\n142\t/// The first entry is the preferred suite for the given KEM; when there is\n143\t/// also a suitable default suite (AES-128-GCM + HKDF-SHA256) that differs\n144\t/// from the preferred one and `out.len() > 2`, it is appended as the second\n145\t/// entry.\n146\t///\n147\t/// Returns `Err(Error::Generic)` if `out.len() < 2` (mirrors the C guard\n148\t/// `cipher_vec_nb_max < 2`) or if no suite can be found.\n149\t///\n150\t/// C: `picoquic_ech_get_ciphers_from_kem`\n151\tpub fn ech_get_ciphers_from_kem(\n152\t    kem_id: u16,\n153\t    out: &mut [HpkeCipherSuiteId],\n154\t) -> Result<usize, Error> {\n155\t    if out.len() < 2 {\n156\t        return Err(Error::Generic);\n157\t    }\n158\t\n159\t    let (target_kdf, target_aead) = match kem_id {\n160\t        kem_id::P256_SHA256 => (kdf_id::HKDF_SHA256, aead_id::AES_128_GCM),\n161\t        kem_id::P384_SHA384 => (kdf_id::HKDF_SHA384, aead_id::AES_256_GCM),\n162\t        kem_id::X25519_SHA256 => (kdf_id::HKDF_SHA256, aead_id::CHACHA20_POLY1305),\n163\t        _ => (kdf_id::HKDF_SHA256, aead_id::AES_128_GCM),\n164\t    };\n165\t    let target = HpkeCipherSuiteId {\n166\t        kdf: target_kdf,\n167\t        aead: target_aead,\n168\t    };\n169\t    let default_suite = HpkeCipherSuiteId {\n170\t        kdf: kdf_id::HKDF_SHA256,\n171\t        aead: aead_id::AES_128_GCM,\n172\t    };\n173\t\n174\t    let mut target_cipher: Option<HpkeCipherSuiteId> = None;\n175\t    let mut default_cipher: Option<HpkeCipherSuiteId> = None;\n176\t\n177\t    for &suite in SUPPORTED_CIPHER_SUITES {\n178\t        if target_cipher.is_none() && suite == target {\n179\t            target_cipher = Some(suite);\n180\t        }\n181\t        if default_cipher.is_none() && suite == default_suite {\n182\t            default_cipher = Some(suite);\n183\t        }\n184\t    }\n185\t\n186\t    // Mirrors the C branching: target first; fall back to default; error if neither.\n187\t    // C: `cipher_vec_nb_max > 2` guards adding the default as a second entry.\n188\t    let nb_ciphers = match (target_cipher, default_cipher) {\n189\t        (Some(t), def) => {\n190\t            out[0] = t;\n191\t            if let Some(d) = def {\n192\t                if d != t && out.len() > 2 {\n193\t                    out[1] = d;\n194\t                    2\n195\t                } else {\n196\t                    1\n197\t                }\n198\t            } else {\n199\t                1\n200\t            }\n201\t        }\n202\t        (None, Some(d)) => {\n203\t            out[0] = d;\n204\t            1\n205\t        }\n206\t        (None, None) => return Err(Error::Generic),\n207\t    };\n208\t    Ok(nb_ciphers)\n209\t}\n210\t\n211\t// ---------------------------------------------------------------------------\n212\t// Config-ID derivation (private helper).\n213\t\n214\t/// Compute the one-byte ECH config-ID from the public key material, KEM id,\n215\t/// cipher suites, and the server public name.\n216\t///\n217\t/// The algorithm accumulates all bytes into a `u64` then XOR-folds the\n218\t/// result down to a single byte.\n219\t///\n220\t/// C: `ech_config_id_from_config` (file-static)\n221\tfn ech_config_id_from_config(\n222\t    public_key_bits: &[u8],\n223\t    kem_id: u16,\n224\t    cipher_suites: &[HpkeCipherSuiteId],\n225\t    public_name: &str,\n226\t) -> u8 {\n227\t    let mut config_sum: u64 = 0;\n228\t    for &b in public_key_bits {\n229\t        config_sum = config_sum.wrapping_add(b as u64);\n230\t    }\n231\t    config_sum = config_sum.wrapping_add(kem_id as u64);\n232\t    for cs in cipher_suites {\n233\t        config_sum = config_sum.wrapping_add(cs.aead as u64);\n234\t        config_sum = config_sum.wrapping_add(cs.kdf as u64);\n235\t    }\n236\t    for b in public_name.bytes() {\n237\t        config_sum = config_sum.wrapping_add(b as u64);\n238\t    }\n239\t    let mut config_id: u8 = 0;\n240\t    while config_sum > 0 {\n241\t        config_id ^= (config_sum & 0xff) as u8;\n242\t        config_sum >>= 8;\n243\t    }\n244\t    config_id\n245\t}\n246\t\n247\t// ---------------------------------------------------------------------------\n248\t// Server-side ECH opener state.\n249\t\n250\t/// Result returned by a successful [`EchOpenerState::open`] call.\n251\t///\n252\t/// `key_material` holds the HPKE-derived key material exported from the\n253\t/// receiver context; callers build the concrete AEAD context from it\n254\t/// together with `cipher`.\n255\tpub struct EchOpenResult {\n256\t    /// The negotiated cipher suite.\n257\t    pub cipher: HpkeCipherSuiteId,\n258\t    /// HPKE-exported key material (32 bytes) derived via RFC 9180\n259\t    /// `Context.Export`.  Callers use this to construct the AEAD context for\n260\t    /// decrypting the ECH inner ClientHello.\n261\t    pub key_material: Vec<u8>,\n262\t}\n263\t\n264\t/// Server-side ECH opener callback state.\n265\t///\n266\t/// Holds the KEM id, the private key bytes used for HPKE decapsulation,\n267\t/// and the serialised ECH config bytes (used to reconstruct the HPKE `info`\n268\t/// string during opening).\n269\t///\n270\t/// C: `ech_opener_callback_t`\n271\tpub struct EchOpenerState {\n272\t    /// HPKE KEM identifier, e.g. `kem_id::X25519_SHA256`.\n273\t    /// C: `kem` (`ptls_hpke_kem_t*`; we store only the numeric id).\n274\t    pub kem_id: u16,\n275\t    /// Raw private key bytes for HPKE decapsulation.\n276\t    /// C: `keyex` (`ptls_key_exchange_context_t*` loaded from a PEM file).\n277\t    pub private_key: Vec<u8>,\n278\t    /// Serialised ECH config bytes including the two-byte outer length prefix.\n279\t    /// C: `config` (`ptls_buffer_t`).\n280\t    pub config: Vec<u8>,\n281\t}\n282\t\n283\timpl EchOpenerState {\n284\t    /// Attempt to open (decapsulate) an incoming ECH extension.\n285\t    ///\n286\t    /// Finds the cipher suite matching `cipher_id` in the supported list,\n287\t    /// builds the HPKE `info` string as `info_prefix || config[2..]`, then\n288\t    /// performs HPKE base-mode receiver setup (RFC 9180 §5.1.1) to derive\n289\t    /// the AEAD key material.\n290\t    ///\n291\t    /// Returns `Some(EchOpenResult)` on success, `None` when `cipher_id` is\n292\t    /// not in the supported list or the key bytes cannot be deserialized.\n293\t    ///\n294\t    /// C: `ech_opener_callback`\n295\t    pub fn open(\n296\t        &self,\n297\t        cipher_id: HpkeCipherSuiteId,\n298\t        enc: &[u8],\n299\t        info_prefix: &[u8],\n300\t    ) -> Option<EchOpenResult> {\n301\t        // Find the matching cipher suite in the supported list.\n302\t        let cipher = SUPPORTED_CIPHER_SUITES\n303\t            .iter()\n304\t            .copied()\n305\t            .find(|c| c.kdf == cipher_id.kdf && c.aead == cipher_id.aead)?;\n306\t\n307\t        // Build info = info_prefix || config[2..]\n308\t        // (config[0..2] is the two-byte ECHConfigList outer length prefix,\n309\t        // skipped to match the `ptls_buffer_pushv(&infobuf, config.base+2, …)`\n310\t        // call in the C implementation.)\n311\t        let config_payload = self.config.get(2..).unwrap_or(&[]);\n312\t        let mut info = Vec::with_capacity(info_prefix.len() + config_payload.len());\n313\t        info.extend_from_slice(info_prefix);\n314\t        info.extend_from_slice(config_payload);\n315\t\n316\t        // HPKE base-mode receiver setup (equivalent to ptls_hpke_setup_base_r).\n317\t        let key_material = hpke_setup_receiver(self.kem_id, cipher, &self.private_key, enc, &info)?;\n318\t        Some(EchOpenResult {\n319\t            cipher,\n320\t            key_material,\n321\t        })\n322\t    }\n323\t}\n324\t\n325\t// ---------------------------------------------------------------------------\n326\t// HPKE receiver setup dispatcher.\n327\t\n328\t/// Perform HPKE base-mode receiver setup (RFC 9180 §5.1.1) for the given\n329\t/// `(kem, cipher)` combination and return 32 bytes of exported key material\n330\t/// via `Context.Export`.  Returns `None` on key-format mismatch or an\n331\t/// unknown algorithm combination.\n332\t///\n333\t/// Dispatches over the three KEM/KDF/AEAD triples that picoquic supports.\n334\t/// The C equivalent is the `ptls_hpke_setup_base_r` call inside\n335\t/// `ech_opener_callback`.\n336\tfn hpke_setup_receiver(\n337\t    kem: u16,\n338\t    cipher: HpkeCipherSuiteId,\n339\t    private_key: &[u8],\n340\t    enc: &[u8],\n341\t    info: &[u8],\n342\t) -> Option<Vec<u8>> {\n343\t    use hpke::{Deserializable, Kem as HpkeKem, OpModeR};\n344\t\n345\t    macro_rules! run_hpke {\n346\t        ($KemType:ty, $KdfType:ty, $AeadType:ty) => {{\n347\t            let sk =\n348\t                <$KemType as HpkeKem>::PrivateKey::from_bytes(private_key).ok()?;\n349\t            let ek =\n350\t                <$KemType as HpkeKem>::EncappedKey::from_bytes(enc).ok()?;\n351\t            let ctx = hpke::setup_receiver::<$AeadType, $KdfType, $KemType>(\n352\t                &OpModeR::Base,\n353\t                &sk,\n354\t                &ek,\n355\t                info,\n356\t            )\n357\t            .ok()?;\n358\t            let mut out = alloc::vec![0u8; 32];\n359\t            ctx.export(b\"picoquic ech key material\", &mut out).ok()?;\n360\t            Some(out)\n361\t        }};\n362\t    }\n363\t\n364\t    match (kem, cipher.kdf, cipher.aead) {\n365\t        (kem_id::X25519_SHA256, kdf_id::HKDF_SHA256, aead_id::AES_128_GCM) => {\n366\t            run_hpke!(\n367\t                hpke::kem::X25519HkdfSha256,\n368\t                hpke::kdf::HkdfSha256,\n369\t                hpke::aead::AesGcm128\n370\t            )\n371\t        }\n372\t        (kem_id::X25519_SHA256, kdf_id::HKDF_SHA256, aead_id::CHACHA20_POLY1305) => {\n373\t            run_hpke!(\n374\t                hpke::kem::X25519HkdfSha256,\n375\t                hpke::kdf::HkdfSha256,\n376\t                hpke::aead::ChaCha20Poly1305\n377\t            )\n378\t        }\n379\t        (kem_id::P256_SHA256, kdf_id::HKDF_SHA256, aead_id::AES_128_GCM) => {\n380\t            run_hpke!(\n381\t                hpke::kem::DhP256HkdfSha256,\n382\t                hpke::kdf::HkdfSha256,\n383\t                hpke::aead::AesGcm128\n384\t            )\n385\t        }\n386\t        (kem_id::P384_SHA384, kdf_id::HKDF_SHA384, aead_id::AES_256_GCM) => {\n387\t            run_hpke!(\n388\t                hpke::kem::DhP384HkdfSha384,\n389\t                hpke::kdf::HkdfSha384,\n390\t                hpke::aead::AesGcm256\n391\t            )\n392\t        }\n393\t        _ => None,\n394\t    }\n395\t}\n396\t\n397\t// ---------------------------------------------------------------------------\n398\t// TLS group-id → HPKE KEM-id mapping.\n399\t\n400\t/// TLS named-group identifiers (RFC 8446 §4.2.7, as used by picotls).\n401\tpub mod group_id {\n402\t    /// secp256r1 / P-256  (`PTLS_GROUP_SECP256R1`)\n403\t    pub const SECP256R1: u16 = 23;\n404\t    /// secp384r1 / P-384  (`PTLS_GROUP_SECP384R1`)\n405\t    pub const SECP384R1: u16 = 24;\n406\t    /// X25519             (`PTLS_GROUP_X25519`)\n407\t    pub const X25519: u16 = 29;\n408\t}\n409\t\n410\t/// Find the HPKE KEM identifier for the given TLS named-group id.\n411\t///\n412\t/// Mirrors the C loop over `picoquic_hpke_kems[]` that matches on\n413\t/// `picoquic_hpke_kems[i]->keyex->id == group_id`.\n414\t///\n415\t/// Returns `Some(kem_id)` on success, `None` when the group is not\n416\t/// one of the three supported curves.\n417\t///\n418\t/// C: `picoquic_ech_get_kem_from_curve`\n419\tpub fn ech_get_kem_from_curve(group_id: u16) -> Option<u16> {\n420\t    match group_id {\n421\t        group_id::SECP256R1 => Some(kem_id::P256_SHA256),\n422\t        group_id::SECP384R1 => Some(kem_id::P384_SHA384),\n423\t        group_id::X25519 => Some(kem_id::X25519_SHA256),\n424\t        _ => None,\n425\t    }\n426\t}\n427\t\n428\t// ---------------------------------------------------------------------------\n429\t// ASN.1 DER SubjectPublicKeyInfo parser.\n430\t\n431\t/// Parsed fields extracted from a DER-encoded SubjectPublicKeyInfo blob.\n432\t///\n433\t/// All slices borrow from the original input passed to\n434\t/// [`parse_public_key_asn1`], so their lifetime is tied to that input.\n435\t///\n436\t/// C: the four output parameters of `picoquic_parse_public_key_asn1`.\n437\tpub struct PublicKeyAsn1<'a> {\n438\t    /// Algorithm OID value bytes (tag + length stripped).\n439\t    ///\n440\t    /// C: `public_key_algo.{base,len}`\n441\t    pub algo: &'a [u8],\n442\t    /// Parameters field: raw bytes from after the algorithm OID to the\n443\t    /// end of the inner AlgorithmIdentifier SEQUENCE.  Includes the\n444\t    /// tag + length of any nested TLV; empty when there are no parameters\n445\t    /// (e.g. X25519 keys).\n446\t    ///\n447\t    /// C: `public_key_param.{base,len}`\n448\t    pub param: &'a [u8],\n449\t    /// BIT STRING value bytes.  The first byte is the padding-count\n450\t    /// (always `0x00` for the curves picoquic supports); the key bytes\n451\t    /// follow immediately.\n452\t    ///\n453\t    /// C: `public_key_bit_string.{base,len}`\n454\t    pub bit_string: &'a [u8],\n455\t    /// Total number of bytes consumed from the input.\n456\t    pub consumed: usize,\n457\t}\n458\t\n459\t/// Parse a DER TLV header at `pos` within `bytes[..bytes_max]`.\n460\t///\n461\t/// `expected_type` must match the tag byte.  Returns `(value_start, value_end)`\n462\t/// on success, `Err` on type mismatch, truncation, or overflow.\n463\tfn asn1_tlv(\n464\t    bytes: &[u8],\n465\t    bytes_max: usize,\n466\t    pos: usize,\n467\t    expected_type: u8,\n468\t) -> Result<(usize, usize), Error> {\n469\t    if pos >= bytes_max || bytes[pos] != expected_type {\n470\t        return Err(Error::Generic);\n471\t    }\n472\t    let pos = pos + 1;\n473\t    if pos >= bytes_max {\n474\t        return Err(Error::Generic);\n475\t    }\n476\t    let first = bytes[pos];\n477\t    let (length, val_start) = if first < 0x80 {\n478\t        (first as usize, pos + 1)\n479\t    } else {\n480\t        let n = (first & 0x7F) as usize;\n481\t        if n == 0 || pos + 1 + n > bytes_max {\n482\t            return Err(Error::Generic);\n483\t        }\n484\t        let mut len = 0usize;\n485\t        for i in 0..n {\n486\t            len = (len << 8) | (bytes[pos + 1 + i] as usize);\n487\t        }\n488\t        (len, pos + 1 + n)\n489\t    };\n490\t    let val_end = val_start + length;\n491\t    if val_end > bytes_max {\n492\t        return Err(Error::Generic);\n493\t    }\n494\t    Ok((val_start, val_end))\n495\t}\n496\t\n497\t/// Parse a DER-encoded SubjectPublicKeyInfo structure.\n498\t///\n499\t/// Walks the outer SEQUENCE → AlgorithmIdentifier SEQUENCE → OID +\n500\t/// optional parameters → BIT STRING layout described in RFC 5480 and\n501\t/// RFC 8410, returning zero-copy sub-slices into `input`.\n502\t///\n503\t/// Returns `Err(Error::Generic)` for any structural violation (wrong tag,\n504\t/// truncated length field, outer-sequence length mismatch, or trailing\n505\t/// bytes after the BIT STRING).\n506\t///\n507\t/// C: `picoquic_parse_public_key_asn1`\n508\tpub fn parse_public_key_asn1(input: &[u8]) -> Result<PublicKeyAsn1<'_>, Error> {\n509\t    let bytes_max = input.len();\n510\t\n511\t    // Outer SEQUENCE must span the entire buffer.\n512\t    let (outer_val, outer_end) = asn1_tlv(input, bytes_max, 0, 0x30)?;\n513\t    if outer_end != bytes_max {\n514\t        return Err(Error::Generic); // PTLS_ERROR_BER_EXCESSIVE_LENGTH\n515\t    }\n516\t\n517\t    // AlgorithmIdentifier SEQUENCE.\n518\t    let (inner_val, inner_end) = asn1_tlv(input, outer_end, outer_val, 0x30)?;\n519\t\n520\t    // Algorithm OID — value bytes only (tag + length consumed by asn1_tlv).\n521\t    let (oid_val, oid_end) = asn1_tlv(input, inner_end, inner_val, 0x06)?;\n522\t    let algo = &input[oid_val..oid_end];\n523\t\n524\t    // Parameters: everything remaining in the inner SEQUENCE after the OID.\n525\t    let param = if inner_end <= oid_end {\n526\t        &input[0..0]\n527\t    } else {\n528\t        &input[oid_end..inner_end]\n529\t    };\n530\t\n531\t    // BIT STRING (public key), must consume the rest of the outer SEQUENCE.\n532\t    let (bs_val, bs_end) = asn1_tlv(input, outer_end, inner_end, 0x03)?;\n533\t    if bs_end != outer_end {\n534\t        return Err(Error::Generic); // PTLS_ERROR_BER_ELEMENT_TOO_SHORT\n535\t    }\n536\t    let bit_string = &input[bs_val..bs_end];\n537\t\n538\t    Ok(PublicKeyAsn1 {\n539\t        algo,\n540\t        param,\n541\t        bit_string,\n542\t        consumed: bs_end,\n543\t    })\n544\t}\n545\t\n546\t// ---------------------------------------------------------------------------\n547\t// Base64 decoder (companion to `base64_encode`).\n548\t\n549\t/// Decode standard base64 (RFC 4648) from `input` into `out`.\n550\t///\n551\t/// Ignores whitespace and `=` padding characters.  Returns\n552\t/// `Err(Error::Generic)` for any non-base64, non-whitespace, non-padding\n553\t/// character.\n554\t///\n555\t/// C: `picoquic_base64_decode` (picoquic/ech.c:50)\n556\tfn base64_decode(input: &[u8], out: &mut Vec<u8>) -> Result<(), Error> {\n557\t    let decode_char = |c: u8| -> Option<u8> {\n558\t        match c {\n559\t            b'A'..=b'Z' => Some(c - b'A'),\n560\t            b'a'..=b'z' => Some(c - b'a' + 26),\n561\t            b'0'..=b'9' => Some(c - b'0' + 52),\n562\t            b'+' => Some(62),\n563\t            b'/' => Some(63),\n564\t            _ => None,\n565\t        }\n566\t    };\n567\t\n568\t    let mut accum: u32 = 0;\n569\t    let mut nbits: u32 = 0;\n570\t\n571\t    for &c in input {\n572\t        if c == b'=' || c == b'\\n' || c == b'\\r' || c == b' ' || c == b'\\t' {\n573\t            continue;\n574\t        }\n575\t        let v = decode_char(c).ok_or(Error::Generic)?;\n576\t        accum = (accum << 6) | v as u32;\n577\t        nbits += 6;\n578\t        if nbits >= 8 {\n579\t            nbits -= 8;\n580\t            out.push((accum >> nbits) as u8);\n581\t        }\n582\t    }\n583\t\n584\t    Ok(())\n585\t}\n586\t\n587\t// ---------------------------------------------------------------------------\n588\t// PEM / DER helpers for private key loading.\n589\t\n590\t/// Strip PEM header/footer lines and base64-decode the body.\n591\t///\n592\t/// Handles both bare base64 (no headers) and PEM-wrapped base64\n593\t/// (`-----BEGIN ...-----` / `-----END ...-----`).  Lines that start\n594\t/// with `-----` are silently skipped; all other content is fed to\n595\t/// [`base64_decode`].\n596\t///\n597\t/// Returns the decoded bytes.\n598\tfn pem_base64_decode(pem: &str) -> Result<Vec<u8>, Error> {\n599\t    let mut out = Vec::new();\n600\t    for line in pem.lines() {\n601\t        let line = line.trim();\n602\t        if line.starts_with(\"-----\") {\n603\t            continue;\n604\t        }\n605\t        base64_decode(line.as_bytes(), &mut out)?;\n606\t    }\n607\t    if out.is_empty() {\n608\t        return Err(Error::Generic);\n609\t    }\n610\t    Ok(out)\n611\t}\n612\t\n613\t/// Extract the raw scalar bytes of a private key from DER-encoded data.\n614\t///\n615\t/// Handles two wire formats:\n616\t///\n617\t/// * **RFC 5915** (`EC PRIVATE KEY`): `SEQUENCE { INTEGER 1, OCTET STRING\n618\t///   { key }, … }` — the private key scalar is the first OCTET STRING.\n619\t///\n620\t/// * **PKCS#8 / OneAsymmetricKey** (`PRIVATE KEY`): `SEQUENCE { INTEGER\n621\t///   0, AlgorithmIdentifier SEQUENCE, OCTET STRING { payload } }`.\n622\t///   The `payload` is either:\n623\t///   - A nested OCTET STRING (for OKP keys: X25519, etc.) whose\n624\t///     content is the raw scalar, or\n625\t///   - An ECPrivateKey SEQUENCE (for EC keys) — parsed as RFC 5915.\n626\tfn extract_private_key_der(der: &[u8], label: &str) -> Result<Vec<u8>, Error> {\n627\t    let bytes_max = der.len();\n628\t\n629\t    // Outer SEQUENCE.\n630\t    let (outer_val, outer_end) = asn1_tlv(der, bytes_max, 0, 0x30)?;\n631\t\n632\t    if label.contains(\"EC PRIVATE KEY\") {\n633\t        // RFC 5915: SEQUENCE { INTEGER version, OCTET STRING private_key, … }\n634\t        let (_, after_ver) = asn1_tlv(der, outer_end, outer_val, 0x02)?;\n635\t        let (pk_val, pk_end) = asn1_tlv(der, outer_end, after_ver, 0x04)?;\n636\t        Ok(der[pk_val..pk_end].to_vec())\n637\t    } else {\n638\t        // PKCS#8: SEQUENCE { INTEGER version, AlgorithmId SEQUENCE, OCTET STRING privateKey }\n639\t        let (_, after_ver) = asn1_tlv(der, outer_end, outer_val, 0x02)?;\n640\t        let (_, after_alg) = asn1_tlv(der, outer_end, after_ver, 0x30)?;\n641\t        let (pk_outer_val, pk_outer_end) = asn1_tlv(der, outer_end, after_alg, 0x04)?;\n642\t\n643\t        if pk_outer_val < pk_outer_end && der[pk_outer_val] == 0x04 {\n644\t            // Nested OCTET STRING: OKP / X25519 CurvePrivateKey.\n645\t            let (inner_val, inner_end) = asn1_tlv(der, pk_outer_end, pk_outer_val, 0x04)?;\n646\t            Ok(der[inner_val..inner_end].to_vec())\n647\t        } else if pk_outer_val < pk_outer_end && der[pk_outer_val] == 0x30 {\n648\t            // ECPrivateKey SEQUENCE inside the privateKey OCTET STRING.\n649\t            let (ec_val, ec_end) = asn1_tlv(der, pk_outer_end, pk_outer_val, 0x30)?;\n650\t            let (_, after_ec_ver) = asn1_tlv(der, ec_end, ec_val, 0x02)?;\n651\t            let (ec_pk_val, ec_pk_end) = asn1_tlv(der, ec_end, after_ec_ver, 0x04)?;\n652\t            Ok(der[ec_pk_val..ec_pk_end].to_vec())\n653\t        } else {\n654\t            Err(Error::Generic)\n655\t        }\n656\t    }\n657\t}\n658\t\n659\t// ---------------------------------------------------------------------------\n660\t// ECH config file reader.\n661\t\n662\t/// Read a base64-encoded ECHConfigList from a text file and return the\n663\t/// decoded binary bytes.\n664\t///\n665\t/// The file may contain PEM headers (`-----BEGIN ...-----` /\n666\t/// `-----END ...-----`) or bare base64.  The decoded bytes are the\n667\t/// ECHConfigList wire format: a 2-byte big-endian total-length prefix\n668\t/// followed by one or more ECHConfig entries.\n669\t///\n670\t/// C: `picoquic_ech_read_config` (picoquic/ech.c:98)\n671\tpub fn ech_read_config_file(config_file_name: &str) -> Result<Vec<u8>, Error> {\n672\t    let text = std::fs::read_to_string(config_file_name).map_err(|_| Error::Generic)?;\n673\t    pem_base64_decode(&text)\n674\t}\n675\t\n676\t// ---------------------------------------------------------------------------\n677\t// ECH config encoder.\n678\t\n679\t/// Encode a single ECHConfig into wire bytes (version + length +\n680\t/// ECHConfigContents).\n681\t///\n682\t/// The result is a self-contained ECHConfig entry suitable for inclusion\n683\t/// in an ECHConfigList.  The caller must prepend the 2-byte outer\n684\t/// ECHConfigList length when building the list.\n685\t///\n686\t/// C: `ptls_ech_encode_config` (picotls, called from\n687\t/// `picoquic_ech_create_config_from_pk`).\n688\tfn ech_encode_config(\n689\t    config_id: u8,\n690\t    kem_id: u16,\n691\t    public_key: &[u8],\n692\t    cipher_suites: &[HpkeCipherSuiteId],\n693\t    maximum_name_length: u8,\n694\t    public_name: &str,\n695\t) -> Result<Vec<u8>, Error> {\n696\t    let name_bytes = public_name.as_bytes();\n697\t    if name_bytes.len() > 255 {\n698\t        return Err(Error::Generic);\n699\t    }\n700\t\n701\t    // Compute the length of ECHConfigContents:\n702\t    //   config_id (1) + kem_id (2) + pk_len (2) + pk (N)\n703\t    //   + cs_len (2) + cs entries (4 * n)\n704\t    //   + max_name_len (1) + name_len (1) + name (L)\n705\t    //   + extensions_len (2)\n706\t    let pk_len = public_key.len();\n707\t    let cs_bytes = cipher_suites.len() * 4;\n708\t    let name_len = name_bytes.len();\n709\t    let contents_len = 1 + 2 + 2 + pk_len + 2 + cs_bytes + 1 + 1 + name_len + 2;\n710\t\n711\t    // ECHConfig wire: version (2) + contents_length (2) + contents.\n712\t    let mut buf = Vec::with_capacity(4 + contents_len);\n713\t\n714\t    // version = 0xFE0D (ECH draft-13+)\n715\t    buf.extend_from_slice(&0xFE0Du16.to_be_bytes());\n716\t    // ECHConfigContents length\n717\t    buf.extend_from_slice(&(contents_len as u16).to_be_bytes());\n718\t    // config_id\n719\t    buf.push(config_id);\n720\t    // kem_id\n721\t    buf.extend_from_slice(&kem_id.to_be_bytes());\n722\t    // public_key (2-byte length prefix)\n723\t    buf.extend_from_slice(&(pk_len as u16).to_be_bytes());\n724\t    buf.extend_from_slice(public_key);\n725\t    // cipher_suites (2-byte length prefix; each suite is kdf_id:2 + aead_id:2)\n726\t    buf.extend_from_slice(&(cs_bytes as u16).to_be_bytes());\n727\t    for cs in cipher_suites {\n728\t        buf.extend_from_slice(&cs.kdf.to_be_bytes());\n729\t        buf.extend_from_slice(&cs.aead.to_be_bytes());\n730\t    }\n731\t    // maximum_name_length\n732\t    buf.push(maximum_name_length);\n733\t    // public_name (1-byte length prefix)\n734\t    buf.push(name_len as u8);\n735\t    buf.extend_from_slice(name_bytes);\n736\t    // extensions (empty list, 2-byte length = 0)\n737\t    buf.extend_from_slice(&0u16.to_be_bytes());\n738\t\n739\t    Ok(buf)\n740\t}\n741\t\n742\t// ---------------------------------------------------------------------------\n743\t// ECH opener initialiser.\n744\t\n745\t/// Initialise a server-side ECH opener from on-disk key material.\n746\t///\n747\t/// Reads the binary ECH config from `config_file_name` (base64-encoded\n748\t/// ECHConfigList) and the EC/OKP private key from `private_key_file`\n749\t/// (PEM-encoded), then constructs and returns an [`EchOpenerState`].\n750\t///\n751\t/// The `config` field of the returned state is the decoded binary\n752\t/// ECHConfigList (2-byte outer length + ECHConfig).  The `private_key`\n753\t/// field is the raw scalar bytes required by the HPKE `PrivateKey::from_bytes`\n754\t/// call in [`EchOpenerState::open`].\n755\t///\n756\t/// C: `ech_init_opener_callback` (picoquic/ech.c:280)\n757\tpub fn ech_init_opener(\n758\t    private_key_file: &str,\n759\t    config_file_name: &str,\n760\t) -> Result<EchOpenerState, Error> {\n761\t    // Read and decode the ECHConfigList from the base64-encoded config file.\n762\t    let config = ech_read_config_file(config_file_name)?;\n763\t\n764\t    // Extract kem_id from ECHConfigList bytes[7:9]:\n765\t    //   bytes[0:2] = ECHConfigList outer length\n766\t    //   bytes[2:4] = ECHConfig version (0xFE0D)\n767\t    //   bytes[4:6] = ECHConfig contents length\n768\t    //   bytes[6]   = config_id\n769\t    //   bytes[7:9] = kem_id\n770\t    if config.len() < 9 {\n771\t        return Err(Error::Generic);\n772\t    }\n773\t    let kem_id = (config[7] as u16) << 8 | config[8] as u16;\n774\t\n775\t    // Validate the kem_id against the supported set.\n776\t    if !matches!(\n777\t        kem_id,\n778\t        kem_id::P256_SHA256 | kem_id::P384_SHA384 | kem_id::X25519_SHA256\n779\t    ) {\n780\t        return Err(Error::Generic);\n781\t    }\n782\t\n783\t    // Read and parse the PEM private key file.\n784\t    let pem_text = std::fs::read_to_string(private_key_file).map_err(|_| Error::Generic)?;\n785\t    // Determine the key format from the PEM label.\n786\t    let label_start = pem_text.find(\"-----BEGIN \").ok_or(Error::Generic)? + \"-----BEGIN \".len();\n787\t    let label_end = pem_text[label_start..]\n788\t        .find(\"-----\")\n789\t        .ok_or(Error::Generic)?;\n790\t    let label = &pem_text[label_start..label_start + label_end];\n791\t\n792\t    let der = pem_base64_decode(&pem_text)?;\n793\t    let private_key = extract_private_key_der(&der, label)?;\n794\t\n795\t    Ok(EchOpenerState {\n796\t        kem_id,\n797\t        private_key,\n798\t        config,\n799\t    })\n800\t}\n801\t\n802\t// ---------------------------------------------------------------------------\n803\t// ECH config builder from a public key.\n804\t\n805\t/// Build an ECHConfig entry from an ASN.1 public key and a server public\n806\t/// name, returning the raw ECHConfig wire bytes.\n807\t///\n808\t/// 1. Derives the HPKE KEM from `group_id` (one of the TLS named-group\n809\t///    identifiers in [`group_id`]).\n810\t/// 2. Selects the preferred cipher suites for that KEM via\n811\t///    [`ech_get_ciphers_from_kem`].\n812\t/// 3. Computes a one-byte config-ID by XOR-folding the key material,\n813\t///    KEM id, cipher-suite ids, and the public name.\n814\t/// 4. Encodes the full ECHConfig wire structure.\n815\t///\n816\t/// The returned `Vec<u8>` is one ECHConfig (without the outer\n817\t/// ECHConfigList 2-byte total-length prefix).  Wrap it with that prefix\n818\t/// to obtain a complete ECHConfigList.\n819\t///\n820\t/// C: `picoquic_ech_create_config_from_pk` (picoquic/ech.c:802)\n821\tpub fn ech_create_config_from_pk(\n822\t    group_id: u16,\n823\t    public_key_bits: &[u8],\n824\t    public_name: &str,\n825\t) -> Result<Vec<u8>, Error> {\n826\t    // Derive KEM id from the TLS named-group id.\n827\t    let kem_id = ech_get_kem_from_curve(group_id).ok_or(Error::Generic)?;\n828\t\n829\t    // Collect the preferred cipher suites for this KEM.\n830\t    let mut cipher_buf = [HpkeCipherSuiteId { kdf: 0, aead: 0 }; 5];\n831\t    let n_ciphers = ech_get_ciphers_from_kem(kem_id, &mut cipher_buf)?;\n832\t    let cipher_suites = &cipher_buf[..n_ciphers];\n833\t\n834\t    // Compute a one-byte config-ID from all the key material.\n835\t    let config_id = ech_config_id_from_config(public_key_bits, kem_id, cipher_suites, public_name);\n836\t\n837\t    // Encode and return the ECHConfig wire bytes.\n838\t    ech_encode_config(\n839\t        config_id,\n840\t        kem_id,\n841\t        public_key_bits,\n842\t        cipher_suites,\n843\t        255,\n844\t        public_name,\n845\t    )\n846\t}\n847\t\n848\t// ---------------------------------------------------------------------------\n849\t// Tests.\n850\t\n851\t#[cfg(test)]\n852\tmod tests {\n853\t    use super::*;\n854\t\n855\t    #[test]\n856\t    fn base64_encode_empty() {\n857\t        let mut buf = [0u8; 1];\n858\t        let n = base64_encode(&[], &mut buf).unwrap();\n859\t        assert_eq!(n, 0);\n860\t        assert_eq!(buf[0], 0);\n861\t    }\n862\t\n863\t    #[test]\n864\t    fn base64_encode_three_bytes() {\n865\t        // \"Man\" → \"TWFu\"\n866\t        let mut buf = [0u8; 5];\n867\t        let n = base64_encode(b\"Man\", &mut buf).unwrap();\n868\t        assert_eq!(n, 4);\n869\t        assert_eq!(&buf[..4], b\"TWFu\");\n870\t        assert_eq!(buf[4], 0);\n871\t    }\n872\t\n873\t    #[test]\n874\t    fn base64_encode_padding_one() {\n875\t        // \"M\" → \"TQ==\"\n876\t        let mut buf = [0u8; 5];\n877\t        let n = base64_encode(b\"M\", &mut buf).unwrap();\n878\t        assert_eq!(n, 4);\n879\t        assert_eq!(&buf[..4], b\"TQ==\");\n880\t    }\n881\t\n882\t    #[test]\n883\t    fn base64_encode_padding_two() {\n884\t        // \"Ma\" → \"TWE=\"\n885\t        let mut buf = [0u8; 5];\n886\t        let n = base64_encode(b\"Ma\", &mut buf).unwrap();\n887\t        assert_eq!(n, 4);\n888\t        assert_eq!(&buf[..4], b\"TWE=\");\n889\t    }\n890\t\n891\t    #[test]\n892\t    fn base64_encode_buffer_too_small() {\n893\t        let mut buf = [0u8; 4]; // needs 5 (4 chars + NUL)\n894\t        assert!(base64_encode(b\"Man\", &mut buf).is_err());\n895\t    }\n896\t\n897\t    #[test]\n898\t    fn base64_encoded_len_values() {\n899\t        assert_eq!(base64_encoded_len(0), 0);\n900\t        assert_eq!(base64_encoded_len(1), 4);\n901\t        assert_eq!(base64_encoded_len(2), 4);\n902\t        assert_eq!(base64_encoded_len(3), 4);\n903\t        assert_eq!(base64_encoded_len(4), 8);\n904\t        assert_eq!(base64_encoded_len(6), 8);\n905\t    }\n906\t\n907\t    #[test]\n908\t    fn ech_get_ciphers_p256() {\n909\t        let mut out = [HpkeCipherSuiteId { kdf: 0, aead: 0 }; 4];\n910\t        let n = ech_get_ciphers_from_kem(kem_id::P256_SHA256, &mut out).unwrap();\n911\t        assert!(n >= 1);\n912\t        assert_eq!(out[0].kdf, kdf_id::HKDF_SHA256);\n913\t        assert_eq!(out[0].aead, aead_id::AES_128_GCM);\n914\t    }\n915\t\n916\t    #[test]\n917\t    fn ech_get_ciphers_p384() {\n918\t        let mut out = [HpkeCipherSuiteId { kdf: 0, aead: 0 }; 4];\n919\t        let n = ech_get_ciphers_from_kem(kem_id::P384_SHA384, &mut out).unwrap();\n920\t        assert!(n >= 1);\n921\t        assert_eq!(out[0].kdf, kdf_id::HKDF_SHA384);\n922\t        assert_eq!(out[0].aead, aead_id::AES_256_GCM);\n923\t    }\n924\t\n925\t    #[test]\n926\t    fn ech_get_ciphers_x25519() {\n927\t        let mut out = [HpkeCipherSuiteId { kdf: 0, aead: 0 }; 4];\n928\t        let n = ech_get_ciphers_from_kem(kem_id::X25519_SHA256, &mut out).unwrap();\n929\t        assert!(n >= 1);\n930\t        assert_eq!(out[0].kdf, kdf_id::HKDF_SHA256);\n931\t        assert_eq!(out[0].aead, aead_id::CHACHA20_POLY1305);\n932\t    }\n933\t\n934\t    #[test]\n935\t    fn ech_get_ciphers_out_too_small() {\n936\t        let mut out = [HpkeCipherSuiteId { kdf: 0, aead: 0 }; 1];\n937\t        assert!(ech_get_ciphers_from_kem(kem_id::P256_SHA256, &mut out).is_err());\n938\t    }\n939\t\n940\t    #[test]\n941\t    fn config_id_is_deterministic() {\n942\t        let key = [1u8, 2, 3, 4];\n943\t        let suites = [HpkeCipherSuiteId {\n944\t            kdf: kdf_id::HKDF_SHA256,\n945\t            aead: aead_id::AES_128_GCM,\n946\t        }];\n947\t        let id1 = ech_config_id_from_config(&key, kem_id::X25519_SHA256, &suites, \"example.com\");\n948\t        let id2 = ech_config_id_from_config(&key, kem_id::X25519_SHA256, &suites, \"example.com\");\n949\t        assert_eq!(id1, id2);\n950\t    }\n951\t\n952\t    #[test]\n953\t    fn config_id_changes_with_key() {\n954\t        let suites = [HpkeCipherSuiteId {\n955\t            kdf: kdf_id::HKDF_SHA256,\n956\t            aead: aead_id::AES_128_GCM,\n957\t        }];\n958\t        let id1 =\n959\t            ech_config_id_from_config(&[1, 2, 3], kem_id::X25519_SHA256, &suites, \"example.com\");\n960\t        let id2 =\n961\t            ech_config_id_from_config(&[4, 5, 6], kem_id::X25519_SHA256, &suites, \"example.com\");\n962\t        assert_ne!(id1, id2);\n963\t    }\n964\t\n965\t    #[test]\n966\t    fn kem_from_curve_known_groups() {\n967\t        assert_eq!(\n968\t            ech_get_kem_from_curve(group_id::SECP256R1),\n969\t            Some(kem_id::P256_SHA256)\n970\t        );\n971\t        assert_eq!(\n972\t            ech_get_kem_from_curve(group_id::SECP384R1),\n973\t            Some(kem_id::P384_SHA384)\n974\t        );\n975\t        assert_eq!(\n976\t            ech_get_kem_from_curve(group_id::X25519),\n977\t            Some(kem_id::X25519_SHA256)\n978\t        );\n979\t    }\n980\t\n981\t    #[test]\n982\t    fn kem_from_curve_unknown() {\n983\t        assert_eq!(ech_get_kem_from_curve(0xFFFF), None);\n984\t    }\n985\t\n986\t    // Minimal DER-encoded SubjectPublicKeyInfo for X25519 (RFC 8410):\n987\t    // SEQUENCE {\n988\t    //   SEQUENCE { OID 1.3.101.110 }        -- id-X25519\n989\t    //   BIT STRING { 0x00 <32 zero bytes> }  -- fake key, padding=0\n990\t    // }\n991\t    fn x25519_spki() -> Vec<u8> {\n992\t        let oid: &[u8] = &[0x2b, 0x65, 0x6e]; // 1.3.101.110\n993\t        // inner SEQUENCE: OID TLV\n994\t        let mut inner = Vec::new();\n995\t        inner.push(0x06);\n996\t        inner.push(oid.len() as u8);\n997\t        inner.extend_from_slice(oid);\n998\t        // BIT STRING: padding byte + 32-byte key\n999\t        let mut bs_val = vec![0x00u8]; // padding count\n1000\t        bs_val.extend_from_slice(&[0xABu8; 32]);\n1001\t        let mut outer = Vec::new();\n1002\t        // inner SEQUENCE TLV\n1003\t        outer.push(0x30);\n1004\t        outer.push(inner.len() as u8);\n1005\t        outer.extend_from_slice(&inner);\n1006\t        // BIT STRING TLV\n1007\t        outer.push(0x03);\n1008\t        outer.push(bs_val.len() as u8);\n1009\t        outer.extend_from_slice(&bs_val);\n1010\t        // wrap in outer SEQUENCE\n1011\t        let mut spki = Vec::new();\n1012\t        spki.push(0x30);\n1013\t        spki.push(outer.len() as u8);\n1014\t        spki.extend_from_slice(&outer);\n1015\t        spki\n1016\t    }\n1017\t\n1018\t    #[test]\n1019\t    fn parse_public_key_asn1_x25519() {\n1020\t        let spki = x25519_spki();\n1021\t        let r = parse_public_key_asn1(&spki).unwrap();\n1022\t        assert_eq!(r.algo, &[0x2b, 0x65, 0x6e]);\n1023\t        assert_eq!(r.param, &[] as &[u8]); // X25519 has no parameters\n1024\t        assert_eq!(r.bit_string[0], 0x00); // padding byte\n1025\t        assert_eq!(r.bit_string.len(), 33); // 1 + 32 key bytes\n1026\t        assert_eq!(r.consumed, spki.len());\n1027\t    }\n1028\t\n1029\t    #[test]\n1030\t    fn parse_public_key_asn1_truncated() {\n1031\t        let spki = x25519_spki();\n1032\t        assert!(parse_public_key_asn1(&spki[..4]).is_err());\n1033\t    }\n1034\t\n1035\t    #[test]\n1036\t    fn parse_public_key_asn1_wrong_outer_tag() {\n1037\t        let mut spki = x25519_spki();\n1038\t        spki[0] = 0x31; // SET instead of SEQUENCE\n1039\t        assert!(parse_public_key_asn1(&spki).is_err());\n1040\t    }\n1041\t}\n1042\t"}]},"parent_tool_use_id":null,"session_id":"83fff6f3-c332-4b5d-b717-1fbf70423982","uuid":"dd57ee37-96cf-463f-95af-1530307d28d0","timestamp":"2026-05-07T14:31:20.023Z","tool_use_result":{"type":"text","file":{"filePath":"/Users/richbarn/Projects/picoquic/rs/fq/src/ech.rs","content":"//! Encrypted ClientHello (ECH) helpers.\n//!\n//! Pure-Rust portion of the ECH support layer, fully translated from\n//! `picoquic/ech.c`.  HPKE key-exchange (DHKEM-X25519, DHKEM-P256,\n//! DHKEM-P384) is implemented via the `hpke` crate; the remaining logic\n//! — cipher-suite selection, config-ID derivation, base64 encoding, and\n//! opener-state plumbing — is translated directly.\n\nextern crate alloc;\nuse alloc::vec::Vec;\n\nuse crate::Error;\n\n// ---------------------------------------------------------------------------\n// HPKE constants (IANA registries, RFC 9180).\n\n/// HPKE KEM algorithm identifiers (RFC 9180 §7.1).\npub mod kem_id {\n    /// DHKEM(P-256, HKDF-SHA256)\n    pub const P256_SHA256: u16 = 0x0010;\n    /// DHKEM(P-384, HKDF-SHA384)\n    pub const P384_SHA384: u16 = 0x0011;\n    /// DHKEM(X25519, HKDF-SHA256)\n    pub const X25519_SHA256: u16 = 0x0020;\n}\n\n/// HPKE KDF algorithm identifiers (RFC 9180 §7.2).\npub mod kdf_id {\n    /// HKDF-SHA256\n    pub const HKDF_SHA256: u16 = 0x0001;\n    /// HKDF-SHA384\n    pub const HKDF_SHA384: u16 = 0x0002;\n    /// HKDF-SHA512\n    pub const HKDF_SHA512: u16 = 0x0003;\n}\n\n/// HPKE AEAD algorithm identifiers (RFC 9180 §7.3).\npub mod aead_id {\n    /// AES-128-GCM\n    pub const AES_128_GCM: u16 = 0x0001;\n    /// AES-256-GCM\n    pub const AES_256_GCM: u16 = 0x0002;\n    /// ChaCha20-Poly1305\n    pub const CHACHA20_POLY1305: u16 = 0x0003;\n}\n\n// ---------------------------------------------------------------------------\n// Cipher-suite identifier.\n\n/// HPKE symmetric cipher-suite: (KDF id, AEAD id) pair.\n///\n/// C: `ptls_hpke_cipher_suite_id_t`\n#[derive(Debug, Clone, Copy, PartialEq, Eq)]\npub struct HpkeCipherSuiteId {\n    pub kdf: u16,\n    pub aead: u16,\n}\n\n/// The three cipher suites we advertise as supported, mirroring the\n/// `picoquic_hpke_cipher_suites[]` array that the C picotls backend\n/// populates at startup.\nconst SUPPORTED_CIPHER_SUITES: &[HpkeCipherSuiteId] = &[\n    HpkeCipherSuiteId {\n        kdf: kdf_id::HKDF_SHA256,\n        aead: aead_id::AES_128_GCM,\n    },\n    HpkeCipherSuiteId {\n        kdf: kdf_id::HKDF_SHA256,\n        aead: aead_id::CHACHA20_POLY1305,\n    },\n    HpkeCipherSuiteId {\n        kdf: kdf_id::HKDF_SHA384,\n        aead: aead_id::AES_256_GCM,\n    },\n];\n\n// ---------------------------------------------------------------------------\n// Base64 encoding.\n\nconst BASE64_ALPHABET: &[u8; 64] =\n    b\"ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789+/\";\n\n/// Return the number of base64 characters needed to encode `input_len` bytes,\n/// not counting a NUL terminator.  Mirrors `ptls_base64_howlong`.\n#[inline]\npub fn base64_encoded_len(input_len: usize) -> usize {\n    input_len.div_ceil(3) * 4\n}\n\n/// Encode `input` as standard RFC 4648 base64 into `out`.\n///\n/// `out` must be at least `base64_encoded_len(input.len()) + 1` bytes long\n/// (the extra byte is for the NUL terminator written to match picotls\n/// convention).  Returns the number of base64 characters written (excluding\n/// the NUL).  Returns `Err(Error::Generic)` when `out` is too small.\n///\n/// C: `picoquic_base64_encode`\npub fn base64_encode(input: &[u8], out: &mut [u8]) -> Result<usize, Error> {\n    let len = base64_encoded_len(input.len());\n    if len + 1 > out.len() {\n        return Err(Error::Generic);\n    }\n    let mut pos = 0usize;\n    let mut chunks = input.chunks_exact(3);\n    for chunk in &mut chunks {\n        let b = ((chunk[0] as u32) << 16) | ((chunk[1] as u32) << 8) | (chunk[2] as u32);\n        out[pos] = BASE64_ALPHABET[((b >> 18) & 0x3f) as usize];\n        out[pos + 1] = BASE64_ALPHABET[((b >> 12) & 0x3f) as usize];\n        out[pos + 2] = BASE64_ALPHABET[((b >> 6) & 0x3f) as usize];\n        out[pos + 3] = BASE64_ALPHABET[(b & 0x3f) as usize];\n        pos += 4;\n    }\n    match chunks.remainder() {\n        [a] => {\n            let b = (*a as u32) << 16;\n            out[pos] = BASE64_ALPHABET[((b >> 18) & 0x3f) as usize];\n            out[pos + 1] = BASE64_ALPHABET[((b >> 12) & 0x3f) as usize];\n            out[pos + 2] = b'=';\n            out[pos + 3] = b'=';\n            pos += 4;\n        }\n        [a, b] => {\n            let v = ((*a as u32) << 16) | ((*b as u32) << 8);\n            out[pos] = BASE64_ALPHABET[((v >> 18) & 0x3f) as usize];\n            out[pos + 1] = BASE64_ALPHABET[((v >> 12) & 0x3f) as usize];\n            out[pos + 2] = BASE64_ALPHABET[((v >> 6) & 0x3f) as usize];\n            out[pos + 3] = b'=';\n            pos += 4;\n        }\n        _ => {}\n    }\n    out[pos] = 0; // NUL terminator (mirrors ptls_base64_encode convention)\n    Ok(len)\n}\n\n// ---------------------------------------------------------------------------\n// Cipher-suite selector.\n\n/// Fill `out` with HPKE cipher suites appropriate for `kem_id`, returning\n/// the number of entries written.\n///\n/// The first entry is the preferred suite for the given KEM; when there is\n/// also a suitable default suite (AES-128-GCM + HKDF-SHA256) that differs\n/// from the preferred one and `out.len() > 2`, it is appended as the second\n/// entry.\n///\n/// Returns `Err(Error::Generic)` if `out.len() < 2` (mirrors the C guard\n/// `cipher_vec_nb_max < 2`) or if no suite can be found.\n///\n/// C: `picoquic_ech_get_ciphers_from_kem`\npub fn ech_get_ciphers_from_kem(\n    kem_id: u16,\n    out: &mut [HpkeCipherSuiteId],\n) -> Result<usize, Error> {\n    if out.len() < 2 {\n        return Err(Error::Generic);\n    }\n\n    let (target_kdf, target_aead) = match kem_id {\n        kem_id::P256_SHA256 => (kdf_id::HKDF_SHA256, aead_id::AES_128_GCM),\n        kem_id::P384_SHA384 => (kdf_id::HKDF_SHA384, aead_id::AES_256_GCM),\n        kem_id::X25519_SHA256 => (kdf_id::HKDF_SHA256, aead_id::CHACHA20_POLY1305),\n        _ => (kdf_id::HKDF_SHA256, aead_id::AES_128_GCM),\n    };\n    let target = HpkeCipherSuiteId {\n        kdf: target_kdf,\n        aead: target_aead,\n    };\n    let default_suite = HpkeCipherSuiteId {\n        kdf: kdf_id::HKDF_SHA256,\n        aead: aead_id::AES_128_GCM,\n    };\n\n    let mut target_cipher: Option<HpkeCipherSuiteId> = None;\n    let mut default_cipher: Option<HpkeCipherSuiteId> = None;\n\n    for &suite in SUPPORTED_CIPHER_SUITES {\n        if target_cipher.is_none() && suite == target {\n            target_cipher = Some(suite);\n        }\n        if default_cipher.is_none() && suite == default_suite {\n            default_cipher = Some(suite);\n        }\n    }\n\n    // Mirrors the C branching: target first; fall back to default; error if neither.\n    // C: `cipher_vec_nb_max > 2` guards adding the default as a second entry.\n    let nb_ciphers = match (target_cipher, default_cipher) {\n        (Some(t), def) => {\n            out[0] = t;\n            if let Some(d) = def {\n                if d != t && out.len() > 2 {\n                    out[1] = d;\n                    2\n                } else {\n                    1\n                }\n            } else {\n                1\n            }\n        }\n        (None, Some(d)) => {\n            out[0] = d;\n            1\n        }\n        (None, None) => return Err(Error::Generic),\n    };\n    Ok(nb_ciphers)\n}\n\n// ---------------------------------------------------------------------------\n// Config-ID derivation (private helper).\n\n/// Compute the one-byte ECH config-ID from the public key material, KEM id,\n/// cipher suites, and the server public name.\n///\n/// The algorithm accumulates all bytes into a `u64` then XOR-folds the\n/// result down to a single byte.\n///\n/// C: `ech_config_id_from_config` (file-static)\nfn ech_config_id_from_config(\n    public_key_bits: &[u8],\n    kem_id: u16,\n    cipher_suites: &[HpkeCipherSuiteId],\n    public_name: &str,\n) -> u8 {\n    let mut config_sum: u64 = 0;\n    for &b in public_key_bits {\n        config_sum = config_sum.wrapping_add(b as u64);\n    }\n    config_sum = config_sum.wrapping_add(kem_id as u64);\n    for cs in cipher_suites {\n        config_sum = config_sum.wrapping_add(cs.aead as u64);\n        config_sum = config_sum.wrapping_add(cs.kdf as u64);\n    }\n    for b in public_name.bytes() {\n        config_sum = config_sum.wrapping_add(b as u64);\n    }\n    let mut config_id: u8 = 0;\n    while config_sum > 0 {\n        config_id ^= (config_sum & 0xff) as u8;\n        config_sum >>= 8;\n    }\n    config_id\n}\n\n// ---------------------------------------------------------------------------\n// Server-side ECH opener state.\n\n/// Result returned by a successful [`EchOpenerState::open`] call.\n///\n/// `key_material` holds the HPKE-derived key material exported from the\n/// receiver context; callers build the concrete AEAD context from it\n/// together with `cipher`.\npub struct EchOpenResult {\n    /// The negotiated cipher suite.\n    pub cipher: HpkeCipherSuiteId,\n    /// HPKE-exported key material (32 bytes) derived via RFC 9180\n    /// `Context.Export`.  Callers use this to construct the AEAD context for\n    /// decrypting the ECH inner ClientHello.\n    pub key_material: Vec<u8>,\n}\n\n/// Server-side ECH opener callback state.\n///\n/// Holds the KEM id, the private key bytes used for HPKE decapsulation,\n/// and the serialised ECH config bytes (used to reconstruct the HPKE `info`\n/// string during opening).\n///\n/// C: `ech_opener_callback_t`\npub struct EchOpenerState {\n    /// HPKE KEM identifier, e.g. `kem_id::X25519_SHA256`.\n    /// C: `kem` (`ptls_hpke_kem_t*`; we store only the numeric id).\n    pub kem_id: u16,\n    /// Raw private key bytes for HPKE decapsulation.\n    /// C: `keyex` (`ptls_key_exchange_context_t*` loaded from a PEM file).\n    pub private_key: Vec<u8>,\n    /// Serialised ECH config bytes including the two-byte outer length prefix.\n    /// C: `config` (`ptls_buffer_t`).\n    pub config: Vec<u8>,\n}\n\nimpl EchOpenerState {\n    /// Attempt to open (decapsulate) an incoming ECH extension.\n    ///\n    /// Finds the cipher suite matching `cipher_id` in the supported list,\n    /// builds the HPKE `info` string as `info_prefix || config[2..]`, then\n    /// performs HPKE base-mode receiver setup (RFC 9180 §5.1.1) to derive\n    /// the AEAD key material.\n    ///\n    /// Returns `Some(EchOpenResult)` on success, `None` when `cipher_id` is\n    /// not in the supported list or the key bytes cannot be deserialized.\n    ///\n    /// C: `ech_opener_callback`\n    pub fn open(\n        &self,\n        cipher_id: HpkeCipherSuiteId,\n        enc: &[u8],\n        info_prefix: &[u8],\n    ) -> Option<EchOpenResult> {\n        // Find the matching cipher suite in the supported list.\n        let cipher = SUPPORTED_CIPHER_SUITES\n            .iter()\n            .copied()\n            .find(|c| c.kdf == cipher_id.kdf && c.aead == cipher_id.aead)?;\n\n        // Build info = info_prefix || config[2..]\n        // (config[0..2] is the two-byte ECHConfigList outer length prefix,\n        // skipped to match the `ptls_buffer_pushv(&infobuf, config.base+2, …)`\n        // call in the C implementation.)\n        let config_payload = self.config.get(2..).unwrap_or(&[]);\n        let mut info = Vec::with_capacity(info_prefix.len() + config_payload.len());\n        info.extend_from_slice(info_prefix);\n        info.extend_from_slice(config_payload);\n\n        // HPKE base-mode receiver setup (equivalent to ptls_hpke_setup_base_r).\n        let key_material = hpke_setup_receiver(self.kem_id, cipher, &self.private_key, enc, &info)?;\n        Some(EchOpenResult {\n            cipher,\n            key_material,\n        })\n    }\n}\n\n// ---------------------------------------------------------------------------\n// HPKE receiver setup dispatcher.\n\n/// Perform HPKE base-mode receiver setup (RFC 9180 §5.1.1) for the given\n/// `(kem, cipher)` combination and return 32 bytes of exported key material\n/// via `Context.Export`.  Returns `None` on key-format mismatch or an\n/// unknown algorithm combination.\n///\n/// Dispatches over the three KEM/KDF/AEAD triples that picoquic supports.\n/// The C equivalent is the `ptls_hpke_setup_base_r` call inside\n/// `ech_opener_callback`.\nfn hpke_setup_receiver(\n    kem: u16,\n    cipher: HpkeCipherSuiteId,\n    private_key: &[u8],\n    enc: &[u8],\n    info: &[u8],\n) -> Option<Vec<u8>> {\n    use hpke::{Deserializable, Kem as HpkeKem, OpModeR};\n\n    macro_rules! run_hpke {\n        ($KemType:ty, $KdfType:ty, $AeadType:ty) => {{\n            let sk =\n                <$KemType as HpkeKem>::PrivateKey::from_bytes(private_key).ok()?;\n            let ek =\n                <$KemType as HpkeKem>::EncappedKey::from_bytes(enc).ok()?;\n            let ctx = hpke::setup_receiver::<$AeadType, $KdfType, $KemType>(\n                &OpModeR::Base,\n                &sk,\n                &ek,\n                info,\n            )\n            .ok()?;\n            let mut out = alloc::vec![0u8; 32];\n            ctx.export(b\"picoquic ech key material\", &mut out).ok()?;\n            Some(out)\n        }};\n    }\n\n    match (kem, cipher.kdf, cipher.aead) {\n        (kem_id::X25519_SHA256, kdf_id::HKDF_SHA256, aead_id::AES_128_GCM) => {\n            run_hpke!(\n                hpke::kem::X25519HkdfSha256,\n                hpke::kdf::HkdfSha256,\n                hpke::aead::AesGcm128\n            )\n        }\n        (kem_id::X25519_SHA256, kdf_id::HKDF_SHA256, aead_id::CHACHA20_POLY1305) => {\n            run_hpke!(\n                hpke::kem::X25519HkdfSha256,\n                hpke::kdf::HkdfSha256,\n                hpke::aead::ChaCha20Poly1305\n            )\n        }\n        (kem_id::P256_SHA256, kdf_id::HKDF_SHA256, aead_id::AES_128_GCM) => {\n            run_hpke!(\n                hpke::kem::DhP256HkdfSha256,\n                hpke::kdf::HkdfSha256,\n                hpke::aead::AesGcm128\n            )\n        }\n        (kem_id::P384_SHA384, kdf_id::HKDF_SHA384, aead_id::AES_256_GCM) => {\n            run_hpke!(\n                hpke::kem::DhP384HkdfSha384,\n                hpke::kdf::HkdfSha384,\n                hpke::aead::AesGcm256\n            )\n        }\n        _ => None,\n    }\n}\n\n// ---------------------------------------------------------------------------\n// TLS group-id → HPKE KEM-id mapping.\n\n/// TLS named-group identifiers (RFC 8446 §4.2.7, as used by picotls).\npub mod group_id {\n    /// secp256r1 / P-256  (`PTLS_GROUP_SECP256R1`)\n    pub const SECP256R1: u16 = 23;\n    /// secp384r1 / P-384  (`PTLS_GROUP_SECP384R1`)\n    pub const SECP384R1: u16 = 24;\n    /// X25519             (`PTLS_GROUP_X25519`)\n    pub const X25519: u16 = 29;\n}\n\n/// Find the HPKE KEM identifier for the given TLS named-group id.\n///\n/// Mirrors the C loop over `picoquic_hpke_kems[]` that matches on\n/// `picoquic_hpke_kems[i]->keyex->id == group_id`.\n///\n/// Returns `Some(kem_id)` on success, `None` when the group is not\n/// one of the three supported curves.\n///\n/// C: `picoquic_ech_get_kem_from_curve`\npub fn ech_get_kem_from_curve(group_id: u16) -> Option<u16> {\n    match group_id {\n        group_id::SECP256R1 => Some(kem_id::P256_SHA256),\n        group_id::SECP384R1 => Some(kem_id::P384_SHA384),\n        group_id::X25519 => Some(kem_id::X25519_SHA256),\n        _ => None,\n    }\n}\n\n// ---------------------------------------------------------------------------\n// ASN.1 DER SubjectPublicKeyInfo parser.\n\n/// Parsed fields extracted from a DER-encoded SubjectPublicKeyInfo blob.\n///\n/// All slices borrow from the original input passed to\n/// [`parse_public_key_asn1`], so their lifetime is tied to that input.\n///\n/// C: the four output parameters of `picoquic_parse_public_key_asn1`.\npub struct PublicKeyAsn1<'a> {\n    /// Algorithm OID value bytes (tag + length stripped).\n    ///\n    /// C: `public_key_algo.{base,len}`\n    pub algo: &'a [u8],\n    /// Parameters field: raw bytes from after the algorithm OID to the\n    /// end of the inner AlgorithmIdentifier SEQUENCE.  Includes the\n    /// tag + length of any nested TLV; empty when there are no parameters\n    /// (e.g. X25519 keys).\n    ///\n    /// C: `public_key_param.{base,len}`\n    pub param: &'a [u8],\n    /// BIT STRING value bytes.  The first byte is the padding-count\n    /// (always `0x00` for the curves picoquic supports); the key bytes\n    /// follow immediately.\n    ///\n    /// C: `public_key_bit_string.{base,len}`\n    pub bit_string: &'a [u8],\n    /// Total number of bytes consumed from the input.\n    pub consumed: usize,\n}\n\n/// Parse a DER TLV header at `pos` within `bytes[..bytes_max]`.\n///\n/// `expected_type` must match the tag byte.  Returns `(value_start, value_end)`\n/// on success, `Err` on type mismatch, truncation, or overflow.\nfn asn1_tlv(\n    bytes: &[u8],\n    bytes_max: usize,\n    pos: usize,\n    expected_type: u8,\n) -> Result<(usize, usize), Error> {\n    if pos >= bytes_max || bytes[pos] != expected_type {\n        return Err(Error::Generic);\n    }\n    let pos = pos + 1;\n    if pos >= bytes_max {\n        return Err(Error::Generic);\n    }\n    let first = bytes[pos];\n    let (length, val_start) = if first < 0x80 {\n        (first as usize, pos + 1)\n    } else {\n        let n = (first & 0x7F) as usize;\n        if n == 0 || pos + 1 + n > bytes_max {\n            return Err(Error::Generic);\n        }\n        let mut len = 0usize;\n        for i in 0..n {\n            len = (len << 8) | (bytes[pos + 1 + i] as usize);\n        }\n        (len, pos + 1 + n)\n    };\n    let val_end = val_start + length;\n    if val_end > bytes_max {\n        return Err(Error::Generic);\n    }\n    Ok((val_start, val_end))\n}\n\n/// Parse a DER-encoded SubjectPublicKeyInfo structure.\n///\n/// Walks the outer SEQUENCE → AlgorithmIdentifier SEQUENCE → OID +\n/// optional parameters → BIT STRING layout described in RFC 5480 and\n/// RFC 8410, returning zero-copy sub-slices into `input`.\n///\n/// Returns `Err(Error::Generic)` for any structural violation (wrong tag,\n/// truncated length field, outer-sequence length mismatch, or trailing\n/// bytes after the BIT STRING).\n///\n/// C: `picoquic_parse_public_key_asn1`\npub fn parse_public_key_asn1(input: &[u8]) -> Result<PublicKeyAsn1<'_>, Error> {\n    let bytes_max = input.len();\n\n    // Outer SEQUENCE must span the entire buffer.\n    let (outer_val, outer_end) = asn1_tlv(input, bytes_max, 0, 0x30)?;\n    if outer_end != bytes_max {\n        return Err(Error::Generic); // PTLS_ERROR_BER_EXCESSIVE_LENGTH\n    }\n\n    // AlgorithmIdentifier SEQUENCE.\n    let (inner_val, inner_end) = asn1_tlv(input, outer_end, outer_val, 0x30)?;\n\n    // Algorithm OID — value bytes only (tag + length consumed by asn1_tlv).\n    let (oid_val, oid_end) = asn1_tlv(input, inner_end, inner_val, 0x06)?;\n    let algo = &input[oid_val..oid_end];\n\n    // Parameters: everything remaining in the inner SEQUENCE after the OID.\n    let param = if inner_end <= oid_end {\n        &input[0..0]\n    } else {\n        &input[oid_end..inner_end]\n    };\n\n    // BIT STRING (public key), must consume the rest of the outer SEQUENCE.\n    let (bs_val, bs_end) = asn1_tlv(input, outer_end, inner_end, 0x03)?;\n    if bs_end != outer_end {\n        return Err(Error::Generic); // PTLS_ERROR_BER_ELEMENT_TOO_SHORT\n    }\n    let bit_string = &input[bs_val..bs_end];\n\n    Ok(PublicKeyAsn1 {\n        algo,\n        param,\n        bit_string,\n        consumed: bs_end,\n    })\n}\n\n// ---------------------------------------------------------------------------\n// Base64 decoder (companion to `base64_encode`).\n\n/// Decode standard base64 (RFC 4648) from `input` into `out`.\n///\n/// Ignores whitespace and `=` padding characters.  Returns\n/// `Err(Error::Generic)` for any non-base64, non-whitespace, non-padding\n/// character.\n///\n/// C: `picoquic_base64_decode` (picoquic/ech.c:50)\nfn base64_decode(input: &[u8], out: &mut Vec<u8>) -> Result<(), Error> {\n    let decode_char = |c: u8| -> Option<u8> {\n        match c {\n            b'A'..=b'Z' => Some(c - b'A'),\n            b'a'..=b'z' => Some(c - b'a' + 26),\n            b'0'..=b'9' => Some(c - b'0' + 52),\n            b'+' => Some(62),\n            b'/' => Some(63),\n            _ => None,\n        }\n    };\n\n    let mut accum: u32 = 0;\n    let mut nbits: u32 = 0;\n\n    for &c in input {\n        if c == b'=' || c == b'\\n' || c == b'\\r' || c == b' ' || c == b'\\t' {\n            continue;\n        }\n        let v = decode_char(c).ok_or(Error::Generic)?;\n        accum = (accum << 6) | v as u32;\n        nbits += 6;\n        if nbits >= 8 {\n            nbits -= 8;\n            out.push((accum >> nbits) as u8);\n        }\n    }\n\n    Ok(())\n}\n\n// ---------------------------------------------------------------------------\n// PEM / DER helpers for private key loading.\n\n/// Strip PEM header/footer lines and base64-decode the body.\n///\n/// Handles both bare base64 (no headers) and PEM-wrapped base64\n/// (`-----BEGIN ...-----` / `-----END ...-----`).  Lines that start\n/// with `-----` are silently skipped; all other content is fed to\n/// [`base64_decode`].\n///\n/// Returns the decoded bytes.\nfn pem_base64_decode(pem: &str) -> Result<Vec<u8>, Error> {\n    let mut out = Vec::new();\n    for line in pem.lines() {\n        let line = line.trim();\n        if line.starts_with(\"-----\") {\n            continue;\n        }\n        base64_decode(line.as_bytes(), &mut out)?;\n    }\n    if out.is_empty() {\n        return Err(Error::Generic);\n    }\n    Ok(out)\n}\n\n/// Extract the raw scalar bytes of a private key from DER-encoded data.\n///\n/// Handles two wire formats:\n///\n/// * **RFC 5915** (`EC PRIVATE KEY`): `SEQUENCE { INTEGER 1, OCTET STRING\n///   { key }, … }` — the private key scalar is the first OCTET STRING.\n///\n/// * **PKCS#8 / OneAsymmetricKey** (`PRIVATE KEY`): `SEQUENCE { INTEGER\n///   0, AlgorithmIdentifier SEQUENCE, OCTET STRING { payload } }`.\n///   The `payload` is either:\n///   - A nested OCTET STRING (for OKP keys: X25519, etc.) whose\n///     content is the raw scalar, or\n///   - An ECPrivateKey SEQUENCE (for EC keys) — parsed as RFC 5915.\nfn extract_private_key_der(der: &[u8], label: &str) -> Result<Vec<u8>, Error> {\n    let bytes_max = der.len();\n\n    // Outer SEQUENCE.\n    let (outer_val, outer_end) = asn1_tlv(der, bytes_max, 0, 0x30)?;\n\n    if label.contains(\"EC PRIVATE KEY\") {\n        // RFC 5915: SEQUENCE { INTEGER version, OCTET STRING private_key, … }\n        let (_, after_ver) = asn1_tlv(der, outer_end, outer_val, 0x02)?;\n        let (pk_val, pk_end) = asn1_tlv(der, outer_end, after_ver, 0x04)?;\n        Ok(der[pk_val..pk_end].to_vec())\n    } else {\n        // PKCS#8: SEQUENCE { INTEGER version, AlgorithmId SEQUENCE, OCTET STRING privateKey }\n        let (_, after_ver) = asn1_tlv(der, outer_end, outer_val, 0x02)?;\n        let (_, after_alg) = asn1_tlv(der, outer_end, after_ver, 0x30)?;\n        let (pk_outer_val, pk_outer_end) = asn1_tlv(der, outer_end, after_alg, 0x04)?;\n\n        if pk_outer_val < pk_outer_end && der[pk_outer_val] == 0x04 {\n            // Nested OCTET STRING: OKP / X25519 CurvePrivateKey.\n            let (inner_val, inner_end) = asn1_tlv(der, pk_outer_end, pk_outer_val, 0x04)?;\n            Ok(der[inner_val..inner_end].to_vec())\n        } else if pk_outer_val < pk_outer_end && der[pk_outer_val] == 0x30 {\n            // ECPrivateKey SEQUENCE inside the privateKey OCTET STRING.\n            let (ec_val, ec_end) = asn1_tlv(der, pk_outer_end, pk_outer_val, 0x30)?;\n            let (_, after_ec_ver) = asn1_tlv(der, ec_end, ec_val, 0x02)?;\n            let (ec_pk_val, ec_pk_end) = asn1_tlv(der, ec_end, after_ec_ver, 0x04)?;\n            Ok(der[ec_pk_val..ec_pk_end].to_vec())\n        } else {\n            Err(Error::Generic)\n        }\n    }\n}\n\n// ---------------------------------------------------------------------------\n// ECH config file reader.\n\n/// Read a base64-encoded ECHConfigList from a text file and return the\n/// decoded binary bytes.\n///\n/// The file may contain PEM headers (`-----BEGIN ...-----` /\n/// `-----END ...-----`) or bare base64.  The decoded bytes are the\n/// ECHConfigList wire format: a 2-byte big-endian total-length prefix\n/// followed by one or more ECHConfig entries.\n///\n/// C: `picoquic_ech_read_config` (picoquic/ech.c:98)\npub fn ech_read_config_file(config_file_name: &str) -> Result<Vec<u8>, Error> {\n    let text = std::fs::read_to_string(config_file_name).map_err(|_| Error::Generic)?;\n    pem_base64_decode(&text)\n}\n\n// ---------------------------------------------------------------------------\n// ECH config encoder.\n\n/// Encode a single ECHConfig into wire bytes (version + length +\n/// ECHConfigContents).\n///\n/// The result is a self-contained ECHConfig entry suitable for inclusion\n/// in an ECHConfigList.  The caller must prepend the 2-byte outer\n/// ECHConfigList length when building the list.\n///\n/// C: `ptls_ech_encode_config` (picotls, called from\n/// `picoquic_ech_create_config_from_pk`).\nfn ech_encode_config(\n    config_id: u8,\n    kem_id: u16,\n    public_key: &[u8],\n    cipher_suites: &[HpkeCipherSuiteId],\n    maximum_name_length: u8,\n    public_name: &str,\n) -> Result<Vec<u8>, Error> {\n    let name_bytes = public_name.as_bytes();\n    if name_bytes.len() > 255 {\n        return Err(Error::Generic);\n    }\n\n    // Compute the length of ECHConfigContents:\n    //   config_id (1) + kem_id (2) + pk_len (2) + pk (N)\n    //   + cs_len (2) + cs entries (4 * n)\n    //   + max_name_len (1) + name_len (1) + name (L)\n    //   + extensions_len (2)\n    let pk_len = public_key.len();\n    let cs_bytes = cipher_suites.len() * 4;\n    let name_len = name_bytes.len();\n    let contents_len = 1 + 2 + 2 + pk_len + 2 + cs_bytes + 1 + 1 + name_len + 2;\n\n    // ECHConfig wire: version (2) + contents_length (2) + contents.\n    let mut buf = Vec::with_capacity(4 + contents_len);\n\n    // version = 0xFE0D (ECH draft-13+)\n    buf.extend_from_slice(&0xFE0Du16.to_be_bytes());\n    // ECHConfigContents length\n    buf.extend_from_slice(&(contents_len as u16).to_be_bytes());\n    // config_id\n    buf.push(config_id);\n    // kem_id\n    buf.extend_from_slice(&kem_id.to_be_bytes());\n    // public_key (2-byte length prefix)\n    buf.extend_from_slice(&(pk_len as u16).to_be_bytes());\n    buf.extend_from_slice(public_key);\n    // cipher_suites (2-byte length prefix; each suite is kdf_id:2 + aead_id:2)\n    buf.extend_from_slice(&(cs_bytes as u16).to_be_bytes());\n    for cs in cipher_suites {\n        buf.extend_from_slice(&cs.kdf.to_be_bytes());\n        buf.extend_from_slice(&cs.aead.to_be_bytes());\n    }\n    // maximum_name_length\n    buf.push(maximum_name_length);\n    // public_name (1-byte length prefix)\n    buf.push(name_len as u8);\n    buf.extend_from_slice(name_bytes);\n    // extensions (empty list, 2-byte length = 0)\n    buf.extend_from_slice(&0u16.to_be_bytes());\n\n    Ok(buf)\n}\n\n// ---------------------------------------------------------------------------\n// ECH opener initialiser.\n\n/// Initialise a server-side ECH opener from on-disk key material.\n///\n/// Reads the binary ECH config from `config_file_name` (base64-encoded\n/// ECHConfigList) and the EC/OKP private key from `private_key_file`\n/// (PEM-encoded), then constructs and returns an [`EchOpenerState`].\n///\n/// The `config` field of the returned state is the decoded binary\n/// ECHConfigList (2-byte outer length + ECHConfig).  The `private_key`\n/// field is the raw scalar bytes required by the HPKE `PrivateKey::from_bytes`\n/// call in [`EchOpenerState::open`].\n///\n/// C: `ech_init_opener_callback` (picoquic/ech.c:280)\npub fn ech_init_opener(\n    private_key_file: &str,\n    config_file_name: &str,\n) -> Result<EchOpenerState, Error> {\n    // Read and decode the ECHConfigList from the base64-encoded config file.\n    let config = ech_read_config_file(config_file_name)?;\n\n    // Extract kem_id from ECHConfigList bytes[7:9]:\n    //   bytes[0:2] = ECHConfigList outer length\n    //   bytes[2:4] = ECHConfig version (0xFE0D)\n    //   bytes[4:6] = ECHConfig contents length\n    //   bytes[6]   = config_id\n    //   bytes[7:9] = kem_id\n    if config.len() < 9 {\n        return Err(Error::Generic);\n    }\n    let kem_id = (config[7] as u16) << 8 | config[8] as u16;\n\n    // Validate the kem_id against the supported set.\n    if !matches!(\n        kem_id,\n        kem_id::P256_SHA256 | kem_id::P384_SHA384 | kem_id::X25519_SHA256\n    ) {\n        return Err(Error::Generic);\n    }\n\n    // Read and parse the PEM private key file.\n    let pem_text = std::fs::read_to_string(private_key_file).map_err(|_| Error::Generic)?;\n    // Determine the key format from the PEM label.\n    let label_start = pem_text.find(\"-----BEGIN \").ok_or(Error::Generic)? + \"-----BEGIN \".len();\n    let label_end = pem_text[label_start..]\n        .find(\"-----\")\n        .ok_or(Error::Generic)?;\n    let label = &pem_text[label_start..label_start + label_end];\n\n    let der = pem_base64_decode(&pem_text)?;\n    let private_key = extract_private_key_der(&der, label)?;\n\n    Ok(EchOpenerState {\n        kem_id,\n        private_key,\n        config,\n    })\n}\n\n// ---------------------------------------------------------------------------\n// ECH config builder from a public key.\n\n/// Build an ECHConfig entry from an ASN.1 public key and a server public\n/// name, returning the raw ECHConfig wire bytes.\n///\n/// 1. Derives the HPKE KEM from `group_id` (one of the TLS named-group\n///    identifiers in [`group_id`]).\n/// 2. Selects the preferred cipher suites for that KEM via\n///    [`ech_get_ciphers_from_kem`].\n/// 3. Computes a one-byte config-ID by XOR-folding the key material,\n///    KEM id, cipher-suite ids, and the public name.\n/// 4. Encodes the full ECHConfig wire structure.\n///\n/// The returned `Vec<u8>` is one ECHConfig (without the outer\n/// ECHConfigList 2-byte total-length prefix).  Wrap it with that prefix\n/// to obtain a complete ECHConfigList.\n///\n/// C: `picoquic_ech_create_config_from_pk` (picoquic/ech.c:802)\npub fn ech_create_config_from_pk(\n    group_id: u16,\n    public_key_bits: &[u8],\n    public_name: &str,\n) -> Result<Vec<u8>, Error> {\n    // Derive KEM id from the TLS named-group id.\n    let kem_id = ech_get_kem_from_curve(group_id).ok_or(Error::Generic)?;\n\n    // Collect the preferred cipher suites for this KEM.\n    let mut cipher_buf = [HpkeCipherSuiteId { kdf: 0, aead: 0 }; 5];\n    let n_ciphers = ech_get_ciphers_from_kem(kem_id, &mut cipher_buf)?;\n    let cipher_suites = &cipher_buf[..n_ciphers];\n\n    // Compute a one-byte config-ID from all the key material.\n    let config_id = ech_config_id_from_config(public_key_bits, kem_id, cipher_suites, public_name);\n\n    // Encode and return the ECHConfig wire bytes.\n    ech_encode_config(\n        config_id,\n        kem_id,\n        public_key_bits,\n        cipher_suites,\n        255,\n        public_name,\n    )\n}\n\n// ---------------------------------------------------------------------------\n// Tests.\n\n#[cfg(test)]\nmod tests {\n    use super::*;\n\n    #[test]\n    fn base64_encode_empty() {\n        let mut buf = [0u8; 1];\n        let n = base64_encode(&[], &mut buf).unwrap();\n        assert_eq!(n, 0);\n        assert_eq!(buf[0], 0);\n    }\n\n    #[test]\n    fn base64_encode_three_bytes() {\n        // \"Man\" → \"TWFu\"\n        let mut buf = [0u8; 5];\n        let n = base64_encode(b\"Man\", &mut buf).unwrap();\n        assert_eq!(n, 4);\n        assert_eq!(&buf[..4], b\"TWFu\");\n        assert_eq!(buf[4], 0);\n    }\n\n    #[test]\n    fn base64_encode_padding_one() {\n        // \"M\" → \"TQ==\"\n        let mut buf = [0u8; 5];\n        let n = base64_encode(b\"M\", &mut buf).unwrap();\n        assert_eq!(n, 4);\n        assert_eq!(&buf[..4], b\"TQ==\");\n    }\n\n    #[test]\n    fn base64_encode_padding_two() {\n        // \"Ma\" → \"TWE=\"\n        let mut buf = [0u8; 5];\n        let n = base64_encode(b\"Ma\", &mut buf).unwrap();\n        assert_eq!(n, 4);\n        assert_eq!(&buf[..4], b\"TWE=\");\n    }\n\n    #[test]\n    fn base64_encode_buffer_too_small() {\n        let mut buf = [0u8; 4]; // needs 5 (4 chars + NUL)\n        assert!(base64_encode(b\"Man\", &mut buf).is_err());\n    }\n\n    #[test]\n    fn base64_encoded_len_values() {\n        assert_eq!(base64_encoded_len(0), 0);\n        assert_eq!(base64_encoded_len(1), 4);\n        assert_eq!(base64_encoded_len(2), 4);\n        assert_eq!(base64_encoded_len(3), 4);\n        assert_eq!(base64_encoded_len(4), 8);\n        assert_eq!(base64_encoded_len(6), 8);\n    }\n\n    #[test]\n    fn ech_get_ciphers_p256() {\n        let mut out = [HpkeCipherSuiteId { kdf: 0, aead: 0 }; 4];\n        let n = ech_get_ciphers_from_kem(kem_id::P256_SHA256, &mut out).unwrap();\n        assert!(n >= 1);\n        assert_eq!(out[0].kdf, kdf_id::HKDF_SHA256);\n        assert_eq!(out[0].aead, aead_id::AES_128_GCM);\n    }\n\n    #[test]\n    fn ech_get_ciphers_p384() {\n        let mut out = [HpkeCipherSuiteId { kdf: 0, aead: 0 }; 4];\n        let n = ech_get_ciphers_from_kem(kem_id::P384_SHA384, &mut out).unwrap();\n        assert!(n >= 1);\n        assert_eq!(out[0].kdf, kdf_id::HKDF_SHA384);\n        assert_eq!(out[0].aead, aead_id::AES_256_GCM);\n    }\n\n    #[test]\n    fn ech_get_ciphers_x25519() {\n        let mut out = [HpkeCipherSuiteId { kdf: 0, aead: 0 }; 4];\n        let n = ech_get_ciphers_from_kem(kem_id::X25519_SHA256, &mut out).unwrap();\n        assert!(n >= 1);\n        assert_eq!(out[0].kdf, kdf_id::HKDF_SHA256);\n        assert_eq!(out[0].aead, aead_id::CHACHA20_POLY1305);\n    }\n\n    #[test]\n    fn ech_get_ciphers_out_too_small() {\n        let mut out = [HpkeCipherSuiteId { kdf: 0, aead: 0 }; 1];\n        assert!(ech_get_ciphers_from_kem(kem_id::P256_SHA256, &mut out).is_err());\n    }\n\n    #[test]\n    fn config_id_is_deterministic() {\n        let key = [1u8, 2, 3, 4];\n        let suites = [HpkeCipherSuiteId {\n            kdf: kdf_id::HKDF_SHA256,\n            aead: aead_id::AES_128_GCM,\n        }];\n        let id1 = ech_config_id_from_config(&key, kem_id::X25519_SHA256, &suites, \"example.com\");\n        let id2 = ech_config_id_from_config(&key, kem_id::X25519_SHA256, &suites, \"example.com\");\n        assert_eq!(id1, id2);\n    }\n\n    #[test]\n    fn config_id_changes_with_key() {\n        let suites = [HpkeCipherSuiteId {\n            kdf: kdf_id::HKDF_SHA256,\n            aead: aead_id::AES_128_GCM,\n        }];\n        let id1 =\n            ech_config_id_from_config(&[1, 2, 3], kem_id::X25519_SHA256, &suites, \"example.com\");\n        let id2 =\n            ech_config_id_from_config(&[4, 5, 6], kem_id::X25519_SHA256, &suites, \"example.com\");\n        assert_ne!(id1, id2);\n    }\n\n    #[test]\n    fn kem_from_curve_known_groups() {\n        assert_eq!(\n            ech_get_kem_from_curve(group_id::SECP256R1),\n            Some(kem_id::P256_SHA256)\n        );\n        assert_eq!(\n            ech_get_kem_from_curve(group_id::SECP384R1),\n            Some(kem_id::P384_SHA384)\n        );\n        assert_eq!(\n            ech_get_kem_from_curve(group_id::X25519),\n            Some(kem_id::X25519_SHA256)\n        );\n    }\n\n    #[test]\n    fn kem_from_curve_unknown() {\n        assert_eq!(ech_get_kem_from_curve(0xFFFF), None);\n    }\n\n    // Minimal DER-encoded SubjectPublicKeyInfo for X25519 (RFC 8410):\n    // SEQUENCE {\n    //   SEQUENCE { OID 1.3.101.110 }        -- id-X25519\n    //   BIT STRING { 0x00 <32 zero bytes> }  -- fake key, padding=0\n    // }\n    fn x25519_spki() -> Vec<u8> {\n        let oid: &[u8] = &[0x2b, 0x65, 0x6e]; // 1.3.101.110\n        // inner SEQUENCE: OID TLV\n        let mut inner = Vec::new();\n        inner.push(0x06);\n        inner.push(oid.len() as u8);\n        inner.extend_from_slice(oid);\n        // BIT STRING: padding byte + 32-byte key\n        let mut bs_val = vec![0x00u8]; // padding count\n        bs_val.extend_from_slice(&[0xABu8; 32]);\n        let mut outer = Vec::new();\n        // inner SEQUENCE TLV\n        outer.push(0x30);\n        outer.push(inner.len() as u8);\n        outer.extend_from_slice(&inner);\n        // BIT STRING TLV\n        outer.push(0x03);\n        outer.push(bs_val.len() as u8);\n        outer.extend_from_slice(&bs_val);\n        // wrap in outer SEQUENCE\n        let mut spki = Vec::new();\n        spki.push(0x30);\n        spki.push(outer.len() as u8);\n        spki.extend_from_slice(&outer);\n        spki\n    }\n\n    #[test]\n    fn parse_public_key_asn1_x25519() {\n        let spki = x25519_spki();\n        let r = parse_public_key_asn1(&spki).unwrap();\n        assert_eq!(r.algo, &[0x2b, 0x65, 0x6e]);\n        assert_eq!(r.param, &[] as &[u8]); // X25519 has no parameters\n        assert_eq!(r.bit_string[0], 0x00); // padding byte\n        assert_eq!(r.bit_string.len(), 33); // 1 + 32 key bytes\n        assert_eq!(r.consumed, spki.len());\n    }\n\n    #[test]\n    fn parse_public_key_asn1_truncated() {\n        let spki = x25519_spki();\n        assert!(parse_public_key_asn1(&spki[..4]).is_err());\n    }\n\n    #[test]\n    fn parse_public_key_asn1_wrong_outer_tag() {\n        let mut spki = x25519_spki();\n        spki[0] = 0x31; // SET instead of SEQUENCE\n        assert!(parse_public_key_asn1(&spki).is_err());\n    }\n}\n","numLines":1042,"startLine":1,"totalLines":1042}}}
