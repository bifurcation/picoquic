{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01ViVAPfkevmaQdGkosX1pbk","type":"tool_result","content":"1\t[package]\n2\tname = \"fq\"\n3\tversion = \"0.1.0\"\n4\tedition = \"2024\"\n5\t\n6\t[features]\n7\tdefault = []\n8\t# Each backend lives behind its own feature so a binary only pays\n9\t# for the implementations it actually links.  See `src/sys/`.\n10\tsys-picotls = []\n11\tsys-openssl = [\"dep:openssl\", \"dep:openssl-sys\", \"dep:foreign-types\"]\n12\tsys-mbedtls = []\n13\tsys-fusion = []\n14\t\n15\t[dependencies]\n16\tlog = { version = \"0.4\", default-features = false }\n17\tfugit = { version = \"0.3\", default-features = false }\n18\trand = { version = \"0.9\", default-features = false }\n19\trand_core = { version = \"0.9\", default-features = false }\n20\t\n21\t# Rust Crypto trait crates (no implementations -- those come from\n22\t# the active TLS backend's crypto layer, except for header\n23\t# protection which we implement ourselves).\n24\taead = { version = \"0.5\", default-features = false }\n25\tcipher = { version = \"0.4\", default-features = false }\n26\tdigest = { version = \"0.10\", default-features = false }\n27\t\n28\t# Concrete cipher implementations used by header protection\n29\t# (QUIC packet-number encryption is QUIC logic, not TLS).\n30\taes = { version = \"0.8\", default-features = false }\n31\tchacha20 = { version = \"0.9\", default-features = false }\n32\t\n33\t# Hash, HKDF, and AEAD implementations used by the QUIC initial-secret\n34\t# derivation, retry-protection AEAD, and test-only crypto helpers in\n35\t# `tls_api`.  These are pure-Rust algorithms not specific to any TLS\n36\t# backend.\n37\tsha2 = { version = \"0.10\", default-features = false }\n38\thkdf = { version = \"0.12\", default-features = false }\n39\thmac = { version = \"0.12\", default-features = false }\n40\taes-gcm = { version = \"0.10\", default-features = false, features = [\"aes\", \"alloc\"] }\n41\t\n42\t# UDP socket abstraction.  std-only.\n43\tsocket2 = { version = \"0.5\", default-features = false, features = [\"all\"] }\n44\t\n45\t# HPKE (RFC 9180) — used by the ECH opener callback to perform DHKEM\n46\t# decapsulation.  KEM algorithm support is gated per feature below.\n47\thpke = { version = \"0.12\", features = [\"x25519\", \"p256\", \"p384\"] }\n48\t\n49\t# Platform socket ancillary-data (cmsg) helpers.  Used only on Unix via\n50\t# `#[cfg(unix)]`; safe to list unconditionally.\n51\tlibc = \"0.2\"\n52\t\n53\t# Optional backend implementations (gated by `sys-*` features).\n54\topenssl = { version = \"0.10\", optional = true }\n55\topenssl-sys = { version = \"0.9\", optional = true }\n56\tforeign-types = { version = \"0.3\", optional = true }\n57\t"}]},"parent_tool_use_id":null,"session_id":"83fff6f3-c332-4b5d-b717-1fbf70423982","uuid":"93b0d559-5ed5-4e51-b53d-506a8198c4bf","timestamp":"2026-05-07T14:33:31.019Z","tool_use_result":{"type":"text","file":{"filePath":"/Users/richbarn/Projects/picoquic/rs/fq/Cargo.toml","content":"[package]\nname = \"fq\"\nversion = \"0.1.0\"\nedition = \"2024\"\n\n[features]\ndefault = []\n# Each backend lives behind its own feature so a binary only pays\n# for the implementations it actually links.  See `src/sys/`.\nsys-picotls = []\nsys-openssl = [\"dep:openssl\", \"dep:openssl-sys\", \"dep:foreign-types\"]\nsys-mbedtls = []\nsys-fusion = []\n\n[dependencies]\nlog = { version = \"0.4\", default-features = false }\nfugit = { version = \"0.3\", default-features = false }\nrand = { version = \"0.9\", default-features = false }\nrand_core = { version = \"0.9\", default-features = false }\n\n# Rust Crypto trait crates (no implementations -- those come from\n# the active TLS backend's crypto layer, except for header\n# protection which we implement ourselves).\naead = { version = \"0.5\", default-features = false }\ncipher = { version = \"0.4\", default-features = false }\ndigest = { version = \"0.10\", default-features = false }\n\n# Concrete cipher implementations used by header protection\n# (QUIC packet-number encryption is QUIC logic, not TLS).\naes = { version = \"0.8\", default-features = false }\nchacha20 = { version = \"0.9\", default-features = false }\n\n# Hash, HKDF, and AEAD implementations used by the QUIC initial-secret\n# derivation, retry-protection AEAD, and test-only crypto helpers in\n# `tls_api`.  These are pure-Rust algorithms not specific to any TLS\n# backend.\nsha2 = { version = \"0.10\", default-features = false }\nhkdf = { version = \"0.12\", default-features = false }\nhmac = { version = \"0.12\", default-features = false }\naes-gcm = { version = \"0.10\", default-features = false, features = [\"aes\", \"alloc\"] }\n\n# UDP socket abstraction.  std-only.\nsocket2 = { version = \"0.5\", default-features = false, features = [\"all\"] }\n\n# HPKE (RFC 9180) — used by the ECH opener callback to perform DHKEM\n# decapsulation.  KEM algorithm support is gated per feature below.\nhpke = { version = \"0.12\", features = [\"x25519\", \"p256\", \"p384\"] }\n\n# Platform socket ancillary-data (cmsg) helpers.  Used only on Unix via\n# `#[cfg(unix)]`; safe to list unconditionally.\nlibc = \"0.2\"\n\n# Optional backend implementations (gated by `sys-*` features).\nopenssl = { version = \"0.10\", optional = true }\nopenssl-sys = { version = \"0.9\", optional = true }\nforeign-types = { version = \"0.3\", optional = true }\n","numLines":57,"startLine":1,"totalLines":57}}}
