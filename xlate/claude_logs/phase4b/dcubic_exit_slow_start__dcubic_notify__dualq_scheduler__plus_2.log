{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01V86axPtdCZPP2BwNFe1H9u","type":"tool_result","content":"1\t//! Translation of `picoquic/picoquictest_dualq.h` (with bodies in\n2\t//! `picoquictest/dualq_aqm.c`).\n3\t//!\n4\t//! DualQ-Coupled AQM used by the test suite (RFC 9332 timestamp\n5\t//! variant).  Sits behind a [`TestSimLink`]'s `aqm_state` slot and\n6\t//! classifies arriving packets into an L4S queue ([`Dualq::lq`]) or\n7\t//! a Classic queue ([`Dualq::cq`]); marks/drops on dequeue using the\n8\t//! PI2 controller; and feeds admitted packets back into the link's\n9\t//! transit queue.\n10\t//!\n11\t//! The implementation mirrors `picoquic/dualq_aqm.c`.\n12\t//!\n13\t//! Translation policy notes for this module:\n14\t//!\n15\t//! * The C vtable struct `picoquictest_aqm_t` is already a Rust\n16\t//!   trait ([`TestAqm`](crate::tests::util::TestAqm)) in\n17\t//!   [`crate::utils`].  The C \"embed `super` and cast pointer\"\n18\t//!   inheritance pattern collapses to `impl TestAqm for Dualq`; the\n19\t//!   C `super` field is dropped.\n20\t//! * The C dualq pair of `queue_first` / `queue_last` raw\n21\t//!   `*mut TestSimPacket` heads (the intrusive-linked-list shape\n22\t//!   used by the parent sim-link) is replaced by an owning\n23\t//!   `VecDeque<TestSimPacket>` per queue.  Submit pushes;\n24\t//!   dequeue pops.  No raw pointers, no `unsafe`.\n25\t//! * The C `dualq_dequeue_one`'s `int* should_drop` out-parameter\n26\t//!   folds into a tuple return — `Option<(Box<...>, bool)>`\n27\t//!   represents \"no packet ready\" / \"(packet, drop?)\".\n28\t//! * The C `dualq_release` self-frees with `free(self)` and clears\n29\t//!   `link->aqm_state`.  In Rust the trait method takes\n30\t//!   `&mut self`; the actual deallocation rides on the\n31\t//!   `Option<Box<dyn TestAqm>>` slot in the link being reset to\n32\t//!   `None` by the caller after `release` drains the queues —\n33\t//!   `release` itself only handles the queue drain.\n34\t\n35\tuse crate::Error;\n36\tuse crate::Instant;\n37\tuse crate::tests::util::{TestAqm, TestSimLink, TestSimPacket};\n38\t\n39\t// ---------------------------------------------------------------------------\n40\t// Tunables.\n41\t\n42\t/// Simulation link-rate ceiling: 125,000,000 bytes/sec ≈ 1 Gbps.\n43\t/// C: `#define DUALQ_MAX_LINK_RATE 125000000`.\n44\tpub const DUALQ_MAX_LINK_RATE: u64 = 125_000_000;\n45\tconst PICOQUIC_ECN_ECT_1: u8 = 0x01;\n46\tconst PICOQUIC_ECN_CE: u8 = 0x03;\n47\t\n48\t// ---------------------------------------------------------------------------\n49\t// Per-queue state.\n50\t\n51\t/// One classified queue (L4S or Classic) inside a [`Dualq`].\n52\t/// C: `dualq_queue_t`.\n53\t///\n54\t/// Storage shape:\n55\t///\n56\t/// * The C `queue_first` / `queue_last` pair (intrusive linked\n57\t///   list, same pattern as [`crate::tests::util::TestSimLink`])\n58\t///   is replaced by an owning `VecDeque<TestSimPacket>`.  Submit\n59\t///   pushes to the back; dequeue pops from the front and hands\n60\t///   ownership to the caller via [`Dualq::dequeue_one`].\n61\t/// * `count` mirrors the C `int`, kept as `i32` for ABI parity with\n62\t///   the dualq tests that inspect it directly.\n63\t#[derive(Default)]\n64\tpub struct DualqQueue {\n65\t    pub queue_bytes: u64,\n66\t    /// Running sum of drop probability — when it crosses 1.0 the\n67\t    /// `dualq_recur` helper \"fires\" and the head packet is\n68\t    /// dropped/marked.  C: `double sum_p`.\n69\t    pub sum_p: f64,\n70\t    /// Packets in the queue.  Replaces the C `queue_first` /\n71\t    /// `queue_last` head/tail pair.  `count` is `packets.len()`\n72\t    /// (the C field is gone).\n73\t    pub packets: std::collections::VecDeque<TestSimPacket>,\n74\t}\n75\t\n76\timpl DualqQueue {\n77\t    /// Append `packet` to the tail of this queue.\n78\t    /// C: `dualq_enqueue_queue(dualq_queue_t* xq,\n79\t    /// picoquictest_sim_packet_t* packet)`.\n80\t    pub fn enqueue(&mut self, packet: TestSimPacket) {\n81\t        self.queue_bytes += packet.length as u64;\n82\t        self.packets.push_back(packet);\n83\t    }\n84\t\n85\t    /// C: `dualq_dequeue_queue` (picoquic/dualq_aqm.c:114)\n86\t    ///\n87\t    /// Remove and return the head packet from this queue, updating\n88\t    /// `queue_bytes` and the packet count.  Returns `None` when empty.\n89\t    fn dequeue(&mut self) -> Option<TestSimPacket> {\n90\t        let packet = self.packets.pop_front()?;\n91\t        if self.packets.is_empty() {\n92\t            self.queue_bytes = 0;\n93\t        } else if (packet.length as u64) < self.queue_bytes {\n94\t            self.queue_bytes -= packet.length as u64;\n95\t        } else {\n96\t            self.queue_bytes = 1;\n97\t        }\n98\t        Some(packet)\n99\t    }\n100\t}\n101\t\n102\t// ---------------------------------------------------------------------------\n103\t// AQM state.\n104\t\n105\t/// DualQ Coupled AQM state attached to a sim link.  C:\n106\t/// `dualq_state_t`.\n107\t///\n108\t/// The C struct embedded a `picoquictest_aqm_t` vtable in its first\n109\t/// field (`super`); in Rust the equivalent is `impl TestAqm for\n110\t/// Dualq`, so the explicit `super` field is dropped.  All other\n111\t/// fields mirror the C layout one-for-one.  Field names follow Rust\n112\t/// conventions: the RFC 9332 symbols `p_Cmax`, `p'_L`, etc., become\n113\t/// `p_c_max`, `p_prime_l`, and so on.\n114\tpub struct Dualq {\n115\t    // -- Initialization parameters -----------------------------------\n116\t    /// PI2 queue-delay target for both L4S and Classic, in\n117\t    /// microseconds.\n118\t    pub target: u64,\n119\t    /// Coupling factor `k`.\n120\t    pub k: f64,\n121\t    /// Above this drop probability, the classic queue uses drops\n122\t    /// instead of marks.  C: `p_Cmax`.\n123\t    pub p_c_max: f64,\n124\t    /// Interval between PI2 parameter updates, in microseconds.\n125\t    /// C: `Tupdate`.\n126\t    pub t_update: u64,\n127\t    /// PI integral gain in Hz.\n128\t    pub pi2_alpha: f64,\n129\t    /// PI proportional gain in MHz (1 / microsecond).\n130\t    pub pi2_beta: f64,\n131\t    /// Above this queue-size threshold, the L queue behaves as\n132\t    /// classic.  C: `maxTh`.\n133\t    pub max_th: u64,\n134\t    /// Queue size above which the L queue starts CE marking.\n135\t    /// C: `minTh`.\n136\t    pub min_th: u64,\n137\t    /// `max_th - min_th`.\n138\t    pub range: u64,\n139\t    /// Above this drop probability, the L4S queue uses drops\n140\t    /// instead of marks.  C: `p_Lmax`.\n141\t    pub p_l_max: f64,\n142\t    /// Maximum size of L4S + Classic queues, in bytes.\n143\t    pub limit: u64,\n144\t    /// Counter used for weighted fair queuing — 15 ticks for L4S,\n145\t    /// 1 tick for Classic.  C: `int schedule_tick`.\n146\t    pub schedule_tick: i32,\n147\t\n148\t    // -- Queues ------------------------------------------------------\n149\t    /// L4S queue of pending packets.\n150\t    pub lq: DualqQueue,\n151\t    /// Classic queue of pending packets.\n152\t    pub cq: DualqQueue,\n153\t\n154\t    // -- PI2 controller scratch space --------------------------------\n155\t    /// Current length of the classic queue, in microseconds.\n156\t    pub curq: i64,\n157\t    /// Previous length of the classic queue, in microseconds.\n158\t    pub prevq: i64,\n159\t    /// Time at which the PI2 parameters should next be updated.\n160\t    pub update_next: Instant,\n161\t    pub lq_average_queue: u64,\n162\t    /// `p'` coefficient (RFC 9332): nominal mark rate of the L4S\n163\t    /// queue derived from the classic queue length.  C: `pprime`.\n164\t    pub p_prime: f64,\n165\t    /// `p'_L`: mark rate of the L4S queue computed from L4S queue\n166\t    /// length, before coupling.  C: `pprime_L`.\n167\t    pub p_prime_l: f64,\n168\t    /// Actual mark rate of the L4S queue, after combining with\n169\t    /// `p_cl`.  C: `p_L`.\n170\t    pub p_l: f64,\n171\t    /// Coupled L4S probability: `p_prime_l * k`.  C: `p_CL`.\n172\t    pub p_cl: f64,\n173\t    /// Nominal drop rate of the classic queue (`p_prime_l^2`).\n174\t    /// C: `p_C`.\n175\t    pub p_c: f64,\n176\t\n177\t    // -- Picoquic NS data --------------------------------------------\n178\t    /// Time of the last `submit` call (microseconds).\n179\t    pub last_input_time: Instant,\n180\t}\n181\t\n182\timpl Default for Dualq {\n183\t    fn default() -> Self {\n184\t        Self {\n185\t            target: 0,\n186\t            k: 0.0,\n187\t            p_c_max: 0.0,\n188\t            t_update: 0,\n189\t            pi2_alpha: 0.0,\n190\t            pi2_beta: 0.0,\n191\t            max_th: 0,\n192\t            min_th: 0,\n193\t            range: 0,\n194\t            p_l_max: 0.0,\n195\t            limit: 0,\n196\t            schedule_tick: 0,\n197\t            lq: DualqQueue::default(),\n198\t            cq: DualqQueue::default(),\n199\t            curq: 0,\n200\t            prevq: 0,\n201\t            update_next: Instant::from_ticks(0),\n202\t            lq_average_queue: 0,\n203\t            p_prime: 0.0,\n204\t            p_prime_l: 0.0,\n205\t            p_l: 0.0,\n206\t            p_cl: 0.0,\n207\t            p_c: 0.0,\n208\t            last_input_time: Instant::from_ticks(0),\n209\t        }\n210\t    }\n211\t}\n212\t\n213\t// ---------------------------------------------------------------------------\n214\t// Trait impl — replaces the C \"embedded vtable + cast\" inheritance.\n215\t\n216\timpl TestAqm for Dualq {\n217\t    /// C: `dualq_submit`.  Queues the packet, updates\n218\t    /// `last_input_time`, and runs the dequeue/PI2 update pass.\n219\t    fn submit(&mut self, link: &mut TestSimLink, packet: TestSimPacket, current_time: Instant) {\n220\t        self.enqueue(link, packet, current_time);\n221\t        self.last_input_time = current_time;\n222\t        self.update_it(link, current_time);\n223\t    }\n224\t\n225\t    /// C: `dualq_reset` — runs the dequeue/PI2 update pass at\n226\t    /// `current_time`.\n227\t    fn reset(&mut self, link: &mut TestSimLink, current_time: Instant) {\n228\t        self.update_it(link, current_time);\n229\t    }\n230\t\n231\t    /// C: `dualq_release` — drains both queues onto the link as\n232\t    /// dropped packets.  The C body also `free(self)`s and nulls\n233\t    /// `link->aqm_state`; in Rust the caller drops the\n234\t    /// `Option<Box<dyn TestAqm>>` slot to do the same.\n235\t    fn release(&mut self, link: &mut TestSimLink) {\n236\t        while let Some(packet) = self.lq.dequeue() {\n237\t            link.enqueue(packet, Instant::from_ticks(0), true);\n238\t        }\n239\t        while let Some(packet) = self.cq.dequeue() {\n240\t            link.enqueue(packet, Instant::from_ticks(0), true);\n241\t        }\n242\t    }\n243\t\n244\t    /// C: `dualq_has_pending` — true iff either queue has at least\n245\t    /// one packet ready to admit.\n246\t    fn has_pending(&mut self) -> bool {\n247\t        !self.lq.packets.is_empty() || !self.cq.packets.is_empty()\n248\t    }\n249\t\n250\t    /// C: `dualq_admit_pending` — runs the dequeue/PI2 update pass\n251\t    /// at `current_time`.\n252\t    fn admit_pending(&mut self, link: &mut TestSimLink, current_time: Instant) {\n253\t        self.update_it(link, current_time);\n254\t    }\n255\t\n256\t    fn as_any_mut(&mut self) -> &mut dyn core::any::Any {\n257\t        self\n258\t    }\n259\t}\n260\t\n261\timpl Dualq {\n262\t    fn total_queue_bytes(&self) -> u64 {\n263\t        self.cq.queue_bytes + self.lq.queue_bytes\n264\t    }\n265\t\n266\t    fn enqueue(\n267\t        &mut self,\n268\t        link: &mut TestSimLink,\n269\t        mut packet: TestSimPacket,\n270\t        current_time: Instant,\n271\t    ) {\n272\t        if self.total_queue_bytes() + packet.length as u64 > self.limit {\n273\t            link.enqueue(packet, Instant::from_ticks(0), true);\n274\t        } else {\n275\t            packet.arrival_time = current_time;\n276\t            if packet.ecn_mark == PICOQUIC_ECN_ECT_1 || packet.ecn_mark == PICOQUIC_ECN_CE {\n277\t                self.lq.enqueue(packet);\n278\t            } else {\n279\t                self.cq.enqueue(packet);\n280\t            }\n281\t        }\n282\t    }\n283\t\n284\t    /// C: `dualq_recur` (picoquic/dualq_aqm.c:182)\n285\t    ///\n286\t    /// Accumulate `likelihood` into `queue.sum_p`; return `true` (fire)\n287\t    /// when the running sum crosses 1.0 and subtract 1.0.  Implements\n288\t    /// the RFC 9332 stochastic drop/mark decision.\n289\t    fn recur(queue: &mut DualqQueue, likelihood: f64) -> bool {\n290\t        queue.sum_p += likelihood;\n291\t        if queue.sum_p > 1.0 {\n292\t            queue.sum_p -= 1.0;\n293\t            true\n294\t        } else {\n295\t            false\n296\t        }\n297\t    }\n298\t\n299\t    fn scheduler(&mut self) -> Option<(TestSimPacket, bool)> {\n300\t        let mut is_lq = (self.schedule_tick & 0x0f) != 0;\n301\t        let mut packet = if is_lq {\n302\t            self.lq.dequeue()\n303\t        } else {\n304\t            self.cq.dequeue()\n305\t        };\n306\t        if packet.is_none() {\n307\t            is_lq = !is_lq;\n308\t            packet = if is_lq {\n309\t                self.lq.dequeue()\n310\t            } else {\n311\t                self.cq.dequeue()\n312\t            };\n313\t        }\n314\t\n315\t        self.schedule_tick = (self.schedule_tick + 1) & 0x0f;\n316\t        packet.map(|packet| (packet, is_lq))\n317\t    }\n318\t\n319\t    /// C: `dualq_laqm` (picoquic/dualq_aqm.c:210)\n320\t    ///\n321\t    /// Native L4S AQM probability derived from the sojourn time of the\n322\t    /// head packet in the L4S queue.  Returns a value in [0.0, 1.0]:\n323\t    /// 0 below `min_th`, linear ramp between `min_th` and `max_th`,\n324\t    /// and 1.0 at or above `max_th`.\n325\t    fn laqm(&self, current_time: Instant) -> f64 {\n326\t        let mut p_prime = 0.0;\n327\t        let mut lq_time = 0;\n328\t        if self.lq.packets.len() > 1\n329\t            && let Some(packet) = self.lq.packets.front()\n330\t            && packet.arrival_time.ticks() < current_time.ticks()\n331\t        {\n332\t            lq_time = current_time.ticks() - packet.arrival_time.ticks();\n333\t        }\n334\t        if lq_time >= self.max_th {\n335\t            p_prime = 1.0;\n336\t        } else if lq_time > self.min_th {\n337\t            p_prime = (lq_time - self.min_th) as f64 / self.range as f64;\n338\t        }\n339\t        p_prime\n340\t    }\n341\t\n342\t    fn pi2_update(&mut self, current_time: Instant) {\n343\t        let current_ticks = current_time.ticks();\n344\t        let cq_time = self\n345\t            .cq\n346\t            .packets\n347\t            .front()\n348\t            .filter(|packet| packet.arrival_time.ticks() < current_ticks)\n349\t            .map(|packet| current_ticks - packet.arrival_time.ticks())\n350\t            .unwrap_or(0);\n351\t        let lq_time = self\n352\t            .lq\n353\t            .packets\n354\t            .front()\n355\t            .filter(|packet| packet.arrival_time.ticks() < current_ticks)\n356\t            .map(|packet| current_ticks - packet.arrival_time.ticks())\n357\t            .unwrap_or(0);\n358\t\n359\t        self.curq = cq_time.max(lq_time) as i64;\n360\t        let target_delta = self.curq - self.target as i64;\n361\t        let delta_q = self.curq - self.prevq;\n362\t\n363\t        self.p_prime += self.pi2_alpha * target_delta as f64 + self.pi2_beta * delta_q as f64;\n364\t        self.p_prime = self.p_prime.clamp(0.0, 1.0);\n365\t\n366\t        self.p_cl = self.p_prime * self.k;\n367\t        if self.p_cl > 1.0 {\n368\t            self.p_cl = 1.0;\n369\t        }\n370\t        self.p_c = self.p_prime * self.p_prime_l;\n371\t        self.prevq = self.curq;\n372\t    }\n373\t\n374\t    fn update_it(&mut self, link: &mut TestSimLink, current_time: Instant) {\n375\t        while link.queue_time.ticks() <= current_time.ticks() {\n376\t            if let Some((packet, should_drop)) = self.dequeue_one(current_time) {\n377\t                link.enqueue(packet, current_time, should_drop);\n378\t            } else {\n379\t                break;\n380\t            }\n381\t        }\n382\t\n383\t        if current_time.ticks() >= self.update_next.ticks() {\n384\t            self.pi2_update(current_time);\n385\t            self.update_next = Instant::from_ticks(current_time.ticks() + self.t_update);\n386\t        }\n387\t    }\n388\t\n389\t    fn params_init(&mut self, l4s_max: u64, link: &TestSimLink) {\n390\t        self.limit = if link.queue_delay_max <= link.microsec_latency || link.picosec_per_byte == 0\n391\t        {\n392\t            (250u64 * DUALQ_MAX_LINK_RATE) / 1_000_000\n393\t        } else {\n394\t            let queue_delay = link.queue_delay_max - link.microsec_latency;\n395\t            (queue_delay * 1_000_000) / link.picosec_per_byte\n396\t        };\n397\t        self.k = 2.0;\n398\t        self.target = 15_000;\n399\t        let rtt_max = 100_000u64;\n400\t        self.p_c_max = 1.0 / (self.k * self.k);\n401\t        if self.p_c_max > 1.0 {\n402\t            self.p_c_max = 1.0;\n403\t        }\n404\t        self.t_update = rtt_max / 3;\n405\t        if self.t_update > self.target {\n406\t            self.t_update = self.target;\n407\t        }\n408\t        self.pi2_alpha = (0.1 * self.t_update as f64) / (rtt_max as f64 * rtt_max as f64);\n409\t        self.pi2_beta = 0.3 / rtt_max as f64;\n410\t\n411\t        if l4s_max == 0 {\n412\t            self.max_th = 1200;\n413\t            self.min_th = 800;\n414\t        } else {\n415\t            self.max_th = l4s_max;\n416\t            self.min_th = if l4s_max > 1200 { 800 } else { l4s_max / 3 };\n417\t        }\n418\t        self.range = self.max_th - self.min_th;\n419\t        self.p_l_max = 1.0;\n420\t    }\n421\t\n422\t    /// Install a fresh DualQ AQM on `link`, sized for an L4S queue\n423\t    /// of at most `l4s_max` bytes.  C: `int\n424\t    /// dualq_configure(picoquictest_sim_link_t* link, uint64_t\n425\t    /// l4s_max)`.\n426\t    ///\n427\t    /// Returns [`Error::Memory`] on the C `ERROR_MEMORY`\n428\t    /// allocation-failure path.\n429\t    pub fn install(link: &mut TestSimLink, l4s_max: u64) -> Result<(), Error> {\n430\t        if let Some(mut aqm) = link.aqm_state.take() {\n431\t            if let Some(dualq) = aqm.as_any_mut().downcast_mut::<Dualq>() {\n432\t                dualq.params_init(l4s_max, link);\n433\t                link.aqm_state = Some(aqm);\n434\t                return Ok(());\n435\t            }\n436\t            aqm.release(link);\n437\t        }\n438\t\n439\t        let mut dualq = Dualq::default();\n440\t        dualq.params_init(l4s_max, link);\n441\t        link.aqm_state = Some(Box::new(dualq));\n442\t        Ok(())\n443\t    }\n444\t\n445\t    /// Run the scheduler / mark / drop logic for one packet,\n446\t    /// returning the chosen packet (if any) along with the\n447\t    /// should-drop flag.  C: `picoquictest_sim_packet_t*\n448\t    /// dualq_dequeue_one(dualq_state_t* dualq, uint64_t\n449\t    /// current_time, int* should_drop)`.\n450\t    ///\n451\t    /// The C `should_drop` out-parameter folds into the tuple\n452\t    /// return.  `None` mirrors the C `NULL` \"no packet ready\" path;\n453\t    /// the C body always sets `*should_drop = 0` before returning\n454\t    /// `NULL`, so no flag survives that branch.\n455\t    ///\n456\t    /// Exposed publicly to mirror the C surface used by the\n457\t    /// `dualq_aqm_test.c` unit tests; Phase 2 translates those\n458\t    /// tests directly.\n459\t    pub fn dequeue_one(&mut self, current_time: Instant) -> Option<(TestSimPacket, bool)> {\n460\t        let (mut packet, is_lq) = self.scheduler()?;\n461\t        let mut should_drop = false;\n462\t\n463\t        if is_lq {\n464\t            if self.p_cl < self.p_l_max {\n465\t                self.p_prime_l = self.laqm(current_time);\n466\t                self.p_l = self.p_prime_l.max(self.p_cl);\n467\t                if Self::recur(&mut self.lq, self.p_prime_l) {\n468\t                    packet.ecn_mark = PICOQUIC_ECN_CE;\n469\t                }\n470\t            } else if Self::recur(&mut self.lq, self.p_c) {\n471\t                should_drop = true;\n472\t            } else if Self::recur(&mut self.lq, self.p_cl) {\n473\t                packet.ecn_mark = PICOQUIC_ECN_CE;\n474\t            }\n475\t        } else if Self::recur(&mut self.cq, self.p_c) {\n476\t            if packet.ecn_mark == 0 || self.p_c >= self.p_c_max {\n477\t                should_drop = true;\n478\t            } else {\n479\t                packet.ecn_mark = PICOQUIC_ECN_CE;\n480\t            }\n481\t        }\n482\t\n483\t        Some((packet, should_drop))\n484\t    }\n485\t}\n486\t\n487\t#[cfg(test)]\n488\tmod test {}\n489\t"}]},"parent_tool_use_id":null,"session_id":"0935a79a-3385-490e-8044-a2b7bb8dca0a","uuid":"cefc1b5f-8f3d-40e5-af12-2f3a72e0e335","timestamp":"2026-05-07T14:16:58.373Z","tool_use_result":{"type":"text","file":{"filePath":"/Users/richbarn/Projects/picoquic/rs/fq/src/tests/dualq.rs","content":"//! Translation of `picoquic/picoquictest_dualq.h` (with bodies in\n//! `picoquictest/dualq_aqm.c`).\n//!\n//! DualQ-Coupled AQM used by the test suite (RFC 9332 timestamp\n//! variant).  Sits behind a [`TestSimLink`]'s `aqm_state` slot and\n//! classifies arriving packets into an L4S queue ([`Dualq::lq`]) or\n//! a Classic queue ([`Dualq::cq`]); marks/drops on dequeue using the\n//! PI2 controller; and feeds admitted packets back into the link's\n//! transit queue.\n//!\n//! The implementation mirrors `picoquic/dualq_aqm.c`.\n//!\n//! Translation policy notes for this module:\n//!\n//! * The C vtable struct `picoquictest_aqm_t` is already a Rust\n//!   trait ([`TestAqm`](crate::tests::util::TestAqm)) in\n//!   [`crate::utils`].  The C \"embed `super` and cast pointer\"\n//!   inheritance pattern collapses to `impl TestAqm for Dualq`; the\n//!   C `super` field is dropped.\n//! * The C dualq pair of `queue_first` / `queue_last` raw\n//!   `*mut TestSimPacket` heads (the intrusive-linked-list shape\n//!   used by the parent sim-link) is replaced by an owning\n//!   `VecDeque<TestSimPacket>` per queue.  Submit pushes;\n//!   dequeue pops.  No raw pointers, no `unsafe`.\n//! * The C `dualq_dequeue_one`'s `int* should_drop` out-parameter\n//!   folds into a tuple return — `Option<(Box<...>, bool)>`\n//!   represents \"no packet ready\" / \"(packet, drop?)\".\n//! * The C `dualq_release` self-frees with `free(self)` and clears\n//!   `link->aqm_state`.  In Rust the trait method takes\n//!   `&mut self`; the actual deallocation rides on the\n//!   `Option<Box<dyn TestAqm>>` slot in the link being reset to\n//!   `None` by the caller after `release` drains the queues —\n//!   `release` itself only handles the queue drain.\n\nuse crate::Error;\nuse crate::Instant;\nuse crate::tests::util::{TestAqm, TestSimLink, TestSimPacket};\n\n// ---------------------------------------------------------------------------\n// Tunables.\n\n/// Simulation link-rate ceiling: 125,000,000 bytes/sec ≈ 1 Gbps.\n/// C: `#define DUALQ_MAX_LINK_RATE 125000000`.\npub const DUALQ_MAX_LINK_RATE: u64 = 125_000_000;\nconst PICOQUIC_ECN_ECT_1: u8 = 0x01;\nconst PICOQUIC_ECN_CE: u8 = 0x03;\n\n// ---------------------------------------------------------------------------\n// Per-queue state.\n\n/// One classified queue (L4S or Classic) inside a [`Dualq`].\n/// C: `dualq_queue_t`.\n///\n/// Storage shape:\n///\n/// * The C `queue_first` / `queue_last` pair (intrusive linked\n///   list, same pattern as [`crate::tests::util::TestSimLink`])\n///   is replaced by an owning `VecDeque<TestSimPacket>`.  Submit\n///   pushes to the back; dequeue pops from the front and hands\n///   ownership to the caller via [`Dualq::dequeue_one`].\n/// * `count` mirrors the C `int`, kept as `i32` for ABI parity with\n///   the dualq tests that inspect it directly.\n#[derive(Default)]\npub struct DualqQueue {\n    pub queue_bytes: u64,\n    /// Running sum of drop probability — when it crosses 1.0 the\n    /// `dualq_recur` helper \"fires\" and the head packet is\n    /// dropped/marked.  C: `double sum_p`.\n    pub sum_p: f64,\n    /// Packets in the queue.  Replaces the C `queue_first` /\n    /// `queue_last` head/tail pair.  `count` is `packets.len()`\n    /// (the C field is gone).\n    pub packets: std::collections::VecDeque<TestSimPacket>,\n}\n\nimpl DualqQueue {\n    /// Append `packet` to the tail of this queue.\n    /// C: `dualq_enqueue_queue(dualq_queue_t* xq,\n    /// picoquictest_sim_packet_t* packet)`.\n    pub fn enqueue(&mut self, packet: TestSimPacket) {\n        self.queue_bytes += packet.length as u64;\n        self.packets.push_back(packet);\n    }\n\n    /// C: `dualq_dequeue_queue` (picoquic/dualq_aqm.c:114)\n    ///\n    /// Remove and return the head packet from this queue, updating\n    /// `queue_bytes` and the packet count.  Returns `None` when empty.\n    fn dequeue(&mut self) -> Option<TestSimPacket> {\n        let packet = self.packets.pop_front()?;\n        if self.packets.is_empty() {\n            self.queue_bytes = 0;\n        } else if (packet.length as u64) < self.queue_bytes {\n            self.queue_bytes -= packet.length as u64;\n        } else {\n            self.queue_bytes = 1;\n        }\n        Some(packet)\n    }\n}\n\n// ---------------------------------------------------------------------------\n// AQM state.\n\n/// DualQ Coupled AQM state attached to a sim link.  C:\n/// `dualq_state_t`.\n///\n/// The C struct embedded a `picoquictest_aqm_t` vtable in its first\n/// field (`super`); in Rust the equivalent is `impl TestAqm for\n/// Dualq`, so the explicit `super` field is dropped.  All other\n/// fields mirror the C layout one-for-one.  Field names follow Rust\n/// conventions: the RFC 9332 symbols `p_Cmax`, `p'_L`, etc., become\n/// `p_c_max`, `p_prime_l`, and so on.\npub struct Dualq {\n    // -- Initialization parameters -----------------------------------\n    /// PI2 queue-delay target for both L4S and Classic, in\n    /// microseconds.\n    pub target: u64,\n    /// Coupling factor `k`.\n    pub k: f64,\n    /// Above this drop probability, the classic queue uses drops\n    /// instead of marks.  C: `p_Cmax`.\n    pub p_c_max: f64,\n    /// Interval between PI2 parameter updates, in microseconds.\n    /// C: `Tupdate`.\n    pub t_update: u64,\n    /// PI integral gain in Hz.\n    pub pi2_alpha: f64,\n    /// PI proportional gain in MHz (1 / microsecond).\n    pub pi2_beta: f64,\n    /// Above this queue-size threshold, the L queue behaves as\n    /// classic.  C: `maxTh`.\n    pub max_th: u64,\n    /// Queue size above which the L queue starts CE marking.\n    /// C: `minTh`.\n    pub min_th: u64,\n    /// `max_th - min_th`.\n    pub range: u64,\n    /// Above this drop probability, the L4S queue uses drops\n    /// instead of marks.  C: `p_Lmax`.\n    pub p_l_max: f64,\n    /// Maximum size of L4S + Classic queues, in bytes.\n    pub limit: u64,\n    /// Counter used for weighted fair queuing — 15 ticks for L4S,\n    /// 1 tick for Classic.  C: `int schedule_tick`.\n    pub schedule_tick: i32,\n\n    // -- Queues ------------------------------------------------------\n    /// L4S queue of pending packets.\n    pub lq: DualqQueue,\n    /// Classic queue of pending packets.\n    pub cq: DualqQueue,\n\n    // -- PI2 controller scratch space --------------------------------\n    /// Current length of the classic queue, in microseconds.\n    pub curq: i64,\n    /// Previous length of the classic queue, in microseconds.\n    pub prevq: i64,\n    /// Time at which the PI2 parameters should next be updated.\n    pub update_next: Instant,\n    pub lq_average_queue: u64,\n    /// `p'` coefficient (RFC 9332): nominal mark rate of the L4S\n    /// queue derived from the classic queue length.  C: `pprime`.\n    pub p_prime: f64,\n    /// `p'_L`: mark rate of the L4S queue computed from L4S queue\n    /// length, before coupling.  C: `pprime_L`.\n    pub p_prime_l: f64,\n    /// Actual mark rate of the L4S queue, after combining with\n    /// `p_cl`.  C: `p_L`.\n    pub p_l: f64,\n    /// Coupled L4S probability: `p_prime_l * k`.  C: `p_CL`.\n    pub p_cl: f64,\n    /// Nominal drop rate of the classic queue (`p_prime_l^2`).\n    /// C: `p_C`.\n    pub p_c: f64,\n\n    // -- Picoquic NS data --------------------------------------------\n    /// Time of the last `submit` call (microseconds).\n    pub last_input_time: Instant,\n}\n\nimpl Default for Dualq {\n    fn default() -> Self {\n        Self {\n            target: 0,\n            k: 0.0,\n            p_c_max: 0.0,\n            t_update: 0,\n            pi2_alpha: 0.0,\n            pi2_beta: 0.0,\n            max_th: 0,\n            min_th: 0,\n            range: 0,\n            p_l_max: 0.0,\n            limit: 0,\n            schedule_tick: 0,\n            lq: DualqQueue::default(),\n            cq: DualqQueue::default(),\n            curq: 0,\n            prevq: 0,\n            update_next: Instant::from_ticks(0),\n            lq_average_queue: 0,\n            p_prime: 0.0,\n            p_prime_l: 0.0,\n            p_l: 0.0,\n            p_cl: 0.0,\n            p_c: 0.0,\n            last_input_time: Instant::from_ticks(0),\n        }\n    }\n}\n\n// ---------------------------------------------------------------------------\n// Trait impl — replaces the C \"embedded vtable + cast\" inheritance.\n\nimpl TestAqm for Dualq {\n    /// C: `dualq_submit`.  Queues the packet, updates\n    /// `last_input_time`, and runs the dequeue/PI2 update pass.\n    fn submit(&mut self, link: &mut TestSimLink, packet: TestSimPacket, current_time: Instant) {\n        self.enqueue(link, packet, current_time);\n        self.last_input_time = current_time;\n        self.update_it(link, current_time);\n    }\n\n    /// C: `dualq_reset` — runs the dequeue/PI2 update pass at\n    /// `current_time`.\n    fn reset(&mut self, link: &mut TestSimLink, current_time: Instant) {\n        self.update_it(link, current_time);\n    }\n\n    /// C: `dualq_release` — drains both queues onto the link as\n    /// dropped packets.  The C body also `free(self)`s and nulls\n    /// `link->aqm_state`; in Rust the caller drops the\n    /// `Option<Box<dyn TestAqm>>` slot to do the same.\n    fn release(&mut self, link: &mut TestSimLink) {\n        while let Some(packet) = self.lq.dequeue() {\n            link.enqueue(packet, Instant::from_ticks(0), true);\n        }\n        while let Some(packet) = self.cq.dequeue() {\n            link.enqueue(packet, Instant::from_ticks(0), true);\n        }\n    }\n\n    /// C: `dualq_has_pending` — true iff either queue has at least\n    /// one packet ready to admit.\n    fn has_pending(&mut self) -> bool {\n        !self.lq.packets.is_empty() || !self.cq.packets.is_empty()\n    }\n\n    /// C: `dualq_admit_pending` — runs the dequeue/PI2 update pass\n    /// at `current_time`.\n    fn admit_pending(&mut self, link: &mut TestSimLink, current_time: Instant) {\n        self.update_it(link, current_time);\n    }\n\n    fn as_any_mut(&mut self) -> &mut dyn core::any::Any {\n        self\n    }\n}\n\nimpl Dualq {\n    fn total_queue_bytes(&self) -> u64 {\n        self.cq.queue_bytes + self.lq.queue_bytes\n    }\n\n    fn enqueue(\n        &mut self,\n        link: &mut TestSimLink,\n        mut packet: TestSimPacket,\n        current_time: Instant,\n    ) {\n        if self.total_queue_bytes() + packet.length as u64 > self.limit {\n            link.enqueue(packet, Instant::from_ticks(0), true);\n        } else {\n            packet.arrival_time = current_time;\n            if packet.ecn_mark == PICOQUIC_ECN_ECT_1 || packet.ecn_mark == PICOQUIC_ECN_CE {\n                self.lq.enqueue(packet);\n            } else {\n                self.cq.enqueue(packet);\n            }\n        }\n    }\n\n    /// C: `dualq_recur` (picoquic/dualq_aqm.c:182)\n    ///\n    /// Accumulate `likelihood` into `queue.sum_p`; return `true` (fire)\n    /// when the running sum crosses 1.0 and subtract 1.0.  Implements\n    /// the RFC 9332 stochastic drop/mark decision.\n    fn recur(queue: &mut DualqQueue, likelihood: f64) -> bool {\n        queue.sum_p += likelihood;\n        if queue.sum_p > 1.0 {\n            queue.sum_p -= 1.0;\n            true\n        } else {\n            false\n        }\n    }\n\n    fn scheduler(&mut self) -> Option<(TestSimPacket, bool)> {\n        let mut is_lq = (self.schedule_tick & 0x0f) != 0;\n        let mut packet = if is_lq {\n            self.lq.dequeue()\n        } else {\n            self.cq.dequeue()\n        };\n        if packet.is_none() {\n            is_lq = !is_lq;\n            packet = if is_lq {\n                self.lq.dequeue()\n            } else {\n                self.cq.dequeue()\n            };\n        }\n\n        self.schedule_tick = (self.schedule_tick + 1) & 0x0f;\n        packet.map(|packet| (packet, is_lq))\n    }\n\n    /// C: `dualq_laqm` (picoquic/dualq_aqm.c:210)\n    ///\n    /// Native L4S AQM probability derived from the sojourn time of the\n    /// head packet in the L4S queue.  Returns a value in [0.0, 1.0]:\n    /// 0 below `min_th`, linear ramp between `min_th` and `max_th`,\n    /// and 1.0 at or above `max_th`.\n    fn laqm(&self, current_time: Instant) -> f64 {\n        let mut p_prime = 0.0;\n        let mut lq_time = 0;\n        if self.lq.packets.len() > 1\n            && let Some(packet) = self.lq.packets.front()\n            && packet.arrival_time.ticks() < current_time.ticks()\n        {\n            lq_time = current_time.ticks() - packet.arrival_time.ticks();\n        }\n        if lq_time >= self.max_th {\n            p_prime = 1.0;\n        } else if lq_time > self.min_th {\n            p_prime = (lq_time - self.min_th) as f64 / self.range as f64;\n        }\n        p_prime\n    }\n\n    fn pi2_update(&mut self, current_time: Instant) {\n        let current_ticks = current_time.ticks();\n        let cq_time = self\n            .cq\n            .packets\n            .front()\n            .filter(|packet| packet.arrival_time.ticks() < current_ticks)\n            .map(|packet| current_ticks - packet.arrival_time.ticks())\n            .unwrap_or(0);\n        let lq_time = self\n            .lq\n            .packets\n            .front()\n            .filter(|packet| packet.arrival_time.ticks() < current_ticks)\n            .map(|packet| current_ticks - packet.arrival_time.ticks())\n            .unwrap_or(0);\n\n        self.curq = cq_time.max(lq_time) as i64;\n        let target_delta = self.curq - self.target as i64;\n        let delta_q = self.curq - self.prevq;\n\n        self.p_prime += self.pi2_alpha * target_delta as f64 + self.pi2_beta * delta_q as f64;\n        self.p_prime = self.p_prime.clamp(0.0, 1.0);\n\n        self.p_cl = self.p_prime * self.k;\n        if self.p_cl > 1.0 {\n            self.p_cl = 1.0;\n        }\n        self.p_c = self.p_prime * self.p_prime_l;\n        self.prevq = self.curq;\n    }\n\n    fn update_it(&mut self, link: &mut TestSimLink, current_time: Instant) {\n        while link.queue_time.ticks() <= current_time.ticks() {\n            if let Some((packet, should_drop)) = self.dequeue_one(current_time) {\n                link.enqueue(packet, current_time, should_drop);\n            } else {\n                break;\n            }\n        }\n\n        if current_time.ticks() >= self.update_next.ticks() {\n            self.pi2_update(current_time);\n            self.update_next = Instant::from_ticks(current_time.ticks() + self.t_update);\n        }\n    }\n\n    fn params_init(&mut self, l4s_max: u64, link: &TestSimLink) {\n        self.limit = if link.queue_delay_max <= link.microsec_latency || link.picosec_per_byte == 0\n        {\n            (250u64 * DUALQ_MAX_LINK_RATE) / 1_000_000\n        } else {\n            let queue_delay = link.queue_delay_max - link.microsec_latency;\n            (queue_delay * 1_000_000) / link.picosec_per_byte\n        };\n        self.k = 2.0;\n        self.target = 15_000;\n        let rtt_max = 100_000u64;\n        self.p_c_max = 1.0 / (self.k * self.k);\n        if self.p_c_max > 1.0 {\n            self.p_c_max = 1.0;\n        }\n        self.t_update = rtt_max / 3;\n        if self.t_update > self.target {\n            self.t_update = self.target;\n        }\n        self.pi2_alpha = (0.1 * self.t_update as f64) / (rtt_max as f64 * rtt_max as f64);\n        self.pi2_beta = 0.3 / rtt_max as f64;\n\n        if l4s_max == 0 {\n            self.max_th = 1200;\n            self.min_th = 800;\n        } else {\n            self.max_th = l4s_max;\n            self.min_th = if l4s_max > 1200 { 800 } else { l4s_max / 3 };\n        }\n        self.range = self.max_th - self.min_th;\n        self.p_l_max = 1.0;\n    }\n\n    /// Install a fresh DualQ AQM on `link`, sized for an L4S queue\n    /// of at most `l4s_max` bytes.  C: `int\n    /// dualq_configure(picoquictest_sim_link_t* link, uint64_t\n    /// l4s_max)`.\n    ///\n    /// Returns [`Error::Memory`] on the C `ERROR_MEMORY`\n    /// allocation-failure path.\n    pub fn install(link: &mut TestSimLink, l4s_max: u64) -> Result<(), Error> {\n        if let Some(mut aqm) = link.aqm_state.take() {\n            if let Some(dualq) = aqm.as_any_mut().downcast_mut::<Dualq>() {\n                dualq.params_init(l4s_max, link);\n                link.aqm_state = Some(aqm);\n                return Ok(());\n            }\n            aqm.release(link);\n        }\n\n        let mut dualq = Dualq::default();\n        dualq.params_init(l4s_max, link);\n        link.aqm_state = Some(Box::new(dualq));\n        Ok(())\n    }\n\n    /// Run the scheduler / mark / drop logic for one packet,\n    /// returning the chosen packet (if any) along with the\n    /// should-drop flag.  C: `picoquictest_sim_packet_t*\n    /// dualq_dequeue_one(dualq_state_t* dualq, uint64_t\n    /// current_time, int* should_drop)`.\n    ///\n    /// The C `should_drop` out-parameter folds into the tuple\n    /// return.  `None` mirrors the C `NULL` \"no packet ready\" path;\n    /// the C body always sets `*should_drop = 0` before returning\n    /// `NULL`, so no flag survives that branch.\n    ///\n    /// Exposed publicly to mirror the C surface used by the\n    /// `dualq_aqm_test.c` unit tests; Phase 2 translates those\n    /// tests directly.\n    pub fn dequeue_one(&mut self, current_time: Instant) -> Option<(TestSimPacket, bool)> {\n        let (mut packet, is_lq) = self.scheduler()?;\n        let mut should_drop = false;\n\n        if is_lq {\n            if self.p_cl < self.p_l_max {\n                self.p_prime_l = self.laqm(current_time);\n                self.p_l = self.p_prime_l.max(self.p_cl);\n                if Self::recur(&mut self.lq, self.p_prime_l) {\n                    packet.ecn_mark = PICOQUIC_ECN_CE;\n                }\n            } else if Self::recur(&mut self.lq, self.p_c) {\n                should_drop = true;\n            } else if Self::recur(&mut self.lq, self.p_cl) {\n                packet.ecn_mark = PICOQUIC_ECN_CE;\n            }\n        } else if Self::recur(&mut self.cq, self.p_c) {\n            if packet.ecn_mark == 0 || self.p_c >= self.p_c_max {\n                should_drop = true;\n            } else {\n                packet.ecn_mark = PICOQUIC_ECN_CE;\n            }\n        }\n\n        Some((packet, should_drop))\n    }\n}\n\n#[cfg(test)]\nmod test {}\n","numLines":489,"startLine":1,"totalLines":489}}}
