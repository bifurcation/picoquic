{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_017UEdRA413Ckk9ZEX6z4tAF","type":"tool_result","content":"1\t//! Test cases for `picoquictest/dualq_aqm_test.c`.\n2\t//!\n3\t//! Unit tests for the DualQ Coupled AQM (RFC 9332) implementation used\n4\t//! in the network simulator.  The test suite is structured as five\n5\t//! sequential sub-tests:\n6\t//!\n7\t//! 1. `dualq_ctx_test`   — create / release the context.\n8\t//! 2. `dualq_enqueue`    — verify the per-queue enqueue API.\n9\t//! 3. `dualq_dequeue`    — verify the dequeue scheduler.\n10\t//! 4. `dualq_submit`     — verify submit routing and drop-on-overflow.\n11\t//! 5. `dualq_sustain`    — end-to-end throughput with mixed ECN traffic.\n12\t\n13\t#![allow(non_snake_case)]\n14\t\n15\tuse crate::Instant;\n16\tuse crate::tests::dualq::{Dualq, DualqQueue};\n17\tuse crate::tests::util::{TestAqm, TestSimLink, TestSimPacket};\n18\t\n19\t// ---------------------------------------------------------------------------\n20\t// Sub-test helpers.  Each mirrors one C helper function.\n21\t\n22\tconst ECN_ECT_0: u8 = 0x02;\n23\tconst ECN_ECT_1: u8 = 0x01;\n24\tconst ECN_CE: u8 = 0x03;\n25\tconst ECN_SEQUENCE: [u8; 5] = [0, ECN_ECT_0, 0, ECN_ECT_1, ECN_CE];\n26\tconst QUEUE_ID: [u8; 5] = [0, 0, 0, 1, 1];\n27\t\n28\tstruct DualqTestCtx {\n29\t    link: TestSimLink,\n30\t    simulated_time: Instant,\n31\t}\n32\t\n33\tfn check(ok: bool) -> crate::Result<()> {\n34\t    if ok {\n35\t        Ok(())\n36\t    } else {\n37\t        Err(crate::Error::Generic)\n38\t    }\n39\t}\n40\t\n41\tfn dualq_test_get_ctx() -> crate::Result<DualqTestCtx> {\n42\t    let simulated_time = Instant::from_ticks(0);\n43\t    let mut link = TestSimLink::create(0.01, 25_000, None, 50_000, simulated_time)?;\n44\t    Dualq::install(&mut link, 5_000)?;\n45\t    Ok(DualqTestCtx {\n46\t        link,\n47\t        simulated_time,\n48\t    })\n49\t}\n50\t\n51\tfn with_dualq<R>(\n52\t    link: &mut TestSimLink,\n53\t    f: impl FnOnce(&mut Dualq, &mut TestSimLink) -> crate::Result<R>,\n54\t) -> crate::Result<R> {\n55\t    let mut aqm = link.aqm_state.take().ok_or(crate::Error::Generic)?;\n56\t    let result = match aqm.as_any_mut().downcast_mut::<Dualq>() {\n57\t        Some(dualq) => f(dualq, link),\n58\t        None => Err(crate::Error::Generic),\n59\t    };\n60\t    link.aqm_state = Some(aqm);\n61\t    result\n62\t}\n63\t\n64\tfn dualq_test_get_packet(ecn_mark: u8, length: usize) -> crate::Result<TestSimPacket> {\n65\t    let mut packet = TestSimPacket::create()?;\n66\t    packet.ecn_mark = ecn_mark;\n67\t    packet.length = length;\n68\t    Ok(packet)\n69\t}\n70\t\n71\tfn queue_for_mut(dualq: &mut Dualq, queue_id: u8) -> &mut DualqQueue {\n72\t    if queue_id == 0 {\n73\t        &mut dualq.cq\n74\t    } else {\n75\t        &mut dualq.lq\n76\t    }\n77\t}\n78\t\n79\tfn queue_bytes(dualq: &Dualq, queue_id: u8) -> u64 {\n80\t    if queue_id == 0 {\n81\t        dualq.cq.queue_bytes\n82\t    } else {\n83\t        dualq.lq.queue_bytes\n84\t    }\n85\t}\n86\t\n87\tfn packet_key(packet: &TestSimPacket) -> (u64, usize, u8, u8) {\n88\t    (\n89\t        packet.arrival_time.ticks(),\n90\t        packet.length,\n91\t        packet.ecn_mark,\n92\t        packet.bytes[0],\n93\t    )\n94\t}\n95\t\n96\tfn dualq_test_check_queue(link: &TestSimLink) -> crate::Result<()> {\n97\t    let mut previous_time = 0;\n98\t    for packet in &link.packets {\n99\t        let arrival_time = packet.arrival_time.ticks();\n100\t        check(arrival_time > previous_time)?;\n101\t        previous_time = arrival_time;\n102\t    }\n103\t    Ok(())\n104\t}\n105\t\n106\t/// Verify that `test_set_minimal_cnx_with_time` + `TestSimLink::create` +\n107\t/// `Dualq::install` complete without error.\n108\t/// C: `dualq_test_ctx_test`.\n109\tfn dualq_ctx_test() -> crate::Result<()> {\n110\t    let mut ctx = dualq_test_get_ctx()?;\n111\t    with_dualq(&mut ctx.link, |_dualq, _link| Ok(()))\n112\t}\n113\t\n114\t/// Enqueue one packet per ECN value into the matching queue and verify\n115\t/// that `queue_bytes`, head, and tail pointers update correctly.\n116\t/// C: `dualq_enqueue_test`.\n117\tfn dualq_enqueue() -> crate::Result<()> {\n118\t    let mut ctx = dualq_test_get_ctx()?;\n119\t\n120\t    with_dualq(&mut ctx.link, |dualq, link| {\n121\t        for i in 0..ECN_SEQUENCE.len() {\n122\t            let packet = dualq_test_get_packet(ECN_SEQUENCE[i], 1000)?;\n123\t            let new_key = packet_key(&packet);\n124\t            let link_queue_len = link.packets.len();\n125\t            let xq = queue_for_mut(dualq, QUEUE_ID[i]);\n126\t            let old_bytes = xq.queue_bytes;\n127\t            let old_len = xq.packets.len();\n128\t            let old_front = xq.packets.front().map(packet_key);\n129\t\n130\t            xq.enqueue(packet);\n131\t\n132\t            check(xq.packets.len() == old_len + 1)?;\n133\t            check(xq.queue_bytes == old_bytes + 1000)?;\n134\t            check(xq.packets.back().map(packet_key) == Some(new_key))?;\n135\t            if old_len == 0 {\n136\t                check(xq.packets.front().map(packet_key) == Some(new_key))?;\n137\t            } else {\n138\t                check(xq.packets.front().map(packet_key) == old_front)?;\n139\t            }\n140\t            check(link.packets.len() == link_queue_len)?;\n141\t        }\n142\t        Ok(())\n143\t    })\n144\t}\n145\t\n146\t/// Load five packets, dequeue until both queues are empty, and verify\n147\t/// all five packets are delivered within 100 ms simulated time.\n148\t/// C: `dualq_dequeue_test`.\n149\tfn dualq_dequeue() -> crate::Result<()> {\n150\t    let mut ctx = dualq_test_get_ctx()?;\n151\t\n152\t    with_dualq(&mut ctx.link, |dualq, _link| {\n153\t        for i in 0..ECN_SEQUENCE.len() {\n154\t            let packet = dualq_test_get_packet(ECN_SEQUENCE[i], 1000)?;\n155\t            queue_for_mut(dualq, QUEUE_ID[i]).enqueue(packet);\n156\t        }\n157\t\n158\t        let mut trials = 0;\n159\t        let mut received = 0;\n160\t        while dualq.lq.queue_bytes > 0 || dualq.cq.queue_bytes > 0 {\n161\t            trials += 1;\n162\t            check(trials <= 1000)?;\n163\t            if let Some((_packet, _should_drop)) = dualq.dequeue_one(ctx.simulated_time) {\n164\t                received += 1;\n165\t            } else {\n166\t                ctx.simulated_time = Instant::from_ticks(ctx.simulated_time.ticks() + 1000);\n167\t            }\n168\t        }\n169\t\n170\t        check(received == 5)?;\n171\t        check(dualq.cq.queue_bytes == 0 && dualq.cq.packets.is_empty())?;\n172\t        check(dualq.lq.queue_bytes == 0 && dualq.lq.packets.is_empty())?;\n173\t        check(ctx.simulated_time.ticks() <= 100_000)\n174\t    })\n175\t}\n176\t\n177\t/// Submit 50 packets and verify that: the first packet goes directly to\n178\t/// the link when the link queue is idle; subsequent packets go to the AQM\n179\t/// queues; and at least one packet is dropped when the combined queue\n180\t/// exceeds `dqs.limit`.\n181\t/// C: `dualq_submit_test`.\n182\tfn dualq_submit() -> crate::Result<()> {\n183\t    let mut ctx = dualq_test_get_ctx()?;\n184\t    let mut one_was_dropped = false;\n185\t\n186\t    with_dualq(&mut ctx.link, |dualq, link| {\n187\t        for i in 0..50 {\n188\t            let i_queue = i % ECN_SEQUENCE.len();\n189\t            let packet = dualq_test_get_packet(ECN_SEQUENCE[i_queue], 1000)?;\n190\t            let old_bytes = queue_bytes(dualq, QUEUE_ID[i_queue]);\n191\t            let old_queue_time = link.queue_time;\n192\t            let old_total = dualq.cq.queue_bytes + dualq.lq.queue_bytes + packet.length as u64;\n193\t\n194\t            dualq.submit(link, packet, ctx.simulated_time);\n195\t\n196\t            if old_queue_time.ticks() <= ctx.simulated_time.ticks() {\n197\t                check(link.queue_time != old_queue_time)?;\n198\t            } else {\n199\t                check(link.queue_time == old_queue_time)?;\n200\t                if old_total > dualq.limit {\n201\t                    check(queue_bytes(dualq, QUEUE_ID[i_queue]) == old_bytes)?;\n202\t                    one_was_dropped = true;\n203\t                    break;\n204\t                } else {\n205\t                    check(queue_bytes(dualq, QUEUE_ID[i_queue]) != old_bytes)?;\n206\t                    dualq_test_check_queue(link)?;\n207\t                }\n208\t            }\n209\t        }\n210\t        Ok(())\n211\t    })?;\n212\t\n213\t    check(one_was_dropped)\n214\t}\n215\t\n216\t/// Drive 100 mixed-ECN packets through the full submit→dequeue pipeline,\n217\t/// interleaving arrivals, admissions, and submissions; verify all 100 are\n218\t/// accounted for (received + dropped) within 125 ms simulated time.\n219\t/// C: `dualq_sustain_test`.\n220\tfn dualq_sustain() -> crate::Result<()> {\n221\t    #[derive(Copy, Clone)]\n222\t    enum SustainAction {\n223\t        Arrival,\n224\t        Admission,\n225\t        Submit,\n226\t    }\n227\t\n228\t    fn receive(ctx: &mut DualqTestCtx, nb_received: &mut i32) -> crate::Result<()> {\n229\t        check(ctx.link.dequeue(ctx.simulated_time).is_some())?;\n230\t        *nb_received += 1;\n231\t        dualq_test_check_queue(&ctx.link)\n232\t    }\n233\t\n234\t    fn admit(ctx: &mut DualqTestCtx) {\n235\t        ctx.link.admit_pending(ctx.simulated_time);\n236\t    }\n237\t\n238\t    fn submit(ctx: &mut DualqTestCtx, nb_sent: &mut i32) -> crate::Result<()> {\n239\t        let mut packet = dualq_test_get_packet(ECN_SEQUENCE[*nb_sent as usize % 5], 1000)?;\n240\t        packet.bytes[0] = *nb_sent as u8;\n241\t        *nb_sent += 1;\n242\t        ctx.link.submit(packet, ctx.simulated_time);\n243\t        dualq_test_check_queue(&ctx.link)\n244\t    }\n245\t\n246\t    let mut ctx = dualq_test_get_ctx()?;\n247\t    let mut submit_time = ctx.simulated_time.ticks();\n248\t    let max_time = 125_000;\n249\t    let mut nb_received = 0;\n250\t    let mut nb_sent = 0;\n251\t\n252\t    loop {\n253\t        let mut action_time = u64::MAX;\n254\t        let mut next_action = None;\n255\t        let arrival_time = ctx.link.next_arrival(Instant::from_ticks(action_time));\n256\t        if arrival_time < action_time {\n257\t            next_action = Some(SustainAction::Arrival);\n258\t            action_time = arrival_time;\n259\t        }\n260\t\n261\t        let admission_time = ctx\n262\t            .link\n263\t            .next_admission(ctx.simulated_time, Instant::from_ticks(action_time));\n264\t        if admission_time < action_time {\n265\t            next_action = Some(SustainAction::Admission);\n266\t            action_time = admission_time;\n267\t        }\n268\t\n269\t        let can_submit = with_dualq(&mut ctx.link, |dualq, _link| {\n270\t            Ok(dualq.cq.queue_bytes + dualq.lq.queue_bytes + 1000 <= dualq.limit)\n271\t        })?;\n272\t        if nb_sent < 100 && can_submit && submit_time < action_time {\n273\t            next_action = Some(SustainAction::Submit);\n274\t            action_time = submit_time;\n275\t        }\n276\t\n277\t        let Some(next_action) = next_action else {\n278\t            break;\n279\t        };\n280\t\n281\t        if ctx.simulated_time.ticks() < action_time {\n282\t            check(action_time <= ctx.simulated_time.ticks() + 4000)?;\n283\t            ctx.simulated_time = Instant::from_ticks(action_time);\n284\t        } else {\n285\t            action_time = ctx.simulated_time.ticks();\n286\t        }\n287\t\n288\t        match next_action {\n289\t            SustainAction::Submit => {\n290\t                submit(&mut ctx, &mut nb_sent)?;\n291\t                if nb_sent % 7 == 0 {\n292\t                    submit_time += 4000;\n293\t                }\n294\t            }\n295\t            SustainAction::Arrival => receive(&mut ctx, &mut nb_received)?,\n296\t            SustainAction::Admission => admit(&mut ctx),\n297\t        }\n298\t\n299\t        let _ = action_time;\n300\t    }\n301\t\n302\t    check(nb_received as u64 + ctx.link.packets_dropped == 100)?;\n303\t    check(ctx.simulated_time.ticks() <= max_time)\n304\t}\n305\t\n306\t// ---------------------------------------------------------------------------\n307\t// Test entry.\n308\t\n309\t/// Run the full DualQ AQM unit-test suite.\n310\t/// C: `dualq_aqm_test` in `picoquictest/dualq_aqm_test.c`.\n311\t#[test]\n312\tfn dualq_aqm() {\n313\t    dualq_ctx_test().expect(\"dualq_ctx_test\");\n314\t    dualq_enqueue().expect(\"dualq_enqueue\");\n315\t    dualq_dequeue().expect(\"dualq_dequeue\");\n316\t    dualq_submit().expect(\"dualq_submit\");\n317\t    dualq_sustain().expect(\"dualq_sustain\");\n318\t}\n319\t"}]},"parent_tool_use_id":null,"session_id":"0935a79a-3385-490e-8044-a2b7bb8dca0a","uuid":"f52f7c3b-75a7-4582-a354-6b60cbce6002","timestamp":"2026-05-07T14:16:53.673Z","tool_use_result":{"type":"text","file":{"filePath":"/Users/richbarn/Projects/picoquic/rs/fq/src/tests/dualq_aqm.rs","content":"//! Test cases for `picoquictest/dualq_aqm_test.c`.\n//!\n//! Unit tests for the DualQ Coupled AQM (RFC 9332) implementation used\n//! in the network simulator.  The test suite is structured as five\n//! sequential sub-tests:\n//!\n//! 1. `dualq_ctx_test`   — create / release the context.\n//! 2. `dualq_enqueue`    — verify the per-queue enqueue API.\n//! 3. `dualq_dequeue`    — verify the dequeue scheduler.\n//! 4. `dualq_submit`     — verify submit routing and drop-on-overflow.\n//! 5. `dualq_sustain`    — end-to-end throughput with mixed ECN traffic.\n\n#![allow(non_snake_case)]\n\nuse crate::Instant;\nuse crate::tests::dualq::{Dualq, DualqQueue};\nuse crate::tests::util::{TestAqm, TestSimLink, TestSimPacket};\n\n// ---------------------------------------------------------------------------\n// Sub-test helpers.  Each mirrors one C helper function.\n\nconst ECN_ECT_0: u8 = 0x02;\nconst ECN_ECT_1: u8 = 0x01;\nconst ECN_CE: u8 = 0x03;\nconst ECN_SEQUENCE: [u8; 5] = [0, ECN_ECT_0, 0, ECN_ECT_1, ECN_CE];\nconst QUEUE_ID: [u8; 5] = [0, 0, 0, 1, 1];\n\nstruct DualqTestCtx {\n    link: TestSimLink,\n    simulated_time: Instant,\n}\n\nfn check(ok: bool) -> crate::Result<()> {\n    if ok {\n        Ok(())\n    } else {\n        Err(crate::Error::Generic)\n    }\n}\n\nfn dualq_test_get_ctx() -> crate::Result<DualqTestCtx> {\n    let simulated_time = Instant::from_ticks(0);\n    let mut link = TestSimLink::create(0.01, 25_000, None, 50_000, simulated_time)?;\n    Dualq::install(&mut link, 5_000)?;\n    Ok(DualqTestCtx {\n        link,\n        simulated_time,\n    })\n}\n\nfn with_dualq<R>(\n    link: &mut TestSimLink,\n    f: impl FnOnce(&mut Dualq, &mut TestSimLink) -> crate::Result<R>,\n) -> crate::Result<R> {\n    let mut aqm = link.aqm_state.take().ok_or(crate::Error::Generic)?;\n    let result = match aqm.as_any_mut().downcast_mut::<Dualq>() {\n        Some(dualq) => f(dualq, link),\n        None => Err(crate::Error::Generic),\n    };\n    link.aqm_state = Some(aqm);\n    result\n}\n\nfn dualq_test_get_packet(ecn_mark: u8, length: usize) -> crate::Result<TestSimPacket> {\n    let mut packet = TestSimPacket::create()?;\n    packet.ecn_mark = ecn_mark;\n    packet.length = length;\n    Ok(packet)\n}\n\nfn queue_for_mut(dualq: &mut Dualq, queue_id: u8) -> &mut DualqQueue {\n    if queue_id == 0 {\n        &mut dualq.cq\n    } else {\n        &mut dualq.lq\n    }\n}\n\nfn queue_bytes(dualq: &Dualq, queue_id: u8) -> u64 {\n    if queue_id == 0 {\n        dualq.cq.queue_bytes\n    } else {\n        dualq.lq.queue_bytes\n    }\n}\n\nfn packet_key(packet: &TestSimPacket) -> (u64, usize, u8, u8) {\n    (\n        packet.arrival_time.ticks(),\n        packet.length,\n        packet.ecn_mark,\n        packet.bytes[0],\n    )\n}\n\nfn dualq_test_check_queue(link: &TestSimLink) -> crate::Result<()> {\n    let mut previous_time = 0;\n    for packet in &link.packets {\n        let arrival_time = packet.arrival_time.ticks();\n        check(arrival_time > previous_time)?;\n        previous_time = arrival_time;\n    }\n    Ok(())\n}\n\n/// Verify that `test_set_minimal_cnx_with_time` + `TestSimLink::create` +\n/// `Dualq::install` complete without error.\n/// C: `dualq_test_ctx_test`.\nfn dualq_ctx_test() -> crate::Result<()> {\n    let mut ctx = dualq_test_get_ctx()?;\n    with_dualq(&mut ctx.link, |_dualq, _link| Ok(()))\n}\n\n/// Enqueue one packet per ECN value into the matching queue and verify\n/// that `queue_bytes`, head, and tail pointers update correctly.\n/// C: `dualq_enqueue_test`.\nfn dualq_enqueue() -> crate::Result<()> {\n    let mut ctx = dualq_test_get_ctx()?;\n\n    with_dualq(&mut ctx.link, |dualq, link| {\n        for i in 0..ECN_SEQUENCE.len() {\n            let packet = dualq_test_get_packet(ECN_SEQUENCE[i], 1000)?;\n            let new_key = packet_key(&packet);\n            let link_queue_len = link.packets.len();\n            let xq = queue_for_mut(dualq, QUEUE_ID[i]);\n            let old_bytes = xq.queue_bytes;\n            let old_len = xq.packets.len();\n            let old_front = xq.packets.front().map(packet_key);\n\n            xq.enqueue(packet);\n\n            check(xq.packets.len() == old_len + 1)?;\n            check(xq.queue_bytes == old_bytes + 1000)?;\n            check(xq.packets.back().map(packet_key) == Some(new_key))?;\n            if old_len == 0 {\n                check(xq.packets.front().map(packet_key) == Some(new_key))?;\n            } else {\n                check(xq.packets.front().map(packet_key) == old_front)?;\n            }\n            check(link.packets.len() == link_queue_len)?;\n        }\n        Ok(())\n    })\n}\n\n/// Load five packets, dequeue until both queues are empty, and verify\n/// all five packets are delivered within 100 ms simulated time.\n/// C: `dualq_dequeue_test`.\nfn dualq_dequeue() -> crate::Result<()> {\n    let mut ctx = dualq_test_get_ctx()?;\n\n    with_dualq(&mut ctx.link, |dualq, _link| {\n        for i in 0..ECN_SEQUENCE.len() {\n            let packet = dualq_test_get_packet(ECN_SEQUENCE[i], 1000)?;\n            queue_for_mut(dualq, QUEUE_ID[i]).enqueue(packet);\n        }\n\n        let mut trials = 0;\n        let mut received = 0;\n        while dualq.lq.queue_bytes > 0 || dualq.cq.queue_bytes > 0 {\n            trials += 1;\n            check(trials <= 1000)?;\n            if let Some((_packet, _should_drop)) = dualq.dequeue_one(ctx.simulated_time) {\n                received += 1;\n            } else {\n                ctx.simulated_time = Instant::from_ticks(ctx.simulated_time.ticks() + 1000);\n            }\n        }\n\n        check(received == 5)?;\n        check(dualq.cq.queue_bytes == 0 && dualq.cq.packets.is_empty())?;\n        check(dualq.lq.queue_bytes == 0 && dualq.lq.packets.is_empty())?;\n        check(ctx.simulated_time.ticks() <= 100_000)\n    })\n}\n\n/// Submit 50 packets and verify that: the first packet goes directly to\n/// the link when the link queue is idle; subsequent packets go to the AQM\n/// queues; and at least one packet is dropped when the combined queue\n/// exceeds `dqs.limit`.\n/// C: `dualq_submit_test`.\nfn dualq_submit() -> crate::Result<()> {\n    let mut ctx = dualq_test_get_ctx()?;\n    let mut one_was_dropped = false;\n\n    with_dualq(&mut ctx.link, |dualq, link| {\n        for i in 0..50 {\n            let i_queue = i % ECN_SEQUENCE.len();\n            let packet = dualq_test_get_packet(ECN_SEQUENCE[i_queue], 1000)?;\n            let old_bytes = queue_bytes(dualq, QUEUE_ID[i_queue]);\n            let old_queue_time = link.queue_time;\n            let old_total = dualq.cq.queue_bytes + dualq.lq.queue_bytes + packet.length as u64;\n\n            dualq.submit(link, packet, ctx.simulated_time);\n\n            if old_queue_time.ticks() <= ctx.simulated_time.ticks() {\n                check(link.queue_time != old_queue_time)?;\n            } else {\n                check(link.queue_time == old_queue_time)?;\n                if old_total > dualq.limit {\n                    check(queue_bytes(dualq, QUEUE_ID[i_queue]) == old_bytes)?;\n                    one_was_dropped = true;\n                    break;\n                } else {\n                    check(queue_bytes(dualq, QUEUE_ID[i_queue]) != old_bytes)?;\n                    dualq_test_check_queue(link)?;\n                }\n            }\n        }\n        Ok(())\n    })?;\n\n    check(one_was_dropped)\n}\n\n/// Drive 100 mixed-ECN packets through the full submit→dequeue pipeline,\n/// interleaving arrivals, admissions, and submissions; verify all 100 are\n/// accounted for (received + dropped) within 125 ms simulated time.\n/// C: `dualq_sustain_test`.\nfn dualq_sustain() -> crate::Result<()> {\n    #[derive(Copy, Clone)]\n    enum SustainAction {\n        Arrival,\n        Admission,\n        Submit,\n    }\n\n    fn receive(ctx: &mut DualqTestCtx, nb_received: &mut i32) -> crate::Result<()> {\n        check(ctx.link.dequeue(ctx.simulated_time).is_some())?;\n        *nb_received += 1;\n        dualq_test_check_queue(&ctx.link)\n    }\n\n    fn admit(ctx: &mut DualqTestCtx) {\n        ctx.link.admit_pending(ctx.simulated_time);\n    }\n\n    fn submit(ctx: &mut DualqTestCtx, nb_sent: &mut i32) -> crate::Result<()> {\n        let mut packet = dualq_test_get_packet(ECN_SEQUENCE[*nb_sent as usize % 5], 1000)?;\n        packet.bytes[0] = *nb_sent as u8;\n        *nb_sent += 1;\n        ctx.link.submit(packet, ctx.simulated_time);\n        dualq_test_check_queue(&ctx.link)\n    }\n\n    let mut ctx = dualq_test_get_ctx()?;\n    let mut submit_time = ctx.simulated_time.ticks();\n    let max_time = 125_000;\n    let mut nb_received = 0;\n    let mut nb_sent = 0;\n\n    loop {\n        let mut action_time = u64::MAX;\n        let mut next_action = None;\n        let arrival_time = ctx.link.next_arrival(Instant::from_ticks(action_time));\n        if arrival_time < action_time {\n            next_action = Some(SustainAction::Arrival);\n            action_time = arrival_time;\n        }\n\n        let admission_time = ctx\n            .link\n            .next_admission(ctx.simulated_time, Instant::from_ticks(action_time));\n        if admission_time < action_time {\n            next_action = Some(SustainAction::Admission);\n            action_time = admission_time;\n        }\n\n        let can_submit = with_dualq(&mut ctx.link, |dualq, _link| {\n            Ok(dualq.cq.queue_bytes + dualq.lq.queue_bytes + 1000 <= dualq.limit)\n        })?;\n        if nb_sent < 100 && can_submit && submit_time < action_time {\n            next_action = Some(SustainAction::Submit);\n            action_time = submit_time;\n        }\n\n        let Some(next_action) = next_action else {\n            break;\n        };\n\n        if ctx.simulated_time.ticks() < action_time {\n            check(action_time <= ctx.simulated_time.ticks() + 4000)?;\n            ctx.simulated_time = Instant::from_ticks(action_time);\n        } else {\n            action_time = ctx.simulated_time.ticks();\n        }\n\n        match next_action {\n            SustainAction::Submit => {\n                submit(&mut ctx, &mut nb_sent)?;\n                if nb_sent % 7 == 0 {\n                    submit_time += 4000;\n                }\n            }\n            SustainAction::Arrival => receive(&mut ctx, &mut nb_received)?,\n            SustainAction::Admission => admit(&mut ctx),\n        }\n\n        let _ = action_time;\n    }\n\n    check(nb_received as u64 + ctx.link.packets_dropped == 100)?;\n    check(ctx.simulated_time.ticks() <= max_time)\n}\n\n// ---------------------------------------------------------------------------\n// Test entry.\n\n/// Run the full DualQ AQM unit-test suite.\n/// C: `dualq_aqm_test` in `picoquictest/dualq_aqm_test.c`.\n#[test]\nfn dualq_aqm() {\n    dualq_ctx_test().expect(\"dualq_ctx_test\");\n    dualq_enqueue().expect(\"dualq_enqueue\");\n    dualq_dequeue().expect(\"dualq_dequeue\");\n    dualq_submit().expect(\"dualq_submit\");\n    dualq_sustain().expect(\"dualq_sustain\");\n}\n","numLines":319,"startLine":1,"totalLines":319}}}
{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01YLmLEtFphmvmbB6EqaNV21","type":"tool_result","content":"1\t//! Encrypted ClientHello (ECH) helpers.\n2\t//!\n3\t//! Pure-Rust portion of the ECH support layer, fully translated from\n4\t//! `picoquic/ech.c`.  HPKE key-exchange (DHKEM-X25519, DHKEM-P256,\n5\t//! DHKEM-P384) is implemented via the `hpke` crate; the remaining logic\n6\t//! — cipher-suite selection, config-ID derivation, base64 encoding, and\n7\t//! opener-state plumbing — is translated directly.\n8\t\n9\textern crate alloc;\n10\tuse alloc::vec::Vec;\n11\t\n12\tuse crate::Error;\n13\t\n14\t// ---------------------------------------------------------------------------\n15\t// HPKE constants (IANA registries, RFC 9180).\n16\t\n17\t/// HPKE KEM algorithm identifiers (RFC 9180 §7.1).\n18\tpub mod kem_id {\n19\t    /// DHKEM(P-256, HKDF-SHA256)\n20\t    pub const P256_SHA256: u16 = 0x0010;\n21\t    /// DHKEM(P-384, HKDF-SHA384)\n22\t    pub const P384_SHA384: u16 = 0x0011;\n23\t    /// DHKEM(X25519, HKDF-SHA256)\n24\t    pub const X25519_SHA256: u16 = 0x0020;\n25\t}\n26\t\n27\t/// HPKE KDF algorithm identifiers (RFC 9180 §7.2).\n28\tpub mod kdf_id {\n29\t    /// HKDF-SHA256\n30\t    pub const HKDF_SHA256: u16 = 0x0001;\n31\t    /// HKDF-SHA384\n32\t    pub const HKDF_SHA384: u16 = 0x0002;\n33\t    /// HKDF-SHA512\n34\t    pub const HKDF_SHA512: u16 = 0x0003;\n35\t}\n36\t\n37\t/// HPKE AEAD algorithm identifiers (RFC 9180 §7.3).\n38\tpub mod aead_id {\n39\t    /// AES-128-GCM\n40\t    pub const AES_128_GCM: u16 = 0x0001;\n41\t    /// AES-256-GCM\n42\t    pub const AES_256_GCM: u16 = 0x0002;\n43\t    /// ChaCha20-Poly1305\n44\t    pub const CHACHA20_POLY1305: u16 = 0x0003;\n45\t}\n46\t\n47\t// ---------------------------------------------------------------------------\n48\t// Cipher-suite identifier.\n49\t\n50\t/// HPKE symmetric cipher-suite: (KDF id, AEAD id) pair.\n51\t///\n52\t/// C: `ptls_hpke_cipher_suite_id_t`\n53\t#[derive(Debug, Clone, Copy, PartialEq, Eq)]\n54\tpub struct HpkeCipherSuiteId {\n55\t    pub kdf: u16,\n56\t    pub aead: u16,\n57\t}\n58\t\n59\t/// The three cipher suites we advertise as supported, mirroring the\n60\t/// `picoquic_hpke_cipher_suites[]` array that the C picotls backend\n61\t/// populates at startup.\n62\tconst SUPPORTED_CIPHER_SUITES: &[HpkeCipherSuiteId] = &[\n63\t    HpkeCipherSuiteId {\n64\t        kdf: kdf_id::HKDF_SHA256,\n65\t        aead: aead_id::AES_128_GCM,\n66\t    },\n67\t    HpkeCipherSuiteId {\n68\t        kdf: kdf_id::HKDF_SHA256,\n69\t        aead: aead_id::CHACHA20_POLY1305,\n70\t    },\n71\t    HpkeCipherSuiteId {\n72\t        kdf: kdf_id::HKDF_SHA384,\n73\t        aead: aead_id::AES_256_GCM,\n74\t    },\n75\t];\n76\t\n77\t// ---------------------------------------------------------------------------\n78\t// Base64 encoding.\n79\t\n80\tconst BASE64_ALPHABET: &[u8; 64] =\n81\t    b\"ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789+/\";\n82\t\n83\t/// Return the number of base64 characters needed to encode `input_len` bytes,\n84\t/// not counting a NUL terminator.  Mirrors `ptls_base64_howlong`.\n85\t#[inline]\n86\tpub fn base64_encoded_len(input_len: usize) -> usize {\n87\t    input_len.div_ceil(3) * 4\n88\t}\n89\t\n90\t/// Encode `input` as standard RFC 4648 base64 into `out`.\n91\t///\n92\t/// `out` must be at least `base64_encoded_len(input.len()) + 1` bytes long\n93\t/// (the extra byte is for the NUL terminator written to match picotls\n94\t/// convention).  Returns the number of base64 characters written (excluding\n95\t/// the NUL).  Returns `Err(Error::Generic)` when `out` is too small.\n96\t///\n97\t/// C: `picoquic_base64_encode`\n98\tpub fn base64_encode(input: &[u8], out: &mut [u8]) -> Result<usize, Error> {\n99\t    let len = base64_encoded_len(input.len());\n100\t    if len + 1 > out.len() {\n101\t        return Err(Error::Generic);\n102\t    }\n103\t    let mut pos = 0usize;\n104\t    let mut chunks = input.chunks_exact(3);\n105\t    for chunk in &mut chunks {\n106\t        let b = ((chunk[0] as u32) << 16) | ((chunk[1] as u32) << 8) | (chunk[2] as u32);\n107\t        out[pos] = BASE64_ALPHABET[((b >> 18) & 0x3f) as usize];\n108\t        out[pos + 1] = BASE64_ALPHABET[((b >> 12) & 0x3f) as usize];\n109\t        out[pos + 2] = BASE64_ALPHABET[((b >> 6) & 0x3f) as usize];\n110\t        out[pos + 3] = BASE64_ALPHABET[(b & 0x3f) as usize];\n111\t        pos += 4;\n112\t    }\n113\t    match chunks.remainder() {\n114\t        [a] => {\n115\t            let b = (*a as u32) << 16;\n116\t            out[pos] = BASE64_ALPHABET[((b >> 18) & 0x3f) as usize];\n117\t            out[pos + 1] = BASE64_ALPHABET[((b >> 12) & 0x3f) as usize];\n118\t            out[pos + 2] = b'=';\n119\t            out[pos + 3] = b'=';\n120\t            pos += 4;\n121\t        }\n122\t        [a, b] => {\n123\t            let v = ((*a as u32) << 16) | ((*b as u32) << 8);\n124\t            out[pos] = BASE64_ALPHABET[((v >> 18) & 0x3f) as usize];\n125\t            out[pos + 1] = BASE64_ALPHABET[((v >> 12) & 0x3f) as usize];\n126\t            out[pos + 2] = BASE64_ALPHABET[((v >> 6) & 0x3f) as usize];\n127\t            out[pos + 3] = b'=';\n128\t            pos += 4;\n129\t        }\n130\t        _ => {}\n131\t    }\n132\t    out[pos] = 0; // NUL terminator (mirrors ptls_base64_encode convention)\n133\t    Ok(len)\n134\t}\n135\t\n136\t// ---------------------------------------------------------------------------\n137\t// Cipher-suite selector.\n138\t\n139\t/// Fill `out` with HPKE cipher suites appropriate for `kem_id`, returning\n140\t/// the number of entries written.\n141\t///\n142\t/// The first entry is the preferred suite for the given KEM; when there is\n143\t/// also a suitable default suite (AES-128-GCM + HKDF-SHA256) that differs\n144\t/// from the preferred one and `out.len() > 2`, it is appended as the second\n145\t/// entry.\n146\t///\n147\t/// Returns `Err(Error::Generic)` if `out.len() < 2` (mirrors the C guard\n148\t/// `cipher_vec_nb_max < 2`) or if no suite can be found.\n149\t///\n150\t/// C: `picoquic_ech_get_ciphers_from_kem`\n151\tpub fn ech_get_ciphers_from_kem(\n152\t    kem_id: u16,\n153\t    out: &mut [HpkeCipherSuiteId],\n154\t) -> Result<usize, Error> {\n155\t    if out.len() < 2 {\n156\t        return Err(Error::Generic);\n157\t    }\n158\t\n159\t    let (target_kdf, target_aead) = match kem_id {\n160\t        kem_id::P256_SHA256 => (kdf_id::HKDF_SHA256, aead_id::AES_128_GCM),\n161\t        kem_id::P384_SHA384 => (kdf_id::HKDF_SHA384, aead_id::AES_256_GCM),\n162\t        kem_id::X25519_SHA256 => (kdf_id::HKDF_SHA256, aead_id::CHACHA20_POLY1305),\n163\t        _ => (kdf_id::HKDF_SHA256, aead_id::AES_128_GCM),\n164\t    };\n165\t    let target = HpkeCipherSuiteId {\n166\t        kdf: target_kdf,\n167\t        aead: target_aead,\n168\t    };\n169\t    let default_suite = HpkeCipherSuiteId {\n170\t        kdf: kdf_id::HKDF_SHA256,\n171\t        aead: aead_id::AES_128_GCM,\n172\t    };\n173\t\n174\t    let mut target_cipher: Option<HpkeCipherSuiteId> = None;\n175\t    let mut default_cipher: Option<HpkeCipherSuiteId> = None;\n176\t\n177\t    for &suite in SUPPORTED_CIPHER_SUITES {\n178\t        if target_cipher.is_none() && suite == target {\n179\t            target_cipher = Some(suite);\n180\t        }\n181\t        if default_cipher.is_none() && suite == default_suite {\n182\t            default_cipher = Some(suite);\n183\t        }\n184\t    }\n185\t\n186\t    // Mirrors the C branching: target first; fall back to default; error if neither.\n187\t    // C: `cipher_vec_nb_max > 2` guards adding the default as a second entry.\n188\t    let nb_ciphers = match (target_cipher, default_cipher) {\n189\t        (Some(t), def) => {\n190\t            out[0] = t;\n191\t            if let Some(d) = def {\n192\t                if d != t && out.len() > 2 {\n193\t                    out[1] = d;\n194\t                    2\n195\t                } else {\n196\t                    1\n197\t                }\n198\t            } else {\n199\t                1\n200\t            }\n201\t        }\n202\t        (None, Some(d)) => {\n203\t            out[0] = d;\n204\t            1\n205\t        }\n206\t        (None, None) => return Err(Error::Generic),\n207\t    };\n208\t    Ok(nb_ciphers)\n209\t}\n210\t\n211\t// ---------------------------------------------------------------------------\n212\t// Config-ID derivation (private helper).\n213\t\n214\t/// Compute the one-byte ECH config-ID from the public key material, KEM id,\n215\t/// cipher suites, and the server public name.\n216\t///\n217\t/// The algorithm accumulates all bytes into a `u64` then XOR-folds the\n218\t/// result down to a single byte.\n219\t///\n220\t/// C: `ech_config_id_from_config` (file-static)\n221\tfn ech_config_id_from_config(\n222\t    public_key_bits: &[u8],\n223\t    kem_id: u16,\n224\t    cipher_suites: &[HpkeCipherSuiteId],\n225\t    public_name: &str,\n226\t) -> u8 {\n227\t    let mut config_sum: u64 = 0;\n228\t    for &b in public_key_bits {\n229\t        config_sum = config_sum.wrapping_add(b as u64);\n230\t    }\n231\t    config_sum = config_sum.wrapping_add(kem_id as u64);\n232\t    for cs in cipher_suites {\n233\t        config_sum = config_sum.wrapping_add(cs.aead as u64);\n234\t        config_sum = config_sum.wrapping_add(cs.kdf as u64);\n235\t    }\n236\t    for b in public_name.bytes() {\n237\t        config_sum = config_sum.wrapping_add(b as u64);\n238\t    }\n239\t    let mut config_id: u8 = 0;\n240\t    while config_sum > 0 {\n241\t        config_id ^= (config_sum & 0xff) as u8;\n242\t        config_sum >>= 8;\n243\t    }\n244\t    config_id\n245\t}\n246\t\n247\t// ---------------------------------------------------------------------------\n248\t// Server-side ECH opener state.\n249\t\n250\t/// Result returned by a successful [`EchOpenerState::open`] call.\n251\t///\n252\t/// `key_material` holds the HPKE-derived key material exported from the\n253\t/// receiver context; callers build the concrete AEAD context from it\n254\t/// together with `cipher`.\n255\tpub struct EchOpenResult {\n256\t    /// The negotiated cipher suite.\n257\t    pub cipher: HpkeCipherSuiteId,\n258\t    /// HPKE-exported key material (32 bytes) derived via RFC 9180\n259\t    /// `Context.Export`.  Callers use this to construct the AEAD context for\n260\t    /// decrypting the ECH inner ClientHello.\n261\t    pub key_material: Vec<u8>,\n262\t}\n263\t\n264\t/// Server-side ECH opener callback state.\n265\t///\n266\t/// Holds the KEM id, the private key bytes used for HPKE decapsulation,\n267\t/// and the serialised ECH config bytes (used to reconstruct the HPKE `info`\n268\t/// string during opening).\n269\t///\n270\t/// C: `ech_opener_callback_t`\n271\tpub struct EchOpenerState {\n272\t    /// HPKE KEM identifier, e.g. `kem_id::X25519_SHA256`.\n273\t    /// C: `kem` (`ptls_hpke_kem_t*`; we store only the numeric id).\n274\t    pub kem_id: u16,\n275\t    /// Raw private key bytes for HPKE decapsulation.\n276\t    /// C: `keyex` (`ptls_key_exchange_context_t*` loaded from a PEM file).\n277\t    pub private_key: Vec<u8>,\n278\t    /// Serialised ECH config bytes including the two-byte outer length prefix.\n279\t    /// C: `config` (`ptls_buffer_t`).\n280\t    pub config: Vec<u8>,\n281\t}\n282\t\n283\timpl EchOpenerState {\n284\t    /// Attempt to open (decapsulate) an incoming ECH extension.\n285\t    ///\n286\t    /// Finds the cipher suite matching `cipher_id` in the supported list,\n287\t    /// builds the HPKE `info` string as `info_prefix || config[2..]`, then\n288\t    /// performs HPKE base-mode receiver setup (RFC 9180 §5.1.1) to derive\n289\t    /// the AEAD key material.\n290\t    ///\n291\t    /// Returns `Some(EchOpenResult)` on success, `None` when `cipher_id` is\n292\t    /// not in the supported list or the key bytes cannot be deserialized.\n293\t    ///\n294\t    /// C: `ech_opener_callback`\n295\t    pub fn open(\n296\t        &self,\n297\t        cipher_id: HpkeCipherSuiteId,\n298\t        enc: &[u8],\n299\t        info_prefix: &[u8],\n300\t    ) -> Option<EchOpenResult> {\n301\t        // Find the matching cipher suite in the supported list.\n302\t        let cipher = SUPPORTED_CIPHER_SUITES\n303\t            .iter()\n304\t            .copied()\n305\t            .find(|c| c.kdf == cipher_id.kdf && c.aead == cipher_id.aead)?;\n306\t\n307\t        // Build info = info_prefix || config[2..]\n308\t        // (config[0..2] is the two-byte ECHConfigList outer length prefix,\n309\t        // skipped to match the `ptls_buffer_pushv(&infobuf, config.base+2, …)`\n310\t        // call in the C implementation.)\n311\t        let config_payload = self.config.get(2..).unwrap_or(&[]);\n312\t        let mut info = Vec::with_capacity(info_prefix.len() + config_payload.len());\n313\t        info.extend_from_slice(info_prefix);\n314\t        info.extend_from_slice(config_payload);\n315\t\n316\t        // HPKE base-mode receiver setup (equivalent to ptls_hpke_setup_base_r).\n317\t        let key_material = hpke_setup_receiver(self.kem_id, cipher, &self.private_key, enc, &info)?;\n318\t        Some(EchOpenResult {\n319\t            cipher,\n320\t            key_material,\n321\t        })\n322\t    }\n323\t}\n324\t\n325\t// ---------------------------------------------------------------------------\n326\t// HPKE receiver setup dispatcher.\n327\t\n328\t/// Perform HPKE base-mode receiver setup (RFC 9180 §5.1.1) for the given\n329\t/// `(kem, cipher)` combination and return 32 bytes of exported key material\n330\t/// via `Context.Export`.  Returns `None` on key-format mismatch or an\n331\t/// unknown algorithm combination.\n332\t///\n333\t/// Dispatches over the three KEM/KDF/AEAD triples that picoquic supports.\n334\t/// The C equivalent is the `ptls_hpke_setup_base_r` call inside\n335\t/// `ech_opener_callback`.\n336\tfn hpke_setup_receiver(\n337\t    kem: u16,\n338\t    cipher: HpkeCipherSuiteId,\n339\t    private_key: &[u8],\n340\t    enc: &[u8],\n341\t    info: &[u8],\n342\t) -> Option<Vec<u8>> {\n343\t    use hpke::{Deserializable, Kem as HpkeKem, OpModeR};\n344\t\n345\t    macro_rules! run_hpke {\n346\t        ($KemType:ty, $KdfType:ty, $AeadType:ty) => {{\n347\t            let sk =\n348\t                <$KemType as HpkeKem>::PrivateKey::from_bytes(private_key).ok()?;\n349\t            let ek =\n350\t                <$KemType as HpkeKem>::EncappedKey::from_bytes(enc).ok()?;\n351\t            let ctx = hpke::setup_receiver::<$AeadType, $KdfType, $KemType>(\n352\t                &OpModeR::Base,\n353\t                &sk,\n354\t                &ek,\n355\t                info,\n356\t            )\n357\t            .ok()?;\n358\t            let mut out = alloc::vec![0u8; 32];\n359\t            ctx.export(b\"picoquic ech key material\", &mut out).ok()?;\n360\t            Some(out)\n361\t        }};\n362\t    }\n363\t\n364\t    match (kem, cipher.kdf, cipher.aead) {\n365\t        (kem_id::X25519_SHA256, kdf_id::HKDF_SHA256, aead_id::AES_128_GCM) => {\n366\t            run_hpke!(\n367\t                hpke::kem::X25519HkdfSha256,\n368\t                hpke::kdf::HkdfSha256,\n369\t                hpke::aead::AesGcm128\n370\t            )\n371\t        }\n372\t        (kem_id::X25519_SHA256, kdf_id::HKDF_SHA256, aead_id::CHACHA20_POLY1305) => {\n373\t            run_hpke!(\n374\t                hpke::kem::X25519HkdfSha256,\n375\t                hpke::kdf::HkdfSha256,\n376\t                hpke::aead::ChaCha20Poly1305\n377\t            )\n378\t        }\n379\t        (kem_id::P256_SHA256, kdf_id::HKDF_SHA256, aead_id::AES_128_GCM) => {\n380\t            run_hpke!(\n381\t                hpke::kem::DhP256HkdfSha256,\n382\t                hpke::kdf::HkdfSha256,\n383\t                hpke::aead::AesGcm128\n384\t            )\n385\t        }\n386\t        (kem_id::P384_SHA384, kdf_id::HKDF_SHA384, aead_id::AES_256_GCM) => {\n387\t            run_hpke!(\n388\t                hpke::kem::DhP384HkdfSha384,\n389\t                hpke::kdf::HkdfSha384,\n390\t                hpke::aead::AesGcm256\n391\t            )\n392\t        }\n393\t        _ => None,\n394\t    }\n395\t}\n396\t\n397\t// ---------------------------------------------------------------------------\n398\t// TLS group-id → HPKE KEM-id mapping.\n399\t\n400\t/// TLS named-group identifiers (RFC 8446 §4.2.7, as used by picotls).\n401\tpub mod group_id {\n402\t    /// secp256r1 / P-256  (`PTLS_GROUP_SECP256R1`)\n403\t    pub const SECP256R1: u16 = 23;\n404\t    /// secp384r1 / P-384  (`PTLS_GROUP_SECP384R1`)\n405\t    pub const SECP384R1: u16 = 24;\n406\t    /// X25519             (`PTLS_GROUP_X25519`)\n407\t    pub const X25519: u16 = 29;\n408\t}\n409\t\n410\t/// Find the HPKE KEM identifier for the given TLS named-group id.\n411\t///\n412\t/// Mirrors the C loop over `picoquic_hpke_kems[]` that matches on\n413\t/// `picoquic_hpke_kems[i]->keyex->id == group_id`.\n414\t///\n415\t/// Returns `Some(kem_id)` on success, `None` when the group is not\n416\t/// one of the three supported curves.\n417\t///\n418\t/// C: `picoquic_ech_get_kem_from_curve`\n419\tpub fn ech_get_kem_from_curve(group_id: u16) -> Option<u16> {\n420\t    match group_id {\n421\t        group_id::SECP256R1 => Some(kem_id::P256_SHA256),\n422\t        group_id::SECP384R1 => Some(kem_id::P384_SHA384),\n423\t        group_id::X25519 => Some(kem_id::X25519_SHA256),\n424\t        _ => None,\n425\t    }\n426\t}\n427\t\n428\t// ---------------------------------------------------------------------------\n429\t// ASN.1 DER SubjectPublicKeyInfo parser.\n430\t\n431\t/// Parsed fields extracted from a DER-encoded SubjectPublicKeyInfo blob.\n432\t///\n433\t/// All slices borrow from the original input passed to\n434\t/// [`parse_public_key_asn1`], so their lifetime is tied to that input.\n435\t///\n436\t/// C: the four output parameters of `picoquic_parse_public_key_asn1`.\n437\tpub struct PublicKeyAsn1<'a> {\n438\t    /// Algorithm OID value bytes (tag + length stripped).\n439\t    ///\n440\t    /// C: `public_key_algo.{base,len}`\n441\t    pub algo: &'a [u8],\n442\t    /// Parameters field: raw bytes from after the algorithm OID to the\n443\t    /// end of the inner AlgorithmIdentifier SEQUENCE.  Includes the\n444\t    /// tag + length of any nested TLV; empty when there are no parameters\n445\t    /// (e.g. X25519 keys).\n446\t    ///\n447\t    /// C: `public_key_param.{base,len}`\n448\t    pub param: &'a [u8],\n449\t    /// BIT STRING value bytes.  The first byte is the padding-count\n450\t    /// (always `0x00` for the curves picoquic supports); the key bytes\n451\t    /// follow immediately.\n452\t    ///\n453\t    /// C: `public_key_bit_string.{base,len}`\n454\t    pub bit_string: &'a [u8],\n455\t    /// Total number of bytes consumed from the input.\n456\t    pub consumed: usize,\n457\t}\n458\t\n459\t/// Parse a DER TLV header at `pos` within `bytes[..bytes_max]`.\n460\t///\n461\t/// `expected_type` must match the tag byte.  Returns `(value_start, value_end)`\n462\t/// on success, `Err` on type mismatch, truncation, or overflow.\n463\tfn asn1_tlv(\n464\t    bytes: &[u8],\n465\t    bytes_max: usize,\n466\t    pos: usize,\n467\t    expected_type: u8,\n468\t) -> Result<(usize, usize), Error> {\n469\t    if pos >= bytes_max || bytes[pos] != expected_type {\n470\t        return Err(Error::Generic);\n471\t    }\n472\t    let pos = pos + 1;\n473\t    if pos >= bytes_max {\n474\t        return Err(Error::Generic);\n475\t    }\n476\t    let first = bytes[pos];\n477\t    let (length, val_start) = if first < 0x80 {\n478\t        (first as usize, pos + 1)\n479\t    } else {\n480\t        let n = (first & 0x7F) as usize;\n481\t        if n == 0 || pos + 1 + n > bytes_max {\n482\t            return Err(Error::Generic);\n483\t        }\n484\t        let mut len = 0usize;\n485\t        for i in 0..n {\n486\t            len = (len << 8) | (bytes[pos + 1 + i] as usize);\n487\t        }\n488\t        (len, pos + 1 + n)\n489\t    };\n490\t    let val_end = val_start + length;\n491\t    if val_end > bytes_max {\n492\t        return Err(Error::Generic);\n493\t    }\n494\t    Ok((val_start, val_end))\n495\t}\n496\t\n497\t/// Parse a DER-encoded SubjectPublicKeyInfo structure.\n498\t///\n499\t/// Walks the outer SEQUENCE → AlgorithmIdentifier SEQUENCE → OID +\n500\t/// optional parameters → BIT STRING layout described in RFC 5480 and\n501\t/// RFC 8410, returning zero-copy sub-slices into `input`.\n502\t///\n503\t/// Returns `Err(Error::Generic)` for any structural violation (wrong tag,\n504\t/// truncated length field, outer-sequence length mismatch, or trailing\n505\t/// bytes after the BIT STRING).\n506\t///\n507\t/// C: `picoquic_parse_public_key_asn1`\n508\tpub fn parse_public_key_asn1(input: &[u8]) -> Result<PublicKeyAsn1<'_>, Error> {\n509\t    let bytes_max = input.len();\n510\t\n511\t    // Outer SEQUENCE must span the entire buffer.\n512\t    let (outer_val, outer_end) = asn1_tlv(input, bytes_max, 0, 0x30)?;\n513\t    if outer_end != bytes_max {\n514\t        return Err(Error::Generic); // PTLS_ERROR_BER_EXCESSIVE_LENGTH\n515\t    }\n516\t\n517\t    // AlgorithmIdentifier SEQUENCE.\n518\t    let (inner_val, inner_end) = asn1_tlv(input, outer_end, outer_val, 0x30)?;\n519\t\n520\t    // Algorithm OID — value bytes only (tag + length consumed by asn1_tlv).\n521\t    let (oid_val, oid_end) = asn1_tlv(input, inner_end, inner_val, 0x06)?;\n522\t    let algo = &input[oid_val..oid_end];\n523\t\n524\t    // Parameters: everything remaining in the inner SEQUENCE after the OID.\n525\t    let param = if inner_end <= oid_end {\n526\t        &input[0..0]\n527\t    } else {\n528\t        &input[oid_end..inner_end]\n529\t    };\n530\t\n531\t    // BIT STRING (public key), must consume the rest of the outer SEQUENCE.\n532\t    let (bs_val, bs_end) = asn1_tlv(input, outer_end, inner_end, 0x03)?;\n533\t    if bs_end != outer_end {\n534\t        return Err(Error::Generic); // PTLS_ERROR_BER_ELEMENT_TOO_SHORT\n535\t    }\n536\t    let bit_string = &input[bs_val..bs_end];\n537\t\n538\t    Ok(PublicKeyAsn1 {\n539\t        algo,\n540\t        param,\n541\t        bit_string,\n542\t        consumed: bs_end,\n543\t    })\n544\t}\n545\t\n546\t// ---------------------------------------------------------------------------\n547\t// Tests.\n548\t\n549\t#[cfg(test)]\n550\tmod tests {\n551\t    use super::*;\n552\t\n553\t    #[test]\n554\t    fn base64_encode_empty() {\n555\t        let mut buf = [0u8; 1];\n556\t        let n = base64_encode(&[], &mut buf).unwrap();\n557\t        assert_eq!(n, 0);\n558\t        assert_eq!(buf[0], 0);\n559\t    }\n560\t\n561\t    #[test]\n562\t    fn base64_encode_three_bytes() {\n563\t        // \"Man\" → \"TWFu\"\n564\t        let mut buf = [0u8; 5];\n565\t        let n = base64_encode(b\"Man\", &mut buf).unwrap();\n566\t        assert_eq!(n, 4);\n567\t        assert_eq!(&buf[..4], b\"TWFu\");\n568\t        assert_eq!(buf[4], 0);\n569\t    }\n570\t\n571\t    #[test]\n572\t    fn base64_encode_padding_one() {\n573\t        // \"M\" → \"TQ==\"\n574\t        let mut buf = [0u8; 5];\n575\t        let n = base64_encode(b\"M\", &mut buf).unwrap();\n576\t        assert_eq!(n, 4);\n577\t        assert_eq!(&buf[..4], b\"TQ==\");\n578\t    }\n579\t\n580\t    #[test]\n581\t    fn base64_encode_padding_two() {\n582\t        // \"Ma\" → \"TWE=\"\n583\t        let mut buf = [0u8; 5];\n584\t        let n = base64_encode(b\"Ma\", &mut buf).unwrap();\n585\t        assert_eq!(n, 4);\n586\t        assert_eq!(&buf[..4], b\"TWE=\");\n587\t    }\n588\t\n589\t    #[test]\n590\t    fn base64_encode_buffer_too_small() {\n591\t        let mut buf = [0u8; 4]; // needs 5 (4 chars + NUL)\n592\t        assert!(base64_encode(b\"Man\", &mut buf).is_err());\n593\t    }\n594\t\n595\t    #[test]\n596\t    fn base64_encoded_len_values() {\n597\t        assert_eq!(base64_encoded_len(0), 0);\n598\t        assert_eq!(base64_encoded_len(1), 4);\n599\t        assert_eq!(base64_encoded_len(2), 4);\n600\t        assert_eq!(base64_encoded_len(3), 4);\n601\t        assert_eq!(base64_encoded_len(4), 8);\n602\t        assert_eq!(base64_encoded_len(6), 8);\n603\t    }\n604\t\n605\t    #[test]\n606\t    fn ech_get_ciphers_p256() {\n607\t        let mut out = [HpkeCipherSuiteId { kdf: 0, aead: 0 }; 4];\n608\t        let n = ech_get_ciphers_from_kem(kem_id::P256_SHA256, &mut out).unwrap();\n609\t        assert!(n >= 1);\n610\t        assert_eq!(out[0].kdf, kdf_id::HKDF_SHA256);\n611\t        assert_eq!(out[0].aead, aead_id::AES_128_GCM);\n612\t    }\n613\t\n614\t    #[test]\n615\t    fn ech_get_ciphers_p384() {\n616\t        let mut out = [HpkeCipherSuiteId { kdf: 0, aead: 0 }; 4];\n617\t        let n = ech_get_ciphers_from_kem(kem_id::P384_SHA384, &mut out).unwrap();\n618\t        assert!(n >= 1);\n619\t        assert_eq!(out[0].kdf, kdf_id::HKDF_SHA384);\n620\t        assert_eq!(out[0].aead, aead_id::AES_256_GCM);\n621\t    }\n622\t\n623\t    #[test]\n624\t    fn ech_get_ciphers_x25519() {\n625\t        let mut out = [HpkeCipherSuiteId { kdf: 0, aead: 0 }; 4];\n626\t        let n = ech_get_ciphers_from_kem(kem_id::X25519_SHA256, &mut out).unwrap();\n627\t        assert!(n >= 1);\n628\t        assert_eq!(out[0].kdf, kdf_id::HKDF_SHA256);\n629\t        assert_eq!(out[0].aead, aead_id::CHACHA20_POLY1305);\n630\t    }\n631\t\n632\t    #[test]\n633\t    fn ech_get_ciphers_out_too_small() {\n634\t        let mut out = [HpkeCipherSuiteId { kdf: 0, aead: 0 }; 1];\n635\t        assert!(ech_get_ciphers_from_kem(kem_id::P256_SHA256, &mut out).is_err());\n636\t    }\n637\t\n638\t    #[test]\n639\t    fn config_id_is_deterministic() {\n640\t        let key = [1u8, 2, 3, 4];\n641\t        let suites = [HpkeCipherSuiteId {\n642\t            kdf: kdf_id::HKDF_SHA256,\n643\t            aead: aead_id::AES_128_GCM,\n644\t        }];\n645\t        let id1 = ech_config_id_from_config(&key, kem_id::X25519_SHA256, &suites, \"example.com\");\n646\t        let id2 = ech_config_id_from_config(&key, kem_id::X25519_SHA256, &suites, \"example.com\");\n647\t        assert_eq!(id1, id2);\n648\t    }\n649\t\n650\t    #[test]\n651\t    fn config_id_changes_with_key() {\n652\t        let suites = [HpkeCipherSuiteId {\n653\t            kdf: kdf_id::HKDF_SHA256,\n654\t            aead: aead_id::AES_128_GCM,\n655\t        }];\n656\t        let id1 =\n657\t            ech_config_id_from_config(&[1, 2, 3], kem_id::X25519_SHA256, &suites, \"example.com\");\n658\t        let id2 =\n659\t            ech_config_id_from_config(&[4, 5, 6], kem_id::X25519_SHA256, &suites, \"example.com\");\n660\t        assert_ne!(id1, id2);\n661\t    }\n662\t\n663\t    #[test]\n664\t    fn kem_from_curve_known_groups() {\n665\t        assert_eq!(\n666\t            ech_get_kem_from_curve(group_id::SECP256R1),\n667\t            Some(kem_id::P256_SHA256)\n668\t        );\n669\t        assert_eq!(\n670\t            ech_get_kem_from_curve(group_id::SECP384R1),\n671\t            Some(kem_id::P384_SHA384)\n672\t        );\n673\t        assert_eq!(\n674\t            ech_get_kem_from_curve(group_id::X25519),\n675\t            Some(kem_id::X25519_SHA256)\n676\t        );\n677\t    }\n678\t\n679\t    #[test]\n680\t    fn kem_from_curve_unknown() {\n681\t        assert_eq!(ech_get_kem_from_curve(0xFFFF), None);\n682\t    }\n683\t\n684\t    // Minimal DER-encoded SubjectPublicKeyInfo for X25519 (RFC 8410):\n685\t    // SEQUENCE {\n686\t    //   SEQUENCE { OID 1.3.101.110 }        -- id-X25519\n687\t    //   BIT STRING { 0x00 <32 zero bytes> }  -- fake key, padding=0\n688\t    // }\n689\t    fn x25519_spki() -> Vec<u8> {\n690\t        let oid: &[u8] = &[0x2b, 0x65, 0x6e]; // 1.3.101.110\n691\t        // inner SEQUENCE: OID TLV\n692\t        let mut inner = Vec::new();\n693\t        inner.push(0x06);\n694\t        inner.push(oid.len() as u8);\n695\t        inner.extend_from_slice(oid);\n696\t        // BIT STRING: padding byte + 32-byte key\n697\t        let mut bs_val = vec![0x00u8]; // padding count\n698\t        bs_val.extend_from_slice(&[0xABu8; 32]);\n699\t        let mut outer = Vec::new();\n700\t        // inner SEQUENCE TLV\n701\t        outer.push(0x30);\n702\t        outer.push(inner.len() as u8);\n703\t        outer.extend_from_slice(&inner);\n704\t        // BIT STRING TLV\n705\t        outer.push(0x03);\n706\t        outer.push(bs_val.len() as u8);\n707\t        outer.extend_from_slice(&bs_val);\n708\t        // wrap in outer SEQUENCE\n709\t        let mut spki = Vec::new();\n710\t        spki.push(0x30);\n711\t        spki.push(outer.len() as u8);\n712\t        spki.extend_from_slice(&outer);\n713\t        spki\n714\t    }\n715\t\n716\t    #[test]\n717\t    fn parse_public_key_asn1_x25519() {\n718\t        let spki = x25519_spki();\n719\t        let r = parse_public_key_asn1(&spki).unwrap();\n720\t        assert_eq!(r.algo, &[0x2b, 0x65, 0x6e]);\n721\t        assert_eq!(r.param, &[] as &[u8]); // X25519 has no parameters\n722\t        assert_eq!(r.bit_string[0], 0x00); // padding byte\n723\t        assert_eq!(r.bit_string.len(), 33); // 1 + 32 key bytes\n724\t        assert_eq!(r.consumed, spki.len());\n725\t    }\n726\t\n727\t    #[test]\n728\t    fn parse_public_key_asn1_truncated() {\n729\t        let spki = x25519_spki();\n730\t        assert!(parse_public_key_asn1(&spki[..4]).is_err());\n731\t    }\n732\t\n733\t    #[test]\n734\t    fn parse_public_key_asn1_wrong_outer_tag() {\n735\t        let mut spki = x25519_spki();\n736\t        spki[0] = 0x31; // SET instead of SEQUENCE\n737\t        assert!(parse_public_key_asn1(&spki).is_err());\n738\t    }\n739\t}\n740\t"}]},"parent_tool_use_id":null,"session_id":"0935a79a-3385-490e-8044-a2b7bb8dca0a","uuid":"d3413ae4-196d-40bb-be7f-34a72a61381a","timestamp":"2026-05-07T14:16:53.807Z","tool_use_result":{"type":"text","file":{"filePath":"/Users/richbarn/Projects/picoquic/rs/fq/src/ech.rs","content":"//! Encrypted ClientHello (ECH) helpers.\n//!\n//! Pure-Rust portion of the ECH support layer, fully translated from\n//! `picoquic/ech.c`.  HPKE key-exchange (DHKEM-X25519, DHKEM-P256,\n//! DHKEM-P384) is implemented via the `hpke` crate; the remaining logic\n//! — cipher-suite selection, config-ID derivation, base64 encoding, and\n//! opener-state plumbing — is translated directly.\n\nextern crate alloc;\nuse alloc::vec::Vec;\n\nuse crate::Error;\n\n// ---------------------------------------------------------------------------\n// HPKE constants (IANA registries, RFC 9180).\n\n/// HPKE KEM algorithm identifiers (RFC 9180 §7.1).\npub mod kem_id {\n    /// DHKEM(P-256, HKDF-SHA256)\n    pub const P256_SHA256: u16 = 0x0010;\n    /// DHKEM(P-384, HKDF-SHA384)\n    pub const P384_SHA384: u16 = 0x0011;\n    /// DHKEM(X25519, HKDF-SHA256)\n    pub const X25519_SHA256: u16 = 0x0020;\n}\n\n/// HPKE KDF algorithm identifiers (RFC 9180 §7.2).\npub mod kdf_id {\n    /// HKDF-SHA256\n    pub const HKDF_SHA256: u16 = 0x0001;\n    /// HKDF-SHA384\n    pub const HKDF_SHA384: u16 = 0x0002;\n    /// HKDF-SHA512\n    pub const HKDF_SHA512: u16 = 0x0003;\n}\n\n/// HPKE AEAD algorithm identifiers (RFC 9180 §7.3).\npub mod aead_id {\n    /// AES-128-GCM\n    pub const AES_128_GCM: u16 = 0x0001;\n    /// AES-256-GCM\n    pub const AES_256_GCM: u16 = 0x0002;\n    /// ChaCha20-Poly1305\n    pub const CHACHA20_POLY1305: u16 = 0x0003;\n}\n\n// ---------------------------------------------------------------------------\n// Cipher-suite identifier.\n\n/// HPKE symmetric cipher-suite: (KDF id, AEAD id) pair.\n///\n/// C: `ptls_hpke_cipher_suite_id_t`\n#[derive(Debug, Clone, Copy, PartialEq, Eq)]\npub struct HpkeCipherSuiteId {\n    pub kdf: u16,\n    pub aead: u16,\n}\n\n/// The three cipher suites we advertise as supported, mirroring the\n/// `picoquic_hpke_cipher_suites[]` array that the C picotls backend\n/// populates at startup.\nconst SUPPORTED_CIPHER_SUITES: &[HpkeCipherSuiteId] = &[\n    HpkeCipherSuiteId {\n        kdf: kdf_id::HKDF_SHA256,\n        aead: aead_id::AES_128_GCM,\n    },\n    HpkeCipherSuiteId {\n        kdf: kdf_id::HKDF_SHA256,\n        aead: aead_id::CHACHA20_POLY1305,\n    },\n    HpkeCipherSuiteId {\n        kdf: kdf_id::HKDF_SHA384,\n        aead: aead_id::AES_256_GCM,\n    },\n];\n\n// ---------------------------------------------------------------------------\n// Base64 encoding.\n\nconst BASE64_ALPHABET: &[u8; 64] =\n    b\"ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789+/\";\n\n/// Return the number of base64 characters needed to encode `input_len` bytes,\n/// not counting a NUL terminator.  Mirrors `ptls_base64_howlong`.\n#[inline]\npub fn base64_encoded_len(input_len: usize) -> usize {\n    input_len.div_ceil(3) * 4\n}\n\n/// Encode `input` as standard RFC 4648 base64 into `out`.\n///\n/// `out` must be at least `base64_encoded_len(input.len()) + 1` bytes long\n/// (the extra byte is for the NUL terminator written to match picotls\n/// convention).  Returns the number of base64 characters written (excluding\n/// the NUL).  Returns `Err(Error::Generic)` when `out` is too small.\n///\n/// C: `picoquic_base64_encode`\npub fn base64_encode(input: &[u8], out: &mut [u8]) -> Result<usize, Error> {\n    let len = base64_encoded_len(input.len());\n    if len + 1 > out.len() {\n        return Err(Error::Generic);\n    }\n    let mut pos = 0usize;\n    let mut chunks = input.chunks_exact(3);\n    for chunk in &mut chunks {\n        let b = ((chunk[0] as u32) << 16) | ((chunk[1] as u32) << 8) | (chunk[2] as u32);\n        out[pos] = BASE64_ALPHABET[((b >> 18) & 0x3f) as usize];\n        out[pos + 1] = BASE64_ALPHABET[((b >> 12) & 0x3f) as usize];\n        out[pos + 2] = BASE64_ALPHABET[((b >> 6) & 0x3f) as usize];\n        out[pos + 3] = BASE64_ALPHABET[(b & 0x3f) as usize];\n        pos += 4;\n    }\n    match chunks.remainder() {\n        [a] => {\n            let b = (*a as u32) << 16;\n            out[pos] = BASE64_ALPHABET[((b >> 18) & 0x3f) as usize];\n            out[pos + 1] = BASE64_ALPHABET[((b >> 12) & 0x3f) as usize];\n            out[pos + 2] = b'=';\n            out[pos + 3] = b'=';\n            pos += 4;\n        }\n        [a, b] => {\n            let v = ((*a as u32) << 16) | ((*b as u32) << 8);\n            out[pos] = BASE64_ALPHABET[((v >> 18) & 0x3f) as usize];\n            out[pos + 1] = BASE64_ALPHABET[((v >> 12) & 0x3f) as usize];\n            out[pos + 2] = BASE64_ALPHABET[((v >> 6) & 0x3f) as usize];\n            out[pos + 3] = b'=';\n            pos += 4;\n        }\n        _ => {}\n    }\n    out[pos] = 0; // NUL terminator (mirrors ptls_base64_encode convention)\n    Ok(len)\n}\n\n// ---------------------------------------------------------------------------\n// Cipher-suite selector.\n\n/// Fill `out` with HPKE cipher suites appropriate for `kem_id`, returning\n/// the number of entries written.\n///\n/// The first entry is the preferred suite for the given KEM; when there is\n/// also a suitable default suite (AES-128-GCM + HKDF-SHA256) that differs\n/// from the preferred one and `out.len() > 2`, it is appended as the second\n/// entry.\n///\n/// Returns `Err(Error::Generic)` if `out.len() < 2` (mirrors the C guard\n/// `cipher_vec_nb_max < 2`) or if no suite can be found.\n///\n/// C: `picoquic_ech_get_ciphers_from_kem`\npub fn ech_get_ciphers_from_kem(\n    kem_id: u16,\n    out: &mut [HpkeCipherSuiteId],\n) -> Result<usize, Error> {\n    if out.len() < 2 {\n        return Err(Error::Generic);\n    }\n\n    let (target_kdf, target_aead) = match kem_id {\n        kem_id::P256_SHA256 => (kdf_id::HKDF_SHA256, aead_id::AES_128_GCM),\n        kem_id::P384_SHA384 => (kdf_id::HKDF_SHA384, aead_id::AES_256_GCM),\n        kem_id::X25519_SHA256 => (kdf_id::HKDF_SHA256, aead_id::CHACHA20_POLY1305),\n        _ => (kdf_id::HKDF_SHA256, aead_id::AES_128_GCM),\n    };\n    let target = HpkeCipherSuiteId {\n        kdf: target_kdf,\n        aead: target_aead,\n    };\n    let default_suite = HpkeCipherSuiteId {\n        kdf: kdf_id::HKDF_SHA256,\n        aead: aead_id::AES_128_GCM,\n    };\n\n    let mut target_cipher: Option<HpkeCipherSuiteId> = None;\n    let mut default_cipher: Option<HpkeCipherSuiteId> = None;\n\n    for &suite in SUPPORTED_CIPHER_SUITES {\n        if target_cipher.is_none() && suite == target {\n            target_cipher = Some(suite);\n        }\n        if default_cipher.is_none() && suite == default_suite {\n            default_cipher = Some(suite);\n        }\n    }\n\n    // Mirrors the C branching: target first; fall back to default; error if neither.\n    // C: `cipher_vec_nb_max > 2` guards adding the default as a second entry.\n    let nb_ciphers = match (target_cipher, default_cipher) {\n        (Some(t), def) => {\n            out[0] = t;\n            if let Some(d) = def {\n                if d != t && out.len() > 2 {\n                    out[1] = d;\n                    2\n                } else {\n                    1\n                }\n            } else {\n                1\n            }\n        }\n        (None, Some(d)) => {\n            out[0] = d;\n            1\n        }\n        (None, None) => return Err(Error::Generic),\n    };\n    Ok(nb_ciphers)\n}\n\n// ---------------------------------------------------------------------------\n// Config-ID derivation (private helper).\n\n/// Compute the one-byte ECH config-ID from the public key material, KEM id,\n/// cipher suites, and the server public name.\n///\n/// The algorithm accumulates all bytes into a `u64` then XOR-folds the\n/// result down to a single byte.\n///\n/// C: `ech_config_id_from_config` (file-static)\nfn ech_config_id_from_config(\n    public_key_bits: &[u8],\n    kem_id: u16,\n    cipher_suites: &[HpkeCipherSuiteId],\n    public_name: &str,\n) -> u8 {\n    let mut config_sum: u64 = 0;\n    for &b in public_key_bits {\n        config_sum = config_sum.wrapping_add(b as u64);\n    }\n    config_sum = config_sum.wrapping_add(kem_id as u64);\n    for cs in cipher_suites {\n        config_sum = config_sum.wrapping_add(cs.aead as u64);\n        config_sum = config_sum.wrapping_add(cs.kdf as u64);\n    }\n    for b in public_name.bytes() {\n        config_sum = config_sum.wrapping_add(b as u64);\n    }\n    let mut config_id: u8 = 0;\n    while config_sum > 0 {\n        config_id ^= (config_sum & 0xff) as u8;\n        config_sum >>= 8;\n    }\n    config_id\n}\n\n// ---------------------------------------------------------------------------\n// Server-side ECH opener state.\n\n/// Result returned by a successful [`EchOpenerState::open`] call.\n///\n/// `key_material` holds the HPKE-derived key material exported from the\n/// receiver context; callers build the concrete AEAD context from it\n/// together with `cipher`.\npub struct EchOpenResult {\n    /// The negotiated cipher suite.\n    pub cipher: HpkeCipherSuiteId,\n    /// HPKE-exported key material (32 bytes) derived via RFC 9180\n    /// `Context.Export`.  Callers use this to construct the AEAD context for\n    /// decrypting the ECH inner ClientHello.\n    pub key_material: Vec<u8>,\n}\n\n/// Server-side ECH opener callback state.\n///\n/// Holds the KEM id, the private key bytes used for HPKE decapsulation,\n/// and the serialised ECH config bytes (used to reconstruct the HPKE `info`\n/// string during opening).\n///\n/// C: `ech_opener_callback_t`\npub struct EchOpenerState {\n    /// HPKE KEM identifier, e.g. `kem_id::X25519_SHA256`.\n    /// C: `kem` (`ptls_hpke_kem_t*`; we store only the numeric id).\n    pub kem_id: u16,\n    /// Raw private key bytes for HPKE decapsulation.\n    /// C: `keyex` (`ptls_key_exchange_context_t*` loaded from a PEM file).\n    pub private_key: Vec<u8>,\n    /// Serialised ECH config bytes including the two-byte outer length prefix.\n    /// C: `config` (`ptls_buffer_t`).\n    pub config: Vec<u8>,\n}\n\nimpl EchOpenerState {\n    /// Attempt to open (decapsulate) an incoming ECH extension.\n    ///\n    /// Finds the cipher suite matching `cipher_id` in the supported list,\n    /// builds the HPKE `info` string as `info_prefix || config[2..]`, then\n    /// performs HPKE base-mode receiver setup (RFC 9180 §5.1.1) to derive\n    /// the AEAD key material.\n    ///\n    /// Returns `Some(EchOpenResult)` on success, `None` when `cipher_id` is\n    /// not in the supported list or the key bytes cannot be deserialized.\n    ///\n    /// C: `ech_opener_callback`\n    pub fn open(\n        &self,\n        cipher_id: HpkeCipherSuiteId,\n        enc: &[u8],\n        info_prefix: &[u8],\n    ) -> Option<EchOpenResult> {\n        // Find the matching cipher suite in the supported list.\n        let cipher = SUPPORTED_CIPHER_SUITES\n            .iter()\n            .copied()\n            .find(|c| c.kdf == cipher_id.kdf && c.aead == cipher_id.aead)?;\n\n        // Build info = info_prefix || config[2..]\n        // (config[0..2] is the two-byte ECHConfigList outer length prefix,\n        // skipped to match the `ptls_buffer_pushv(&infobuf, config.base+2, …)`\n        // call in the C implementation.)\n        let config_payload = self.config.get(2..).unwrap_or(&[]);\n        let mut info = Vec::with_capacity(info_prefix.len() + config_payload.len());\n        info.extend_from_slice(info_prefix);\n        info.extend_from_slice(config_payload);\n\n        // HPKE base-mode receiver setup (equivalent to ptls_hpke_setup_base_r).\n        let key_material = hpke_setup_receiver(self.kem_id, cipher, &self.private_key, enc, &info)?;\n        Some(EchOpenResult {\n            cipher,\n            key_material,\n        })\n    }\n}\n\n// ---------------------------------------------------------------------------\n// HPKE receiver setup dispatcher.\n\n/// Perform HPKE base-mode receiver setup (RFC 9180 §5.1.1) for the given\n/// `(kem, cipher)` combination and return 32 bytes of exported key material\n/// via `Context.Export`.  Returns `None` on key-format mismatch or an\n/// unknown algorithm combination.\n///\n/// Dispatches over the three KEM/KDF/AEAD triples that picoquic supports.\n/// The C equivalent is the `ptls_hpke_setup_base_r` call inside\n/// `ech_opener_callback`.\nfn hpke_setup_receiver(\n    kem: u16,\n    cipher: HpkeCipherSuiteId,\n    private_key: &[u8],\n    enc: &[u8],\n    info: &[u8],\n) -> Option<Vec<u8>> {\n    use hpke::{Deserializable, Kem as HpkeKem, OpModeR};\n\n    macro_rules! run_hpke {\n        ($KemType:ty, $KdfType:ty, $AeadType:ty) => {{\n            let sk =\n                <$KemType as HpkeKem>::PrivateKey::from_bytes(private_key).ok()?;\n            let ek =\n                <$KemType as HpkeKem>::EncappedKey::from_bytes(enc).ok()?;\n            let ctx = hpke::setup_receiver::<$AeadType, $KdfType, $KemType>(\n                &OpModeR::Base,\n                &sk,\n                &ek,\n                info,\n            )\n            .ok()?;\n            let mut out = alloc::vec![0u8; 32];\n            ctx.export(b\"picoquic ech key material\", &mut out).ok()?;\n            Some(out)\n        }};\n    }\n\n    match (kem, cipher.kdf, cipher.aead) {\n        (kem_id::X25519_SHA256, kdf_id::HKDF_SHA256, aead_id::AES_128_GCM) => {\n            run_hpke!(\n                hpke::kem::X25519HkdfSha256,\n                hpke::kdf::HkdfSha256,\n                hpke::aead::AesGcm128\n            )\n        }\n        (kem_id::X25519_SHA256, kdf_id::HKDF_SHA256, aead_id::CHACHA20_POLY1305) => {\n            run_hpke!(\n                hpke::kem::X25519HkdfSha256,\n                hpke::kdf::HkdfSha256,\n                hpke::aead::ChaCha20Poly1305\n            )\n        }\n        (kem_id::P256_SHA256, kdf_id::HKDF_SHA256, aead_id::AES_128_GCM) => {\n            run_hpke!(\n                hpke::kem::DhP256HkdfSha256,\n                hpke::kdf::HkdfSha256,\n                hpke::aead::AesGcm128\n            )\n        }\n        (kem_id::P384_SHA384, kdf_id::HKDF_SHA384, aead_id::AES_256_GCM) => {\n            run_hpke!(\n                hpke::kem::DhP384HkdfSha384,\n                hpke::kdf::HkdfSha384,\n                hpke::aead::AesGcm256\n            )\n        }\n        _ => None,\n    }\n}\n\n// ---------------------------------------------------------------------------\n// TLS group-id → HPKE KEM-id mapping.\n\n/// TLS named-group identifiers (RFC 8446 §4.2.7, as used by picotls).\npub mod group_id {\n    /// secp256r1 / P-256  (`PTLS_GROUP_SECP256R1`)\n    pub const SECP256R1: u16 = 23;\n    /// secp384r1 / P-384  (`PTLS_GROUP_SECP384R1`)\n    pub const SECP384R1: u16 = 24;\n    /// X25519             (`PTLS_GROUP_X25519`)\n    pub const X25519: u16 = 29;\n}\n\n/// Find the HPKE KEM identifier for the given TLS named-group id.\n///\n/// Mirrors the C loop over `picoquic_hpke_kems[]` that matches on\n/// `picoquic_hpke_kems[i]->keyex->id == group_id`.\n///\n/// Returns `Some(kem_id)` on success, `None` when the group is not\n/// one of the three supported curves.\n///\n/// C: `picoquic_ech_get_kem_from_curve`\npub fn ech_get_kem_from_curve(group_id: u16) -> Option<u16> {\n    match group_id {\n        group_id::SECP256R1 => Some(kem_id::P256_SHA256),\n        group_id::SECP384R1 => Some(kem_id::P384_SHA384),\n        group_id::X25519 => Some(kem_id::X25519_SHA256),\n        _ => None,\n    }\n}\n\n// ---------------------------------------------------------------------------\n// ASN.1 DER SubjectPublicKeyInfo parser.\n\n/// Parsed fields extracted from a DER-encoded SubjectPublicKeyInfo blob.\n///\n/// All slices borrow from the original input passed to\n/// [`parse_public_key_asn1`], so their lifetime is tied to that input.\n///\n/// C: the four output parameters of `picoquic_parse_public_key_asn1`.\npub struct PublicKeyAsn1<'a> {\n    /// Algorithm OID value bytes (tag + length stripped).\n    ///\n    /// C: `public_key_algo.{base,len}`\n    pub algo: &'a [u8],\n    /// Parameters field: raw bytes from after the algorithm OID to the\n    /// end of the inner AlgorithmIdentifier SEQUENCE.  Includes the\n    /// tag + length of any nested TLV; empty when there are no parameters\n    /// (e.g. X25519 keys).\n    ///\n    /// C: `public_key_param.{base,len}`\n    pub param: &'a [u8],\n    /// BIT STRING value bytes.  The first byte is the padding-count\n    /// (always `0x00` for the curves picoquic supports); the key bytes\n    /// follow immediately.\n    ///\n    /// C: `public_key_bit_string.{base,len}`\n    pub bit_string: &'a [u8],\n    /// Total number of bytes consumed from the input.\n    pub consumed: usize,\n}\n\n/// Parse a DER TLV header at `pos` within `bytes[..bytes_max]`.\n///\n/// `expected_type` must match the tag byte.  Returns `(value_start, value_end)`\n/// on success, `Err` on type mismatch, truncation, or overflow.\nfn asn1_tlv(\n    bytes: &[u8],\n    bytes_max: usize,\n    pos: usize,\n    expected_type: u8,\n) -> Result<(usize, usize), Error> {\n    if pos >= bytes_max || bytes[pos] != expected_type {\n        return Err(Error::Generic);\n    }\n    let pos = pos + 1;\n    if pos >= bytes_max {\n        return Err(Error::Generic);\n    }\n    let first = bytes[pos];\n    let (length, val_start) = if first < 0x80 {\n        (first as usize, pos + 1)\n    } else {\n        let n = (first & 0x7F) as usize;\n        if n == 0 || pos + 1 + n > bytes_max {\n            return Err(Error::Generic);\n        }\n        let mut len = 0usize;\n        for i in 0..n {\n            len = (len << 8) | (bytes[pos + 1 + i] as usize);\n        }\n        (len, pos + 1 + n)\n    };\n    let val_end = val_start + length;\n    if val_end > bytes_max {\n        return Err(Error::Generic);\n    }\n    Ok((val_start, val_end))\n}\n\n/// Parse a DER-encoded SubjectPublicKeyInfo structure.\n///\n/// Walks the outer SEQUENCE → AlgorithmIdentifier SEQUENCE → OID +\n/// optional parameters → BIT STRING layout described in RFC 5480 and\n/// RFC 8410, returning zero-copy sub-slices into `input`.\n///\n/// Returns `Err(Error::Generic)` for any structural violation (wrong tag,\n/// truncated length field, outer-sequence length mismatch, or trailing\n/// bytes after the BIT STRING).\n///\n/// C: `picoquic_parse_public_key_asn1`\npub fn parse_public_key_asn1(input: &[u8]) -> Result<PublicKeyAsn1<'_>, Error> {\n    let bytes_max = input.len();\n\n    // Outer SEQUENCE must span the entire buffer.\n    let (outer_val, outer_end) = asn1_tlv(input, bytes_max, 0, 0x30)?;\n    if outer_end != bytes_max {\n        return Err(Error::Generic); // PTLS_ERROR_BER_EXCESSIVE_LENGTH\n    }\n\n    // AlgorithmIdentifier SEQUENCE.\n    let (inner_val, inner_end) = asn1_tlv(input, outer_end, outer_val, 0x30)?;\n\n    // Algorithm OID — value bytes only (tag + length consumed by asn1_tlv).\n    let (oid_val, oid_end) = asn1_tlv(input, inner_end, inner_val, 0x06)?;\n    let algo = &input[oid_val..oid_end];\n\n    // Parameters: everything remaining in the inner SEQUENCE after the OID.\n    let param = if inner_end <= oid_end {\n        &input[0..0]\n    } else {\n        &input[oid_end..inner_end]\n    };\n\n    // BIT STRING (public key), must consume the rest of the outer SEQUENCE.\n    let (bs_val, bs_end) = asn1_tlv(input, outer_end, inner_end, 0x03)?;\n    if bs_end != outer_end {\n        return Err(Error::Generic); // PTLS_ERROR_BER_ELEMENT_TOO_SHORT\n    }\n    let bit_string = &input[bs_val..bs_end];\n\n    Ok(PublicKeyAsn1 {\n        algo,\n        param,\n        bit_string,\n        consumed: bs_end,\n    })\n}\n\n// ---------------------------------------------------------------------------\n// Tests.\n\n#[cfg(test)]\nmod tests {\n    use super::*;\n\n    #[test]\n    fn base64_encode_empty() {\n        let mut buf = [0u8; 1];\n        let n = base64_encode(&[], &mut buf).unwrap();\n        assert_eq!(n, 0);\n        assert_eq!(buf[0], 0);\n    }\n\n    #[test]\n    fn base64_encode_three_bytes() {\n        // \"Man\" → \"TWFu\"\n        let mut buf = [0u8; 5];\n        let n = base64_encode(b\"Man\", &mut buf).unwrap();\n        assert_eq!(n, 4);\n        assert_eq!(&buf[..4], b\"TWFu\");\n        assert_eq!(buf[4], 0);\n    }\n\n    #[test]\n    fn base64_encode_padding_one() {\n        // \"M\" → \"TQ==\"\n        let mut buf = [0u8; 5];\n        let n = base64_encode(b\"M\", &mut buf).unwrap();\n        assert_eq!(n, 4);\n        assert_eq!(&buf[..4], b\"TQ==\");\n    }\n\n    #[test]\n    fn base64_encode_padding_two() {\n        // \"Ma\" → \"TWE=\"\n        let mut buf = [0u8; 5];\n        let n = base64_encode(b\"Ma\", &mut buf).unwrap();\n        assert_eq!(n, 4);\n        assert_eq!(&buf[..4], b\"TWE=\");\n    }\n\n    #[test]\n    fn base64_encode_buffer_too_small() {\n        let mut buf = [0u8; 4]; // needs 5 (4 chars + NUL)\n        assert!(base64_encode(b\"Man\", &mut buf).is_err());\n    }\n\n    #[test]\n    fn base64_encoded_len_values() {\n        assert_eq!(base64_encoded_len(0), 0);\n        assert_eq!(base64_encoded_len(1), 4);\n        assert_eq!(base64_encoded_len(2), 4);\n        assert_eq!(base64_encoded_len(3), 4);\n        assert_eq!(base64_encoded_len(4), 8);\n        assert_eq!(base64_encoded_len(6), 8);\n    }\n\n    #[test]\n    fn ech_get_ciphers_p256() {\n        let mut out = [HpkeCipherSuiteId { kdf: 0, aead: 0 }; 4];\n        let n = ech_get_ciphers_from_kem(kem_id::P256_SHA256, &mut out).unwrap();\n        assert!(n >= 1);\n        assert_eq!(out[0].kdf, kdf_id::HKDF_SHA256);\n        assert_eq!(out[0].aead, aead_id::AES_128_GCM);\n    }\n\n    #[test]\n    fn ech_get_ciphers_p384() {\n        let mut out = [HpkeCipherSuiteId { kdf: 0, aead: 0 }; 4];\n        let n = ech_get_ciphers_from_kem(kem_id::P384_SHA384, &mut out).unwrap();\n        assert!(n >= 1);\n        assert_eq!(out[0].kdf, kdf_id::HKDF_SHA384);\n        assert_eq!(out[0].aead, aead_id::AES_256_GCM);\n    }\n\n    #[test]\n    fn ech_get_ciphers_x25519() {\n        let mut out = [HpkeCipherSuiteId { kdf: 0, aead: 0 }; 4];\n        let n = ech_get_ciphers_from_kem(kem_id::X25519_SHA256, &mut out).unwrap();\n        assert!(n >= 1);\n        assert_eq!(out[0].kdf, kdf_id::HKDF_SHA256);\n        assert_eq!(out[0].aead, aead_id::CHACHA20_POLY1305);\n    }\n\n    #[test]\n    fn ech_get_ciphers_out_too_small() {\n        let mut out = [HpkeCipherSuiteId { kdf: 0, aead: 0 }; 1];\n        assert!(ech_get_ciphers_from_kem(kem_id::P256_SHA256, &mut out).is_err());\n    }\n\n    #[test]\n    fn config_id_is_deterministic() {\n        let key = [1u8, 2, 3, 4];\n        let suites = [HpkeCipherSuiteId {\n            kdf: kdf_id::HKDF_SHA256,\n            aead: aead_id::AES_128_GCM,\n        }];\n        let id1 = ech_config_id_from_config(&key, kem_id::X25519_SHA256, &suites, \"example.com\");\n        let id2 = ech_config_id_from_config(&key, kem_id::X25519_SHA256, &suites, \"example.com\");\n        assert_eq!(id1, id2);\n    }\n\n    #[test]\n    fn config_id_changes_with_key() {\n        let suites = [HpkeCipherSuiteId {\n            kdf: kdf_id::HKDF_SHA256,\n            aead: aead_id::AES_128_GCM,\n        }];\n        let id1 =\n            ech_config_id_from_config(&[1, 2, 3], kem_id::X25519_SHA256, &suites, \"example.com\");\n        let id2 =\n            ech_config_id_from_config(&[4, 5, 6], kem_id::X25519_SHA256, &suites, \"example.com\");\n        assert_ne!(id1, id2);\n    }\n\n    #[test]\n    fn kem_from_curve_known_groups() {\n        assert_eq!(\n            ech_get_kem_from_curve(group_id::SECP256R1),\n            Some(kem_id::P256_SHA256)\n        );\n        assert_eq!(\n            ech_get_kem_from_curve(group_id::SECP384R1),\n            Some(kem_id::P384_SHA384)\n        );\n        assert_eq!(\n            ech_get_kem_from_curve(group_id::X25519),\n            Some(kem_id::X25519_SHA256)\n        );\n    }\n\n    #[test]\n    fn kem_from_curve_unknown() {\n        assert_eq!(ech_get_kem_from_curve(0xFFFF), None);\n    }\n\n    // Minimal DER-encoded SubjectPublicKeyInfo for X25519 (RFC 8410):\n    // SEQUENCE {\n    //   SEQUENCE { OID 1.3.101.110 }        -- id-X25519\n    //   BIT STRING { 0x00 <32 zero bytes> }  -- fake key, padding=0\n    // }\n    fn x25519_spki() -> Vec<u8> {\n        let oid: &[u8] = &[0x2b, 0x65, 0x6e]; // 1.3.101.110\n        // inner SEQUENCE: OID TLV\n        let mut inner = Vec::new();\n        inner.push(0x06);\n        inner.push(oid.len() as u8);\n        inner.extend_from_slice(oid);\n        // BIT STRING: padding byte + 32-byte key\n        let mut bs_val = vec![0x00u8]; // padding count\n        bs_val.extend_from_slice(&[0xABu8; 32]);\n        let mut outer = Vec::new();\n        // inner SEQUENCE TLV\n        outer.push(0x30);\n        outer.push(inner.len() as u8);\n        outer.extend_from_slice(&inner);\n        // BIT STRING TLV\n        outer.push(0x03);\n        outer.push(bs_val.len() as u8);\n        outer.extend_from_slice(&bs_val);\n        // wrap in outer SEQUENCE\n        let mut spki = Vec::new();\n        spki.push(0x30);\n        spki.push(outer.len() as u8);\n        spki.extend_from_slice(&outer);\n        spki\n    }\n\n    #[test]\n    fn parse_public_key_asn1_x25519() {\n        let spki = x25519_spki();\n        let r = parse_public_key_asn1(&spki).unwrap();\n        assert_eq!(r.algo, &[0x2b, 0x65, 0x6e]);\n        assert_eq!(r.param, &[] as &[u8]); // X25519 has no parameters\n        assert_eq!(r.bit_string[0], 0x00); // padding byte\n        assert_eq!(r.bit_string.len(), 33); // 1 + 32 key bytes\n        assert_eq!(r.consumed, spki.len());\n    }\n\n    #[test]\n    fn parse_public_key_asn1_truncated() {\n        let spki = x25519_spki();\n        assert!(parse_public_key_asn1(&spki[..4]).is_err());\n    }\n\n    #[test]\n    fn parse_public_key_asn1_wrong_outer_tag() {\n        let mut spki = x25519_spki();\n        spki[0] = 0x31; // SET instead of SEQUENCE\n        assert!(parse_public_key_asn1(&spki).is_err());\n    }\n}\n","numLines":740,"startLine":1,"totalLines":740}}}
