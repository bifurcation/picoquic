key of the client facing server.\n771\t* - supported HPKE cipher suites.\n772\t*\n773\t* If the configuration is not available, it will have to be created.\n774\t* The server admin will have to provide the parameters.\n775\t* Many picoquic deployments use small servers with limited management.\n776\t* In that case, we may use default values such as the DNS name of\n777\t* the local server, the public key found in the local server certificate,\n778\t* a locally supported HPKE-KEM compatible with the public key,\n779\t* the list of locally supported HPKE symmetric cipher suites,\n780\t* and a configuration ID computed as combination of these local\n781\t* parameters.\n782\t*/\n783\tstatic int picoquic_ech_create_config_list_from_config(ptls_buffer_t* config_buf, uint8_t** config_list, size_t* config_list_len)\n784\t{\n785\t    int ret = 0;\n786\t    size_t bin_size = config_buf->off + 2;\n787\t    uint8_t* bin_val = (uint8_t*)malloc(bin_size);\n788\t    if (bin_val == NULL) {\n789\t        DBG_PRINTF(\"Cannot allocate %d bytes for config bin buffer\", bin_size);\n790\t        ret = -1;\n791\t    }\n792\t    else {\n793\t        bin_val[0] = (uint8_t)(((config_buf->off) >> 8) & 0xff);\n794\t        bin_val[1] = (uint8_t)(config_buf->off & 0xff);\n795\t        memcpy(bin_val + 2, config_buf->base, config_buf->off);\n796\t        *config_list = bin_val;\n797\t        *config_list_len = bin_size;\n798\t    }\n799\t    return ret;"}]},"parent_tool_use_id":null,"session_id":"0935a79a-3385-490e-8044-a2b7bb8dca0a","uuid":"61f928bf-d6be-446c-8996-9a8e728f25e5","timestamp":"2026-05-07T14:22:18.995Z","tool_use_result":{"type":"text","file":{"filePath":"/Users/richbarn/Projects/picoquic/picoquic/ech.c","content":"        }\n        else {\n            ret = -1;\n        }\n    } else {\n        cipher_vec[0] = target_cipher;\n        nb_ciphers = 1;\n        if (default_cipher != NULL && default_cipher != target_cipher && cipher_vec_nb_max > 2) {\n            cipher_vec[1] = defa