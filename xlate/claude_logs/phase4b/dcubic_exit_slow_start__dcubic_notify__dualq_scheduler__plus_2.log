{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01KZPMoBjqBB7PWLe46Eht9f","type":"tool_result","content":"1\t//! Translation of `picoquic/cubic.c` — CUBIC congestion control.\n2\t//!\n3\t//! Phase 4: `cubic_W_cubic` (private helper) and `cubic_observe`\n4\t//! (public API method on [`CubicState`]).\n5\t\n6\tuse crate::cc_common::{ConnectionCc, MinMaxRtt, PathCc, SMOOTHED_LOSS_THRESHOLD};\n7\tuse crate::internal::{CWIN_INITIAL, CWIN_MINIMUM, Connection, Path};\n8\tuse crate::{CongestionNotification, PerAckState};\n9\t\n10\t// ---------------------------------------------------------------------------\n11\t// Constants from cubic.c `#define`s.\n12\t\n13\tconst CUBIC_C: f64 = 0.4;\n14\tconst CUBIC_BETA_ECN: f64 = 7.0 / 8.0;\n15\t#[allow(dead_code)]\n16\tconst CUBIC_BETA: f64 = 3.0 / 4.0;\n17\t\n18\t// ---------------------------------------------------------------------------\n19\t// Algorithm-state enum.  C: `picoquic_cubic_alg_state_t`.\n20\t\n21\t/// C: `picoquic_cubic_alg_state_t`\n22\t#[derive(Debug, Copy, Clone, PartialEq, Eq, Default)]\n23\tpub enum CubicAlgState {\n24\t    #[default]\n25\t    SlowStart = 0,\n26\t    Recovery,\n27\t    CongestionAvoidance,\n28\t}\n29\t\n30\t// ---------------------------------------------------------------------------\n31\t// Per-path CUBIC state.  C: `picoquic_cubic_state_t`.\n32\t\n33\t/// C: `picoquic_cubic_state_t`\n34\t///\n35\t/// Type deviations from C:\n36\t/// * `alg_state` (`picoquic_cubic_alg_state_t`) → [`CubicAlgState`]\n37\t/// * `previous_alg_state` stored as `u64` to preserve raw casts done in\n38\t///   the C body (`cubic_state->previous_alg_state = cubic_state->alg_state`)\n39\t/// * `K`, `W_max`, `W_last_max`, `W_reno` (`double`) → `f64`\n40\t/// * `rtt_filter` (`picoquic_min_max_rtt_t`) → [`MinMaxRtt`]\n41\tpub struct CubicState {\n42\t    pub alg_state: CubicAlgState,\n43\t    pub recovery_sequence: u64,\n44\t    pub start_of_epoch: u64,\n45\t    pub previous_start_of_epoch: u64,\n46\t    pub previous_alg_state: u64,\n47\t    pub previous_ssthresh: u64,\n48\t    pub previous_cwin: u64,\n49\t    pub k: f64,\n50\t    pub w_max: f64,\n51\t    pub w_last_max: f64,\n52\t    pub w_reno: f64,\n53\t    pub ssthresh: u64,\n54\t    pub rtt_filter: MinMaxRtt,\n55\t}\n56\t\n57\timpl Default for CubicState {\n58\t    fn default() -> Self {\n59\t        Self {\n60\t            alg_state: CubicAlgState::SlowStart,\n61\t            recovery_sequence: 0,\n62\t            start_of_epoch: 0,\n63\t            previous_start_of_epoch: 0,\n64\t            previous_alg_state: 0,\n65\t            previous_ssthresh: u64::MAX,\n66\t            previous_cwin: 0,\n67\t            k: 0.0,\n68\t            w_max: 0.0,\n69\t            w_last_max: 0.0,\n70\t            w_reno: 0.0,\n71\t            ssthresh: u64::MAX,\n72\t            rtt_filter: MinMaxRtt::default(),\n73\t        }\n74\t    }\n75\t}\n76\t\n77\timpl CubicState {\n78\t    /// C: `cubic_reset` (picoquic/cubic.c:53)\n79\t    ///\n80\t    /// Reset `self` to the initial CUBIC state for `path_x` at `current_time`.\n81\t    /// Mirrors the C body: zero the struct, set `path_x.cwin` to\n82\t    /// [`CWIN_INITIAL`], then populate per-epoch fields.\n83\t    pub fn reset(&mut self, path_x: &mut Path, current_time: u64) {\n84\t        let w_last_max = u64::MAX as f64 / path_x.send_mtu as f64;\n85\t        path_x.cwin = CWIN_INITIAL;\n86\t        *self = Self {\n87\t            alg_state: CubicAlgState::SlowStart,\n88\t            recovery_sequence: 0,\n89\t            start_of_epoch: current_time,\n90\t            previous_start_of_epoch: current_time,\n91\t            previous_alg_state: CubicAlgState::SlowStart as u64,\n92\t            previous_ssthresh: u64::MAX,\n93\t            previous_cwin: CWIN_INITIAL,\n94\t            k: 0.0,\n95\t            w_max: w_last_max,\n96\t            w_last_max,\n97\t            w_reno: CWIN_INITIAL as f64,\n98\t            ssthresh: u64::MAX,\n99\t            rtt_filter: MinMaxRtt::default(),\n100\t        };\n101\t    }\n102\t\n103\t    /// C: `cubic_W_cubic` (picoquic/cubic.c:121)\n104\t    ///\n105\t    /// Compute `W_cubic(t) = C * (t − K)³ + W_max` where `t` is the\n106\t    /// elapsed time in seconds since `start_of_epoch`.  Returns the\n107\t    /// window size in packets (not bytes).\n108\t    ///\n109\t    /// The subtraction `current_time - start_of_epoch` mirrors the\n110\t    /// unsigned C arithmetic; wrapping is intentional for out-of-order\n111\t    /// calls (same as C `uint64_t` semantics).\n112\t    fn w_cubic(&self, current_time: u64) -> f64 {\n113\t        let delta_t_sec =\n114\t            current_time.wrapping_sub(self.start_of_epoch) as f64 / 1_000_000.0 - self.k;\n115\t        CUBIC_C * (delta_t_sec * delta_t_sec * delta_t_sec) + self.w_max\n116\t    }\n117\t\n118\t    /// C: `cubic_enter_avoidance` (picoquic/cubic.c:132)\n119\t    ///\n120\t    /// Compute the CUBIC coefficient `K` and switch to congestion\n121\t    /// avoidance at `current_time`.\n122\t    pub fn enter_avoidance(&mut self, current_time: u64) {\n123\t        self.k = cubic_root(self.w_max * (1.0 - CUBIC_BETA_ECN) / CUBIC_C);\n124\t        self.alg_state = CubicAlgState::CongestionAvoidance;\n125\t        self.start_of_epoch = current_time;\n126\t        self.previous_start_of_epoch = self.start_of_epoch;\n127\t    }\n128\t\n129\t    /// C: `cubic_observe` (picoquic/cubic.c:562)\n130\t    ///\n131\t    /// Report the current algorithm state and `W_max` to an observer.\n132\t    /// Returns `(cc_state, cc_param)` where `cc_state` is the numeric\n133\t    /// discriminant of [`CubicAlgState`] and `cc_param` is `W_max`\n134\t    /// cast to `u64` (matching the C `(uint64_t)cubic_state->W_max`).\n135\t    pub fn observe(&self) -> (u64, u64) {\n136\t        (self.alg_state as u64, self.w_max as u64)\n137\t    }\n138\t\n139\t    /// Convenience wrapper that fills the two out-parameters used by\n140\t    /// the C `cubic_observe` call-site signature\n141\t    /// `(path_x, &mut cc_state, &mut cc_param)`.\n142\t    pub fn observe_into(&self, cc_state: &mut u64, cc_param: &mut u64) {\n143\t        let (s, p) = self.observe();\n144\t        *cc_state = s;\n145\t        *cc_param = p;\n146\t    }\n147\t\n148\t    /// C: `cubic_init` (picoquic/cubic.c:70)\n149\t    ///\n150\t    /// Initialise per-path CUBIC state and store it in\n151\t    /// `path_x.congestion_alg_state`.  Mirrors the C pattern of\n152\t    /// `malloc` + `cubic_reset`; the Rust translation boxes a\n153\t    /// `CubicState` into `Option<Box<dyn Any>>`.\n154\t    pub fn init(path_x: &mut Path, _option_string: Option<&str>, current_time: u64) {\n155\t        let mut state = Box::new(CubicState::default());\n156\t        state.reset(path_x, current_time);\n157\t        path_x.congestion_alg_state = Some(state);\n158\t    }\n159\t\n160\t    /// C: `cubic_enter_recovery` (picoquic/cubic.c:144)\n161\t    ///\n162\t    /// Record the start of a recovery epoch, apply the CUBIC fast-\n163\t    /// convergence rule, compute the new slow-start threshold, and\n164\t    /// either fall back to slow start (if the new threshold is too\n165\t    /// small) or enter congestion avoidance immediately.\n166\t    pub fn enter_recovery(\n167\t        &mut self,\n168\t        connection: &Connection,\n169\t        path_x: &mut Path,\n170\t        notification: CongestionNotification,\n171\t        current_time: u64,\n172\t    ) {\n173\t        self.recovery_sequence = connection.sequence_number(path_x);\n174\t        self.previous_start_of_epoch = self.start_of_epoch;\n175\t        self.previous_alg_state = self.alg_state as u64;\n176\t        self.previous_ssthresh = self.ssthresh;\n177\t        self.previous_cwin = path_x.cwin;\n178\t\n179\t        self.w_max = path_x.cwin as f64 / path_x.send_mtu as f64;\n180\t\n181\t        // Fast convergence.\n182\t        if self.w_max < self.w_last_max {\n183\t            self.w_last_max = self.w_max;\n184\t            self.w_max *= CUBIC_BETA_ECN;\n185\t        } else {\n186\t            self.w_last_max = self.w_max;\n187\t        }\n188\t\n189\t        self.ssthresh = (self.w_max * CUBIC_BETA_ECN * path_x.send_mtu as f64) as u64;\n190\t\n191\t        if self.ssthresh < CWIN_MINIMUM {\n192\t            // Things are very bad — fall back to slow start.\n193\t            self.alg_state = CubicAlgState::SlowStart;\n194\t            self.ssthresh = u64::MAX;\n195\t            path_x.is_ssthresh_initialized = false;\n196\t            self.previous_start_of_epoch = self.start_of_epoch;\n197\t            self.start_of_epoch = current_time;\n198\t            self.w_reno = CWIN_MINIMUM as f64;\n199\t            path_x.cwin = CWIN_MINIMUM;\n200\t        } else if notification == CongestionNotification::Timeout {\n201\t            path_x.cwin = CWIN_MINIMUM;\n202\t            self.previous_start_of_epoch = self.start_of_epoch;\n203\t            self.start_of_epoch = current_time;\n204\t            self.alg_state = CubicAlgState::SlowStart;\n205\t        } else {\n206\t            // Enter congestion avoidance immediately.\n207\t            self.enter_avoidance(current_time);\n208\t            let w_cubic = self.w_cubic(current_time);\n209\t            let win_cubic = (w_cubic * path_x.send_mtu as f64) as u64;\n210\t            self.w_reno = path_x.cwin as f64 / 2.0;\n211\t            // See comment in cubic.c:195-200: w_cubic >= w_reno holds for\n212\t            // CUBIC_BETA_ECN > 0.618, so we pick win_cubic unconditionally.\n213\t            path_x.cwin = win_cubic;\n214\t        }\n215\t    }\n216\t\n217\t    /// C: `cubic_correct_spurious` (picoquic/cubic.c:214)\n218\t    ///\n219\t    /// Undo the most-recent recovery step when the triggering loss\n220\t    /// turns out to have been spurious.\n221\t    pub fn correct_spurious(&mut self, path_x: &mut Path, current_time: u64) {\n222\t        if self.ssthresh != u64::MAX {\n223\t            self.w_max = self.w_last_max;\n224\t            self.start_of_epoch = self.previous_start_of_epoch;\n225\t            self.alg_state = match self.previous_alg_state {\n226\t                0 => CubicAlgState::SlowStart,\n227\t                1 => CubicAlgState::Recovery,\n228\t                _ => CubicAlgState::CongestionAvoidance,\n229\t            };\n230\t            if self.alg_state != CubicAlgState::SlowStart {\n231\t                self.enter_avoidance(self.previous_start_of_epoch);\n232\t                let w_cubic = self.w_cubic(current_time);\n233\t                self.w_reno = w_cubic * path_x.send_mtu as f64;\n234\t                self.ssthresh = (self.w_max * CUBIC_BETA * path_x.send_mtu as f64) as u64;\n235\t                path_x.cwin = self.w_reno as u64;\n236\t            } else {\n237\t                self.ssthresh = self.previous_ssthresh;\n238\t                path_x.cwin = self.previous_cwin;\n239\t                self.w_reno = self.previous_cwin as f64;\n240\t            }\n241\t        }\n242\t    }\n243\t\n244\t    /// C: `cubic_notify` (picoquic/cubic.c:243)\n245\t    ///\n246\t    /// Main congestion-control event handler.  Called by the QUIC engine\n247\t    /// on every ACK, loss, ECN, RTT-measurement, and reset event.\n248\t    pub fn notify(\n249\t        &mut self,\n250\t        connection: &mut Connection,\n251\t        path_x: &mut Path,\n252\t        notification: CongestionNotification,\n253\t        ack_state: &PerAckState,\n254\t        current_time: u64,\n255\t    ) {\n256\t        use crate::Instant;\n257\t\n258\t        path_x.is_cc_data_updated = true;\n259\t\n260\t        match notification {\n261\t            CongestionNotification::Acknowledgement => match self.alg_state {\n262\t                CubicAlgState::SlowStart => {\n263\t                    path_x.cwin = path_x.update_target_cwin_estimation();\n264\t                    if path_x.last_time_acked_data_frame_sent > path_x.last_sender_limited_time {\n265\t                        path_x.cwin +=\n266\t                            path_x.slow_start_increase_ex(ack_state.nb_bytes_acknowledged, false);\n267\t                        if path_x.cwin >= self.ssthresh {\n268\t                            self.w_reno = path_x.cwin as f64 / 2.0;\n269\t                            path_x.is_ssthresh_initialized = true;\n270\t                            self.enter_avoidance(current_time);\n271\t                        }\n272\t                    }\n273\t                }\n274\t                CubicAlgState::Recovery => {\n275\t                    self.alg_state = CubicAlgState::SlowStart;\n276\t                    path_x.cwin += ack_state.nb_bytes_acknowledged;\n277\t                    if path_x.cwin >= self.ssthresh {\n278\t                        self.alg_state = CubicAlgState::CongestionAvoidance;\n279\t                    }\n280\t                }\n281\t                CubicAlgState::CongestionAvoidance => {\n282\t                    if path_x.last_time_acked_data_frame_sent > path_x.last_sender_limited_time {\n283\t                        // Protect against limited senders.\n284\t                        if self.start_of_epoch < path_x.last_sender_limited_time.ticks() {\n285\t                            self.start_of_epoch = path_x.last_sender_limited_time.ticks();\n286\t                        }\n287\t                        let w_cubic = self.w_cubic(current_time);\n288\t                        let win_cubic = (w_cubic * path_x.send_mtu as f64) as u64;\n289\t                        self.w_reno += ack_state.nb_bytes_acknowledged as f64\n290\t                            * path_x.send_mtu as f64\n291\t                            / self.w_reno;\n292\t                        if win_cubic as f64 > self.w_reno {\n293\t                            path_x.cwin = win_cubic;\n294\t                        } else {\n295\t                            path_x.cwin = self.w_reno as u64;\n296\t                        }\n297\t                    }\n298\t                }\n299\t            },\n300\t\n301\t            CongestionNotification::Repeat\n302\t            | CongestionNotification::Timeout\n303\t            | CongestionNotification::EcnEc => match self.alg_state {\n304\t                CubicAlgState::SlowStart => {\n305\t                    if (notification == CongestionNotification::EcnEc\n306\t                        || self.rtt_filter.hystart_loss_test(\n307\t                            notification,\n308\t                            ack_state.lost_packet_number,\n309\t                            SMOOTHED_LOSS_THRESHOLD,\n310\t                        ))\n311\t                        && (current_time.wrapping_sub(self.start_of_epoch)\n312\t                            > path_x.smoothed_rtt.ticks()\n313\t                            || self.recovery_sequence <= connection.ack_number(path_x))\n314\t                    {\n315\t                        path_x.is_ssthresh_initialized = true;\n316\t                        self.enter_recovery(connection, path_x, notification, current_time);\n317\t                    }\n318\t                }\n319\t                CubicAlgState::Recovery | CubicAlgState::CongestionAvoidance => {\n320\t                    if ack_state.lost_packet_number >= self.recovery_sequence\n321\t                        && (notification == CongestionNotification::EcnEc\n322\t                            || self.rtt_filter.hystart_loss_test(\n323\t                                notification,\n324\t                                ack_state.lost_packet_number,\n325\t                                SMOOTHED_LOSS_THRESHOLD,\n326\t                            ))\n327\t                    {\n328\t                        self.enter_recovery(connection, path_x, notification, current_time);\n329\t                    }\n330\t                }\n331\t            },\n332\t\n333\t            CongestionNotification::SpuriousRepeat => {\n334\t                self.correct_spurious(path_x, current_time);\n335\t            }\n336\t\n337\t            CongestionNotification::RttMeasurement => {\n338\t                if self.alg_state == CubicAlgState::SlowStart && self.ssthresh == u64::MAX {\n339\t                    let rtt_meas = if connection.is_time_stamp_enabled {\n340\t                        ack_state.one_way_delay\n341\t                    } else {\n342\t                        ack_state.rtt_measurement\n343\t                    };\n344\t                    let ptime = Instant::from_ticks(\n345\t                        connection\n346\t                            .paths\n347\t                            .first()\n348\t                            .map_or(0, |p| p.pacing.packet_time_microsec.ticks()),\n349\t                    );\n350\t                    if self.rtt_filter.hystart_test(\n351\t                        rtt_meas,\n352\t                        ptime,\n353\t                        Instant::from_ticks(current_time),\n354\t                        connection.is_time_stamp_enabled,\n355\t                    ) {\n356\t                        let rtt_min = self.rtt_filter.rtt_filtered_min;\n357\t                        let target_reno = crate::internal::TARGET_RENO_RTT;\n358\t                        let target_sat = crate::internal::TARGET_SATELLITE_RTT;\n359\t\n360\t                        if rtt_min > target_reno {\n361\t                            let correction = if rtt_min > target_sat {\n362\t                                target_sat.ticks() as f64 / rtt_min.ticks() as f64\n363\t                            } else {\n364\t                                target_reno.ticks() as f64 / rtt_min.ticks() as f64\n365\t                            };\n366\t                            let base_window = (correction * path_x.cwin as f64) as u64;\n367\t                            let delta_window = path_x.cwin - base_window;\n368\t                            path_x.cwin -= delta_window / 2;\n369\t                        } else {\n370\t                            path_x.cwin /= 2;\n371\t                        }\n372\t\n373\t                        self.ssthresh = path_x.cwin;\n374\t                        self.w_max = path_x.cwin as f64 / path_x.send_mtu as f64;\n375\t                        self.w_last_max = self.w_max;\n376\t                        self.w_reno = path_x.cwin as f64;\n377\t                        path_x.is_ssthresh_initialized = true;\n378\t\n379\t                        self.enter_recovery(connection, path_x, notification, current_time);\n380\t\n381\t                        // Adjust epoch so we enter the test phase immediately.\n382\t                        let k_micro = (self.k * 1_000_000.0) as u64;\n383\t                        if k_micro > current_time {\n384\t                            self.k = current_time as f64 / 1_000_000.0;\n385\t                            self.start_of_epoch = 0;\n386\t                        } else {\n387\t                            self.start_of_epoch = current_time - k_micro;\n388\t                        }\n389\t                    }\n390\t                }\n391\t            }\n392\t\n393\t            CongestionNotification::SeedCwin => {\n394\t                if self.alg_state == CubicAlgState::SlowStart && self.ssthresh == u64::MAX {\n395\t                    if path_x.cwin < ack_state.nb_bytes_acknowledged {\n396\t                        path_x.cwin = ack_state.nb_bytes_acknowledged;\n397\t                    }\n398\t                    self.ssthresh = ack_state.nb_bytes_acknowledged;\n399\t                    self.w_max = path_x.cwin as f64 / path_x.send_mtu as f64;\n400\t                    self.w_last_max = self.w_max;\n401\t                    self.w_reno = path_x.cwin as f64;\n402\t                    path_x.is_ssthresh_initialized = true;\n403\t                    self.enter_avoidance(current_time);\n404\t                }\n405\t            }\n406\t\n407\t            CongestionNotification::Reset => {\n408\t                self.reset(path_x, current_time);\n409\t            }\n410\t\n411\t            _ => {}\n412\t        }\n413\t\n414\t        // Update pacing data.\n415\t        let in_slow_start = self.alg_state == CubicAlgState::SlowStart && self.ssthresh == u64::MAX;\n416\t        path_x.update_pacing_data(in_slow_start as i32);\n417\t    }\n418\t}\n419\t\n420\t// ---------------------------------------------------------------------------\n421\t\n422\t/// C: `cubic_root` (picoquic/cubic.c:83)\n423\t///\n424\t/// Newton-Raphson cube-root approximation using bit-shift bracketing\n425\t/// followed by three Newton steps.  Input `x` is the CUBIC `W_max *\n426\t/// (1 − β) / C` value; result is `K`, the time-to-reach-W_max.\n427\tfn cubic_root(x: f64) -> f64 {\n428\t    let mut v: f64 = 1.0;\n429\t    let mut y: f64 = 1.0;\n430\t\n431\t    while v > x * 8.0 {\n432\t        v /= 8.0;\n433\t        y /= 2.0;\n434\t    }\n435\t    while v < x {\n436\t        v *= 8.0;\n437\t        y *= 2.0;\n438\t    }\n439\t    for _ in 0..3 {\n440\t        let y2 = y * y;\n441\t        let y3 = y2 * y;\n442\t        y += (x - y3) / (3.0 * y2);\n443\t    }\n444\t    y\n445\t}\n446\t\n447\t#[cfg(test)]\n448\tmod tests {\n449\t    use super::*;\n450\t\n451\t    #[test]\n452\t    fn w_cubic_at_epoch_start() {\n453\t        let state = CubicState {\n454\t            start_of_epoch: 1_000_000,\n455\t            k: 0.0,\n456\t            w_max: 10.0,\n457\t            ..Default::default()\n458\t        };\n459\t        // At t = start_of_epoch: delta_t_sec = 0 - 0 = 0; W_cubic = 0 + W_max\n460\t        let w = state.w_cubic(1_000_000);\n461\t        assert!((w - 10.0).abs() < 1e-10);\n462\t    }\n463\t\n464\t    #[test]\n465\t    fn w_cubic_positive_t() {\n466\t        let state = CubicState {\n467\t            start_of_epoch: 0,\n468\t            k: 0.0,\n469\t            w_max: 0.0,\n470\t            ..Default::default()\n471\t        };\n472\t        // delta_t_sec = 1.0; W_cubic = 0.4 * 1^3 + 0 = 0.4\n473\t        let w = state.w_cubic(1_000_000);\n474\t        assert!((w - 0.4).abs() < 1e-10);\n475\t    }\n476\t\n477\t    #[test]\n478\t    fn observe_returns_state_and_w_max() {\n479\t        let state = CubicState {\n480\t            alg_state: CubicAlgState::CongestionAvoidance,\n481\t            w_max: 42.7,\n482\t            ..Default::default()\n483\t        };\n484\t        let (cc_state, cc_param) = state.observe();\n485\t        assert_eq!(cc_state, CubicAlgState::CongestionAvoidance as u64);\n486\t        assert_eq!(cc_param, 42); // truncated cast, same as C (uint64_t)42.7 = 42\n487\t    }\n488\t\n489\t    #[test]\n490\t    fn cubic_root_cube() {\n491\t        // cubic_root(8) ≈ 2.0\n492\t        let r = cubic_root(8.0);\n493\t        assert!((r - 2.0).abs() < 1e-6);\n494\t    }\n495\t}\n496\t"}]},"parent_tool_use_id":null,"session_id":"0935a79a-3385-490e-8044-a2b7bb8dca0a","uuid":"5ce83e6f-272c-48ad-a0e2-2268d699e287","timestamp":"2026-05-07T14:16:42.409Z","tool_use_result":{"type":"text","file":{"filePath":"/Users/richbarn/Projects/picoquic/rs/fq/src/cubic.rs","content":"//! Translation of `picoquic/cubic.c` — CUBIC congestion control.\n//!\n//! Phase 4: `cubic_W_cubic` (private helper) and `cubic_observe`\n//! (public API method on [`CubicState`]).\n\nuse crate::cc_common::{ConnectionCc, MinMaxRtt, PathCc, SMOOTHED_LOSS_THRESHOLD};\nuse crate::internal::{CWIN_INITIAL, CWIN_MINIMUM, Connection, Path};\nuse crate::{CongestionNotification, PerAckState};\n\n// ---------------------------------------------------------------------------\n// Constants from cubic.c `#define`s.\n\nconst CUBIC_C: f64 = 0.4;\nconst CUBIC_BETA_ECN: f64 = 7.0 / 8.0;\n#[allow(dead_code)]\nconst CUBIC_BETA: f64 = 3.0 / 4.0;\n\n// ---------------------------------------------------------------------------\n// Algorithm-state enum.  C: `picoquic_cubic_alg_state_t`.\n\n/// C: `picoquic_cubic_alg_state_t`\n#[derive(Debug, Copy, Clone, PartialEq, Eq, Default)]\npub enum CubicAlgState {\n    #[default]\n    SlowStart = 0,\n    Recovery,\n    CongestionAvoidance,\n}\n\n// ---------------------------------------------------------------------------\n// Per-path CUBIC state.  C: `picoquic_cubic_state_t`.\n\n/// C: `picoquic_cubic_state_t`\n///\n/// Type deviations from C:\n/// * `alg_state` (`picoquic_cubic_alg_state_t`) → [`CubicAlgState`]\n/// * `previous_alg_state` stored as `u64` to preserve raw casts done in\n///   the C body (`cubic_state->previous_alg_state = cubic_state->alg_state`)\n/// * `K`, `W_max`, `W_last_max`, `W_reno` (`double`) → `f64`\n/// * `rtt_filter` (`picoquic_min_max_rtt_t`) → [`MinMaxRtt`]\npub struct CubicState {\n    pub alg_state: CubicAlgState,\n    pub recovery_sequence: u64,\n    pub start_of_epoch: u64,\n    pub previous_start_of_epoch: u64,\n    pub previous_alg_state: u64,\n    pub previous_ssthresh: u64,\n    pub previous_cwin: u64,\n    pub k: f64,\n    pub w_max: f64,\n    pub w_last_max: f64,\n    pub w_reno: f64,\n    pub ssthresh: u64,\n    pub rtt_filter: MinMaxRtt,\n}\n\nimpl Default for CubicState {\n    fn default() -> Self {\n        Self {\n            alg_state: CubicAlgState::SlowStart,\n            recovery_sequence: 0,\n            start_of_epoch: 0,\n            previous_start_of_epoch: 0,\n            previous_alg_state: 0,\n            previous_ssthresh: u64::MAX,\n            previous_cwin: 0,\n            k: 0.0,\n            w_max: 0.0,\n            w_last_max: 0.0,\n            w_reno: 0.0,\n            ssthresh: u64::MAX,\n            rtt_filter: MinMaxRtt::default(),\n        }\n    }\n}\n\nimpl CubicState {\n    /// C: `cubic_reset` (picoquic/cubic.c:53)\n    ///\n    /// Reset `self` to the initial CUBIC state for `path_x` at `current_time`.\n    /// Mirrors the C body: zero the struct, set `path_x.cwin` to\n    /// [`CWIN_INITIAL`], then populate per-epoch fields.\n    pub fn reset(&mut self, path_x: &mut Path, current_time: u64) {\n        let w_last_max = u64::MAX as f64 / path_x.send_mtu as f64;\n        path_x.cwin = CWIN_INITIAL;\n        *self = Self {\n            alg_state: CubicAlgState::SlowStart,\n            recovery_sequence: 0,\n            start_of_epoch: current_time,\n            previous_start_of_epoch: current_time,\n            previous_alg_state: CubicAlgState::SlowStart as u64,\n            previous_ssthresh: u64::MAX,\n            previous_cwin: CWIN_INITIAL,\n            k: 0.0,\n            w_max: w_last_max,\n            w_last_max,\n            w_reno: CWIN_INITIAL as f64,\n            ssthresh: u64::MAX,\n            rtt_filter: MinMaxRtt::default(),\n        };\n    }\n\n    /// C: `cubic_W_cubic` (picoquic/cubic.c:121)\n    ///\n    /// Compute `W_cubic(t) = C * (t − K)³ + W_max` where `t` is the\n    /// elapsed time in seconds since `start_of_epoch`.  Returns the\n    /// window size in packets (not bytes).\n    ///\n    /// The subtraction `current_time - start_of_epoch` mirrors the\n    /// unsigned C arithmetic; wrapping is intentional for out-of-order\n    /// calls (same as C `uint64_t` semantics).\n    fn w_cubic(&self, current_time: u64) -> f64 {\n        let delta_t_sec =\n            current_time.wrapping_sub(self.start_of_epoch) as f64 / 1_000_000.0 - self.k;\n        CUBIC_C * (delta_t_sec * delta_t_sec * delta_t_sec) + self.w_max\n    }\n\n    /// C: `cubic_enter_avoidance` (picoquic/cubic.c:132)\n    ///\n    /// Compute the CUBIC coefficient `K` and switch to congestion\n    /// avoidance at `current_time`.\n    pub fn enter_avoidance(&mut self, current_time: u64) {\n        self.k = cubic_root(self.w_max * (1.0 - CUBIC_BETA_ECN) / CUBIC_C);\n        self.alg_state = CubicAlgState::CongestionAvoidance;\n        self.start_of_epoch = current_time;\n        self.previous_start_of_epoch = self.start_of_epoch;\n    }\n\n    /// C: `cubic_observe` (picoquic/cubic.c:562)\n    ///\n    /// Report the current algorithm state and `W_max` to an observer.\n    /// Returns `(cc_state, cc_param)` where `cc_state` is the numeric\n    /// discriminant of [`CubicAlgState`] and `cc_param` is `W_max`\n    /// cast to `u64` (matching the C `(uint64_t)cubic_state->W_max`).\n    pub fn observe(&self) -> (u64, u64) {\n        (self.alg_state as u64, self.w_max as u64)\n    }\n\n    /// Convenience wrapper that fills the two out-parameters used by\n    /// the C `cubic_observe` call-site signature\n    /// `(path_x, &mut cc_state, &mut cc_param)`.\n    pub fn observe_into(&self, cc_state: &mut u64, cc_param: &mut u64) {\n        let (s, p) = self.observe();\n        *cc_state = s;\n        *cc_param = p;\n    }\n\n    /// C: `cubic_init` (picoquic/cubic.c:70)\n    ///\n    /// Initialise per-path CUBIC state and store it in\n    /// `path_x.congestion_alg_state`.  Mirrors the C pattern of\n    /// `malloc` + `cubic_reset`; the Rust translation boxes a\n    /// `CubicState` into `Option<Box<dyn Any>>`.\n    pub fn init(path_x: &mut Path, _option_string: Option<&str>, current_time: u64) {\n        let mut state = Box::new(CubicState::default());\n        state.reset(path_x, current_time);\n        path_x.congestion_alg_state = Some(state);\n    }\n\n    /// C: `cubic_enter_recovery` (picoquic/cubic.c:144)\n    ///\n    /// Record the start of a recovery epoch, apply the CUBIC fast-\n    /// convergence rule, compute the new slow-start threshold, and\n    /// either fall back to slow start (if the new threshold is too\n    /// small) or enter congestion avoidance immediately.\n    pub fn enter_recovery(\n        &mut self,\n        connection: &Connection,\n        path_x: &mut Path,\n        notification: CongestionNotification,\n        current_time: u64,\n    ) {\n        self.recovery_sequence = connection.sequence_number(path_x);\n        self.previous_start_of_epoch = self.start_of_epoch;\n        self.previous_alg_state = self.alg_state as u64;\n        self.previous_ssthresh = self.ssthresh;\n        self.previous_cwin = path_x.cwin;\n\n        self.w_max = path_x.cwin as f64 / path_x.send_mtu as f64;\n\n        // Fast convergence.\n        if self.w_max < self.w_last_max {\n            self.w_last_max = self.w_max;\n            self.w_max *= CUBIC_BETA_ECN;\n        } else {\n            self.w_last_max = self.w_max;\n        }\n\n        self.ssthresh = (self.w_max * CUBIC_BETA_ECN * path_x.send_mtu as f64) as u64;\n\n        if self.ssthresh < CWIN_MINIMUM {\n            // Things are very bad — fall back to slow start.\n            self.alg_state = CubicAlgState::SlowStart;\n            self.ssthresh = u64::MAX;\n            path_x.is_ssthresh_initialized = false;\n            self.previous_start_of_epoch = self.start_of_epoch;\n            self.start_of_epoch = current_time;\n            self.w_reno = CWIN_MINIMUM as f64;\n            path_x.cwin = CWIN_MINIMUM;\n        } else if notification == CongestionNotification::Timeout {\n            path_x.cwin = CWIN_MINIMUM;\n            self.previous_start_of_epoch = self.start_of_epoch;\n            self.start_of_epoch = current_time;\n            self.alg_state = CubicAlgState::SlowStart;\n        } else {\n            // Enter congestion avoidance immediately.\n            self.enter_avoidance(current_time);\n            let w_cubic = self.w_cubic(current_time);\n            let win_cubic = (w_cubic * path_x.send_mtu as f64) as u64;\n            self.w_reno = path_x.cwin as f64 / 2.0;\n            // See comment in cubic.c:195-200: w_cubic >= w_reno holds for\n            // CUBIC_BETA_ECN > 0.618, so we pick win_cubic unconditionally.\n            path_x.cwin = win_cubic;\n        }\n    }\n\n    /// C: `cubic_correct_spurious` (picoquic/cubic.c:214)\n    ///\n    /// Undo the most-recent recovery step when the triggering loss\n    /// turns out to have been spurious.\n    pub fn correct_spurious(&mut self, path_x: &mut Path, current_time: u64) {\n        if self.ssthresh != u64::MAX {\n            self.w_max = self.w_last_max;\n            self.start_of_epoch = self.previous_start_of_epoch;\n            self.alg_state = match self.previous_alg_state {\n                0 => CubicAlgState::SlowStart,\n                1 => CubicAlgState::Recovery,\n                _ => CubicAlgState::CongestionAvoidance,\n            };\n            if self.alg_state != CubicAlgState::SlowStart {\n                self.enter_avoidance(self.previous_start_of_epoch);\n                let w_cubic = self.w_cubic(current_time);\n                self.w_reno = w_cubic * path_x.send_mtu as f64;\n                self.ssthresh = (self.w_max * CUBIC_BETA * path_x.send_mtu as f64) as u64;\n                path_x.cwin = self.w_reno as u64;\n            } else {\n                self.ssthresh = self.previous_ssthresh;\n                path_x.cwin = self.previous_cwin;\n                self.w_reno = self.previous_cwin as f64;\n            }\n        }\n    }\n\n    /// C: `cubic_notify` (picoquic/cubic.c:243)\n    ///\n    /// Main congestion-control event handler.  Called by the QUIC engine\n    /// on every ACK, loss, ECN, RTT-measurement, and reset event.\n    pub fn notify(\n        &mut self,\n        connection: &mut Connection,\n        path_x: &mut Path,\n        notification: CongestionNotification,\n        ack_state: &PerAckState,\n        current_time: u64,\n    ) {\n        use crate::Instant;\n\n        path_x.is_cc_data_updated = true;\n\n        match notification {\n            CongestionNotification::Acknowledgement => match self.alg_state {\n                CubicAlgState::SlowStart => {\n                    path_x.cwin = path_x.update_target_cwin_estimation();\n                    if path_x.last_time_acked_data_frame_sent > path_x.last_sender_limited_time {\n                        path_x.cwin +=\n                            path_x.slow_start_increase_ex(ack_state.nb_bytes_acknowledged, false);\n                        if path_x.cwin >= self.ssthresh {\n                            self.w_reno = path_x.cwin as f64 / 2.0;\n                            path_x.is_ssthresh_initialized = true;\n                            self.enter_avoidance(current_time);\n                        }\n                    }\n                }\n                CubicAlgState::Recovery => {\n                    self.alg_state = CubicAlgState::SlowStart;\n                    path_x.cwin += ack_state.nb_bytes_acknowledged;\n                    if path_x.cwin >= self.ssthresh {\n                        self.alg_state = CubicAlgState::CongestionAvoidance;\n                    }\n                }\n                CubicAlgState::CongestionAvoidance => {\n                    if path_x.last_time_acked_data_frame_sent > path_x.last_sender_limited_time {\n                        // Protect against limited senders.\n                        if self.start_of_epoch < path_x.last_sender_limited_time.ticks() {\n                            self.start_of_epoch = path_x.last_sender_limited_time.ticks();\n                        }\n                        let w_cubic = self.w_cubic(current_time);\n                        let win_cubic = (w_cubic * path_x.send_mtu as f64) as u64;\n                        self.w_reno += ack_state.nb_bytes_acknowledged as f64\n                            * path_x.send_mtu as f64\n                            / self.w_reno;\n                        if win_cubic as f64 > self.w_reno {\n                            path_x.cwin = win_cubic;\n                        } else {\n                            path_x.cwin = self.w_reno as u64;\n                        }\n                    }\n                }\n            },\n\n            CongestionNotification::Repeat\n            | CongestionNotification::Timeout\n            | CongestionNotification::EcnEc => match self.alg_state {\n                CubicAlgState::SlowStart => {\n                    if (notification == CongestionNotification::EcnEc\n                        || self.rtt_filter.hystart_loss_test(\n                            notification,\n                            ack_state.lost_packet_number,\n                            SMOOTHED_LOSS_THRESHOLD,\n                        ))\n                        && (current_time.wrapping_sub(self.start_of_epoch)\n                            > path_x.smoothed_rtt.ticks()\n                            || self.recovery_sequence <= connection.ack_number(path_x))\n                    {\n                        path_x.is_ssthresh_initialized = true;\n                        self.enter_recovery(connection, path_x, notification, current_time);\n                    }\n                }\n                CubicAlgState::Recovery | CubicAlgState::CongestionAvoidance => {\n                    if ack_state.lost_packet_number >= self.recovery_sequence\n                        && (notification == CongestionNotification::EcnEc\n                            || self.rtt_filter.hystart_loss_test(\n                                notification,\n                                ack_state.lost_packet_number,\n                                SMOOTHED_LOSS_THRESHOLD,\n                            ))\n                    {\n                        self.enter_recovery(connection, path_x, notification, current_time);\n                    }\n                }\n            },\n\n            CongestionNotification::SpuriousRepeat => {\n                self.correct_spurious(path_x, current_time);\n            }\n\n            CongestionNotification::RttMeasurement => {\n                if self.alg_state == CubicAlgState::SlowStart && self.ssthresh == u64::MAX {\n                    let rtt_meas = if connection.is_time_stamp_enabled {\n                        ack_state.one_way_delay\n                    } else {\n                        ack_state.rtt_measurement\n                    };\n                    let ptime = Instant::from_ticks(\n                        connection\n                            .paths\n                            .first()\n                            .map_or(0, |p| p.pacing.packet_time_microsec.ticks()),\n                    );\n                    if self.rtt_filter.hystart_test(\n                        rtt_meas,\n                        ptime,\n                        Instant::from_ticks(current_time),\n                        connection.is_time_stamp_enabled,\n                    ) {\n                        let rtt_min = self.rtt_filter.rtt_filtered_min;\n                        let target_reno = crate::internal::TARGET_RENO_RTT;\n                        let target_sat = crate::internal::TARGET_SATELLITE_RTT;\n\n                        if rtt_min > target_reno {\n                            let correction = if rtt_min > target_sat {\n                                target_sat.ticks() as f64 / rtt_min.ticks() as f64\n                            } else {\n                                target_reno.ticks() as f64 / rtt_min.ticks() as f64\n                            };\n                            let base_window = (correction * path_x.cwin as f64) as u64;\n                            let delta_window = path_x.cwin - base_window;\n                            path_x.cwin -= delta_window / 2;\n                        } else {\n                            path_x.cwin /= 2;\n                        }\n\n                        self.ssthresh = path_x.cwin;\n                        self.w_max = path_x.cwin as f64 / path_x.send_mtu as f64;\n                        self.w_last_max = self.w_max;\n                        self.w_reno = path_x.cwin as f64;\n                        path_x.is_ssthresh_initialized = true;\n\n                        self.enter_recovery(connection, path_x, notification, current_time);\n\n                        // Adjust epoch so we enter the test phase immediately.\n                        let k_micro = (self.k * 1_000_000.0) as u64;\n                        if k_micro > current_time {\n                            self.k = current_time as f64 / 1_000_000.0;\n                            self.start_of_epoch = 0;\n                        } else {\n                            self.start_of_epoch = current_time - k_micro;\n                        }\n                    }\n                }\n            }\n\n            CongestionNotification::SeedCwin => {\n                if self.alg_state == CubicAlgState::SlowStart && self.ssthresh == u64::MAX {\n                    if path_x.cwin < ack_state.nb_bytes_acknowledged {\n                        path_x.cwin = ack_state.nb_bytes_acknowledged;\n                    }\n                    self.ssthresh = ack_state.nb_bytes_acknowledged;\n                    self.w_max = path_x.cwin as f64 / path_x.send_mtu as f64;\n                    self.w_last_max = self.w_max;\n                    self.w_reno = path_x.cwin as f64;\n                    path_x.is_ssthresh_initialized = true;\n                    self.enter_avoidance(current_time);\n                }\n            }\n\n            CongestionNotification::Reset => {\n                self.reset(path_x, current_time);\n            }\n\n            _ => {}\n        }\n\n        // Update pacing data.\n        let in_slow_start = self.alg_state == CubicAlgState::SlowStart && self.ssthresh == u64::MAX;\n        path_x.update_pacing_data(in_slow_start as i32);\n    }\n}\n\n// ---------------------------------------------------------------------------\n\n/// C: `cubic_root` (picoquic/cubic.c:83)\n///\n/// Newton-Raphson cube-root approximation using bit-shift bracketing\n/// followed by three Newton steps.  Input `x` is the CUBIC `W_max *\n/// (1 − β) / C` value; result is `K`, the time-to-reach-W_max.\nfn cubic_root(x: f64) -> f64 {\n    let mut v: f64 = 1.0;\n    let mut y: f64 = 1.0;\n\n    while v > x * 8.0 {\n        v /= 8.0;\n        y /= 2.0;\n    }\n    while v < x {\n        v *= 8.0;\n        y *= 2.0;\n    }\n    for _ in 0..3 {\n        let y2 = y * y;\n        let y3 = y2 * y;\n        y += (x - y3) / (3.0 * y2);\n    }\n    y\n}\n\n#[cfg(test)]\nmod tests {\n    use super::*;\n\n    #[test]\n    fn w_cubic_at_epoch_start() {\n        let state = CubicState {\n            start_of_epoch: 1_000_000,\n            k: 0.0,\n            w_max: 10.0,\n            ..Default::default()\n        };\n        // At t = start_of_epoch: delta_t_sec = 0 - 0 = 0; W_cubic = 0 + W_max\n        let w = state.w_cubic(1_000_000);\n        assert!((w - 10.0).abs() < 1e-10);\n    }\n\n    #[test]\n    fn w_cubic_positive_t() {\n        let state = CubicState {\n            start_of_epoch: 0,\n            k: 0.0,\n            w_max: 0.0,\n            ..Default::default()\n        };\n        // delta_t_sec = 1.0; W_cubic = 0.4 * 1^3 + 0 = 0.4\n        let w = state.w_cubic(1_000_000);\n        assert!((w - 0.4).abs() < 1e-10);\n    }\n\n    #[test]\n    fn observe_returns_state_and_w_max() {\n        let state = CubicState {\n            alg_state: CubicAlgState::CongestionAvoidance,\n            w_max: 42.7,\n            ..Default::default()\n        };\n        let (cc_state, cc_param) = state.observe();\n        assert_eq!(cc_state, CubicAlgState::CongestionAvoidance as u64);\n        assert_eq!(cc_param, 42); // truncated cast, same as C (uint64_t)42.7 = 42\n    }\n\n    #[test]\n    fn cubic_root_cube() {\n        // cubic_root(8) ≈ 2.0\n        let r = cubic_root(8.0);\n        assert!((r - 2.0).abs() < 1e-6);\n    }\n}\n","numLines":496,"startLine":1,"totalLines":496}}}
