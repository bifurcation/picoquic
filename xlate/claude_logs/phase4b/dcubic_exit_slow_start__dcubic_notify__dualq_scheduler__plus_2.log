{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_0185oUR3GHuZv395tdFrVfXX","type":"tool_result","content":"230\t}\n231\t\n232\t// ---------------------------------------------------------------------------\n233\t// Test entries.\n234\t\n235\t/// Create an ECH config from the test public key, save it, and verify it\n236\t/// matches the reference file.\n237\t/// C: `ech_config_test` in `picoquictest/ech_test.c`.\n238\t#[test]\n239\tfn ech_config() {\n240\t    tls_api_init();\n241\t    let config = ech_create_config_from_public_key(TEST_ECH_PUB_KEY, ECH_PUBLIC_NAME)\n242\t        .expect(\"create ECH config from public key\");\n243\t    ech_save_config(&config, ECH_CONFIG_FILE).expect(\"save ECH config\");\n244\t    ech_test_check_buf(&config, TEST_ECH_CONFIG_REF).expect(\"config matches reference\");\n245\t}\n246\t\n247\t/// Create an ECH config from the test private key, save it, and verify it\n248\t/// matches the reference file.\n249\t/// C: `ech_config_p_test` in `picoquictest/ech_test.c`.\n250\t#[test]\n251\tfn ech_config_p() {\n252\t    tls_api_init();\n253\t    let config = ech_create_config_from_private_key(TEST_ECH_PRIVATE_KEY, ECH_PUBLIC_NAME)\n254\t        .expect(\"create ECH config from private key\");\n255\t    ech_save_config(&config, ECH_CONFIG_FILE).expect(\"save ECH config\");\n256\t    ech_test_check_buf(&config, TEST_ECH_CONFIG_REF).expect(\"config matches reference\");\n257\t}\n258\t\n259\t/// Verify a full ECH handshake succeeds.\n260\t/// C: `ech_e2e_test` in `picoquictest/ech_test.c`.\n261\t#[test]\n262\tfn ech_e2e() {\n263\t    let spec = EchE2eSpec {\n264\t        expect_success: true,\n265\t        ..Default::default()\n266\t    };\n267\t    ech_e2e_test_one(&spec);\n268\t}\n269\t"}]},"parent_tool_use_id":null,"session_id":"0935a79a-3385-490e-8044-a2b7bb8dca0a","uuid":"631b3772-d2e0-4d60-b2a4-645b646842ba","timestamp":"2026-05-07T14:29:25.499Z","tool_use_result":{"type":"text","file":{"filePath":"/Users/richbarn/Proj