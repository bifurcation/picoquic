{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01QwqR9eiPtusFRK88aZVfYY","type":"tool_result","content":"1\t//! Test cases for `picoquictest/congestion_test.c`.\n2\t//!\n3\t//! Exercises the network simulator with multiple congestion-control algorithms\n4\t//! (Cubic, C4, FastCC, BBR, BBR1, NewReno, dCubic) across a variety of link\n5\t//! configurations: symmetric/asymmetric paths, jitter, slow long-haul links,\n6\t//! a 2-second blackhole window, app-limited flows, and a CWIN-max cap.\n7\t//!\n8\t//! Helper functions mirror the C static helpers directly; every `#[test]`\n9\t//! entry is a thin wrapper that selects parameters and delegates.\n10\t\n11\t#![allow(non_snake_case)]\n12\t\n13\tuse super::util::{\n14\t    TestApiStreamDesc, check_bytes_in_flight, save_empty_tickets, test_api_init_send_recv_scenario,\n15\t    tls_api_data_sending_loop, tls_api_init_ctx_ex, tls_api_one_scenario_body,\n16\t    tls_api_one_scenario_body_connect, tls_api_one_scenario_body_verify,\n17\t    tls_api_one_scenario_init_ex,\n18\t};\n19\tuse crate::internal::{Version, init_transport_parameters};\n20\tuse crate::tp::TransportParameters;\n21\tuse crate::{CongestionAlgorithm, ConnectionId, Duration, Instant, get_congestion_algorithm};\n22\t\n23\t// ---------------------------------------------------------------------------\n24\t// Shared stream scenarios.  C: file-scope statics in congestion_test.c.\n25\t\n26\t/// Four sequential 1 MB streams.  C: `test_scenario_congestion[]`.\n27\tconst TEST_SCENARIO_CONGESTION: &[TestApiStreamDesc] = &[\n28\t    TestApiStreamDesc {\n29\t        stream_id: 4,\n30\t        previous_stream_id: 0,"}]},"parent_tool_use_id":null,"session_id":"0935a79a-3385-490e-8044-a2b7bb8dca0a","uuid":"60dfa30b-9891-4ad2-a3bb-fc1ebd604690","timestamp":"2026-05-07T14:28:38.315Z","tool_use_result":{"type":"text","file":{"filePath":"/Users/richbarn/Projects/picoquic/rs/fq/src/tests/congestion.rs","content":"//! Test cases for `picoquictest/congestio