{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01Xdd8Ef5ZLKDbAGjiUNezh5","type":"tool_result","content":"1\t//! Numeric error codes used over the QUIC wire and inside picoquic.\n2\t//!\n3\t//! Two distinct ranges:\n4\t//!\n5\t//! * [`InternalError`] — picoquic-private codes allocated in the\n6\t//!   `0x400`+ range so they never collide with QUIC transport or\n7\t//!   TLS alert codes.  Surface inside the library; never put on the\n8\t//!   wire.\n9\t//! * [`TransportError`] — QUIC transport / TLS-alert codes from\n10\t//!   RFC 9000 §20 (and various drafts).  These cross the wire in\n11\t//!   CONNECTION_CLOSE frames.\n12\t//!\n13\t//! The `crate::Error` enum (defined in `lib.rs`) is the richer Rust\n14\t//! error surface used by fallible APIs; these enums provide the\n15\t//! numeric on-wire / on-log codes those errors map to.\n16\t\n17\t// ---------------------------------------------------------------------------\n18\t// Picoquic-internal errors.\n19\t\n20\t/// Base offset for picoquic's internal error codes.  Allocated in\n21\t/// the `0x400`+ range so they never collide with QUIC transport or\n22\t/// TLS alert codes.\n23\tpub const ERROR_CLASS: u64 = 0x400;\n24\t\n25\t/// Picoquic-internal error code.  Numeric values follow C source.\n26\t#[derive(Debug, Copy, Clone, PartialEq, Eq)]\n27\t#[repr(u64)]\n28\tpub enum InternalError {\n29\t    Duplicate = ERROR_CLASS + 1,\n30\t    AeadCheck = ERROR_CLASS + 3,\n31\t    UnexpectedPacket = ERROR_CLASS + 4,\n32\t    Memory = ERROR_CLASS + 5,\n33\t    CnxidCheck = ERROR_CLASS + 7,\n34\t    InitialTooShort = ERROR_CLASS + 8,\n35\t    VersionNegotiationSpoofed = ERROR_CLASS + 9,\n36\t    MalformedTransportExtension = ERROR_CLASS + 10,\n37\t    ExtensionBufferTooSmall = ERROR_CLASS + 11,\n38\t    IllegalTransportExtension = ERROR_CLASS + 12,\n39\t    CannotResetStreamZero = ERROR_CLASS + 13,\n40\t    InvalidStreamId = ERROR_CLASS + 14,\n41\t    StreamAlreadyClosed = ERROR_CLASS + 15,\n42\t    FrameBufferTooSmall = ERROR_CLASS + 16,\n43\t    InvalidFrame = ERROR_CLASS + 17,\n44\t    CannotControlStreamZero = ERROR_CLASS + 18,\n45\t    Retry = ERROR_CLASS + 19,\n46\t    Disconnected = ERROR_CLASS + 20,\n47\t    Detected = ERROR_CLASS + 21,\n48\t    InvalidTicket = ERROR_CLASS + 23,\n49\t    InvalidFile = ERROR_CLASS + 24,\n50\t    SendBufferTooSmall = ERROR_CLASS + 25,\n51\t    UnexpectedState = ERROR_CLASS + 26,\n52\t    UnexpectedError = ERROR_CLASS + 27,\n53\t    TlsServerConWithoutCert = ERROR_CLASS + 28,\n54\t    NoSuchFile = ERROR_CLASS + 29,\n55\t    StatelessReset = ERROR_CLASS + 30,\n56\t    ConnectionDeleted = ERROR_CLASS + 31,\n57\t    CnxidSegment = ERROR_CLASS + 32,\n58\t    CnxidNotAvailable = ERROR_CLASS + 33,\n59\t    MigrationDisabled = ERROR_CLASS + 34,\n60\t    CannotComputeKey = ERROR_CLASS + 35,"}]},"parent_tool_use_id":null,"session_id":"0935a79a-3385-490e-8044-a2b7bb8dca0a","uuid":"f3348480-1873-4f48-811a-bef4131a7313","timestamp":"2026-05-07T14:25:02.695Z","tool_use_result":{"type":"text","file":{"filePath":"/Users/richbarn/Projects/picoquic/rs/fq/src/errors.rs","content":"//! Numeric error codes used over the QUIC wire and inside picoquic.\n//!\n//! Two distinct ranges:\n//!\n//! * [`InternalError`] — picoquic-private codes allocated in the\n//!   `0x400`+ range so they never collide with QUIC transport or\n//!   TLS alert codes.  Surface inside the library; never put on the\n//!   wire.\n//! * [`TransportError`] — QUIC transport / TLS-alert codes from\n//!   RFC 9000 §20 (and various drafts).  These cross the wire in\n//!   CONNECTION_CLOSE frames.\n//!\n//! The `crate::Error` enum (defined in `lib.rs`) is the richer Rust\n//! error surface used by fallible APIs; these enums provide the\n//! numeric on-wire / on-log codes those errors map to.\n\n// ---------------------------------------------------------------------------\n// Picoquic-internal errors.\n\n/// Base offset for picoquic's internal error codes.  Allocated in\n/// the `0x400`+ range so they never collide with QUIC transport or\n/// TLS alert codes.\npub const ERROR_CLASS: u64 = 0x400;\n\n/// Picoquic-internal error code.  Numeric values follow C source.\n#[derive(Debug, Copy, Clone, PartialEq, Eq)]\n#[repr(u64)]\npub enum InternalError {\n    Duplicate = ERROR_CLASS + 1,\n    AeadCheck = ERROR_CLASS + 3,\n    UnexpectedPacket = ERROR_CLASS + 4,\n    Memory = ERROR_CLASS + 5,\n    CnxidCheck = ERROR_CLASS + 7,\n    InitialTooShort = ERROR_CLASS + 8,\n    VersionNegotiationSpoofed = ERROR_CLASS + 9,\n    MalformedTransportExtension = ERROR_CLASS + 10,\n    ExtensionBufferTooSmall = ERROR_CLASS + 11,\n    IllegalTransportExtension = ERROR_CLASS + 12,\n    CannotResetStreamZero = ERROR_CLASS + 13,\n    InvalidStreamId = ERROR_CLASS + 14,\n    StreamAlreadyClosed = ERROR_CLASS + 15,\n    FrameBufferTooSmall = ERROR_CLASS + 16,\n    InvalidFrame = ERROR_CLASS + 17,\n    CannotControlStreamZero = ERROR_CLASS + 18,\n    Retry = ERROR_CLASS + 19,\n    Disconnected = ERROR_CLASS + 20,\n    Detected = ERROR_CLASS + 21,\n    InvalidTicket = ERROR_CLASS + 23,\n    InvalidFile = ERROR_CLASS + 24,\n    SendBufferTooSmall = ERROR_CLASS + 25,\n    UnexpectedState = ERROR_CLASS + 26,\n    UnexpectedError = ERROR_CLASS + 27,\n    TlsServerConWithoutCert = ERROR_CLASS + 28,\n    NoSuchFile = ERROR_CLASS + 29,\n    StatelessReset = ERROR_CLASS + 30,\n    ConnectionDeleted = ERROR_CLASS + 31,\n    CnxidSegment = ERROR_CLASS + 32,\n    CnxidNotAvailable = ERROR_CLASS + 33,\n    MigrationDisabled = ERROR_CLASS + 34,\n    CannotComputeKey = ERROR_CLASS + 35,","numLines":60,"startLine":1,"totalLines":253}}}
