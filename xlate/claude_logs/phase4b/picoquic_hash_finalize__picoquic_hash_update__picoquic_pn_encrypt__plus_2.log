{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01HX9LNFtiPVH4DS45gpbGT5","type":"tool_result","content":"640\t}\n641\t\n642\t// ---------------------------------------------------------------------------\n643\t// Master TLS context.\n644\t//\n645\t// In Phase 2 the C `*mut c_void tls_master_ctx` is replaced by\n646\t// `Quic.tls_client_config` / `tls_server_config` (boxed\n647\t// `DynClientConfig` / `DynServerConfig` trait objects defined in\n648\t// [`crate::tls`]).  Both lifecycle entry points install or\n649\t// release state on the QUIC context itself.\n650\t\n651\timpl Quic {\n652\t    /// Initialize this context's master TLS context.  Loads the\n653\t    /// certificate chain, the private key, the trusted-root bundle\n654\t    /// and the ticket-encryption key.  Any of the file-name / key\n655\t    /// parameters may be `NULL` in C (server-only, no roots, no\n656\t    /// ticket key); Rust models that with `Option<&str>` /\n657\t    /// `Option<&[u8]>`.  C: `master_tlscontext`.\n658\t    pub fn init_master_tls_context(\n659\t        &mut self,\n660\t        cert_file_name: Option<&str>,\n661\t        key_file_name: Option<&str>,\n662\t        cert_root_file_name: Option<&str>,\n663\t        ticket_key: Option<&[u8]>,\n664\t    ) -> Result<(), Error> {\n665\t        match (cert_file_name, key_file_name) {\n666\t            (Some(cert), Some(key)) => {\n667\t                get_certs_from_file(cert).ok_or(Error::InvalidFile)?;\n668\t                self.set_private_key_from_file(key)?;\n669\t            }\n670\t            (None, None) => {}\n671\t            _ => return Err(Error::InvalidArgument),\n672\t        }\n673\t\n674\t        if let Some(root) = cert_root_file_name {\n675\t            self.is_cert_store_not_empty = get_certs_from_file(root).is_some();\n676\t            if !self.is_cert_store_not_empty {\n677\t                return Err(Error::InvalidFile);\n678\t            }\n679\t        }\n680\t\n681\t        install_ticket_aead_contexts(self, ticket_key)\n682\t    }\n683\t\n684\t    /// Tear down the master TLS context installed by\n685\t    /// [`Quic::init_master_tls_context`].  C:\n686\t    /// `master_tlscontext_free`.\n687\t    pub fn free_master_tls_context(&mut self) {\n688\t        self.tls_client_config = None;\n689\t        self.tls_server_config = None;\n690\t    }\n691\t}\n692\t\n693\t// ---------------------------------------------------------------------------\n694\t// Per-connection TLS context.\n695\t//\n696\t// `tls_ctx_t` itself lives in `crypto_provider_api.rs`; this module\n697\t// just exposes the API surface that quic-core uses to drive it.\n698\t\n699\timpl Connection {\n700\t    /// Allocate a per-connection TLS context, attach it to this\n701\t    /// connection, and initialize the tls handshake-property slots.\n702\t    /// C: `tlscontext_create`.  C side returns 0 on success,\n703\t    /// `ERROR_TLS_SERVER_CON_WITHOUT_CERT` / `ERROR_MEMORY` / -1 on\n704\t    /// failure.\n705\t    pub fn create_tls_context(&mut self, quic: &mut Quic) -> Result<(), Error> {\n706\t        let version = connection_version(self);\n707\t        let transport_params = Vec::new();\n708\t        let session: Box<dyn crate::tls::Session> = if self.client_mode {\n709\t            if let Some(config) = quic.tls_client_config.as_ref() {\n710\t                let sni = self.sni.as_deref().unwrap_or(\"\");\n711\t                config\n712\t                    .start_session(version as u32, sni, &transport_params)\n713\t                    .map_err(|_| Error::Tls)?\n714\t            } else {\n715\t                Box::new(LocalSession::new(\n716\t                    true,\n717\t                    version.parameters().tls_prefix_label,\n718\t                ))\n719\t            }\n720\t        } else if let Some(config) = quic.tls_server_config.as_ref() {\n721\t            config\n722\t                .start_session(version as u32, &transport_params)\n723\t                .map_err(|_| Error::Tls)?\n724\t        } else {\n725\t            if quic.enforce_client_only {\n726\t                return Err(Error::Protocol(\n727\t                    InternalError::TlsServerConWithoutCert as u64,\n728\t                ));\n729\t            }\n730\t            Box::new(LocalSession::new(\n731\t                false,\n732\t                version.parameters().tls_prefix_label,\n733\t            ))\n734\t        };\n735\t\n736\t        self.tls_ctx = Some(session);\n737\t        self.tls_sendbuf.clear();\n738\t        self.app_secret_len = SHA256_SIZE;\n739\t        Ok(())"}]},"parent_tool_use_id":null,"session_id":"d295fe5c-73e0-4b20-9131-8117f7409d00","uuid":"12174775-321e-40fa-8ee6-48b670cd2afe","timestamp":"2026-05-07T09:54:51.942Z","tool_use_result":{"type":"text","file":{"filePath":"/Users/richbarn/Projects/picoquic/rs/fq/src/tls_api.rs","content":"}\n\n// ---------------------------------------------------------------------------\n// Master TLS context.\n//\n// In Phase 2 the C `*mut c_void tls_master_ctx` is replaced by\n// `Quic.tls_client_config` / `tls_server_config` (boxed\n// `DynClientConfig` / `DynServerConfig` trait objects defined in\n// [`crate::tls`]).  Both lifecycle entry points install or\n// release state on the QUIC context itself.\n\nimpl Quic {\n    /// Initialize this context's master TLS context.  Loads the\n    /// certificate chain, the private key, the trusted-root bundle\n    /// and the ticket-encryption key.  Any of the file-name / key\n    /// parameters may be `NULL` in C (server-only, no roots, no\n    /// ticket key); Rust models that with `Option<&str>` /\n    /// `Option<&[u8]>`.  C: `master_tlscontext`.\n    pub fn init_master_tls_context(\n        &mut self,\n        cert_file_name: Option<&str>,\n        key_file_name: Option<&str>,\n        cert_root_file_name: Option<&str>,\n        ticket_key: Option<&[u8]>,\n    ) -> Result<(), Error> {\n        match (cert_file_name, key_file_name) {\n            (Some(cert), Some(key)) => {\n                get_certs_from_file(cert).ok_or(Error::InvalidFile)?;\n                self.set_private_key_from_file(key)?;\n            }\n            (None, None) => {}\n            _ => return Err(Error::InvalidArgument),\n        }\n\n        if let Some(root) = cert_root_file_name {\n            self.is_cert_store_not_empty = get_certs_from_file(root).is_some();\n            if !self.is_cert_store_not_empty {\n                return Err(Error::InvalidFile);\n            }\n        }\n\n        install_ticket_aead_contexts(self, ticket_key)\n    }\n\n    /// Tear down the master TLS context installed by\n    /// [`Quic::init_master_tls_context`].  C:\n    /// `master_tlscontext_free`.\n    pub fn free_master_tls_context(&mut self) {\n        self.tls_client_config = None;\n        self.tls_server_config = None;\n    }\n}\n\n// ---------------------------------------------------------------------------\n// Per-connection TLS context.\n//\n// `tls_ctx_t` itself lives in `crypto_provider_api.rs`; this module\n// just exposes the API surface that quic-core uses to drive it.\n\nimpl Connection {\n    /// Allocate a per-connection TLS context, attach it to this\n    /// connection, and initialize the tls handshake-property slots.\n    /// C: `tlscontext_create`.  C side returns 0 on success,\n    /// `ERROR_TLS_SERVER_CON_WITHOUT_CERT` / `ERROR_MEMORY` / -1 on\n    /// failure.\n    pub fn create_tls_context(&mut self, quic: &mut Quic) -> Result<(), Error> {\n        let version = connection_version(self);\n        let transport_params = Vec::new();\n        let session: Box<dyn crate::tls::Session> = if self.client_mode {\n            if let Some(config) = quic.tls_client_config.as_ref() {\n                let sni = self.sni.as_deref().unwrap_or(\"\");\n                config\n                    .start_session(version as u32, sni, &transport_params)\n                    .map_err(|_| Error::Tls)?\n            } else {\n                Box::new(LocalSession::new(\n                    true,\n                    version.parameters().tls_prefix_label,\n                ))\n            }\n        } else if let Some(config) = quic.tls_server_config.as_ref() {\n            config\n                .start_session(version as u32, &transport_params)\n                .map_err(|_| Error::Tls)?\n        } else {\n            if quic.enforce_client_only {\n                return Err(Error::Protocol(\n                    InternalError::TlsServerConWithoutCert as u64,\n                ));\n            }\n            Box::new(LocalSession::new(\n                false,\n                version.parameters().tls_prefix_label,\n            ))\n        };\n\n        self.tls_ctx = Some(session);\n        self.tls_sendbuf.clear();\n        self.app_secret_len = SHA256_SIZE;\n        Ok(())","numLines":100,"startLine":640,"totalLines":1949}}}
