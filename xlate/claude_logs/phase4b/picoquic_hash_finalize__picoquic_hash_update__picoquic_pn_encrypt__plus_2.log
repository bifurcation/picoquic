{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01UzjQtrNMiV3YVLKAAzdKkV","type":"tool_result","content":"100\t    /// secret.  Used by QUIC for stateless-reset tokens etc.\n101\t    fn export_keying_material(\n102\t        &self,\n103\t        label: &[u8],\n104\t        context: &[u8],\n105\t        output: &mut [u8],\n106\t    ) -> Result<(), Error>;\n107\t\n108\t    /// Returns `true` when the TLS handshake used ECH.\n109\t    ///\n110\t    /// C: `ptls_is_ech_handshake(tls_ctx->tls, NULL, NULL, NULL)`\n111\t    fn is_ech_handshake(&self) -> bool {\n112\t        false\n113\t    }\n114\t\n115\t    /// ECH retry-config bytes the server sent back.  Empty when none.\n116\t    ///\n117\t    /// C: `tls_ctx->retry_configs.{base,len}` (`picoquic_ech_get_retry_config`)\n118\t    fn retry_configs(&self) -> &[u8] {\n119\t        &[]\n120\t    }\n121\t}\n122\t\n123\t// ---------------------------------------------------------------------------\n124\t// Builder traits for client / server sessions.\n125\t\n126\t/// Builder for client-side sessions.  Each backend exposes one\n127\t/// concrete `ClientConfig` type; the application constructs it\n128\t/// with backend-specific options (cert store, ALPN list, etc.)\n129\t/// and then calls [`ClientConfig::start_session`] per outgoing\n130\t/// connection.\n131\tpub trait ClientConfig {\n132\t    type Session: Session;\n133\t\n134\t    /// Start a fresh client-side TLS session.\n135\t    ///\n136\t    /// * `version` — QUIC wire version (passed to TLS as the\n137\t    ///   transport-parameter version field).\n138\t    /// * `server_name` — SNI value.\n139\t    /// * `transport_params` — already-encoded transport-parameters\n140\t    ///   blob to ship in the TLS extension.\n141\t    fn start_session(\n142\t        &self,\n143\t        version: u32,\n144\t        server_name: &str,\n145\t        transport_params: &[u8],\n146\t    ) -> Result<Self::Session, ConfigError>;\n147\t}\n148\t\n149\t/// Builder for server-side sessions.\n150\tpub trait ServerConfig {\n151\t    type Session: Session;\n152\t\n153\t    fn start_session(\n154\t        &self,\n155\t        version: u32,\n156\t        transport_params: &[u8],\n157\t    ) -> Result<Self::Session, ConfigError>;\n158\t}\n159\t\n160\t/// Top-level backend trait.  Each backend (picotls, rustls,\n161\t/// OpenSSL) implements this once at the crate level.\n162\t///\n163\t/// In v1 `Quic` holds boxed [`DynClientConfig`] /\n164\t/// [`DynServerConfig`] trait objects (so a single binary can carry\n165\t/// multiple backends and pick at runtime).  An ergonomic generic\n166\t/// wrapper (`Quic<T: TlsBackend>`) for compile-time-only selection\n167\t/// is a candidate Phase-4 follow-up.\n168\tpub trait TlsBackend {\n169\t    type Client: ClientConfig;\n170\t    type Server: ServerConfig;\n171\t}\n172\t\n173\t// ---------------------------------------------------------------------------\n174\t// Dyn-compatible wrappers around `ClientConfig` / `ServerConfig`.\n175\t//\n176\t// `ClientConfig::start_session` returns `Self::Session`, which makes\n177\t// the trait itself non-dyn-compatible.  The `Dyn*Config` wrappers\n178\t// re-export the same operation but Box the returned session so the\n179\t// caller doesn't need to know the concrete `Self::Session` type.\n180\t// Blanket impls plumb every `ClientConfig` / `ServerConfig` through\n181\t// to these.\n182\t\n183\t/// Dyn-compatible mirror of [`ClientConfig`].\n184\tpub trait DynClientConfig: Send {\n185\t    /// Start a fresh client-side TLS session, boxing the result.\n186\t    fn start_session(\n187\t        &self,\n188\t        version: u32,\n189\t        server_name: &str,\n190\t        transport_params: &[u8],\n191\t    ) -> Result<Box<dyn Session>, ConfigError>;\n192\t}\n193\t\n194\timpl<T> DynClientConfig for T\n195\twhere\n196\t    T: ClientConfig + Send,\n197\t    T::Session: 'static,\n198\t{\n199\t    fn start_session(\n200\t        &self,\n201\t        version: u32,\n202\t        server_name: &str,\n203\t        transport_params: &[u8],\n204\t    ) -> Result<Box<dyn Session>, ConfigError> {\n205\t        ClientConfig::start_session(self, version, server_name, transport_params)\n206\t            .map(|s| Box::new(s) as Box<dyn Session>)\n207\t    }\n208\t}\n209\t\n210\t/// Dyn-compatible mirror of [`ServerConfig`].\n211\tpub trait DynServerConfig: Send {\n212\t    fn start_session(\n213\t        &self,\n214\t        version: u32,\n215\t        transport_params: &[u8],\n216\t    ) -> Result<Box<dyn Session>, ConfigError>;\n217\t}\n218\t\n219\timpl<T> DynServerConfig for T\n220\twhere\n221\t    T: ServerConfig + Send,\n222\t    T::Session: 'static,\n223\t{\n224\t    fn start_session(\n225\t        &self,\n226\t        version: u32,\n227\t        transport_params: &[u8],\n228\t    ) -> Result<Box<dyn Session>, ConfigError> {\n229\t        ServerConfig::start_session(self, version, transport_params)\n230\t            .map(|s| Box::new(s) as Box<dyn Session>)\n231\t    }\n232\t}\n233\t\n234\t// ---------------------------------------------------------------------------\n235\t// Packet protection (AEAD layer).\n236\t\n237\t/// One direction of packet protection (client-to-server, or\n238\t/// vice versa).  Hides the AEAD primitive from the rest of\n239\t/// picoquic; backend implementations hold an `aead::AeadInPlace`\n240\t/// from a Rust Crypto crate.\n241\tpub trait PacketKey: Send {\n242\t    /// In-place encrypt: `payload[..]` is the plaintext on\n243\t    /// entry; on success the ciphertext + 16-byte auth tag\n244\t    /// fills `payload`.  `header` is the AAD.  `packet` is the\n245\t    /// QUIC packet sequence number, used to derive the AEAD\n246\t    /// nonce.\n247\t    fn encrypt(&self, packet: u64, header: &[u8], payload: &mut Vec<u8>);\n248\t\n249\t    /// In-place decrypt + tag verify.  Shrinks `payload` by\n250\t    /// the tag length on success.\n251\t    fn decrypt(&self, packet: u64, header: &[u8], payload: &mut Vec<u8