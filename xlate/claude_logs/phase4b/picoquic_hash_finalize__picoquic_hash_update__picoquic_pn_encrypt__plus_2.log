Context\").finish_non_exhaustive()\n1785\t    }\n1786\t}\n1787\t\n1788\timpl Aes128EcbContext {\n1789\t    /// Construct an AES-128-ECB context (encrypt or decrypt) keyed\n1790\t    /// by `ecb_key`.  C: `aes128_ecb_create`.\n1791\t    pub fn new(is_enc: bool, ecb_key: &[u8; 16]) -> Self {\n1792\t        use cipher::KeyInit;\n1793\t        if is_enc {\n1794\t            Aes128EcbContext::Encrypt(\n1795\t                aes::Aes128Enc::new_from_slice(ecb_key).expect(\"key is 16 bytes\"),\n1796\t            )\n1797\t        } else {\n1798\t            Aes128EcbContext::Decrypt(\n1799\t                aes::Aes128Dec::new_from_slice(ecb_key).expect(\"key is 16 bytes\"),\n1800\t            )\n1801\t        }\n1802\t    }\n1803\t\n1804\t    /// Encrypt or decrypt `block` in place.  C:\n1805\t    /// `aes128_ecb_encrypt` (encrypt-mode only — decrypt-mode\n1806\t    /// is exposed through the same method here, since the\n1807\t    /// direction is fixed at construction).\n1808\t    pub fn process(&self, block: &mut [u8; 16]) {\n1809\t        use cipher::{BlockDecrypt, BlockEncrypt};\n1810\t        let mut b = cipher::generic_array::GenericArray::clone_from_slice(block);\n1811\t        match self {\n1812\t            Aes128EcbContext::Encrypt(enc) => enc.encrypt_block(&mut b),\n1813\t            Aes128EcbContext::Decrypt(dec) => dec.decrypt_block(&mut b),\n1814\t        }\n1815\t        block.copy_from_slice(&b);\n1816\t    }\n1817\t}\n1818\t\n1819\t/// Return whether `ecb_cipher_name` names a supported ECB cipher algorithm.\n1820\t/// Mirrors the C search over the cipher-suite table for a matching\n1821\t/// `aead->ecb_cipher->name`; the only ECB cipher in the Rust build is\n1822\t/// `\"AES128-ECB\"` (backed by [`Aes128EcbContext`]).\n1823\t/// C: `picoquic_get_ecb_cipher_by_id`\n1824\tfn get_ecb_cipher_by_name(ecb_cipher_name: &str) -> bool {\n1825\t    ecb_cipher_name == \"AES128-ECB\"\n1826\t}\n1827\t\n1828\t/// Create an AES-128-ECB cipher context for CID encryption, l