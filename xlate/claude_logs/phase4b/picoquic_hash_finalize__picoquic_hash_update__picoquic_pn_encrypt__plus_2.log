{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01Qz5BqjQ6d7yrEX4ZhTdan9","type":"tool_result","content":"1290\t}\n1291\t\n1292\t/// HKDF-Expand-Label (RFC 8446 §7.1) using the QUIC-specific label\n1293\t/// encoding.  The output length is determined by `output.len()`.\n1294\t/// Uses SHA-256 (the hash fixed for QUIC Initial-secret derivation).\n1295\t/// C: `ptls_hkdf_expand_label(cipher->hash, output, output_len,\n1296\t///    ptls_iovec(secret), label, empty_ctx, base_label)`.\n1297\tpub fn hkdf_expand_label(\n1298\t    label: &str,\n1299\t    base_label: &str,\n1300\t    secret: &[u8],\n1301\t    output: &mut [u8],\n1302\t) -> Result<(), crate::Error> {\n1303\t    hkdf_expand_label_sha256(label, base_label, secret, output)\n1304\t}\n1305\t\n1306\t// ---------------------------------------------------------------------------\n1307\t// Reset secret and verify-certificate management.\n1308\t\n1309\timpl Quic {\n1310\t    /// Compute the 16-byte reset secret tied to `connection_id` using this\n1311\t    /// context's reset seed.  C: `create_connection_id_reset_secret`.\n1312\t    pub fn create_connection_id_reset_secret(\n1313\t        &mut self,\n1314\t        cnx_id: &ConnectionId,\n1315\t        reset_secret: &mut [u8; RESET_SECRET_SIZE],\n1316\t    ) -> Result<(), Error> {\n1317\t        use digest::Digest;\n1318\t\n1319\t        let mut serialized = [0u8; crate::CONNECTION_ID_MAX_SIZE + 1];\n1320\t        serialized[..cnx_id.len()].copy_from_slice(cnx_id.as_bytes());\n1321\t        serialized[crate::CONNECTION_ID_MAX_SIZE] = cnx_id.len() as u8;\n1322\t\n1323\t        let mut hasher = sha2::Sha256::new();\n1324\t        hasher.update(self.reset_seed);\n1325\t        hasher.update(serialized);\n1326\t        let digest = hasher.finalize();\n1327\t        reset_secret.copy_from_slice(&digest[..RESET_SECRET_SIZE]);\n1328\t        Ok(())\n1329\t    }\n1330\t\n1331\t    // The C `tls_set_verify_certificate_callback` /\n1332\t    // `dispose_verify_certificate_callback` pair is folded into\n1333\t    // [`crate::tls::TlsCallbacks`] — applications install a single\n1334\t    // callbacks bundle on the QUIC context and override\n1335\t    // `verify_certificate` to plug in their own logic.\n1336\t\n1337\t    /// Toggle whether the server requires client certificates.  C\n1338\t    /// took an `int`; promoted to `bool`.  C:\n1339\t    /// `tls_set_client_authentication`.\n1340\t    pub fn tls_set_client_authentication(&mut self, client_authentication: bool) {\n1341\t        self.client_authentication = client_authentication;\n1342\t    }\n1343\t\n1344\t    /// Report whether client authentication is currently required.\n1345\t    /// C: `tls_client_authentication_activated`.\n1346\t    pub fn tls_client_authentication_activated(&self) -> bool {\n1347\t        self.client_authentication\n1348\t    }\n1349\t\n1350\t    /// Toggle whether tls exposes its exporter API on this master\n1351\t    /// context.  C: `tls_set_use_exporter`.\n1352\t    pub fn tls_set_use_exporter(&mut self, use_exporter: bool) {\n1353\t        self.use_exporter = use_exporter;\n1354\t    }\n1355\t}\n1356\t\n1357\t// ---------------------------------------------------------------------------\n1358\t// Retry tokens.\n1359\t//\n1360\t// `server_decrypt_retry_token`,\n1361\t// `prepare_retry_token`, and\n1362\t// `verify_retry_token` were the three token entry points\n1363\t// declared in this header.  All three take a `struct sockaddr*`\n1364\t// peer address (mapped to [`SocketAddr`]) and produce / consume a\n1365\t// caller-allocated `token` buffer.\n1366\t\n1367\t/// Output bundle from [`server_decrypt_retry_token`].  C\n1368\t/// returned the new-token flag through `int*` and the plaintext\n1369\t/// length through `size_t*`; collapsing them into a struct keeps"}]},"parent_tool_use_id":null,"session_id":"d295fe5c-73e0-4b20-9131-8117f7409d00","uuid":"dddc52e9-cf86-47fe-af39-df931ab61458","timestamp":"2026-05-07T09:54:58.062Z","tool_use_result":{"type":"text","file":{"filePath":"/Users/richbarn/Projects/picoquic/rs/fq/src/tls_api.rs","content":"}\n\n/// HKDF-Expand-Label (RFC 8446 §7.1) using the QUIC-specific label\n/// encoding.  The output length is determined by `output.len()`.\n/// Uses SHA-256 (the hash fixed for QUIC Initial-secret derivation).\n/// C: `ptls_hkdf_expand_label(cipher->hash, output, output_len,\n///    ptls_iovec(secret), label, empty_ctx, base_label)`.\npub fn hkdf_expand_label(\n    label: &str,\n    base_label: &str,\n    secret: &[u8],\n    output: &mut [u8],\n) -> Result<(), crate::Error> {\n    hkdf_expand_label_sha256(label, base_label, secret, output)\n}\n\n// ---------------------------------------------------------------------------\n// Reset secret and verify-certificate management.\n\nimpl Quic {\n    /// Compute the 16-byte reset secret tied to `connection_id` using this\n    /// context's reset seed.  C: `create_connection_id_reset_secret`.\n    pub fn create_connection_id_reset_secret(\n        &mut self,\n        cnx_id: &ConnectionId,\n        reset_secret: &mut [u8; RESET_SECRET_SIZE],\n    ) -> Result<(), Error> {\n        use digest::Digest;\n\n        let mut serialized = [0u8; crate::CONNECTION_ID_MAX_SIZE + 1];\n        serialized[..cnx_id.len()].copy_from_slice(cnx_id.as_bytes());\n        serialized[crate::CONNECTION_ID_MAX_SIZE] = cnx_id.len() as u8;\n\n        let mut hasher = sha2::Sha256::new();\n        hasher.update(self.reset_seed);\n        hasher.update(serialized);\n        let digest = hasher.finalize();\n        reset_secret.copy_from_slice(&digest[..RESET_SECRET_SIZE]);\n        Ok(())\n    }\n\n    // The C `tls_set_verify_certificate_callback` /\n    // `dispose_verify_certificate_callback` pair is folded into\n    // [`crate::tls::TlsCallbacks`] — applications install a single\n    // callbacks bundle on the QUIC context and override\n    // `verify_certificate` to plug in their own logic.\n\n    /// Toggle whether the server requires client certificates.  C\n    /// took an `int`; promoted to `bool`.  C:\n    /// `tls_set_client_authentication`.\n    pub fn tls_set_client_authentication(&mut self, client_authentication: bool) {\n        self.client_authentication = client_authentication;\n    }\n\n    /// Report whether client authentication is currently required.\n    /// C: `tls_client_authentication_activated`.\n    pub fn tls_client_authentication_activated(&self) -> bool {\n        self.client_authentication\n    }\n\n    /// Toggle whether tls exposes its exporter API on this master\n    /// context.  C: `tls_set_use_exporter`.\n    pub fn tls_set_use_exporter(&mut self, use_exporter: bool) {\n        self.use_exporter = use_exporter;\n    }\n}\n\n// ---------------------------------------------------------------------------\n// Retry tokens.\n//\n// `server_decrypt_retry_token`,\n// `prepare_retry_token`, and\n// `verify_retry_token` were the three token entry points\n// declared in this header.  All three take a `struct sockaddr*`\n// peer address (mapped to [`SocketAddr`]) and produce / consume a\n// caller-allocated `token` buffer.\n\n/// Output bundle from [`server_decrypt_retry_token`].  C\n/// returned the new-token flag through `int*` and the plaintext\n/// length through `size_t*`; collapsing them into a struct keeps","numLines":80,"startLine":1290,"totalLines":1949}}}
