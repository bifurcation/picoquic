n tuple;\n321\t}\n322\t\n323\t/* Find available paths:\n324\t* Check that there is at least one available path. If not, promote one of the candidates.\n325\t*/\n326\tint picoquic_verify_path_available(picoquic_cnx_t* cnx, picoquic_path_t** next_path, uint64_t* min_retransmit, uint64_t current_time)\n327\t{\n328\t    int backup_index = -1;\n329\t    int nb_available = 0;\n330\t    uint64_t best_available_retransmit = UINT64_MAX;\n331\t    uint64_t best_backup_retransmit = UINT64_MAX;\n332\t\n333\t    *min_retransmit = 0;\n334\t\n335\t    for (int path_index = 0; path_index < cnx->nb_paths; path_index++) {\n336\t        picoquic_path_t* path_x = cnx->path[path_index];\n337\t        if (path_x->first_tuple->challenge_verified &&\n338\t            !path_x->path_is_demoted) {\n339\t            /* Set the congestion algorithm if not already done */\n340\t            if (cnx->congestion_alg != NULL && path_x->congestion_alg_state == NULL) {\n341\t                cnx->congestion_alg->alg_init(path_x, cnx->congestion_alg_option_string, current_time);\n342\t            }\n343\t            /* track the available paths */\n344\t            if (path_x->path_is_backup) {\n345\t                if (backup_index < 0 || path_x->nb_retransmit < best_backup_retransmit) {\n346\t                    best_backup_retransmit = path_x->nb_retransmit;\n347\t                    backup_index = path_index;\n348\t                }\n349\t            }\n350\t            else\n351\t            {\n352\t                if (path_x->nb_retransmit < best_available_retransmit) {\n353\t                    best_available_retransmit = path_x->nb_retransmit;\n354\t                    *next_path = path_x;\n355\t                    nb_available = 0;\n356\t                }\n357\t                nb_available++;\n358\t            }\n359\t        }\n360\t    }\n361\t    if (best_available_retransmit > 0 && best_backup_retransmit < best_available_retransmit) {\n362\t        cnx->path[backup_index]->path_is_backup = 