{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01R1q6vagcefQZXFXDUudVxi","type":"tool_result","content":"100\t\n101\t/*\n102\t * Returns CWIN based on bandwidth estimation if larger than current CWIN. Otherwise, returns current CWIN.\n103\t */\n104\tuint64_t picoquic_cc_update_target_cwin_estimation(picoquic_path_t* path_x);\n105\t\n106\t/*\n107\t * Returns CWIN for long RTT connections if larger than current CWIN. Otherwise, returns current CWIN.\n108\t */\n109\tuint64_t picoquic_cc_update_cwin_for_long_rtt(picoquic_path_t * path_x);\n110\t\n111\t/* Many congestion control algorithms run a parallel version of new reno in order\n112\t * to provide a lower bound estimate of either the congestion window or the\n113\t * the minimal bandwidth. This implementation of new reno does not directly\n114\t * refer to the connection and path variables (e.g. cwin) but instead sets\n115\t * its entire state in memory.\n116\t */\n117\t\n118\ttypedef enum {\n119\t    picoquic_newreno_alg_slow_start = 0,\n120\t    picoquic_newreno_alg_congestion_avoidance\n121\t} picoquic_newreno_alg_state_t;\n122\t\n123\ttypedef struct st_picoquic_newreno_sim_state_t {\n124\t    picoquic_newreno_alg_state_t alg_state;\n125\t    uint64_t cwin;\n126\t    uint64_t residual_ack;\n127\t    uint64_t ssthresh;\n128\t    uint64_t recovery_start;\n129\t    uint64_t recovery_sequence;\n130\t} picoquic_newreno_sim_state_t;\n131\t\n132\tvoid picoquic_newreno_sim_reset(picoquic_newreno_sim_state_t* nrss);\n133\t\n134\tvoid picoquic_newreno_sim_notify(\n135\t    picoquic_newreno_sim_state_t* nr_state,\n136\t    picoquic_cnx_t* cnx,\n137\t    picoquic_path_t* path_x,\n138\t    picoquic_congestion_notification_t notification,\n139\t    picoquic_per_ack_state_t * ack_state,\n140\t    uint64_t current_time);\n141\t\n142\t#ifdef __cplusplus\n143\t}\n144\t#endif\n145\t\n146\t#endif\n147\t"}]},"parent_tool_use_id":null,"session_id":"234a43d5-4d7d-4176-a3a8-3c27d4d10782","uuid":"f4f019be-00ee-4f20-bd71-39b68603a6e4","timestamp":"2026-05-07T06:29:36.902Z","tool_use_result":{"type":"text","file":{"filePath":"/Users/richbarn/Projects/picoquic/picoquic/cc_common.h","content":"\n/*\n * Returns CWIN based on bandwidth estimation if larger than current CWIN. Otherwise, returns current CWIN.\n */\nuint64_t picoquic_cc_update_target_cwin_estimation(picoquic_path_t* path_x);\n\n/*\n * Returns CWIN for long RTT connections if larger than current CWIN. Otherwise, returns current CWIN.\n */\nuint64_t picoquic_cc_update_cwin_for_long_rtt(picoquic_path_t * path_x);\n\n/* Many congestion control algorithms run a parallel version of new reno in order\n * to provide a lower bound estimate of either the congestion window or the\n * the minimal bandwidth. This implementation of new reno does not directly\n * refer to the connection and path variables (e.g. cwin) but instead sets\n * its entire state in memory.\n */\n\ntypedef enum {\n    picoquic_newreno_alg_slow_start = 0,\n    picoquic_newreno_alg_congestion_avoidance\n} picoquic_newreno_alg_state_t;\n\ntypedef struct st_picoquic_newreno_sim_state_t {\n    picoquic_newreno_alg_state_t alg_state;\n    uint64_t cwin;\n    uint64_t residual_ack;\n    uint64_t ssthresh;\n    uint64_t recovery_start;\n    uint64_t recovery_sequence;\n} picoquic_newreno_sim_state_t;\n\nvoid picoquic_newreno_sim_reset(picoquic_newreno_sim_state_t* nrss);\n\nvoid picoquic_newreno_sim_notify(\n    picoquic_newreno_sim_state_t* nr_state,\n    picoquic_cnx_t* cnx,\n    picoquic_path_t* path_x,\n    picoquic_congestion_notification_t notification,\n    picoquic_per_ack_state_t * ack_state,\n    uint64_t current_time);\n\n#ifdef __cplusplus\n}\n#endif\n\n#endif\n","numLines":48,"startLine":100,"totalLines":147}}}
