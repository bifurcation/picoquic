{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01FdqrFXG2F3e8WsNMapDSkG","type":"tool_result","content":"748\t/// `option_string` arrives as an optional borrowed `&str`; the C\n749\t/// version accepted a nullable `char const*` that callers either\n750\t/// owned for the duration of the call or set to `NULL`.\n751\tpub trait CongestionControl: Sync {\n752\t    fn alg_init(&self, path_x: &mut Path, option_string: Option<&str>, current_time: Instant);\n753\t\n754\t    fn alg_notify(\n755\t        &self,\n756\t        connection: &mut Connection,\n757\t        path_x: &mut Path,\n758\t        notification: CongestionNotification,\n759\t        ack_state: &PerAckState,\n760\t        current_time: Instant,\n761\t    );\n762\t\n763\t    fn alg_delete(&self, path_x: &mut Path);\n764\t\n765\t    /// Optional observation hook — many algorithms leave this\n766\t    /// unimplemented (`NULL` in C).  Callers that don't care can\n767\t    /// rely on the default `None` return.\n768\t    fn alg_observe(&self, _path_x: &Path) -> Option<(u64, u64)> {\n769\t        None\n770\t    }\n771\t}\n772\t\n773\t/// Congestion-control algorithm descriptor.  C:\n774\t/// `CongestionAlgorithm`.\n775\t///\n776\t/// The four function pointers from the C struct fold into a single\n777\t/// trait-object reference; the algorithm identifier and numeric tag\n778\t/// stay alongside it.  `congestion_algorithm_id` is `&'static str`\n779\t/// because the C side stores compile-time string literals.\n780\tpub struct CongestionAlgorithm {\n781\t    pub congestion_algorithm_id: &'static str,\n782\t    pub congestion_algorithm_number: u8,\n783\t    pub ecn_mark: u8,\n784\t    pub algorithm: &'static dyn CongestionControl,\n785\t}\n786\t\n787\timpl core::fmt::Debug for CongestionAlgorithm {\n788\t    fn fmt(&self, f: &mut core::fmt::Formatter<'_>) -> core::fmt::Result {\n789\t        f.debug_struct(\"CongestionAlgorithm\")\n790\t            .field(\"congestion_algorithm_id\", &self.congestion_algorithm_id)\n791\t            .field(\n792\t                \"congestion_algorithm_number\",\n793\t                &self.congestion_algorithm_number,\n794\t            )\n795\t            .field(\"ecn_mark\", &self.ecn_mark)\n796\t            .finish_non_exhaustive()\n797\t    }\n798\t}\n799\t\n800\t/// Return the registered congestion-control algorithm table.  In\n801\t/// C this was a pair of `extern` globals\n802\t/// (`congestion_control_algorithms` and\n803\t/// `nb_congestion_control_algorithms`); the Rust API\n804\t/// exposes a single accessor returning a borrowed slice — the\n805\t/// length is implicit.  The slice is empty until\n806\t/// [`register_congestion_control_algorithms`] (or its\n807\t/// `_all_` convenience wrapper) is called.\n808\tpub fn congestion_control_algorithms() -> &'static [&'static CongestionAlgorithm] {\n809\t    CC_ALGORITHM_REGISTRY\n810\t        .get()\n811\t        .map(|v| v.as_slice())\n812\t        .unwrap_or(&[])\n813\t}\n814\t\n815\t/// Process-wide congestion-control algorithm registry.  Filled by\n816\t/// [`register_congestion_control_algorithms`].  `OnceLock` is used\n817\t/// so the registry can be set once (or never) without locking on\n818\t/// every read after the first call to `congestion_control_algorithms`.\n819\tstatic CC_ALGORITHM_REGISTRY: std::sync::OnceLock<Vec<&'static CongestionAlgorithm>> =\n820\t    std::sync::OnceLock::new();\n821\t\n822\tstruct BaselineCongestionControl;\n823\t\n824\timpl CongestionControl for BaselineCongestionControl {\n825\t    fn alg_init(&self, path_x: &mut Path, _option_string: Option<&str>, _current_time: Instant) {\n826\t        path_x.cwin = crate::internal::CWIN_INITIAL;\n827\t        path_x.bytes_in_transit = 0;"}]},"parent_tool_use_id":null,"session_id":"234a43d5-4d7d-4176-a3a8-3c27d4d10782","uuid":"f8df6c6d-608e-4944-8989-152f461000df","timestamp":"2026-05-07T06:31:34.261Z","tool_use_result":{"type":"text","file":{"filePath":"/Users/richbarn/Projects/picoquic/rs/fq/src/lib.rs","content":"/// `option_string` arrives as an optional borrowed `&str`; the C\n/// version accepted a nullable `char const*` that callers either\n/// owned for the duration of the call or set to `NULL`.\npub trait CongestionControl: Sync {\n    fn alg_init(&self, path_x: &mut Path, option_string: Option<&str>, current_time: Instant);\n\n    fn alg_notify(\n        &self,\n        connection: &mut Connection,\n        path_x: &mut Path,\n        notification: CongestionNotification,\n        ack_state: &PerAckState,\n        current_time: Instant,\n    );\n\n    fn alg_delete(&self, path_x: &mut Path);\n\n    /// Optional observation hook — many algorithms leave this\n    /// unimplemented (`NULL` in C).  Callers that don't care can\n    /// rely on the default `None` return.\n    fn alg_observe(&self, _path_x: &Path) -> Option<(u64, u64)> {\n        None\n    }\n}\n\n/// Congestion-control algorithm descriptor.  C:\n/// `CongestionAlgorithm`.\n///\n/// The four function pointers from the C struct fold into a single\n/// trait-object reference; the algorithm identifier and numeric tag\n/// stay alongside it.  `congestion_algorithm_id` is `&'static str`\n/// because the C side stores compile-time string literals.\npub struct CongestionAlgorithm {\n    pub congestion_algorithm_id: &'static str,\n    pub congestion_algorithm_number: u8,\n    pub ecn_mark: u8,\n    pub algorithm: &'static dyn CongestionControl,\n}\n\nimpl core::fmt::Debug for CongestionAlgorithm {\n    fn fmt(&self, f: &mut core::fmt::Formatter<'_>) -> core::fmt::Result {\n        f.debug_struct(\"CongestionAlgorithm\")\n            .field(\"congestion_algorithm_id\", &self.congestion_algorithm_id)\n            .field(\n                \"congestion_algorithm_number\",\n                &self.congestion_algorithm_number,\n            )\n            .field(\"ecn_mark\", &self.ecn_mark)\n            .finish_non_exhaustive()\n    }\n}\n\n/// Return the registered congestion-control algorithm table.  In\n/// C this was a pair of `extern` globals\n/// (`congestion_control_algorithms` and\n/// `nb_congestion_control_algorithms`); the Rust API\n/// exposes a single accessor returning a borrowed slice — the\n/// length is implicit.  The slice is empty until\n/// [`register_congestion_control_algorithms`] (or its\n/// `_all_` convenience wrapper) is called.\npub fn congestion_control_algorithms() -> &'static [&'static CongestionAlgorithm] {\n    CC_ALGORITHM_REGISTRY\n        .get()\n        .map(|v| v.as_slice())\n        .unwrap_or(&[])\n}\n\n/// Process-wide congestion-control algorithm registry.  Filled by\n/// [`register_congestion_control_algorithms`].  `OnceLock` is used\n/// so the registry can be set once (or never) without locking on\n/// every read after the first call to `congestion_control_algorithms`.\nstatic CC_ALGORITHM_REGISTRY: std::sync::OnceLock<Vec<&'static CongestionAlgorithm>> =\n    std::sync::OnceLock::new();\n\nstruct BaselineCongestionControl;\n\nimpl CongestionControl for BaselineCongestionControl {\n    fn alg_init(&self, path_x: &mut Path, _option_string: Option<&str>, _current_time: Instant) {\n        path_x.cwin = crate::internal::CWIN_INITIAL;\n        path_x.bytes_in_transit = 0;","numLines":80,"startLine":748,"totalLines":4054}}}
