{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01QVQXiy8PM8jeDTrwBwQyW5","type":"tool_result","content":"420\t// ---------------------------------------------------------------------------\n421\t// Embedded New Reno simulator.\n422\t//\n423\t// Several congestion controllers run a parallel New Reno instance to\n424\t// derive a lower bound on the congestion window or minimum\n425\t// bandwidth.  This simulator does not touch the connection or path\n426\t// state directly; everything lives in `NewRenoSimState`.\n427\t\n428\t/// Internal phase of the embedded New Reno simulator.\n429\t/// C: `picoquic_newreno_alg_state_t`.\n430\t#[derive(Debug, Copy, Clone, PartialEq, Eq, Default)]\n431\tpub enum NewRenoAlgState {\n432\t    #[default]\n433\t    SlowStart,\n434\t    CongestionAvoidance,\n435\t}\n436\t\n437\t/// Simulator state for the embedded New Reno instance.\n438\t/// C: `picoquic_newreno_sim_state_t`.\n439\t#[derive(Debug, Clone, Default)]\n440\tpub struct NewRenoSimState {\n441\t    pub alg_state: NewRenoAlgState,\n442\t    pub cwin: u64,\n443\t    pub residual_ack: u64,\n444\t    pub ssthresh: u64,\n445\t    pub recovery_start: u64,\n446\t    pub recovery_sequence: u64,\n447\t}\n448\t\n449\timpl NewRenoSimState {\n450\t    /// Reset the simulator to its initial state.\n451\t    /// C: `picoquic_newreno_sim_reset`.\n452\t    pub fn reset(&mut self) {\n453\t        *self = Self::default();\n454\t        self.ssthresh = u64::MAX;\n455\t        self.cwin = CWIN_INITIAL;\n456\t    }\n457\t\n458\t    /// Drive the simulator with a congestion-control event.\n459\t    ///\n460\t    /// `connection` and `path_x` are read-only here: the C body only mutates\n461\t    /// `self`, reading the connection and path to resolve sequence\n462\t    /// numbers and timestamps via the `cc_*` accessors.  C:\n463\t    /// `picoquic_newreno_sim_notify`.\n464\t    pub fn notify(\n465\t        &mut self,\n466\t        connection: &Connection,\n467\t        path_x: &Path,\n468\t        notification: CongestionNotification,\n469\t        ack_state: &PerAckState,\n470\t        current_time: Instant,\n471\t    ) {\n472\t        match notification {\n473\t            CongestionNotification::Acknowledgement => match self.alg_state {\n474\t                NewRenoAlgState::SlowStart => {\n475\t                    self.cwin += ack_state.nb_bytes_acknowledged;\n476\t                    if self.cwin >= self.ssthresh {\n477\t                        self.alg_state = NewRenoAlgState::CongestionAvoidance;\n478\t                    }\n479\t                }\n480\t                NewRenoAlgState::CongestionAvoidance => {\n481\t                    let complete_delta = ack_state.nb_bytes_acknowledged * path_x.send_mtu as u64\n482\t                        + self.residual_ack;\n483\t                    self.residual_ack = complete_delta % self.cwin;\n484\t                    self.cwin += complete_delta / self.cwin;\n485\t                }\n486\t            },\n487\t            CongestionNotification::EcnEc\n488\t            | CongestionNotification::Repeat\n489\t            | CongestionNotification::Timeout\n490\t                if self.recovery_sequence <= ack_state.lost_packet_number =>\n491\t            {\n492\t                self.enter_recovery(connection, path_x, notification, current_time);\n493\t            }\n494\t            CongestionNotification::EcnEc\n495\t            | CongestionNotification::Repeat\n496\t            | CongestionNotification::Timeout => {}\n497\t            CongestionNotification::SpuriousRepeat => {\n498\t                if !connection.is_multipath_enabled {\n499\t                    if current_time.ticks() - self.recovery_start < path_x.smoothed_rtt.ticks()\n500\t                        && self.recovery_sequence > connection.ack_number(path_x)\n501\t                        && self.ssthresh != u64::MAX\n502\t                        && self.cwin < 2 * self.ssthresh\n503\t                    {\n504\t                        self.cwin = 2 * self.ssthresh;\n505\t                        self.alg_state = NewRenoAlgState::CongestionAvoidance;\n506\t                    }\n507\t                } else if current_time.ticks() - self.recovery_start < path_x.smoothed_rtt.ticks()\n508\t                    && self.recovery_start > connection.ack_sent_time(path_x).ticks()\n509\t                    && self.ssthresh != u64::MAX\n510\t                    && self.cwin < 2 * self.ssthresh\n511\t                {\n512\t                    self.cwin = 2 * self.ssthresh;\n513\t                    self.alg_state = NewRenoAlgState::CongestionAvoidance;\n514\t                }\n515\t            }\n516\t            CongestionNotification::Reset => {\n517\t                self.reset();\n518\t            }\n519\t            CongestionNotification::SeedCwin => {\n520\t                self.seed_cwin(ack_state.nb_bytes_acknowledged);\n521\t            }\n522\t            _ => {}\n523\t        }\n524\t    }\n525\t\n526\t    fn enter_recovery(\n527\t        &mut self,\n528\t        connection: &Connection,\n529\t        path_x: &Path,\n530\t        notification: CongestionNotification,\n531\t        current_time: Instant,\n532\t    ) {\n533\t        self.ssthresh = self.cwin / 2;\n534\t        if self.ssthresh < CWIN_MINIMUM {\n535\t            self.ssthresh = CWIN_MINIMUM;\n536\t        }\n537\t        if notification == CongestionNotification::Timeout {\n538\t            self.cwin = CWIN_MINIMUM;\n539\t            self.alg_state = NewRenoAlgState::SlowStart;"}]},"parent_tool_use_id":null,"session_id":"234a43d5-4d7d-4176-a3a8-3c27d4d10782","uuid":"ffef0a5f-0338-49b4-9506-d519caa008e1","timestamp":"2026-05-07T06:29:44.164Z","tool_use_result":{"type":"text","file":{"filePath":"/Users/richbarn/Projects/picoquic/rs/fq/src/cc_common.rs","content":"// ---------------------------------------------------------------------------\n// Embedded New Reno simulator.\n//\n// Several congestion controllers run a parallel New Reno instance to\n// derive a lower bound on the congestion window or minimum\n// bandwidth.  This simulator does not touch the connection or path\n// state directly; everything lives in `NewRenoSimState`.\n\n/// Internal phase of the embedded New Reno simulator.\n/// C: `picoquic_newreno_alg_state_t`.\n#[derive(Debug, Copy, Clone, PartialEq, Eq, Default)]\npub enum NewRenoAlgState {\n    #[default]\n    SlowStart,\n    CongestionAvoidance,\n}\n\n/// Simulator state for the embedded New Reno instance.\n/// C: `picoquic_newreno_sim_state_t`.\n#[derive(Debug, Clone, Default)]\npub struct NewRenoSimState {\n    pub alg_state: NewRenoAlgState,\n    pub cwin: u64,\n    pub residual_ack: u64,\n    pub ssthresh: u64,\n    pub recovery_start: u64,\n    pub recovery_sequence: u64,\n}\n\nimpl NewRenoSimState {\n    /// Reset the simulator to its initial state.\n    /// C: `picoquic_newreno_sim_reset`.\n    pub fn reset(&mut self) {\n        *self = Self::default();\n        self.ssthresh = u64::MAX;\n        self.cwin = CWIN_INITIAL;\n    }\n\n    /// Drive the simulator with a congestion-control event.\n    ///\n    /// `connection` and `path_x` are read-only here: the C body only mutates\n    /// `self`, reading the connection and path to resolve sequence\n    /// numbers and timestamps via the `cc_*` accessors.  C:\n    /// `picoquic_newreno_sim_notify`.\n    pub fn notify(\n        &mut self,\n        connection: &Connection,\n        path_x: &Path,\n        notification: CongestionNotification,\n        ack_state: &PerAckState,\n        current_time: Instant,\n    ) {\n        match notification {\n            CongestionNotification::Acknowledgement => match self.alg_state {\n                NewRenoAlgState::SlowStart => {\n                    self.cwin += ack_state.nb_bytes_acknowledged;\n                    if self.cwin >= self.ssthresh {\n                        self.alg_state = NewRenoAlgState::CongestionAvoidance;\n                    }\n                }\n                NewRenoAlgState::CongestionAvoidance => {\n                    let complete_delta = ack_state.nb_bytes_acknowledged * path_x.send_mtu as u64\n                        + self.residual_ack;\n                    self.residual_ack = complete_delta % self.cwin;\n                    self.cwin += complete_delta / self.cwin;\n                }\n            },\n            CongestionNotification::EcnEc\n            | CongestionNotification::Repeat\n            | CongestionNotification::Timeout\n                if self.recovery_sequence <= ack_state.lost_packet_number =>\n            {\n                self.enter_recovery(connection, path_x, notification, current_time);\n            }\n            CongestionNotification::EcnEc\n            | CongestionNotification::Repeat\n            | CongestionNotification::Timeout => {}\n            CongestionNotification::SpuriousRepeat => {\n                if !connection.is_multipath_enabled {\n                    if current_time.ticks() - self.recovery_start < path_x.smoothed_rtt.ticks()\n                        && self.recovery_sequence > connection.ack_number(path_x)\n                        && self.ssthresh != u64::MAX\n                        && self.cwin < 2 * self.ssthresh\n                    {\n                        self.cwin = 2 * self.ssthresh;\n                        self.alg_state = NewRenoAlgState::CongestionAvoidance;\n                    }\n                } else if current_time.ticks() - self.recovery_start < path_x.smoothed_rtt.ticks()\n                    && self.recovery_start > connection.ack_sent_time(path_x).ticks()\n                    && self.ssthresh != u64::MAX\n                    && self.cwin < 2 * self.ssthresh\n                {\n                    self.cwin = 2 * self.ssthresh;\n                    self.alg_state = NewRenoAlgState::CongestionAvoidance;\n                }\n            }\n            CongestionNotification::Reset => {\n                self.reset();\n            }\n            CongestionNotification::SeedCwin => {\n                self.seed_cwin(ack_state.nb_bytes_acknowledged);\n            }\n            _ => {}\n        }\n    }\n\n    fn enter_recovery(\n        &mut self,\n        connection: &Connection,\n        path_x: &Path,\n        notification: CongestionNotification,\n        current_time: Instant,\n    ) {\n        self.ssthresh = self.cwin / 2;\n        if self.ssthresh < CWIN_MINIMUM {\n            self.ssthresh = CWIN_MINIMUM;\n        }\n        if notification == CongestionNotification::Timeout {\n            self.cwin = CWIN_MINIMUM;\n            self.alg_state = NewRenoAlgState::SlowStart;","numLines":120,"startLine":420,"totalLines":563}}}
