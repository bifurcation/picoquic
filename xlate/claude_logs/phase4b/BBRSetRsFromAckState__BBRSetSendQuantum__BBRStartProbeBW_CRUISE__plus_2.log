{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01W2yG6CTQ1oNaL9ed9tcvtE","type":"tool_result","content":"2340\t    }\n2341\t    else {\n2342\t        BBRUpdateControlParameters(bbr_state, path_x, rs);\n2343\t    }\n2344\t}\n2345\t\n2346\t/* First step of BBR ACK processing:\n2347\t* convert the discrete arguments of \"picoquic_bbr_notify\"\n2348\t* into the \"rs\" structure used in the BBRv3 draft. We do\n2349\t* that so that it is easy to compare the code to the draft.\n2350\t* \n2351\t* \n2352\t * Code maintains the following counters per path\n2353\t * - total_bytes_lost -- number of bytes deemed lost from beginning of path\n2354\t * - delivered -- amount delivered so far\n2355\t * - rtt_sample -- last rtt sample\n2356\t * - bytes_in_transit -- bytes currently in flight\n2357\t * \n2358\t * It does not contain `data_lost`, but that could be inferred if\n2359\t * we keep a variable `nb_bytes_lost_since_packet_sent`.\n2360\t * The packet data contains: delivered_prior, so that the BBR variable\n2361\t * \"delivered\" can be computed = path->delivered - packet->delivered_prior.\n2362\t */\n2363\tstatic void BBRSetRsFromAckState(picoquic_path_t* path_x, picoquic_per_ack_state_t* ack_state, bbr_per_ack_state_t* rs)\n2364\t{\n2365\t    /* Need to compute the delivery rate */\n2366\t    if (path_x->bandwidth_estimate > 0) {\n2367\t        rs->delivery_rate = path_x->bandwidth_estimate;\n2368\t    }\n2369\t    else if (ack_state->rtt_measurement > 0) {\n2370\t        rs->delivery_rate = PICOQUIC_RATE_FROM_BYTES(ack_state->nb_bytes_delivered_since_packet_sent, ack_state->rtt_measurement);\n2371\t    }\n2372\t    else\n2373\t    {\n2374\t        rs->delivery_rate = 40000;\n2375\t    }\n2376\t    rs->delivered = ack_state->nb_bytes_delivered_since_packet_sent;\n2377\t    /* variable in path */\n2378\t    rs->rtt_sample = path_x->rtt_sample;\n2379\t    /* variables from call */\n2380\t    rs->newly_acked = ack_state->nb_bytes_acknowledged; /* volume of data acked by current ack */\n2381\t    rs->newly_lost = ack_state->nb_bytes_newly_lost; /* volume of data marked lost on ack received */\n2382\t    rs->lost = ack_state->nb_bytes_lost_since_packet_sent;\n2383\t    rs->tx_in_flight = ack_state->inflight_prior;\n2384\t    rs->is_app_limited = ack_state->is_app_limited; /*Checked that this is properly implemented */   \n2385\t    rs->is_cwnd_limited = ack_state->is_cwnd_limited;\n2386\t}\n2387\t\n2388\tstatic void picoquic_bbr_notify_ack(\n2389\t    picoquic_bbr_state_t* bbr_state,"}]},"parent_tool_use_id":null,"session_id":"5be31241-b87d-4d1b-a6ec-ddeef1119c85","uuid":"9ea31975-6aa8-411c-9a0f-7df2a1d89f58","timestamp":"2026-05-07T04:58:25.787Z","tool_use_result":{"type":"text","file":{"filePath":"/Users/richbarn/Projects/picoquic/picoquic/bbr.c","content":"    }\n    else {\n        BBRUpdateControlParameters(bbr_state, path_x, rs);\n    }\n}\n\n/* First step of BBR ACK processing:\n* convert the discrete arguments of \"picoquic_bbr_notify\"\n* into the \"rs\" structure used in the BBRv3 draft. We do\n* that so that it is easy to compare the code to the draft.\n* \n* \n * Code maintains the following counters per path\n * - total_bytes_lost -- number of bytes deemed lost from beginning of path\n * - delivered -- amount delivered so far\n * - rtt_sample -- last rtt sample\n * - bytes_in_transit -- bytes currently in flight\n * \n * It does not contain `data_lost`, but that could be inferred if\n * we keep a variable `nb_bytes_lost_since_packet_sent`.\n * The packet data contains: delivered_prior, so that the BBR variable\n * \"delivered\" can be computed = path->delivered - packet->delivered_prior.\n */\nstatic void BBRSetRsFromAckState(picoquic_path_t* path_x, picoquic_per_ack_state_t* ack_state, bbr_per_ack_state_t* rs)\n{\n    /* Need to compute the delivery rate */\n    if (path_x->bandwidth_estimate > 0) {\n        rs->delivery_rate = path_x->bandwidth_estimate;\n    }\n    else if (ack_state->rtt_measurement > 0) {\n        rs->delivery_rate = PICOQUIC_RATE_FROM_BYTES(ack_state->nb_bytes_delivered_since_packet_sent, ack_state->rtt_measurement);\n    }\n    else\n    {\n        rs->delivery_rate = 40000;\n    }\n    rs->delivered = ack_state->nb_bytes_delivered_since_packet_sent;\n    /* variable in path */\n    rs->rtt_sample = path_x->rtt_sample;\n    /* variables from call */\n    rs->newly_acked = ack_state->nb_bytes_acknowledged; /* volume of data acked by current ack */\n    rs->newly_lost = ack_state->nb_bytes_newly_lost; /* volume of data marked lost on ack received */\n    rs->lost = ack_state->nb_bytes_lost_since_packet_sent;\n    rs->tx_in_flight = ack_state->inflight_prior;\n    rs->is_app_limited = ack_state->is_app_limited; /*Checked that this is properly implemented */   \n    rs->is_cwnd_limited = ack_state->is_cwnd_limited;\n}\n\nstatic void picoquic_bbr_notify_ack(\n    picoquic_bbr_state_t* bbr_state,","numLines":50,"startLine":2340,"totalLines":2486}}}
