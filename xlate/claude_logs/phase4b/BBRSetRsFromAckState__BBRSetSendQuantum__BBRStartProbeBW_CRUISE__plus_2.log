{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_017javcBfUacpPmMmmcc7Btu","type":"tool_result","content":"1\t//! Translation of `picoquic/bbr.c` — BBRv3 congestion control.\n2\t//!\n3\t//! Phase 4: private helper batch (BBRAccessEcnPacketContext,\n4\t//! BBRAdaptMinRttMargin, BBRAdvanceLatestDeliverySignals,\n5\t//! BBRBDPMultipleWithBw, BBRBoundBWForModel, BBREnterStartup,\n6\t//! BBREnterStartupLongRTT, BBREnterStartupResume,\n7\t//! BBRExitLostFeedback, BBRHasElapsedInPhase).\n8\t\n9\tuse crate::PacketContext;\n10\tuse crate::cc_common::MinMaxRtt;\n11\tuse crate::internal::{\n12\t    CWIN_INITIAL, Connection, INITIAL_RTT, PacketContextState, Path, TARGET_RENO_RTT,\n13\t    TARGET_SATELLITE_RTT,\n14\t};\n15\t\n16\t// ---------------------------------------------------------------------------\n17\t// Constants from bbr.c `#define`s.\n18\t\n19\tconst BBR_MIN_RTT_MARGIN_PERCENT: u64 = 5;\n20\tconst BBR_APP_LIMITED_ROUNDS_THRESHOLD: i32 = 3; // C: BBRAppLimitedRoundsThreshold\n21\tconst BBR_PACING_MARGIN_PERCENT: u64 = 1; // C: BBRPacingMarginPercent\n22\tconst BBR_RTT_JITTER_BUFFER_LEN: usize = 7; // C: BBRRTTJitterBufferLen\n23\tconst BBR_STARTUP_PACING_GAIN: f64 = 2.77; // C: BBRStartupPacingGain (4·ln 2)\n24\tconst BBR_STARTUP_CWND_GAIN: f64 = 2.0; // C: BBRStartupCwndGain\n25\tconst BBR_STARTUP_RESUME_PACING_GAIN: f64 = 1.25; // C: BBRStartupResumePacingGain\n26\tconst BBR_STARTUP_RESUME_CWND_GAIN: f64 = 1.25; // C: BBRStartupResumeCwndGain\n27\tconst BBR_PROBE_RTT_CWND_GAIN: f64 = 0.5; // C: BBRProbeRTTCwndGain\n28\tconst BBR_EXCESSIVE_ECN_CE: f64 = 0.2; // C: BBRExcessiveEcnCE\n29\tconst BBR_BETA: f64 = 0.7; // C: BBRBeta — multiplicative decrease on loss\n30\t\n31\t// ---------------------------------------------------------------------------\n32\t// Algorithm-state enum.  C: `picoquic_bbr_alg_state_t`.\n33\t\n34\t#[derive(Debug, Copy, Clone, PartialEq, Eq, Default)]\n35\tpub enum BbrAlgState {\n36\t    #[default]\n37\t    Startup = 0,\n38\t    Drain,\n39\t    ProbeBwDown,\n40\t    ProbeBwCruise,\n41\t    ProbeBwRefill,\n42\t    ProbeBwUp,\n43\t    ProbeRtt,\n44\t    StartupLongRtt,\n45\t    StartupResume,\n46\t}\n47\t\n48\t// ---------------------------------------------------------------------------\n49\t// ACK-phase enum.  C: `picoquic_bbr_ack_phase_t`.\n50\t\n51\t#[derive(Debug, Copy, Clone, PartialEq, Eq, Default)]\n52\tpub enum BbrAckPhase {\n53\t    #[default]\n54\t    ProbeStarting = 0,\n55\t    ProbeStopping,\n56\t    Refilling,\n57\t    ProbeFeedback,\n58\t}\n59\t\n60\t// ---------------------------------------------------------------------------\n61\t// Experimental-flag struct.  C: `bbr_exp` (always enabled via\n62\t// `#define BBRExperiment on`).\n63\t\n64\t#[derive(Debug, Clone, Default)]\n65\tpub struct BbrExp {\n66\t    pub do_early_exit: bool,\n67\t    pub do_rapid_start: bool,\n68\t    pub do_handle_suspension: bool,\n69\t    pub do_control_lost: bool,\n70\t    pub do_exit_probe_bw_up_on_delay: bool,\n71\t    pub do_enter_probe_bw_after_limited: bool,\n72\t}\n73\t\n74\t// ---------------------------------------------------------------------------\n75\t// Per-ACK state.  C: `bbr_per_ack_state_t`.\n76\t\n77\t#[derive(Debug, Clone, Default)]\n78\tpub struct BbrPerAckState {\n79\t    pub delivered: u64,\n80\t    pub delivery_rate: u64,\n81\t    pub rtt_sample: u64,\n82\t    pub newly_acked: u64,\n83\t    pub newly_lost: u64,\n84\t    pub tx_in_flight: u64,\n85\t    pub lost: u64,\n86\t    pub ecn_ce: u64,\n87\t    pub ecn_frac: f64,\n88\t    pub ecn_alpha: f64,\n89\t    pub is_app_limited: bool,\n90\t    pub is_cwnd_limited: bool,\n91\t}\n92\t\n93\t// ---------------------------------------------------------------------------\n94\t// BBR state.  C: `picoquic_bbr_state_t`.\n95\t//\n96\t// Type deviations from C:\n97\t//   * single-bit `unsigned int x : 1` bitfields → `bool`\n98\t//   * non-negative `int` counters → `u32`\n99\t//   * `char const* option_string` → `Option<String>` (owned copy)\n100\t//   * `picoquic_min_max_rtt_t rtt_filter` → `MinMaxRtt`\n101\t//   * fixed arrays keep their C dimensions as Rust `[T; N]`\n102\t\n103\tpub struct BbrState {\n104\t    pub state: BbrAlgState,\n105\t    pub round_start_pn: u64,\n106\t    pub round_count: u32,\n107\t    pub rounds_since_probe: u32,\n108\t    pub round_start: bool,\n109\t    pub next_round_delivered: u64,\n110\t\n111\t    pub pacing_rate: f64,\n112\t    pub send_quantum: u64,\n113\t    pub prior_cwnd: u64,\n114\t\n115\t    pub pacing_gain: f64,\n116\t    pub next_departure_time: u64,\n117\t\n118\t    pub cwnd_gain: f64,\n119\t    pub packet_conservation: bool,\n120\t\n121\t    pub max_bw: u64,\n122\t    pub bw_hi: u64,\n123\t    pub bw_lo: u64,\n124\t    pub bw: u64,\n125\t\n126\t    // min_rtt uses u64::MAX as the sentinel \"no valid sample yet\".\n127\t    pub min_rtt: u64,\n128\t\n129\t    // RTT jitter buffer (C: #ifdef RTTJitterBuffer, always enabled).\n130\t    pub rtt_jitter_buffer: [u64; BBR_RTT_JITTER_BUFFER_LEN],\n131\t    pub rtt_jitter_cycle: u64,\n132\t    pub rtt_short_term_min: u64,\n133\t    pub rtt_short_term_max: u64,\n134\t    pub last_rtt_sample_stamp: u64,\n135\t    pub nb_rtt_excess: i32,\n136\t    pub rtt_too_high_in_round: bool,\n137\t\n138\t    pub bdp: u64,\n139\t    pub extra_acked: u64,\n140\t    pub offload_budget: u64,\n141\t    pub max_inflight: u64,\n142\t    pub inflight_hi: u64,\n143\t    pub inflight_lo: u64,\n144\t\n145\t    pub bw_latest: u64,\n146\t    pub inflight_latest: u64,\n147\t\n148\t    // BBRMaxBwFilterLen = 2\n149\t    pub max_bw_filter: [u64; 2],\n150\t    pub cycle_count: u32,\n151\t\n152\t    pub extra_acked_interval_start: u64,\n153\t    pub extra_acked_delivered: u64,\n154\t    // BBRExtraAckedFilterLen = 10\n155\t    pub extra_acked_filter: [u64; 10],\n156\t\n157\t    pub filled_pipe: bool,\n158\t    pub full_bw: u64,\n159\t    pub full_bw_count: u32,\n160\t\n161\t    pub min_rtt_stamp: u64,\n162\t    pub probe_rtt_min_delay: u64,\n163\t    pub probe_rtt_min_stamp: u64,\n164\t    pub probe_rtt_done_stamp: u64,\n165\t    pub min_rtt_margin: u64,\n166\t    pub probe_rtt_expired: bool,\n167\t    pub probe_rtt_round_done: bool,\n168\t    pub idle_restart: bool,\n169\t    pub path_is_app_limited: bool,\n170\t\n171\t    pub probe_probe_bw_quickly: bool,\n172\t    pub bw_probe_wait: u64,\n173\t    pub bw_probe_ceiling: u64,\n174\t    pub cycle_stamp: u64,\n175\t    pub rounds_since_bw_probe: u32,\n176\t    pub bw_probe_up_cnt: u32,\n177\t    pub bw_probe_up_rounds: u32,\n178\t    pub bw_probe_samples: u32,\n179\t    pub bw_probe_up_acks: u64,\n180\t    pub ack_phase: BbrAckPhase,\n181\t\n182\t    pub loss_in_round: bool,\n183\t    pub loss_round_start: bool,\n184\t    pub loss_round_delivered: u64,\n185\t\n186\t    pub is_in_recovery: bool,\n187\t    pub is_pto_recovery: bool,\n188\t    pub recovery_packet_number: u64,\n189\t    pub recovery_delivered: u64,\n190\t\n191\t    pub is_handling_lost_feedback: bool,\n192\t    pub cwin_before_lost_feedback: u64,\n193\t\n194\t    pub app_limited_round_count: i32,\n195\t    pub app_limited_this_round: i32,\n196\t\n197\t    pub ecn_ect1_last_round: u64,\n198\t    pub ecn_ce_last_round: u64,\n199\t    pub ecn_alpha: f64,\n200\t\n201\t    pub random_context: u64,\n202\t\n203\t    pub rtt_filter: MinMaxRtt,\n204\t    pub bdp_seed: u64,\n205\t    pub probe_bdp_seed: bool,\n206\t\n207\t    pub option_string: Option<String>,\n208\t    pub wifi_shadow_rtt: u64,\n209\t    pub quantum_ratio: f64,\n210\t\n211\t    pub exp_flags: BbrExp,\n212\t}\n213\t\n214\timpl BbrState {\n215\t    /// C: `BBRAdaptMinRttMargin` (picoquic/bbr.c:1290)\n216\t    ///\n217\t    /// Recompute `min_rtt_margin` as a fixed percentage of `min_rtt`\n218\t    /// plus the transmission time of two MTU-sized packets at `max_bw`.\n219\t    /// The margin prevents the probe-RTT timer from firing too early\n220\t    /// when only a small amount of queuing is present.\n221\t    pub fn adapt_min_rtt_margin(&mut self, path_x: &Path) {\n222\t        let margin = (self.min_rtt * BBR_MIN_RTT_MARGIN_PERCENT) * 100 / 1_000_000;\n223\t        let margin = if self.max_bw > 0 {\n224\t            margin + 2 * path_x.send_mtu as u64 * 1_000_000 / self.max_bw\n225\t        } else {\n226\t            margin\n227\t        };\n228\t        self.min_rtt_margin = margin;\n229\t    }\n230\t\n231\t    /// C: `BBRAdvanceLatestDeliverySignals` (picoquic/bbr.c:1007)\n232\t    ///\n233\t    /// Called near the end of ACK processing: if this ACK completed a\n234\t    /// loss round, reset `bw_latest` and `inflight_latest` to the\n235\t    /// current sample so the next round starts fresh.\n236\t    pub fn advance_latest_delivery_signals(&mut self, rs: &BbrPerAckState) {\n237\t        if self.loss_round_start {\n238\t            self.bw_latest = rs.delivery_rate;\n239\t            self.inflight_latest = rs.delivered;\n240\t        }\n241\t    }\n242\t\n243\t    /// C: `BBRBDPMultipleWithBw` (picoquic/bbr.c:869)\n244\t    ///\n245\t    /// Returns `gain × BDP` computed at the supplied `bw` rather than\n246\t    /// `self.bw`.  When `min_rtt` has never been measured (`u64::MAX`),\n247\t    /// returns the initial congestion window as a safe floor.\n248\t    ///\n249\t    /// Side-effect: writes `self.bdp` so callers can read the raw BDP\n250\t    /// estimate after the call (mirrors C's write-through of\n251\t    /// `bbr_state->bdp`).\n252\t    pub fn bdp_multiple_with_bw(&mut self, path_x: &Path, gain: f64, bw: u64) -> u64 {\n253\t        if self.min_rtt == u64::MAX {\n254\t            return CWIN_INITIAL * path_x.send_mtu as u64;\n255\t        }\n256\t        // PICOQUIC_BYTES_FROM_RATE(min_rtt_us, bps) = min_rtt * bps / 1_000_000\n257\t        self.bdp = self.min_rtt * bw / 1_000_000;\n258\t        (gain * self.bdp as f64) as u64\n259\t    }\n260\t\n261\t    /// C: `BBRBoundBWForModel` (picoquic/bbr.c:1094)\n262\t    ///\n263\t    /// Set `self.bw = min(max_bw, bw_lo, bw_hi)`.  `bw_hi` is only\n264\t    /// applied when non-zero; the zero check preserves compatibility\n265\t    /// with states where `bw_hi` is not yet initialised (noted as a\n266\t    /// TODO in the C source).\n267\t    pub fn bound_bw_for_model(&mut self) {\n268\t        self.bw = self.max_bw;\n269\t        if self.bw > self.bw_lo {\n270\t            self.bw = self.bw_lo;\n271\t        }\n272\t        // TODO: remove the bw_hi != 0 guard once variables are properly\n273\t        // initialised (mirrors the C-side TODO at bbr.c:1100).\n274\t        if self.bw > self.bw_hi && self.bw_hi != 0 {\n275\t            self.bw = self.bw_hi;\n276\t        }\n277\t    }\n278\t\n279\t    /// C: `BBREnterProbeRTT` (picoquic/bbr.c:1487)\n280\t    pub fn enter_probe_rtt(&mut self, path_x: &mut Path) {\n281\t        self.state = BbrAlgState::ProbeRtt;\n282\t        self.pacing_gain = 1.0;\n283\t        self.cwnd_gain = BBR_PROBE_RTT_CWND_GAIN;\n284\t        path_x.is_cca_probing_up = false;\n285\t    }\n286\t\n287\t    /// C: `BBREnterDrain` (picoquic/bbr.c:1933)\n288\t    pub fn enter_drain(&mut self, path_x: &mut Path) {\n289\t        // Picoquic-specific: notify transport that the startup phase is complete.\n290\t        path_x.is_ssthresh_initialized = true;\n291\t        self.state = BbrAlgState::Drain;\n292\t        self.pacing_gain = 1.0 / BBR_STARTUP_CWND_GAIN; // pace slowly\n293\t        self.cwnd_gain = BBR_STARTUP_CWND_GAIN; // maintain cwnd\n294\t        path_x.is_cca_probing_up = false;\n295\t    }\n296\t\n297\t    /// C: `BBRCheckStartupFullBandwidthGeneric` (picoquic/bbr.c:1952)\n298\t    pub fn check_startup_full_bandwidth_generic(&mut self, rs: &BbrPerAckState, threshold: f64) {\n299\t        if self.filled_pipe || !self.round_start || rs.is_app_limited {\n300\t            return;\n301\t        }\n302\t        if self.max_bw as f64 >= threshold * self.full_bw as f64 {\n303\t            // still growing\n304\t            self.full_bw = self.max_bw;\n305\t            self.full_bw_count = 0;\n306\t            return;\n307\t        }\n308\t        self.full_bw_count += 1; // another round without much growth\n309\t        if self.full_bw_count >= 3 {\n310\t            self.filled_pipe = true;\n311\t        }\n312\t    }\n313\t\n314\t    /// C: `BBRCheckStartupFullBandwidth` (picoquic/bbr.c:2020)\n315\t    pub fn check_startup_full_bandwidth(&mut self, rs: &BbrPerAckState) {\n316\t        if self.filled_pipe || !self.round_start || rs.is_app_limited {\n317\t            return;\n318\t        }\n319\t        // 5/4 integer approximation of ×1.25 avoids floating-point drift.\n320\t        if 4 * self.max_bw >= 5 * self.full_bw {\n321\t            // still growing\n322\t            self.full_bw = self.max_bw;\n323\t            self.full_bw_count = 0;\n324\t            if rs.ecn_frac < 0.2 {\n325\t                return;\n326\t            }\n327\t        }\n328\t        self.full_bw_count += 1; // another round without much growth\n329\t        if self.full_bw_count >= 3 || rs.ecn_frac >= BBR_EXCESSIVE_ECN_CE {\n330\t            self.filled_pipe = true;\n331\t        }\n332\t    }\n333\t\n334\t    /// C: `BBRCheckAppLimitedEnded` (picoquic/bbr.c:1747)\n335\t    ///\n336\t    /// Tracks per-round app-limited state.  Returns `true` on the first\n337\t    /// round where the app is *not* limited after having been limited for\n338\t    /// more than `BBR_APP_LIMITED_ROUNDS_THRESHOLD` consecutive rounds.\n339\t    pub fn check_app_limited_ended(&mut self, rs: &BbrPerAckState) -> bool {\n340\t        let mut app_limited_ended = false;\n341\t        if self.round_start {\n342\t            if self.app_limited_this_round != 0 {\n343\t                self.app_limited_round_count += 1;\n344\t            } else {\n345\t                app_limited_ended = self.app_limited_round_count > BBR_APP_LIMITED_ROUNDS_THRESHOLD;\n346\t                self.app_limited_round_count = 0;\n347\t            }\n348\t            self.app_limited_this_round = 0;\n349\t        } else {\n350\t            self.app_limited_this_round |= rs.is_app_limited as i32;\n351\t        }\n352\t        app_limited_ended\n353\t    }\n354\t\n355\t    /// C: `BBRExitLostFeedback` (picoquic/bbr.c:782)\n356\t    ///\n357\t    /// Restore the congestion window saved by `BBREnterLostFeedback` and\n358\t    /// clear the lost-feedback flag.  No-op if the flag is not set.\n359\t    pub fn exit_lost_feedback(&mut self, path_x: &mut Path) {\n360\t        if self.is_handling_lost_feedback {\n361\t            path_x.cwin = self.cwin_before_lost_feedback;\n362\t            self.is_handling_lost_feedback = false;\n363\t        }\n364\t    }\n365\t\n366\t    /// C: `BBRHasElapsedInPhase` (picoquic/bbr.c:1776)\n367\t    ///\n368\t    /// Returns `true` when `current_time` has advanced past\n369\t    /// `cycle_stamp + interval`.  Used to decide when to transition from\n370\t    /// DOWN/CRUISE to REFILL in the probe-BW cycle.\n371\t    pub(crate) fn has_elapsed_in_phase(&self, interval: u64, current_time: u64) -> bool {\n372\t        current_time > self.cycle_stamp + interval\n373\t    }\n374\t\n375\t    /// C: `BBREnterStartupResume` (picoquic/bbr.c:1972)\n376\t    ///\n377\t    /// Enter `StartupResume` state, which uses Hystart-like pacing gains\n378\t    /// to resume quickly after a suspension.  Called either when a BDP\n379\t    /// seed is set or on the initial `EnterStartup` path when a seed\n380\t    /// exists.\n381\t    pub(crate) fn enter_startup_resume(&mut self) {\n382\t        self.state = BbrAlgState::StartupResume;\n383\t        self.pacing_gain = BBR_STARTUP_RESUME_PACING_GAIN;\n384\t        self.cwnd_gain = BBR_STARTUP_RESUME_CWND_GAIN;\n385\t    }\n386\t\n387\t    /// C: `BBREnterStartup` (picoquic/bbr.c:2061)\n388\t    ///\n389\t    /// Enter normal `Startup` state with the standard pacing and cwnd\n390\t    /// gains.  Sets `is_cca_probing_up` to inform the transport that the\n391\t    /// congestion controller is actively probing for more bandwidth.\n392\t    pub fn enter_startup(&mut self, path_x: &mut Path) {\n393\t        self.state = BbrAlgState::Startup;\n394\t        self.pacing_gain = BBR_STARTUP_PACING_GAIN;\n395\t        self.cwnd_gain = BBR_STARTUP_CWND_GAIN;\n396\t        path_x.is_cca_probing_up = true;\n397\t    }\n398\t\n399\t    /// C: `BBREnterStartupLongRTT` (picoquic/bbr.c:2080)\n400\t    ///\n401\t    /// Enter `StartupLongRTT` state, which uses Hystart rather than the\n402\t    /// normal BBR Startup algorithm.  The initial congestion window is\n403\t    /// scaled up from `CWIN_INITIAL` proportional to `rtt_min` (capped at\n404\t    /// the satellite-RTT ceiling) and then further boosted by the BDP seed\n405\t    /// when available.\n406\t    pub fn enter_startup_long_rtt(&mut self, path_x: &mut Path) {\n407\t        let mut cwnd = CWIN_INITIAL;\n408\t        self.state = BbrAlgState::StartupLongRtt;\n409\t        if path_x.rtt_min > TARGET_RENO_RTT {\n410\t            let rtt_cap = if path_x.rtt_min > TARGET_SATELLITE_RTT {\n411\t                TARGET_SATELLITE_RTT\n412\t            } else {\n413\t                path_x.rtt_min\n414\t            };\n415\t            cwnd = (cwnd as f64 * rtt_cap.ticks() as f64 / TARGET_RENO_RTT.ticks() as f64) as u64;\n416\t        }\n417\t        if cwnd < self.bdp_seed {\n418\t            cwnd = self.bdp_seed;\n419\t        }\n420\t        if cwnd > path_x.cwin {\n421\t            path_x.cwin = cwnd;\n422\t        }\n423\t        path_x.is_cca_probing_up = true;\n424\t    }\n425\t\n426\t    /// C: `BBRInitFullPipe` (picoquic/bbr.c:434)\n427\t    ///\n428\t    /// Reset the \"pipe full\" bandwidth-growth detector to its initial state.\n429\t    pub fn init_full_pipe(&mut self) {\n430\t        self.filled_pipe = false;\n431\t        self.full_bw = 0;\n432\t        self.full_bw_count = 0;\n433\t    }\n434\t\n435\t    /// C: `BBRInitLowerBounds` (picoquic/bbr.c:1025)\n436\t    ///\n437\t    /// On the first congestion episode in a cycle, latch `bw_lo` to\n438\t    /// `max_bw` and `inflight_lo` to `cwin` (the UINT64_MAX sentinel\n439\t    /// means \"not yet initialised\").\n440\t    pub fn init_lower_bounds(&mut self, path_x: &Path) {\n441\t        if self.bw_lo == u64::MAX {\n442\t            self.bw_lo = self.max_bw;\n443\t        }\n444\t        if self.inflight_lo == u64::MAX {\n445\t            self.inflight_lo = path_x.cwin;\n446\t        }\n447\t    }\n448\t\n449\t    /// C: `BBRInitPacingRate` (picoquic/bbr.c:933)\n450\t    ///\n451\t    /// Set the initial pacing rate based on the nominal bandwidth at\n452\t    /// `INITIAL_RTT` (250 ms), unless the path already has a real RTT\n453\t    /// estimate, in which case that estimate is used instead.\n454\t    pub fn init_pacing_rate(&mut self, path_x: &Path) {\n455\t        let initial_rtt = if path_x.smoothed_rtt != INITIAL_RTT || path_x.rtt_variant.ticks() != 0 {\n456\t            path_x.smoothed_rtt.ticks()\n457\t        } else {\n458\t            INITIAL_RTT.ticks()\n459\t        };\n460\t        let nominal_bandwidth = (1_000_000u64 * CWIN_INITIAL) as f64 / initial_rtt as f64;\n461\t        self.pacing_rate = BBR_STARTUP_PACING_GAIN * nominal_bandwidth;\n462\t    }\n463\t\n464\t    /// C: `BBRInitRandom` (picoquic/bbr.c:421)\n465\t    ///\n466\t    /// Seed `random_context` from the current time, connection role, and\n467\t    /// path ID so that tests remain deterministic while production runs\n468\t    /// diverge.  `connection` is passed separately because `Path` carries\n469\t    /// no back-pointer to its owning `Connection` in Rust.\n470\t    pub fn init_random(&mut self, connection: &Connection, path_x: &Path, current_time: u64) {\n471\t        let mut ctx: u64 = 0xfedcba9876543210;\n472\t        ctx ^= current_time;\n473\t        if connection.client_mode {\n474\t            ctx = ctx.wrapping_add(0x0123456789abcdef);\n475\t        }\n476\t        if path_x.unique_path_id > 0 && path_x.unique_path_id != u64::MAX {\n477\t            ctx = ctx.wrapping_mul(path_x.unique_path_id.wrapping_add(1));\n478\t        }\n479\t        self.random_context = ctx;\n480\t    }\n481\t\n482\t    /// C: `BBRInflightWithHeadroom` (picoquic/bbr.c:1547)\n483\t    ///\n484\t    /// Returns the inflight limit that leaves `BBRHeadroom` (15%) of the\n485\t    /// bottleneck buffer free for competing flows.  Returns `u64::MAX`\n486\t    /// when `inflight_hi` has not yet been measured.\n487\t    pub fn inflight_with_headroom(&self, path_x: &Path) -> u64 {\n488\t        const BBR_HEADROOM: f64 = 0.15;\n489\t        const BBR_MIN_PIPE_CWND: u64 = 4;\n490\t        if self.inflight_hi == u64::MAX {\n491\t            return u64::MAX;\n492\t        }\n493\t        let headroom = ((1.0 - BBR_HEADROOM) * self.inflight_hi as f64) as u64;\n494\t        headroom.max(BBR_MIN_PIPE_CWND * path_x.send_mtu as u64)\n495\t    }\n496\t\n497\t    /// C: `BBRIsProbingBW` (picoquic/bbr.c:1532)\n498\t    ///\n499\t    /// Returns `true` when the state is actively probing for more bandwidth\n500\t    /// (i.e. NOT in one of the non-probing states: ProbeBwDown, ProbeBwCruise,\n501\t    /// Drain, or ProbeRtt).\n502\t    pub fn is_probing_bw(&self) -> bool {\n503\t        !matches!(\n504\t            self.state,\n505\t            BbrAlgState::ProbeBwDown\n506\t                | BbrAlgState::ProbeBwCruise\n507\t                | BbrAlgState::Drain\n508\t                | BbrAlgState::ProbeRtt\n509\t        )\n510\t    }\n511\t\n512\t    /// C: `BBRLossLowerBounds` (picoquic/bbr.c:1035)\n513\t    ///\n514\t    /// Apply a `BBRBeta` (0.7) multiplicative decrease to `bw_lo` and\n515\t    /// `inflight_lo`, then floor each at the latest sample so the model\n516\t    /// cannot shrink below what was actually observed this round.\n517\t    pub fn loss_lower_bounds(&mut self) {\n518\t        self.bw_lo = ((BBR_BETA * self.bw_lo as f64) as u64).max(self.bw_latest);\n519\t        self.inflight_lo = ((BBR_BETA * self.inflight_lo as f64) as u64).max(self.inflight_latest);\n520\t    }\n521\t\n522\t    /// C: `BBRModulateCwndForRecovery` (picoquic/bbr.c:627)\n523\t    ///\n524\t    /// On packet loss, shrink `cwin` by the number of bytes lost (floored at\n525\t    /// one MTU).  When `packet_conservation` is active, ensure `cwin` is at\n526\t    /// least `bytes_in_transit + newly_acked` so the pipe stays full.\n527\t    pub fn modulate_cwnd_for_recovery(&self, path_x: &mut Path, rs: &BbrPerAckState) {\n528\t        if rs.newly_lost > 0 {\n529\t            if path_x.cwin > rs.newly_lost + path_x.send_mtu as u64 {\n530\t                path_x.cwin -= rs.newly_lost;\n531\t            } else {\n532\t                path_x.cwin = path_x.send_mtu as u64;\n533\t            }\n534\t        }\n535\t        if self.packet_conservation && path_x.cwin < path_x.bytes_in_transit + rs.newly_acked {\n536\t            path_x.cwin = path_x.bytes_in_transit + rs.newly_acked;\n537\t        }\n538\t    }\n539\t\n540\t    /// C: `BBRRaiseInflightHiSlope` (picoquic/bbr.c:1561)\n541\t    ///\n542\t    /// Recompute how aggressively `inflight_hi` is raised during ProbeBwUp.\n543\t    /// Each round the slope doubles (shift by `bw_probe_up_rounds`, capped at\n544\t    /// 30), and `bw_probe_up_cnt` is set to the number of MTU-sized ACKs\n545\t    /// required to justify a one-MTU increase (minimum 1).\n546\t    pub fn raise_inflight_hi_slope(&mut self, path_x: &Path) {\n547\t        let growth_this_round = (path_x.send_mtu as u64) << self.bw_probe_up_rounds;\n548\t        self.bw_probe_up_rounds = (self.bw_probe_up_rounds + 1).min(30);\n549\t        let up_cnt = (path_x.cwin / growth_this_round) as u32;\n550\t        self.bw_probe_up_cnt = up_cnt.max(1);\n551\t    }\n552\t\n553\t    /// C: `BBRResetCongestionSignals` (picoquic/bbr.c:1014)\n554\t    ///\n555\t    /// Clear the per-round congestion signals so the next round starts with\n556\t    /// a clean slate.  Called at the start of each new round.\n557\t    pub fn reset_congestion_signals(&mut self) {\n558\t        self.loss_in_round = false;\n559\t        self.bw_latest = 0;\n560\t        self.inflight_latest = 0;\n561\t    }\n562\t\n563\t    /// C: `BBRResetLowerBounds` (picoquic/bbr.c:1088)\n564\t    ///\n565\t    /// Reset `bw_lo` and `inflight_lo` to their uninitialized sentinel\n566\t    /// (`u64::MAX`), indicating no congestion episode has been seen yet.\n567\t    pub fn reset_lower_bounds(&mut self) {\n568\t        self.bw_lo = u64::MAX;\n569\t        self.inflight_lo = u64::MAX;\n570\t    }\n571\t\n572\t    /// C: `BBRResetRTTJitterBuffer` (picoquic/bbr.c:1322)\n573\t    ///\n574\t    /// Reinitialise the RTT jitter-buffer metadata to `rtt_init_value` and\n575\t    /// reset the cycle counter and excess counter.  The sample array itself\n576\t    /// is not cleared here (the caller's prior `memset` zeroes it on first\n577\t    /// call, and valid entries are overwritten as `rtt_jitter_cycle` advances).\n578\t    pub fn reset_rtt_jitter_buffer(&mut self, rtt_init_value: u64, current_time: u64) {\n579\t        self.rtt_jitter_cycle = 0;\n580\t        self.last_rtt_sample_stamp = current_time;\n581\t        self.rtt_short_term_min = rtt_init_value;\n582\t        self.rtt_short_term_max = rtt_init_value;\n583\t        self.probe_rtt_min_delay = rtt_init_value;\n584\t        self.nb_rtt_excess = 0;\n585\t    }\n586\t\n587\t    /// C: `BBRRestoreCwnd` (picoquic/bbr.c:736)\n588\t    ///\n589\t    /// Returns whichever is larger: the cwnd saved before recovery\n590\t    /// (`prior_cwnd`) or the current `path_x.cwin`.  Used when exiting\n591\t    /// recovery to avoid shrinking the window below what it was before.\n592\t    pub fn restore_cwnd(&self, path_x: &Path) -> u64 {\n593\t        self.prior_cwnd.max(path_x.cwin)\n594\t    }\n595\t\n596\t    /// C: `BBRSetPacingRateWithGain` (picoquic/bbr.c:944)\n597\t    ///\n598\t    /// Compute the target pacing rate as `pacing_gain × bw × (1 − margin%)`.\n599\t    /// In `StartupResume` with a BDP seed, the rate is floored at the seed\n600\t    /// rate to avoid sending slower than the measured path capacity.\n601\t    /// The rate is only applied when the pipe is full or the new rate exceeds\n602\t    /// the current one (prevents backward steps during slow-start).\n603\t    pub fn set_pacing_rate_with_gain(&mut self, pacing_gain: f64) {\n604\t        let rate = pacing_gain * (self.bw * (100 - BBR_PACING_MARGIN_PERCENT)) as f64 / 100.0;\n605\t        let rate = if self.state == BbrAlgState::StartupResume\n606\t            && !self.filled_pipe\n607\t            && self.bdp_seed > 0\n608\t            && self.min_rtt > 0\n609\t            && self.min_rtt != u64::MAX\n610\t        {\n611\t            let bdp_rate = self.bdp_seed as f64 * 1_000_000.0 / self.min_rtt as f64;\n612\t            rate.max(bdp_rate)\n613\t        } else {\n614\t            rate\n615\t        };\n616\t        if self.filled_pipe || rate > self.pacing_rate {\n617\t            self.pacing_rate = rate;\n618\t        }\n619\t    }\n620\t\n621\t    /// C: `BBRSetOptions` (picoquic/bbr.c:460)\n622\t    ///\n623\t    /// Parse `option_string` to configure experimental flags and numeric\n624\t    /// parameters.  `BBRExperiment` is always enabled in this build, so all\n625\t    /// experiment flags default to `true` before any option disables them.\n626\t    ///\n627\t    /// Single-letter flags (toggle off the corresponding experiment):\n628\t    /// `E` `R` `H` `L` `D` `A`.  Complex options terminated by a value:\n629\t    /// `T<us>` → `wifi_shadow_rtt`, `Q<float>` → `quantum_ratio`.\n630\t    pub fn set_options(&mut self) {\n631\t        // BBRExperiment is always on.\n632\t        self.exp_flags.do_early_exit = true;\n633\t        self.exp_flags.do_rapid_start = true;\n634\t        self.exp_flags.do_handle_suspension = true;\n635\t        self.exp_flags.do_control_lost = true;\n636\t        self.exp_flags.do_exit_probe_bw_up_on_delay = true;\n637\t        self.exp_flags.do_enter_probe_bw_after_limited = true;\n638\t\n639\t        let s = match self.option_string.clone() {\n640\t            Some(s) => s,\n641\t            None => return,\n642\t        };\n643\t        let mut chars = s.chars().peekable();\n644\t        while let Some(c) = chars.next() {\n645\t            match c {\n646\t                'E' => self.exp_flags.do_early_exit = false,\n647\t                'R' => self.exp_flags.do_rapid_start = false,\n648\t                'H' => self.exp_flags.do_handle_suspension = false,\n649\t                'L' => self.exp_flags.do_control_lost = false,\n650\t                'D' => self.exp_flags.do_exit_probe_bw_up_on_delay = false,\n651\t                'A' => self.exp_flags.do_enter_probe_bw_after_limited = false,\n652\t                'T' => {\n653\t                    let mut u: u64 = 0;\n654\t                    while let Some(&d) = chars.peek() {\n655\t                        if d.is_ascii_digit() {\n656\t                            u = u * 10 + (d as u64 - b'0' as u64);\n657\t                            chars.next();\n658\t                        } else {\n659\t                            break;\n660\t                        }\n661\t                    }\n662\t                    self.wifi_shadow_rtt = u;\n663\t                }\n664\t                'Q' => {\n665\t                    let mut d: f64 = 0.0;\n666\t                    let mut div: f64 = 1.0;\n667\t                    let mut dotted = false;\n668\t                    while let Some(&ch) = chars.peek() {\n669\t                        if ch.is_ascii_digit() {\n670\t                            if !dotted {\n671\t                                d = d * 10.0 + (ch as u8 - b'0') as f64;\n672\t                            } else {\n673\t                                div /= 10.0;\n674\t                                d += div * (ch as u8 - b'0') as f64;\n675\t                            }\n676\t                            chars.next();\n677\t                        } else if ch == '.' {\n678\t                            if dotted {\n679\t                                break;\n680\t                            }\n681\t                            dotted = true;\n682\t                            chars.next();\n683\t                        } else {\n684\t                            break;\n685\t                        }\n686\t                    }\n687\t                    self.quantum_ratio = d;\n688\t                }\n689\t                _ => {}\n690\t            }\n691\t        }\n692\t    }\n693\t}\n694\t\n695\t/// C: `BBRAccessEcnPacketContext` (picoquic/bbr.c:2245)\n696\t///\n697\t/// Return the packet-context that carries ECN counts for `path_x`.\n698\t///\n699\t/// Under multipath each path has its own context; under single-path\n700\t/// only the default path (`unique_path_id == 0`, corresponding to\n701\t/// `cnx->path[0]` in C) participates in ECN tracking — other paths\n702\t/// return `None`.\n703\t///\n704\t/// Note: in C the path held a back-pointer to its connection\n705\t/// (`path_x->cnx`); in Rust there is no back-pointer, so the caller\n706\t/// must supply both `connection` and `path_x`.\n707\tpub fn access_ecn_packet_context<'a>(\n708\t    connection: &'a Connection,\n709\t    path_x: &'a Path,\n710\t) -> Option<&'a PacketContextState> {\n711\t    if connection.is_multipath_enabled {\n712\t        Some(&path_x.pkt_ctx)\n713\t    } else if path_x.unique_path_id != 0 {\n714\t        // Non-default path in single-path mode: ECN counts are not\n715\t        // tracked per-path here; the caller should use the default path.\n716\t        None\n717\t    } else {\n718\t        Some(&connection.pkt_ctx[PacketContext::Application as usize])\n719\t    }\n720\t}\n721\t\n722\t#[cfg(test)]\n723\tmod tests {\n724\t    use super::*;\n725\t\n726\t    fn make_state() -> BbrState {\n727\t        BbrState {\n728\t            state: BbrAlgState::default(),\n729\t            round_start_pn: 0,\n730\t            round_count: 0,\n731\t            rounds_since_probe: 0,\n732\t            round_start: false,\n733\t            next_round_delivered: 0,\n734\t            pacing_rate: 0.0,\n735\t            send_quantum: 0,\n736\t            prior_cwnd: 0,\n737\t            pacing_gain: 1.0,\n738\t            next_departure_time: 0,\n739\t            cwnd_gain: 1.0,\n740\t            packet_conservation: false,\n741\t            max_bw: 0,\n742\t            bw_hi: u64::MAX,\n743\t            bw_lo: u64::MAX,\n744\t            bw: 0,\n745\t            min_rtt: u64::MAX,\n746\t            rtt_jitter_buffer: [0; BBR_RTT_JITTER_BUFFER_LEN],\n747\t            rtt_jitter_cycle: 0,\n748\t            rtt_short_term_min: 0,\n749\t            rtt_short_term_max: 0,\n750\t            last_rtt_sample_stamp: 0,\n751\t            nb_rtt_excess: 0,\n752\t            rtt_too_high_in_round: false,\n753\t            bdp: 0,\n754\t            extra_acked: 0,\n755\t            offload_budget: 0,\n756\t            max_inflight: 0,\n757\t            inflight_hi: u64::MAX,\n758\t            inflight_lo: u64::MAX,\n759\t            bw_latest: 0,\n760\t            inflight_latest: 0,\n761\t            max_bw_filter: [0; 2],\n762\t            cycle_count: 0,\n763\t            extra_acked_interval_start: 0,\n764\t            extra_acked_delivered: 0,\n765\t            extra_acked_filter: [0; 10],\n766\t            filled_pipe: false,\n767\t            full_bw: 0,\n768\t            full_bw_count: 0,\n769\t            min_rtt_stamp: 0,\n770\t            probe_rtt_min_delay: 0,\n771\t            probe_rtt_min_stamp: 0,\n772\t            probe_rtt_done_stamp: 0,\n773\t            min_rtt_margin: 0,\n774\t            probe_rtt_expired: false,\n775\t            probe_rtt_round_done: false,\n776\t            idle_restart: false,\n777\t            path_is_app_limited: false,\n778\t            probe_probe_bw_quickly: false,\n779\t            bw_probe_wait: 0,\n780\t            bw_probe_ceiling: 0,\n781\t            cycle_stamp: 0,\n782\t            rounds_since_bw_probe: 0,\n783\t            bw_probe_up_cnt: 0,\n784\t            bw_probe_up_rounds: 0,\n785\t            bw_probe_samples: 0,\n786\t            bw_probe_up_acks: 0,\n787\t            ack_phase: BbrAckPhase::default(),\n788\t            loss_in_round: false,\n789\t            loss_round_start: false,\n790\t            loss_round_delivered: 0,\n791\t            is_in_recovery: false,\n792\t            is_pto_recovery: false,\n793\t            recovery_packet_number: 0,\n794\t            recovery_delivered: 0,\n795\t            is_handling_lost_feedback: false,\n796\t            cwin_before_lost_feedback: 0,\n797\t            app_limited_round_count: 0,\n798\t            app_limited_this_round: 0,\n799\t            ecn_ect1_last_round: 0,\n800\t            ecn_ce_last_round: 0,\n801\t            ecn_alpha: 0.0,\n802\t            random_context: 0,\n803\t            rtt_filter: MinMaxRtt::default(),\n804\t            bdp_seed: 0,\n805\t            probe_bdp_seed: false,\n806\t            option_string: None,\n807\t            wifi_shadow_rtt: 0,\n808\t            quantum_ratio: 0.001,\n809\t            exp_flags: BbrExp::default(),\n810\t        }\n811\t    }\n812\t\n813\t    #[test]\n814\t    fn bound_bw_for_model_clamps_to_lo() {\n815\t        let mut s = make_state();\n816\t        s.max_bw = 1000;\n817\t        s.bw_lo = 800;\n818\t        s.bw_hi = 0; // not yet initialised → ignored\n819\t        s.bound_bw_for_model();\n820\t        assert_eq!(s.bw, 800);\n821\t    }\n822\t\n823\t    #[test]\n824\t    fn bound_bw_for_model_clamps_to_hi() {\n825\t        let mut s = make_state();\n826\t        s.max_bw = 1000;\n827\t        s.bw_lo = u64::MAX;\n828\t        s.bw_hi = 900;\n829\t        s.bound_bw_for_model();\n830\t        assert_eq!(s.bw, 900);\n831\t    }\n832\t\n833\t    #[test]\n834\t    fn bdp_multiple_with_bw_no_rtt_sample() {\n835\t        let mut s = make_state();\n836\t        s.min_rtt = u64::MAX;\n837\t        // Need a Path-like shape; use a zero send_mtu to simplify.\n838\t        // A real Path cannot be constructed in a unit test without the full\n839\t        // internal machinery, so we only verify the guard path indirectly via\n840\t        // the public interface.  The guard returns CWIN_INITIAL * send_mtu;\n841\t        // with send_mtu = 0 we get 0.\n842\t        // (Full integration coverage comes from the cargo test suite.)\n843\t        let _ = s.min_rtt; // use s so the compiler is happy\n844\t    }\n845\t\n846\t    #[test]\n847\t    fn advance_latest_delivery_signals_round_start() {\n848\t        let mut s = make_state();\n849\t        s.loss_round_start = true;\n850\t        s.bw_latest = 0;\n851\t        s.inflight_latest = 0;\n852\t        let rs = BbrPerAckState {\n853\t            delivery_rate: 500,\n854\t            delivered: 1200,\n855\t            ..BbrPerAckState::default()\n856\t        };\n857\t        s.advance_latest_delivery_signals(&rs);\n858\t        assert_eq!(s.bw_latest, 500);\n859\t        assert_eq!(s.inflight_latest, 1200);\n860\t    }\n861\t\n862\t    #[test]\n863\t    fn advance_latest_delivery_signals_no_round_start() {\n864\t        let mut s = make_state();\n865\t        s.loss_round_start = false;\n866\t        s.bw_latest = 42;\n867\t        s.inflight_latest = 99;\n868\t        let rs = BbrPerAckState {\n869\t            delivery_rate: 500,\n870\t            delivered: 1200,\n871\t            ..BbrPerAckState::default()\n872\t        };\n873\t        s.advance_latest_delivery_signals(&rs);\n874\t        // Not a round start: values must be unchanged.\n875\t        assert_eq!(s.bw_latest, 42);\n876\t        assert_eq!(s.inflight_latest, 99);\n877\t    }\n878\t\n879\t    // enter_probe_rtt and enter_drain write only to Path and BbrState fields;\n880\t    // constructing a full Path in unit tests requires heavy internal machinery,\n881\t    // so those functions are covered by the cargo compilation gate (--no-run)\n882\t    // and by higher-level integration tests.\n883\t\n884\t    #[test]\n885\t    fn check_startup_full_bandwidth_generic_growing() {\n886\t        let mut s = make_state();\n887\t        s.round_start = true;\n888\t        s.full_bw = 1000;\n889\t        s.max_bw = 1300; // >= threshold(1.25) * 1000 = 1250 → still growing\n890\t        let rs = BbrPerAckState::default();\n891\t        s.check_startup_full_bandwidth_generic(&rs, 1.25);\n892\t        assert_eq!(s.full_bw, 1300);\n893\t        assert_eq!(s.full_bw_count, 0);\n894\t        assert!(!s.filled_pipe);\n895\t    }\n896\t\n897\t    #[test]\n898\t    fn check_startup_full_bandwidth_generic_fills_after_3_rounds() {\n899\t        let mut s = make_state();\n900\t        s.round_start = true;\n901\t        s.full_bw = 1000;\n902\t        s.max_bw = 900; // < 1.25 * 1000 → not growing\n903\t        let rs = BbrPerAckState::default();\n904\t        s.check_startup_full_bandwidth_generic(&rs, 1.25);\n905\t        assert_eq!(s.full_bw_count, 1);\n906\t        assert!(!s.filled_pipe);\n907\t        s.check_startup_full_bandwidth_generic(&rs, 1.25);\n908\t        assert_eq!(s.full_bw_count, 2);\n909\t        s.check_startup_full_bandwidth_generic(&rs, 1.25);\n910\t        assert_eq!(s.full_bw_count, 3);\n911\t        assert!(s.filled_pipe);\n912\t    }\n913\t\n914\t    #[test]\n915\t    fn check_startup_full_bandwidth_skips_when_app_limited() {\n916\t        let mut s = make_state();\n917\t        s.round_start = true;\n918\t        s.full_bw = 1000;\n919\t        s.max_bw = 900;\n920\t        let rs = BbrPerAckState {\n921\t            is_app_limited: true,\n922\t            ..BbrPerAckState::default()\n923\t        };\n924\t        s.check_startup_full_bandwidth(&rs);\n925\t        assert_eq!(s.full_bw_count, 0); // skipped\n926\t    }\n927\t\n928\t    #[test]\n929\t    fn check_startup_full_bandwidth_ecn_triggers_fill() {\n930\t        let mut s = make_state();\n931\t        s.round_start = true;\n932\t        s.full_bw = 1000;\n933\t        s.max_bw = 900;\n934\t        // ecn_frac >= 0.2 should trigger filled_pipe even on first stall\n935\t        let rs = BbrPerAckState {\n936\t            ecn_frac: 0.3,\n937\t            ..BbrPerAckState::default()\n938\t        };\n939\t        s.check_startup_full_bandwidth(&rs);\n940\t        assert!(s.filled_pipe);\n941\t    }\n942\t\n943\t    #[test]\n944\t    fn check_app_limited_ended_accumulates_and_detects() {\n945\t        let mut s = make_state();\n946\t        // Simulate 4 app-limited rounds (> threshold of 3).\n947\t        for _ in 0..4 {\n948\t            s.round_start = true;\n949\t            s.app_limited_this_round = 1;\n950\t            let rs = BbrPerAckState::default();\n951\t            let ended = s.check_app_limited_ended(&rs);\n952\t            assert!(!ended);\n953\t        }\n954\t        // Now a non-app-limited round at round_start should return true.\n955\t        s.round_start = true;\n956\t        s.app_limited_this_round = 0;\n957\t        let rs = BbrPerAckState::default();\n958\t        let ended = s.check_app_limited_ended(&rs);\n959\t        assert!(ended);\n960\t        assert_eq!(s.app_limited_round_count, 0);\n961\t    }\n962\t\n963\t    #[test]\n964\t    fn check_app_limited_ended_mid_round_accumulates_flag() {\n965\t        let mut s = make_state();\n966\t        s.round_start = false;\n967\t        s.app_limited_this_round = 0;\n968\t        let rs = BbrPerAckState {\n969\t            is_app_limited: true,\n970\t            ..BbrPerAckState::default()\n971\t        };\n972\t        let ended = s.check_app_limited_ended(&rs);\n973\t        assert!(!ended);\n974\t        assert_eq!(s.app_limited_this_round, 1);\n975\t    }\n976\t\n977\t    #[test]\n978\t    fn has_elapsed_in_phase_true_when_past_deadline() {\n979\t        let s = make_state(); // cycle_stamp = 0\n980\t        assert!(s.has_elapsed_in_phase(100, 101));\n981\t    }\n982\t\n983\t    #[test]\n984\t    fn has_elapsed_in_phase_false_when_at_deadline() {\n985\t        let s = make_state(); // cycle_stamp = 0\n986\t        assert!(!s.has_elapsed_in_phase(100, 100)); // current_time must be strictly >\n987\t    }\n988\t\n989\t    #[test]\n990\t    fn has_elapsed_in_phase_respects_cycle_stamp() {\n991\t        let mut s = make_state();\n992\t        s.cycle_stamp = 500;\n993\t        assert!(!s.has_elapsed_in_phase(100, 599));\n994\t        assert!(s.has_elapsed_in_phase(100, 601));\n995\t    }\n996\t\n997\t    #[test]\n998\t    fn exit_lost_feedback_restores_cwin_and_clears_flag() {\n999\t        // exit_lost_feedback requires Path, so we only test the BbrState\n1000\t        // side-effect that is path-independent: when the flag is already\n1001\t        // clear the function must be a no-op (no panic).\n1002\t        let mut s = make_state();\n1003\t        s.is_handling_lost_feedback = false;\n1004\t        s.cwin_before_lost_feedback = 9999;\n1005\t        // We cannot call exit_lost_feedback here without a Path, but we can\n1006\t        // verify the guard: the function reads `is_handling_lost_feedback`\n1007\t        // first.  Full coverage comes from the integration tests.\n1008\t        let _ = s.cwin_before_lost_feedback; // used\n1009\t    }\n1010\t\n1011\t    #[test]\n1012\t    fn enter_startup_resume_sets_state_and_gains() {\n1013\t        let mut s = make_state();\n1014\t        s.enter_startup_resume();\n1015\t        assert_eq!(s.state, BbrAlgState::StartupResume);\n1016\t        assert!((s.pacing_gain - BBR_STARTUP_RESUME_PACING_GAIN).abs() < f64::EPSILON);\n1017\t        assert!((s.cwnd_gain - BBR_STARTUP_RESUME_CWND_GAIN).abs() < f64::EPSILON);\n1018\t    }\n1019\t\n1020\t    // enter_startup and enter_startup_long_rtt mutate Path fields\n1021\t    // (is_cca_probing_up, cwin); constructing a full Path requires\n1022\t    // the heavy internal machinery.  Those are covered by the cargo\n1023\t    // compilation gate and integration tests.\n1024\t\n1025\t    #[test]\n1026\t    fn reset_lower_bounds_sets_sentinels() {\n1027\t        let mut s = make_state();\n1028\t        s.bw_lo = 1234;\n1029\t        s.inflight_lo = 5678;\n1030\t        s.reset_lower_bounds();\n1031\t        assert_eq!(s.bw_lo, u64::MAX);\n1032\t        assert_eq!(s.inflight_lo, u64::MAX);\n1033\t    }\n1034\t\n1035\t    #[test]\n1036\t    fn reset_rtt_jitter_buffer_initialises_fields() {\n1037\t        let mut s = make_state();\n1038\t        let rtt_init = 50_000u64;\n1039\t        let now = 1_000_000u64;\n1040\t        s.reset_rtt_jitter_buffer(rtt_init, now);\n1041\t        assert_eq!(s.rtt_jitter_cycle, 0);\n1042\t        assert_eq!(s.last_rtt_sample_stamp, now);\n1043\t        assert_eq!(s.rtt_short_term_min, rtt_init);\n1044\t        assert_eq!(s.rtt_short_term_max, rtt_init);\n1045\t        assert_eq!(s.probe_rtt_min_delay, rtt_init);\n1046\t        assert_eq!(s.nb_rtt_excess, 0);\n1047\t    }\n1048\t\n1049\t    #[test]\n1050\t    fn set_pacing_rate_with_gain_increases_rate() {\n1051\t        let mut s = make_state();\n1052\t        s.bw = 1_000_000; // 1 Mbps\n1053\t        s.pacing_rate = 0.0;\n1054\t        s.filled_pipe = false;\n1055\t        s.set_pacing_rate_with_gain(1.0);\n1056\t        // rate = 1.0 * 1_000_000 * 99 / 100 = 990_000\n1057\t        assert!((s.pacing_rate - 990_000.0).abs() < 1.0);\n1058\t    }\n1059\t\n1060\t    #[test]\n1061\t    fn set_pacing_rate_with_gain_does_not_decrease() {\n1062\t        let mut s = make_state();\n1063\t        s.bw = 1_000_000;\n1064\t        s.pacing_rate = 2_000_000.0;\n1065\t        s.filled_pipe = false;\n1066\t        s.set_pacing_rate_with_gain(1.0);\n1067\t        // new rate (990_000) < current (2_000_000) and not filled_pipe → no update\n1068\t        assert!((s.pacing_rate - 2_000_000.0).abs() < 1.0);\n1069\t    }\n1070\t\n1071\t    #[test]\n1072\t    fn set_pacing_rate_with_gain_updates_when_filled_pipe() {\n1073\t        let mut s = make_state();\n1074\t        s.bw = 1_000_000;\n1075\t        s.pacing_rate = 2_000_000.0;\n1076\t        s.filled_pipe = true;\n1077\t        s.set_pacing_rate_with_gain(1.0);\n1078\t        // filled_pipe → always update\n1079\t        assert!((s.pacing_rate - 990_000.0).abs() < 1.0);\n1080\t    }\n1081\t\n1082\t    #[test]\n1083\t    fn set_options_defaults_to_all_experiment_flags_enabled() {\n1084\t        let mut s = make_state();\n1085\t        s.option_string = None;\n1086\t        s.set_options();\n1087\t        assert!(s.exp_flags.do_early_exit);\n1088\t        assert!(s.exp_flags.do_rapid_start);\n1089\t        assert!(s.exp_flags.do_handle_suspension);\n1090\t        assert!(s.exp_flags.do_control_lost);\n1091\t        assert!(s.exp_flags.do_exit_probe_bw_up_on_delay);\n1092\t        assert!(s.exp_flags.do_enter_probe_bw_after_limited);\n1093\t    }\n1094\t\n1095\t    #[test]\n1096\t    fn set_options_single_letter_flags_disable_experiments() {\n1097\t        let mut s = make_state();\n1098\t        s.option_string = Some(\"ERHLD\".to_string());\n1099\t        s.set_options();\n1100\t        assert!(!s.exp_flags.do_early_exit);\n1101\t        assert!(!s.exp_flags.do_rapid_start);\n1102\t        assert!(!s.exp_flags.do_handle_suspension);\n1103\t        assert!(!s.exp_flags.do_control_lost);\n1104\t        assert!(!s.exp_flags.do_exit_probe_bw_up_on_delay);\n1105\t        // 'A' not present → still true\n1106\t        assert!(s.exp_flags.do_enter_probe_bw_after_limited);\n1107\t    }\n1108\t\n1109\t    #[test]\n1110\t    fn set_options_parses_wifi_shadow_rtt() {\n1111\t        let mut s = make_state();\n1112\t        s.option_string = Some(\"T12345\".to_string());\n1113\t        s.set_options();\n1114\t        assert_eq!(s.wifi_shadow_rtt, 12345);\n1115\t    }\n1116\t\n1117\t    #[test]\n1118\t    fn set_options_parses_quantum_ratio_integer() {\n1119\t        let mut s = make_state();\n1120\t        s.option_string = Some(\"Q2\".to_string());\n1121\t        s.set_options();\n1122\t        assert!((s.quantum_ratio - 2.0).abs() < 1e-9);\n1123\t    }\n1124\t\n1125\t    #[test]\n1126\t    fn set_options_parses_quantum_ratio_decimal() {\n1127\t        let mut s = make_state();\n1128\t        s.option_string = Some(\"Q1.5\".to_string());\n1129\t        s.set_options();\n1130\t        assert!((s.quantum_ratio - 1.5).abs() < 1e-9);\n1131\t    }\n1132\t}\n1133\t"}]},"parent_tool_use_id":null,"session_id":"5be31241-b87d-4d1b-a6ec-ddeef1119c85","uuid":"5a790879-b223-46f2-95a2-ac9ba0671707","timestamp":"2026-05-07T04:58:28.314Z","tool_use_result":{"type":"text","file":{"filePath":"/Users/richbarn/Projects/picoquic/rs/fq/src/bbr.rs","content":"//! Translation of `picoquic/bbr.c` — BBRv3 congestion control.\n//!\n//! Phase 4: private helper batch (BBRAccessEcnPacketContext,\n//! BBRAdaptMinRttMargin, BBRAdvanceLatestDeliverySignals,\n//! BBRBDPMultipleWithBw, BBRBoundBWForModel, BBREnterStartup,\n//! BBREnterStartupLongRTT, BBREnterStartupResume,\n//! BBRExitLostFeedback, BBRHasElapsedInPhase).\n\nuse crate::PacketContext;\nuse crate::cc_common::MinMaxRtt;\nuse crate::internal::{\n    CWIN_INITIAL, Connection, INITIAL_RTT, PacketContextState, Path, TARGET_RENO_RTT,\n    TARGET_SATELLITE_RTT,\n};\n\n// ---------------------------------------------------------------------------\n// Constants from bbr.c `#define`s.\n\nconst BBR_MIN_RTT_MARGIN_PERCENT: u64 = 5;\nconst BBR_APP_LIMITED_ROUNDS_THRESHOLD: i32 = 3; // C: BBRAppLimitedRoundsThreshold\nconst BBR_PACING_MARGIN_PERCENT: u64 = 1; // C: BBRPacingMarginPercent\nconst BBR_RTT_JITTER_BUFFER_LEN: usize = 7; // C: BBRRTTJitterBufferLen\nconst BBR_STARTUP_PACING_GAIN: f64 = 2.77; // C: BBRStartupPacingGain (4·ln 2)\nconst BBR_STARTUP_CWND_GAIN: f64 = 2.0; // C: BBRStartupCwndGain\nconst BBR_STARTUP_RESUME_PACING_GAIN: f64 = 1.25; // C: BBRStartupResumePacingGain\nconst BBR_STARTUP_RESUME_CWND_GAIN: f64 = 1.25; // C: BBRStartupResumeCwndGain\nconst BBR_PROBE_RTT_CWND_GAIN: f64 = 0.5; // C: BBRProbeRTTCwndGain\nconst BBR_EXCESSIVE_ECN_CE: f64 = 0.2; // C: BBRExcessiveEcnCE\nconst BBR_BETA: f64 = 0.7; // C: BBRBeta — multiplicative decrease on loss\n\n// ---------------------------------------------------------------------------\n// Algorithm-state enum.  C: `picoquic_bbr_alg_state_t`.\n\n#[derive(Debug, Copy, Clone, PartialEq, Eq, Default)]\npub enum BbrAlgState {\n    #[default]\n    Startup = 0,\n    Drain,\n    ProbeBwDown,\n    ProbeBwCruise,\n    ProbeBwRefill,\n    ProbeBwUp,\n    ProbeRtt,\n    StartupLongRtt,\n    StartupResume,\n}\n\n// ---------------------------------------------------------------------------\n// ACK-phase enum.  C: `picoquic_bbr_ack_phase_t`.\n\n#[derive(Debug, Copy, Clone, PartialEq, Eq, Default)]\npub enum BbrAckPhase {\n    #[default]\n    ProbeStarting = 0,\n    ProbeStopping,\n    Refilling,\n    ProbeFeedback,\n}\n\n// ---------------------------------------------------------------------------\n// Experimental-flag struct.  C: `bbr_exp` (always enabled via\n// `#define BBRExperiment on`).\n\n#[derive(Debug, Clone, Default)]\npub struct BbrExp {\n    pub do_early_exit: bool,\n    pub do_rapid_start: bool,\n    pub do_handle_suspension: bool,\n    pub do_control_lost: bool,\n    pub do_exit_probe_bw_up_on_delay: bool,\n    pub do_enter_probe_bw_after_limited: bool,\n}\n\n// ---------------------------------------------------------------------------\n// Per-ACK state.  C: `bbr_per_ack_state_t`.\n\n#[derive(Debug, Clone, Default)]\npub struct BbrPerAckState {\n    pub delivered: u64,\n    pub delivery_rate: u64,\n    pub rtt_sample: u64,\n    pub newly_acked: u64,\n    pub newly_lost: u64,\n    pub tx_in_flight: u64,\n    pub lost: u64,\n    pub ecn_ce: u64,\n    pub ecn_frac: f64,\n    pub ecn_alpha: f64,\n    pub is_app_limited: bool,\n    pub is_cwnd_limited: bool,\n}\n\n// ---------------------------------------------------------------------------\n// BBR state.  C: `picoquic_bbr_state_t`.\n//\n// Type deviations from C:\n//   * single-bit `unsigned int x : 1` bitfields → `bool`\n//   * non-negative `int` counters → `u32`\n//   * `char const* option_string` → `Option<String>` (owned copy)\n//   * `picoquic_min_max_rtt_t rtt_filter` → `MinMaxRtt`\n//   * fixed arrays keep their C dimensions as Rust `[T; N]`\n\npub struct BbrState {\n    pub state: BbrAlgState,\n    pub round_start_pn: u64,\n    pub round_count: u32,\n    pub rounds_since_probe: u32,\n    pub round_start: bool,\n    pub next_round_delivered: u64,\n\n    pub pacing_rate: f64,\n    pub send_quantum: u64,\n    pub prior_cwnd: u64,\n\n    pub pacing_gain: f64,\n    pub next_departure_time: u64,\n\n    pub cwnd_gain: f64,\n    pub packet_conservation: bool,\n\n    pub max_bw: u64,\n    pub bw_hi: u64,\n    pub bw_lo: u64,\n    pub bw: u64,\n\n    // min_rtt uses u64::MAX as the sentinel \"no valid sample yet\".\n    pub min_rtt: u64,\n\n    // RTT jitter buffer (C: #ifdef RTTJitterBuffer, always enabled).\n    pub rtt_jitter_buffer: [u64; BBR_RTT_JITTER_BUFFER_LEN],\n    pub rtt_jitter_cycle: u64,\n    pub rtt_short_term_min: u64,\n    pub rtt_short_term_max: u64,\n    pub last_rtt_sample_stamp: u64,\n    pub nb_rtt_excess: i32,\n    pub rtt_too_high_in_round: bool,\n\n    pub bdp: u64,\n    pub extra_acked: u64,\n    pub offload_budget: u64,\n    pub max_inflight: u64,\n    pub inflight_hi: u64,\n    pub inflight_lo: u64,\n\n    pub bw_latest: u64,\n    pub inflight_latest: u64,\n\n    // BBRMaxBwFilterLen = 2\n    pub max_bw_filter: [u64; 2],\n    pub cycle_count: u32,\n\n    pub extra_acked_interval_start: u64,\n    pub extra_acked_delivered: u64,\n    // BBRExtraAckedFilterLen = 10\n    pub extra_acked_filter: [u64; 10],\n\n    pub filled_pipe: bool,\n    pub full_bw: u64,\n    pub full_bw_count: u32,\n\n    pub min_rtt_stamp: u64,\n    pub probe_rtt_min_delay: u64,\n    pub probe_rtt_min_stamp: u64,\n    pub probe_rtt_done_stamp: u64,\n    pub min_rtt_margin: u64,\n    pub probe_rtt_expired: bool,\n    pub probe_rtt_round_done: bool,\n    pub idle_restart: bool,\n    pub path_is_app_limited: bool,\n\n    pub probe_probe_bw_quickly: bool,\n    pub bw_probe_wait: u64,\n    pub bw_probe_ceiling: u64,\n    pub cycle_stamp: u64,\n    pub rounds_since_bw_probe: u32,\n    pub bw_probe_up_cnt: u32,\n    pub bw_probe_up_rounds: u32,\n    pub bw_probe_samples: u32,\n    pub bw_probe_up_acks: u64,\n    pub ack_phase: BbrAckPhase,\n\n    pub loss_in_round: bool,\n    pub loss_round_start: bool,\n    pub loss_round_delivered: u64,\n\n    pub is_in_recovery: bool,\n    pub is_pto_recovery: bool,\n    pub recovery_packet_number: u64,\n    pub recovery_delivered: u64,\n\n    pub is_handling_lost_feedback: bool,\n    pub cwin_before_lost_feedback: u64,\n\n    pub app_limited_round_count: i32,\n    pub app_limited_this_round: i32,\n\n    pub ecn_ect1_last_round: u64,\n    pub ecn_ce_last_round: u64,\n    pub ecn_alpha: f64,\n\n    pub random_context: u64,\n\n    pub rtt_filter: MinMaxRtt,\n    pub bdp_seed: u64,\n    pub probe_bdp_seed: bool,\n\n    pub option_string: Option<String>,\n    pub wifi_shadow_rtt: u64,\n    pub quantum_ratio: f64,\n\n    pub exp_flags: BbrExp,\n}\n\nimpl BbrState {\n    /// C: `BBRAdaptMinRttMargin` (picoquic/bbr.c:1290)\n    ///\n    /// Recompute `min_rtt_margin` as a fixed percentage of `min_rtt`\n    /// plus the transmission time of two MTU-sized packets at `max_bw`.\n    /// The margin prevents the probe-RTT timer from firing too early\n    /// when only a small amount of queuing is present.\n    pub fn adapt_min_rtt_margin(&mut self, path_x: &Path) {\n        let margin = (self.min_rtt * BBR_MIN_RTT_MARGIN_PERCENT) * 100 / 1_000_000;\n        let margin = if self.max_bw > 0 {\n            margin + 2 * path_x.send_mtu as u64 * 1_000_000 / self.max_bw\n        } else {\n            margin\n        };\n        self.min_rtt_margin = margin;\n    }\n\n    /// C: `BBRAdvanceLatestDeliverySignals` (picoquic/bbr.c:1007)\n    ///\n    /// Called near the end of ACK processing: if this ACK completed a\n    /// loss round, reset `bw_latest` and `inflight_latest` to the\n    /// current sample so the next round starts fresh.\n    pub fn advance_latest_delivery_signals(&mut self, rs: &BbrPerAckState) {\n        if self.loss_round_start {\n            self.bw_latest = rs.delivery_rate;\n            self.inflight_latest = rs.delivered;\n        }\n    }\n\n    /// C: `BBRBDPMultipleWithBw` (picoquic/bbr.c:869)\n    ///\n    /// Returns `gain × BDP` computed at the supplied `bw` rather than\n    /// `self.bw`.  When `min_rtt` has never been measured (`u64::MAX`),\n    /// returns the initial congestion window as a safe floor.\n    ///\n    /// Side-effect: writes `self.bdp` so callers can read the raw BDP\n    /// estimate after the call (mirrors C's write-through of\n    /// `bbr_state->bdp`).\n    pub fn bdp_multiple_with_bw(&mut self, path_x: &Path, gain: f64, bw: u64) -> u64 {\n        if self.min_rtt == u64::MAX {\n            return CWIN_INITIAL * path_x.send_mtu as u64;\n        }\n        // PICOQUIC_BYTES_FROM_RATE(min_rtt_us, bps) = min_rtt * bps / 1_000_000\n        self.bdp = self.min_rtt * bw / 1_000_000;\n        (gain * self.bdp as f64) as u64\n    }\n\n    /// C: `BBRBoundBWForModel` (picoquic/bbr.c:1094)\n    ///\n    /// Set `self.bw = min(max_bw, bw_lo, bw_hi)`.  `bw_hi` is only\n    /// applied when non-zero; the zero check preserves compatibility\n    /// with states where `bw_hi` is not yet initialised (noted as a\n    /// TODO in the C source).\n    pub fn bound_bw_for_model(&mut self) {\n        self.bw = self.max_bw;\n        if self.bw > self.bw_lo {\n            self.bw = self.bw_lo;\n        }\n        // TODO: remove the bw_hi != 0 guard once variables are properly\n        // initialised (mirrors the C-side TODO at bbr.c:1100).\n        if self.bw > self.bw_hi && self.bw_hi != 0 {\n            self.bw = self.bw_hi;\n        }\n    }\n\n    /// C: `BBREnterProbeRTT` (picoquic/bbr.c:1487)\n    pub fn enter_probe_rtt(&mut self, path_x: &mut Path) {\n        self.state = BbrAlgState::ProbeRtt;\n        self.pacing_gain = 1.0;\n        self.cwnd_gain = BBR_PROBE_RTT_CWND_GAIN;\n        path_x.is_cca_probing_up = false;\n    }\n\n    /// C: `BBREnterDrain` (picoquic/bbr.c:1933)\n    pub fn enter_drain(&mut self, path_x: &mut Path) {\n        // Picoquic-specific: notify transport that the startup phase is complete.\n        path_x.is_ssthresh_initialized = true;\n        self.state = BbrAlgState::Drain;\n        self.pacing_gain = 1.0 / BBR_STARTUP_CWND_GAIN; // pace slowly\n        self.cwnd_gain = BBR_STARTUP_CWND_GAIN; // maintain cwnd\n        path_x.is_cca_probing_up = false;\n    }\n\n    /// C: `BBRCheckStartupFullBandwidthGeneric` (picoquic/bbr.c:1952)\n    pub fn check_startup_full_bandwidth_generic(&mut self, rs: &BbrPerAckState, threshold: f64) {\n        if self.filled_pipe || !self.round_start || rs.is_app_limited {\n            return;\n        }\n        if self.max_bw as f64 >= threshold * self.full_bw as f64 {\n            // still growing\n            self.full_bw = self.max_bw;\n            self.full_bw_count = 0;\n            return;\n        }\n        self.full_bw_count += 1; // another round without much growth\n        if self.full_bw_count >= 3 {\n            self.filled_pipe = true;\n        }\n    }\n\n    /// C: `BBRCheckStartupFullBandwidth` (picoquic/bbr.c:2020)\n    pub fn check_startup_full_bandwidth(&mut self, rs: &BbrPerAckState) {\n        if self.filled_pipe || !self.round_start || rs.is_app_limited {\n            return;\n        }\n        // 5/4 integer approximation of ×1.25 avoids floating-point drift.\n        if 4 * self.max_bw >= 5 * self.full_bw {\n            // still growing\n            self.full_bw = self.max_bw;\n            self.full_bw_count = 0;\n            if rs.ecn_frac < 0.2 {\n                return;\n            }\n        }\n        self.full_bw_count += 1; // another round without much growth\n        if self.full_bw_count >= 3 || rs.ecn_frac >= BBR_EXCESSIVE_ECN_CE {\n            self.filled_pipe = true;\n        }\n    }\n\n    /// C: `BBRCheckAppLimitedEnded` (picoquic/bbr.c:1747)\n    ///\n    /// Tracks per-round app-limited state.  Returns `true` on the first\n    /// round where the app is *not* limited after having been limited for\n    /// more than `BBR_APP_LIMITED_ROUNDS_THRESHOLD` consecutive rounds.\n    pub fn check_app_limited_ended(&mut self, rs: &BbrPerAckState) -> bool {\n        let mut app_limited_ended = false;\n        if self.round_start {\n            if self.app_limited_this_round != 0 {\n                self.app_limited_round_count += 1;\n            } else {\n                app_limited_ended = self.app_limited_round_count > BBR_APP_LIMITED_ROUNDS_THRESHOLD;\n                self.app_limited_round_count = 0;\n            }\n            self.app_limited_this_round = 0;\n        } else {\n            self.app_limited_this_round |= rs.is_app_limited as i32;\n        }\n        app_limited_ended\n    }\n\n    /// C: `BBRExitLostFeedback` (picoquic/bbr.c:782)\n    ///\n    /// Restore the congestion window saved by `BBREnterLostFeedback` and\n    /// clear the lost-feedback flag.  No-op if the flag is not set.\n    pub fn exit_lost_feedback(&mut self, path_x: &mut Path) {\n        if self.is_handling_lost_feedback {\n            path_x.cwin = self.cwin_before_lost_feedback;\n            self.is_handling_lost_feedback = false;\n        }\n    }\n\n    /// C: `BBRHasElapsedInPhase` (picoquic/bbr.c:1776)\n    ///\n    /// Returns `true` when `current_time` has advanced past\n    /// `cycle_stamp + interval`.  Used to decide when to transition from\n    /// DOWN/CRUISE to REFILL in the probe-BW cycle.\n    pub(crate) fn has_elapsed_in_phase(&self, interval: u64, current_time: u64) -> bool {\n        current_time > self.cycle_stamp + interval\n    }\n\n    /// C: `BBREnterStartupResume` (picoquic/bbr.c:1972)\n    ///\n    /// Enter `StartupResume` state, which uses Hystart-like pacing gains\n    /// to resume quickly after a suspension.  Called either when a BDP\n    /// seed is set or on the initial `EnterStartup` path when a seed\n    /// exists.\n    pub(crate) fn enter_startup_resume(&mut self) {\n        self.state = BbrAlgState::StartupResume;\n        self.pacing_gain = BBR_STARTUP_RESUME_PACING_GAIN;\n        self.cwnd_gain = BBR_STARTUP_RESUME_CWND_GAIN;\n    }\n\n    /// C: `BBREnterStartup` (picoquic/bbr.c:2061)\n    ///\n    /// Enter normal `Startup` state with the standard pacing and cwnd\n    /// gains.  Sets `is_cca_probing_up` to inform the transport that the\n    /// congestion controller is actively probing for more bandwidth.\n    pub fn enter_startup(&mut self, path_x: &mut Path) {\n        self.state = BbrAlgState::Startup;\n        self.pacing_gain = BBR_STARTUP_PACING_GAIN;\n        self.cwnd_gain = BBR_STARTUP_CWND_GAIN;\n        path_x.is_cca_probing_up = true;\n    }\n\n    /// C: `BBREnterStartupLongRTT` (picoquic/bbr.c:2080)\n    ///\n    /// Enter `StartupLongRTT` state, which uses Hystart rather than the\n    /// normal BBR Startup algorithm.  The initial congestion window is\n    /// scaled up from `CWIN_INITIAL` proportional to `rtt_min` (capped at\n    /// the satellite-RTT ceiling) and then further boosted by the BDP seed\n    /// when available.\n    pub fn enter_startup_long_rtt(&mut self, path_x: &mut Path) {\n        let mut cwnd = CWIN_INITIAL;\n        self.state = BbrAlgState::StartupLongRtt;\n        if path_x.rtt_min > TARGET_RENO_RTT {\n            let rtt_cap = if path_x.rtt_min > TARGET_SATELLITE_RTT {\n                TARGET_SATELLITE_RTT\n            } else {\n                path_x.rtt_min\n            };\n            cwnd = (cwnd as f64 * rtt_cap.ticks() as f64 / TARGET_RENO_RTT.ticks() as f64) as u64;\n        }\n        if cwnd < self.bdp_seed {\n            cwnd = self.bdp_seed;\n        }\n        if cwnd > path_x.cwin {\n            path_x.cwin = cwnd;\n        }\n        path_x.is_cca_probing_up = true;\n    }\n\n    /// C: `BBRInitFullPipe` (picoquic/bbr.c:434)\n    ///\n    /// Reset the \"pipe full\" bandwidth-growth detector to its initial state.\n    pub fn init_full_pipe(&mut self) {\n        self.filled_pipe = false;\n        self.full_bw = 0;\n        self.full_bw_count = 0;\n    }\n\n    /// C: `BBRInitLowerBounds` (picoquic/bbr.c:1025)\n    ///\n    /// On the first congestion episode in a cycle, latch `bw_lo` to\n    /// `max_bw` and `inflight_lo` to `cwin` (the UINT64_MAX sentinel\n    /// means \"not yet initialised\").\n    pub fn init_lower_bounds(&mut self, path_x: &Path) {\n        if self.bw_lo == u64::MAX {\n            self.bw_lo = self.max_bw;\n        }\n        if self.inflight_lo == u64::MAX {\n            self.inflight_lo = path_x.cwin;\n        }\n    }\n\n    /// C: `BBRInitPacingRate` (picoquic/bbr.c:933)\n    ///\n    /// Set the initial pacing rate based on the nominal bandwidth at\n    /// `INITIAL_RTT` (250 ms), unless the path already has a real RTT\n    /// estimate, in which case that estimate is used instead.\n    pub fn init_pacing_rate(&mut self, path_x: &Path) {\n        let initial_rtt = if path_x.smoothed_rtt != INITIAL_RTT || path_x.rtt_variant.ticks() != 0 {\n            path_x.smoothed_rtt.ticks()\n        } else {\n            INITIAL_RTT.ticks()\n        };\n        let nominal_bandwidth = (1_000_000u64 * CWIN_INITIAL) as f64 / initial_rtt as f64;\n        self.pacing_rate = BBR_STARTUP_PACING_GAIN * nominal_bandwidth;\n    }\n\n    /// C: `BBRInitRandom` (picoquic/bbr.c:421)\n    ///\n    /// Seed `random_context` from the current time, connection role, and\n    /// path ID so that tests remain deterministic while production runs\n    /// diverge.  `connection` is passed separately because `Path` carries\n    /// no back-pointer to its owning `Connection` in Rust.\n    pub fn init_random(&mut self, connection: &Connection, path_x: &Path, current_time: u64) {\n        let mut ctx: u64 = 0xfedcba9876543210;\n        ctx ^= current_time;\n        if connection.client_mode {\n            ctx = ctx.wrapping_add(0x0123456789abcdef);\n        }\n        if path_x.unique_path_id > 0 && path_x.unique_path_id != u64::MAX {\n            ctx = ctx.wrapping_mul(path_x.unique_path_id.wrapping_add(1));\n        }\n        self.random_context = ctx;\n    }\n\n    /// C: `BBRInflightWithHeadroom` (picoquic/bbr.c:1547)\n    ///\n    /// Returns the inflight limit that leaves `BBRHeadroom` (15%) of the\n    /// bottleneck buffer free for competing flows.  Returns `u64::MAX`\n    /// when `inflight_hi` has not yet been measured.\n    pub fn inflight_with_headroom(&self, path_x: &Path) -> u64 {\n        const BBR_HEADROOM: f64 = 0.15;\n        const BBR_MIN_PIPE_CWND: u64 = 4;\n        if self.inflight_hi == u64::MAX {\n            return u64::MAX;\n        }\n        let headroom = ((1.0 - BBR_HEADROOM) * self.inflight_hi as f64) as u64;\n        headroom.max(BBR_MIN_PIPE_CWND * path_x.send_mtu as u64)\n    }\n\n    /// C: `BBRIsProbingBW` (picoquic/bbr.c:1532)\n    ///\n    /// Returns `true` when the state is actively probing for more bandwidth\n    /// (i.e. NOT in one of the non-probing states: ProbeBwDown, ProbeBwCruise,\n    /// Drain, or ProbeRtt).\n    pub fn is_probing_bw(&self) -> bool {\n        !matches!(\n            self.state,\n            BbrAlgState::ProbeBwDown\n                | BbrAlgState::ProbeBwCruise\n                | BbrAlgState::Drain\n                | BbrAlgState::ProbeRtt\n        )\n    }\n\n    /// C: `BBRLossLowerBounds` (picoquic/bbr.c:1035)\n    ///\n    /// Apply a `BBRBeta` (0.7) multiplicative decrease to `bw_lo` and\n    /// `inflight_lo`, then floor each at the latest sample so the model\n    /// cannot shrink below what was actually observed this round.\n    pub fn loss_lower_bounds(&mut self) {\n        self.bw_lo = ((BBR_BETA * self.bw_lo as f64) as u64).max(self.bw_latest);\n        self.inflight_lo = ((BBR_BETA * self.inflight_lo as f64) as u64).max(self.inflight_latest);\n    }\n\n    /// C: `BBRModulateCwndForRecovery` (picoquic/bbr.c:627)\n    ///\n    /// On packet loss, shrink `cwin` by the number of bytes lost (floored at\n    /// one MTU).  When `packet_conservation` is active, ensure `cwin` is at\n    /// least `bytes_in_transit + newly_acked` so the pipe stays full.\n    pub fn modulate_cwnd_for_recovery(&self, path_x: &mut Path, rs: &BbrPerAckState) {\n        if rs.newly_lost > 0 {\n            if path_x.cwin > rs.newly_lost + path_x.send_mtu as u64 {\n                path_x.cwin -= rs.newly_lost;\n            } else {\n                path_x.cwin = path_x.send_mtu as u64;\n            }\n        }\n        if self.packet_conservation && path_x.cwin < path_x.bytes_in_transit + rs.newly_acked {\n            path_x.cwin = path_x.bytes_in_transit + rs.newly_acked;\n        }\n    }\n\n    /// C: `BBRRaiseInflightHiSlope` (picoquic/bbr.c:1561)\n    ///\n    /// Recompute how aggressively `inflight_hi` is raised during ProbeBwUp.\n    /// Each round the slope doubles (shift by `bw_probe_up_rounds`, capped at\n    /// 30), and `bw_probe_up_cnt` is set to the number of MTU-sized ACKs\n    /// required to justify a one-MTU increase (minimum 1).\n    pub fn raise_inflight_hi_slope(&mut self, path_x: &Path) {\n        let growth_this_round = (path_x.send_mtu as u64) << self.bw_probe_up_rounds;\n        self.bw_probe_up_rounds = (self.bw_probe_up_rounds + 1).min(30);\n        let up_cnt = (path_x.cwin / growth_this_round) as u32;\n        self.bw_probe_up_cnt = up_cnt.max(1);\n    }\n\n    /// C: `BBRResetCongestionSignals` (picoquic/bbr.c:1014)\n    ///\n    /// Clear the per-round congestion signals so the next round starts with\n    /// a clean slate.  Called at the start of each new round.\n    pub fn reset_congestion_signals(&mut self) {\n        self.loss_in_round = false;\n        self.bw_latest = 0;\n        self.inflight_latest = 0;\n    }\n\n    /// C: `BBRResetLowerBounds` (picoquic/bbr.c:1088)\n    ///\n    /// Reset `bw_lo` and `inflight_lo` to their uninitialized sentinel\n    /// (`u64::MAX`), indicating no congestion episode has been seen yet.\n    pub fn reset_lower_bounds(&mut self) {\n        self.bw_lo = u64::MAX;\n        self.inflight_lo = u64::MAX;\n    }\n\n    /// C: `BBRResetRTTJitterBuffer` (picoquic/bbr.c:1322)\n    ///\n    /// Reinitialise the RTT jitter-buffer metadata to `rtt_init_value` and\n    /// reset the cycle counter and excess counter.  The sample array itself\n    /// is not cleared here (the caller's prior `memset` zeroes it on first\n    /// call, and valid entries are overwritten as `rtt_jitter_cycle` advances).\n    pub fn reset_rtt_jitter_buffer(&mut self, rtt_init_value: u64, current_time: u64) {\n        self.rtt_jitter_cycle = 0;\n        self.last_rtt_sample_stamp = current_time;\n        self.rtt_short_term_min = rtt_init_value;\n        self.rtt_short_term_max = rtt_init_value;\n        self.probe_rtt_min_delay = rtt_init_value;\n        self.nb_rtt_excess = 0;\n    }\n\n    /// C: `BBRRestoreCwnd` (picoquic/bbr.c:736)\n    ///\n    /// Returns whichever is larger: the cwnd saved before recovery\n    /// (`prior_cwnd`) or the current `path_x.cwin`.  Used when exiting\n    /// recovery to avoid shrinking the window below what it was before.\n    pub fn restore_cwnd(&self, path_x: &Path) -> u64 {\n        self.prior_cwnd.max(path_x.cwin)\n    }\n\n    /// C: `BBRSetPacingRateWithGain` (picoquic/bbr.c:944)\n    ///\n    /// Compute the target pacing rate as `pacing_gain × bw × (1 − margin%)`.\n    /// In `StartupResume` with a BDP seed, the rate is floored at the seed\n    /// rate to avoid sending slower than the measured path capacity.\n    /// The rate is only applied when the pipe is full or the new rate exceeds\n    /// the current one (prevents backward steps during slow-start).\n    pub fn set_pacing_rate_with_gain(&mut self, pacing_gain: f64) {\n        let rate = pacing_gain * (self.bw * (100 - BBR_PACING_MARGIN_PERCENT)) as f64 / 100.0;\n        let rate = if self.state == BbrAlgState::StartupResume\n            && !self.filled_pipe\n            && self.bdp_seed > 0\n            && self.min_rtt > 0\n            && self.min_rtt != u64::MAX\n        {\n            let bdp_rate = self.bdp_seed as f64 * 1_000_000.0 / self.min_rtt as f64;\n            rate.max(bdp_rate)\n        } else {\n            rate\n        };\n        if self.filled_pipe || rate > self.pacing_rate {\n            self.pacing_rate = rate;\n        }\n    }\n\n    /// C: `BBRSetOptions` (picoquic/bbr.c:460)\n    ///\n    /// Parse `option_string` to configure experimental flags and numeric\n    /// parameters.  `BBRExperiment` is always enabled in this build, so all\n    /// experiment flags default to `true` before any option disables them.\n    ///\n    /// Single-letter flags (toggle off the corresponding experiment):\n    /// `E` `R` `H` `L` `D` `A`.  Complex options terminated by a value:\n    /// `T<us>` → `wifi_shadow_rtt`, `Q<float>` → `quantum_ratio`.\n    pub fn set_options(&mut self) {\n        // BBRExperiment is always on.\n        self.exp_flags.do_early_exit = true;\n        self.exp_flags.do_rapid_start = true;\n        self.exp_flags.do_handle_suspension = true;\n        self.exp_flags.do_control_lost = true;\n        self.exp_flags.do_exit_probe_bw_up_on_delay = true;\n        self.exp_flags.do_enter_probe_bw_after_limited = true;\n\n        let s = match self.option_string.clone() {\n            Some(s) => s,\n            None => return,\n        };\n        let mut chars = s.chars().peekable();\n        while let Some(c) = chars.next() {\n            match c {\n                'E' => self.exp_flags.do_early_exit = false,\n                'R' => self.exp_flags.do_rapid_start = false,\n                'H' => self.exp_flags.do_handle_suspension = false,\n                'L' => self.exp_flags.do_control_lost = false,\n                'D' => self.exp_flags.do_exit_probe_bw_up_on_delay = false,\n                'A' => self.exp_flags.do_enter_probe_bw_after_limited = false,\n                'T' => {\n                    let mut u: u64 = 0;\n                    while let Some(&d) = chars.peek() {\n                        if d.is_ascii_digit() {\n                            u = u * 10 + (d as u64 - b'0' as u64);\n                            chars.next();\n                        } else {\n                            break;\n                        }\n                    }\n                    self.wifi_shadow_rtt = u;\n                }\n                'Q' => {\n                    let mut d: f64 = 0.0;\n                    let mut div: f64 = 1.0;\n                    let mut dotted = false;\n                    while let Some(&ch) = chars.peek() {\n                        if ch.is_ascii_digit() {\n                            if !dotted {\n                                d = d * 10.0 + (ch as u8 - b'0') as f64;\n                            } else {\n                                div /= 10.0;\n                                d += div * (ch as u8 - b'0') as f64;\n                            }\n                            chars.next();\n                        } else if ch == '.' {\n                            if dotted {\n                                break;\n                            }\n                            dotted = true;\n                            chars.next();\n                        } else {\n                            break;\n                        }\n                    }\n                    self.quantum_ratio = d;\n                }\n                _ => {}\n            }\n        }\n    }\n}\n\n/// C: `BBRAccessEcnPacketContext` (picoquic/bbr.c:2245)\n///\n/// Return the packet-context that carries ECN counts for `path_x`.\n///\n/// Under multipath each path has its own context; under single-path\n/// only the default path (`unique_path_id == 0`, corresponding to\n/// `cnx->path[0]` in C) participates in ECN tracking — other paths\n/// return `None`.\n///\n/// Note: in C the path held a back-pointer to its connection\n/// (`path_x->cnx`); in Rust there is no back-pointer, so the caller\n/// must supply both `connection` and `path_x`.\npub fn access_ecn_packet_context<'a>(\n    connection: &'a Connection,\n    path_x: &'a Path,\n) -> Option<&'a PacketContextState> {\n    if connection.is_multipath_enabled {\n        Some(&path_x.pkt_ctx)\n    } else if path_x.unique_path_id != 0 {\n        // Non-default path in single-path mode: ECN counts are not\n        // tracked per-path here; the caller should use the default path.\n        None\n    } else {\n        Some(&connection.pkt_ctx[PacketContext::Application as usize])\n    }\n}\n\n#[cfg(test)]\nmod tests {\n    use super::*;\n\n    fn make_state() -> BbrState {\n        BbrState {\n            state: BbrAlgState::default(),\n            round_start_pn: 0,\n            round_count: 0,\n            rounds_since_probe: 0,\n            round_start: false,\n            next_round_delivered: 0,\n            pacing_rate: 0.0,\n            send_quantum: 0,\n            prior_cwnd: 0,\n            pacing_gain: 1.0,\n            next_departure_time: 0,\n            cwnd_gain: 1.0,\n            packet_conservation: false,\n            max_bw: 0,\n            bw_hi: u64::MAX,\n            bw_lo: u64::MAX,\n            bw: 0,\n            min_rtt: u64::MAX,\n            rtt_jitter_buffer: [0; BBR_RTT_JITTER_BUFFER_LEN],\n            rtt_jitter_cycle: 0,\n            rtt_short_term_min: 0,\n            rtt_short_term_max: 0,\n            last_rtt_sample_stamp: 0,\n            nb_rtt_excess: 0,\n            rtt_too_high_in_round: false,\n            bdp: 0,\n            extra_acked: 0,\n            offload_budget: 0,\n            max_inflight: 0,\n            inflight_hi: u64::MAX,\n            inflight_lo: u64::MAX,\n            bw_latest: 0,\n            inflight_latest: 0,\n            max_bw_filter: [0; 2],\n            cycle_count: 0,\n            extra_acked_interval_start: 0,\n            extra_acked_delivered: 0,\n            extra_acked_filter: [0; 10],\n            filled_pipe: false,\n            full_bw: 0,\n            full_bw_count: 0,\n            min_rtt_stamp: 0,\n            probe_rtt_min_delay: 0,\n            probe_rtt_min_stamp: 0,\n            probe_rtt_done_stamp: 0,\n            min_rtt_margin: 0,\n            probe_rtt_expired: false,\n            probe_rtt_round_done: false,\n            idle_restart: false,\n            path_is_app_limited: false,\n            probe_probe_bw_quickly: false,\n            bw_probe_wait: 0,\n            bw_probe_ceiling: 0,\n            cycle_stamp: 0,\n            rounds_since_bw_probe: 0,\n            bw_probe_up_cnt: 0,\n            bw_probe_up_rounds: 0,\n            bw_probe_samples: 0,\n            bw_probe_up_acks: 0,\n            ack_phase: BbrAckPhase::default(),\n            loss_in_round: false,\n            loss_round_start: false,\n            loss_round_delivered: 0,\n            is_in_recovery: false,\n            is_pto_recovery: false,\n            recovery_packet_number: 0,\n            recovery_delivered: 0,\n            is_handling_lost_feedback: false,\n            cwin_before_lost_feedback: 0,\n            app_limited_round_count: 0,\n            app_limited_this_round: 0,\n            ecn_ect1_last_round: 0,\n            ecn_ce_last_round: 0,\n            ecn_alpha: 0.0,\n            random_context: 0,\n            rtt_filter: MinMaxRtt::default(),\n            bdp_seed: 0,\n            probe_bdp_seed: false,\n            option_string: None,\n            wifi_shadow_rtt: 0,\n            quantum_ratio: 0.001,\n            exp_flags: BbrExp::default(),\n        }\n    }\n\n    #[test]\n    fn bound_bw_for_model_clamps_to_lo() {\n        let mut s = make_state();\n        s.max_bw = 1000;\n        s.bw_lo = 800;\n        s.bw_hi = 0; // not yet initialised → ignored\n        s.bound_bw_for_model();\n        assert_eq!(s.bw, 800);\n    }\n\n    #[test]\n    fn bound_bw_for_model_clamps_to_hi() {\n        let mut s = make_state();\n        s.max_bw = 1000;\n        s.bw_lo = u64::MAX;\n        s.bw_hi = 900;\n        s.bound_bw_for_model();\n        assert_eq!(s.bw, 900);\n    }\n\n    #[test]\n    fn bdp_multiple_with_bw_no_rtt_sample() {\n        let mut s = make_state();\n        s.min_rtt = u64::MAX;\n        // Need a Path-like shape; use a zero send_mtu to simplify.\n        // A real Path cannot be constructed in a unit test without the full\n        // internal machinery, so we only verify the guard path indirectly via\n        // the public interface.  The guard returns CWIN_INITIAL * send_mtu;\n        // with send_mtu = 0 we get 0.\n        // (Full integration coverage comes from the cargo test suite.)\n        let _ = s.min_rtt; // use s so the compiler is happy\n    }\n\n    #[test]\n    fn advance_latest_delivery_signals_round_start() {\n        let mut s = make_state();\n        s.loss_round_start = true;\n        s.bw_latest = 0;\n        s.inflight_latest = 0;\n        let rs = BbrPerAckState {\n            delivery_rate: 500,\n            delivered: 1200,\n            ..BbrPerAckState::default()\n        };\n        s.advance_latest_delivery_signals(&rs);\n        assert_eq!(s.bw_latest, 500);\n        assert_eq!(s.inflight_latest, 1200);\n    }\n\n    #[test]\n    fn advance_latest_delivery_signals_no_round_start() {\n        let mut s = make_state();\n        s.loss_round_start = false;\n        s.bw_latest = 42;\n        s.inflight_latest = 99;\n        let rs = BbrPerAckState {\n            delivery_rate: 500,\n            delivered: 1200,\n            ..BbrPerAckState::default()\n        };\n        s.advance_latest_delivery_signals(&rs);\n        // Not a round start: values must be unchanged.\n        assert_eq!(s.bw_latest, 42);\n        assert_eq!(s.inflight_latest, 99);\n    }\n\n    // enter_probe_rtt and enter_drain write only to Path and BbrState fields;\n    // constructing a full Path in unit tests requires heavy internal machinery,\n    // so those functions are covered by the cargo compilation gate (--no-run)\n    // and by higher-level integration tests.\n\n    #[test]\n    fn check_startup_full_bandwidth_generic_growing() {\n        let mut s = make_state();\n        s.round_start = true;\n        s.full_bw = 1000;\n        s.max_bw = 1300; // >= threshold(1.25) * 1000 = 1250 → still growing\n        let rs = BbrPerAckState::default();\n        s.check_startup_full_bandwidth_generic(&rs, 1.25);\n        assert_eq!(s.full_bw, 1300);\n        assert_eq!(s.full_bw_count, 0);\n        assert!(!s.filled_pipe);\n    }\n\n    #[test]\n    fn check_startup_full_bandwidth_generic_fills_after_3_rounds() {\n        let mut s = make_state();\n        s.round_start = true;\n        s.full_bw = 1000;\n        s.max_bw = 900; // < 1.25 * 1000 → not growing\n        let rs = BbrPerAckState::default();\n        s.check_startup_full_bandwidth_generic(&rs, 1.25);\n        assert_eq!(s.full_bw_count, 1);\n        assert!(!s.filled_pipe);\n        s.check_startup_full_bandwidth_generic(&rs, 1.25);\n        assert_eq!(s.full_bw_count, 2);\n        s.check_startup_full_bandwidth_generic(&rs, 1.25);\n        assert_eq!(s.full_bw_count, 3);\n        assert!(s.filled_pipe);\n    }\n\n    #[test]\n    fn check_startup_full_bandwidth_skips_when_app_limited() {\n        let mut s = make_state();\n        s.round_start = true;\n        s.full_bw = 1000;\n        s.max_bw = 900;\n        let rs = BbrPerAckState {\n            is_app_limited: true,\n            ..BbrPerAckState::default()\n        };\n        s.check_startup_full_bandwidth(&rs);\n        assert_eq!(s.full_bw_count, 0); // skipped\n    }\n\n    #[test]\n    fn check_startup_full_bandwidth_ecn_triggers_fill() {\n        let mut s = make_state();\n        s.round_start = true;\n        s.full_bw = 1000;\n        s.max_bw = 900;\n        // ecn_frac >= 0.2 should trigger filled_pipe even on first stall\n        let rs = BbrPerAckState {\n            ecn_frac: 0.3,\n            ..BbrPerAckState::default()\n        };\n        s.check_startup_full_bandwidth(&rs);\n        assert!(s.filled_pipe);\n    }\n\n    #[test]\n    fn check_app_limited_ended_accumulates_and_detects() {\n        let mut s = make_state();\n        // Simulate 4 app-limited rounds (> threshold of 3).\n        for _ in 0..4 {\n            s.round_start = true;\n            s.app_limited_this_round = 1;\n            let rs = BbrPerAckState::default();\n            let ended = s.check_app_limited_ended(&rs);\n            assert!(!ended);\n        }\n        // Now a non-app-limited round at round_start should return true.\n        s.round_start = true;\n        s.app_limited_this_round = 0;\n        let rs = BbrPerAckState::default();\n        let ended = s.check_app_limited_ended(&rs);\n        assert!(ended);\n        assert_eq!(s.app_limited_round_count, 0);\n    }\n\n    #[test]\n    fn check_app_limited_ended_mid_round_accumulates_flag() {\n        let mut s = make_state();\n        s.round_start = false;\n        s.app_limited_this_round = 0;\n        let rs = BbrPerAckState {\n            is_app_limited: true,\n            ..BbrPerAckState::default()\n        };\n        let ended = s.check_app_limited_ended(&rs);\n        assert!(!ended);\n        assert_eq!(s.app_limited_this_round, 1);\n    }\n\n    #[test]\n    fn has_elapsed_in_phase_true_when_past_deadline() {\n        let s = make_state(); // cycle_stamp = 0\n        assert!(s.has_elapsed_in_phase(100, 101));\n    }\n\n    #[test]\n    fn has_elapsed_in_phase_false_when_at_deadline() {\n        let s = make_state(); // cycle_stamp = 0\n        assert!(!s.has_elapsed_in_phase(100, 100)); // current_time must be strictly >\n    }\n\n    #[test]\n    fn has_elapsed_in_phase_respects_cycle_stamp() {\n        let mut s = make_state();\n        s.cycle_stamp = 500;\n        assert!(!s.has_elapsed_in_phase(100, 599));\n        assert!(s.has_elapsed_in_phase(100, 601));\n    }\n\n    #[test]\n    fn exit_lost_feedback_restores_cwin_and_clears_flag() {\n        // exit_lost_feedback requires Path, so we only test the BbrState\n        // side-effect that is path-independent: when the flag is already\n        // clear the function must be a no-op (no panic).\n        let mut s = make_state();\n        s.is_handling_lost_feedback = false;\n        s.cwin_before_lost_feedback = 9999;\n        // We cannot call exit_lost_feedback here without a Path, but we can\n        // verify the guard: the function reads `is_handling_lost_feedback`\n        // first.  Full coverage comes from the integration tests.\n        let _ = s.cwin_before_lost_feedback; // used\n    }\n\n    #[test]\n    fn enter_startup_resume_sets_state_and_gains() {\n        let mut s = make_state();\n        s.enter_startup_resume();\n        assert_eq!(s.state, BbrAlgState::StartupResume);\n        assert!((s.pacing_gain - BBR_STARTUP_RESUME_PACING_GAIN).abs() < f64::EPSILON);\n        assert!((s.cwnd_gain - BBR_STARTUP_RESUME_CWND_GAIN).abs() < f64::EPSILON);\n    }\n\n    // enter_startup and enter_startup_long_rtt mutate Path fields\n    // (is_cca_probing_up, cwin); constructing a full Path requires\n    // the heavy internal machinery.  Those are covered by the cargo\n    // compilation gate and integration tests.\n\n    #[test]\n    fn reset_lower_bounds_sets_sentinels() {\n        let mut s = make_state();\n        s.bw_lo = 1234;\n        s.inflight_lo = 5678;\n        s.reset_lower_bounds();\n        assert_eq!(s.bw_lo, u64::MAX);\n        assert_eq!(s.inflight_lo, u64::MAX);\n    }\n\n    #[test]\n    fn reset_rtt_jitter_buffer_initialises_fields() {\n        let mut s = make_state();\n        let rtt_init = 50_000u64;\n        let now = 1_000_000u64;\n        s.reset_rtt_jitter_buffer(rtt_init, now);\n        assert_eq!(s.rtt_jitter_cycle, 0);\n        assert_eq!(s.last_rtt_sample_stamp, now);\n        assert_eq!(s.rtt_short_term_min, rtt_init);\n        assert_eq!(s.rtt_short_term_max, rtt_init);\n        assert_eq!(s.probe_rtt_min_delay, rtt_init);\n        assert_eq!(s.nb_rtt_excess, 0);\n    }\n\n    #[test]\n    fn set_pacing_rate_with_gain_increases_rate() {\n        let mut s = make_state();\n        s.bw = 1_000_000; // 1 Mbps\n        s.pacing_rate = 0.0;\n        s.filled_pipe = false;\n        s.set_pacing_rate_with_gain(1.0);\n        // rate = 1.0 * 1_000_000 * 99 / 100 = 990_000\n        assert!((s.pacing_rate - 990_000.0).abs() < 1.0);\n    }\n\n    #[test]\n    fn set_pacing_rate_with_gain_does_not_decrease() {\n        let mut s = make_state();\n        s.bw = 1_000_000;\n        s.pacing_rate = 2_000_000.0;\n        s.filled_pipe = false;\n        s.set_pacing_rate_with_gain(1.0);\n        // new rate (990_000) < current (2_000_000) and not filled_pipe → no update\n        assert!((s.pacing_rate - 2_000_000.0).abs() < 1.0);\n    }\n\n    #[test]\n    fn set_pacing_rate_with_gain_updates_when_filled_pipe() {\n        let mut s = make_state();\n        s.bw = 1_000_000;\n        s.pacing_rate = 2_000_000.0;\n        s.filled_pipe = true;\n        s.set_pacing_rate_with_gain(1.0);\n        // filled_pipe → always update\n        assert!((s.pacing_rate - 990_000.0).abs() < 1.0);\n    }\n\n    #[test]\n    fn set_options_defaults_to_all_experiment_flags_enabled() {\n        let mut s = make_state();\n        s.option_string = None;\n        s.set_options();\n        assert!(s.exp_flags.do_early_exit);\n        assert!(s.exp_flags.do_rapid_start);\n        assert!(s.exp_flags.do_handle_suspension);\n        assert!(s.exp_flags.do_control_lost);\n        assert!(s.exp_flags.do_exit_probe_bw_up_on_delay);\n        assert!(s.exp_flags.do_enter_probe_bw_after_limited);\n    }\n\n    #[test]\n    fn set_options_single_letter_flags_disable_experiments() {\n        let mut s = make_state();\n        s.option_string = Some(\"ERHLD\".to_string());\n        s.set_options();\n        assert!(!s.exp_flags.do_early_exit);\n        assert!(!s.exp_flags.do_rapid_start);\n        assert!(!s.exp_flags.do_handle_suspension);\n        assert!(!s.exp_flags.do_control_lost);\n        assert!(!s.exp_flags.do_exit_probe_bw_up_on_delay);\n        // 'A' not present → still true\n        assert!(s.exp_flags.do_enter_probe_bw_after_limited);\n    }\n\n    #[test]\n    fn set_options_parses_wifi_shadow_rtt() {\n        let mut s = make_state();\n        s.option_string = Some(\"T12345\".to_string());\n        s.set_options();\n        assert_eq!(s.wifi_shadow_rtt, 12345);\n    }\n\n    #[test]\n    fn set_options_parses_quantum_ratio_integer() {\n        let mut s = make_state();\n        s.option_string = Some(\"Q2\".to_string());\n        s.set_options();\n        assert!((s.quantum_ratio - 2.0).abs() < 1e-9);\n    }\n\n    #[test]\n    fn set_options_parses_quantum_ratio_decimal() {\n        let mut s = make_state();\n        s.option_string = Some(\"Q1.5\".to_string());\n        s.set_options();\n        assert!((s.quantum_ratio - 1.5).abs() < 1e-9);\n    }\n}\n","numLines":1133,"startLine":1,"totalLines":1133}}}
