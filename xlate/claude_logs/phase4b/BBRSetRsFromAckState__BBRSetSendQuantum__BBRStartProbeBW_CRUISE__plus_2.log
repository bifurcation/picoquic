{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01X1KqPWk7TkvfT9BWSq1pMq","type":"tool_result","content":"960\t}\n961\t\n962\tstatic void  BBRSetPacingRate(picoquic_bbr_state_t* bbr_state)\n963\t{\n964\t    BBRSetPacingRateWithGain(bbr_state, bbr_state->pacing_gain);\n965\t}\n966\t\n967\tstatic void BBRSetSendQuantum(picoquic_bbr_state_t* bbr_state, picoquic_path_t* path_x)\n968\t{\n969\t    /* 1.2 Mbps = 150 kBps = 150000Bps  */\n970\t    uint64_t floor = 2 * path_x->send_mtu;\n971\t    if (bbr_state->pacing_rate < 150000) {\n972\t        floor = 1 * path_x->send_mtu;\n973\t    }\n974\t    /* 1 ms = 1000000us/1000 */\n975\t    bbr_state->send_quantum = (uint64_t)(bbr_state->pacing_rate * bbr_state->quantum_ratio); \n976\t    if (bbr_state->send_quantum > 0x10000) {\n977\t        bbr_state->send_quantum = 0x10000;\n978\t    }\n979\t    if (bbr_state->send_quantum < floor) {\n980\t        bbr_state->send_quantum = floor;\n981\t    }\n982\t}\n983\t\n984\t\n985\t/* Path model functions when not probing for bandwith */\n986\t  /* Near start of ACK processing: */\n987\tstatic void BBRUpdateLatestDeliverySignals(picoquic_bbr_state_t* bbr_state, picoquic_path_t* path_x, bbr_per_ack_state_t * rs)\n988\t{\n989\t    /* BBR.bw_latest = max(BBR.bw_latest, rs.delivery_rate) */\n990\t    bbr_state->loss_round_start = 0;\n991\t    if (bbr_state->bw_latest < rs->delivery_rate) {\n992\t        bbr_state->bw_latest = rs->delivery_rate;\n993\t    }\n994\t    /* BBR.inflight_latest = max(BBR.inflight_latest, rs.delivered) */\n995\t    if (bbr_state->inflight_latest < rs->delivered) {\n996\t        bbr_state->inflight_latest = rs->delivered;\n997\t    }\n998\t    \n999\t    uint64_t prior_delivered = path_x->delivered - rs->delivered;\n1000\t    if (prior_delivered >= bbr_state->loss_round_delivered) {\n1001\t        bbr_state->loss_round_delivered = path_x->delivered;\n1002\t        bbr_state->loss_round_start = 1;\n1003\t    }\n1004\t}\n1005\t\n1006\t  /* Near end of ACK processing: */\n1007\tstatic void BBRAdvanceLatestDeliverySignals(picoquic_bbr_state_t* bbr_state, bbr_per_ack_state_t * rs) {\n1008\t    if (bbr_state->loss_round_start) {\n1009\t        bbr_state->bw_latest = rs->delivery_rate;\n1010\t        bbr_state->inflight_latest = rs->delivered;\n1011\t    }\n1012\t}\n1013\t\n1014\tstatic void BBRResetCongestionSignals(picoquic_bbr_state_t* bbr_state)\n1015\t{\n1016\t    bbr_state->loss_in_round = 0;\n1017\t#ifdef RTTJitterBuffer\n1018\t    bbr_state->rtt_too_high_in_round = 0;\n1019\t#endif\n1020\t    bbr_state->bw_latest = 0;\n1021\t    bbr_state->inflight_latest = 0;\n1022\t}\n1023\t\n1024\t/* Handle the first congestion episode in this cycle */\n1025\tstatic void BBRInitLowerBounds(picoquic_bbr_state_t* bbr_state, picoquic_path_t* path_x)\n1026\t{\n1027\t    if (bbr_state->bw_lo == UINT64_MAX) {\n1028\t        bbr_state->bw_lo = bbr_state->max_bw;\n1029\t    }\n1030\t    if (bbr_state->inflight_lo == UINT64_MAX) {\n1031\t        bbr_state->inflight_lo = path_x->cwin;\n1032\t    }\n1033\t}\n1034\t\n1035\t/* Adjust model once per round based on loss */\n1036\tstatic void BBRLossLowerBounds(picoquic_bbr_state_t* bbr_state)\n1037\t{\n1038\t    /* set: bw_lo = max(bw_latest, bw_lo*BBRBeta) */\n1039\t    bbr_state->bw_lo = (uint64_t)(BBRBeta * (double)bbr_state->bw_lo);"}]},"parent_tool_use_id":null,"session_id":"5be31241-b87d-4d1b-a6ec-ddeef1119c85","uuid":"4d2555df-479a-432d-86f9-b05ce30eb3b1","timestamp":"2026-05-07T04:58:22.721Z","tool_use_result":{"type":"text","file":{"filePath":"/Users/richbarn/Projects/picoquic/picoquic/bbr.c","content":"}\n\nstatic void  BBRSetPacingRate(picoquic_bbr_state_t* bbr_state)\n{\n    BBRSetPacingRateWithGain(bbr_state, bbr_state->pacing_gain);\n}\n\nstatic void BBRSetSendQuantum(picoquic_bbr_state_t* bbr_state, picoquic_path_t* path_x)\n{\n    /* 1.2 Mbps = 150 kBps = 150000Bps  */\n    uint64_t floor = 2 * path_x->send_mtu;\n    if (bbr_state->pacing_rate < 150000) {\n        floor = 1 * path_x->send_mtu;\n    }\n    /* 1 ms = 1000000us/1000 */\n    bbr_state->send_quantum = (uint64_t)(bbr_state->pacing_rate * bbr_state->quantum_ratio); \n    if (bbr_state->send_quantum > 0x10000) {\n        bbr_state->send_quantum = 0x10000;\n    }\n    if (bbr_state->send_quantum < floor) {\n        bbr_state->send_quantum = floor;\n    }\n}\n\n\n/* Path model functions when not probing for bandwith */\n  /* Near start of ACK processing: */\nstatic void BBRUpdateLatestDeliverySignals(picoquic_bbr_state_t* bbr_state, picoquic_path_t* path_x, bbr_per_ack_state_t * rs)\n{\n    /* BBR.bw_latest = max(BBR.bw_latest, rs.delivery_rate) */\n    bbr_state->loss_round_start = 0;\n    if (bbr_state->bw_latest < rs->delivery_rate) {\n        bbr_state->bw_latest = rs->delivery_rate;\n    }\n    /* BBR.inflight_latest = max(BBR.inflight_latest, rs.delivered) */\n    if (bbr_state->inflight_latest < rs->delivered) {\n        bbr_state->inflight_latest = rs->delivered;\n    }\n    \n    uint64_t prior_delivered = path_x->delivered - rs->delivered;\n    if (prior_delivered >= bbr_state->loss_round_delivered) {\n        bbr_state->loss_round_delivered = path_x->delivered;\n        bbr_state->loss_round_start = 1;\n    }\n}\n\n  /* Near end of ACK processing: */\nstatic void BBRAdvanceLatestDeliverySignals(picoquic_bbr_state_t* bbr_state, bbr_per_ack_state_t * rs) {\n    if (bbr_state->loss_round_start) {\n        bbr_state->bw_latest = rs->delivery_rate;\n        bbr_state->inflight_latest = rs->delivered;\n    }\n}\n\nstatic void BBRResetCongestionSignals(picoquic_bbr_state_t* bbr_state)\n{\n    bbr_state->loss_in_round = 0;\n#ifdef RTTJitterBuffer\n    bbr_state->rtt_too_high_in_round = 0;\n#endif\n    bbr_state->bw_latest = 0;\n    bbr_state->inflight_latest = 0;\n}\n\n/* Handle the first congestion episode in this cycle */\nstatic void BBRInitLowerBounds(picoquic_bbr_state_t* bbr_state, picoquic_path_t* path_x)\n{\n    if (bbr_state->bw_lo == UINT64_MAX) {\n        bbr_state->bw_lo = bbr_state->max_bw;\n    }\n    if (bbr_state->inflight_lo == UINT64_MAX) {\n        bbr_state->inflight_lo = path_x->cwin;\n    }\n}\n\n/* Adjust model once per round based on loss */\nstatic void BBRLossLowerBounds(picoquic_bbr_state_t* bbr_state)\n{\n    /* set: bw_lo = max(bw_latest, bw_lo*BBRBeta) */\n    bbr_state->bw_lo = (uint64_t)(BBRBeta * (double)bbr_state->bw_lo);","numLines":80,"startLine":960,"totalLines":2486}}}
