_limited_ended\n333\t    }\n334\t}\n335\t\n336\t/// C: `BBRAccessEcnPacketContext` (picoquic/bbr.c:2245)\n337\t///\n338\t/// Return the packet-context that carries ECN counts for `path_x`.\n339\t///\n340\t/// Under multipath each path has its own context; under single-path\n341\t/// only the default path (`unique_path_id == 0`, corresponding to\n342\t/// `cnx->path[0]` in C) participates in ECN tracking — other paths\n343\t/// return `None`.\n344\t///\n345\t/// Note: in C the path held a back-pointer to its connection\n346\t/// (`path_x->cnx`); in Rust there is no back-pointer, so the caller\n347\t/// must supply both `connection` and `path_x`.\n348\tpub fn access_ecn_packet_context<'a>(\n349\t    connection: &'a Connection,\n350\t    path_x: &'a Path,\n351\t) -> Option<&'a PacketContextState> {\n352\t    if connection.is_multipath_enabled {\n353\t        Some(&path_x.pkt_ctx)\n354\t    } else if path_x.unique_path_id != 0 {\n355\t        // Non-default path in single-path mode: ECN counts are not\n356\t        // tracked per-path here; the caller should use the default path.\n357\t        None\n358\t    } else {\n359\t        Some(&connection.pkt_ctx[PacketContext::Application as usize])\n360\t    }\n361\t}\n362\t\n363\t#[cfg(test)]\n364\tmod tests {\n365\t    use super::*;\n366\t\n367\t    fn make_state() -> BbrState {\n368\t        BbrState {\n369\t            state: BbrAlgState::default(),\n370\t            round_start_pn: 0,\n371\t            round_count: 0,\n372\t            rounds_since_probe: 0,\n373\t            round_start: false,\n374\t            next_round_delivered: 0,\n375\t            pacing_rate: 0.0,\n376\t            send_quantum: 0,\n377\t            prior_cwnd: 0,\n378\t            pacing_gain: 1.0,\n379\t            next_departure_time: 0,\n380\t            cwnd_gain: 1.0,\n381\t            packet_conservation: false,\n382\t            max_bw: 0,\n383\t            bw_hi: u64::MAX,\n384\t            bw_lo: u64::MAX,\n385\t            bw: 0,\n386