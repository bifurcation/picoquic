{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_017mWK9bmXE3MDW3VoV23P59","type":"tool_result","content":"770\t        !bbr_state->is_handling_lost_feedback &&\n771\t        path_x->cnx->cnx_state == picoquic_state_ready) {\n772\t        /* Remembering the old cwin, so the state can be restored when the\n773\t        * condition is lifted. */\n774\t        bbr_state->cwin_before_lost_feedback = path_x->cwin;\n775\t        /* setting the congestion window to exactly the bytes in transit, thus\n776\t         * preventing any further transmission until the condition is lifted */\n777\t        path_x->cwin = path_x->bytes_in_transit;\n778\t        bbr_state->is_handling_lost_feedback = 1;\n779\t    }\n780\t}\n781\t\n782\tstatic void BBRExitLostFeedback(picoquic_bbr_state_t* bbr_state, picoquic_path_t* path_x)\n783\t{\n784\t    if (bbr_state->is_handling_lost_feedback) {\n785\t        path_x->cwin = bbr_state->cwin_before_lost_feedback;\n786\t        bbr_state->is_handling_lost_feedback = 0;\n787\t    }\n788\t}\n789\t\n790\t/* In picoquic, the arrival of an RTO maps to a \"timer based\" packet loss.\n791\t* Question: do we want this on a loss signal, or simply when observing\n792\t* loss data in ack notification?\n793\t */\n794\tstatic void BBROnEnterRTO(picoquic_bbr_state_t* bbr_state, picoquic_path_t* path_x, uint64_t lost_packet_number)\n795\t{\n796\t    if (!bbr_state->is_in_recovery) {\n797\t        bbr_state->prior_cwnd = BBRSaveCwnd(bbr_state, path_x);\n798\t        bbr_state->is_in_recovery = 1;\n799\t    }"}]},"parent_tool_use_id":null,"session_id":"b60c8fe4-bb4e-418b-8ff6-93e162ed7f11","uuid":"08b4cab0-a0ce-477f-a959-4c9351fe22cc","timestamp":"2026-05-07T03:11:14.349Z","tool_use_result":{"type":"text","file":{"filePath":"/Users/richbarn/Projects/picoquic/picoquic/bbr.c","content":"        !bbr_state->is_handling_lost_feedback &&\n        path_x->cnx->cnx_state == picoquic_state_ready) {\n        /* Remembering the old cwin, so the state