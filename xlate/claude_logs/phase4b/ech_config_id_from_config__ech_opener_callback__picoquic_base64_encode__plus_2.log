{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01TP3uu5gvxhdEjdKynQpEJ6","type":"tool_result","content":"1\t/*\n2\t* Author: Christian Huitema\n3\t* Copyright (c) 2019, Private Octopus, Inc.\n4\t* All rights reserved.\n5\t*\n6\t* Permission to use, copy, modify, and distribute this software for any\n7\t* purpose with or without fee is hereby granted, provided that the above\n8\t* copyright notice and this permission notice appear in all copies.\n9\t*\n10\t* THIS SOFTWARE IS PROVIDED BY THE COPYRIGHT HOLDERS AND CONTRIBUTORS \"AS IS\" AND\n11\t* ANY EXPRESS OR IMPLIED WARRANTIES, INCLUDING, BUT NOT LIMITED TO, THE IMPLIED\n12\t* WARRANTIES OF MERCHANTABILITY AND FITNESS FOR A PARTICULAR PURPOSE ARE\n13\t* DISCLAIMED. IN NO EVENT SHALL Private Octopus, Inc. BE LIABLE FOR ANY\n14\t* DIRECT, INDIRECT, INCIDENTAL, SPECIAL, EXEMPLARY, OR CONSEQUENTIAL DAMAGES\n15\t* (INCLUDING, BUT NOT LIMITED TO, PROCUREMENT OF SUBSTITUTE GOODS OR SERVICES;\n16\t* LOSS OF USE, DATA, OR PROFITS; OR BUSINESS INTERRUPTION) HOWEVER CAUSED AND\n17\t* ON ANY THEORY OF LIABILITY, WHETHER IN CONTRACT, STRICT LIABILITY, OR TORT\n18\t* (INCLUDING NEGLIGENCE OR OTHERWISE) ARISING IN ANY WAY OUT OF THE USE OF THIS\n19\t* SOFTWARE, EVEN IF ADVISED OF THE POSSIBILITY OF SUCH DAMAGE.\n20\t*/\n21\t\n22\t#include \"picoquic_internal.h\"\n23\t#include \"picoquic_utils.h\"\n24\t#include \"picosocks.h\"\n25\t#include \"tls_api.h\"\n26\t#ifdef _WINDOWS\n27\t#include \"wincompat.h\"\n28\t#pragma warning(disable:4204)\n29\t#endif\n30\t#include <picotls.h>\n31\t#ifdef _WINDOWS\n32\t#include <picotls\\pembase64.h>\n33\t#include <picotls\\minicrypto.h>\n34\t#include <picotls\\asn1.h>\n35\t#else\n36\t#include <picotls/pembase64.h>\n37\t#include <picotls/minicrypto.h>\n38\t#include <picotls/asn1.h>\n39\t#endif\n40\t#include <stddef.h>\n41\t#include <stdlib.h>\n42\t#include <string.h>\n43\ttypedef const struct st_ptls_cipher_suite_t ptls_cipher_suite_t;\n44\t#include \"picoquic_crypto_provider_api.h\"\n45\t\n46\t/* Decode a base64 string. This is not strictly ECH related, \n47\t* but applications cannot easily access the base64 implementation in\n48\t* picotls.\n49\t*/\n50\tint picoquic_base64_decode(uint8_t** v, size_t* v_len, char const* b64_txt)\n51\t{\n52\t    int ret = 0;\n53\t    ptls_buffer_t config;\n54\t    uint8_t short_buf[256];\n55\t    ptls_base64_decode_state_t d_state;\n56\t    *v = NULL;\n57\t    *v_len = 0;\n58\t    ptls_buffer_init(&config, short_buf, sizeof(short_buf));\n59\t    ptls_base64_decode_init(&d_state);\n60\t    ret = ptls_base64_decode(b64_txt, &d_state, &config);\n61\t    if (ret == 0 && (d_state.status == PTLS_BASE64_DECODE_DONE || (d_state.status == PTLS_BASE64_DECODE_IN_PROGRESS && d_state.nbc == 0))) {\n62\t        ret = 0;\n63\t        if (config.off > 0) {\n64\t            if ((*v = (uint8_t*)malloc(config.off)) == NULL) {\n65\t                ret = PICOQUIC_ERROR_MEMORY;\n66\t            }\n67\t            else {\n68\t                memcpy(*v, config.base, config.off);\n69\t                *v_len = config.off;\n70\t            }\n71\t        }\n72\t    }\n73\t    ptls_buffer_dispose(&config);\n74\t    return ret;\n75\t}\n76\t/* Encode a base64 string. This is not strictly ECH related,\n77\t* but applications cannot easily access the base64 implementation in\n78\t* picotls.\n79\t*/\n80\tint picoquic_base64_encode(const uint8_t* v, size_t v_len, char* b64, size_t b64_size, size_t* b64_len)\n81\t{\n82\t\n83\t    int ret = 0;\n84\t    size_t len = ptls_base64_howlong(v_len);\n85\t    *b64_len = len;\n86\t    if (len + 1 > b64_size) {\n87\t        ret = -1;\n88\t    }\n89\t    else {\n90\t        (void)ptls_base64_encode(v, v_len, b64);\n91\t    }\n92\t    return ret;\n93\t}\n94\t\n95\t/* Read the configuration file.\n96\t* We assume that it contains exactly one config, in base 64 encoding. \n97\t */\n98\tint picoquic_ech_read_config(ptls_buffer_t * config, char const * config_file_name)\n99\t{\n100\t    int ret = 0;\n101\t    char buffer[1024];\n102\t    FILE* F = picoquic_file_open(config_file_name, \"r\");\n103\t    if (F == NULL) {\n104\t        ret = -1;\n105\t    }\n106\t    else {\n107\t        ptls_base64_decode_state_t d_state;\n108\t        ptls_base64_decode_init(&d_state);\n109\t        while (fgets(buffer, sizeof(buffer), F) != NULL) {\n110\t            ret = ptls_base64_decode(buffer, &d_state, config);\n111\t        }\n112\t        if (d_state.status == PTLS_BASE64_DECODE_DONE || (d_state.status == PTLS_BASE64_DECODE_IN_PROGRESS && d_state.nbc == 0)) {\n113\t            ret = 0;\n114\t        }\n115\t        else {\n116\t            ret = PTLS_ERROR_INCORRECT_BASE64;\n117\t        }\n118\t        F=picoquic_file_close(F);\n119\t        if (ret == 0) {\n120\t            DBG_PRINTF(\"Got %zu bytes from %s\", config->off, config_file_name);\n121\t        }\n122\t    }\n123\t    return ret;\n124\t}\n125\t\n126\t\n127\tint picoquic_ech_save_config(uint8_t* config, size_t config_len, char const* file_name)\n128\t{\n129\t    int ret = 0;\n130\t    int last_err;\n131\t    size_t ech_text_size = 0;\n132\t    size_t ech_text_len = 0;\n133\t    char* ech_text = NULL;\n134\t\n135\t    (void)picoquic_base64_encode(config, config_len, ech_text, ech_text_size, &ech_text_len);\n136\t    ech_text_size = ech_text_len + 1;\n137\t    ech_text = (char*)malloc(ech_text_size);\n138\t\n139\t    if (ech_text == NULL) {\n140\t        DBG_PRINTF(\"Cannot allocate %d bytes for text buffer\", ech_text_size);\n141\t        ret = -1;\n142\t    }\n143\t    else {\n144\t        ret = picoquic_base64_encode(config, config_len, ech_text, ech_text_size, &ech_text_len);\n145\t    }\n146\t    if (ret == 0) {\n147\t        FILE* F = picoquic_file_open_ex(file_name, \"w\", &last_err);\n148\t        if (F == NULL) {\n149\t            DBG_PRINTF(\"Cannot open file <%s>, err: %x\", file_name, last_err);\n150\t            ret = -1;\n151\t        }\n152\t        else {\n153\t            size_t written = fwrite(ech_text, 1, ech_text_size, F);\n154\t            if (written != ech_text_size) {\n155\t                DBG_PRINTF(\"Cannot write %d bytes on file <%s>, err= %zu\", ech_text, file_name, written);\n156\t                ret = -1;\n157\t            }\n158\t            else {\n159\t                (void)fprintf(F, \"\\n\");\n160\t                DBG_PRINTF(\"Wrote %d bytes on file <%s>\", ech_text_size + 1, file_name);\n161\t            }\n162\t            picoquic_file_close(F);\n163\t        }\n164\t    }\n165\t    if (ech_text != NULL) {\n166\t        free(ech_text);\n167\t    }\n168\t    return ret;\n169\t}\n170\t\n171\t/*\n172\t* The ECH extension in TLS is defined as:\n173\t*       enum { outer(0), inner(1) } ECHClientHelloType;\n174\t*\n175\t*       struct {\n176\t*          ECHClientHelloType type;\n177\t*          select (ECHClientHello.type) {\n178\t*              case outer:\n179\t*                  HpkeSymmetricCipherSuite cipher_suite;\n180\t*                  uint8 config_id;\n181\t*                  opaque enc<0..2^16-1>;\n182\t*                  opaque payload<1..2^16-1>;\n183\t*              case inner:\n184\t*                  Empty;\n185\t*          };\n186\t*       } ECHClientHello;\n187\t* \n188\t* On the server side, picotls decode the \"cipher_suite\" and \"config_id\"\n189\t* parameters, and the \"enc\" prefix, and then call the \"create_opener\"\n190\t* callback, documented in the PTLS context as ech.server.create_opener.\n191\t* \n192\t* It is called as: \n193\t* tls->ech.aead = tls->ctx->ech.server.create_opener->cb(\n194\t*                     tls->ctx->ech.server.create_opener, &tls->ech.kem, &tls->ech.cipher, tls, ch->ech.config_id,\n195\t*                     ch->ech.cipher_suite, ch->ech.enc, ptls_iovec_init(ech_info_prefix, sizeof(ech_info_prefix)))\n196\t* \n197\t* The opener signature is:\n198\t* \n199\t* ptls_aead_context_t* ech_opener_callback(ptls_ech_create_opener_t * self,\n200\t*     ptls_hpke_kem_t** kem, ptls_hpke_cipher_suite_t** cipher, ptls_t* tls, \n201\t*    uint8_t config_id, ptls_hpke_cipher_suite_id_t cipher_id, ptls_iovec_t enc, ptls_iovec_t info_prefix)\n202\t* \n203\t* with the following parameters:\n204\t* \n205\t* - \"self\" points to the \"callback\" structure documented in the \n206\t* ptls context as ech.server.create_opener. Its first member is the \"cb\" pointer\n207\t* to the function, followed by implementation specific parameters.\n208\t* - \"kem\" and \"cipher\" are output parameters, to be set by the callback.\n209\t* - \"tls\" is the ptls context\n210\t* - \"config_id\" and \"cipher_id\" are decoded from the \"config_id\" and \"cipher_suite\"\n211\t*   parameters of the ECH extension in the client hello\n212\t* - \"enc\" points to the content of the \"enc\" field of the ECH extension, i.e.,\n213\t*   the HPKE encapsulated key.\n214\t* - \"info_prefix\" points to the constant used when deriving the ECH keys -- in the\n215\t*   current code, this is set to \"tls ech\".\n216\t*\n217\t* The callback should find a configuration that matches the config_id, then\n218\t* perform the specified key exchange and derive the aead key used to encrypt\n219\t* the payload.\n220\t*/\n221\t\n222\ttypedef struct st_ech_opener_callback_t {\n223\t    ptls_ech_create_opener_t super;\n224\t    ptls_hpke_kem_t* kem;\n225\t    ptls_key_exchange_context_t* keyex;\n226\t    ptls_buffer_t config;\n227\t} ech_opener_callback_t;\n228\t\n229\t\n230\t/* Find the config based on the config ID */\n231\t/* Perform the key exchange using the public key provided by the client\n232\t * in the \"enc\" parameter and the private key corresponding to the config ID */\n233\tptls_aead_context_t* ech_opener_callback(ptls_ech_create_opener_t * cb,\n234\t    ptls_hpke_kem_t** p_kem, ptls_hpke_cipher_suite_t** cipher, ptls_t* UNUSED(tls), \n235\t    uint8_t UNUSED(config_id), ptls_hpke_cipher_suite_id_t cipher_id, ptls_iovec_t enc, ptls_iovec_t info_prefix)\n236\t{\n237\t    ptls_aead_context_t* aead = NULL;\n238\t    ptls_buffer_t infobuf;\n239\t    int ret = 0;\n240\t    ech_opener_callback_t* ech_cb = (ech_opener_callback_t*)cb;\n241\t\n242\t    *cipher = NULL;\n243\t    for (size_t i = 0; picoquic_hpke_cipher_suites[i] != NULL; ++i) {\n244\t        if (picoquic_hpke_cipher_suites[i]->id.kdf == cipher_id.kdf &&\n245\t            picoquic_hpke_cipher_suites[i]->id.aead == cipher_id.aead) {\n246\t            *cipher = picoquic_hpke_cipher_suites[i];\n247\t            break;\n248\t        }\n249\t    }\n250\t    if (*cipher == NULL)\n251\t        return NULL;\n252\t    *p_kem = ech_cb->kem;\n253\t\n254\t    /* Compose the \"info\" field by combining the \"info_prefix\" and the selected configuration.\n255\t    * In the unit test example, the binary string is preceded by a two bytes of length, with\n256\t    * an added null byte at the end.\n257\t    */\n258\t\n259\t    ptls_buffer_init(&infobuf, \"\", 0);\n260\t    ptls_buffer_pushv(&infobuf, info_prefix.base, info_prefix.len);\n261\t    ptls_buffer_pushv(&infobuf, ech_cb->config.base+2, ech_cb->config.off - 2);\n262\t    ret = ptls_hpke_setup_base_r(ech_cb->kem, *cipher, ech_cb->keyex, &aead, enc,\n263\t        ptls_iovec_init(infobuf.base, infobuf.off));\n264\tExit:\n265\t    ptls_buffer_dispose(&infobuf);\n266\t    return aead;\n267\t}\n268\t\n269\t/* Dispose of the ech callback. */\n270\tstatic void ech_dispose_opener_callback(ech_opener_callback_t* ech_cb)\n271\t{\n272\t    if (picoquic_keyex_dispose_fn != NULL && ech_cb->keyex != NULL) {\n273\t        picoquic_keyex_dispose_fn(ech_cb->keyex);\n274\t    }\n275\t    ptls_buffer_dispose(&ech_cb->config);\n276\t    memset(ech_cb, 0, sizeof(ech_opener_callback_t));\n277\t    free(ech_cb);\n278\t}\n279\t\n280\t/* Initialize the opener structure */\n281\tstatic int ech_init_opener_callback(ech_opener_callback_t** p_ech_cb, char const * private_key_file, char const* config_file_name)\n282\t{\n283\t    int ret = 0;\n284\t    /* Allocate an opener callback */\n285\t    ech_opener_callback_t* ech_cb = (ech_opener_callback_t*)malloc(sizeof(ech_opener_callback_t));\n286\t    if (ech_cb == NULL) {\n287\t        DBG_PRINTF(\"Cannot allocate callback memory (%zu bytes)\", sizeof(ech_opener_callback_t));\n288\t        ret = PICOQUIC_ERROR_MEMORY;\n289\t    }\n290\t    else {\n291\t        memset(ech_cb, 0, sizeof(ech_opener_callback_t));\n292\t        /* set the callback */\n293\t        ech_cb->super.cb = ech_opener_callback;\n294\t        ptls_buffer_init(&ech_cb->config, \"\", 0);\n295\t        /* Read the config bytes into the ech_cb->config buffer */\n296\t        ret = picoquic_ech_read_config(&ech_cb->config, config_file_name);\n297\t        if (ret != 0) {\n298\t            DBG_PRINTF(\"Cannot read ech configuration from %s\", config_file_name);\n299\t        } else {\n300\t            uint16_t kem_id;\n301\t            /* Get kem-id from config, then get kem from kem_id */\n302\t            kem_id = (((uint16_t)ech_cb->config.base[7]) << 8) + ech_cb->config.base[8];\n303\t            for (int i = 0; i < 4 && picoquic_hpke_kems[i] !=  NULL; i++) {\n304\t                if (picoquic_hpke_kems[i]->id == kem_id) {\n305\t                    ech_cb->kem = picoquic_hpke_kems[i];\n306\t                    break;\n307\t                }\n308\t            }\n309\t            if (ech_cb->kem == NULL){\n310\t                DBG_PRINTF(\"Cannot find hpke kwm for code 0x%04x\", kem_id);\n311\t                ret = PICOQUIC_ERROR_UNEXPECTED_ERROR;\n312\t            }\n313\t            else if (picoquic_keyex_from_key_file_fn == NULL) {\n314\t                DBG_PRINTF(\"%s\", \"Cannot find picoquic_keyex_from_key_file_fn\");\n315\t                ret = PICOQUIC_ERROR_UNEXPECTED_ERROR;\n316\t            }\n317\t            else {\n318\t                ret = picoquic_keyex_from_key_file_fn(&ech_cb->keyex, private_key_file);\n319\t                if (ret != 0) {\n320\t                    DBG_PRINTF(\"picoquic_keyex_from_key_file_fn fails, ret= %d(0x%x)\", ret, ret);\n321\t                }\n322\t            }\n323\t        }\n324\t        if (ret != 0) {\n325\t            ech_dispose_opener_callback(ech_cb);\n326\t            ech_cb = NULL;\n327\t        }\n328\t    }\n329\t    *p_ech_cb = ech_cb;\n330\t    return ret;\n331\t}\n332\t\n333\t/* Configure a QUIC context for ECH\n334\t*\n335\t* For both clients and servers, document:\n336\t*    ech.client.ciphers: list of HPKE symmetric cipher-suites (set to NULL to disable ECH altogether)\n337\t*    ech.client.kems: list of supported key exchanges.\n338\t*    (these lists are initialized during the initialization of the TLS API.)\n339\t* For the server, document:\n340\t*    ech.server.create_opener: the ECH \"opener\" callback function, which\n341\t*        does ECDH key exchange and returns the AEAD context.\n342\t*    ech.server.retry_configs: ECHConfigList to be sent to the client when\n343\t*        there is mismatch (or when the client sends a grease)\n344\t* We assume here that there will be just one ECH configuration for the server.\n345\t* We copy this configuration in the ECH callback buffer, and we add a pointer\n346\t* to it in ech.server.retry_configs.\n347\t*/\n348\tint picoquic_ech_configure_quic_ctx(picoquic_quic_t * quic, char const* private_key_file, char const* config_file_name)\n349\t{\n350\t    int ret = 0;\n351\t    ptls_context_t* ctx = (ptls_context_t*)quic->tls_master_ctx;\n352\t    PICOQUIC_THREAD_CHECK(quic);\n353\t\n354\t    picoquic_release_quic_ech_ctx(quic);\n355\t    ctx->ech.client.ciphers = picoquic_hpke_cipher_suites;\n356\t    ctx->ech.client.kems = picoquic_hpke_kems;\n357\t    if (private_key_file != NULL) {\n358\t        ech_opener_callback_t* ech_cb = NULL;\n359\t        if ((ret = ech_init_opener_callback(&ech_cb, private_key_file, config_file_name)) == 0) {\n360\t            ctx->ech.server.create_opener = &ech_cb->super;\n361\t            ctx->ech.server.retry_configs.base = ech_cb->config.base;\n362\t            ctx->ech.server.retry_configs.len = ech_cb->config.off;\n363\t        }\n364\t    }\n365\t    return ret;\n366\t}\n367\t\n368\t/* The call to ech_release_quic_ctx releases the allocations done by the\n369\t* call to ech_configure_quic_ctx. It should be used when deleting the quic context.\n370\t* It can be safely used even if there was no call to ech_configure_quic_ctx.\n371\t* \n372\t* This is performed automatically when deleting a quic context in \"picoquic_free\"\n373\t */\n374\t\n375\tvoid picoquic_release_quic_ech_ctx(picoquic_quic_t* quic)\n376\t{\n377\t    ptls_context_t* ctx = (ptls_context_t*)quic->tls_master_ctx;\n378\t    PICOQUIC_THREAD_CHECK(quic);\n379\t\n380\t    if (ctx != NULL) {\n381\t        ech_opener_callback_t* ech_cb = (ech_opener_callback_t*)ctx->ech.server.create_opener;\n382\t        ctx->ech.server.retry_configs.base = NULL;\n383\t        ctx->ech.server.retry_configs.len = 0;\n384\t\n385\t        if (ech_cb != NULL) {\n386\t            ech_dispose_opener_callback(ech_cb);\n387\t        }\n388\t    }\n389\t}\n390\t\n391\t/* Configure a tls connection context on the client side:\n392\t* We need to document the client handshake properties\n393\t* \"ech.configs\" with a list of server configurations (HTTPS records.)\n394\t* This data will be freed when deleted the tls_ctx for the connection.\n395\t*/\n396\tint picoquic_ech_configure_client(picoquic_cnx_t* cnx, const uint8_t * config_data, size_t config_length)\n397\t{\n398\t    int ret = 0;\n399\t    picoquic_tls_ctx_t* tls_ctx = (picoquic_tls_ctx_t*)cnx->tls_ctx;\n400\t    PICOQUIC_THREAD_CHECK(cnx->quic);\n401\t\n402\t    tls_ctx->handshake_properties.client.ech.configs.base = (uint8_t*)malloc(config_length+1);\n403\t    if (tls_ctx->handshake_properties.client.ech.configs.base == NULL) {\n404\t        ret = PICOQUIC_ERROR_MEMORY;\n405\t    }\n406\t    else {\n407\t        if (config_length > 0) {\n408\t            memcpy(tls_ctx->handshake_properties.client.ech.configs.base, config_data, config_length);\n409\t        }\n410\t        tls_ctx->handshake_properties.client.ech.configs.len = config_length;\n411\t    }\n412\t    return ret;\n413\t}\n414\t\n415\t/* Check whether the ech handshake succeeded.\n416\t */\n417\tint picoquic_is_ech_handshake(picoquic_cnx_t* cnx)\n418\t{\n419\t    picoquic_tls_ctx_t* tls_ctx = (picoquic_tls_ctx_t*)cnx->tls_ctx;\n420\t    PICOQUIC_THREAD_CHECK(cnx->quic);\n421\t    return ptls_is_ech_handshake(tls_ctx->tls, NULL, NULL, NULL);\n422\t}\n423\t\n424\t/* The key is expected to be read from a PEM file. The ASN1 syntax of a sec256r1\n425\t* public key is:\n426\t*   Sequence { (sequence type = 0x30)\n427\t*      Sequence {  (sequence type = 0x30)\n428\t*          Object_ID { (ASN1 type = 0x06)\n429\t*             identifier of the algorithm -- 2a:86:48:ce:3d:02:01\n430\t*          }\n431\t*          Object_ID { (ASN1 type = 0x06)\n432\t*             identifier of the curve -- 2a:86:48:ce:3d:03:01:07\n433\t*      }\n434\t*      BIT STRING {  (ASN1 type = 0x03)\n435\t*         first octet encoded number of padding bits at the end, should be 00\n436\t*         string of octets representing the public key\n437\t*      }\n438\t*   }\n439\t* \n440\t* For secp384r1 we find:\n441\t* \n442\t* Sequence {:30:76:\n443\t*    Sequence { 30:10:\n444\t*        Object ID { 06:07:\n445\t*                      2a:86:48:ce:3d:02:01:\n446\t*        Object ID { 06:05:\n447\t*                     :2b:81:04:00:22:\n448\t*    }\n449\t*    BIT STRING {03:62:\n450\t*       Null Byte 00:\n451\t*       97 bytes: 04:43:e9:2c:2c:61:ae\n452\t*       :69:bc:fa:ae:af:56:8d:90:e3:2d:d4:c6:43:66:97\n453\t*       :a5:4c:73:82:3b:b6:dd:4f:d4:89:bc:1f:7d:f9:eb\n454\t*       :c2:ad:ec:29:48:d0:3b:f6:92:e7:af:0f:7d:13:5f\n455\t*       :a4:b6:a3:ab:3e:34:e8:56:81:11:9b:d5:4f:23:08\n456\t*       :4e:1a:ee:95:10:e6:aa:36:33:f7:24:ce:f3:3c:21\n457\t*       :e1:e6:2e:d4:69:d1:37:f3:c9:a6:d7:19:63:70:83\n458\t*    }\n459\t*  }\n460\t*\n461\t* \n462\t* for x25519 we find:\n463\t*  \n464\t* Sequence { :30:2a:\n465\t*     Sequence { 30:05:\n466\t*         Object ID { 06:03:\n467\t*                       2b:65:6e:\n468\t*         }\n469\t*     Bit String { 03:21:\n470\t*         Null Byte 00\n471\t*         :79:49:77\n472\t*         :8b:22:a1:a7:f5:86:e4:09:62:54:79:21:36:55:55\n473\t*         :16:49:20:a8:6e:dc:1d:bb:a2:2a:a6:7e:71:0c\n474\t*     }\n475\t* }\n476\t* \n477\t* From RFC 5480:\n478\t* In the X.509 certificate, the subjectPublicKeyInfo field has the\n479\t* SubjectPublicKeyInfo type, which has the following ASN.1 syntax:\n480\t*     SubjectPublicKeyInfo  ::=  SEQUENCE  {\n481\t*      algorithm         AlgorithmIdentifier,\n482\t*      subjectPublicKey  BIT STRING\n483\t*     }\n484\t*     \n485\t*    AlgorithmIdentifier  ::=  SEQUENCE  {\n486\t*        algorithm   OBJECT IDENTIFIER,\n487\t*        parameters  ANY DEFINED BY algorithm OPTIONAL\n488\t*    }\n489\t*    id-ecPublicKey OBJECT IDENTIFIER ::= {\n490\t*        iso(1) member-body(2) us(840) ansi-X9-62(10045) keyType(2) 1 }\n491\t*    \n492\t* secp256r1 OBJECT IDENTIFIER ::= {\n493\t*    iso(1) member-body(2) us(840) ansi-X9-62(10045) curves(3)\n494\t*    prime(1) 7 }\n495\t* secp384r1 OBJECT IDENTIFIER ::= {\n496\t*    iso(1) identified-organization(3) certicom(132) curve(0) 34 }\n497\t* \n498\t* From RFC 8410:\n499\t* id-X25519    OBJECT IDENTIFIER ::= { 1 3 101 110 }\n500\t*/\n501\t\n502\tsize_t picoquic_parse_public_key_asn1(ptls_iovec_t public_key_asn1,\n503\t    ptls_iovec_t* public_key_algo, ptls_iovec_t* public_key_param,\n504\t    ptls_iovec_t* public_key_bit_string, int* decode_error,\n505\t    ptls_minicrypto_log_ctx_t* log_ctx)\n506\t{\n507\t    uint8_t* bytes = public_key_asn1.base;\n508\t    size_t bytes_max = public_key_asn1.len;\n509\t\n510\t    /* read the ASN1 messages */\n511\t    size_t byte_index = 0;\n512\t    uint32_t seq0_length = 0;\n513\t    size_t last_byte0;\n514\t    uint32_t seq1_length = 0;\n515\t    size_t last_byte1 = 0;\n516\t    uint32_t oid_length;\n517\t    size_t last_oid_byte;\n518\t    uint32_t key_data_length;\n519\t    size_t key_data_last;\n520\t\n521\t    /* start with sequence */\n522\t    byte_index = ptls_asn1_get_expected_type_and_length(bytes, bytes_max, byte_index, 0x30, &seq0_length, NULL, &last_byte0,\n523\t        decode_error, log_ctx);\n524\t\n525\t    if (*decode_error == 0 && bytes_max != last_byte0) {\n526\t        byte_index = ptls_asn1_error_message(\"Length larger than message\", bytes_max, byte_index, 0, log_ctx);\n527\t        *decode_error = PTLS_ERROR_BER_EXCESSIVE_LENGTH;\n528\t    }\n529\t\n530\t    if (*decode_error == 0) {\n531\t        /* open embedded sequence */\n532\t        byte_index = ptls_asn1_get_expected_type_and_length(bytes, bytes_max, byte_index, 0x30, &seq1_length, NULL, &last_byte1,\n533\t            decode_error, log_ctx);\n534\t    }\n535\t\n536\t    if (*decode_error == 0) {\n537\t        if (log_ctx != NULL) {\n538\t            log_ctx->fn(log_ctx->ctx, \"   Algorithm Identifier:\\n\");\n539\t        }\n540\t        /* get length of OID */\n541\t        byte_index = ptls_asn1_get_expected_type_and_length(bytes, last_byte1, byte_index, 0x06, &oid_length, NULL, &last_oid_byte,\n542\t            decode_error, log_ctx);\n543\t\n544\t        if (*decode_error == 0) {\n545\t            if (log_ctx != NULL) {\n546\t                /* print the OID value */\n547\t                log_ctx->fn(log_ctx->ctx, \"      Algorithm:\");\n548\t                ptls_asn1_dump_content(bytes + byte_index, oid_length, 0, log_ctx);\n549\t                log_ctx->fn(log_ctx->ctx, \",\\n\");\n550\t            }\n551\t            public_key_algo->base = bytes + byte_index;\n552\t            public_key_algo->len = oid_length;\n553\t            byte_index += oid_length;\n554\t        }\n555\t    }\n556\t\n557\t    if (*decode_error == 0) {\n558\t        /* get parameters, ANY */\n559\t        if (log_ctx != NULL) {\n560\t            log_ctx->fn(log_ctx->ctx, \"      Parameters:\\n\");\n561\t        }\n562\t\n563\t        public_key_param->base = bytes + byte_index;\n564\t        if (last_byte1 <= byte_index) {\n565\t            public_key_param->len = 0;\n566\t        }\n567\t        else {\n568\t            public_key_param->len = last_byte1 - byte_index;\n569\t        }\n570\t        byte_index = last_byte1;\n571\t    }\n572\t\n573\t    /* get bit string, key */\n574\t    if (*decode_error == 0) {\n575\t        byte_index = ptls_asn1_get_expected_type_and_length(bytes, last_byte0, byte_index, 0x03, &key_data_length, NULL,\n576\t            &key_data_last, decode_error, log_ctx);\n577\t        if (*decode_error == 0) {\n578\t            public_key_bit_string->base = bytes + byte_index;\n579\t            public_key_bit_string->len = key_data_length;\n580\t            byte_index += key_data_length;\n581\t        }\n582\t    }\n583\t\n584\t    if (*decode_error == 0 && byte_index != last_byte0) {\n585\t        byte_index = ptls_asn1_error_message(\"Length larger than element\", bytes_max, byte_index, 0, log_ctx);\n586\t        *decode_error = PTLS_ERROR_BER_ELEMENT_TOO_SHORT;\n587\t    }\n588\t\n589\t    if (log_ctx != NULL) {\n590\t        log_ctx->fn(log_ctx->ctx, \"\\n\");\n591\t    }\n592\t    return byte_index;\n593\t}\n594\t\n595\t\n596\tstatic uint8_t oid_algo_secp[] = { 0x2a, 0x86, 0x48, 0xce, 0x3d, 0x02, 0x01 };\n597\tstatic uint8_t oid_pr_secp256r1[] = { 0x06, 0x08, 0x2a, 0x86, 0x48, 0xce, 0x3d, 0x03, 0x01, 0x07 };\n598\tstatic uint8_t oid_pr_secp384r1[] = { 0x06, 0x05, 0x2b, 0x81, 0x04, 0x00, 0x22 };\n599\tstatic uint8_t oid_x25519[] = { 0x2b, 0x65, 0x6e };\n600\t\n601\tint picoquic_ech_parse_public_key(ptls_iovec_t public_key_asn1,\n602\t    uint16_t* group_id,\n603\t    ptls_iovec_t* public_key_bits)\n604\t{\n605\t    int ret = 0;\n606\t    ptls_iovec_t public_key_algo;\n607\t    ptls_iovec_t public_key_param;\n608\t    ptls_iovec_t public_key_bit_string;\n609\t    size_t expected_key_length = 0;\n610\t    (void)picoquic_parse_public_key_asn1(public_key_asn1,\n611\t        &public_key_algo, &public_key_param,\n612\t        &public_key_bit_string, &ret, NULL);\n613\t    if (ret == 0) {\n614\t        if (public_key_algo.len == sizeof(oid_algo_secp) &&\n615\t            memcmp(public_key_algo.base, oid_algo_secp, sizeof(oid_algo_secp)) == 0) {\n616\t            if (public_key_param.len == sizeof(oid_pr_secp256r1) &&\n617\t                memcmp(public_key_param.base, oid_pr_secp256r1, sizeof(oid_pr_secp256r1)) == 0) {\n618\t                *group_id = PTLS_GROUP_SECP256R1;\n619\t                expected_key_length = 0x41;\n620\t            }\n621\t            else if (public_key_param.len == sizeof(oid_pr_secp384r1) &&\n622\t                memcmp(public_key_param.base, oid_pr_secp384r1, sizeof(oid_pr_secp384r1)) == 0) {\n623\t                *group_id = PTLS_GROUP_SECP384R1;\n624\t                expected_key_length = 0x61;\n625\t            }\n626\t            else {\n627\t                DBG_PRINTF(\"%s\", \"Unsupported SecP Group ID\");\n628\t                ret = -1;\n629\t            }\n630\t        }\n631\t        else if (public_key_algo.len == sizeof(oid_x25519) &&\n632\t            memcmp(public_key_algo.base, oid_x25519, sizeof(oid_x25519)) == 0) {\n633\t            *group_id = PTLS_GROUP_X25519;\n634\t            expected_key_length = 0x20;\n635\t        }\n636\t    }\n637\t    else {\n638\t        DBG_PRINTF(\"%s\", \"Unsupported Algorithm ID\");\n639\t        ret = -1;\n640\t    }\n641\t    if (ret == 0) {\n642\t        if (public_key_bit_string.len > 1 && public_key_bit_string.base[0] == 0) {\n643\t            public_key_bits->base = public_key_bit_string.base + 1;\n644\t            public_key_bits->len = public_key_bit_string.len - 1;\n645\t            if (public_key_bits->len != expected_key_length) {\n646\t                DBG_PRINTF(\"Invalid length for curve 0x%04x: %zu, expected %zu\",\n647\t                    *group_id, public_key_bits->len, expected_key_length);\n648\t                ret = -1;\n649\t            }\n650\t        }\n651\t    }\n652\t    return ret;\n653\t}\n654\t\n655\tint picoquic_ech_get_kem_from_curve(ptls_hpke_kem_t **kem, uint16_t group_id)\n656\t{\n657\t    int ret = -1;\n658\t\n659\t    for (int i = 0; i < PICOQUIC_HPKE_KEM_NB_MAX; i++) {\n660\t        if (picoquic_hpke_kems[i] == NULL) {\n661\t            break;\n662\t        }\n663\t        else if (picoquic_hpke_kems[i]->keyex->id == group_id) {\n664\t            *kem = picoquic_hpke_kems[i];\n665\t            ret = 0;\n666\t            break;\n667\t        }\n668\t    }\n669\t    return ret;\n670\t}\n671\t\n672\tint picoquic_ech_get_ciphers_from_kem(ptls_hpke_cipher_suite_t** cipher_vec, size_t cipher_vec_nb_max, uint16_t kem_id)\n673\t{\n674\t    int ret = 0;\n675\t    size_t nb_ciphers = 0;\n676\t    uint16_t target_kdf_id = PTLS_HPKE_HKDF_SHA256;\n677\t    uint16_t target_aead_id = PTLS_HPKE_AEAD_AES_128_GCM;\n678\t    ptls_hpke_cipher_suite_t* target_cipher = NULL;\n679\t    ptls_hpke_cipher_suite_t* default_cipher = NULL;\n680\t\n681\t    if (cipher_vec_nb_max < 2) {\n682\t        return -1;\n683\t    }\n684\t\n685\t    switch (kem_id) {\n686\t    case PTLS_HPKE_KEM_P256_SHA256:\n687\t        target_kdf_id = PTLS_HPKE_HKDF_SHA256;\n688\t        target_aead_id = PTLS_HPKE_AEAD_AES_128_GCM;\n689\t        break;\n690\t    case PTLS_HPKE_KEM_P384_SHA384:\n691\t        target_kdf_id = PTLS_HPKE_HKDF_SHA384;\n692\t        target_aead_id = PTLS_HPKE_AEAD_AES_256_GCM;\n693\t        break;\n694\t    case PTLS_HPKE_KEM_X25519_SHA256:\n695\t        target_kdf_id = PTLS_HPKE_HKDF_SHA256;\n696\t        target_aead_id = PTLS_HPKE_AEAD_CHACHA20POLY1305;\n697\t        break;\n698\t    default:\n699\t        break;\n700\t    }\n701\t\n702\t    for (size_t i = 0; i < PICOQUIC_HPKE_CIPHER_SUITE_NB_MAX; i++) {\n703\t        if (picoquic_hpke_cipher_suites[i] == NULL) {\n704\t            break;\n705\t        }\n706\t        else if (picoquic_hpke_cipher_suites[i]->id.aead == target_aead_id &&\n707\t            picoquic_hpke_cipher_suites[i]->id.kdf == target_kdf_id) {\n708\t            target_cipher = picoquic_hpke_cipher_suites[i];\n709\t            break;\n710\t        }\n711\t        else if (picoquic_hpke_cipher_suites[i]->id.aead == PTLS_HPKE_AEAD_AES_128_GCM &&\n712\t            picoquic_hpke_cipher_suites[i]->id.kdf == PTLS_HPKE_HKDF_SHA256) {\n713\t            default_cipher = picoquic_hpke_cipher_suites[i];\n714\t        }\n715\t    }\n716\t    if (target_cipher == NULL) {\n717\t        if (default_cipher != NULL) {\n718\t            cipher_vec[0] = default_cipher;\n719\t            nb_ciphers = 1;\n720\t        }\n721\t        else {\n722\t            ret = -1;\n723\t        }\n724\t    } else {\n725\t        cipher_vec[0] = target_cipher;\n726\t        nb_ciphers = 1;\n727\t        if (default_cipher != NULL && default_cipher != target_cipher && cipher_vec_nb_max > 2) {\n728\t            cipher_vec[1] = default_cipher;\n729\t            nb_ciphers++;\n730\t        }\n731\t    }\n732\t    for (size_t i = nb_ciphers; i < cipher_vec_nb_max; i++) {\n733\t        cipher_vec[i] = NULL;\n734\t    }\n735\t    return ret;\n736\t}\n737\t\n738\tstatic uint8_t ech_config_id_from_config(ptls_iovec_t public_key_bits, ptls_hpke_kem_t* kem, ptls_hpke_cipher_suite_t** cipher_vec, char const* public_name)\n739\t{\n740\t    /* compute the config ID */\n741\t    uint64_t config_sum = 0;\n742\t    uint8_t config_id = 0;\n743\t    for (size_t i = 0; i < public_key_bits.len; i++) {\n744\t        config_sum += public_key_bits.base[i];\n745\t    }\n746\t    config_sum += kem->id;\n747\t    for (size_t i = 0; cipher_vec[i] != NULL; i++) {\n748\t        config_sum += cipher_vec[i]->id.aead;\n749\t        config_sum += cipher_vec[i]->id.kdf;\n750\t    }\n751\t    for (size_t i = 0; public_name[i] != 0; i++) {\n752\t        config_sum += (uint8_t)public_name[i];\n753\t    }\n754\t    while (config_sum > 0) {\n755\t        config_id ^= (uint8_t)(config_sum & 0xff);\n756\t        config_sum >>= 8;\n757\t    }\n758\t    return config_id;\n759\t}\n760\t\n761\t/* Server side support.\n762\t*\n763\t* The server need two parameters: an ECH encryption key, and an\n764\t* ECH configuration.\n765\t*\n766\t* The ECH configuration has several parameters:\n767\t* - configuration ID,\n768\t* - identifier of the HPKE key encapsulation mechanism (KEM),\n769\t* - server public name, i.e., the DNS name of the client facing server,\n770\t* - server public key, i.e., the public key of the client facing server.\n771\t* - supported HPKE cipher suites.\n772\t*\n773\t* If the configuration is not available, it will have to be created.\n774\t* The server admin will have to provide the parameters.\n775\t* Many picoquic deployments use small servers with limited management.\n776\t* In that case, we may use default values such as the DNS name of\n777\t* the local server, the public key found in the local server certificate,\n778\t* a locally supported HPKE-KEM compatible with the public key,\n779\t* the list of locally supported HPKE symmetric cipher suites,\n780\t* and a configuration ID computed as combination of these local\n781\t* parameters.\n782\t*/\n783\tstatic int picoquic_ech_create_config_list_from_config(ptls_buffer_t* config_buf, uint8_t** config_list, size_t* config_list_len)\n784\t{\n785\t    int ret = 0;\n786\t    size_t bin_size = config_buf->off + 2;\n787\t    uint8_t* bin_val = (uint8_t*)malloc(bin_size);\n788\t    if (bin_val == NULL) {\n789\t        DBG_PRINTF(\"Cannot allocate %d bytes for config bin buffer\", bin_size);\n790\t        ret = -1;\n791\t    }\n792\t    else {\n793\t        bin_val[0] = (uint8_t)(((config_buf->off) >> 8) & 0xff);\n794\t        bin_val[1] = (uint8_t)(config_buf->off & 0xff);\n795\t        memcpy(bin_val + 2, config_buf->base, config_buf->off);\n796\t        *config_list = bin_val;\n797\t        *config_list_len = bin_size;\n798\t    }\n799\t    return ret;\n800\t}\n801\t\n802\tstatic int picoquic_ech_create_config_from_pk(ptls_buffer_t* config_buf, uint16_t group_id, ptls_iovec_t public_key_bits, char const* public_name)\n803\t{\n804\t    int ret = 0;\n805\t    ptls_hpke_kem_t* kem = NULL;\n806\t    ptls_hpke_cipher_suite_t* cipher_vec[PICOQUIC_HPKE_CIPHER_SUITE_NB_MAX + 1];\n807\t\n808\t    if ((ret = picoquic_ech_get_kem_from_curve(&kem, group_id)) != 0) {\n809\t        DBG_PRINTF(\"Could not find KEM for group = 0x%04x\", group_id);\n810\t    }\n811\t    /* Find the list of locally supported cipher suites, retaining only the most common */\n812\t    else if ((ret = picoquic_ech_get_ciphers_from_kem(cipher_vec, PICOQUIC_HPKE_CIPHER_SUITE_NB_MAX + 1, kem->id)) != 0) {\n813\t        DBG_PRINTF(\"Could not find Ciphers for kem = 0x%04x\", kem->id);\n814\t    }\n815\t    else {\n816\t        /* Compute a config ID from public key bytes, kem-id, cipher-suite IDs and public name */\n817\t        uint8_t config_id = ech_config_id_from_config(public_key_bits, kem, cipher_vec, public_name);\n818\t        /* Encode the key config */\n819\t        if ((ret = ptls_ech_encode_config(config_buf, config_id, kem, public_key_bits,\n820\t            cipher_vec, 255, public_name)) != 0) {\n821\t            DBG_PRINTF(\"Could not encode the configuration, err: %x\", ret);\n822\t        }\n823\t    }\n824\t    return ret;\n825\t}\n826\t\n827\tstatic int picoquic_ech_create_rr_from_binary(ptls_buffer_t* config_buf, ptls_iovec_t public_key_asn1, char const* public_name)\n828\t{\n829\t    int ret = 0;\n830\t    ptls_iovec_t public_key_bits = ptls_iovec_init(NULL, 0);\n831\t    uint16_t group_id = 0;\n832\t\n833\t    /* Parse the ASN1 public key to extract the key type and the key bytes */\n834\t    if ((ret = picoquic_ech_parse_public_key(public_key_asn1, &group_id, &public_key_bits)) != 0) {\n835\t        DBG_PRINTF(\"Cannot get group and pubkey from ASN1, err: %x\", ret);\n836\t    }\n837\t    /* Build config from group id and key bits */\n838\t    else {\n839\t        ret = picoquic_ech_create_config_from_pk(config_buf, group_id, public_key_bits, public_name);\n840\t    }\n841\t    return ret;\n842\t}\n843\t\n844\tint picoquic_ech_create_config_from_binary(uint8_t ** config, size_t * config_len, ptls_iovec_t public_key_asn1, char const* public_name)\n845\t{\n846\t    int ret = 0;\n847\t    ptls_buffer_t config_buf;\n848\t    ptls_buffer_init(&config_buf, \"\", 0);\n849\t\n850\t    if ((ret = picoquic_ech_create_rr_from_binary(&config_buf, public_key_asn1, public_name)) == 0) {\n851\t        ret = picoquic_ech_create_config_list_from_config(&config_buf, config, config_len);\n852\t    }\n853\t    ptls_buffer_dispose(&config_buf);\n854\t    return ret;\n855\t}\n856\t\n857\tint picoquic_ech_create_config_from_public_key(uint8_t** config, size_t* config_len, char const * public_key_file, char const* public_name)\n858\t{\n859\t    int ret = 0;\n860\t    ptls_iovec_t public_key_asn1 = ptls_iovec_init(NULL, 0);\n861\t    size_t pub_key_objects = 0;\n862\t\n863\t    /* Read the public key from a file. */\n864\t    ret = ptls_load_pem_objects(public_key_file, \"PUBLIC KEY\", &public_key_asn1, 1, &pub_key_objects);\n865\t    if (ret != 0) {\n866\t        DBG_PRINTF(\"Cannot load pubkey from <%s>, err: %x\", public_key_file, ret);\n867\t    }\n868\t    else\n869\t    {\n870\t        ret = picoquic_ech_create_config_from_binary(config, config_len, public_key_asn1, public_name);\n871\t    }\n872\t    if (public_key_asn1.base != NULL) {\n873\t        free(public_key_asn1.base);\n874\t    }\n875\t    return ret;\n876\t}\n877\t\n878\t\n879\tint picoquic_ech_create_config_from_private_key(uint8_t** config, size_t* config_len, char const* private_key_file, char const* public_name)\n880\t{\n881\t    int ret = 0;\n882\t\n883\t    *config = NULL;\n884\t    *config_len = 0;\n885\t\n886\t    if (picoquic_get_public_key_from_private_fn != NULL) {\n887\t        uint16_t group_id = 0;\n888\t        ptls_iovec_t public_key_bits = ptls_iovec_init(NULL, 0);\n889\t\n890\t        ret = picoquic_get_public_key_from_private_fn(private_key_file, &public_key_bits.base, &public_key_bits.len);\n891\t\n892\t        if (ret == 0) {\n893\t            switch (public_key_bits.len) {\n894\t            case 0x21: /* x25519 */\n895\t                group_id = 0x001d;\n896\t                break;\n897\t            case 0x41: /* secp265r1 */\n898\t                group_id = 0x0017;\n899\t                break;\n900\t            case 0x61: /* x25519 */\n901\t                group_id = 0x0018;\n902\t                break;\n903\t            default:\n904\t                DBG_PRINTF(\"Cannot find group ID from pubkey length 0x%02x from %s\",\n905\t                    public_key_bits.len, private_key_file);\n906\t                ret = -1;\n907\t                break;\n908\t            }\n909\t        }\n910\t\n911\t        if (ret == 0) {\n912\t            ptls_buffer_t config_buf;\n913\t            ptls_buffer_init(&config_buf, \"\", 0);\n914\t            ret = picoquic_ech_create_config_from_pk(&config_buf, group_id, public_key_bits, public_name);\n915\t            if (ret == 0) {\n916\t                ret = picoquic_ech_create_config_list_from_config(&config_buf, config, config_len);\n917\t            }\n918\t            ptls_buffer_dispose(&config_buf);\n919\t        }\n920\t        if (public_key_bits.base != NULL) {\n921\t            free(public_key_bits.base);\n922\t        }\n923\t    }\n924\t    return ret;\n925\t}\n926\t\n927\tint picoquic_ech_create_config_file(char const* public_name, char const* private_key_file, char const* ech_config_file)\n928\t{\n929\t    uint8_t* config = NULL;\n930\t    size_t config_len = 0;\n931\t    int ret = picoquic_ech_create_config_from_private_key(&config, &config_len, private_key_file, public_name);\n932\t\n933\t    if (ret == 0) {\n934\t        ret = picoquic_ech_save_config(config, config_len, ech_config_file);\n935\t    }\n936\t    if (config != NULL) {\n937\t        free(config);\n938\t    }\n939\t    return ret;\n940\t}\n941\t\n942\t#if 0\n943\t/*\n944\t* In theory, all the information required to set up ECH is present in the\n945\t* certificate used by the public server. The public key certainly is there.\n946\t* \n947\t* The certificate has a rather simple structure (see RFC 5280):\n948\t* \n949\t*  Certificate  ::=  SEQUENCE  {\n950\t*        tbsCertificate       TBSCertificate,\n951\t*        signatureAlgorithm   AlgorithmIdentifier,\n952\t*        signatureValue       BIT STRING  }\n953\t*\n954\t*   TBSCertificate  ::=  SEQUENCE  {\n955\t*        version         [0]  EXPLICIT Version DEFAULT v1,\n956\t*        serialNumber         CertificateSerialNumber,\n957\t*        signature            AlgorithmIdentifier,\n958\t*        issuer               Name,\n959\t*        validity             Validity,\n960\t*        subject              Name,\n961\t*        subjectPublicKeyInfo SubjectPublicKeyInfo,\n962\t*        issuerUniqueID  [1]  IMPLICIT UniqueIdentifier OPTIONAL,\n963\t*                             -- If present, version MUST be v2 or v3\n964\t*        subjectUniqueID [2]  IMPLICIT UniqueIdentifier OPTIONAL,\n965\t*                             -- If present, version MUST be v2 or v3\n966\t*        extensions      [3]  EXPLICIT Extensions OPTIONAL\n967\t*                             -- If present, version MUST be v3\n968\t*        }\n969\t* \n970\t* We need a simple parser that:\n971\t* - opens the outside sequence,\n972\t* - opens its first element, the TBSCertificate\n973\t* - skip the elements version [0], serialNumber (INTEGER), \n974\t*   signature (AlgorithmIdentifier, SEQUENCE),\n975\t*   issuer (Name, CHOICE, RdnSequence SEQUENCE OF),\n976\t*   validity (SEQUENCE)\n977\t*   subject (Name, CHOICE, RdnSequence SEQUENCE OF).\n978\t* - return the bytes from start (Type) of subjectPublicKeyInfo(SEQUENCE)\n979\t*   to end of that element.\n980\t*/\n981\tint picoquic_ech_get_public_key_from_cert(ptls_iovec_t cert, ptls_iovec_t* public_key_asn1,\n982\t    ptls_minicrypto_log_ctx_t* log_ctx)\n983\t{\n984\t    int ret = 0;\n985\t    uint8_t* bytes = cert.base;\n986\t    size_t bytes_max = cert.len;\n987\t    size_t byte_index = 0;\n988\t    uint32_t seq0_length = 0;\n989\t    size_t last_byte0;\n990\t    uint32_t seq1_length = 0;\n991\t    size_t last_byte1 = 0;\n992\t    size_t last_byte2 = 0;\n993\t    uint32_t skipped_length;\n994\t    size_t pubkey_info_index = 0;\n995\t    int indefinite_length;\n996\t    const uint8_t skipped_types[] = {\n997\t        0xa0, /* version [0] */\n998\t        0x02, /* serialNumber (INTEGER) */\n999\t        0x30, /* AlgorithmIdentifier, SEQUENCE) */\n1000\t        0x30, /* issuer (Name, CHOICE, RdnSequence SEQUENCE OF) */\n1001\t        0x30, /* validity (SEQUENCE) */\n1002\t        0x30, /* subject (Name, CHOICE, RdnSequence SEQUENCE OF). */\n1003\t    };\n1004\t    /* open the outside sequence */\n1005\t\n1006\t    /* start with sequence */\n1007\t    byte_index = ptls_asn1_get_expected_type_and_length(bytes, bytes_max, byte_index, 0x30, &seq0_length, NULL, &last_byte0,\n1008\t        &ret, log_ctx);\n1009\t    if (ret == 0 && bytes_max != last_byte0) {\n1010\t        byte_index = ptls_asn1_error_message(\"Length larger than message\", bytes_max, byte_index, 0, log_ctx);\n1011\t        ret = PTLS_ERROR_BER_EXCESSIVE_LENGTH;\n1012\t    }\n1013\t    if (ret == 0) {\n1014\t        byte_index = ptls_asn1_get_expected_type_and_length(bytes, seq0_length, byte_index, 0x30, &seq1_length, NULL, &last_byte1,\n1015\t            &ret, log_ctx);\n1016\t    }\n1017\t    /* get the first component, TBSCertificate SEQUENCE */\n1018\t    for (size_t i = 0; i < sizeof(skipped_types) && ret == 0; i++) {\n1019\t        {\n1020\t            byte_index = ptls_asn1_get_expected_type_and_length(bytes, last_byte1, byte_index, skipped_types[i], &skipped_length,\n1021\t                &indefinite_length, &last_byte2,\n1022\t                &ret, log_ctx);\n1023\t            if (ret == 0) {\n1024\t                byte_index += skipped_length;\n1025\t            }\n1026\t        }\n1027\t    }\n1028\t    /* If all went well, this component is the public key info. */\n1029\t    if (ret == 0) {\n1030\t        pubkey_info_index = byte_index;\n1031\t        /* open embedded sequence */\n1032\t        byte_index = ptls_asn1_get_expected_type_and_length(bytes, last_byte1, byte_index, 0x30, &skipped_length, NULL, &last_byte2,\n1033\t            &ret, log_ctx);\n1034\t        if (ret == 0) {\n1035\t            public_key_asn1->base = bytes + pubkey_info_index;\n1036\t            public_key_asn1->len = byte_index + skipped_length - pubkey_info_index;\n1037\t        }\n1038\t    }\n1039\t    return ret;\n1040\t}\n1041\t\n1042\tint picoquic_ech_create_config_from_cert(uint8_t** config, size_t* config_len, char const* cert_file, char const* public_name)\n1043\t{\n1044\t    int ret = 0;\n1045\t    ptls_iovec_t cert_bytes = ptls_iovec_init(NULL, 0);\n1046\t    ptls_iovec_t public_key_asn1 = ptls_iovec_init(NULL, 0);\n1047\t    size_t cert_objects = 0;\n1048\t    /* Read the cert from a file. */\n1049\t    if ((ret = ptls_load_pem_objects(cert_file, \"CERTIFICATE\", &cert_bytes, 1, &cert_objects)) != 0) {\n1050\t        DBG_PRINTF(\"Cannot read cert bytes from <%s>\", cert_file);\n1051\t    }\n1052\t    /* Extract the Public Key Info */\n1053\t    if (ret == 0 && (ret = picoquic_ech_get_public_key_from_cert(cert_bytes, &public_key_asn1, NULL)) != 0) {\n1054\t        DBG_PRINTF(\"Cannot extract public key from cert bytes of <%s>, ret = %d (0x%x)\", cert_file, ret, ret);\n1055\t    }\n1056\t    /* Obtain the configuration */\n1057\t    if (ret == 0){\n1058\t        ret = picoquic_ech_create_config_from_binary(config, config_len, public_key_asn1, public_name);\n1059\t    }\n1060\t    if (cert_bytes.base != NULL) {\n1061\t        free(cert_bytes.base);\n1062\t    }\n1063\t    return ret;\n1064\t}\n1065\t#endif\n1066\t\n1067\tvoid picoquic_ech_get_retry_config(picoquic_cnx_t* cnx,\n1068\t    uint8_t** retry_config, size_t* retry_config_len)\n1069\t{\n1070\t    picoquic_tls_ctx_t* tls_ctx = (picoquic_tls_ctx_t*)cnx->tls_ctx;\n1071\t    PICOQUIC_THREAD_CHECK(cnx->quic);\n1072\t\n1073\t    *retry_config = tls_ctx->retry_configs.base;\n1074\t    *retry_config_len = tls_ctx->retry_configs.len;\n1075\t}\n1076\t"}]},"parent_tool_use_id":null,"session_id":"c694d8c7-5173-4d7d-b47f-1867084f331f","uuid":"17eee689-f9cf-4400-9954-eb35b3818233","timestamp":"2026-05-07T05:51:27.095Z","tool_use_result":{"type":"text","file":{"filePath":"/Users/richbarn/Projects/picoquic/picoquic/ech.c","content":"/*\n* Author: Christian Huitema\n* Copyright (c) 2019, Private Octopus, Inc.\n* All rights reserved.\n*\n* Permission to use, copy, modify, and distribute this software for any\n* purpose with or without fee is hereby granted, provided that the above\n* copyright notice and this permission notice appear in all copies.\n*\n* THIS SOFTWARE IS PROVIDED BY THE COPYRIGHT HOLDERS AND CONTRIBUTORS \"AS IS\" AND\n* ANY EXPRESS OR IMPLIED WARRANTIES, INCLUDING, BUT NOT LIMITED TO, THE IMPLIED\n* WARRANTIES OF MERCHANTABILITY AND FITNESS FOR A PARTICULAR PURPOSE ARE\n* DISCLAIMED. IN NO EVENT SHALL Private Octopus, Inc. BE LIABLE FOR ANY\n* DIRECT, INDIRECT, INCIDENTAL, SPECIAL, EXEMPLARY, OR CONSEQUENTIAL DAMAGES\n* (INCLUDING, BUT NOT LIMITED TO, PROCUREMENT OF SUBSTITUTE GOODS OR SERVICES;\n* LOSS OF USE, DATA, OR PROFITS; OR BUSINESS INTERRUPTION) HOWEVER CAUSED AND\n* ON ANY THEORY OF LIABILITY, WHETHER IN CONTRACT, STRICT LIABILITY, OR TORT\n* (INCLUDING NEGLIGENCE OR OTHERWISE) ARISING IN ANY WAY OUT OF THE USE OF THIS\n* SOFTWARE, EVEN IF ADVISED OF THE POSSIBILITY OF SUCH DAMAGE.\n*/\n\n#include \"picoquic_internal.h\"\n#include \"picoquic_utils.h\"\n#include \"picosocks.h\"\n#include \"tls_api.h\"\n#ifdef _WINDOWS\n#include \"wincompat.h\"\n#pragma warning(disable:4204)\n#endif\n#include <picotls.h>\n#ifdef _WINDOWS\n#include <picotls\\pembase64.h>\n#include <picotls\\minicrypto.h>\n#include <picotls\\asn1.h>\n#else\n#include <picotls/pembase64.h>\n#include <picotls/minicrypto.h>\n#include <picotls/asn1.h>\n#endif\n#include <stddef.h>\n#include <stdlib.h>\n#include <string.h>\ntypedef const struct st_ptls_cipher_suite_t ptls_cipher_suite_t;\n#include \"picoquic_crypto_provider_api.h\"\n\n/* Decode a base64 string. This is not strictly ECH related, \n* but applications cannot easily access the base64 implementation in\n* picotls.\n*/\nint picoquic_base64_decode(uint8_t** v, size_t* v_len, char const* b64_txt)\n{\n    int ret = 0;\n    ptls_buffer_t config;\n    uint8_t short_buf[256];\n    ptls_base64_decode_state_t d_state;\n    *v = NULL;\n    *v_len = 0;\n    ptls_buffer_init(&config, short_buf, sizeof(short_buf));\n    ptls_base64_decode_init(&d_state);\n    ret = ptls_base64_decode(b64_txt, &d_state, &config);\n    if (ret == 0 && (d_state.status == PTLS_BASE64_DECODE_DONE || (d_state.status == PTLS_BASE64_DECODE_IN_PROGRESS && d_state.nbc == 0))) {\n        ret = 0;\n        if (config.off > 0) {\n            if ((*v = (uint8_t*)malloc(config.off)) == NULL) {\n                ret = PICOQUIC_ERROR_MEMORY;\n            }\n            else {\n                memcpy(*v, config.base, config.off);\n                *v_len = config.off;\n            }\n        }\n    }\n    ptls_buffer_dispose(&config);\n    return ret;\n}\n/* Encode a base64 string. This is not strictly ECH related,\n* but applications cannot easily access the base64 implementation in\n* picotls.\n*/\nint picoquic_base64_encode(const uint8_t* v, size_t v_len, char* b64, size_t b64_size, size_t* b64_len)\n{\n\n    int ret = 0;\n    size_t len = ptls_base64_howlong(v_len);\n    *b64_len = len;\n    if (len + 1 > b64_size) {\n        ret = -1;\n    }\n    else {\n        (void)ptls_base64_encode(v, v_len, b64);\n    }\n    return ret;\n}\n\n/* Read the configuration file.\n* We assume that it contains exactly one config, in base 64 encoding. \n */\nint picoquic_ech_read_config(ptls_buffer_t * config, char const * config_file_name)\n{\n    int ret = 0;\n    char buffer[1024];\n    FILE* F = picoquic_file_open(config_file_name, \"r\");\n    if (F == NULL) {\n        ret = -1;\n    }\n    else {\n        ptls_base64_decode_state_t d_state;\n        ptls_base64_decode_init(&d_state);\n        while (fgets(buffer, sizeof(buffer), F) != NULL) {\n            ret = ptls_base64_decode(buffer, &d_state, config);\n        }\n        if (d_state.status == PTLS_BASE64_DECODE_DONE || (d_state.status == PTLS_BASE64_DECODE_IN_PROGRESS && d_state.nbc == 0)) {\n            ret = 0;\n        }\n        else {\n            ret = PTLS_ERROR_INCORRECT_BASE64;\n        }\n        F=picoquic_file_close(F);\n        if (ret == 0) {\n            DBG_PRINTF(\"Got %zu bytes from %s\", config->off, config_file_name);\n        }\n    }\n    return ret;\n}\n\n\nint picoquic_ech_save_config(uint8_t* config, size_t config_len, char const* file_name)\n{\n    int ret = 0;\n    int last_err;\n    size_t ech_text_size = 0;\n    size_t ech_text_len = 0;\n    char* ech_text = NULL;\n\n    (void)picoquic_base64_encode(config, config_len, ech_text, ech_text_size, &ech_text_len);\n    ech_text_size = ech_text_len + 1;\n    ech_text = (char*)malloc(ech_text_size);\n\n    if (ech_text == NULL) {\n        DBG_PRINTF(\"Cannot allocate %d bytes for text buffer\", ech_text_size);\n        ret = -1;\n    }\n    else {\n        ret = picoquic_base64_encode(config, config_len, ech_text, ech_text_size, &ech_text_len);\n    }\n    if (ret == 0) {\n        FILE* F = picoquic_file_open_ex(file_name, \"w\", &last_err);\n        if (F == NULL) {\n            DBG_PRINTF(\"Cannot open file <%s>, err: %x\", file_name, last_err);\n            ret = -1;\n        }\n        else {\n            size_t written = fwrite(ech_text, 1, ech_text_size, F);\n            if (written != ech_text_size) {\n                DBG_PRINTF(\"Cannot write %d bytes on file <%s>, err= %zu\", ech_text, file_name, written);\n                ret = -1;\n            }\n            else {\n                (void)fprintf(F, \"\\n\");\n                DBG_PRINTF(\"Wrote %d bytes on file <%s>\", ech_text_size + 1, file_name);\n            }\n            picoquic_file_close(F);\n        }\n    }\n    if (ech_text != NULL) {\n        free(ech_text);\n    }\n    return ret;\n}\n\n/*\n* The ECH extension in TLS is defined as:\n*       enum { outer(0), inner(1) } ECHClientHelloType;\n*\n*       struct {\n*          ECHClientHelloType type;\n*          select (ECHClientHello.type) {\n*              case outer:\n*                  HpkeSymmetricCipherSuite cipher_suite;\n*                  uint8 config_id;\n*                  opaque enc<0..2^16-1>;\n*                  opaque payload<1..2^16-1>;\n*              case inner:\n*                  Empty;\n*          };\n*       } ECHClientHello;\n* \n* On the server side, picotls decode the \"cipher_suite\" and \"config_id\"\n* parameters, and the \"enc\" prefix, and then call the \"create_opener\"\n* callback, documented in the PTLS context as ech.server.create_opener.\n* \n* It is called as: \n* tls->ech.aead = tls->ctx->ech.server.create_opener->cb(\n*                     tls->ctx->ech.server.create_opener, &tls->ech.kem, &tls->ech.cipher, tls, ch->ech.config_id,\n*                     ch->ech.cipher_suite, ch->ech.enc, ptls_iovec_init(ech_info_prefix, sizeof(ech_info_prefix)))\n* \n* The opener signature is:\n* \n* ptls_aead_context_t* ech_opener_callback(ptls_ech_create_opener_t * self,\n*     ptls_hpke_kem_t** kem, ptls_hpke_cipher_suite_t** cipher, ptls_t* tls, \n*    uint8_t config_id, ptls_hpke_cipher_suite_id_t cipher_id, ptls_iovec_t enc, ptls_iovec_t info_prefix)\n* \n* with the following parameters:\n* \n* - \"self\" points to the \"callback\" structure documented in the \n* ptls context as ech.server.create_opener. Its first member is the \"cb\" pointer\n* to the function, followed by implementation specific parameters.\n* - \"kem\" and \"cipher\" are output parameters, to be set by the callback.\n* - \"tls\" is the ptls context\n* - \"config_id\" and \"cipher_id\" are decoded from the \"config_id\" and \"cipher_suite\"\n*   parameters of the ECH extension in the client hello\n* - \"enc\" points to the content of the \"enc\" field of the ECH extension, i.e.,\n*   the HPKE encapsulated key.\n* - \"info_prefix\" points to the constant used when deriving the ECH keys -- in the\n*   current code, this is set to \"tls ech\".\n*\n* The callback should find a configuration that matches the config_id, then\n* perform the specified key exchange and derive the aead key used to encrypt\n* the payload.\n*/\n\ntypedef struct st_ech_opener_callback_t {\n    ptls_ech_create_opener_t super;\n    ptls_hpke_kem_t* kem;\n    ptls_key_exchange_context_t* keyex;\n    ptls_buffer_t config;\n} ech_opener_callback_t;\n\n\n/* Find the config based on the config ID */\n/* Perform the key exchange using the public key provided by the client\n * in the \"enc\" parameter and the private key corresponding to the config ID */\nptls_aead_context_t* ech_opener_callback(ptls_ech_create_opener_t * cb,\n    ptls_hpke_kem_t** p_kem, ptls_hpke_cipher_suite_t** cipher, ptls_t* UNUSED(tls), \n    uint8_t UNUSED(config_id), ptls_hpke_cipher_suite_id_t cipher_id, ptls_iovec_t enc, ptls_iovec_t info_prefix)\n{\n    ptls_aead_context_t* aead = NULL;\n    ptls_buffer_t infobuf;\n    int ret = 0;\n    ech_opener_callback_t* ech_cb = (ech_opener_callback_t*)cb;\n\n    *cipher = NULL;\n    for (size_t i = 0; picoquic_hpke_cipher_suites[i] != NULL; ++i) {\n        if (picoquic_hpke_cipher_suites[i]->id.kdf == cipher_id.kdf &&\n            picoquic_hpke_cipher_suites[i]->id.aead == cipher_id.aead) {\n            *cipher = picoquic_hpke_cipher_suites[i];\n            break;\n        }\n    }\n    if (*cipher == NULL)\n        return NULL;\n    *p_kem = ech_cb->kem;\n\n    /* Compose the \"info\" field by combining the \"info_prefix\" and the selected configuration.\n    * In the unit test example, the binary string is preceded by a two bytes of length, with\n    * an added null byte at the end.\n    */\n\n    ptls_buffer_init(&infobuf, \"\", 0);\n    ptls_buffer_pushv(&infobuf, info_prefix.base, info_prefix.len);\n    ptls_buffer_pushv(&infobuf, ech_cb->config.base+2, ech_cb->config.off - 2);\n    ret = ptls_hpke_setup_base_r(ech_cb->kem, *cipher, ech_cb->keyex, &aead, enc,\n        ptls_iovec_init(infobuf.base, infobuf.off));\nExit:\n    ptls_buffer_dispose(&infobuf);\n    return aead;\n}\n\n/* Dispose of the ech callback. */\nstatic void ech_dispose_opener_callback(ech_opener_callback_t* ech_cb)\n{\n    if (picoquic_keyex_dispose_fn != NULL && ech_cb->keyex != NULL) {\n        picoquic_keyex_dispose_fn(ech_cb->keyex);\n    }\n    ptls_buffer_dispose(&ech_cb->config);\n    memset(ech_cb, 0, sizeof(ech_opener_callback_t));\n    free(ech_cb);\n}\n\n/* Initialize the opener structure */\nstatic int ech_init_opener_callback(ech_opener_callback_t** p_ech_cb, char const * private_key_file, char const* config_file_name)\n{\n    int ret = 0;\n    /* Allocate an opener callback */\n    ech_opener_callback_t* ech_cb = (ech_opener_callback_t*)malloc(sizeof(ech_opener_callback_t));\n    if (ech_cb == NULL) {\n        DBG_PRINTF(\"Cannot allocate callback memory (%zu bytes)\", sizeof(ech_opener_callback_t));\n        ret = PICOQUIC_ERROR_MEMORY;\n    }\n    else {\n        memset(ech_cb, 0, sizeof(ech_opener_callback_t));\n        /* set the callback */\n        ech_cb->super.cb = ech_opener_callback;\n        ptls_buffer_init(&ech_cb->config, \"\", 0);\n        /* Read the config bytes into the ech_cb->config buffer */\n        ret = picoquic_ech_read_config(&ech_cb->config, config_file_name);\n        if (ret != 0) {\n            DBG_PRINTF(\"Cannot read ech configuration from %s\", config_file_name);\n        } else {\n            uint16_t kem_id;\n            /* Get kem-id from config, then get kem from kem_id */\n            kem_id = (((uint16_t)ech_cb->config.base[7]) << 8) + ech_cb->config.base[8];\n            for (int i = 0; i < 4 && picoquic_hpke_kems[i] !=  NULL; i++) {\n                if (picoquic_hpke_kems[i]->id == kem_id) {\n                    ech_cb->kem = picoquic_hpke_kems[i];\n                    break;\n                }\n            }\n            if (ech_cb->kem == NULL){\n                DBG_PRINTF(\"Cannot find hpke kwm for code 0x%04x\", kem_id);\n                ret = PICOQUIC_ERROR_UNEXPECTED_ERROR;\n            }\n            else if (picoquic_keyex_from_key_file_fn == NULL) {\n                DBG_PRINTF(\"%s\", \"Cannot find picoquic_keyex_from_key_file_fn\");\n                ret = PICOQUIC_ERROR_UNEXPECTED_ERROR;\n            }\n            else {\n                ret = picoquic_keyex_from_key_file_fn(&ech_cb->keyex, private_key_file);\n                if (ret != 0) {\n                    DBG_PRINTF(\"picoquic_keyex_from_key_file_fn fails, ret= %d(0x%x)\", ret, ret);\n                }\n            }\n        }\n        if (ret != 0) {\n            ech_dispose_opener_callback(ech_cb);\n            ech_cb = NULL;\n        }\n    }\n    *p_ech_cb = ech_cb;\n    return ret;\n}\n\n/* Configure a QUIC context for ECH\n*\n* For both clients and servers, document:\n*    ech.client.ciphers: list of HPKE symmetric cipher-suites (set to NULL to disable ECH altogether)\n*    ech.client.kems: list of supported key exchanges.\n*    (these lists are initialized during the initialization of the TLS API.)\n* For the server, document:\n*    ech.server.create_opener: the ECH \"opener\" callback function, which\n*        does ECDH key exchange and returns the AEAD context.\n*    ech.server.retry_configs: ECHConfigList to be sent to the client when\n*        there is mismatch (or when the client sends a grease)\n* We assume here that there will be just one ECH configuration for the server.\n* We copy this configuration in the ECH callback buffer, and we add a pointer\n* to it in ech.server.retry_configs.\n*/\nint picoquic_ech_configure_quic_ctx(picoquic_quic_t * quic, char const* private_key_file, char const* config_file_name)\n{\n    int ret = 0;\n    ptls_context_t* ctx = (ptls_context_t*)quic->tls_master_ctx;\n    PICOQUIC_THREAD_CHECK(quic);\n\n    picoquic_release_quic_ech_ctx(quic);\n    ctx->ech.client.ciphers = picoquic_hpke_cipher_suites;\n    ctx->ech.client.kems = picoquic_hpke_kems;\n    if (private_key_file != NULL) {\n        ech_opener_callback_t* ech_cb = NULL;\n        if ((ret = ech_init_opener_callback(&ech_cb, private_key_file, config_file_name)) == 0) {\n            ctx->ech.server.create_opener = &ech_cb->super;\n            ctx->ech.server.retry_configs.base = ech_cb->config.base;\n            ctx->ech.server.retry_configs.len = ech_cb->config.off;\n        }\n    }\n    return ret;\n}\n\n/* The call to ech_release_quic_ctx releases the allocations done by the\n* call to ech_configure_quic_ctx. It should be used when deleting the quic context.\n* It can be safely used even if there was no call to ech_configure_quic_ctx.\n* \n* This is performed automatically when deleting a quic context in \"picoquic_free\"\n */\n\nvoid picoquic_release_quic_ech_ctx(picoquic_quic_t* quic)\n{\n    ptls_context_t* ctx = (ptls_context_t*)quic->tls_master_ctx;\n    PICOQUIC_THREAD_CHECK(quic);\n\n    if (ctx != NULL) {\n        ech_opener_callback_t* ech_cb = (ech_opener_callback_t*)ctx->ech.server.create_opener;\n        ctx->ech.server.retry_configs.base = NULL;\n        ctx->ech.server.retry_configs.len = 0;\n\n        if (ech_cb != NULL) {\n            ech_dispose_opener_callback(ech_cb);\n        }\n    }\n}\n\n/* Configure a tls connection context on the client side:\n* We need to document the client handshake properties\n* \"ech.configs\" with a list of server configurations (HTTPS records.)\n* This data will be freed when deleted the tls_ctx for the connection.\n*/\nint picoquic_ech_configure_client(picoquic_cnx_t* cnx, const uint8_t * config_data, size_t config_length)\n{\n    int ret = 0;\n    picoquic_tls_ctx_t* tls_ctx = (picoquic_tls_ctx_t*)cnx->tls_ctx;\n    PICOQUIC_THREAD_CHECK(cnx->quic);\n\n    tls_ctx->handshake_properties.client.ech.configs.base = (uint8_t*)malloc(config_length+1);\n    if (tls_ctx->handshake_properties.client.ech.configs.base == NULL) {\n        ret = PICOQUIC_ERROR_MEMORY;\n    }\n    else {\n        if (config_length > 0) {\n            memcpy(tls_ctx->handshake_properties.client.ech.configs.base, config_data, config_length);\n        }\n        tls_ctx->handshake_properties.client.ech.configs.len = config_length;\n    }\n    return ret;\n}\n\n/* Check whether the ech handshake succeeded.\n */\nint picoquic_is_ech_handshake(picoquic_cnx_t* cnx)\n{\n    picoquic_tls_ctx_t* tls_ctx = (picoquic_tls_ctx_t*)cnx->tls_ctx;\n    PICOQUIC_THREAD_CHECK(cnx->quic);\n    return ptls_is_ech_handshake(tls_ctx->tls, NULL, NULL, NULL);\n}\n\n/* The key is expected to be read from a PEM file. The ASN1 syntax of a sec256r1\n* public key is:\n*   Sequence { (sequence type = 0x30)\n*      Sequence {  (sequence type = 0x30)\n*          Object_ID { (ASN1 type = 0x06)\n*             identifier of the algorithm -- 2a:86:48:ce:3d:02:01\n*          }\n*          Object_ID { (ASN1 type = 0x06)\n*             identifier of the curve -- 2a:86:48:ce:3d:03:01:07\n*      }\n*      BIT STRING {  (ASN1 type = 0x03)\n*         first octet encoded number of padding bits at the end, should be 00\n*         string of octets representing the public key\n*      }\n*   }\n* \n* For secp384r1 we find:\n* \n* Sequence {:30:76:\n*    Sequence { 30:10:\n*        Object ID { 06:07:\n*                      2a:86:48:ce:3d:02:01:\n*        Object ID { 06:05:\n*                     :2b:81:04:00:22:\n*    }\n*    BIT STRING {03:62:\n*       Null Byte 00:\n*       97 bytes: 04:43:e9:2c:2c:61:ae\n*       :69:bc:fa:ae:af:56:8d:90:e3:2d:d4:c6:43:66:97\n*       :a5:4c:73:82:3b:b6:dd:4f:d4:89:bc:1f:7d:f9:eb\n*       :c2:ad:ec:29:48:d0:3b:f6:92:e7:af:0f:7d:13:5f\n*       :a4:b6:a3:ab:3e:34:e8:56:81:11:9b:d5:4f:23:08\n*       :4e:1a:ee:95:10:e6:aa:36:33:f7:24:ce:f3:3c:21\n*       :e1:e6:2e:d4:69:d1:37:f3:c9:a6:d7:19:63:70:83\n*    }\n*  }\n*\n* \n* for x25519 we find:\n*  \n* Sequence { :30:2a:\n*     Sequence { 30:05:\n*         Object ID { 06:03:\n*                       2b:65:6e:\n*         }\n*     Bit String { 03:21:\n*         Null Byte 00\n*         :79:49:77\n*         :8b:22:a1:a7:f5:86:e4:09:62:54:79:21:36:55:55\n*         :16:49:20:a8:6e:dc:1d:bb:a2:2a:a6:7e:71:0c\n*     }\n* }\n* \n* From RFC 5480:\n* In the X.509 certificate, the subjectPublicKeyInfo field has the\n* SubjectPublicKeyInfo type, which has the following ASN.1 syntax:\n*     SubjectPublicKeyInfo  ::=  SEQUENCE  {\n*      algorithm         AlgorithmIdentifier,\n*      subjectPublicKey  BIT STRING\n*     }\n*     \n*    AlgorithmIdentifier  ::=  SEQUENCE  {\n*        algorithm   OBJECT IDENTIFIER,\n*        parameters  ANY DEFINED BY algorithm OPTIONAL\n*    }\n*    id-ecPublicKey OBJECT IDENTIFIER ::= {\n*        iso(1) member-body(2) us(840) ansi-X9-62(10045) keyType(2) 1 }\n*    \n* secp256r1 OBJECT IDENTIFIER ::= {\n*    iso(1) member-body(2) us(840) ansi-X9-62(10045) curves(3)\n*    prime(1) 7 }\n* secp384r1 OBJECT IDENTIFIER ::= {\n*    iso(1) identified-organization(3) certicom(132) curve(0) 34 }\n* \n* From RFC 8410:\n* id-X25519    OBJECT IDENTIFIER ::= { 1 3 101 110 }\n*/\n\nsize_t picoquic_parse_public_key_asn1(ptls_iovec_t public_key_asn1,\n    ptls_iovec_t* public_key_algo, ptls_iovec_t* public_key_param,\n    ptls_iovec_t* public_key_bit_string, int* decode_error,\n    ptls_minicrypto_log_ctx_t* log_ctx)\n{\n    uint8_t* bytes = public_key_asn1.base;\n    size_t bytes_max = public_key_asn1.len;\n\n    /* read the ASN1 messages */\n    size_t byte_index = 0;\n    uint32_t seq0_length = 0;\n    size_t last_byte0;\n    uint32_t seq1_length = 0;\n    size_t last_byte1 = 0;\n    uint32_t oid_length;\n    size_t last_oid_byte;\n    uint32_t key_data_length;\n    size_t key_data_last;\n\n    /* start with sequence */\n    byte_index = ptls_asn1_get_expected_type_and_length(bytes, bytes_max, byte_index, 0x30, &seq0_length, NULL, &last_byte0,\n        decode_error, log_ctx);\n\n    if (*decode_error == 0 && bytes_max != last_byte0) {\n        byte_index = ptls_asn1_error_message(\"Length larger than message\", bytes_max, byte_index, 0, log_ctx);\n        *decode_error = PTLS_ERROR_BER_EXCESSIVE_LENGTH;\n    }\n\n    if (*decode_error == 0) {\n        /* open embedded sequence */\n        byte_index = ptls_asn1_get_expected_type_and_length(bytes, bytes_max, byte_index, 0x30, &seq1_length, NULL, &last_byte1,\n            decode_error, log_ctx);\n    }\n\n    if (*decode_error == 0) {\n        if (log_ctx != NULL) {\n            log_ctx->fn(log_ctx->ctx, \"   Algorithm Identifier:\\n\");\n        }\n        /* get length of OID */\n        byte_index = ptls_asn1_get_expected_type_and_length(bytes, last_byte1, byte_index, 0x06, &oid_length, NULL, &last_oid_byte,\n            decode_error, log_ctx);\n\n        if (*decode_error == 0) {\n            if (log_ctx != NULL) {\n                /* print the OID value */\n                log_ctx->fn(log_ctx->ctx, \"      Algorithm:\");\n                ptls_asn1_dump_content(bytes + byte_index, oid_length, 0, log_ctx);\n                log_ctx->fn(log_ctx->ctx, \",\\n\");\n            }\n            public_key_algo->base = bytes + byte_index;\n            public_key_algo->len = oid_length;\n            byte_index += oid_length;\n        }\n    }\n\n    if (*decode_error == 0) {\n        /* get parameters, ANY */\n        if (log_ctx != NULL) {\n            log_ctx->fn(log_ctx->ctx, \"      Parameters:\\n\");\n        }\n\n        public_key_param->base = bytes + byte_index;\n        if (last_byte1 <= byte_index) {\n            public_key_param->len = 0;\n        }\n        else {\n            public_key_param->len = last_byte1 - byte_index;\n        }\n        byte_index = last_byte1;\n    }\n\n    /* get bit string, key */\n    if (*decode_error == 0) {\n        byte_index = ptls_asn1_get_expected_type_and_length(bytes, last_byte0, byte_index, 0x03, &key_data_length, NULL,\n            &key_data_last, decode_error, log_ctx);\n        if (*decode_error == 0) {\n            public_key_bit_string->base = bytes + byte_index;\n            public_key_bit_string->len = key_data_length;\n            byte_index += key_data_length;\n        }\n    }\n\n    if (*decode_error == 0 && byte_index != last_byte0) {\n        byte_index = ptls_asn1_error_message(\"Length larger than element\", bytes_max, byte_index, 0, log_ctx);\n        *decode_error = PTLS_ERROR_BER_ELEMENT_TOO_SHORT;\n    }\n\n    if (log_ctx != NULL) {\n        log_ctx->fn(log_ctx->ctx, \"\\n\");\n    }\n    return byte_index;\n}\n\n\nstatic uint8_t oid_algo_secp[] = { 0x2a, 0x86, 0x48, 0xce, 0x3d, 0x02, 0x01 };\nstatic uint8_t oid_pr_secp256r1[] = { 0x06, 0x08, 0x2a, 0x86, 0x48, 0xce, 0x3d, 0x03, 0x01, 0x07 };\nstatic uint8_t oid_pr_secp384r1[] = { 0x06, 0x05, 0x2b, 0x81, 0x04, 0x00, 0x22 };\nstatic uint8_t oid_x25519[] = { 0x2b, 0x65, 0x6e };\n\nint picoquic_ech_parse_public_key(ptls_iovec_t public_key_asn1,\n    uint16_t* group_id,\n    ptls_iovec_t* public_key_bits)\n{\n    int ret = 0;\n    ptls_iovec_t public_key_algo;\n    ptls_iovec_t public_key_param;\n    ptls_iovec_t public_key_bit_string;\n    size_t expected_key_length = 0;\n    (void)picoquic_parse_public_key_asn1(public_key_asn1,\n        &public_key_algo, &public_key_param,\n        &public_key_bit_string, &ret, NULL);\n    if (ret == 0) {\n        if (public_key_algo.len == sizeof(oid_algo_secp) &&\n            memcmp(public_key_algo.base, oid_algo_secp, sizeof(oid_algo_secp)) == 0) {\n            if (public_key_param.len == sizeof(oid_pr_secp256r1) &&\n                memcmp(public_key_param.base, oid_pr_secp256r1, sizeof(oid_pr_secp256r1)) == 0) {\n                *group_id = PTLS_GROUP_SECP256R1;\n                expected_key_length = 0x41;\n            }\n            else if (public_key_param.len == sizeof(oid_pr_secp384r1) &&\n                memcmp(public_key_param.base, oid_pr_secp384r1, sizeof(oid_pr_secp384r1)) == 0) {\n                *group_id = PTLS_GROUP_SECP384R1;\n                expected_key_length = 0x61;\n            }\n            else {\n                DBG_PRINTF(\"%s\", \"Unsupported SecP Group ID\");\n                ret = -1;\n            }\n        }\n        else if (public_key_algo.len == sizeof(oid_x25519) &&\n            memcmp(public_key_algo.base, oid_x25519, sizeof(oid_x25519)) == 0) {\n            *group_id = PTLS_GROUP_X25519;\n            expected_key_length = 0x20;\n        }\n    }\n    else {\n        DBG_PRINTF(\"%s\", \"Unsupported Algorithm ID\");\n        ret = -1;\n    }\n    if (ret == 0) {\n        if (public_key_bit_string.len > 1 && public_key_bit_string.base[0] == 0) {\n            public_key_bits->base = public_key_bit_string.base + 1;\n            public_key_bits->len = public_key_bit_string.len - 1;\n            if (public_key_bits->len != expected_key_length) {\n                DBG_PRINTF(\"Invalid length for curve 0x%04x: %zu, expected %zu\",\n                    *group_id, public_key_bits->len, expected_key_length);\n                ret = -1;\n            }\n        }\n    }\n    return ret;\n}\n\nint picoquic_ech_get_kem_from_curve(ptls_hpke_kem_t **kem, uint16_t group_id)\n{\n    int ret = -1;\n\n    for (int i = 0; i < PICOQUIC_HPKE_KEM_NB_MAX; i++) {\n        if (picoquic_hpke_kems[i] == NULL) {\n            break;\n        }\n        else if (picoquic_hpke_kems[i]->keyex->id == group_id) {\n            *kem = picoquic_hpke_kems[i];\n            ret = 0;\n            break;\n        }\n    }\n    return ret;\n}\n\nint picoquic_ech_get_ciphers_from_kem(ptls_hpke_cipher_suite_t** cipher_vec, size_t cipher_vec_nb_max, uint16_t kem_id)\n{\n    int ret = 0;\n    size_t nb_ciphers = 0;\n    uint16_t target_kdf_id = PTLS_HPKE_HKDF_SHA256;\n    uint16_t target_aead_id = PTLS_HPKE_AEAD_AES_128_GCM;\n    ptls_hpke_cipher_suite_t* target_cipher = NULL;\n    ptls_hpke_cipher_suite_t* default_cipher = NULL;\n\n    if (cipher_vec_nb_max < 2) {\n        return -1;\n    }\n\n    switch (kem_id) {\n    case PTLS_HPKE_KEM_P256_SHA256:\n        target_kdf_id = PTLS_HPKE_HKDF_SHA256;\n        target_aead_id = PTLS_HPKE_AEAD_AES_128_GCM;\n        break;\n    case PTLS_HPKE_KEM_P384_SHA384:\n        target_kdf_id = PTLS_HPKE_HKDF_SHA384;\n        target_aead_id = PTLS_HPKE_AEAD_AES_256_GCM;\n        break;\n    case PTLS_HPKE_KEM_X25519_SHA256:\n        target_kdf_id = PTLS_HPKE_HKDF_SHA256;\n        target_aead_id = PTLS_HPKE_AEAD_CHACHA20POLY1305;\n        break;\n    default:\n        break;\n    }\n\n    for (size_t i = 0; i < PICOQUIC_HPKE_CIPHER_SUITE_NB_MAX; i++) {\n        if (picoquic_hpke_cipher_suites[i] == NULL) {\n            break;\n        }\n        else if (picoquic_hpke_cipher_suites[i]->id.aead == target_aead_id &&\n            picoquic_hpke_cipher_suites[i]->id.kdf == target_kdf_id) {\n            target_cipher = picoquic_hpke_cipher_suites[i];\n            break;\n        }\n        else if (picoquic_hpke_cipher_suites[i]->id.aead == PTLS_HPKE_AEAD_AES_128_GCM &&\n            picoquic_hpke_cipher_suites[i]->id.kdf == PTLS_HPKE_HKDF_SHA256) {\n            default_cipher = picoquic_hpke_cipher_suites[i];\n        }\n    }\n    if (target_cipher == NULL) {\n        if (default_cipher != NULL) {\n            cipher_vec[0] = default_cipher;\n            nb_ciphers = 1;\n        }\n        else {\n            ret = -1;\n        }\n    } else {\n        cipher_vec[0] = target_cipher;\n        nb_ciphers = 1;\n        if (default_cipher != NULL && default_cipher != target_cipher && cipher_vec_nb_max > 2) {\n            cipher_vec[1] = default_cipher;\n            nb_ciphers++;\n        }\n    }\n    for (size_t i = nb_ciphers; i < cipher_vec_nb_max; i++) {\n        cipher_vec[i] = NULL;\n    }\n    return ret;\n}\n\nstatic uint8_t ech_config_id_from_config(ptls_iovec_t public_key_bits, ptls_hpke_kem_t* kem, ptls_hpke_cipher_suite_t** cipher_vec, char const* public_name)\n{\n    /* compute the config ID */\n    uint64_t config_sum = 0;\n    uint8_t config_id = 0;\n    for (size_t i = 0; i < public_key_bits.len; i++) {\n        config_sum += public_key_bits.base[i];\n    }\n    config_sum += kem->id;\n    for (size_t i = 0; cipher_vec[i] != NULL; i++) {\n        config_sum += cipher_vec[i]->id.aead;\n        config_sum += cipher_vec[i]->id.kdf;\n    }\n    for (size_t i = 0; public_name[i] != 0; i++) {\n        config_sum += (uint8_t)public_name[i];\n    }\n    while (config_sum > 0) {\n        config_id ^= (uint8_t)(config_sum & 0xff);\n        config_sum >>= 8;\n    }\n    return config_id;\n}\n\n/* Server side support.\n*\n* The server need two parameters: an ECH encryption key, and an\n* ECH configuration.\n*\n* The ECH configuration has several parameters:\n* - configuration ID,\n* - identifier of the HPKE key encapsulation mechanism (KEM),\n* - server public name, i.e., the DNS name of the client facing server,\n* - server public key, i.e., the public key of the client facing server.\n* - supported HPKE cipher suites.\n*\n* If the configuration is not available, it will have to be created.\n* The server admin will have to provide the parameters.\n* Many picoquic deployments use small servers with limited management.\n* In that case, we may use default values such as the DNS name of\n* the local server, the public key found in the local server certificate,\n* a locally supported HPKE-KEM compatible with the public key,\n* the list of locally supported HPKE symmetric cipher suites,\n* and a configuration ID computed as combination of these local\n* parameters.\n*/\nstatic int picoquic_ech_create_config_list_from_config(ptls_buffer_t* config_buf, uint8_t** config_list, size_t* config_list_len)\n{\n    int ret = 0;\n    size_t bin_size = config_buf->off + 2;\n    uint8_t* bin_val = (uint8_t*)malloc(bin_size);\n    if (bin_val == NULL) {\n        DBG_PRINTF(\"Cannot allocate %d bytes for config bin buffer\", bin_size);\n        ret = -1;\n    }\n    else {\n        bin_val[0] = (uint8_t)(((config_buf->off) >> 8) & 0xff);\n        bin_val[1] = (uint8_t)(config_buf->off & 0xff);\n        memcpy(bin_val + 2, config_buf->base, config_buf->off);\n        *config_list = bin_val;\n        *config_list_len = bin_size;\n    }\n    return ret;\n}\n\nstatic int picoquic_ech_create_config_from_pk(ptls_buffer_t* config_buf, uint16_t group_id, ptls_iovec_t public_key_bits, char const* public_name)\n{\n    int ret = 0;\n    ptls_hpke_kem_t* kem = NULL;\n    ptls_hpke_cipher_suite_t* cipher_vec[PICOQUIC_HPKE_CIPHER_SUITE_NB_MAX + 1];\n\n    if ((ret = picoquic_ech_get_kem_from_curve(&kem, group_id)) != 0) {\n        DBG_PRINTF(\"Could not find KEM for group = 0x%04x\", group_id);\n    }\n    /* Find the list of locally supported cipher suites, retaining only the most common */\n    else if ((ret = picoquic_ech_get_ciphers_from_kem(cipher_vec, PICOQUIC_HPKE_CIPHER_SUITE_NB_MAX + 1, kem->id)) != 0) {\n        DBG_PRINTF(\"Could not find Ciphers for kem = 0x%04x\", kem->id);\n    }\n    else {\n        /* Compute a config ID from public key bytes, kem-id, cipher-suite IDs and public name */\n        uint8_t config_id = ech_config_id_from_config(public_key_bits, kem, cipher_vec, public_name);\n        /* Encode the key config */\n        if ((ret = ptls_ech_encode_config(config_buf, config_id, kem, public_key_bits,\n            cipher_vec, 255, public_name)) != 0) {\n            DBG_PRINTF(\"Could not encode the configuration, err: %x\", ret);\n        }\n    }\n    return ret;\n}\n\nstatic int picoquic_ech_create_rr_from_binary(ptls_buffer_t* config_buf, ptls_iovec_t public_key_asn1, char const* public_name)\n{\n    int ret = 0;\n    ptls_iovec_t public_key_bits = ptls_iovec_init(NULL, 0);\n    uint16_t group_id = 0;\n\n    /* Parse the ASN1 public key to extract the key type and the key bytes */\n    if ((ret = picoquic_ech_parse_public_key(public_key_asn1, &group_id, &public_key_bits)) != 0) {\n        DBG_PRINTF(\"Cannot get group and pubkey from ASN1, err: %x\", ret);\n    }\n    /* Build config from group id and key bits */\n    else {\n        ret = picoquic_ech_create_config_from_pk(config_buf, group_id, public_key_bits, public_name);\n    }\n    return ret;\n}\n\nint picoquic_ech_create_config_from_binary(uint8_t ** config, size_t * config_len, ptls_iovec_t public_key_asn1, char const* public_name)\n{\n    int ret = 0;\n    ptls_buffer_t config_buf;\n    ptls_buffer_init(&config_buf, \"\", 0);\n\n    if ((ret = picoquic_ech_create_rr_from_binary(&config_buf, public_key_asn1, public_name)) == 0) {\n        ret = picoquic_ech_create_config_list_from_config(&config_buf, config, config_len);\n    }\n    ptls_buffer_dispose(&config_buf);\n    return ret;\n}\n\nint picoquic_ech_create_config_from_public_key(uint8_t** config, size_t* config_len, char const * public_key_file, char const* public_name)\n{\n    int ret = 0;\n    ptls_iovec_t public_key_asn1 = ptls_iovec_init(NULL, 0);\n    size_t pub_key_objects = 0;\n\n    /* Read the public key from a file. */\n    ret = ptls_load_pem_objects(public_key_file, \"PUBLIC KEY\", &public_key_asn1, 1, &pub_key_objects);\n    if (ret != 0) {\n        DBG_PRINTF(\"Cannot load pubkey from <%s>, err: %x\", public_key_file, ret);\n    }\n    else\n    {\n        ret = picoquic_ech_create_config_from_binary(config, config_len, public_key_asn1, public_name);\n    }\n    if (public_key_asn1.base != NULL) {\n        free(public_key_asn1.base);\n    }\n    return ret;\n}\n\n\nint picoquic_ech_create_config_from_private_key(uint8_t** config, size_t* config_len, char const* private_key_file, char const* public_name)\n{\n    int ret = 0;\n\n    *config = NULL;\n    *config_len = 0;\n\n    if (picoquic_get_public_key_from_private_fn != NULL) {\n        uint16_t group_id = 0;\n        ptls_iovec_t public_key_bits = ptls_iovec_init(NULL, 0);\n\n        ret = picoquic_get_public_key_from_private_fn(private_key_file, &public_key_bits.base, &public_key_bits.len);\n\n        if (ret == 0) {\n            switch (public_key_bits.len) {\n            case 0x21: /* x25519 */\n                group_id = 0x001d;\n                break;\n            case 0x41: /* secp265r1 */\n                group_id = 0x0017;\n                break;\n            case 0x61: /* x25519 */\n                group_id = 0x0018;\n                break;\n            default:\n                DBG_PRINTF(\"Cannot find group ID from pubkey length 0x%02x from %s\",\n                    public_key_bits.len, private_key_file);\n                ret = -1;\n                break;\n            }\n        }\n\n        if (ret == 0) {\n            ptls_buffer_t config_buf;\n            ptls_buffer_init(&config_buf, \"\", 0);\n            ret = picoquic_ech_create_config_from_pk(&config_buf, group_id, public_key_bits, public_name);\n            if (ret == 0) {\n                ret = picoquic_ech_create_config_list_from_config(&config_buf, config, config_len);\n            }\n            ptls_buffer_dispose(&config_buf);\n        }\n        if (public_key_bits.base != NULL) {\n            free(public_key_bits.base);\n        }\n    }\n    return ret;\n}\n\nint picoquic_ech_create_config_file(char const* public_name, char const* private_key_file, char const* ech_config_file)\n{\n    uint8_t* config = NULL;\n    size_t config_len = 0;\n    int ret = picoquic_ech_create_config_from_private_key(&config, &config_len, private_key_file, public_name);\n\n    if (ret == 0) {\n        ret = picoquic_ech_save_config(config, config_len, ech_config_file);\n    }\n    if (config != NULL) {\n        free(config);\n    }\n    return ret;\n}\n\n#if 0\n/*\n* In theory, all the information required to set up ECH is present in the\n* certificate used by the public server. The public key certainly is there.\n* \n* The certificate has a rather simple structure (see RFC 5280):\n* \n*  Certificate  ::=  SEQUENCE  {\n*        tbsCertificate       TBSCertificate,\n*        signatureAlgorithm   AlgorithmIdentifier,\n*        signatureValue       BIT STRING  }\n*\n*   TBSCertificate  ::=  SEQUENCE  {\n*        version         [0]  EXPLICIT Version DEFAULT v1,\n*        serialNumber         CertificateSerialNumber,\n*        signature            AlgorithmIdentifier,\n*        issuer               Name,\n*        validity             Validity,\n*        subject              Name,\n*        subjectPublicKeyInfo SubjectPublicKeyInfo,\n*        issuerUniqueID  [1]  IMPLICIT UniqueIdentifier OPTIONAL,\n*                             -- If present, version MUST be v2 or v3\n*        subjectUniqueID [2]  IMPLICIT UniqueIdentifier OPTIONAL,\n*                             -- If present, version MUST be v2 or v3\n*        extensions      [3]  EXPLICIT Extensions OPTIONAL\n*                             -- If present, version MUST be v3\n*        }\n* \n* We need a simple parser that:\n* - opens the outside sequence,\n* - opens its first element, the TBSCertificate\n* - skip the elements version [0], serialNumber (INTEGER), \n*   signature (AlgorithmIdentifier, SEQUENCE),\n*   issuer (Name, CHOICE, RdnSequence SEQUENCE OF),\n*   validity (SEQUENCE)\n*   subject (Name, CHOICE, RdnSequence SEQUENCE OF).\n* - return the bytes from start (Type) of subjectPublicKeyInfo(SEQUENCE)\n*   to end of that element.\n*/\nint picoquic_ech_get_public_key_from_cert(ptls_iovec_t cert, ptls_iovec_t* public_key_asn1,\n    ptls_minicrypto_log_ctx_t* log_ctx)\n{\n    int ret = 0;\n    uint8_t* bytes = cert.base;\n    size_t bytes_max = cert.len;\n    size_t byte_index = 0;\n    uint32_t seq0_length = 0;\n    size_t last_byte0;\n    uint32_t seq1_length = 0;\n    size_t last_byte1 = 0;\n    size_t last_byte2 = 0;\n    uint32_t skipped_length;\n    size_t pubkey_info_index = 0;\n    int indefinite_length;\n    const uint8_t skipped_types[] = {\n        0xa0, /* version [0] */\n        0x02, /* serialNumber (INTEGER) */\n        0x30, /* AlgorithmIdentifier, SEQUENCE) */\n        0x30, /* issuer (Name, CHOICE, RdnSequence SEQUENCE OF) */\n        0x30, /* validity (SEQUENCE) */\n        0x30, /* subject (Name, CHOICE, RdnSequence SEQUENCE OF). */\n    };\n    /* open the outside sequence */\n\n    /* start with sequence */\n    byte_index = ptls_asn1_get_expected_type_and_length(bytes, bytes_max, byte_index, 0x30, &seq0_length, NULL, &last_byte0,\n        &ret, log_ctx);\n    if (ret == 0 && bytes_max != last_byte0) {\n        byte_index = ptls_asn1_error_message(\"Length larger than message\", bytes_max, byte_index, 0, log_ctx);\n        ret = PTLS_ERROR_BER_EXCESSIVE_LENGTH;\n    }\n    if (ret == 0) {\n        byte_index = ptls_asn1_get_expected_type_and_length(bytes, seq0_length, byte_index, 0x30, &seq1_length, NULL, &last_byte1,\n            &ret, log_ctx);\n    }\n    /* get the first component, TBSCertificate SEQUENCE */\n    for (size_t i = 0; i < sizeof(skipped_types) && ret == 0; i++) {\n        {\n            byte_index = ptls_asn1_get_expected_type_and_length(bytes, last_byte1, byte_index, skipped_types[i], &skipped_length,\n                &indefinite_length, &last_byte2,\n                &ret, log_ctx);\n            if (ret == 0) {\n                byte_index += skipped_length;\n            }\n        }\n    }\n    /* If all went well, this component is the public key info. */\n    if (ret == 0) {\n        pubkey_info_index = byte_index;\n        /* open embedded sequence */\n        byte_index = ptls_asn1_get_expected_type_and_length(bytes, last_byte1, byte_index, 0x30, &skipped_length, NULL, &last_byte2,\n            &ret, log_ctx);\n        if (ret == 0) {\n            public_key_asn1->base = bytes + pubkey_info_index;\n            public_key_asn1->len = byte_index + skipped_length - pubkey_info_index;\n        }\n    }\n    return ret;\n}\n\nint picoquic_ech_create_config_from_cert(uint8_t** config, size_t* config_len, char const* cert_file, char const* public_name)\n{\n    int ret = 0;\n    ptls_iovec_t cert_bytes = ptls_iovec_init(NULL, 0);\n    ptls_iovec_t public_key_asn1 = ptls_iovec_init(NULL, 0);\n    size_t cert_objects = 0;\n    /* Read the cert from a file. */\n    if ((ret = ptls_load_pem_objects(cert_file, \"CERTIFICATE\", &cert_bytes, 1, &cert_objects)) != 0) {\n        DBG_PRINTF(\"Cannot read cert bytes from <%s>\", cert_file);\n    }\n    /* Extract the Public Key Info */\n    if (ret == 0 && (ret = picoquic_ech_get_public_key_from_cert(cert_bytes, &public_key_asn1, NULL)) != 0) {\n        DBG_PRINTF(\"Cannot extract public key from cert bytes of <%s>, ret = %d (0x%x)\", cert_file, ret, ret);\n    }\n    /* Obtain the configuration */\n    if (ret == 0){\n        ret = picoquic_ech_create_config_from_binary(config, config_len, public_key_asn1, public_name);\n    }\n    if (cert_bytes.base != NULL) {\n        free(cert_bytes.base);\n    }\n    return ret;\n}\n#endif\n\nvoid picoquic_ech_get_retry_config(picoquic_cnx_t* cnx,\n    uint8_t** retry_config, size_t* retry_config_len)\n{\n    picoquic_tls_ctx_t* tls_ctx = (picoquic_tls_ctx_t*)cnx->tls_ctx;\n    PICOQUIC_THREAD_CHECK(cnx->quic);\n\n    *retry_config = tls_ctx->retry_configs.base;\n    *retry_config_len = tls_ctx->retry_configs.len;\n}\n","numLines":1076,"startLine":1,"totalLines":1076}}}
