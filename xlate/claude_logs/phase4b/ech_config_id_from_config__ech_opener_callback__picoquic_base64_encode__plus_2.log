{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01SVjvuwCmaQMBvGak4psgA4","type":"tool_result","content":"1\t//! Test cases for `picoquictest/ech_test.c`.\n2\t//!\n3\t//! Exercises Encrypted Client Hello (ECH):\n4\t//!\n5\t//! * `ech_config` / `ech_config_p` — build an ECH config list from a\n6\t//!   public-key or private-key file and verify it matches the reference.\n7\t//! * `ech_e2e` — end-to-end handshake with ECH enabled, verify success.\n8\t//! * `ech_e2e_0rtt` — ECH with GREASE (no config), complete the\n9\t//!   connection, obtain a session ticket, and verify 0-RTT on the second\n10\t//!   connection.\n11\t//! * `ech_grease` — client sends ECH GREASE (no valid config); server\n12\t//!   should *not* report `is_ech_handshake`.\n13\t//! * `ech_no_ech` — server has no ECH key; client should fall back and\n14\t//!   complete the connection; second connection reuses the ticket.\n15\t\n16\t#![allow(non_snake_case)]\n17\t\n18\tuse super::util::{\n19\t    TEST_ALPN, TEST_ECH_CONFIG, TEST_ECH_CONFIG_REF, TEST_ECH_PRIVATE_KEY, TEST_ECH_PUB_KEY,\n20\t    TEST_SNI, TestApiStreamDesc, save_empty_tickets, session_resume_wait_for_ticket,\n21\t    test_api_init_send_recv_scenario, tls_api_connection_loop, tls_api_data_sending_loop,\n22\t    tls_api_init_ctx_ex, tls_api_one_scenario_body_verify, tls_api_synch_to_empty_loop,\n23\t};\n24\tuse crate::internal::Version;\n25\tuse crate::{\n26\t    ConnectionId, Error, Instant, ech_create_config_from_private_key,\n27\t    ech_create_config_from_public_key, ech_read_config, ech_save_config, tls_api_init,\n28\t};\n29\t\n30\t// ---------------------------------------------------------------------------\n31\t// Constants.\n32\t\n33\tconst ECH_CONFIG_FILE: &str = \"ech_config.txt\";\n34\t#[allow(dead_code)]\n35\tconst ECH_TICKET_FILE: &str = \"ech_ticket_store.bin\";\n36\tconst ECH_PUBLIC_NAME: &str = \"test.example.com\";\n37\tconst ECH_SCENARIO_SMALL: &[TestApiStreamDesc] = &[TestApiStreamDesc {\n38\t    stream_id: 4,\n39\t    previous_stream_id: 0,\n40\t    q_len: 256,\n41\t    r_len: 1000,\n42\t}];\n43\t\n44\t// ---------------------------------------------------------------------------\n45\t// Local helper.\n46\t\n47\t/// Read the ECH config from `ref_file` and assert it byte-matches `config`.\n48\t/// C: `ech_test_check_buf` in `picoquictest/ech_test.c`.\n49\tfn ech_test_check_buf(config: &[u8], ref_file: &str) -> crate::Result<()> {\n50\t    let ref_config = ech_read_config(ref_file)?;"}]},"parent_tool_use_id":null,"session_id":"c694d8c7-5173-4d7d-b47f-1867084f331f","uuid":"f5815b05-bdab-4b7b-bb82-6aa6b56871b8","timestamp":"2026-05-07T05:59:10.831Z","tool_use_result":{"type":"text","file":{"filePath":"/Users/richbarn/Projects/picoquic/rs/fq/src/tests/ech.rs","content":"//! Test cases for `picoquictest/ech_test.c`.\n//!\n//! Exercises Encrypted Client Hello (ECH):\n//!\n//! * `ech_config` / `ech_config_p` — build an ECH config list from a\n//!   public-key or private-key file and verify it matches the reference.\n//! * `ech_e2e` — end-to-end handshake with ECH enabled, verify success.\n//! * `ech_e2e_0rtt` — ECH with GREASE (no config), complete the\n//!   connection, obtain a session ticket, and verify 0-RTT on the second\n//!   connection.\n//! * `ech_grease` — client sends ECH GREASE (no valid config); server\n//!   should *not* report `is_ech_handshake`.\n//! * `ech_no_ech` — server has no ECH key; client should fall back and\n//!   complete the connection; second connection reuses the ticket.\n\n#![allow(non_snake_case)]\n\nuse super::util::{\n    TEST_ALPN, TEST_ECH_CONFIG, TEST_ECH_CONFIG_REF, TEST_ECH_PRIVATE_KEY, TEST_ECH_PUB_KEY,\n    TEST_SNI, TestApiStreamDesc, save_empty_tickets, session_resume_wait_for_ticket,\n    test_api_init_send_recv_scenario, tls_api_connection_loop, tls_api_data_sending_loop,\n    tls_api_init_ctx_ex, tls_api_one_scenario_body_verify, tls_api_synch_to_empty_loop,\n};\nuse crate::internal::Version;\nuse crate::{\n    ConnectionId, Error, Instant, ech_create_config_from_private_key,\n    ech_create_config_from_public_key, ech_read_config, ech_save_config, tls_api_init,\n};\n\n// ---------------------------------------------------------------------------\n// Constants.\n\nconst ECH_CONFIG_FILE: &str = \"ech_config.txt\";\n#[allow(dead_code)]\nconst ECH_TICKET_FILE: &str = \"ech_ticket_store.bin\";\nconst ECH_PUBLIC_NAME: &str = \"test.example.com\";\nconst ECH_SCENARIO_SMALL: &[TestApiStreamDesc] = &[TestApiStreamDesc {\n    stream_id: 4,\n    previous_stream_id: 0,\n    q_len: 256,\n    r_len: 1000,\n}];\n\n// ---------------------------------------------------------------------------\n// Local helper.\n\n/// Read the ECH config from `ref_file` and assert it byte-matches `config`.\n/// C: `ech_test_check_buf` in `picoquictest/ech_test.c`.\nfn ech_test_check_buf(config: &[u8], ref_file: &str) -> crate::Result<()> {\n    let ref_config = ech_read_config(ref_file)?;","numLines":50,"startLine":1,"totalLines":306}}}
