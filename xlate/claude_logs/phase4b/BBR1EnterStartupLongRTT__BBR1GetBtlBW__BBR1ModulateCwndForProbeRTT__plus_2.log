{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01YLndRiQM7teWVLHN2dZqPz","type":"tool_result","content":"1\t//! Translation of `picoquic/bbr1.c` — BBRv1 congestion control.\n2\t//!\n3\t//! Phase 4B: initial batch (BBR1AfterOneRoundtripInFastRecovery,\n4\t//! BBR1CheckFullPipe, BBR1EnterProbeRTT, BBR1EnterStartup).\n5\t\n6\tuse crate::cc_common::MinMaxRtt;\n7\t\n8\t// ---------------------------------------------------------------------------\n9\t// Constants from bbr1.c `#define`s.\n10\t\n11\tconst BBR1_HIGH_GAIN: f64 = 2.8853900817779; // C: BBR1_HIGH_GAIN (2/ln(2))\n12\tconst BBR1_BTL_BW_FILTER_LENGTH: usize = 10; // C: BBR1_BTL_BW_FILTER_LENGTH\n13\t\n14\t// ---------------------------------------------------------------------------\n15\t// Algorithm-state enum.  C: `picoquic_bbr1_alg_state_t`.\n16\t\n17\t#[derive(Debug, Copy, Clone, PartialEq, Eq, Default)]\n18\tpub enum Bbr1AlgState {\n19\t    #[default]\n20\t    Startup = 0,\n21\t    Drain,\n22\t    ProbeBw,\n23\t    ProbeRtt,\n24\t    StartupLongRtt,\n25\t}\n26\t\n27\t// ---------------------------------------------------------------------------\n28\t// BBR1 state.  C: `picoquic_bbr1_state_t`.\n29\t//\n30\t// Type deviations from C:\n31\t//   * single-bit `unsigned int x : 1` bitfields → `bool`\n32\t//   * `const char* option_string` → `Option<String>` (owned copy)\n33\t//   * `picoquic_min_max_rtt_t rtt_filter` → `MinMaxRtt`\n34\t//   * `int` round/count fields → `i32` (faithfully signed)\n35\t\n36\tpub struct Bbr1State {\n37\t    pub state: Bbr1AlgState,\n38\t    pub btl_bw: u64,\n39\t    pub next_round_delivered: u64,\n40\t    pub btl_bw_filter: [u64; BBR1_BTL_BW_FILTER_LENGTH],\n41\t    pub full_bw: u64,\n42\t    pub rt_prop: u64,\n43\t    pub rt_prop_stamp: u64,\n44\t    pub cycle_stamp: u64,\n45\t    pub probe_rtt_done_stamp: u64,\n46\t    pub prior_cwnd: u64,\n47\t    pub prior_in_flight: u64,\n48\t    pub bytes_delivered: u64,\n49\t    pub send_quantum: u64,\n50\t    pub rtt_filter: MinMaxRtt,\n51\t    pub target_cwnd: u64,\n52\t    pub pacing_gain: f64,\n53\t    pub cwnd_gain: f64,\n54\t    pub pacing_rate: f64,\n55\t    pub cycle_index: u32,\n56\t    pub cycle_start: u32,\n57\t    pub round_count: i32,\n58\t    pub full_bw_count: i32,\n59\t    pub lt_rtt_cnt: i32,\n60\t    pub lt_bw: u64,\n61\t    pub lt_last_stamp: u64,\n62\t    pub previous_round_lost: u64,\n63\t    pub previous_sampling_delivered: u64,\n64\t    pub previous_sampling_lost: u64,\n65\t    pub loss_interval_start: u64,\n66\t    pub congestion_sequence: u64,\n67\t    pub cwin_before_suspension: u64,\n68\t    pub option_string: Option<String>,\n69\t    pub wifi_shadow_rtt: u64,\n70\t    pub quantum_ratio: f64,\n71\t    pub filled_pipe: bool,\n72\t    pub round_start: bool,\n73\t    pub rt_prop_expired: bool,\n74\t    pub probe_rtt_round_done: bool,\n75\t    pub idle_restart: bool,\n76\t    pub packet_conservation: bool,\n77\t    pub btl_bw_increased: bool,\n78\t    pub lt_use_bw: bool,\n79\t    pub lt_is_sampling: bool,\n80\t    pub last_loss_was_timeout: bool,\n81\t    pub cycle_on_loss: bool,\n82\t    pub is_suspended: bool,\n83\t    pub is_suspension_nearly_over: bool,\n84\t}\n85\t\n86\timpl Bbr1State {\n87\t    /// C: `BBR1EnterStartup` (picoquic/bbr1.c:327)\n88\t    ///\n89\t    /// Enter the Startup state with the high-gain pacing and cwnd multipliers.\n90\t    pub fn enter_startup(&mut self) {\n91\t        self.state = Bbr1AlgState::Startup;\n92\t        self.pacing_gain = BBR1_HIGH_GAIN;\n93\t        self.cwnd_gain = BBR1_HIGH_GAIN;\n94\t    }\n95\t\n96\t    /// C: `BBR1CheckFullPipe` (picoquic/bbr1.c:771)\n97\t    ///\n98\t    /// Detect when the pipe is full during Startup.  On each round start\n99\t    /// (unless app-limited or already detected), check whether `btl_bw`\n100\t    /// has grown by ≥ 25%.  After three consecutive rounds without\n101\t    /// sufficient growth, set `filled_pipe`.\n102\t    pub fn check_full_pipe(&mut self, rs_is_app_limited: bool) {\n103\t        if !self.filled_pipe && self.round_start && !rs_is_app_limited {\n104\t            if self.btl_bw as f64 >= self.full_bw as f64 * 1.25 {\n105\t                self.full_bw = self.btl_bw;\n106\t                self.full_bw_count = 0;\n107\t            } else {\n108\t                self.full_bw_count += 1;\n109\t                if self.full_bw_count >= 3 {\n110\t                    self.filled_pipe = true;\n111\t                }\n112\t            }\n113\t        }\n114\t    }\n115\t\n116\t    /// C: `BBR1EnterProbeRTT` (picoquic/bbr1.c:885)\n117\t    ///\n118\t    /// Enter ProbeRTT state: coast at unity gains to drain the queue and\n119\t    /// obtain a fresh minimum-RTT sample.\n120\t    pub fn enter_probe_rtt(&mut self) {\n121\t        self.state = Bbr1AlgState::ProbeRtt;\n122\t        self.pacing_gain = 1.0;\n123\t        self.cwnd_gain = 1.0;\n124\t    }\n125\t\n126\t    /// C: `BBR1AfterOneRoundtripInFastRecovery` (picoquic/bbr1.c:1107)\n127\t    ///\n128\t    /// After the first full round-trip in fast recovery, disable packet\n129\t    /// conservation so the congestion window can grow normally again.\n130\t    pub fn after_one_roundtrip_in_fast_recovery(&mut self) {\n131\t        self.packet_conservation = false;\n132\t    }\n133\t}\n134\t\n135\t#[cfg(test)]\n136\tmod tests {\n137\t    use super::*;\n138\t\n139\t    fn make_state() -> Bbr1State {\n140\t        Bbr1State {\n141\t            state: Bbr1AlgState::default(),\n142\t            btl_bw: 0,\n143\t            next_round_delivered: 0,\n144\t            btl_bw_filter: [0; BBR1_BTL_BW_FILTER_LENGTH],\n145\t            full_bw: 0,\n146\t            rt_prop: 0,\n147\t            rt_prop_stamp: 0,\n148\t            cycle_stamp: 0,\n149\t            probe_rtt_done_stamp: 0,\n150\t            prior_cwnd: 0,\n151\t            prior_in_flight: 0,\n152\t            bytes_delivered: 0,\n153\t            send_quantum: 0,\n154\t            rtt_filter: MinMaxRtt::default(),\n155\t            target_cwnd: 0,\n156\t            pacing_gain: 1.0,\n157\t            cwnd_gain: 1.0,\n158\t            pacing_rate: 0.0,\n159\t            cycle_index: 0,\n160\t            cycle_start: 0,\n161\t            round_count: 0,\n162\t            full_bw_count: 0,\n163\t            lt_rtt_cnt: 0,\n164\t            lt_bw: 0,\n165\t            lt_last_stamp: 0,\n166\t            previous_round_lost: 0,\n167\t            previous_sampling_delivered: 0,\n168\t            previous_sampling_lost: 0,\n169\t            loss_interval_start: 0,\n170\t            congestion_sequence: 0,\n171\t            cwin_before_suspension: 0,\n172\t            option_string: None,\n173\t            wifi_shadow_rtt: 0,\n174\t            quantum_ratio: 0.001,\n175\t            filled_pipe: false,\n176\t            round_start: false,\n177\t            rt_prop_expired: false,\n178\t            probe_rtt_round_done: false,\n179\t            idle_restart: false,\n180\t            packet_conservation: false,\n181\t            btl_bw_increased: false,\n182\t            lt_use_bw: false,\n183\t            lt_is_sampling: false,\n184\t            last_loss_was_timeout: false,\n185\t            cycle_on_loss: false,\n186\t            is_suspended: false,\n187\t            is_suspension_nearly_over: false,\n188\t        }\n189\t    }\n190\t\n191\t    #[test]\n192\t    fn enter_startup_sets_state_and_gains() {\n193\t        let mut s = make_state();\n194\t        s.enter_startup();\n195\t        assert_eq!(s.state, Bbr1AlgState::Startup);\n196\t        assert!((s.pacing_gain - BBR1_HIGH_GAIN).abs() < f64::EPSILON);\n197\t        assert!((s.cwnd_gain - BBR1_HIGH_GAIN).abs() < f64::EPSILON);\n198\t    }\n199\t\n200\t    #[test]\n201\t    fn check_full_pipe_growing_resets_count() {\n202\t        let mut s = make_state();\n203\t        s.round_start = true;\n204\t        s.full_bw = 1000;\n205\t        s.btl_bw = 1300; // >= 1.25 * 1000\n206\t        s.check_full_pipe(false);\n207\t        assert_eq!(s.full_bw, 1300);\n208\t        assert_eq!(s.full_bw_count, 0);\n209\t        assert!(!s.filled_pipe);\n210\t    }\n211\t\n212\t    #[test]\n213\t    fn check_full_pipe_fills_after_3_stall_rounds() {\n214\t        let mut s = make_state();\n215\t        s.round_start = true;\n216\t        s.full_bw = 1000;\n217\t        s.btl_bw = 900; // < 1.25 * 1000\n218\t        s.check_full_pipe(false);\n219\t        assert_eq!(s.full_bw_count, 1);\n220\t        assert!(!s.filled_pipe);\n221\t        s.check_full_pipe(false);\n222\t        assert_eq!(s.full_bw_count, 2);\n223\t        s.check_full_pipe(false);\n224\t        assert_eq!(s.full_bw_count, 3);\n225\t        assert!(s.filled_pipe);\n226\t    }\n227\t\n228\t    #[test]\n229\t    fn check_full_pipe_skips_when_app_limited() {\n230\t        let mut s = make_state();\n231\t        s.round_start = true;\n232\t        s.full_bw = 1000;\n233\t        s.btl_bw = 900;\n234\t        s.check_full_pipe(true); // app-limited → skip\n235\t        assert_eq!(s.full_bw_count, 0);\n236\t        assert!(!s.filled_pipe);\n237\t    }\n238\t\n239\t    #[test]\n240\t    fn check_full_pipe_skips_when_already_filled() {\n241\t        let mut s = make_state();\n242\t        s.round_start = true;\n243\t        s.filled_pipe = true;\n244\t        s.full_bw = 1000;\n245\t        s.btl_bw = 900;\n246\t        s.check_full_pipe(false);\n247\t        assert_eq!(s.full_bw_count, 0); // guard skips the body\n248\t    }\n249\t\n250\t    #[test]\n251\t    fn enter_probe_rtt_sets_state_and_unity_gains() {\n252\t        let mut s = make_state();\n253\t        s.enter_probe_rtt();\n254\t        assert_eq!(s.state, Bbr1AlgState::ProbeRtt);\n255\t        assert!((s.pacing_gain - 1.0).abs() < f64::EPSILON);\n256\t        assert!((s.cwnd_gain - 1.0).abs() < f64::EPSILON);\n257\t    }\n258\t\n259\t    #[test]\n260\t    fn after_one_roundtrip_clears_packet_conservation() {\n261\t        let mut s = make_state();\n262\t        s.packet_conservation = true;\n263\t        s.after_one_roundtrip_in_fast_recovery();\n264\t        assert!(!s.packet_conservation);\n265\t    }\n266\t}\n267\t"}]},"parent_tool_use_id":null,"session_id":"3cc46119-9ac7-4618-9647-c26b3a01609f","uuid":"ae717ac6-96c9-4272-9a5c-f217d6f6b683","timestamp":"2026-05-07T05:10:19.581Z","tool_use_result":{"type":"text","file":{"filePath":"/Users/richbarn/Projects/picoquic/rs/fq/src/bbr1.rs","content":"//! Translation of `picoquic/bbr1.c` — BBRv1 congestion control.\n//!\n//! Phase 4B: initial batch (BBR1AfterOneRoundtripInFastRecovery,\n//! BBR1CheckFullPipe, BBR1EnterProbeRTT, BBR1EnterStartup).\n\nuse crate::cc_common::MinMaxRtt;\n\n// ---------------------------------------------------------------------------\n// Constants from bbr1.c `#define`s.\n\nconst BBR1_HIGH_GAIN: f64 = 2.8853900817779; // C: BBR1_HIGH_GAIN (2/ln(2))\nconst BBR1_BTL_BW_FILTER_LENGTH: usize = 10; // C: BBR1_BTL_BW_FILTER_LENGTH\n\n// ---------------------------------------------------------------------------\n// Algorithm-state enum.  C: `picoquic_bbr1_alg_state_t`.\n\n#[derive(Debug, Copy, Clone, PartialEq, Eq, Default)]\npub enum Bbr1AlgState {\n    #[default]\n    Startup = 0,\n    Drain,\n    ProbeBw,\n    ProbeRtt,\n    StartupLongRtt,\n}\n\n// ---------------------------------------------------------------------------\n// BBR1 state.  C: `picoquic_bbr1_state_t`.\n//\n// Type deviations from C:\n//   * single-bit `unsigned int x : 1` bitfields → `bool`\n//   * `const char* option_string` → `Option<String>` (owned copy)\n//   * `picoquic_min_max_rtt_t rtt_filter` → `MinMaxRtt`\n//   * `int` round/count fields → `i32` (faithfully signed)\n\npub struct Bbr1State {\n    pub state: Bbr1AlgState,\n    pub btl_bw: u64,\n    pub next_round_delivered: u64,\n    pub btl_bw_filter: [u64; BBR1_BTL_BW_FILTER_LENGTH],\n    pub full_bw: u64,\n    pub rt_prop: u64,\n    pub rt_prop_stamp: u64,\n    pub cycle_stamp: u64,\n    pub probe_rtt_done_stamp: u64,\n    pub prior_cwnd: u64,\n    pub prior_in_flight: u64,\n    pub bytes_delivered: u64,\n    pub send_quantum: u64,\n    pub rtt_filter: MinMaxRtt,\n    pub target_cwnd: u64,\n    pub pacing_gain: f64,\n    pub cwnd_gain: f64,\n    pub pacing_rate: f64,\n    pub cycle_index: u32,\n    pub cycle_start: u32,\n    pub round_count: i32,\n    pub full_bw_count: i32,\n    pub lt_rtt_cnt: i32,\n    pub lt_bw: u64,\n    pub lt_last_stamp: u64,\n    pub previous_round_lost: u64,\n    pub previous_sampling_delivered: u64,\n    pub previous_sampling_lost: u64,\n    pub loss_interval_start: u64,\n    pub congestion_sequence: u64,\n    pub cwin_before_suspension: u64,\n    pub option_string: Option<String>,\n    pub wifi_shadow_rtt: u64,\n    pub quantum_ratio: f64,\n    pub filled_pipe: bool,\n    pub round_start: bool,\n    pub rt_prop_expired: bool,\n    pub probe_rtt_round_done: bool,\n    pub idle_restart: bool,\n    pub packet_conservation: bool,\n    pub btl_bw_increased: bool,\n    pub lt_use_bw: bool,\n    pub lt_is_sampling: bool,\n    pub last_loss_was_timeout: bool,\n    pub cycle_on_loss: bool,\n    pub is_suspended: bool,\n    pub is_suspension_nearly_over: bool,\n}\n\nimpl Bbr1State {\n    /// C: `BBR1EnterStartup` (picoquic/bbr1.c:327)\n    ///\n    /// Enter the Startup state with the high-gain pacing and cwnd multipliers.\n    pub fn enter_startup(&mut self) {\n        self.state = Bbr1AlgState::Startup;\n        self.pacing_gain = BBR1_HIGH_GAIN;\n        self.cwnd_gain = BBR1_HIGH_GAIN;\n    }\n\n    /// C: `BBR1CheckFullPipe` (picoquic/bbr1.c:771)\n    ///\n    /// Detect when the pipe is full during Startup.  On each round start\n    /// (unless app-limited or already detected), check whether `btl_bw`\n    /// has grown by ≥ 25%.  After three consecutive rounds without\n    /// sufficient growth, set `filled_pipe`.\n    pub fn check_full_pipe(&mut self, rs_is_app_limited: bool) {\n        if !self.filled_pipe && self.round_start && !rs_is_app_limited {\n            if self.btl_bw as f64 >= self.full_bw as f64 * 1.25 {\n                self.full_bw = self.btl_bw;\n                self.full_bw_count = 0;\n            } else {\n                self.full_bw_count += 1;\n                if self.full_bw_count >= 3 {\n                    self.filled_pipe = true;\n                }\n            }\n        }\n    }\n\n    /// C: `BBR1EnterProbeRTT` (picoquic/bbr1.c:885)\n    ///\n    /// Enter ProbeRTT state: coast at unity gains to drain the queue and\n    /// obtain a fresh minimum-RTT sample.\n    pub fn enter_probe_rtt(&mut self) {\n        self.state = Bbr1AlgState::ProbeRtt;\n        self.pacing_gain = 1.0;\n        self.cwnd_gain = 1.0;\n    }\n\n    /// C: `BBR1AfterOneRoundtripInFastRecovery` (picoquic/bbr1.c:1107)\n    ///\n    /// After the first full round-trip in fast recovery, disable packet\n    /// conservation so the congestion window can grow normally again.\n    pub fn after_one_roundtrip_in_fast_recovery(&mut self) {\n        self.packet_conservation = false;\n    }\n}\n\n#[cfg(test)]\nmod tests {\n    use super::*;\n\n    fn make_state() -> Bbr1State {\n        Bbr1State {\n            state: Bbr1AlgState::default(),\n            btl_bw: 0,\n            next_round_delivered: 0,\n            btl_bw_filter: [0; BBR1_BTL_BW_FILTER_LENGTH],\n            full_bw: 0,\n            rt_prop: 0,\n            rt_prop_stamp: 0,\n            cycle_stamp: 0,\n            probe_rtt_done_stamp: 0,\n            prior_cwnd: 0,\n            prior_in_flight: 0,\n            bytes_delivered: 0,\n            send_quantum: 0,\n            rtt_filter: MinMaxRtt::default(),\n            target_cwnd: 0,\n            pacing_gain: 1.0,\n            cwnd_gain: 1.0,\n            pacing_rate: 0.0,\n            cycle_index: 0,\n            cycle_start: 0,\n            round_count: 0,\n            full_bw_count: 0,\n            lt_rtt_cnt: 0,\n            lt_bw: 0,\n            lt_last_stamp: 0,\n            previous_round_lost: 0,\n            previous_sampling_delivered: 0,\n            previous_sampling_lost: 0,\n            loss_interval_start: 0,\n            congestion_sequence: 0,\n            cwin_before_suspension: 0,\n            option_string: None,\n            wifi_shadow_rtt: 0,\n            quantum_ratio: 0.001,\n            filled_pipe: false,\n            round_start: false,\n            rt_prop_expired: false,\n            probe_rtt_round_done: false,\n            idle_restart: false,\n            packet_conservation: false,\n            btl_bw_increased: false,\n            lt_use_bw: false,\n            lt_is_sampling: false,\n            last_loss_was_timeout: false,\n            cycle_on_loss: false,\n            is_suspended: false,\n            is_suspension_nearly_over: false,\n        }\n    }\n\n    #[test]\n    fn enter_startup_sets_state_and_gains() {\n        let mut s = make_state();\n        s.enter_startup();\n        assert_eq!(s.state, Bbr1AlgState::Startup);\n        assert!((s.pacing_gain - BBR1_HIGH_GAIN).abs() < f64::EPSILON);\n        assert!((s.cwnd_gain - BBR1_HIGH_GAIN).abs() < f64::EPSILON);\n    }\n\n    #[test]\n    fn check_full_pipe_growing_resets_count() {\n        let mut s = make_state();\n        s.round_start = true;\n        s.full_bw = 1000;\n        s.btl_bw = 1300; // >= 1.25 * 1000\n        s.check_full_pipe(false);\n        assert_eq!(s.full_bw, 1300);\n        assert_eq!(s.full_bw_count, 0);\n        assert!(!s.filled_pipe);\n    }\n\n    #[test]\n    fn check_full_pipe_fills_after_3_stall_rounds() {\n        let mut s = make_state();\n        s.round_start = true;\n        s.full_bw = 1000;\n        s.btl_bw = 900; // < 1.25 * 1000\n        s.check_full_pipe(false);\n        assert_eq!(s.full_bw_count, 1);\n        assert!(!s.filled_pipe);\n        s.check_full_pipe(false);\n        assert_eq!(s.full_bw_count, 2);\n        s.check_full_pipe(false);\n        assert_eq!(s.full_bw_count, 3);\n        assert!(s.filled_pipe);\n    }\n\n    #[test]\n    fn check_full_pipe_skips_when_app_limited() {\n        let mut s = make_state();\n        s.round_start = true;\n        s.full_bw = 1000;\n        s.btl_bw = 900;\n        s.check_full_pipe(true); // app-limited → skip\n        assert_eq!(s.full_bw_count, 0);\n        assert!(!s.filled_pipe);\n    }\n\n    #[test]\n    fn check_full_pipe_skips_when_already_filled() {\n        let mut s = make_state();\n        s.round_start = true;\n        s.filled_pipe = true;\n        s.full_bw = 1000;\n        s.btl_bw = 900;\n        s.check_full_pipe(false);\n        assert_eq!(s.full_bw_count, 0); // guard skips the body\n    }\n\n    #[test]\n    fn enter_probe_rtt_sets_state_and_unity_gains() {\n        let mut s = make_state();\n        s.enter_probe_rtt();\n        assert_eq!(s.state, Bbr1AlgState::ProbeRtt);\n        assert!((s.pacing_gain - 1.0).abs() < f64::EPSILON);\n        assert!((s.cwnd_gain - 1.0).abs() < f64::EPSILON);\n    }\n\n    #[test]\n    fn after_one_roundtrip_clears_packet_conservation() {\n        let mut s = make_state();\n        s.packet_conservation = true;\n        s.after_one_roundtrip_in_fast_recovery();\n        assert!(!s.packet_conservation);\n    }\n}\n","numLines":267,"startLine":1,"totalLines":267}}}
