{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01LfRuVzGbYaDbcD7hLVr9F4","type":"tool_result","content":"155\t/// `Copy`, supports arithmetic with [`Duration`], and converts to\n156\t/// `u64` cheaply via `.ticks()` when crossing wire boundaries.\n157\t///\n158\t/// Phase 2 decision: per-call `current_time: Instant` parameters\n159\t/// stay (matches the C source's design — caller decides what time\n160\t/// it is).  No `Clock` trait at the library level; applications\n161\t/// can build a clock-injecting wrapper around the calls if they\n162\t/// want that style.\n163\tpub type Instant = fugit::Instant<u64, 1, 1_000_000>;\n164\t\n165\t/// Duration in microseconds.  Companion to [`Instant`].  Use for\n166\t/// timeouts, RTTs, jitter, etc.  In the C source these are bare\n167\t/// `uint64_t` values labelled by context (`idle_timeout`,\n168\t/// `microsec_latency`, …); the typed alias makes the unit explicit.\n169\tpub type Duration = fugit::Duration<u64, 1, 1_000_000>;\n170\t\n171\t// Error codes (picoquic-internal `ERROR_*` and protocol-defined\n172\t// `TRANSPORT_*` / TLS-alert) live as enums in [`crate::errors`].\n173\tpub use errors::{InternalError, TransportError};\n174\t\n175\t// ---------------------------------------------------------------------------\n176\t// Packet sizes and miscellaneous constants.\n177\t\n178\tpub const MAX_PACKET_SIZE: usize = 1536;\n179\tpub const INITIAL_MTU_IPV4: usize = 1252;\n180\tpub const INITIAL_MTU_IPV6: usize = 1232;\n181\tpub const RESET_SECRET_SIZE: usize = 16;\n182\tpub const RESET_PACKET_PAD_SIZE: usize = 23;\n183\tpub const RESET_PACKET_MIN_SIZE: usize = RESET_PACKET_PAD_SIZE + RESET_SECRET_SIZE;\n184\tpub const MAX_CRYPTO_BUFFER_GAP: usize = 16384;"}]},"parent_tool_use_id":null,"session_id":"e85c7bed-bd05-4049-931b-16153c644e2c","uuid":"f06b1bc3-9dab-4110-b4fe-845ceadad300","timestamp":"2026-05-07T09:07:01.561Z","tool_use_result":{"type":"text","file":{"filePath":"/Users/richbarn/Projects/picoqu