{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01SYPLXTT2fAcqVArEqTCSUw","type":"tool_result","content":"460\t    /// `connection` and `path_x` are read-only here: the C body only mutates\n461\t    /// `self`, reading the connection and path to resolve sequence\n462\t    /// numbers and timestamps via the `cc_*` accessors.  C:\n463\t    /// `picoquic_newreno_sim_notify`.\n464\t    pub fn notify(\n465\t        &mut self,\n466\t        connection: &Connection,\n467\t        path_x: &Path,\n468\t        notification: CongestionNotification,\n469\t        ack_state: &PerAckState,\n470\t        current_time: Instant,\n471\t    ) {\n472\t        match notification {\n473\t            CongestionNotification::Acknowledgement => match self.alg_state {\n474\t                NewRenoAlgState::SlowStart => {\n475\t                    self.cwin += ack_state.nb_bytes_acknowledged;\n476\t                    if self.cwin >= self.ssthresh {\n477\t                        self.alg_state = NewRenoAlgState::CongestionAvoidance;\n478\t                    }\n479\t                }\n480\t                NewRenoAlgState::CongestionAvoidance => {\n481\t                    let complete_delta = ack_state.nb_bytes_acknowledged * path_x.send_mtu as u64\n482\t                        + self.residual_ack;\n483\t                    self.residual_ack = complete_delta % self.cwin;\n484\t                    self.cwin += complete_delta / self.cwin;\n485\t                }\n486\t            },\n487\t            CongestionNotification::EcnEc\n488\t            | CongestionNotification::Repeat\n489\t            | CongestionNotification::Timeout\n490\t                if self.recovery_sequence <= ack_state.lost_packet_number =>\n491\t            {\n492\t                self.enter_recovery(connection, path_x, notification, current_time);\n493\t            }\n494\t            CongestionNotification::EcnEc\n495\t            | CongestionNotification::Repeat\n496\t            | CongestionNotification::Timeout => {}\n497\t            CongestionNotification::SpuriousRepeat => {\n498\t                if !connection.is_multipath_enabled {\n499\t                    if current_time.ticks() - self.recovery_start < path_x.smoothed_rtt.ticks()\n500\t                        && self.recovery_sequence > connection.ack_number(path_x)\n501\t                        && self.ssthresh != u64::MAX\n502\t                        && self.cwin < 2 * self.ssthresh\n503\t                    {\n504\t                        self.cwin = 2 * self.ssthresh;\n505\t                        self.alg_state = NewRenoAlgState::CongestionAvoidance;\n506\t                    }\n507\t                } else if current_time.ticks() - self.recovery_start < path_x.smoothed_rtt.ticks()\n508\t                    && self.recovery_start > connection.ack_sent_time(path_x).ticks()\n509\t                    && self.ssthresh != u64::MAX\n510\t                    && self.cwin < 2 * self.ssthresh\n511\t                {\n512\t                    self.cwin = 2 * self.ssthresh;\n513\t                    self.alg_state = NewRenoAlgState::CongestionAvoidance;\n514\t                }\n515\t            }\n516\t            CongestionNotification::Reset => {\n517\t                self.reset();\n518\t            }\n519\t            CongestionNotification::SeedCwin => {\n520\t                self.seed_cwin(ack_state.nb_bytes_acknowledged);\n521\t            }\n522\t            _ => {}\n523\t        }\n524\t    }\n525\t\n526\t    fn enter_recovery(\n527\t        &mut self,\n528\t        connection: &Connection,\n529\t        path_x: &Path,\n530\t        notification: CongestionNotification,\n531\t        current_time: Instant,\n532\t    ) {\n533\t        self.ssthresh = self.cwin / 2;\n534\t        if self.ssthresh < CWIN_MINIMUM {\n535\t            self.ssthresh = CWIN_MINIMUM;\n536\t        }\n537\t        if notification == CongestionNotification::Timeout {\n538\t            self.cwin = CWIN_MINIMUM;\n539\t            self.alg_state = NewRenoAlgState::SlowStart;"}]},"parent_tool_use_id":null,"session_id":"e85c7bed-bd05-4049-931b-16153c644e2c","uuid":"ccbca6f6-e71d-4f14-8882-687083cc271c","timestamp":"2026-05-07T09:05:38.016Z","tool_use_result":{"type":"text","file":{"filePath":"/Users/richbarn/Projects/picoquic/rs/fq/src/cc_common.rs","content":"    /// `connection` and `path_x` are read-only here: the C body only mutates\n    /// `self`, reading the connection and path to resolve sequence\n    /// numbers and timestamps via the `cc_*` accessors.  C:\n    /// `picoquic_newreno_sim_notify`.\n    pub fn notify(\n        &mut self,\n        connection: &Connection,\n        path_x: &Path,\n        notification: CongestionNotification,\n        ack_state: &PerAckState,\n        current_time: Instant,\n    ) {\n        match notification {\n            CongestionNotification::Acknowledgement => match self.alg_state {\n                NewRenoAlgState::SlowStart => {\n                    self.cwin += ack_state.nb_bytes_acknowledged;\n                    if self.cwin >= self.ssthresh {\n                        self.alg_state = NewRenoAlgState::CongestionAvoidance;\n                    }\n                }\n                NewRenoAlgState::CongestionAvoidance => {\n                    let complete_delta = ack_state.nb_bytes_acknowledged * path_x.send_mtu as u64\n                        + self.residual_ack;\n                    self.residual_ack = complete_delta % self.cwin;\n                    self.cwin += complete_delta / self.cwin;\n                }\n            },\n            CongestionNotification::EcnEc\n            | CongestionNotification::Repeat\n            | CongestionNotification::Timeout\n                if self.recovery_sequence <= ack_state.lost_packet_number =>\n            {\n                self.enter_recovery(connection, path_x, notification, current_time);\n            }\n            CongestionNotification::EcnEc\n            | CongestionNotification::Repeat\n            | CongestionNotification::Timeout => {}\n            CongestionNotification::SpuriousRepeat => {\n                if !connection.is_multipath_enabled {\n                    if current_time.ticks() - self.recovery_start < path_x.smoothed_rtt.ticks()\n                        && self.recovery_sequence > connection.ack_number(path_x)\n                        && self.ssthresh != u64::MAX\n                        && self.cwin < 2 * self.ssthresh\n                    {\n                        self.cwin = 2 * self.ssthresh;\n                        self.alg_state = NewRenoAlgState::CongestionAvoidance;\n                    }\n                } else if current_time.ticks() - self.recovery_start < path_x.smoothed_rtt.ticks()\n                    && self.recovery_start > connection.ack_sent_time(path_x).ticks()\n                    && self.ssthresh != u64::MAX\n                    && self.cwin < 2 * self.ssthresh\n                {\n                    self.cwin = 2 * self.ssthresh;\n                    self.alg_state = NewRenoAlgState::CongestionAvoidance;\n                }\n            }\n            CongestionNotification::Reset => {\n                self.reset();\n            }\n            CongestionNotification::SeedCwin => {\n                self.seed_cwin(ack_state.nb_bytes_acknowledged);\n            }\n            _ => {}\n        }\n    }\n\n    fn enter_recovery(\n        &mut self,\n        connection: &Connection,\n        path_x: &Path,\n        notification: CongestionNotification,\n        current_time: Instant,\n    ) {\n        self.ssthresh = self.cwin / 2;\n        if self.ssthresh < CWIN_MINIMUM {\n            self.ssthresh = CWIN_MINIMUM;\n        }\n        if notification == CongestionNotification::Timeout {\n            self.cwin = CWIN_MINIMUM;\n            self.alg_state = NewRenoAlgState::SlowStart;","numLines":80,"startLine":460,"totalLines":569}}}
