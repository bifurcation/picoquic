{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01MVoA7CQvEgbpezuNyQXf5n","type":"tool_result","content":"670\t/// the internal module once it is translated.\n671\tpub const DATAGRAM_QUEUE_CAUTIOUS_LENGTH: usize = INITIAL_MTU_IPV4;\n672\t\n673\t/// Congestion-control event fed to a [`CongestionControl`]\n674\t/// implementation's `alg_notify` hook.\n675\t#[derive(Debug, Copy, Clone, PartialEq, Eq)]\n676\tpub enum CongestionNotification {\n677\t    /// At least one packet was acknowledged.\n678\t    Acknowledgement,\n679\t    /// A packet was retransmitted.\n680\t    Repeat,\n681\t    /// A retransmission timer expired.\n682\t    Timeout,\n683\t    /// A retransmission was found to have been spurious.\n684\t    SpuriousRepeat,\n685\t    /// A new RTT sample is available.\n686\t    RttMeasurement,\n687\t    /// ECN-marked traffic was acknowledged.\n688\t    EcnEc,\n689\t    /// The send path is blocked by the congestion window.\n690\t    CwinBlocked,\n691\t    /// Seed the congestion window from external knowledge.\n692\t    SeedCwin,\n693\t    /// Reset congestion-control state.\n694\t    Reset,\n695\t    /// Notification of lost feedback.\n696\t    LostFeedback,\n697\t}\n698\t\n699\t/// Per-ACK state passed to the congestion-control algorithm.  C:\n700\t/// `PerAckState`.\n701\t///\n702\t/// Single-bit `unsigned int : 1` bitfields collapse to `bool`.  `pc`\n703\t/// stays an `i32` (the C field used `int` instead of the enum\n704\t/// itself to avoid include dependencies; we follow suit so the\n705\t/// translation can be checked field-by-field).\n706\t#[derive(Debug, Copy, Clone)]\n707\tpub struct PerAckState {\n708\t    pub rtt_measurement: Duration,\n709\t    pub send_delay: Duration,\n710\t    pub one_way_delay: Duration,\n711\t    pub nb_bytes_acknowledged: u64,\n712\t    pub nb_bytes_newly_lost: u64,\n713\t    pub nb_bytes_lost_since_packet_sent: u64,\n714\t    pub nb_bytes_delivered_since_packet_sent: u64,\n715\t    pub inflight_prior: u64,\n716\t    pub lost_packet_number: u64,\n717\t    pub lost_packet_sent_time: Instant,\n718\t    pub pc: i32,\n719\t    pub is_app_limited: bool,\n720\t    pub is_cwnd_limited: bool,\n721\t}\n722\t\n723\timpl Default for PerAckState {\n724\t    fn default() -> Self {\n725\t        Self {\n726\t            rtt_measurement: Duration::from_ticks(0),\n727\t            send_delay: Duration::from_ticks(0),\n728\t            one_way_delay: Duration::from_ticks(0),\n729\t            nb_bytes_acknowledged: 0,\n730\t            nb_bytes_newly_lost: 0,\n731\t            nb_bytes_lost_since_packet_sent: 0,\n732\t            nb_bytes_delivered_since_packet_sent: 0,\n733\t            inflight_prior: 0,\n734\t            lost_packet_number: 0,\n735\t            lost_packet_sent_time: Instant::from_ticks(0),\n736\t            pc: 0,\n737\t            is_app_limited: false,\n738\t            is_cwnd_limited: false,\n739\t        }\n740\t    }\n741\t}\n742\t\n743\t/// Congestion-control algorithm vtable.  In C this is four\n744\t/// independent function-pointer typedefs grouped into a struct\n745\t/// (`congestion_algorithm_init`,\n746\t/// `_notify`, `_delete`, `_observe`).  The C side always installs\n747\t/// the four together, so they collapse to a single Rust trait per\n748\t/// the \"trait grouping is a judgment call\" rule.\n749\t///\n750\t/// `option_string` arrives as an optional borrowed `&str`; the C\n751\t/// version accepted a nullable `char const*` that callers either\n752\t/// owned for the duration of the call or set to `NULL`.\n753\tpub trait CongestionControl: Sync {\n754\t    fn alg_init(&self, path_x: &mut Path, option_string: Option<&str>, current_time: Instant);\n755\t\n756\t    fn alg_notify(\n757\t        &self,\n758\t        connection: &mut Connection,\n759\t        path_x: &mut Path,\n760\t        notification: CongestionNotification,\n761\t        ack_state: &PerAckState,\n762\t        current_time: Instant,\n763\t    );\n764\t\n765\t    fn alg_delete(&self, path_x: &mut Path);\n766\t\n767\t    /// Optional observation hook — many algorithms leave this\n768\t    /// unimplemented (`NULL` in C).  Callers that don't care can\n769\t    /// rely on the default `None` return."}]},"parent_tool_use_id":null,"session_id":"e85c7bed-bd05-4049-931b-16153c644e2c","uuid":"3b86e8fa-0994-40dd-a638-c3d86e337bc9","timestamp":"2026-05-07T09:02:51.467Z","tool_use_result":{"type":"text","file":{"filePath":"/Users/richbarn/Projects/picoquic/rs/fq/src/lib.rs","content":"/// the internal module once it is translated.\npub const DATAGRAM_QUEUE_CAUTIOUS_LENGTH: usize = INITIAL_MTU_IPV4;\n\n/// Congestion-control event fed to a [`CongestionControl`]\n/// implementation's `alg_notify` hook.\n#[derive(Debug, Copy, Clone, PartialEq, Eq)]\npub enum CongestionNotification {\n    /// At least one packet was acknowledged.\n    Acknowledgement,\n    /// A packet was retransmitted.\n    Repeat,\n    /// A retransmission timer expired.\n    Timeout,\n    /// A retransmission was found to have been spurious.\n    SpuriousRepeat,\n    /// A new RTT sample is available.\n    RttMeasurement,\n    /// ECN-marked traffic was acknowledged.\n    EcnEc,\n    /// The send path is blocked by the congestion window.\n    CwinBlocked,\n    /// Seed the congestion window from external knowledge.\n    SeedCwin,\n    /// Reset congestion-control state.\n    Reset,\n    /// Notification of lost feedback.\n    LostFeedback,\n}\n\n/// Per-ACK state passed to the congestion-control algorithm.  C:\n/// `PerAckState`.\n///\n/// Single-bit `unsigned int : 1` bitfields collapse to `bool`.  `pc`\n/// stays an `i32` (the C field used `int` instead of the enum\n/// itself to avoid include dependencies; we follow suit so the\n/// translation can be checked field-by-field).\n#[derive(Debug, Copy, Clone)]\npub struct PerAckState {\n    pub rtt_measurement: Duration,\n    pub send_delay: Duration,\n    pub one_way_delay: Duration,\n    pub nb_bytes_acknowledged: u64,\n    pub nb_bytes_newly_lost: u64,\n    pub nb_bytes_lost_since_packet_sent: u64,\n    pub nb_bytes_delivered_since_packet_sent: u64,\n    pub inflight_prior: u64,\n    pub lost_packet_number: u64,\n    pub lost_packet_sent_time: Instant,\n    pub pc: i32,\n    pub is_app_limited: bool,\n    pub is_cwnd_limited: bool,\n}\n\nimpl Default for PerAckState {\n    fn default() -> Self {\n        Self {\n            rtt_measurement: Duration::from_ticks(0),\n            send_delay: Duration::from_ticks(0),\n            one_way_delay: Duration::from_ticks(0),\n            nb_bytes_acknowledged: 0,\n            nb_bytes_newly_lost: 0,\n            nb_bytes_lost_since_packet_sent: 0,\n            nb_bytes_delivered_since_packet_sent: 0,\n            inflight_prior: 0,\n            lost_packet_number: 0,\n            lost_packet_sent_time: Instant::from_ticks(0),\n            pc: 0,\n            is_app_limited: false,\n            is_cwnd_limited: false,\n        }\n    }\n}\n\n/// Congestion-control algorithm vtable.  In C this is four\n/// independent function-pointer typedefs grouped into a struct\n/// (`congestion_algorithm_init`,\n/// `_notify`, `_delete`, `_observe`).  The C side always installs\n/// the four together, so they collapse to a single Rust trait per\n/// the \"trait grouping is a judgment call\" rule.\n///\n/// `option_string` arrives as an optional borrowed `&str`; the C\n/// version accepted a nullable `char const*` that callers either\n/// owned for the duration of the call or set to `NULL`.\npub trait CongestionControl: Sync {\n    fn alg_init(&self, path_x: &mut Path, option_string: Option<&str>, current_time: Instant);\n\n    fn alg_notify(\n        &self,\n        connection: &mut Connection,\n        path_x: &mut Path,\n        notification: CongestionNotification,\n        ack_state: &PerAckState,\n        current_time: Instant,\n    );\n\n    fn alg_delete(&self, path_x: &mut Path);\n\n    /// Optional observation hook — many algorithms leave this\n    /// unimplemented (`NULL` in C).  Callers that don't care can\n    /// rely on the default `None` return.","numLines":100,"startLine":670,"totalLines":4229}}}
