{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01MDeKuQdpxzhUzCCc1ajurD","type":"tool_result","content":"295\t\n296\t/* Compute the parameters of the ACK transmission.\n297\t * We assume that there is space for up to N ranges, in addition to\n298\t * the topmost one. We want to select the \"most urgent\" ones.\n299\t */\n300\t\n301\tvoid picoquic_sack_select_ack_ranges(picoquic_sack_list_t* sack_list, picoquic_sack_item_t* first_sack,\n302\t    int max_ranges, int is_opportunistic, int* nb_sent_max, int* nb_sent_max_skip)\n303\t{\n304\t    int cumul_sent = 0;\n305\t    int first_sack_count = (first_sack == NULL) ? PICOQUIC_MAX_ACK_RANGE_REPEAT :\n306\t        first_sack->nb_times_sent[is_opportunistic];\n307\t    *nb_sent_max = PICOQUIC_MAX_ACK_RANGE_REPEAT;\n308\t    *nb_sent_max_skip = 0;\n309\t\n310\t    for (int i = 0; i < PICOQUIC_MAX_ACK_RANGE_REPEAT; i++) {\n311\t        cumul_sent += sack_list->rc[is_opportunistic].range_counts[i];\n312\t        if (i == first_sack_count) {\n313\t            cumul_sent -= 1;\n314\t        }\n315\t        if (cumul_sent >= max_ranges) {\n316\t            *nb_sent_max = i;\n317\t            *nb_sent_max_skip = cumul_sent - max_ranges;\n318\t            break;\n319\t        }\n320\t    }\n321\t}\n322\t\n323\t/*\n324\t * Check whether the data fills a hole. returns 0 if it does, -1 otherwise.\n325\t * This is used exclusively for managing stream content, and thus does not\n326\t * check the \"horizon\".\n327\t */\n328\tint picoquic_check_sack_list(picoquic_sack_list_t* sack_list,\n329\t    uint64_t pn64_min, uint64_t pn64_max)"}]},"parent_tool_use_id":null,"session_id":"e85c7bed-bd05-4049-931b-16153c644e2c","uuid":"0bc5e4d6-656f-48c0-87dd-4f7537eda357","timestamp":"2026-05-07T09:02:01.914Z","tool_use_result":{"type":"text","file":{"filePath":"/Users/richbarn/Projects/picoquic/picoquic/sacks.c","content":"\n/* Compute the parameters of the ACK transmission.\n * We assume that there is space for up to N ranges, in addition to\n * the topmost one. We want to select the \"most urgent\" ones.\n */\n\nvoid picoquic_sack_select_ack_ranges(picoquic_sack_list_t* sack_list, picoquic_sack_item_t* first_sack,\n    int max_ranges, int is_opportunistic, int* nb_sent_max, int* nb_sent_max_skip)\n{\n    int cumul_sent = 0;\n    int first_sack_count = (first_sack == NULL) ? PICOQUIC_MAX_ACK_RANGE_REPEAT :\n        first_sack->nb_times_sent[is_opportunistic];\n    *nb_sent_max = PICOQUIC_MAX_ACK_RANGE_REPEAT;\n    *nb_sent_max_skip = 0;\n\n    for (int i = 0; i < PICOQUIC_MAX_ACK_RANGE_REPEAT; i++) {\n        cumul_sent += sack_list->rc[is_opportunistic].range_counts[i];\n        if (i == first_sack_count) {\n            cumul_sent -= 1;\n        }\n        if (cumul_sent >= max_ranges) {\n            *nb_sent_max = i;\n            *nb_sent_max_skip = cumul_sent - max_ranges;\n            break;\n        }\n    }\n}\n\n/*\n * Check whether the data fills a hole. returns 0 if it does, -1 otherwise.\n * This is used exclusively for managing stream content, and thus does not\n * check the \"horizon\".\n */\nint picoquic_check_sack_list(picoquic_sack_list_t* sack_list,\n    uint64_t pn64_min, uint64_t pn64_max)","numLines":35,"startLine":295,"totalLines":502}}}
