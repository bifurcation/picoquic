{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01FTLUyXscJbzUcsmJD5PyEV","type":"tool_result","content":"780\t/// stay alongside it.  `congestion_algorithm_id` is `&'static str`\n781\t/// because the C side stores compile-time string literals.\n782\tpub struct CongestionAlgorithm {\n783\t    pub congestion_algorithm_id: &'static str,\n784\t    pub congestion_algorithm_number: u8,\n785\t    pub ecn_mark: u8,\n786\t    pub algorithm: &'static dyn CongestionControl,\n787\t}\n788\t\n789\timpl core::fmt::Debug for CongestionAlgorithm {\n790\t    fn fmt(&self, f: &mut core::fmt::Formatter<'_>) -> core::fmt::Result {\n791\t        f.debug_struct(\"CongestionAlgorithm\")\n792\t            .field(\"congestion_algorithm_id\", &self.congestion_algorithm_id)\n793\t            .field(\n794\t                \"congestion_algorithm_number\",\n795\t                &self.congestion_algorithm_number,\n796\t            )\n797\t            .field(\"ecn_mark\", &self.ecn_mark)\n798\t            .finish_non_exhaustive()\n799\t    }\n800\t}\n801\t\n802\t/// Return the registered congestion-control algorithm table.  In\n803\t/// C this was a pair of `extern` globals\n804\t/// (`congestion_control_algorithms` and\n805\t/// `nb_congestion_control_algorithms`); the Rust API\n806\t/// exposes a single accessor returning a borrowed slice — the\n807\t/// length is implicit.  The slice is empty until\n808\t/// [`register_congestion_control_algorithms`] (or its\n809\t/// `_all_` convenience wrapper) is called.\n810\tpub fn congestion_control_algorithms() -> &'static [&'static CongestionAlgorithm] {\n811\t    CC_ALGORITHM_REGISTRY\n812\t        .get()\n813\t        .map(|v| v.as_slice())\n814\t        .unwrap_or(&[])\n815\t}\n816\t\n817\t/// Process-wide congestion-control algorithm registry.  Filled by\n818\t/// [`register_congestion_control_algorithms`].  `OnceLock` is used\n819\t/// so the registry can be set once (or never) without locking on\n820\t/// every read after the first call to `congestion_control_algorithms`.\n821\tstatic CC_ALGORITHM_REGISTRY: std::sync::OnceLock<Vec<&'static CongestionAlgorithm>> =\n822\t    std::sync::OnceLock::new();\n823\t\n824\tstruct BaselineCongestionControl;\n825\t\n826\timpl CongestionControl for BaselineCongestionControl {\n827\t    fn alg_init(&self, path_x: &mut Path, _option_string: Option<&str>, _current_time: Instant) {\n828\t        path_x.cwin = crate::internal::CWIN_INITIAL;\n829\t        path_x.bytes_in_transit = 0;\n830\t    }\n831\t\n832\t    fn alg_notify(\n833\t        &self,\n834\t        _connection: &mut Connection,\n835\t        path_x: &mut Path,\n836\t        notification: CongestionNotification,\n837\t        ack_state: &PerAckState,\n838\t        _current_time: Instant,\n839\t    ) {"}]},"parent_tool_use_id":null,"session_id":"e85c7bed-bd05-4049-931b-16153c644e2c","uuid":"b4404710-756a-4b28-9d98-94c6174bebd7","timestamp":"2026-05-07T09:03:00.761Z","tool_use_result":{"type":"text","file":{"filePath":"/Users/richbarn/Projects/picoquic/rs/fq/src/lib.rs","content":"/// stay alongside it.  `congestion_algorithm_id` is `&'static str`\n/// because the C side stores compile-time string literals.\npub struct CongestionAlgorithm {\n    pub congestion_algorithm_id: &'static str,\n    pub congestion_algorithm_number: u8,\n    pub ecn_mark: u8,\n    pub algorithm: &'static dyn CongestionControl,\n}\n\nimpl core::fmt::Debug for CongestionAlgorithm {\n    fn fmt(&self, f: &mut core::fmt::Formatter<'_>) -> core::fmt::Result {\n        f.debug_struct(\"CongestionAlgorithm\")\n            .field(\"congestion_algorithm_id\", &self.congestion_algorithm_id)\n            .field(\n                \"congestion_algorithm_number\",\n                &self.congestion_algorithm_number,\n            )\n            .field(\"ecn_mark\", &self.ecn_mark)\n            .finish_non_exhaustive()\n    }\n}\n\n/// Return the registered congestion-control algorithm table.  In\n/// C this was a pair of `extern` globals\n/// (`congestion_control_algorithms` and\n/// `nb_congestion_control_algorithms`); the Rust API\n/// exposes a single accessor returning a borrowed slice — the\n/// length is implicit.  The slice is empty until\n/// [`register_congestion_control_algorithms`] (or its\n/// `_all_` convenience wrapper) is called.\npub fn congestion_control_algorithms() -> &'static [&'static CongestionAlgorithm] {\n    CC_ALGORITHM_REGISTRY\n        .get()\n        .map(|v| v.as_slice())\n        .unwrap_or(&[])\n}\n\n/// Process-wide congestion-control algorithm registry.  Filled by\n/// [`register_congestion_control_algorithms`].  `OnceLock` is used\n/// so the registry can be set once (or never) without locking on\n/// every read after the first call to `congestion_control_algorithms`.\nstatic CC_ALGORITHM_REGISTRY: std::sync::OnceLock<Vec<&'static CongestionAlgorithm>> =\n    std::sync::OnceLock::new();\n\nstruct BaselineCongestionControl;\n\nimpl CongestionControl for BaselineCongestionControl {\n    fn alg_init(&self, path_x: &mut Path, _option_string: Option<&str>, _current_time: Instant) {\n        path_x.cwin = crate::internal::CWIN_INITIAL;\n        path_x.bytes_in_transit = 0;\n    }\n\n    fn alg_notify(\n        &self,\n        _connection: &mut Connection,\n        path_x: &mut Path,\n        notification: CongestionNotification,\n        ack_state: &PerAckState,\n        _current_time: Instant,\n    ) {","numLines":60,"startLine":780,"totalLines":4229}}}
