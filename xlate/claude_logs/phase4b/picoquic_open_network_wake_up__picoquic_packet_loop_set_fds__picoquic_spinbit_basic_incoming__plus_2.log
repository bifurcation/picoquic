{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_017LfD48GRQ95yFwZ4UQRLRE","type":"tool_result","content":"1\t//! Translation of `picoquic/picosocks.h` plus the Phase 2 socket\n2\t//! abstraction.\n3\t//!\n4\t//! Phase 2 reshape: the C `SOCKET_TYPE` (a Linux file descriptor)\n5\t//! is replaced by a [`Socket`] *trait* that the host platform\n6\t//! implements.  The default implementation wraps\n7\t//! [`socket2::Socket`] (the canonical cross-platform UDP socket\n8\t//! crate); other backends (no-std embedded, Windows-specific,\n9\t//! the test simulator) implement the same trait.\n10\t//! [`ServerSockets<S>`] is generic over the implementor.\n11\t//!\n12\t//! Phase 4: all method bodies are implemented.\n13\t\n14\tuse core::net::SocketAddr;\n15\t\n16\t#[cfg(unix)]\n17\tuse libc;\n18\t\n19\tuse crate::Error;\n20\tuse crate::Instant;\n21\t\n22\t// ---------------------------------------------------------------------------\n23\t// Constants and supporting types.\n24\t\n25\t/// Number of UDP sockets a server context owns — one IPv4, one\n26\t/// IPv6.  C: `PICOQUIC_NB_SERVER_SOCKETS`.\n27\tpub const SERVER_SOCKET_COUNT: usize = 2;\n28\t\n29\t/// `MessageHeader` is a re-export of [`socket2::MsgHdr`] — the\n30\t/// canonical cross-platform `msghdr` wrapper.  Phase 4 fills in\n31\t/// the bodies that thread one through the cmsg helpers.\n32\tpub type MessageHeader<'addr, 'bufs, 'control> = socket2::MsgHdr<'addr, 'bufs, 'control>;\n33\t\n34\t/// OS error code surfaced by socket sends when the underlying\n35\t/// syscall fails.  Wraps the raw Linux `errno` (or its Windows\n36\t/// equivalent on other targets) and exposes\n37\t/// [`OsError::is_unreachable`] for the path-abandon decision the\n38\t/// C `picoquic_socket_error_implies_unreachable` helper made.\n39\t#[derive(Debug, Copy, Clone, PartialEq, Eq)]\n40\tpub struct OsError(pub i32);\n41\t\n42\timpl OsError {\n43\t    /// Whether this errno implies the destination is unreachable\n44\t    /// and the owning path should be abandoned.  C:\n45\t    /// `picoquic_socket_error_implies_unreachable`.\n46\t    pub fn is_unreachable(self) -> bool {\n47\t        use std::io::ErrorKind;\n48\t        let kind = std::io::Error::from_raw_os_error(self.0).kind();\n49\t        matches!(\n50\t            kind,\n51\t            ErrorKind::ConnectionReset\n52\t                | ErrorKind::HostUnreachable\n53\t                | ErrorKind::NetworkDown\n54\t                | ErrorKind::NetworkUnreachable\n55\t        )\n56\t    }\n57\t}\n58\t\n59\t// ---------------------------------------------------------------------------\n60\t// `Socket` trait.\n61\t\n62\t/// One UDP socket on the application's network stack.  Replaces\n63\t/// the C `SOCKET_TYPE` (a raw file descriptor); the host\n64\t/// implementation supplies open / bind / send / recv operations\n65\t/// while the rest of picoquic stays platform-agnostic.\n66\t///\n67\t/// The default [`socket2::Socket`] implementation is in\n68\t/// [`crate::socks_socket2`] (gated on the `std` feature).\n69\tpub trait Socket {\n70\t    /// Local address bound to this socket (`getsockname`).\n71\t    /// C: `picoquic_get_local_address`.\n72\t    fn local_address(&self) -> Result<SocketAddr, Error>;\n73\t\n74\t    /// Receive one UDP datagram into `buffer`.  Output parameters\n75\t    /// (source / dest address, interface index, ECN, byte count)\n76\t    /// fold into [`RecvInfo`]; the slice length subsumes the C\n77\t    /// `buffer_max` parameter.  C: `picoquic_recvmsg`.\n78\t    fn recv(&mut self, buffer: &mut [u8]) -> Result<RecvInfo, Error>;\n79\t\n80\t    /// Send `bytes` to `addr_dest` from `addr_from` with an\n81\t    /// optional GSO segmentation hint `gso_size` (`UDP_SEGMENT`).\n82\t    /// `addr_from = None` lets the kernel choose the source\n83\t    /// address.  `Ok(n)` reports bytes sent; `Err` carries the\n84\t    /// OS error.  C: `picoquic_sendmsg`.\n85\t    fn send(\n86\t        &mut self,\n87\t        addr_dest: &SocketAddr,\n88\t        addr_from: Option<&SocketAddr>,\n89\t        dest_if: i32,\n90\t        bytes: &[u8],\n91\t        gso_size: i32,\n92\t    ) -> Result<usize, OsError>;\n93\t\n94\t    /// Enable per-packet destination-info delivery on this socket\n95\t    /// (`IP_PKTINFO` / `IPV6_RECVPKTINFO`).  Default: no-op for\n96\t    /// backends that don't surface pktinfo.\n97\t    /// C: `picoquic_socket_set_pkt_info`.\n98\t    fn set_pkt_info(&mut self) -> Result<(), Error> {\n99\t        Ok(())\n100\t    }\n101\t\n102\t    /// Enable ECN reception (and request `ECN_ECT_1` outbound).\n103\t    /// Returns `(recv_set, send_set)` indicating whether the\n104\t    /// kernel honored each socket option.  Default: no-op,\n105\t    /// returns `(false, false)`.\n106\t    fn set_ecn_options(&mut self) -> Result<(bool, bool), Error> {\n107\t        Ok((false, false))\n108\t    }\n109\t\n110\t    /// Like [`Self::set_ecn_options`] but with an explicit\n111\t    /// outbound TOS / ECN value (`ecn` is one of the 2-bit\n112\t    /// `EcnCodepoint` codes).  Default: delegates to the\n113\t    /// no-op `set_ecn_options`.\n114\t    fn set_ecn_options_ex(&mut self, _ecn: EcnCodepoint) -> Result<(bool, bool), Error> {\n115\t        self.set_ecn_options()\n116\t    }\n117\t\n118\t    /// Enable Path-MTU-Discovery probing on this socket\n119\t    /// (Linux-only; no-op on other platforms by default).\n120\t    /// C: `picoquic_socket_set_pmtud_options`."}]},"parent_tool_use_id":null,"session_id":"883038f3-dc47-41ca-bc79-c1df5243c1d6","uuid":"079aa75f-1bd6-4e32-8576-7b55d300cc5d","timestamp":"2026-05-07T09:23:27.871Z","tool_use_result":{"type":"text","file":{"filePath":"/Users/richbarn/Projects/picoquic/rs/fq/src/socks.rs","content":"//! Translation of `picoquic/picosocks.h` plus the Phase 2 socket\n//! abstraction.\n//!\n//! Phase 2 reshape: the C `SOCKET_TYPE` (a Linux file descriptor)\n//! is replaced by a [`Socket`] *trait* that the host platform\n//! implements.  The default implementation wraps\n//! [`socket2::Socket`] (the canonical cross-platform UDP socket\n//! crate); other backends (no-std embedded, Windows-specific,\n//! the test simulator) implement the same trait.\n//! [`ServerSockets<S>`] is generic over the implementor.\n//!\n//! Phase 4: all method bodies are implemented.\n\nuse core::net::SocketAddr;\n\n#[cfg(unix)]\nuse libc;\n\nuse crate::Error;\nuse crate::Instant;\n\n// ---------------------------------------------------------------------------\n// Constants and supporting types.\n\n/// Number of UDP sockets a server context owns — one IPv4, one\n/// IPv6.  C: `PICOQUIC_NB_SERVER_SOCKETS`.\npub const SERVER_SOCKET_COUNT: usize = 2;\n\n/// `MessageHeader` is a re-export of [`socket2::MsgHdr`] — the\n/// canonical cross-platform `msghdr` wrapper.  Phase 4 fills in\n/// the bodies that thread one through the cmsg helpers.\npub type MessageHeader<'addr, 'bufs, 'control> = socket2::MsgHdr<'addr, 'bufs, 'control>;\n\n/// OS error code surfaced by socket sends when the underlying\n/// syscall fails.  Wraps the raw Linux `errno` (or its Windows\n/// equivalent on other targets) and exposes\n/// [`OsError::is_unreachable`] for the path-abandon decision the\n/// C `picoquic_socket_error_implies_unreachable` helper made.\n#[derive(Debug, Copy, Clone, PartialEq, Eq)]\npub struct OsError(pub i32);\n\nimpl OsError {\n    /// Whether this errno implies the destination is unreachable\n    /// and the owning path should be abandoned.  C:\n    /// `picoquic_socket_error_implies_unreachable`.\n    pub fn is_unreachable(self) -> bool {\n        use std::io::ErrorKind;\n        let kind = std::io::Error::from_raw_os_error(self.0).kind();\n        matches!(\n            kind,\n            ErrorKind::ConnectionReset\n                | ErrorKind::HostUnreachable\n                | ErrorKind::NetworkDown\n                | ErrorKind::NetworkUnreachable\n        )\n    }\n}\n\n// ---------------------------------------------------------------------------\n// `Socket` trait.\n\n/// One UDP socket on the application's network stack.  Replaces\n/// the C `SOCKET_TYPE` (a raw file descriptor); the host\n/// implementation supplies open / bind / send / recv operations\n/// while the rest of picoquic stays platform-agnostic.\n///\n/// The default [`socket2::Socket`] implementation is in\n/// [`crate::socks_socket2`] (gated on the `std` feature).\npub trait Socket {\n    /// Local address bound to this socket (`getsockname`).\n    /// C: `picoquic_get_local_address`.\n    fn local_address(&self) -> Result<SocketAddr, Error>;\n\n    /// Receive one UDP datagram into `buffer`.  Output parameters\n    /// (source / dest address, interface index, ECN, byte count)\n    /// fold into [`RecvInfo`]; the slice length subsumes the C\n    /// `buffer_max` parameter.  C: `picoquic_recvmsg`.\n    fn recv(&mut self, buffer: &mut [u8]) -> Result<RecvInfo, Error>;\n\n    /// Send `bytes` to `addr_dest` from `addr_from` with an\n    /// optional GSO segmentation hint `gso_size` (`UDP_SEGMENT`).\n    /// `addr_from = None` lets the kernel choose the source\n    /// address.  `Ok(n)` reports bytes sent; `Err` carries the\n    /// OS error.  C: `picoquic_sendmsg`.\n    fn send(\n        &mut self,\n        addr_dest: &SocketAddr,\n        addr_from: Option<&SocketAddr>,\n        dest_if: i32,\n        bytes: &[u8],\n        gso_size: i32,\n    ) -> Result<usize, OsError>;\n\n    /// Enable per-packet destination-info delivery on this socket\n    /// (`IP_PKTINFO` / `IPV6_RECVPKTINFO`).  Default: no-op for\n    /// backends that don't surface pktinfo.\n    /// C: `picoquic_socket_set_pkt_info`.\n    fn set_pkt_info(&mut self) -> Result<(), Error> {\n        Ok(())\n    }\n\n    /// Enable ECN reception (and request `ECN_ECT_1` outbound).\n    /// Returns `(recv_set, send_set)` indicating whether the\n    /// kernel honored each socket option.  Default: no-op,\n    /// returns `(false, false)`.\n    fn set_ecn_options(&mut self) -> Result<(bool, bool), Error> {\n        Ok((false, false))\n    }\n\n    /// Like [`Self::set_ecn_options`] but with an explicit\n    /// outbound TOS / ECN value (`ecn` is one of the 2-bit\n    /// `EcnCodepoint` codes).  Default: delegates to the\n    /// no-op `set_ecn_options`.\n    fn set_ecn_options_ex(&mut self, _ecn: EcnCodepoint) -> Result<(bool, bool), Error> {\n        self.set_ecn_options()\n    }\n\n    /// Enable Path-MTU-Discovery probing on this socket\n    /// (Linux-only; no-op on other platforms by default).\n    /// C: `picoquic_socket_set_pmtud_options`.","numLines":120,"startLine":1,"totalLines":468}}}
