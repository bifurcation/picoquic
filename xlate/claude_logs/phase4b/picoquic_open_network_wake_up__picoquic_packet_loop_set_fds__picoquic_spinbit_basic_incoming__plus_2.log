{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01YC3bLZmMuhhRxoKFzYQr3a","type":"tool_result","content":"505\t}\n506\t\n507\t// ---------------------------------------------------------------------------\n508\t// Spin-bit policy vtable.\n509\t\n510\t/// Spin-bit policy: how to update the spin bit on an incoming\n511\t/// packet, and what value to emit on outgoing packets.  In C the\n512\t/// policy is two function pointers grouped into\n513\t/// `SpinbitDef`; the two are always installed\n514\t/// together so they share one Rust trait.\n515\tpub trait SpinBitPolicy: Sync {\n516\t    /// C: `spinbit_incoming_fn`.\n517\t    fn incoming(&self, connection: &mut Connection, path_x: &mut Path, ph: &PacketHeader);\n518\t\n519\t    /// C: `spinbit_outgoing_fn`.\n520\t    fn outgoing(&self, connection: &mut Connection) -> u8;\n521\t}\n522\t\n523\t/// Spin-bit policy dispatch table.  Replaces `extern SpinbitDef\n524\t/// spin_function_table[]` from the C source.  Each row is a\n525\t/// `&'static dyn` to a stateless policy implementor; the wrapper\n526\t/// `SpinbitDef` struct from C is gone (the trait object carries\n527\t/// the same information).\n528\t///\n529\t/// Indices match [`crate::SpinbitVersion`] values:\n530\t/// * 0 = Basic\n531\t/// * 1 = Random\n532\t/// * 2 = Null\n533\t/// * 3 = On (test-only, server side)\n534\t///\n535\t/// The concrete policy types and the populated table land in\n536\t/// `crate::spinbit` (Phase 4).\n537\tpub static SPIN_FUNCTION_TABLE: &[&dyn SpinBitPolicy] = &[];\n538\t\n539\t// ---------------------------------------------------------------------------\n540\t// Stateless packet, queued at the QUIC context until sendable.\n541\t\n542\tpub struct StatelessPacket {\n543\t    pub addr_to: SocketAddr,\n544\t    pub addr_local: SocketAddr,\n545\t    pub if_index_local: i32,\n546\t    pub received_ecn: u8,\n547\t    pub length: usize,\n548\t    pub receive_time: Instant,\n549\t    pub connection_id_log64: u64,\n550\t    pub initial_connection_id: ConnectionId,\n551\t    pub packet_type: PacketType,\n552\t    pub bytes: [u8; MAX_PACKET_SIZE],\n553\t}\n554\t\n555\timpl Quic {\n556\t    /// Allocate a fresh stateless-packet buffer.  C:\n557\t    /// `create_stateless_packet` plus the per-context pool;\n558\t    /// `Quic.connections.alloc()`-style — Rust uses normal heap\n559\t    /// allocation and lets `Drop` free.\n560\t    pub fn create_stateless_packet(&mut self) -> Result<StatelessPacket, crate::Error> {\n561\t        use core::net::{IpAddr, Ipv4Addr};\n562\t        Ok(StatelessPacket {\n563\t            addr_to: core::net::SocketAddr::new(IpAddr::V4(Ipv4Addr::UNSPECIFIED), 0),\n564\t            addr_local: core::net::SocketAddr::new(IpAddr::V4(Ipv4Addr::UNSPECIFIED), 0),"}]},"parent_tool_use_id":null,"session_id":"883038f3-dc47-41ca-bc79-c1df5243c1d6","uuid":"0b8ebd00-9cca-4543-a4da-de1dbe82637a","timestamp":"2026-05-07T09:22:51.695Z","tool_use_result":{"type":"text","file":{"filePath":"/Users/richbarn/Projects/picoquic/rs/fq/src/internal.rs","content":"}\n\n// ---------------------------------------------------------------------------\n// Spin-bit policy vtable.\n\n/// Spin-bit policy: how to update the spin bit on an incoming\n/// packet, and what value to emit on outgoing packets.  In C the\n/// policy is two function pointers grouped into\n/// `SpinbitDef`; the two are always installed\n/// together so they share one Rust trait.\npub trait SpinBitPolicy: Sync {\n    /// C: `spinbit_incoming_fn`.\n    fn incoming(&self, connection: &mut Connection, path_x: &mut Path, ph: &PacketHeader);\n\n    /// C: `spinbit_outgoing_fn`.\n    fn outgoing(&self, connection: &mut Connection) -> u8;\n}\n\n/// Spin-bit policy dispatch table.  Replaces `extern SpinbitDef\n/// spin_function_table[]` from the C source.  Each row is a\n/// `&'static dyn` to a stateless policy implementor; the wrapper\n/// `SpinbitDef` struct from C is gone (the trait object carries\n/// the same information).\n///\n/// Indices match [`crate::SpinbitVersion`] values:\n/// * 0 = Basic\n/// * 1 = Random\n/// * 2 = Null\n/// * 3 = On (test-only, server side)\n///\n/// The concrete policy types and the populated table land in\n/// `crate::spinbit` (Phase 4).\npub static SPIN_FUNCTION_TABLE: &[&dyn SpinBitPolicy] = &[];\n\n// ---------------------------------------------------------------------------\n// Stateless packet, queued at the QUIC context until sendable.\n\npub struct StatelessPacket {\n    pub addr_to: SocketAddr,\n    pub addr_local: SocketAddr,\n    pub if_index_local: i32,\n    pub received_ecn: u8,\n    pub length: usize,\n    pub receive_time: Instant,\n    pub connection_id_log64: u64,\n    pub initial_connection_id: ConnectionId,\n    pub packet_type: PacketType,\n    pub bytes: [u8; MAX_PACKET_SIZE],\n}\n\nimpl Quic {\n    /// Allocate a fresh stateless-packet buffer.  C:\n    /// `create_stateless_packet` plus the per-context pool;\n    /// `Quic.connections.alloc()`-style — Rust uses normal heap\n    /// allocation and lets `Drop` free.\n    pub fn create_stateless_packet(&mut self) -> Result<StatelessPacket, crate::Error> {\n        use core::net::{IpAddr, Ipv4Addr};\n        Ok(StatelessPacket {\n            addr_to: core::net::SocketAddr::new(IpAddr::V4(Ipv4Addr::UNSPECIFIED), 0),\n            addr_local: core::net::SocketAddr::new(IpAddr::V4(Ipv4Addr::UNSPECIFIED), 0),","numLines":60,"startLine":505,"totalLines":12069}}}
