{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_015nsy363pCZG4zMYCV4FCee","type":"tool_result","content":"1\t//! Test cases for `picoquictest/spinbit_test.c`.\n2\t//!\n3\t//! Verifies spin-bit rotation counts for various server/client\n4\t//! spinbit policies (basic, on, null, random).\n5\t\n6\t#![allow(non_snake_case)]\n7\t\n8\tuse super::util::{\n9\t    TestApiStreamDesc, test_api_init_send_recv_scenario, tls_api_connection_loop, tls_api_init_ctx,\n10\t    tls_api_one_sim_round,\n11\t};\n12\tuse crate::internal::Version;\n13\tuse crate::{Instant, SpinbitVersion};\n14\t\n15\tconst TEST_SCENARIO_SPIN: &[TestApiStreamDesc] = &[TestApiStreamDesc {\n16\t    stream_id: 4,\n17\t    previous_stream_id: 0,\n18\t    q_len: 257,\n19\t    r_len: 1_000_000,\n20\t}];\n21\t\n22\t// ---------------------------------------------------------------------------\n23\t// Core helper.\n24\t// C: `spinbit_test_one` in `picoquictest/spinbit_test.c`.\n25\t\n26\tfn spinbit_test_one(\n27\t    spin_policy: SpinbitVersion,\n28\t    spin_policy_server: SpinbitVersion,\n29\t) -> crate::Result<()> {\n30\t    let mut simulated_time = Instant::from_ticks(0);\n31\t    let mut loss_mask: u64 = 0;\n32\t\n33\t    let mut test_ctx = tls_api_init_ctx(&mut simulated_time, Version::InternalTest1 as u32, None)\n34\t        .ok_or(crate::Error::Generic)?;\n35\t\n36\t    let _ = test_ctx\n37\t        .qserver\n38\t        .set_default_spinbit_policy(spin_policy_server);\n39\t    test_ctx.cnx_client().set_spinbit_policy(spin_policy)?;\n40\t\n41\t    test_ctx.cnx_client().start_client()?;\n42\t\n43\t    tls_api_connection_loop(&mut test_ctx, &mut loss_mask, 0, &mut simulated_time)?;\n44\t\n45\t    test_api_init_send_recv_scenario(&mut test_ctx, TEST_SCENARIO_SPIN)?;\n46\t\n47\t    // Observe spin-bit transitions over a 10-second window.\n48\t    let spin_begin_time = simulated_time;\n49\t    let next_time = Instant::from_ticks(simulated_time.ticks() + 10_000_000);\n50\t    let max_trials = 100_000;\n51\t    let mut nb_trials = 0;\n52\t    let mut nb_inactive = 0;\n53\t    let mut spin_count: i32 = 0;\n54\t    let mut current_spin = test_ctx.cnx_client().primary_path_current_spin();\n55\t\n56\t    test_ctx.c_to_s_link.loss_mask = Some(loss_mask);\n57\t    test_ctx.s_to_c_link.loss_mask = Some(loss_mask);\n58\t\n59\t    while nb_trials < max_trials\n60\t        && simulated_time < next_time\n61\t        && nb_inactive < 256\n62\t        && test_ctx.client_ready()\n63\t        && test_ctx.server_ready()\n64\t    {\n65\t        let mut was_active = false;\n66\t        nb_trials += 1;\n67\t\n68\t        tls_api_one_sim_round(\n69\t            &mut test_ctx,\n70\t            &mut simulated_time,\n71\t            next_time,\n72\t            &mut was_active,\n73\t        )?;\n74\t\n75\t        let new_spin = test_ctx.cnx_client().primary_path_current_spin();\n76\t        if new_spin != current_spin {\n77\t            spin_count += 1;\n78\t            current_spin = new_spin;\n79\t        }\n80\t\n81\t        if was_active {\n82\t            nb_inactive = 0;\n83\t        } else {\n84\t            nb_inactive += 1;\n85\t        }\n86\t\n87\t        if test_ctx.test_finished\n88\t            && test_ctx.cnx_client().is_cnx_backlog_empty()\n89\t            && test_ctx.cnx_server().is_cnx_backlog_empty()\n90\t        {\n91\t            break;\n92\t        }\n93\t    }\n94\t\n95\t    let spin_duration = simulated_time.ticks() - spin_begin_time.ticks();\n96\t    let _ = spin_duration;\n97\t\n98\t    test_ctx.cnx_client().close(0)?;\n99\t\n100\t    // Validate spin counts against policy expectations.\n101\t    if matches!(spin_policy, SpinbitVersion::Basic) {\n102\t        match spin_policy_server {\n103\t            SpinbitVersion::On => {\n104\t                assert!(\n105\t                    spin_count >= 6,\n106\t                    \"implausible spin bit: {} rotations, rtt_min = {}, duration = {}\",\n107\t                    spin_count,\n108\t                    test_ctx.cnx_client().primary_path_rtt_min(),\n109\t                    spin_duration,\n110\t                );\n111\t            }\n112\t            SpinbitVersion::Random => {\n113\t                assert!(\n114\t                    spin_count >= 100,\n115\t                    \"implausible spin bit: {} rotations\",\n116\t                    spin_count,\n117\t                );\n118\t            }\n119\t            SpinbitVersion::Null => {\n120\t                assert_eq!(\n121\t                    spin_count, 0,\n122\t                    \"implausible spin bit: {} rotations with null policy\",\n123\t                    spin_count,\n124\t                );\n125\t            }\n126\t            _ => {}\n127\t        }\n128\t    }\n129\t\n130\t    Ok(())\n131\t}\n132\t\n133\t// ---------------------------------------------------------------------------\n134\t// Exported tests.\n135\t\n136\t/// C: `spinbit_test` in `picoquictest/spinbit_test.c`.\n137\t#[test]\n138\tfn spinbit() {\n139\t    spinbit_test_one(SpinbitVersion::Basic, SpinbitVersion::On).expect(\"spinbit\");\n140\t}\n141\t\n142\t/// C: `spinbit_random_test` in `picoquictest/spinbit_test.c`.\n143\t#[test]\n144\tfn spinbit_random() {\n145\t    spinbit_test_one(SpinbitVersion::Basic, SpinbitVersion::Random).expect(\"spinbit_random\");\n146\t}\n147\t\n148\t/// C: `spinbit_randclient_test` in `picoquictest/spinbit_test.c`.\n149\t#[test]\n150\tfn spinbit_randclient() {\n151\t    spinbit_test_one(SpinbitVersion::Random, SpinbitVersion::Basic).expect(\"spinbit_randclient\");\n152\t}\n153\t\n154\t/// C: `spinbit_null_test` in `picoquictest/spinbit_test.c`.\n155\t#[test]\n156\tfn spinbit_null() {\n157\t    spinbit_test_one(SpinbitVersion::Basic, SpinbitVersion::Null).expect(\"spinbit_null\");\n158\t}\n159\t\n160\t/// C: `spinbit_bad_test` in `picoquictest/spinbit_test.c`.\n161\t/// Verifies that invalid spinbit policy codes are rejected.\n162\t///\n163\t/// The C test passes raw out-of-range integer values (