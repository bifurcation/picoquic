{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_013YQhA69j92CSaFKKpCqoxc","type":"tool_result","content":"1\t//! Translation of `picoquic/picosocks.h` plus the Phase 2 socket\n2\t//! abstraction.\n3\t//!\n4\t//! Phase 2 reshape: the C `SOCKET_TYPE` (a Linux file descriptor)\n5\t//! is replaced by a [`Socket`] *trait* that the host platform\n6\t//! implements.  The default implementation wraps\n7\t//! [`socket2::Socket`] (the canonical cross-platform UDP socket\n8\t//! crate); other backends (no-std embedded, Windows-specific,\n9\t//! the test simulator) implement the same trait.\n10\t//! [`ServerSockets<S>`] is generic over the implementor.\n11\t//!\n12\t//! Phase 4: all method bodies are implemented.\n13\t\n14\tuse core::net::SocketAddr;\n15\t\n16\tuse crate::Error;\n17\tuse crate::Instant;\n18\t\n19\t// ---------------------------------------------------------------------------\n20\t// Constants and supporting types.\n21\t\n22\t/// Number of UDP sockets a server context owns — one IPv4, one\n23\t/// IPv6.  C: `PICOQUIC_NB_SERVER_SOCKETS`.\n24\tpub const SERVER_SOCKET_COUNT: usize = 2;\n25\t\n26\t/// `MessageHeader` is a re-export of [`socket2::MsgHdr`] — the\n27\t/// canonical cross-platform `msghdr` wrapper.  Phase 4 fills in\n28\t/// the bodies that thread one through the cmsg helpers.\n29\tpub type MessageHeader<'addr, 'bufs, 'control> = socket2::MsgHdr<'addr, 'bufs, 'control>;\n30\t\n31\t/// OS error code surfaced by socket sends when the underlying\n32\t/// syscall fails.  Wraps the raw Linux `errno` (or its Windows\n33\t/// equivalent on other targets) and exposes\n34\t/// [`OsError::is_unreachable`] for the path-abandon decision the\n35\t/// C `picoquic_socket_error_implies_unreachable` helper made.\n36\t#[derive(Debug, Copy, Clone, PartialEq, Eq)]\n37\tpub struct OsError(pub i32);\n38\t\n39\timpl OsError {\n40\t    /// Whether this errno implies the destination is unreachable\n41\t    /// and the owning path should be abandoned.  C:\n42\t    /// `picoquic_socket_error_implies_unreachable`.\n43\t    pub fn is_unreachable(self) -> bool {\n44\t        use std::io::ErrorKind;\n45\t        let kind = std::io::Error::from_raw_os_error(self.0).kind();\n46\t        matches!(\n47\t            kind,\n48\t            ErrorKind::ConnectionReset\n49\t                | ErrorKind::HostUnreachable\n50\t                | ErrorKind::NetworkDown\n51\t                | ErrorKind::NetworkUnreachable\n52\t        )\n53\t    }\n54\t}\n55\t\n56\t// ---------------------------------------------------------------------------\n57\t// `Socket` trait.\n58\t\n59\t/// One UDP socket on the application's network stack.  Replaces\n60\t/// the C `SOCKET_TYPE` (a raw file descriptor); the host\n61\t/// implementation supplies open / bind / send / recv operations\n62\t/// while the rest of picoquic stays platform-agnostic.\n63\t///\n64\t/// The default [`socket2::Socket`] implementation is in\n65\t/// [`crate::socks_socket2`] (gated on the `std` feature).\n66\tpub trait Socket {\n67\t    /// Local address bound to this socket (`getsockname`).\n68\t    /// C: `picoquic_get_local_address`.\n69\t    fn local_address(&self) -> Result<SocketAddr, Error>;\n70\t\n71\t    /// Receive one UDP datagram into `buffer`.  Output parameters\n72\t    /// (source / dest address, interface index, ECN, byte count)\n73\t    /// fold into [`RecvInfo`]; the slice length subsumes the C\n74\t    /// `buffer_max` parameter.  C: `picoquic_recvmsg`.\n75\t    fn recv(&mut self, buffer: &mut [u8]) -> Result<RecvInfo, Error>;\n76\t\n77\t    /// Send `bytes` to `addr_dest` from `addr_from` with an\n78\t    /// optional GSO segmentation hint `gso_size` (`UDP_SEGMENT`).\n79\t    /// `addr_from = None` lets the kernel choose the source\n80\t    /// address.  `Ok(n)` reports bytes sent; `Err` carries the\n81\t    /// OS error.  C: `picoquic_sendmsg`.\n82\t    fn send(\n83\t        &mut self,\n84\t        addr_dest: &SocketAddr,\n85\t        addr_from: Option<&SocketAddr>,\n86\t        dest_if: i32,\n87\t        bytes: &[u8],\n88\t        gso_size: i32,\n89\t    ) -> Result<usize, OsError>;\n90\t\n91\t    /// Enable per-packet destination-info delivery on this\n92\t    /// socket (`IP_PKTINFO` / `IPV6_RECVPKTINFO`).  Default:\n93\t    /// no-op for backends that don't surface pktinfo.\n94\t    fn set_pkt_info(&mut self) -> Result<(), Error> {\n95\t        Ok(())\n96\t    }\n97\t\n98\t    /// Enable ECN reception (and request `ECN_ECT_1` outbound).\n99\t    /// Returns `(recv_set, send_set)` indicating whether the\n100\t    /// kernel honored each socket option.  Default: no-op,\n101\t    /// returns `(false, false)`.\n102\t    fn set_ecn_options(&mut self) -> Result<(bool, bool), Error> {\n103\t        Ok((false, false))\n104\t    }\n105\t\n106\t    /// Like [`Self::set_ecn_options`] but with an explicit\n107\t    /// outbound TOS / ECN value (`ecn` is one of the 2-bit\n108\t    /// `EcnCodepoint` codes).  Default: delegates to the\n109\t    /// no-op `set_ecn_options`.\n110\t    fn set_ecn_options_ex(&mut self, _ecn: EcnCodepoint) -> Result<(bool, bool), Error> {\n111\t        self.set_ecn_options()\n112\t    }\n113\t\n114\t    /// Enable Path-MTU-Discovery probing on this socket\n115\t    /// (Linux-only; no-op on other platforms by default).\n116\t    fn set_pmtud_options(&mut self) -> Result<(), Error> {\n117\t        Ok(())\n118\t    }\n119\t\n120\t    /// Open and bind an IPv4 server socket on `port`.  Called by\n121\t    /// [`ServerSockets::open`]; concrete implementations override\n122\t    /// this to use their socket backend.\n123\t    fn open_server_v4(_port: i32) -> Result<Self, Error>\n124\t    where\n125\t        Self: Sized,\n126\t    {\n127\t        Err(Error::Generic)\n128\t    }\n129\t\n130\t    /// Open and bind an IPv6 server socket on `port`.  Called by\n131\t    /// [`ServerSockets::open`]; concrete implementations override\n132\t    /// this to use their socket backend.\n133\t    fn open_server_v6(_port: i32) -> Result<Self, Error>\n134\t    where\n135\t        Self: Sized,\n136\t    {\n137\t        Err(Error::Generic)\n138\t    }\n139\t}\n140\t\n141\t// ---------------------------------------------------------------------------\n142\t// `ServerSockets` -- generic over the socket implementation.\n143\t\n144\t/// Pair of UDP sockets owned by a server (one IPv4, one IPv6).\n145\t/// C: `picoquic_server_sockets_t`.  Generic over the active\n146\t/// [`Socket`] implementation.\n147\tpub struct ServerSockets<S: Socket> {\n148\t    /// One UDP socket per address family.  `None` slots are\n149\t    /// uninitialised — see [`ServerSockets::open`] /\n150\t    /// [`ServerSockets::close`].\n151\t    pub sockets: [Option<S>; SERVER_SOCKET_COUNT],\n152\t}\n153\t\n154\timpl<S: Socket> Default for ServerSockets<S> {\n155\t    fn default() -> Self {\n156\t        Self {\n157\t            sockets: [None, None],\n158\t        }\n159\t    }\n160\t}\n161\t\n162\timpl<S: Socket> ServerSockets<S> {\n163\t    /// Open the IPv4 + IPv6 server-side UDP socket pair listening\n164\t    /// on `port`.  C: `picoquic_open_server_sockets`.  The\n165\t    /// concrete `S` implementor is chosen at the call site;\n166\t    /// the default `crate::socks_socket2::Socket2Udp` wraps\n167\t    /// [`socket2::Socket`].\n168\t    pub fn open(port: i32) -> Result<Self, Error> {\n169\t        let s6 = S::open_server_v6(port)?;\n170\t        let s4 = S::open_server_v4(port)?;\n171\t        Ok(Self {\n172\t            sockets: [Some(s6), Some(s4)],\n173\t        })\n174\t    }\n175\t\n176\t    /// Close every socket in the pair, leaving each slot `None`.\n177\t    /// C: `picoquic_close_server_sockets`.\n178\t    pub fn close(&mut self) {\n179\t        for slot in &mut self.sockets {\n180\t            *slot = None;\n181\t        }\n182\t    }\n183\t\n184\t    /// Pick the matching socket (v4 / v6, dispatched by\n185\t    /// `addr_dest`'s family) and send through it.\n186\t    /// C: `picoquic_send_through_server_sockets`.\n187\t    pub fn send_through(\n188\t        &mut self,\n189\t        addr_dest: &SocketAddr,\n190\t        addr_from: Option<&SocketAddr>,\n191\t        from_if: i32,\n192\t        bytes: &[u8],\n193\t    ) -> Result<usize, OsError> {\n194\t        let idx = if addr_dest.is_ipv4() { 1 } else { 0 };\n195\t        match &mut self.sockets[idx] {\n196\t            Some(s) => s.send(addr_dest, addr_from, from_if, bytes, 0),\n197\t            None => Err(OsError(-1)),\n198\t        }\n199\t    }\n200\t}\n201\t\n202\t// ---------------------------------------------------------------------------\n203\t// Receive metadata.\n204\t\n205\t/// Receive metadata returned by [`Socket::recv`].  Mirrors the\n206\t/// C output parameters folded into a single struct.\n207\t#[derive(Debug, Default, Copy, Clone)]\n208\tpub struct RecvInfo {\n209\t    /// Source address; `None` matches the C `addr_from->ss_family\n210\t    /// = 0` written when `recvmsg` returned `<= 0`.\n211\t    pub addr_from: Option<SocketAddr>,\n212\t    /// Destination address parsed out of `IP_PKTINFO` /\n213\t    /// `IPV6_PKTINFO` cmsg; `None` when no pktinfo was attached.\n214\t    pub addr_dest: Option<SocketAddr>,\n215\t    /// Receiving interface index from the same cmsg.\n216\t    pub dest_if: i32,\n217\t    /// `IP_TOS` / `IPV6_TCLASS` ECN code-point byte.\n218\t    pub received_ecn: u8,\n219\t    /// Number of bytes written into the caller's buffer.\n220\t    pub bytes_recv: usize,\n221\t}\n222\t\n223\t/// Result of [`select`].\n224\t///\n225\t/// Folds the seven nullable out-parameters of the C\n226\t/// `picoquic_select_ex` helper into one struct: source / destination\n227\t/// address, interface index, ECN code-point, byte count,\n228\t/// post-receive timestamp, and the index of the socket that fired.\n229\t#[derive(Debug, Copy, Clone)]\n230\tpub struct SelectInfo {\n231\t    pub addr_from: Option<SocketAddr>,\n232\t    pub addr_dest: Option<SocketAddr>,\n233\t    pub dest_if: i32,\n234\t    pub received_ecn: u8,\n235\t    pub bytes_recv: usize,\n236\t    pub current_time: Instant,\n237\t    pub socket_rank: usize,\n238\t}\n239\t\n240\timpl Default for SelectInfo {\n241\t    fn default() -> Self {\n242\t        Self {\n243\t            addr_from: None,\n244\t            addr_dest: None,\n245\t            dest_if: 0,\n246\t            received_ecn: 0,\n247\t            bytes_recv: 0,\n248\t            current_time: Instant::from_ticks(0),\n249\t            socket_rank: 0,\n250\t        }\n251\t    }\n252\t}\n253\t\n254\t/// Wait up to `delta_t` microseconds for a packet on any socket\n255\t/// in `sockets`, then read at most `buffer.len()` bytes.\n256\t///\n257\t/// Generic over the [`Socket`] implementation.  C:\n258\t/// `picoquic_select` and `picoquic_select_ex` are merged here —\n259\t/// the `_ex` form is the more general one; the rank lives in\n260\t/// [`SelectInfo`].\n261\tpub fn select<S: Socket>(\n262\t    sockets: &mut [S],\n263\t    buffer: &mut [u8],\n264\t    _delta_t: i64,\n265\t) -> Result<SelectInfo, Error> {\n266\t    // Faithful note: the C body uses select(2) with raw file descriptors.\n267\t    // The generic Socket trait does not expose a file descriptor, so this\n268\t    // fallback tries each socket once in order and returns the first that\n269\t    // delivers data.  Platform-specific implementations can supply a more\n270\t    // efficient multiplexed select via the concrete Socket type.\n271\t    for (rank, socket) in sockets.iter_mut().enumerate() {\n272\t        match socket.recv(buffer) {\n273\t            Ok(info) if info.bytes_recv > 0 => {\n274\t                let now_us = std::time::SystemTime::now()\n275\t                    .duration_since(std::time::SystemTime::UNIX_EPOCH)\n276\t                    .map(|d| d.as_micros() as u64)\n277\t                    .unwrap_or(0);\n278\t                return Ok(SelectInfo {\n279\t                    addr_from: info.addr_from,\n280\t                    addr_dest: info.addr_dest,\n281\t                    dest_if: info.dest_if,\n282\t                    received_ecn: info.received_ecn,\n283\t                    bytes_recv: info.bytes_recv,\n284\t                    current_time: Instant::from_ticks(now_us),\n285\t                    socket_rank: rank,\n286\t                });\n287\t            }\n288\t            _ => {}\n289\t        }\n290\t    }\n291\t    Err(Error::Generic)\n292\t}\n293\t\n294\t// ---------------------------------------------------------------------------\n295\t// Address resolution.\n296\t\n297\t/// Resolved server address plus the \"was the input a hostname?\"\n298\t/// hint the TLS layer needs to choose an SNI value.\n299\t#[derive(Debug, Copy, Clone)]\n300\tpub struct ServerAddress {\n301\t    pub addr: SocketAddr,\n302\t    pub is_name: bool,\n303\t}\n304\t\n305\timpl ServerAddress {\n306\t    /// Parse `ip_address_text` (numeric IPv4 / IPv6 or hostname)\n307\t    /// and combine with `server_port` into a [`ServerAddress`].\n308\t    /// C: `picoquic_get_server_address`.\n309\t    pub fn resolve(ip_address_text: &str, server_port: i32) -> Result<Self, Error> {\n310\t        let port = server_port as u16;\n311\t        // Try numeric IPv4.\n312\t        if let Ok(ipv4) = ip_address_text.parse::<std::net::Ipv4Addr>() {\n313\t            return Ok(Self {\n314\t                addr: SocketAddr::V4(std::net::SocketAddrV4::new(ipv4, port)),\n315\t                is_name: false,\n316\t            });\n317\t        }\n318\t        // Try numeric IPv6.\n319\t        if let Ok(ipv6) = ip_address_text.parse::<std::net::Ipv6Addr>() {\n320\t            return Ok(Self {\n321\t                addr: SocketAddr::V6(std::net::SocketAddrV6::new(ipv6, port, 0, 0)),\n322\t                is_name: false,\n323\t            });\n324\t        }\n325\t        // Hostname: DNS lookup.\n326\t        use std::net::ToSocketAddrs;\n327\t        let addr = (ip_address_text, port)\n328\t            .to_socket_addrs()\n329\t            .map_err(|_| Error::Generic)?\n330\t            .next()\n331\t            .ok_or(Error::Generic)?;\n332\t        Ok(Self {\n333\t            addr,\n334\t            is_name: true,\n335\t        })\n336\t    }\n337\t}\n338\t\n339\t// ---------------------------------------------------------------------------\n340\t// Control-message helpers (cmsg parse / format).\n341\t\n342\t/// Result of cmsg parsing.  Folds the four nullable\n343\t/// out-parameters of the C helper into one struct.\n344\t#[derive(Debug, Default, Copy, Clone)]\n345\tpub struct CmsgInfo {\n346\t    /// Destination address parsed from `IP_PKTINFO` / `IPV6_PKTINFO`;\n347\t    /// `None` when no pktinfo was attached.\n348\t    pub addr_dest: Option<SocketAddr>,\n349\t    /// Receiving interface index from the same cmsg.\n350\t    pub dest_if: Option<i32>,\n351\t    /// `IP_TOS` / `IPV6_TCLASS` ECN code-point.\n352\t    pub received_ecn: Option<EcnCodepoint>,\n353\t    /// `UDP_GRO` segment size; always `0` on Linux.\n354\t    pub udp_coalesced_size: usize,\n355\t}\n356\t\n357\t/// IP / IPv6 ECN code-point reported by the kernel on receive.\n358\t/// Mirrors the two-bit `IP_TOS` / `IPV6_TCLASS` ECN field.\n359\t#[derive(Debug, Default, Copy, Clone, PartialEq, Eq)]\n360\t#[repr(u8)]\n361\tpub enum EcnCodepoint {\n362\t    #[default]\n363\t    NotEct = 0b00,\n364\t    Ect1 = 0b01,\n365\t    Ect0 = 0b10,\n366\t    Ce = 0b11,\n367\t}\n368\t\n369\t/// Parse the control-message ancillary data attached to a\n370\t/// received `msghdr`.  C: `picoquic_socks_cmsg_parse`.\n371\tpub fn parse_cmsg(_header: &MessageHeader<'_, '_, '_>) -> CmsgInfo {\n372\t    // Control-message parsing requires CMSG_FIRSTHDR / CMSG_NXTHDR macros,\n373\t    // which are not available in safe Rust through socket2 0.5.  Return a\n374\t    // neutral default; ECN and pktinfo will appear as absent.\n375\t    CmsgInfo::default()\n376\t}\n377\t\n378\t/// Write `IP_PKTINFO` / `IPV6_PKTINFO` / `UDP_SEGMENT` control\n379\t/// messages into `header` for an outgoing datagram.  C:\n380\t/// `picoquic_socks_cmsg_format`.\n381\tpub fn format_cmsg(\n382\t    _header: &mut MessageHeader<'_, '_, '_>,\n383\t    _message_length: usize,\n384\t    _send_msg_size: usize,\n385\t    _addr_from: Option<&SocketAddr>,\n386\t    _dest_if: i32,\n387\t) {\n388\t    // Control-message formatting requires CMSG_ macros not available in\n389\t    // safe Rust through socket2 0.5.  The kernel will pick the source\n390\t    // address; GSO segmentation and ECN marking are not applied.\n391\t}\n392\t\n393\t#[cfg(test)]\n394\tmod test {}\n395\t"}]},"parent_tool_use_id":null,"session_id":"40395700-1831-4991-bd38-88b19d18c7a2","uuid":"e1cbdf09-5f04-4ffa-bcd2-964838f78374","timestamp":"2026-05-07T06:59:40.830Z","tool_use_result":{"type":"text","file":{"filePath":"/Users/richbarn/Projects/picoquic/rs/fq/src/socks.rs","content":"//! Translation of `picoquic/picosocks.h` plus the Phase 2 socket\n//! abstraction.\n//!\n//! Phase 2 reshape: the C `SOCKET_TYPE` (a Linux file descriptor)\n//! is replaced by a [`Socket`] *trait* that the host platform\n//! implements.  The default implementation wraps\n//! [`socket2::Socket`] (the canonical cross-platform UDP socket\n//! crate); other backends (no-std embedded, Windows-specific,\n//! the test simulator) implement the same trait.\n//! [`ServerSockets<S>`] is generic over the implementor.\n//!\n//! Phase 4: all method bodies are implemented.\n\nuse core::net::SocketAddr;\n\nuse crate::Error;\nuse crate::Instant;\n\n// ---------------------------------------------------------------------------\n// Constants and supporting types.\n\n/// Number of UDP sockets a server context owns — one IPv4, one\n/// IPv6.  C: `PICOQUIC_NB_SERVER_SOCKETS`.\npub const SERVER_SOCKET_COUNT: usize = 2;\n\n/// `MessageHeader` is a re-export of [`socket2::MsgHdr`] — the\n/// canonical cross-platform `msghdr` wrapper.  Phase 4 fills in\n/// the bodies that thread one through the cmsg helpers.\npub type MessageHeader<'addr, 'bufs, 'control> = socket2::MsgHdr<'addr, 'bufs, 'control>;\n\n/// OS error code surfaced by socket sends when the underlying\n/// syscall fails.  Wraps the raw Linux `errno` (or its Windows\n/// equivalent on other targets) and exposes\n/// [`OsError::is_unreachable`] for the path-abandon decision the\n/// C `picoquic_socket_error_implies_unreachable` helper made.\n#[derive(Debug, Copy, Clone, PartialEq, Eq)]\npub struct OsError(pub i32);\n\nimpl OsError {\n    /// Whether this errno implies the destination is unreachable\n    /// and the owning path should be abandoned.  C:\n    /// `picoquic_socket_error_implies_unreachable`.\n    pub fn is_unreachable(self) -> bool {\n        use std::io::ErrorKind;\n        let kind = std::io::Error::from_raw_os_error(self.0).kind();\n        matches!(\n            kind,\n            ErrorKind::ConnectionReset\n                | ErrorKind::HostUnreachable\n                | ErrorKind::NetworkDown\n                | ErrorKind::NetworkUnreachable\n        )\n    }\n}\n\n// ---------------------------------------------------------------------------\n// `Socket` trait.\n\n/// One UDP socket on the application's network stack.  Replaces\n/// the C `SOCKET_TYPE` (a raw file descriptor); the host\n/// implementation supplies open / bind / send / recv operations\n/// while the rest of picoquic stays platform-agnostic.\n///\n/// The default [`socket2::Socket`] implementation is in\n/// [`crate::socks_socket2`] (gated on the `std` feature).\npub trait Socket {\n    /// Local address bound to this socket (`getsockname`).\n    /// C: `picoquic_get_local_address`.\n    fn local_address(&self) -> Result<SocketAddr, Error>;\n\n    /// Receive one UDP datagram into `buffer`.  Output parameters\n    /// (source / dest address, interface index, ECN, byte count)\n    /// fold into [`RecvInfo`]; the slice length subsumes the C\n    /// `buffer_max` parameter.  C: `picoquic_recvmsg`.\n    fn recv(&mut self, buffer: &mut [u8]) -> Result<RecvInfo, Error>;\n\n    /// Send `bytes` to `addr_dest` from `addr_from` with an\n    /// optional GSO segmentation hint `gso_size` (`UDP_SEGMENT`).\n    /// `addr_from = None` lets the kernel choose the source\n    /// address.  `Ok(n)` reports bytes sent; `Err` carries the\n    /// OS error.  C: `picoquic_sendmsg`.\n    fn send(\n        &mut self,\n        addr_dest: &SocketAddr,\n        addr_from: Option<&SocketAddr>,\n        dest_if: i32,\n        bytes: &[u8],\n        gso_size: i32,\n    ) -> Result<usize, OsError>;\n\n    /// Enable per-packet destination-info delivery on this\n    /// socket (`IP_PKTINFO` / `IPV6_RECVPKTINFO`).  Default:\n    /// no-op for backends that don't surface pktinfo.\n    fn set_pkt_info(&mut self) -> Result<(), Error> {\n        Ok(())\n    }\n\n    /// Enable ECN reception (and request `ECN_ECT_1` outbound).\n    /// Returns `(recv_set, send_set)` indicating whether the\n    /// kernel honored each socket option.  Default: no-op,\n    /// returns `(false, false)`.\n    fn set_ecn_options(&mut self) -> Result<(bool, bool), Error> {\n        Ok((false, false))\n    }\n\n    /// Like [`Self::set_ecn_options`] but with an explicit\n    /// outbound TOS / ECN value (`ecn` is one of the 2-bit\n    /// `EcnCodepoint` codes).  Default: delegates to the\n    /// no-op `set_ecn_options`.\n    fn set_ecn_options_ex(&mut self, _ecn: EcnCodepoint) -> Result<(bool, bool), Error> {\n        self.set_ecn_options()\n    }\n\n    /// Enable Path-MTU-Discovery probing on this socket\n    /// (Linux-only; no-op on other platforms by default).\n    fn set_pmtud_options(&mut self) -> Result<(), Error> {\n        Ok(())\n    }\n\n    /// Open and bind an IPv4 server socket on `port`.  Called by\n    /// [`ServerSockets::open`]; concrete implementations override\n    /// this to use their socket backend.\n    fn open_server_v4(_port: i32) -> Result<Self, Error>\n    where\n        Self: Sized,\n    {\n        Err(Error::Generic)\n    }\n\n    /// Open and bind an IPv6 server socket on `port`.  Called by\n    /// [`ServerSockets::open`]; concrete implementations override\n    /// this to use their socket backend.\n    fn open_server_v6(_port: i32) -> Result<Self, Error>\n    where\n        Self: Sized,\n    {\n        Err(Error::Generic)\n    }\n}\n\n// ---------------------------------------------------------------------------\n// `ServerSockets` -- generic over the socket implementation.\n\n/// Pair of UDP sockets owned by a server (one IPv4, one IPv6).\n/// C: `picoquic_server_sockets_t`.  Generic over the active\n/// [`Socket`] implementation.\npub struct ServerSockets<S: Socket> {\n    /// One UDP socket per address family.  `None` slots are\n    /// uninitialised — see [`ServerSockets::open`] /\n    /// [`ServerSockets::close`].\n    pub sockets: [Option<S>; SERVER_SOCKET_COUNT],\n}\n\nimpl<S: Socket> Default for ServerSockets<S> {\n    fn default() -> Self {\n        Self {\n            sockets: [None, None],\n        }\n    }\n}\n\nimpl<S: Socket> ServerSockets<S> {\n    /// Open the IPv4 + IPv6 server-side UDP socket pair listening\n    /// on `port`.  C: `picoquic_open_server_sockets`.  The\n    /// concrete `S` implementor is chosen at the call site;\n    /// the default `crate::socks_socket2::Socket2Udp` wraps\n    /// [`socket2::Socket`].\n    pub fn open(port: i32) -> Result<Self, Error> {\n        let s6 = S::open_server_v6(port)?;\n        let s4 = S::open_server_v4(port)?;\n        Ok(Self {\n            sockets: [Some(s6), Some(s4)],\n        })\n    }\n\n    /// Close every socket in the pair, leaving each slot `None`.\n    /// C: `picoquic_close_server_sockets`.\n    pub fn close(&mut self) {\n        for slot in &mut self.sockets {\n            *slot = None;\n        }\n    }\n\n    /// Pick the matching socket (v4 / v6, dispatched by\n    /// `addr_dest`'s family) and send through it.\n    /// C: `picoquic_send_through_server_sockets`.\n    pub fn send_through(\n        &mut self,\n        addr_dest: &SocketAddr,\n        addr_from: Option<&SocketAddr>,\n        from_if: i32,\n        bytes: &[u8],\n    ) -> Result<usize, OsError> {\n        let idx = if addr_dest.is_ipv4() { 1 } else { 0 };\n        match &mut self.sockets[idx] {\n            Some(s) => s.send(addr_dest, addr_from, from_if, bytes, 0),\n            None => Err(OsError(-1)),\n        }\n    }\n}\n\n// ---------------------------------------------------------------------------\n// Receive metadata.\n\n/// Receive metadata returned by [`Socket::recv`].  Mirrors the\n/// C output parameters folded into a single struct.\n#[derive(Debug, Default, Copy, Clone)]\npub struct RecvInfo {\n    /// Source address; `None` matches the C `addr_from->ss_family\n    /// = 0` written when `recvmsg` returned `<= 0`.\n    pub addr_from: Option<SocketAddr>,\n    /// Destination address parsed out of `IP_PKTINFO` /\n    /// `IPV6_PKTINFO` cmsg; `None` when no pktinfo was attached.\n    pub addr_dest: Option<SocketAddr>,\n    /// Receiving interface index from the same cmsg.\n    pub dest_if: i32,\n    /// `IP_TOS` / `IPV6_TCLASS` ECN code-point byte.\n    pub received_ecn: u8,\n    /// Number of bytes written into the caller's buffer.\n    pub bytes_recv: usize,\n}\n\n/// Result of [`select`].\n///\n/// Folds the seven nullable out-parameters of the C\n/// `picoquic_select_ex` helper into one struct: source / destination\n/// address, interface index, ECN code-point, byte count,\n/// post-receive timestamp, and the index of the socket that fired.\n#[derive(Debug, Copy, Clone)]\npub struct SelectInfo {\n    pub addr_from: Option<SocketAddr>,\n    pub addr_dest: Option<SocketAddr>,\n    pub dest_if: i32,\n    pub received_ecn: u8,\n    pub bytes_recv: usize,\n    pub current_time: Instant,\n    pub socket_rank: usize,\n}\n\nimpl Default for SelectInfo {\n    fn default() -> Self {\n        Self {\n            addr_from: None,\n            addr_dest: None,\n            dest_if: 0,\n            received_ecn: 0,\n            bytes_recv: 0,\n            current_time: Instant::from_ticks(0),\n            socket_rank: 0,\n        }\n    }\n}\n\n/// Wait up to `delta_t` microseconds for a packet on any socket\n/// in `sockets`, then read at most `buffer.len()` bytes.\n///\n/// Generic over the [`Socket`] implementation.  C:\n/// `picoquic_select` and `picoquic_select_ex` are merged here —\n/// the `_ex` form is the more general one; the rank lives in\n/// [`SelectInfo`].\npub fn select<S: Socket>(\n    sockets: &mut [S],\n    buffer: &mut [u8],\n    _delta_t: i64,\n) -> Result<SelectInfo, Error> {\n    // Faithful note: the C body uses select(2) with raw file descriptors.\n    // The generic Socket trait does not expose a file descriptor, so this\n    // fallback tries each socket once in order and returns the first that\n    // delivers data.  Platform-specific implementations can supply a more\n    // efficient multiplexed select via the concrete Socket type.\n    for (rank, socket) in sockets.iter_mut().enumerate() {\n        match socket.recv(buffer) {\n            Ok(info) if info.bytes_recv > 0 => {\n                let now_us = std::time::SystemTime::now()\n                    .duration_since(std::time::SystemTime::UNIX_EPOCH)\n                    .map(|d| d.as_micros() as u64)\n                    .unwrap_or(0);\n                return Ok(SelectInfo {\n                    addr_from: info.addr_from,\n                    addr_dest: info.addr_dest,\n                    dest_if: info.dest_if,\n                    received_ecn: info.received_ecn,\n                    bytes_recv: info.bytes_recv,\n                    current_time: Instant::from_ticks(now_us),\n                    socket_rank: rank,\n                });\n            }\n            _ => {}\n        }\n    }\n    Err(Error::Generic)\n}\n\n// ---------------------------------------------------------------------------\n// Address resolution.\n\n/// Resolved server address plus the \"was the input a hostname?\"\n/// hint the TLS layer needs to choose an SNI value.\n#[derive(Debug, Copy, Clone)]\npub struct ServerAddress {\n    pub addr: SocketAddr,\n    pub is_name: bool,\n}\n\nimpl ServerAddress {\n    /// Parse `ip_address_text` (numeric IPv4 / IPv6 or hostname)\n    /// and combine with `server_port` into a [`ServerAddress`].\n    /// C: `picoquic_get_server_address`.\n    pub fn resolve(ip_address_text: &str, server_port: i32) -> Result<Self, Error> {\n        let port = server_port as u16;\n        // Try numeric IPv4.\n        if let Ok(ipv4) = ip_address_text.parse::<std::net::Ipv4Addr>() {\n            return Ok(Self {\n                addr: SocketAddr::V4(std::net::SocketAddrV4::new(ipv4, port)),\n                is_name: false,\n            });\n        }\n        // Try numeric IPv6.\n        if let Ok(ipv6) = ip_address_text.parse::<std::net::Ipv6Addr>() {\n            return Ok(Self {\n                addr: SocketAddr::V6(std::net::SocketAddrV6::new(ipv6, port, 0, 0)),\n                is_name: false,\n            });\n        }\n        // Hostname: DNS lookup.\n        use std::net::ToSocketAddrs;\n        let addr = (ip_address_text, port)\n            .to_socket_addrs()\n            .map_err(|_| Error::Generic)?\n            .next()\n            .ok_or(Error::Generic)?;\n        Ok(Self {\n            addr,\n            is_name: true,\n        })\n    }\n}\n\n// ---------------------------------------------------------------------------\n// Control-message helpers (cmsg parse / format).\n\n/// Result of cmsg parsing.  Folds the four nullable\n/// out-parameters of the C helper into one struct.\n#[derive(Debug, Default, Copy, Clone)]\npub struct CmsgInfo {\n    /// Destination address parsed from `IP_PKTINFO` / `IPV6_PKTINFO`;\n    /// `None` when no pktinfo was attached.\n    pub addr_dest: Option<SocketAddr>,\n    /// Receiving interface index from the same cmsg.\n    pub dest_if: Option<i32>,\n    /// `IP_TOS` / `IPV6_TCLASS` ECN code-point.\n    pub received_ecn: Option<EcnCodepoint>,\n    /// `UDP_GRO` segment size; always `0` on Linux.\n    pub udp_coalesced_size: usize,\n}\n\n/// IP / IPv6 ECN code-point reported by the kernel on receive.\n/// Mirrors the two-bit `IP_TOS` / `IPV6_TCLASS` ECN field.\n#[derive(Debug, Default, Copy, Clone, PartialEq, Eq)]\n#[repr(u8)]\npub enum EcnCodepoint {\n    #[default]\n    NotEct = 0b00,\n    Ect1 = 0b01,\n    Ect0 = 0b10,\n    Ce = 0b11,\n}\n\n/// Parse the control-message ancillary data attached to a\n/// received `msghdr`.  C: `picoquic_socks_cmsg_parse`.\npub fn parse_cmsg(_header: &MessageHeader<'_, '_, '_>) -> CmsgInfo {\n    // Control-message parsing requires CMSG_FIRSTHDR / CMSG_NXTHDR macros,\n    // which are not available in safe Rust through socket2 0.5.  Return a\n    // neutral default; ECN and pktinfo will appear as absent.\n    CmsgInfo::default()\n}\n\n/// Write `IP_PKTINFO` / `IPV6_PKTINFO` / `UDP_SEGMENT` control\n/// messages into `header` for an outgoing datagram.  C:\n/// `picoquic_socks_cmsg_format`.\npub fn format_cmsg(\n    _header: &mut MessageHeader<'_, '_, '_>,\n    _message_length: usize,\n    _send_msg_size: usize,\n    _addr_from: Option<&SocketAddr>,\n    _dest_if: i32,\n) {\n    // Control-message formatting requires CMSG_ macros not available in\n    // safe Rust through socket2 0.5.  The kernel will pick the source\n    // address; GSO segmentation and ECN marking are not applied.\n}\n\n#[cfg(test)]\nmod test {}\n","numLines":395,"startLine":1,"totalLines":395}}}
