_THRESHOLD;","+                self.app_limited_round_count = 0;","+            }","+            self.app_limited_this_round = 0;","+        } else {","+            self.app_limited_this_round |= rs.is_app_limited as i32;","+        }","+        app_limited_ended","+    }"," }"," "," /// C: `BBRAccessEcnPacketContext` (picoquic/bbr.c:2245)"]}],"userModified":false,"replaceAll":false}}
