e) {\n213\t        if self.loss_round_start {\n214\t            self.bw_latest = rs.delivery_rate;\n215\t            self.inflight_latest = rs.delivered;\n216\t        }\n217\t    }\n218\t\n219\t    /// C: `BBRBDPMultipleWithBw` (picoquic/bbr.c:869)\n220\t    ///\n221\t    /// Returns `gain × BDP` computed at the supplied `bw` rather than\n222\t    /// `self.bw`.  When `min_rtt` has never been measured (`u64::MAX`),\n223\t    /// returns the initial congestion window as a safe floor.\n224\t    ///\n225\t    /// Side-effect: writes `self.bdp` so callers can read the raw BDP\n226\t    /// estimate after the call (mirrors C's write-through of\n227\t    /// `bbr_state->bdp`).\n228\t    pub fn bdp_multiple_with_bw(&mut self, path_x: &Path, gain: f64, bw: u64) -> u64 {\n229\t        if self.min_rtt == u64::MAX {\n230\t            return CWIN_INITIAL * path_x.send_mtu as u64;\n231\t        }\n232\t        // PICOQUIC_BYTES_FROM_RATE(min_rtt_us, bps) = min_rtt * bps / 1_000_000\n233\t        self.bdp = self.min_rtt * bw / 1_000_000;\n234\t        (gain * self.bdp as f64) as u64\n235\t    }\n236\t\n237\t    /// C: `BBRBoundBWForModel` (picoquic/bbr.c:1094)\n238\t    ///\n239\t    /// Set `self.bw = min(max_bw, bw_lo, bw_hi)`.  `bw_hi` is only\n240\t    /// applied when non-zero; the zero check preserves compatibility\n241\t    /// with states where `bw_hi` is not yet initialised (noted as a\n242\t    /// TODO in the C source).\n243\t    pub fn bound_bw_for_model(&mut self) {\n244\t        self.bw = self.max_bw;\n245\t        if self.bw > self.bw_lo {\n246\t            self.bw = self.bw_lo;\n247\t        }\n248\t        // TODO: remove the bw_hi != 0 guard once variables are properly\n249\t        // initialised (mirrors the C-side TODO at bbr.c:1100).\n250\t        if self.bw > self.bw_hi && self.bw_hi != 0 {\n251\t            self.bw = self.bw_hi;\n252\t        }\n253\t    }\n254\t}\n255\t\n256\t/// C: `BBRAccessEcnPacketContext` (picoquic/bbr.c:2245)\n257\t///\n258\t/// Re