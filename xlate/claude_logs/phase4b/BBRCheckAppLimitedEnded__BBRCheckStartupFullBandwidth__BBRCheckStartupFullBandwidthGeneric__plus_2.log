{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01CnjpwUNXMdnXCPMmW1NVkx","type":"tool_result","content":"1928\t    BBRStartProbeBW_DOWN(bbr_state, path_x, current_time);\n1929\t}\n1930\t/* End of probe BW specific algorithms */\n1931\t\n1932\t/* Drain specific processes for BBRv3 */\n1933\tstatic void BBREnterDrain(picoquic_bbr_state_t* bbr_state, picoquic_path_t* path_x)\n1934\t{\n1935\t    path_x->is_ssthresh_initialized = 1; /* Picoquic specific: notify transport that the startup phase is complete */\n1936\t    bbr_state->state = picoquic_bbr_alg_drain;\n1937\t    bbr_state->pacing_gain = 1.0 / BBRStartupCwndGain;  /* pace slowly */\n1938\t    bbr_state->cwnd_gain = BBRStartupCwndGain;   /* maintain cwnd */\n1939\t\n1940\t    path_x->is_cca_probing_up = 0;\n1941\t}\n1942\t\n1943\tstatic void BBRCheckDrain(picoquic_bbr_state_t* bbr_state, picoquic_path_t* path_x, uint64_t current_time)\n1944\t{\n1945\t    if (bbr_state->state == picoquic_bbr_alg_drain && path_x->bytes_in_transit <= BBRInflight(bbr_state, path_x, 1.0)) {\n1946\t        BBREnterProbeBW(bbr_state, path_x, current_time);  /* we estimate that the queue is drained */\n1947\t    }\n1948\t}\n1949\t/* End of drain specific algorithms */\n1950\t\n1951\t/* Startup extension to support careful resume */\n1952\tstatic void BBRCheckStartupFullBandwidthGeneric(picoquic_bbr_state_t* bbr_state,\n1953\t    bbr_per_ack_state_t * rs, double threshold)\n1954\t{\n1955\t    if (bbr_state->filled_pipe ||\n1956\t        !bbr_state->round_start || rs->is_app_limited) {\n1957\t        return;  /* no need to check for a full pipe now */\n1958\t    }\n1959\t\n1960\t    if ((double)bbr_state->max_bw >= threshold*((double)bbr_state->full_bw)) {\n1961\t        /* still growing? */\n1962\t        bbr_state->full_bw = bbr_state->max_bw;    /* record new baseline level */\n1963\t        bbr_state->full_bw_count = 0;\n1964\t        return;\n1965\t    }\n1966\t    bbr_state->full_bw_count++; /* another round