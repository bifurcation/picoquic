{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01NxQENqvjoZrMdYLrAihvXk","type":"tool_result","content":"1\t//! Translation of `picoquic/c4.c` — C4 congestion control.\n2\t\n3\tuse crate::cc_common::{ConnectionCc, PathCc, SMOOTHED_LOSS_FACTOR, SMOOTHED_LOSS_SCOPE};\n4\tuse crate::internal::{Connection, Path};\n5\tuse crate::{PacketContext, State};\n6\t\n7\t// ---------------------------------------------------------------------------\n8\t// Constants from c4.c `#define`s.\n9\t\n10\tconst C4_ALPHA_PUSH_LOW_1024: u64 = 1088; // C: C4_ALPHA_PUSH_LOW_1024 (106.25%)\n11\t/// Gain parameter for the ECN alpha EWMA: g = 1/2^4.  C: `C4_ECN_SHIFT_G`.\n12\tconst C4_ECN_SHIFT_G: u32 = 4;\n13\t/// Maximum delay threshold in microseconds (25 ms).  C: `C4_DELAY_THRESHOLD_MAX`.\n14\tconst C4_DELAY_THRESHOLD_MAX: u64 = 25_000;\n15\t/// Default probe level on entry to Initial.  C: `C4_PROBE_LEVEL_DEFAULT`.\n16\t#[allow(dead_code)]\n17\tconst C4_PROBE_LEVEL_DEFAULT: i32 = 1;\n18\t/// Alpha multiplier during Initial slow-start (200%).  C: `C4_ALPHA_INITIAL`.\n19\t#[allow(dead_code)]\n20\tconst C4_ALPHA_INITIAL: u64 = 2048;\n21\t/// Alpha multiplier during Recovery (93.75%).  C: `C4_ALPHA_RECOVER_1024`.\n22\t#[allow(dead_code)]\n23\tconst C4_ALPHA_RECOVER_1024: u64 = 960;\n24\t\n25\t// ---------------------------------------------------------------------------\n26\t// `MULT1024(c, v)` — fixed-point scale by c/1024.  C: `MULT1024`.\n27\t\n28\t#[inline]\n29\tfn mult1024(c: u64, v: u64) -> u64 {\n30\t    (v * c) >> 10\n31\t}\n32\t\n33\t// ---------------------------------------------------------------------------\n34\t// Algorithm-state enum.  C: `c4_alg_state_t`.\n35\t\n36\t#[derive(Debug, Copy, Clone, PartialEq, Eq, Default)]\n37\tpub enum C4AlgState {\n38\t    #[default]\n39\t    Initial = 0,\n40\t    Recovery,\n41\t    Cruising,\n42\t    Pushing,\n43\t}\n44\t\n45\t// ---------------------------------------------------------------------------\n46\t// Congestion-event discriminant.  C: `c4_congestion_t`.\n47\t\n48\t#[derive(Debug, Copy, Clone, PartialEq, Eq, Default)]\n49\tpub enum C4Congestion {\n50\t    #[default]\n51\t    None = 0,\n52\t    Delay,\n53\t    Ecn,\n54\t    Loss,\n55\t}\n56\t\n57\t// ---------------------------------------------------------------------------\n58\t// C4 algorithm state.  C: `c4_state_t` (picoquic/c4.c:143).\n59\t//\n60\t// Type deviations from C:\n61\t//   * single-bit `unsigned int x : 1` bitfields → `bool`\n62\t//   * `const char* option_string` → `Option<String>` (owned copy)\n63\t\n64\tpub struct C4State {\n65\t    pub alg_state: C4AlgState,\n66\t    pub nominal_rate: u64,\n67\t    pub nominal_max_rtt: u64,\n68\t    pub initial_cwnd: u64,\n69\t    pub running_min_rtt: u64,\n70\t    pub alpha_1024_current: u64,\n71\t    pub alpha_1024_previous: u64,\n72\t    pub nb_packets_in_startup: u64,\n73\t    pub era_sequence: u64,\n74\t    pub nb_cruise_left_before_push: u64,\n75\t    pub seed_cwin: u64,\n76\t    pub seed_rate: u64,\n77\t    pub probe_level: i32,\n78\t    pub nb_eras_no_increase: i32,\n79\t    pub push_rate_old: u64,\n80\t    pub push_alpha: u64,\n81\t    pub era_max_rtt: u64,\n82\t    pub era_min_rtt: u64,\n83\t    pub delay_threshold: u64,\n84\t    pub recent_delay_excess: u64,\n85\t    pub last_lost_packet_number: u64,\n86\t    pub smoothed_drop_rate: f64,\n87\t    pub ecn_alpha: u64,\n88\t    pub ecn_ect1: u64,\n89\t    pub ecn_ce: u64,\n90\t    pub ecn_threshold: u64,\n91\t    pub congestion_notified: bool,\n92\t    pub push_was_not_limited: bool,\n93\t    pub use_seed_cwin: bool,\n94\t    pub initial_after_jitter: bool,\n95\t    pub excess_ce_after_push: bool,\n96\t    pub option_string: Option<String>,\n97\t}\n98\t\n99\timpl C4State {\n100\t    /// C: `c4_sensitivity_1024` (picoquic/c4.c:244)\n101\t    ///\n102\t    /// Fixed-point sensitivity in [0, 1024] scaled to `nominal_rate`:\n103\t    /// 0 below 50 kbps, 1024 above 10 Mbps, linearly interpolated in between.\n104\t    fn sensitivity_1024(&self) -> u64 {\n105\t        if self.nominal_rate < 50_000 {\n106\t            0\n107\t        } else if self.nominal_rate > 10_000_000 {\n108\t            1024\n109\t        } else if self.nominal_rate < 1_000_000 {\n110\t            (self.nominal_rate - 50_000) * 963 / 950_000\n111\t        } else {\n112\t            963 + ((self.nominal_rate - 1_000_000) * 61 / 9_000_000)\n113\t        }\n114\t    }\n115\t\n116\t    /// C: `c4_growth_evaluate` (picoquic/c4.c:429)\n117\t    ///\n118\t    /// Returns `true` when the previous era produced meaningful throughput\n119\t    /// growth.  If `push_alpha` was large enough to measure reliably, growth\n120\t    /// is defined as exceeding the alpha-scaled old rate; otherwise it falls\n121\t    /// back to a simple rate comparison guarded by the absence of congestion.\n122\t    fn growth_evaluate(&self) -> bool {\n123\t        if self.push_alpha > C4_ALPHA_PUSH_LOW_1024 {\n124\t            let target_rate =\n125\t                (3 * self.push_rate_old + mult1024(self.push_alpha, self.push_rate_old)) / 4;\n126\t            self.nominal_rate > target_rate\n127\t        } else {\n128\t            self.nominal_rate > self.push_rate_old && !self.congestion_notified\n129\t        }\n130\t    }\n131\t\n132\t    /// C: `c4_growth_reset` (picoquic/c4.c:449)\n133\t    fn growth_reset(&mut self) {\n134\t        self.congestion_notified = false;\n135\t        self.push_was_not_limited = false;\n136\t        self.push_rate_old = self.nominal_rate;\n137\t        // push_alpha is reset to current alpha here; caller sets it to correct\n138\t        // value when entering push state.\n139\t        self.push_alpha = self.alpha_1024_current;\n140\t    }\n141\t\n142\t    /// C: `c4_set_options` (picoquic/c4.c:499)\n143\t    ///\n144\t    /// Parses `option_string` for recognized option characters.  No option\n145\t    /// characters are currently defined; the loop exits on the first unknown.\n146\t    fn set_options(&mut self) {\n147\t        if let Some(s) = self.option_string.as_deref() {\n148\t            // No recognized option characters are currently defined.  The C switch\n149\t            // hits `default: ended = 1` for every character, so the loop exits\n150\t            // immediately after consuming the first character.\n151\t            let _ = s.chars().next();\n152\t        }\n153\t    }\n154\t\n155\t    /// C: `c4_seed_cwin` (picoquic/c4.c:527)\n156\t    pub fn seed_cwin(&mut self, bytes_in_flight: u64) {\n157\t        if self.alg_state == C4AlgState::Initial {\n158\t            self.use_seed_cwin = true;\n159\t            self.seed_cwin = bytes_in_flight;\n160\t        }\n161\t    }\n162\t\n163\t    /// C: `c4_observe` (picoquic/c4.c:1121)\n164\t    ///\n165\t    /// Returns `(cc_state, cc_param)`: the algorithm-state discriminant and\n166\t    /// `nominal_max_rtt`, matching the C convention of filling two `uint64_t*`\n167\t    /// out-params.\n168\t    pub fn observe(&self) -> (u64, u64) {\n169\t        (self.alg_state as u64, self.nominal_max_rtt)\n170\t    }\n171\t\n172\t    /// C: `c4_update_loss_rate` (picoquic/c4.c:301)\n173\t    ///\n174\t    /// Advances the smoothed drop-rate EMA to account for packets up to and\n175\t    /// including `lost_packet_number`.  Each step between the last recorded\n176\t    /// loss and the new one decays the rate; the final step adds one loss\n177\t    /// event.  Steps beyond `SMOOTHED_LOSS_SCOPE` behind the new number are\n178\t    /// skipped to cap the decay loop.\n179\t    pub fn update_loss_rate(&mut self, lost_packet_number: u64) {\n180\t        let mut next_number = self.last_lost_packet_number;\n181\t\n182\t        if lost_packet_number > next_number {\n183\t            if next_number + SMOOTHED_LOSS_SCOPE < lost_packet_number {\n184\t                next_number = lost_packet_number - SMOOTHED_LOSS_SCOPE;\n185\t            }\n186\t\n187\t            while next_number < lost_packet_number {\n188\t                self.smoothed_drop_rate *= 1.0 - SMOOTHED_LOSS_FACTOR;\n189\t                next_number += 1;\n190\t            }\n191\t\n192\t            self.smoothed_drop_rate += (1.0 - self.smoothed_drop_rate) * SMOOTHED_LOSS_FACTOR;\n193\t            self.last_lost_packet_number = lost_packet_number;\n194\t        }\n195\t    }\n196\t\n197\t    /// ECN alpha EWMA core.  C: `c4_update_ecn_alpha` (picoquic/c4.c:321) body.\n198\t    ///\n199\t    /// Takes the current totals directly so the logic can be tested without\n200\t    /// constructing `Path` / `Connection`.  Called by `update_ecn_alpha`.\n201\t    fn ecn_alpha_update_counts(&mut self, ecn_ect1_remote: u64, ecn_ce_remote: u64) {\n202\t        let delta_ect1 = ecn_ect1_remote as i64 - self.ecn_ect1 as i64;\n203\t        let delta_ce = ecn_ce_remote as i64 - self.ecn_ce as i64;\n204\t\n205\t        self.ecn_ect1 = ecn_ect1_remote;\n206\t        self.ecn_ce = ecn_ce_remote;\n207\t\n208\t        if delta_ce > 0 || delta_ect1 > 0 {\n209\t            let sum = delta_ce + delta_ect1;\n210\t            let frac: u64 = if sum > 0 {\n211\t                ((delta_ce * 1024) / sum) as u64\n212\t            } else {\n213\t                0\n214\t            };\n215\t\n216\t            if frac > self.ecn_alpha && frac >= 512 {\n217\t                self.ecn_alpha = frac;\n218\t            } else {\n219\t                // EWMA: alpha = alpha*(1 - 1/2^shift) + frac*(1/2^shift)\n220\t                let alpha_shifted = (self.ecn_alpha << C4_ECN_SHIFT_G) - self.ecn_alpha + frac;\n221\t                self.ecn_alpha = alpha_shifted >> C4_ECN_SHIFT_G;\n222\t            }\n223\t        }\n224\t    }\n225\t\n226\t    /// C: `c4_delay_threshold` (picoquic/c4.c:266)\n227\t    ///\n228\t    /// Compute the delay threshold for declaring congestion.  Sensitivity\n229\t    /// is 0 at ≤ 50 kbps, 1024 at ≥ 10 Mbps, and linearly interpolated\n230\t    /// in between.  The resulting fraction scales `nominal_max_rtt`, giving\n231\t    /// a threshold in [64/1024 × rtt, 260/1024 × rtt], capped at\n232\t    /// [`C4_DELAY_THRESHOLD_MAX`] (25 ms).\n233\t    pub fn delay_threshold(&self) -> u64 {\n234\t        let sensitivity = self.sensitivity_1024();\n235\t        let fraction = 64 + mult1024(1024 - sensitivity, 196);\n236\t        let delay = mult1024(fraction, self.nominal_max_rtt);\n237\t        delay.min(C4_DELAY_THRESHOLD_MAX)\n238\t    }\n239\t\n240\t    /// C: `c4_update_ecn_alpha` (picoquic/c4.c:321)\n241\t    ///\n242\t    /// Selects the right packet context (path-scoped under multipath;\n243\t    /// connection application context otherwise) and delegates to\n244\t    /// `ecn_alpha_update_counts`.\n245\t    #[allow(dead_code)]\n246\t    pub(crate) fn update_ecn_alpha(&mut self, path_x: &Path, connection: &Connection) {\n247\t        let pkt_ctx = if connection.is_multipath_enabled {\n248\t            &path_x.pkt_ctx\n249\t        } else {\n250\t            &connection.pkt_ctx[PacketContext::Application as usize]\n251\t        };\n252\t        self.ecn_alpha_update_counts(pkt_ctx.ecn_ect1_total_remote, pkt_ctx.ecn_ce_total_remote);\n253\t    }\n254\t\n255\t    /// C: `c4_ecn_threshold` (picoquic/c4.c:281)\n256\t    ///\n257\t    /// Computes the ECN marking fraction (over 1024) above which a CE-mark\n258\t    /// event triggers congestion notification.  At low sensitivity the\n259\t    /// threshold is high (~192/1024 ≈ 18.75%); at maximum sensitivity it\n260\t    /// falls to ~96/1024 ≈ 9.375%.\n261\t    pub fn ecn_threshold(&self) -> u64 {\n262\t        let sensitivity = self.sensitivity_1024();\n263\t        192 - mult1024(sensitivity, 96)\n264\t    }\n265\t\n266\t    /// C: `c4_era_check` (picoquic/c4.c:463)\n267\t    ///\n268\t    /// Returns `true` when the current measurement era is complete: the\n269\t    /// connection must be in the Ready state, and the lowest unacknowledged\n270\t    /// sequence number must have advanced past `era_sequence`.\n271\t    #[allow(dead_code)]\n272\t    fn era_check(&self, path_x: &Path, connection: &Connection) -> bool {\n273\t        if connection.connection_state < State::Ready {\n274\t            return false;\n275\t        }\n276\t        path_x.lowest_not_ack() > self.era_sequence\n277\t    }\n278\t\n279\t    /// C: `c4_era_reset` (picoquic/c4.c:475)\n280\t    ///\n281\t    /// Begins a new measurement era: advances `era_sequence` to the current\n282\t    /// send sequence number, resets per-era RTT accumulators, snapshots\n283\t    /// `alpha_1024_current` into `alpha_1024_previous`, and updates the ECN\n284\t    /// alpha from the latest packet-context counters.\n285\t    #[allow(dead_code)]\n286\t    fn era_reset(&mut self, path_x: &Path, connection: &Connection) {\n287\t        self.era_sequence = connection.sequence_number(path_x);\n288\t        self.era_max_rtt = 0;\n289\t        self.era_min_rtt = u64::MAX;\n290\t        self.alpha_1024_previous = self.alpha_1024_current;\n291\t        self.update_ecn_alpha(path_x, connection);\n292\t    }\n293\t\n294\t    /// C: `c4_enter_initial` (picoquic/c4.c:486)\n295\t    ///\n296\t    /// Transitions to the Initial (slow-start) state: captures the current\n297\t    /// CWIN, sets probe level and alpha to their startup defaults, resets era\n298\t    /// and growth tracking, and zeroes the ECN alpha.\n299\t    #[allow(dead_code)]\n300\t    fn enter_initial(&mut self, path_x: &Path, connection: &Connection) {"}]},"parent_tool_use_id":"toolu_01MHtBgZYddCc3d77yZouPcF","session_id":"4f4cd1bb-ca1b-49c0-a612-160336c885bd","uuid":"08a3e1e4-2202-4437-9c15-97bd2e9402c0","timestamp":"2026-05-07T13:55:08.080Z"}
