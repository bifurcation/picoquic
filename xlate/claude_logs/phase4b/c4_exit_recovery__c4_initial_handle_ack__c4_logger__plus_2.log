{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01Wn43Bo5N4nHUhugr4Er5QT","type":"tool_result","content":"675\t/// implementation's `alg_notify` hook.\n676\t#[derive(Debug, Copy, Clone, PartialEq, Eq)]\n677\tpub enum CongestionNotification {\n678\t    /// At least one packet was acknowledged.\n679\t    Acknowledgement,\n680\t    /// A packet was retransmitted.\n681\t    Repeat,\n682\t    /// A retransmission timer expired.\n683\t    Timeout,\n684\t    /// A retransmission was found to have been spurious.\n685\t    SpuriousRepeat,\n686\t    /// A new RTT sample is available.\n687\t    RttMeasurement,\n688\t    /// ECN-marked traffic was acknowledged.\n689\t    EcnEc,\n690\t    /// The send path is blocked by the congestion window.\n691\t    CwinBlocked,\n692\t    /// Seed the congestion window from external knowledge.\n693\t    SeedCwin,\n694\t    /// Reset congestion-control state.\n695\t    Reset,\n696\t    /// Notification of lost feedback.\n697\t    LostFeedback,\n698\t}\n699\t\n700\t/// Per-ACK state passed to the congestion-control algorithm.  C:\n701\t/// `PerAckState`.\n702\t///\n703\t/// Single-bit `unsigned int : 1` bitfields collapse to `bool`.  `pc`\n704\t/// stays an `i32` (the C field used `int` instead of the enum\n705\t/// itself to avoid include dependencies; we follow suit so the\n706\t/// translation can be checked field-by-field).\n707\t#[derive(Debug, Copy, Clone)]\n708\tpub struct PerAckState {\n709\t    pub rtt_measurement: Duration,\n710\t    pub send_delay: Duration,\n711\t    pub one_way_delay: Duration,\n712\t    pub nb_bytes_acknowledged: u64,\n713\t    pub nb_bytes_newly_lost: u64,\n714\t    pub nb_bytes_lost_since_packet_sent: u64,\n715\t    pub nb_bytes_delivered_since_packet_sent: u64,\n716\t    pub inflight_prior: u64,\n717\t    pub lost_packet_number: u64,\n718\t    pub lost_packet_sent_time: Instant,\n719\t    pub pc: i32,\n720\t    pub is_app_limited: bool,\n721\t    pub is_cwnd_limited: bool,\n722\t}\n723\t\n724\timpl Default for PerAckState {\n725\t    fn default() -> Self {\n726\t        Self {\n727\t            rtt_measurement: Duration::from_ticks(0),\n728\t            send_delay: Duration::from_ticks(0),\n729\t            one_way_delay: Duration::from_ticks(0),\n730\t            nb_bytes_acknowledged: 0,\n731\t            nb_bytes_newly_lost: 0,\n732\t            nb_bytes_lost_since_packet_sent: 0,\n733\t            nb_bytes_delivered_since_packet_sent: 0,\n734\t            inflight_prior: 0,"}]},"parent_tool_use_id":"toolu_01MHtBgZYddCc3d77yZouPcF","session_id":"4f4cd1bb-ca1b-49c0-a612-160336c885bd","uuid":"52422047-6f97-4ca0-a225-a9d11ed5228d","timestamp":"2026-05-07T13:55:36.636Z"}
