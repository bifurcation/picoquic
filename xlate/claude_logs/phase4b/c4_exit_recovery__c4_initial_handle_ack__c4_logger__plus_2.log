{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_012cnBB4A2DXwydCHZcSyfnT","type":"tool_result","content":"710\t\n711\t/* Enter cruise.\n712\t* CWIN is set C4_ALPHA_CRUISE of nominal value (98%?)\n713\t* Ack target if set to nominal cwin times log2 of cwin.\n714\t*/\n715\tstatic void c4_enter_cruise(\n716\t    picoquic_path_t* path_x,\n717\t    c4_state_t* c4_state)\n718\t{\n719\t    c4_era_reset(path_x, c4_state);\n720\t    c4_state->use_seed_cwin = 0;\n721\t\n722\t    if (c4_state->probe_level > C4_PROBE_LEVEL_DEFAULT) {\n723\t        c4_state->nb_cruise_left_before_push = 0;\n724\t    }\n725\t    else {\n726\t        if (c4_state->nb_cruise_left_before_push == 0) {\n727\t            c4_state->nb_cruise_left_before_push = (c4_state->probe_level == 0) ? 1 : C4_NB_CRUISE_BEFORE_PUSH;\n728\t        }     \n729\t    }\n730\t    c4_state->alpha_1024_current = C4_ALPHA_CRUISE_1024;\n731\t    if (path_x->smoothed_rtt < C4_MAX_RTT_MIN) {\n732\t        /* When operating in a CPU limited environment, pacing is too\n733\t         * conservative, and should be loosened. Ideally, we would detect\n734\t         * the CPU limited condition by comparing pacing rate and the actual\n735\t         * send rate, but that requires some amount of testing. In practice,\n736\t         * we have only tested this loosening in loopback tests, so we only\n737\t         * apply it if the RTT is below 1ms.\n738\t         */\n739\t        c4_state->alpha_1024_current += 48;\n740\t    }\n741\t    c4_state->alg_state = c4_cruising;\n742\t}\n743\t\n744\t/* Enter push.\n745\t*/\n746\tstatic void c4_enter_push(\n747\t    picoquic_path_t* path_x,\n748\t    c4_state_t* c4_state)\n749\t{\n750\t    c4_state->alpha_1024_current = c4_push_rate_by_probe_level[c4_state->probe_level];\n751\t    c4_state->push_alpha = c4_state->alpha_1024_current;\n752\t    c4_era_reset(path_x, c4_state);\n753\t    c4_state->alg_state = c4_pushing;\n754\t}\n755\t\n756\tvoid c4_update_min_max_rtt(picoquic_path_t* path_x, c4_state_t* c4_state)\n757\t{\n758\t    /* Include the last sample, to deal with order of arrivals between ACK and RTT */\n759\t    if (path_x->rtt_sample > c4_state->era_max_rtt) {\n760\t        c4_state->era_max_rtt = path_x->rtt_sample;\n761\t    }\n762\t    if (path_x->rtt_sample < c4_state->era_min_rtt) {\n763\t        c4_state->era_min_rtt = path_x->rtt_sample;\n764\t    }\n765\t    if (c4_state->alpha_1024_previous <= C4_ALPHA_NEUTRAL_1024) {\n766\t        /* Update the running min RTT, as the max RTT computation depends on it. */\n767\t        if (c4_state->era_min_rtt < c4_state->running_min_rtt) {\n768\t            c4_state->running_min_rtt = c4_state->era_min_rtt;\n769\t        }\n770\t        else {\n771\t            c4_state->running_min_rtt = (7 * c4_state->running_min_rtt + c4_state->era_min_rtt) / 8;\n772\t        }\n773\t\n774\t        /* We want to increase the max RTT, but we want to limit the jitter\n775\t         * measurement to avoid aberrant behavior.\n776\t         */\n777\t        uint64_t corrected_max = (c4_state->era_max_rtt < c4_state->running_min_rtt + C4_MAX_JITTER) ?\n778\t            c4_state->era_max_rtt : c4_state->running_min_rtt + C4_MAX_JITTER;\n779\t\n780\t        if (corrected_max > c4_state->nominal_max_rtt) {\n781\t            c4_state->nominal_max_rtt = corrected_max;\n782\t        }\n783\t        else {\n784\t            /* If not growing, slowly diminish the max rtt */\n785\t            c4_state->nominal_max_rtt = (7 * c4_state->nominal_max_rtt + corrected_max) / 8;\n786\t        }\n787\t        /* Recompute the delay threshold as the max RTT was updated. */\n788\t        c4_state->delay_threshold = c4_delay_threshold(c4_state);\n789\t    }\n790\t    else if (c4_state->nominal_max_rtt == 0) {\n791\t        /* Initialize the max RTT and the delay threshold. */\n792\t        c4_state->nominal_max_rtt = c4_state->era_max_rtt;\n793\t        c4_state->delay_threshold = c4_delay_threshold(c4_state);\n794\t    }\n795\t\n796\t    if (c4_state->nominal_max_rtt < C4_MAX_RTT_MIN) {\n797\t        c4_state->nominal_max_rtt = C4_MAX_RTT_MIN;\n798\t        c4_state->delay_threshold = c4_delay_threshold(c4_state);\n799\t    }\n800\t}\n801\t\n802\t/* Handle data ack event.\n803\t */\n804\tvoid c4_handle_ack(picoquic_path_t* path_x, c4_state_t* c4_state, picoquic_per_ack_state_t* ack_state)\n805\t{\n806\t    uint64_t previous_rate = c4_state->nominal_rate;\n807\t    uint64_t rate_measurement = 0;\n808\t\n809\t    if (ack_state->rtt_measurement > 0 && ack_state->nb_bytes_delivered_since_packet_sent > 0) {\n810\t\n811\t        rate_measurement = path_x->bandwidth_estimate;\n812\t        C4_LOGGER(path_x, rate_measurement, c4_state, ack_state, 0, 0);\n813\t\n814\t        /* Assessment of rate limited status */\n815\t        if (rate_measurement > c4_state->nominal_rate &&\n816\t            !(c4_state->alg_state == c4_recovery && c4_state->congestion_notified != 0)) {\n817\t            c4_state->push_was_not_limited = 1;\n818\t            c4_state->nominal_rate = rate_measurement;\n819\t            c4_state->delay_threshold = c4_delay_threshold(c4_state);\n820\t        }\n821\t        else {\n822\t            /* The ACK rate did not grow, but that's not a proof.\n823\t                * If the number of bytes sent are larger than the corrected bytes,\n824\t                * we know the delivery was slowed by the network, not the app.\n825\t                */\n826\t            uint64_t target_cwin = PICOQUIC_BYTES_FROM_RATE(c4_state->running_min_rtt, previous_rate);\n827\t            if (ack_state->nb_bytes_delivered_since_packet_sent > target_cwin) {\n828\t                c4_state->push_was_not_limited = 1;\n829\t            }\n830\t        }\n831\t    }\n832\t\n833\t    if (c4_state->alg_state == c4_initial) {\n834\t        c4_initial_handle_ack(path_x, c4_state, ack_state);\n835\t    }\n836\t    else {\n837\t        if (c4_era_check(path_x, c4_state)) {\n838\t            /* Update max rtt and running min rtt */\n839\t            c4_update_min_max_rtt(path_x, c4_state);\n840\t            /* The initial phase may have exited too early if we have both high jitter and competition\n841\t            * from other flows. Finding an RTT higher than the previous max is an indication that\n842\t            * the previous initial might have exited too soon, especially if the difference between\n843\t            * max RTT and min RTT is large. Reentering Initial remedies that.\n844\t            * However, reentering Initial is a bit of a hack. It is OK in the high jitter or\n845\t            * competition secnarios, but it can backfire and cause congestion and losses. So we don't\n846\t            * do that if the RTT is low (lower than 50ms) or if the data rate is high enough\n847\t            * (higher than 1Mbps, i.e., 8Mbps). And we only do that once per connection.\n848\t            */\n849\t            if (!c4_state->initial_after_jitter &&\n850\t                c4_state->nominal_max_rtt > 50000 &&\n851\t                c4_state->nominal_rate < 1000000 &&\n852\t                5 * c4_state->running_min_rtt < 2 * c4_state->nominal_max_rtt) {\n853\t                c4_state->initial_after_jitter = 1;\n854\t                c4_enter_initial(path_x, c4_state);\n855\t            }\n856\t            else\n857\t            {\n858\t                /* Manage the transition to the next state */\n859\t                switch (c4_state->alg_state) {\n860\t                case c4_recovery:\n861\t                    c4_exit_recovery(path_x, c4_state);\n862\t                    break;\n863\t                case c4_cruising:\n864\t                    if (c4_state->nb_cruise_left_before_push > 0) {\n865\t                        c4_state->nb_cruise_left_before_push--;\n866\t                    }\n867\t                    c4_era_reset(path_x, c4_state);\n868\t                    if (c4_state->nb_cruise_left_before_push <= 0 &&\n869\t                        path_x->last_time_acked_data_frame_sent > path_x->last_sender_limited_time) {\n870\t                        c4_enter_push(path_x, c4_state);\n871\t                    }\n872\t                    break;\n873\t                case c4_pushing:\n874\t                    c4_enter_recovery(path_x, c4_state, c4_congestion_none);\n875\t                    break;\n876\t                default:\n877\t                    c4_era_reset(path_x, c4_state);\n878\t                    break;\n879\t                }\n880\t            }\n881\t        }\n882\t    }\n883\t}\n884\t\n885\t/* Reaction to ECN/CE or sustained losses.\n886\t * This is more or less the same code as added to bbr.\n887\t * This code is called if an ECN/EC event is received, \n888\t * or a lost event indicating a high loss rate,\n889\t * or a delay event.\n890\t * \n891\t * TODO: proper treatment of ECN per L4S\n892\t */\n893\tstatic void c4_notify_congestion(\n894\t    picoquic_path_t* path_x,\n895\t    c4_state_t* c4_state,\n896\t    c4_congestion_t c_mode)\n897\t{\n898\t    uint64_t beta = C4_BETA_LOSS_1024;\n899\t    c4_state->congestion_notified = 1;\n900\t\n901\t    if (c_mode == c4_congestion_loss) {\n902\t        /* Make amount of slow down function of sensitivity,\n903\t        * for better fairness between C4 connections.\n904\t        */\n905\t        beta = (C4_BETA_LOSS_1024 + MULT1024(c4_sensitivity_1024(c4_state), C4_BETA_LOSS_1024))/2;\n906\t    }\n907\t    else if (c_mode == c4_congestion_ecn) {\n908\t        /* Apply proportional reduction.\n909\t         * The threshold value is a function of sensitivity, and thus the reduction\n910\t         * incorporates a sensitivity factor. There is no obvious need for\n911\t         * additional sensitivity related factors.\n912\t         */\n913\t        beta = (c4_state->ecn_alpha - c4_state->ecn_threshold) * 1024 / c4_state->ecn_threshold;\n914\t        if (beta > C4_BETA_LOSS_1024) {\n915\t            /* capping beta to the standard 1/4th. */\n916\t            beta = C4_BETA_LOSS_1024;\n917\t        }\n918\t    }\n919\t    \n920\t    if (c_mode == c4_congestion_delay) {\n921\t        /* TODO: we should really use bytes in flight! */\n922\t        beta = c4_state->recent_delay_excess*1024/c4_state->delay_threshold;\n923\t\n924\t        if (beta > C4_BETA_LOSS_1024) {\n925\t            /* capping beta to the standard 1/4th. */\n926\t            beta = C4_BETA_LOSS_1024;\n927\t        }\n928\t    }\n929\t    else {\n930\t        /* Clear the excess delay to avoid spurious delay measurements */\n931\t        c4_state->recent_delay_excess = 0;\n932\t    }\n933\t\n934\t\n935\t    if (c4_state->alg_state == c4_recovery) {\n936\t        if (c4_state->alpha_1024_current == C4_ALPHA_RECOVER_1024) {\n937\t            /* Congestion notification after entering recovery \n938\t             * indicates that queues are building up. It is thus\n939\t             * prudent to decrease \"alpha_current\" and to spend a bit\n940\t             * more time in recovery, to reduce these queues. */\n941\t            c4_state->alpha_1024_current = C4_ALPHA_RECOVER2_1024;\n942\t            c4_state->era_sequence = picoquic_cc_get_sequence_number(path_x->cnx, path_x);\n943\t            C4_LOGGER(path_x, 0, c4_state, NULL, beta, c_mode);\n944\t        }\n945\t        if (c_mode == c4_congestion_ecn) {\n946\t            c4_state->excess_ce_after_push = 1;\n947\t        }\n948\t    }\n949\t    else\n950\t    {\n951\t        if (c4_state->alg_state != c4_pushing) {\n952\t            c4_state->nominal_rate -= MULT1024(beta, c4_state->nominal_rate);\n953\t            if (c_mode == c4_congestion_loss) {\n954\t                c4_state->nominal_max_rtt -= MULT1024(beta, c4_state->nominal_max_rtt);\n955\t                if (c4_state->nominal_max_rtt < C4_MAX_RTT_MIN) {\n956\t                    c4_state->nominal_max_rtt = C4_MAX_RTT_MIN;\n957\t                }\n958\t                c4_state->delay_threshold = c4_delay_threshold(c4_state);\n959\t            }\n960\t            C4_LOGGER(path_x, 0, c4_state, NULL, beta, c_mode);\n961\t        }\n962\t        c4_enter_recovery(path_x, c4_state, c_mode);\n963\t    }\n964\t\n965\t    c4_apply_rate_and_cwin(path_x, c4_state);\n966\t\n967\t    path_x->is_ssthresh_initialized = 1;\n968\t}\n969\t\n970\t/* Update RTT:\n971\t* Maintain rtt_min, rtt_max, and rtt_min_stamp,\n972\t* as well as rtt_min_is_trusted and delay_threshold.\n973\t* Do not otherwise change the state.\n974\t */\n975\t\n976\tstatic void c4_update_rtt(\n977\t    c4_state_t* c4_state,\n978\t    uint64_t rtt_measurement)\n979\t{\n980\t    if (rtt_measurement > c4_state->era_max_rtt) {\n981\t        c4_state->era_max_rtt = rtt_measurement;\n982\t    }\n983\t    if (rtt_measurement < c4_state->era_min_rtt) {\n984\t        c4_state->era_min_rtt = rtt_measurement;\n985\t    }\n986\t    if (rtt_measurement < c4_state->running_min_rtt) {\n987\t        c4_state->running_min_rtt = rtt_measurement;\n988\t    }\n989\t    if (c4_state->nominal_max_rtt == 0) {\n990\t        c4_state->nominal_max_rtt = rtt_measurement;\n991\t        if (c4_state->nominal_max_rtt < C4_MAX_RTT_MIN) {\n992\t            c4_state->nominal_max_rtt = C4_MAX_RTT_MIN;\n993\t        }\n994\t        c4_state->delay_threshold = c4_delay_threshold(c4_state);\n995\t        c4_state->recent_delay_excess = 0;\n996\t    }\n997\t    else {\n998\t        uint64_t target_rtt = c4_state->nominal_max_rtt + c4_state->delay_threshold;\n999\t        if (rtt_measurement > target_rtt) {\n1000\t            c4_state->recent_delay_excess = rtt_measurement - target_rtt;\n1001\t        }\n1002\t        else {\n1003\t            c4_state->recent_delay_excess = 0;\n1004\t        }\n1005\t    }\n1006\t}\n1007\t\n1008\tstatic void c4_handle_rtt_excess(\n1009\t    picoquic_path_t* path_x,\n1010\t    c4_state_t* c4_state)\n1011\t{\n1012\t    if (c4_state->recent_delay_excess > 0 &&\n1013\t        c4_state->alpha_1024_previous > 1024) {\n1014\t        /* May well be congested */\n1015\t        c4_notify_congestion(path_x, c4_state, c4_congestion_delay);\n1016\t    }\n1017\t}\n1018\t\n1019\t/*\n1020\t * Properly implementing c4 requires managing a number of\n1021\t * signals, such as packet losses or acknowledgements. We attempt\n1022\t * to condensate all that in a single API, which could be shared\n1023\t * by many different congestion control algorithms.\n1024\t */\n1025\tvoid c4_notify(\n1026\t    picoquic_cnx_t* UNUSED(cnx), picoquic_path_t* path_x,\n1027\t    picoquic_congestion_notification_t notification,\n1028\t    picoquic_per_ack_state_t * ack_state,\n1029\t    uint64_t UNUSED(current_time))\n1030\t{\n1031\t    c4_state_t* c4_state = (c4_state_t*)path_x->congestion_alg_state;\n1032\t    path_x->is_cc_data_updated = 1;\n1033\t\n1034\t    if (ack_state != NULL && ack_state->pc != picoquic_packet_context_application) {\n1035\t        return;\n1036\t    }\n1037\t\n1038\t    if (c4_state != NULL) {\n1039\t        switch (notification) {\n1040\t        case picoquic_congestion_notification_acknowledgement:\n1041\t            c4_handle_ack(path_x, c4_state, ack_state);\n1042\t            c4_apply_rate_and_cwin(path_x, c4_state);\n1043\t            break;\n1044\t        case picoquic_congestion_notification_ecn_ec:\n1045\t            /* TODO: ECN is special? Implement the prague logic */\n1046\t            c4_state->ecn_threshold = c4_ecn_threshold(c4_state);\n1047\t            c4_update_ecn_alpha(path_x, c4_state);\n1048\t            if (c4_state->ecn_alpha > c4_state->ecn_threshold) {\n1049\t                if (c4_state->alg_state == c4_initial) {\n1050\t                    if (c4_state->recent_delay_excess > 0\n1051\t                        && c4_state->nb_eras_no_increase > 1\n1052\t                        && c4_state->push_rate_old >= c4_state->nominal_rate) {\n1053\t\n1054\t                        c4_exit_initial(path_x, c4_state);\n1055\t                    }\n1056\t                }\n1057\t                else {\n1058\t                    c4_notify_congestion(path_x, c4_state, c4_congestion_ecn);\n1059\t                }\n1060\t            }\n1061\t            break;\n1062\t        case picoquic_congestion_notification_repeat:\n1063\t            if (c4_state->alg_state == c4_recovery && ack_state->lost_packet_number < c4_state->era_sequence) {\n1064\t                /* Do not worry about loss of packets sent before entering recovery */\n1065\t                break;\n1066\t            }\n1067\t            c4_update_loss_rate(c4_state, ack_state->lost_packet_number);\n1068\t\n1069\t            if (c4_state->smoothed_drop_rate > c4_loss_threshold(c4_state)) {\n1070\t                if (c4_state->alg_state == c4_initial) {\n1071\t                    c4_initial_handle_loss(path_x, c4_state);\n1072\t                }\n1073\t                else {\n1074\t                    c4_notify_congestion(path_x, c4_state, c4_congestion_loss);\n1075\t                }\n1076\t            }\n1077\t            break;\n1078\t        case picoquic_congestion_notification_timeout:\n1079\t            /* Treat timeout as PTO: no impact on congestion control */\n1080\t            break;\n1081\t        case picoquic_congestion_notification_spurious_repeat:\n1082\t            /* Remove handling of spurious repeat, as it was tied to timeout */\n1083\t            break;\n1084\t        case picoquic_congestion_notification_rtt_measurement:\n1085\t            c4_update_rtt(c4_state, ack_state->rtt_measurement);\n1086\t            if (c4_state->alg_state == c4_initial) {\n1087\t                c4_initial_handle_rtt_excess(path_x, c4_state);\n1088\t                c4_apply_rate_and_cwin(path_x, c4_state);\n1089\t            }\n1090\t            else {\n1091\t                c4_handle_rtt_excess(path_x, c4_state);\n1092\t            }\n1093\t            break;\n1094\t        case picoquic_congestion_notification_lost_feedback:\n1095\t            break;\n1096\t        case picoquic_congestion_notification_cwin_blocked:\n1097\t            break;\n1098\t        case picoquic_congestion_notification_reset:\n1099\t            c4_reset(c4_state, path_x, c4_state->option_string);\n1100\t            break;\n1101\t        case picoquic_congestion_notification_seed_cwin:\n1102\t            c4_seed_cwin(c4_state, ack_state->nb_bytes_acknowledged);\n1103\t            break;\n1104\t        default:\n1105\t            /* ignore */\n1106\t            break;\n1107\t        }\n1108\t    }\n1109\t}\n1110\t\n1111\t/* Release the state of the congestion control algorithm */\n1112\tvoid c4_delete(picoquic_path_t* path_x)\n1113\t{\n1114\t    if (path_x->congestion_alg_state != NULL) {\n1115\t        free(path_x->congestion_alg_state);\n1116\t        path_x->congestion_alg_state = NULL;\n1117\t    }\n1118\t}\n1119\t\n1120\t/* Observe the state of congestion control */\n1121\tvoid c4_observe(picoquic_path_t* path_x, uint64_t* cc_state, uint64_t* cc_param)\n1122\t{\n1123\t    c4_state_t* c4_state = (c4_state_t*)path_x->congestion_alg_state;\n1124\t    *cc_state = (uint64_t)c4_state->alg_state;\n1125\t    *cc_param = c4_state->nominal_max_rtt;\n1126\t}\n1127\t\n1128\t/* Definition record for the C4 CC algorithm */\n1129\t#define C4_ID \"c4\" \n1130\t\n1131\tpicoquic_congestion_algorithm_t c4_algorithm_struct = {\n1132\t    C4_ID, PICOQUIC_CC_ALGO_NUMBER_C4, PICOQUIC_ECN_ECT_1,\n1133\t    c4_init,\n1134\t    c4_notify,\n1135\t    c4_delete,\n1136\t    c4_observe\n1137\t};\n1138\t\n1139\tpicoquic_congestion_algorithm_t* c4_algorithm = &c4_algorithm_struct;"}]},"parent_tool_use_id":null,"session_id":"4f4cd1bb-ca1b-49c0-a612-160336c885bd","uuid":"8396fa09-e60b-4951-9c30-fd9df5539043","timestamp":"2026-05-07T13:54:36.859Z","tool_use_result":{"type":"text","file":{"filePath":"/Users/richbarn/Projects/picoquic/picoquic/c4.c","content":"\n/* Enter cruise.\n* CWIN is set C4_ALPHA_CRUISE of nominal value (98%?)\n* Ack target if set to nominal cwin times log2 of cwin.\n*/\nstatic void c4_enter_cruise(\n    picoquic_path_t* path_x,\n    c4_state_t* c4_state)\n{\n    c4_era_reset(path_x, c4_state);\n    c4_state->use_seed_cwin = 0;\n\n    if (c4_state->probe_level > C4_PROBE_LEVEL_DEFAULT) {\n        c4_state->nb_cruise_left_before_push = 0;\n    }\n    else {\n        if (c4_state->nb_cruise_left_before_push == 0) {\n            c4_state->nb_cruise_left_before_push = (c4_state->probe_level == 0) ? 1 : C4_NB_CRUISE_BEFORE_PUSH;\n        }     \n    }\n    c4_state->alpha_1024_current = C4_ALPHA_CRUISE_1024;\n    if (path_x->smoothed_rtt < C4_MAX_RTT_MIN) {\n        /* When operating in a CPU limited environment, pacing is too\n         * conservative, and should be loosened. Ideally, we would detect\n         * the CPU limited condition by comparing pacing rate and the actual\n         * send rate, but that requires some amount of testing. In practice,\n         * we have only tested this loosening in loopback tests, so we only\n         * apply it if the RTT is below 1ms.\n         */\n        c4_state->alpha_1024_current += 48;\n    }\n    c4_state->alg_state = c4_cruising;\n}\n\n/* Enter push.\n*/\nstatic void c4_enter_push(\n    picoquic_path_t* path_x,\n    c4_state_t* c4_state)\n{\n    c4_state->alpha_1024_current = c4_push_rate_by_probe_level[c4_state->probe_level];\n    c4_state->push_alpha = c4_state->alpha_1024_current;\n    c4_era_reset(path_x, c4_state);\n    c4_state->alg_state = c4_pushing;\n}\n\nvoid c4_update_min_max_rtt(picoquic_path_t* path_x, c4_state_t* c4_state)\n{\n    /* Include the last sample, to deal with order of arrivals between ACK and RTT */\n    if (path_x->rtt_sample > c4_state->era_max_rtt) {\n        c4_state->era_max_rtt = path_x->rtt_sample;\n    }\n    if (path_x->rtt_sample < c4_state->era_min_rtt) {\n        c4_state->era_min_rtt = path_x->rtt_sample;\n    }\n    if (c4_state->alpha_1024_previous <= C4_ALPHA_NEUTRAL_1024) {\n        /* Update the running min RTT, as the max RTT computation depends on it. */\n        if (c4_state->era_min_rtt < c4_state->running_min_rtt) {\n            c4_state->running_min_rtt = c4_state->era_min_rtt;\n        }\n        else {\n            c4_state->running_min_rtt = (7 * c4_state->running_min_rtt + c4_state->era_min_rtt) / 8;\n        }\n\n        /* We want to increase the max RTT, but we want to limit the jitter\n         * measurement to avoid aberrant behavior.\n         */\n        uint64_t corrected_max = (c4_state->era_max_rtt < c4_state->running_min_rtt + C4_MAX_JITTER) ?\n            c4_state->era_max_rtt : c4_state->running_min_rtt + C4_MAX_JITTER;\n\n        if (corrected_max > c4_state->nominal_max_rtt) {\n            c4_state->nominal_max_rtt = corrected_max;\n        }\n        else {\n            /* If not growing, slowly diminish the max rtt */\n            c4_state->nominal_max_rtt = (7 * c4_state->nominal_max_rtt + corrected_max) / 8;\n        }\n        /* Recompute the delay threshold as the max RTT was updated. */\n        c4_state->delay_threshold = c4_delay_threshold(c4_state);\n    }\n    else if (c4_state->nominal_max_rtt == 0) {\n        /* Initialize the max RTT and the delay threshold. */\n        c4_state->nominal_max_rtt = c4_state->era_max_rtt;\n        c4_state->delay_threshold = c4_delay_threshold(c4_state);\n    }\n\n    if (c4_state->nominal_max_rtt < C4_MAX_RTT_MIN) {\n        c4_state->nominal_max_rtt = C4_MAX_RTT_MIN;\n        c4_state->delay_threshold = c4_delay_threshold(c4_state);\n    }\n}\n\n/* Handle data ack event.\n */\nvoid c4_handle_ack(picoquic_path_t* path_x, c4_state_t* c4_state, picoquic_per_ack_state_t* ack_state)\n{\n    uint64_t previous_rate = c4_state->nominal_rate;\n    uint64_t rate_measurement = 0;\n\n    if (ack_state->rtt_measurement > 0 && ack_state->nb_bytes_delivered_since_packet_sent > 0) {\n\n        rate_measurement = path_x->bandwidth_estimate;\n        C4_LOGGER(path_x, rate_measurement, c4_state, ack_state, 0, 0);\n\n        /* Assessment of rate limited status */\n        if (rate_measurement > c4_state->nominal_rate &&\n            !(c4_state->alg_state == c4_recovery && c4_state->congestion_notified != 0)) {\n            c4_state->push_was_not_limited = 1;\n            c4_state->nominal_rate = rate_measurement;\n            c4_state->delay_threshold = c4_delay_threshold(c4_state);\n        }\n        else {\n            /* The ACK rate did not grow, but that's not a proof.\n                * If the number of bytes sent are larger than the corrected bytes,\n                * we know the delivery was slowed by the network, not the app.\n                */\n            uint64_t target_cwin = PICOQUIC_BYTES_FROM_RATE(c4_state->running_min_rtt, previous_rate);\n            if (ack_state->nb_bytes_delivered_since_packet_sent > target_cwin) {\n                c4_state->push_was_not_limited = 1;\n            }\n        }\n    }\n\n    if (c4_state->alg_state == c4_initial) {\n        c4_initial_handle_ack(path_x, c4_state, ack_state);\n    }\n    else {\n        if (c4_era_check(path_x, c4_state)) {\n            /* Update max rtt and running min rtt */\n            c4_update_min_max_rtt(path_x, c4_state);\n            /* The initial phase may have exited too early if we have both high jitter and competition\n            * from other flows. Finding an RTT higher than the previous max is an indication that\n            * the previous initial might have exited too soon, especially if the difference between\n            * max RTT and min RTT is large. Reentering Initial remedies that.\n            * However, reentering Initial is a bit of a hack. It is OK in the high jitter or\n            * competition secnarios, but it can backfire and cause congestion and losses. So we don't\n            * do that if the RTT is low (lower than 50ms) or if the data rate is high enough\n            * (higher than 1Mbps, i.e., 8Mbps). And we only do that once per connection.\n            */\n            if (!c4_state->initial_after_jitter &&\n                c4_state->nominal_max_rtt > 50000 &&\n                c4_state->nominal_rate < 1000000 &&\n                5 * c4_state->running_min_rtt < 2 * c4_state->nominal_max_rtt) {\n                c4_state->initial_after_jitter = 1;\n                c4_enter_initial(path_x, c4_state);\n            }\n            else\n            {\n                /* Manage the transition to the next state */\n                switch (c4_state->alg_state) {\n                case c4_recovery:\n                    c4_exit_recovery(path_x, c4_state);\n                    break;\n                case c4_cruising:\n                    if (c4_state->nb_cruise_left_before_push > 0) {\n                        c4_state->nb_cruise_left_before_push--;\n                    }\n                    c4_era_reset(path_x, c4_state);\n                    if (c4_state->nb_cruise_left_before_push <= 0 &&\n                        path_x->last_time_acked_data_frame_sent > path_x->last_sender_limited_time) {\n                        c4_enter_push(path_x, c4_state);\n                    }\n                    break;\n                case c4_pushing:\n                    c4_enter_recovery(path_x, c4_state, c4_congestion_none);\n                    break;\n                default:\n                    c4_era_reset(path_x, c4_state);\n                    break;\n                }\n            }\n        }\n    }\n}\n\n/* Reaction to ECN/CE or sustained losses.\n * This is more or less the same code as added to bbr.\n * This code is called if an ECN/EC event is received, \n * or a lost event indicating a high loss rate,\n * or a delay event.\n * \n * TODO: proper treatment of ECN per L4S\n */\nstatic void c4_notify_congestion(\n    picoquic_path_t* path_x,\n    c4_state_t* c4_state,\n    c4_congestion_t c_mode)\n{\n    uint64_t beta = C4_BETA_LOSS_1024;\n    c4_state->congestion_notified = 1;\n\n    if (c_mode == c4_congestion_loss) {\n        /* Make amount of slow down function of sensitivity,\n        * for better fairness between C4 connections.\n        */\n        beta = (C4_BETA_LOSS_1024 + MULT1024(c4_sensitivity_1024(c4_state), C4_BETA_LOSS_1024))/2;\n    }\n    else if (c_mode == c4_congestion_ecn) {\n        /* Apply proportional reduction.\n         * The threshold value is a function of sensitivity, and thus the reduction\n         * incorporates a sensitivity factor. There is no obvious need for\n         * additional sensitivity related factors.\n         */\n        beta = (c4_state->ecn_alpha - c4_state->ecn_threshold) * 1024 / c4_state->ecn_threshold;\n        if (beta > C4_BETA_LOSS_1024) {\n            /* capping beta to the standard 1/4th. */\n            beta = C4_BETA_LOSS_1024;\n        }\n    }\n    \n    if (c_mode == c4_congestion_delay) {\n        /* TODO: we should really use bytes in flight! */\n        beta = c4_state->recent_delay_excess*1024/c4_state->delay_threshold;\n\n        if (beta > C4_BETA_LOSS_1024) {\n            /* capping beta to the standard 1/4th. */\n            beta = C4_BETA_LOSS_1024;\n        }\n    }\n    else {\n        /* Clear the excess delay to avoid spurious delay measurements */\n        c4_state->recent_delay_excess = 0;\n    }\n\n\n    if (c4_state->alg_state == c4_recovery) {\n        if (c4_state->alpha_1024_current == C4_ALPHA_RECOVER_1024) {\n            /* Congestion notification after entering recovery \n             * indicates that queues are building up. It is thus\n             * prudent to decrease \"alpha_current\" and to spend a bit\n             * more time in recovery, to reduce these queues. */\n            c4_state->alpha_1024_current = C4_ALPHA_RECOVER2_1024;\n            c4_state->era_sequence = picoquic_cc_get_sequence_number(path_x->cnx, path_x);\n            C4_LOGGER(path_x, 0, c4_state, NULL, beta, c_mode);\n        }\n        if (c_mode == c4_congestion_ecn) {\n            c4_state->excess_ce_after_push = 1;\n        }\n    }\n    else\n    {\n        if (c4_state->alg_state != c4_pushing) {\n            c4_state->nominal_rate -= MULT1024(beta, c4_state->nominal_rate);\n            if (c_mode == c4_congestion_loss) {\n                c4_state->nominal_max_rtt -= MULT1024(beta, c4_state->nominal_max_rtt);\n                if (c4_state->nominal_max_rtt < C4_MAX_RTT_MIN) {\n                    c4_state->nominal_max_rtt = C4_MAX_RTT_MIN;\n                }\n                c4_state->delay_threshold = c4_delay_threshold(c4_state);\n            }\n            C4_LOGGER(path_x, 0, c4_state, NULL, beta, c_mode);\n        }\n        c4_enter_recovery(path_x, c4_state, c_mode);\n    }\n\n    c4_apply_rate_and_cwin(path_x, c4_state);\n\n    path_x->is_ssthresh_initialized = 1;\n}\n\n/* Update RTT:\n* Maintain rtt_min, rtt_max, and rtt_min_stamp,\n* as well as rtt_min_is_trusted and delay_threshold.\n* Do not otherwise change the state.\n */\n\nstatic void c4_update_rtt(\n    c4_state_t* c4_state,\n    uint64_t rtt_measurement)\n{\n    if (rtt_measurement > c4_state->era_max_rtt) {\n        c4_state->era_max_rtt = rtt_measurement;\n    }\n    if (rtt_measurement < c4_state->era_min_rtt) {\n        c4_state->era_min_rtt = rtt_measurement;\n    }\n    if (rtt_measurement < c4_state->running_min_rtt) {\n        c4_state->running_min_rtt = rtt_measurement;\n    }\n    if (c4_state->nominal_max_rtt == 0) {\n        c4_state->nominal_max_rtt = rtt_measurement;\n        if (c4_state->nominal_max_rtt < C4_MAX_RTT_MIN) {\n            c4_state->nominal_max_rtt = C4_MAX_RTT_MIN;\n        }\n        c4_state->delay_threshold = c4_delay_threshold(c4_state);\n        c4_state->recent_delay_excess = 0;\n    }\n    else {\n        uint64_t target_rtt = c4_state->nominal_max_rtt + c4_state->delay_threshold;\n        if (rtt_measurement > target_rtt) {\n            c4_state->recent_delay_excess = rtt_measurement - target_rtt;\n        }\n        else {\n            c4_state->recent_delay_excess = 0;\n        }\n    }\n}\n\nstatic void c4_handle_rtt_excess(\n    picoquic_path_t* path_x,\n    c4_state_t* c4_state)\n{\n    if (c4_state->recent_delay_excess > 0 &&\n        c4_state->alpha_1024_previous > 1024) {\n        /* May well be congested */\n        c4_notify_congestion(path_x, c4_state, c4_congestion_delay);\n    }\n}\n\n/*\n * Properly implementing c4 requires managing a number of\n * signals, such as packet losses or acknowledgements. We attempt\n * to condensate all that in a single API, which could be shared\n * by many different congestion control algorithms.\n */\nvoid c4_notify(\n    picoquic_cnx_t* UNUSED(cnx), picoquic_path_t* path_x,\n    picoquic_congestion_notification_t notification,\n    picoquic_per_ack_state_t * ack_state,\n    uint64_t UNUSED(current_time))\n{\n    c4_state_t* c4_state = (c4_state_t*)path_x->congestion_alg_state;\n    path_x->is_cc_data_updated = 1;\n\n    if (ack_state != NULL && ack_state->pc != picoquic_packet_context_application) {\n        return;\n    }\n\n    if (c4_state != NULL) {\n        switch (notification) {\n        case picoquic_congestion_notification_acknowledgement:\n            c4_handle_ack(path_x, c4_state, ack_state);\n            c4_apply_rate_and_cwin(path_x, c4_state);\n            break;\n        case picoquic_congestion_notification_ecn_ec:\n            /* TODO: ECN is special? Implement the prague logic */\n            c4_state->ecn_threshold = c4_ecn_threshold(c4_state);\n            c4_update_ecn_alpha(path_x, c4_state);\n            if (c4_state->ecn_alpha > c4_state->ecn_threshold) {\n                if (c4_state->alg_state == c4_initial) {\n                    if (c4_state->recent_delay_excess > 0\n                        && c4_state->nb_eras_no_increase > 1\n                        && c4_state->push_rate_old >= c4_state->nominal_rate) {\n\n                        c4_exit_initial(path_x, c4_state);\n                    }\n                }\n                else {\n                    c4_notify_congestion(path_x, c4_state, c4_congestion_ecn);\n                }\n            }\n            break;\n        case picoquic_congestion_notification_repeat:\n            if (c4_state->alg_state == c4_recovery && ack_state->lost_packet_number < c4_state->era_sequence) {\n                /* Do not worry about loss of packets sent before entering recovery */\n                break;\n            }\n            c4_update_loss_rate(c4_state, ack_state->lost_packet_number);\n\n            if (c4_state->smoothed_drop_rate > c4_loss_threshold(c4_state)) {\n                if (c4_state->alg_state == c4_initial) {\n                    c4_initial_handle_loss(path_x, c4_state);\n                }\n                else {\n                    c4_notify_congestion(path_x, c4_state, c4_congestion_loss);\n                }\n            }\n            break;\n        case picoquic_congestion_notification_timeout:\n            /* Treat timeout as PTO: no impact on congestion control */\n            break;\n        case picoquic_congestion_notification_spurious_repeat:\n            /* Remove handling of spurious repeat, as it was tied to timeout */\n            break;\n        case picoquic_congestion_notification_rtt_measurement:\n            c4_update_rtt(c4_state, ack_state->rtt_measurement);\n            if (c4_state->alg_state == c4_initial) {\n                c4_initial_handle_rtt_excess(path_x, c4_state);\n                c4_apply_rate_and_cwin(path_x, c4_state);\n            }\n            else {\n                c4_handle_rtt_excess(path_x, c4_state);\n            }\n            break;\n        case picoquic_congestion_notification_lost_feedback:\n            break;\n        case picoquic_congestion_notification_cwin_blocked:\n            break;\n        case picoquic_congestion_notification_reset:\n            c4_reset(c4_state, path_x, c4_state->option_string);\n            break;\n        case picoquic_congestion_notification_seed_cwin:\n            c4_seed_cwin(c4_state, ack_state->nb_bytes_acknowledged);\n            break;\n        default:\n            /* ignore */\n            break;\n        }\n    }\n}\n\n/* Release the state of the congestion control algorithm */\nvoid c4_delete(picoquic_path_t* path_x)\n{\n    if (path_x->congestion_alg_state != NULL) {\n        free(path_x->congestion_alg_state);\n        path_x->congestion_alg_state = NULL;\n    }\n}\n\n/* Observe the state of congestion control */\nvoid c4_observe(picoquic_path_t* path_x, uint64_t* cc_state, uint64_t* cc_param)\n{\n    c4_state_t* c4_state = (c4_state_t*)path_x->congestion_alg_state;\n    *cc_state = (uint64_t)c4_state->alg_state;\n    *cc_param = c4_state->nominal_max_rtt;\n}\n\n/* Definition record for the C4 CC algorithm */\n#define C4_ID \"c4\" \n\npicoquic_congestion_algorithm_t c4_algorithm_struct = {\n    C4_ID, PICOQUIC_CC_ALGO_NUMBER_C4, PICOQUIC_ECN_ECT_1,\n    c4_init,\n    c4_notify,\n    c4_delete,\n    c4_observe\n};\n\npicoquic_congestion_algorithm_t* c4_algorithm = &c4_algorithm_struct;","numLines":430,"startLine":710,"totalLines":1140}}}
