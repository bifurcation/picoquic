{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01VX417PLY5NGiRuXS8ZFRBr","type":"tool_result","content":"1\t//! Translation of `picoquic/c4.c` — C4 congestion control.\n2\t\n3\tuse crate::cc_common::{ConnectionCc, PathCc, SMOOTHED_LOSS_FACTOR, SMOOTHED_LOSS_SCOPE};\n4\tuse crate::internal::{Connection, Path};\n5\tuse crate::{PacketContext, State};\n6\t\n7\t// ---------------------------------------------------------------------------\n8\t// Constants from c4.c `#define`s.\n9\t\n10\tconst C4_ALPHA_PUSH_LOW_1024: u64 = 1088; // C: C4_ALPHA_PUSH_LOW_1024 (106.25%)\n11\t/// Gain parameter for the ECN alpha EWMA: g = 1/2^4.  C: `C4_ECN_SHIFT_G`.\n12\tconst C4_ECN_SHIFT_G: u32 = 4;\n13\t/// Maximum delay threshold in microseconds (25 ms).  C: `C4_DELAY_THRESHOLD_MAX`.\n14\tconst C4_DELAY_THRESHOLD_MAX: u64 = 25_000;\n15\t/// Default probe level on entry to Initial.  C: `C4_PROBE_LEVEL_DEFAULT`.\n16\t#[allow(dead_code)]\n17\tconst C4_PROBE_LEVEL_DEFAULT: i32 = 1;\n18\t/// Alpha multiplier during Initial slow-start (200%).  C: `C4_ALPHA_INITIAL`.\n19\t#[allow(dead_code)]\n20\tconst C4_ALPHA_INITIAL: u64 = 2048;\n21\t/// Alpha multiplier during Recovery (93.75%).  C: `C4_ALPHA_RECOVER_1024`.\n22\t#[allow(dead_code)]\n23\tconst C4_ALPHA_RECOVER_1024: u64 = 960;\n24\t\n25\t// ---------------------------------------------------------------------------\n26\t// `MULT1024(c, v)` — fixed-point scale by c/1024.  C: `MULT1024`.\n27\t\n28\t#[inline]\n29\tfn mult1024(c: u64, v: u64) -> u64 {\n30\t    (v * c) >> 10\n31\t}\n32\t\n33\t// ---------------------------------------------------------------------------\n34\t// Algorithm-state enum.  C: `c4_alg_state_t`.\n35\t\n36\t#[derive(Debug, Copy, Clone, PartialEq, Eq, Default)]\n37\tpub enum C4AlgState {\n38\t    #[default]\n39\t    Initial = 0,\n40\t    Recovery,\n41\t    Cruising,\n42\t    Pushing,\n43\t}\n44\t\n45\t// ---------------------------------------------------------------------------\n46\t// Congestion-event discriminant.  C: `c4_congestion_t`.\n47\t\n48\t#[derive(Debug, Copy, Clone, PartialEq, Eq, Default)]\n49\tpub enum C4Congestion {\n50\t    #[default]\n51\t    None = 0,\n52\t    Delay,\n53\t    Ecn,\n54\t    Loss,\n55\t}\n56\t\n57\t// ---------------------------------------------------------------------------\n58\t// C4 algorithm state.  C: `c4_state_t` (picoquic/c4.c:143).\n59\t//\n60\t// Type deviations from C:\n61\t//   * single-bit `unsigned int x : 1` bitfields → `bool`\n62\t//   * `const char* option_string` → `Option<String>` (owned copy)\n63\t\n64\tpub struct C4State {\n65\t    pub alg_state: C4AlgState,\n66\t    pub nominal_rate: u64,\n67\t    pub nominal_max_rtt: u64,\n68\t    pub initial_cwnd: u64,\n69\t    pub running_min_rtt: u64,\n70\t    pub alpha_1024_current: u64,\n71\t    pub alpha_1024_previous: u64,\n72\t    pub nb_packets_in_startup: u64,\n73\t    pub era_sequence: u64,\n74\t    pub nb_cruise_left_before_push: u64,\n75\t    pub seed_cwin: u64,\n76\t    pub seed_rate: u64,\n77\t    pub probe_level: i32,\n78\t    pub nb_eras_no_increase: i32,\n79\t    pub push_rate_old: u64,\n80\t    pub push_alpha: u64,\n81\t    pub era_max_rtt: u64,\n82\t    pub era_min_rtt: u64,\n83\t    pub delay_threshold: u64,\n84\t    pub recent_delay_excess: u64,\n85\t    pub last_lost_packet_number: u64,\n86\t    pub smoothed_drop_rate: f64,\n87\t    pub ecn_alpha: u64,\n88\t    pub ecn_ect1: u64,\n89\t    pub ecn_ce: u64,\n90\t    pub ecn_threshold: u64,\n91\t    pub congestion_notified: bool,\n92\t    pub push_was_not_limited: bool,\n93\t    pub use_seed_cwin: bool,\n94\t    pub initial_after_jitter: bool,\n95\t    pub excess_ce_after_push: bool,\n96\t    pub option_string: Option<String>,\n97\t}\n98\t\n99\timpl C4State {\n100\t    /// C: `c4_sensitivity_1024` (picoquic/c4.c:244)\n101\t    ///\n102\t    /// Fixed-point sensitivity in [0, 1024] scaled to `nominal_rate`:\n103\t    /// 0 below 50 kbps, 1024 above 10 Mbps, linearly interpolated in between.\n104\t    fn sensitivity_1024(&self) -> u64 {\n105\t        if self.nominal_rate < 50_000 {\n106\t            0\n107\t        } else if self.nominal_rate > 10_000_000 {\n108\t            1024\n109\t        } else if self.nominal_rate < 1_000_000 {\n110\t            (self.nominal_rate - 50_000) * 963 / 950_000\n111\t        } else {\n112\t            963 + ((self.nominal_rate - 1_000_000) * 61 / 9_000_000)\n113\t        }\n114\t    }\n115\t\n116\t    /// C: `c4_growth_evaluate` (picoquic/c4.c:429)\n117\t    ///\n118\t    /// Returns `true` when the previous era produced meaningful throughput\n119\t    /// growth.  If `push_alpha` was large enough to measure reliably, growth\n120\t    /// is defined as exceeding the alpha-scaled old rate; otherwise it falls\n121\t    /// back to a simple rate comparison guarded by the absence of congestion.\n122\t    fn growth_evaluate(&self) -> bool {\n123\t        if self.push_alpha > C4_ALPHA_PUSH_LOW_1024 {\n124\t            let target_rate =\n125\t                (3 * self.push_rate_old + mult1024(self.push_alpha, self.push_rate_old)) / 4;\n126\t            self.nominal_rate > target_rate\n127\t        } else {\n128\t            self.nominal_rate > self.push_rate_old && !self.congestion_notified\n129\t        }\n130\t    }\n131\t\n132\t    /// C: `c4_growth_reset` (picoquic/c4.c:449)\n133\t    fn growth_reset(&mut self) {\n134\t        self.congestion_notified = false;\n135\t        self.push_was_not_limited = false;\n136\t        self.push_rate_old = self.nominal_rate;\n137\t        // push_alpha is reset to current alpha here; caller sets it to correct\n138\t        // value when entering push state.\n139\t        self.push_alpha = self.alpha_1024_current;\n140\t    }\n141\t\n142\t    /// C: `c4_set_options` (picoquic/c4.c:499)\n143\t    ///\n144\t    /// Parses `option_string` for recognized option characters.  No option\n145\t    /// characters are currently defined; the loop exits on the first unknown.\n146\t    fn set_options(&mut self) {\n147\t        if let Some(s) = self.option_string.as_deref() {\n148\t            // No recognized option characters are currently defined.  The C switch\n149\t            // hits `default: ended = 1` for every character, so the loop exits\n150\t            // immediately after consuming the first character.\n151\t            let _ = s.chars().next();\n152\t        }\n153\t    }\n154\t\n155\t    /// C: `c4_seed_cwin` (picoquic/c4.c:527)\n156\t    pub fn seed_cwin(&mut self, bytes_in_flight: u64) {\n157\t        if self.alg_state == C4AlgState::Initial {\n158\t            self.use_seed_cwin = true;\n159\t            self.seed_cwin = bytes_in_flight;\n160\t        }\n161\t    }\n162\t\n163\t    /// C: `c4_observe` (picoquic/c4.c:1121)\n164\t    ///\n165\t    /// Returns `(cc_state, cc_param)`: the algorithm-state discriminant and\n166\t    /// `nominal_max_rtt`, matching the C convention of filling two `uint64_t*`\n167\t    /// out-params.\n168\t    pub fn observe(&self) -> (u64, u64) {\n169\t        (self.alg_state as u64, self.nominal_max_rtt)\n170\t    }\n171\t\n172\t    /// C: `c4_update_loss_rate` (picoquic/c4.c:301)\n173\t    ///\n174\t    /// Advances the smoothed drop-rate EMA to account for packets up to and\n175\t    /// including `lost_packet_number`.  Each step between the last recorded\n176\t    /// loss and the new one decays the rate; the final step adds one loss\n177\t    /// event.  Steps beyond `SMOOTHED_LOSS_SCOPE` behind the new number are\n178\t    /// skipped to cap the decay loop.\n179\t    pub fn update_loss_rate(&mut self, lost_packet_number: u64) {\n180\t        let mut next_number = self.last_lost_packet_number;\n181\t\n182\t        if lost_packet_number > next_number {\n183\t            if next_number + SMOOTHED_LOSS_SCOPE < lost_packet_number {\n184\t                next_number = lost_packet_number - SMOOTHED_LOSS_SCOPE;\n185\t            }\n186\t\n187\t            while next_number < lost_packet_number {\n188\t                self.smoothed_drop_rate *= 1.0 - SMOOTHED_LOSS_FACTOR;\n189\t                next_number += 1;\n190\t            }\n191\t\n192\t            self.smoothed_drop_rate += (1.0 - self.smoothed_drop_rate) * SMOOTHED_LOSS_FACTOR;\n193\t            self.last_lost_packet_number = lost_packet_number;\n194\t        }\n195\t    }\n196\t\n197\t    /// ECN alpha EWMA core.  C: `c4_update_ecn_alpha` (picoquic/c4.c:321) body.\n198\t    ///\n199\t    /// Takes the current totals directly so the logic can be tested without\n200\t    /// constructing `Path` / `Connection`.  Called by `update_ecn_alpha`.\n201\t    fn ecn_alpha_update_counts(&mut self, ecn_ect1_remote: u64, ecn_ce_remote: u64) {\n202\t        let delta_ect1 = ecn_ect1_remote as i64 - self.ecn_ect1 as i64;\n203\t        let delta_ce = ecn_ce_remote as i64 - self.ecn_ce as i64;\n204\t\n205\t        self.ecn_ect1 = ecn_ect1_remote;\n206\t        self.ecn_ce = ecn_ce_remote;\n207\t\n208\t        if delta_ce > 0 || delta_ect1 > 0 {\n209\t            let sum = delta_ce + delta_ect1;\n210\t            let frac: u64 = if sum > 0 {\n211\t                ((delta_ce * 1024) / sum) as u64\n212\t            } else {\n213\t                0\n214\t            };\n215\t\n216\t            if frac > self.ecn_alpha && frac >= 512 {\n217\t                self.ecn_alpha = frac;\n218\t            } else {\n219\t                // EWMA: alpha = alpha*(1 - 1/2^shift) + frac*(1/2^shift)\n220\t                let alpha_shifted = (self.ecn_alpha << C4_ECN_SHIFT_G) - self.ecn_alpha + frac;\n221\t                self.ecn_alpha = alpha_shifted >> C4_ECN_SHIFT_G;\n222\t            }\n223\t        }\n224\t    }\n225\t\n226\t    /// C: `c4_delay_threshold` (picoquic/c4.c:266)\n227\t    ///\n228\t    /// Compute the delay threshold for declaring congestion.  Sensitivity\n229\t    /// is 0 at ≤ 50 kbps, 1024 at ≥ 10 Mbps, and linearly interpolated\n230\t    /// in between.  The resulting fraction scales `nominal_max_rtt`, giving\n231\t    /// a threshold in [64/1024 × rtt, 260/1024 × rtt], capped at\n232\t    /// [`C4_DELAY_THRESHOLD_MAX`] (25 ms).\n233\t    pub fn delay_threshold(&self) -> u64 {\n234\t        let sensitivity = self.sensitivity_1024();\n235\t        let fraction = 64 + mult1024(1024 - sensitivity, 196);\n236\t        let delay = mult1024(fraction, self.nominal_max_rtt);\n237\t        delay.min(C4_DELAY_THRESHOLD_MAX)\n238\t    }\n239\t\n240\t    /// C: `c4_update_ecn_alpha` (picoquic/c4.c:321)\n241\t    ///\n242\t    /// Selects the right packet context (path-scoped under multipath;\n243\t    /// connection application context otherwise) and delegates to\n244\t    /// `ecn_alpha_update_counts`.\n245\t    #[allow(dead_code)]\n246\t    pub(crate) fn update_ecn_alpha(&mut self, path_x: &Path, connection: &Connection) {\n247\t        let pkt_ctx = if connection.is_multipath_enabled {\n248\t            &path_x.pkt_ctx\n249\t        } else {\n250\t            &connection.pkt_ctx[PacketContext::Application as usize]\n251\t        };\n252\t        self.ecn_alpha_update_counts(pkt_ctx.ecn_ect1_total_remote, pkt_ctx.ecn_ce_total_remote);\n253\t    }\n254\t\n255\t    /// C: `c4_ecn_threshold` (picoquic/c4.c:281)\n256\t    ///\n257\t    /// Computes the ECN marking fraction (over 1024) above which a CE-mark\n258\t    /// event triggers congestion notification.  At low sensitivity the\n259\t    /// threshold is high (~192/1024 ≈ 18.75%); at maximum sensitivity it\n260\t    /// falls to ~96/1024 ≈ 9.375%.\n261\t    pub fn ecn_threshold(&self) -> u64 {\n262\t        let sensitivity = self.sensitivity_1024();\n263\t        192 - mult1024(sensitivity, 96)\n264\t    }\n265\t\n266\t    /// C: `c4_era_check` (picoquic/c4.c:463)\n267\t    ///\n268\t    /// Returns `true` when the current measurement era is complete: the\n269\t    /// connection must be in the Ready state, and the lowest unacknowledged\n270\t    /// sequence number must have advanced past `era_sequence`.\n271\t    #[allow(dead_code)]\n272\t    fn era_check(&self, path_x: &Path, connection: &Connection) -> bool {\n273\t        if connection.connection_state < State::Ready {\n274\t            return false;\n275\t        }\n276\t        path_x.lowest_not_ack() > self.era_sequence\n277\t    }\n278\t\n279\t    /// C: `c4_era_reset` (picoquic/c4.c:475)\n280\t    ///\n281\t    /// Begins a new measurement era: advances `era_sequence` to the current\n282\t    /// send sequence number, resets per-era RTT accumulators, snapshots\n283\t    /// `alpha_1024_current` into `alpha_1024_previous`, and updates the ECN\n284\t    /// alpha from the latest packet-context counters.\n285\t    #[allow(dead_code)]\n286\t    fn era_reset(&mut self, path_x: &Path, connection: &Connection) {\n287\t        self.era_sequence = connection.sequence_number(path_x);\n288\t        self.era_max_rtt = 0;\n289\t        self.era_min_rtt = u64::MAX;\n290\t        self.alpha_1024_previous = self.alpha_1024_current;\n291\t        self.update_ecn_alpha(path_x, connection);\n292\t    }\n293\t\n294\t    /// C: `c4_enter_initial` (picoquic/c4.c:486)\n295\t    ///\n296\t    /// Transitions to the Initial (slow-start) state: captures the current\n297\t    /// CWIN, sets probe level and alpha to their startup defaults, resets era\n298\t    /// and growth tracking, and zeroes the ECN alpha.\n299\t    #[allow(dead_code)]\n300\t    fn enter_initial(&mut self, path_x: &Path, connection: &Connection) {\n301\t        self.alg_state = C4AlgState::Initial;\n302\t        self.initial_cwnd = path_x.cwin;\n303\t        self.probe_level = C4_PROBE_LEVEL_DEFAULT;\n304\t        self.alpha_1024_current = C4_ALPHA_INITIAL;\n305\t        self.nb_packets_in_startup = 0;\n306\t        self.era_reset(path_x, connection);\n307\t        self.nb_eras_no_increase = 0;\n308\t        self.ecn_alpha = 0;\n309\t        self.growth_reset();\n310\t    }\n311\t\n312\t    /// C: `c4_enter_recovery` (picoquic/c4.c:649)\n313\t    ///\n314\t    /// Transitions to the Recovery state.  If entering from Initial, first\n315\t    /// calls `growth_reset` so the growth comparison starts from a clean\n316\t    /// baseline.  Multiple simultaneous congestion signals are collapsed: if\n317\t    /// already in Recovery this is a no-op.\n318\t    #[allow(dead_code)]\n319\t    fn enter_recovery(&mut self, path_x: &Path, connection: &Connection, c_mode: C4Congestion) {\n320\t        if self.alg_state == C4AlgState::Initial {\n321\t            self.growth_reset();\n322\t        }\n323\t        if self.alg_state != C4AlgState::Recovery {\n324\t            self.excess_ce_after_push = c_mode == C4Congestion::Ecn;\n325\t            self.alg_state = C4AlgState::Recovery;\n326\t            self.era_reset(path_x, connection);\n327\t            self.alpha_1024_current = C4_ALPHA_RECOVER_1024;\n328\t        }\n329\t    }\n330\t}\n331\t\n332\t#[cfg(test)]\n333\tmod tests {\n334\t    use super::*;\n335\t\n336\t    fn make_state() -> C4State {\n337\t        C4State {\n338\t            alg_state: C4AlgState::default(),\n339\t            nominal_rate: 0,\n340\t            nominal_max_rtt: 0,\n341\t            initial_cwnd: 0,\n342\t            running_min_rtt: 0,\n343\t            alpha_1024_current: 0,\n344\t            alpha_1024_previous: 0,\n345\t            nb_packets_in_startup: 0,\n346\t            era_sequence: 0,\n347\t            nb_cruise_left_before_push: 0,\n348\t            seed_cwin: 0,\n349\t            seed_rate: 0,\n350\t            probe_level: 0,\n351\t            nb_eras_no_increase: 0,\n352\t            push_rate_old: 0,\n353\t            push_alpha: 0,\n354\t            era_max_rtt: 0,\n355\t            era_min_rtt: 0,\n356\t            delay_threshold: 0,\n357\t            recent_delay_excess: 0,\n358\t            last_lost_packet_number: 0,\n359\t            smoothed_drop_rate: 0.0,\n360\t            ecn_alpha: 0,\n361\t            ecn_ect1: 0,\n362\t            ecn_ce: 0,\n363\t            ecn_threshold: 0,\n364\t            congestion_notified: false,\n365\t            push_was_not_limited: false,\n366\t            use_seed_cwin: false,\n367\t            initial_after_jitter: false,\n368\t            excess_ce_after_push: false,\n369\t            option_string: None,\n370\t        }\n371\t    }\n372\t\n373\t    #[test]\n374\t    fn growth_evaluate_high_alpha_growing() {\n375\t        let mut s = make_state();\n376\t        // push_alpha > 1088, push_rate_old = 1000, nominal_rate must exceed:\n377\t        // target = (3*1000 + MULT1024(1280, 1000)) / 4 = (3000 + 1250) / 4 = 1062\n378\t        s.push_alpha = 1280;\n379\t        s.push_rate_old = 1000;\n380\t        s.nominal_rate = 1100;\n381\t        assert!(s.growth_evaluate());\n382\t    }\n383\t\n384\t    #[test]\n385\t    fn growth_evaluate_high_alpha_not_growing() {\n386\t        let mut s = make_state();\n387\t        s.push_alpha = 1280;\n388\t        s.push_rate_old = 1000;\n389\t        s.nominal_rate = 1000; // equal to target_rate or below\n390\t        assert!(!s.growth_evaluate());\n391\t    }\n392\t\n393\t    #[test]\n394\t    fn growth_evaluate_low_alpha_growing_no_congestion() {\n395\t        let mut s = make_state();\n396\t        s.push_alpha = 1000; // <= 1088\n397\t        s.push_rate_old = 800;\n398\t        s.nominal_rate = 900;\n399\t        s.congestion_notified = false;\n400\t        assert!(s.growth_evaluate());\n401\t    }\n402\t\n403\t    #[test]\n404\t    fn growth_evaluate_low_alpha_congestion_blocks_growth() {\n405\t        let mut s = make_state();\n406\t        s.push_alpha = 1000;\n407\t        s.push_rate_old = 800;\n408\t        s.nominal_rate = 900;\n409\t        s.congestion_notified = true;\n410\t        assert!(!s.growth_evaluate());\n411\t    }\n412\t\n413\t    // --- sensitivity_1024 ---\n414\t\n415\t    #[test]\n416\t    fn sensitivity_below_50k() {\n417\t        let mut s = make_state();\n418\t        s.nominal_rate = 49_999;\n419\t        assert_eq!(s.sensitivity_1024(), 0);\n420\t    }\n421\t\n422\t    #[test]\n423\t    fn sensitivity_at_50k_boundary() {\n424\t        let mut s = make_state();\n425\t        s.nominal_rate = 50_000;\n426\t        // (50000 - 50000) * 963 / 950000 == 0\n427\t        assert_eq!(s.sensitivity_1024(), 0);\n428\t    }\n429\t\n430\t    #[test]\n431\t    fn sensitivity_midrange() {\n432\t        let mut s = make_state();\n433\t        s.nominal_rate = 500_000;\n434\t        // (500000 - 50000) * 963 / 950000 = 450000 * 963 / 950000 = 456\n435\t        assert_eq!(s.sensitivity_1024(), 456);\n436\t    }\n437\t\n438\t    #[test]\n439\t    fn sensitivity_at_1mbps() {\n440\t        let mut s = make_state();\n441\t        s.nominal_rate = 1_000_000;\n442\t        // hits else branch: 963 + (0 * 61 / 9000000) = 963\n443\t        assert_eq!(s.sensitivity_1024(), 963);\n444\t    }\n445\t\n446\t    #[test]\n447\t    fn sensitivity_at_10mbps() {\n448\t        let mut s = make_state();\n449\t        s.nominal_rate = 10_000_000;\n450\t        // 963 + (9000000 * 61 / 9000000) = 963 + 61 = 1024\n451\t        assert_eq!(s.sensitivity_1024(), 1024);\n452\t    }\n453\t\n454\t    #[test]\n455\t    fn sensitivity_above_10mbps() {\n456\t        let mut s = make_state();\n457\t        s.nominal_rate = 10_000_001;\n458\t        assert_eq!(s.sensitivity_1024(), 1024);\n459\t    }\n460\t\n461\t    // --- growth_reset ---\n462\t\n463\t    #[test]\n464\t    fn growth_reset_clears_flags_and_snapshots() {\n465\t        let mut s = make_state();\n466\t        s.nominal_rate = 5_000_000;\n467\t        s.alpha_1024_current = 1100;\n468\t        s.congestion_notified = true;\n469\t        s.push_was_not_limited = true;\n470\t        s.push_rate_old = 1_000_000;\n471\t        s.push_alpha = 900;\n472\t\n473\t        s.growth_reset();\n474\t\n475\t        assert!(!s.congestion_notified);\n476\t        assert!(!s.push_was_not_limited);\n477\t        assert_eq!(s.push_rate_old, 5_000_000);\n478\t        assert_eq!(s.push_alpha, 1100);\n479\t    }\n480\t\n481\t    // --- set_options ---\n482\t\n483\t    #[test]\n484\t    fn set_options_none_is_noop() {\n485\t        let mut s = make_state();\n486\t        s.option_string = None;\n487\t        s.set_options(); // must not panic\n488\t    }\n489\t\n490\t    #[test]\n491\t    fn set_options_unknown_chars_are_noop() {\n492\t        let mut s = make_state();\n493\t        s.option_string = Some(\"xyz\".to_owned());\n494\t        s.set_options(); // must not panic; no state change expected\n495\t    }\n496\t\n497\t    // --- seed_cwin ---\n498\t\n499\t    #[test]\n500\t    fn seed_cwin_sets_when_initial() {\n501\t        let mut s = make_state();\n502\t        s.alg_state = C4AlgState::Initial;\n503\t        s.seed_cwin(123_456);\n504\t        assert!(s.use_seed_cwin);\n505\t        assert_eq!(s.seed_cwin, 123_456);\n506\t    }\n507\t\n508\t    #[test]\n509\t    fn seed_cwin_ignored_when_not_initial() {\n510\t        let mut s = make_state();\n511\t        s.alg_state = C4AlgState::Cruising;\n512\t        s.seed_cwin(123_456);\n513\t        assert!(!s.use_seed_cwin);\n514\t        assert_eq!(s.seed_cwin, 0);\n515\t    }\n516\t\n517\t    // --- observe ---\n518\t\n519\t    #[test]\n520\t    fn observe_returns_state_and_rtt() {\n521\t        let mut s = make_state();\n522\t        s.alg_state = C4AlgState::Pushing;\n523\t        s.nominal_max_rtt = 42_000;\n524\t        let (cc_state, cc_param) = s.observe();\n525\t        assert_eq!(cc_state, C4AlgState::Pushing as u64);\n526\t        assert_eq!(cc_param, 42_000);\n527\t    }\n528\t\n529\t    #[test]\n530\t    fn observe_initial_state() {\n531\t        let s = make_state();\n532\t        let (cc_state, cc_param) = s.observe();\n533\t        assert_eq!(cc_state, 0); // C4AlgState::Initial == 0\n534\t        assert_eq!(cc_param, 0);\n535\t    }\n536\t\n537\t    // --- update_loss_rate ---\n538\t\n539\t    #[test]\n540\t    fn loss_rate_no_update_when_not_newer() {\n541\t        let mut s = make_state();\n542\t        s.last_lost_packet_number = 100;\n543\t        s.smoothed_drop_rate = 0.5;\n544\t        s.update_loss_rate(100); // same number → no change\n545\t        assert_eq!(s.smoothed_drop_rate, 0.5);\n546\t        assert_eq!(s.last_lost_packet_number, 100);\n547\t    }\n548\t\n549\t    #[test]\n550\t    fn loss_rate_single_step() {\n551\t        let mut s = make_state();\n552\t        s.last_lost_packet_number = 0;\n553\t        s.smoothed_drop_rate = 0.0;\n554\t        s.update_loss_rate(1);\n555\t        // one decay step: rate *= (1 - 1/16) = 0  (was 0)\n556\t        // then: rate += (1 - 0) * (1/16) = 1/16\n557\t        assert!((s.smoothed_drop_rate - 1.0 / 16.0).abs() < 1e-12);\n558\t        assert_eq!(s.last_lost_packet_number, 1);\n559\t    }\n560\t\n561\t    #[test]\n562\t    fn loss_rate_caps_scope() {\n563\t        let mut s = make_state();\n564\t        // Gap far exceeds SMOOTHED_LOSS_SCOPE=32; loop should start at\n565\t        // lost_packet_number - 32 so only 32 decays happen, not 1000.\n566\t        s.last_lost_packet_number = 0;\n567\t        s.smoothed_drop_rate = 1.0;\n568\t        s.update_loss_rate(1000);\n569\t        // After 32 decay steps: 1.0 * (15/16)^32 ≈ 0.1209\n570\t        // Then one more step adding the loss event:\n571\t        // result = decayed + (1 - decayed) * (1/16)\n572\t        let expected_decayed = (15.0f64 / 16.0).powi(32);\n573\t        let expected = expected_decayed + (1.0 - expected_decayed) * (1.0 / 16.0);\n574\t        assert!((s.smoothed_drop_rate - expected).abs() < 1e-9);\n575\t        assert_eq!(s.last_lost_packet_number, 1000);\n576\t    }\n577\t\n578\t    // --- ecn_threshold ---\n579\t\n580\t    #[test]\n581\t    fn ecn_threshold_zero_sensitivity() {\n582\t        let mut s = make_state();\n583\t        s.nominal_rate = 0; // sensitivity = 0\n584\t        // 192 - MULT1024(0, 96) = 192\n585\t        assert_eq!(s.ecn_threshold(), 192);\n586\t    }\n587\t\n588\t    #[test]\n589\t    fn ecn_threshold_max_sensitivity() {\n590\t        let mut s = make_state();\n591\t        s.nominal_rate = 10_000_001; // sensitivity = 1024\n592\t        // 192 - MULT1024(1024, 96) = 192 - 96 = 96\n593\t        assert_eq!(s.ecn_threshold(), 96);\n594\t    }\n595\t\n596\t    #[test]\n597\t    fn ecn_threshold_mid_sensitivity() {\n598\t        let mut s = make_state();\n599\t        s.nominal_rate = 1_000_000; // sensitivity = 963\n600\t        // 192 - MULT1024(963, 96) = 192 - ((96 * 963) >> 10) = 192 - 90 = 102\n601\t        let expected = 192 - ((96u64 * 963) >> 10);\n602\t        assert_eq!(s.ecn_threshold(), expected);\n603\t    }\n604\t\n605\t    // --- ecn_alpha_update_counts ---\n606\t\n607\t    #[test]\n608\t    fn ecn_alpha_no_update_when_both_zero_delta() {\n609\t        let mut s = make_state();\n610\t        s.ecn_alpha = 500;\n611\t        s.ecn_ect1 = 100;\n612\t        s.ecn_ce = 50;\n613\t        // same totals → no delta → alpha unchanged\n614\t        s.ecn_alpha_update_counts(100, 50);\n615\t        assert_eq!(s.ecn_alpha, 500);\n616\t    }\n617\t\n618\t    #[test]\n619\t    fn ecn_alpha_fast_path_large_frac() {\n620\t        let mut s = make_state();\n621\t        s.ecn_alpha = 400;\n622\t        s.ecn_ect1 = 0;\n623\t        s.ecn_ce = 0;\n624\t        // delta_ce = 600, delta_ect1 = 400 → frac = 600*1024/(600+400) = 614\n625\t        // frac (614) > alpha (400) and frac >= 512 → fast path: alpha = frac\n626\t        s.ecn_alpha_update_counts(400, 600);\n627\t        assert_eq!(s.ecn_alpha, 614);\n628\t    }\n629\t\n630\t    #[test]\n631\t    fn ecn_alpha_ewma_path() {\n632\t        let mut s = make_state();\n633\t        s.ecn_alpha = 256;\n634\t        s.ecn_ect1 = 0;\n635\t        s.ecn_ce = 0;\n636\t        // delta_ce = 100, delta_ect1 = 900 → frac = 100*1024/1000 = 102\n637\t        // frac (102) < alpha (256) → EWMA path\n638\t        // alpha_shifted = 256 * 16 - 256 + 102 = 256*15 + 102 = 3840 + 102 = 3942\n639\t        // new alpha = 3942 / 16 = 246\n640\t        s.ecn_alpha_update_counts(900, 100);\n641\t        assert_eq!(s.ecn_alpha, 246);\n642\t    }\n643\t\n644\t    #[test]\n645\t    fn ecn_alpha_only_ect1_delta() {\n646\t        let mut s = make_state();\n647\t        s.ecn_alpha = 200;\n648\t        s.ecn_ect1 = 0;\n649\t        s.ecn_ce = 0;\n650\t        // delta_ect1 = 500, delta_ce = 0 → frac = 0\n651\t        // frac (0) < alpha (200) → EWMA:\n652\t        //   alpha_shifted = 200 << 4 = 3200; 3200 - 200 = 3000; 3000 + 0 = 3000\n653\t        //   new alpha = 3000 >> 4 = 187\n654\t        s.ecn_alpha_update_counts(500, 0);\n655\t        assert_eq!(s.ecn_alpha, 187);\n656\t    }\n657\t}\n658\t"}]},"parent_tool_use_id":null,"session_id":"4f4cd1bb-ca1b-49c0-a612-160336c885bd","uuid":"4804e298-3028-4420-86aa-edbe2180c467","timestamp":"2026-05-07T13:54:30.565Z","tool_use_result":{"type":"text","file":{"filePath":"/Users/richbarn/Projects/picoquic/rs/fq/src/c4.rs","content":"//! Translation of `picoquic/c4.c` — C4 congestion control.\n\nuse crate::cc_common::{ConnectionCc, PathCc, SMOOTHED_LOSS_FACTOR, SMOOTHED_LOSS_SCOPE};\nuse crate::internal::{Connection, Path};\nuse crate::{PacketContext, State};\n\n// ---------------------------------------------------------------------------\n// Constants from c4.c `#define`s.\n\nconst C4_ALPHA_PUSH_LOW_1024: u64 = 1088; // C: C4_ALPHA_PUSH_LOW_1024 (106.25%)\n/// Gain parameter for the ECN alpha EWMA: g = 1/2^4.  C: `C4_ECN_SHIFT_G`.\nconst C4_ECN_SHIFT_G: u32 = 4;\n/// Maximum delay threshold in microseconds (25 ms).  C: `C4_DELAY_THRESHOLD_MAX`.\nconst C4_DELAY_THRESHOLD_MAX: u64 = 25_000;\n/// Default probe level on entry to Initial.  C: `C4_PROBE_LEVEL_DEFAULT`.\n#[allow(dead_code)]\nconst C4_PROBE_LEVEL_DEFAULT: i32 = 1;\n/// Alpha multiplier during Initial slow-start (200%).  C: `C4_ALPHA_INITIAL`.\n#[allow(dead_code)]\nconst C4_ALPHA_INITIAL: u64 = 2048;\n/// Alpha multiplier during Recovery (93.75%).  C: `C4_ALPHA_RECOVER_1024`.\n#[allow(dead_code)]\nconst C4_ALPHA_RECOVER_1024: u64 = 960;\n\n// ---------------------------------------------------------------------------\n// `MULT1024(c, v)` — fixed-point scale by c/1024.  C: `MULT1024`.\n\n#[inline]\nfn mult1024(c: u64, v: u64) -> u64 {\n    (v * c) >> 10\n}\n\n// ---------------------------------------------------------------------------\n// Algorithm-state enum.  C: `c4_alg_state_t`.\n\n#[derive(Debug, Copy, Clone, PartialEq, Eq, Default)]\npub enum C4AlgState {\n    #[default]\n    Initial = 0,\n    Recovery,\n    Cruising,\n    Pushing,\n}\n\n// ---------------------------------------------------------------------------\n// Congestion-event discriminant.  C: `c4_congestion_t`.\n\n#[derive(Debug, Copy, Clone, PartialEq, Eq, Default)]\npub enum C4Congestion {\n    #[default]\n    None = 0,\n    Delay,\n    Ecn,\n    Loss,\n}\n\n// ---------------------------------------------------------------------------\n// C4 algorithm state.  C: `c4_state_t` (picoquic/c4.c:143).\n//\n// Type deviations from C:\n//   * single-bit `unsigned int x : 1` bitfields → `bool`\n//   * `const char* option_string` → `Option<String>` (owned copy)\n\npub struct C4State {\n    pub alg_state: C4AlgState,\n    pub nominal_rate: u64,\n    pub nominal_max_rtt: u64,\n    pub initial_cwnd: u64,\n    pub running_min_rtt: u64,\n    pub alpha_1024_current: u64,\n    pub alpha_1024_previous: u64,\n    pub nb_packets_in_startup: u64,\n    pub era_sequence: u64,\n    pub nb_cruise_left_before_push: u64,\n    pub seed_cwin: u64,\n    pub seed_rate: u64,\n    pub probe_level: i32,\n    pub nb_eras_no_increase: i32,\n    pub push_rate_old: u64,\n    pub push_alpha: u64,\n    pub era_max_rtt: u64,\n    pub era_min_rtt: u64,\n    pub delay_threshold: u64,\n    pub recent_delay_excess: u64,\n    pub last_lost_packet_number: u64,\n    pub smoothed_drop_rate: f64,\n    pub ecn_alpha: u64,\n    pub ecn_ect1: u64,\n    pub ecn_ce: u64,\n    pub ecn_threshold: u64,\n    pub congestion_notified: bool,\n    pub push_was_not_limited: bool,\n    pub use_seed_cwin: bool,\n    pub initial_after_jitter: bool,\n    pub excess_ce_after_push: bool,\n    pub option_string: Option<String>,\n}\n\nimpl C4State {\n    /// C: `c4_sensitivity_1024` (picoquic/c4.c:244)\n    ///\n    /// Fixed-point sensitivity in [0, 1024] scaled to `nominal_rate`:\n    /// 0 below 50 kbps, 1024 above 10 Mbps, linearly interpolated in between.\n    fn sensitivity_1024(&self) -> u64 {\n        if self.nominal_rate < 50_000 {\n            0\n        } else if self.nominal_rate > 10_000_000 {\n            1024\n        } else if self.nominal_rate < 1_000_000 {\n            (self.nominal_rate - 50_000) * 963 / 950_000\n        } else {\n            963 + ((self.nominal_rate - 1_000_000) * 61 / 9_000_000)\n        }\n    }\n\n    /// C: `c4_growth_evaluate` (picoquic/c4.c:429)\n    ///\n    /// Returns `true` when the previous era produced meaningful throughput\n    /// growth.  If `push_alpha` was large enough to measure reliably, growth\n    /// is defined as exceeding the alpha-scaled old rate; otherwise it falls\n    /// back to a simple rate comparison guarded by the absence of congestion.\n    fn growth_evaluate(&self) -> bool {\n        if self.push_alpha > C4_ALPHA_PUSH_LOW_1024 {\n            let target_rate =\n                (3 * self.push_rate_old + mult1024(self.push_alpha, self.push_rate_old)) / 4;\n            self.nominal_rate > target_rate\n        } else {\n            self.nominal_rate > self.push_rate_old && !self.congestion_notified\n        }\n    }\n\n    /// C: `c4_growth_reset` (picoquic/c4.c:449)\n    fn growth_reset(&mut self) {\n        self.congestion_notified = false;\n        self.push_was_not_limited = false;\n        self.push_rate_old = self.nominal_rate;\n        // push_alpha is reset to current alpha here; caller sets it to correct\n        // value when entering push state.\n        self.push_alpha = self.alpha_1024_current;\n    }\n\n    /// C: `c4_set_options` (picoquic/c4.c:499)\n    ///\n    /// Parses `option_string` for recognized option characters.  No option\n    /// characters are currently defined; the loop exits on the first unknown.\n    fn set_options(&mut self) {\n        if let Some(s) = self.option_string.as_deref() {\n            // No recognized option characters are currently defined.  The C switch\n            // hits `default: ended = 1` for every character, so the loop exits\n            // immediately after consuming the first character.\n            let _ = s.chars().next();\n        }\n    }\n\n    /// C: `c4_seed_cwin` (picoquic/c4.c:527)\n    pub fn seed_cwin(&mut self, bytes_in_flight: u64) {\n        if self.alg_state == C4AlgState::Initial {\n            self.use_seed_cwin = true;\n            self.seed_cwin = bytes_in_flight;\n        }\n    }\n\n    /// C: `c4_observe` (picoquic/c4.c:1121)\n    ///\n    /// Returns `(cc_state, cc_param)`: the algorithm-state discriminant and\n    /// `nominal_max_rtt`, matching the C convention of filling two `uint64_t*`\n    /// out-params.\n    pub fn observe(&self) -> (u64, u64) {\n        (self.alg_state as u64, self.nominal_max_rtt)\n    }\n\n    /// C: `c4_update_loss_rate` (picoquic/c4.c:301)\n    ///\n    /// Advances the smoothed drop-rate EMA to account for packets up to and\n    /// including `lost_packet_number`.  Each step between the last recorded\n    /// loss and the new one decays the rate; the final step adds one loss\n    /// event.  Steps beyond `SMOOTHED_LOSS_SCOPE` behind the new number are\n    /// skipped to cap the decay loop.\n    pub fn update_loss_rate(&mut self, lost_packet_number: u64) {\n        let mut next_number = self.last_lost_packet_number;\n\n        if lost_packet_number > next_number {\n            if next_number + SMOOTHED_LOSS_SCOPE < lost_packet_number {\n                next_number = lost_packet_number - SMOOTHED_LOSS_SCOPE;\n            }\n\n            while next_number < lost_packet_number {\n                self.smoothed_drop_rate *= 1.0 - SMOOTHED_LOSS_FACTOR;\n                next_number += 1;\n            }\n\n            self.smoothed_drop_rate += (1.0 - self.smoothed_drop_rate) * SMOOTHED_LOSS_FACTOR;\n            self.last_lost_packet_number = lost_packet_number;\n        }\n    }\n\n    /// ECN alpha EWMA core.  C: `c4_update_ecn_alpha` (picoquic/c4.c:321) body.\n    ///\n    /// Takes the current totals directly so the logic can be tested without\n    /// constructing `Path` / `Connection`.  Called by `update_ecn_alpha`.\n    fn ecn_alpha_update_counts(&mut self, ecn_ect1_remote: u64, ecn_ce_remote: u64) {\n        let delta_ect1 = ecn_ect1_remote as i64 - self.ecn_ect1 as i64;\n        let delta_ce = ecn_ce_remote as i64 - self.ecn_ce as i64;\n\n        self.ecn_ect1 = ecn_ect1_remote;\n        self.ecn_ce = ecn_ce_remote;\n\n        if delta_ce > 0 || delta_ect1 > 0 {\n            let sum = delta_ce + delta_ect1;\n            let frac: u64 = if sum > 0 {\n                ((delta_ce * 1024) / sum) as u64\n            } else {\n                0\n            };\n\n            if frac > self.ecn_alpha && frac >= 512 {\n                self.ecn_alpha = frac;\n            } else {\n                // EWMA: alpha = alpha*(1 - 1/2^shift) + frac*(1/2^shift)\n                let alpha_shifted = (self.ecn_alpha << C4_ECN_SHIFT_G) - self.ecn_alpha + frac;\n                self.ecn_alpha = alpha_shifted >> C4_ECN_SHIFT_G;\n            }\n        }\n    }\n\n    /// C: `c4_delay_threshold` (picoquic/c4.c:266)\n    ///\n    /// Compute the delay threshold for declaring congestion.  Sensitivity\n    /// is 0 at ≤ 50 kbps, 1024 at ≥ 10 Mbps, and linearly interpolated\n    /// in between.  The resulting fraction scales `nominal_max_rtt`, giving\n    /// a threshold in [64/1024 × rtt, 260/1024 × rtt], capped at\n    /// [`C4_DELAY_THRESHOLD_MAX`] (25 ms).\n    pub fn delay_threshold(&self) -> u64 {\n        let sensitivity = self.sensitivity_1024();\n        let fraction = 64 + mult1024(1024 - sensitivity, 196);\n        let delay = mult1024(fraction, self.nominal_max_rtt);\n        delay.min(C4_DELAY_THRESHOLD_MAX)\n    }\n\n    /// C: `c4_update_ecn_alpha` (picoquic/c4.c:321)\n    ///\n    /// Selects the right packet context (path-scoped under multipath;\n    /// connection application context otherwise) and delegates to\n    /// `ecn_alpha_update_counts`.\n    #[allow(dead_code)]\n    pub(crate) fn update_ecn_alpha(&mut self, path_x: &Path, connection: &Connection) {\n        let pkt_ctx = if connection.is_multipath_enabled {\n            &path_x.pkt_ctx\n        } else {\n            &connection.pkt_ctx[PacketContext::Application as usize]\n        };\n        self.ecn_alpha_update_counts(pkt_ctx.ecn_ect1_total_remote, pkt_ctx.ecn_ce_total_remote);\n    }\n\n    /// C: `c4_ecn_threshold` (picoquic/c4.c:281)\n    ///\n    /// Computes the ECN marking fraction (over 1024) above which a CE-mark\n    /// event triggers congestion notification.  At low sensitivity the\n    /// threshold is high (~192/1024 ≈ 18.75%); at maximum sensitivity it\n    /// falls to ~96/1024 ≈ 9.375%.\n    pub fn ecn_threshold(&self) -> u64 {\n        let sensitivity = self.sensitivity_1024();\n        192 - mult1024(sensitivity, 96)\n    }\n\n    /// C: `c4_era_check` (picoquic/c4.c:463)\n    ///\n    /// Returns `true` when the current measurement era is complete: the\n    /// connection must be in the Ready state, and the lowest unacknowledged\n    /// sequence number must have advanced past `era_sequence`.\n    #[allow(dead_code)]\n    fn era_check(&self, path_x: &Path, connection: &Connection) -> bool {\n        if connection.connection_state < State::Ready {\n            return false;\n        }\n        path_x.lowest_not_ack() > self.era_sequence\n    }\n\n    /// C: `c4_era_reset` (picoquic/c4.c:475)\n    ///\n    /// Begins a new measurement era: advances `era_sequence` to the current\n    /// send sequence number, resets per-era RTT accumulators, snapshots\n    /// `alpha_1024_current` into `alpha_1024_previous`, and updates the ECN\n    /// alpha from the latest packet-context counters.\n    #[allow(dead_code)]\n    fn era_reset(&mut self, path_x: &Path, connection: &Connection) {\n        self.era_sequence = connection.sequence_number(path_x);\n        self.era_max_rtt = 0;\n        self.era_min_rtt = u64::MAX;\n        self.alpha_1024_previous = self.alpha_1024_current;\n        self.update_ecn_alpha(path_x, connection);\n    }\n\n    /// C: `c4_enter_initial` (picoquic/c4.c:486)\n    ///\n    /// Transitions to the Initial (slow-start) state: captures the current\n    /// CWIN, sets probe level and alpha to their startup defaults, resets era\n    /// and growth tracking, and zeroes the ECN alpha.\n    #[allow(dead_code)]\n    fn enter_initial(&mut self, path_x: &Path, connection: &Connection) {\n        self.alg_state = C4AlgState::Initial;\n        self.initial_cwnd = path_x.cwin;\n        self.probe_level = C4_PROBE_LEVEL_DEFAULT;\n        self.alpha_1024_current = C4_ALPHA_INITIAL;\n        self.nb_packets_in_startup = 0;\n        self.era_reset(path_x, connection);\n        self.nb_eras_no_increase = 0;\n        self.ecn_alpha = 0;\n        self.growth_reset();\n    }\n\n    /// C: `c4_enter_recovery` (picoquic/c4.c:649)\n    ///\n    /// Transitions to the Recovery state.  If entering from Initial, first\n    /// calls `growth_reset` so the growth comparison starts from a clean\n    /// baseline.  Multiple simultaneous congestion signals are collapsed: if\n    /// already in Recovery this is a no-op.\n    #[allow(dead_code)]\n    fn enter_recovery(&mut self, path_x: &Path, connection: &Connection, c_mode: C4Congestion) {\n        if self.alg_state == C4AlgState::Initial {\n            self.growth_reset();\n        }\n        if self.alg_state != C4AlgState::Recovery {\n            self.excess_ce_after_push = c_mode == C4Congestion::Ecn;\n            self.alg_state = C4AlgState::Recovery;\n            self.era_reset(path_x, connection);\n            self.alpha_1024_current = C4_ALPHA_RECOVER_1024;\n        }\n    }\n}\n\n#[cfg(test)]\nmod tests {\n    use super::*;\n\n    fn make_state() -> C4State {\n        C4State {\n            alg_state: C4AlgState::default(),\n            nominal_rate: 0,\n            nominal_max_rtt: 0,\n            initial_cwnd: 0,\n            running_min_rtt: 0,\n            alpha_1024_current: 0,\n            alpha_1024_previous: 0,\n            nb_packets_in_startup: 0,\n            era_sequence: 0,\n            nb_cruise_left_before_push: 0,\n            seed_cwin: 0,\n            seed_rate: 0,\n            probe_level: 0,\n            nb_eras_no_increase: 0,\n            push_rate_old: 0,\n            push_alpha: 0,\n            era_max_rtt: 0,\n            era_min_rtt: 0,\n            delay_threshold: 0,\n            recent_delay_excess: 0,\n            last_lost_packet_number: 0,\n            smoothed_drop_rate: 0.0,\n            ecn_alpha: 0,\n            ecn_ect1: 0,\n            ecn_ce: 0,\n            ecn_threshold: 0,\n            congestion_notified: false,\n            push_was_not_limited: false,\n            use_seed_cwin: false,\n            initial_after_jitter: false,\n            excess_ce_after_push: false,\n            option_string: None,\n        }\n    }\n\n    #[test]\n    fn growth_evaluate_high_alpha_growing() {\n        let mut s = make_state();\n        // push_alpha > 1088, push_rate_old = 1000, nominal_rate must exceed:\n        // target = (3*1000 + MULT1024(1280, 1000)) / 4 = (3000 + 1250) / 4 = 1062\n        s.push_alpha = 1280;\n        s.push_rate_old = 1000;\n        s.nominal_rate = 1100;\n        assert!(s.growth_evaluate());\n    }\n\n    #[test]\n    fn growth_evaluate_high_alpha_not_growing() {\n        let mut s = make_state();\n        s.push_alpha = 1280;\n        s.push_rate_old = 1000;\n        s.nominal_rate = 1000; // equal to target_rate or below\n        assert!(!s.growth_evaluate());\n    }\n\n    #[test]\n    fn growth_evaluate_low_alpha_growing_no_congestion() {\n        let mut s = make_state();\n        s.push_alpha = 1000; // <= 1088\n        s.push_rate_old = 800;\n        s.nominal_rate = 900;\n        s.congestion_notified = false;\n        assert!(s.growth_evaluate());\n    }\n\n    #[test]\n    fn growth_evaluate_low_alpha_congestion_blocks_growth() {\n        let mut s = make_state();\n        s.push_alpha = 1000;\n        s.push_rate_old = 800;\n        s.nominal_rate = 900;\n        s.congestion_notified = true;\n        assert!(!s.growth_evaluate());\n    }\n\n    // --- sensitivity_1024 ---\n\n    #[test]\n    fn sensitivity_below_50k() {\n        let mut s = make_state();\n        s.nominal_rate = 49_999;\n        assert_eq!(s.sensitivity_1024(), 0);\n    }\n\n    #[test]\n    fn sensitivity_at_50k_boundary() {\n        let mut s = make_state();\n        s.nominal_rate = 50_000;\n        // (50000 - 50000) * 963 / 950000 == 0\n        assert_eq!(s.sensitivity_1024(), 0);\n    }\n\n    #[test]\n    fn sensitivity_midrange() {\n        let mut s = make_state();\n        s.nominal_rate = 500_000;\n        // (500000 - 50000) * 963 / 950000 = 450000 * 963 / 950000 = 456\n        assert_eq!(s.sensitivity_1024(), 456);\n    }\n\n    #[test]\n    fn sensitivity_at_1mbps() {\n        let mut s = make_state();\n        s.nominal_rate = 1_000_000;\n        // hits else branch: 963 + (0 * 61 / 9000000) = 963\n        assert_eq!(s.sensitivity_1024(), 963);\n    }\n\n    #[test]\n    fn sensitivity_at_10mbps() {\n        let mut s = make_state();\n        s.nominal_rate = 10_000_000;\n        // 963 + (9000000 * 61 / 9000000) = 963 + 61 = 1024\n        assert_eq!(s.sensitivity_1024(), 1024);\n    }\n\n    #[test]\n    fn sensitivity_above_10mbps() {\n        let mut s = make_state();\n        s.nominal_rate = 10_000_001;\n        assert_eq!(s.sensitivity_1024(), 1024);\n    }\n\n    // --- growth_reset ---\n\n    #[test]\n    fn growth_reset_clears_flags_and_snapshots() {\n        let mut s = make_state();\n        s.nominal_rate = 5_000_000;\n        s.alpha_1024_current = 1100;\n        s.congestion_notified = true;\n        s.push_was_not_limited = true;\n        s.push_rate_old = 1_000_000;\n        s.push_alpha = 900;\n\n        s.growth_reset();\n\n        assert!(!s.congestion_notified);\n        assert!(!s.push_was_not_limited);\n        assert_eq!(s.push_rate_old, 5_000_000);\n        assert_eq!(s.push_alpha, 1100);\n    }\n\n    // --- set_options ---\n\n    #[test]\n    fn set_options_none_is_noop() {\n        let mut s = make_state();\n        s.option_string = None;\n        s.set_options(); // must not panic\n    }\n\n    #[test]\n    fn set_options_unknown_chars_are_noop() {\n        let mut s = make_state();\n        s.option_string = Some(\"xyz\".to_owned());\n        s.set_options(); // must not panic; no state change expected\n    }\n\n    // --- seed_cwin ---\n\n    #[test]\n    fn seed_cwin_sets_when_initial() {\n        let mut s = make_state();\n        s.alg_state = C4AlgState::Initial;\n        s.seed_cwin(123_456);\n        assert!(s.use_seed_cwin);\n        assert_eq!(s.seed_cwin, 123_456);\n    }\n\n    #[test]\n    fn seed_cwin_ignored_when_not_initial() {\n        let mut s = make_state();\n        s.alg_state = C4AlgState::Cruising;\n        s.seed_cwin(123_456);\n        assert!(!s.use_seed_cwin);\n        assert_eq!(s.seed_cwin, 0);\n    }\n\n    // --- observe ---\n\n    #[test]\n    fn observe_returns_state_and_rtt() {\n        let mut s = make_state();\n        s.alg_state = C4AlgState::Pushing;\n        s.nominal_max_rtt = 42_000;\n        let (cc_state, cc_param) = s.observe();\n        assert_eq!(cc_state, C4AlgState::Pushing as u64);\n        assert_eq!(cc_param, 42_000);\n    }\n\n    #[test]\n    fn observe_initial_state() {\n        let s = make_state();\n        let (cc_state, cc_param) = s.observe();\n        assert_eq!(cc_state, 0); // C4AlgState::Initial == 0\n        assert_eq!(cc_param, 0);\n    }\n\n    // --- update_loss_rate ---\n\n    #[test]\n    fn loss_rate_no_update_when_not_newer() {\n        let mut s = make_state();\n        s.last_lost_packet_number = 100;\n        s.smoothed_drop_rate = 0.5;\n        s.update_loss_rate(100); // same number → no change\n        assert_eq!(s.smoothed_drop_rate, 0.5);\n        assert_eq!(s.last_lost_packet_number, 100);\n    }\n\n    #[test]\n    fn loss_rate_single_step() {\n        let mut s = make_state();\n        s.last_lost_packet_number = 0;\n        s.smoothed_drop_rate = 0.0;\n        s.update_loss_rate(1);\n        // one decay step: rate *= (1 - 1/16) = 0  (was 0)\n        // then: rate += (1 - 0) * (1/16) = 1/16\n        assert!((s.smoothed_drop_rate - 1.0 / 16.0).abs() < 1e-12);\n        assert_eq!(s.last_lost_packet_number, 1);\n    }\n\n    #[test]\n    fn loss_rate_caps_scope() {\n        let mut s = make_state();\n        // Gap far exceeds SMOOTHED_LOSS_SCOPE=32; loop should start at\n        // lost_packet_number - 32 so only 32 decays happen, not 1000.\n        s.last_lost_packet_number = 0;\n        s.smoothed_drop_rate = 1.0;\n        s.update_loss_rate(1000);\n        // After 32 decay steps: 1.0 * (15/16)^32 ≈ 0.1209\n        // Then one more step adding the loss event:\n        // result = decayed + (1 - decayed) * (1/16)\n        let expected_decayed = (15.0f64 / 16.0).powi(32);\n        let expected = expected_decayed + (1.0 - expected_decayed) * (1.0 / 16.0);\n        assert!((s.smoothed_drop_rate - expected).abs() < 1e-9);\n        assert_eq!(s.last_lost_packet_number, 1000);\n    }\n\n    // --- ecn_threshold ---\n\n    #[test]\n    fn ecn_threshold_zero_sensitivity() {\n        let mut s = make_state();\n        s.nominal_rate = 0; // sensitivity = 0\n        // 192 - MULT1024(0, 96) = 192\n        assert_eq!(s.ecn_threshold(), 192);\n    }\n\n    #[test]\n    fn ecn_threshold_max_sensitivity() {\n        let mut s = make_state();\n        s.nominal_rate = 10_000_001; // sensitivity = 1024\n        // 192 - MULT1024(1024, 96) = 192 - 96 = 96\n        assert_eq!(s.ecn_threshold(), 96);\n    }\n\n    #[test]\n    fn ecn_threshold_mid_sensitivity() {\n        let mut s = make_state();\n        s.nominal_rate = 1_000_000; // sensitivity = 963\n        // 192 - MULT1024(963, 96) = 192 - ((96 * 963) >> 10) = 192 - 90 = 102\n        let expected = 192 - ((96u64 * 963) >> 10);\n        assert_eq!(s.ecn_threshold(), expected);\n    }\n\n    // --- ecn_alpha_update_counts ---\n\n    #[test]\n    fn ecn_alpha_no_update_when_both_zero_delta() {\n        let mut s = make_state();\n        s.ecn_alpha = 500;\n        s.ecn_ect1 = 100;\n        s.ecn_ce = 50;\n        // same totals → no delta → alpha unchanged\n        s.ecn_alpha_update_counts(100, 50);\n        assert_eq!(s.ecn_alpha, 500);\n    }\n\n    #[test]\n    fn ecn_alpha_fast_path_large_frac() {\n        let mut s = make_state();\n        s.ecn_alpha = 400;\n        s.ecn_ect1 = 0;\n        s.ecn_ce = 0;\n        // delta_ce = 600, delta_ect1 = 400 → frac = 600*1024/(600+400) = 614\n        // frac (614) > alpha (400) and frac >= 512 → fast path: alpha = frac\n        s.ecn_alpha_update_counts(400, 600);\n        assert_eq!(s.ecn_alpha, 614);\n    }\n\n    #[test]\n    fn ecn_alpha_ewma_path() {\n        let mut s = make_state();\n        s.ecn_alpha = 256;\n        s.ecn_ect1 = 0;\n        s.ecn_ce = 0;\n        // delta_ce = 100, delta_ect1 = 900 → frac = 100*1024/1000 = 102\n        // frac (102) < alpha (256) → EWMA path\n        // alpha_shifted = 256 * 16 - 256 + 102 = 256*15 + 102 = 3840 + 102 = 3942\n        // new alpha = 3942 / 16 = 246\n        s.ecn_alpha_update_counts(900, 100);\n        assert_eq!(s.ecn_alpha, 246);\n    }\n\n    #[test]\n    fn ecn_alpha_only_ect1_delta() {\n        let mut s = make_state();\n        s.ecn_alpha = 200;\n        s.ecn_ect1 = 0;\n        s.ecn_ce = 0;\n        // delta_ect1 = 500, delta_ce = 0 → frac = 0\n        // frac (0) < alpha (200) → EWMA:\n        //   alpha_shifted = 200 << 4 = 3200; 3200 - 200 = 3000; 3000 + 0 = 3000\n        //   new alpha = 3000 >> 4 = 187\n        s.ecn_alpha_update_counts(500, 0);\n        assert_eq!(s.ecn_alpha, 187);\n    }\n}\n","numLines":658,"startLine":1,"totalLines":658}}}
