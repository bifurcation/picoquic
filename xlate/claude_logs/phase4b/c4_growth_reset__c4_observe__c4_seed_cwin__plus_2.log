{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01UaRERFS644uQAaSq4rtnmf","type":"tool_result","content":"240\t* - 1MB/s: (1-0.03/0.5) = 0.94, approximate to 963/1024\n241\t* - 10MB/s: 1\n242\t*/\n243\t\n244\tstatic uint64_t c4_sensitivity_1024(c4_state_t* c4_state)\n245\t{\n246\t    uint64_t sensitivity = 1024;\n247\t    if (c4_state->nominal_rate < 50000) {\n248\t        sensitivity = 0;\n249\t    }\n250\t    else if (c4_state->nominal_rate > 10000000) {\n251\t        sensitivity = 1024;\n252\t    }\n253\t    else if (c4_state->nominal_rate < 1000000) {\n254\t        sensitivity = (c4_state->nominal_rate - 50000) * 963 / 950000;\n255\t    }\n256\t    else {\n257\t        sensitivity = 963 + ((c4_state->nominal_rate - 1000000) * 61 / 9000000);\n258\t    }\n259\t    return sensitivity;\n260\t}\n261\t\n262\t/* Compute the delay threshold for declaring congestion,\n263\t* as the min of RTT/8 and c4_DELAY_THRESHOLD_MAX (25 ms) \n264\t */\n265\t\n266\tuint64_t c4_delay_threshold(c4_state_t* c4_state)\n267\t{\n268\t    uint64_t sensitivity = c4_sensitivity_1024(c4_state);\n269\t    uint64_t fraction = 64 + MULT1024(1024 - sensitivity, 196);\n270\t    uint64_t delay = MULT1024(fraction, c4_state->nominal_max_rtt);\n271\t    if (delay > C4_DELAY_THRESHOLD_MAX) {\n272\t        delay = C4_DELAY_THRESHOLD_MAX;\n273\t    }\n274\t    return delay;\n275\t}\n276\t\n277\t/* Compute the ECNmarking threshold for declaring a congestion event.\n278\t* The marking threshold should be large if the sensitivity is small --\n279\t* maybe 25%, and smaller if the sensitivity is large -- maybe 12.5%.\n280\t*/\n281\tuint64_t c4_ecn_threshold(c4_state_t* c4_state)\n282\t{\n283\t    uint64_t sensitivity = c4_sensitivity_1024(c4_state);\n284\t\n285\t    uint64_t ecn_threshold = 192 - MULT1024(sensitivity, 96);\n286\t\n287\t    return ecn_threshold;\n288\t}\n289\t\n290\t/* Compute the loss rate threshold for declaring a congestion event\n291\t*/\n292\tdouble c4_loss_threshold(c4_state_t* c4_state)\n293\t{\n294\t    uint64_t sensitivity = c4_sensitivity_1024(c4_state);\n295\t    double fraction = ((double)sensitivity) / 1024.0;\n296\t    double loss_threshold = 0.02 + 0.50 * (1-fraction);\n297\t\n298\t    return loss_threshold;\n299\t}\n300\t\n301\t/* Compute the loss rate */\n302\tvoid c4_update_loss_rate(c4_state_t * c4_state, uint64_t lost_packet_number)\n303\t{\n304\t    uint64_t next_number = c4_state->last_lost_packet_number;\n305\t\n306\t    if (lost_packet_number > next_number) {\n307\t        if (next_number + PICOQUIC_SMOOTHED_LOSS_SCOPE < lost_packet_number) {\n308\t            next_number = lost_packet_number - PICOQUIC_SMOOTHED_LOSS_SCOPE;\n309\t        }\n310\t\n311\t        while (next_number < lost_packet_number) {\n312\t            c4_state->smoothed_drop_rate *= (1.0 - PICOQUIC_SMOOTHED_LOSS_FACTOR);\n313\t            next_number++;\n314\t        }\n315\t\n316\t        c4_state->smoothed_drop_rate += (1.0 - c4_state->smoothed_drop_rate) * PICOQUIC_SMOOTHED_LOSS_FACTOR;\n317\t        c4_state->last_lost_packet_number = lost_packet_number;\n318\t    }\n319\t}\n320\t\n321\t/* Compute the ECN alpha\n322\t*\n323\t* This is similar the prague implementation.\n324\t*/\n325\tstatic void c4_update_ecn_alpha(picoquic_path_t* path_x, c4_state_t* c4_state)\n326\t{\n327\t    uint64_t frac = 0;\n328\t    picoquic_packet_context_t* pkt_ctx = (path_x->cnx->is_multipath_enabled)?\n329\t        &path_x->pkt_ctx : &path_x->cnx->pkt_ctx[picoquic_packet_context_application];\n330\t    int64_t delta_ect1 = pkt_ctx->ecn_ect1_total_remote - c4_state->ecn_ect1;\n331\t    int64_t delta_ce = pkt_ctx->ecn_ce_total_remote - c4_state->ecn_ce;\n332\t\n333\t    c4_state->ecn_ect1 = pkt_ctx->ecn_ect1_total_remote;\n334\t    c4_state->ecn_ce = pkt_ctx->ecn_ce_total_remote;\n335\t\n336\t    if (delta_ce > 0 || delta_ect1 > 0) {\n337\t        frac = (delta_ce * 1024) / (delta_ce + delta_ect1);\n338\t\n339\t        if (frac > c4_state->ecn_alpha && frac >= 512) {\n340\t            c4_state->ecn_alpha = frac;\n341\t        }\n342\t        else\n343\t        {\n344\t            uint64_t alpha_shifted = c4_state->ecn_alpha << C4_ECN_SHIFT_G;\n345\t            alpha_shifted -= c4_state->ecn_alpha;\n346\t            alpha_shifted += frac;\n347\t            c4_state->ecn_alpha = alpha_shifted >> C4_ECN_SHIFT_G;\n348\t        }\n349\t    }\n350\t}\n351\t\n352\t/*\n353\t* c4_apply_rate_and_cwin:\n354\t* Manage all setting of the actual cwin, pacing rate and quantum\n355\t* at a single place, based on the state parameters computed\n356\t* in the other functions.\n357\t*/\n358\t\n359\tstatic void c4_apply_rate_and_cwin(\n360\t    picoquic_path_t* path_x,\n361\t    c4_state_t* c4_state)\n362\t{\n363\t\n364\t    uint64_t pacing_rate = MULT1024(c4_state->alpha_1024_current, c4_state->nominal_rate);\n365\t    uint64_t quantum;\n366\t    uint64_t target_cwin = PICOQUIC_CWIN_INITIAL;\n367\t    if (c4_state->nominal_max_rtt != 0 && c4_state->nominal_rate != 0) {\n368\t        target_cwin = PICOQUIC_BYTES_FROM_RATE(c4_state->nominal_max_rtt, pacing_rate);\n369\t    }\n370\t\n371\t    if (c4_state->alg_state == c4_initial) {\n372\t        if (target_cwin < c4_state->initial_cwnd) {\n373\t            target_cwin = c4_state->initial_cwnd;\n374\t        }\n375\t        /* Initial special case: bandwidth discovery */\n376\t        if (c4_state->nb_packets_in_startup > 0) {\n377\t            if (path_x->peak_bandwidth_estimate > pacing_rate) {\n378\t                uint64_t min_win;\n379\t                pacing_rate = (pacing_rate + path_x->peak_bandwidth_estimate) / 2;\n380\t                min_win = PICOQUIC_BYTES_FROM_RATE(path_x->smoothed_rtt, path_x->peak_bandwidth_estimate) / 2;\n381\t                if (min_win > target_cwin) {\n382\t                    target_cwin = min_win;\n383\t                }\n384\t            }\n385\t        }\n386\t        /* Initial special case: seed cwin */\n387\t        if (c4_state->use_seed_cwin && c4_state->seed_cwin > target_cwin) {\n388\t            /* Match half the difference between seed and computed CWIN */\n389\t            target_cwin = (c4_state->seed_cwin + target_cwin) / 2;\n390\t            c4_state->seed_rate = PICOQUIC_RATE_FROM_BYTES(c4_state->seed_cwin, path_x->smoothed_rtt);\n391\t            if (c4_state->seed_rate > pacing_rate) {\n392\t                pacing_rate = c4_state->seed_rate;\n393\t            }\n394\t        }\n395\t        c4_state->initial_cwnd = target_cwin;\n396\t    }\n397\t    else {\n398\t        uint64_t delta_rtt_target = C4_RTT_MARGIN_DELAY;\n399\t        if (c4_state->nominal_max_rtt < 4* C4_RTT_MARGIN_DELAY) {\n400\t            delta_rtt_target = c4_state->nominal_max_rtt / 4;\n401\t        }\n402\t        target_cwin += PICOQUIC_BYTES_FROM_RATE(delta_rtt_target, pacing_rate);\n403\t\n404\t        if (c4_state->alg_state == c4_pushing) {\n405\t            uint64_t delta_alpha = c4_state->alpha_1024_current - 1024;\n406\t            uint64_t delta_rate = MULT1024(delta_alpha, c4_state->nominal_rate);\n407\t            uint64_t delta_cwin = PICOQUIC_BYTES_FROM_RATE(c4_state->nominal_max_rtt, delta_rate);\n408\t            if (delta_cwin < path_x->send_mtu) {\n409\t                target_cwin += path_x->send_mtu - delta_cwin;\n410\t            }\n411\t        }\n412\t    }\n413\t\n414\t    path_x->cwin = target_cwin;\n415\t    /* set the quantum to 4 milliseconds (OK, 4/1.024 ms, for simplicity) */\n416\t    quantum = MULT1024(4, pacing_rate);\n417\t    if (quantum > 0x10000) {\n418\t        quantum = 0x10000;\n419\t    }\n420\t    else if (quantum < 2 * path_x->send_mtu) {\n421\t        quantum = 2 * path_x->send_mtu;\n422\t    }\n423\t    picoquic_update_pacing_rate(path_x, (double)pacing_rate, quantum);\n424\t}\n425\t\n426\t/* Perform evaluation. Assess whether the previous era resulted\n427\t * in a significant increase or not.\n428\t */\n429\tstatic int c4_growth_evaluate(c4_state_t* c4_state)\n430\t{\n431\t    int is_growing = 0;\n432\t    if (c4_state->push_alpha > C4_ALPHA_PUSH_LOW_1024) {\n433\t        /* If the value of \"push_alpha\" was large enough, we can reasonably\n434\t         * measure growth. */\n435\t        uint64_t target_rate = (3*c4_state->push_rate_old +\n436\t            MULT1024(c4_state->push_alpha, c4_state->push_rate_old)) / 4;\n437\t        is_growing = (c4_state->nominal_rate > target_rate);\n438\t    }\n439\t    else {\n440\t        /* If the value was not big enough, we have to make decision\n441\t         * based on congestion signals.\n442\t         */\n443\t        is_growing = (c4_state->nominal_rate > c4_state->push_rate_old &&\n444\t            !c4_state->congestion_notified);\n445\t    }\n446\t    return is_growing;\n447\t}\n448\t\n449\tstatic void c4_growth_reset(c4_state_t* c4_state)\n450\t{\n451\t    c4_state->congestion_notified = 0;\n452\t    c4_state->push_was_not_limited = 0;\n453\t    c4_state->push_rate_old = c4_state->nominal_rate;\n454\t    /* Push alpha will have to be reset to the correct value when entering push */\n455\t    c4_state->push_alpha = c4_state->alpha_1024_current;\n456\t}\n457\t\n458\t\n459\t/* End of round trip.\n460\t* Happens if packet waited for is acked.\n461\t* Add bandwidth measurement to bandwidth barrel.\n462\t */\n463\tstatic int c4_era_check(\n464\t    picoquic_path_t* path_x,\n465\t    c4_state_t* c4_state)\n466\t{\n467\t    if (path_x->cnx->cnx_state < picoquic_state_ready) {\n468\t        return 0;\n469\t    }\n470\t    else {\n471\t        return (picoquic_cc_get_lowest_not_ack(path_x) > c4_state->era_sequence);\n472\t    }\n473\t}\n474\t\n475\tstatic void c4_era_reset(\n476\t    picoquic_path_t* path_x,\n477\t    c4_state_t* c4_state)\n478\t{\n479\t    c4_state->era_sequence = picoquic_cc_get_sequence_number(path_x->cnx, path_x);\n480\t    c4_state->era_max_rtt = 0;\n481\t    c4_state->era_min_rtt = UINT64_MAX;\n482\t    c4_state->alpha_1024_previous = c4_state->alpha_1024_current;\n483\t    c4_update_ecn_alpha(path_x, c4_state);\n484\t}\n485\t\n486\tstatic void c4_enter_initial(picoquic_path_t* path_x, c4_state_t* c4_state)\n487\t{\n488\t    c4_state->alg_state = c4_initial;\n489\t    c4_state->initial_cwnd = path_x->cwin;\n490\t    c4_state->probe_level = C4_PROBE_LEVEL_DEFAULT;\n491\t    c4_state->alpha_1024_current = C4_ALPHA_INITIAL;\n492\t    c4_state->nb_packets_in_startup = 0;\n493\t    c4_era_reset(path_x, c4_state);\n494\t    c4_state->nb_eras_no_increase = 0;\n495\t    c4_state->ecn_alpha = 0;\n496\t    c4_growth_reset(c4_state);\n497\t}\n498\t\n499\tstatic void c4_set_options(c4_state_t* c4_state)\n500\t{\n501\t    if (c4_state->option_string != NULL) {\n502\t        char const* x = c4_state->option_string;\n503\t        char c;\n504\t        int ended = 0;\n505\t\n506\t        while ((c = *x) != 0 && !ended) {\n507\t            x++;\n508\t            switch (c) {\n509\t            default:\n510\t                ended = 1;\n511\t                break;\n512\t            }\n513\t        }\n514\t    }\n515\t}\n516\t\n517\tvoid c4_reset(c4_state_t* c4_state, picoquic_path_t* path_x, char const* option_string)\n518\t{\n519\t    memset(c4_state, 0, sizeof(c4_state_t));\n520\t    c4_state->option_string = option_string;\n521\t    c4_state->running_min_rtt = UINT64_MAX;\n522\t    c4_state->alpha_1024_current = C4_ALPHA_INITIAL;\n523\t    c4_set_options(c4_state);\n524\t    c4_enter_initial(path_x, c4_state);\n525\t}\n526\t\n527\tvoid c4_seed_cwin(c4_state_t* c4_state, uint64_t bytes_in_flight)\n528\t{\n529\t    if (c4_state->alg_state == c4_initial) {\n530\t        c4_state->use_seed_cwin = 1;\n531\t        c4_state->seed_cwin = bytes_in_flight;\n532\t    }\n533\t}\n534\t\n535\tstatic void c4_exit_initial(picoquic_path_t* path_x, c4_state_t* c4_state)\n536\t{\n537\t    if (c4_state->nominal_rate > 0) {\n538\t        /* We assume that any required correction is done prior to calling this */\n539\t        uint64_t ssthresh = c4_state->initial_cwnd / 2;\n540\t        c4_state->nominal_max_rtt = ssthresh * 1000000 / c4_state->nominal_rate;\n541\t        if (c4_state->nominal_max_rtt < C4_MAX_RTT_MIN) {\n542\t            c4_state->nominal_max_rtt = C4_MAX_RTT_MIN;\n543\t        }\n544\t        c4_state->delay_threshold = c4_delay_threshold(c4_state);\n545\t        c4_state->nb_eras_no_increase = 0;\n546\t        c4_state->probe_level = C4_PROBE_LEVEL_DEFAULT;\n547\t        c4_enter_recovery(path_x, c4_state, c4_congestion_none);\n548\t    }\n549\t}\n550\t\n551\tstatic void c4_initial_handle_rtt_excess(picoquic_path_t* path_x, c4_state_t* c4_state)\n552\t{\n553\t    /* HyStart. */\n554\t    /* Using RTT increases as congestion signal. This is used\n555\t     * for getting out of slow start, but also for ending a cycle\n556\t     * during congestion avoidance */\n557\t    /* we do not directly use \"hystart test\", because we want to separate the\n558\t    * \"update_rtt\" functions from the actual tests.\n559\t     */"}]},"parent_tool_use_id":null,"session_id":"45776a5c-e59c-46e0-bb21-636bdbe37604","uuid":"890961bc-1fa4-4e01-8d22-b2992f230dfa","timestamp":"2026-05-07T05:24:44.273Z","tool_use_result":{"type":"text","file":{"filePath":"/Users/richbarn/Projects/picoquic/picoquic/c4.c","content":"* - 1MB/s: (1-0.03/0.5) = 0.94, approximate to 963/1024\n* - 10MB/s: 1\n*/\n\nstatic uint64_t c4_sensitivity_1024(c4_state_t* c4_state)\n{\n    uint64_t sensitivity = 1024;\n    if (c4_state->nominal_rate < 50000) {\n        sensitivity = 0;\n    }\n    else if (c4_state->nominal_rate > 10000000) {\n        sensitivity = 1024;\n    }\n    else if (c4_state->nominal_rate < 1000000) {\n        sensitivity = (c4_state->nominal_rate - 50000) * 963 / 950000;\n    }\n    else {\n        sensitivity = 963 + ((c4_state->nominal_rate - 1000000) * 61 / 9000000);\n    }\n    return sensitivity;\n}\n\n/* Compute the delay threshold for declaring congestion,\n* as the min of RTT/8 and c4_DELAY_THRESHOLD_MAX (25 ms) \n */\n\nuint64_t c4_delay_threshold(c4_state_t* c4_state)\n{\n    uint64_t sensitivity = c4_sensitivity_1024(c4_state);\n    uint64_t fraction = 64 + MULT1024(1024 - sensitivity, 196);\n    uint64_t delay = MULT1024(fraction, c4_state->nominal_max_rtt);\n    if (delay > C4_DELAY_THRESHOLD_MAX) {\n        delay = C4_DELAY_THRESHOLD_MAX;\n    }\n    return delay;\n}\n\n/* Compute the ECNmarking threshold for declaring a congestion event.\n* The marking threshold should be large if the sensitivity is small --\n* maybe 25%, and smaller if the sensitivity is large -- maybe 12.5%.\n*/\nuint64_t c4_ecn_threshold(c4_state_t* c4_state)\n{\n    uint64_t sensitivity = c4_sensitivity_1024(c4_state);\n\n    uint64_t ecn_threshold = 192 - MULT1024(sensitivity, 96);\n\n    return ecn_threshold;\n}\n\n/* Compute the loss rate threshold for declaring a congestion event\n*/\ndouble c4_loss_threshold(c4_state_t* c4_state)\n{\n    uint64_t sensitivity = c4_sensitivity_1024(c4_state);\n    double fraction = ((double)sensitivity) / 1024.0;\n    double loss_threshold = 0.02 + 0.50 * (1-fraction);\n\n    return loss_threshold;\n}\n\n/* Compute the loss rate */\nvoid c4_update_loss_rate(c4_state_t * c4_state, uint64_t lost_packet_number)\n{\n    uint64_t next_number = c4_state->last_lost_packet_number;\n\n    if (lost_packet_number > next_number) {\n        if (next_number + PICOQUIC_SMOOTHED_LOSS_SCOPE < lost_packet_number) {\n            next_number = lost_packet_number - PICOQUIC_SMOOTHED_LOSS_SCOPE;\n        }\n\n        while (next_number < lost_packet_number) {\n            c4_state->smoothed_drop_rate *= (1.0 - PICOQUIC_SMOOTHED_LOSS_FACTOR);\n            next_number++;\n        }\n\n        c4_state->smoothed_drop_rate += (1.0 - c4_state->smoothed_drop_rate) * PICOQUIC_SMOOTHED_LOSS_FACTOR;\n        c4_state->last_lost_packet_number = lost_packet_number;\n    }\n}\n\n/* Compute the ECN alpha\n*\n* This is similar the prague implementation.\n*/\nstatic void c4_update_ecn_alpha(picoquic_path_t* path_x, c4_state_t* c4_state)\n{\n    uint64_t frac = 0;\n    picoquic_packet_context_t* pkt_ctx = (path_x->cnx->is_multipath_enabled)?\n        &path_x->pkt_ctx : &path_x->cnx->pkt_ctx[picoquic_packet_context_application];\n    int64_t delta_ect1 = pkt_ctx->ecn_ect1_total_remote - c4_state->ecn_ect1;\n    int64_t delta_ce = pkt_ctx->ecn_ce_total_remote - c4_state->ecn_ce;\n\n    c4_state->ecn_ect1 = pkt_ctx->ecn_ect1_total_remote;\n    c4_state->ecn_ce = pkt_ctx->ecn_ce_total_remote;\n\n    if (delta_ce > 0 || delta_ect1 > 0) {\n        frac = (delta_ce * 1024) / (delta_ce + delta_ect1);\n\n        if (frac > c4_state->ecn_alpha && frac >= 512) {\n            c4_state->ecn_alpha = frac;\n        }\n        else\n        {\n            uint64_t alpha_shifted = c4_state->ecn_alpha << C4_ECN_SHIFT_G;\n            alpha_shifted -= c4_state->ecn_alpha;\n            alpha_shifted += frac;\n            c4_state->ecn_alpha = alpha_shifted >> C4_ECN_SHIFT_G;\n        }\n    }\n}\n\n/*\n* c4_apply_rate_and_cwin:\n* Manage all setting of the actual cwin, pacing rate and quantum\n* at a single place, based on the state parameters computed\n* in the other functions.\n*/\n\nstatic void c4_apply_rate_and_cwin(\n    picoquic_path_t* path_x,\n    c4_state_t* c4_state)\n{\n\n    uint64_t pacing_rate = MULT1024(c4_state->alpha_1024_current, c4_state->nominal_rate);\n    uint64_t quantum;\n    uint64_t target_cwin = PICOQUIC_CWIN_INITIAL;\n    if (c4_state->nominal_max_rtt != 0 && c4_state->nominal_rate != 0) {\n        target_cwin = PICOQUIC_BYTES_FROM_RATE(c4_state->nominal_max_rtt, pacing_rate);\n    }\n\n    if (c4_state->alg_state == c4_initial) {\n        if (target_cwin < c4_state->initial_cwnd) {\n            target_cwin = c4_state->initial_cwnd;\n        }\n        /* Initial special case: bandwidth discovery */\n        if (c4_state->nb_packets_in_startup > 0) {\n            if (path_x->peak_bandwidth_estimate > pacing_rate) {\n                uint64_t min_win;\n                pacing_rate = (pacing_rate + path_x->peak_bandwidth_estimate) / 2;\n                min_win = PICOQUIC_BYTES_FROM_RATE(path_x->smoothed_rtt, path_x->peak_bandwidth_estimate) / 2;\n                if (min_win > target_cwin) {\n                    target_cwin = min_win;\n                }\n            }\n        }\n        /* Initial special case: seed cwin */\n        if (c4_state->use_seed_cwin && c4_state->seed_cwin > target_cwin) {\n            /* Match half the difference between seed and computed CWIN */\n            target_cwin = (c4_state->seed_cwin + target_cwin) / 2;\n            c4_state->seed_rate = PICOQUIC_RATE_FROM_BYTES(c4_state->seed_cwin, path_x->smoothed_rtt);\n            if (c4_state->seed_rate > pacing_rate) {\n                pacing_rate = c4_state->seed_rate;\n            }\n        }\n        c4_state->initial_cwnd = target_cwin;\n    }\n    else {\n        uint64_t delta_rtt_target = C4_RTT_MARGIN_DELAY;\n        if (c4_state->nominal_max_rtt < 4* C4_RTT_MARGIN_DELAY) {\n            delta_rtt_target = c4_state->nominal_max_rtt / 4;\n        }\n        target_cwin += PICOQUIC_BYTES_FROM_RATE(delta_rtt_target, pacing_rate);\n\n        if (c4_state->alg_state == c4_pushing) {\n            uint64_t delta_alpha = c4_state->alpha_1024_current - 1024;\n            uint64_t delta_rate = MULT1024(delta_alpha, c4_state->nominal_rate);\n            uint64_t delta_cwin = PICOQUIC_BYTES_FROM_RATE(c4_state->nominal_max_rtt, delta_rate);\n            if (delta_cwin < path_x->send_mtu) {\n                target_cwin += path_x->send_mtu - delta_cwin;\n            }\n        }\n    }\n\n    path_x->cwin = target_cwin;\n    /* set the quantum to 4 milliseconds (OK, 4/1.024 ms, for simplicity) */\n    quantum = MULT1024(4, pacing_rate);\n    if (quantum > 0x10000) {\n        quantum = 0x10000;\n    }\n    else if (quantum < 2 * path_x->send_mtu) {\n        quantum = 2 * path_x->send_mtu;\n    }\n    picoquic_update_pacing_rate(path_x, (double)pacing_rate, quantum);\n}\n\n/* Perform evaluation. Assess whether the previous era resulted\n * in a significant increase or not.\n */\nstatic int c4_growth_evaluate(c4_state_t* c4_state)\n{\n    int is_growing = 0;\n    if (c4_state->push_alpha > C4_ALPHA_PUSH_LOW_1024) {\n        /* If the value of \"push_alpha\" was large enough, we can reasonably\n         * measure growth. */\n        uint64_t target_rate = (3*c4_state->push_rate_old +\n            MULT1024(c4_state->push_alpha, c4_state->push_rate_old)) / 4;\n        is_growing = (c4_state->nominal_rate > target_rate);\n    }\n    else {\n        /* If the value was not big enough, we have to make decision\n         * based on congestion signals.\n         */\n        is_growing = (c4_state->nominal_rate > c4_state->push_rate_old &&\n            !c4_state->congestion_notified);\n    }\n    return is_growing;\n}\n\nstatic void c4_growth_reset(c4_state_t* c4_state)\n{\n    c4_state->congestion_notified = 0;\n    c4_state->push_was_not_limited = 0;\n    c4_state->push_rate_old = c4_state->nominal_rate;\n    /* Push alpha will have to be reset to the correct value when entering push */\n    c4_state->push_alpha = c4_state->alpha_1024_current;\n}\n\n\n/* End of round trip.\n* Happens if packet waited for is acked.\n* Add bandwidth measurement to bandwidth barrel.\n */\nstatic int c4_era_check(\n    picoquic_path_t* path_x,\n    c4_state_t* c4_state)\n{\n    if (path_x->cnx->cnx_state < picoquic_state_ready) {\n        return 0;\n    }\n    else {\n        return (picoquic_cc_get_lowest_not_ack(path_x) > c4_state->era_sequence);\n    }\n}\n\nstatic void c4_era_reset(\n    picoquic_path_t* path_x,\n    c4_state_t* c4_state)\n{\n    c4_state->era_sequence = picoquic_cc_get_sequence_number(path_x->cnx, path_x);\n    c4_state->era_max_rtt = 0;\n    c4_state->era_min_rtt = UINT64_MAX;\n    c4_state->alpha_1024_previous = c4_state->alpha_1024_current;\n    c4_update_ecn_alpha(path_x, c4_state);\n}\n\nstatic void c4_enter_initial(picoquic_path_t* path_x, c4_state_t* c4_state)\n{\n    c4_state->alg_state = c4_initial;\n    c4_state->initial_cwnd = path_x->cwin;\n    c4_state->probe_level = C4_PROBE_LEVEL_DEFAULT;\n    c4_state->alpha_1024_current = C4_ALPHA_INITIAL;\n    c4_state->nb_packets_in_startup = 0;\n    c4_era_reset(path_x, c4_state);\n    c4_state->nb_eras_no_increase = 0;\n    c4_state->ecn_alpha = 0;\n    c4_growth_reset(c4_state);\n}\n\nstatic void c4_set_options(c4_state_t* c4_state)\n{\n    if (c4_state->option_string != NULL) {\n        char const* x = c4_state->option_string;\n        char c;\n        int ended = 0;\n\n        while ((c = *x) != 0 && !ended) {\n            x++;\n            switch (c) {\n            default:\n                ended = 1;\n                break;\n            }\n        }\n    }\n}\n\nvoid c4_reset(c4_state_t* c4_state, picoquic_path_t* path_x, char const* option_string)\n{\n    memset(c4_state, 0, sizeof(c4_state_t));\n    c4_state->option_string = option_string;\n    c4_state->running_min_rtt = UINT64_MAX;\n    c4_state->alpha_1024_current = C4_ALPHA_INITIAL;\n    c4_set_options(c4_state);\n    c4_enter_initial(path_x, c4_state);\n}\n\nvoid c4_seed_cwin(c4_state_t* c4_state, uint64_t bytes_in_flight)\n{\n    if (c4_state->alg_state == c4_initial) {\n        c4_state->use_seed_cwin = 1;\n        c4_state->seed_cwin = bytes_in_flight;\n    }\n}\n\nstatic void c4_exit_initial(picoquic_path_t* path_x, c4_state_t* c4_state)\n{\n    if (c4_state->nominal_rate > 0) {\n        /* We assume that any required correction is done prior to calling this */\n        uint64_t ssthresh = c4_state->initial_cwnd / 2;\n        c4_state->nominal_max_rtt = ssthresh * 1000000 / c4_state->nominal_rate;\n        if (c4_state->nominal_max_rtt < C4_MAX_RTT_MIN) {\n            c4_state->nominal_max_rtt = C4_MAX_RTT_MIN;\n        }\n        c4_state->delay_threshold = c4_delay_threshold(c4_state);\n        c4_state->nb_eras_no_increase = 0;\n        c4_state->probe_level = C4_PROBE_LEVEL_DEFAULT;\n        c4_enter_recovery(path_x, c4_state, c4_congestion_none);\n    }\n}\n\nstatic void c4_initial_handle_rtt_excess(picoquic_path_t* path_x, c4_state_t* c4_state)\n{\n    /* HyStart. */\n    /* Using RTT increases as congestion signal. This is used\n     * for getting out of slow start, but also for ending a cycle\n     * during congestion avoidance */\n    /* we do not directly use \"hystart test\", because we want to separate the\n    * \"update_rtt\" functions from the actual tests.\n     */","numLines":320,"startLine":240,"totalLines":1140}}}
