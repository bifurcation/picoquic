{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01QPsyjJgLWeY4g5ZjbpwQau","type":"tool_result","content":"895\t\n896\t    /// Uniform integer in `[low, high]` from the BBR internal PRNG.\n897\t    /// C: `BBRRandomIntBetween` (picoquic/bbr.c:1644).\n898\t    fn random_int_between(&mut self, low: u64, high: u64) -> u64 {\n899\t        let range = high - low + 1;\n900\t        let rnd_min = u64::MAX % range;\n901\t        let rnd = loop {\n902\t            let v = self.bbr_random();\n903\t            if v >= rnd_min {\n904\t                break v;\n905\t            }\n906\t        };\n907\t        low + rnd % range\n908\t    }\n909\t\n910\t    /// Advance the max-BW windowed filter to the next cycle.\n911\t    /// C: `BBRAdvanceMaxBwFilter` (picoquic/bbr.c:1118).\n912\t    pub(crate) fn advance_max_bw_filter(&mut self) {\n913\t        self.cycle_count += 1;\n914\t        self.ack_phase = BbrAckPhase::ProbeStarting;\n915\t        // Clear the slot for the new cycle so stale values don't persist.\n916\t        let slot = (self.cycle_count as usize) % self.max_bw_filter.len();\n917\t        self.max_bw_filter[slot] = 0;\n918\t    }\n919\t\n920\t    /// Latch the random probe-wait intervals for a normal probe-BW DOWN phase.\n921\t    /// C: `BBRPickProbeWait` (picoquic/bbr.c:1658).\n922\t    fn pick_probe_wait(&mut self) {\n923\t        const BBR_LONG_RTT_THRESHOLD: u64 = 250_000;\n924\t        self.rounds_since_bw_probe = self.random_int_between(0, 1) as u32;\n925\t        self.bw_probe_wait = if self.min_rtt < BBR_LONG_RTT_THRESHOLD {\n926\t            2_000_000 + self.random_int_between(0, 1_000_000)\n927\t        } else {\n928\t            8 * self.min_rtt + self.random_int_between(0, 4 * self.min_rtt)\n929\t        };\n930\t    }\n931\t\n932\t    /// Latch the random probe-wait intervals for an early-exit probe-BW DOWN.\n933\t    /// C: `BBRPickProbeWaitEarly` (picoquic/bbr.c:1675).\n934\t    fn pick_probe_wait_early(&mut self) {\n935\t        const BBR_LONG_RTT_THRESHOLD: u64 = 250_000;\n936\t        self.rounds_since_bw_probe = self.random_int_between(0, 1) as u32;\n937\t        self.bw_probe_wait = if self.min_rtt < BBR_LONG_RTT_THRESHOLD {\n938\t            self.min_rtt + self.random_int_between(0, BBR_LONG_RTT_THRESHOLD)\n939\t        } else {\n940\t            self.min_rtt + self.random_int_between(0, self.min_rtt)\n941\t        };\n942\t    }\n943\t\n944\t    /// Record the packet-number watermark that ends the current round.\n945\t    /// C: `BBRStartRound` (picoquic/bbr.c:1212).\n946\t    ///\n947\t    /// In C `round_start_pn` is set via `picoquic_cc_get_sequence_number`\n948\t    /// which reads either `path_x->pkt_ctx.send_sequence` (multipath) or\n949\t    /// `cnx->pkt_ctx[application].send_sequence` (single-path).  Rust has no\n950\t    /// back-pointer from `Path` to `Connection`, so both are passed explicitly.\n951\t    pub(crate) fn start_round(&mut self, connection: &Connection, path_x: &Path) {\n952\t        self.round_start_pn = if connection.is_multipath_enabled {\n953\t            path_x.pkt_ctx.send_sequence\n954\t        } else {\n955\t            connection.pkt_ctx[PacketContext::Application as usize].send_sequence\n956\t        };\n957\t        self.next_round_delivered = path_x.delivered;\n958\t    }\n959\t\n960\t    /// Transition to ProbeBW-DOWN state.\n961\t    /// C: `BBRStartProbeBW_DOWN` (picoquic/bbr.c:1793).\n962\t    pub(crate) fn start_probe_bw_down(\n963\t        &mut self,\n964\t        connection: &Connection,\n965\t        path_x: &mut Path,\n966\t        current_time: u64,\n967\t    ) {\n968\t        const BBR_PROBE_BW_DOWN_PACING_GAIN: f64 = 0.9;\n969\t        const BBR_PROBE_BW_DOWN_CWND_GAIN: f64 = 2.0;\n970\t        self.pacing_gain = BBR_PROBE_BW_DOWN_PACING_GAIN;\n971\t        self.cwnd_gain = BBR_PROBE_BW_DOWN_CWND_GAIN;\n972\t        self.reset_congestion_signals();\n973\t        self.bw_probe_up_cnt = u32::MAX; // not growing inflight_hi\n974\t        if self.probe_probe_bw_quickly && self.exp_flags.do_rapid_start {\n975\t            self.pick_probe_wait_early();\n976\t        } else {\n977\t            self.pick_probe_wait();\n978\t        }\n979\t        self.cycle_stamp = current_time;\n980\t        self.ack_phase = BbrAckPhase::ProbeStopping;\n981\t        self.start_round(connection, path_x);\n982\t        self.state = BbrAlgState::ProbeBwDown;\n983\t        self.nb_rtt_excess = 0;\n984\t        self.app_limited_round_count = 0;\n985\t        self.app_limited_this_round = 0;\n986\t        path_x.is_cca_probing_up = false;\n987\t    }\n988\t\n989\t    /// React to inflight being too high: record the new inflight ceiling and,\n990\t    /// if currently in ProbeBW-UP, transition to DOWN.\n991\t    /// C: `BBRHandleInflightTooHigh` (picoquic/bbr.c:1174).\n992\t    fn handle_inflight_too_high(\n993\t        &mut self,\n994\t        connection: &Connection,\n995\t        path_x: &mut Path,\n996\t        rs: &BbrPerAckState,\n997\t        current_time: u64,\n998\t    ) {\n999\t        self.bw_probe_samples = 0; // only react once per bw probe\n1000\t        if !rs.is_app_limited {\n1001\t            let beta_target = (self.target_inflight(path_x) as f64 * BBR_BETA) as u64;\n1002\t            self.inflight_hi = rs.tx_in_flight.max(beta_target);\n1003\t        }\n1004\t        if self.state == BbrAlgState::ProbeBwUp {\n1005\t            self.start_probe_bw_down(connection, path_x, current_time);\n1006\t        }\n1007\t    }\n1008\t\n1009\t    /// Test whether inflight is too high and respond; returns `true` when\n1010\t    /// the inflight ceiling was triggered.\n1011\t    /// C: `CheckInflightTooHigh` (picoquic/bbr.c:1188).\n1012\t    fn check_inflight_too_high(\n1013\t        &mut self,\n1014\t        connection: &Connection,\n1015\t        path_x: &mut Path,\n1016\t        rs: &BbrPerAckState,\n1017\t        current_time: u64,\n1018\t    ) -> bool {\n1019\t        if self.is_inflight_too_high(path_x, rs) {\n1020\t            if self.bw_probe_samples != 0 {\n1021\t                self.handle_inflight_too_high(connection, path_x, rs, current_time);\n1022\t            }\n1023\t            true\n1024\t        } else {\n1025\t            false\n1026\t        }\n1027\t    }\n1028\t\n1029\t    /// Increase `inflight_hi` when the congestion window is cwnd-limited and\n1030\t    /// we are in ProbeBW-UP.  Called when loss rate is safe.\n1031\t    /// C: `BBRProbeInflightHiUpward` (picoquic/bbr.c:1571).\n1032\t    pub(crate) fn probe_inflight_hi_upward(&mut self, path_x: &Path, rs: &BbrPerAckState) {\n1033\t        if !rs.is_cwnd_limited || path_x.cwin < self.inflight_hi {\n1034\t            return; // not fully using inflight_hi, so don't grow it\n1035\t        }\n1036\t        self.bw_probe_up_acks += rs.newly_acked;\n1037\t        if self.bw_probe_up_acks >= self.bw_probe_up_cnt as u64 * path_x.send_mtu as u64 {\n1038\t            let delta = self.bw_probe_up_acks / self.bw_probe_up_cnt as u64;\n1039\t            self.bw_probe_up_acks -= delta * self.bw_probe_up_cnt as u64;\n1040\t            self.inflight_hi += delta;\n1041\t        }\n1042\t        if self.round_start {\n1043\t            self.raise_inflight_hi_slope(path_x);\n1044\t        }\n1045\t    }\n1046\t\n1047\t    /// Track ACK state and adjust `inflight_hi` and `bw_hi` upper bounds.\n1048\t    /// C: `BBRAdaptUpperBounds` (picoquic/bbr.c:1589).\n1049\t    pub fn adapt_upper_bounds(\n1050\t        &mut self,\n1051\t        connection: &Connection,\n1052\t        path_x: &mut Path,\n1053\t        rs: &BbrPerAckState,\n1054\t        current_time: u64,\n1055\t    ) {\n1056\t        if self.ack_phase == BbrAckPhase::ProbeStarting && self.round_start {\n1057\t            self.ack_phase = BbrAckPhase::ProbeFeedback;\n1058\t        }\n1059\t        if self.ack_phase == BbrAckPhase::ProbeStopping\n1060\t            && self.round_start\n1061\t            && self.is_in_a_probe_bw_state()\n1062\t            && !rs.is_app_limited