or the new rate exceeds\n607\t    /// the current one (prevents backward steps during slow-start).\n608\t    pub fn set_pacing_rate_with_gain(&mut self, pacing_gain: f64) {\n609\t        let rate = pacing_gain * (self.bw * (100 - BBR_PACING_MARGIN_PERCENT)) as f64 / 100.0;\n610\t        let rate = if self.state == BbrAlgState::StartupResume\n611\t            && !self.filled_pipe\n612\t            && self.bdp_seed > 0\n613\t            && self.min_rtt > 0\n614\t            && self.min_rtt != u64::MAX\n615\t        {\n616\t            let bdp_rate = self.bdp_seed as f64 * 1_000_000.0 / self.min_rtt as f64;\n617\t            rate.max(bdp_rate)\n618\t        } else {\n619\t            rate\n620\t        };\n621\t        if self.filled_pipe || rate > self.pacing_rate {\n622\t            self.pacing_rate = rate;\n623\t        }\n624\t    }\n625\t\n626\t    /// C: `BBRSetSendQuantum` (picoquic/bbr.c:967)\n627\t    ///\n628\t    /// Compute `send_quantum` as `pacing_rate × quantum_ratio`, clamped to\n629\t    /// at most 64 KiB and floored at one MTU (pacing_rate < 1.2 Mbps) or\n630\t    /// two MTUs (otherwise).\n631\t    pub fn set_send_quantum(&mut self, path_x: &Path) {\n632\t        let floor = if self.pacing_rate < 150_000.0 {\n633\t            path_x.send_mtu as u64\n634\t        } else {\n635\t            2 * path_x.send_mtu as u64\n636\t        };\n637\t        let quantum = (self.pacing_rate * self.quantum_ratio) as u64;\n638\t        self.send_quantum = quantum.min(0x10000).max(floor);\n639\t    }\n640\t\n641\t    /// C: `BBRStartProbeBW_CRUISE` (picoquic/bbr.c:1816)\n642\t    ///\n643\t    /// Enter the ProbeBW/Cruise phase: pace at rate (gain = 1.0) while\n644\t    /// maintaining the congestion window (cwnd_gain = 2.0).\n645\t    pub fn start_probe_bw_cruise(&mut self) {\n646\t        self.pacing_gain = BBR_PROBE_BW_CRUISE_PACING_GAIN;\n647\t        self.cwnd_gain = BBR_PROBE_BW_CRUISE_CWND_GAIN;\n648\t        self.state = BbrAlgState::ProbeBwCruise;\n649\t   