{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01PB9SMPeKbHRr1fsHgcBgei","type":"tool_result","content":"490\t    /// bottleneck buffer free for competing flows.  Returns `u64::MAX`\n491\t    /// when `inflight_hi` has not yet been measured.\n492\t    pub fn inflight_with_headroom(&self, path_x: &Path) -> u64 {\n493\t        const BBR_HEADROOM: f64 = 0.15;\n494\t        const BBR_MIN_PIPE_CWND: u64 = 4;\n495\t        if self.inflight_hi == u64::MAX {\n496\t            return u64::MAX;\n497\t        }\n498\t        let headroom = ((1.0 - BBR_HEADROOM) * self.inflight_hi as f64) as u64;\n499\t        headroom.max(BBR_MIN_PIPE_CWND * path_x.send_mtu as u64)\n500\t    }\n501\t\n502\t    /// C: `BBRIsProbingBW` (picoquic/bbr.c:1532)\n503\t    ///\n504\t    /// Returns `true` when the state is actively probing for more bandwidth\n505\t    /// (i.e. NOT in one of the non-probing states: ProbeBwDown, ProbeBwCruise,\n506\t    /// Drain, or ProbeRtt).\n507\t    pub fn is_probing_bw(&self) -> bool {\n508\t        !matches!(\n509\t            self.state,\n510\t            BbrAlgState::ProbeBwDown\n511\t                | BbrAlgState::ProbeBwCruise\n512\t                | BbrAlgState::Drain\n513\t                | BbrAlgState::ProbeRtt\n514\t        )\n515\t    }\n516\t\n517\t    /// C: `BBRLossLowerBounds` (picoquic/bbr.c:1035)\n518\t    ///\n519\t    /// Apply a `BBRBeta` (0.7) multiplicative decrease to `bw_lo` and\n520\t    /// `inflight_lo`, then floor each at the latest sample so the model\n521\t    /// cannot shrink below what was actually observed this round.\n522\t    pub fn loss_lower_bounds(&mut self) {\n523\t        self.bw_lo = ((BBR_BETA * self.bw_lo as f64) as u64).max(self.bw_latest);\n524\t        self.inflight_lo = ((BBR_BETA * self.inflight_lo as f64) as u64).max(self.inflight_latest);\n525\t    }\n526\t\n527\t    /// C: `BBRModulateCwndForRecovery` (picoquic/bbr.c:627)\n528\t    ///\n529\t    /// On packet loss, shrink `cwin` by the number of bytes lost (floored at\n530\t    /// one MTU).  When `packet_conservation` is active, ensure `cwin` is at\n531\t    /// least `bytes_in_transit + newly_acked` so the pipe stays full.\n532\t    pub fn modulate_cwnd_for_recovery(&self, path_x: &mut Path, rs: &BbrPerAckState) {\n533\t        if rs.newly_lost > 0 {\n534\t            if path_x.cwin > rs.newly_lost + path_x.send_mtu as u64 {\n535\t                path_x.cwin -= rs.newly_lost;\n536\t            } else {\n537\t                path_x.cwin = path_x.send_mtu as u64;\n538\t            }\n539\t        }\n540\t        if self.packet_conservation && path_x.cwin < path_x.bytes_in_transit + rs.newly_acked {\n541\t            path_x.cwin = path_x.bytes_in_transit + rs.newly_acked;\n542\t        }\n543\t    }\n544\t\n545\t    /// C: `BBRRaiseInflightHiSlope` (picoquic/bbr.c:1561)\n546\t    ///\n547\t    /// Recompute how aggressively `inflight_hi` is raised during ProbeBwUp.\n548\t    /// Each round the slope doubles (shift by `bw_probe_up_rounds`, capped at\n549\t    /// 30), and `bw_probe_up_cnt` is set to the number of MTU-sized ACKs\n550\t    /// required to justify a one-MTU increase (minimum 1).\n551\t    pub fn raise_inflight_hi_slope(&mut self, path_x: &Path) {\n552\t        let growth_this_round = (path_x.send_mtu as u64) << self.bw_probe_up_rounds;\n553\t        self.bw_probe_up_rounds = (self.bw_probe_up_rounds + 1).min(30);\n554\t        let up_cnt = (path_x.cwin / growth_this_round) as u32;\n555\t        self.bw_probe_up_cnt = up_cnt.max(1);\n556\t    }\n557\t\n558\t    /// C: `BBRResetCongestionSignals` (picoquic/bbr.c:1014)\n559\t    ///\n560\t    /// Clear the per-round congestion signals so the next round starts with\n561\t    /// a clean slate.  Called at the start of each new round.\n562\t    pub fn reset_congestion_signals(&mut self) {\n563\t        self.loss_in_round = false;\n564\t        self.bw_latest = 0;\n565\t        self.inflight_latest = 0;\n566\t    }\n567\t\n568\t    /// C: `BBR