\t        if cwnd > path_x.cwin {\n426\t            path_x.cwin = cwnd;\n427\t        }\n428\t        path_x.is_cca_probing_up = true;\n429\t    }\n430\t\n431\t    /// C: `BBRInitFullPipe` (picoquic/bbr.c:434)\n432\t    ///\n433\t    /// Reset the \"pipe full\" bandwidth-growth detector to its initial state.\n434\t    pub fn init_full_pipe(&mut self) {\n435\t        self.filled_pipe = false;\n436\t        self.full_bw = 0;\n437\t        self.full_bw_count = 0;\n438\t    }\n439\t\n440\t    /// C: `BBRInitLowerBounds` (picoquic/bbr.c:1025)\n441\t    ///\n442\t    /// On the first congestion episode in a cycle, latch `bw_lo` to\n443\t    /// `max_bw` and `inflight_lo` to `cwin` (the UINT64_MAX sentinel\n444\t    /// means \"not yet initialised\").\n445\t    pub fn init_lower_bounds(&mut self, path_x: &Path) {\n446\t        if self.bw_lo == u64::MAX {\n447\t            self.bw_lo = self.max_bw;\n448\t        }\n449\t        if self.inflight_lo == u64::MAX {\n450\t            self.inflight_lo = path_x.cwin;\n451\t        }\n452\t    }\n453\t\n454\t    /// C: `BBRInitPacingRate` (picoquic/bbr.c:933)\n455\t    ///\n456\t    /// Set the initial pacing rate based on the nominal bandwidth at\n457\t    /// `INITIAL_RTT` (250 ms), unless the path already has a real RTT\n458\t    /// estimate, in which case that estimate is used instead.\n459\t    pub fn init_pacing_rate(&mut self, path_x: &Path) {\n460\t        let initial_rtt = if path_x.smoothed_rtt != INITIAL_RTT || path_x.rtt_variant.ticks() != 0 {\n461\t            path_x.smoothed_rtt.ticks()\n462\t        } else {\n463\t            INITIAL_RTT.ticks()\n464\t        };\n465\t        let nominal_bandwidth = (1_000_000u64 * CWIN_INITIAL) as f64 / initial_rtt as f64;\n466\t        self.pacing_rate = BBR_STARTUP_PACING_GAIN * nominal_bandwidth;\n467\t    }\n468\t\n469\t    /// C: `BBRInitRandom` (picoquic/bbr.c:421)\n470\t    ///\n471\t    /// Seed `random_context` from the current time, connection role, and\n472\t    /// path