1290)\n221\t    ///\n222\t    /// Recompute `min_rtt_margin` as a fixed percentage of `min_rtt`\n223\t    /// plus the transmission time of two MTU-sized packets at `max_bw`.\n224\t    /// The margin prevents the probe-RTT timer from firing too early\n225\t    /// when only a small amount of queuing is present.\n226\t    pub fn adapt_min_rtt_margin(&mut self, path_x: &Path) {\n227\t        let margin = (self.min_rtt * BBR_MIN_RTT_MARGIN_PERCENT) * 100 / 1_000_000;\n228\t        let margin = if self.max_bw > 0 {\n229\t            margin + 2 * path_x.send_mtu as u64 * 1_000_000 / self.max_bw\n230\t        } else {\n231\t            margin\n232\t        };\n233\t        self.min_rtt_margin = margin;\n234\t    }\n235\t\n236\t    /// C: `BBRAdvanceLatestDeliverySignals` (picoquic/bbr.c:1007)\n237\t    ///\n238\t    /// Called near the end of ACK processing: if this ACK completed a\n239\t    /// loss round, reset `bw_latest` and `inflight_latest` to the\n240\t    /// current sample so the next round starts fresh.\n241\t    pub fn advance_latest_delivery_signals(&mut self, rs: &BbrPerAckState) {\n242\t        if self.loss_round_start {\n243\t            self.bw_latest = rs.delivery_rate;\n244\t            self.inflight_latest = rs.delivered;\n245\t        }\n246\t    }\n247\t\n248\t    /// C: `BBRBDPMultipleWithBw` (picoquic/bbr.c:869)\n249\t    ///\n250\t    /// Returns `gain × BDP` computed at the supplied `bw` rather than\n251\t    /// `self.bw`.  When `min_rtt` has never been measured (`u64::MAX`),\n252\t    /// returns the initial congestion window as a safe floor.\n253\t    ///\n254\t    /// Side-effect: writes `self.bdp` so callers can read the raw BDP\n255\t    /// estimate after the call (mirrors C's write-through of\n256\t    /// `bbr_state->bdp`).\n257\t    pub fn bdp_multiple_with_bw(&mut self, path_x: &Path, gain: f64, bw: u64) -> u64 {\n258\t        if self.min_rtt == u64::MAX {\n259\t            return CWIN_INITIAL * path_x.send_mtu as u64;\n260\t        }\n261\t        // PICOQUIC_BYTES_FROM_RATE(min_rtt_us, bps) = min_rtt * bps / 1_000_000\n262\t        self.bdp = self.min_rtt * bw / 1_000_000;\n263\t        (gain * self.bdp as f64) as u64\n264\t    }\n265\t\n266\t    /// C: `BBRBoundBWForModel` (picoquic/bbr.c:1094)\n267\t    ///\n268\t    /// Set `self.bw = min(max_bw, bw_lo, bw_hi)`.  `bw_hi` is only\n269\t    /// applied when non-zero; the zero check preserves compatibility\n270\t    /// with states where `bw_hi` is not yet initialised (noted as a\n271\t    /// TODO in the C source).\n272\t    pub fn bound_bw_for_model(&mut self) {\n273\t        self.bw = self.max_bw;\n274\t        if self.bw > self.bw_lo {\n275\t            self.bw = self.bw_lo;\n276\t        }\n277\t        // TODO: remove the bw_hi != 0 guard once variables are properly\n278\t        // initialised (mirrors the C-side TODO at bbr.c:1100).\n279\t        if self.bw > self.bw_hi && self.bw_hi != 0 {\n280\t            self.bw = self.bw_hi;\n281\t        }\n282\t    }\n283\t\n284\t    /// C: `BBREnterProbeRTT` (picoquic/bbr.c:1487)\n285\t    pub fn enter_probe_rtt(&mut self, path_x: &mut Path) {\n286\t        self.state = BbrAlgState::ProbeRtt;\n287\t        self.pacing_gain = 1.0;\n288\t        self.cwnd_gain = BBR_PROBE_RTT_CWND_GAIN;\n289\t        path_x.is_cca_probing_up = false;\n290\t    }\n291\t\n292\t    /// C: `BBREnterDrain` (picoquic/bbr.c:1933)\n293\t    pub fn enter_drain(&mut self, path_x: &mut Path) {\n294\t        // Picoquic-specific: notify transport that the startup phase is complete.\n295\t        path_x.is_ssthresh_initialized = true;\n296\t        self.state = BbrAlgState::Drain;\n297\t        self.pacing_gain = 1.0 / BBR_STARTUP_CWND_GAIN; // pace slowly\n298\t        self.cwnd_gain = BBR_STARTUP_CWND_GAIN; // maintain cwnd\n299\t        path_x.is_cca_probing_up = false;"}]},"parent_tool_use_id":null,"session_id":"150c7366-bb85-444c-b8bf-a4b52005129b","uuid":"21f5b828-6256-45aa-991e-04f9b64a3b7a","timestamp":"2026-05-07T10:20