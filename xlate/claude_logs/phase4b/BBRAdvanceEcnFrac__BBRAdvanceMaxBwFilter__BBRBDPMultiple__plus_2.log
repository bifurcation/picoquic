{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01HatVAwZpUw8uxjkD7JjtMM","type":"tool_result","content":"60\t\n61\t/// Select the packet context for L4S ECN accounting: the per-connection\n62\t/// application context unless multipath is enabled, in which case the\n63\t/// per-path context is used instead.\n64\t///\n65\t/// C: `picoquic_prague_get_pkt_ctx` (picoquic/prague.c:144-154).\n66\t#[allow(dead_code)]\n67\tpub(crate) fn prague_get_pkt_ctx<'a>(\n68\t    cnx: &'a Connection,\n69\t    path_x: &'a Path,\n70\t) -> &'a PacketContextState {\n71\t    if cnx.is_multipath_enabled {\n72\t        &path_x.pkt_ctx\n73\t    } else {\n74\t        &cnx.pkt_ctx[PacketContext::Application as usize]\n75\t    }\n76\t}\n77\t\n78\t/// Reset `pr_state` to initial slow-start phase and set `path_x.cwin`\n79\t/// to the initial congestion window.\n80\t///\n81\t/// C: `picoquic_prague_init_reno` (picoquic/prague.c:118-124).\n82\t#[allow(dead_code)]\n83\tpub(crate) fn prague_init_reno(pr_state: &mut PragueState, path_x: &mut Path) {\n84\t    pr_state.alg_state = PragueAlgState::SlowStart;\n85\t    pr_state.ssthresh = u64::MAX;\n86\t    pr_state.alpha = 0;\n87\t    path_x.cwin = CWIN_INITIAL;\n88\t}\n89\t\n90\t// ---------------------------------------------------------------------------\n91\t// Public API.\n92\t\n93\timpl PragueState {\n94\t    /// Observe the current algorithm phase and slow-start threshold.\n95\t    ///\n96\t    /// Returns `(cc_state, cc_param)` where `cc_state` is the numeric\n97\t    /// discriminant of [`PragueAlgState`] and `cc_param` is `ssthresh`\n98\t    /// (reported as `0` when `ssthresh == u64::MAX`, meaning the threshold\n99\t    /// has not yet been set).\n100\t    ///\n101\t    /// C: `picoquic_prague_observe` (picoquic/prague.c:407-412).\n102\t    pub fn observe(&self) -> (u64, u64) {\n103\t        let cc_state = self.alg_state as u64;\n104\t        let cc_param = if self.ssthresh == u64::MAX {\n105\t            0\n106\t        } else {\n107\t            self.ssthresh\n108\t        };\n109\t        (cc_state, cc_param)\n110\t    }\n111\t}\n112\t"}]},"parent_tool_use_id":null,"session_id":"150c7366-bb85-444c-b8bf-a4b52005129b","uuid":"f5155136-b0b8-411d-96c1-68d0096e05c5","timestamp":"2026-05-07T10:21:10.047Z","tool_use_result":{"type":"text","file":{"filePath":"/Users/richbarn/Projects/picoquic/rs/fq/src/prague.rs","content":"\n/// Select the packet context for L4S ECN accounting: the per-connection\n/// application context unless multipath is enabled, in which case the\n/// per-path context is used instead.\n///\n/// C: `picoquic_prague_get_pkt_ctx` (picoquic/prague.c:144-154).\n#[allow(dead_code)]\npub(crate) fn prague_get_pkt_ctx<'a>(\n    cnx: &'a Connection,\n    path_x: &'a Path,\n) -> &'a PacketContextState {\n    if cnx.is_multipath_enabled {\n        &path_x.pkt_ctx\n    } else {\n        &cnx.pkt_ctx[PacketContext::Application as usize]\n    }\n}\n\n/// Reset `pr_state` to initial slow-start phase and set `path_x.cwin`\n/// to the initial congestion window.\n///\n/// C: `picoquic_prague_init_reno` (picoquic/prague.c:118-124).\n#[allow(dead_code)]\npub(crate) fn prague_init_reno(pr_state: &mut PragueState, path_x: &mut Path) {\n    pr_state.alg_state = PragueAlgState::SlowStart;\n    pr_state.ssthresh = u64::MAX;\n    pr_state.alpha = 0;\n    path_x.cwin = CWIN_INITIAL;\n}\n\n// ---------------------------------------------------------------------------\n// Public API.\n\nimpl PragueState {\n    /// Observe the current algorithm phase and slow-start threshold.\n    ///\n    /// Returns `(cc_state, cc_param)` where `cc_state` is the numeric\n    /// discriminant of [`PragueAlgState`] and `cc_param` is `ssthresh`\n    /// (reported as `0` when `ssthresh == u64::MAX`, meaning the threshold\n    /// has not yet been set).\n    ///\n    /// C: `picoquic_prague_observe` (picoquic/prague.c:407-412).\n    pub fn observe(&self) -> (u64, u64) {\n        let cc_state = self.alg_state as u64;\n        let cc_param = if self.ssthresh == u64::MAX {\n            0\n        } else {\n            self.ssthresh\n        };\n        (cc_state, cc_param)\n    }\n}\n","numLines":53,"startLine":60,"totalLines":112}}}
