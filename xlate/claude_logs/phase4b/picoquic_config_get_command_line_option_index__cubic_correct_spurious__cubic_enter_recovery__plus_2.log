{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01TQnNjz3Dr5VegB7WtSfHKN","type":"tool_result","content":"1\t//! Translation of `quic/config.h`.\n2\t//!\n3\t//! Demo-application–facing configuration plumbing for quic-core:\n4\t//! the [`Config`] bag of CLI-derived options, the [`OptionId`]\n5\t//! tag identifying each option, and [`Config::create_and_configure`],\n6\t//! the one-shot constructor that turns a populated config into a\n7\t//! fully-wired [`Quic`].\n8\t//!\n9\t//! Phase 4: all function bodies are implemented.\n10\t//!\n11\t//! Pointer-shape decisions for the config struct were guided by\n12\t//! reading `quic/config.c`:\n13\t//!\n14\t//! * Every `char const*` string field that\n15\t//!   `config_clear` `free`s is owned in C (allocated via\n16\t//!   `config_set_string_param`'s `malloc` + `memcpy`).  These map\n17\t//!   to `Option<String>`; `None` substitutes for the C `NULL`\n18\t//!   sentinel that all callers test before use.\n19\t//! * `multipath_alt_config: *mut char` is owned the same way and\n20\t//!   becomes `Option<String>`.\n21\t//! * `ech_target: uint8_t*` plus `ech_target_len` is owned by the\n22\t//!   config (`config_clear` frees it after the base64\n23\t//!   decode in `option_ECH_client`); it becomes\n24\t//!   `Option<Vec<u8>>` with the length implicit in the vector.\n25\t//! * `ticket_encryption_key: const uint8_t*` is *borrowed* in C —\n26\t//!   `config_clear` does not free it.  Phase 1 stores an\n27\t//!   owned `Option<Vec<u8>>` for safety; in v1 only the demo apps\n28\t//!   set this field, and they can supply an owned buffer.  Phase 3\n29\t//!   may revisit if a caller actually relies on aliasing.  The\n30\t//!   paired `ticket_encryption_key_length` field is dropped — its\n31\t//!   value is always implicit in the Vec length.\n32\t//! * Single-bit `unsigned int : 1` flag bitfields (`use_long_log`,\n33\t//!   `do_retry`, …) collapse to individual `bool` fields.  Every C\n34\t//!   call site reads/writes one bit at a time as a Boolean\n35\t//!   (`config->do_retry = 1`), so the\n36\t//!   integer-with-mask-and-shift translation buys nothing here and\n37\t//!   `bitflags!` is overkill for an unrelated set of flags.\n38\t//! * Bitfield `enable_sslkeylog` is gated by\n39\t//!   `#ifndef WITHOUT_SSLKEYLOG` in C.  v1 follows the\n40\t//!   canonical build (the macro is undefined), so the field is\n41\t//!   always present in Rust; a `cfg`-gated variant lands when the\n42\t//!   build options are translated.\n43\t\n44\tuse crate::Error;\n45\tuse crate::Instant;\n46\tuse crate::internal::MICROSEC_HANDSHAKE_MAX;\n47\tuse crate::{LossbitVersion, Quic, SpinbitVersion, StreamDataCallback};\n48\t\n49\t// ---------------------------------------------------------------------------\n50\t// Option identifiers.\n51\t\n52\t/// One identifier per CLI / API option understood by [`Config`].\n53\t///\n54\t/// Mirrors the C `picoquic_option_enum_t`; variant order is\n55\t/// load-bearing — the option dispatch table in `quic/config.c`\n56\t/// indexes by variant — so the discriminants do not get reordered.\n57\t///\n58\t/// [`OptionId::SslKeyLog`] is unconditional here even though the C\n59\t/// enum gates it on `#ifndef WITHOUT_SSLKEYLOG`, matching the\n60\t/// canonical-build behavior; see the module-level docs for the\n61\t/// rationale.\n62\t#[derive(Debug, Copy, Clone, PartialEq, Eq)]\n63\tpub enum OptionId {\n64\t    Cert,\n65\t    Key,\n66\t    ServerPort,\n67\t    ProposedVersion,\n68\t    OutDir,\n69\t    WwwDir,\n70\t    MaxConnections,\n71\t    DoRetry,\n72\t    InitialRandom,\n73\t    ResetSeed,\n74\t    DisablePortBlocking,\n75\t    SolutionDir,\n76\t    CcAlgo,\n77\t    CcOption,\n78\t    Spinbit,\n79\t    Lossbit,\n80\t    Multipath,\n81\t    DestIf,\n82\t    CipherSuite,\n83\t    InitCnxId,\n84\t    LogFile,\n85\t    LongLog,\n86\t    BinlogDir,\n87\t    QlogDir,\n88\t    MtuMax,\n89\t    Sni,\n90\t    Alpn,\n91\t    RootTrustFile,\n92\t    ForceZeroShare,\n93\t    CnxIdLength,\n94\t    NoDisk,\n95\t    IdleTimeout,\n96\t    LargeClientHello,\n97\t    TicketFileName,\n98\t    TokenFileName,\n99\t    SocketBufferSize,\n100\t    PerformanceLog,\n101\t    PreemptiveRepeat,\n102\t    VersionUpgrade,\n103\t    NoGso,\n104\t    BdpFrame,\n105\t    CwinMax,\n106\t    SslKeyLog,\n107\t    AddressDiscovery,\n108\t    EchServer,\n109\t    EchClient,\n110\t    EchInit,\n111\t    FlowControlMax,\n112\t    PreferredV4,\n113\t    PreferredV6,\n114\t    Help,\n115\t}\n116\t\n117\t// ---------------------------------------------------------------------------\n118\t// Option table (mirrors C static option_table[]).\n119\t\n120\tstruct OptionEntry {\n121\t    id: OptionId,\n122\t    letter: char,\n123\t    name: &'static str,\n124\t    nb_params: usize,\n125\t    param_sample: &'static str,\n126\t    help: &'static str,\n127\t}\n128\t\n129\tstatic OPTION_TABLE: &[OptionEntry] = &[\n130\t    OptionEntry {\n131\t        id: OptionId::Cert,\n132\t        letter: 'c',\n133\t        name: \"cert\",\n134\t        nb_params: 1,\n135\t        param_sample: \"file\",\n136\t        help: \"cert file\",\n137\t    },\n138\t    OptionEntry {\n139\t        id: OptionId::Key,\n140\t        letter: 'k',\n141\t        name: \"key\",\n142\t        nb_params: 1,\n143\t        param_sample: \"file\",\n144\t        help: \"key file\",\n145\t    },\n146\t    OptionEntry {\n147\t        id: OptionId::ServerPort,\n148\t        letter: 'p',\n149\t        name: \"port\",\n150\t        nb_params: 1,\n151\t        param_sample: \"number\",\n152\t        help: \"server port\",\n153\t    },\n154\t    OptionEntry {\n155\t        id: OptionId::ProposedVersion,\n156\t        letter: 'v',\n157\t        name: \"proposed_version\",\n158\t        nb_params: 1,\n159\t        param_sample: \"\",\n160\t        help: \"Version proposed by client, e.g. -v ff000012\",\n161\t    },\n162\t    OptionEntry {\n163\t        id: OptionId::OutDir,\n164\t        letter: 'o',\n165\t        name: \"outdir\",\n166\t        nb_params: 1,\n167\t        param_sample: \"folder\",\n168\t        help: \"Folder where client writes downloaded files, defaults to current directory.\",\n169\t    },\n170\t    OptionEntry {\n171\t        id: OptionId::WwwDir,\n172\t        letter: 'w',\n173\t        name: \"wwwdir\",\n174\t        nb_params: 1,\n175\t        param_sample: \"folder\",\n176\t        help: \"Folder containing web pages served by server\",\n177\t    },\n178\t    OptionEntry {\n179\t        id: OptionId::MaxConnections,\n180\t        letter: 'x',\n181\t        name: \"max_connections\",\n182\t        nb_params: 1,\n183\t        param_sample: \"number\",\n184\t        help: \"Maximum number of concurrent connections, default 256\",\n185\t    },\n186\t    OptionEntry {\n187\t        id: OptionId::DoRetry,\n188\t        letter: 'r',\n189\t        name: \"do_retry\",\n190\t        nb_params: 0,\n191\t        param_sample: \"\",\n192\t        help: \"Do Retry Request\",\n193\t    },\n194\t    OptionEntry {\n195\t        id: OptionId::InitialRandom,\n196\t        letter: 'R',\n197\t        name: \"initial_random\",\n198\t        nb_params: 1,\n199\t        param_sample: \"option\",\n200\t        help: \"Randomize packet number spaces: none(0), initial(1, default), all(2).\",\n201\t    },\n202\t    OptionEntry {\n203\t        id: OptionId::ResetSeed,\n204\t        letter: 's',\n205\t        name: \"reset_seed\",\n206\t        nb_params: 1,\n207\t        param_sample: \"<32 hex chars>\",\n208\t        help: \"Reset seed\",\n209\t    },\n210\t    OptionEntry {\n211\t        id: OptionId::DisablePortBlocking,\n212\t        letter: 'X',\n213\t        name: \"disable_block\",\n214\t        nb_params: 0,\n215\t        param_sample: \"\",\n216\t        help: \"Disable the check for blocked ports\",\n217\t    },\n218\t    OptionEntry {\n219\t        id: OptionId::SolutionDir,\n220\t        letter: 'S',\n221\t        name: \"solution_dir\",\n222\t        nb_params: 1,\n223\t        param_sample: \"folder\",\n224\t        help: \"Set the path to the source files to find the default files\",\n225\t    },\n226\t    OptionEntry {\n227\t        id: OptionId::CcAlgo,\n228\t        letter: 'G',\n229\t        name: \"cc_algo\",\n230\t        nb_params: 1,\n231\t        param_sample: \"cc_algorithm\",\n232\t        help: \"Use the specified congestion control algorithm. Defaults to bbr.\",\n233\t    },\n234\t    OptionEntry {\n235\t        id: OptionId::CcOption,\n236\t        letter: 'H',\n237\t        name: \"cco\",\n238\t        nb_params: 1,\n239\t        param_sample: \"option\",\n240\t        help: \"Set option string if required by congestion control algorithm.\",\n241\t    },\n242\t    OptionEntry {\n243\t        id: OptionId::Spinbit,\n244\t        letter: 'P',\n245\t        name: \"spinbit\",\n246\t        nb_params: 1,\n247\t        param_sample: \"number\",\n248\t        help: \"Set the default spinbit policy\",\n249\t    },\n250\t    OptionEntry {\n251\t        id: OptionId::Lossbit,\n252\t        letter: 'O',\n253\t        name: \"lossbit\",\n254\t        nb_params: 1,\n255\t        param_sample: \"number\",\n256\t        help: \"Set the default lossbit policy\",\n257\t    },\n258\t    OptionEntry {\n259\t        id: OptionId::Multipath,\n260\t        letter: 'M',\n261\t        name: \"multipath\",\n262\t        nb_params: 0,\n263\t        param_sample: \"\",\n264\t        help: \"Enable QUIC multipath extension\",\n265\t    },\n266\t    OptionEntry {\n267\t        id: OptionId::DestIf,\n268\t        letter: 'e',\n269\t        name: \"dest_if\",\n270\t        nb_params: 1,\n271\t        param_sample: \"if\",\n272\t        help: \"Send on interface (default: -1)\",\n273\t    },\n274\t    OptionEntry {\n275\t        id: OptionId::CipherSuite,\n276\t        letter: 'C',\n277\t        name: \"cipher_suite\",\n278\t        nb_params: 1,\n279\t        param_sample: \"cipher_suite_id\",\n280\t        help: \"specify cipher suite (e.g. -C 20 = chacha20)\",\n281\t    },\n282\t    OptionEntry {\n283\t        id: OptionId::InitCnxId,\n284\t        letter: 'i',\n285\t        name: \"cnxid_params\",\n286\t        nb_params: 1,\n287\t        param_sample: \"per-text-lb-spec\",\n288\t        help: \"See documentation for LB compatible CID configuration\",\n289\t    },\n290\t    OptionEntry {\n291\t        id: OptionId::LogFile,\n292\t        letter: 'l',\n293\t        name: \"text_log\",\n294\t        nb_params: 1,\n295\t        param_sample: \"file\",\n296\t        help: \"Log file, Log to stdout if file = \\\"-\\\". No text logging if absent.\",\n297\t    },\n298\t    OptionEntry {\n299\t        id: OptionId::LongLog,\n300\t        letter: 'L',\n301\t        name: \"long_log\",\n302\t        nb_params: 0,\n303\t        param_sample: \"\",\n304\t        help: \"Log all packets. If absent, log stops after 100 packets.\",\n305\t    },\n306\t    OptionEntry {\n307\t        id: OptionId::BinlogDir,\n308\t        letter: 'b',\n309\t        name: \"binlog_dir\",\n310\t        nb_params: 1,\n311\t        param_sample: \"folder\",\n312\t        help: \"Binary logging to this directory. No binary logging if absent.\",\n313\t    },\n314\t    OptionEntry {\n315\t        id: OptionId::QlogDir,\n316\t        letter: 'q',\n317\t        name: \"qlog_dir\",\n318\t        nb_params: 1,\n319\t        param_sample: \"folder\",\n320\t        help: \"Qlog logging to this directory.\",\n321\t    },\n322\t    OptionEntry {\n323\t        id: OptionId::MtuMax,\n324\t        letter: 'm',\n325\t        name: \"mtu_max\",\n326\t        nb_params: 1,\n327\t        param_sample: \"mtu_max\",\n328\t        help: \"Largest mtu value that can be tried for discovery.\",\n329\t    },\n330\t    OptionEntry {\n331\t        id: OptionId::Sni,\n332\t        letter: 'n',\n333\t        name: \"sni\",\n334\t        nb_params: 1,\n335\t        param_sample: \"sni\",\n336\t        help: \"sni (default: server name)\",\n337\t    },\n338\t    OptionEntry {\n339\t        id: OptionId::Alpn,\n340\t        letter: 'a',\n341\t        name: \"alpn\",\n342\t        nb_params: 1,\n343\t        param_sample: \"alpn\",\n344\t        help: \"alpn (default function of version)\",\n345\t    },\n346\t    OptionEntry {\n347\t        id: OptionId::RootTrustFile,\n348\t        letter: 't',\n349\t        name: \"root_trust_file\",\n350\t        nb_params: 1,\n351\t        param_sample: \"file\",\n352\t        help: \"root trust file\",\n353\t    },\n354\t    OptionEntry {\n355\t        id: OptionId::ForceZeroShare,\n356\t        letter: 'z',\n357\t        name: \"force_zero_share\",\n358\t        nb_params: 0,\n359\t        param_sample: \"\",\n360\t        help: \"Set TLS zero share behavior on client, to force HRR\",\n361\t    },\n362\t    OptionEntry {\n363\t        id: OptionId::CnxIdLength,\n364\t        letter: 'I',\n365\t        name: \"cnxid_length\",\n366\t        nb_params: 1,\n367\t        param_sample: \"length\",\n368\t        help: \"Length of CNX_ID used by the client, default=8\",\n369\t    },\n370\t    OptionEntry {\n371\t        id: OptionId::IdleTimeout,\n372\t        letter: 'd',\n373\t        name: \"idle_timeout\",\n374\t        nb_params: 1,\n375\t        param_sample: \"ms\",\n376\t        help: \"Duration of idle timeout in milliseconds (Default 30,000ms)\",\n377\t    },\n378\t    OptionEntry {\n379\t        id: OptionId::NoDisk,\n380\t        letter: 'D',\n381\t        name: \"no_disk\",\n382\t        nb_params: 0,\n383\t        param_sample: \"\",\n384\t        help: \"no disk: do not save received files on disk\",\n385\t    },\n386\t    OptionEntry {\n387\t        id: OptionId::LargeClientHello,\n388\t        letter: 'Q',\n389\t        name: \"large_client_hello\",\n390\t        nb_params: 0,\n391\t        param_sample: \"\",\n392\t        help: \"send a large client hello in order to test post quantum readiness\",\n393\t    },\n394\t    OptionEntry {\n395\t        id: OptionId::TicketFileName,\n396\t        letter: 'T',\n397\t        name: \"ticket_file\",\n398\t        nb_params: 1,\n399\t        param_sample: \"file\",\n400\t        help: \"File storing the session tickets\",\n401\t    },\n402\t    OptionEntry {\n403\t        id: OptionId::TokenFileName,\n404\t        letter: 'N',\n405\t        name: \"token_file\",\n406\t        nb_params: 1,\n407\t        param_sample: \"file\",\n408\t        help: \"File storing the new tokens\",\n409\t    },\n410\t    OptionEntry {\n411\t        id: OptionId::SocketBufferSize,\n412\t        letter: 'B',\n413\t        name: \"so_buf_size\",\n414\t        nb_params: 1,\n415\t        param_sample: \"number\",\n416\t        help: \"Set buffer size with SO_SNDBUF SO_RCVBUF\",\n417\t    },\n418\t    OptionEntry {\n419\t        id: OptionId::PerformanceLog,\n420\t        letter: 'F',\n421\t        name: \"log_file_name\",\n422\t        nb_params: 1,\n423\t        param_sample: \"file\",\n424\t        help: \"Append performance reports to performance log\",\n425\t    },\n426\t    OptionEntry {\n427\t        id: OptionId::PreemptiveRepeat,\n428\t        letter: 'V',\n429\t        name: \"preemptive_repeat\",\n430\t        nb_params: 0,\n431\t        param_sample: \"\",\n432\t        help: \"enable preemptive repeat\",\n433\t    },\n434\t    OptionEntry {\n435\t        id: OptionId::VersionUpgrade,\n436\t        letter: 'U',\n437\t        name: \"version_upgrade\",\n438\t        nb_params: 1,\n439\t        param_sample: \"\",\n440\t        help: \"Version upgrade if server agrees, e.g. -U 6b3343cf\",\n441\t    },\n442\t    OptionEntry {\n443\t        id: OptionId::NoGso,\n444\t        letter: '0',\n445\t        name: \"no_gso\",\n446\t        nb_params: 0,\n447\t        param_sample: \"\",\n448\t        help: \"Do not use UDP GSO or equivalent\",\n449\t    },\n450\t    OptionEntry {\n451\t        id: OptionId::BdpFrame,\n452\t        letter: 'j',\n453\t        name: \"bdp\",\n454\t        nb_params: 1,\n455\t        param_sample: \"number\",\n456\t        help: \"use bdp extension frame(1) or don't (0). Default=0\",\n457\t    },\n458\t    OptionEntry {\n459\t        id: OptionId::CwinMax,\n460\t        letter: 'W',\n461\t        name: \"cwin_max\",\n462\t        nb_params: 1,\n463\t        param_sample: \"bytes\",\n464\t        help: \"Max value for CWIN. Default=UINT64_MAX\",\n465\t    },\n466\t    OptionEntry {\n467\t        id: OptionId::SslKeyLog,\n468\t        letter: '8',\n469\t        name: \"sslkeylog\",\n470\t        nb_params: 0,\n471\t        param_sample: \"\",\n472\t        help: \"Enable SSLKEYLOG\",\n473\t    },\n474\t    OptionEntry {\n475\t        id: OptionId::AddressDiscovery,\n476\t        letter: 'J',\n477\t        name: \"addr_disc\",\n478\t        nb_params: 1,\n479\t        param_sample: \"mode\",\n480\t        help: \"provider (0), receiver (1) or both (2).\",\n481\t    },\n482\t    OptionEntry {\n483\t        id: OptionId::EchServer,\n484\t        letter: 'E',\n485\t        name: \"ech_s\",\n486\t        nb_params: 2,\n487\t        param_sample: \"key config\",\n488\t        help: \"ECH private key file, config file. Default= no ECH on server.\",\n489\t    },\n490\t    OptionEntry {\n491\t        id: OptionId::EchInit,\n492\t        letter: 'y',\n493\t        name: \"ech_init\",\n494\t        nb_params: 1,\n495\t        param_sample: \"public_name\",\n496\t        help: \"Create an ECH configuration before applying the `ech_s` parameter.\",\n497\t    },\n498\t    OptionEntry {\n499\t        id: OptionId::EchClient,\n500\t        letter: 'K',\n501\t        name: \"ech_c\",\n502\t        nb_params: 1,\n503\t        param_sample: \"base64\",\n504\t        help: \"ECH configuration for the client connection, base64 encoded.\",\n505\t    },\n506\t    OptionEntry {\n507\t        id: OptionId::FlowControlMax,\n508\t        letter: 'Z',\n509\t        name: \"flow_control_max\",\n510\t        nb_params: 1,\n511\t        param_sample: \"bytes\",\n512\t        help: \"Set the flow control's initial max data.\",\n513\t    },\n514\t    OptionEntry {\n515\t        id: OptionId::PreferredV4,\n516\t        letter: '4',\n517\t        name: \"preferred_v4\",\n518\t        nb_params: 1,\n519\t        param_sample: \"ip[:port]\",\n520\t        help: \"Preferred address for v4 connections.\",\n521\t    },\n522\t    OptionEntry {\n523\t        id: OptionId::PreferredV6,\n524\t        letter: '6',\n525\t        name: \"preferred_v6\",\n526\t        nb_params: 1,\n527\t        param_sample: \"ipv6[:port]\",\n528\t        help: \"Preferred address for v6 connections.\",\n529\t    },\n530\t    OptionEntry {\n531\t        id: OptionId::Help,\n532\t        letter: 'h',\n533\t        name: \"help\",\n534\t        nb_params: 0,\n535\t        param_sample: \"\",\n536\t        help: \"This help message\",\n537\t    },\n538\t];\n539\t\n540\t/// C: `config_parse_target_version` (picoquic/config.c:116)\n541\t///\n542\t/// Parses a hex-encoded QUIC version number.  Returns 0 on any invalid input,\n543\t/// matching the C behaviour of breaking on the first unrecognised character.\n544\tfn parse_hex_version(s: &str) -> u32 {\n545\t    u32::from_str_radix(s, 16).unwrap_or(0)\n546\t}\n547\t\n548\t/// C: `config_optval_string` (picoquic/config.c:181)\n549\t///\n550\t/// Copies at most `buffer.len() - 1` bytes from `p` into `buffer`,\n551\t/// null-terminates, and returns the filled prefix as a `str`.\n552\t/// Matches the C truncation-and-NUL-terminate contract exactly.\n553\tfn config_optval_string<'a>(buffer: &'a mut [u8], p: &[u8]) -> &'a str {\n554\t    let len = p.len().min(buffer.len().saturating_sub(1));\n555\t    buffer[..len].copy_from_slice(&p[..len]);\n556\t    if !buffer.is_empty() {\n557\t        buffer[len] = 0;\n558\t    }\n559\t    core::str::from_utf8(&buffer[..len]).unwrap_or(\"\")\n560\t}\n561\t\n562\t/// C: `config_optval_param_string` (picoquic/config.c:191)\n563\t///\n564\t/// Bounds-checked wrapper around [`config_optval_string`]: copies\n565\t/// `params[x]` into `buffer` (NUL-terminated, truncated to fit) and\n566\t/// returns the filled prefix.  Writes a single NUL and returns `\"\"` when\n567\t/// `x` is out of bounds — matching the C behaviour for `params == NULL`\n568\t/// or `x < 0 || x >= nb_param`.\n569\t///\n570\t/// In the C implementation this helper exists because `option_param_t`\n571\t/// carries a raw pointer and length that need explicit bounds checking.\n572\t/// The Rust `&[&str]` slice already encodes the length, so the only\n573\t/// real work is the `x >= params.len()` guard.\n574\t#[allow(dead_code)]\n575\tfn config_optval_param_string<'a>(buffer: &'a mut [u8], params: &[&str], x: usize) -> &'a str {\n576\t    if x >= params.len() {\n577\t        if !buffer.is_empty() {\n578\t            buffer[0] = 0;\n579\t        }\n580\t        return \"\";\n581\t    }\n582\t    config_optval_string(buffer, params[x].as_bytes())\n583\t}\n584\t\n585\t/// C: `config_atoi` (picoquic/config.c:202)\n586\t///\n587\t/// Parse a decimal (ASCII digit only) integer from `params[x]`.\n588\t///\n589\t/// Returns `Ok(value)` on success.  Returns `Err(InvalidArgument)` when `x`\n590\t/// is out of bounds or any character in `params[x]` is not an ASCII digit —\n591\t/// mirroring the C behaviour of setting `*ret = -1` and returning `-1` on error.\n592\tpub fn config_atoi(params: &[&str], x: usize) -> Result<i32, Error> {\n593\t    if x >= params.len() {\n594\t        return Err(Error::InvalidArgument);\n595\t    }\n596\t    let mut v: i32 = 0;\n597\t    for b in params[x].bytes() {\n598\t        let digit = b.wrapping_sub(b'0');\n599\t        if digit > 9 {\n600\t            return Err(Error::InvalidArgument);\n601\t        }\n602\t        v = v * 10 + digit as i32;\n603\t    }\n604\t    Ok(v)\n605\t}\n606\t\n607\tfn base64_decode(s: &str) -> Result<Vec<u8>, Error> {\n608\t    let mut table = [0xFFu8; 256];\n609\t    for (i, &c) in b\"ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789+/\"\n610\t        .iter()\n611\t        .enumerate()\n612\t    {\n613\t        table[c as usize] = i as u8;\n614\t    }\n615\t    let bytes: Vec<u8> = s.bytes().filter(|&c| c != b'=').collect();\n616\t    let mut out = Vec::new();\n617\t    for chunk in bytes.chunks(4) {\n618\t        let mut v = [0u8; 4];\n619\t        let n = chunk.len();\n620\t        for (i, &b) in chunk.iter().enumerate() {\n621\t            let x = table[b as usize];\n622\t            if x == 0xFF {\n623\t                return Err(Error::InvalidArgument);\n624\t            }\n625\t            v[i] = x;\n626\t        }\n627\t        out.push((v[0] << 2) | (v[1] >> 4));\n628\t        if n >= 3 {\n629\t            out.push((v[1] << 4) | (v[2] >> 2));\n630\t        }\n631\t        if n == 4 {\n632\t            out.push((v[2] << 6) | v[3]);\n633\t        }\n634\t    }\n635\t    Ok(out)\n636\t}\n637\t\n638\tfn option_entry(id: OptionId) -> Option<&'static OptionEntry> {\n639\t    OPTION_TABLE.iter().find(|e| e.id == id)\n640\t}\n641\t\n642\tfn option_entry_by_letter(letter: char) -> Option<(usize, &'static OptionEntry)> {\n643\t    OPTION_TABLE\n644\t        .iter()\n645\t        .enumerate()\n646\t        .find(|(_, e)| e.letter == letter)\n647\t}\n648\t\n649\tfn option_entry_by_name(name: &str) -> Option<(usize, &'static OptionEntry)> {\n650\t    OPTION_TABLE\n651\t        .iter()\n652\t        .enumerate()\n653\t        .find(|(_, e)| e.name == name)\n654\t}\n655\t\n656\t/// C: `config_set_string_param` (picoquic/config.c:148)\n657\t///\n658\t/// Replace `*v` with an owned copy of `params[x]`.  Clears `*v` first\n659\t/// (mirrors the `free(*v)` in C), then sets it if the selected param\n660\t/// is non-empty.  Returns `Err(InvalidArgument)` when `x` is out of\n661\t/// bounds or the param is empty (the C path where `length == 0` causes\n662\t/// `malloc` to be skipped and `-1` is returned).\n663\t#[allow(dead_code)]\n664\tfn config_set_string_param(v: &mut Option<String>, params: &[&str], x: usize) -> Result<(), Error> {\n665\t    *v = None;\n666\t    if x < params.len() && !params[x].is_empty() {\n667\t        *v = Some(params[x].to_string());\n668\t        Ok(())\n669\t    } else {\n670\t        Err(Error::InvalidArgument)\n671\t    }\n672\t}\n673\t\n674\t/// C: `picoquic_config_get_option_char_index` (picoquic/config.c:641)\n675\t///\n676\t/// Return the index in `OPTION_TABLE` of the entry whose single-character\n677\t/// flag equals `opt`, or `-1` if not found.\n678\tpub fn picoquic_config_get_option_char_index(opt: char) -> i32 {\n679\t    OPTION_TABLE\n680\t        .iter()\n681\t        .position(|e| e.letter == opt)\n682\t        .map_or(-1, |i| i as i32)\n683\t}\n684\t\n685\t/// C: `picoquic_config_get_option_name_index` (picoquic/config.c:654)\n686\t///\n687\t/// Return the index in `OPTION_TABLE` of the first entry whose long name\n688\t/// matches the first `l` bytes of `s` (mirrors `strncmp(s, name, l) == 0`),\n689\t/// or `-1` if not found.\n690\tpub fn picoquic_config_get_option_name_index(s: &str, l: usize) -> i32 {\n691\t    let l = l.min(s.len());\n692\t    let prefix = &s[..l];\n693\t    OPTION_TABLE\n694\t        .iter()\n695\t        .position(|e| e.name.len() >= l && &e.name[..l] == prefix)\n696\t        .map_or(-1, |i| i as i32)\n697\t}\n698\t\n699\t/// C: `config_set_option` (picoquic/config.c:274)\n700\t///\n701\t/// Applies a single option — identified by `entry.id` — to `config`.  Each\n702\t/// arm mirrors the corresponding `case` in the C `switch (option_desc->option_num)`.\n703\t/// Error conditions that C prints to `stderr` via `config_optval_param_string`\n704\t/// are surfaced as `Err(Error::InvalidArgument)` instead; the C `int` return\n705\t/// (`0` / `-1`) maps to `Ok(())` / `Err`.\n706\tfn apply_option(config: &mut Config, entry: &OptionEntry, params: &[&str]) -> Result<(), Error> {\n707\t    let p0 = params.first().copied();\n708\t    let p1 = params.get(1).copied();\n709\t    match entry.id {\n710\t        OptionId::Cert => {\n711\t            config.server_cert_file = Some(p0.ok_or(Error::InvalidArgument)?.to_string());\n712\t        }\n713\t        OptionId::Key => {\n714\t            config.server_key_file = Some(p0.ok_or(Error::InvalidArgument)?.to_string());\n715\t        }\n716\t        OptionId::ServerPort => {\n717\t            config.set_port(p0.ok_or(Error::InvalidArgument)?)?;\n718\t        }\n719\t        OptionId::ProposedVersion => {\n720\t            let v = parse_hex_version(p0.ok_or(Error::InvalidArgument)?);\n721\t            if v == 0 {\n722\t                return Err(Error::InvalidArgument);\n723\t            }\n724\t            config.proposed_version = v;\n725\t        }\n726\t        OptionId::OutDir => {\n727\t            config.out_dir = Some(p0.ok_or(Error::InvalidArgument)?.to_string());\n728\t        }\n729\t        OptionId::WwwDir => {\n730\t            config.www_dir = Some(p0.ok_or(Error::InvalidArgument)?.to_string());\n731\t        }\n732\t        OptionId::MaxConnections => {\n733\t            let v: i32 = p0\n734\t                .ok_or(Error::InvalidArgument)?\n735\t                .parse()\n736\t                .map_err(|_| Error::InvalidArgument)?;\n737\t            if v <= 0 {\n738\t                return Err(Error::InvalidArgument);\n739\t            }\n740\t            config.nb_connections = v as u32;\n741\t        }\n742\t        OptionId::DoRetry => {\n743\t            config.do_retry = true;\n744\t        }\n745\t        OptionId::InitialRandom => {\n746\t            let v: i32 = p0\n747\t                .ok_or(Error::InvalidArgument)?\n748\t                .parse()\n749\t                .map_err(|_| Error::InvalidArgument)?;\n750\t            if !(0..=2).contains(&v) {\n751\t                return Err(Error::InvalidArgument);\n752\t            }\n753\t            config.initial_random = v as u32;\n754\t        }\n755\t        OptionId::ResetSeed => {\n756\t            config.has_reset_seed = true;\n757\t            let n =\n758\t                crate::utils::parse_hexa(p0.ok_or(Error::InvalidArgument)?, &mut config.reset_seed);\n759\t            if n != config.reset_seed.len() {\n760\t                return Err(Error::InvalidArgument);\n761\t            }\n762\t        }\n763\t        OptionId::DisablePortBlocking => {\n764\t            config.disable_port_blocking = true;\n765\t        }\n766\t        OptionId::SslKeyLog => {\n767\t            config.enable_sslkeylog = true;\n768\t        }\n769\t        OptionId::SolutionDir => {\n770\t            config.solution_dir = Some(p0.ok_or(Error::InvalidArgument)?.to_string());\n771\t        }\n772\t        OptionId::CcAlgo => {\n773\t            config.cc_algo_id = Some(p0.ok_or(Error::InvalidArgument)?.to_string());\n774\t        }\n775\t        OptionId::CcOption => {\n776\t            config.cc_algo_option_string = Some(p0.ok_or(Error::InvalidArgument)?.to_string());\n777\t        }\n778\t        OptionId::Spinbit => {\n779\t            let v: i32 = p0\n780\t                .ok_or(Error::InvalidArgument)?\n781\t                .parse()\n782\t                .map_err(|_| Error::InvalidArgument)?;\n783\t            config.spinbit_policy = match v {\n784\t                0 => SpinbitVersion::Basic,\n785\t                1 => SpinbitVersion::Random,\n786\t                2 => SpinbitVersion::Null,\n787\t                3 => SpinbitVersion::On,\n788\t                _ => return Err(Error::InvalidArgument),\n789\t            };\n790\t        }\n791\t        OptionId::Lossbit => {\n792\t            let v: i32 = p0\n793\t                .ok_or(Error::InvalidArgument)?\n794\t                .parse()\n795\t                .map_err(|_| Error::InvalidArgument)?;\n796\t            config.lossbit_policy = match v {\n797\t                0 => LossbitVersion::None,\n798\t                1 => LossbitVersion::SendOnly,\n799\t                2 => LossbitVersion::SendReceive,\n800\t                _ => return Err(Error::InvalidArgument),\n801\t            };\n802\t        }\n803\t        OptionId::Multipath => {\n804\t            config.multipath_option = 1;\n805\t        }\n806\t        OptionId::DestIf => {\n807\t            config.dest_if = p0\n808\t                .ok_or(Error::InvalidArgument)?\n809\t                .parse()\n810\t                .map_err(|_| Error::InvalidArgument)?;\n811\t        }\n812\t        OptionId::CipherSuite => {\n813\t            config.cipher_suite_id = p0\n814\t                .ok_or(Error::InvalidArgument)?\n815\t                .parse()\n816\t                .map_err(|_| Error::InvalidArgument)?;\n817\t        }\n818\t        OptionId::InitCnxId => {\n819\t            config.connection_id_cbdata = Some(p0.ok_or(Error::InvalidArgument)?.to_string());\n820\t        }\n821\t        OptionId::LogFile => {\n822\t            config.log_file = Some(p0.ok_or(Error::InvalidArgument)?.to_string());\n823\t        }\n824\t        OptionId::LongLog => {\n825\t            config.use_long_log = true;\n826\t        }\n827\t        OptionId::BinlogDir => {\n828\t            config.bin_dir = Some(p0.ok_or(Error::InvalidArgument)?.to_string());\n829\t        }\n830\t        OptionId::QlogDir => {\n831\t            config.qlog_dir = Some(p0.ok_or(Error::InvalidArgument)?.to_string());\n832\t        }\n833\t        OptionId::MtuMax => {\n834\t            let v: i32 = p0\n835\t                .ok_or(Error::InvalidArgument)?\n836\t                .parse()\n837\t                .map_err(|_| Error::InvalidArgument)?;\n838\t            if v <= 0 || v > crate::internal::MAX_PACKET_SIZE as i32 {\n839\t                return Err(Error::InvalidArgument);\n840\t            }\n841\t            config.mtu_max = v;\n842\t        }\n843\t        OptionId::Sni => {\n844\t            config.sni = Some(p0.ok_or(Error::InvalidArgument)?.to_string());\n845\t        }\n846\t        OptionId::Alpn => {\n847\t            config.alpn = Some(p0.ok_or(Error::InvalidArgument)?.to_string());\n848\t        }\n849\t        OptionId::RootTrustFile => {\n850\t            config.root_trust_file = Some(p0.ok_or(Error::InvalidArgument)?.to_string());\n851\t        }\n852\t        OptionId::ForceZeroShare => {\n853\t            config.force_zero_share = true;\n854\t        }\n855\t        OptionId::CnxIdLength => {\n856\t            let v: i32 = p0\n857\t                .ok_or(Error::InvalidArgument)?\n858\t                .parse()\n859\t                .map_err(|_| Error::InvalidArgument)?;\n860\t            if v < 0 || v > crate::CONNECTION_ID_MAX_SIZE as i32 {\n861\t                return Err(Error::InvalidArgument);\n862\t            }\n863\t            config.connection_id_length = v;\n864\t        }\n865\t        OptionId::IdleTimeout => {\n866\t            let v: i32 = p0\n867\t                .ok_or(Error::InvalidArgument)?\n868\t                .parse()\n869\t                .map_err(|_| Error::InvalidArgument)?;\n870\t            if v < 0 {\n871\t                return Err(Error::InvalidArgument);\n872\t            }\n873\t            config.idle_timeout = v;\n874\t        }\n875\t        OptionId::NoDisk => {\n876\t            config.no_disk = true;\n877\t        }\n878\t        OptionId::LargeClientHello => {\n879\t            config.large_client_hello = true;\n880\t        }\n881\t        OptionId::TicketFileName => {\n882\t            config.ticket_file_name = Some(p0.ok_or(Error::InvalidArgument)?.to_string());\n883\t        }\n884\t        OptionId::TokenFileName => {\n885\t            config.token_file_name = Some(p0.ok_or(Error::InvalidArgument)?.to_string());\n886\t        }\n887\t        OptionId::SocketBufferSize => {\n888\t            let v: i32 = p0\n889\t                .ok_or(Error::InvalidArgument)?\n890\t                .parse()\n891\t                .map_err(|_| Error::InvalidArgument)?;\n892\t            if v < 0 {\n893\t                return Err(Error::InvalidArgument);\n894\t            }\n895\t            config.socket_buffer_size = v;\n896\t        }\n897\t        OptionId::PerformanceLog => {\n898\t            config.performance_log = Some(p0.ok_or(Error::InvalidArgument)?.to_string());\n899\t        }\n900\t        OptionId::PreemptiveRepeat => {\n901\t            config.do_preemptive_repeat = true;\n902\t        }\n903\t        OptionId::VersionUpgrade => {\n904\t            let v = parse_hex_version(p0.ok_or(Error::InvalidArgument)?);\n905\t            if v == 0 {\n906\t                return Err(Error::InvalidArgument);\n907\t            }\n908\t            config.desired_version = v;\n909\t        }\n910\t        OptionId::NoGso => {\n911\t            config.do_not_use_gso = true;\n912\t        }\n913\t        OptionId::BdpFrame => {\n914\t            let v: i32 = p0\n915\t                .ok_or(Error::InvalidArgument)?\n916\t                .parse()\n917\t                .map_err(|_| Error::InvalidArgument)?;\n918\t            if !(0..=1).contains(&v) {\n919\t                return Err(Error::InvalidArgument);\n920\t            }\n921\t            config.bdp_frame_option = v;\n922\t        }\n923\t        OptionId::CwinMax => {\n924\t            let v: i64 = p0\n925\t                .ok_or(Error::InvalidArgument)?\n926\t                .parse()\n927\t                .map_err(|_| Error::InvalidArgument)?;\n928\t            if v < 0 {\n929\t                return Err(Error::InvalidArgument);\n930\t            }\n931\t            config.cwin_max = if v == 0 { u64::MAX } else { v as u64 };\n932\t        }\n933\t        OptionId::AddressDiscovery => {\n934\t            let v: i32 = p0\n935\t                .ok_or(Error::InvalidArgument)?\n936\t                .parse()\n937\t                .map_err(|_| Error::InvalidArgument)?;\n938\t            if !(0..=2).contains(&v) {\n939\t                return Err(Error::InvalidArgument);\n940\t            }\n941\t            config.address_discovery_mode = v + 1;\n942\t        }\n943\t        OptionId::EchServer => {\n944\t            config.ech_key_file = Some(p0.ok_or(Error::InvalidArgument)?.to_string());\n945\t            if let Some(s) = p1 {\n946\t                config.ech_config_file = Some(s.to_string());\n947\t            }\n948\t        }\n949\t        OptionId::EchInit => {\n950\t            config.ech_public_name = Some(p0.ok_or(Error::InvalidArgument)?.to_string());\n951\t        }\n952\t        OptionId::EchClient => {\n953\t            let s = p0.ok_or(Error::InvalidArgument)?;\n954\t            if s == \"-\" {\n955\t                config.ech_target = None;\n956\t            } else {\n957\t                config.ech_target = Some(base64_decode(s).map_err(|_| Error::InvalidArgument)?);\n958\t            }\n959\t        }\n960\t        OptionId::FlowControlMax => {\n961\t            let v: i64 = p0\n962\t                .ok_or(Error::InvalidArgument)?\n963\t                .parse()\n964\t                .map_err(|_| Error::InvalidArgument)?;\n965\t            if v < 0 {\n966\t                return Err(Error::InvalidArgument);\n967\t            }\n968\t            config.flow_control_max = v as u64;\n969\t        }\n970\t        OptionId::PreferredV4 => {\n971\t            config.preferred_address_v4 = Some(p0.ok_or(Error::InvalidArgument)?.to_string());\n972\t        }\n973\t        OptionId::PreferredV6 => {\n974\t            config.preferred_address_v6 = Some(p0.ok_or(Error::InvalidArgument)?.to_string());\n975\t        }\n976\t        OptionId::Help => {\n977\t            return Err(Error::InvalidArgument);\n978\t        }\n979\t    }\n980\t    Ok(())\n981\t}\n982\t\n983\tfn collect_params<'a>(\n984\t    entry: &OptionEntry,\n985\t    p_optind: &mut usize,\n986\t    argv: &[&'a str],\n987\t    optarg: Option<&'a str>,\n988\t) -> Result<Vec<&'a str>, Error> {\n989\t    let mut params = Vec::new();\n990\t    if entry.nb_params > 0 {\n991\t        params.push(optarg.ok_or(Error::InvalidArgument)?);\n992\t        let mut nb = 1;\n993\t        while nb < entry.nb_params {\n994\t            if *p_optind >= argv.len() {\n995\t                return Err(Error::InvalidArgument);\n996\t            }\n997\t            params.push(argv[*p_optind]);\n998\t            *p_optind += 1;\n999\t            nb += 1;\n1000\t        }\n1001\t    }\n1002\t    Ok(params)\n1003\t}\n1004\t\n1005\tfn parse_option_string(opt_string: &str) -> Option<(usize, &'static OptionEntry)> {\n1006\t    if opt_string.starts_with(\"--\") && opt_string.len() > 2 {\n1007\t        option_entry_by_name(&opt_string[2..])\n1008\t    } else if opt_string.starts_with('-') && opt_string.len() == 2 {\n1009\t        opt_string.chars().nth(1).and_then(option_entry_by_letter)\n1010\t    } else {\n1011\t        None\n1012\t    }\n1013\t}\n1014\t\n1015\t// ---------------------------------------------------------------------------\n1016\t// Configuration struct.\n1017\t\n1018\t/// Configuration bag for a QUIC context, populated from CLI flags\n1019\t/// (via [`Config::command_line`]) or directly (via\n1020\t/// [`Config::set_option`]) and consumed by\n1021\t/// [`Config::create_and_configure`].\n1022\t///\n1023\t/// Mirrors the C `picoquic_quic_config_t` field-for-field;\n1024\t/// `repr(C)` is dropped because the struct never crosses an\n1025\t/// external boundary.  See the module-level docs for the\n1026\t/// pointer-shape rationale.\n1027\t///\n1028\t/// `Default` produces the documented C defaults:\n1029\t/// `nb_connections = 256`, `connection_id_length = -1`, `cwin_max =\n1030\t/// u64::MAX`, idle timeout from `MICROSEC_HANDSHAKE_MAX`, etc.  This\n1031\t/// folds the C `picoquic_config_init` step into the constructor —\n1032\t/// the C `config_clear` (which `free`s every owned string) collapses\n1033\t/// to `Drop`, and resetting a config to defaults is just\n1034\t/// `*config = Config::default()`.\n1035\t#[derive(Debug)]\n1036\tpub struct Config {\n1037\t    pub nb_connections: u32,\n1038\t    pub solution_dir: Option<String>,\n1039\t    pub server_cert_file: Option<String>,\n1040\t    pub server_key_file: Option<String>,\n1041\t    pub log_file: Option<String>,\n1042\t    pub bin_dir: Option<String>,\n1043\t    pub qlog_dir: Option<String>,\n1044\t    pub performance_log: Option<String>,\n1045\t    pub server_port: u16,\n1046\t    pub local_port: u16,\n1047\t    /// Whether the public port is shared with sibling threads\n1048\t    /// (`SO_REUSEPORT`).  C: `int is_port_shared`, used as a\n1049\t    /// Boolean flag.\n1050\t    pub is_port_shared: bool,\n1051\t    pub nb_threads: i32,\n1052\t    pub dest_if: i32,\n1053\t    pub mtu_max: i32,\n1054\t    /// `-1` is the C \"unset\" sentinel applied by [`Self::init`];\n1055\t    /// values `>= 0` set the connection-ID length explicitly.  Kept\n1056\t    /// as `i32` rather than `Option<u8>` for source-level parity\n1057\t    /// with the C body.\n1058\t    pub connection_id_length: i32,\n1059\t    pub idle_timeout: i32,\n1060\t    pub socket_buffer_size: i32,\n1061\t    pub cc_algo_id: Option<String>,\n1062\t    pub cc_algo_option_string: Option<String>,\n1063\t    pub connection_id_cbdata: Option<String>,\n1064\t    pub spinbit_policy: SpinbitVersion,\n1065\t    pub lossbit_policy: LossbitVersion,\n1066\t    pub multipath_option: i32,\n1067\t    pub multipath_alt_config: Option<String>,\n1068\t    pub bdp_frame_option: i32,\n1069\t    pub cwin_max: u64,\n1070\t    pub address_discovery_mode: i32,\n1071\t\n1072\t    // Common flags.\n1073\t    pub initial_random: u32,\n1074\t    pub use_long_log: bool,\n1075\t    pub do_preemptive_repeat: bool,\n1076\t    pub do_not_use_gso: bool,\n1077\t    pub disable_port_blocking: bool,\n1078\t    /// Originally bitfield-gated by `#ifndef\n1079\t    /// WITHOUT_SSLKEYLOG`; v1 follows the canonical build\n1080\t    /// (always defined), so the field is unconditional here.\n1081\t    pub enable_sslkeylog: bool,\n1082\t\n1083\t    // Server only.\n1084\t    pub www_dir: Option<String>,\n1085\t    pub reset_seed: [u8; 16],\n1086\t    /// Borrowed in C (`config_clear` does not free it); owned\n1087\t    /// `Vec<u8>` here for safety.  The C\n1088\t    /// `ticket_encryption_key_length` field is dropped — its value\n1089\t    /// is always `ticket_encryption_key.as_ref().map_or(0, Vec::len)`.\n1090\t    pub ticket_encryption_key: Option<Vec<u8>>,\n1091\t\n1092\t    // Server flags.\n1093\t    pub do_retry: bool,\n1094\t    pub has_reset_seed: bool,\n1095\t\n1096\t    // Client only.\n1097\t    pub ticket_file_name: Option<String>,\n1098\t    pub token_file_name: Option<String>,\n1099\t    pub sni: Option<String>,\n1100\t    pub alpn: Option<String>,\n1101\t    pub out_dir: Option<String>,\n1102\t    pub root_trust_file: Option<String>,\n1103\t    pub cipher_suite_id: i32,\n1104\t    pub proposed_version: u32,\n1105\t    pub desired_version: u32,\n1106\t    pub force_zero_share: bool,\n1107\t    pub no_disk: bool,\n1108\t    pub large_client_hello: bool,\n1109\t\n1110\t    // ECH parameters for server.\n1111\t    pub ech_key_file: Option<String>,\n1112\t    pub ech_config_file: Option<String>,\n1113\t    pub ech_public_name: Option<String>,\n1114\t    /// ECH parameter for the client, base64-decoded.  Owned by\n1115\t    /// the config — `config_clear` frees it in C.  The C\n1116\t    /// `ech_target_len` field is dropped — its value is always\n1117\t    /// `ech_target.as_ref().map_or(0, Vec::len)`.\n1118\t    pub ech_target: Option<Vec<u8>>,\n1119\t\n1120\t    pub flow_control_max: u64,\n1121\t\n1122\t    // Preferred address, encoded as strings.\n1123\t    pub preferred_address_v4: Option<String>,\n1124\t    pub preferred_address_v6: Option<String>,\n1125\t}\n1126\t\n1127\timpl Default for Config {\n1128\t    /// Build a fresh config with the documented C defaults.  C:\n1129\t    /// `picoquic_config_init` (which the C body invoked after a\n1130\t    /// zero-initialising `memset`).\n1131\t    fn default() -> Self {\n1132\t        Config {\n1133\t            nb_connections: 256,\n1134\t            solution_dir: None,\n1135\t            server_cert_file: None,\n1136\t            server_key_file: None,\n1137\t            log_file: None,\n1138\t            bin_dir: None,\n1139\t            qlog_dir: None,\n1140\t            performance_log: None,\n1141\t            server_port: 0,\n1142\t            local_port: 0,\n1143\t            is_port_shared: false,\n1144\t            nb_threads: 0,\n1145\t            dest_if: 0,\n1146\t            mtu_max: 0,\n1147\t            connection_id_length: -1,\n1148\t            idle_timeout: (MICROSEC_HANDSHAKE_MAX.ticks() / 1000) as i32,\n1149\t            socket_buffer_size: 0,\n1150\t            cc_algo_id: None,\n1151\t            cc_algo_option_string: None,\n1152\t            connection_id_cbdata: None,\n1153\t            spinbit_policy: SpinbitVersion::default(),\n1154\t            lossbit_policy: LossbitVersion::default(),\n1155\t            multipath_option: 0,\n1156\t            multipath_alt_config: None,\n1157\t            bdp_frame_option: 0,\n1158\t            cwin_max: u64::MAX,\n1159\t            address_discovery_mode: 0,\n1160\t            initial_random: 3,\n1161\t            use_long_log: false,\n1162\t            do_preemptive_repeat: false,\n1163\t            do_not_use_gso: false,\n1164\t            disable_port_blocking: false,\n1165\t            enable_sslkeylog: false,\n1166\t            www_dir: None,\n1167\t            reset_seed: [0; 16],\n1168\t            ticket_encryption_key: None,\n1169\t            do_retry: false,\n1170\t            has_reset_seed: false,\n1171\t            ticket_file_name: None,\n1172\t            token_file_name: None,\n1173\t            sni: None,\n1174\t            alpn: None,\n1175\t            out_dir: None,\n1176\t            root_trust_file: None,\n1177\t            cipher_suite_id: 0,\n1178\t            proposed_version: 0,\n1179\t            desired_version: 0,\n1180\t            force_zero_share: false,\n1181\t            no_disk: false,\n1182\t            large_client_hello: false,\n1183\t            ech_key_file: None,\n1184\t            ech_config_file: None,\n1185\t            ech_public_name: None,\n1186\t            ech_target: None,\n1187\t            flow_control_max: 0,\n1188\t            preferred_address_v4: None,\n1189\t            preferred_address_v6: None,\n1190\t        }\n1191\t    }\n1192\t}\n1193\t\n1194\timpl Config {\n1195\t    /// C: `picoquic_config_clear` (picoquic/config.c:1046)\n1196\t    ///\n1197\t    /// Frees all owned fields and resets every member to the defaults that\n1198\t    /// [`Config::default`] produces.  In the C version each `const char*`\n1199\t    /// field is individually `free`d and then `picoquic_config_init` is\n1200\t    /// called; in Rust the old values are dropped automatically when the\n1201\t    /// struct is overwritten, so the entire operation collapses to a single\n1202\t    /// assignment.\n1203\t    pub fn clear(&mut self) {\n1204\t        *self = Config::default();\n1205\t    }\n1206\t\n1207\t    /// Apply one option, selected by `option`, to the config.\n1208\t    /// C: `picoquic_config_set_option`.\n1209\t    ///\n1210\t    /// `value` is optional — flag-style options ([`OptionId::DoRetry`],\n1211\t    /// [`OptionId::LongLog`], …) ignore it; value-style options\n1212\t    /// require it and return `Err` when it is missing or malformed.\n1213\t    ///\n1214\t    /// The C signature returned `int` (`0` ↔ `Ok`, `-1` ↔ `Err`);\n1215\t    /// mapped to `Result<(), Error>`.\n1216\t    pub fn set_option(&mut self, option: OptionId, value: Option<&str>) -> Result<(), Error> {\n1217\t        let entry = option_entry(option).ok_or(Error::InvalidArgument)?;\n1218\t        let params: &[&str] = match value {\n1219\t            Some(v) => &[v],\n1220\t            None => &[],\n1221\t        };\n1222\t        apply_option(self, entry, params)\n1223\t    }\n1224\t\n1225\t    /// Dispatch one option from a single-character flag (`-x`).\n1226\t    /// C: `picoquic_config_command_line`.\n1227\t    ///\n1228\t    /// `p_optind` advances past any extra arguments consumed beyond\n1229\t    /// the inline `optarg`, mirroring the C in/out parameter so that\n1230\t    /// an outer getopt-style loop stays in sync.\n1231\t    ///\n1232\t    /// `argv` is a borrowed slice of borrowed strings — the C caller\n1233\t    /// (`first` etc.) owns the argument vector for the program\n1234\t    /// lifetime, so a borrow is safe.  The C `int argc` parameter is\n1235\t    /// dropped (implicit in `argv.len()`).\n1236\t    pub fn command_line(\n1237\t        &mut self,\n1238\t        opt: char,\n1239\t        p_optind: &mut usize,\n1240\t        argv: &[&str],\n1241\t        optarg: Option<&str>,\n1242\t    ) -> Result<(), Error> {\n1243\t        let (_, entry) = option_entry_by_letter(opt).ok_or(Error::InvalidArgument)?;\n1244\t        let params = collect_params(entry, p_optind, argv, optarg)?;\n1245\t        apply_option(self, entry, &params)\n1246\t    }\n1247\t\n1248\t    /// Like [`Self::command_line`] but accepts both single-character\n1249\t    /// (`-x`) and long-form (`--name`) option strings; the leading\n1250\t    /// dashes are part of `opt_string`, matching the C contract.\n1251\t    /// C: `picoquic_config_command_line_ex`.\n1252\t    pub fn command_line_ex(\n1253\t        &mut self,\n1254\t        opt_string: &str,\n1255\t        p_optind: &mut usize,\n1256\t        argv: &[&str],\n1257\t        optarg: Option<&str>,\n1258\t    ) -> Result<(), Error> {\n1259\t        let (_, entry) = parse_option_string(opt_string).ok_or(Error::InvalidArgument)?;\n1260\t        let params = collect_params(entry, p_optind, argv, optarg)?;\n1261\t        apply_option(self, entry, &params)\n1262\t    }\n1263\t\n1264\t    /// Build the getopt-style option string from the dispatch table\n1265\t    /// in `config.c` — one letter per option, with `:` after each\n1266\t    /// option that takes an argument.  C:\n1267\t    /// `picoquic_config_option_letters`.\n1268\t    ///\n1269\t    /// The C signature wrote into a caller-supplied buffer\n1270\t    /// (`option_string`, `string_max`) and reported the populated\n1271\t    /// length via `*string_length`.  The Rust wrapper owns the\n1272\t    /// buffer and returns it directly, so the buffer-too-small\n1273\t    /// failure mode disappears.\n1274\t    pub fn option_letters() -> String {\n1275\t        let mut s = String::new();\n1276\t        for e in OPTION_TABLE {\n1277\t            s.push(e.letter);\n1278\t            if e.nb_params > 0 {\n1279\t                s.push(':');\n1280\t            }\n1281\t        }\n1282\t        s\n1283\t    }\n1284\t\n1285\t    /// Write the option help to a [`core::fmt::Write`] sink.\n1286\t    /// C: `picoquic_config_usage_file`.\n1287\t    ///\n1288\t    /// The C parameter was `FILE*`; the Rust translation accepts\n1289\t    /// any sink (a `String` buffer, the stdout/stderr handles under\n1290\t    /// the `std` feature, or a custom writer) so the function\n1291\t    /// stays `no_std`-friendly.\n1292\t    pub fn write_usage(w: &mut dyn core::fmt::Write) {\n1293\t        let _ = w.write_str(\"Picoquic options:\\n\");\n1294\t        for e in OPTION_TABLE {\n1295\t            let _ = write!(w, \"  -{} {}\", e.letter, e.param_sample);\n1296\t            let pad = 12usize.saturating_sub(e.param_sample.len());\n1297\t            for _ in 0..pad {\n1298\t                let _ = w.write_char(' ');\n1299\t            }\n1300\t            let _ = writeln!(w, \" {}\", e.help);\n1301\t        }\n1302\t    }\n1303\t\n1304\t    /// Print the option help to stderr.  C: `picoquic_config_usage`.\n1305\t    ///\n1306\t    /// Routes through an intermediate `String` buffer then `eprint!`.\n1307\t    pub fn print_usage() {\n1308\t        let mut buf = String::new();\n1309\t        Self::write_usage(&mut buf);\n1310\t        eprint!(\"{}\", buf);\n1311\t    }\n1312\t\n1313\t    /// Parse a port-configuration string into `server_port`,\n1314\t    /// `local_port`, `is_port_shared`, and `nb_threads`.\n1315\t    /// C: `config_set_port` (internal, called from the `-p` option\n1316\t    /// handler in `picoquic/config.c`).\n1317\t    ///\n1318\t    /// Accepted formats:\n1319\t    /// - `\"\"` / `\"0\"` — clear all (port 0, not shared)\n1320\t    /// - `\"4433\"` — server port only\n1321\t    /// - `\"443:4434\"` — server:local\n1322\t    /// - `\"S4433\"` — shared server port\n1323\t    /// - `\"S443:4434*256\"` — shared server:local, 256 threads\n1324\t    /// - `\"4433*7\"` — server port, 7 threads\n1325\t    ///\n1326\t    /// Returns `Err` when any token cannot be parsed or a port value\n1327\t    /// exceeds 65535.\n1328\t    pub fn set_port(&mut self, port_string: &str) -> Result<(), Error> {\n1329\t        let bytes = port_string.as_bytes();\n1330\t        let mut i = 0;\n1331\t        let mut is_port_shared = false;\n1332\t        let mut p1: i32 = 0;\n1333\t        let mut p2: i32 = 0;\n1334\t        let mut nb_threads: i32 = 0;\n1335\t\n1336\t        if i < bytes.len() && bytes[i] == b'S' {\n1337\t            is_port_shared = true;\n1338\t            i += 1;\n1339\t        }\n1340\t        while i < bytes.len() && bytes[i].is_ascii_digit() {\n1341\t            p1 = p1 * 10 + (bytes[i] - b'0') as i32;\n1342\t            i += 1;\n1343\t        }\n1344\t        if i < bytes.len() && bytes[i] == b':' {\n1345\t            i += 1;\n1346\t            while i < bytes.len() && bytes[i].is_ascii_digit() {\n1347\t                p2 = p2 * 10 + (bytes[i] - b'0') as i32;\n1348\t                i += 1;\n1349\t            }\n1350\t        }\n1351\t        if i < bytes.len() && bytes[i] == b'*' {\n1352\t            i += 1;\n1353\t            while i < bytes.len() && bytes[i].is_ascii_digit() {\n1354\t                nb_threads = nb_threads * 10 + (bytes[i] - b'0') as i32;\n1355\t                i += 1;\n1356\t            }\n1357\t        }\n1358\t        if i != bytes.len() || !(0..=65535).contains(&p1) || !(0..=65535).contains(&p2) {\n1359\t            return Err(Error::InvalidArgument);\n1360\t        }\n1361\t        self.server_port = p1 as u16;\n1362\t        self.local_port = p2 as u16;\n1363\t        self.is_port_shared = is_port_shared;\n1364\t        self.nb_threads = nb_threads;\n1365\t        Ok(())\n1366\t    }\n1367\t\n1368\t    /// Build a fully-configured QUIC context from this config plus\n1369\t    /// an application-supplied callback.  C:\n1370\t    /// `picoquic_create_and_configure`.\n1371\t    ///\n1372\t    /// Returns `None` when context creation fails (the C side\n1373\t    /// returned `NULL`).\n1374\t    ///\n1375\t    /// Pointer-shape choices, derived from the C signature and the\n1376\t    /// body in `config.c`:\n1377\t    ///\n1378\t    /// * `picoquic_quic_config_t* config` is consumed-borrowed\n1379\t    ///   (`&mut self`): the body reads every field and may set up\n1380\t    ///   downstream owned state, but it does not free the struct\n1381\t    ///   itself — ownership stays with the caller.\n1382\t    /// * `default_callback_fn` + `default_callback_ctx` collapse to\n1383\t    ///   one `Option<Box<dyn StreamDataCallback>>` per the\n1384\t    ///   function-pointers-map-to-traits rule, with the `void*`\n1385\t    ///   context folded into the trait implementor's state.  `None`\n1386\t    ///   matches the C \"no default callback\" case where the function\n1387\t    ///   pointer was `NULL`.\n1388\t    /// * `p_simulated_time: *mut u64` carries simulated wall time for\n1389\t    ///   tests; the C QUIC context retains the pointer across calls,\n1390\t    ///   so an `&mut u64` borrow expresses the contract directly.\n1391\t    ///   Phase 3 may revisit (e.g. with a clock trait) once the QUIC\n1392\t    ///   context type is real.\n1393\t    pub fn create_and_configure(\n1394\t        &mut self,\n1395\t        default_callback: Option<Box<dyn StreamDataCallback>>,\n1396\t        current_time: Instant,\n1397\t        _p_simulated_time: Option<&mut u64>,\n1398\t    ) -> Option<Box<Quic>> {\n1399\t        let reset_seed = if self.has_reset_seed {\n1400\t            self.reset_seed\n1401\t        } else {\n1402\t            [0u8; 16]\n1403\t        };\n1404\t\n1405\t        let mut quic = Quic::new(\n1406\t            self.nb_connections,\n1407\t            self.server_cert_file.as_deref(),\n1408\t            self.server_key_file.as_deref(),\n1409\t            self.root_trust_file.as_deref(),\n1410\t            self.alpn.as_deref(),\n1411\t            default_callback,\n1412\t            None,\n1413\t            reset_seed,\n1414\t            current_time,\n1415\t            self.ticket_file_name.as_deref(),\n1416\t            self.ticket_encryption_key.as_deref(),\n1417\t        )?;\n1418\t\n1419\t        if self.do_retry {\n1420\t            quic.set_cookie_mode(1);\n1421\t        } else {\n1422\t            quic.set_cookie_mode(2);\n1423\t        }\n1424\t\n1425\t        if let Some(ref cc_id) = self.cc_algo_id {\n1426\t            let _ = quic.set_default_congestion_algorithm_by_name(cc_id);\n1427\t        }\n1428\t\n1429\t        let _ = quic.set_default_spinbit_policy(self.spinbit_policy);\n1430\t        quic.set_default_lossbit_policy(self.lossbit_policy);\n1431\t        quic.set_default_multipath_option(self.multipath_option);\n1432\t        quic.set_default_idle_timeout(crate::Duration::from_ticks(self.idle_timeout as u64 * 1000));\n1433\t        quic.set_cwin_max(self.cwin_max);\n1434\t        quic.set_default_address_discovery_mode(self.address_discovery_mode);\n1435\t\n1436\t        if let Some(ref token_file) = self.token_file_name {\n1437\t            let _ = quic.load_retry_tokens(token_file);\n1438\t        }\n1439\t\n1440\t        if self.force_zero_share {\n1441\t            quic.client_zero_share = true;\n1442\t        }\n1443\t\n1444\t        if self.mtu_max > 0 {\n1445\t            quic.set_mtu_max(self.mtu_max as u32);\n1446\t        }\n1447\t\n1448\t        if self.connection_id_length != -1 {\n1449\t            let _ = quic.set_default_connection_id_length(self.connection_id_length as u8);\n1450\t        }\n1451\t\n1452\t        quic.set_padding_policy(39, 128);\n1453\t\n1454\t        if let Some(ref bin_dir) = self.bin_dir {\n1455\t            let _ = quic.set_binlog(Some(bin_dir.as_str()));\n1456\t        }\n1457\t\n1458\t        if let Some(ref qlog_dir) = self.qlog_dir {\n1459\t            let _ = quic.set_qlog(qlog_dir.as_str());\n1460\t        }\n1461\t\n1462\t        if let Some(ref log_file) = self.log_file {\n1463\t            let _ = quic.set_textlog(Some(log_file.as_str()));\n1464\t        }\n1465\t\n1466\t        quic.set_log_level(if self.use_long_log { 1 } else { 0 });\n1467\t        quic.set_preemptive_repeat_policy(self.do_preemptive_repeat);\n1468\t        quic.set_port_blocking_disabled(self.disable_port_blocking);\n1469\t        quic.set_sslkeylog_enabled(self.enable_sslkeylog);\n1470\t\n1471\t        if self.initial_random <= 2 {\n1472\t            quic.set_random_initial(self.initial_random as i32);\n1473\t        }\n1474\t\n1475\t        if self.cipher_suite_id != 0 {\n1476\t            let iana_code = match self.cipher_suite_id {\n1477\t                20 => crate::CHACHA20_POLY1305_SHA256,\n1478\t                128 => crate::AES_128_GCM_SHA256,\n1479\t                256 => crate::AES_256_GCM_SHA384,\n1480\t                v => v as u16,\n1481\t            };\n1482\t            let _ = quic.set_cipher_suite(iana_code);\n1483\t        }\n1484\t\n1485\t        if self.do_retry {\n1486\t            quic.set_cookie_mode(1);\n1487\t        } else {\n1488\t            quic.set_cookie_mode(2);\n1489\t        }\n1490\t\n1491\t        quic.set_default_bdp_frame_option(self.bdp_frame_option != 0);\n1492\t\n1493\t        let mut failed = false;\n1494\t\n1495\t        if let Some(ref public_name) = self.ech_public_name {\n1496\t            if self.ech_key_file.is_none() || self.ech_config_file.is_none() {\n1497\t                // key file or config file not specified — cannot create ECH config\n1498\t            } else {\n1499\t                let key_file = self.ech_key_file.as_deref().unwrap();\n1500\t                let cfg_file = self.ech_config_file.as_deref().unwrap();\n1501\t                if crate::ech_create_config_file(public_name, key_file, cfg_file).is_err() {\n1502\t                    failed = true;\n1503\t                }\n1504\t            }\n1505\t        }\n1506\t\n1507\t        if !failed\n1508\t            && (self.ech_key_file.is_some() || self.ech_target.is_some())\n1509\t            && quic\n1510\t                .ech_configure(\n1511\t                    self.ech_key_file.as_deref(),\n1512\t                    self.ech_config_file.as_deref(),\n1513\t                )\n1514\t                .is_err()\n1515\t        {\n1516\t            failed = true;\n1517\t        }\n1518\t\n1519\t        if !failed && self.flow_control_max > 0 {\n1520\t            quic.set_max_data_control(self.flow_control_max);\n1521\t        }\n1522\t\n1523\t        if failed { None } else { Some(quic) }\n1524\t    }\n1525\t}\n1526\t\n1527\t#[cfg(test)]\n1528\tmod test {\n1529\t    use super::*;\n1530\t\n1531\t    // --- config_atoi ---\n1532\t\n1533\t    #[test]\n1534\t    fn atoi_valid_integer() {\n1535\t        assert_eq!(config_atoi(&[\"42\"], 0), Ok(42));\n1536\t    }\n1537\t\n1538\t    #[test]\n1539\t    fn atoi_zero() {\n1540\t        assert_eq!(config_atoi(&[\"0\"], 0), Ok(0));\n1541\t    }\n1542\t\n1543\t    #[test]\n1544\t    fn atoi_multi_digit() {\n1545\t        assert_eq!(config_atoi(&[\"12345\"], 0), Ok(12345));\n1546\t    }\n1547\t\n1548\t    #[test]\n1549\t    fn atoi_out_of_bounds_index() {\n1550\t        assert_eq!(config_atoi(&[\"5\"], 1), Err(Error::InvalidArgument));\n1551\t    }\n1552\t\n1553\t    #[test]\n1554\t    fn atoi_empty_params() {\n1555\t        assert_eq!(config_atoi(&[], 0), Err(Error::InvalidArgument));\n1556\t    }\n1557\t\n1558\t    #[test]\n1559\t    fn atoi_non_digit_char() {\n1560\t        assert_eq!(config_atoi(&[\"12a3\"], 0), Err(Error::InvalidArgument));\n1561\t    }\n1562\t\n1563\t    #[test]\n1564\t    fn atoi_negative_sign_rejected() {\n1565\t        // C version rejects any non-digit byte; '-' is not a digit\n1566\t        assert_eq!(config_atoi(&[\"-5\"], 0), Err(Error::InvalidArgument));\n1567\t    }\n1568\t\n1569\t    // --- config_optval_string ---\n1570\t\n1571\t    #[test]\n1572\t    fn optval_string_copies_within_capacity() {\n1573\t        let mut buf = [0u8; 16];\n1574\t        let result = config_optval_string(&mut buf, b\"hello\");\n1575\t        assert_eq!(result, \"hello\");\n1576\t        assert_eq!(buf[5], 0); // null terminator\n1577\t    }\n1578\t\n1579\t    #[test]\n1580\t    fn optval_string_truncates_to_buffer_minus_one() {\n1581\t        let mut buf = [0u8; 4]; // capacity 4 → max 3 bytes + NUL\n1582\t        let result = config_optval_string(&mut buf, b\"abcdef\");\n1583\t        assert_eq!(result, \"abc\");\n1584\t        assert_eq!(buf[3], 0);\n1585\t    }\n1586\t\n1587\t    #[test]\n1588\t    fn optval_string_empty_input() {\n1589\t        let mut buf = [0xffu8; 8];\n1590\t        let result = config_optval_string(&mut buf, b\"\");\n1591\t        assert_eq!(result, \"\");\n1592\t        assert_eq!(buf[0], 0);\n1593\t    }\n1594\t}\n1595\t"}]},"parent_tool_use_id":null,"session_id":"f89f9153-c014-4310-b972-78fe66d716ab","uuid":"bff3c8b0-0d5a-4f80-87e1-17bce15b59fd","timestamp":"2026-05-07T14:11:33.043Z","tool_use_result":{"type":"text","file":{"filePath":"/Users/richbarn/Projects/picoquic/rs/fq/src/config.rs","content":"//! Translation of `quic/config.h`.\n//!\n//! Demo-application–facing configuration plumbing for quic-core:\n//! the [`Config`] bag of CLI-derived options, the [`OptionId`]\n//! tag identifying each option, and [`Config::create_and_configure`],\n//! the one-shot constructor that turns a populated config into a\n//! fully-wired [`Quic`].\n//!\n//! Phase 4: all function bodies are implemented.\n//!\n//! Pointer-shape decisions for the config struct were guided by\n//! reading `quic/config.c`:\n//!\n//! * Every `char const*` string field that\n//!   `config_clear` `free`s is owned in C (allocated via\n//!   `config_set_string_param`'s `malloc` + `memcpy`).  These map\n//!   to `Option<String>`; `None` substitutes for the C `NULL`\n//!   sentinel that all callers test before use.\n//! * `multipath_alt_config: *mut char` is owned the same way and\n//!   becomes `Option<String>`.\n//! * `ech_target: uint8_t*` plus `ech_target_len` is owned by the\n//!   config (`config_clear` frees it after the base64\n//!   decode in `option_ECH_client`); it becomes\n//!   `Option<Vec<u8>>` with the length implicit in the vector.\n//! * `ticket_encryption_key: const uint8_t*` is *borrowed* in C —\n//!   `config_clear` does not free it.  Phase 1 stores an\n//!   owned `Option<Vec<u8>>` for safety; in v1 only the demo apps\n//!   set this field, and they can supply an owned buffer.  Phase 3\n//!   may revisit if a caller actually relies on aliasing.  The\n//!   paired `ticket_encryption_key_length` field is dropped — its\n//!   value is always implicit in the Vec length.\n//! * Single-bit `unsigned int : 1` flag bitfields (`use_long_log`,\n//!   `do_retry`, …) collapse to individual `bool` fields.  Every C\n//!   call site reads/writes one bit at a time as a Boolean\n//!   (`config->do_retry = 1`), so the\n//!   integer-with-mask-and-shift translation buys nothing here and\n//!   `bitflags!` is overkill for an unrelated set of flags.\n//! * Bitfield `enable_sslkeylog` is gated by\n//!   `#ifndef WITHOUT_SSLKEYLOG` in C.  v1 follows the\n//!   canonical build (the macro is undefined), so the field is\n//!   always present in Rust; a `cfg`-gated variant lands when the\n//!   build options are translated.\n\nuse crate::Error;\nuse crate::Instant;\nuse crate::internal::MICROSEC_HANDSHAKE_MAX;\nuse crate::{LossbitVersion, Quic, SpinbitVersion, StreamDataCallback};\n\n// ---------------------------------------------------------------------------\n// Option identifiers.\n\n/// One identifier per CLI / API option understood by [`Config`].\n///\n/// Mirrors the C `picoquic_option_enum_t`; variant order is\n/// load-bearing — the option dispatch table in `quic/config.c`\n/// indexes by variant — so the discriminants do not get reordered.\n///\n/// [`OptionId::SslKeyLog`] is unconditional here even though the C\n/// enum gates it on `#ifndef WITHOUT_SSLKEYLOG`, matching the\n/// canonical-build behavior; see the module-level docs for the\n/// rationale.\n#[derive(Debug, Copy, Clone, PartialEq, Eq)]\npub enum OptionId {\n    Cert,\n    Key,\n    ServerPort,\n    ProposedVersion,\n    OutDir,\n    WwwDir,\n    MaxConnections,\n    DoRetry,\n    InitialRandom,\n    ResetSeed,\n    DisablePortBlocking,\n    SolutionDir,\n    CcAlgo,\n    CcOption,\n    Spinbit,\n    Lossbit,\n    Multipath,\n    DestIf,\n    CipherSuite,\n    InitCnxId,\n    LogFile,\n    LongLog,\n    BinlogDir,\n    QlogDir,\n    MtuMax,\n    Sni,\n    Alpn,\n    RootTrustFile,\n    ForceZeroShare,\n    CnxIdLength,\n    NoDisk,\n    IdleTimeout,\n    LargeClientHello,\n    TicketFileName,\n    TokenFileName,\n    SocketBufferSize,\n    PerformanceLog,\n    PreemptiveRepeat,\n    VersionUpgrade,\n    NoGso,\n    BdpFrame,\n    CwinMax,\n    SslKeyLog,\n    AddressDiscovery,\n    EchServer,\n    EchClient,\n    EchInit,\n    FlowControlMax,\n    PreferredV4,\n    PreferredV6,\n    Help,\n}\n\n// ---------------------------------------------------------------------------\n// Option table (mirrors C static option_table[]).\n\nstruct OptionEntry {\n    id: OptionId,\n    letter: char,\n    name: &'static str,\n    nb_params: usize,\n    param_sample: &'static str,\n    help: &'static str,\n}\n\nstatic OPTION_TABLE: &[OptionEntry] = &[\n    OptionEntry {\n        id: OptionId::Cert,\n        letter: 'c',\n        name: \"cert\",\n        nb_params: 1,\n        param_sample: \"file\",\n        help: \"cert file\",\n    },\n    OptionEntry {\n        id: OptionId::Key,\n        letter: 'k',\n        name: \"key\",\n        nb_params: 1,\n        param_sample: \"file\",\n        help: \"key file\",\n    },\n    OptionEntry {\n        id: OptionId::ServerPort,\n        letter: 'p',\n        name: \"port\",\n        nb_params: 1,\n        param_sample: \"number\",\n        help: \"server port\",\n    },\n    OptionEntry {\n        id: OptionId::ProposedVersion,\n        letter: 'v',\n        name: \"proposed_version\",\n        nb_params: 1,\n        param_sample: \"\",\n        help: \"Version proposed by client, e.g. -v ff000012\",\n    },\n    OptionEntry {\n        id: OptionId::OutDir,\n        letter: 'o',\n        name: \"outdir\",\n        nb_params: 1,\n        param_sample: \"folder\",\n        help: \"Folder where client writes downloaded files, defaults to current directory.\",\n    },\n    OptionEntry {\n        id: OptionId::WwwDir,\n        letter: 'w',\n        name: \"wwwdir\",\n        nb_params: 1,\n        param_sample: \"folder\",\n        help: \"Folder containing web pages served by server\",\n    },\n    OptionEntry {\n        id: OptionId::MaxConnections,\n        letter: 'x',\n        name: \"max_connections\",\n        nb_params: 1,\n        param_sample: \"number\",\n        help: \"Maximum number of concurrent connections, default 256\",\n    },\n    OptionEntry {\n        id: OptionId::DoRetry,\n        letter: 'r',\n        name: \"do_retry\",\n        nb_params: 0,\n        param_sample: \"\",\n        help: \"Do Retry Request\",\n    },\n    OptionEntry {\n        id: OptionId::InitialRandom,\n        letter: 'R',\n        name: \"initial_random\",\n        nb_params: 1,\n        param_sample: \"option\",\n        help: \"Randomize packet number spaces: none(0), initial(1, default), all(2).\",\n    },\n    OptionEntry {\n        id: OptionId::ResetSeed,\n        letter: 's',\n        name: \"reset_seed\",\n        nb_params: 1,\n        param_sample: \"<32 hex chars>\",\n        help: \"Reset seed\",\n    },\n    OptionEntry {\n        id: OptionId::DisablePortBlocking,\n        letter: 'X',\n        name: \"disable_block\",\n        nb_params: 0,\n        param_sample: \"\",\n        help: \"Disable the check for blocked ports\",\n    },\n    OptionEntry {\n        id: OptionId::SolutionDir,\n        letter: 'S',\n        name: \"solution_dir\",\n        nb_params: 1,\n        param_sample: \"folder\",\n        help: \"Set the path to the source files to find the default files\",\n    },\n    OptionEntry {\n        id: OptionId::CcAlgo,\n        letter: 'G',\n        name: \"cc_algo\",\n        nb_params: 1,\n        param_sample: \"cc_algorithm\",\n        help: \"Use the specified congestion control algorithm. Defaults to bbr.\",\n    },\n    OptionEntry {\n        id: OptionId::CcOption,\n        letter: 'H',\n        name: \"cco\",\n        nb_params: 1,\n        param_sample: \"option\",\n        help: \"Set option string if required by congestion control algorithm.\",\n    },\n    OptionEntry {\n        id: OptionId::Spinbit,\n        letter: 'P',\n        name: \"spinbit\",\n        nb_params: 1,\n        param_sample: \"number\",\n        help: \"Set the default spinbit policy\",\n    },\n    OptionEntry {\n        id: OptionId::Lossbit,\n        letter: 'O',\n        name: \"lossbit\",\n        nb_params: 1,\n        param_sample: \"number\",\n        help: \"Set the default lossbit policy\",\n    },\n    OptionEntry {\n        id: OptionId::Multipath,\n        letter: 'M',\n        name: \"multipath\",\n        nb_params: 0,\n        param_sample: \"\",\n        help: \"Enable QUIC multipath extension\",\n    },\n    OptionEntry {\n        id: OptionId::DestIf,\n        letter: 'e',\n        name: \"dest_if\",\n        nb_params: 1,\n        param_sample: \"if\",\n        help: \"Send on interface (default: -1)\",\n    },\n    OptionEntry {\n        id: OptionId::CipherSuite,\n        letter: 'C',\n        name: \"cipher_suite\",\n        nb_params: 1,\n        param_sample: \"cipher_suite_id\",\n        help: \"specify cipher suite (e.g. -C 20 = chacha20)\",\n    },\n    OptionEntry {\n        id: OptionId::InitCnxId,\n        letter: 'i',\n        name: \"cnxid_params\",\n        nb_params: 1,\n        param_sample: \"per-text-lb-spec\",\n        help: \"See documentation for LB compatible CID configuration\",\n    },\n    OptionEntry {\n        id: OptionId::LogFile,\n        letter: 'l',\n        name: \"text_log\",\n        nb_params: 1,\n        param_sample: \"file\",\n        help: \"Log file, Log to stdout if file = \\\"-\\\". No text logging if absent.\",\n    },\n    OptionEntry {\n        id: OptionId::LongLog,\n        letter: 'L',\n        name: \"long_log\",\n        nb_params: 0,\n        param_sample: \"\",\n        help: \"Log all packets. If absent, log stops after 100 packets.\",\n    },\n    OptionEntry {\n        id: OptionId::BinlogDir,\n        letter: 'b',\n        name: \"binlog_dir\",\n        nb_params: 1,\n        param_sample: \"folder\",\n        help: \"Binary logging to this directory. No binary logging if absent.\",\n    },\n    OptionEntry {\n        id: OptionId::QlogDir,\n        letter: 'q',\n        name: \"qlog_dir\",\n        nb_params: 1,\n        param_sample: \"folder\",\n        help: \"Qlog logging to this directory.\",\n    },\n    OptionEntry {\n        id: OptionId::MtuMax,\n        letter: 'm',\n        name: \"mtu_max\",\n        nb_params: 1,\n        param_sample: \"mtu_max\",\n        help: \"Largest mtu value that can be tried for discovery.\",\n    },\n    OptionEntry {\n        id: OptionId::Sni,\n        letter: 'n',\n        name: \"sni\",\n        nb_params: 1,\n        param_sample: \"sni\",\n        help: \"sni (default: server name)\",\n    },\n    OptionEntry {\n        id: OptionId::Alpn,\n        letter: 'a',\n        name: \"alpn\",\n        nb_params: 1,\n        param_sample: \"alpn\",\n        help: \"alpn (default function of version)\",\n    },\n    OptionEntry {\n        id: OptionId::RootTrustFile,\n        letter: 't',\n        name: \"root_trust_file\",\n        nb_params: 1,\n        param_sample: \"file\",\n        help: \"root trust file\",\n    },\n    OptionEntry {\n        id: OptionId::ForceZeroShare,\n        letter: 'z',\n        name: \"force_zero_share\",\n        nb_params: 0,\n        param_sample: \"\",\n        help: \"Set TLS zero share behavior on client, to force HRR\",\n    },\n    OptionEntry {\n        id: OptionId::CnxIdLength,\n        letter: 'I',\n        name: \"cnxid_length\",\n        nb_params: 1,\n        param_sample: \"length\",\n        help: \"Length of CNX_ID used by the client, default=8\",\n    },\n    OptionEntry {\n        id: OptionId::IdleTimeout,\n        letter: 'd',\n        name: \"idle_timeout\",\n        nb_params: 1,\n        param_sample: \"ms\",\n        help: \"Duration of idle timeout in milliseconds (Default 30,000ms)\",\n    },\n    OptionEntry {\n        id: OptionId::NoDisk,\n        letter: 'D',\n        name: \"no_disk\",\n        nb_params: 0,\n        param_sample: \"\",\n        help: \"no disk: do not save received files on disk\",\n    },\n    OptionEntry {\n        id: OptionId::LargeClientHello,\n        letter: 'Q',\n        name: \"large_client_hello\",\n        nb_params: 0,\n        param_sample: \"\",\n        help: \"send a large client hello in order to test post quantum readiness\",\n    },\n    OptionEntry {\n        id: OptionId::TicketFileName,\n        letter: 'T',\n        name: \"ticket_file\",\n        nb_params: 1,\n        param_sample: \"file\",\n        help: \"File storing the session tickets\",\n    },\n    OptionEntry {\n        id: OptionId::TokenFileName,\n        letter: 'N',\n        name: \"token_file\",\n        nb_params: 1,\n        param_sample: \"file\",\n        help: \"File storing the new tokens\",\n    },\n    OptionEntry {\n        id: OptionId::SocketBufferSize,\n        letter: 'B',\n        name: \"so_buf_size\",\n        nb_params: 1,\n        param_sample: \"number\",\n        help: \"Set buffer size with SO_SNDBUF SO_RCVBUF\",\n    },\n    OptionEntry {\n        id: OptionId::PerformanceLog,\n        letter: 'F',\n        name: \"log_file_name\",\n        nb_params: 1,\n        param_sample: \"file\",\n        help: \"Append performance reports to performance log\",\n    },\n    OptionEntry {\n        id: OptionId::PreemptiveRepeat,\n        letter: 'V',\n        name: \"preemptive_repeat\",\n        nb_params: 0,\n        param_sample: \"\",\n        help: \"enable preemptive repeat\",\n    },\n    OptionEntry {\n        id: OptionId::VersionUpgrade,\n        letter: 'U',\n        name: \"version_upgrade\",\n        nb_params: 1,\n        param_sample: \"\",\n        help: \"Version upgrade if server agrees, e.g. -U 6b3343cf\",\n    },\n    OptionEntry {\n        id: OptionId::NoGso,\n        letter: '0',\n        name: \"no_gso\",\n        nb_params: 0,\n        param_sample: \"\",\n        help: \"Do not use UDP GSO or equivalent\",\n    },\n    OptionEntry {\n        id: OptionId::BdpFrame,\n        letter: 'j',\n        name: \"bdp\",\n        nb_params: 1,\n        param_sample: \"number\",\n        help: \"use bdp extension frame(1) or don't (0). Default=0\",\n    },\n    OptionEntry {\n        id: OptionId::CwinMax,\n        letter: 'W',\n        name: \"cwin_max\",\n        nb_params: 1,\n        param_sample: \"bytes\",\n        help: \"Max value for CWIN. Default=UINT64_MAX\",\n    },\n    OptionEntry {\n        id: OptionId::SslKeyLog,\n        letter: '8',\n        name: \"sslkeylog\",\n        nb_params: 0,\n        param_sample: \"\",\n        help: \"Enable SSLKEYLOG\",\n    },\n    OptionEntry {\n        id: OptionId::AddressDiscovery,\n        letter: 'J',\n        name: \"addr_disc\",\n        nb_params: 1,\n        param_sample: \"mode\",\n        help: \"provider (0), receiver (1) or both (2).\",\n    },\n    OptionEntry {\n        id: OptionId::EchServer,\n        letter: 'E',\n        name: \"ech_s\",\n        nb_params: 2,\n        param_sample: \"key config\",\n        help: \"ECH private key file, config file. Default= no ECH on server.\",\n    },\n    OptionEntry {\n        id: OptionId::EchInit,\n        letter: 'y',\n        name: \"ech_init\",\n        nb_params: 1,\n        param_sample: \"public_name\",\n        help: \"Create an ECH configuration before applying the `ech_s` parameter.\",\n    },\n    OptionEntry {\n        id: OptionId::EchClient,\n        letter: 'K',\n        name: \"ech_c\",\n        nb_params: 1,\n        param_sample: \"base64\",\n        help: \"ECH configuration for the client connection, base64 encoded.\",\n    },\n    OptionEntry {\n        id: OptionId::FlowControlMax,\n        letter: 'Z',\n        name: \"flow_control_max\",\n        nb_params: 1,\n        param_sample: \"bytes\",\n        help: \"Set the flow control's initial max data.\",\n    },\n    OptionEntry {\n        id: OptionId::PreferredV4,\n        letter: '4',\n        name: \"preferred_v4\",\n        nb_params: 1,\n        param_sample: \"ip[:port]\",\n        help: \"Preferred address for v4 connections.\",\n    },\n    OptionEntry {\n        id: OptionId::PreferredV6,\n        letter: '6',\n        name: \"preferred_v6\",\n        nb_params: 1,\n        param_sample: \"ipv6[:port]\",\n        help: \"Preferred address for v6 connections.\",\n    },\n    OptionEntry {\n        id: OptionId::Help,\n        letter: 'h',\n        name: \"help\",\n        nb_params: 0,\n        param_sample: \"\",\n        help: \"This help message\",\n    },\n];\n\n/// C: `config_parse_target_version` (picoquic/config.c:116)\n///\n/// Parses a hex-encoded QUIC version number.  Returns 0 on any invalid input,\n/// matching the C behaviour of breaking on the first unrecognised character.\nfn parse_hex_version(s: &str) -> u32 {\n    u32::from_str_radix(s, 16).unwrap_or(0)\n}\n\n/// C: `config_optval_string` (picoquic/config.c:181)\n///\n/// Copies at most `buffer.len() - 1` bytes from `p` into `buffer`,\n/// null-terminates, and returns the filled prefix as a `str`.\n/// Matches the C truncation-and-NUL-terminate contract exactly.\nfn config_optval_string<'a>(buffer: &'a mut [u8], p: &[u8]) -> &'a str {\n    let len = p.len().min(buffer.len().saturating_sub(1));\n    buffer[..len].copy_from_slice(&p[..len]);\n    if !buffer.is_empty() {\n        buffer[len] = 0;\n    }\n    core::str::from_utf8(&buffer[..len]).unwrap_or(\"\")\n}\n\n/// C: `config_optval_param_string` (picoquic/config.c:191)\n///\n/// Bounds-checked wrapper around [`config_optval_string`]: copies\n/// `params[x]` into `buffer` (NUL-terminated, truncated to fit) and\n/// returns the filled prefix.  Writes a single NUL and returns `\"\"` when\n/// `x` is out of bounds — matching the C behaviour for `params == NULL`\n/// or `x < 0 || x >= nb_param`.\n///\n/// In the C implementation this helper exists because `option_param_t`\n/// carries a raw pointer and length that need explicit bounds checking.\n/// The Rust `&[&str]` slice already encodes the length, so the only\n/// real work is the `x >= params.len()` guard.\n#[allow(dead_code)]\nfn config_optval_param_string<'a>(buffer: &'a mut [u8], params: &[&str], x: usize) -> &'a str {\n    if x >= params.len() {\n        if !buffer.is_empty() {\n            buffer[0] = 0;\n        }\n        return \"\";\n    }\n    config_optval_string(buffer, params[x].as_bytes())\n}\n\n/// C: `config_atoi` (picoquic/config.c:202)\n///\n/// Parse a decimal (ASCII digit only) integer from `params[x]`.\n///\n/// Returns `Ok(value)` on success.  Returns `Err(InvalidArgument)` when `x`\n/// is out of bounds or any character in `params[x]` is not an ASCII digit —\n/// mirroring the C behaviour of setting `*ret = -1` and returning `-1` on error.\npub fn config_atoi(params: &[&str], x: usize) -> Result<i32, Error> {\n    if x >= params.len() {\n        return Err(Error::InvalidArgument);\n    }\n    let mut v: i32 = 0;\n    for b in params[x].bytes() {\n        let digit = b.wrapping_sub(b'0');\n        if digit > 9 {\n            return Err(Error::InvalidArgument);\n        }\n        v = v * 10 + digit as i32;\n    }\n    Ok(v)\n}\n\nfn base64_decode(s: &str) -> Result<Vec<u8>, Error> {\n    let mut table = [0xFFu8; 256];\n    for (i, &c) in b\"ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789+/\"\n        .iter()\n        .enumerate()\n    {\n        table[c as usize] = i as u8;\n    }\n    let bytes: Vec<u8> = s.bytes().filter(|&c| c != b'=').collect();\n    let mut out = Vec::new();\n    for chunk in bytes.chunks(4) {\n        let mut v = [0u8; 4];\n        let n = chunk.len();\n        for (i, &b) in chunk.iter().enumerate() {\n            let x = table[b as usize];\n            if x == 0xFF {\n                return Err(Error::InvalidArgument);\n            }\n            v[i] = x;\n        }\n        out.push((v[0] << 2) | (v[1] >> 4));\n        if n >= 3 {\n            out.push((v[1] << 4) | (v[2] >> 2));\n        }\n        if n == 4 {\n            out.push((v[2] << 6) | v[3]);\n        }\n    }\n    Ok(out)\n}\n\nfn option_entry(id: OptionId) -> Option<&'static OptionEntry> {\n    OPTION_TABLE.iter().find(|e| e.id == id)\n}\n\nfn option_entry_by_letter(letter: char) -> Option<(usize, &'static OptionEntry)> {\n    OPTION_TABLE\n        .iter()\n        .enumerate()\n        .find(|(_, e)| e.letter == letter)\n}\n\nfn option_entry_by_name(name: &str) -> Option<(usize, &'static OptionEntry)> {\n    OPTION_TABLE\n        .iter()\n        .enumerate()\n        .find(|(_, e)| e.name == name)\n}\n\n/// C: `config_set_string_param` (picoquic/config.c:148)\n///\n/// Replace `*v` with an owned copy of `params[x]`.  Clears `*v` first\n/// (mirrors the `free(*v)` in C), then sets it if the selected param\n/// is non-empty.  Returns `Err(InvalidArgument)` when `x` is out of\n/// bounds or the param is empty (the C path where `length == 0` causes\n/// `malloc` to be skipped and `-1` is returned).\n#[allow(dead_code)]\nfn config_set_string_param(v: &mut Option<String>, params: &[&str], x: usize) -> Result<(), Error> {\n    *v = None;\n    if x < params.len() && !params[x].is_empty() {\n        *v = Some(params[x].to_string());\n        Ok(())\n    } else {\n        Err(Error::InvalidArgument)\n    }\n}\n\n/// C: `picoquic_config_get_option_char_index` (picoquic/config.c:641)\n///\n/// Return the index in `OPTION_TABLE` of the entry whose single-character\n/// flag equals `opt`, or `-1` if not found.\npub fn picoquic_config_get_option_char_index(opt: char) -> i32 {\n    OPTION_TABLE\n        .iter()\n        .position(|e| e.letter == opt)\n        .map_or(-1, |i| i as i32)\n}\n\n/// C: `picoquic_config_get_option_name_index` (picoquic/config.c:654)\n///\n/// Return the index in `OPTION_TABLE` of the first entry whose long name\n/// matches the first `l` bytes of `s` (mirrors `strncmp(s, name, l) == 0`),\n/// or `-1` if not found.\npub fn picoquic_config_get_option_name_index(s: &str, l: usize) -> i32 {\n    let l = l.min(s.len());\n    let prefix = &s[..l];\n    OPTION_TABLE\n        .iter()\n        .position(|e| e.name.len() >= l && &e.name[..l] == prefix)\n        .map_or(-1, |i| i as i32)\n}\n\n/// C: `config_set_option` (picoquic/config.c:274)\n///\n/// Applies a single option — identified by `entry.id` — to `config`.  Each\n/// arm mirrors the corresponding `case` in the C `switch (option_desc->option_num)`.\n/// Error conditions that C prints to `stderr` via `config_optval_param_string`\n/// are surfaced as `Err(Error::InvalidArgument)` instead; the C `int` return\n/// (`0` / `-1`) maps to `Ok(())` / `Err`.\nfn apply_option(config: &mut Config, entry: &OptionEntry, params: &[&str]) -> Result<(), Error> {\n    let p0 = params.first().copied();\n    let p1 = params.get(1).copied();\n    match entry.id {\n        OptionId::Cert => {\n            config.server_cert_file = Some(p0.ok_or(Error::InvalidArgument)?.to_string());\n        }\n        OptionId::Key => {\n            config.server_key_file = Some(p0.ok_or(Error::InvalidArgument)?.to_string());\n        }\n        OptionId::ServerPort => {\n            config.set_port(p0.ok_or(Error::InvalidArgument)?)?;\n        }\n        OptionId::ProposedVersion => {\n            let v = parse_hex_version(p0.ok_or(Error::InvalidArgument)?);\n            if v == 0 {\n                return Err(Error::InvalidArgument);\n            }\n            config.proposed_version = v;\n        }\n        OptionId::OutDir => {\n            config.out_dir = Some(p0.ok_or(Error::InvalidArgument)?.to_string());\n        }\n        OptionId::WwwDir => {\n            config.www_dir = Some(p0.ok_or(Error::InvalidArgument)?.to_string());\n        }\n        OptionId::MaxConnections => {\n            let v: i32 = p0\n                .ok_or(Error::InvalidArgument)?\n                .parse()\n                .map_err(|_| Error::InvalidArgument)?;\n            if v <= 0 {\n                return Err(Error::InvalidArgument);\n            }\n            config.nb_connections = v as u32;\n        }\n        OptionId::DoRetry => {\n            config.do_retry = true;\n        }\n        OptionId::InitialRandom => {\n            let v: i32 = p0\n                .ok_or(Error::InvalidArgument)?\n                .parse()\n                .map_err(|_| Error::InvalidArgument)?;\n            if !(0..=2).contains(&v) {\n                return Err(Error::InvalidArgument);\n            }\n            config.initial_random = v as u32;\n        }\n        OptionId::ResetSeed => {\n            config.has_reset_seed = true;\n            let n =\n                crate::utils::parse_hexa(p0.ok_or(Error::InvalidArgument)?, &mut config.reset_seed);\n            if n != config.reset_seed.len() {\n                return Err(Error::InvalidArgument);\n            }\n        }\n        OptionId::DisablePortBlocking => {\n            config.disable_port_blocking = true;\n        }\n        OptionId::SslKeyLog => {\n            config.enable_sslkeylog = true;\n        }\n        OptionId::SolutionDir => {\n            config.solution_dir = Some(p0.ok_or(Error::InvalidArgument)?.to_string());\n        }\n        OptionId::CcAlgo => {\n            config.cc_algo_id = Some(p0.ok_or(Error::InvalidArgument)?.to_string());\n        }\n        OptionId::CcOption => {\n            config.cc_algo_option_string = Some(p0.ok_or(Error::InvalidArgument)?.to_string());\n        }\n        OptionId::Spinbit => {\n            let v: i32 = p0\n                .ok_or(Error::InvalidArgument)?\n                .parse()\n                .map_err(|_| Error::InvalidArgument)?;\n            config.spinbit_policy = match v {\n                0 => SpinbitVersion::Basic,\n                1 => SpinbitVersion::Random,\n                2 => SpinbitVersion::Null,\n                3 => SpinbitVersion::On,\n                _ => return Err(Error::InvalidArgument),\n            };\n        }\n        OptionId::Lossbit => {\n            let v: i32 = p0\n                .ok_or(Error::InvalidArgument)?\n                .parse()\n                .map_err(|_| Error::InvalidArgument)?;\n            config.lossbit_policy = match v {\n                0 => LossbitVersion::None,\n                1 => LossbitVersion::SendOnly,\n                2 => LossbitVersion::SendReceive,\n                _ => return Err(Error::InvalidArgument),\n            };\n        }\n        OptionId::Multipath => {\n            config.multipath_option = 1;\n        }\n        OptionId::DestIf => {\n            config.dest_if = p0\n                .ok_or(Error::InvalidArgument)?\n                .parse()\n                .map_err(|_| Error::InvalidArgument)?;\n        }\n        OptionId::CipherSuite => {\n            config.cipher_suite_id = p0\n                .ok_or(Error::InvalidArgument)?\n                .parse()\n                .map_err(|_| Error::InvalidArgument)?;\n        }\n        OptionId::InitCnxId => {\n            config.connection_id_cbdata = Some(p0.ok_or(Error::InvalidArgument)?.to_string());\n        }\n        OptionId::LogFile => {\n            config.log_file = Some(p0.ok_or(Error::InvalidArgument)?.to_string());\n        }\n        OptionId::LongLog => {\n            config.use_long_log = true;\n        }\n        OptionId::BinlogDir => {\n            config.bin_dir = Some(p0.ok_or(Error::InvalidArgument)?.to_string());\n        }\n        OptionId::QlogDir => {\n            config.qlog_dir = Some(p0.ok_or(Error::InvalidArgument)?.to_string());\n        }\n        OptionId::MtuMax => {\n            let v: i32 = p0\n                .ok_or(Error::InvalidArgument)?\n                .parse()\n                .map_err(|_| Error::InvalidArgument)?;\n            if v <= 0 || v > crate::internal::MAX_PACKET_SIZE as i32 {\n                return Err(Error::InvalidArgument);\n            }\n            config.mtu_max = v;\n        }\n        OptionId::Sni => {\n            config.sni = Some(p0.ok_or(Error::InvalidArgument)?.to_string());\n        }\n        OptionId::Alpn => {\n            config.alpn = Some(p0.ok_or(Error::InvalidArgument)?.to_string());\n        }\n        OptionId::RootTrustFile => {\n            config.root_trust_file = Some(p0.ok_or(Error::InvalidArgument)?.to_string());\n        }\n        OptionId::ForceZeroShare => {\n            config.force_zero_share = true;\n        }\n        OptionId::CnxIdLength => {\n            let v: i32 = p0\n                .ok_or(Error::InvalidArgument)?\n                .parse()\n                .map_err(|_| Error::InvalidArgument)?;\n            if v < 0 || v > crate::CONNECTION_ID_MAX_SIZE as i32 {\n                return Err(Error::InvalidArgument);\n            }\n            config.connection_id_length = v;\n        }\n        OptionId::IdleTimeout => {\n            let v: i32 = p0\n                .ok_or(Error::InvalidArgument)?\n                .parse()\n                .map_err(|_| Error::InvalidArgument)?;\n            if v < 0 {\n                return Err(Error::InvalidArgument);\n            }\n            config.idle_timeout = v;\n        }\n        OptionId::NoDisk => {\n            config.no_disk = true;\n        }\n        OptionId::LargeClientHello => {\n            config.large_client_hello = true;\n        }\n        OptionId::TicketFileName => {\n            config.ticket_file_name = Some(p0.ok_or(Error::InvalidArgument)?.to_string());\n        }\n        OptionId::TokenFileName => {\n            config.token_file_name = Some(p0.ok_or(Error::InvalidArgument)?.to_string());\n        }\n        OptionId::SocketBufferSize => {\n            let v: i32 = p0\n                .ok_or(Error::InvalidArgument)?\n                .parse()\n                .map_err(|_| Error::InvalidArgument)?;\n            if v < 0 {\n                return Err(Error::InvalidArgument);\n            }\n            config.socket_buffer_size = v;\n        }\n        OptionId::PerformanceLog => {\n            config.performance_log = Some(p0.ok_or(Error::InvalidArgument)?.to_string());\n        }\n        OptionId::PreemptiveRepeat => {\n            config.do_preemptive_repeat = true;\n        }\n        OptionId::VersionUpgrade => {\n            let v = parse_hex_version(p0.ok_or(Error::InvalidArgument)?);\n            if v == 0 {\n                return Err(Error::InvalidArgument);\n            }\n            config.desired_version = v;\n        }\n        OptionId::NoGso => {\n            config.do_not_use_gso = true;\n        }\n        OptionId::BdpFrame => {\n            let v: i32 = p0\n                .ok_or(Error::InvalidArgument)?\n                .parse()\n                .map_err(|_| Error::InvalidArgument)?;\n            if !(0..=1).contains(&v) {\n                return Err(Error::InvalidArgument);\n            }\n            config.bdp_frame_option = v;\n        }\n        OptionId::CwinMax => {\n            let v: i64 = p0\n                .ok_or(Error::InvalidArgument)?\n                .parse()\n                .map_err(|_| Error::InvalidArgument)?;\n            if v < 0 {\n                return Err(Error::InvalidArgument);\n            }\n            config.cwin_max = if v == 0 { u64::MAX } else { v as u64 };\n        }\n        OptionId::AddressDiscovery => {\n            let v: i32 = p0\n                .ok_or(Error::InvalidArgument)?\n                .parse()\n                .map_err(|_| Error::InvalidArgument)?;\n            if !(0..=2).contains(&v) {\n                return Err(Error::InvalidArgument);\n            }\n            config.address_discovery_mode = v + 1;\n        }\n        OptionId::EchServer => {\n            config.ech_key_file = Some(p0.ok_or(Error::InvalidArgument)?.to_string());\n            if let Some(s) = p1 {\n                config.ech_config_file = Some(s.to_string());\n            }\n        }\n        OptionId::EchInit => {\n            config.ech_public_name = Some(p0.ok_or(Error::InvalidArgument)?.to_string());\n        }\n        OptionId::EchClient => {\n            let s = p0.ok_or(Error::InvalidArgument)?;\n            if s == \"-\" {\n                config.ech_target = None;\n            } else {\n                config.ech_target = Some(base64_decode(s).map_err(|_| Error::InvalidArgument)?);\n            }\n        }\n        OptionId::FlowControlMax => {\n            let v: i64 = p0\n                .ok_or(Error::InvalidArgument)?\n                .parse()\n                .map_err(|_| Error::InvalidArgument)?;\n            if v < 0 {\n                return Err(Error::InvalidArgument);\n            }\n            config.flow_control_max = v as u64;\n        }\n        OptionId::PreferredV4 => {\n            config.preferred_address_v4 = Some(p0.ok_or(Error::InvalidArgument)?.to_string());\n        }\n        OptionId::PreferredV6 => {\n            config.preferred_address_v6 = Some(p0.ok_or(Error::InvalidArgument)?.to_string());\n        }\n        OptionId::Help => {\n            return Err(Error::InvalidArgument);\n        }\n    }\n    Ok(())\n}\n\nfn collect_params<'a>(\n    entry: &OptionEntry,\n    p_optind: &mut usize,\n    argv: &[&'a str],\n    optarg: Option<&'a str>,\n) -> Result<Vec<&'a str>, Error> {\n    let mut params = Vec::new();\n    if entry.nb_params > 0 {\n        params.push(optarg.ok_or(Error::InvalidArgument)?);\n        let mut nb = 1;\n        while nb < entry.nb_params {\n            if *p_optind >= argv.len() {\n                return Err(Error::InvalidArgument);\n            }\n            params.push(argv[*p_optind]);\n            *p_optind += 1;\n            nb += 1;\n        }\n    }\n    Ok(params)\n}\n\nfn parse_option_string(opt_string: &str) -> Option<(usize, &'static OptionEntry)> {\n    if opt_string.starts_with(\"--\") && opt_string.len() > 2 {\n        option_entry_by_name(&opt_string[2..])\n    } else if opt_string.starts_with('-') && opt_string.len() == 2 {\n        opt_string.chars().nth(1).and_then(option_entry_by_letter)\n    } else {\n        None\n    }\n}\n\n// ---------------------------------------------------------------------------\n// Configuration struct.\n\n/// Configuration bag for a QUIC context, populated from CLI flags\n/// (via [`Config::command_line`]) or directly (via\n/// [`Config::set_option`]) and consumed by\n/// [`Config::create_and_configure`].\n///\n/// Mirrors the C `picoquic_quic_config_t` field-for-field;\n/// `repr(C)` is dropped because the struct never crosses an\n/// external boundary.  See the module-level docs for the\n/// pointer-shape rationale.\n///\n/// `Default` produces the documented C defaults:\n/// `nb_connections = 256`, `connection_id_length = -1`, `cwin_max =\n/// u64::MAX`, idle timeout from `MICROSEC_HANDSHAKE_MAX`, etc.  This\n/// folds the C `picoquic_config_init` step into the constructor —\n/// the C `config_clear` (which `free`s every owned string) collapses\n/// to `Drop`, and resetting a config to defaults is just\n/// `*config = Config::default()`.\n#[derive(Debug)]\npub struct Config {\n    pub nb_connections: u32,\n    pub solution_dir: Option<String>,\n    pub server_cert_file: Option<String>,\n    pub server_key_file: Option<String>,\n    pub log_file: Option<String>,\n    pub bin_dir: Option<String>,\n    pub qlog_dir: Option<String>,\n    pub performance_log: Option<String>,\n    pub server_port: u16,\n    pub local_port: u16,\n    /// Whether the public port is shared with sibling threads\n    /// (`SO_REUSEPORT`).  C: `int is_port_shared`, used as a\n    /// Boolean flag.\n    pub is_port_shared: bool,\n    pub nb_threads: i32,\n    pub dest_if: i32,\n    pub mtu_max: i32,\n    /// `-1` is the C \"unset\" sentinel applied by [`Self::init`];\n    /// values `>= 0` set the connection-ID length explicitly.  Kept\n    /// as `i32` rather than `Option<u8>` for source-level parity\n    /// with the C body.\n    pub connection_id_length: i32,\n    pub idle_timeout: i32,\n    pub socket_buffer_size: i32,\n    pub cc_algo_id: Option<String>,\n    pub cc_algo_option_string: Option<String>,\n    pub connection_id_cbdata: Option<String>,\n    pub spinbit_policy: SpinbitVersion,\n    pub lossbit_policy: LossbitVersion,\n    pub multipath_option: i32,\n    pub multipath_alt_config: Option<String>,\n    pub bdp_frame_option: i32,\n    pub cwin_max: u64,\n    pub address_discovery_mode: i32,\n\n    // Common flags.\n    pub initial_random: u32,\n    pub use_long_log: bool,\n    pub do_preemptive_repeat: bool,\n    pub do_not_use_gso: bool,\n    pub disable_port_blocking: bool,\n    /// Originally bitfield-gated by `#ifndef\n    /// WITHOUT_SSLKEYLOG`; v1 follows the canonical build\n    /// (always defined), so the field is unconditional here.\n    pub enable_sslkeylog: bool,\n\n    // Server only.\n    pub www_dir: Option<String>,\n    pub reset_seed: [u8; 16],\n    /// Borrowed in C (`config_clear` does not free it); owned\n    /// `Vec<u8>` here for safety.  The C\n    /// `ticket_encryption_key_length` field is dropped — its value\n    /// is always `ticket_encryption_key.as_ref().map_or(0, Vec::len)`.\n    pub ticket_encryption_key: Option<Vec<u8>>,\n\n    // Server flags.\n    pub do_retry: bool,\n    pub has_reset_seed: bool,\n\n    // Client only.\n    pub ticket_file_name: Option<String>,\n    pub token_file_name: Option<String>,\n    pub sni: Option<String>,\n    pub alpn: Option<String>,\n    pub out_dir: Option<String>,\n    pub root_trust_file: Option<String>,\n    pub cipher_suite_id: i32,\n    pub proposed_version: u32,\n    pub desired_version: u32,\n    pub force_zero_share: bool,\n    pub no_disk: bool,\n    pub large_client_hello: bool,\n\n    // ECH parameters for server.\n    pub ech_key_file: Option<String>,\n    pub ech_config_file: Option<String>,\n    pub ech_public_name: Option<String>,\n    /// ECH parameter for the client, base64-decoded.  Owned by\n    /// the config — `config_clear` frees it in C.  The C\n    /// `ech_target_len` field is dropped — its value is always\n    /// `ech_target.as_ref().map_or(0, Vec::len)`.\n    pub ech_target: Option<Vec<u8>>,\n\n    pub flow_control_max: u64,\n\n    // Preferred address, encoded as strings.\n    pub preferred_address_v4: Option<String>,\n    pub preferred_address_v6: Option<String>,\n}\n\nimpl Default for Config {\n    /// Build a fresh config with the documented C defaults.  C:\n    /// `picoquic_config_init` (which the C body invoked after a\n    /// zero-initialising `memset`).\n    fn default() -> Self {\n        Config {\n            nb_connections: 256,\n            solution_dir: None,\n            server_cert_file: None,\n            server_key_file: None,\n            log_file: None,\n            bin_dir: None,\n            qlog_dir: None,\n            performance_log: None,\n            server_port: 0,\n            local_port: 0,\n            is_port_shared: false,\n            nb_threads: 0,\n            dest_if: 0,\n            mtu_max: 0,\n            connection_id_length: -1,\n            idle_timeout: (MICROSEC_HANDSHAKE_MAX.ticks() / 1000) as i32,\n            socket_buffer_size: 0,\n            cc_algo_id: None,\n            cc_algo_option_string: None,\n            connection_id_cbdata: None,\n            spinbit_policy: SpinbitVersion::default(),\n            lossbit_policy: LossbitVersion::default(),\n            multipath_option: 0,\n            multipath_alt_config: None,\n            bdp_frame_option: 0,\n            cwin_max: u64::MAX,\n            address_discovery_mode: 0,\n            initial_random: 3,\n            use_long_log: false,\n            do_preemptive_repeat: false,\n            do_not_use_gso: false,\n            disable_port_blocking: false,\n            enable_sslkeylog: false,\n            www_dir: None,\n            reset_seed: [0; 16],\n            ticket_encryption_key: None,\n            do_retry: false,\n            has_reset_seed: false,\n            ticket_file_name: None,\n            token_file_name: None,\n            sni: None,\n            alpn: None,\n            out_dir: None,\n            root_trust_file: None,\n            cipher_suite_id: 0,\n            proposed_version: 0,\n            desired_version: 0,\n            force_zero_share: false,\n            no_disk: false,\n            large_client_hello: false,\n            ech_key_file: None,\n            ech_config_file: None,\n            ech_public_name: None,\n            ech_target: None,\n            flow_control_max: 0,\n            preferred_address_v4: None,\n            preferred_address_v6: None,\n        }\n    }\n}\n\nimpl Config {\n    /// C: `picoquic_config_clear` (picoquic/config.c:1046)\n    ///\n    /// Frees all owned fields and resets every member to the defaults that\n    /// [`Config::default`] produces.  In the C version each `const char*`\n    /// field is individually `free`d and then `picoquic_config_init` is\n    /// called; in Rust the old values are dropped automatically when the\n    /// struct is overwritten, so the entire operation collapses to a single\n    /// assignment.\n    pub fn clear(&mut self) {\n        *self = Config::default();\n    }\n\n    /// Apply one option, selected by `option`, to the config.\n    /// C: `picoquic_config_set_option`.\n    ///\n    /// `value` is optional — flag-style options ([`OptionId::DoRetry`],\n    /// [`OptionId::LongLog`], …) ignore it; value-style options\n    /// require it and return `Err` when it is missing or malformed.\n    ///\n    /// The C signature returned `int` (`0` ↔ `Ok`, `-1` ↔ `Err`);\n    /// mapped to `Result<(), Error>`.\n    pub fn set_option(&mut self, option: OptionId, value: Option<&str>) -> Result<(), Error> {\n        let entry = option_entry(option).ok_or(Error::InvalidArgument)?;\n        let params: &[&str] = match value {\n            Some(v) => &[v],\n            None => &[],\n        };\n        apply_option(self, entry, params)\n    }\n\n    /// Dispatch one option from a single-character flag (`-x`).\n    /// C: `picoquic_config_command_line`.\n    ///\n    /// `p_optind` advances past any extra arguments consumed beyond\n    /// the inline `optarg`, mirroring the C in/out parameter so that\n    /// an outer getopt-style loop stays in sync.\n    ///\n    /// `argv` is a borrowed slice of borrowed strings — the C caller\n    /// (`first` etc.) owns the argument vector for the program\n    /// lifetime, so a borrow is safe.  The C `int argc` parameter is\n    /// dropped (implicit in `argv.len()`).\n    pub fn command_line(\n        &mut self,\n        opt: char,\n        p_optind: &mut usize,\n        argv: &[&str],\n        optarg: Option<&str>,\n    ) -> Result<(), Error> {\n        let (_, entry) = option_entry_by_letter(opt).ok_or(Error::InvalidArgument)?;\n        let params = collect_params(entry, p_optind, argv, optarg)?;\n        apply_option(self, entry, &params)\n    }\n\n    /// Like [`Self::command_line`] but accepts both single-character\n    /// (`-x`) and long-form (`--name`) option strings; the leading\n    /// dashes are part of `opt_string`, matching the C contract.\n    /// C: `picoquic_config_command_line_ex`.\n    pub fn command_line_ex(\n        &mut self,\n        opt_string: &str,\n        p_optind: &mut usize,\n        argv: &[&str],\n        optarg: Option<&str>,\n    ) -> Result<(), Error> {\n        let (_, entry) = parse_option_string(opt_string).ok_or(Error::InvalidArgument)?;\n        let params = collect_params(entry, p_optind, argv, optarg)?;\n        apply_option(self, entry, &params)\n    }\n\n    /// Build the getopt-style option string from the dispatch table\n    /// in `config.c` — one letter per option, with `:` after each\n    /// option that takes an argument.  C:\n    /// `picoquic_config_option_letters`.\n    ///\n    /// The C signature wrote into a caller-supplied buffer\n    /// (`option_string`, `string_max`) and reported the populated\n    /// length via `*string_length`.  The Rust wrapper owns the\n    /// buffer and returns it directly, so the buffer-too-small\n    /// failure mode disappears.\n    pub fn option_letters() -> String {\n        let mut s = String::new();\n        for e in OPTION_TABLE {\n            s.push(e.letter);\n            if e.nb_params > 0 {\n                s.push(':');\n            }\n        }\n        s\n    }\n\n    /// Write the option help to a [`core::fmt::Write`] sink.\n    /// C: `picoquic_config_usage_file`.\n    ///\n    /// The C parameter was `FILE*`; the Rust translation accepts\n    /// any sink (a `String` buffer, the stdout/stderr handles under\n    /// the `std` feature, or a custom writer) so the function\n    /// stays `no_std`-friendly.\n    pub fn write_usage(w: &mut dyn core::fmt::Write) {\n        let _ = w.write_str(\"Picoquic options:\\n\");\n        for e in OPTION_TABLE {\n            let _ = write!(w, \"  -{} {}\", e.letter, e.param_sample);\n            let pad = 12usize.saturating_sub(e.param_sample.len());\n            for _ in 0..pad {\n                let _ = w.write_char(' ');\n            }\n            let _ = writeln!(w, \" {}\", e.help);\n        }\n    }\n\n    /// Print the option help to stderr.  C: `picoquic_config_usage`.\n    ///\n    /// Routes through an intermediate `String` buffer then `eprint!`.\n    pub fn print_usage() {\n        let mut buf = String::new();\n        Self::write_usage(&mut buf);\n        eprint!(\"{}\", buf);\n    }\n\n    /// Parse a port-configuration string into `server_port`,\n    /// `local_port`, `is_port_shared`, and `nb_threads`.\n    /// C: `config_set_port` (internal, called from the `-p` option\n    /// handler in `picoquic/config.c`).\n    ///\n    /// Accepted formats:\n    /// - `\"\"` / `\"0\"` — clear all (port 0, not shared)\n    /// - `\"4433\"` — server port only\n    /// - `\"443:4434\"` — server:local\n    /// - `\"S4433\"` — shared server port\n    /// - `\"S443:4434*256\"` — shared server:local, 256 threads\n    /// - `\"4433*7\"` — server port, 7 threads\n    ///\n    /// Returns `Err` when any token cannot be parsed or a port value\n    /// exceeds 65535.\n    pub fn set_port(&mut self, port_string: &str) -> Result<(), Error> {\n        let bytes = port_string.as_bytes();\n        let mut i = 0;\n        let mut is_port_shared = false;\n        let mut p1: i32 = 0;\n        let mut p2: i32 = 0;\n        let mut nb_threads: i32 = 0;\n\n        if i < bytes.len() && bytes[i] == b'S' {\n            is_port_shared = true;\n            i += 1;\n        }\n        while i < bytes.len() && bytes[i].is_ascii_digit() {\n            p1 = p1 * 10 + (bytes[i] - b'0') as i32;\n            i += 1;\n        }\n        if i < bytes.len() && bytes[i] == b':' {\n            i += 1;\n            while i < bytes.len() && bytes[i].is_ascii_digit() {\n                p2 = p2 * 10 + (bytes[i] - b'0') as i32;\n                i += 1;\n            }\n        }\n        if i < bytes.len() && bytes[i] == b'*' {\n            i += 1;\n            while i < bytes.len() && bytes[i].is_ascii_digit() {\n                nb_threads = nb_threads * 10 + (bytes[i] - b'0') as i32;\n                i += 1;\n            }\n        }\n        if i != bytes.len() || !(0..=65535).contains(&p1) || !(0..=65535).contains(&p2) {\n            return Err(Error::InvalidArgument);\n        }\n        self.server_port = p1 as u16;\n        self.local_port = p2 as u16;\n        self.is_port_shared = is_port_shared;\n        self.nb_threads = nb_threads;\n        Ok(())\n    }\n\n    /// Build a fully-configured QUIC context from this config plus\n    /// an application-supplied callback.  C:\n    /// `picoquic_create_and_configure`.\n    ///\n    /// Returns `None` when context creation fails (the C side\n    /// returned `NULL`).\n    ///\n    /// Pointer-shape choices, derived from the C signature and the\n    /// body in `config.c`:\n    ///\n    /// * `picoquic_quic_config_t* config` is consumed-borrowed\n    ///   (`&mut self`): the body reads every field and may set up\n    ///   downstream owned state, but it does not free the struct\n    ///   itself — ownership stays with the caller.\n    /// * `default_callback_fn` + `default_callback_ctx` collapse to\n    ///   one `Option<Box<dyn StreamDataCallback>>` per the\n    ///   function-pointers-map-to-traits rule, with the `void*`\n    ///   context folded into the trait implementor's state.  `None`\n    ///   matches the C \"no default callback\" case where the function\n    ///   pointer was `NULL`.\n    /// * `p_simulated_time: *mut u64` carries simulated wall time for\n    ///   tests; the C QUIC context retains the pointer across calls,\n    ///   so an `&mut u64` borrow expresses the contract directly.\n    ///   Phase 3 may revisit (e.g. with a clock trait) once the QUIC\n    ///   context type is real.\n    pub fn create_and_configure(\n        &mut self,\n        default_callback: Option<Box<dyn StreamDataCallback>>,\n        current_time: Instant,\n        _p_simulated_time: Option<&mut u64>,\n    ) -> Option<Box<Quic>> {\n        let reset_seed = if self.has_reset_seed {\n            self.reset_seed\n        } else {\n            [0u8; 16]\n        };\n\n        let mut quic = Quic::new(\n            self.nb_connections,\n            self.server_cert_file.as_deref(),\n            self.server_key_file.as_deref(),\n            self.root_trust_file.as_deref(),\n            self.alpn.as_deref(),\n            default_callback,\n            None,\n            reset_seed,\n            current_time,\n            self.ticket_file_name.as_deref(),\n            self.ticket_encryption_key.as_deref(),\n        )?;\n\n        if self.do_retry {\n            quic.set_cookie_mode(1);\n        } else {\n            quic.set_cookie_mode(2);\n        }\n\n        if let Some(ref cc_id) = self.cc_algo_id {\n            let _ = quic.set_default_congestion_algorithm_by_name(cc_id);\n        }\n\n        let _ = quic.set_default_spinbit_policy(self.spinbit_policy);\n        quic.set_default_lossbit_policy(self.lossbit_policy);\n        quic.set_default_multipath_option(self.multipath_option);\n        quic.set_default_idle_timeout(crate::Duration::from_ticks(self.idle_timeout as u64 * 1000));\n        quic.set_cwin_max(self.cwin_max);\n        quic.set_default_address_discovery_mode(self.address_discovery_mode);\n\n        if let Some(ref token_file) = self.token_file_name {\n            let _ = quic.load_retry_tokens(token_file);\n        }\n\n        if self.force_zero_share {\n            quic.client_zero_share = true;\n        }\n\n        if self.mtu_max > 0 {\n            quic.set_mtu_max(self.mtu_max as u32);\n        }\n\n        if self.connection_id_length != -1 {\n            let _ = quic.set_default_connection_id_length(self.connection_id_length as u8);\n        }\n\n        quic.set_padding_policy(39, 128);\n\n        if let Some(ref bin_dir) = self.bin_dir {\n            let _ = quic.set_binlog(Some(bin_dir.as_str()));\n        }\n\n        if let Some(ref qlog_dir) = self.qlog_dir {\n            let _ = quic.set_qlog(qlog_dir.as_str());\n        }\n\n        if let Some(ref log_file) = self.log_file {\n            let _ = quic.set_textlog(Some(log_file.as_str()));\n        }\n\n        quic.set_log_level(if self.use_long_log { 1 } else { 0 });\n        quic.set_preemptive_repeat_policy(self.do_preemptive_repeat);\n        quic.set_port_blocking_disabled(self.disable_port_blocking);\n        quic.set_sslkeylog_enabled(self.enable_sslkeylog);\n\n        if self.initial_random <= 2 {\n            quic.set_random_initial(self.initial_random as i32);\n        }\n\n        if self.cipher_suite_id != 0 {\n            let iana_code = match self.cipher_suite_id {\n                20 => crate::CHACHA20_POLY1305_SHA256,\n                128 => crate::AES_128_GCM_SHA256,\n                256 => crate::AES_256_GCM_SHA384,\n                v => v as u16,\n            };\n            let _ = quic.set_cipher_suite(iana_code);\n        }\n\n        if self.do_retry {\n            quic.set_cookie_mode(1);\n        } else {\n            quic.set_cookie_mode(2);\n        }\n\n        quic.set_default_bdp_frame_option(self.bdp_frame_option != 0);\n\n        let mut failed = false;\n\n        if let Some(ref public_name) = self.ech_public_name {\n            if self.ech_key_file.is_none() || self.ech_config_file.is_none() {\n                // key file or config file not specified — cannot create ECH config\n            } else {\n                let key_file = self.ech_key_file.as_deref().unwrap();\n                let cfg_file = self.ech_config_file.as_deref().unwrap();\n                if crate::ech_create_config_file(public_name, key_file, cfg_file).is_err() {\n                    failed = true;\n                }\n            }\n        }\n\n        if !failed\n            && (self.ech_key_file.is_some() || self.ech_target.is_some())\n            && quic\n                .ech_configure(\n                    self.ech_key_file.as_deref(),\n                    self.ech_config_file.as_deref(),\n                )\n                .is_err()\n        {\n            failed = true;\n        }\n\n        if !failed && self.flow_control_max > 0 {\n            quic.set_max_data_control(self.flow_control_max);\n        }\n\n        if failed { None } else { Some(quic) }\n    }\n}\n\n#[cfg(test)]\nmod test {\n    use super::*;\n\n    // --- config_atoi ---\n\n    #[test]\n    fn atoi_valid_integer() {\n        assert_eq!(config_atoi(&[\"42\"], 0), Ok(42));\n    }\n\n    #[test]\n    fn atoi_zero() {\n        assert_eq!(config_atoi(&[\"0\"], 0), Ok(0));\n    }\n\n    #[test]\n    fn atoi_multi_digit() {\n        assert_eq!(config_atoi(&[\"12345\"], 0), Ok(12345));\n    }\n\n    #[test]\n    fn atoi_out_of_bounds_index() {\n        assert_eq!(config_atoi(&[\"5\"], 1), Err(Error::InvalidArgument));\n    }\n\n    #[test]\n    fn atoi_empty_params() {\n        assert_eq!(config_atoi(&[], 0), Err(Error::InvalidArgument));\n    }\n\n    #[test]\n    fn atoi_non_digit_char() {\n        assert_eq!(config_atoi(&[\"12a3\"], 0), Err(Error::InvalidArgument));\n    }\n\n    #[test]\n    fn atoi_negative_sign_rejected() {\n        // C version rejects any non-digit byte; '-' is not a digit\n        assert_eq!(config_atoi(&[\"-5\"], 0), Err(Error::InvalidArgument));\n    }\n\n    // --- config_optval_string ---\n\n    #[test]\n    fn optval_string_copies_within_capacity() {\n        let mut buf = [0u8; 16];\n        let result = config_optval_string(&mut buf, b\"hello\");\n        assert_eq!(result, \"hello\");\n        assert_eq!(buf[5], 0); // null terminator\n    }\n\n    #[test]\n    fn optval_string_truncates_to_buffer_minus_one() {\n        let mut buf = [0u8; 4]; // capacity 4 → max 3 bytes + NUL\n        let result = config_optval_string(&mut buf, b\"abcdef\");\n        assert_eq!(result, \"abc\");\n        assert_eq!(buf[3], 0);\n    }\n\n    #[test]\n    fn optval_string_empty_input() {\n        let mut buf = [0xffu8; 8];\n        let result = config_optval_string(&mut buf, b\"\");\n        assert_eq!(result, \"\");\n        assert_eq!(buf[0], 0);\n    }\n}\n","numLines":1595,"startLine":1,"totalLines":1595}}}
