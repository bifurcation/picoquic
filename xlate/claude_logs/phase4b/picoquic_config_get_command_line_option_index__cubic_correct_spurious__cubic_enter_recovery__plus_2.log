{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_016T8nnkkPZvcAgc3bc3du6P","type":"tool_result","content":"160\t    /// C: `cubic_enter_recovery` (picoquic/cubic.c:144)\n161\t    ///\n162\t    /// Record the start of a recovery epoch, apply the CUBIC fast-\n163\t    /// convergence rule, compute the new slow-start threshold, and\n164\t    /// either fall back to slow start (if the new threshold is too\n165\t    /// small) or enter congestion avoidance immediately.\n166\t    pub fn enter_recovery(\n167\t        &mut self,\n168\t        connection: &Connection,\n169\t        path_x: &mut Path,\n170\t        notification: CongestionNotification,\n171\t        current_time: u64,\n172\t    ) {\n173\t        use crate::Instant;\n174\t\n175\t        self.recovery_sequence = connection.sequence_number(path_x);\n176\t        self.previous_start_of_epoch = self.start_of_epoch;\n177\t        self.previous_alg_state = self.alg_state as u64;\n178\t        self.previous_ssthresh = self.ssthresh;\n179\t        self.previous_cwin = path_x.cwin;\n180\t\n181\t        self.w_max = path_x.cwin as f64 / path_x.send_mtu as f64;\n182\t\n183\t        // Fast convergence.\n184\t        if self.w_max < self.w_last_max {\n185\t            self.w_last_max = self.w_max;\n186\t            self.w_max *= CUBIC_BETA_ECN;\n187\t        } else {\n188\t            self.w_last_max = self.w_max;\n189\t        }\n190\t\n191\t        self.ssthresh = (self.w_max * CUBIC_BETA_ECN * path_x.send_mtu as f64) as u64;\n192\t\n193\t        if self.ssthresh < CWIN_MINIMUM {\n194\t            // Things are very bad — fall back to slow start.\n195\t            self.alg_state = CubicAlgState::SlowStart;\n196\t            self.ssthresh = u64::MAX;\n197\t            path_x.is_ssthresh_initialized = false;\n198\t            self.previous_start_of_epoch = self.start_of_epoch;\n199\t            self.start_of_epoch = current_time;\n200\t            self.w_reno = CWIN_MINIMUM as f64;\n201\t            path_x.cwin = CWIN_MINIMUM;\n202\t        } else if notification == CongestionNotification::Timeout {\n203\t            path_x.cwin = CWIN_MINIMUM;\n204\t            self.previous_start_of_epoch = self.start_of_epoch;\n205\t            self.start_of_epoch = current_time;\n206\t            self.alg_state = CubicAlgState::SlowStart;\n207\t        } else {\n208\t            // Enter congestion avoidance immediately.\n209\t            self.enter_avoidance(current_time);\n210\t            let w_cubic = self.w_cubic(current_time);\n211\t            let win_cubic = (w_cubic * path_x.send_mtu as f64) as u64;\n212\t            self.w_reno = path_x.cwin as f64 / 2.0;\n213\t            // See comment in cubic.c:195-200: w_cubic >= w_reno holds for\n214\t            // CUBIC_BETA_ECN > 0.618, so we pick win_cubic unconditionally.\n215\t            path_x.cwin = win_cubic;\n216\t        }\n217\t        let _ = Instant::from_ticks(0); // suppress unused-import warning\n218\t    }\n219\t"}]},"parent_tool_use_id":null,"session_id":"f89f9153-c014-4310-b972-78fe66d716ab","uuid":"f4bab10b-0b9e-4065-9e45-2ebe216c9972","timestamp":"2026-05-07T14:15:09.425Z","tool_use_result":{"type":"text","file":{"filePath":"/Users/richbarn/Projects/picoquic/rs/fq/src/cubic.rs","content":"    /// C: `cubic_enter_recovery` (picoquic/cubic.c:144)\n    ///\n    /// Record the start of a recovery epoch, apply the CUBIC fast-\n    /// convergence rule, compute the new slow-start threshold, and\n    /// either fall back to slow start (if the new threshold is too\n    /// small) or enter congestion avoidance immediately.\n    pub fn enter_recovery(\n        &mut self,\n        connection: &Connection,\n        path_x: &mut Path,\n        notification: CongestionNotification,\n        current_time: u64,\n    ) {\n        use crate::Instant;\n\n        self.recovery_sequence = connection.sequence_number(path_x);\n        self.previous_start_of_epoch = self.start_of_epoch;\n        self.previous_alg_state = self.alg_state as u64;\n        self.previous_ssthresh = self.ssthresh;\n        self.previous_cwin = path_x.cwin;\n\n        self.w_max = path_x.cwin as f64 / path_x.send_mtu as f64;\n\n        // Fast convergence.\n        if self.w_max < self.w_last_max {\n            self.w_last_max = self.w_max;\n            self.w_max *= CUBIC_BETA_ECN;\n        } else {\n            self.w_last_max = self.w_max;\n        }\n\n        self.ssthresh = (self.w_max * CUBIC_BETA_ECN * path_x.send_mtu as f64) as u64;\n\n        if self.ssthresh < CWIN_MINIMUM {\n            // Things are very bad — fall back to slow start.\n            self.alg_state = CubicAlgState::SlowStart;\n            self.ssthresh = u64::MAX;\n            path_x.is_ssthresh_initialized = false;\n            self.previous_start_of_epoch = self.start_of_epoch;\n            self.start_of_epoch = current_time;\n            self.w_reno = CWIN_MINIMUM as f64;\n            path_x.cwin = CWIN_MINIMUM;\n        } else if notification == CongestionNotification::Timeout {\n            path_x.cwin = CWIN_MINIMUM;\n            self.previous_start_of_epoch = self.start_of_epoch;\n            self.start_of_epoch = current_time;\n            self.alg_state = CubicAlgState::SlowStart;\n        } else {\n            // Enter congestion avoidance immediately.\n            self.enter_avoidance(current_time);\n            let w_cubic = self.w_cubic(current_time);\n            let win_cubic = (w_cubic * path_x.send_mtu as f64) as u64;\n            self.w_reno = path_x.cwin as f64 / 2.0;\n            // See comment in cubic.c:195-200: w_cubic >= w_reno holds for\n            // CUBIC_BETA_ECN > 0.618, so we pick win_cubic unconditionally.\n            path_x.cwin = win_cubic;\n        }\n        let _ = Instant::from_ticks(0); // suppress unused-import warning\n    }\n","numLines":60,"startLine":160,"totalLines":501}}}
