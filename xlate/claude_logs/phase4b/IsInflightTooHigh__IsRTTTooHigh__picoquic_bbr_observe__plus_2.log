{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01AX5cRvi1T5LeRFmmcD9KNc","type":"tool_result","content":"1050\t    #[test]\n1051\t    fn check_startup_full_bandwidth_generic_growing() {\n1052\t        let mut s = make_state();\n1053\t        s.round_start = true;\n1054\t        s.full_bw = 1000;\n1055\t        s.max_bw = 1300; // >= threshold(1.25) * 1000 = 1250 → still growing\n1056\t        let rs = BbrPerAckState::default();\n1057\t        s.check_startup_full_bandwidth_generic(&rs, 1.25);\n1058\t        assert_eq!(s.full_bw, 1300);\n1059\t        assert_eq!(s.full_bw_count, 0);\n1060\t        assert!(!s.filled_pipe);\n1061\t    }\n1062\t\n1063\t    #[test]\n1064\t    fn check_startup_full_bandwidth_generic_fills_after_3_rounds() {\n1065\t        let mut s = make_state();\n1066\t        s.round_start = true;\n1067\t        s.full_bw = 1000;\n1068\t        s.max_bw = 900; // < 1.25 * 1000 → not growing\n1069\t        let rs = BbrPerAckState::default();\n1070\t        s.check_startup_full_bandwidth_generic(&rs, 1.25);\n1071\t        assert_eq!(s.full_bw_count, 1);\n1072\t        assert!(!s.filled_pipe);\n1073\t        s.check_startup_full_bandwidth_generic(&rs, 1.25);\n1074\t        assert_eq!(s.full_bw_count, 2);\n1075\t        s.check_startup_full_bandwidth_generic(&rs, 1.25);\n1076\t        assert_eq!(s.full_bw_count, 3);\n1077\t        assert!(s.filled_pipe);\n1078\t    }\n1079\t\n1080\t    #[test]\n1081\t    fn check_startup_full_bandwidth_skips_when_app_limited() {\n1082\t        let mut s = make_state();\n1083\t        s.round_start = true;\n1084\t        s.full_bw = 1000;\n1085\t        s.max_bw = 900;\n1086\t        let rs = BbrPerAckState {\n1087\t            is_app_limited: true,\n1088\t            ..BbrPerAckState::default()\n1089\t        };\n1090\t        s.check_startup_full_bandwidth(&rs);\n1091\t        assert_eq!(s.full_bw_count, 0); // skipped\n1092\t    }\n1093\t\n1094\t    #[test]\n1095\t    fn check_startup_full_bandwidth_ecn_triggers_fill() {\n1096\t        let mut s = make_state();\n1097\t        s.round_start = true;\n1098\t        s.full_bw = 1000;\n1099\t        s.max_bw = 900;\n1100\t        // ecn_frac >= 0.2 should trigger filled_pipe even on first stall\n1101\t        let rs = BbrPerAckState {\n1102\t            ecn_frac: 0.3,\n1103\t            ..BbrPerAckState::default()\n1104\t        };\n1105\t        s.check_startup_full_bandwidth(&rs);\n1106\t        assert!(s.filled_pipe);\n1107\t    }\n1108\t\n1109\t    #[test]\n1110\t    fn check_app_limited_ended_accumulates_and_detects() {\n1111\t        let mut s = make_state();\n1112\t        // Simulate 4 app-limited rounds (> threshold of 3).\n1113\t        for _ in 0..4 {\n1114\t            s.round_start = true;\n1115\t            s.app_limited_this_round = 1;\n1116\t            let rs = BbrPerAckState::default();\n1117\t            let ended = s.check_app_limited_ended(&rs);\n1118\t            assert!(!ended);\n1119\t        }\n1120\t        // Now a non-app-limited round at round_start should return true.\n1121\t        s.round_start = true;\n1122\t        s.app_limited_this_round = 0;\n1123\t        let rs = BbrPerAckState::default();\n1124\t        let ended = s.check_app_limited_ended(&rs);\n1125\t        assert!(ended);\n1126\t        assert_eq!(s.app_limited_round_count, 0);\n1127\t    }\n1128\t\n1129\t    #[test]\n1130\t    fn check_app_limited_ended_mid_round_accumulates_flag() {\n1131\t        let mut s = make_state();\n1132\t        s.round_start = false;\n1133\t        s.app_limited_this_round = 0;\n1134\t        let rs = BbrPerAckState {\n1135\t            is_app_limited: true,\n1136\t            ..BbrPerAckState::default()\n1137\t        };\n1138\t        let ended = s.check_app_limited_ended(&rs);\n1139\t        assert!(!ended);"}]},"parent_tool_use_id":null,"session_id":"c7ee04fd-d40e-4f23-8adf-c23734b8992d","uuid":"ad2326d4-4662-4418-8d22-673e7bff3b8c","timestamp":"2026-05-07T05:04:36.265Z","tool_use_result":{"type":"text","file":{"filePath":"/Users/richbarn/Projects/picoquic/rs/fq/src/bbr.rs","content":"    #[test]\n    fn check_startup_full_bandwidth_generic_growing() {\n        let mut s = make_state();\n        s.round_start = true;\n        s.full_bw = 1000;\n        s.max_bw = 1300; // >= threshold(1.25) * 1000 = 1250 → still growing\n        let rs = BbrPerAckState::default();\n        s.check_startup_full_bandwidth_generic(&rs, 1.25);\n        assert_eq!(s.full_bw, 1300);\n        assert_eq!(s.full_bw_count, 0);\n        assert!(!s.filled_pipe);\n    }\n\n    #[test]\n    fn check_startup_full_bandwidth_generic_fills_after_3_rounds() {\n        let mut s = make_state();\n        s.round_start = true;\n        s.full_bw = 1000;\n        s.max_bw = 900; // < 1.25 * 1000 → not growing\n        let rs = BbrPerAckState::default();\n        s.check_startup_full_bandwidth_generic(&rs, 1.25);\n        assert_eq!(s.full_bw_count, 1);\n        assert!(!s.filled_pipe);\n        s.check_startup_full_bandwidth_generic(&rs, 1.25);\n        assert_eq!(s.full_bw_count, 2);\n        s.check_startup_full_bandwidth_generic(&rs, 1.25);\n        assert_eq!(s.full_bw_count, 3);\n        assert!(s.filled_pipe);\n    }\n\n    #[test]\n    fn check_startup_full_bandwidth_skips_when_app_limited() {\n        let mut s = make_state();\n        s.round_start = true;\n        s.full_bw = 1000;\n        s.max_bw = 900;\n        let rs = BbrPerAckState {\n            is_app_limited: true,\n            ..BbrPerAckState::default()\n        };\n        s.check_startup_full_bandwidth(&rs);\n        assert_eq!(s.full_bw_count, 0); // skipped\n    }\n\n    #[test]\n    fn check_startup_full_bandwidth_ecn_triggers_fill() {\n        let mut s = make_state();\n        s.round_start = true;\n        s.full_bw = 1000;\n        s.max_bw = 900;\n        // ecn_frac >= 0.2 should trigger filled_pipe even on first stall\n        let rs = BbrPerAckState {\n            ecn_frac: 0.3,\n            ..BbrPerAckState::default()\n        };\n        s.check_startup_full_bandwidth(&rs);\n        assert!(s.filled_pipe);\n    }\n\n    #[test]\n    fn check_app_limited_ended_accumulates_and_detects() {\n        let mut s = make_state();\n        // Simulate 4 app-limited rounds (> threshold of 3).\n        for _ in 0..4 {\n            s.round_start = true;\n            s.app_limited_this_round = 1;\n            let rs = BbrPerAckState::default();\n            let ended = s.check_app_limited_ended(&rs);\n            assert!(!ended);\n        }\n        // Now a non-app-limited round at round_start should return true.\n        s.round_start = true;\n        s.app_limited_this_round = 0;\n        let rs = BbrPerAckState::default();\n        let ended = s.check_app_limited_ended(&rs);\n        assert!(ended);\n        assert_eq!(s.app_limited_round_count, 0);\n    }\n\n    #[test]\n    fn check_app_limited_ended_mid_round_accumulates_flag() {\n        let mut s = make_state();\n        s.round_start = false;\n        s.app_limited_this_round = 0;\n        let rs = BbrPerAckState {\n            is_app_limited: true,\n            ..BbrPerAckState::default()\n        };\n        let ended = s.check_app_limited_ended(&rs);\n        assert!(!ended);","numLines":90,"startLine":1050,"totalLines":1343}}}
