(uint8_t* bytes, uint64_t n64)\n49\t{\n50\t    bytes[0] = (uint8_t)(n64 >> 56);\n51\t    bytes[1] = (uint8_t)(n64 >> 48);\n52\t    bytes[2] = (uint8_t)(n64 >> 40);\n53\t    bytes[3] = (uint8_t)(n64 >> 32);\n54\t    bytes[4] = (uint8_t)(n64 >> 24);\n55\t    bytes[5] = (uint8_t)(n64 >> 16);\n56\t    bytes[6] = (uint8_t)(n64 >> 8);\n57\t    bytes[7] = (uint8_t)(n64);\n58\t}\n59\t\n60\t/*\n61\t * Summary of Integer Encodings\n62\t * 2Bit \tLength \tUsable Bits \tRange\n63\t * 00       1        6       0-63\n64\t * 01       2       14       0-16383\n65\t * 10       4       30       0-1073741823\n66\t * 11       8       62       0-4611686018427387903\n67\t */\n68\tsize_t picoquic_encode_varint_length(uint64_t n64)\n69\t{\n70\t    if (n64 < 16384) {\n71\t        if (n64 < 64) {\n72\t            return 1u;\n73\t        } else {\n74\t            return 2u;\n75\t        }\n76\t    } else {\n77\t        if (n64 < 1073741824) {\n78\t            return 4u;\n79\t        } else {\n80\t            return 8u;\n81\t        }\n82\t    }\n83\t}\n84\t\n85\tsize_t picoquic_decode_varint_length(uint8_t byte)\n86\t{\n87\t    return ((size_t)1u) << ((byte & 0xC0) >> 6);\n88\t}\n89\t\n90\tsize_t picoquic_varint_encode(uint8_t* bytes, size_t max_bytes, uint64_t n64)\n91\t{\n92\t    uint8_t* x = bytes;\n93\t\n94\t    if (n64 < 16384) {\n95\t        if (n64 < 64) {\n96\t            if (max_bytes > 0) {\n97\t                *x++ = (uint8_t)(n64);\n98\t            }\n99\t        } else {\n100\t            if (max_bytes >= 2) {\n101\t                *x++ = (uint8_t)((n64 >> 8) | 0x40);\n102\t                *x++ = (uint8_t)(n64);\n103\t            }\n104\t        }\n105\t    } else if (n64 < 1073741824) {\n106\t        if (max_bytes >= 4) {\n107\t            *x++ = (uint8_t)((n64 >> 24) | 0x80);\n108\t            *x++ = (uint8_t)(n64 >> 16);\n109\t            *x++ = (uint8_t)(n64 >> 8);\n110\t            *x++ = (uint8_t)(n64);\n111\t        }\n112\t    } else {\n113\t        if (max_bytes >= 8) {\