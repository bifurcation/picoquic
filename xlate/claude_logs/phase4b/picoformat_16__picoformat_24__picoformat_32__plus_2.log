write_record(f, &payload);\n1222\t        }\n1223\t    }\n1224\t\n1225\t    fn transport_extension(&mut self, is_local: bool, params: &[u8]) {\n1226\t        if self.f_binlog.is_none() {\n1227\t            return;\n1228\t        }\n1229\t        let cid = self.initial_connection_id;\n1230\t        let now = self.quic_time();\n1231\t\n1232\t        let mut buf = ByteStreamBuf::default();\n1233\t        let Some(mut msg) = buf.stream(BYTESTREAM_MAX_BUFFER_SIZE) else {\n1234\t            return;\n1235\t        };\n1236\t        compose_event_header(&mut msg, &cid, now, 0, LogEventType::ParamUpdate);\n1237\t        let _ = msg.write_varint(if is_local { 1 } else { 0 });\n1238\t        let _ = msg.write_varint(params.len() as u64);\n1239\t        if !params.is_empty() {\n1240\t            let _ = msg.write_bytes(params);\n1241\t        }\n1242\t\n1243\t        let payload = msg.as_bytes().to_vec();\n1244\t        drop(msg);\n1245\t        if let Some(f) = self.f_binlog.as_mut() {\n1246\t            write_record(f, &payload);\n1247\t        }\n1248\t    }\n1249\t\n1250\t    fn new_connection(&mut self) {\n1251\t        // The C body opens a new file using `cnx->quic->binlog_dir`.\n1252\t        // `Connection` carries no back-pointer to its `Quic`, so the\n1253\t        // file-open path lives on the Quic side; here we only emit\n1254\t        // the `new_connection` record when the file handle is\n1255\t        // already attached, mirroring the C `bin_log_fns == NULL`\n1256\t        // short-circuit.\n1257\t        if self.f_binlog.is_none() {\n1258\t            return;\n1259\t        }\n1260\t\n1261\t        let cid = self.initial_connection_id;\n1262\t        let start_time = self.start_time;\n1263\t        let client_mode = self.client_mode;\n1264\t        let proposed_version = self.proposed_version;\n1265\t        let cc_id: &'static str = self\n1266\t            .congestion_alg\n1267\t            .map(|a| a.congestion_algorithm_id)\n1268\t            .unwrap_or(\"