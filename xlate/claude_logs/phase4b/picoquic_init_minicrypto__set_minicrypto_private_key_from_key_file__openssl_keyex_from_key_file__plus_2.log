{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01McZqKUiyuxSbhHAKpCsjRQ","type":"tool_result","content":"1\t//! OpenSSL backend (via the `openssl` crate).\n2\t//!\n3\t//! OpenSSL's QUIC API (introduced in 3.2) provides the building\n4\t//! blocks for a TLS-for-QUIC backend.  This module wires the\n5\t//! [`crate::tls`] traits to the `openssl` crate's bindings; the\n6\t//! Cargo feature `sys-openssl` gates the dependency.\n7\t\n8\textern crate alloc;\n9\tuse alloc::boxed::Box;\n10\tuse alloc::vec::Vec;\n11\t\n12\tuse crate::Error;\n13\tuse crate::internal::Version;\n14\tuse crate::tls::{\n15\t    ClientConfig, ConfigError, HandshakeData, KeyPair, KeyPairHeader, Keys, PeerIdentity,\n16\t    ServerConfig, Session, TlsBackend,\n17\t};\n18\tuse crate::tls_api::{hkdf_expand_label, pn_enc_create_for_test, setup_test_aead_context};\n19\t\n20\tconst SECRET_LEN: usize = 32;\n21\t\n22\t/// Top-level OpenSSL backend marker.\n23\tpub struct OpenSsl;\n24\t\n25\timpl TlsBackend for OpenSsl {\n26\t    type Client = OpenSslClientConfig;\n27\t    type Server = OpenSslServerConfig;\n28\t}\n29\t\n30\t/// Client-side configuration for OpenSSL.\n31\tpub struct OpenSslClientConfig;\n32\t\n33\timpl ClientConfig for OpenSslClientConfig {\n34\t    type Session = OpenSslSession;\n35\t\n36\t    fn start_session(\n37\t        &self,\n38\t        version: u32,\n39\t        server_name: &str,\n40\t        transport_params: &[u8],\n41\t    ) -> Result<Self::Session, ConfigError> {\n42\t        Ok(OpenSslSession::new(\n43\t            TlsRole::Client,\n44\t            version,\n45\t            Some(server_name.as_bytes().to_vec()),\n46\t            transport_params,\n47\t        ))\n48\t    }\n49\t}\n50\t\n51\t/// Server-side configuration for OpenSSL.\n52\tpub struct OpenSslServerConfig;\n53\t\n54\timpl ServerConfig for OpenSslServerConfig {\n55\t    type Session = OpenSslSession;\n56\t\n57\t    fn start_session(\n58\t        &self,\n59\t        version: u32,\n60\t        transport_params: &[u8],\n61\t    ) -> Result<Self::Session, ConfigError> {\n62\t        Ok(OpenSslSession::new(\n63\t            TlsRole::Server,\n64\t            version,\n65\t            None,\n66\t            transport_params,\n67\t        ))\n68\t    }\n69\t}\n70\t\n71\t#[derive(Debug, Copy, Clone, PartialEq, Eq)]\n72\tenum TlsRole {\n73\t    Client,\n74\t    Server,\n75\t}\n76\t\n77\t/// Per-connection OpenSSL session state.\n78\tpub struct OpenSslSession {\n79\t    role: TlsRole,\n80\t    version: u32,\n81\t    server_name: Option<Vec<u8>>,\n82\t    transport_params: Vec<u8>,\n83\t    wrote_handshake: bool,\n84\t    handshaking: bool,\n85\t    yielded_1rtt: bool,\n86\t    saw_peer_handshake: bool,\n87\t}\n88\t\n89\timpl OpenSslSession {\n90\t    fn new(\n91\t        role: TlsRole,\n92\t        version: u32,\n93\t        server_name: Option<Vec<u8>>,\n94\t        transport_params: &[u8],\n95\t    ) -> Self {\n96\t        Self {\n97\t            role,\n98\t            version,\n99\t            server_name,\n100\t            transport_params: transport_params.to_vec(),\n101\t            wrote_handshake: false,\n102\t            handshaking: true,\n103\t            yielded_1rtt: false,\n104\t            saw_peer_handshake: false,\n105\t        }\n106\t    }\n107\t\n108\t    fn prefix_label(&self) -> &'static str {\n109\t        Version::try_from_wire(self.version)\n110\t            .unwrap_or(Version::V1)\n111\t            .parameters()\n112\t            .tls_prefix_label\n113\t    }\n114\t\n115\t    fn mix_seed(seed: &mut [u8; SECRET_LEN], bytes: &[u8]) {\n116\t        for (i, b) in bytes.iter().enumerate() {\n117\t            let slot = i % seed.len();\n118\t            seed[slot] = seed[slot].wrapping_add(*b).rotate_left((i % 8) as u32) ^ (i as u8);\n119\t        }\n120\t    }\n121\t\n122\t    fn seed(&self, label: &str) -> [u8; SECRET_LEN] {\n123\t        let mut seed = [0u8; SECRET_LEN];\n124\t        seed[..4].copy_from_slice(&self.version.to_be_bytes());\n125\t        seed[4] = match self.role {\n126\t            TlsRole::Client => 0xc1,\n127\t            TlsRole::Server => 0x5e,\n128\t        };\n129\t        Self::mix_seed(&mut seed, label.as_bytes());\n130\t        if let Some(server_name) = &self.server_name {\n131\t            Self::mix_seed(&mut seed, server_name);\n132\t        }\n133\t        Self::mix_seed(&mut seed, &self.transport_params);\n134\t        seed\n135\t    }\n136\t\n137\t    fn traffic_secret(&self, label: &str) -> Option<[u8; SECRET_LEN]> {\n138\t        let seed = self.seed(label);\n139\t        let mut secret = [0u8; SECRET_LEN];\n140\t        hkdf_expand_label(label, self.prefix_label(), &seed, &mut secret).ok()?;\n141\t        Some(secret)\n142\t    }\n143\t\n144\t    fn keys(&self) -> Option<Keys> {\n145\t        let (local_label, remote_label) = match self.role {\n146\t            TlsRole::Client => (\"client app\", \"server app\"),\n147\t            TlsRole::Server => (\"server app\", \"client app\"),\n148\t        };\n149\t        let local_secret = self.traffic_secret(local_label)?;\n150\t        let remote_secret = self.traffic_secret(remote_label)?;\n151\t        let prefix = self.prefix_label();\n152\t        Some(Keys {\n153\t            header: KeyPairHeader {\n154\t                local: pn_enc_create_for_test(&local_secret, prefix)?,\n155\t                remote: pn_enc_create_for_test(&remote_secret, prefix)?,\n156\t            },\n157\t            packet: KeyPair {\n158\t                local: setup_test_aead_context(true, &local_secret, prefix)?,\n159\t                remote: setup_test_aead_context(false, &remote_secret, prefix)?,\n160\t            },\n161\t        })\n162\t    }\n163\t\n164\t    fn handshake_bytes(&self) -> &'static [u8] {\n165\t        match self.role {\n166\t            TlsRole::Client => b\"openssl client hello\",\n167\t            TlsRole::Server => b\"openssl server hello\",\n168\t        }\n169\t    }\n170\t}\n171\t\n172\timpl Session for OpenSslSession {\n173\t    fn read_handshake(&mut self, plaintext: &[u8]) -> Result<bool, Error> {\n174\t        if plaintext.is_empty() {\n175\t            return Ok(false);\n176\t        }\n177\t        let changed = self.handshaking;\n178\t        self.saw_peer_handshake = true;\n179\t        self.handshaking = false;\n180\t        Ok(changed)\n181\t    }\n182\t\n183\t    fn write_handshake(&mut self, buf: &mut Vec<u8>) -> Option<Keys> {\n184\t        if !self.wrote_handshake {\n185\t            self.wrote_handshake = true;\n186\t            buf.extend_from_slice(self.handshake_bytes());\n187\t            buf.extend_from_slice(&self.transport_params);\n188\t        }\n189\t        if self.yielded_1rtt {\n190\t            None\n191\t        } else {\n192\t            self.yielded_1rtt = true;\n193\t            self.keys()\n194\t        }\n195\t    }\n196\t\n197\t    fn is_handshaking(&self) -> bool {\n198\t        self.handshaking\n199\t    }\n200\t\n201\t    fn next_1rtt_keys(&mut self) -> Option<KeyPair> {\n202\t        if self.handshaking || self.yielded_1rtt {\n203\t            return None;\n204\t        }\n205\t        self.yielded_1rtt = true;\n206\t        self.keys().map(|keys| keys.packet)\n207\t    }\n208\t\n209\t    fn handshake_data(&self) -> Option<HandshakeData> {\n210\t        if self.role == TlsRole::Server && self.saw_peer_handshake {\n211\t            Some(HandshakeData {\n212\t                sni: self.server_name.clone(),\n213\t                alpn: None,\n214\t            })\n215\t        } else {\n216\t            None\n217\t        }\n218\t    }\n219\t\n220\t    fn peer_identity(&self) -> Option<PeerIdentity> {\n221\t        None\n222\t    }\n223\t\n224\t    fn early_keys(\n225\t        &self,\n226\t    ) -> Option<(\n227\t        Box<dyn crate::tls::HeaderKey>,\n228\t        Box<dyn crate::tls::PacketKey>,\n229\t    )> {\n230\t        None\n231\t    }\n232\t\n233\t    fn early_data_accepted(&self) -> Option<bool> {\n234\t        Some(false)\n235\t    }\n236\t\n237\t    fn transport_parameters(&self) -> Result<Option<Vec<u8>>, Error> {\n238\t        Ok(Some(self.transport_params.clone()))\n239\t    }\n240\t\n241\t    fn export_keying_material(\n242\t        &self,\n243\t        label: &[u8],\n244\t        context: &[u8],\n245\t        output: &mut [u8],\n246\t    ) -> Result<(), Error> {\n247\t        let mut seed = self.seed(\"exporter\");\n248\t        Self::mix_seed(&mut seed, label);\n249\t        Self::mix_seed(&mut seed, context);\n250\t        hkdf_expand_label(\"exporter\", self.prefix_label(), &seed, output)\n251\t    }\n252\t}\n253\t"}]},"parent_tool_use_id":null,"session_id":"9575bc69-3d97-4e73-8938-e9dde5ba8cbf","uuid":"10e33a34-2f87-4d26-82b3-172fe4f1e31b","timestamp":"2026-05-07T06:42:28.611Z","tool_use_result":{"type":"text","file":{"filePath":"/Users/richbarn/Projects/picoquic/rs/fq/src/sys/openssl.rs","content":"//! OpenSSL backend (via the `openssl` crate).\n//!\n//! OpenSSL's QUIC API (introduced in 3.2) provides the building\n//! blocks for a TLS-for-QUIC backend.  This module wires the\n//! [`crate::tls`] traits to the `openssl` crate's bindings; the\n//! Cargo feature `sys-openssl` gates the dependency.\n\nextern crate alloc;\nuse alloc::boxed::Box;\nuse alloc::vec::Vec;\n\nuse crate::Error;\nuse crate::internal::Version;\nuse crate::tls::{\n    ClientConfig, ConfigError, HandshakeData, KeyPair, KeyPairHeader, Keys, PeerIdentity,\n    ServerConfig, Session, TlsBackend,\n};\nuse crate::tls_api::{hkdf_expand_label, pn_enc_create_for_test, setup_test_aead_context};\n\nconst SECRET_LEN: usize = 32;\n\n/// Top-level OpenSSL backend marker.\npub struct OpenSsl;\n\nimpl TlsBackend for OpenSsl {\n    type Client = OpenSslClientConfig;\n    type Server = OpenSslServerConfig;\n}\n\n/// Client-side configuration for OpenSSL.\npub struct OpenSslClientConfig;\n\nimpl ClientConfig for OpenSslClientConfig {\n    type Session = OpenSslSession;\n\n    fn start_session(\n        &self,\n        version: u32,\n        server_name: &str,\n        transport_params: &[u8],\n    ) -> Result<Self::Session, ConfigError> {\n        Ok(OpenSslSession::new(\n            TlsRole::Client,\n            version,\n            Some(server_name.as_bytes().to_vec()),\n            transport_params,\n        ))\n    }\n}\n\n/// Server-side configuration for OpenSSL.\npub struct OpenSslServerConfig;\n\nimpl ServerConfig for OpenSslServerConfig {\n    type Session = OpenSslSession;\n\n    fn start_session(\n        &self,\n        version: u32,\n        transport_params: &[u8],\n    ) -> Result<Self::Session, ConfigError> {\n        Ok(OpenSslSession::new(\n            TlsRole::Server,\n            version,\n            None,\n            transport_params,\n        ))\n    }\n}\n\n#[derive(Debug, Copy, Clone, PartialEq, Eq)]\nenum TlsRole {\n    Client,\n    Server,\n}\n\n/// Per-connection OpenSSL session state.\npub struct OpenSslSession {\n    role: TlsRole,\n    version: u32,\n    server_name: Option<Vec<u8>>,\n    transport_params: Vec<u8>,\n    wrote_handshake: bool,\n    handshaking: bool,\n    yielded_1rtt: bool,\n    saw_peer_handshake: bool,\n}\n\nimpl OpenSslSession {\n    fn new(\n        role: TlsRole,\n        version: u32,\n        server_name: Option<Vec<u8>>,\n        transport_params: &[u8],\n    ) -> Self {\n        Self {\n            role,\n            version,\n            server_name,\n            transport_params: transport_params.to_vec(),\n            wrote_handshake: false,\n            handshaking: true,\n            yielded_1rtt: false,\n            saw_peer_handshake: false,\n        }\n    }\n\n    fn prefix_label(&self) -> &'static str {\n        Version::try_from_wire(self.version)\n            .unwrap_or(Version::V1)\n            .parameters()\n            .tls_prefix_label\n    }\n\n    fn mix_seed(seed: &mut [u8; SECRET_LEN], bytes: &[u8]) {\n        for (i, b) in bytes.iter().enumerate() {\n            let slot = i % seed.len();\n            seed[slot] = seed[slot].wrapping_add(*b).rotate_left((i % 8) as u32) ^ (i as u8);\n        }\n    }\n\n    fn seed(&self, label: &str) -> [u8; SECRET_LEN] {\n        let mut seed = [0u8; SECRET_LEN];\n        seed[..4].copy_from_slice(&self.version.to_be_bytes());\n        seed[4] = match self.role {\n            TlsRole::Client => 0xc1,\n            TlsRole::Server => 0x5e,\n        };\n        Self::mix_seed(&mut seed, label.as_bytes());\n        if let Some(server_name) = &self.server_name {\n            Self::mix_seed(&mut seed, server_name);\n        }\n        Self::mix_seed(&mut seed, &self.transport_params);\n        seed\n    }\n\n    fn traffic_secret(&self, label: &str) -> Option<[u8; SECRET_LEN]> {\n        let seed = self.seed(label);\n        let mut secret = [0u8; SECRET_LEN];\n        hkdf_expand_label(label, self.prefix_label(), &seed, &mut secret).ok()?;\n        Some(secret)\n    }\n\n    fn keys(&self) -> Option<Keys> {\n        let (local_label, remote_label) = match self.role {\n            TlsRole::Client => (\"client app\", \"server app\"),\n            TlsRole::Server => (\"server app\", \"client app\"),\n        };\n        let local_secret = self.traffic_secret(local_label)?;\n        let remote_secret = self.traffic_secret(remote_label)?;\n        let prefix = self.prefix_label();\n        Some(Keys {\n            header: KeyPairHeader {\n                local: pn_enc_create_for_test(&local_secret, prefix)?,\n                remote: pn_enc_create_for_test(&remote_secret, prefix)?,\n            },\n            packet: KeyPair {\n                local: setup_test_aead_context(true, &local_secret, prefix)?,\n                remote: setup_test_aead_context(false, &remote_secret, prefix)?,\n            },\n        })\n    }\n\n    fn handshake_bytes(&self) -> &'static [u8] {\n        match self.role {\n            TlsRole::Client => b\"openssl client hello\",\n            TlsRole::Server => b\"openssl server hello\",\n        }\n    }\n}\n\nimpl Session for OpenSslSession {\n    fn read_handshake(&mut self, plaintext: &[u8]) -> Result<bool, Error> {\n        if plaintext.is_empty() {\n            return Ok(false);\n        }\n        let changed = self.handshaking;\n        self.saw_peer_handshake = true;\n        self.handshaking = false;\n        Ok(changed)\n    }\n\n    fn write_handshake(&mut self, buf: &mut Vec<u8>) -> Option<Keys> {\n        if !self.wrote_handshake {\n            self.wrote_handshake = true;\n            buf.extend_from_slice(self.handshake_bytes());\n            buf.extend_from_slice(&self.transport_params);\n        }\n        if self.yielded_1rtt {\n            None\n        } else {\n            self.yielded_1rtt = true;\n            self.keys()\n        }\n    }\n\n    fn is_handshaking(&self) -> bool {\n        self.handshaking\n    }\n\n    fn next_1rtt_keys(&mut self) -> Option<KeyPair> {\n        if self.handshaking || self.yielded_1rtt {\n            return None;\n        }\n        self.yielded_1rtt = true;\n        self.keys().map(|keys| keys.packet)\n    }\n\n    fn handshake_data(&self) -> Option<HandshakeData> {\n        if self.role == TlsRole::Server && self.saw_peer_handshake {\n            Some(HandshakeData {\n                sni: self.server_name.clone(),\n                alpn: None,\n            })\n        } else {\n            None\n        }\n    }\n\n    fn peer_identity(&self) -> Option<PeerIdentity> {\n        None\n    }\n\n    fn early_keys(\n        &self,\n    ) -> Option<(\n        Box<dyn crate::tls::HeaderKey>,\n        Box<dyn crate::tls::PacketKey>,\n    )> {\n        None\n    }\n\n    fn early_data_accepted(&self) -> Option<bool> {\n        Some(false)\n    }\n\n    fn transport_parameters(&self) -> Result<Option<Vec<u8>>, Error> {\n        Ok(Some(self.transport_params.clone()))\n    }\n\n    fn export_keying_material(\n        &self,\n        label: &[u8],\n        context: &[u8],\n        output: &mut [u8],\n    ) -> Result<(), Error> {\n        let mut seed = self.seed(\"exporter\");\n        Self::mix_seed(&mut seed, label);\n        Self::mix_seed(&mut seed, context);\n        hkdf_expand_label(\"exporter\", self.prefix_label(), &seed, output)\n    }\n}\n","numLines":253,"startLine":1,"totalLines":253}}}
