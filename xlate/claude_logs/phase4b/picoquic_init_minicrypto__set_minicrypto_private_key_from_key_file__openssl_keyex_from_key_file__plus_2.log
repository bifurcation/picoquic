{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_019tq4ci8KxbeRRSSL4csAP3","type":"tool_result","content":"253\t\n254\t// ---------------------------------------------------------------------------\n255\t// Global init / clear helpers.\n256\t//\n257\t// The C module (`picoquic_ptls_openssl.c`) keeps a `static int\n258\t// openssl_is_init` flag and a `static OSSL_PROVIDER*` handle (OpenSSL\n259\t// 3.x only).  Rust models the flag with `AtomicBool` and the provider\n260\t// with `Mutex<Option<…>>` so the provider is unloaded (via `Drop`) when\n261\t// `clear_openssl` sets it to `None`.\n262\t\n263\tuse std::sync::Mutex;\n264\tuse std::sync::atomic::{AtomicBool, Ordering};\n265\t\n266\tstatic OPENSSL_IS_INIT: AtomicBool = AtomicBool::new(false);\n267\t\n268\t// OpenSSL 3.x: hold the default provider so we can unload it on clear.\n269\t// Gated on the `ossl300` cfg set by the openssl-sys build script.\n270\t#[cfg(ossl300)]\n271\tstatic OPENSSL_DEFAULT_PROVIDER: Mutex<Option<openssl::provider::Provider>> = Mutex::new(None);\n272\t\n273\t/// Initialize the OpenSSL library; idempotent.  On OpenSSL ≥ 3.0 loads\n274\t/// the default provider; on 1.x calls `OpenSSL_add_all_algorithms` and\n275\t/// the built-in ENGINE setup (via `openssl::init()`).\n276\t/// C: `picoquic_init_openssl`.\n277\tpub fn init_openssl() {\n278\t    if !OPENSSL_IS_INIT.swap(true, Ordering::SeqCst) {\n279\t        openssl::init();\n280\t        #[cfg(ossl300)]\n281\t        {\n282\t            let mut guard = OPENSSL_DEFAULT_PROVIDER.lock().unwrap();\n283\t            if guard.is_none() {\n284\t                *guard = openssl::provider::Provider::load(None, \"default\").ok();\n285\t            }\n286\t        }\n287\t    }\n288\t}\n289\t\n290\t/// Tear down OpenSSL state installed by [`init_openssl`].  On OpenSSL ≥ 3.0\n291\t/// the default provider is unloaded by dropping the stored handle.  On\n292\t/// OpenSSL 1.x the cleanup functions (`EVP_cleanup`, `ERR_free_strings`,\n293\t/// `ENGINE_cleanup`) are deprecated / removed and handled by OpenSSL's own\n294\t/// `atexit` hooks; the Rust `openssl` crate does not expose them.\n295\t/// C: `picoquic_clear_openssl`.\n296\tpub fn clear_openssl() {\n297\t    if OPENSSL_IS_INIT.swap(false, Ordering::SeqCst) {\n298\t        #[cfg(ossl300)]\n299\t        {\n300\t            let mut guard = OPENSSL_DEFAULT_PROVIDER.lock().unwrap();\n301\t            *guard = None; // Drop triggers OSSL_PROVIDER_unload.\n302\t        }\n303\t    }\n304\t}\n305\t\n306\t// ---------------------------------------------------------------------------\n307\t// Key-exchange context from a private-key file.\n308\t\n309\t/// Per-connection key-exchange context backed by an OpenSSL private key.\n310\t/// Corresponds to `ptls_key_exchange_context_t *` created by\n311\t/// `ptls_openssl_create_key_exchange`.\n312\tpub struct KeyExchangeContext {\n313\t    pub(crate) key: openssl::pkey::PKey<openssl::pkey::Private>,\n314\t}\n315\t\n316\t/// Read a PEM-encoded private key from `keypem` and build a key-exchange\n317\t/// context for it.  Returns `Err(NoSuchFile)` when the path is unreadable\n318\t/// and `Err(InvalidFile)` when the PEM cannot be parsed as a private key.\n319\t/// C: `openssl_keyex_from_key_file`.\n320\tpub fn openssl_keyex_from_key_file(keypem: &str) -> Result<KeyExchangeContext, crate::Error> {\n321\t    let pem = std::fs::read(keypem).map_err(|_| crate::Error::NoSuchFile)?;\n322\t    let key =\n323\t        openssl::pkey::PKey::private_key_from_pem(&pem).map_err(|_| crate::Error::InvalidFile)?;\n324\t    Ok(KeyExchangeContext { key })\n325\t}\n326\t"}]},"parent_tool_use_id":null,"session_id":"9575bc69-3d97-4e73-8938-e9dde5ba8cbf","uuid":"874ef006-0a5b-460a-82c3-dd332f4df17d","timestamp":"2026-05-07T06:47:08.937Z","tool_use_result":{"type":"text","file":{"filePath":"/Users/richbarn/Projects/picoquic/rs/fq/src/sys/openssl.rs","content":"\n// ---------------------------------------------------------------------------\n// Global init / clear helpers.\n//\n// The C module (`picoquic_ptls_openssl.c`) keeps a `static int\n// openssl_is_init` flag and a `static OSSL_PROVIDER*` handle (OpenSSL\n// 3.x only).  Rust models the flag with `AtomicBool` and the provider\n// with `Mutex<Option<…>>` so the provider is unloaded (via `Drop`) when\n// `clear_openssl` sets it to `None`.\n\nuse std::sync::Mutex;\nuse std::sync::atomic::{AtomicBool, Ordering};\n\nstatic OPENSSL_IS_INIT: AtomicBool = AtomicBool::new(false);\n\n// OpenSSL 3.x: hold the default provider so we can unload it on clear.\n// Gated on the `ossl300` cfg set by the openssl-sys build script.\n#[cfg(ossl300)]\nstatic OPENSSL_DEFAULT_PROVIDER: Mutex<Option<openssl::provider::Provider>> = Mutex::new(None);\n\n/// Initialize the OpenSSL library; idempotent.  On OpenSSL ≥ 3.0 loads\n/// the default provider; on 1.x calls `OpenSSL_add_all_algorithms` and\n/// the built-in ENGINE setup (via `openssl::init()`).\n/// C: `picoquic_init_openssl`.\npub fn init_openssl() {\n    if !OPENSSL_IS_INIT.swap(true, Ordering::SeqCst) {\n        openssl::init();\n        #[cfg(ossl300)]\n        {\n            let mut guard = OPENSSL_DEFAULT_PROVIDER.lock().unwrap();\n            if guard.is_none() {\n                *guard = openssl::provider::Provider::load(None, \"default\").ok();\n            }\n        }\n    }\n}\n\n/// Tear down OpenSSL state installed by [`init_openssl`].  On OpenSSL ≥ 3.0\n/// the default provider is unloaded by dropping the stored handle.  On\n/// OpenSSL 1.x the cleanup functions (`EVP_cleanup`, `ERR_free_strings`,\n/// `ENGINE_cleanup`) are deprecated / removed and handled by OpenSSL's own\n/// `atexit` hooks; the Rust `openssl` crate does not expose them.\n/// C: `picoquic_clear_openssl`.\npub fn clear_openssl() {\n    if OPENSSL_IS_INIT.swap(false, Ordering::SeqCst) {\n        #[cfg(ossl300)]\n        {\n            let mut guard = OPENSSL_DEFAULT_PROVIDER.lock().unwrap();\n            *guard = None; // Drop triggers OSSL_PROVIDER_unload.\n        }\n    }\n}\n\n// ---------------------------------------------------------------------------\n// Key-exchange context from a private-key file.\n\n/// Per-connection key-exchange context backed by an OpenSSL private key.\n/// Corresponds to `ptls_key_exchange_context_t *` created by\n/// `ptls_openssl_create_key_exchange`.\npub struct KeyExchangeContext {\n    pub(crate) key: openssl::pkey::PKey<openssl::pkey::Private>,\n}\n\n/// Read a PEM-encoded private key from `keypem` and build a key-exchange\n/// context for it.  Returns `Err(NoSuchFile)` when the path is unreadable\n/// and `Err(InvalidFile)` when the PEM cannot be parsed as a private key.\n/// C: `openssl_keyex_from_key_file`.\npub fn openssl_keyex_from_key_file(keypem: &str) -> Result<KeyExchangeContext, crate::Error> {\n    let pem = std::fs::read(keypem).map_err(|_| crate::Error::NoSuchFile)?;\n    let key =\n        openssl::pkey::PKey::private_key_from_pem(&pem).map_err(|_| crate::Error::InvalidFile)?;\n    Ok(KeyExchangeContext { key })\n}\n","numLines":74,"startLine":253,"totalLines":326}}}
