{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01UBf98j1MjfjHqC8wt14KBy","type":"tool_result","content":"1\t//! Translation of `quic/cc_common.h`.\n2\t//!\n3\t//! Shared helpers used by every congestion-control module: RTT\n4\t//! filtering, HyStart / HyStart++ slow-start exit tests, slow-start\n5\t//! window-growth helpers, and the standalone New Reno simulator that\n6\t//! several other algorithms run as a lower-bound estimator.\n7\t//!\n8\t//! Phase 4: all function bodies are implemented.\n9\t\n10\tuse crate::internal::{\n11\t    CWIN_INITIAL, CWIN_MINIMUM, Connection, Path, TARGET_RENO_RTT, TARGET_SATELLITE_RTT,\n12\t};\n13\tuse crate::{CongestionNotification, Duration, Instant, PerAckState};\n14\t\n15\t// ---------------------------------------------------------------------------\n16\t// Tunable constants (`#define`s in the header).\n17\t\n18\t/// Window size of the min/max RTT filter, counted in RTT\n19\t/// measurements.  Doubles as the threshold of consecutive\n20\t/// RTT-excess measurements that trigger slow-start exit.  Used as\n21\t/// an array dimension below, hence `usize`.\n22\tpub const MIN_MAX_RTT_SCOPE: usize = 7;\n23\t\n24\t/// Lookback window for the smoothed packet-loss filter, in packets.\n25\tpub const SMOOTHED_LOSS_SCOPE: u64 = 32;\n26\t\n27\t/// Per-step decay factor for the smoothed loss-rate EMA.  Equivalent\n28\t/// to `1.0 / 16.0`, written explicitly for parity with the C macro.\n29\tpub const SMOOTHED_LOSS_FACTOR: f64 = 1.0 / 16.0;\n30\t\n31\t/// Drop-rate threshold above which the volume-based HyStart loss\n32\t/// test triggers slow-start exit.\n33\tpub const SMOOTHED_LOSS_THRESHOLD: f64 = 0.15;\n34\t\n35\t// HyStart++ tuning constants.  Values come from the IETF HyStart++\n36\t// draft (RFC 9406-equivalent); see the C header for the full\n37\t// rationale, including why `L` is omitted (quic is always paced).\n38\t\n39\tpub const HYSTART_PP_MIN_RTT_THRESH: u64 = 4_000;\n40\tpub const HYSTART_PP_MAX_RTT_THRESH: u64 = 16_000;\n41\tpub const HYSTART_PP_MIN_RTT_DIVISOR: u64 = 8;\n42\tpub const HYSTART_PP_N_RTT_SAMPLE: u64 = 8;\n43\tpub const HYSTART_PP_CSS_GROWTH_DIVISOR: u64 = 4;\n44\tpub const HYSTART_PP_CSS_ROUNDS: u64 = 5;\n45\t\n46\t// ---------------------------------------------------------------------------\n47\t// RTT filter and HyStart-related state.\n48\t\n49\t/// Rolling min/max RTT filter plus smoothed-loss bookkeeping shared\n50\t/// by HyStart exit tests.  C: `picoquic_min_max_rtt_t`.\n51\t///\n52\t/// Type deviations from C: `is_init` (`int` → `bool`);\n53\t/// `sample_current` (`int` → `usize`, used as array index);\n54\t/// `nb_rtt_excess` (`int` → `u32`, always non-negative; safety wins).\n55\t#[derive(Debug, Clone)]\n56\tpub struct MinMaxRtt {\n57\t    /// `None` until the first RTT measurement arrives.\n58\t    pub last_rtt_sample_time: Option<Instant>,\n59\t    pub rtt_filtered_min: Duration,\n60\t    pub nb_rtt_excess: u32,\n61\t    pub sample_current: usize,\n62\t    pub is_init: bool,\n63\t    pub smoothed_drop_rate: f64,\n64\t    /// Smoothed byte-count EMA stored in fixed-point with an\n65\t    /// implicit ×16 multiplier (each step is `prev - prev/16 + new`,\n66\t    /// see `picoquic_cc_hystart_loss_volume_test`); the extra range\n67\t    /// avoids precision loss in integer EMA arithmetic.\n68\t    pub smoothed_bytes_sent_16: u64,\n69\t    /// Same fixed-point convention as [`Self::smoothed_bytes_sent_16`].\n70\t    pub smoothed_bytes_lost_16: u64,\n71\t    pub last_lost_packet_number: u64,\n72\t    pub sample_min: Duration,\n73\t    pub sample_max: Duration,\n74\t    pub samples: [Duration; MIN_MAX_RTT_SCOPE],\n75\t}\n76\t\n77\timpl Default for MinMaxRtt {\n78\t    fn default() -> Self {\n79\t        Self {\n80\t            last_rtt_sample_time: None,"}]},"parent_tool_use_id":null,"session_id":"589969e0-25c9-4813-acd8-cf423be18f35","uuid":"d74341a4-111e-4387-9fcf-331f9e38e25d","timestamp":"2026-05-07T05:28:12.035Z","tool_use_result":{"type":"t