{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01RsDdg92yDDP7gVsvSN6jJX","type":"tool_result","content":"186\t    /// C: `c4_update_ecn_alpha` (picoquic/c4.c:321)\n187\t    ///\n188\t    /// Computes the ECN alpha estimate using an EWMA, similar to the Prague\n189\t    /// implementation.  Picks the packet context from the path under multipath\n190\t    /// or from the connection's application context under single-path.\n191\t    pub(crate) fn update_ecn_alpha(&mut self, path_x: &Path, connection: &Connection) {\n192\t        let pkt_ctx = if connection.is_multipath_enabled {\n193\t            &path_x.pkt_ctx\n194\t        } else {\n195\t            &connection.pkt_ctx[PacketContext::Application as usize]\n196\t        };\n197\t\n198\t        let delta_ect1 = pkt_ctx.ecn_ect1_total_remote as i64 - self.ecn_ect1 as i64;\n199\t        let delta_ce = pkt_ctx.ecn_ce_total_remote as i64 - self.ecn_ce as i64;\n200\t\n201\t        self.ecn_ect1 = pkt_ctx.ecn_ect1_total_remote;\n202\t        self.ecn_ce = pkt_ctx.ecn_ce_total_remote;\n203\t\n204\t        if delta_ce > 0 || delta_ect1 > 0 {\n205\t            let sum = delta_ce + delta_ect1;\n206\t            let frac: u64 = if sum > 0 {\n207\t                ((delta_ce * 1024) / sum) as u64\n208\t            } else {\n209\t                0\n210\t            };\n211\t\n212\t            if frac > self.ecn_alpha && frac >= 512 {\n213\t                self.ecn_alpha = frac;\n214\t            } else {\n215\t                // EWMA: alpha = alpha*(1 - 1/2^shift) + frac*(1/2^shift)\n216\t                let alpha_shifted = (self.ecn_alpha << C4_ECN_SHIFT_G) - self.ecn_alpha + frac;\n217\t                self.ecn_alpha = alpha_shifted >> C4_ECN_SHIFT_G;\n218\t            }\n219\t        }\n220\t    }\n221\t}\n222\t\n223\t#[cfg(test)]\n224\tmod tests {\n225\t    use super::*;\n226\t\n227\t    fn make_state() -> C4State {\n228\t        C4State {\n229\t            alg_state: C4AlgState::default(),\n230\t            nominal_rate: 0,\n231\t            nominal_max_rtt: 0,\n232\t            initial_cwnd: 0,\n233\t            running_min_rtt: 0,\n234\t            alpha_1024_current: 0,\n235\t            alpha_1024_previous: 0,\n236\t            nb_packets_in_startup: 0,\n237\t            era_sequence: 0,\n238\t            nb_cruise_left_before_push: 0,\n239\t            seed_cwin: 0,\n240\t            seed_rate: 0,"}]},"parent_tool_use_id":null,"session_id":"589969e0-25c9-4813-acd8-cf423be18f35","uuid":"cf68986e-1a7e-4bd8-8c1d-172e97dabf6c","timestamp":"2026-05-07T05:34:47.111Z","tool_use_result":{"type":"text","file":{"filePath":"/Users/richbarn/Projects/picoquic/rs/fq/src/c4.rs","content":"    /// C: `c4_update_ecn_alpha` (picoquic/c4.c:321)\n    ///\n    /// Computes the ECN alpha estimate using an EWMA, similar to the Prague\n    /// implementation.  Picks the packet context from the path under multipath\n    /// or from the connection's application context under single-path.\n    pub(crate) fn update_ecn_alpha(&mut self, path_x: &Path, connection: &Connection) {\n        let pkt_ctx = if connection.is_multipath_enabled {\n            &path_x.pkt_ctx\n        } else {\n            &connection.pkt_ctx[PacketContext::Application as usize]\n        };\n\n        let delta_ect1 = pkt_ctx.ecn_ect1_total_remote as i64 - self.ecn_ect1 as i64;\n        let delta_ce = pkt_ctx.ecn_ce_total_remote as i64 - self.ecn_ce as i64;\n\n        self.ecn_ect1 = pkt_ctx.ecn_ect1_total_remote;\n        self.ecn_ce = pkt_ctx.ecn_ce_total_remote;\n\n        if delta_ce > 0 || delta_ect1 > 0 {\n            let sum = delta_ce + delta_ect1;\n            let frac: u64 = if sum > 0 {\n                ((delta_ce * 1024) / sum) as u64\n            } else {\n                0\n            };\n\n            if frac > self.ecn_alpha && frac >= 512 {\n                self.ecn_alpha = frac;\n            } else {\n                // EWMA: alpha = alpha*(1 - 1/2^shift) + frac*(1/2^shift)\n                let alpha_shifted = (self.ecn_alpha << C4_ECN_SHIFT_G) - self.ecn_alpha + frac;\n                self.ecn_alpha = alpha_shifted >> C4_ECN_SHIFT_G;\n            }\n        }\n    }\n}\n\n#[cfg(test)]\nmod tests {\n    use super::*;\n\n    fn make_state() -> C4State {\n        C4State {\n            alg_state: C4AlgState::default(),\n            nominal_rate: 0,\n            nominal_max_rtt: 0,\n            initial_cwnd: 0,\n            running_min_rtt: 0,\n            alpha_1024_current: 0,\n            alpha_1024_previous: 0,\n            nb_packets_in_startup: 0,\n            era_sequence: 0,\n            nb_cruise_left_before_push: 0,\n            seed_cwin: 0,\n            seed_rate: 0,","numLines":55,"startLine":186,"totalLines":428}}}
