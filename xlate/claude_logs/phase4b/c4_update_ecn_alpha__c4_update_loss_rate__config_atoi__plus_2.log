{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_0188T1gHCjA3E1ZD3tHRbW2R","type":"tool_result","content":"1\t//! Translation of `picoquic/c4.c` — C4 congestion control.\n2\t\n3\t// ---------------------------------------------------------------------------\n4\t// Constants from c4.c `#define`s.\n5\t\n6\tconst C4_ALPHA_PUSH_LOW_1024: u64 = 1088; // C: C4_ALPHA_PUSH_LOW_1024 (106.25%)\n7\t\n8\t// ---------------------------------------------------------------------------\n9\t// `MULT1024(c, v)` — fixed-point scale by c/1024.  C: `MULT1024`.\n10\t\n11\t#[inline]\n12\tfn mult1024(c: u64, v: u64) -> u64 {\n13\t    (v * c) >> 10\n14\t}\n15\t\n16\t// ---------------------------------------------------------------------------\n17\t// Algorithm-state enum.  C: `c4_alg_state_t`.\n18\t\n19\t#[derive(Debug, Copy, Clone, PartialEq, Eq, Default)]\n20\tpub enum C4AlgState {\n21\t    #[default]\n22\t    Initial = 0,\n23\t    Recovery,\n24\t    Cruising,\n25\t    Pushing,\n26\t}\n27\t\n28\t// ---------------------------------------------------------------------------\n29\t// Congestion-event discriminant.  C: `c4_congestion_t`.\n30\t\n31\t#[derive(Debug, Copy, Clone, PartialEq, Eq, Default)]\n32\tpub enum C4Congestion {\n33\t    #[default]\n34\t    None = 0,\n35\t    Delay,\n36\t    Ecn,\n37\t    Loss,\n38\t}\n39\t\n40\t// ---------------------------------------------------------------------------\n41\t// C4 algorithm state.  C: `c4_state_t` (picoquic/c4.c:143).\n42\t//\n43\t// Type deviations from C:\n44\t//   * single-bit `unsigned int x : 1` bitfields → `bool`\n45\t//   * `const char* option_string` → `Option<String>` (owned copy)\n46\t\n47\tpub struct C4State {\n48\t    pub alg_state: C4AlgState,\n49\t    pub nominal_rate: u64,\n50\t    pub nominal_max_rtt: u64,\n51\t    pub initial_cwnd: u64,\n52\t    pub running_min_rtt: u64,\n53\t    pub alpha_1024_current: u64,\n54\t    pub alpha_1024_previous: u64,\n55\t    pub nb_packets_in_startup: u64,\n56\t    pub era_sequence: u64,\n57\t    pub nb_cruise_left_before_push: u64,\n58\t    pub seed_cwin: u64,\n59\t    pub seed_rate: u64,\n60\t    pub probe_level: i32,\n61\t    pub nb_eras_no_increase: i32,\n62\t    pub push_rate_old: u64,\n63\t    pub push_alpha: u64,\n64\t    pub era_max_rtt: u64,\n65\t    pub era_min_rtt: u64,\n66\t    pub delay_threshold: u64,\n67\t    pub recent_delay_excess: u64,\n68\t    pub last_lost_packet_number: u64,\n69\t    pub smoothed_drop_rate: f64,\n70\t    pub ecn_alpha: u64,\n71\t    pub ecn_ect1: u64,\n72\t    pub ecn_ce: u64,\n73\t    pub ecn_threshold: u64,\n74\t    pub congestion_notified: bool,\n75\t    pub push_was_not_limited: bool,\n76\t    pub use_seed_cwin: bool,\n77\t    pub initial_after_jitter: bool,\n78\t    pub excess_ce_after_push: bool,\n79\t    pub option_string: Option<String>,\n80\t}\n81\t\n82\timpl C4State {\n83\t    /// C: `c4_sensitivity_1024` (picoquic/c4.c:244)\n84\t    ///\n85\t    /// Fixed-point sensitivity in [0, 1024] scaled to `nominal_rate`:\n86\t    /// 0 below 50 kbps, 1024 above 10 Mbps, linearly interpolated in between.\n87\t    fn sensitivity_1024(&self) -> u64 {\n88\t        if self.nominal_rate < 50_000 {\n89\t            0\n90\t        } else if self.nominal_rate > 10_000_000 {\n91\t            1024\n92\t        } else if self.nominal_rate < 1_000_000 {\n93\t            (self.nominal_rate - 50_000) * 963 / 950_000\n94\t        } else {\n95\t            963 + ((self.nominal_rate - 1_000_000) * 61 / 9_000_000)\n96\t        }\n97\t    }\n98\t\n99\t    /// C: `c4_growth_evaluate` (picoquic/c4.c:429)\n100\t    ///\n101\t    /// Returns `true` when the previous era produced meaningful throughput\n102\t    /// growth.  If `push_alpha` was large enough to measure reliably, growth\n103\t    /// is defined as exceeding the alpha-scaled old rate; otherwise it falls\n104\t    /// back to a simple rate comparison guarded by the absence of congestion.\n105\t    fn growth_evaluate(&self) -> bool {\n106\t        if self.push_alpha > C4_ALPHA_PUSH_LOW_1024 {\n107\t            let target_rate =\n108\t                (3 * self.push_rate_old + mult1024(self.push_alpha, self.push_rate_old)) / 4;\n109\t            self.nominal_rate > target_rate\n110\t        } else {\n111\t            self.nominal_rate > self.push_rate_old && !self.congestion_notified\n112\t        }\n113\t    }\n114\t\n115\t    /// C: `c4_growth_reset` (picoquic/c4.c:449)\n116\t    fn growth_reset(&mut self) {\n117\t        self.congestion_notified = false;\n118\t        self.push_was_not_limited = false;\n119\t        self.push_rate_old = self.nominal_rate;\n120\t        // push_alpha is reset to current alpha here; caller sets it to correct\n121\t        // value when entering push state.\n122\t        self.push_alpha = self.alpha_1024_current;\n123\t    }\n124\t\n125\t    /// C: `c4_set_options` (picoquic/c4.c:499)\n126\t    ///\n127\t    /// Parses `option_string` for recognized option characters.  No option\n128\t    /// characters are currently defined; the loop exits on the first unknown.\n129\t    fn set_options(&mut self) {\n130\t        if let Some(s) = self.option_string.as_deref() {\n131\t            // No recognized option characters are currently defined.  The C switch\n132\t            // hits `default: ended = 1` for every character, so the loop exits\n133\t            // immediately after consuming the first character.\n134\t            let _ = s.chars().next();\n135\t        }\n136\t    }\n137\t\n138\t    /// C: `c4_seed_cwin` (picoquic/c4.c:527)\n139\t    pub fn seed_cwin(&mut self, bytes_in_flight: u64) {\n140\t        if self.alg_state == C4AlgState::Initial {\n141\t            self.use_seed_cwin = true;\n142\t            self.seed_cwin = bytes_in_flight;\n143\t        }\n144\t    }\n145\t\n146\t    /// C: `c4_observe` (picoquic/c4.c:1121)\n147\t    ///\n148\t    /// Returns `(cc_state, cc_param)`: the algorithm-state discriminant and\n149\t    /// `nominal_max_rtt`, matching the C convention of filling two `uint64_t*`\n150\t    /// out-params.\n151\t    pub fn observe(&self) -> (u64, u64) {\n152\t        (self.alg_state as u64, self.nominal_max_rtt)\n153\t    }\n154\t}\n155\t\n156\t#[cfg(test)]\n157\tmod tests {\n158\t    use super::*;\n159\t\n160\t    fn make_state() -> C4State {\n161\t        C4State {\n162\t            alg_state: C4AlgState::default(),\n163\t            nominal_rate: 0,\n164\t            nominal_max_rtt: 0,\n165\t            initial_cwnd: 0,\n166\t            running_min_rtt: 0,\n167\t            alpha_1024_current: 0,\n168\t            alpha_1024_previous: 0,\n169\t            nb_packets_in_startup: 0,\n170\t            era_sequence: 0,\n171\t            nb_cruise_left_before_push: 0,\n172\t            seed_cwin: 0,\n173\t            seed_rate: 0,\n174\t            probe_level: 0,\n175\t            nb_eras_no_increase: 0,\n176\t            push_rate_old: 0,\n177\t            push_alpha: 0,\n178\t            era_max_rtt: 0,\n179\t            era_min_rtt: 0,\n180\t            delay_threshold: 0,\n181\t            recent_delay_excess: 0,\n182\t            last_lost_packet_number: 0,\n183\t            smoothed_drop_rate: 0.0,\n184\t            ecn_alpha: 0,\n185\t            ecn_ect1: 0,\n186\t            ecn_ce: 0,\n187\t            ecn_threshold: 0,\n188\t            congestion_notified: false,\n189\t            push_was_not_limited: false,\n190\t            use_seed_cwin: false,\n191\t            initial_after_jitter: false,\n192\t            excess_ce_after_push: false,\n193\t            option_string: None,\n194\t        }\n195\t    }\n196\t\n197\t    #[test]\n198\t    fn growth_evaluate_high_alpha_growing() {\n199\t        let mut s = make_state();\n200\t        // push_alpha > 1088, push_rate_old = 1000, nominal_rate must exceed:\n201\t        // target = (3*1000 + MULT1024(1280, 1000)) / 4 = (3000 + 1250) / 4 = 1062\n202\t        s.push_alpha = 1280;\n203\t        s.push_rate_old = 1000;\n204\t        s.nominal_rate = 1100;\n205\t        assert!(s.growth_evaluate());\n206\t    }\n207\t\n208\t    #[test]\n209\t    fn growth_evaluate_high_alpha_not_growing() {\n210\t        let mut s = make_state();\n211\t        s.push_alpha = 1280;\n212\t        s.push_rate_old = 1000;\n213\t        s.nominal_rate = 1000; // equal to target_rate or below\n214\t        assert!(!s.growth_evaluate());\n215\t    }\n216\t\n217\t    #[test]\n218\t    fn growth_evaluate_low_alpha_growing_no_congestion() {\n219\t        let mut s = make_state();\n220\t        s.push_alpha = 1000; // <= 1088\n221\t        s.push_rate_old = 800;\n222\t        s.nominal_rate = 900;\n223\t        s.congestion_notified = false;\n224\t        assert!(s.growth_evaluate());\n225\t    }\n226\t\n227\t    #[test]\n228\t    fn growth_evaluate_low_alpha_congestion_blocks_growth() {\n229\t        let mut s = make_state();\n230\t        s.push_alpha = 1000;\n231\t        s.push_rate_old = 800;\n232\t        s.nominal_rate = 900;\n233\t        s.congestion_notified = true;\n234\t        assert!(!s.growth_evaluate());\n235\t    }\n236\t\n237\t    // --- sensitivity_1024 ---\n238\t\n239\t    #[test]\n240\t    fn sensitivity_below_50k() {\n241\t        let mut s = make_state();\n242\t        s.nominal_rate = 49_999;\n243\t        assert_eq!(s.sensitivity_1024(), 0);\n244\t    }\n245\t\n246\t    #[test]\n247\t    fn sensitivity_at_50k_boundary() {\n248\t        let mut s = make_state();\n249\t        s.nominal_rate = 50_000;\n250\t        // (50000 - 50000) * 963 / 950000 == 0\n251\t        assert_eq!(s.sensitivity_1024(), 0);\n252\t    }\n253\t\n254\t    #[test]\n255\t    fn sensitivity_midrange() {\n256\t        let mut s = make_state();\n257\t        s.nominal_rate = 500_000;\n258\t        // (500000 - 50000) * 963 / 950000 = 450000 * 963 / 950000 = 456\n259\t        assert_eq!(s.sensitivity_1024(), 456);\n260\t    }\n261\t\n262\t    #[test]\n263\t    fn sensitivity_at_1mbps() {\n264\t        let mut s = make_state();\n265\t        s.nominal_rate = 1_000_000;\n266\t        // hits else branch: 963 + (0 * 61 / 9000000) = 963\n267\t        assert_eq!(s.sensitivity_1024(), 963);\n268\t    }\n269\t\n270\t    #[test]\n271\t    fn sensitivity_at_10mbps() {\n272\t        let mut s = make_state();\n273\t        s.nominal_rate = 10_000_000;\n274\t        // 963 + (9000000 * 61 / 9000000) = 963 + 61 = 1024\n275\t        assert_eq!(s.sensitivity_1024(), 1024);\n276\t    }\n277\t\n278\t    #[test]\n279\t    fn sensitivity_above_10mbps() {\n280\t        let mut s = make_state();\n281\t        s.nominal_rate = 10_000_001;\n282\t        assert_eq!(s.sensitivity_1024(), 1024);\n283\t    }\n284\t\n285\t    // --- growth_reset ---\n286\t\n287\t    #[test]\n288\t    fn growth_reset_clears_flags_and_snapshots() {\n289\t        let mut s = make_state();\n290\t        s.nominal_rate = 5_000_000;\n291\t        s.alpha_1024_current = 1100;\n292\t        s.congestion_notified = true;\n293\t        s.push_was_not_limited = true;\n294\t        s.push_rate_old = 1_000_000;\n295\t        s.push_alpha = 900;\n296\t\n297\t        s.growth_reset();\n298\t\n299\t        assert!(!s.congestion_notified);\n300\t        assert!(!s.push_was_not_limited);\n301\t        assert_eq!(s.push_rate_old, 5_000_000);\n302\t        assert_eq!(s.push_alpha, 1100);\n303\t    }\n304\t\n305\t    // --- set_options ---\n306\t\n307\t    #[test]\n308\t    fn set_options_none_is_noop() {\n309\t        let mut s = make_state();\n310\t        s.option_string = None;\n311\t        s.set_options(); // must not panic\n312\t    }\n313\t\n314\t    #[test]\n315\t    fn set_options_unknown_chars_are_noop() {\n316\t        let mut s = make_state();\n317\t        s.option_string = Some(\"xyz\".to_owned());\n318\t        s.set_options(); // must not panic; no state change expected\n319\t    }\n320\t\n321\t    // --- seed_cwin ---\n322\t\n323\t    #[test]\n324\t    fn seed_cwin_sets_when_initial() {\n325\t        let mut s = make_state();\n326\t        s.alg_state = C4AlgState::Initial;\n327\t        s.seed_cwin(123_456);\n328\t        assert!(s.use_seed_cwin);\n329\t        assert_eq!(s.seed_cwin, 123_456);\n330\t    }\n331\t\n332\t    #[test]\n333\t    fn seed_cwin_ignored_when_not_initial() {\n334\t        let mut s = make_state();\n335\t        s.alg_state = C4AlgState::Cruising;\n336\t        s.seed_cwin(123_456);\n337\t        assert!(!s.use_seed_cwin);\n338\t        assert_eq!(s.seed_cwin, 0);\n339\t    }\n340\t\n341\t    // --- observe ---\n342\t\n343\t    #[test]\n344\t    fn observe_returns_state_and_rtt() {\n345\t        let mut s = make_state();\n346\t        s.alg_state = C4AlgState::Pushing;\n347\t        s.nominal_max_rtt = 42_000;\n348\t        let (cc_state, cc_param) = s.observe();\n349\t        assert_eq!(cc_state, C4AlgState::Pushing as u64);\n350\t        assert_eq!(cc_param, 42_000);\n351\t    }\n352\t\n353\t    #[test]\n354\t    fn observe_initial_state() {\n355\t        let s = make_state();\n356\t        let (cc_state, cc_param) = s.observe();\n357\t        assert_eq!(cc_state, 0); // C4AlgState::Initial == 0\n358\t        assert_eq!(cc_param, 0);\n359\t    }\n360\t}\n361\t"}]},"parent_tool_use_id":null,"session_id":"589969e0-25c9-4813-acd8-cf423be18f35","uuid":"b69e787b-d88b-4528-8776-0d72d3f2fa38","timestamp":"2026-05-07T05:27:42.750Z","tool_use_result":{"type":"text","file":{"filePath":"/Users/richbarn/Projects/picoquic/rs/fq/src/c4.rs","content":"//! Translation of `picoquic/c4.c` — C4 congestion control.\n\n// ---------------------------------------------------------------------------\n// Constants from c4.c `#define`s.\n\nconst C4_ALPHA_PUSH_LOW_1024: u64 = 1088; // C: C4_ALPHA_PUSH_LOW_1024 (106.25%)\n\n// ---------------------------------------------------------------------------\n// `MULT1024(c, v)` — fixed-point scale by c/1024.  C: `MULT1024`.\n\n#[inline]\nfn mult1024(c: u64, v: u64) -> u64 {\n    (v * c) >> 10\n}\n\n// ---------------------------------------------------------------------------\n// Algorithm-state enum.  C: `c4_alg_state_t`.\n\n#[derive(Debug, Copy, Clone, PartialEq, Eq, Default)]\npub enum C4AlgState {\n    #[default]\n    Initial = 0,\n    Recovery,\n    Cruising,\n    Pushing,\n}\n\n// ---------------------------------------------------------------------------\n// Congestion-event discriminant.  C: `c4_congestion_t`.\n\n#[derive(Debug, Copy, Clone, PartialEq, Eq, Default)]\npub enum C4Congestion {\n    #[default]\n    None = 0,\n    Delay,\n    Ecn,\n    Loss,\n}\n\n// ---------------------------------------------------------------------------\n// C4 algorithm state.  C: `c4_state_t` (picoquic/c4.c:143).\n//\n// Type deviations from C:\n//   * single-bit `unsigned int x : 1` bitfields → `bool`\n//   * `const char* option_string` → `Option<String>` (owned copy)\n\npub struct C4State {\n    pub alg_state: C4AlgState,\n    pub nominal_rate: u64,\n    pub nominal_max_rtt: u64,\n    pub initial_cwnd: u64,\n    pub running_min_rtt: u64,\n    pub alpha_1024_current: u64,\n    pub alpha_1024_previous: u64,\n    pub nb_packets_in_startup: u64,\n    pub era_sequence: u64,\n    pub nb_cruise_left_before_push: u64,\n    pub seed_cwin: u64,\n    pub seed_rate: u64,\n    pub probe_level: i32,\n    pub nb_eras_no_increase: i32,\n    pub push_rate_old: u64,\n    pub push_alpha: u64,\n    pub era_max_rtt: u64,\n    pub era_min_rtt: u64,\n    pub delay_threshold: u64,\n    pub recent_delay_excess: u64,\n    pub last_lost_packet_number: u64,\n    pub smoothed_drop_rate: f64,\n    pub ecn_alpha: u64,\n    pub ecn_ect1: u64,\n    pub ecn_ce: u64,\n    pub ecn_threshold: u64,\n    pub congestion_notified: bool,\n    pub push_was_not_limited: bool,\n    pub use_seed_cwin: bool,\n    pub initial_after_jitter: bool,\n    pub excess_ce_after_push: bool,\n    pub option_string: Option<String>,\n}\n\nimpl C4State {\n    /// C: `c4_sensitivity_1024` (picoquic/c4.c:244)\n    ///\n    /// Fixed-point sensitivity in [0, 1024] scaled to `nominal_rate`:\n    /// 0 below 50 kbps, 1024 above 10 Mbps, linearly interpolated in between.\n    fn sensitivity_1024(&self) -> u64 {\n        if self.nominal_rate < 50_000 {\n            0\n        } else if self.nominal_rate > 10_000_000 {\n            1024\n        } else if self.nominal_rate < 1_000_000 {\n            (self.nominal_rate - 50_000) * 963 / 950_000\n        } else {\n            963 + ((self.nominal_rate - 1_000_000) * 61 / 9_000_000)\n        }\n    }\n\n    /// C: `c4_growth_evaluate` (picoquic/c4.c:429)\n    ///\n    /// Returns `true` when the previous era produced meaningful throughput\n    /// growth.  If `push_alpha` was large enough to measure reliably, growth\n    /// is defined as exceeding the alpha-scaled old rate; otherwise it falls\n    /// back to a simple rate comparison guarded by the absence of congestion.\n    fn growth_evaluate(&self) -> bool {\n        if self.push_alpha > C4_ALPHA_PUSH_LOW_1024 {\n            let target_rate =\n                (3 * self.push_rate_old + mult1024(self.push_alpha, self.push_rate_old)) / 4;\n            self.nominal_rate > target_rate\n        } else {\n            self.nominal_rate > self.push_rate_old && !self.congestion_notified\n        }\n    }\n\n    /// C: `c4_growth_reset` (picoquic/c4.c:449)\n    fn growth_reset(&mut self) {\n        self.congestion_notified = false;\n        self.push_was_not_limited = false;\n        self.push_rate_old = self.nominal_rate;\n        // push_alpha is reset to current alpha here; caller sets it to correct\n        // value when entering push state.\n        self.push_alpha = self.alpha_1024_current;\n    }\n\n    /// C: `c4_set_options` (picoquic/c4.c:499)\n    ///\n    /// Parses `option_string` for recognized option characters.  No option\n    /// characters are currently defined; the loop exits on the first unknown.\n    fn set_options(&mut self) {\n        if let Some(s) = self.option_string.as_deref() {\n            // No recognized option characters are currently defined.  The C switch\n            // hits `default: ended = 1` for every character, so the loop exits\n            // immediately after consuming the first character.\n            let _ = s.chars().next();\n        }\n    }\n\n    /// C: `c4_seed_cwin` (picoquic/c4.c:527)\n    pub fn seed_cwin(&mut self, bytes_in_flight: u64) {\n        if self.alg_state == C4AlgState::Initial {\n            self.use_seed_cwin = true;\n            self.seed_cwin = bytes_in_flight;\n        }\n    }\n\n    /// C: `c4_observe` (picoquic/c4.c:1121)\n    ///\n    /// Returns `(cc_state, cc_param)`: the algorithm-state discriminant and\n    /// `nominal_max_rtt`, matching the C convention of filling two `uint64_t*`\n    /// out-params.\n    pub fn observe(&self) -> (u64, u64) {\n        (self.alg_state as u64, self.nominal_max_rtt)\n    }\n}\n\n#[cfg(test)]\nmod tests {\n    use super::*;\n\n    fn make_state() -> C4State {\n        C4State {\n            alg_state: C4AlgState::default(),\n            nominal_rate: 0,\n            nominal_max_rtt: 0,\n            initial_cwnd: 0,\n            running_min_rtt: 0,\n            alpha_1024_current: 0,\n            alpha_1024_previous: 0,\n            nb_packets_in_startup: 0,\n            era_sequence: 0,\n            nb_cruise_left_before_push: 0,\n            seed_cwin: 0,\n            seed_rate: 0,\n            probe_level: 0,\n            nb_eras_no_increase: 0,\n            push_rate_old: 0,\n            push_alpha: 0,\n            era_max_rtt: 0,\n            era_min_rtt: 0,\n            delay_threshold: 0,\n            recent_delay_excess: 0,\n            last_lost_packet_number: 0,\n            smoothed_drop_rate: 0.0,\n            ecn_alpha: 0,\n            ecn_ect1: 0,\n            ecn_ce: 0,\n            ecn_threshold: 0,\n            congestion_notified: false,\n            push_was_not_limited: false,\n            use_seed_cwin: false,\n            initial_after_jitter: false,\n            excess_ce_after_push: false,\n            option_string: None,\n        }\n    }\n\n    #[test]\n    fn growth_evaluate_high_alpha_growing() {\n        let mut s = make_state();\n        // push_alpha > 1088, push_rate_old = 1000, nominal_rate must exceed:\n        // target = (3*1000 + MULT1024(1280, 1000)) / 4 = (3000 + 1250) / 4 = 1062\n        s.push_alpha = 1280;\n        s.push_rate_old = 1000;\n        s.nominal_rate = 1100;\n        assert!(s.growth_evaluate());\n    }\n\n    #[test]\n    fn growth_evaluate_high_alpha_not_growing() {\n        let mut s = make_state();\n        s.push_alpha = 1280;\n        s.push_rate_old = 1000;\n        s.nominal_rate = 1000; // equal to target_rate or below\n        assert!(!s.growth_evaluate());\n    }\n\n    #[test]\n    fn growth_evaluate_low_alpha_growing_no_congestion() {\n        let mut s = make_state();\n        s.push_alpha = 1000; // <= 1088\n        s.push_rate_old = 800;\n        s.nominal_rate = 900;\n        s.congestion_notified = false;\n        assert!(s.growth_evaluate());\n    }\n\n    #[test]\n    fn growth_evaluate_low_alpha_congestion_blocks_growth() {\n        let mut s = make_state();\n        s.push_alpha = 1000;\n        s.push_rate_old = 800;\n        s.nominal_rate = 900;\n        s.congestion_notified = true;\n        assert!(!s.growth_evaluate());\n    }\n\n    // --- sensitivity_1024 ---\n\n    #[test]\n    fn sensitivity_below_50k() {\n        let mut s = make_state();\n        s.nominal_rate = 49_999;\n        assert_eq!(s.sensitivity_1024(), 0);\n    }\n\n    #[test]\n    fn sensitivity_at_50k_boundary() {\n        let mut s = make_state();\n        s.nominal_rate = 50_000;\n        // (50000 - 50000) * 963 / 950000 == 0\n        assert_eq!(s.sensitivity_1024(), 0);\n    }\n\n    #[test]\n    fn sensitivity_midrange() {\n        let mut s = make_state();\n        s.nominal_rate = 500_000;\n        // (500000 - 50000) * 963 / 950000 = 450000 * 963 / 950000 = 456\n        assert_eq!(s.sensitivity_1024(), 456);\n    }\n\n    #[test]\n    fn sensitivity_at_1mbps() {\n        let mut s = make_state();\n        s.nominal_rate = 1_000_000;\n        // hits else branch: 963 + (0 * 61 / 9000000) = 963\n        assert_eq!(s.sensitivity_1024(), 963);\n    }\n\n    #[test]\n    fn sensitivity_at_10mbps() {\n        let mut s = make_state();\n        s.nominal_rate = 10_000_000;\n        // 963 + (9000000 * 61 / 9000000) = 963 + 61 = 1024\n        assert_eq!(s.sensitivity_1024(), 1024);\n    }\n\n    #[test]\n    fn sensitivity_above_10mbps() {\n        let mut s = make_state();\n        s.nominal_rate = 10_000_001;\n        assert_eq!(s.sensitivity_1024(), 1024);\n    }\n\n    // --- growth_reset ---\n\n    #[test]\n    fn growth_reset_clears_flags_and_snapshots() {\n        let mut s = make_state();\n        s.nominal_rate = 5_000_000;\n        s.alpha_1024_current = 1100;\n        s.congestion_notified = true;\n        s.push_was_not_limited = true;\n        s.push_rate_old = 1_000_000;\n        s.push_alpha = 900;\n\n        s.growth_reset();\n\n        assert!(!s.congestion_notified);\n        assert!(!s.push_was_not_limited);\n        assert_eq!(s.push_rate_old, 5_000_000);\n        assert_eq!(s.push_alpha, 1100);\n    }\n\n    // --- set_options ---\n\n    #[test]\n    fn set_options_none_is_noop() {\n        let mut s = make_state();\n        s.option_string = None;\n        s.set_options(); // must not panic\n    }\n\n    #[test]\n    fn set_options_unknown_chars_are_noop() {\n        let mut s = make_state();\n        s.option_string = Some(\"xyz\".to_owned());\n        s.set_options(); // must not panic; no state change expected\n    }\n\n    // --- seed_cwin ---\n\n    #[test]\n    fn seed_cwin_sets_when_initial() {\n        let mut s = make_state();\n        s.alg_state = C4AlgState::Initial;\n        s.seed_cwin(123_456);\n        assert!(s.use_seed_cwin);\n        assert_eq!(s.seed_cwin, 123_456);\n    }\n\n    #[test]\n    fn seed_cwin_ignored_when_not_initial() {\n        let mut s = make_state();\n        s.alg_state = C4AlgState::Cruising;\n        s.seed_cwin(123_456);\n        assert!(!s.use_seed_cwin);\n        assert_eq!(s.seed_cwin, 0);\n    }\n\n    // --- observe ---\n\n    #[test]\n    fn observe_returns_state_and_rtt() {\n        let mut s = make_state();\n        s.alg_state = C4AlgState::Pushing;\n        s.nominal_max_rtt = 42_000;\n        let (cc_state, cc_param) = s.observe();\n        assert_eq!(cc_state, C4AlgState::Pushing as u64);\n        assert_eq!(cc_param, 42_000);\n    }\n\n    #[test]\n    fn observe_initial_state() {\n        let s = make_state();\n        let (cc_state, cc_param) = s.observe();\n        assert_eq!(cc_state, 0); // C4AlgState::Initial == 0\n        assert_eq!(cc_param, 0);\n    }\n}\n","numLines":361,"startLine":1,"totalLines":361}}}
