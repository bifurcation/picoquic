{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_015iHm2j4YcuWAGM9qH39seZ","type":"tool_result","content":"1\t//! Translation of `picoquic/c4.c` — C4 congestion control.\n2\t\n3\tuse crate::cc_common::{ConnectionCc, PathCc, SMOOTHED_LOSS_FACTOR, SMOOTHED_LOSS_SCOPE};\n4\tuse crate::internal::{CWIN_INITIAL, Connection, Path};\n5\tuse crate::utils::{bytes_from_rate, rate_from_bytes};\n6\tuse crate::{CongestionNotification, PacketContext, PerAckState, State};\n7\t\n8\t// ---------------------------------------------------------------------------\n9\t// Constants from c4.c `#define`s.\n10\t\n11\tconst C4_ALPHA_PUSH_LOW_1024: u64 = 1088; // C: C4_ALPHA_PUSH_LOW_1024 (106.25%)\n12\tconst C4_ALPHA_PUSH_VERY_LOW_1024: u64 = 1056; // C: C4_ALPHA_PUSH_VERY_LOW_1024 (103.125%)\n13\tconst C4_ALPHA_PUSH_1024: u64 = 1280; // C: C4_ALPHA_PUSH_1024 (125%)\n14\t/// 100%.  C: `C4_ALPHA_NEUTRAL_1024`.\n15\tconst C4_ALPHA_NEUTRAL_1024: u64 = 1024;\n16\t/// 87.50%.  C: `C4_ALPHA_RECOVER2_1024`.\n17\tconst C4_ALPHA_RECOVER2_1024: u64 = 896;\n18\t/// 100%.  C: `C4_ALPHA_CRUISE_1024`.\n19\tconst C4_ALPHA_CRUISE_1024: u64 = 1024;\n20\t/// 25% congestion back-off.  C: `C4_BETA_LOSS_1024`.\n21\tconst C4_BETA_LOSS_1024: u64 = 256;\n22\t/// Loss count before exiting initial.  C: `C4_NB_PACKETS_BEFORE_LOSS`.\n23\tconst C4_NB_PACKETS_BEFORE_LOSS: u64 = 20;\n24\t/// Cruise eras before attempting a push.  C: `C4_NB_CRUISE_BEFORE_PUSH`.\n25\tconst C4_NB_CRUISE_BEFORE_PUSH: u64 = 4;\n26\t/// RTT margin for CWIN buffer (15 ms).  C: `C4_RTT_MARGIN_DELAY`.\n27\tconst C4_RTT_MARGIN_DELAY: u64 = 15_000;\n28\t/// Minimum nominal max-RTT (1 ms).  C: `C4_MAX_RTT_MIN`.\n29\tconst C4_MAX_RTT_MIN: u64 = 1_000;\n30\t/// Max jitter cap on era max-RTT (250 ms).  C: `C4_MAX_JITTER`.\n31\tconst C4_MAX_JITTER: u64 = 250_000;\n32\t/// Maximum probe level before re-entering Initial.  C: `C4_PROBE_LEVEL_MAX`.\n33\tconst C4_PROBE_LEVEL_MAX: i32 = 3;\n34\t/// Push-alpha table indexed by probe level.  C: `c4_push_rate_by_probe_level`.\n35\tconst C4_PUSH_RATE_BY_PROBE_LEVEL: [u64; 4] = [\n36\t    C4_ALPHA_PUSH_VERY_LOW_1024,\n37\t    C4_ALPHA_PUSH_LOW_1024,\n38\t    C4_ALPHA_PUSH_1024,\n39\t    C4_ALPHA_PUSH_1024,\n40\t];\n41\t/// Gain parameter for the ECN alpha EWMA: g = 1/2^4.  C: `C4_ECN_SHIFT_G`.\n42\tconst C4_ECN_SHIFT_G: u32 = 4;\n43\t/// Maximum delay threshold in microseconds (25 ms).  C: `C4_DELAY_THRESHOLD_MAX`.\n44\tconst C4_DELAY_THRESHOLD_MAX: u64 = 25_000;\n45\t/// Default probe level on entry to Initial.  C: `C4_PROBE_LEVEL_DEFAULT`.\n46\tconst C4_PROBE_LEVEL_DEFAULT: i32 = 1;\n47\t/// Alpha multiplier during Initial slow-start (200%).  C: `C4_ALPHA_INITIAL`.\n48\tconst C4_ALPHA_INITIAL: u64 = 2048;\n49\t/// Alpha multiplier during Recovery (93.75%).  C: `C4_ALPHA_RECOVER_1024`.\n50\tconst C4_ALPHA_RECOVER_1024: u64 = 960;\n51\t\n52\t// ---------------------------------------------------------------------------\n53\t// `MULT1024(c, v)` — fixed-point scale by c/1024.  C: `MULT1024`.\n54\t\n55\t#[inline]\n56\tfn mult1024(c: u64, v: u64) -> u64 {\n57\t    (v * c) >> 10\n58\t}\n59\t\n60\t// ---------------------------------------------------------------------------\n61\t// Algorithm-state enum.  C: `c4_alg_state_t`.\n62\t\n63\t#[derive(Debug, Copy, Clone, PartialEq, Eq, Default)]\n64\tpub enum C4AlgState {\n65\t    #[default]\n66\t    Initial = 0,\n67\t    Recovery,\n68\t    Cruising,\n69\t    Pushing,\n70\t}\n71\t\n72\t// ---------------------------------------------------------------------------\n73\t// Congestion-event discriminant.  C: `c4_congestion_t`.\n74\t\n75\t#[derive(Debug, Copy, Clone, PartialEq, Eq, Default)]\n76\tpub enum C4Congestion {\n77\t    #[default]\n78\t    None = 0,\n79\t    Delay,\n80\t    Ecn,\n81\t    Loss,\n82\t}\n83\t\n84\t// ---------------------------------------------------------------------------\n85\t// C4 algorithm state.  C: `c4_state_t` (picoquic/c4.c:143).\n86\t//\n87\t// Type deviations from C:\n88\t//   * single-bit `unsigned int x : 1` bitfields → `bool`\n89\t//   * `const char* option_string` → `Option<String>` (owned copy)\n90\t\n91\tpub struct C4State {\n92\t    pub alg_state: C4AlgState,\n93\t    pub nominal_rate: u64,\n94\t    pub nominal_max_rtt: u64,\n95\t    pub initial_cwnd: u64,\n96\t    pub running_min_rtt: u64,\n97\t    pub alpha_1024_current: u64,\n98\t    pub alpha_1024_previous: u64,\n99\t    pub nb_packets_in_startup: u64,\n100\t    pub era_sequence: u64,\n101\t    pub nb_cruise_left_before_push: u64,\n102\t    pub seed_cwin: u64,\n103\t    pub seed_rate: u64,\n104\t    pub probe_level: i32,\n105\t    pub nb_eras_no_increase: i32,\n106\t    pub push_rate_old: u64,\n107\t    pub push_alpha: u64,\n108\t    pub era_max_rtt: u64,\n109\t    pub era_min_rtt: u64,\n110\t    pub delay_threshold: u64,\n111\t    pub recent_delay_excess: u64,\n112\t    pub last_lost_packet_number: u64,\n113\t    pub smoothed_drop_rate: f64,\n114\t    pub ecn_alpha: u64,\n115\t    pub ecn_ect1: u64,\n116\t    pub ecn_ce: u64,\n117\t    pub ecn_threshold: u64,\n118\t    pub congestion_notified: bool,\n119\t    pub push_was_not_limited: bool,\n120\t    pub use_seed_cwin: bool,\n121\t    pub initial_after_jitter: bool,\n122\t    pub excess_ce_after_push: bool,\n123\t    pub option_string: Option<String>,\n124\t}\n125\t\n126\timpl C4State {\n127\t    /// C: `c4_sensitivity_1024` (picoquic/c4.c:244)\n128\t    ///\n129\t    /// Fixed-point sensitivity in [0, 1024] scaled to `nominal_rate`:\n130\t    /// 0 below 50 kbps, 1024 above 10 Mbps, linearly interpolated in between.\n131\t    fn sensitivity_1024(&self) -> u64 {\n132\t        if self.nominal_rate < 50_000 {\n133\t            0\n134\t        } else if self.nominal_rate > 10_000_000 {\n135\t            1024\n136\t        } else if self.nominal_rate < 1_000_000 {\n137\t            (self.nominal_rate - 50_000) * 963 / 950_000\n138\t        } else {\n139\t            963 + ((self.nominal_rate - 1_000_000) * 61 / 9_000_000)\n140\t        }\n141\t    }\n142\t\n143\t    /// C: `c4_growth_evaluate` (picoquic/c4.c:429)\n144\t    ///\n145\t    /// Returns `true` when the previous era produced meaningful throughput\n146\t    /// growth.  If `push_alpha` was large enough to measure reliably, growth\n147\t    /// is defined as exceeding the alpha-scaled old rate; otherwise it falls\n148\t    /// back to a simple rate comparison guarded by the absence of congestion.\n149\t    fn growth_evaluate(&self) -> bool {\n150\t        if self.push_alpha > C4_ALPHA_PUSH_LOW_1024 {\n151\t            let target_rate =\n152\t                (3 * self.push_rate_old + mult1024(self.push_alpha, self.push_rate_old)) / 4;\n153\t            self.nominal_rate > target_rate\n154\t        } else {\n155\t            self.nominal_rate > self.push_rate_old && !self.congestion_notified\n156\t        }\n157\t    }\n158\t\n159\t    /// C: `c4_growth_reset` (picoquic/c4.c:449)\n160\t    fn growth_reset(&mut self) {\n161\t        self.congestion_notified = false;\n162\t        self.push_was_not_limited = false;\n163\t        self.push_rate_old = self.nominal_rate;\n164\t        // push_alpha is reset to current alpha here; caller sets it to correct\n165\t        // value when entering push state.\n166\t        self.push_alpha = self.alpha_1024_current;\n167\t    }\n168\t\n169\t    /// C: `c4_set_options` (picoquic/c4.c:499)\n170\t    ///\n171\t    /// Parses `option_string` for recognized option characters.  No option\n172\t    /// characters are currently defined; the loop exits on the first unknown.\n173\t    fn set_options(&mut self) {\n174\t        if let Some(s) = self.option_string.as_deref() {\n175\t            // No recognized option characters are currently defined.  The C switch\n176\t            // hits `default: ended = 1` for every character, so the loop exits\n177\t            // immediately after consuming the first character.\n178\t            let _ = s.chars().next();\n179\t        }\n180\t    }\n181\t\n182\t    /// C: `c4_seed_cwin` (picoquic/c4.c:527)\n183\t    pub fn seed_cwin(&mut self, bytes_in_flight: u64) {\n184\t        if self.alg_state == C4AlgState::Initial {\n185\t            self.use_seed_cwin = true;\n186\t            self.seed_cwin = bytes_in_flight;\n187\t        }\n188\t    }\n189\t\n190\t    /// C: `c4_observe` (picoquic/c4.c:1121)\n191\t    ///\n192\t    /// Returns `(cc_state, cc_param)`: the algorithm-state discriminant and\n193\t    /// `nominal_max_rtt`, matching the C convention of filling two `uint64_t*`\n194\t    /// out-params.\n195\t    pub fn observe(&self) -> (u64, u64) {\n196\t        (self.alg_state as u64, self.nominal_max_rtt)\n197\t    }\n198\t\n199\t    /// C: `c4_update_loss_rate` (picoquic/c4.c:301)\n200\t    ///\n201\t    /// Advances the smoothed drop-rate EMA to account for packets up to and\n202\t    /// including `lost_packet_number`.  Each step between the last recorded\n203\t    /// loss and the new one decays the rate; the final step adds one loss\n204\t    /// event.  Steps beyond `SMOOTHED_LOSS_SCOPE` behind the new number are\n205\t    /// skipped to cap the decay loop.\n206\t    pub fn update_loss_rate(&mut self, lost_packet_number: u64) {\n207\t        let mut next_number = self.last_lost_packet_number;\n208\t\n209\t        if lost_packet_number > next_number {\n210\t            if next_number + SMOOTHED_LOSS_SCOPE < lost_packet_number {\n211\t                next_number = lost_packet_number - SMOOTHED_LOSS_SCOPE;\n212\t            }\n213\t\n214\t            while next_number < lost_packet_number {\n215\t                self.smoothed_drop_rate *= 1.0 - SMOOTHED_LOSS_FACTOR;\n216\t                next_number += 1;\n217\t            }\n218\t\n219\t            self.smoothed_drop_rate += (1.0 - self.smoothed_drop_rate) * SMOOTHED_LOSS_FACTOR;\n220\t            self.last_lost_packet_number = lost_packet_number;\n221\t        }\n222\t    }\n223\t\n224\t    /// ECN alpha EWMA core.  C: `c4_update_ecn_alpha` (picoquic/c4.c:321) body.\n225\t    ///\n226\t    /// Takes the current totals directly so the logic can be tested without\n227\t    /// constructing `Path` / `Connection`.  Called by `update_ecn_alpha`.\n228\t    fn ecn_alpha_update_counts(&mut self, ecn_ect1_remote: u64, ecn_ce_remote: u64) {\n229\t        let delta_ect1 = ecn_ect1_remote as i64 - self.ecn_ect1 as i64;\n230\t        let delta_ce = ecn_ce_remote as i64 - self.ecn_ce as i64;\n231\t\n232\t        self.ecn_ect1 = ecn_ect1_remote;\n233\t        self.ecn_ce = ecn_ce_remote;\n234\t\n235\t        if delta_ce > 0 || delta_ect1 > 0 {\n236\t            let sum = delta_ce + delta_ect1;\n237\t            let frac: u64 = if sum > 0 {\n238\t                ((delta_ce * 1024) / sum) as u64\n239\t            } else {\n240\t                0\n241\t            };\n242\t\n243\t            if frac > self.ecn_alpha && frac >= 512 {\n244\t                self.ecn_alpha = frac;\n245\t            } else {\n246\t                // EWMA: alpha = alpha*(1 - 1/2^shift) + frac*(1/2^shift)\n247\t                let alpha_shifted = (self.ecn_alpha << C4_ECN_SHIFT_G) - self.ecn_alpha + frac;\n248\t                self.ecn_alpha = alpha_shifted >> C4_ECN_SHIFT_G;\n249\t            }\n250\t        }\n251\t    }\n252\t\n253\t    /// C: `c4_delay_threshold` (picoquic/c4.c:266)\n254\t    ///\n255\t    /// Compute the delay threshold for declaring congestion.  Sensitivity\n256\t    /// is 0 at ≤ 50 kbps, 1024 at ≥ 10 Mbps, and linearly interpolated\n257\t    /// in between.  The resulting fraction scales `nominal_max_rtt`, giving\n258\t    /// a threshold in [64/1024 × rtt, 260/1024 × rtt], capped at\n259\t    /// [`C4_DELAY_THRESHOLD_MAX`] (25 ms).\n260\t    pub fn delay_threshold(&self) -> u64 {\n261\t        let sensitivity = self.sensitivity_1024();\n262\t        let fraction = 64 + mult1024(1024 - sensitivity, 196);\n263\t        let delay = mult1024(fraction, self.nominal_max_rtt);\n264\t        delay.min(C4_DELAY_THRESHOLD_MAX)\n265\t    }\n266\t\n267\t    /// C: `c4_update_ecn_alpha` (picoquic/c4.c:321)\n268\t    ///\n269\t    /// Selects the right packet context (path-scoped under multipath;\n270\t    /// connection application context otherwise) and delegates to\n271\t    /// `ecn_alpha_update_counts`.\n272\t    #[allow(dead_code)]\n273\t    pub(crate) fn update_ecn_alpha(&mut self, path_x: &Path, connection: &Connection) {\n274\t        let pkt_ctx = if connection.is_multipath_enabled {\n275\t            &path_x.pkt_ctx\n276\t        } else {\n277\t            &connection.pkt_ctx[PacketContext::Application as usize]\n278\t        };\n279\t        self.ecn_alpha_update_counts(pkt_ctx.ecn_ect1_total_remote, pkt_ctx.ecn_ce_total_remote);\n280\t    }\n281\t\n282\t    /// C: `c4_ecn_threshold` (picoquic/c4.c:281)\n283\t    ///\n284\t    /// Computes the ECN marking fraction (over 1024) above which a CE-mark\n285\t    /// event triggers congestion notification.  At low sensitivity the\n286\t    /// threshold is high (~192/1024 ≈ 18.75%); at maximum sensitivity it\n287\t    /// falls to ~96/1024 ≈ 9.375%.\n288\t    pub fn ecn_threshold(&self) -> u64 {\n289\t        let sensitivity = self.sensitivity_1024();\n290\t        192 - mult1024(sensitivity, 96)\n291\t    }\n292\t\n293\t    /// C: `c4_era_check` (picoquic/c4.c:463)\n294\t    ///\n295\t    /// Returns `true` when the current measurement era is complete: the\n296\t    /// connection must be in the Ready state, and the lowest unacknowledged\n297\t    /// sequence number must have advanced past `era_sequence`.\n298\t    #[allow(dead_code)]\n299\t    fn era_check(&self, path_x: &Path, connection: &Connection) -> bool {\n300\t        if connection.connection_state < State::Ready {\n301\t            return false;\n302\t        }\n303\t        path_x.lowest_not_ack() > self.era_sequence\n304\t    }\n305\t\n306\t    /// C: `c4_era_reset` (picoquic/c4.c:475)\n307\t    ///\n308\t    /// Begins a new measurement era: advances `era_sequence` to the current\n309\t    /// send sequence number, resets per-era RTT accumulators, snapshots\n310\t    /// `alpha_1024_current` into `alpha_1024_previous`, and updates the ECN\n311\t    /// alpha from the latest packet-context counters.\n312\t    #[allow(dead_code)]\n313\t    fn era_reset(&mut self, path_x: &Path, connection: &Connection) {\n314\t        self.era_sequence = connection.sequence_number(path_x);\n315\t        self.era_max_rtt = 0;\n316\t        self.era_min_rtt = u64::MAX;\n317\t        self.alpha_1024_previous = self.alpha_1024_current;\n318\t        self.update_ecn_alpha(path_x, connection);\n319\t    }\n320\t\n321\t    /// C: `c4_enter_initial` (picoquic/c4.c:486)\n322\t    ///\n323\t    /// Transitions to the Initial (slow-start) state: captures the current\n324\t    /// CWIN, sets probe level and alpha to their startup defaults, resets era\n325\t    /// and growth tracking, and zeroes the ECN alpha.\n326\t    #[allow(dead_code)]\n327\t    fn enter_initial(&mut self, path_x: &Path, connection: &Connection) {\n328\t        self.alg_state = C4AlgState::Initial;\n329\t        self.initial_cwnd = path_x.cwin;\n330\t        self.probe_level = C4_PROBE_LEVEL_DEFAULT;\n331\t        self.alpha_1024_current = C4_ALPHA_INITIAL;\n332\t        self.nb_packets_in_startup = 0;\n333\t        self.era_reset(path_x, connection);\n334\t        self.nb_eras_no_increase = 0;\n335\t        self.ecn_alpha = 0;\n336\t        self.growth_reset();\n337\t    }\n338\t\n339\t    /// C: `c4_enter_recovery` (picoquic/c4.c:649)\n340\t    ///\n341\t    /// Transitions to the Recovery state.  If entering from Initial, first\n342\t    /// calls `growth_reset` so the growth comparison starts from a clean\n343\t    /// baseline.  Multiple simultaneous congestion signals are collapsed: if\n344\t    /// already in Recovery this is a no-op.\n345\t    fn enter_recovery(&mut self, path_x: &Path, connection: &Connection, c_mode: C4Congestion) {\n346\t        if self.alg_state == C4AlgState::Initial {\n347\t            self.growth_reset();\n348\t        }\n349\t        if self.alg_state != C4AlgState::Recovery {\n350\t            self.excess_ce_after_push = c_mode == C4Congestion::Ecn;\n351\t            self.alg_state = C4AlgState::Recovery;\n352\t            self.era_reset(path_x, connection);\n353\t            self.alpha_1024_current = C4_ALPHA_RECOVER_1024;\n354\t        }\n355\t    }\n356\t\n357\t    /// C: `c4_loss_threshold` (picoquic/c4.c:290)\n358\t    ///\n359\t    /// Returns the smoothed-loss-rate threshold above which a loss event\n360\t    /// triggers a congestion notification.  Ranges from ~52% at low rates\n361\t    /// (sensitivity ≈ 0) to ~2% at maximum sensitivity.\n362\t    pub fn loss_threshold(&self) -> f64 {\n363\t        let sensitivity = self.sensitivity_1024();\n364\t        let fraction = sensitivity as f64 / 1024.0;\n365\t        0.02 + 0.50 * (1.0 - fraction)\n366\t    }\n367\t\n368\t    /// C: `c4_enter_cruise` (picoquic/c4.c:715)\n369\t    ///\n370\t    /// Transitions to the Cruising state.  Resets the era, clears the seed\n371\t    /// CWIN flag, calculates how many cruise eras remain before the next\n372\t    /// push, and sets `alpha_1024_current`.  For very low-RTT paths (< 1 ms)\n373\t    /// pacing is loosened by an extra 48/1024 ≈ 4.7%.\n374\t    fn enter_cruise(&mut self, path_x: &mut Path, connection: &Connection) {\n375\t        self.era_reset(path_x, connection);\n376\t        self.use_seed_cwin = false;\n377\t\n378\t        if self.probe_level > C4_PROBE_LEVEL_DEFAULT {\n379\t            self.nb_cruise_left_before_push = 0;\n380\t        } else if self.nb_cruise_left_before_push == 0 {\n381\t            self.nb_cruise_left_before_push = if self.probe_level == 0 {\n382\t                1\n383\t            } else {\n384\t                C4_NB_CRUISE_BEFORE_PUSH\n385\t            };\n386\t        }\n387\t\n388\t        self.alpha_1024_current = C4_ALPHA_CRUISE_1024;\n389\t        if path_x.smoothed_rtt.ticks() < C4_MAX_RTT_MIN {\n390\t            self.alpha_1024_current += 48;\n391\t        }\n392\t        self.alg_state = C4AlgState::Cruising;\n393\t    }\n394\t\n395\t    /// C: `c4_exit_initial` (picoquic/c4.c:535)\n396\t    ///\n397\t    /// Exits the Initial slow-start phase.  Derives `nominal_max_rtt` from\n398\t    /// the half-CWIN / rate ratio, clamps it to `C4_MAX_RTT_MIN`, updates\n399\t    /// the delay threshold, resets era counters, and enters Recovery with no\n400\t    /// congestion signal (used as the first cruise entry point).\n401\t    fn exit_initial(&mut self, path_x: &mut Path, connection: &Connection) {\n402\t        if self.nominal_rate > 0 {\n403\t            let ssthresh = self.initial_cwnd / 2;\n404\t            self.nominal_max_rtt = ssthresh * 1_000_000 / self.nominal_rate;\n405\t            if self.nominal_max_rtt < C4_MAX_RTT_MIN {\n406\t                self.nominal_max_rtt = C4_MAX_RTT_MIN;\n407\t            }\n408\t            self.delay_threshold = self.delay_threshold();\n409\t            self.nb_eras_no_increase = 0;\n410\t            self.probe_level = C4_PROBE_LEVEL_DEFAULT;\n411\t            self.enter_recovery(path_x, connection, C4Congestion::None);\n412\t        }\n413\t    }\n414\t\n415\t    /// C: `c4_exit_recovery` (picoquic/c4.c:674)\n416\t    ///\n417\t    /// Exits Recovery.  Evaluates whether the previous push produced growth\n418\t    /// and adjusts `probe_level` accordingly: successful growth increments it\n419\t    /// (unless ECN excess was flagged); a rate-limited failure resets it to 1\n420\t    /// (0 under ECN excess).  After resetting growth tracking and clearing\n421\t    /// transient state, transitions to Initial if probe_level has exceeded the\n422\t    /// maximum, or to Cruising otherwise.\n423\t    fn exit_recovery(&mut self, path_x: &mut Path, connection: &Connection) {\n424\t        let is_growing = self.growth_evaluate();\n425\t        if is_growing {\n426\t            if !self.excess_ce_after_push {\n427\t                self.probe_level += 1;\n428\t            }\n429\t        } else if self.push_was_not_limited {\n430\t            self.probe_level = 1;\n431\t            if self.excess_ce_after_push {\n432\t                self.probe_level = 0;\n433\t            }\n434\t        }\n435\t        self.growth_reset();\n436\t        self.recent_delay_excess = 0;\n437\t        self.smoothed_drop_rate = 0.0;\n438\t        self.ecn_alpha = 0;\n439\t\n440\t        if self.probe_level > C4_PROBE_LEVEL_MAX {\n441\t            self.enter_initial(path_x, connection);\n442\t        } else {\n443\t            self.enter_cruise(path_x, connection);\n444\t        }\n445\t    }\n446\t\n447\t    /// C: `c4_initial_handle_ack` (picoquic/c4.c:576)\n448\t    ///\n449\t    /// Handles an ACK during Initial slow-start.  Grows `initial_cwnd` by the\n450\t    /// bytes acknowledged (with a right-shift damper proportional to how many\n451\t    /// eras without rate increase have been observed — similar to HyStart++).\n452\t    /// At each era boundary, checks whether growth is still happening; if not,\n453\t    /// increments `nb_eras_no_increase`.  After three eras without growth,\n454\t    /// or immediately if the seed-rate has been validated, exits Initial.\n455\t    fn initial_handle_ack(\n456\t        &mut self,\n457\t        path_x: &mut Path,\n458\t        connection: &Connection,\n459\t        ack_state: &PerAckState,\n460\t    ) {\n461\t        self.nb_packets_in_startup += 1;\n462\t        self.initial_cwnd +=\n463\t            ack_state.nb_bytes_acknowledged >> (3 * self.nb_eras_no_increase as u32);\n464\t        if self.use_seed_cwin && self.seed_rate > 0 && self.nominal_rate >= self.seed_rate {\n465\t            self.use_seed_cwin = false;\n466\t        }\n467\t        if self.era_check(path_x, connection) {\n468\t            let is_growing = self.growth_evaluate();\n469\t            if is_growing {\n470\t                self.nb_eras_no_increase = 0;\n471\t            } else if self.push_was_not_limited && self.nominal_rate > 0 {\n472\t                self.nb_eras_no_increase += 1;\n473\t            }\n474\t            self.era_reset(path_x, connection);\n475\t            if self.nb_eras_no_increase >= 3 {\n476\t                self.exit_initial(path_x, connection);\n477\t            } else {\n478\t                self.growth_reset();\n479\t            }\n480\t        }\n481\t    }\n482\t\n483\t    /// C: `c4_apply_rate_and_cwin` (picoquic/c4.c:359)\n484\t    ///\n485\t    /// Computes and applies the pacing rate and CWIN from the current alpha\n486\t    /// and nominal-rate parameters.  In Initial state the CWIN is floored to\n487\t    /// `initial_cwnd` and may incorporate the seed CWIN or peak bandwidth\n488\t    /// estimate.  In other states an RTT-margin buffer and an extra Pushing\n489\t    /// padding are added.\n490\t    fn apply_rate_and_cwin(&mut self, path_x: &mut Path) {\n491\t        let mut pacing_rate = mult1024(self.alpha_1024_current, self.nominal_rate);\n492\t        let mut target_cwin = CWIN_INITIAL;\n493\t        if self.nominal_max_rtt != 0 && self.nominal_rate != 0 {\n494\t            target_cwin = bytes_from_rate(self.nominal_max_rtt, pacing_rate);\n495\t        }\n496\t\n497\t        if self.alg_state == C4AlgState::Initial {\n498\t            if target_cwin < self.initial_cwnd {\n499\t                target_cwin = self.initial_cwnd;\n500\t            }\n501\t            if self.nb_packets_in_startup > 0 && path_x.peak_bandwidth_estimate > pacing_rate {\n502\t                pacing_rate = (pacing_rate + path_x.peak_bandwidth_estimate) / 2;\n503\t                let min_win =\n504\t                    bytes_from_rate(path_x.smoothed_rtt.ticks(), path_x.peak_bandwidth_estimate)\n505\t                        / 2;\n506\t                if min_win > target_cwin {\n507\t                    target_cwin = min_win;\n508\t                }\n509\t            }\n510\t            if self.use_seed_cwin && self.seed_cwin > target_cwin {\n511\t                target_cwin = (self.seed_cwin + target_cwin) / 2;\n512\t                self.seed_rate = rate_from_bytes(self.seed_cwin, path_x.smoothed_rtt.ticks());\n513\t                if self.seed_rate > pacing_rate {\n514\t                    pacing_rate = self.seed_rate;\n515\t                }\n516\t            }\n517\t            self.initial_cwnd = target_cwin;\n518\t        } else {\n519\t            let delta_rtt_target = if self.nominal_max_rtt < 4 * C4_RTT_MARGIN_DELAY {\n520\t                self.nominal_max_rtt / 4\n521\t            } else {\n522\t                C4_RTT_MARGIN_DELAY\n523\t            };\n524\t            target_cwin += bytes_from_rate(delta_rtt_target, pacing_rate);\n525\t\n526\t            if self.alg_state == C4AlgState::Pushing {\n527\t                let delta_alpha = self.alpha_1024_current.saturating_sub(1024);\n528\t                let delta_rate = mult1024(delta_alpha, self.nominal_rate);\n529\t                let delta_cwin = bytes_from_rate(self.nominal_max_rtt, delta_rate);\n530\t                if delta_cwin < path_x.send_mtu as u64 {\n531\t                    target_cwin += path_x.send_mtu as u64 - delta_cwin;\n532\t                }\n533\t            }\n534\t        }\n535\t\n536\t        path_x.cwin = target_cwin;\n537\t        let mut quantum = mult1024(4, pacing_rate);\n538\t        if quantum > 0x10000 {\n539\t            quantum = 0x10000;\n540\t        } else if quantum < 2 * path_x.send_mtu as u64 {\n541\t            quantum = 2 * path_x.send_mtu as u64;\n542\t        }\n543\t        path_x.update_pacing_rate(pacing_rate as f64, quantum);\n544\t    }\n545\t\n546\t    /// C: `c4_notify_congestion` (picoquic/c4.c:893)\n547\t    ///\n548\t    /// Reacts to a congestion event (delay, ECN, or loss) by computing a\n549\t    /// `beta` back-off fraction, reducing `nominal_rate` and optionally\n550\t    /// `nominal_max_rtt`, then entering Recovery.  Congestion signals arriving\n551\t    /// while already in Recovery tighten `alpha_1024_current` further rather\n552\t    /// than re-entering.\n553\t    fn notify_congestion(\n554\t        &mut self,\n555\t        path_x: &mut Path,\n556\t        connection: &Connection,\n557\t        c_mode: C4Congestion,\n558\t    ) {\n559\t        let mut beta = C4_BETA_LOSS_1024;\n560\t        self.congestion_notified = true;\n561\t\n562\t        if c_mode == C4Congestion::Loss {\n563\t            beta = (C4_BETA_LOSS_1024 + mult1024(self.sensitivity_1024(), C4_BETA_LOSS_1024)) / 2;\n564\t        } else if c_mode == C4Congestion::Ecn {\n565\t            if self.ecn_threshold > 0 {\n566\t                beta = (self.ecn_alpha - self.ecn_threshold) * 1024 / self.ecn_threshold;\n567\t            }\n568\t            if beta > C4_BETA_LOSS_1024 {\n569\t                beta = C4_BETA_LOSS_1024;\n570\t            }\n571\t        }\n572\t\n573\t        if c_mode == C4Congestion::Delay {\n574\t            if self.delay_threshold > 0 {\n575\t                beta = self.recent_delay_excess * 1024 / self.delay_threshold;\n576\t            }\n577\t            if beta > C4_BETA_LOSS_1024 {\n578\t                beta = C4_BETA_LOSS_1024;\n579\t            }\n580\t        } else {\n581\t            self.recent_delay_excess = 0;\n582\t        }\n583\t\n584\t        if self.alg_state == C4AlgState::Recovery {\n585\t            if self.alpha_1024_current == C4_ALPHA_RECOVER_1024 {\n586\t                self.alpha_1024_current = C4_ALPHA_RECOVER2_1024;\n587\t                self.era_sequence = connection.sequence_number(path_x);\n588\t                c4_logger(path_x, 0, self, None, beta, c_mode);\n589\t            }\n590\t            if c_mode == C4Congestion::Ecn {\n591\t                self.excess_ce_after_push = true;\n592\t            }\n593\t        } else {\n594\t            if self.alg_state != C4AlgState::Pushing {\n595\t                self.nominal_rate -= mult1024(beta, self.nominal_rate);\n596\t                if c_mode == C4Congestion::Loss {\n597\t                    self.nominal_max_rtt -= mult1024(beta, self.nominal_max_rtt);\n598\t                    if self.nominal_max_rtt < C4_MAX_RTT_MIN {\n599\t                        self.nominal_max_rtt = C4_MAX_RTT_MIN;\n600\t                    }\n601\t                    self.delay_threshold = self.delay_threshold();\n602\t                }\n603\t                c4_logger(path_x, 0, self, None, beta, c_mode);\n604\t            }\n605\t            self.enter_recovery(path_x, connection, c_mode);\n606\t        }\n607\t\n608\t        self.apply_rate_and_cwin(path_x);\n609\t        path_x.is_ssthresh_initialized = true;\n610\t    }\n611\t\n612\t    /// C: `c4_initial_handle_loss` (picoquic/c4.c:568)\n613\t    ///\n614\t    /// Counts a loss event during Initial and exits Initial once\n615\t    /// `C4_NB_PACKETS_BEFORE_LOSS` losses have been seen.\n616\t    fn initial_handle_loss(&mut self, path_x: &mut Path, connection: &Connection) {\n617\t        self.nb_packets_in_startup += 1;\n618\t        if self.nb_packets_in_startup > C4_NB_PACKETS_BEFORE_LOSS {\n619\t            self.exit_initial(path_x, connection);\n620\t        }\n621\t    }\n622\t\n623\t    /// C: `c4_update_rtt` (picoquic/c4.c:976)\n624\t    ///\n625\t    /// Updates per-era RTT accumulators and the running min-RTT from a new\n626\t    /// RTT sample.  If `nominal_max_rtt` has not been set yet, initialises it\n627\t    /// and the delay threshold.  Otherwise computes `recent_delay_excess` as\n628\t    /// how far the sample exceeds `nominal_max_rtt + delay_threshold`.\n629\t    fn update_rtt(&mut self, rtt_measurement: u64) {\n630\t        if rtt_measurement > self.era_max_rtt {\n631\t            self.era_max_rtt = rtt_measurement;\n632\t        }\n633\t        if rtt_measurement < self.era_min_rtt {\n634\t            self.era_min_rtt = rtt_measurement;\n635\t        }\n636\t        if rtt_measurement < self.running_min_rtt {\n637\t            self.running_min_rtt = rtt_measurement;\n638\t        }\n639\t        if self.nominal_max_rtt == 0 {\n640\t            self.nominal_max_rtt = rtt_measurement;\n641\t            if self.nominal_max_rtt < C4_MAX_RTT_MIN {\n642\t                self.nominal_max_rtt = C4_MAX_RTT_MIN;\n643\t            }\n644\t            self.delay_threshold = self.delay_threshold();\n645\t            self.recent_delay_excess = 0;\n646\t        } else {\n647\t            let target_rtt = self.nominal_max_rtt + self.delay_threshold;\n648\t            if rtt_measurement > target_rtt {\n649\t                self.recent_delay_excess = rtt_measurement - target_rtt;\n650\t            } else {\n651\t                self.recent_delay_excess = 0;\n652\t            }\n653\t        }\n654\t    }\n655\t\n656\t    /// C: `c4_initial_handle_rtt_excess` (picoquic/c4.c:551)\n657\t    ///\n658\t    /// HyStart-style RTT-increase detector during Initial.  Exits Initial\n659\t    /// when delay excess has been seen, at least two eras without increase\n660\t    /// have elapsed, and the rate has not grown above the previous era's rate.\n661\t    fn initial_handle_rtt_excess(&mut self, path_x: &mut Path, connection: &Connection) {\n662\t        if self.recent_delay_excess > 0\n663\t            && self.nb_eras_no_increase > 1\n664\t            && self.push_rate_old >= self.nominal_rate\n665\t        {\n666\t            self.exit_initial(path_x, connection);\n667\t        }\n668\t    }\n669\t\n670\t    /// C: `c4_handle_rtt_excess` (picoquic/c4.c:1008)\n671\t    ///\n672\t    /// Fires a delay-congestion notification when a delay excess was observed\n673\t    /// during a period where alpha was above neutral (i.e. we were probing).\n674\t    fn handle_rtt_excess(&mut self, path_x: &mut Path, connection: &Connection) {\n675\t        if self.recent_delay_excess > 0 && self.alpha_1024_previous > 1024 {\n676\t            self.notify_congestion(path_x, connection, C4Congestion::Delay);\n677\t        }\n678\t    }\n679\t\n680\t    /// C: `c4_update_min_max_rtt` (picoquic/c4.c:756)\n681\t    ///\n682\t    /// Updates `running_min_rtt`, `nominal_max_rtt`, and `delay_threshold`\n683\t    /// from the era's min/max RTT samples.  Only applied when\n684\t    /// `alpha_1024_previous ≤ C4_ALPHA_NEUTRAL_1024` so that measurements\n685\t    /// taken during a push period don't corrupt the baseline.  A corrected max\n686\t    /// is capped at `running_min_rtt + C4_MAX_JITTER` to limit jitter impact.\n687\t    fn update_min_max_rtt(&mut self, path_x: &Path) {\n688\t        let rtt_sample = path_x.rtt_sample.ticks();\n689\t        if rtt_sample > self.era_max_rtt {\n690\t            self.era_max_rtt = rtt_sample;\n691\t        }\n692\t        if rtt_sample < self.era_min_rtt {\n693\t            self.era_min_rtt = rtt_sample;\n694\t        }\n695\t        if self.alpha_1024_previous <= C4_ALPHA_NEUTRAL_1024 {\n696\t            if self.era_min_rtt < self.running_min_rtt {\n697\t                self.running_min_rtt = self.era_min_rtt;\n698\t            } else {\n699\t                self.running_min_rtt = (7 * self.running_min_rtt + self.era_min_rtt) / 8;\n700\t            }\n701\t\n702\t            let corrected_max = if self.era_max_rtt < self.running_min_rtt + C4_MAX_JITTER {\n703\t                self.era_max_rtt\n704\t            } else {\n705\t                self.running_min_rtt + C4_MAX_JITTER\n706\t            };\n707\t\n708\t            if corrected_max > self.nominal_max_rtt {\n709\t                self.nominal_max_rtt = corrected_max;\n710\t            } else {\n711\t                self.nominal_max_rtt = (7 * self.nominal_max_rtt + corrected_max) / 8;\n712\t            }\n713\t            self.delay_threshold = self.delay_threshold();\n714\t        } else if self.nominal_max_rtt == 0 {\n715\t            self.nominal_max_rtt = self.era_max_rtt;\n716\t            self.delay_threshold = self.delay_threshold();\n717\t        }\n718\t\n719\t        if self.nominal_max_rtt < C4_MAX_RTT_MIN {\n720\t            self.nominal_max_rtt = C4_MAX_RTT_MIN;\n721\t            self.delay_threshold = self.delay_threshold();\n722\t        }\n723\t    }\n724\t\n725\t    /// C: `c4_enter_push` (picoquic/c4.c:746)\n726\t    ///\n727\t    /// Transitions to the Pushing state, setting alpha from the probe-level\n728\t    /// table, snapshotting that alpha into `push_alpha`, and resetting the era.\n729\t    fn enter_push(&mut self, path_x: &mut Path, connection: &Connection) {\n730\t        let level = self.probe_level.clamp(0, C4_PROBE_LEVEL_MAX) as usize;\n731\t        self.alpha_1024_current = C4_PUSH_RATE_BY_PROBE_LEVEL[level];\n732\t        self.push_alpha = self.alpha_1024_current;\n733\t        self.era_reset(path_x, connection);\n734\t        self.alg_state = C4AlgState::Pushing;\n735\t    }\n736\t\n737\t    /// C: `c4_handle_ack` (picoquic/c4.c:804)\n738\t    ///\n739\t    /// Processes an acknowledgement: updates `nominal_rate` from the bandwidth\n740\t    /// estimate, sets `push_was_not_limited` when delivery was not\n741\t    /// application-limited, then advances the state machine at each era\n742\t    /// boundary (exit recovery → cruise → push → recovery cycle).\n743\t    fn handle_ack(&mut self, path_x: &mut Path, connection: &Connection, ack_state: &PerAckState) {\n744\t        let previous_rate = self.nominal_rate;\n745\t\n746\t        if ack_state.rtt_measurement.ticks() > 0\n747\t            && ack_state.nb_bytes_delivered_since_packet_sent > 0\n748\t        {\n749\t            let rate_measurement = path_x.bandwidth_estimate;\n750\t            c4_logger(\n751\t                path_x,\n752\t                rate_measurement,\n753\t                self,\n754\t                Some(ack_state),\n755\t                0,\n756\t                C4Congestion::None,\n757\t            );\n758\t\n759\t            if rate_measurement > self.nominal_rate\n760\t                && !(self.alg_state == C4AlgState::Recovery && self.congestion_notified)\n761\t            {\n762\t                self.push_was_not_limited = true;\n763\t                self.nominal_rate = rate_measurement;\n764\t                self.delay_threshold = self.delay_threshold();\n765\t            } else {\n766\t                let target_cwin = bytes_from_rate(self.running_min_rtt, previous_rate);\n767\t                if ack_state.nb_bytes_delivered_since_packet_sent > target_cwin {\n768\t                    self.push_was_not_limited = true;\n769\t                }\n770\t            }\n771\t        }\n772\t\n773\t        if self.alg_state == C4AlgState::Initial {\n774\t            self.initial_handle_ack(path_x, connection, ack_state);\n775\t        } else if self.era_check(path_x, connection) {\n776\t            self.update_min_max_rtt(path_x);\n777\t            // Check whether jitter/competition warrants re-entering Initial.\n778\t            if !self.initial_after_jitter\n779\t                && self.nominal_max_rtt > 50_000\n780\t                && self.nominal_rate < 1_000_000\n781\t                && 5 * self.running_min_rtt < 2 * self.nominal_max_rtt\n782\t            {\n783\t                self.initial_after_jitter = true;\n784\t                self.enter_initial(path_x, connection);\n785\t            } else {\n786\t                match self.alg_state {\n787\t                    C4AlgState::Recovery => {\n788\t                        self.exit_recovery(path_x, connection);\n789\t                    }\n790\t                    C4AlgState::Cruising => {\n791\t                        if self.nb_cruise_left_before_push > 0 {\n792\t                            self.nb_cruise_left_before_push -= 1;\n793\t                        }\n794\t                        self.era_reset(path_x, connection);\n795\t                        if self.nb_cruise_left_before_push == 0\n796\t                            && path_x.last_time_acked_data_frame_sent\n797\t                                > path_x.last_sender_limited_time\n798\t                        {\n799\t                            self.enter_push(path_x, connection);\n800\t                        }\n801\t                    }\n802\t                    C4AlgState::Pushing => {\n803\t                        self.enter_recovery(path_x, connection, C4Congestion::None);\n804\t                    }\n805\t                    _ => {\n806\t                        self.era_reset(path_x, connection);\n807\t                    }\n808\t                }\n809\t            }\n810\t        }\n811\t    }\n812\t\n813\t    /// C: `c4_reset` (picoquic/c4.c:517)\n814\t    ///\n815\t    /// Zeroes the C4 state (preserving `option_string`), then re-initialises\n816\t    /// via `enter_initial`.  Called on algorithm reset notifications and during\n817\t    /// `c4_init`.\n818\t    fn reset(&mut self, path_x: &mut Path, connection: &Connection) {\n819\t        let option_string = self.option_string.take();\n820\t        // Zero all fields.\n821\t        *self = C4State {\n822\t            alg_state: C4AlgState::default(),\n823\t            nominal_rate: 0,\n824\t            nominal_max_rtt: 0,\n825\t            initial_cwnd: 0,\n826\t            running_min_rtt: u64::MAX,\n827\t            alpha_1024_current: C4_ALPHA_INITIAL,\n828\t            alpha_1024_previous: 0,\n829\t            nb_packets_in_startup: 0,\n830\t            era_sequence: 0,\n831\t            nb_cruise_left_before_push: 0,\n832\t            seed_cwin: 0,\n833\t            seed_rate: 0,\n834\t            probe_level: 0,\n835\t            nb_eras_no_increase: 0,\n836\t            push_rate_old: 0,\n837\t            push_alpha: 0,\n838\t            era_max_rtt: 0,\n839\t            era_min_rtt: 0,\n840\t            delay_threshold: 0,\n841\t            recent_delay_excess: 0,\n842\t            last_lost_packet_number: 0,\n843\t            smoothed_drop_rate: 0.0,\n844\t            ecn_alpha: 0,\n845\t            ecn_ect1: 0,\n846\t            ecn_ce: 0,\n847\t            ecn_threshold: 0,\n848\t            congestion_notified: false,\n849\t            push_was_not_limited: false,\n850\t            use_seed_cwin: false,\n851\t            initial_after_jitter: false,\n852\t            excess_ce_after_push: false,\n853\t            option_string,\n854\t        };\n855\t        self.set_options();\n856\t        self.enter_initial(path_x, connection);\n857\t    }\n858\t\n859\t    /// C: `c4_notify` (picoquic/c4.c:1025)\n860\t    ///\n861\t    /// Main congestion-control notification dispatch.  Sets `is_cc_data_updated`,\n862\t    /// filters non-application packet contexts, then routes the notification to\n863\t    /// the appropriate handler.\n864\t    pub fn notify(\n865\t        &mut self,\n866\t        connection: &Connection,\n867\t        path_x: &mut Path,\n868\t        notification: CongestionNotification,\n869\t        ack_state: Option<&PerAckState>,\n870\t        _current_time: u64,\n871\t    ) {\n872\t        path_x.is_cc_data_updated = true;\n873\t\n874\t        if let Some(a) = ack_state\n875\t            && a.pc != PacketContext::Application as i32\n876\t        {\n877\t            return;\n878\t        }\n879\t\n880\t        match notification {\n881\t            CongestionNotification::Acknowledgement => {\n882\t                if let Some(a) = ack_state {\n883\t                    self.handle_ack(path_x, connection, a);\n884\t                }\n885\t                self.apply_rate_and_cwin(path_x);\n886\t            }\n887\t            CongestionNotification::EcnEc => {\n888\t                self.ecn_threshold = self.ecn_threshold();\n889\t                self.update_ecn_alpha(path_x, connection);\n890\t                if self.ecn_alpha > self.ecn_threshold {\n891\t                    if self.alg_state == C4AlgState::Initial {\n892\t                        if self.recent_delay_excess > 0\n893\t                            && self.nb_eras_no_increase > 1\n894\t                            && self.push_rate_old >= self.nominal_rate\n895\t                        {\n896\t                            self.exit_initial(path_x, connection);\n897\t                        }\n898\t                    } else {\n899\t                        self.notify_congestion(path_x, connection, C4Congestion::Ecn);\n900\t                    }\n901\t                }\n902\t            }\n903\t            CongestionNotification::Repeat => {\n904\t                if let Some(a) = ack_state {\n905\t                    if self.alg_state == C4AlgState::Recovery\n906\t                        && a.lost_packet_number < self.era_sequence\n907\t                    {\n908\t                        return;\n909\t                    }\n910\t                    self.update_loss_rate(a.lost_packet_number);\n911\t                    if self.smoothed_drop_rate > self.loss_threshold() {\n912\t                        if self.alg_state == C4AlgState::Initial {\n913\t                            self.initial_handle_loss(path_x, connection);\n914\t                        } else {\n915\t                            self.notify_congestion(path_x, connection, C4Congestion::Loss);\n916\t                        }\n917\t                    }\n918\t                }\n919\t            }\n920\t            CongestionNotification::Timeout => {}\n921\t            CongestionNotification::SpuriousRepeat => {}\n922\t            CongestionNotification::RttMeasurement => {\n923\t                if let Some(a) = ack_state {\n924\t                    self.update_rtt(a.rtt_measurement.ticks());\n925\t                    if self.alg_state == C4AlgState::Initial {\n926\t                        self.initial_handle_rtt_excess(path_x, connection);\n927\t                        self.apply_rate_and_cwin(path_x);\n928\t                    } else {\n929\t                        self.handle_rtt_excess(path_x, connection);\n930\t                    }\n931\t                }\n932\t            }\n933\t            CongestionNotification::LostFeedback => {}\n934\t            CongestionNotification::CwinBlocked => {}\n935\t            CongestionNotification::Reset => {\n936\t                self.reset(path_x, connection);\n937\t            }\n938\t            CongestionNotification::SeedCwin => {\n939\t                if let Some(a) = ack_state {\n940\t                    self.seed_cwin(a.nb_bytes_acknowledged);\n941\t                }\n942\t            }\n943\t        }\n944\t    }\n945\t}\n946\t\n947\t/// C: `c4_logger` (picoquic/c4.c:199)\n948\t///\n949\t/// Emits a diagnostic log line with the current C4 rate-control parameters.\n950\t/// In C this is gated by `C4_WITH_LOGGING`; in Rust it always compiles and\n951\t/// emits at `log::debug` level (no-cost when the log level is above debug).\n952\tpub fn c4_logger(\n953\t    path_x: &Path,\n954\t    rate_measurement: u64,\n955\t    c4_state: &C4State,\n956\t    ack_state: Option<&PerAckState>,\n957\t    beta: u64,\n958\t    congestion_mode: C4Congestion,\n959\t) {\n960\t    log::debug!(\n961\t        \"C4_rate, {},{},{},{},{},{},{},{},{},{},{},{},{},{},{}\",\n962\t        rate_measurement,\n963\t        c4_state.nominal_rate,\n964\t        ack_state.map_or(0, |a| a.nb_bytes_delivered_since_packet_sent),\n965\t        ack_state.map_or(0, |a| a.rtt_measurement.ticks()),\n966\t        ack_state.map_or(0, |a| a.send_delay.ticks()),\n967\t        c4_state.nominal_max_rtt,\n968\t        c4_state.alg_state as u64,\n969\t        path_x.bandwidth_estimate,\n970\t        path_x.bytes_in_transit,\n971\t        beta,\n972\t        congestion_mode as u64,\n973\t        c4_state.ecn_alpha,\n974\t        path_x.smoothed_rtt.ticks(),\n975\t        path_x.rtt_variant.ticks(),\n976\t        c4_state.alpha_1024_previous,\n977\t    );\n978\t}\n979\t\n980\t#[cfg(test)]\n981\tmod tests {\n982\t    use super::*;\n983\t\n984\t    fn make_state() -> C4State {\n985\t        C4State {\n986\t            alg_state: C4AlgState::default(),\n987\t            nominal_rate: 0,\n988\t            nominal_max_rtt: 0,\n989\t            initial_cwnd: 0,\n990\t            running_min_rtt: 0,\n991\t            alpha_1024_current: 0,\n992\t            alpha_1024_previous: 0,\n993\t            nb_packets_in_startup: 0,\n994\t            era_sequence: 0,\n995\t            nb_cruise_left_before_push: 0,\n996\t            seed_cwin: 0,\n997\t            seed_rate: 0,\n998\t            probe_level: 0,\n999\t            nb_eras_no_increase: 0,\n1000\t            push_rate_old: 0,\n1001\t            push_alpha: 0,\n1002\t            era_max_rtt: 0,\n1003\t            era_min_rtt: 0,\n1004\t            delay_threshold: 0,\n1005\t            recent_delay_excess: 0,\n1006\t            last_lost_packet_number: 0,\n1007\t            smoothed_drop_rate: 0.0,\n1008\t            ecn_alpha: 0,\n1009\t            ecn_ect1: 0,\n1010\t            ecn_ce: 0,\n1011\t            ecn_threshold: 0,\n1012\t            congestion_notified: false,\n1013\t            push_was_not_limited: false,\n1014\t            use_seed_cwin: false,\n1015\t            initial_after_jitter: false,\n1016\t            excess_ce_after_push: false,\n1017\t            option_string: None,\n1018\t        }\n1019\t    }\n1020\t\n1021\t    #[test]\n1022\t    fn growth_evaluate_high_alpha_growing() {\n1023\t        let mut s = make_state();\n1024\t        // push_alpha > 1088, push_rate_old = 1000, nominal_rate must exceed:\n1025\t        // target = (3*1000 + MULT1024(1280, 1000)) / 4 = (3000 + 1250) / 4 = 1062\n1026\t        s.push_alpha = 1280;\n1027\t        s.push_rate_old = 1000;\n1028\t        s.nominal_rate = 1100;\n1029\t        assert!(s.growth_evaluate());\n1030\t    }\n1031\t\n1032\t    #[test]\n1033\t    fn growth_evaluate_high_alpha_not_growing() {\n1034\t        let mut s = make_state();\n1035\t        s.push_alpha = 1280;\n1036\t        s.push_rate_old = 1000;\n1037\t        s.nominal_rate = 1000; // equal to target_rate or below\n1038\t        assert!(!s.growth_evaluate());\n1039\t    }\n1040\t\n1041\t    #[test]\n1042\t    fn growth_evaluate_low_alpha_growing_no_congestion() {\n1043\t        let mut s = make_state();\n1044\t        s.push_alpha = 1000; // <= 1088\n1045\t        s.push_rate_old = 800;\n1046\t        s.nominal_rate = 900;\n1047\t        s.congestion_notified = false;\n1048\t        assert!(s.growth_evaluate());\n1049\t    }\n1050\t\n1051\t    #[test]\n1052\t    fn growth_evaluate_low_alpha_congestion_blocks_growth() {\n1053\t        let mut s = make_state();\n1054\t        s.push_alpha = 1000;\n1055\t        s.push_rate_old = 800;\n1056\t        s.nominal_rate = 900;\n1057\t        s.congestion_notified = true;\n1058\t        assert!(!s.growth_evaluate());\n1059\t    }\n1060\t\n1061\t    // --- sensitivity_1024 ---\n1062\t\n1063\t    #[test]\n1064\t    fn sensitivity_below_50k() {\n1065\t        let mut s = make_state();\n1066\t        s.nominal_rate = 49_999;\n1067\t        assert_eq!(s.sensitivity_1024(), 0);\n1068\t    }\n1069\t\n1070\t    #[test]\n1071\t    fn sensitivity_at_50k_boundary() {\n1072\t        let mut s = make_state();\n1073\t        s.nominal_rate = 50_000;\n1074\t        // (50000 - 50000) * 963 / 950000 == 0\n1075\t        assert_eq!(s.sensitivity_1024(), 0);\n1076\t    }\n1077\t\n1078\t    #[test]\n1079\t    fn sensitivity_midrange() {\n1080\t        let mut s = make_state();\n1081\t        s.nominal_rate = 500_000;\n1082\t        // (500000 - 50000) * 963 / 950000 = 450000 * 963 / 950000 = 456\n1083\t        assert_eq!(s.sensitivity_1024(), 456);\n1084\t    }\n1085\t\n1086\t    #[test]\n1087\t    fn sensitivity_at_1mbps() {\n1088\t        let mut s = make_state();\n1089\t        s.nominal_rate = 1_000_000;\n1090\t        // hits else branch: 963 + (0 * 61 / 9000000) = 963\n1091\t        assert_eq!(s.sensitivity_1024(), 963);\n1092\t    }\n1093\t\n1094\t    #[test]\n1095\t    fn sensitivity_at_10mbps() {\n1096\t        let mut s = make_state();\n1097\t        s.nominal_rate = 10_000_000;\n1098\t        // 963 + (9000000 * 61 / 9000000) = 963 + 61 = 1024\n1099\t        assert_eq!(s.sensitivity_1024(), 1024);\n1100\t    }\n1101\t\n1102\t    #[test]\n1103\t    fn sensitivity_above_10mbps() {\n1104\t        let mut s = make_state();\n1105\t        s.nominal_rate = 10_000_001;\n1106\t        assert_eq!(s.sensitivity_1024(), 1024);\n1107\t    }\n1108\t\n1109\t    // --- growth_reset ---\n1110\t\n1111\t    #[test]\n1112\t    fn growth_reset_clears_flags_and_snapshots() {\n1113\t        let mut s = make_state();\n1114\t        s.nominal_rate = 5_000_000;\n1115\t        s.alpha_1024_current = 1100;\n1116\t        s.congestion_notified = true;\n1117\t        s.push_was_not_limited = true;\n1118\t        s.push_rate_old = 1_000_000;\n1119\t        s.push_alpha = 900;\n1120\t\n1121\t        s.growth_reset();\n1122\t\n1123\t        assert!(!s.congestion_notified);\n1124\t        assert!(!s.push_was_not_limited);\n1125\t        assert_eq!(s.push_rate_old, 5_000_000);\n1126\t        assert_eq!(s.push_alpha, 1100);\n1127\t    }\n1128\t\n1129\t    // --- set_options ---\n1130\t\n1131\t    #[test]\n1132\t    fn set_options_none_is_noop() {\n1133\t        let mut s = make_state();\n1134\t        s.option_string = None;\n1135\t        s.set_options(); // must not panic\n1136\t    }\n1137\t\n1138\t    #[test]\n1139\t    fn set_options_unknown_chars_are_noop() {\n1140\t        let mut s = make_state();\n1141\t        s.option_string = Some(\"xyz\".to_owned());\n1142\t        s.set_options(); // must not panic; no state change expected\n1143\t    }\n1144\t\n1145\t    // --- seed_cwin ---\n1146\t\n1147\t    #[test]\n1148\t    fn seed_cwin_sets_when_initial() {\n1149\t        let mut s = make_state();\n1150\t        s.alg_state = C4AlgState::Initial;\n1151\t        s.seed_cwin(123_456);\n1152\t        assert!(s.use_seed_cwin);\n1153\t        assert_eq!(s.seed_cwin, 123_456);\n1154\t    }\n1155\t\n1156\t    #[test]\n1157\t    fn seed_cwin_ignored_when_not_initial() {\n1158\t        let mut s = make_state();\n1159\t        s.alg_state = C4AlgState::Cruising;\n1160\t        s.seed_cwin(123_456);\n1161\t        assert!(!s.use_seed_cwin);\n1162\t        assert_eq!(s.seed_cwin, 0);\n1163\t    }\n1164\t\n1165\t    // --- observe ---\n1166\t\n1167\t    #[test]\n1168\t    fn observe_returns_state_and_rtt() {\n1169\t        let mut s = make_state();\n1170\t        s.alg_state = C4AlgState::Pushing;\n1171\t        s.nominal_max_rtt = 42_000;\n1172\t        let (cc_state, cc_param) = s.observe();\n1173\t        assert_eq!(cc_state, C4AlgState::Pushing as u64);\n1174\t        assert_eq!(cc_param, 42_000);\n1175\t    }\n1176\t\n1177\t    #[test]\n1178\t    fn observe_initial_state() {\n1179\t        let s = make_state();\n1180\t        let (cc_state, cc_param) = s.observe();\n1181\t        assert_eq!(cc_state, 0); // C4AlgState::Initial == 0\n1182\t        assert_eq!(cc_param, 0);\n1183\t    }\n1184\t\n1185\t    // --- update_loss_rate ---\n1186\t\n1187\t    #[test]\n1188\t    fn loss_rate_no_update_when_not_newer() {\n1189\t        let mut s = make_state();\n1190\t        s.last_lost_packet_number = 100;\n1191\t        s.smoothed_drop_rate = 0.5;\n1192\t        s.update_loss_rate(100); // same number → no change\n1193\t        assert_eq!(s.smoothed_drop_rate, 0.5);\n1194\t        assert_eq!(s.last_lost_packet_number, 100);\n1195\t    }\n1196\t\n1197\t    #[test]\n1198\t    fn loss_rate_single_step() {\n1199\t        let mut s = make_state();\n1200\t        s.last_lost_packet_number = 0;\n1201\t        s.smoothed_drop_rate = 0.0;\n1202\t        s.update_loss_rate(1);\n1203\t        // one decay step: rate *= (1 - 1/16) = 0  (was 0)\n1204\t        // then: rate += (1 - 0) * (1/16) = 1/16\n1205\t        assert!((s.smoothed_drop_rate - 1.0 / 16.0).abs() < 1e-12);\n1206\t        assert_eq!(s.last_lost_packet_number, 1);\n1207\t    }\n1208\t\n1209\t    #[test]\n1210\t    fn loss_rate_caps_scope() {\n1211\t        let mut s = make_state();\n1212\t        // Gap far exceeds SMOOTHED_LOSS_SCOPE=32; loop should start at\n1213\t        // lost_packet_number - 32 so only 32 decays happen, not 1000.\n1214\t        s.last_lost_packet_number = 0;\n1215\t        s.smoothed_drop_rate = 1.0;\n1216\t        s.update_loss_rate(1000);\n1217\t        // After 32 decay steps: 1.0 * (15/16)^32 ≈ 0.1209\n1218\t        // Then one more step adding the loss event:\n1219\t        // result = decayed + (1 - decayed) * (1/16)\n1220\t        let expected_decayed = (15.0f64 / 16.0).powi(32);\n1221\t        let expected = expected_decayed + (1.0 - expected_decayed) * (1.0 / 16.0);\n1222\t        assert!((s.smoothed_drop_rate - expected).abs() < 1e-9);\n1223\t        assert_eq!(s.last_lost_packet_number, 1000);\n1224\t    }\n1225\t\n1226\t    // --- ecn_threshold ---\n1227\t\n1228\t    #[test]\n1229\t    fn ecn_threshold_zero_sensitivity() {\n1230\t        let mut s = make_state();\n1231\t        s.nominal_rate = 0; // sensitivity = 0\n1232\t        // 192 - MULT1024(0, 96) = 192\n1233\t        assert_eq!(s.ecn_threshold(), 192);\n1234\t    }\n1235\t\n1236\t    #[test]\n1237\t    fn ecn_threshold_max_sensitivity() {\n1238\t        let mut s = make_state();\n1239\t        s.nominal_rate = 10_000_001; // sensitivity = 1024\n1240\t        // 192 - MULT1024(1024, 96) = 192 - 96 = 96\n1241\t        assert_eq!(s.ecn_threshold(), 96);\n1242\t    }\n1243\t\n1244\t    #[test]\n1245\t    fn ecn_threshold_mid_sensitivity() {\n1246\t        let mut s = make_state();\n1247\t        s.nominal_rate = 1_000_000; // sensitivity = 963\n1248\t        // 192 - MULT1024(963, 96) = 192 - ((96 * 963) >> 10) = 192 - 90 = 102\n1249\t        let expected = 192 - ((96u64 * 963) >> 10);\n1250\t        assert_eq!(s.ecn_threshold(), expected);\n1251\t    }\n1252\t\n1253\t    // --- ecn_alpha_update_counts ---\n1254\t\n1255\t    #[test]\n1256\t    fn ecn_alpha_no_update_when_both_zero_delta() {\n1257\t        let mut s = make_state();\n1258\t        s.ecn_alpha = 500;\n1259\t        s.ecn_ect1 = 100;\n1260\t        s.ecn_ce = 50;\n1261\t        // same totals → no delta → alpha unchanged\n1262\t        s.ecn_alpha_update_counts(100, 50);\n1263\t        assert_eq!(s.ecn_alpha, 500);\n1264\t    }\n1265\t\n1266\t    #[test]\n1267\t    fn ecn_alpha_fast_path_large_frac() {\n1268\t        let mut s = make_state();\n1269\t        s.ecn_alpha = 400;\n1270\t        s.ecn_ect1 = 0;\n1271\t        s.ecn_ce = 0;\n1272\t        // delta_ce = 600, delta_ect1 = 400 → frac = 600*1024/(600+400) = 614\n1273\t        // frac (614) > alpha (400) and frac >= 512 → fast path: alpha = frac\n1274\t        s.ecn_alpha_update_counts(400, 600);\n1275\t        assert_eq!(s.ecn_alpha, 614);\n1276\t    }\n1277\t\n1278\t    #[test]\n1279\t    fn ecn_alpha_ewma_path() {\n1280\t        let mut s = make_state();\n1281\t        s.ecn_alpha = 256;\n1282\t        s.ecn_ect1 = 0;\n1283\t        s.ecn_ce = 0;\n1284\t        // delta_ce = 100, delta_ect1 = 900 → frac = 100*1024/1000 = 102\n1285\t        // frac (102) < alpha (256) → EWMA path\n1286\t        // alpha_shifted = 256 * 16 - 256 + 102 = 256*15 + 102 = 3840 + 102 = 3942\n1287\t        // new alpha = 3942 / 16 = 246\n1288\t        s.ecn_alpha_update_counts(900, 100);\n1289\t        assert_eq!(s.ecn_alpha, 246);\n1290\t    }\n1291\t\n1292\t    #[test]\n1293\t    fn ecn_alpha_only_ect1_delta() {\n1294\t        let mut s = make_state();\n1295\t        s.ecn_alpha = 200;\n1296\t        s.ecn_ect1 = 0;\n1297\t        s.ecn_ce = 0;\n1298\t        // delta_ect1 = 500, delta_ce = 0 → frac = 0\n1299\t        // frac (0) < alpha (200) → EWMA:\n1300\t        //   alpha_shifted = 200 << 4 = 3200; 3200 - 200 = 3000; 3000 + 0 = 3000\n1301\t        //   new alpha = 3000 >> 4 = 187\n1302\t        s.ecn_alpha_update_counts(500, 0);\n1303\t        assert_eq!(s.ecn_alpha, 187);\n1304\t    }\n1305\t}\n1306\t"}]},"parent_tool_use_id":null,"session_id":"c9215279-20c1-4a41-9599-fe6fc7f39608","uuid":"6024d3e3-04ff-474c-b2be-d572a657423c","timestamp":"2026-05-07T14:05:47.842Z","tool_use_result":{"type":"text","file":{"filePath":"/Users/richbarn/Projects/picoquic/rs/fq/src/c4.rs","content":"//! Translation of `picoquic/c4.c` — C4 congestion control.\n\nuse crate::cc_common::{ConnectionCc, PathCc, SMOOTHED_LOSS_FACTOR, SMOOTHED_LOSS_SCOPE};\nuse crate::internal::{CWIN_INITIAL, Connection, Path};\nuse crate::utils::{bytes_from_rate, rate_from_bytes};\nuse crate::{CongestionNotification, PacketContext, PerAckState, State};\n\n// ---------------------------------------------------------------------------\n// Constants from c4.c `#define`s.\n\nconst C4_ALPHA_PUSH_LOW_1024: u64 = 1088; // C: C4_ALPHA_PUSH_LOW_1024 (106.25%)\nconst C4_ALPHA_PUSH_VERY_LOW_1024: u64 = 1056; // C: C4_ALPHA_PUSH_VERY_LOW_1024 (103.125%)\nconst C4_ALPHA_PUSH_1024: u64 = 1280; // C: C4_ALPHA_PUSH_1024 (125%)\n/// 100%.  C: `C4_ALPHA_NEUTRAL_1024`.\nconst C4_ALPHA_NEUTRAL_1024: u64 = 1024;\n/// 87.50%.  C: `C4_ALPHA_RECOVER2_1024`.\nconst C4_ALPHA_RECOVER2_1024: u64 = 896;\n/// 100%.  C: `C4_ALPHA_CRUISE_1024`.\nconst C4_ALPHA_CRUISE_1024: u64 = 1024;\n/// 25% congestion back-off.  C: `C4_BETA_LOSS_1024`.\nconst C4_BETA_LOSS_1024: u64 = 256;\n/// Loss count before exiting initial.  C: `C4_NB_PACKETS_BEFORE_LOSS`.\nconst C4_NB_PACKETS_BEFORE_LOSS: u64 = 20;\n/// Cruise eras before attempting a push.  C: `C4_NB_CRUISE_BEFORE_PUSH`.\nconst C4_NB_CRUISE_BEFORE_PUSH: u64 = 4;\n/// RTT margin for CWIN buffer (15 ms).  C: `C4_RTT_MARGIN_DELAY`.\nconst C4_RTT_MARGIN_DELAY: u64 = 15_000;\n/// Minimum nominal max-RTT (1 ms).  C: `C4_MAX_RTT_MIN`.\nconst C4_MAX_RTT_MIN: u64 = 1_000;\n/// Max jitter cap on era max-RTT (250 ms).  C: `C4_MAX_JITTER`.\nconst C4_MAX_JITTER: u64 = 250_000;\n/// Maximum probe level before re-entering Initial.  C: `C4_PROBE_LEVEL_MAX`.\nconst C4_PROBE_LEVEL_MAX: i32 = 3;\n/// Push-alpha table indexed by probe level.  C: `c4_push_rate_by_probe_level`.\nconst C4_PUSH_RATE_BY_PROBE_LEVEL: [u64; 4] = [\n    C4_ALPHA_PUSH_VERY_LOW_1024,\n    C4_ALPHA_PUSH_LOW_1024,\n    C4_ALPHA_PUSH_1024,\n    C4_ALPHA_PUSH_1024,\n];\n/// Gain parameter for the ECN alpha EWMA: g = 1/2^4.  C: `C4_ECN_SHIFT_G`.\nconst C4_ECN_SHIFT_G: u32 = 4;\n/// Maximum delay threshold in microseconds (25 ms).  C: `C4_DELAY_THRESHOLD_MAX`.\nconst C4_DELAY_THRESHOLD_MAX: u64 = 25_000;\n/// Default probe level on entry to Initial.  C: `C4_PROBE_LEVEL_DEFAULT`.\nconst C4_PROBE_LEVEL_DEFAULT: i32 = 1;\n/// Alpha multiplier during Initial slow-start (200%).  C: `C4_ALPHA_INITIAL`.\nconst C4_ALPHA_INITIAL: u64 = 2048;\n/// Alpha multiplier during Recovery (93.75%).  C: `C4_ALPHA_RECOVER_1024`.\nconst C4_ALPHA_RECOVER_1024: u64 = 960;\n\n// ---------------------------------------------------------------------------\n// `MULT1024(c, v)` — fixed-point scale by c/1024.  C: `MULT1024`.\n\n#[inline]\nfn mult1024(c: u64, v: u64) -> u64 {\n    (v * c) >> 10\n}\n\n// ---------------------------------------------------------------------------\n// Algorithm-state enum.  C: `c4_alg_state_t`.\n\n#[derive(Debug, Copy, Clone, PartialEq, Eq, Default)]\npub enum C4AlgState {\n    #[default]\n    Initial = 0,\n    Recovery,\n    Cruising,\n    Pushing,\n}\n\n// ---------------------------------------------------------------------------\n// Congestion-event discriminant.  C: `c4_congestion_t`.\n\n#[derive(Debug, Copy, Clone, PartialEq, Eq, Default)]\npub enum C4Congestion {\n    #[default]\n    None = 0,\n    Delay,\n    Ecn,\n    Loss,\n}\n\n// ---------------------------------------------------------------------------\n// C4 algorithm state.  C: `c4_state_t` (picoquic/c4.c:143).\n//\n// Type deviations from C:\n//   * single-bit `unsigned int x : 1` bitfields → `bool`\n//   * `const char* option_string` → `Option<String>` (owned copy)\n\npub struct C4State {\n    pub alg_state: C4AlgState,\n    pub nominal_rate: u64,\n    pub nominal_max_rtt: u64,\n    pub initial_cwnd: u64,\n    pub running_min_rtt: u64,\n    pub alpha_1024_current: u64,\n    pub alpha_1024_previous: u64,\n    pub nb_packets_in_startup: u64,\n    pub era_sequence: u64,\n    pub nb_cruise_left_before_push: u64,\n    pub seed_cwin: u64,\n    pub seed_rate: u64,\n    pub probe_level: i32,\n    pub nb_eras_no_increase: i32,\n    pub push_rate_old: u64,\n    pub push_alpha: u64,\n    pub era_max_rtt: u64,\n    pub era_min_rtt: u64,\n    pub delay_threshold: u64,\n    pub recent_delay_excess: u64,\n    pub last_lost_packet_number: u64,\n    pub smoothed_drop_rate: f64,\n    pub ecn_alpha: u64,\n    pub ecn_ect1: u64,\n    pub ecn_ce: u64,\n    pub ecn_threshold: u64,\n    pub congestion_notified: bool,\n    pub push_was_not_limited: bool,\n    pub use_seed_cwin: bool,\n    pub initial_after_jitter: bool,\n    pub excess_ce_after_push: bool,\n    pub option_string: Option<String>,\n}\n\nimpl C4State {\n    /// C: `c4_sensitivity_1024` (picoquic/c4.c:244)\n    ///\n    /// Fixed-point sensitivity in [0, 1024] scaled to `nominal_rate`:\n    /// 0 below 50 kbps, 1024 above 10 Mbps, linearly interpolated in between.\n    fn sensitivity_1024(&self) -> u64 {\n        if self.nominal_rate < 50_000 {\n            0\n        } else if self.nominal_rate > 10_000_000 {\n            1024\n        } else if self.nominal_rate < 1_000_000 {\n            (self.nominal_rate - 50_000) * 963 / 950_000\n        } else {\n            963 + ((self.nominal_rate - 1_000_000) * 61 / 9_000_000)\n        }\n    }\n\n    /// C: `c4_growth_evaluate` (picoquic/c4.c:429)\n    ///\n    /// Returns `true` when the previous era produced meaningful throughput\n    /// growth.  If `push_alpha` was large enough to measure reliably, growth\n    /// is defined as exceeding the alpha-scaled old rate; otherwise it falls\n    /// back to a simple rate comparison guarded by the absence of congestion.\n    fn growth_evaluate(&self) -> bool {\n        if self.push_alpha > C4_ALPHA_PUSH_LOW_1024 {\n            let target_rate =\n                (3 * self.push_rate_old + mult1024(self.push_alpha, self.push_rate_old)) / 4;\n            self.nominal_rate > target_rate\n        } else {\n            self.nominal_rate > self.push_rate_old && !self.congestion_notified\n        }\n    }\n\n    /// C: `c4_growth_reset` (picoquic/c4.c:449)\n    fn growth_reset(&mut self) {\n        self.congestion_notified = false;\n        self.push_was_not_limited = false;\n        self.push_rate_old = self.nominal_rate;\n        // push_alpha is reset to current alpha here; caller sets it to correct\n        // value when entering push state.\n        self.push_alpha = self.alpha_1024_current;\n    }\n\n    /// C: `c4_set_options` (picoquic/c4.c:499)\n    ///\n    /// Parses `option_string` for recognized option characters.  No option\n    /// characters are currently defined; the loop exits on the first unknown.\n    fn set_options(&mut self) {\n        if let Some(s) = self.option_string.as_deref() {\n            // No recognized option characters are currently defined.  The C switch\n            // hits `default: ended = 1` for every character, so the loop exits\n            // immediately after consuming the first character.\n            let _ = s.chars().next();\n        }\n    }\n\n    /// C: `c4_seed_cwin` (picoquic/c4.c:527)\n    pub fn seed_cwin(&mut self, bytes_in_flight: u64) {\n        if self.alg_state == C4AlgState::Initial {\n            self.use_seed_cwin = true;\n            self.seed_cwin = bytes_in_flight;\n        }\n    }\n\n    /// C: `c4_observe` (picoquic/c4.c:1121)\n    ///\n    /// Returns `(cc_state, cc_param)`: the algorithm-state discriminant and\n    /// `nominal_max_rtt`, matching the C convention of filling two `uint64_t*`\n    /// out-params.\n    pub fn observe(&self) -> (u64, u64) {\n        (self.alg_state as u64, self.nominal_max_rtt)\n    }\n\n    /// C: `c4_update_loss_rate` (picoquic/c4.c:301)\n    ///\n    /// Advances the smoothed drop-rate EMA to account for packets up to and\n    /// including `lost_packet_number`.  Each step between the last recorded\n    /// loss and the new one decays the rate; the final step adds one loss\n    /// event.  Steps beyond `SMOOTHED_LOSS_SCOPE` behind the new number are\n    /// skipped to cap the decay loop.\n    pub fn update_loss_rate(&mut self, lost_packet_number: u64) {\n        let mut next_number = self.last_lost_packet_number;\n\n        if lost_packet_number > next_number {\n            if next_number + SMOOTHED_LOSS_SCOPE < lost_packet_number {\n                next_number = lost_packet_number - SMOOTHED_LOSS_SCOPE;\n            }\n\n            while next_number < lost_packet_number {\n                self.smoothed_drop_rate *= 1.0 - SMOOTHED_LOSS_FACTOR;\n                next_number += 1;\n            }\n\n            self.smoothed_drop_rate += (1.0 - self.smoothed_drop_rate) * SMOOTHED_LOSS_FACTOR;\n            self.last_lost_packet_number = lost_packet_number;\n        }\n    }\n\n    /// ECN alpha EWMA core.  C: `c4_update_ecn_alpha` (picoquic/c4.c:321) body.\n    ///\n    /// Takes the current totals directly so the logic can be tested without\n    /// constructing `Path` / `Connection`.  Called by `update_ecn_alpha`.\n    fn ecn_alpha_update_counts(&mut self, ecn_ect1_remote: u64, ecn_ce_remote: u64) {\n        let delta_ect1 = ecn_ect1_remote as i64 - self.ecn_ect1 as i64;\n        let delta_ce = ecn_ce_remote as i64 - self.ecn_ce as i64;\n\n        self.ecn_ect1 = ecn_ect1_remote;\n        self.ecn_ce = ecn_ce_remote;\n\n        if delta_ce > 0 || delta_ect1 > 0 {\n            let sum = delta_ce + delta_ect1;\n            let frac: u64 = if sum > 0 {\n                ((delta_ce * 1024) / sum) as u64\n            } else {\n                0\n            };\n\n            if frac > self.ecn_alpha && frac >= 512 {\n                self.ecn_alpha = frac;\n            } else {\n                // EWMA: alpha = alpha*(1 - 1/2^shift) + frac*(1/2^shift)\n                let alpha_shifted = (self.ecn_alpha << C4_ECN_SHIFT_G) - self.ecn_alpha + frac;\n                self.ecn_alpha = alpha_shifted >> C4_ECN_SHIFT_G;\n            }\n        }\n    }\n\n    /// C: `c4_delay_threshold` (picoquic/c4.c:266)\n    ///\n    /// Compute the delay threshold for declaring congestion.  Sensitivity\n    /// is 0 at ≤ 50 kbps, 1024 at ≥ 10 Mbps, and linearly interpolated\n    /// in between.  The resulting fraction scales `nominal_max_rtt`, giving\n    /// a threshold in [64/1024 × rtt, 260/1024 × rtt], capped at\n    /// [`C4_DELAY_THRESHOLD_MAX`] (25 ms).\n    pub fn delay_threshold(&self) -> u64 {\n        let sensitivity = self.sensitivity_1024();\n        let fraction = 64 + mult1024(1024 - sensitivity, 196);\n        let delay = mult1024(fraction, self.nominal_max_rtt);\n        delay.min(C4_DELAY_THRESHOLD_MAX)\n    }\n\n    /// C: `c4_update_ecn_alpha` (picoquic/c4.c:321)\n    ///\n    /// Selects the right packet context (path-scoped under multipath;\n    /// connection application context otherwise) and delegates to\n    /// `ecn_alpha_update_counts`.\n    #[allow(dead_code)]\n    pub(crate) fn update_ecn_alpha(&mut self, path_x: &Path, connection: &Connection) {\n        let pkt_ctx = if connection.is_multipath_enabled {\n            &path_x.pkt_ctx\n        } else {\n            &connection.pkt_ctx[PacketContext::Application as usize]\n        };\n        self.ecn_alpha_update_counts(pkt_ctx.ecn_ect1_total_remote, pkt_ctx.ecn_ce_total_remote);\n    }\n\n    /// C: `c4_ecn_threshold` (picoquic/c4.c:281)\n    ///\n    /// Computes the ECN marking fraction (over 1024) above which a CE-mark\n    /// event triggers congestion notification.  At low sensitivity the\n    /// threshold is high (~192/1024 ≈ 18.75%); at maximum sensitivity it\n    /// falls to ~96/1024 ≈ 9.375%.\n    pub fn ecn_threshold(&self) -> u64 {\n        let sensitivity = self.sensitivity_1024();\n        192 - mult1024(sensitivity, 96)\n    }\n\n    /// C: `c4_era_check` (picoquic/c4.c:463)\n    ///\n    /// Returns `true` when the current measurement era is complete: the\n    /// connection must be in the Ready state, and the lowest unacknowledged\n    /// sequence number must have advanced past `era_sequence`.\n    #[allow(dead_code)]\n    fn era_check(&self, path_x: &Path, connection: &Connection) -> bool {\n        if connection.connection_state < State::Ready {\n            return false;\n        }\n        path_x.lowest_not_ack() > self.era_sequence\n    }\n\n    /// C: `c4_era_reset` (picoquic/c4.c:475)\n    ///\n    /// Begins a new measurement era: advances `era_sequence` to the current\n    /// send sequence number, resets per-era RTT accumulators, snapshots\n    /// `alpha_1024_current` into `alpha_1024_previous`, and updates the ECN\n    /// alpha from the latest packet-context counters.\n    #[allow(dead_code)]\n    fn era_reset(&mut self, path_x: &Path, connection: &Connection) {\n        self.era_sequence = connection.sequence_number(path_x);\n        self.era_max_rtt = 0;\n        self.era_min_rtt = u64::MAX;\n        self.alpha_1024_previous = self.alpha_1024_current;\n        self.update_ecn_alpha(path_x, connection);\n    }\n\n    /// C: `c4_enter_initial` (picoquic/c4.c:486)\n    ///\n    /// Transitions to the Initial (slow-start) state: captures the current\n    /// CWIN, sets probe level and alpha to their startup defaults, resets era\n    /// and growth tracking, and zeroes the ECN alpha.\n    #[allow(dead_code)]\n    fn enter_initial(&mut self, path_x: &Path, connection: &Connection) {\n        self.alg_state = C4AlgState::Initial;\n        self.initial_cwnd = path_x.cwin;\n        self.probe_level = C4_PROBE_LEVEL_DEFAULT;\n        self.alpha_1024_current = C4_ALPHA_INITIAL;\n        self.nb_packets_in_startup = 0;\n        self.era_reset(path_x, connection);\n        self.nb_eras_no_increase = 0;\n        self.ecn_alpha = 0;\n        self.growth_reset();\n    }\n\n    /// C: `c4_enter_recovery` (picoquic/c4.c:649)\n    ///\n    /// Transitions to the Recovery state.  If entering from Initial, first\n    /// calls `growth_reset` so the growth comparison starts from a clean\n    /// baseline.  Multiple simultaneous congestion signals are collapsed: if\n    /// already in Recovery this is a no-op.\n    fn enter_recovery(&mut self, path_x: &Path, connection: &Connection, c_mode: C4Congestion) {\n        if self.alg_state == C4AlgState::Initial {\n            self.growth_reset();\n        }\n        if self.alg_state != C4AlgState::Recovery {\n            self.excess_ce_after_push = c_mode == C4Congestion::Ecn;\n            self.alg_state = C4AlgState::Recovery;\n            self.era_reset(path_x, connection);\n            self.alpha_1024_current = C4_ALPHA_RECOVER_1024;\n        }\n    }\n\n    /// C: `c4_loss_threshold` (picoquic/c4.c:290)\n    ///\n    /// Returns the smoothed-loss-rate threshold above which a loss event\n    /// triggers a congestion notification.  Ranges from ~52% at low rates\n    /// (sensitivity ≈ 0) to ~2% at maximum sensitivity.\n    pub fn loss_threshold(&self) -> f64 {\n        let sensitivity = self.sensitivity_1024();\n        let fraction = sensitivity as f64 / 1024.0;\n        0.02 + 0.50 * (1.0 - fraction)\n    }\n\n    /// C: `c4_enter_cruise` (picoquic/c4.c:715)\n    ///\n    /// Transitions to the Cruising state.  Resets the era, clears the seed\n    /// CWIN flag, calculates how many cruise eras remain before the next\n    /// push, and sets `alpha_1024_current`.  For very low-RTT paths (< 1 ms)\n    /// pacing is loosened by an extra 48/1024 ≈ 4.7%.\n    fn enter_cruise(&mut self, path_x: &mut Path, connection: &Connection) {\n        self.era_reset(path_x, connection);\n        self.use_seed_cwin = false;\n\n        if self.probe_level > C4_PROBE_LEVEL_DEFAULT {\n            self.nb_cruise_left_before_push = 0;\n        } else if self.nb_cruise_left_before_push == 0 {\n            self.nb_cruise_left_before_push = if self.probe_level == 0 {\n                1\n            } else {\n                C4_NB_CRUISE_BEFORE_PUSH\n            };\n        }\n\n        self.alpha_1024_current = C4_ALPHA_CRUISE_1024;\n        if path_x.smoothed_rtt.ticks() < C4_MAX_RTT_MIN {\n            self.alpha_1024_current += 48;\n        }\n        self.alg_state = C4AlgState::Cruising;\n    }\n\n    /// C: `c4_exit_initial` (picoquic/c4.c:535)\n    ///\n    /// Exits the Initial slow-start phase.  Derives `nominal_max_rtt` from\n    /// the half-CWIN / rate ratio, clamps it to `C4_MAX_RTT_MIN`, updates\n    /// the delay threshold, resets era counters, and enters Recovery with no\n    /// congestion signal (used as the first cruise entry point).\n    fn exit_initial(&mut self, path_x: &mut Path, connection: &Connection) {\n        if self.nominal_rate > 0 {\n            let ssthresh = self.initial_cwnd / 2;\n            self.nominal_max_rtt = ssthresh * 1_000_000 / self.nominal_rate;\n            if self.nominal_max_rtt < C4_MAX_RTT_MIN {\n                self.nominal_max_rtt = C4_MAX_RTT_MIN;\n            }\n            self.delay_threshold = self.delay_threshold();\n            self.nb_eras_no_increase = 0;\n            self.probe_level = C4_PROBE_LEVEL_DEFAULT;\n            self.enter_recovery(path_x, connection, C4Congestion::None);\n        }\n    }\n\n    /// C: `c4_exit_recovery` (picoquic/c4.c:674)\n    ///\n    /// Exits Recovery.  Evaluates whether the previous push produced growth\n    /// and adjusts `probe_level` accordingly: successful growth increments it\n    /// (unless ECN excess was flagged); a rate-limited failure resets it to 1\n    /// (0 under ECN excess).  After resetting growth tracking and clearing\n    /// transient state, transitions to Initial if probe_level has exceeded the\n    /// maximum, or to Cruising otherwise.\n    fn exit_recovery(&mut self, path_x: &mut Path, connection: &Connection) {\n        let is_growing = self.growth_evaluate();\n        if is_growing {\n            if !self.excess_ce_after_push {\n                self.probe_level += 1;\n            }\n        } else if self.push_was_not_limited {\n            self.probe_level = 1;\n            if self.excess_ce_after_push {\n                self.probe_level = 0;\n            }\n        }\n        self.growth_reset();\n        self.recent_delay_excess = 0;\n        self.smoothed_drop_rate = 0.0;\n        self.ecn_alpha = 0;\n\n        if self.probe_level > C4_PROBE_LEVEL_MAX {\n            self.enter_initial(path_x, connection);\n        } else {\n            self.enter_cruise(path_x, connection);\n        }\n    }\n\n    /// C: `c4_initial_handle_ack` (picoquic/c4.c:576)\n    ///\n    /// Handles an ACK during Initial slow-start.  Grows `initial_cwnd` by the\n    /// bytes acknowledged (with a right-shift damper proportional to how many\n    /// eras without rate increase have been observed — similar to HyStart++).\n    /// At each era boundary, checks whether growth is still happening; if not,\n    /// increments `nb_eras_no_increase`.  After three eras without growth,\n    /// or immediately if the seed-rate has been validated, exits Initial.\n    fn initial_handle_ack(\n        &mut self,\n        path_x: &mut Path,\n        connection: &Connection,\n        ack_state: &PerAckState,\n    ) {\n        self.nb_packets_in_startup += 1;\n        self.initial_cwnd +=\n            ack_state.nb_bytes_acknowledged >> (3 * self.nb_eras_no_increase as u32);\n        if self.use_seed_cwin && self.seed_rate > 0 && self.nominal_rate >= self.seed_rate {\n            self.use_seed_cwin = false;\n        }\n        if self.era_check(path_x, connection) {\n            let is_growing = self.growth_evaluate();\n            if is_growing {\n                self.nb_eras_no_increase = 0;\n            } else if self.push_was_not_limited && self.nominal_rate > 0 {\n                self.nb_eras_no_increase += 1;\n            }\n            self.era_reset(path_x, connection);\n            if self.nb_eras_no_increase >= 3 {\n                self.exit_initial(path_x, connection);\n            } else {\n                self.growth_reset();\n            }\n        }\n    }\n\n    /// C: `c4_apply_rate_and_cwin` (picoquic/c4.c:359)\n    ///\n    /// Computes and applies the pacing rate and CWIN from the current alpha\n    /// and nominal-rate parameters.  In Initial state the CWIN is floored to\n    /// `initial_cwnd` and may incorporate the seed CWIN or peak bandwidth\n    /// estimate.  In other states an RTT-margin buffer and an extra Pushing\n    /// padding are added.\n    fn apply_rate_and_cwin(&mut self, path_x: &mut Path) {\n        let mut pacing_rate = mult1024(self.alpha_1024_current, self.nominal_rate);\n        let mut target_cwin = CWIN_INITIAL;\n        if self.nominal_max_rtt != 0 && self.nominal_rate != 0 {\n            target_cwin = bytes_from_rate(self.nominal_max_rtt, pacing_rate);\n        }\n\n        if self.alg_state == C4AlgState::Initial {\n            if target_cwin < self.initial_cwnd {\n                target_cwin = self.initial_cwnd;\n            }\n            if self.nb_packets_in_startup > 0 && path_x.peak_bandwidth_estimate > pacing_rate {\n                pacing_rate = (pacing_rate + path_x.peak_bandwidth_estimate) / 2;\n                let min_win =\n                    bytes_from_rate(path_x.smoothed_rtt.ticks(), path_x.peak_bandwidth_estimate)\n                        / 2;\n                if min_win > target_cwin {\n                    target_cwin = min_win;\n                }\n            }\n            if self.use_seed_cwin && self.seed_cwin > target_cwin {\n                target_cwin = (self.seed_cwin + target_cwin) / 2;\n                self.seed_rate = rate_from_bytes(self.seed_cwin, path_x.smoothed_rtt.ticks());\n                if self.seed_rate > pacing_rate {\n                    pacing_rate = self.seed_rate;\n                }\n            }\n            self.initial_cwnd = target_cwin;\n        } else {\n            let delta_rtt_target = if self.nominal_max_rtt < 4 * C4_RTT_MARGIN_DELAY {\n                self.nominal_max_rtt / 4\n            } else {\n                C4_RTT_MARGIN_DELAY\n            };\n            target_cwin += bytes_from_rate(delta_rtt_target, pacing_rate);\n\n            if self.alg_state == C4AlgState::Pushing {\n                let delta_alpha = self.alpha_1024_current.saturating_sub(1024);\n                let delta_rate = mult1024(delta_alpha, self.nominal_rate);\n                let delta_cwin = bytes_from_rate(self.nominal_max_rtt, delta_rate);\n                if delta_cwin < path_x.send_mtu as u64 {\n                    target_cwin += path_x.send_mtu as u64 - delta_cwin;\n                }\n            }\n        }\n\n        path_x.cwin = target_cwin;\n        let mut quantum = mult1024(4, pacing_rate);\n        if quantum > 0x10000 {\n            quantum = 0x10000;\n        } else if quantum < 2 * path_x.send_mtu as u64 {\n            quantum = 2 * path_x.send_mtu as u64;\n        }\n        path_x.update_pacing_rate(pacing_rate as f64, quantum);\n    }\n\n    /// C: `c4_notify_congestion` (picoquic/c4.c:893)\n    ///\n    /// Reacts to a congestion event (delay, ECN, or loss) by computing a\n    /// `beta` back-off fraction, reducing `nominal_rate` and optionally\n    /// `nominal_max_rtt`, then entering Recovery.  Congestion signals arriving\n    /// while already in Recovery tighten `alpha_1024_current` further rather\n    /// than re-entering.\n    fn notify_congestion(\n        &mut self,\n        path_x: &mut Path,\n        connection: &Connection,\n        c_mode: C4Congestion,\n    ) {\n        let mut beta = C4_BETA_LOSS_1024;\n        self.congestion_notified = true;\n\n        if c_mode == C4Congestion::Loss {\n            beta = (C4_BETA_LOSS_1024 + mult1024(self.sensitivity_1024(), C4_BETA_LOSS_1024)) / 2;\n        } else if c_mode == C4Congestion::Ecn {\n            if self.ecn_threshold > 0 {\n                beta = (self.ecn_alpha - self.ecn_threshold) * 1024 / self.ecn_threshold;\n            }\n            if beta > C4_BETA_LOSS_1024 {\n                beta = C4_BETA_LOSS_1024;\n            }\n        }\n\n        if c_mode == C4Congestion::Delay {\n            if self.delay_threshold > 0 {\n                beta = self.recent_delay_excess * 1024 / self.delay_threshold;\n            }\n            if beta > C4_BETA_LOSS_1024 {\n                beta = C4_BETA_LOSS_1024;\n            }\n        } else {\n            self.recent_delay_excess = 0;\n        }\n\n        if self.alg_state == C4AlgState::Recovery {\n            if self.alpha_1024_current == C4_ALPHA_RECOVER_1024 {\n                self.alpha_1024_current = C4_ALPHA_RECOVER2_1024;\n                self.era_sequence = connection.sequence_number(path_x);\n                c4_logger(path_x, 0, self, None, beta, c_mode);\n            }\n            if c_mode == C4Congestion::Ecn {\n                self.excess_ce_after_push = true;\n            }\n        } else {\n            if self.alg_state != C4AlgState::Pushing {\n                self.nominal_rate -= mult1024(beta, self.nominal_rate);\n                if c_mode == C4Congestion::Loss {\n                    self.nominal_max_rtt -= mult1024(beta, self.nominal_max_rtt);\n                    if self.nominal_max_rtt < C4_MAX_RTT_MIN {\n                        self.nominal_max_rtt = C4_MAX_RTT_MIN;\n                    }\n                    self.delay_threshold = self.delay_threshold();\n                }\n                c4_logger(path_x, 0, self, None, beta, c_mode);\n            }\n            self.enter_recovery(path_x, connection, c_mode);\n        }\n\n        self.apply_rate_and_cwin(path_x);\n        path_x.is_ssthresh_initialized = true;\n    }\n\n    /// C: `c4_initial_handle_loss` (picoquic/c4.c:568)\n    ///\n    /// Counts a loss event during Initial and exits Initial once\n    /// `C4_NB_PACKETS_BEFORE_LOSS` losses have been seen.\n    fn initial_handle_loss(&mut self, path_x: &mut Path, connection: &Connection) {\n        self.nb_packets_in_startup += 1;\n        if self.nb_packets_in_startup > C4_NB_PACKETS_BEFORE_LOSS {\n            self.exit_initial(path_x, connection);\n        }\n    }\n\n    /// C: `c4_update_rtt` (picoquic/c4.c:976)\n    ///\n    /// Updates per-era RTT accumulators and the running min-RTT from a new\n    /// RTT sample.  If `nominal_max_rtt` has not been set yet, initialises it\n    /// and the delay threshold.  Otherwise computes `recent_delay_excess` as\n    /// how far the sample exceeds `nominal_max_rtt + delay_threshold`.\n    fn update_rtt(&mut self, rtt_measurement: u64) {\n        if rtt_measurement > self.era_max_rtt {\n            self.era_max_rtt = rtt_measurement;\n        }\n        if rtt_measurement < self.era_min_rtt {\n            self.era_min_rtt = rtt_measurement;\n        }\n        if rtt_measurement < self.running_min_rtt {\n            self.running_min_rtt = rtt_measurement;\n        }\n        if self.nominal_max_rtt == 0 {\n            self.nominal_max_rtt = rtt_measurement;\n            if self.nominal_max_rtt < C4_MAX_RTT_MIN {\n                self.nominal_max_rtt = C4_MAX_RTT_MIN;\n            }\n            self.delay_threshold = self.delay_threshold();\n            self.recent_delay_excess = 0;\n        } else {\n            let target_rtt = self.nominal_max_rtt + self.delay_threshold;\n            if rtt_measurement > target_rtt {\n                self.recent_delay_excess = rtt_measurement - target_rtt;\n            } else {\n                self.recent_delay_excess = 0;\n            }\n        }\n    }\n\n    /// C: `c4_initial_handle_rtt_excess` (picoquic/c4.c:551)\n    ///\n    /// HyStart-style RTT-increase detector during Initial.  Exits Initial\n    /// when delay excess has been seen, at least two eras without increase\n    /// have elapsed, and the rate has not grown above the previous era's rate.\n    fn initial_handle_rtt_excess(&mut self, path_x: &mut Path, connection: &Connection) {\n        if self.recent_delay_excess > 0\n            && self.nb_eras_no_increase > 1\n            && self.push_rate_old >= self.nominal_rate\n        {\n            self.exit_initial(path_x, connection);\n        }\n    }\n\n    /// C: `c4_handle_rtt_excess` (picoquic/c4.c:1008)\n    ///\n    /// Fires a delay-congestion notification when a delay excess was observed\n    /// during a period where alpha was above neutral (i.e. we were probing).\n    fn handle_rtt_excess(&mut self, path_x: &mut Path, connection: &Connection) {\n        if self.recent_delay_excess > 0 && self.alpha_1024_previous > 1024 {\n            self.notify_congestion(path_x, connection, C4Congestion::Delay);\n        }\n    }\n\n    /// C: `c4_update_min_max_rtt` (picoquic/c4.c:756)\n    ///\n    /// Updates `running_min_rtt`, `nominal_max_rtt`, and `delay_threshold`\n    /// from the era's min/max RTT samples.  Only applied when\n    /// `alpha_1024_previous ≤ C4_ALPHA_NEUTRAL_1024` so that measurements\n    /// taken during a push period don't corrupt the baseline.  A corrected max\n    /// is capped at `running_min_rtt + C4_MAX_JITTER` to limit jitter impact.\n    fn update_min_max_rtt(&mut self, path_x: &Path) {\n        let rtt_sample = path_x.rtt_sample.ticks();\n        if rtt_sample > self.era_max_rtt {\n            self.era_max_rtt = rtt_sample;\n        }\n        if rtt_sample < self.era_min_rtt {\n            self.era_min_rtt = rtt_sample;\n        }\n        if self.alpha_1024_previous <= C4_ALPHA_NEUTRAL_1024 {\n            if self.era_min_rtt < self.running_min_rtt {\n                self.running_min_rtt = self.era_min_rtt;\n            } else {\n                self.running_min_rtt = (7 * self.running_min_rtt + self.era_min_rtt) / 8;\n            }\n\n            let corrected_max = if self.era_max_rtt < self.running_min_rtt + C4_MAX_JITTER {\n                self.era_max_rtt\n            } else {\n                self.running_min_rtt + C4_MAX_JITTER\n            };\n\n            if corrected_max > self.nominal_max_rtt {\n                self.nominal_max_rtt = corrected_max;\n            } else {\n                self.nominal_max_rtt = (7 * self.nominal_max_rtt + corrected_max) / 8;\n            }\n            self.delay_threshold = self.delay_threshold();\n        } else if self.nominal_max_rtt == 0 {\n            self.nominal_max_rtt = self.era_max_rtt;\n            self.delay_threshold = self.delay_threshold();\n        }\n\n        if self.nominal_max_rtt < C4_MAX_RTT_MIN {\n            self.nominal_max_rtt = C4_MAX_RTT_MIN;\n            self.delay_threshold = self.delay_threshold();\n        }\n    }\n\n    /// C: `c4_enter_push` (picoquic/c4.c:746)\n    ///\n    /// Transitions to the Pushing state, setting alpha from the probe-level\n    /// table, snapshotting that alpha into `push_alpha`, and resetting the era.\n    fn enter_push(&mut self, path_x: &mut Path, connection: &Connection) {\n        let level = self.probe_level.clamp(0, C4_PROBE_LEVEL_MAX) as usize;\n        self.alpha_1024_current = C4_PUSH_RATE_BY_PROBE_LEVEL[level];\n        self.push_alpha = self.alpha_1024_current;\n        self.era_reset(path_x, connection);\n        self.alg_state = C4AlgState::Pushing;\n    }\n\n    /// C: `c4_handle_ack` (picoquic/c4.c:804)\n    ///\n    /// Processes an acknowledgement: updates `nominal_rate` from the bandwidth\n    /// estimate, sets `push_was_not_limited` when delivery was not\n    /// application-limited, then advances the state machine at each era\n    /// boundary (exit recovery → cruise → push → recovery cycle).\n    fn handle_ack(&mut self, path_x: &mut Path, connection: &Connection, ack_state: &PerAckState) {\n        let previous_rate = self.nominal_rate;\n\n        if ack_state.rtt_measurement.ticks() > 0\n            && ack_state.nb_bytes_delivered_since_packet_sent > 0\n        {\n            let rate_measurement = path_x.bandwidth_estimate;\n            c4_logger(\n                path_x,\n                rate_measurement,\n                self,\n                Some(ack_state),\n                0,\n                C4Congestion::None,\n            );\n\n            if rate_measurement > self.nominal_rate\n                && !(self.alg_state == C4AlgState::Recovery && self.congestion_notified)\n            {\n                self.push_was_not_limited = true;\n                self.nominal_rate = rate_measurement;\n                self.delay_threshold = self.delay_threshold();\n            } else {\n                let target_cwin = bytes_from_rate(self.running_min_rtt, previous_rate);\n                if ack_state.nb_bytes_delivered_since_packet_sent > target_cwin {\n                    self.push_was_not_limited = true;\n                }\n            }\n        }\n\n        if self.alg_state == C4AlgState::Initial {\n            self.initial_handle_ack(path_x, connection, ack_state);\n        } else if self.era_check(path_x, connection) {\n            self.update_min_max_rtt(path_x);\n            // Check whether jitter/competition warrants re-entering Initial.\n            if !self.initial_after_jitter\n                && self.nominal_max_rtt > 50_000\n                && self.nominal_rate < 1_000_000\n                && 5 * self.running_min_rtt < 2 * self.nominal_max_rtt\n            {\n                self.initial_after_jitter = true;\n                self.enter_initial(path_x, connection);\n            } else {\n                match self.alg_state {\n                    C4AlgState::Recovery => {\n                        self.exit_recovery(path_x, connection);\n                    }\n                    C4AlgState::Cruising => {\n                        if self.nb_cruise_left_before_push > 0 {\n                            self.nb_cruise_left_before_push -= 1;\n                        }\n                        self.era_reset(path_x, connection);\n                        if self.nb_cruise_left_before_push == 0\n                            && path_x.last_time_acked_data_frame_sent\n                                > path_x.last_sender_limited_time\n                        {\n                            self.enter_push(path_x, connection);\n                        }\n                    }\n                    C4AlgState::Pushing => {\n                        self.enter_recovery(path_x, connection, C4Congestion::None);\n                    }\n                    _ => {\n                        self.era_reset(path_x, connection);\n                    }\n                }\n            }\n        }\n    }\n\n    /// C: `c4_reset` (picoquic/c4.c:517)\n    ///\n    /// Zeroes the C4 state (preserving `option_string`), then re-initialises\n    /// via `enter_initial`.  Called on algorithm reset notifications and during\n    /// `c4_init`.\n    fn reset(&mut self, path_x: &mut Path, connection: &Connection) {\n        let option_string = self.option_string.take();\n        // Zero all fields.\n        *self = C4State {\n            alg_state: C4AlgState::default(),\n            nominal_rate: 0,\n            nominal_max_rtt: 0,\n            initial_cwnd: 0,\n            running_min_rtt: u64::MAX,\n            alpha_1024_current: C4_ALPHA_INITIAL,\n            alpha_1024_previous: 0,\n            nb_packets_in_startup: 0,\n            era_sequence: 0,\n            nb_cruise_left_before_push: 0,\n            seed_cwin: 0,\n            seed_rate: 0,\n            probe_level: 0,\n            nb_eras_no_increase: 0,\n            push_rate_old: 0,\n            push_alpha: 0,\n            era_max_rtt: 0,\n            era_min_rtt: 0,\n            delay_threshold: 0,\n            recent_delay_excess: 0,\n            last_lost_packet_number: 0,\n            smoothed_drop_rate: 0.0,\n            ecn_alpha: 0,\n            ecn_ect1: 0,\n            ecn_ce: 0,\n            ecn_threshold: 0,\n            congestion_notified: false,\n            push_was_not_limited: false,\n            use_seed_cwin: false,\n            initial_after_jitter: false,\n            excess_ce_after_push: false,\n            option_string,\n        };\n        self.set_options();\n        self.enter_initial(path_x, connection);\n    }\n\n    /// C: `c4_notify` (picoquic/c4.c:1025)\n    ///\n    /// Main congestion-control notification dispatch.  Sets `is_cc_data_updated`,\n    /// filters non-application packet contexts, then routes the notification to\n    /// the appropriate handler.\n    pub fn notify(\n        &mut self,\n        connection: &Connection,\n        path_x: &mut Path,\n        notification: CongestionNotification,\n        ack_state: Option<&PerAckState>,\n        _current_time: u64,\n    ) {\n        path_x.is_cc_data_updated = true;\n\n        if let Some(a) = ack_state\n            && a.pc != PacketContext::Application as i32\n        {\n            return;\n        }\n\n        match notification {\n            CongestionNotification::Acknowledgement => {\n                if let Some(a) = ack_state {\n                    self.handle_ack(path_x, connection, a);\n                }\n                self.apply_rate_and_cwin(path_x);\n            }\n            CongestionNotification::EcnEc => {\n                self.ecn_threshold = self.ecn_threshold();\n                self.update_ecn_alpha(path_x, connection);\n                if self.ecn_alpha > self.ecn_threshold {\n                    if self.alg_state == C4AlgState::Initial {\n                        if self.recent_delay_excess > 0\n                            && self.nb_eras_no_increase > 1\n                            && self.push_rate_old >= self.nominal_rate\n                        {\n                            self.exit_initial(path_x, connection);\n                        }\n                    } else {\n                        self.notify_congestion(path_x, connection, C4Congestion::Ecn);\n                    }\n                }\n            }\n            CongestionNotification::Repeat => {\n                if let Some(a) = ack_state {\n                    if self.alg_state == C4AlgState::Recovery\n                        && a.lost_packet_number < self.era_sequence\n                    {\n                        return;\n                    }\n                    self.update_loss_rate(a.lost_packet_number);\n                    if self.smoothed_drop_rate > self.loss_threshold() {\n                        if self.alg_state == C4AlgState::Initial {\n                            self.initial_handle_loss(path_x, connection);\n                        } else {\n                            self.notify_congestion(path_x, connection, C4Congestion::Loss);\n                        }\n                    }\n                }\n            }\n            CongestionNotification::Timeout => {}\n            CongestionNotification::SpuriousRepeat => {}\n            CongestionNotification::RttMeasurement => {\n                if let Some(a) = ack_state {\n                    self.update_rtt(a.rtt_measurement.ticks());\n                    if self.alg_state == C4AlgState::Initial {\n                        self.initial_handle_rtt_excess(path_x, connection);\n                        self.apply_rate_and_cwin(path_x);\n                    } else {\n                        self.handle_rtt_excess(path_x, connection);\n                    }\n                }\n            }\n            CongestionNotification::LostFeedback => {}\n            CongestionNotification::CwinBlocked => {}\n            CongestionNotification::Reset => {\n                self.reset(path_x, connection);\n            }\n            CongestionNotification::SeedCwin => {\n                if let Some(a) = ack_state {\n                    self.seed_cwin(a.nb_bytes_acknowledged);\n                }\n            }\n        }\n    }\n}\n\n/// C: `c4_logger` (picoquic/c4.c:199)\n///\n/// Emits a diagnostic log line with the current C4 rate-control parameters.\n/// In C this is gated by `C4_WITH_LOGGING`; in Rust it always compiles and\n/// emits at `log::debug` level (no-cost when the log level is above debug).\npub fn c4_logger(\n    path_x: &Path,\n    rate_measurement: u64,\n    c4_state: &C4State,\n    ack_state: Option<&PerAckState>,\n    beta: u64,\n    congestion_mode: C4Congestion,\n) {\n    log::debug!(\n        \"C4_rate, {},{},{},{},{},{},{},{},{},{},{},{},{},{},{}\",\n        rate_measurement,\n        c4_state.nominal_rate,\n        ack_state.map_or(0, |a| a.nb_bytes_delivered_since_packet_sent),\n        ack_state.map_or(0, |a| a.rtt_measurement.ticks()),\n        ack_state.map_or(0, |a| a.send_delay.ticks()),\n        c4_state.nominal_max_rtt,\n        c4_state.alg_state as u64,\n        path_x.bandwidth_estimate,\n        path_x.bytes_in_transit,\n        beta,\n        congestion_mode as u64,\n        c4_state.ecn_alpha,\n        path_x.smoothed_rtt.ticks(),\n        path_x.rtt_variant.ticks(),\n        c4_state.alpha_1024_previous,\n    );\n}\n\n#[cfg(test)]\nmod tests {\n    use super::*;\n\n    fn make_state() -> C4State {\n        C4State {\n            alg_state: C4AlgState::default(),\n            nominal_rate: 0,\n            nominal_max_rtt: 0,\n            initial_cwnd: 0,\n            running_min_rtt: 0,\n            alpha_1024_current: 0,\n            alpha_1024_previous: 0,\n            nb_packets_in_startup: 0,\n            era_sequence: 0,\n            nb_cruise_left_before_push: 0,\n            seed_cwin: 0,\n            seed_rate: 0,\n            probe_level: 0,\n            nb_eras_no_increase: 0,\n            push_rate_old: 0,\n            push_alpha: 0,\n            era_max_rtt: 0,\n            era_min_rtt: 0,\n            delay_threshold: 0,\n            recent_delay_excess: 0,\n            last_lost_packet_number: 0,\n            smoothed_drop_rate: 0.0,\n            ecn_alpha: 0,\n            ecn_ect1: 0,\n            ecn_ce: 0,\n            ecn_threshold: 0,\n            congestion_notified: false,\n            push_was_not_limited: false,\n            use_seed_cwin: false,\n            initial_after_jitter: false,\n            excess_ce_after_push: false,\n            option_string: None,\n        }\n    }\n\n    #[test]\n    fn growth_evaluate_high_alpha_growing() {\n        let mut s = make_state();\n        // push_alpha > 1088, push_rate_old = 1000, nominal_rate must exceed:\n        // target = (3*1000 + MULT1024(1280, 1000)) / 4 = (3000 + 1250) / 4 = 1062\n        s.push_alpha = 1280;\n        s.push_rate_old = 1000;\n        s.nominal_rate = 1100;\n        assert!(s.growth_evaluate());\n    }\n\n    #[test]\n    fn growth_evaluate_high_alpha_not_growing() {\n        let mut s = make_state();\n        s.push_alpha = 1280;\n        s.push_rate_old = 1000;\n        s.nominal_rate = 1000; // equal to target_rate or below\n        assert!(!s.growth_evaluate());\n    }\n\n    #[test]\n    fn growth_evaluate_low_alpha_growing_no_congestion() {\n        let mut s = make_state();\n        s.push_alpha = 1000; // <= 1088\n        s.push_rate_old = 800;\n        s.nominal_rate = 900;\n        s.congestion_notified = false;\n        assert!(s.growth_evaluate());\n    }\n\n    #[test]\n    fn growth_evaluate_low_alpha_congestion_blocks_growth() {\n        let mut s = make_state();\n        s.push_alpha = 1000;\n        s.push_rate_old = 800;\n        s.nominal_rate = 900;\n        s.congestion_notified = true;\n        assert!(!s.growth_evaluate());\n    }\n\n    // --- sensitivity_1024 ---\n\n    #[test]\n    fn sensitivity_below_50k() {\n        let mut s = make_state();\n        s.nominal_rate = 49_999;\n        assert_eq!(s.sensitivity_1024(), 0);\n    }\n\n    #[test]\n    fn sensitivity_at_50k_boundary() {\n        let mut s = make_state();\n        s.nominal_rate = 50_000;\n        // (50000 - 50000) * 963 / 950000 == 0\n        assert_eq!(s.sensitivity_1024(), 0);\n    }\n\n    #[test]\n    fn sensitivity_midrange() {\n        let mut s = make_state();\n        s.nominal_rate = 500_000;\n        // (500000 - 50000) * 963 / 950000 = 450000 * 963 / 950000 = 456\n        assert_eq!(s.sensitivity_1024(), 456);\n    }\n\n    #[test]\n    fn sensitivity_at_1mbps() {\n        let mut s = make_state();\n        s.nominal_rate = 1_000_000;\n        // hits else branch: 963 + (0 * 61 / 9000000) = 963\n        assert_eq!(s.sensitivity_1024(), 963);\n    }\n\n    #[test]\n    fn sensitivity_at_10mbps() {\n        let mut s = make_state();\n        s.nominal_rate = 10_000_000;\n        // 963 + (9000000 * 61 / 9000000) = 963 + 61 = 1024\n        assert_eq!(s.sensitivity_1024(), 1024);\n    }\n\n    #[test]\n    fn sensitivity_above_10mbps() {\n        let mut s = make_state();\n        s.nominal_rate = 10_000_001;\n        assert_eq!(s.sensitivity_1024(), 1024);\n    }\n\n    // --- growth_reset ---\n\n    #[test]\n    fn growth_reset_clears_flags_and_snapshots() {\n        let mut s = make_state();\n        s.nominal_rate = 5_000_000;\n        s.alpha_1024_current = 1100;\n        s.congestion_notified = true;\n        s.push_was_not_limited = true;\n        s.push_rate_old = 1_000_000;\n        s.push_alpha = 900;\n\n        s.growth_reset();\n\n        assert!(!s.congestion_notified);\n        assert!(!s.push_was_not_limited);\n        assert_eq!(s.push_rate_old, 5_000_000);\n        assert_eq!(s.push_alpha, 1100);\n    }\n\n    // --- set_options ---\n\n    #[test]\n    fn set_options_none_is_noop() {\n        let mut s = make_state();\n        s.option_string = None;\n        s.set_options(); // must not panic\n    }\n\n    #[test]\n    fn set_options_unknown_chars_are_noop() {\n        let mut s = make_state();\n        s.option_string = Some(\"xyz\".to_owned());\n        s.set_options(); // must not panic; no state change expected\n    }\n\n    // --- seed_cwin ---\n\n    #[test]\n    fn seed_cwin_sets_when_initial() {\n        let mut s = make_state();\n        s.alg_state = C4AlgState::Initial;\n        s.seed_cwin(123_456);\n        assert!(s.use_seed_cwin);\n        assert_eq!(s.seed_cwin, 123_456);\n    }\n\n    #[test]\n    fn seed_cwin_ignored_when_not_initial() {\n        let mut s = make_state();\n        s.alg_state = C4AlgState::Cruising;\n        s.seed_cwin(123_456);\n        assert!(!s.use_seed_cwin);\n        assert_eq!(s.seed_cwin, 0);\n    }\n\n    // --- observe ---\n\n    #[test]\n    fn observe_returns_state_and_rtt() {\n        let mut s = make_state();\n        s.alg_state = C4AlgState::Pushing;\n        s.nominal_max_rtt = 42_000;\n        let (cc_state, cc_param) = s.observe();\n        assert_eq!(cc_state, C4AlgState::Pushing as u64);\n        assert_eq!(cc_param, 42_000);\n    }\n\n    #[test]\n    fn observe_initial_state() {\n        let s = make_state();\n        let (cc_state, cc_param) = s.observe();\n        assert_eq!(cc_state, 0); // C4AlgState::Initial == 0\n        assert_eq!(cc_param, 0);\n    }\n\n    // --- update_loss_rate ---\n\n    #[test]\n    fn loss_rate_no_update_when_not_newer() {\n        let mut s = make_state();\n        s.last_lost_packet_number = 100;\n        s.smoothed_drop_rate = 0.5;\n        s.update_loss_rate(100); // same number → no change\n        assert_eq!(s.smoothed_drop_rate, 0.5);\n        assert_eq!(s.last_lost_packet_number, 100);\n    }\n\n    #[test]\n    fn loss_rate_single_step() {\n        let mut s = make_state();\n        s.last_lost_packet_number = 0;\n        s.smoothed_drop_rate = 0.0;\n        s.update_loss_rate(1);\n        // one decay step: rate *= (1 - 1/16) = 0  (was 0)\n        // then: rate += (1 - 0) * (1/16) = 1/16\n        assert!((s.smoothed_drop_rate - 1.0 / 16.0).abs() < 1e-12);\n        assert_eq!(s.last_lost_packet_number, 1);\n    }\n\n    #[test]\n    fn loss_rate_caps_scope() {\n        let mut s = make_state();\n        // Gap far exceeds SMOOTHED_LOSS_SCOPE=32; loop should start at\n        // lost_packet_number - 32 so only 32 decays happen, not 1000.\n        s.last_lost_packet_number = 0;\n        s.smoothed_drop_rate = 1.0;\n        s.update_loss_rate(1000);\n        // After 32 decay steps: 1.0 * (15/16)^32 ≈ 0.1209\n        // Then one more step adding the loss event:\n        // result = decayed + (1 - decayed) * (1/16)\n        let expected_decayed = (15.0f64 / 16.0).powi(32);\n        let expected = expected_decayed + (1.0 - expected_decayed) * (1.0 / 16.0);\n        assert!((s.smoothed_drop_rate - expected).abs() < 1e-9);\n        assert_eq!(s.last_lost_packet_number, 1000);\n    }\n\n    // --- ecn_threshold ---\n\n    #[test]\n    fn ecn_threshold_zero_sensitivity() {\n        let mut s = make_state();\n        s.nominal_rate = 0; // sensitivity = 0\n        // 192 - MULT1024(0, 96) = 192\n        assert_eq!(s.ecn_threshold(), 192);\n    }\n\n    #[test]\n    fn ecn_threshold_max_sensitivity() {\n        let mut s = make_state();\n        s.nominal_rate = 10_000_001; // sensitivity = 1024\n        // 192 - MULT1024(1024, 96) = 192 - 96 = 96\n        assert_eq!(s.ecn_threshold(), 96);\n    }\n\n    #[test]\n    fn ecn_threshold_mid_sensitivity() {\n        let mut s = make_state();\n        s.nominal_rate = 1_000_000; // sensitivity = 963\n        // 192 - MULT1024(963, 96) = 192 - ((96 * 963) >> 10) = 192 - 90 = 102\n        let expected = 192 - ((96u64 * 963) >> 10);\n        assert_eq!(s.ecn_threshold(), expected);\n    }\n\n    // --- ecn_alpha_update_counts ---\n\n    #[test]\n    fn ecn_alpha_no_update_when_both_zero_delta() {\n        let mut s = make_state();\n        s.ecn_alpha = 500;\n        s.ecn_ect1 = 100;\n        s.ecn_ce = 50;\n        // same totals → no delta → alpha unchanged\n        s.ecn_alpha_update_counts(100, 50);\n        assert_eq!(s.ecn_alpha, 500);\n    }\n\n    #[test]\n    fn ecn_alpha_fast_path_large_frac() {\n        let mut s = make_state();\n        s.ecn_alpha = 400;\n        s.ecn_ect1 = 0;\n        s.ecn_ce = 0;\n        // delta_ce = 600, delta_ect1 = 400 → frac = 600*1024/(600+400) = 614\n        // frac (614) > alpha (400) and frac >= 512 → fast path: alpha = frac\n        s.ecn_alpha_update_counts(400, 600);\n        assert_eq!(s.ecn_alpha, 614);\n    }\n\n    #[test]\n    fn ecn_alpha_ewma_path() {\n        let mut s = make_state();\n        s.ecn_alpha = 256;\n        s.ecn_ect1 = 0;\n        s.ecn_ce = 0;\n        // delta_ce = 100, delta_ect1 = 900 → frac = 100*1024/1000 = 102\n        // frac (102) < alpha (256) → EWMA path\n        // alpha_shifted = 256 * 16 - 256 + 102 = 256*15 + 102 = 3840 + 102 = 3942\n        // new alpha = 3942 / 16 = 246\n        s.ecn_alpha_update_counts(900, 100);\n        assert_eq!(s.ecn_alpha, 246);\n    }\n\n    #[test]\n    fn ecn_alpha_only_ect1_delta() {\n        let mut s = make_state();\n        s.ecn_alpha = 200;\n        s.ecn_ect1 = 0;\n        s.ecn_ce = 0;\n        // delta_ect1 = 500, delta_ce = 0 → frac = 0\n        // frac (0) < alpha (200) → EWMA:\n        //   alpha_shifted = 200 << 4 = 3200; 3200 - 200 = 3000; 3000 + 0 = 3000\n        //   new alpha = 3000 >> 4 = 187\n        s.ecn_alpha_update_counts(500, 0);\n        assert_eq!(s.ecn_alpha, 187);\n    }\n}\n","numLines":1306,"startLine":1,"totalLines":1306}}}
{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01STZhcyfZEw6NNgsWSTqE6v","type":"tool_result","content":"1\t//! Translation of `quic/config.h`.\n2\t//!\n3\t//! Demo-application–facing configuration plumbing for quic-core:\n4\t//! the [`Config`] bag of CLI-derived options, the [`OptionId`]\n5\t//! tag identifying each option, and [`Config::create_and_configure`],\n6\t//! the one-shot constructor that turns a populated config into a\n7\t//! fully-wired [`Quic`].\n8\t//!\n9\t//! Phase 4: all function bodies are implemented.\n10\t//!\n11\t//! Pointer-shape decisions for the config struct were guided by\n12\t//! reading `quic/config.c`:\n13\t//!\n14\t//! * Every `char const*` string field that\n15\t//!   `config_clear` `free`s is owned in C (allocated via\n16\t//!   `config_set_string_param`'s `malloc` + `memcpy`).  These map\n17\t//!   to `Option<String>`; `None` substitutes for the C `NULL`\n18\t//!   sentinel that all callers test before use.\n19\t//! * `multipath_alt_config: *mut char` is owned the same way and\n20\t//!   becomes `Option<String>`.\n21\t//! * `ech_target: uint8_t*` plus `ech_target_len` is owned by the\n22\t//!   config (`config_clear` frees it after the base64\n23\t//!   decode in `option_ECH_client`); it becomes\n24\t//!   `Option<Vec<u8>>` with the length implicit in the vector.\n25\t//! * `ticket_encryption_key: const uint8_t*` is *borrowed* in C —\n26\t//!   `config_clear` does not free it.  Phase 1 stores an\n27\t//!   owned `Option<Vec<u8>>` for safety; in v1 only the demo apps\n28\t//!   set this field, and they can supply an owned buffer.  Phase 3\n29\t//!   may revisit if a caller actually relies on aliasing.  The\n30\t//!   paired `ticket_encryption_key_length` field is dropped — its\n31\t//!   value is always implicit in the Vec length.\n32\t//! * Single-bit `unsigned int : 1` flag bitfields (`use_long_log`,\n33\t//!   `do_retry`, …) collapse to individual `bool` fields.  Every C\n34\t//!   call site reads/writes one bit at a time as a Boolean\n35\t//!   (`config->do_retry = 1`), so the\n36\t//!   integer-with-mask-and-shift translation buys nothing here and\n37\t//!   `bitflags!` is overkill for an unrelated set of flags.\n38\t//! * Bitfield `enable_sslkeylog` is gated by\n39\t//!   `#ifndef WITHOUT_SSLKEYLOG` in C.  v1 follows the\n40\t//!   canonical build (the macro is undefined), so the field is\n41\t//!   always present in Rust; a `cfg`-gated variant lands when the\n42\t//!   build options are translated.\n43\t\n44\tuse crate::Error;\n45\tuse crate::Instant;\n46\tuse crate::internal::MICROSEC_HANDSHAKE_MAX;\n47\tuse crate::{LossbitVersion, Quic, SpinbitVersion, StreamDataCallback};\n48\t\n49\t// ---------------------------------------------------------------------------\n50\t// Option identifiers.\n51\t\n52\t/// One identifier per CLI / API option understood by [`Config`].\n53\t///\n54\t/// Mirrors the C `picoquic_option_enum_t`; variant order is\n55\t/// load-bearing — the option dispatch table in `quic/config.c`\n56\t/// indexes by variant — so the discriminants do not get reordered.\n57\t///\n58\t/// [`OptionId::SslKeyLog`] is unconditional here even though the C\n59\t/// enum gates it on `#ifndef WITHOUT_SSLKEYLOG`, matching the\n60\t/// canonical-build behavior; see the module-level docs for the\n61\t/// rationale.\n62\t#[derive(Debug, Copy, Clone, PartialEq, Eq)]\n63\tpub enum OptionId {\n64\t    Cert,\n65\t    Key,\n66\t    ServerPort,\n67\t    ProposedVersion,\n68\t    OutDir,\n69\t    WwwDir,\n70\t    MaxConnections,\n71\t    DoRetry,\n72\t    InitialRandom,\n73\t    ResetSeed,\n74\t    DisablePortBlocking,\n75\t    SolutionDir,\n76\t    CcAlgo,\n77\t    CcOption,\n78\t    Spinbit,\n79\t    Lossbit,\n80\t    Multipath,\n81\t    DestIf,\n82\t    CipherSuite,\n83\t    InitCnxId,\n84\t    LogFile,\n85\t    LongLog,\n86\t    BinlogDir,\n87\t    QlogDir,\n88\t    MtuMax,\n89\t    Sni,\n90\t    Alpn,\n91\t    RootTrustFile,\n92\t    ForceZeroShare,\n93\t    CnxIdLength,\n94\t    NoDisk,\n95\t    IdleTimeout,\n96\t    LargeClientHello,\n97\t    TicketFileName,\n98\t    TokenFileName,\n99\t    SocketBufferSize,\n100\t    PerformanceLog,\n101\t    PreemptiveRepeat,\n102\t    VersionUpgrade,\n103\t    NoGso,\n104\t    BdpFrame,\n105\t    CwinMax,\n106\t    SslKeyLog,\n107\t    AddressDiscovery,\n108\t    EchServer,\n109\t    EchClient,\n110\t    EchInit,\n111\t    FlowControlMax,\n112\t    PreferredV4,\n113\t    PreferredV6,\n114\t    Help,\n115\t}\n116\t\n117\t// ---------------------------------------------------------------------------\n118\t// Option table (mirrors C static option_table[]).\n119\t\n120\tstruct OptionEntry {\n121\t    id: OptionId,\n122\t    letter: char,\n123\t    name: &'static str,\n124\t    nb_params: usize,\n125\t    param_sample: &'static str,\n126\t    help: &'static str,\n127\t}\n128\t\n129\tstatic OPTION_TABLE: &[OptionEntry] = &[\n130\t    OptionEntry {\n131\t        id: OptionId::Cert,\n132\t        letter: 'c',\n133\t        name: \"cert\",\n134\t        nb_params: 1,\n135\t        param_sample: \"file\",\n136\t        help: \"cert file\",\n137\t    },\n138\t    OptionEntry {\n139\t        id: OptionId::Key,\n140\t        letter: 'k',\n141\t        name: \"key\",\n142\t        nb_params: 1,\n143\t        param_sample: \"file\",\n144\t        help: \"key file\",\n145\t    },\n146\t    OptionEntry {\n147\t        id: OptionId::ServerPort,\n148\t        letter: 'p',\n149\t        name: \"port\",\n150\t        nb_params: 1,\n151\t        param_sample: \"number\",\n152\t        help: \"server port\",\n153\t    },\n154\t    OptionEntry {\n155\t        id: OptionId::ProposedVersion,\n156\t        letter: 'v',\n157\t        name: \"proposed_version\",\n158\t        nb_params: 1,\n159\t        param_sample: \"\",\n160\t        help: \"Version proposed by client, e.g. -v ff000012\",\n161\t    },\n162\t    OptionEntry {\n163\t        id: OptionId::OutDir,\n164\t        letter: 'o',\n165\t        name: \"outdir\",\n166\t        nb_params: 1,\n167\t        param_sample: \"folder\",\n168\t        help: \"Folder where client writes downloaded files, defaults to current directory.\",\n169\t    },\n170\t    OptionEntry {\n171\t        id: OptionId::WwwDir,\n172\t        letter: 'w',\n173\t        name: \"wwwdir\",\n174\t        nb_params: 1,\n175\t        param_sample: \"folder\",\n176\t        help: \"Folder containing web pages served by server\",\n177\t    },\n178\t    OptionEntry {\n179\t        id: OptionId::MaxConnections,\n180\t        letter: 'x',\n181\t        name: \"max_connections\",\n182\t        nb_params: 1,\n183\t        param_sample: \"number\",\n184\t        help: \"Maximum number of concurrent connections, default 256\",\n185\t    },\n186\t    OptionEntry {\n187\t        id: OptionId::DoRetry,\n188\t        letter: 'r',\n189\t        name: \"do_retry\",\n190\t        nb_params: 0,\n191\t        param_sample: \"\",\n192\t        help: \"Do Retry Request\",\n193\t    },\n194\t    OptionEntry {\n195\t        id: OptionId::InitialRandom,\n196\t        letter: 'R',\n197\t        name: \"initial_random\",\n198\t        nb_params: 1,\n199\t        param_sample: \"option\",\n200\t        help: \"Randomize packet number spaces: none(0), initial(1, default), all(2).\",\n201\t    },\n202\t    OptionEntry {\n203\t        id: OptionId::ResetSeed,\n204\t        letter: 's',\n205\t        name: \"reset_seed\",\n206\t        nb_params: 1,\n207\t        param_sample: \"<32 hex chars>\",\n208\t        help: \"Reset seed\",\n209\t    },\n210\t    OptionEntry {\n211\t        id: OptionId::DisablePortBlocking,\n212\t        letter: 'X',\n213\t        name: \"disable_block\",\n214\t        nb_params: 0,\n215\t        param_sample: \"\",\n216\t        help: \"Disable the check for blocked ports\",\n217\t    },\n218\t    OptionEntry {\n219\t        id: OptionId::SolutionDir,\n220\t        letter: 'S',\n221\t        name: \"solution_dir\",\n222\t        nb_params: 1,\n223\t        param_sample: \"folder\",\n224\t        help: \"Set the path to the source files to find the default files\",\n225\t    },\n226\t    OptionEntry {\n227\t        id: OptionId::CcAlgo,\n228\t        letter: 'G',\n229\t        name: \"cc_algo\",\n230\t        nb_params: 1,\n231\t        param_sample: \"cc_algorithm\",\n232\t        help: \"Use the specified congestion control algorithm. Defaults to bbr.\",\n233\t    },\n234\t    OptionEntry {\n235\t        id: OptionId::CcOption,\n236\t        letter: 'H',\n237\t        name: \"cco\",\n238\t        nb_params: 1,\n239\t        param_sample: \"option\",\n240\t        help: \"Set option string if required by congestion control algorithm.\",\n241\t    },\n242\t    OptionEntry {\n243\t        id: OptionId::Spinbit,\n244\t        letter: 'P',\n245\t        name: \"spinbit\",\n246\t        nb_params: 1,\n247\t        param_sample: \"number\",\n248\t        help: \"Set the default spinbit policy\",\n249\t    },\n250\t    OptionEntry {\n251\t        id: OptionId::Lossbit,\n252\t        letter: 'O',\n253\t        name: \"lossbit\",\n254\t        nb_params: 1,\n255\t        param_sample: \"number\",\n256\t        help: \"Set the default lossbit policy\",\n257\t    },\n258\t    OptionEntry {\n259\t        id: OptionId::Multipath,\n260\t        letter: 'M',\n261\t        name: \"multipath\",\n262\t        nb_params: 0,\n263\t        param_sample: \"\",\n264\t        help: \"Enable QUIC multipath extension\",\n265\t    },\n266\t    OptionEntry {\n267\t        id: OptionId::DestIf,\n268\t        letter: 'e',\n269\t        name: \"dest_if\",\n270\t        nb_params: 1,\n271\t        param_sample: \"if\",\n272\t        help: \"Send on interface (default: -1)\",\n273\t    },\n274\t    OptionEntry {\n275\t        id: OptionId::CipherSuite,\n276\t        letter: 'C',\n277\t        name: \"cipher_suite\",\n278\t        nb_params: 1,\n279\t        param_sample: \"cipher_suite_id\",\n280\t        help: \"specify cipher suite (e.g. -C 20 = chacha20)\",\n281\t    },\n282\t    OptionEntry {\n283\t        id: OptionId::InitCnxId,\n284\t        letter: 'i',\n285\t        name: \"cnxid_params\",\n286\t        nb_params: 1,\n287\t        param_sample: \"per-text-lb-spec\",\n288\t        help: \"See documentation for LB compatible CID configuration\",\n289\t    },\n290\t    OptionEntry {\n291\t        id: OptionId::LogFile,\n292\t        letter: 'l',\n293\t        name: \"text_log\",\n294\t        nb_params: 1,\n295\t        param_sample: \"file\",\n296\t        help: \"Log file, Log to stdout if file = \\\"-\\\". No text logging if absent.\",\n297\t    },\n298\t    OptionEntry {\n299\t        id: OptionId::LongLog,\n300\t        letter: 'L',\n301\t        name: \"long_log\",\n302\t        nb_params: 0,\n303\t        param_sample: \"\",\n304\t        help: \"Log all packets. If absent, log stops after 100 packets.\",\n305\t    },\n306\t    OptionEntry {\n307\t        id: OptionId::BinlogDir,\n308\t        letter: 'b',\n309\t        name: \"binlog_dir\",\n310\t        nb_params: 1,\n311\t        param_sample: \"folder\",\n312\t        help: \"Binary logging to this directory. No binary logging if absent.\",\n313\t    },\n314\t    OptionEntry {\n315\t        id: OptionId::QlogDir,\n316\t        letter: 'q',\n317\t        name: \"qlog_dir\",\n318\t        nb_params: 1,\n319\t        param_sample: \"folder\",\n320\t        help: \"Qlog logging to this directory.\",\n321\t    },\n322\t    OptionEntry {\n323\t        id: OptionId::MtuMax,\n324\t        letter: 'm',\n325\t        name: \"mtu_max\",\n326\t        nb_params: 1,\n327\t        param_sample: \"mtu_max\",\n328\t        help: \"Largest mtu value that can be tried for discovery.\",\n329\t    },\n330\t    OptionEntry {\n331\t        id: OptionId::Sni,\n332\t        letter: 'n',\n333\t        name: \"sni\",\n334\t        nb_params: 1,\n335\t        param_sample: \"sni\",\n336\t        help: \"sni (default: server name)\",\n337\t    },\n338\t    OptionEntry {\n339\t        id: OptionId::Alpn,\n340\t        letter: 'a',\n341\t        name: \"alpn\",\n342\t        nb_params: 1,\n343\t        param_sample: \"alpn\",\n344\t        help: \"alpn (default function of version)\",\n345\t    },\n346\t    OptionEntry {\n347\t        id: OptionId::RootTrustFile,\n348\t        letter: 't',\n349\t        name: \"root_trust_file\",\n350\t        nb_params: 1,\n351\t        param_sample: \"file\",\n352\t        help: \"root trust file\",\n353\t    },\n354\t    OptionEntry {\n355\t        id: OptionId::ForceZeroShare,\n356\t        letter: 'z',\n357\t        name: \"force_zero_share\",\n358\t        nb_params: 0,\n359\t        param_sample: \"\",\n360\t        help: \"Set TLS zero share behavior on client, to force HRR\",\n361\t    },\n362\t    OptionEntry {\n363\t        id: OptionId::CnxIdLength,\n364\t        letter: 'I',\n365\t        name: \"cnxid_length\",\n366\t        nb_params: 1,\n367\t        param_sample: \"length\",\n368\t        help: \"Length of CNX_ID used by the client, default=8\",\n369\t    },\n370\t    OptionEntry {\n371\t        id: OptionId::IdleTimeout,\n372\t        letter: 'd',\n373\t        name: \"idle_timeout\",\n374\t        nb_params: 1,\n375\t        param_sample: \"ms\",\n376\t        help: \"Duration of idle timeout in milliseconds (Default 30,000ms)\",\n377\t    },\n378\t    OptionEntry {\n379\t        id: OptionId::NoDisk,\n380\t        letter: 'D',\n381\t        name: \"no_disk\",\n382\t        nb_params: 0,\n383\t        param_sample: \"\",\n384\t        help: \"no disk: do not save received files on disk\",\n385\t    },\n386\t    OptionEntry {\n387\t        id: OptionId::LargeClientHello,\n388\t        letter: 'Q',\n389\t        name: \"large_client_hello\",\n390\t        nb_params: 0,\n391\t        param_sample: \"\",\n392\t        help: \"send a large client hello in order to test post quantum readiness\",\n393\t    },\n394\t    OptionEntry {\n395\t        id: OptionId::TicketFileName,\n396\t        letter: 'T',\n397\t        name: \"ticket_file\",\n398\t        nb_params: 1,\n399\t        param_sample: \"file\",\n400\t        help: \"File storing the session tickets\",\n401\t    },\n402\t    OptionEntry {\n403\t        id: OptionId::TokenFileName,\n404\t        letter: 'N',\n405\t        name: \"token_file\",\n406\t        nb_params: 1,\n407\t        param_sample: \"file\",\n408\t        help: \"File storing the new tokens\",\n409\t    },\n410\t    OptionEntry {\n411\t        id: OptionId::SocketBufferSize,\n412\t        letter: 'B',\n413\t        name: \"so_buf_size\",\n414\t        nb_params: 1,\n415\t        param_sample: \"number\",\n416\t        help: \"Set buffer size with SO_SNDBUF SO_RCVBUF\",\n417\t    },\n418\t    OptionEntry {\n419\t        id: OptionId::PerformanceLog,\n420\t        letter: 'F',\n421\t        name: \"log_file_name\",\n422\t        nb_params: 1,\n423\t        param_sample: \"file\",\n424\t        help: \"Append performance reports to performance log\",\n425\t    },\n426\t    OptionEntry {\n427\t        id: OptionId::PreemptiveRepeat,\n428\t        letter: 'V',\n429\t        name: \"preemptive_repeat\",\n430\t        nb_params: 0,\n431\t        param_sample: \"\",\n432\t        help: \"enable preemptive repeat\",\n433\t    },\n434\t    OptionEntry {\n435\t        id: OptionId::VersionUpgrade,\n436\t        letter: 'U',\n437\t        name: \"version_upgrade\",\n438\t        nb_params: 1,\n439\t        param_sample: \"\",\n440\t        help: \"Version upgrade if server agrees, e.g. -U 6b3343cf\",\n441\t    },\n442\t    OptionEntry {\n443\t        id: OptionId::NoGso,\n444\t        letter: '0',\n445\t        name: \"no_gso\",\n446\t        nb_params: 0,\n447\t        param_sample: \"\",\n448\t        help: \"Do not use UDP GSO or equivalent\",\n449\t    },\n450\t    OptionEntry {\n451\t        id: OptionId::BdpFrame,\n452\t        letter: 'j',\n453\t        name: \"bdp\",\n454\t        nb_params: 1,\n455\t        param_sample: \"number\",\n456\t        help: \"use bdp extension frame(1) or don't (0). Default=0\",\n457\t    },\n458\t    OptionEntry {\n459\t        id: OptionId::CwinMax,\n460\t        letter: 'W',\n461\t        name: \"cwin_max\",\n462\t        nb_params: 1,\n463\t        param_sample: \"bytes\",\n464\t        help: \"Max value for CWIN. Default=UINT64_MAX\",\n465\t    },\n466\t    OptionEntry {\n467\t        id: OptionId::SslKeyLog,\n468\t        letter: '8',\n469\t        name: \"sslkeylog\",\n470\t        nb_params: 0,\n471\t        param_sample: \"\",\n472\t        help: \"Enable SSLKEYLOG\",\n473\t    },\n474\t    OptionEntry {\n475\t        id: OptionId::AddressDiscovery,\n476\t        letter: 'J',\n477\t        name: \"addr_disc\",\n478\t        nb_params: 1,\n479\t        param_sample: \"mode\",\n480\t        help: \"provider (0), receiver (1) or both (2).\",\n481\t    },\n482\t    OptionEntry {\n483\t        id: OptionId::EchServer,\n484\t        letter: 'E',\n485\t        name: \"ech_s\",\n486\t        nb_params: 2,\n487\t        param_sample: \"key config\",\n488\t        help: \"ECH private key file, config file. Default= no ECH on server.\",\n489\t    },\n490\t    OptionEntry {\n491\t        id: OptionId::EchInit,\n492\t        letter: 'y',\n493\t        name: \"ech_init\",\n494\t        nb_params: 1,\n495\t        param_sample: \"public_name\",\n496\t        help: \"Create an ECH configuration before applying the `ech_s` parameter.\",\n497\t    },\n498\t    OptionEntry {\n499\t        id: OptionId::EchClient,\n500\t        letter: 'K',\n501\t        name: \"ech_c\",\n502\t        nb_params: 1,\n503\t        param_sample: \"base64\",\n504\t        help: \"ECH configuration for the client connection, base64 encoded.\",\n505\t    },\n506\t    OptionEntry {\n507\t        id: OptionId::FlowControlMax,\n508\t        letter: 'Z',\n509\t        name: \"flow_control_max\",\n510\t        nb_params: 1,\n511\t        param_sample: \"bytes\",\n512\t        help: \"Set the flow control's initial max data.\",\n513\t    },\n514\t    OptionEntry {\n515\t        id: OptionId::PreferredV4,\n516\t        letter: '4',\n517\t        name: \"preferred_v4\",\n518\t        nb_params: 1,\n519\t        param_sample: \"ip[:port]\",\n520\t        help: \"Preferred address for v4 connections.\",\n521\t    },\n522\t    OptionEntry {\n523\t        id: OptionId::PreferredV6,\n524\t        letter: '6',\n525\t        name: \"preferred_v6\",\n526\t        nb_params: 1,\n527\t        param_sample: \"ipv6[:port]\",\n528\t        help: \"Preferred address for v6 connections.\",\n529\t    },\n530\t    OptionEntry {\n531\t        id: OptionId::Help,\n532\t        letter: 'h',\n533\t        name: \"help\",\n534\t        nb_params: 0,\n535\t        param_sample: \"\",\n536\t        help: \"This help message\",\n537\t    },\n538\t];\n539\t\n540\t/// C: `config_parse_target_version` (picoquic/config.c:116)\n541\t///\n542\t/// Parses a hex-encoded QUIC version number.  Returns 0 on any invalid input,\n543\t/// matching the C behaviour of breaking on the first unrecognised character.\n544\tfn parse_hex_version(s: &str) -> u32 {\n545\t    u32::from_str_radix(s, 16).unwrap_or(0)\n546\t}\n547\t\n548\t/// C: `config_optval_string` (picoquic/config.c:181)\n549\t///\n550\t/// Copies at most `buffer.len() - 1` bytes from `p` into `buffer`,\n551\t/// null-terminates, and returns the filled prefix as a `str`.\n552\t/// Matches the C truncation-and-NUL-terminate contract exactly.\n553\tfn config_optval_string<'a>(buffer: &'a mut [u8], p: &[u8]) -> &'a str {\n554\t    let len = p.len().min(buffer.len().saturating_sub(1));\n555\t    buffer[..len].copy_from_slice(&p[..len]);\n556\t    if !buffer.is_empty() {\n557\t        buffer[len] = 0;\n558\t    }\n559\t    core::str::from_utf8(&buffer[..len]).unwrap_or(\"\")\n560\t}\n561\t\n562\t/// C: `config_atoi` (picoquic/config.c:202)\n563\t///\n564\t/// Parse a decimal (ASCII digit only) integer from `params[x]`.\n565\t///\n566\t/// Returns `Ok(value)` on success.  Returns `Err(InvalidArgument)` when `x`\n567\t/// is out of bounds or any character in `params[x]` is not an ASCII digit —\n568\t/// mirroring the C behaviour of setting `*ret = -1` and returning `-1` on error.\n569\tpub fn config_atoi(params: &[&str], x: usize) -> Result<i32, Error> {\n570\t    if x >= params.len() {\n571\t        return Err(Error::InvalidArgument);\n572\t    }\n573\t    let mut v: i32 = 0;\n574\t    for b in params[x].bytes() {\n575\t        let digit = b.wrapping_sub(b'0');\n576\t        if digit > 9 {\n577\t            return Err(Error::InvalidArgument);\n578\t        }\n579\t        v = v * 10 + digit as i32;\n580\t    }\n581\t    Ok(v)\n582\t}\n583\t\n584\tfn base64_decode(s: &str) -> Result<Vec<u8>, Error> {\n585\t    let mut table = [0xFFu8; 256];\n586\t    for (i, &c) in b\"ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789+/\"\n587\t        .iter()\n588\t        .enumerate()\n589\t    {\n590\t        table[c as usize] = i as u8;\n591\t    }\n592\t    let bytes: Vec<u8> = s.bytes().filter(|&c| c != b'=').collect();\n593\t    let mut out = Vec::new();\n594\t    for chunk in bytes.chunks(4) {\n595\t        let mut v = [0u8; 4];\n596\t        let n = chunk.len();\n597\t        for (i, &b) in chunk.iter().enumerate() {\n598\t            let x = table[b as usize];\n599\t            if x == 0xFF {\n600\t                return Err(Error::InvalidArgument);\n601\t            }\n602\t            v[i] = x;\n603\t        }\n604\t        out.push((v[0] << 2) | (v[1] >> 4));\n605\t        if n >= 3 {\n606\t            out.push((v[1] << 4) | (v[2] >> 2));\n607\t        }\n608\t        if n == 4 {\n609\t            out.push((v[2] << 6) | v[3]);\n610\t        }\n611\t    }\n612\t    Ok(out)\n613\t}\n614\t\n615\tfn option_entry(id: OptionId) -> Option<&'static OptionEntry> {\n616\t    OPTION_TABLE.iter().find(|e| e.id == id)\n617\t}\n618\t\n619\tfn option_entry_by_letter(letter: char) -> Option<(usize, &'static OptionEntry)> {\n620\t    OPTION_TABLE\n621\t        .iter()\n622\t        .enumerate()\n623\t        .find(|(_, e)| e.letter == letter)\n624\t}\n625\t\n626\tfn option_entry_by_name(name: &str) -> Option<(usize, &'static OptionEntry)> {\n627\t    OPTION_TABLE\n628\t        .iter()\n629\t        .enumerate()\n630\t        .find(|(_, e)| e.name == name)\n631\t}\n632\t\n633\t/// C: `config_set_string_param` (picoquic/config.c:148)\n634\t///\n635\t/// Replace `*v` with an owned copy of `params[x]`.  Clears `*v` first\n636\t/// (mirrors the `free(*v)` in C), then sets it if the selected param\n637\t/// is non-empty.  Returns `Err(InvalidArgument)` when `x` is out of\n638\t/// bounds or the param is empty (the C path where `length == 0` causes\n639\t/// `malloc` to be skipped and `-1` is returned).\n640\t#[allow(dead_code)]\n641\tfn config_set_string_param(v: &mut Option<String>, params: &[&str], x: usize) -> Result<(), Error> {\n642\t    *v = None;\n643\t    if x < params.len() && !params[x].is_empty() {\n644\t        *v = Some(params[x].to_string());\n645\t        Ok(())\n646\t    } else {\n647\t        Err(Error::InvalidArgument)\n648\t    }\n649\t}\n650\t\n651\t/// C: `picoquic_config_get_option_char_index` (picoquic/config.c:641)\n652\t///\n653\t/// Return the index in `OPTION_TABLE` of the entry whose single-character\n654\t/// flag equals `opt`, or `-1` if not found.\n655\tpub fn picoquic_config_get_option_char_index(opt: char) -> i32 {\n656\t    OPTION_TABLE\n657\t        .iter()\n658\t        .position(|e| e.letter == opt)\n659\t        .map_or(-1, |i| i as i32)\n660\t}\n661\t\n662\t/// C: `picoquic_config_get_option_name_index` (picoquic/config.c:654)\n663\t///\n664\t/// Return the index in `OPTION_TABLE` of the first entry whose long name\n665\t/// matches the first `l` bytes of `s` (mirrors `strncmp(s, name, l) == 0`),\n666\t/// or `-1` if not found.\n667\tpub fn picoquic_config_get_option_name_index(s: &str, l: usize) -> i32 {\n668\t    let l = l.min(s.len());\n669\t    let prefix = &s[..l];\n670\t    OPTION_TABLE\n671\t        .iter()\n672\t        .position(|e| e.name.len() >= l && &e.name[..l] == prefix)\n673\t        .map_or(-1, |i| i as i32)\n674\t}\n675\t\n676\tfn apply_option(config: &mut Config, entry: &OptionEntry, params: &[&str]) -> Result<(), Error> {\n677\t    let p0 = params.first().copied();\n678\t    let p1 = params.get(1).copied();\n679\t    match entry.id {\n680\t        OptionId::Cert => {\n681\t            config.server_cert_file = Some(p0.ok_or(Error::InvalidArgument)?.to_string());\n682\t        }\n683\t        OptionId::Key => {\n684\t            config.server_key_file = Some(p0.ok_or(Error::InvalidArgument)?.to_string());\n685\t        }\n686\t        OptionId::ServerPort => {\n687\t            config.set_port(p0.ok_or(Error::InvalidArgument)?)?;\n688\t        }\n689\t        OptionId::ProposedVersion => {\n690\t            let v = parse_hex_version(p0.ok_or(Error::InvalidArgument)?);\n691\t            if v == 0 {\n692\t                return Err(Error::InvalidArgument);\n693\t            }\n694\t            config.proposed_version = v;\n695\t        }\n696\t        OptionId::OutDir => {\n697\t            config.out_dir = Some(p0.ok_or(Error::InvalidArgument)?.to_string());\n698\t        }\n699\t        OptionId::WwwDir => {\n700\t            config.www_dir = Some(p0.ok_or(Error::InvalidArgument)?.to_string());\n701\t        }\n702\t        OptionId::MaxConnections => {\n703\t            let v: i32 = p0\n704\t                .ok_or(Error::InvalidArgument)?\n705\t                .parse()\n706\t                .map_err(|_| Error::InvalidArgument)?;\n707\t            if v <= 0 {\n708\t                return Err(Error::InvalidArgument);\n709\t            }\n710\t            config.nb_connections = v as u32;\n711\t        }\n712\t        OptionId::DoRetry => {\n713\t            config.do_retry = true;\n714\t        }\n715\t        OptionId::InitialRandom => {\n716\t            let v: i32 = p0\n717\t                .ok_or(Error::InvalidArgument)?\n718\t                .parse()\n719\t                .map_err(|_| Error::InvalidArgument)?;\n720\t            if !(0..=2).contains(&v) {\n721\t                return Err(Error::InvalidArgument);\n722\t            }\n723\t            config.initial_random = v as u32;\n724\t        }\n725\t        OptionId::ResetSeed => {\n726\t            config.has_reset_seed = true;\n727\t            let n =\n728\t                crate::utils::parse_hexa(p0.ok_or(Error::InvalidArgument)?, &mut config.reset_seed);\n729\t            if n != config.reset_seed.len() {\n730\t                return Err(Error::InvalidArgument);\n731\t            }\n732\t        }\n733\t        OptionId::DisablePortBlocking => {\n734\t            config.disable_port_blocking = true;\n735\t        }\n736\t        OptionId::SslKeyLog => {\n737\t            config.enable_sslkeylog = true;\n738\t        }\n739\t        OptionId::SolutionDir => {\n740\t            config.solution_dir = Some(p0.ok_or(Error::InvalidArgument)?.to_string());\n741\t        }\n742\t        OptionId::CcAlgo => {\n743\t            config.cc_algo_id = Some(p0.ok_or(Error::InvalidArgument)?.to_string());\n744\t        }\n745\t        OptionId::CcOption => {\n746\t            config.cc_algo_option_string = Some(p0.ok_or(Error::InvalidArgument)?.to_string());\n747\t        }\n748\t        OptionId::Spinbit => {\n749\t            let v: i32 = p0\n750\t                .ok_or(Error::InvalidArgument)?\n751\t                .parse()\n752\t                .map_err(|_| Error::InvalidArgument)?;\n753\t            config.spinbit_policy = match v {\n754\t                0 => SpinbitVersion::Basic,\n755\t                1 => SpinbitVersion::Random,\n756\t                2 => SpinbitVersion::Null,\n757\t                3 => SpinbitVersion::On,\n758\t                _ => return Err(Error::InvalidArgument),\n759\t            };\n760\t        }\n761\t        OptionId::Lossbit => {\n762\t            let v: i32 = p0\n763\t                .ok_or(Error::InvalidArgument)?\n764\t                .parse()\n765\t                .map_err(|_| Error::InvalidArgument)?;\n766\t            config.lossbit_policy = match v {\n767\t                0 => LossbitVersion::None,\n768\t                1 => LossbitVersion::SendOnly,\n769\t                2 => LossbitVersion::SendReceive,\n770\t                _ => return Err(Error::InvalidArgument),\n771\t            };\n772\t        }\n773\t        OptionId::Multipath => {\n774\t            config.multipath_option = 1;\n775\t        }\n776\t        OptionId::DestIf => {\n777\t            config.dest_if = p0\n778\t                .ok_or(Error::InvalidArgument)?\n779\t                .parse()\n780\t                .map_err(|_| Error::InvalidArgument)?;\n781\t        }\n782\t        OptionId::CipherSuite => {\n783\t            config.cipher_suite_id = p0\n784\t                .ok_or(Error::InvalidArgument)?\n785\t                .parse()\n786\t                .map_err(|_| Error::InvalidArgument)?;\n787\t        }\n788\t        OptionId::InitCnxId => {\n789\t            config.connection_id_cbdata = Some(p0.ok_or(Error::InvalidArgument)?.to_string());\n790\t        }\n791\t        OptionId::LogFile => {\n792\t            config.log_file = Some(p0.ok_or(Error::InvalidArgument)?.to_string());\n793\t        }\n794\t        OptionId::LongLog => {\n795\t            config.use_long_log = true;\n796\t        }\n797\t        OptionId::BinlogDir => {\n798\t            config.bin_dir = Some(p0.ok_or(Error::InvalidArgument)?.to_string());\n799\t        }\n800\t        OptionId::QlogDir => {\n801\t            config.qlog_dir = Some(p0.ok_or(Error::InvalidArgument)?.to_string());\n802\t        }\n803\t        OptionId::MtuMax => {\n804\t            let v: i32 = p0\n805\t                .ok_or(Error::InvalidArgument)?\n806\t                .parse()\n807\t                .map_err(|_| Error::InvalidArgument)?;\n808\t            if v <= 0 || v > crate::internal::MAX_PACKET_SIZE as i32 {\n809\t                return Err(Error::InvalidArgument);\n810\t            }\n811\t            config.mtu_max = v;\n812\t        }\n813\t        OptionId::Sni => {\n814\t            config.sni = Some(p0.ok_or(Error::InvalidArgument)?.to_string());\n815\t        }\n816\t        OptionId::Alpn => {\n817\t            config.alpn = Some(p0.ok_or(Error::InvalidArgument)?.to_string());\n818\t        }\n819\t        OptionId::RootTrustFile => {\n820\t            config.root_trust_file = Some(p0.ok_or(Error::InvalidArgument)?.to_string());\n821\t        }\n822\t        OptionId::ForceZeroShare => {\n823\t            config.force_zero_share = true;\n824\t        }\n825\t        OptionId::CnxIdLength => {\n826\t            let v: i32 = p0\n827\t                .ok_or(Error::InvalidArgument)?\n828\t                .parse()\n829\t                .map_err(|_| Error::InvalidArgument)?;\n830\t            if v < 0 || v > crate::CONNECTION_ID_MAX_SIZE as i32 {\n831\t                return Err(Error::InvalidArgument);\n832\t            }\n833\t            config.connection_id_length = v;\n834\t        }\n835\t        OptionId::IdleTimeout => {\n836\t            let v: i32 = p0\n837\t                .ok_or(Error::InvalidArgument)?\n838\t                .parse()\n839\t                .map_err(|_| Error::InvalidArgument)?;\n840\t            if v < 0 {\n841\t                return Err(Error::InvalidArgument);\n842\t            }\n843\t            config.idle_timeout = v;\n844\t        }\n845\t        OptionId::NoDisk => {\n846\t            config.no_disk = true;\n847\t        }\n848\t        OptionId::LargeClientHello => {\n849\t            config.large_client_hello = true;\n850\t        }\n851\t        OptionId::TicketFileName => {\n852\t            config.ticket_file_name = Some(p0.ok_or(Error::InvalidArgument)?.to_string());\n853\t        }\n854\t        OptionId::TokenFileName => {\n855\t            config.token_file_name = Some(p0.ok_or(Error::InvalidArgument)?.to_string());\n856\t        }\n857\t        OptionId::SocketBufferSize => {\n858\t            let v: i32 = p0\n859\t                .ok_or(Error::InvalidArgument)?\n860\t                .parse()\n861\t                .map_err(|_| Error::InvalidArgument)?;\n862\t            if v < 0 {\n863\t                return Err(Error::InvalidArgument);\n864\t            }\n865\t            config.socket_buffer_size = v;\n866\t        }\n867\t        OptionId::PerformanceLog => {\n868\t            config.performance_log = Some(p0.ok_or(Error::InvalidArgument)?.to_string());\n869\t        }\n870\t        OptionId::PreemptiveRepeat => {\n871\t            config.do_preemptive_repeat = true;\n872\t        }\n873\t        OptionId::VersionUpgrade => {\n874\t            let v = parse_hex_version(p0.ok_or(Error::InvalidArgument)?);\n875\t            if v == 0 {\n876\t                return Err(Error::InvalidArgument);\n877\t            }\n878\t            config.desired_version = v;\n879\t        }\n880\t        OptionId::NoGso => {\n881\t            config.do_not_use_gso = true;\n882\t        }\n883\t        OptionId::BdpFrame => {\n884\t            let v: i32 = p0\n885\t                .ok_or(Error::InvalidArgument)?\n886\t                .parse()\n887\t                .map_err(|_| Error::InvalidArgument)?;\n888\t            if !(0..=1).contains(&v) {\n889\t                return Err(Error::InvalidArgument);\n890\t            }\n891\t            config.bdp_frame_option = v;\n892\t        }\n893\t        OptionId::CwinMax => {\n894\t            let v: i64 = p0\n895\t                .ok_or(Error::InvalidArgument)?\n896\t                .parse()\n897\t                .map_err(|_| Error::InvalidArgument)?;\n898\t            if v < 0 {\n899\t                return Err(Error::InvalidArgument);\n900\t            }\n901\t            config.cwin_max = if v == 0 { u64::MAX } else { v as u64 };\n902\t        }\n903\t        OptionId::AddressDiscovery => {\n904\t            let v: i32 = p0\n905\t                .ok_or(Error::InvalidArgument)?\n906\t                .parse()\n907\t                .map_err(|_| Error::InvalidArgument)?;\n908\t            if !(0..=2).contains(&v) {\n909\t                return Err(Error::InvalidArgument);\n910\t            }\n911\t            config.address_discovery_mode = v + 1;\n912\t        }\n913\t        OptionId::EchServer => {\n914\t            config.ech_key_file = Some(p0.ok_or(Error::InvalidArgument)?.to_string());\n915\t            if let Some(s) = p1 {\n916\t                config.ech_config_file = Some(s.to_string());\n917\t            }\n918\t        }\n919\t        OptionId::EchInit => {\n920\t            config.ech_public_name = Some(p0.ok_or(Error::InvalidArgument)?.to_string());\n921\t        }\n922\t        OptionId::EchClient => {\n923\t            let s = p0.ok_or(Error::InvalidArgument)?;\n924\t            if s == \"-\" {\n925\t                config.ech_target = None;\n926\t            } else {\n927\t                config.ech_target = Some(base64_decode(s).map_err(|_| Error::InvalidArgument)?);\n928\t            }\n929\t        }\n930\t        OptionId::FlowControlMax => {\n931\t            let v: i64 = p0\n932\t                .ok_or(Error::InvalidArgument)?\n933\t                .parse()\n934\t                .map_err(|_| Error::InvalidArgument)?;\n935\t            if v < 0 {\n936\t                return Err(Error::InvalidArgument);\n937\t            }\n938\t            config.flow_control_max = v as u64;\n939\t        }\n940\t        OptionId::PreferredV4 => {\n941\t            config.preferred_address_v4 = Some(p0.ok_or(Error::InvalidArgument)?.to_string());\n942\t        }\n943\t        OptionId::PreferredV6 => {\n944\t            config.preferred_address_v6 = Some(p0.ok_or(Error::InvalidArgument)?.to_string());\n945\t        }\n946\t        OptionId::Help => {\n947\t            return Err(Error::InvalidArgument);\n948\t        }\n949\t    }\n950\t    Ok(())\n951\t}\n952\t\n953\tfn collect_params<'a>(\n954\t    entry: &OptionEntry,\n955\t    p_optind: &mut usize,\n956\t    argv: &[&'a str],\n957\t    optarg: Option<&'a str>,\n958\t) -> Result<Vec<&'a str>, Error> {\n959\t    let mut params = Vec::new();\n960\t    if entry.nb_params > 0 {\n961\t        params.push(optarg.ok_or(Error::InvalidArgument)?);\n962\t        let mut nb = 1;\n963\t        while nb < entry.nb_params {\n964\t            if *p_optind >= argv.len() {\n965\t                return Err(Error::InvalidArgument);\n966\t            }\n967\t            params.push(argv[*p_optind]);\n968\t            *p_optind += 1;\n969\t            nb += 1;\n970\t        }\n971\t    }\n972\t    Ok(params)\n973\t}\n974\t\n975\tfn parse_option_string(opt_string: &str) -> Option<(usize, &'static OptionEntry)> {\n976\t    if opt_string.starts_with(\"--\") && opt_string.len() > 2 {\n977\t        option_entry_by_name(&opt_string[2..])\n978\t    } else if opt_string.starts_with('-') && opt_string.len() == 2 {\n979\t        opt_string.chars().nth(1).and_then(option_entry_by_letter)\n980\t    } else {\n981\t        None\n982\t    }\n983\t}\n984\t\n985\t// ---------------------------------------------------------------------------\n986\t// Configuration struct.\n987\t\n988\t/// Configuration bag for a QUIC context, populated from CLI flags\n989\t/// (via [`Config::command_line`]) or directly (via\n990\t/// [`Config::set_option`]) and consumed by\n991\t/// [`Config::create_and_configure`].\n992\t///\n993\t/// Mirrors the C `picoquic_quic_config_t` field-for-field;\n994\t/// `repr(C)` is dropped because the struct never crosses an\n995\t/// external boundary.  See the module-level docs for the\n996\t/// pointer-shape rationale.\n997\t///\n998\t/// `Default` produces the documented C defaults:\n999\t/// `nb_connections = 256`, `connection_id_length = -1`, `cwin_max =\n1000\t/// u64::MAX`, idle timeout from `MICROSEC_HANDSHAKE_MAX`, etc.  This\n1001\t/// folds the C `picoquic_config_init` step into the constructor —\n1002\t/// the C `config_clear` (which `free`s every owned string) collapses\n1003\t/// to `Drop`, and resetting a config to defaults is just\n1004\t/// `*config = Config::default()`.\n1005\t#[derive(Debug)]\n1006\tpub struct Config {\n1007\t    pub nb_connections: u32,\n1008\t    pub solution_dir: Option<String>,\n1009\t    pub server_cert_file: Option<String>,\n1010\t    pub server_key_file: Option<String>,\n1011\t    pub log_file: Option<String>,\n1012\t    pub bin_dir: Option<String>,\n1013\t    pub qlog_dir: Option<String>,\n1014\t    pub performance_log: Option<String>,\n1015\t    pub server_port: u16,\n1016\t    pub local_port: u16,\n1017\t    /// Whether the public port is shared with sibling threads\n1018\t    /// (`SO_REUSEPORT`).  C: `int is_port_shared`, used as a\n1019\t    /// Boolean flag.\n1020\t    pub is_port_shared: bool,\n1021\t    pub nb_threads: i32,\n1022\t    pub dest_if: i32,\n1023\t    pub mtu_max: i32,\n1024\t    /// `-1` is the C \"unset\" sentinel applied by [`Self::init`];\n1025\t    /// values `>= 0` set the connection-ID length explicitly.  Kept\n1026\t    /// as `i32` rather than `Option<u8>` for source-level parity\n1027\t    /// with the C body.\n1028\t    pub connection_id_length: i32,\n1029\t    pub idle_timeout: i32,\n1030\t    pub socket_buffer_size: i32,\n1031\t    pub cc_algo_id: Option<String>,\n1032\t    pub cc_algo_option_string: Option<String>,\n1033\t    pub connection_id_cbdata: Option<String>,\n1034\t    pub spinbit_policy: SpinbitVersion,\n1035\t    pub lossbit_policy: LossbitVersion,\n1036\t    pub multipath_option: i32,\n1037\t    pub multipath_alt_config: Option<String>,\n1038\t    pub bdp_frame_option: i32,\n1039\t    pub cwin_max: u64,\n1040\t    pub address_discovery_mode: i32,\n1041\t\n1042\t    // Common flags.\n1043\t    pub initial_random: u32,\n1044\t    pub use_long_log: bool,\n1045\t    pub do_preemptive_repeat: bool,\n1046\t    pub do_not_use_gso: bool,\n1047\t    pub disable_port_blocking: bool,\n1048\t    /// Originally bitfield-gated by `#ifndef\n1049\t    /// WITHOUT_SSLKEYLOG`; v1 follows the canonical build\n1050\t    /// (always defined), so the field is unconditional here.\n1051\t    pub enable_sslkeylog: bool,\n1052\t\n1053\t    // Server only.\n1054\t    pub www_dir: Option<String>,\n1055\t    pub reset_seed: [u8; 16],\n1056\t    /// Borrowed in C (`config_clear` does not free it); owned\n1057\t    /// `Vec<u8>` here for safety.  The C\n1058\t    /// `ticket_encryption_key_length` field is dropped — its value\n1059\t    /// is always `ticket_encryption_key.as_ref().map_or(0, Vec::len)`.\n1060\t    pub ticket_encryption_key: Option<Vec<u8>>,\n1061\t\n1062\t    // Server flags.\n1063\t    pub do_retry: bool,\n1064\t    pub has_reset_seed: bool,\n1065\t\n1066\t    // Client only.\n1067\t    pub ticket_file_name: Option<String>,\n1068\t    pub token_file_name: Option<String>,\n1069\t    pub sni: Option<String>,\n1070\t    pub alpn: Option<String>,\n1071\t    pub out_dir: Option<String>,\n1072\t    pub root_trust_file: Option<String>,\n1073\t    pub cipher_suite_id: i32,\n1074\t    pub proposed_version: u32,\n1075\t    pub desired_version: u32,\n1076\t    pub force_zero_share: bool,\n1077\t    pub no_disk: bool,\n1078\t    pub large_client_hello: bool,\n1079\t\n1080\t    // ECH parameters for server.\n1081\t    pub ech_key_file: Option<String>,\n1082\t    pub ech_config_file: Option<String>,\n1083\t    pub ech_public_name: Option<String>,\n1084\t    /// ECH parameter for the client, base64-decoded.  Owned by\n1085\t    /// the config — `config_clear` frees it in C.  The C\n1086\t    /// `ech_target_len` field is dropped — its value is always\n1087\t    /// `ech_target.as_ref().map_or(0, Vec::len)`.\n1088\t    pub ech_target: Option<Vec<u8>>,\n1089\t\n1090\t    pub flow_control_max: u64,\n1091\t\n1092\t    // Preferred address, encoded as strings.\n1093\t    pub preferred_address_v4: Option<String>,\n1094\t    pub preferred_address_v6: Option<String>,\n1095\t}\n1096\t\n1097\timpl Default for Config {\n1098\t    /// Build a fresh config with the documented C defaults.  C:\n1099\t    /// `picoquic_config_init` (which the C body invoked after a\n1100\t    /// zero-initialising `memset`).\n1101\t    fn default() -> Self {\n1102\t        Config {\n1103\t            nb_connections: 256,\n1104\t            solution_dir: None,\n1105\t            server_cert_file: None,\n1106\t            server_key_file: None,\n1107\t            log_file: None,\n1108\t            bin_dir: None,\n1109\t            qlog_dir: None,\n1110\t            performance_log: None,\n1111\t            server_port: 0,\n1112\t            local_port: 0,\n1113\t            is_port_shared: false,\n1114\t            nb_threads: 0,\n1115\t            dest_if: 0,\n1116\t            mtu_max: 0,\n1117\t            connection_id_length: -1,\n1118\t            idle_timeout: (MICROSEC_HANDSHAKE_MAX.ticks() / 1000) as i32,\n1119\t            socket_buffer_size: 0,\n1120\t            cc_algo_id: None,\n1121\t            cc_algo_option_string: None,\n1122\t            connection_id_cbdata: None,\n1123\t            spinbit_policy: SpinbitVersion::default(),\n1124\t            lossbit_policy: LossbitVersion::default(),\n1125\t            multipath_option: 0,\n1126\t            multipath_alt_config: None,\n1127\t            bdp_frame_option: 0,\n1128\t            cwin_max: u64::MAX,\n1129\t            address_discovery_mode: 0,\n1130\t            initial_random: 3,\n1131\t            use_long_log: false,\n1132\t            do_preemptive_repeat: false,\n1133\t            do_not_use_gso: false,\n1134\t            disable_port_blocking: false,\n1135\t            enable_sslkeylog: false,\n1136\t            www_dir: None,\n1137\t            reset_seed: [0; 16],\n1138\t            ticket_encryption_key: None,\n1139\t            do_retry: false,\n1140\t            has_reset_seed: false,\n1141\t            ticket_file_name: None,\n1142\t            token_file_name: None,\n1143\t            sni: None,\n1144\t            alpn: None,\n1145\t            out_dir: None,\n1146\t            root_trust_file: None,\n1147\t            cipher_suite_id: 0,\n1148\t            proposed_version: 0,\n1149\t            desired_version: 0,\n1150\t            force_zero_share: false,\n1151\t            no_disk: false,\n1152\t            large_client_hello: false,\n1153\t            ech_key_file: None,\n1154\t            ech_config_file: None,\n1155\t            ech_public_name: None,\n1156\t            ech_target: None,\n1157\t            flow_control_max: 0,\n1158\t            preferred_address_v4: None,\n1159\t            preferred_address_v6: None,\n1160\t        }\n1161\t    }\n1162\t}\n1163\t\n1164\timpl Config {\n1165\t    /// Apply one option, selected by `option`, to the config.\n1166\t    /// C: `picoquic_config_set_option`.\n1167\t    ///\n1168\t    /// `value` is optional — flag-style options ([`OptionId::DoRetry`],\n1169\t    /// [`OptionId::LongLog`], …) ignore it; value-style options\n1170\t    /// require it and return `Err` when it is missing or malformed.\n1171\t    ///\n1172\t    /// The C signature returned `int` (`0` ↔ `Ok`, `-1` ↔ `Err`);\n1173\t    /// mapped to `Result<(), Error>`.\n1174\t    pub fn set_option(&mut self, option: OptionId, value: Option<&str>) -> Result<(), Error> {\n1175\t        let entry = option_entry(option).ok_or(Error::InvalidArgument)?;\n1176\t        let params: &[&str] = match value {\n1177\t            Some(v) => &[v],\n1178\t            None => &[],\n1179\t        };\n1180\t        apply_option(self, entry, params)\n1181\t    }\n1182\t\n1183\t    /// Dispatch one option from a single-character flag (`-x`).\n1184\t    /// C: `picoquic_config_command_line`.\n1185\t    ///\n1186\t    /// `p_optind` advances past any extra arguments consumed beyond\n1187\t    /// the inline `optarg`, mirroring the C in/out parameter so that\n1188\t    /// an outer getopt-style loop stays in sync.\n1189\t    ///\n1190\t    /// `argv` is a borrowed slice of borrowed strings — the C caller\n1191\t    /// (`first` etc.) owns the argument vector for the program\n1192\t    /// lifetime, so a borrow is safe.  The C `int argc` parameter is\n1193\t    /// dropped (implicit in `argv.len()`).\n1194\t    pub fn command_line(\n1195\t        &mut self,\n1196\t        opt: char,\n1197\t        p_optind: &mut usize,\n1198\t        argv: &[&str],\n1199\t        optarg: Option<&str>,\n1200\t    ) -> Result<(), Error> {\n1201\t        let (_, entry) = option_entry_by_letter(opt).ok_or(Error::InvalidArgument)?;\n1202\t        let params = collect_params(entry, p_optind, argv, optarg)?;\n1203\t        apply_option(self, entry, &params)\n1204\t    }\n1205\t\n1206\t    /// Like [`Self::command_line`] but accepts both single-character\n1207\t    /// (`-x`) and long-form (`--name`) option strings; the leading\n1208\t    /// dashes are part of `opt_string`, matching the C contract.\n1209\t    /// C: `picoquic_config_command_line_ex`.\n1210\t    pub fn command_line_ex(\n1211\t        &mut self,\n1212\t        opt_string: &str,\n1213\t        p_optind: &mut usize,\n1214\t        argv: &[&str],\n1215\t        optarg: Option<&str>,\n1216\t    ) -> Result<(), Error> {\n1217\t        let (_, entry) = parse_option_string(opt_string).ok_or(Error::InvalidArgument)?;\n1218\t        let params = collect_params(entry, p_optind, argv, optarg)?;\n1219\t        apply_option(self, entry, &params)\n1220\t    }\n1221\t\n1222\t    /// Build the getopt-style option string from the dispatch table\n1223\t    /// in `config.c` — one letter per option, with `:` after each\n1224\t    /// option that takes an argument.  C:\n1225\t    /// `picoquic_config_option_letters`.\n1226\t    ///\n1227\t    /// The C signature wrote into a caller-supplied buffer\n1228\t    /// (`option_string`, `string_max`) and reported the populated\n1229\t    /// length via `*string_length`.  The Rust wrapper owns the\n1230\t    /// buffer and returns it directly, so the buffer-too-small\n1231\t    /// failure mode disappears.\n1232\t    pub fn option_letters() -> String {\n1233\t        let mut s = String::new();\n1234\t        for e in OPTION_TABLE {\n1235\t            s.push(e.letter);\n1236\t            if e.nb_params > 0 {\n1237\t                s.push(':');\n1238\t            }\n1239\t        }\n1240\t        s\n1241\t    }\n1242\t\n1243\t    /// Write the option help to a [`core::fmt::Write`] sink.\n1244\t    /// C: `picoquic_config_usage_file`.\n1245\t    ///\n1246\t    /// The C parameter was `FILE*`; the Rust translation accepts\n1247\t    /// any sink (a `String` buffer, the stdout/stderr handles under\n1248\t    /// the `std` feature, or a custom writer) so the function\n1249\t    /// stays `no_std`-friendly.\n1250\t    pub fn write_usage(w: &mut dyn core::fmt::Write) {\n1251\t        let _ = w.write_str(\"Picoquic options:\\n\");\n1252\t        for e in OPTION_TABLE {\n1253\t            let _ = write!(w, \"  -{} {}\", e.letter, e.param_sample);\n1254\t            let pad = 12usize.saturating_sub(e.param_sample.len());\n1255\t            for _ in 0..pad {\n1256\t                let _ = w.write_char(' ');\n1257\t            }\n1258\t            let _ = writeln!(w, \" {}\", e.help);\n1259\t        }\n1260\t    }\n1261\t\n1262\t    /// Print the option help to stderr.  C: `picoquic_config_usage`.\n1263\t    ///\n1264\t    /// Routes through an intermediate `String` buffer then `eprint!`.\n1265\t    pub fn print_usage() {\n1266\t        let mut buf = String::new();\n1267\t        Self::write_usage(&mut buf);\n1268\t        eprint!(\"{}\", buf);\n1269\t    }\n1270\t\n1271\t    /// Parse a port-configuration string into `server_port`,\n1272\t    /// `local_port`, `is_port_shared`, and `nb_threads`.\n1273\t    /// C: `config_set_port` (internal, called from the `-p` option\n1274\t    /// handler in `picoquic/config.c`).\n1275\t    ///\n1276\t    /// Accepted formats:\n1277\t    /// - `\"\"` / `\"0\"` — clear all (port 0, not shared)\n1278\t    /// - `\"4433\"` — server port only\n1279\t    /// - `\"443:4434\"` — server:local\n1280\t    /// - `\"S4433\"` — shared server port\n1281\t    /// - `\"S443:4434*256\"` — shared server:local, 256 threads\n1282\t    /// - `\"4433*7\"` — server port, 7 threads\n1283\t    ///\n1284\t    /// Returns `Err` when any token cannot be parsed or a port value\n1285\t    /// exceeds 65535.\n1286\t    pub fn set_port(&mut self, port_string: &str) -> Result<(), Error> {\n1287\t        let bytes = port_string.as_bytes();\n1288\t        let mut i = 0;\n1289\t        let mut is_port_shared = false;\n1290\t        let mut p1: i32 = 0;\n1291\t        let mut p2: i32 = 0;\n1292\t        let mut nb_threads: i32 = 0;\n1293\t\n1294\t        if i < bytes.len() && bytes[i] == b'S' {\n1295\t            is_port_shared = true;\n1296\t            i += 1;\n1297\t        }\n1298\t        while i < bytes.len() && bytes[i].is_ascii_digit() {\n1299\t            p1 = p1 * 10 + (bytes[i] - b'0') as i32;\n1300\t            i += 1;\n1301\t        }\n1302\t        if i < bytes.len() && bytes[i] == b':' {\n1303\t            i += 1;\n1304\t            while i < bytes.len() && bytes[i].is_ascii_digit() {\n1305\t                p2 = p2 * 10 + (bytes[i] - b'0') as i32;\n1306\t                i += 1;\n1307\t            }\n1308\t        }\n1309\t        if i < bytes.len() && bytes[i] == b'*' {\n1310\t            i += 1;\n1311\t            while i < bytes.len() && bytes[i].is_ascii_digit() {\n1312\t                nb_threads = nb_threads * 10 + (bytes[i] - b'0') as i32;\n1313\t                i += 1;\n1314\t            }\n1315\t        }\n1316\t        if i != bytes.len() || !(0..=65535).contains(&p1) || !(0..=65535).contains(&p2) {\n1317\t            return Err(Error::InvalidArgument);\n1318\t        }\n1319\t        self.server_port = p1 as u16;\n1320\t        self.local_port = p2 as u16;\n1321\t        self.is_port_shared = is_port_shared;\n1322\t        self.nb_threads = nb_threads;\n1323\t        Ok(())\n1324\t    }\n1325\t\n1326\t    /// Build a fully-configured QUIC context from this config plus\n1327\t    /// an application-supplied callback.  C:\n1328\t    /// `picoquic_create_and_configure`.\n1329\t    ///\n1330\t    /// Returns `None` when context creation fails (the C side\n1331\t    /// returned `NULL`).\n1332\t    ///\n1333\t    /// Pointer-shape choices, derived from the C signature and the\n1334\t    /// body in `config.c`:\n1335\t    ///\n1336\t    /// * `picoquic_quic_config_t* config` is consumed-borrowed\n1337\t    ///   (`&mut self`): the body reads every field and may set up\n1338\t    ///   downstream owned state, but it does not free the struct\n1339\t    ///   itself — ownership stays with the caller.\n1340\t    /// * `default_callback_fn` + `default_callback_ctx` collapse to\n1341\t    ///   one `Option<Box<dyn StreamDataCallback>>` per the\n1342\t    ///   function-pointers-map-to-traits rule, with the `void*`\n1343\t    ///   context folded into the trait implementor's state.  `None`\n1344\t    ///   matches the C \"no default callback\" case where the function\n1345\t    ///   pointer was `NULL`.\n1346\t    /// * `p_simulated_time: *mut u64` carries simulated wall time for\n1347\t    ///   tests; the C QUIC context retains the pointer across calls,\n1348\t    ///   so an `&mut u64` borrow expresses the contract directly.\n1349\t    ///   Phase 3 may revisit (e.g. with a clock trait) once the QUIC\n1350\t    ///   context type is real.\n1351\t    pub fn create_and_configure(\n1352\t        &mut self,\n1353\t        default_callback: Option<Box<dyn StreamDataCallback>>,\n1354\t        current_time: Instant,\n1355\t        _p_simulated_time: Option<&mut u64>,\n1356\t    ) -> Option<Box<Quic>> {\n1357\t        let reset_seed = if self.has_reset_seed {\n1358\t            self.reset_seed\n1359\t        } else {\n1360\t            [0u8; 16]\n1361\t        };\n1362\t\n1363\t        let mut quic = Quic::new(\n1364\t            self.nb_connections,\n1365\t            self.server_cert_file.as_deref(),\n1366\t            self.server_key_file.as_deref(),\n1367\t            self.root_trust_file.as_deref(),\n1368\t            self.alpn.as_deref(),\n1369\t            default_callback,\n1370\t            None,\n1371\t            reset_seed,\n1372\t            current_time,\n1373\t            self.ticket_file_name.as_deref(),\n1374\t            self.ticket_encryption_key.as_deref(),\n1375\t        )?;\n1376\t\n1377\t        if self.do_retry {\n1378\t            quic.set_cookie_mode(1);\n1379\t        } else {\n1380\t            quic.set_cookie_mode(2);\n1381\t        }\n1382\t\n1383\t        if let Some(ref cc_id) = self.cc_algo_id {\n1384\t            let _ = quic.set_default_congestion_algorithm_by_name(cc_id);\n1385\t        }\n1386\t\n1387\t        let _ = quic.set_default_spinbit_policy(self.spinbit_policy);\n1388\t        quic.set_default_lossbit_policy(self.lossbit_policy);\n1389\t        quic.set_default_multipath_option(self.multipath_option);\n1390\t        quic.set_default_idle_timeout(crate::Duration::from_ticks(self.idle_timeout as u64 * 1000));\n1391\t        quic.set_cwin_max(self.cwin_max);\n1392\t        quic.set_default_address_discovery_mode(self.address_discovery_mode);\n1393\t\n1394\t        if let Some(ref token_file) = self.token_file_name {\n1395\t            let _ = quic.load_retry_tokens(token_file);\n1396\t        }\n1397\t\n1398\t        if self.force_zero_share {\n1399\t            quic.client_zero_share = true;\n1400\t        }\n1401\t\n1402\t        if self.mtu_max > 0 {\n1403\t            quic.set_mtu_max(self.mtu_max as u32);\n1404\t        }\n1405\t\n1406\t        if self.connection_id_length != -1 {\n1407\t            let _ = quic.set_default_connection_id_length(self.connection_id_length as u8);\n1408\t        }\n1409\t\n1410\t        quic.set_padding_policy(39, 128);\n1411\t\n1412\t        if let Some(ref bin_dir) = self.bin_dir {\n1413\t            let _ = quic.set_binlog(Some(bin_dir.as_str()));\n1414\t        }\n1415\t\n1416\t        if let Some(ref qlog_dir) = self.qlog_dir {\n1417\t            let _ = quic.set_qlog(qlog_dir.as_str());\n1418\t        }\n1419\t\n1420\t        if let Some(ref log_file) = self.log_file {\n1421\t            let _ = quic.set_textlog(Some(log_file.as_str()));\n1422\t        }\n1423\t\n1424\t        quic.set_log_level(if self.use_long_log { 1 } else { 0 });\n1425\t        quic.set_preemptive_repeat_policy(self.do_preemptive_repeat);\n1426\t        quic.set_port_blocking_disabled(self.disable_port_blocking);\n1427\t        quic.set_sslkeylog_enabled(self.enable_sslkeylog);\n1428\t\n1429\t        if self.initial_random <= 2 {\n1430\t            quic.set_random_initial(self.initial_random as i32);\n1431\t        }\n1432\t\n1433\t        if self.cipher_suite_id != 0 {\n1434\t            let iana_code = match self.cipher_suite_id {\n1435\t                20 => crate::CHACHA20_POLY1305_SHA256,\n1436\t                128 => crate::AES_128_GCM_SHA256,\n1437\t                256 => crate::AES_256_GCM_SHA384,\n1438\t                v => v as u16,\n1439\t            };\n1440\t            let _ = quic.set_cipher_suite(iana_code);\n1441\t        }\n1442\t\n1443\t        if self.do_retry {\n1444\t            quic.set_cookie_mode(1);\n1445\t        } else {\n1446\t            quic.set_cookie_mode(2);\n1447\t        }\n1448\t\n1449\t        quic.set_default_bdp_frame_option(self.bdp_frame_option != 0);\n1450\t\n1451\t        let mut failed = false;\n1452\t\n1453\t        if let Some(ref public_name) = self.ech_public_name {\n1454\t            if self.ech_key_file.is_none() || self.ech_config_file.is_none() {\n1455\t                // key file or config file not specified — cannot create ECH config\n1456\t            } else {\n1457\t                let key_file = self.ech_key_file.as_deref().unwrap();\n1458\t                let cfg_file = self.ech_config_file.as_deref().unwrap();\n1459\t                if crate::ech_create_config_file(public_name, key_file, cfg_file).is_err() {\n1460\t                    failed = true;\n1461\t                }\n1462\t            }\n1463\t        }\n1464\t\n1465\t        if !failed\n1466\t            && (self.ech_key_file.is_some() || self.ech_target.is_some())\n1467\t            && quic\n1468\t                .ech_configure(\n1469\t                    self.ech_key_file.as_deref(),\n1470\t                    self.ech_config_file.as_deref(),\n1471\t                )\n1472\t                .is_err()\n1473\t        {\n1474\t            failed = true;\n1475\t        }\n1476\t\n1477\t        if !failed && self.flow_control_max > 0 {\n1478\t            quic.set_max_data_control(self.flow_control_max);\n1479\t        }\n1480\t\n1481\t        if failed { None } else { Some(quic) }\n1482\t    }\n1483\t}\n1484\t\n1485\t#[cfg(test)]\n1486\tmod test {\n1487\t    use super::*;\n1488\t\n1489\t    // --- config_atoi ---\n1490\t\n1491\t    #[test]\n1492\t    fn atoi_valid_integer() {\n1493\t        assert_eq!(config_atoi(&[\"42\"], 0), Ok(42));\n1494\t    }\n1495\t\n1496\t    #[test]\n1497\t    fn atoi_zero() {\n1498\t        assert_eq!(config_atoi(&[\"0\"], 0), Ok(0));\n1499\t    }\n1500\t\n1501\t    #[test]\n1502\t    fn atoi_multi_digit() {\n1503\t        assert_eq!(config_atoi(&[\"12345\"], 0), Ok(12345));\n1504\t    }\n1505\t\n1506\t    #[test]\n1507\t    fn atoi_out_of_bounds_index() {\n1508\t        assert_eq!(config_atoi(&[\"5\"], 1), Err(Error::InvalidArgument));\n1509\t    }\n1510\t\n1511\t    #[test]\n1512\t    fn atoi_empty_params() {\n1513\t        assert_eq!(config_atoi(&[], 0), Err(Error::InvalidArgument));\n1514\t    }\n1515\t\n1516\t    #[test]\n1517\t    fn atoi_non_digit_char() {\n1518\t        assert_eq!(config_atoi(&[\"12a3\"], 0), Err(Error::InvalidArgument));\n1519\t    }\n1520\t\n1521\t    #[test]\n1522\t    fn atoi_negative_sign_rejected() {\n1523\t        // C version rejects any non-digit byte; '-' is not a digit\n1524\t        assert_eq!(config_atoi(&[\"-5\"], 0), Err(Error::InvalidArgument));\n1525\t    }\n1526\t\n1527\t    // --- config_optval_string ---\n1528\t\n1529\t    #[test]\n1530\t    fn optval_string_copies_within_capacity() {\n1531\t        let mut buf = [0u8; 16];\n1532\t        let result = config_optval_string(&mut buf, b\"hello\");\n1533\t        assert_eq!(result, \"hello\");\n1534\t        assert_eq!(buf[5], 0); // null terminator\n1535\t    }\n1536\t\n1537\t    #[test]\n1538\t    fn optval_string_truncates_to_buffer_minus_one() {\n1539\t        let mut buf = [0u8; 4]; // capacity 4 → max 3 bytes + NUL\n1540\t        let result = config_optval_string(&mut buf, b\"abcdef\");\n1541\t        assert_eq!(result, \"abc\");\n1542\t        assert_eq!(buf[3], 0);\n1543\t    }\n1544\t\n1545\t    #[test]\n1546\t    fn optval_string_empty_input() {\n1547\t        let mut buf = [0xffu8; 8];\n1548\t        let result = config_optval_string(&mut buf, b\"\");\n1549\t        assert_eq!(result, \"\");\n1550\t        assert_eq!(buf[0], 0);\n1551\t    }\n1552\t}\n1553\t"}]},"parent_tool_use_id":null,"session_id":"c9215279-20c1-4a41-9599-fe6fc7f39608","uuid":"d6c08a5a-7387-4d2b-abf6-ae805987f3fb","timestamp":"2026-05-07T14:05:48.252Z","tool_use_result":{"type":"text","file":{"filePath":"/Users/richbarn/Projects/picoquic/rs/fq/src/config.rs","content":"//! Translation of `quic/config.h`.\n//!\n//! Demo-application–facing configuration plumbing for quic-core:\n//! the [`Config`] bag of CLI-derived options, the [`OptionId`]\n//! tag identifying each option, and [`Config::create_and_configure`],\n//! the one-shot constructor that turns a populated config into a\n//! fully-wired [`Quic`].\n//!\n//! Phase 4: all function bodies are implemented.\n//!\n//! Pointer-shape decisions for the config struct were guided by\n//! reading `quic/config.c`:\n//!\n//! * Every `char const*` string field that\n//!   `config_clear` `free`s is owned in C (allocated via\n//!   `config_set_string_param`'s `malloc` + `memcpy`).  These map\n//!   to `Option<String>`; `None` substitutes for the C `NULL`\n//!   sentinel that all callers test before use.\n//! * `multipath_alt_config: *mut char` is owned the same way and\n//!   becomes `Option<String>`.\n//! * `ech_target: uint8_t*` plus `ech_target_len` is owned by the\n//!   config (`config_clear` frees it after the base64\n//!   decode in `option_ECH_client`); it becomes\n//!   `Option<Vec<u8>>` with the length implicit in the vector.\n//! * `ticket_encryption_key: const uint8_t*` is *borrowed* in C —\n//!   `config_clear` does not free it.  Phase 1 stores an\n//!   owned `Option<Vec<u8>>` for safety; in v1 only the demo apps\n//!   set this field, and they can supply an owned buffer.  Phase 3\n//!   may revisit if a caller actually relies on aliasing.  The\n//!   paired `ticket_encryption_key_length` field is dropped — its\n//!   value is always implicit in the Vec length.\n//! * Single-bit `unsigned int : 1` flag bitfields (`use_long_log`,\n//!   `do_retry`, …) collapse to individual `bool` fields.  Every C\n//!   call site reads/writes one bit at a time as a Boolean\n//!   (`config->do_retry = 1`), so the\n//!   integer-with-mask-and-shift translation buys nothing here and\n//!   `bitflags!` is overkill for an unrelated set of flags.\n//! * Bitfield `enable_sslkeylog` is gated by\n//!   `#ifndef WITHOUT_SSLKEYLOG` in C.  v1 follows the\n//!   canonical build (the macro is undefined), so the field is\n//!   always present in Rust; a `cfg`-gated variant lands when the\n//!   build options are translated.\n\nuse crate::Error;\nuse crate::Instant;\nuse crate::internal::MICROSEC_HANDSHAKE_MAX;\nuse crate::{LossbitVersion, Quic, SpinbitVersion, StreamDataCallback};\n\n// ---------------------------------------------------------------------------\n// Option identifiers.\n\n/// One identifier per CLI / API option understood by [`Config`].\n///\n/// Mirrors the C `picoquic_option_enum_t`; variant order is\n/// load-bearing — the option dispatch table in `quic/config.c`\n/// indexes by variant — so the discriminants do not get reordered.\n///\n/// [`OptionId::SslKeyLog`] is unconditional here even though the C\n/// enum gates it on `#ifndef WITHOUT_SSLKEYLOG`, matching the\n/// canonical-build behavior; see the module-level docs for the\n/// rationale.\n#[derive(Debug, Copy, Clone, PartialEq, Eq)]\npub enum OptionId {\n    Cert,\n    Key,\n    ServerPort,\n    ProposedVersion,\n    OutDir,\n    WwwDir,\n    MaxConnections,\n    DoRetry,\n    InitialRandom,\n    ResetSeed,\n    DisablePortBlocking,\n    SolutionDir,\n    CcAlgo,\n    CcOption,\n    Spinbit,\n    Lossbit,\n    Multipath,\n    DestIf,\n    CipherSuite,\n    InitCnxId,\n    LogFile,\n    LongLog,\n    BinlogDir,\n    QlogDir,\n    MtuMax,\n    Sni,\n    Alpn,\n    RootTrustFile,\n    ForceZeroShare,\n    CnxIdLength,\n    NoDisk,\n    IdleTimeout,\n    LargeClientHello,\n    TicketFileName,\n    TokenFileName,\n    SocketBufferSize,\n    PerformanceLog,\n    PreemptiveRepeat,\n    VersionUpgrade,\n    NoGso,\n    BdpFrame,\n    CwinMax,\n    SslKeyLog,\n    AddressDiscovery,\n    EchServer,\n    EchClient,\n    EchInit,\n    FlowControlMax,\n    PreferredV4,\n    PreferredV6,\n    Help,\n}\n\n// ---------------------------------------------------------------------------\n// Option table (mirrors C static option_table[]).\n\nstruct OptionEntry {\n    id: OptionId,\n    letter: char,\n    name: &'static str,\n    nb_params: usize,\n    param_sample: &'static str,\n    help: &'static str,\n}\n\nstatic OPTION_TABLE: &[OptionEntry] = &[\n    OptionEntry {\n        id: OptionId::Cert,\n        letter: 'c',\n        name: \"cert\",\n        nb_params: 1,\n        param_sample: \"file\",\n        help: \"cert file\",\n    },\n    OptionEntry {\n        id: OptionId::Key,\n        letter: 'k',\n        name: \"key\",\n        nb_params: 1,\n        param_sample: \"file\",\n        help: \"key file\",\n    },\n    OptionEntry {\n        id: OptionId::ServerPort,\n        letter: 'p',\n        name: \"port\",\n        nb_params: 1,\n        param_sample: \"number\",\n        help: \"server port\",\n    },\n    OptionEntry {\n        id: OptionId::ProposedVersion,\n        letter: 'v',\n        name: \"proposed_version\",\n        nb_params: 1,\n        param_sample: \"\",\n        help: \"Version proposed by client, e.g. -v ff000012\",\n    },\n    OptionEntry {\n        id: OptionId::OutDir,\n        letter: 'o',\n        name: \"outdir\",\n        nb_params: 1,\n        param_sample: \"folder\",\n        help: \"Folder where client writes downloaded files, defaults to current directory.\",\n    },\n    OptionEntry {\n        id: OptionId::WwwDir,\n        letter: 'w',\n        name: \"wwwdir\",\n        nb_params: 1,\n        param_sample: \"folder\",\n        help: \"Folder containing web pages served by server\",\n    },\n    OptionEntry {\n        id: OptionId::MaxConnections,\n        letter: 'x',\n        name: \"max_connections\",\n        nb_params: 1,\n        param_sample: \"number\",\n        help: \"Maximum number of concurrent connections, default 256\",\n    },\n    OptionEntry {\n        id: OptionId::DoRetry,\n        letter: 'r',\n        name: \"do_retry\",\n        nb_params: 0,\n        param_sample: \"\",\n        help: \"Do Retry Request\",\n    },\n    OptionEntry {\n        id: OptionId::InitialRandom,\n        letter: 'R',\n        name: \"initial_random\",\n        nb_params: 1,\n        param_sample: \"option\",\n        help: \"Randomize packet number spaces: none(0), initial(1, default), all(2).\",\n    },\n    OptionEntry {\n        id: OptionId::ResetSeed,\n        letter: 's',\n        name: \"reset_seed\",\n        nb_params: 1,\n        param_sample: \"<32 hex chars>\",\n        help: \"Reset seed\",\n    },\n    OptionEntry {\n        id: OptionId::DisablePortBlocking,\n        letter: 'X',\n        name: \"disable_block\",\n        nb_params: 0,\n        param_sample: \"\",\n        help: \"Disable the check for blocked ports\",\n    },\n    OptionEntry {\n        id: OptionId::SolutionDir,\n        letter: 'S',\n        name: \"solution_dir\",\n        nb_params: 1,\n        param_sample: \"folder\",\n        help: \"Set the path to the source files to find the default files\",\n    },\n    OptionEntry {\n        id: OptionId::CcAlgo,\n        letter: 'G',\n        name: \"cc_algo\",\n        nb_params: 1,\n        param_sample: \"cc_algorithm\",\n        help: \"Use the specified congestion control algorithm. Defaults to bbr.\",\n    },\n    OptionEntry {\n        id: OptionId::CcOption,\n        letter: 'H',\n        name: \"cco\",\n        nb_params: 1,\n        param_sample: \"option\",\n        help: \"Set option string if required by congestion control algorithm.\",\n    },\n    OptionEntry {\n        id: OptionId::Spinbit,\n        letter: 'P',\n        name: \"spinbit\",\n        nb_params: 1,\n        param_sample: \"number\",\n        help: \"Set the default spinbit policy\",\n    },\n    OptionEntry {\n        id: OptionId::Lossbit,\n        letter: 'O',\n        name: \"lossbit\",\n        nb_params: 1,\n        param_sample: \"number\",\n        help: \"Set the default lossbit policy\",\n    },\n    OptionEntry {\n        id: OptionId::Multipath,\n        letter: 'M',\n        name: \"multipath\",\n        nb_params: 0,\n        param_sample: \"\",\n        help: \"Enable QUIC multipath extension\",\n    },\n    OptionEntry {\n        id: OptionId::DestIf,\n        letter: 'e',\n        name: \"dest_if\",\n        nb_params: 1,\n        param_sample: \"if\",\n        help: \"Send on interface (default: -1)\",\n    },\n    OptionEntry {\n        id: OptionId::CipherSuite,\n        letter: 'C',\n        name: \"cipher_suite\",\n        nb_params: 1,\n        param_sample: \"cipher_suite_id\",\n        help: \"specify cipher suite (e.g. -C 20 = chacha20)\",\n    },\n    OptionEntry {\n        id: OptionId::InitCnxId,\n        letter: 'i',\n        name: \"cnxid_params\",\n        nb_params: 1,\n        param_sample: \"per-text-lb-spec\",\n        help: \"See documentation for LB compatible CID configuration\",\n    },\n    OptionEntry {\n        id: OptionId::LogFile,\n        letter: 'l',\n        name: \"text_log\",\n        nb_params: 1,\n        param_sample: \"file\",\n        help: \"Log file, Log to stdout if file = \\\"-\\\". No text logging if absent.\",\n    },\n    OptionEntry {\n        id: OptionId::LongLog,\n        letter: 'L',\n        name: \"long_log\",\n        nb_params: 0,\n        param_sample: \"\",\n        help: \"Log all packets. If absent, log stops after 100 packets.\",\n    },\n    OptionEntry {\n        id: OptionId::BinlogDir,\n        letter: 'b',\n        name: \"binlog_dir\",\n        nb_params: 1,\n        param_sample: \"folder\",\n        help: \"Binary logging to this directory. No binary logging if absent.\",\n    },\n    OptionEntry {\n        id: OptionId::QlogDir,\n        letter: 'q',\n        name: \"qlog_dir\",\n        nb_params: 1,\n        param_sample: \"folder\",\n        help: \"Qlog logging to this directory.\",\n    },\n    OptionEntry {\n        id: OptionId::MtuMax,\n        letter: 'm',\n        name: \"mtu_max\",\n        nb_params: 1,\n        param_sample: \"mtu_max\",\n        help: \"Largest mtu value that can be tried for discovery.\",\n    },\n    OptionEntry {\n        id: OptionId::Sni,\n        letter: 'n',\n        name: \"sni\",\n        nb_params: 1,\n        param_sample: \"sni\",\n        help: \"sni (default: server name)\",\n    },\n    OptionEntry {\n        id: OptionId::Alpn,\n        letter: 'a',\n        name: \"alpn\",\n        nb_params: 1,\n        param_sample: \"alpn\",\n        help: \"alpn (default function of version)\",\n    },\n    OptionEntry {\n        id: OptionId::RootTrustFile,\n        letter: 't',\n        name: \"root_trust_file\",\n        nb_params: 1,\n        param_sample: \"file\",\n        help: \"root trust file\",\n    },\n    OptionEntry {\n        id: OptionId::ForceZeroShare,\n        letter: 'z',\n        name: \"force_zero_share\",\n        nb_params: 0,\n        param_sample: \"\",\n        help: \"Set TLS zero share behavior on client, to force HRR\",\n    },\n    OptionEntry {\n        id: OptionId::CnxIdLength,\n        letter: 'I',\n        name: \"cnxid_length\",\n        nb_params: 1,\n        param_sample: \"length\",\n        help: \"Length of CNX_ID used by the client, default=8\",\n    },\n    OptionEntry {\n        id: OptionId::IdleTimeout,\n        letter: 'd',\n        name: \"idle_timeout\",\n        nb_params: 1,\n        param_sample: \"ms\",\n        help: \"Duration of idle timeout in milliseconds (Default 30,000ms)\",\n    },\n    OptionEntry {\n        id: OptionId::NoDisk,\n        letter: 'D',\n        name: \"no_disk\",\n        nb_params: 0,\n        param_sample: \"\",\n        help: \"no disk: do not save received files on disk\",\n    },\n    OptionEntry {\n        id: OptionId::LargeClientHello,\n        letter: 'Q',\n        name: \"large_client_hello\",\n        nb_params: 0,\n        param_sample: \"\",\n        help: \"send a large client hello in order to test post quantum readiness\",\n    },\n    OptionEntry {\n        id: OptionId::TicketFileName,\n        letter: 'T',\n        name: \"ticket_file\",\n        nb_params: 1,\n        param_sample: \"file\",\n        help: \"File storing the session tickets\",\n    },\n    OptionEntry {\n        id: OptionId::TokenFileName,\n        letter: 'N',\n        name: \"token_file\",\n        nb_params: 1,\n        param_sample: \"file\",\n        help: \"File storing the new tokens\",\n    },\n    OptionEntry {\n        id: OptionId::SocketBufferSize,\n        letter: 'B',\n        name: \"so_buf_size\",\n        nb_params: 1,\n        param_sample: \"number\",\n        help: \"Set buffer size with SO_SNDBUF SO_RCVBUF\",\n    },\n    OptionEntry {\n        id: OptionId::PerformanceLog,\n        letter: 'F',\n        name: \"log_file_name\",\n        nb_params: 1,\n        param_sample: \"file\",\n        help: \"Append performance reports to performance log\",\n    },\n    OptionEntry {\n        id: OptionId::PreemptiveRepeat,\n        letter: 'V',\n        name: \"preemptive_repeat\",\n        nb_params: 0,\n        param_sample: \"\",\n        help: \"enable preemptive repeat\",\n    },\n    OptionEntry {\n        id: OptionId::VersionUpgrade,\n        letter: 'U',\n        name: \"version_upgrade\",\n        nb_params: 1,\n        param_sample: \"\",\n        help: \"Version upgrade if server agrees, e.g. -U 6b3343cf\",\n    },\n    OptionEntry {\n        id: OptionId::NoGso,\n        letter: '0',\n        name: \"no_gso\",\n        nb_params: 0,\n        param_sample: \"\",\n        help: \"Do not use UDP GSO or equivalent\",\n    },\n    OptionEntry {\n        id: OptionId::BdpFrame,\n        letter: 'j',\n        name: \"bdp\",\n        nb_params: 1,\n        param_sample: \"number\",\n        help: \"use bdp extension frame(1) or don't (0). Default=0\",\n    },\n    OptionEntry {\n        id: OptionId::CwinMax,\n        letter: 'W',\n        name: \"cwin_max\",\n        nb_params: 1,\n        param_sample: \"bytes\",\n        help: \"Max value for CWIN. Default=UINT64_MAX\",\n    },\n    OptionEntry {\n        id: OptionId::SslKeyLog,\n        letter: '8',\n        name: \"sslkeylog\",\n        nb_params: 0,\n        param_sample: \"\",\n        help: \"Enable SSLKEYLOG\",\n    },\n    OptionEntry {\n        id: OptionId::AddressDiscovery,\n        letter: 'J',\n        name: \"addr_disc\",\n        nb_params: 1,\n        param_sample: \"mode\",\n        help: \"provider (0), receiver (1) or both (2).\",\n    },\n    OptionEntry {\n        id: OptionId::EchServer,\n        letter: 'E',\n        name: \"ech_s\",\n        nb_params: 2,\n        param_sample: \"key config\",\n        help: \"ECH private key file, config file. Default= no ECH on server.\",\n    },\n    OptionEntry {\n        id: OptionId::EchInit,\n        letter: 'y',\n        name: \"ech_init\",\n        nb_params: 1,\n        param_sample: \"public_name\",\n        help: \"Create an ECH configuration before applying the `ech_s` parameter.\",\n    },\n    OptionEntry {\n        id: OptionId::EchClient,\n        letter: 'K',\n        name: \"ech_c\",\n        nb_params: 1,\n        param_sample: \"base64\",\n        help: \"ECH configuration for the client connection, base64 encoded.\",\n    },\n    OptionEntry {\n        id: OptionId::FlowControlMax,\n        letter: 'Z',\n        name: \"flow_control_max\",\n        nb_params: 1,\n        param_sample: \"bytes\",\n        help: \"Set the flow control's initial max data.\",\n    },\n    OptionEntry {\n        id: OptionId::PreferredV4,\n        letter: '4',\n        name: \"preferred_v4\",\n        nb_params: 1,\n        param_sample: \"ip[:port]\",\n        help: \"Preferred address for v4 connections.\",\n    },\n    OptionEntry {\n        id: OptionId::PreferredV6,\n        letter: '6',\n        name: \"preferred_v6\",\n        nb_params: 1,\n        param_sample: \"ipv6[:port]\",\n        help: \"Preferred address for v6 connections.\",\n    },\n    OptionEntry {\n        id: OptionId::Help,\n        letter: 'h',\n        name: \"help\",\n        nb_params: 0,\n        param_sample: \"\",\n        help: \"This help message\",\n    },\n];\n\n/// C: `config_parse_target_version` (picoquic/config.c:116)\n///\n/// Parses a hex-encoded QUIC version number.  Returns 0 on any invalid input,\n/// matching the C behaviour of breaking on the first unrecognised character.\nfn parse_hex_version(s: &str) -> u32 {\n    u32::from_str_radix(s, 16).unwrap_or(0)\n}\n\n/// C: `config_optval_string` (picoquic/config.c:181)\n///\n/// Copies at most `buffer.len() - 1` bytes from `p` into `buffer`,\n/// null-terminates, and returns the filled prefix as a `str`.\n/// Matches the C truncation-and-NUL-terminate contract exactly.\nfn config_optval_string<'a>(buffer: &'a mut [u8], p: &[u8]) -> &'a str {\n    let len = p.len().min(buffer.len().saturating_sub(1));\n    buffer[..len].copy_from_slice(&p[..len]);\n    if !buffer.is_empty() {\n        buffer[len] = 0;\n    }\n    core::str::from_utf8(&buffer[..len]).unwrap_or(\"\")\n}\n\n/// C: `config_atoi` (picoquic/config.c:202)\n///\n/// Parse a decimal (ASCII digit only) integer from `params[x]`.\n///\n/// Returns `Ok(value)` on success.  Returns `Err(InvalidArgument)` when `x`\n/// is out of bounds or any character in `params[x]` is not an ASCII digit —\n/// mirroring the C behaviour of setting `*ret = -1` and returning `-1` on error.\npub fn config_atoi(params: &[&str], x: usize) -> Result<i32, Error> {\n    if x >= params.len() {\n        return Err(Error::InvalidArgument);\n    }\n    let mut v: i32 = 0;\n    for b in params[x].bytes() {\n        let digit = b.wrapping_sub(b'0');\n        if digit > 9 {\n            return Err(Error::InvalidArgument);\n        }\n        v = v * 10 + digit as i32;\n    }\n    Ok(v)\n}\n\nfn base64_decode(s: &str) -> Result<Vec<u8>, Error> {\n    let mut table = [0xFFu8; 256];\n    for (i, &c) in b\"ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789+/\"\n        .iter()\n        .enumerate()\n    {\n        table[c as usize] = i as u8;\n    }\n    let bytes: Vec<u8> = s.bytes().filter(|&c| c != b'=').collect();\n    let mut out = Vec::new();\n    for chunk in bytes.chunks(4) {\n        let mut v = [0u8; 4];\n        let n = chunk.len();\n        for (i, &b) in chunk.iter().enumerate() {\n            let x = table[b as usize];\n            if x == 0xFF {\n                return Err(Error::InvalidArgument);\n            }\n            v[i] = x;\n        }\n        out.push((v[0] << 2) | (v[1] >> 4));\n        if n >= 3 {\n            out.push((v[1] << 4) | (v[2] >> 2));\n        }\n        if n == 4 {\n            out.push((v[2] << 6) | v[3]);\n        }\n    }\n    Ok(out)\n}\n\nfn option_entry(id: OptionId) -> Option<&'static OptionEntry> {\n    OPTION_TABLE.iter().find(|e| e.id == id)\n}\n\nfn option_entry_by_letter(letter: char) -> Option<(usize, &'static OptionEntry)> {\n    OPTION_TABLE\n        .iter()\n        .enumerate()\n        .find(|(_, e)| e.letter == letter)\n}\n\nfn option_entry_by_name(name: &str) -> Option<(usize, &'static OptionEntry)> {\n    OPTION_TABLE\n        .iter()\n        .enumerate()\n        .find(|(_, e)| e.name == name)\n}\n\n/// C: `config_set_string_param` (picoquic/config.c:148)\n///\n/// Replace `*v` with an owned copy of `params[x]`.  Clears `*v` first\n/// (mirrors the `free(*v)` in C), then sets it if the selected param\n/// is non-empty.  Returns `Err(InvalidArgument)` when `x` is out of\n/// bounds or the param is empty (the C path where `length == 0` causes\n/// `malloc` to be skipped and `-1` is returned).\n#[allow(dead_code)]\nfn config_set_string_param(v: &mut Option<String>, params: &[&str], x: usize) -> Result<(), Error> {\n    *v = None;\n    if x < params.len() && !params[x].is_empty() {\n        *v = Some(params[x].to_string());\n        Ok(())\n    } else {\n        Err(Error::InvalidArgument)\n    }\n}\n\n/// C: `picoquic_config_get_option_char_index` (picoquic/config.c:641)\n///\n/// Return the index in `OPTION_TABLE` of the entry whose single-character\n/// flag equals `opt`, or `-1` if not found.\npub fn picoquic_config_get_option_char_index(opt: char) -> i32 {\n    OPTION_TABLE\n        .iter()\n        .position(|e| e.letter == opt)\n        .map_or(-1, |i| i as i32)\n}\n\n/// C: `picoquic_config_get_option_name_index` (picoquic/config.c:654)\n///\n/// Return the index in `OPTION_TABLE` of the first entry whose long name\n/// matches the first `l` bytes of `s` (mirrors `strncmp(s, name, l) == 0`),\n/// or `-1` if not found.\npub fn picoquic_config_get_option_name_index(s: &str, l: usize) -> i32 {\n    let l = l.min(s.len());\n    let prefix = &s[..l];\n    OPTION_TABLE\n        .iter()\n        .position(|e| e.name.len() >= l && &e.name[..l] == prefix)\n        .map_or(-1, |i| i as i32)\n}\n\nfn apply_option(config: &mut Config, entry: &OptionEntry, params: &[&str]) -> Result<(), Error> {\n    let p0 = params.first().copied();\n    let p1 = params.get(1).copied();\n    match entry.id {\n        OptionId::Cert => {\n            config.server_cert_file = Some(p0.ok_or(Error::InvalidArgument)?.to_string());\n        }\n        OptionId::Key => {\n            config.server_key_file = Some(p0.ok_or(Error::InvalidArgument)?.to_string());\n        }\n        OptionId::ServerPort => {\n            config.set_port(p0.ok_or(Error::InvalidArgument)?)?;\n        }\n        OptionId::ProposedVersion => {\n            let v = parse_hex_version(p0.ok_or(Error::InvalidArgument)?);\n            if v == 0 {\n                return Err(Error::InvalidArgument);\n            }\n            config.proposed_version = v;\n        }\n        OptionId::OutDir => {\n            config.out_dir = Some(p0.ok_or(Error::InvalidArgument)?.to_string());\n        }\n        OptionId::WwwDir => {\n            config.www_dir = Some(p0.ok_or(Error::InvalidArgument)?.to_string());\n        }\n        OptionId::MaxConnections => {\n            let v: i32 = p0\n                .ok_or(Error::InvalidArgument)?\n                .parse()\n                .map_err(|_| Error::InvalidArgument)?;\n            if v <= 0 {\n                return Err(Error::InvalidArgument);\n            }\n            config.nb_connections = v as u32;\n        }\n        OptionId::DoRetry => {\n            config.do_retry = true;\n        }\n        OptionId::InitialRandom => {\n            let v: i32 = p0\n                .ok_or(Error::InvalidArgument)?\n                .parse()\n                .map_err(|_| Error::InvalidArgument)?;\n            if !(0..=2).contains(&v) {\n                return Err(Error::InvalidArgument);\n            }\n            config.initial_random = v as u32;\n        }\n        OptionId::ResetSeed => {\n            config.has_reset_seed = true;\n            let n =\n                crate::utils::parse_hexa(p0.ok_or(Error::InvalidArgument)?, &mut config.reset_seed);\n            if n != config.reset_seed.len() {\n                return Err(Error::InvalidArgument);\n            }\n        }\n        OptionId::DisablePortBlocking => {\n            config.disable_port_blocking = true;\n        }\n        OptionId::SslKeyLog => {\n            config.enable_sslkeylog = true;\n        }\n        OptionId::SolutionDir => {\n            config.solution_dir = Some(p0.ok_or(Error::InvalidArgument)?.to_string());\n        }\n        OptionId::CcAlgo => {\n            config.cc_algo_id = Some(p0.ok_or(Error::InvalidArgument)?.to_string());\n        }\n        OptionId::CcOption => {\n            config.cc_algo_option_string = Some(p0.ok_or(Error::InvalidArgument)?.to_string());\n        }\n        OptionId::Spinbit => {\n            let v: i32 = p0\n                .ok_or(Error::InvalidArgument)?\n                .parse()\n                .map_err(|_| Error::InvalidArgument)?;\n            config.spinbit_policy = match v {\n                0 => SpinbitVersion::Basic,\n                1 => SpinbitVersion::Random,\n                2 => SpinbitVersion::Null,\n                3 => SpinbitVersion::On,\n                _ => return Err(Error::InvalidArgument),\n            };\n        }\n        OptionId::Lossbit => {\n            let v: i32 = p0\n                .ok_or(Error::InvalidArgument)?\n                .parse()\n                .map_err(|_| Error::InvalidArgument)?;\n            config.lossbit_policy = match v {\n                0 => LossbitVersion::None,\n                1 => LossbitVersion::SendOnly,\n                2 => LossbitVersion::SendReceive,\n                _ => return Err(Error::InvalidArgument),\n            };\n        }\n        OptionId::Multipath => {\n            config.multipath_option = 1;\n        }\n        OptionId::DestIf => {\n            config.dest_if = p0\n                .ok_or(Error::InvalidArgument)?\n                .parse()\n                .map_err(|_| Error::InvalidArgument)?;\n        }\n        OptionId::CipherSuite => {\n            config.cipher_suite_id = p0\n                .ok_or(Error::InvalidArgument)?\n                .parse()\n                .map_err(|_| Error::InvalidArgument)?;\n        }\n        OptionId::InitCnxId => {\n            config.connection_id_cbdata = Some(p0.ok_or(Error::InvalidArgument)?.to_string());\n        }\n        OptionId::LogFile => {\n            config.log_file = Some(p0.ok_or(Error::InvalidArgument)?.to_string());\n        }\n        OptionId::LongLog => {\n            config.use_long_log = true;\n        }\n        OptionId::BinlogDir => {\n            config.bin_dir = Some(p0.ok_or(Error::InvalidArgument)?.to_string());\n        }\n        OptionId::QlogDir => {\n            config.qlog_dir = Some(p0.ok_or(Error::InvalidArgument)?.to_string());\n        }\n        OptionId::MtuMax => {\n            let v: i32 = p0\n                .ok_or(Error::InvalidArgument)?\n                .parse()\n                .map_err(|_| Error::InvalidArgument)?;\n            if v <= 0 || v > crate::internal::MAX_PACKET_SIZE as i32 {\n                return Err(Error::InvalidArgument);\n            }\n            config.mtu_max = v;\n        }\n        OptionId::Sni => {\n            config.sni = Some(p0.ok_or(Error::InvalidArgument)?.to_string());\n        }\n        OptionId::Alpn => {\n            config.alpn = Some(p0.ok_or(Error::InvalidArgument)?.to_string());\n        }\n        OptionId::RootTrustFile => {\n            config.root_trust_file = Some(p0.ok_or(Error::InvalidArgument)?.to_string());\n        }\n        OptionId::ForceZeroShare => {\n            config.force_zero_share = true;\n        }\n        OptionId::CnxIdLength => {\n            let v: i32 = p0\n                .ok_or(Error::InvalidArgument)?\n                .parse()\n                .map_err(|_| Error::InvalidArgument)?;\n            if v < 0 || v > crate::CONNECTION_ID_MAX_SIZE as i32 {\n                return Err(Error::InvalidArgument);\n            }\n            config.connection_id_length = v;\n        }\n        OptionId::IdleTimeout => {\n            let v: i32 = p0\n                .ok_or(Error::InvalidArgument)?\n                .parse()\n                .map_err(|_| Error::InvalidArgument)?;\n            if v < 0 {\n                return Err(Error::InvalidArgument);\n            }\n            config.idle_timeout = v;\n        }\n        OptionId::NoDisk => {\n            config.no_disk = true;\n        }\n        OptionId::LargeClientHello => {\n            config.large_client_hello = true;\n        }\n        OptionId::TicketFileName => {\n            config.ticket_file_name = Some(p0.ok_or(Error::InvalidArgument)?.to_string());\n        }\n        OptionId::TokenFileName => {\n            config.token_file_name = Some(p0.ok_or(Error::InvalidArgument)?.to_string());\n        }\n        OptionId::SocketBufferSize => {\n            let v: i32 = p0\n                .ok_or(Error::InvalidArgument)?\n                .parse()\n                .map_err(|_| Error::InvalidArgument)?;\n            if v < 0 {\n                return Err(Error::InvalidArgument);\n            }\n            config.socket_buffer_size = v;\n        }\n        OptionId::PerformanceLog => {\n            config.performance_log = Some(p0.ok_or(Error::InvalidArgument)?.to_string());\n        }\n        OptionId::PreemptiveRepeat => {\n            config.do_preemptive_repeat = true;\n        }\n        OptionId::VersionUpgrade => {\n            let v = parse_hex_version(p0.ok_or(Error::InvalidArgument)?);\n            if v == 0 {\n                return Err(Error::InvalidArgument);\n            }\n            config.desired_version = v;\n        }\n        OptionId::NoGso => {\n            config.do_not_use_gso = true;\n        }\n        OptionId::BdpFrame => {\n            let v: i32 = p0\n                .ok_or(Error::InvalidArgument)?\n                .parse()\n                .map_err(|_| Error::InvalidArgument)?;\n            if !(0..=1).contains(&v) {\n                return Err(Error::InvalidArgument);\n            }\n            config.bdp_frame_option = v;\n        }\n        OptionId::CwinMax => {\n            let v: i64 = p0\n                .ok_or(Error::InvalidArgument)?\n                .parse()\n                .map_err(|_| Error::InvalidArgument)?;\n            if v < 0 {\n                return Err(Error::InvalidArgument);\n            }\n            config.cwin_max = if v == 0 { u64::MAX } else { v as u64 };\n        }\n        OptionId::AddressDiscovery => {\n            let v: i32 = p0\n                .ok_or(Error::InvalidArgument)?\n                .parse()\n                .map_err(|_| Error::InvalidArgument)?;\n            if !(0..=2).contains(&v) {\n                return Err(Error::InvalidArgument);\n            }\n            config.address_discovery_mode = v + 1;\n        }\n        OptionId::EchServer => {\n            config.ech_key_file = Some(p0.ok_or(Error::InvalidArgument)?.to_string());\n            if let Some(s) = p1 {\n                config.ech_config_file = Some(s.to_string());\n            }\n        }\n        OptionId::EchInit => {\n            config.ech_public_name = Some(p0.ok_or(Error::InvalidArgument)?.to_string());\n        }\n        OptionId::EchClient => {\n            let s = p0.ok_or(Error::InvalidArgument)?;\n            if s == \"-\" {\n                config.ech_target = None;\n            } else {\n                config.ech_target = Some(base64_decode(s).map_err(|_| Error::InvalidArgument)?);\n            }\n        }\n        OptionId::FlowControlMax => {\n            let v: i64 = p0\n                .ok_or(Error::InvalidArgument)?\n                .parse()\n                .map_err(|_| Error::InvalidArgument)?;\n            if v < 0 {\n                return Err(Error::InvalidArgument);\n            }\n            config.flow_control_max = v as u64;\n        }\n        OptionId::PreferredV4 => {\n            config.preferred_address_v4 = Some(p0.ok_or(Error::InvalidArgument)?.to_string());\n        }\n        OptionId::PreferredV6 => {\n            config.preferred_address_v6 = Some(p0.ok_or(Error::InvalidArgument)?.to_string());\n        }\n        OptionId::Help => {\n            return Err(Error::InvalidArgument);\n        }\n    }\n    Ok(())\n}\n\nfn collect_params<'a>(\n    entry: &OptionEntry,\n    p_optind: &mut usize,\n    argv: &[&'a str],\n    optarg: Option<&'a str>,\n) -> Result<Vec<&'a str>, Error> {\n    let mut params = Vec::new();\n    if entry.nb_params > 0 {\n        params.push(optarg.ok_or(Error::InvalidArgument)?);\n        let mut nb = 1;\n        while nb < entry.nb_params {\n            if *p_optind >= argv.len() {\n                return Err(Error::InvalidArgument);\n            }\n            params.push(argv[*p_optind]);\n            *p_optind += 1;\n            nb += 1;\n        }\n    }\n    Ok(params)\n}\n\nfn parse_option_string(opt_string: &str) -> Option<(usize, &'static OptionEntry)> {\n    if opt_string.starts_with(\"--\") && opt_string.len() > 2 {\n        option_entry_by_name(&opt_string[2..])\n    } else if opt_string.starts_with('-') && opt_string.len() == 2 {\n        opt_string.chars().nth(1).and_then(option_entry_by_letter)\n    } else {\n        None\n    }\n}\n\n// ---------------------------------------------------------------------------\n// Configuration struct.\n\n/// Configuration bag for a QUIC context, populated from CLI flags\n/// (via [`Config::command_line`]) or directly (via\n/// [`Config::set_option`]) and consumed by\n/// [`Config::create_and_configure`].\n///\n/// Mirrors the C `picoquic_quic_config_t` field-for-field;\n/// `repr(C)` is dropped because the struct never crosses an\n/// external boundary.  See the module-level docs for the\n/// pointer-shape rationale.\n///\n/// `Default` produces the documented C defaults:\n/// `nb_connections = 256`, `connection_id_length = -1`, `cwin_max =\n/// u64::MAX`, idle timeout from `MICROSEC_HANDSHAKE_MAX`, etc.  This\n/// folds the C `picoquic_config_init` step into the constructor —\n/// the C `config_clear` (which `free`s every owned string) collapses\n/// to `Drop`, and resetting a config to defaults is just\n/// `*config = Config::default()`.\n#[derive(Debug)]\npub struct Config {\n    pub nb_connections: u32,\n    pub solution_dir: Option<String>,\n    pub server_cert_file: Option<String>,\n    pub server_key_file: Option<String>,\n    pub log_file: Option<String>,\n    pub bin_dir: Option<String>,\n    pub qlog_dir: Option<String>,\n    pub performance_log: Option<String>,\n    pub server_port: u16,\n    pub local_port: u16,\n    /// Whether the public port is shared with sibling threads\n    /// (`SO_REUSEPORT`).  C: `int is_port_shared`, used as a\n    /// Boolean flag.\n    pub is_port_shared: bool,\n    pub nb_threads: i32,\n    pub dest_if: i32,\n    pub mtu_max: i32,\n    /// `-1` is the C \"unset\" sentinel applied by [`Self::init`];\n    /// values `>= 0` set the connection-ID length explicitly.  Kept\n    /// as `i32` rather than `Option<u8>` for source-level parity\n    /// with the C body.\n    pub connection_id_length: i32,\n    pub idle_timeout: i32,\n    pub socket_buffer_size: i32,\n    pub cc_algo_id: Option<String>,\n    pub cc_algo_option_string: Option<String>,\n    pub connection_id_cbdata: Option<String>,\n    pub spinbit_policy: SpinbitVersion,\n    pub lossbit_policy: LossbitVersion,\n    pub multipath_option: i32,\n    pub multipath_alt_config: Option<String>,\n    pub bdp_frame_option: i32,\n    pub cwin_max: u64,\n    pub address_discovery_mode: i32,\n\n    // Common flags.\n    pub initial_random: u32,\n    pub use_long_log: bool,\n    pub do_preemptive_repeat: bool,\n    pub do_not_use_gso: bool,\n    pub disable_port_blocking: bool,\n    /// Originally bitfield-gated by `#ifndef\n    /// WITHOUT_SSLKEYLOG`; v1 follows the canonical build\n    /// (always defined), so the field is unconditional here.\n    pub enable_sslkeylog: bool,\n\n    // Server only.\n    pub www_dir: Option<String>,\n    pub reset_seed: [u8; 16],\n    /// Borrowed in C (`config_clear` does not free it); owned\n    /// `Vec<u8>` here for safety.  The C\n    /// `ticket_encryption_key_length` field is dropped — its value\n    /// is always `ticket_encryption_key.as_ref().map_or(0, Vec::len)`.\n    pub ticket_encryption_key: Option<Vec<u8>>,\n\n    // Server flags.\n    pub do_retry: bool,\n    pub has_reset_seed: bool,\n\n    // Client only.\n    pub ticket_file_name: Option<String>,\n    pub token_file_name: Option<String>,\n    pub sni: Option<String>,\n    pub alpn: Option<String>,\n    pub out_dir: Option<String>,\n    pub root_trust_file: Option<String>,\n    pub cipher_suite_id: i32,\n    pub proposed_version: u32,\n    pub desired_version: u32,\n    pub force_zero_share: bool,\n    pub no_disk: bool,\n    pub large_client_hello: bool,\n\n    // ECH parameters for server.\n    pub ech_key_file: Option<String>,\n    pub ech_config_file: Option<String>,\n    pub ech_public_name: Option<String>,\n    /// ECH parameter for the client, base64-decoded.  Owned by\n    /// the config — `config_clear` frees it in C.  The C\n    /// `ech_target_len` field is dropped — its value is always\n    /// `ech_target.as_ref().map_or(0, Vec::len)`.\n    pub ech_target: Option<Vec<u8>>,\n\n    pub flow_control_max: u64,\n\n    // Preferred address, encoded as strings.\n    pub preferred_address_v4: Option<String>,\n    pub preferred_address_v6: Option<String>,\n}\n\nimpl Default for Config {\n    /// Build a fresh config with the documented C defaults.  C:\n    /// `picoquic_config_init` (which the C body invoked after a\n    /// zero-initialising `memset`).\n    fn default() -> Self {\n        Config {\n            nb_connections: 256,\n            solution_dir: None,\n            server_cert_file: None,\n            server_key_file: None,\n            log_file: None,\n            bin_dir: None,\n            qlog_dir: None,\n            performance_log: None,\n            server_port: 0,\n            local_port: 0,\n            is_port_shared: false,\n            nb_threads: 0,\n            dest_if: 0,\n            mtu_max: 0,\n            connection_id_length: -1,\n            idle_timeout: (MICROSEC_HANDSHAKE_MAX.ticks() / 1000) as i32,\n            socket_buffer_size: 0,\n            cc_algo_id: None,\n            cc_algo_option_string: None,\n            connection_id_cbdata: None,\n            spinbit_policy: SpinbitVersion::default(),\n            lossbit_policy: LossbitVersion::default(),\n            multipath_option: 0,\n            multipath_alt_config: None,\n            bdp_frame_option: 0,\n            cwin_max: u64::MAX,\n            address_discovery_mode: 0,\n            initial_random: 3,\n            use_long_log: false,\n            do_preemptive_repeat: false,\n            do_not_use_gso: false,\n            disable_port_blocking: false,\n            enable_sslkeylog: false,\n            www_dir: None,\n            reset_seed: [0; 16],\n            ticket_encryption_key: None,\n            do_retry: false,\n            has_reset_seed: false,\n            ticket_file_name: None,\n            token_file_name: None,\n            sni: None,\n            alpn: None,\n            out_dir: None,\n            root_trust_file: None,\n            cipher_suite_id: 0,\n            proposed_version: 0,\n            desired_version: 0,\n            force_zero_share: false,\n            no_disk: false,\n            large_client_hello: false,\n            ech_key_file: None,\n            ech_config_file: None,\n            ech_public_name: None,\n            ech_target: None,\n            flow_control_max: 0,\n            preferred_address_v4: None,\n            preferred_address_v6: None,\n        }\n    }