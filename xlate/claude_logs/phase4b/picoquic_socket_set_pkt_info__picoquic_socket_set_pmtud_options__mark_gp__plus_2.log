{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01BXPmoDbh7SQTJf3XNUs1mT","type":"tool_result","content":"1\t//! Token-based splay tree.\n2\t//!\n3\t//! Replaces the C `picosplay_tree_t` (top-down splay with intrusive\n4\t//! `picosplay_node_t`s embedded in the caller's structs and four\n5\t//! function pointers — `comparator`, `create`, `delete_node`,\n6\t//! `node_value` — plumbed through the API).\n7\t//!\n8\t//! ## API shape\n9\t//!\n10\t//! `SplayTree<K, V>` is a slotmap-backed ordered map.  `K: Ord`\n11\t//! provides comparison; `V` is the stored value (typically a\n12\t//! token into another arena).  Callers handle [`SplayToken`]s\n13\t//! returned by `insert`/`find`; the parent/left/right linkage\n14\t//! lives inside the slot, never inside the caller's struct.\n15\t//!\n16\t//! Tokens are stable across operations on *other* keys.  A splay\n17\t//! rotation that lifts node A to the root rewrites the linkage of\n18\t//! the rotation path, but slot indices don't move and tokens for\n19\t//! those nodes stay valid.  Removal bumps the slot's generation\n20\t//! and frees the slot for reuse — old tokens then return `None`\n21\t//! from [`SplayTree::get`].\n22\t//!\n23\t//! ## Phase 4 plan — implementation\n24\t//!\n25\t//! Phase 4: hand-rolled slotmap + splay tree.  One of:\n26\t//!\n27\t//! 1. **Hand-roll the slotmap.**  Internal layout:\n28\t//!\n29\t//!    ```ignore\n30\t//!    struct Slot<K, V> {\n31\t//!        generation: u32,\n32\t//!        state: SlotState<K, V>,\n33\t//!    }\n34\t//!    enum SlotState<K, V> {\n35\t//!        Free   { next_free: Option<u32> },\n36\t//!        Filled {\n37\t//!            key:    K,\n38\t//!            value:  V,\n39\t//!            parent: Option<u32>,\n40\t//!            left:   Option<u32>,\n41\t//!            right:  Option<u32>,\n42\t//!        },\n43\t//!    }\n44\t//!    pub struct SplayTree<K, V> {\n45\t//!        slots: Vec<Slot<K, V>>,\n46\t//!        free:  Option<u32>,\n47\t//!        root:  Option<u32>,\n48\t//!        len:   usize,\n49\t//!    }\n50\t//!    ```\n51\t//!\n52\t//!    Standard top-down splay over `u32` indices.  Every \"follow a\n53\t//!    pointer\" in the C body becomes \"index into `self.slots`.\"\n54\t//!\n55\t//! 2. **Replace with a third-party crate.**  `splay_tree`,\n56\t//!    `splay-tree`, or BTreeMap (if log-N is fine and we don't\n57\t//!    actually need access locality).  picoquic uses splay\n58\t//!    specifically for the access-locality property in\n59\t//!    `connection_wake_tree` (the next-to-fire connection is usually the\n60\t//!    one we just touched).  `BTreeMap` is the safe-default\n61\t//!    fallback; a real splay crate is the performance-preserving\n62\t//!    choice.\n63\t//!\n64\t//! ## Phase 4 plan — call sites\n65\t//!\n66\t//! Same pattern as the hash table.  Every C site of the form\n67\t//!\n68\t//! ```c\n69\t//! struct Foo { …; picosplay_node_t node; …; };\n70\t//! picosplay_init_tree(&tree, foo_compare, foo_create, foo_delete, foo_value);\n71\t//! picosplay_insert(&tree, &foo);     // value = pointer to parent\n72\t//! ```\n73\t//!\n74\t//! becomes\n75\t//!\n76\t//! ```ignore\n77\t//! struct Foo {\n78\t//!     // … real fields …\n79\t//!     wake_tree_membership: Option<SplayToken>,   // for fast O(1) removal\n80\t//! }\n81\t//! let tok = tree.insert(key, foo_arena_token);\n82\t//! foo.wake_tree_membership = Some(tok);\n83\t//! // …\n84\t//! tree.remove(foo.wake_tree_membership.take().unwrap());\n85\t//! ```\n86\t//!\n87\t//! In particular, every C `_create` callback (which just projected\n88\t//! the embedded `SplayNode` out of a parent pointer) disappears —\n89\t//! the parent already lives in its own arena, the splay tree only\n90\t//! stores a token to it.\n91\t\n92\textern crate alloc;\n93\tuse alloc::vec::Vec;\n94\t\n95\tuse crate::Error;\n96\t\n97\t/// Opaque handle into a [`SplayTree`]'s slot vector.\n98\t///\n99\t/// `idx` selects a slot; `generation` is incremented on every\n100\t/// removal so an old token comparing against a recycled slot\n101\t/// returns `None` from [`SplayTree::get`].\n102\t#[derive(Debug, Copy, Clone, Eq, PartialEq, Hash)]\n103\tpub struct SplayToken {\n104\t    idx: u32,\n105\t    generation: u32,\n106\t}\n107\t\n108\t// ---------------------------------------------------------------------------\n109\t// Internal slot storage\n110\t\n111\tstruct Slot<K, V> {\n112\t    generation: u32,\n113\t    state: SlotState<K, V>,\n114\t}\n115\t\n116\tenum SlotState<K, V> {\n117\t    Free {\n118\t        next_free: Option<u32>,\n119\t    },\n120\t    Filled {\n121\t        key: K,\n122\t        value: V,\n123\t        parent: Option<u32>,\n124\t        left: Option<u32>,\n125\t        right: Option<u32>,\n126\t    },\n127\t}\n128\t\n129\t// ---------------------------------------------------------------------------\n130\t\n131\t/// Splay tree mapping `K` to `V`, addressable by [`SplayToken`].\n132\t///\n133\t/// Operations rotate the touched node to the root for access\n134\t/// locality — that's the whole reason picoquic uses splay rather\n135\t/// than red-black or AVL.  `K: Ord` provides comparison; `V` is\n136\t/// typically a token into some other arena.\n137\tpub struct SplayTree<K, V> {\n138\t    slots: Vec<Slot<K, V>>,\n139\t    free: Option<u32>,\n140\t    root: Option<u32>,\n141\t    len: usize,\n142\t}\n143\t\n144\timpl<K: Ord, V> SplayTree<K, V> {\n145\t    /// Build an empty tree.\n146\t    pub const fn new() -> Self {\n147\t        Self {\n148\t            slots: Vec::new(),\n149\t            free: None,\n150\t            root: None,\n151\t            len: 0,\n152\t        }\n153\t    }\n154\t\n155\t    // -----------------------------------------------------------------------\n156\t    // Slot helpers\n157\t\n158\t    fn alloc_slot(&mut self, key: K, value: V) -> Result<u32, Error> {\n159\t        if let Some(free_idx) = self.free {\n160\t            let next_free = match &self.slots[free_idx as usize].state {\n161\t                SlotState::Free { next_free } => *next_free,\n162\t                SlotState::Filled { .. } => unreachable!(),\n163\t            };\n164\t            let r#gen = self.slots[free_idx as usize].generation;\n165\t            self.slots[free_idx as usize] = Slot {\n166\t                generation: r#gen,\n167\t                state: SlotState::Filled {\n168\t                    key,\n169\t                    value,\n170\t                    parent: None,\n171\t                    left: None,\n172\t                    right: None,\n173\t                },\n174\t            };\n175\t            self.free = next_free;\n176\t            Ok(free_idx)\n177\t        } else {\n178\t            let idx = self.slots.len();\n179\t            if idx > u32::MAX as usize {\n180\t                return Err(Error::Memory);\n181\t            }\n182\t            self.slots.push(Slot {\n183\t                generation: 0,\n184\t                state: SlotState::Filled {\n185\t                    key,\n186\t                    value,\n187\t                    parent: None,\n188\t                    left: None,\n189\t                    right: None,\n190\t                },\n191\t            });\n192\t            Ok(idx as u32)\n193\t        }\n194\t    }\n195\t\n196\t    fn release_slot(&mut self, idx: u32) -> (K, V) {\n197\t        let r#gen = self.slots[idx as usize].generation.wrapping_add(1);\n198\t        let old = core::mem::replace(\n199\t            &mut self.slots[idx as usize],\n200\t            Slot {\n201\t                generation: r#gen,\n202\t                state: SlotState::Free {\n203\t                    next_free: self.free,\n204\t                },\n205\t            },\n206\t        );\n207\t        self.free = Some(idx);\n208\t        match old.state {\n209\t            SlotState::Filled { key, value, .. } => (key, value),\n210\t            SlotState::Free { .. } => unreachable!(),\n211\t        }\n212\t    }\n213\t\n214\t    fn token_of(&self, idx: u32) -> SplayToken {\n215\t        SplayToken {\n216\t            idx,\n217\t            generation: self.slots[idx as usize].generation,\n218\t        }\n219\t    }\n220\t\n221\t    fn is_valid(&self, t: SplayToken) -> bool {\n222\t        let i = t.idx as usize;\n223\t        i < self.slots.len()\n224\t            && matches!(self.slots[i].state, SlotState::Filled { .. })\n225\t            && self.slots[i].generation == t.generation\n226\t    }\n227\t\n228\t    // -----------------------------------------------------------------------\n229\t    // Field accessors\n230\t\n231\t    fn key_of(&self, idx: u32) -> &K {\n232\t        match &self.slots[idx as usize].state {\n233\t            SlotState::Filled { key, .. } => key,\n234\t            SlotState::Free { .. } => unreachable!(),\n235\t        }\n236\t    }\n237\t\n238\t    fn value_of(&self, idx: u32) -> &V {\n239\t        match &self.slots[idx as usize].state {\n240\t            SlotState::Filled { value, .. } => value,\n241\t            SlotState::Free { .. } => unreachable!(),\n242\t        }\n243\t    }\n244\t\n245\t    fn value_of_mut(&mut self, idx: u32) -> &mut V {\n246\t        match &mut self.slots[idx as usize].state {\n247\t            SlotState::Filled { value, .. } => value,\n248\t            SlotState::Free { .. } => unreachable!(),\n249\t        }\n250\t    }\n251\t\n252\t    fn parent_of(&self, idx: u32) -> Option<u32> {\n253\t        match &self.slots[idx as usize].state {\n254\t            SlotState::Filled { parent, .. } => *parent,\n255\t            SlotState::Free { .. } => unreachable!(),\n256\t        }\n257\t    }\n258\t\n259\t    fn left_of(&self, idx: u32) -> Option<u32> {\n260\t        match &self.slots[idx as usize].state {\n261\t            SlotState::Filled { left, .. } => *left,\n262\t            SlotState::Free { .. } => unreachable!(),\n263\t        }\n264\t    }\n265\t\n266\t    fn right_of(&self, idx: u32) -> Option<u32> {\n267\t        match &self.slots[idx as usize].state {\n268\t            SlotState::Filled { right, .. } => *right,\n269\t            SlotState::Free { .. } => unreachable!(),\n270\t        }\n271\t    }\n272\t\n273\t    fn set_parent(&mut self, idx: u32, p: Option<u32>) {\n274\t        match &mut self.slots[idx as usize].state {\n275\t            SlotState::Filled { parent, .. } => *parent = p,\n276\t            SlotState::Free { .. } => unreachable!(),\n277\t        }\n278\t    }\n279\t\n280\t    fn set_left(&mut self, idx: u32, l: Option<u32>) {\n281\t        match &mut self.slots[idx as usize].state {\n282\t            SlotState::Filled { left, .. } => *left = l,\n283\t            SlotState::Free { .. } => unreachable!(),\n284\t        }\n285\t    }\n286\t\n287\t    fn set_right(&mut self, idx: u32, r: Option<u32>) {\n288\t        match &mut self.slots[idx as usize].state {\n289\t            SlotState::Filled { right, .. } => *right = r,\n290\t            SlotState::Free { .. } => unreachable!(),\n291\t        }\n292\t    }\n293\t\n294\t    // -----------------------------------------------------------------------\n295\t    // Splay rotations (C: picosplay.c rotate / mark_gp / splay)\n296\t\n297\t    fn rotate(&mut self, child: u32) {\n298\t        let parent = self.parent_of(child).expect(\"rotate requires a parent\");\n299\t        let grand = self.parent_of(parent);\n300\t        let is_left = self.left_of(parent) == Some(child);\n301\t\n302\t        // Reattach child under grandparent (C: mark_gp).\n303\t        self.set_parent(child, grand);\n304\t        self.set_parent(parent, Some(child));\n305\t        if let Some(g) = grand {\n306\t            if self.left_of(g) == Some(parent) {\n307\t                self.set_left(g, Some(child));\n308\t            } else {\n309\t                self.set_right(g, Some(child));\n310\t            }\n311\t        }\n312\t\n313\t        if is_left {\n314\t            let cr = self.right_of(child);\n315\t            self.set_left(parent, cr);\n316\t            if let Some(cr) = cr {\n317\t                self.set_parent(cr, Some(parent));\n318\t            }\n319\t            self.set_right(child, Some(parent));\n320\t        } else {\n321\t            let cl = self.left_of(child);\n322\t            self.set_right(parent, cl);\n323\t            if let Some(cl) = cl {\n324\t                self.set_parent(cl, Some(parent));\n325\t            }\n326\t            self.set_left(child, Some(parent));\n327\t        }\n328\t    }\n329\t\n330\t    fn splay(&mut self, idx: u32) {\n331\t        loop {\n332\t            let p = match self.parent_of(idx) {\n333\t                None => {\n334\t                    self.root = Some(idx);\n335\t                    return;\n336\t                }\n337\t                Some(p) => p,\n338\t            };\n339\t            match self.parent_of(p) {\n340\t                None => self.rotate(idx),\n341\t                Some(g) => {\n342\t                    let idx_left = self.left_of(p) == Some(idx);\n343\t                    let p_left = self.left_of(g) == Some(p);\n344\t                    if idx_left == p_left {\n345\t                        self.rotate(p);\n346\t                        self.rotate(idx);\n347\t                    } else {\n348\t                        self.rotate(idx);\n349\t                        self.rotate(idx);\n350\t                    }\n351\t                }\n352\t            }\n353\t        }\n354\t    }\n355\t\n356\t    fn leftmost(&self, start: Option<u32>) -> Option<u32> {\n357\t        let mut cur = start?;\n358\t        loop {\n359\t            match self.left_of(cur) {\n360\t                None => return Some(cur),\n361\t                Some(l) => cur = l,\n362\t            }\n363\t        }\n364\t    }\n365\t\n366\t    fn rightmost(&self, start: Option<u32>) -> Option<u32> {\n367\t        let mut cur = start?;\n368\t        loop {\n369\t            match self.right_of(cur) {\n370\t                None => return Some(cur),\n371\t                Some(r) => cur = r,\n372\t            }\n373\t        }\n374\t    }\n375\t\n376\t    // -----------------------------------------------------------------------\n377\t    // Public API\n378\t\n379\t    /// Insert `(key, value)`, splay it to the root, and return its\n380\t    /// token.  If `key` was already present, the previous value is\n381\t    /// replaced and returned in the `Ok` payload.\n382\t    ///\n383\t    /// Returns [`Error::Memory`] on slot-vector allocation failure.\n384\t    pub fn insert(&mut self, key: K, value: V) -> Result<(SplayToken, Option<V>), Error> {\n385\t        if let Some(tok) = self.find(&key) {\n386\t            let old = core::mem::replace(self.value_of_mut(tok.idx), value);\n387\t            return Ok((tok, Some(old)));\n388\t        }\n389\t\n390\t        if self.root.is_none() {\n391\t            let idx = self.alloc_slot(key, value)?;\n392\t            self.root = Some(idx);\n393\t            self.len += 1;\n394\t            return Ok((self.token_of(idx), None));\n395\t        }\n396\t\n397\t        let mut cur = self.root.unwrap();\n398\t        let mut par;\n399\t        let mut go_left;\n400\t        loop {\n401\t            par = cur;\n402\t            let cmp = key.cmp(self.key_of(cur));\n403\t            go_left = cmp == core::cmp::Ordering::Less;\n404\t            let next = if go_left {\n405\t                self.left_of(cur)\n406\t            } else {\n407\t                self.right_of(cur)\n408\t            };\n409\t            match next {\n410\t                None => break,\n411\t                Some(n) => cur = n,\n412\t            }\n413\t        }\n414\t\n415\t        let idx = self.alloc_slot(key, value)?;\n416\t        self.set_parent(idx, Some(par));\n417\t        if go_left {\n418\t            self.set_left(par, Some(idx));\n419\t        } else {\n420\t            self.set_right(par, Some(idx));\n421\t        }\n422\t        self.splay(idx);\n423\t        self.len += 1;\n424\t        Ok((self.token_of(idx), None))\n425\t    }\n426\t\n427\t    /// Look up `key`, splaying the matching node to the root.\n428\t    /// Returns its token, or `None` on miss.  C: `picosplay_find`.\n429\t    pub fn find(&mut self, key: &K) -> Option<SplayToken> {\n430\t        let mut cur = self.root?;\n431\t        loop {\n432\t            match key.cmp(self.key_of(cur)) {\n433\t                core::cmp::Ordering::Equal => {\n434\t                    self.splay(cur);\n435\t                    return Some(self.token_of(cur));\n436\t                }\n437\t                core::cmp::Ordering::Less => match self.left_of(cur) {\n438\t                    None => return None,\n439\t                    Some(l) => cur = l,\n440\t                },\n441\t                core::cmp::Ordering::Greater => match self.right_of(cur) {\n442\t                    None => return None,\n443\t                    Some(r) => cur = r,\n444\t                },\n445\t            }\n446\t        }\n447\t    }\n448\t\n449\t    /// Locate the largest node whose key is `<= key`, without\n450\t    /// splaying.  C: `picosplay_find_previous`.  Returns `None`\n451\t    /// when no node is small enough.\n452\t    pub fn find_previous(&self, key: &K) -> Option<SplayToken> {\n453\t        let mut cur = self.root?;\n454\t        let mut prev: Option<u32> = None;\n455\t        loop {\n456\t            let cmp = key.cmp(self.key_of(cur));\n457\t            if cmp == core::cmp::Ordering::Equal {\n458\t                return Some(self.token_of(cur));\n459\t            } else if cmp == core::cmp::Ordering::Less {\n460\t                match self.left_of(cur) {\n461\t                    None => break,\n462\t                    Some(l) => cur = l,\n463\t                }\n464\t            } else {\n465\t                prev = Some(cur);\n466\t                match self.right_of(cur) {\n467\t                    None => break,\n468\t                    Some(r) => cur = r,\n469\t                }\n470\t            }\n471\t        }\n472\t        prev.map(|p| self.token_of(p))\n473\t    }\n474\t\n475\t    /// Smallest (left-most) node, or `None` for an empty tree.\n476\t    /// C: `picosplay_first`.\n477\t    pub fn first(&self) -> Option<SplayToken> {\n478\t        self.leftmost(self.root).map(|i| self.token_of(i))\n479\t    }\n480\t\n481\t    /// Largest (right-most) node, or `None` for an empty tree.\n482\t    /// C: `picosplay_last`.\n483\t    pub fn last(&self) -> Option<SplayToken> {\n484\t        self.rightmost(self.root).map(|i| self.token_of(i))\n485\t    }\n486\t\n487\t    /// In-order predecessor of `token`, or `None` if it is the\n488\t    /// minimum.  C: `picosplay_previous`.\n489\t    pub fn previous(&self, token: SplayToken) -> Option<SplayToken> {\n490\t        if !self.is_valid(token) {\n491\t            return None;\n492\t        }\n493\t        let idx = token.idx;\n494\t        if let Some(l) = self.left_of(idx) {\n495\t            return self.rightmost(Some(l)).map(|p| self.token_of(p));\n496\t        }\n497\t        let mut node = idx;\n498\t        loop {\n499\t            match self.parent_of(node) {\n500\t                None => return None,\n501\t                Some(p) => {\n502\t                    if self.left_of(p) == Some(node) {\n503\t                        node = p;\n504\t                    } else {\n505\t                        return Some(self.token_of(p));\n506\t                    }\n507\t                }\n508\t            }\n509\t        }\n510\t    }\n511\t\n512\t    /// In-order successor of `token`, or `None` if it is the\n513\t    /// maximum.  C: `picosplay_next`.\n514\t    pub fn next(&self, token: SplayToken) -> Option<SplayToken> {\n515\t        if !self.is_valid(token) {\n516\t            return None;\n517\t        }\n518\t        let idx = token.idx;\n519\t        if let Some(r) = self.right_of(idx) {\n520\t            return self.leftmost(Some(r)).map(|n| self.token_of(n));\n521\t        }\n522\t        let mut node = idx;\n523\t        loop {\n524\t            match self.parent_of(node) {\n525\t                None => return None,\n526\t                Some(p) => {\n527\t                    if self.right_of(p) == Some(node) {\n528\t                        node = p;\n529\t                    } else {\n530\t                        return Some(self.token_of(p));\n531\t                    }\n532\t                }\n533\t            }\n534\t        }\n535\t    }\n536\t\n537\t    /// Borrow the value at `token`, or `None` if stale or out of\n538\t    /// bounds.\n539\t    pub fn get(&self, token: SplayToken) -> Option<&V> {\n540\t        if !self.is_valid(token) {\n541\t            return None;\n542\t        }\n543\t        Some(self.value_of(token.idx))\n544\t    }\n545\t\n546\t    /// Mutably borrow the value at `token`, or `None` if stale.\n547\t    pub fn get_mut(&mut self, token: SplayToken) -> Option<&mut V> {\n548\t        if !self.is_valid(token) {\n549\t            return None;\n550\t        }\n551\t        Some(self.value_of_mut(token.idx))\n552\t    }\n553\t\n554\t    /// Borrow the `(key, value)` pair at `token`.\n555\t    pub fn get_key_value(&self, token: SplayToken) -> Option<(&K, &V)> {\n556\t        if !self.is_valid(token) {\n557\t            return None;\n558\t        }\n559\t        Some((self.key_of(token.idx), self.value_of(token.idx)))\n560\t    }\n561\t\n562\t    /// Remove the entry at `token`.  Bumps the slot's generation.\n563\t    /// Returns `None` for stale tokens.  C: `picosplay_delete_hint`.\n564\t    pub fn remove(&mut self, token: SplayToken) -> Option<(K, V)> {\n565\t        if !self.is_valid(token) {\n566\t            return None;\n567\t        }\n568\t        let node = token.idx;\n569\t        self.splay(node);\n570\t\n571\t        let left = self.left_of(node);\n572\t        let right = self.right_of(node);\n573\t\n574\t        match (left, right) {\n575\t            (None, _) => {\n576\t                self.root = right;\n577\t                if let Some(r) = right {\n578\t                    self.set_parent(r, None);\n579\t                }\n580\t            }\n581\t            (left, None) => {\n582\t                self.root = left;\n583\t                if let Some(l) = left {\n584\t                    self.set_parent(l, None);\n585\t                }\n586\t            }\n587\t            (Some(l), Some(r)) => {\n588\t                let x = self.leftmost(Some(r)).unwrap();\n589\t                if self.parent_of(x) != Some(node) {\n590\t                    let xr = self.right_of(x);\n591\t                    let xp = self.parent_of(x).unwrap();\n592\t                    self.set_left(xp, xr);\n593\t                    if let Some(xr) = xr {\n594\t                        self.set_parent(xr, Some(xp));\n595\t                    }\n596\t                    self.set_right(x, Some(r));\n597\t                    self.set_parent(r, Some(x));\n598\t                }\n599\t                self.set_left(x, Some(l));\n600\t                self.set_parent(l, Some(x));\n601\t                self.root = Some(x);\n602\t                self.set_parent(x, None);\n603\t            }\n604\t        }\n605\t\n606\t        self.len -= 1;\n607\t        Some(self.release_slot(node))\n608\t    }\n609\t\n610\t    /// Remove the entry matching `key`.  Prefer [`SplayTree::remove`]\n611\t    /// when a token is on hand.  C: `picosplay_delete`.\n612\t    pub fn remove_by_key(&mut self, key: &K) -> Option<V> {\n613\t        let tok = self.find(key)?;\n614\t        self.remove(tok).map(|(_, v)| v)\n615\t    }\n616\t\n617\t    /// Number of live entries.\n618\t    pub fn len(&self) -> usize {\n619\t        self.len\n620\t    }\n621\t\n622\t    /// `true` when the tree is empty.\n623\t    pub fn is_empty(&self) -> bool {\n624\t        self.len() == 0\n625\t    }\n626\t\n627\t    /// Drop every entry.  Tokens issued before the call are stale\n628\t    /// after it.  C: `picosplay_empty_tree`.\n629\t    pub fn clear(&mut self) {\n630\t        self.slots.clear();\n631\t        self.free = None;\n632\t        self.root = None;\n633\t        self.len = 0;\n634\t    }\n635\t}\n636\t\n637\timpl<K: Ord, V> Default for SplayTree<K, V> {\n638\t    fn default() -> Self {\n639\t        Self::new()\n640\t    }\n641\t}\n642\t\n643\t#[cfg(test)]\n644\tmod test {}\n645\t"}]},"parent_tool_use_id":null,"session_id":"e2dc405c-b85c-47a3-92e4-53e1c53f419b","uuid":"47150d9a-a2d9-4e6c-a86c-1005d8230797","timestamp":"2026-05-07T08:11:12.741Z","tool_use_result":{"type":"text","file":{"filePath":"/Users/richbarn/Projects/picoquic/rs/fq/src/splay.rs","content":"//! Token-based splay tree.\n//!\n//! Replaces the C `picosplay_tree_t` (top-down splay with intrusive\n//! `picosplay_node_t`s embedded in the caller's structs and four\n//! function pointers — `comparator`, `create`, `delete_node`,\n//! `node_value` — plumbed through the API).\n//!\n//! ## API shape\n//!\n//! `SplayTree<K, V>` is a slotmap-backed ordered map.  `K: Ord`\n//! provides comparison; `V` is the stored value (typically a\n//! token into another arena).  Callers handle [`SplayToken`]s\n//! returned by `insert`/`find`; the parent/left/right linkage\n//! lives inside the slot, never inside the caller's struct.\n//!\n//! Tokens are stable across operations on *other* keys.  A splay\n//! rotation that lifts node A to the root rewrites the linkage of\n//! the rotation path, but slot indices don't move and tokens for\n//! those nodes stay valid.  Removal bumps the slot's generation\n//! and frees the slot for reuse — old tokens then return `None`\n//! from [`SplayTree::get`].\n//!\n//! ## Phase 4 plan — implementation\n//!\n//! Phase 4: hand-rolled slotmap + splay tree.  One of:\n//!\n//! 1. **Hand-roll the slotmap.**  Internal layout:\n//!\n//!    ```ignore\n//!    struct Slot<K, V> {\n//!        generation: u32,\n//!        state: SlotState<K, V>,\n//!    }\n//!    enum SlotState<K, V> {\n//!        Free   { next_free: Option<u32> },\n//!        Filled {\n//!            key:    K,\n//!            value:  V,\n//!            parent: Option<u32>,\n//!            left:   Option<u32>,\n//!            right:  Option<u32>,\n//!        },\n//!    }\n//!    pub struct SplayTree<K, V> {\n//!        slots: Vec<Slot<K, V>>,\n//!        free:  Option<u32>,\n//!        root:  Option<u32>,\n//!        len:   usize,\n//!    }\n//!    ```\n//!\n//!    Standard top-down splay over `u32` indices.  Every \"follow a\n//!    pointer\" in the C body becomes \"index into `self.slots`.\"\n//!\n//! 2. **Replace with a third-party crate.**  `splay_tree`,\n//!    `splay-tree`, or BTreeMap (if log-N is fine and we don't\n//!    actually need access locality).  picoquic uses splay\n//!    specifically for the access-locality property in\n//!    `connection_wake_tree` (the next-to-fire connection is usually the\n//!    one we just touched).  `BTreeMap` is the safe-default\n//!    fallback; a real splay crate is the performance-preserving\n//!    choice.\n//!\n//! ## Phase 4 plan — call sites\n//!\n//! Same pattern as the hash table.  Every C site of the form\n//!\n//! ```c\n//! struct Foo { …; picosplay_node_t node; …; };\n//! picosplay_init_tree(&tree, foo_compare, foo_create, foo_delete, foo_value);\n//! picosplay_insert(&tree, &foo);     // value = pointer to parent\n//! ```\n//!\n//! becomes\n//!\n//! ```ignore\n//! struct Foo {\n//!     // … real fields …\n//!     wake_tree_membership: Option<SplayToken>,   // for fast O(1) removal\n//! }\n//! let tok = tree.insert(key, foo_arena_token);\n//! foo.wake_tree_membership = Some(tok);\n//! // …\n//! tree.remove(foo.wake_tree_membership.take().unwrap());\n//! ```\n//!\n//! In particular, every C `_create` callback (which just projected\n//! the embedded `SplayNode` out of a parent pointer) disappears —\n//! the parent already lives in its own arena, the splay tree only\n//! stores a token to it.\n\nextern crate alloc;\nuse alloc::vec::Vec;\n\nuse crate::Error;\n\n/// Opaque handle into a [`SplayTree`]'s slot vector.\n///\n/// `idx` selects a slot; `generation` is incremented on every\n/// removal so an old token comparing against a recycled slot\n/// returns `None` from [`SplayTree::get`].\n#[derive(Debug, Copy, Clone, Eq, PartialEq, Hash)]\npub struct SplayToken {\n    idx: u32,\n    generation: u32,\n}\n\n// ---------------------------------------------------------------------------\n// Internal slot storage\n\nstruct Slot<K, V> {\n    generation: u32,\n    state: SlotState<K, V>,\n}\n\nenum SlotState<K, V> {\n    Free {\n        next_free: Option<u32>,\n    },\n    Filled {\n        key: K,\n        value: V,\n        parent: Option<u32>,\n        left: Option<u32>,\n        right: Option<u32>,\n    },\n}\n\n// ---------------------------------------------------------------------------\n\n/// Splay tree mapping `K` to `V`, addressable by [`SplayToken`].\n///\n/// Operations rotate the touched node to the root for access\n/// locality — that's the whole reason picoquic uses splay rather\n/// than red-black or AVL.  `K: Ord` provides comparison; `V` is\n/// typically a token into some other arena.\npub struct SplayTree<K, V> {\n    slots: Vec<Slot<K, V>>,\n    free: Option<u32>,\n    root: Option<u32>,\n    len: usize,\n}\n\nimpl<K: Ord, V> SplayTree<K, V> {\n    /// Build an empty tree.\n    pub const fn new() -> Self {\n        Self {\n            slots: Vec::new(),\n            free: None,\n            root: None,\n            len: 0,\n        }\n    }\n\n    // -----------------------------------------------------------------------\n    // Slot helpers\n\n    fn alloc_slot(&mut self, key: K, value: V) -> Result<u32, Error> {\n        if let Some(free_idx) = self.free {\n            let next_free = match &self.slots[free_idx as usize].state {\n                SlotState::Free { next_free } => *next_free,\n                SlotState::Filled { .. } => unreachable!(),\n            };\n            let r#gen = self.slots[free_idx as usize].generation;\n            self.slots[free_idx as usize] = Slot {\n                generation: r#gen,\n                state: SlotState::Filled {\n                    key,\n                    value,\n                    parent: None,\n                    left: None,\n                    right: None,\n                },\n            };\n            self.free = next_free;\n            Ok(free_idx)\n        } else {\n            let idx = self.slots.len();\n            if idx > u32::MAX as usize {\n                return Err(Error::Memory);\n            }\n            self.slots.push(Slot {\n                generation: 0,\n                state: SlotState::Filled {\n                    key,\n                    value,\n                    parent: None,\n                    left: None,\n                    right: None,\n                },\n            });\n            Ok(idx as u32)\n        }\n    }\n\n    fn release_slot(&mut self, idx: u32) -> (K, V) {\n        let r#gen = self.slots[idx as usize].generation.wrapping_add(1);\n        let old = core::mem::replace(\n            &mut self.slots[idx as usize],\n            Slot {\n                generation: r#gen,\n                state: SlotState::Free {\n                    next_free: self.free,\n                },\n            },\n        );\n        self.free = Some(idx);\n        match old.state {\n            SlotState::Filled { key, value, .. } => (key, value),\n            SlotState::Free { .. } => unreachable!(),\n        }\n    }\n\n    fn token_of(&self, idx: u32) -> SplayToken {\n        SplayToken {\n            idx,\n            generation: self.slots[idx as usize].generation,\n        }\n    }\n\n    fn is_valid(&self, t: SplayToken) -> bool {\n        let i = t.idx as usize;\n        i < self.slots.len()\n            && matches!(self.slots[i].state, SlotState::Filled { .. })\n            && self.slots[i].generation == t.generation\n    }\n\n    // -----------------------------------------------------------------------\n    // Field accessors\n\n    fn key_of(&self, idx: u32) -> &K {\n        match &self.slots[idx as usize].state {\n            SlotState::Filled { key, .. } => key,\n            SlotState::Free { .. } => unreachable!(),\n        }\n    }\n\n    fn value_of(&self, idx: u32) -> &V {\n        match &self.slots[idx as usize].state {\n            SlotState::Filled { value, .. } => value,\n            SlotState::Free { .. } => unreachable!(),\n        }\n    }\n\n    fn value_of_mut(&mut self, idx: u32) -> &mut V {\n        match &mut self.slots[idx as usize].state {\n            SlotState::Filled { value, .. } => value,\n            SlotState::Free { .. } => unreachable!(),\n        }\n    }\n\n    fn parent_of(&self, idx: u32) -> Option<u32> {\n        match &self.slots[idx as usize].state {\n            SlotState::Filled { parent, .. } => *parent,\n            SlotState::Free { .. } => unreachable!(),\n        }\n    }\n\n    fn left_of(&self, idx: u32) -> Option<u32> {\n        match &self.slots[idx as usize].state {\n            SlotState::Filled { left, .. } => *left,\n            SlotState::Free { .. } => unreachable!(),\n        }\n    }\n\n    fn right_of(&self, idx: u32) -> Option<u32> {\n        match &self.slots[idx as usize].state {\n            SlotState::Filled { right, .. } => *right,\n            SlotState::Free { .. } => unreachable!(),\n        }\n    }\n\n    fn set_parent(&mut self, idx: u32, p: Option<u32>) {\n        match &mut self.slots[idx as usize].state {\n            SlotState::Filled { parent, .. } => *parent = p,\n            SlotState::Free { .. } => unreachable!(),\n        }\n    }\n\n    fn set_left(&mut self, idx: u32, l: Option<u32>) {\n        match &mut self.slots[idx as usize].state {\n            SlotState::Filled { left, .. } => *left = l,\n            SlotState::Free { .. } => unreachable!(),\n        }\n    }\n\n    fn set_right(&mut self, idx: u32, r: Option<u32>) {\n        match &mut self.slots[idx as usize].state {\n            SlotState::Filled { right, .. } => *right = r,\n            SlotState::Free { .. } => unreachable!(),\n        }\n    }\n\n    // -----------------------------------------------------------------------\n    // Splay rotations (C: picosplay.c rotate / mark_gp / splay)\n\n    fn rotate(&mut self, child: u32) {\n        let parent = self.parent_of(child).expect(\"rotate requires a parent\");\n        let grand = self.parent_of(parent);\n        let is_left = self.left_of(parent) == Some(child);\n\n        // Reattach child under grandparent (C: mark_gp).\n        self.set_parent(child, grand);\n        self.set_parent(parent, Some(child));\n        if let Some(g) = grand {\n            if self.left_of(g) == Some(parent) {\n                self.set_left(g, Some(child));\n            } else {\n                self.set_right(g, Some(child));\n            }\n        }\n\n        if is_left {\n            let cr = self.right_of(child);\n            self.set_left(parent, cr);\n            if let Some(cr) = cr {\n                self.set_parent(cr, Some(parent));\n            }\n            self.set_right(child, Some(parent));\n        } else {\n            let cl = self.left_of(child);\n            self.set_right(parent, cl);\n            if let Some(cl) = cl {\n                self.set_parent(cl, Some(parent));\n            }\n            self.set_left(child, Some(parent));\n        }\n    }\n\n    fn splay(&mut self, idx: u32) {\n        loop {\n            let p = match self.parent_of(idx) {\n                None => {\n                    self.root = Some(idx);\n                    return;\n                }\n                Some(p) => p,\n            };\n            match self.parent_of(p) {\n                None => self.rotate(idx),\n                Some(g) => {\n                    let idx_left = self.left_of(p) == Some(idx);\n                    let p_left = self.left_of(g) == Some(p);\n                    if idx_left == p_left {\n                        self.rotate(p);\n                        self.rotate(idx);\n                    } else {\n                        self.rotate(idx);\n                        self.rotate(idx);\n                    }\n                }\n            }\n        }\n    }\n\n    fn leftmost(&self, start: Option<u32>) -> Option<u32> {\n        let mut cur = start?;\n        loop {\n            match self.left_of(cur) {\n                None => return Some(cur),\n                Some(l) => cur = l,\n            }\n        }\n    }\n\n    fn rightmost(&self, start: Option<u32>) -> Option<u32> {\n        let mut cur = start?;\n        loop {\n            match self.right_of(cur) {\n                None => return Some(cur),\n                Some(r) => cur = r,\n            }\n        }\n    }\n\n    // -----------------------------------------------------------------------\n    // Public API\n\n    /// Insert `(key, value)`, splay it to the root, and return its\n    /// token.  If `key` was already present, the previous value is\n    /// replaced and returned in the `Ok` payload.\n    ///\n    /// Returns [`Error::Memory`] on slot-vector allocation failure.\n    pub fn insert(&mut self, key: K, value: V) -> Result<(SplayToken, Option<V>), Error> {\n        if let Some(tok) = self.find(&key) {\n            let old = core::mem::replace(self.value_of_mut(tok.idx), value);\n            return Ok((tok, Some(old)));\n        }\n\n        if self.root.is_none() {\n            let idx = self.alloc_slot(key, value)?;\n            self.root = Some(idx);\n            self.len += 1;\n            return Ok((self.token_of(idx), None));\n        }\n\n        let mut cur = self.root.unwrap();\n        let mut par;\n        let mut go_left;\n        loop {\n            par = cur;\n            let cmp = key.cmp(self.key_of(cur));\n            go_left = cmp == core::cmp::Ordering::Less;\n            let next = if go_left {\n                self.left_of(cur)\n            } else {\n                self.right_of(cur)\n            };\n            match next {\n                None => break,\n                Some(n) => cur = n,\n            }\n        }\n\n        let idx = self.alloc_slot(key, value)?;\n        self.set_parent(idx, Some(par));\n        if go_left {\n            self.set_left(par, Some(idx));\n        } else {\n            self.set_right(par, Some(idx));\n        }\n        self.splay(idx);\n        self.len += 1;\n        Ok((self.token_of(idx), None))\n    }\n\n    /// Look up `key`, splaying the matching node to the root.\n    /// Returns its token, or `None` on miss.  C: `picosplay_find`.\n    pub fn find(&mut self, key: &K) -> Option<SplayToken> {\n        let mut cur = self.root?;\n        loop {\n            match key.cmp(self.key_of(cur)) {\n                core::cmp::Ordering::Equal => {\n                    self.splay(cur);\n                    return Some(self.token_of(cur));\n                }\n                core::cmp::Ordering::Less => match self.left_of(cur) {\n                    None => return None,\n                    Some(l) => cur = l,\n                },\n                core::cmp::Ordering::Greater => match self.right_of(cur) {\n                    None => return None,\n                    Some(r) => cur = r,\n                },\n            }\n        }\n    }\n\n    /// Locate the largest node whose key is `<= key`, without\n    /// splaying.  C: `picosplay_find_previous`.  Returns `None`\n    /// when no node is small enough.\n    pub fn find_previous(&self, key: &K) -> Option<SplayToken> {\n        let mut cur = self.root?;\n        let mut prev: Option<u32> = None;\n        loop {\n            let cmp = key.cmp(self.key_of(cur));\n            if cmp == core::cmp::Ordering::Equal {\n                return Some(self.token_of(cur));\n            } else if cmp == core::cmp::Ordering::Less {\n                match self.left_of(cur) {\n                    None => break,\n                    Some(l) => cur = l,\n                }\n            } else {\n                prev = Some(cur);\n                match self.right_of(cur) {\n                    None => break,\n                    Some(r) => cur = r,\n                }\n            }\n        }\n        prev.map(|p| self.token_of(p))\n    }\n\n    /// Smallest (left-most) node, or `None` for an empty tree.\n    /// C: `picosplay_first`.\n    pub fn first(&self) -> Option<SplayToken> {\n        self.leftmost(self.root).map(|i| self.token_of(i))\n    }\n\n    /// Largest (right-most) node, or `None` for an empty tree.\n    /// C: `picosplay_last`.\n    pub fn last(&self) -> Option<SplayToken> {\n        self.rightmost(self.root).map(|i| self.token_of(i))\n    }\n\n    /// In-order predecessor of `token`, or `None` if it is the\n    /// minimum.  C: `picosplay_previous`.\n    pub fn previous(&self, token: SplayToken) -> Option<SplayToken> {\n        if !self.is_valid(token) {\n            return None;\n        }\n        let idx = token.idx;\n        if let Some(l) = self.left_of(idx) {\n            return self.rightmost(Some(l)).map(|p| self.token_of(p));\n        }\n        let mut node = idx;\n        loop {\n            match self.parent_of(node) {\n                None => return None,\n                Some(p) => {\n                    if self.left_of(p) == Some(node) {\n                        node = p;\n                    } else {\n                        return Some(self.token_of(p));\n                    }\n                }\n            }\n        }\n    }\n\n    /// In-order successor of `token`, or `None` if it is the\n    /// maximum.  C: `picosplay_next`.\n    pub fn next(&self, token: SplayToken) -> Option<SplayToken> {\n        if !self.is_valid(token) {\n            return None;\n        }\n        let idx = token.idx;\n        if let Some(r) = self.right_of(idx) {\n            return self.leftmost(Some(r)).map(|n| self.token_of(n));\n        }\n        let mut node = idx;\n        loop {\n            match self.parent_of(node) {\n                None => return None,\n                Some(p) => {\n                    if self.right_of(p) == Some(node) {\n                        node = p;\n                    } else {\n                        return Some(self.token_of(p));\n                    }\n                }\n            }\n        }\n    }\n\n    /// Borrow the value at `token`, or `None` if stale or out of\n    /// bounds.\n    pub fn get(&self, token: SplayToken) -> Option<&V> {\n        if !self.is_valid(token) {\n            return None;\n        }\n        Some(self.value_of(token.idx))\n    }\n\n    /// Mutably borrow the value at `token`, or `None` if stale.\n    pub fn get_mut(&mut self, token: SplayToken) -> Option<&mut V> {\n        if !self.is_valid(token) {\n            return None;\n        }\n        Some(self.value_of_mut(token.idx))\n    }\n\n    /// Borrow the `(key, value)` pair at `token`.\n    pub fn get_key_value(&self, token: SplayToken) -> Option<(&K, &V)> {\n        if !self.is_valid(token) {\n            return None;\n        }\n        Some((self.key_of(token.idx), self.value_of(token.idx)))\n    }\n\n    /// Remove the entry at `token`.  Bumps the slot's generation.\n    /// Returns `None` for stale tokens.  C: `picosplay_delete_hint`.\n    pub fn remove(&mut self, token: SplayToken) -> Option<(K, V)> {\n        if !self.is_valid(token) {\n            return None;\n        }\n        let node = token.idx;\n        self.splay(node);\n\n        let left = self.left_of(node);\n        let right = self.right_of(node);\n\n        match (left, right) {\n            (None, _) => {\n                self.root = right;\n                if let Some(r) = right {\n                    self.set_parent(r, None);\n                }\n            }\n            (left, None) => {\n                self.root = left;\n                if let Some(l) = left {\n                    self.set_parent(l, None);\n                }\n            }\n            (Some(l), Some(r)) => {\n                let x = self.leftmost(Some(r)).unwrap();\n                if self.parent_of(x) != Some(node) {\n                    let xr = self.right_of(x);\n                    let xp = self.parent_of(x).unwrap();\n                    self.set_left(xp, xr);\n                    if let Some(xr) = xr {\n                        self.set_parent(xr, Some(xp));\n                    }\n                    self.set_right(x, Some(r));\n                    self.set_parent(r, Some(x));\n                }\n                self.set_left(x, Some(l));\n                self.set_parent(l, Some(x));\n                self.root = Some(x);\n                self.set_parent(x, None);\n            }\n        }\n\n        self.len -= 1;\n        Some(self.release_slot(node))\n    }\n\n    /// Remove the entry matching `key`.  Prefer [`SplayTree::remove`]\n    /// when a token is on hand.  C: `picosplay_delete`.\n    pub fn remove_by_key(&mut self, key: &K) -> Option<V> {\n        let tok = self.find(key)?;\n        self.remove(tok).map(|(_, v)| v)\n    }\n\n    /// Number of live entries.\n    pub fn len(&self) -> usize {\n        self.len\n    }\n\n    /// `true` when the tree is empty.\n    pub fn is_empty(&self) -> bool {\n        self.len() == 0\n    }\n\n    /// Drop every entry.  Tokens issued before the call are stale\n    /// after it.  C: `picosplay_empty_tree`.\n    pub fn clear(&mut self) {\n        self.slots.clear();\n        self.free = None;\n        self.root = None;\n        self.len = 0;\n    }\n}\n\nimpl<K: Ord, V> Default for SplayTree<K, V> {\n    fn default() -> Self {\n        Self::new()\n    }\n}\n\n#[cfg(test)]\nmod test {}\n","numLines":645,"startLine":1,"totalLines":645}}}
