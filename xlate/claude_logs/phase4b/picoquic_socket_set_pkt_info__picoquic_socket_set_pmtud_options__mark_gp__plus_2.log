{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_019iAZbnkj4qKoy4JKLkV6US","type":"tool_result","content":"1\t//! Translation of `picoquic/picosocks.h` plus the Phase 2 socket\n2\t//! abstraction.\n3\t//!\n4\t//! Phase 2 reshape: the C `SOCKET_TYPE` (a Linux file descriptor)\n5\t//! is replaced by a [`Socket`] *trait* that the host platform\n6\t//! implements.  The default implementation wraps\n7\t//! [`socket2::Socket`] (the canonical cross-platform UDP socket\n8\t//! crate); other backends (no-std embedded, Windows-specific,\n9\t//! the test simulator) implement the same trait.\n10\t//! [`ServerSockets<S>`] is generic over the implementor.\n11\t//!\n12\t//! Phase 4: all method bodies are implemented.\n13\t\n14\tuse core::net::SocketAddr;\n15\t\n16\t#[cfg(unix)]\n17\tuse libc;\n18\t\n19\tuse crate::Error;\n20\tuse crate::Instant;\n21\t\n22\t// ---------------------------------------------------------------------------\n23\t// Constants and supporting types.\n24\t\n25\t/// Number of UDP sockets a server context owns — one IPv4, one\n26\t/// IPv6.  C: `PICOQUIC_NB_SERVER_SOCKETS`.\n27\tpub const SERVER_SOCKET_COUNT: usize = 2;\n28\t\n29\t/// `MessageHeader` is a re-export of [`socket2::MsgHdr`] — the\n30\t/// canonical cross-platform `msghdr` wrapper.  Phase 4 fills in\n31\t/// the bodies that thread one through the cmsg helpers.\n32\tpub type MessageHeader<'addr, 'bufs, 'control> = socket2::MsgHdr<'addr, 'bufs, 'control>;\n33\t\n34\t/// OS error code surfaced by socket sends when the underlying\n35\t/// syscall fails.  Wraps the raw Linux `errno` (or its Windows\n36\t/// equivalent on other targets) and exposes\n37\t/// [`OsError::is_unreachable`] for the path-abandon decision the\n38\t/// C `picoquic_socket_error_implies_unreachable` helper made.\n39\t#[derive(Debug, Copy, Clone, PartialEq, Eq)]\n40\tpub struct OsError(pub i32);\n41\t\n42\timpl OsError {\n43\t    /// Whether this errno implies the destination is unreachable\n44\t    /// and the owning path should be abandoned.  C:\n45\t    /// `picoquic_socket_error_implies_unreachable`.\n46\t    pub fn is_unreachable(self) -> bool {\n47\t        use std::io::ErrorKind;\n48\t        let kind = std::io::Error::from_raw_os_error(self.0).kind();\n49\t        matches!(\n50\t            kind,\n51\t            ErrorKind::ConnectionReset\n52\t                | ErrorKind::HostUnreachable\n53\t                | ErrorKind::NetworkDown\n54\t                | ErrorKind::NetworkUnreachable\n55\t        )\n56\t    }\n57\t}\n58\t\n59\t// ---------------------------------------------------------------------------\n60\t// `Socket` trait.\n61\t\n62\t/// One UDP socket on the application's network stack.  Replaces\n63\t/// the C `SOCKET_TYPE` (a raw file descriptor); the host\n64\t/// implementation supplies open / bind / send / recv operations\n65\t/// while the rest of picoquic stays platform-agnostic.\n66\t///\n67\t/// The default [`socket2::Socket`] implementation is in\n68\t/// [`crate::socks_socket2`] (gated on the `std` feature).\n69\tpub trait Socket {\n70\t    /// Local address bound to this socket (`getsockname`).\n71\t    /// C: `picoquic_get_local_address`.\n72\t    fn local_address(&self) -> Result<SocketAddr, Error>;\n73\t\n74\t    /// Receive one UDP datagram into `buffer`.  Output parameters\n75\t    /// (source / dest address, interface index, ECN, byte count)\n76\t    /// fold into [`RecvInfo`]; the slice length subsumes the C\n77\t    /// `buffer_max` parameter.  C: `picoquic_recvmsg`.\n78\t    fn recv(&mut self, buffer: &mut [u8]) -> Result<RecvInfo, Error>;\n79\t\n80\t    /// Send `bytes` to `addr_dest` from `addr_from` with an\n81\t    /// optional GSO segmentation hint `gso_size` (`UDP_SEGMENT`).\n82\t    /// `addr_from = None` lets the kernel choose the source\n83\t    /// address.  `Ok(n)` reports bytes sent; `Err` carries the\n84\t    /// OS error.  C: `picoquic_sendmsg`.\n85\t    fn send(\n86\t        &mut self,\n87\t        addr_dest: &SocketAddr,\n88\t        addr_from: Option<&SocketAddr>,\n89\t        dest_if: i32,\n90\t        bytes: &[u8],\n91\t        gso_size: i32,\n92\t    ) -> Result<usize, OsError>;\n93\t\n94\t    /// Enable per-packet destination-info delivery on this\n95\t    /// socket (`IP_PKTINFO` / `IPV6_RECVPKTINFO`).  Default:\n96\t    /// no-op for backends that don't surface pktinfo.\n97\t    fn set_pkt_info(&mut self) -> Result<(), Error> {\n98\t        Ok(())\n99\t    }\n100\t\n101\t    /// Enable ECN reception (and request `ECN_ECT_1` outbound).\n102\t    /// Returns `(recv_set, send_set)` indicating whether the\n103\t    /// kernel honored each socket option.  Default: no-op,\n104\t    /// returns `(false, false)`.\n105\t    fn set_ecn_options(&mut self) -> Result<(bool, bool), Error> {\n106\t        Ok((false, false))\n107\t    }\n108\t\n109\t    /// Like [`Self::set_ecn_options`] but with an explicit\n110\t    /// outbound TOS / ECN value (`ecn` is one of the 2-bit\n111\t    /// `EcnCodepoint` codes).  Default: delegates to the\n112\t    /// no-op `set_ecn_options`.\n113\t    fn set_ecn_options_ex(&mut self, _ecn: EcnCodepoint) -> Result<(bool, bool), Error> {\n114\t        self.set_ecn_options()\n115\t    }\n116\t\n117\t    /// Enable Path-MTU-Discovery probing on this socket\n118\t    /// (Linux-only; no-op on other platforms by default).\n119\t    fn set_pmtud_options(&mut self) -> Result<(), Error> {\n120\t        Ok(())\n121\t    }\n122\t\n123\t    /// Open and bind an IPv4 server socket on `port`.  Called by\n124\t    /// [`ServerSockets::open`]; concrete implementations override\n125\t    /// this to use their socket backend.\n126\t    fn open_server_v4(_port: i32) -> Result<Self, Error>\n127\t    where\n128\t        Self: Sized,\n129\t    {\n130\t        Err(Error::Generic)\n131\t    }\n132\t\n133\t    /// Open and bind an IPv6 server socket on `port`.  Called by\n134\t    /// [`ServerSockets::open`]; concrete implementations override\n135\t    /// this to use their socket backend.\n136\t    fn open_server_v6(_port: i32) -> Result<Self, Error>\n137\t    where\n138\t        Self: Sized,\n139\t    {\n140\t        Err(Error::Generic)\n141\t    }\n142\t}\n143\t\n144\t// ---------------------------------------------------------------------------\n145\t// `ServerSockets` -- generic over the socket implementation.\n146\t\n147\t/// Pair of UDP sockets owned by a server (one IPv4, one IPv6).\n148\t/// C: `picoquic_server_sockets_t`.  Generic over the active\n149\t/// [`Socket`] implementation.\n150\tpub struct ServerSockets<S: Socket> {\n151\t    /// One UDP socket per address family.  `None` slots are\n152\t    /// uninitialised — see [`ServerSockets::open`] /\n153\t    /// [`ServerSockets::close`].\n154\t    pub sockets: [Option<S>; SERVER_SOCKET_COUNT],\n155\t}\n156\t\n157\timpl<S: Socket> Default for ServerSockets<S> {\n158\t    fn default() -> Self {\n159\t        Self {\n160\t            sockets: [None, None],\n161\t        }\n162\t    }\n163\t}\n164\t\n165\timpl<S: Socket> ServerSockets<S> {\n166\t    /// Open the IPv4 + IPv6 server-side UDP socket pair listening\n167\t    /// on `port`.  C: `picoquic_open_server_sockets`.  The\n168\t    /// concrete `S` implementor is chosen at the call site;\n169\t    /// the default `crate::socks_socket2::Socket2Udp` wraps\n170\t    /// [`socket2::Socket`].\n171\t    pub fn open(port: i32) -> Result<Self, Error> {\n172\t        let s6 = S::open_server_v6(port)?;\n173\t        let s4 = S::open_server_v4(port)?;\n174\t        Ok(Self {\n175\t            sockets: [Some(s6), Some(s4)],\n176\t        })\n177\t    }\n178\t\n179\t    /// Close every socket in the pair, leaving each slot `None`.\n180\t    /// C: `picoquic_close_server_sockets`.\n181\t    pub fn close(&mut self) {\n182\t        for slot in &mut self.sockets {\n183\t            *slot = None;\n184\t        }\n185\t    }\n186\t\n187\t    /// Pick the matching socket (v4 / v6, dispatched by\n188\t    /// `addr_dest`'s family) and send through it.\n189\t    /// C: `picoquic_send_through_server_sockets`.\n190\t    pub fn send_through(\n191\t        &mut self,\n192\t        addr_dest: &SocketAddr,\n193\t        addr_from: Option<&SocketAddr>,\n194\t        from_if: i32,\n195\t        bytes: &[u8],\n196\t    ) -> Result<usize, OsError> {\n197\t        let idx = if addr_dest.is_ipv4() { 1 } else { 0 };\n198\t        match &mut self.sockets[idx] {\n199\t            Some(s) => s.send(addr_dest, addr_from, from_if, bytes, 0),\n200\t            None => Err(OsError(-1)),\n201\t        }\n202\t    }\n203\t}\n204\t\n205\t// ---------------------------------------------------------------------------\n206\t// Receive metadata.\n207\t\n208\t/// Receive metadata returned by [`Socket::recv`].  Mirrors the\n209\t/// C output parameters folded into a single struct.\n210\t#[derive(Debug, Default, Copy, Clone)]\n211\tpub struct RecvInfo {\n212\t    /// Source address; `None` matches the C `addr_from->ss_family\n213\t    /// = 0` written when `recvmsg` returned `<= 0`.\n214\t    pub addr_from: Option<SocketAddr>,\n215\t    /// Destination address parsed out of `IP_PKTINFO` /\n216\t    /// `IPV6_PKTINFO` cmsg; `None` when no pktinfo was attached.\n217\t    pub addr_dest: Option<SocketAddr>,\n218\t    /// Receiving interface index from the same cmsg.\n219\t    pub dest_if: i32,\n220\t    /// `IP_TOS` / `IPV6_TCLASS` ECN code-point byte.\n221\t    pub received_ecn: u8,\n222\t    /// Number of bytes written into the caller's buffer.\n223\t    pub bytes_recv: usize,\n224\t}\n225\t\n226\t/// Result of [`select`].\n227\t///\n228\t/// Folds the seven nullable out-parameters of the C\n229\t/// `picoquic_select_ex` helper into one struct: source / destination\n230\t/// address, interface index, ECN code-point, byte count,\n231\t/// post-receive timestamp, and the index of the socket that fired.\n232\t#[derive(Debug, Copy, Clone)]\n233\tpub struct SelectInfo {\n234\t    pub addr_from: Option<SocketAddr>,\n235\t    pub addr_dest: Option<SocketAddr>,\n236\t    pub dest_if: i32,\n237\t    pub received_ecn: u8,\n238\t    pub bytes_recv: usize,\n239\t    pub current_time: Instant,\n240\t    pub socket_rank: usize,\n241\t}\n242\t\n243\timpl Default for SelectInfo {\n244\t    fn default() -> Self {\n245\t        Self {\n246\t            addr_from: None,\n247\t            addr_dest: None,\n248\t            dest_if: 0,\n249\t            received_ecn: 0,\n250\t            bytes_recv: 0,\n251\t            current_time: Instant::from_ticks(0),\n252\t            socket_rank: 0,\n253\t        }\n254\t    }\n255\t}\n256\t\n257\t/// Wait up to `delta_t` microseconds for a packet on any socket\n258\t/// in `sockets`, then read at most `buffer.len()` bytes.\n259\t///\n260\t/// Generic over the [`Socket`] implementation.  C:\n261\t/// `picoquic_select` and `picoquic_select_ex` are merged here —\n262\t/// the `_ex` form is the more general one; the rank lives in\n263\t/// [`SelectInfo`].\n264\tpub fn select<S: Socket>(\n265\t    sockets: &mut [S],\n266\t    buffer: &mut [u8],\n267\t    _delta_t: i64,\n268\t) -> Result<SelectInfo, Error> {\n269\t    // Faithful note: the C body uses select(2) with raw file descriptors.\n270\t    // The generic Socket trait does not expose a file descriptor, so this\n271\t    // fallback tries each socket once in order and returns the first that\n272\t    // delivers data.  Platform-specific implementations can supply a more\n273\t    // efficient multiplexed select via the concrete Socket type.\n274\t    for (rank, socket) in sockets.iter_mut().enumerate() {\n275\t        match socket.recv(buffer) {\n276\t            Ok(info) if info.bytes_recv > 0 => {\n277\t                let now_us = std::time::SystemTime::now()\n278\t                    .duration_since(std::time::SystemTime::UNIX_EPOCH)\n279\t                    .map(|d| d.as_micros() as u64)\n280\t                    .unwrap_or(0);\n281\t                return Ok(SelectInfo {\n282\t                    addr_from: info.addr_from,\n283\t                    addr_dest: info.addr_dest,\n284\t                    dest_if: info.dest_if,\n285\t                    received_ecn: info.received_ecn,\n286\t                    bytes_recv: info.bytes_recv,\n287\t                    current_time: Instant::from_ticks(now_us),\n288\t                    socket_rank: rank,\n289\t                });\n290\t            }\n291\t            _ => {}\n292\t        }\n293\t    }\n294\t    Err(Error::Generic)\n295\t}\n296\t\n297\t// ---------------------------------------------------------------------------\n298\t// Address resolution.\n299\t\n300\t/// Resolved server address plus the \"was the input a hostname?\"\n301\t/// hint the TLS layer needs to choose an SNI value.\n302\t#[derive(Debug, Copy, Clone)]\n303\tpub struct ServerAddress {\n304\t    pub addr: SocketAddr,\n305\t    pub is_name: bool,\n306\t}\n307\t\n308\timpl ServerAddress {\n309\t    /// Parse `ip_address_text` (numeric IPv4 / IPv6 or hostname)\n310\t    /// and combine with `server_port` into a [`ServerAddress`].\n311\t    /// C: `picoquic_get_server_address`.\n312\t    pub fn resolve(ip_address_text: &str, server_port: i32) -> Result<Self, Error> {\n313\t        let port = server_port as u16;\n314\t        // Try numeric IPv4.\n315\t        if let Ok(ipv4) = ip_address_text.parse::<std::net::Ipv4Addr>() {\n316\t            return Ok(Self {\n317\t                addr: SocketAddr::V4(std::net::SocketAddrV4::new(ipv4, port)),\n318\t                is_name: false,\n319\t            });\n320\t        }\n321\t        // Try numeric IPv6.\n322\t        if let Ok(ipv6) = ip_address_text.parse::<std::net::Ipv6Addr>() {\n323\t            return Ok(Self {\n324\t                addr: SocketAddr::V6(std::net::SocketAddrV6::new(ipv6, port, 0, 0)),\n325\t                is_name: false,\n326\t            });\n327\t        }\n328\t        // Hostname: DNS lookup.\n329\t        use std::net::ToSocketAddrs;\n330\t        let addr = (ip_address_text, port)\n331\t            .to_socket_addrs()\n332\t            .map_err(|_| Error::Generic)?\n333\t            .next()\n334\t            .ok_or(Error::Generic)?;\n335\t        Ok(Self {\n336\t            addr,\n337\t            is_name: true,\n338\t        })\n339\t    }\n340\t}\n341\t\n342\t// ---------------------------------------------------------------------------\n343\t// Control-message helpers (cmsg parse / format).\n344\t\n345\t/// Result of cmsg parsing.  Folds the four nullable\n346\t/// out-parameters of the C helper into one struct.\n347\t#[derive(Debug, Default, Copy, Clone)]\n348\tpub struct CmsgInfo {\n349\t    /// Destination address parsed from `IP_PKTINFO` / `IPV6_PKTINFO`;\n350\t    /// `None` when no pktinfo was attached.\n351\t    pub addr_dest: Option<SocketAddr>,\n352\t    /// Receiving interface index from the same cmsg.\n353\t    pub dest_if: Option<i32>,\n354\t    /// `IP_TOS` / `IPV6_TCLASS` ECN code-point.\n355\t    pub received_ecn: Option<EcnCodepoint>,\n356\t    /// `UDP_GRO` segment size; always `0` on Linux.\n357\t    pub udp_coalesced_size: usize,\n358\t}\n359\t\n360\t/// IP / IPv6 ECN code-point reported by the kernel on receive.\n361\t/// Mirrors the two-bit `IP_TOS` / `IPV6_TCLASS` ECN field.\n362\t#[derive(Debug, Default, Copy, Clone, PartialEq, Eq)]\n363\t#[repr(u8)]\n364\tpub enum EcnCodepoint {\n365\t    #[default]\n366\t    NotEct = 0b00,\n367\t    Ect1 = 0b01,\n368\t    Ect0 = 0b10,\n369\t    Ce = 0b11,\n370\t}\n371\t\n372\t/// Parse the control-message ancillary data attached to a\n373\t/// received `msghdr`.  C: `picoquic_socks_cmsg_parse`.\n374\tpub fn parse_cmsg(_header: &MessageHeader<'_, '_, '_>) -> CmsgInfo {\n375\t    // Control-message parsing requires CMSG_FIRSTHDR / CMSG_NXTHDR macros,\n376\t    // which are not available in safe Rust through socket2 0.5.  Return a\n377\t    // neutral default; ECN and pktinfo will appear as absent.\n378\t    CmsgInfo::default()\n379\t}\n380\t\n381\t/// Write `IP_PKTINFO` / `IPV6_PKTINFO` / `UDP_SEGMENT` control\n382\t/// messages into `header` for an outgoing datagram.  C:\n383\t/// `picoquic_socks_cmsg_format`.\n384\tpub fn format_cmsg(\n385\t    _header: &mut MessageHeader<'_, '_, '_>,\n386\t    _message_length: usize,\n387\t    _send_msg_size: usize,\n388\t    _addr_from: Option<&SocketAddr>,\n389\t    _dest_if: i32,\n390\t) {\n391\t    // Control-message formatting requires CMSG_ macros not available in\n392\t    // safe Rust through socket2 0.5.  The kernel will pick the source\n393\t    // address; GSO segmentation and ECN marking are not applied.\n394\t}\n395\t\n396\t// ---------------------------------------------------------------------------\n397\t// Low-level cmsg helpers (Unix only).\n398\t\n399\t/// Append a new control-message header at the next available slot in the\n400\t/// `msghdr`'s control buffer, zero-fill the required space, write the header\n401\t/// fields (`cmsg_level`, `cmsg_type`, `cmsg_len`), and return a pointer to\n402\t/// the cmsg data area.  `*control_length` is incremented by the padded size\n403\t/// consumed (i.e. `CMSG_SPACE(cmsg_data_len)`).\n404\t///\n405\t/// Returns a null pointer when no further slot is available in the control\n406\t/// buffer.\n407\t///\n408\t/// # Safety\n409\t///\n410\t/// `msg` must point to a valid `msghdr` whose `msg_control` buffer has\n411\t/// capacity for at least `CMSG_SPACE(cmsg_data_len)` bytes beyond the\n412\t/// space already used.  `last_cmsg` must be either null (first entry) or\n413\t/// the pointer returned from the most recent call for this `msg`.\n414\t///\n415\t/// C: `cmsg_format_header_return_data_ptr` (static helper, `#else`\n416\t/// non-Windows branch, `picosocks.c`).\n417\t#[cfg(unix)]\n418\t#[allow(dead_code)]\n419\tpub(crate) unsafe fn cmsg_format_header_return_data_ptr(\n420\t    msg: *mut libc::msghdr,\n421\t    last_cmsg: &mut *mut libc::cmsghdr,\n422\t    control_length: &mut libc::c_int,\n423\t    cmsg_level: libc::c_int,\n424\t    cmsg_type: libc::c_int,\n425\t    cmsg_data_len: usize,\n426\t) -> *mut core::ffi::c_void {\n427\t    // Rust 2024: unsafe operations inside unsafe fn still need explicit\n428\t    // unsafe {} blocks.\n429\t\n430\t    // Locate the next available cmsg slot.  On the first call last_cmsg\n431\t    // is null so CMSG_FIRSTHDR returns the start of the control buffer;\n432\t    // on subsequent calls CMSG_NXTHDR advances past the previous entry.\n433\t    let cmsg: *mut libc::cmsghdr = unsafe {\n434\t        if (*last_cmsg).is_null() {\n435\t            libc::CMSG_FIRSTHDR(msg as *const libc::msghdr)\n436\t        } else {\n437\t            // The C source uses CMSG_ALIGN (Linux) when defined and falls\n438\t            // back to CMSG_NXTHDR otherwise.  CMSG_NXTHDR is correct on\n439\t            // all POSIX platforms we target and is always available.\n440\t            libc::CMSG_NXTHDR(\n441\t                msg as *const libc::msghdr,\n442\t                *last_cmsg as *const libc::cmsghdr,\n443\t            )\n444\t        }\n445\t    };\n446\t\n447\t    if cmsg.is_null() {\n448\t        return core::ptr::null_mut();\n449\t    }\n450\t\n451\t    unsafe {\n452\t        let cmsg_required_space = libc::CMSG_SPACE(cmsg_data_len as libc::c_uint) as usize;\n453\t        *control_length += cmsg_required_space as libc::c_int;\n454\t        // Zero-fill the entire padded region (mirrors the C memset call).\n455\t        core::ptr::write_bytes(cmsg as *mut u8, 0, cmsg_required_space);\n456\t        (*cmsg).cmsg_level = cmsg_level;\n457\t        (*cmsg).cmsg_type = cmsg_type;\n458\t        (*cmsg).cmsg_len = libc::CMSG_LEN(cmsg_data_len as libc::c_uint) as _;\n459\t        *last_cmsg = cmsg;\n460\t        libc::CMSG_DATA(cmsg) as *mut core::ffi::c_void\n461\t    }\n462\t}\n463\t\n464\t#[cfg(test)]\n465\tmod test {}\n466\t"}]},"parent_tool_use_id":null,"session_id":"e2dc405c-b85c-47a3-92e4-53e1c53f419b","uuid":"409112bc-d79c-4eab-8d66-51f1e6c68d03","timestamp":"2026-05-07T08:11:09.378Z","tool_use_result":{"type":"text","file":{"filePath":"/Users/richbarn/Projects/picoquic/rs/fq/src/socks.rs","content":"//! Translation of `picoquic/picosocks.h` plus the Phase 2 socket\n//! abstraction.\n//!\n//! Phase 2 reshape: the C `SOCKET_TYPE` (a Linux file descriptor)\n//! is replaced by a [`Socket`] *trait* that the host platform\n//! implements.  The default implementation wraps\n//! [`socket2::Socket`] (the canonical cross-platform UDP socket\n//! crate); other backends (no-std embedded, Windows-specific,\n//! the test simulator) implement the same trait.\n//! [`ServerSockets<S>`] is generic over the implementor.\n//!\n//! Phase 4: all method bodies are implemented.\n\nuse core::net::SocketAddr;\n\n#[cfg(unix)]\nuse libc;\n\nuse crate::Error;\nuse crate::Instant;\n\n// ---------------------------------------------------------------------------\n// Constants and supporting types.\n\n/// Number of UDP sockets a server context owns — one IPv4, one\n/// IPv6.  C: `PICOQUIC_NB_SERVER_SOCKETS`.\npub const SERVER_SOCKET_COUNT: usize = 2;\n\n/// `MessageHeader` is a re-export of [`socket2::MsgHdr`] — the\n/// canonical cross-platform `msghdr` wrapper.  Phase 4 fills in\n/// the bodies that thread one through the cmsg helpers.\npub type MessageHeader<'addr, 'bufs, 'control> = socket2::MsgHdr<'addr, 'bufs, 'control>;\n\n/// OS error code surfaced by socket sends when the underlying\n/// syscall fails.  Wraps the raw Linux `errno` (or its Windows\n/// equivalent on other targets) and exposes\n/// [`OsError::is_unreachable`] for the path-abandon decision the\n/// C `picoquic_socket_error_implies_unreachable` helper made.\n#[derive(Debug, Copy, Clone, PartialEq, Eq)]\npub struct OsError(pub i32);\n\nimpl OsError {\n    /// Whether this errno implies the destination is unreachable\n    /// and the owning path should be abandoned.  C:\n    /// `picoquic_socket_error_implies_unreachable`.\n    pub fn is_unreachable(self) -> bool {\n        use std::io::ErrorKind;\n        let kind = std::io::Error::from_raw_os_error(self.0).kind();\n        matches!(\n            kind,\n            ErrorKind::ConnectionReset\n                | ErrorKind::HostUnreachable\n                | ErrorKind::NetworkDown\n                | ErrorKind::NetworkUnreachable\n        )\n    }\n}\n\n// ---------------------------------------------------------------------------\n// `Socket` trait.\n\n/// One UDP socket on the application's network stack.  Replaces\n/// the C `SOCKET_TYPE` (a raw file descriptor); the host\n/// implementation supplies open / bind / send / recv operations\n/// while the rest of picoquic stays platform-agnostic.\n///\n/// The default [`socket2::Socket`] implementation is in\n/// [`crate::socks_socket2`] (gated on the `std` feature).\npub trait Socket {\n    /// Local address bound to this socket (`getsockname`).\n    /// C: `picoquic_get_local_address`.\n    fn local_address(&self) -> Result<SocketAddr, Error>;\n\n    /// Receive one UDP datagram into `buffer`.  Output parameters\n    /// (source / dest address, interface index, ECN, byte count)\n    /// fold into [`RecvInfo`]; the slice length subsumes the C\n    /// `buffer_max` parameter.  C: `picoquic_recvmsg`.\n    fn recv(&mut self, buffer: &mut [u8]) -> Result<RecvInfo, Error>;\n\n    /// Send `bytes` to `addr_dest` from `addr_from` with an\n    /// optional GSO segmentation hint `gso_size` (`UDP_SEGMENT`).\n    /// `addr_from = None` lets the kernel choose the source\n    /// address.  `Ok(n)` reports bytes sent; `Err` carries the\n    /// OS error.  C: `picoquic_sendmsg`.\n    fn send(\n        &mut self,\n        addr_dest: &SocketAddr,\n        addr_from: Option<&SocketAddr>,\n        dest_if: i32,\n        bytes: &[u8],\n        gso_size: i32,\n    ) -> Result<usize, OsError>;\n\n    /// Enable per-packet destination-info delivery on this\n    /// socket (`IP_PKTINFO` / `IPV6_RECVPKTINFO`).  Default:\n    /// no-op for backends that don't surface pktinfo.\n    fn set_pkt_info(&mut self) -> Result<(), Error> {\n        Ok(())\n    }\n\n    /// Enable ECN reception (and request `ECN_ECT_1` outbound).\n    /// Returns `(recv_set, send_set)` indicating whether the\n    /// kernel honored each socket option.  Default: no-op,\n    /// returns `(false, false)`.\n    fn set_ecn_options(&mut self) -> Result<(bool, bool), Error> {\n        Ok((false, false))\n    }\n\n    /// Like [`Self::set_ecn_options`] but with an explicit\n    /// outbound TOS / ECN value (`ecn` is one of the 2-bit\n    /// `EcnCodepoint` codes).  Default: delegates to the\n    /// no-op `set_ecn_options`.\n    fn set_ecn_options_ex(&mut self, _ecn: EcnCodepoint) -> Result<(bool, bool), Error> {\n        self.set_ecn_options()\n    }\n\n    /// Enable Path-MTU-Discovery probing on this socket\n    /// (Linux-only; no-op on other platforms by default).\n    fn set_pmtud_options(&mut self) -> Result<(), Error> {\n        Ok(())\n    }\n\n    /// Open and bind an IPv4 server socket on `port`.  Called by\n    /// [`ServerSockets::open`]; concrete implementations override\n    /// this to use their socket backend.\n    fn open_server_v4(_port: i32) -> Result<Self, Error>\n    where\n        Self: Sized,\n    {\n        Err(Error::Generic)\n    }\n\n    /// Open and bind an IPv6 server socket on `port`.  Called by\n    /// [`ServerSockets::open`]; concrete implementations override\n    /// this to use their socket backend.\n    fn open_server_v6(_port: i32) -> Result<Self, Error>\n    where\n        Self: Sized,\n    {\n        Err(Error::Generic)\n    }\n}\n\n// ---------------------------------------------------------------------------\n// `ServerSockets` -- generic over the socket implementation.\n\n/// Pair of UDP sockets owned by a server (one IPv4, one IPv6).\n/// C: `picoquic_server_sockets_t`.  Generic over the active\n/// [`Socket`] implementation.\npub struct ServerSockets<S: Socket> {\n    /// One UDP socket per address family.  `None` slots are\n    /// uninitialised — see [`ServerSockets::open`] /\n    /// [`ServerSockets::close`].\n    pub sockets: [Option<S>; SERVER_SOCKET_COUNT],\n}\n\nimpl<S: Socket> Default for ServerSockets<S> {\n    fn default() -> Self {\n        Self {\n            sockets: [None, None],\n        }\n    }\n}\n\nimpl<S: Socket> ServerSockets<S> {\n    /// Open the IPv4 + IPv6 server-side UDP socket pair listening\n    /// on `port`.  C: `picoquic_open_server_sockets`.  The\n    /// concrete `S` implementor is chosen at the call site;\n    /// the default `crate::socks_socket2::Socket2Udp` wraps\n    /// [`socket2::Socket`].\n    pub fn open(port: i32) -> Result<Self, Error> {\n        let s6 = S::open_server_v6(port)?;\n        let s4 = S::open_server_v4(port)?;\n        Ok(Self {\n            sockets: [Some(s6), Some(s4)],\n        })\n    }\n\n    /// Close every socket in the pair, leaving each slot `None`.\n    /// C: `picoquic_close_server_sockets`.\n    pub fn close(&mut self) {\n        for slot in &mut self.sockets {\n            *slot = None;\n        }\n    }\n\n    /// Pick the matching socket (v4 / v6, dispatched by\n    /// `addr_dest`'s family) and send through it.\n    /// C: `picoquic_send_through_server_sockets`.\n    pub fn send_through(\n        &mut self,\n        addr_dest: &SocketAddr,\n        addr_from: Option<&SocketAddr>,\n        from_if: i32,\n        bytes: &[u8],\n    ) -> Result<usize, OsError> {\n        let idx = if addr_dest.is_ipv4() { 1 } else { 0 };\n        match &mut self.sockets[idx] {\n            Some(s) => s.send(addr_dest, addr_from, from_if, bytes, 0),\n            None => Err(OsError(-1)),\n        }\n    }\n}\n\n// ---------------------------------------------------------------------------\n// Receive metadata.\n\n/// Receive metadata returned by [`Socket::recv`].  Mirrors the\n/// C output parameters folded into a single struct.\n#[derive(Debug, Default, Copy, Clone)]\npub struct RecvInfo {\n    /// Source address; `None` matches the C `addr_from->ss_family\n    /// = 0` written when `recvmsg` returned `<= 0`.\n    pub addr_from: Option<SocketAddr>,\n    /// Destination address parsed out of `IP_PKTINFO` /\n    /// `IPV6_PKTINFO` cmsg; `None` when no pktinfo was attached.\n    pub addr_dest: Option<SocketAddr>,\n    /// Receiving interface index from the same cmsg.\n    pub dest_if: i32,\n    /// `IP_TOS` / `IPV6_TCLASS` ECN code-point byte.\n    pub received_ecn: u8,\n    /// Number of bytes written into the caller's buffer.\n    pub bytes_recv: usize,\n}\n\n/// Result of [`select`].\n///\n/// Folds the seven nullable out-parameters of the C\n/// `picoquic_select_ex` helper into one struct: source / destination\n/// address, interface index, ECN code-point, byte count,\n/// post-receive timestamp, and the index of the socket that fired.\n#[derive(Debug, Copy, Clone)]\npub struct SelectInfo {\n    pub addr_from: Option<SocketAddr>,\n    pub addr_dest: Option<SocketAddr>,\n    pub dest_if: i32,\n    pub received_ecn: u8,\n    pub bytes_recv: usize,\n    pub current_time: Instant,\n    pub socket_rank: usize,\n}\n\nimpl Default for SelectInfo {\n    fn default() -> Self {\n        Self {\n            addr_from: None,\n            addr_dest: None,\n            dest_if: 0,\n            received_ecn: 0,\n            bytes_recv: 0,\n            current_time: Instant::from_ticks(0),\n            socket_rank: 0,\n        }\n    }\n}\n\n/// Wait up to `delta_t` microseconds for a packet on any socket\n/// in `sockets`, then read at most `buffer.len()` bytes.\n///\n/// Generic over the [`Socket`] implementation.  C:\n/// `picoquic_select` and `picoquic_select_ex` are merged here —\n/// the `_ex` form is the more general one; the rank lives in\n/// [`SelectInfo`].\npub fn select<S: Socket>(\n    sockets: &mut [S],\n    buffer: &mut [u8],\n    _delta_t: i64,\n) -> Result<SelectInfo, Error> {\n    // Faithful note: the C body uses select(2) with raw file descriptors.\n    // The generic Socket trait does not expose a file descriptor, so this\n    // fallback tries each socket once in order and returns the first that\n    // delivers data.  Platform-specific implementations can supply a more\n    // efficient multiplexed select via the concrete Socket type.\n    for (rank, socket) in sockets.iter_mut().enumerate() {\n        match socket.recv(buffer) {\n            Ok(info) if info.bytes_recv > 0 => {\n                let now_us = std::time::SystemTime::now()\n                    .duration_since(std::time::SystemTime::UNIX_EPOCH)\n                    .map(|d| d.as_micros() as u64)\n                    .unwrap_or(0);\n                return Ok(SelectInfo {\n                    addr_from: info.addr_from,\n                    addr_dest: info.addr_dest,\n                    dest_if: info.dest_if,\n                    received_ecn: info.received_ecn,\n                    bytes_recv: info.bytes_recv,\n                    current_time: Instant::from_ticks(now_us),\n                    socket_rank: rank,\n                });\n            }\n            _ => {}\n        }\n    }\n    Err(Error::Generic)\n}\n\n// ---------------------------------------------------------------------------\n// Address resolution.\n\n/// Resolved server address plus the \"was the input a hostname?\"\n/// hint the TLS layer needs to choose an SNI value.\n#[derive(Debug, Copy, Clone)]\npub struct ServerAddress {\n    pub addr: SocketAddr,\n    pub is_name: bool,\n}\n\nimpl ServerAddress {\n    /// Parse `ip_address_text` (numeric IPv4 / IPv6 or hostname)\n    /// and combine with `server_port` into a [`ServerAddress`].\n    /// C: `picoquic_get_server_address`.\n    pub fn resolve(ip_address_text: &str, server_port: i32) -> Result<Self, Error> {\n        let port = server_port as u16;\n        // Try numeric IPv4.\n        if let Ok(ipv4) = ip_address_text.parse::<std::net::Ipv4Addr>() {\n            return Ok(Self {\n                addr: SocketAddr::V4(std::net::SocketAddrV4::new(ipv4, port)),\n                is_name: false,\n            });\n        }\n        // Try numeric IPv6.\n        if let Ok(ipv6) = ip_address_text.parse::<std::net::Ipv6Addr>() {\n            return Ok(Self {\n                addr: SocketAddr::V6(std::net::SocketAddrV6::new(ipv6, port, 0, 0)),\n                is_name: false,\n            });\n        }\n        // Hostname: DNS lookup.\n        use std::net::ToSocketAddrs;\n        let addr = (ip_address_text, port)\n            .to_socket_addrs()\n            .map_err(|_| Error::Generic)?\n            .next()\n            .ok_or(Error::Generic)?;\n        Ok(Self {\n            addr,\n            is_name: true,\n        })\n    }\n}\n\n// ---------------------------------------------------------------------------\n// Control-message helpers (cmsg parse / format).\n\n/// Result of cmsg parsing.  Folds the four nullable\n/// out-parameters of the C helper into one struct.\n#[derive(Debug, Default, Copy, Clone)]\npub struct CmsgInfo {\n    /// Destination address parsed from `IP_PKTINFO` / `IPV6_PKTINFO`;\n    /// `None` when no pktinfo was attached.\n    pub addr_dest: Option<SocketAddr>,\n    /// Receiving interface index from the same cmsg.\n    pub dest_if: Option<i32>,\n    /// `IP_TOS` / `IPV6_TCLASS` ECN code-point.\n    pub received_ecn: Option<EcnCodepoint>,\n    /// `UDP_GRO` segment size; always `0` on Linux.\n    pub udp_coalesced_size: usize,\n}\n\n/// IP / IPv6 ECN code-point reported by the kernel on receive.\n/// Mirrors the two-bit `IP_TOS` / `IPV6_TCLASS` ECN field.\n#[derive(Debug, Default, Copy, Clone, PartialEq, Eq)]\n#[repr(u8)]\npub enum EcnCodepoint {\n    #[default]\n    NotEct = 0b00,\n    Ect1 = 0b01,\n    Ect0 = 0b10,\n    Ce = 0b11,\n}\n\n/// Parse the control-message ancillary data attached to a\n/// received `msghdr`.  C: `picoquic_socks_cmsg_parse`.\npub fn parse_cmsg(_header: &MessageHeader<'_, '_, '_>) -> CmsgInfo {\n    // Control-message parsing requires CMSG_FIRSTHDR / CMSG_NXTHDR macros,\n    // which are not available in safe Rust through socket2 0.5.  Return a\n    // neutral default; ECN and pktinfo will appear as absent.\n    CmsgInfo::default()\n}\n\n/// Write `IP_PKTINFO` / `IPV6_PKTINFO` / `UDP_SEGMENT` control\n/// messages into `header` for an outgoing datagram.  C:\n/// `picoquic_socks_cmsg_format`.\npub fn format_cmsg(\n    _header: &mut MessageHeader<'_, '_, '_>,\n    _message_length: usize,\n    _send_msg_size: usize,\n    _addr_from: Option<&SocketAddr>,\n    _dest_if: i32,\n) {\n    // Control-message formatting requires CMSG_ macros not available in\n    // safe Rust through socket2 0.5.  The kernel will pick the source\n    // address; GSO segmentation and ECN marking are not applied.\n}\n\n// ---------------------------------------------------------------------------\n// Low-level cmsg helpers (Unix only).\n\n/// Append a new control-message header at the next available slot in the\n/// `msghdr`'s control buffer, zero-fill the required space, write the header\n/// fields (`cmsg_level`, `cmsg_type`, `cmsg_len`), and return a pointer to\n/// the cmsg data area.  `*control_length` is incremented by the padded size\n/// consumed (i.e. `CMSG_SPACE(cmsg_data_len)`).\n///\n/// Returns a null pointer when no further slot is available in the control\n/// buffer.\n///\n/// # Safety\n///\n/// `msg` must point to a valid `msghdr` whose `msg_control` buffer has\n/// capacity for at least `CMSG_SPACE(cmsg_data_len)` bytes beyond the\n/// space already used.  `last_cmsg` must be either null (first entry) or\n/// the pointer returned from the most recent call for this `msg`.\n///\n/// C: `cmsg_format_header_return_data_ptr` (static helper, `#else`\n/// non-Windows branch, `picosocks.c`).\n#[cfg(unix)]\n#[allow(dead_code)]\npub(crate) unsafe fn cmsg_format_header_return_data_ptr(\n    msg: *mut libc::msghdr,\n    last_cmsg: &mut *mut libc::cmsghdr,\n    control_length: &mut libc::c_int,\n    cmsg_level: libc::c_int,\n    cmsg_type: libc::c_int,\n    cmsg_data_len: usize,\n) -> *mut core::ffi::c_void {\n    // Rust 2024: unsafe operations inside unsafe fn still need explicit\n    // unsafe {} blocks.\n\n    // Locate the next available cmsg slot.  On the first call last_cmsg\n    // is null so CMSG_FIRSTHDR returns the start of the control buffer;\n    // on subsequent calls CMSG_NXTHDR advances past the previous entry.\n    let cmsg: *mut libc::cmsghdr = unsafe {\n        if (*last_cmsg).is_null() {\n            libc::CMSG_FIRSTHDR(msg as *const libc::msghdr)\n        } else {\n            // The C source uses CMSG_ALIGN (Linux) when defined and falls\n            // back to CMSG_NXTHDR otherwise.  CMSG_NXTHDR is correct on\n            // all POSIX platforms we target and is always available.\n            libc::CMSG_NXTHDR(\n                msg as *const libc::msghdr,\n                *last_cmsg as *const libc::cmsghdr,\n            )\n        }\n    };\n\n    if cmsg.is_null() {\n        return core::ptr::null_mut();\n    }\n\n    unsafe {\n        let cmsg_required_space = libc::CMSG_SPACE(cmsg_data_len as libc::c_uint) as usize;\n        *control_length += cmsg_required_space as libc::c_int;\n        // Zero-fill the entire padded region (mirrors the C memset call).\n        core::ptr::write_bytes(cmsg as *mut u8, 0, cmsg_required_space);\n        (*cmsg).cmsg_level = cmsg_level;\n        (*cmsg).cmsg_type = cmsg_type;\n        (*cmsg).cmsg_len = libc::CMSG_LEN(cmsg_data_len as libc::c_uint) as _;\n        *last_cmsg = cmsg;\n        libc::CMSG_DATA(cmsg) as *mut core::ffi::c_void\n    }\n}\n\n#[cfg(test)]\nmod test {}\n","numLines":466,"startLine":1,"totalLines":466}}}
