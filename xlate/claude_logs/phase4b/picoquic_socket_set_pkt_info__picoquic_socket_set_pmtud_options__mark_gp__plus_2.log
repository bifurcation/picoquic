{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01L9bC3xy48C9ha5Bivohz4k","type":"tool_result","content":"1\t//! Default [`crate::socks::Socket`] implementation backed by\n2\t//! [`socket2::Socket`].\n3\t//!\n4\t//! This is the canonical UDP-socket implementation for\n5\t//! Linux / macOS / Windows.  Other backends (no-std embedded,\n6\t//! the test simulator) implement the same trait against their\n7\t//! own platform abstractions.\n8\t//!\n9\t//! Phase 4 wires the safe parts through `socket2`'s\n10\t//! receive/send/option-setting calls.\n11\t\n12\tuse core::net::SocketAddr;\n13\t\n14\tuse crate::Error;\n15\tuse crate::socks::{OsError, RecvInfo, Socket};\n16\t\n17\t/// Newtype around [`socket2::Socket`] so we can implement\n18\t/// the [`crate::socks::Socket`] trait on it locally (the\n19\t/// orphan-rules forbid `impl crate::Socket for socket2::Socket`\n20\t/// directly, since neither type belongs to this crate before\n21\t/// the trait moves in).\n22\tpub struct Socket2Udp(pub socket2::Socket);\n23\t\n24\timpl Socket2Udp {\n25\t    /// Open a UDP client socket on address family `af`\n26\t    /// (`AF_INET` / `AF_INET6`).  Applies pktinfo / ECN /\n27\t    /// PMTUD options before returning.  C:\n28\t    /// `picoquic_open_client_socket`.\n29\t    pub fn open_client(af: i32) -> Result<Self, Error> {\n30\t        let domain = socket2::Domain::from(af);\n31\t        let sock = socket2::Socket::new(domain, socket2::Type::DGRAM, Some(socket2::Protocol::UDP))\n32\t            .map_err(|_| Error::Generic)?;\n33\t        let mut udp = Socket2Udp(sock);\n34\t        let _ = udp.set_pkt_info();\n35\t        let _ = udp.set_ecn_options();\n36\t        let _ = udp.set_pmtud_options();\n37\t        Ok(udp)\n38\t    }\n39\t\n40\t    /// Bind this socket to `port` on `af`.\n41\t    /// C: `picoquic_bind_to_port`.\n42\t    pub fn bind_to_port(&mut self, af: i32, port: i32) -> Result<(), Error> {\n43\t        use core::net::{Ipv4Addr, Ipv6Addr, SocketAddrV4, SocketAddrV6};\n44\t        let addr = if socket2::Domain::from(af) == socket2::Domain::IPV6 {\n45\t            SocketAddr::V6(SocketAddrV6::new(Ipv6Addr::UNSPECIFIED, port as u16, 0, 0))\n46\t        } else {\n47\t            SocketAddr::V4(SocketAddrV4::new(Ipv4Addr::UNSPECIFIED, port as u16))\n48\t        };\n49\t        self.0\n50\t            .bind(&socket2::SockAddr::from(addr))\n51\t            .map_err(|_| Error::Generic)\n52\t    }\n53\t\n54\t    fn open_bound(domain: socket2::Domain, port: i32) -> Result<Self, Error> {\n55\t        use core::net::{Ipv4Addr, Ipv6Addr, SocketAddrV4, SocketAddrV6};\n56\t        let sock = socket2::Socket::new(domain, socket2::Type::DGRAM, Some(socket2::Protocol::UDP))\n57\t            .map_err(|_| Error::Generic)?;\n58\t        let mut udp = Socket2Udp(sock);\n59\t        let _ = udp.set_pkt_info();\n60\t        let _ = udp.set_ecn_options();\n61\t        let _ = udp.set_pmtud_options();\n62\t        let addr = if domain == socket2::Domain::IPV6 {\n63\t            SocketAddr::V6(SocketAddrV6::new(Ipv6Addr::UNSPECIFIED, port as u16, 0, 0))\n64\t        } else {\n65\t            SocketAddr::V4(SocketAddrV4::new(Ipv4Addr::UNSPECIFIED, port as u16))\n66\t        };\n67\t        udp.0\n68\t            .bind(&socket2::SockAddr::from(addr))\n69\t            .map_err(|_| Error::Generic)?;\n70\t        Ok(udp)\n71\t    }\n72\t}\n73\t\n74\timpl Socket for Socket2Udp {\n75\t    fn local_address(&self) -> Result<SocketAddr, Error> {\n76\t        let sa = self.0.local_addr().map_err(|_| Error::Generic)?;\n77\t        sa.as_socket().ok_or(Error::Generic)\n78\t    }\n79\t\n80\t    fn recv(&mut self, buffer: &mut [u8]) -> Result<RecvInfo, Error> {\n81\t        use std::io::Read;\n82\t        let bytes_recv = self.0.read(buffer).map_err(|_| Error::Generic)?;\n83\t        Ok(RecvInfo {\n84\t            bytes_recv,\n85\t            ..RecvInfo::default()\n86\t        })\n87\t    }\n88\t\n89\t    fn send(\n90\t        &mut self,\n91\t        addr_dest: &SocketAddr,\n92\t        _addr_from: Option<&SocketAddr>,\n93\t        _dest_if: i32,\n94\t        bytes: &[u8],\n95\t        _gso_size: i32,\n96\t    ) -> Result<usize, OsError> {\n97\t        let sa = socket2::SockAddr::from(*addr_dest);\n98\t        self.0\n99\t            .send_to(bytes, &sa)\n100\t            .map_err(|e| OsError(e.raw_os_error().unwrap_or(-1)))\n101\t    }\n102\t\n103\t    fn set_pkt_info(&mut self) -> Result<(), Error> {\n104\t        // IPV6_V6ONLY is the part socket2 exposes; IP_PKTINFO /\n105\t        // IPV6_RECVPKTINFO require direct setsockopt (not in socket2 0.5).\n106\t        let _ = self.0.set_only_v6(true);\n107\t        Ok(())\n108\t    }\n109\t\n110\t    fn set_ecn_options(&mut self) -> Result<(bool, bool), Error> {\n111\t        self.set_ecn_options_ex(crate::socks::EcnCodepoint::Ect1)\n112\t    }\n113\t\n114\t    fn set_ecn_options_ex(\n115\t        &mut self,\n116\t        ecn: crate::socks::EcnCodepoint,\n117\t    ) -> Result<(bool, bool), Error> {\n118\t        let ecn = ecn as u32;\n119\t        let recv_v4 = self.0.set_recv_tos(true).is_ok();\n120\t        let recv_v6 = self.0.set_recv_tclass_v6(true).is_ok();\n121\t        let send_v4 = self.0.set_tos(ecn).is_ok();\n122\t        let send_v6 = self.0.set_tclass_v6(ecn).is_ok();\n123\t        Ok((recv_v4 || recv_v6, send_v4 || send_v6))\n124\t    }\n125\t\n126\t    fn set_pmtud_options(&mut self) -> Result<(), Error> {\n127\t        // IP_MTU_DISCOVER / IPV6_MTU_DISCOVER are Linux-only and not\n128\t        // exposed by socket2 0.5; no-op on other platforms.\n129\t        Ok(())\n130\t    }\n131\t\n132\t    fn open_server_v4(port: i32) -> Result<Self, Error> {\n133\t        Self::open_bound(socket2::Domain::IPV4, port)\n134\t    }\n135\t\n136\t    fn open_server_v6(port: i32) -> Result<Self, Error> {\n137\t        Self::open_bound(socket2::Domain::IPV6, port)\n138\t    }\n139\t}\n140\t\n141\t#[cfg(test)]\n142\tmod test {}\n143\t"}]},"parent_tool_use_id":null,"session_id":"e2dc405c-b85c-47a3-92e4-53e1c53f419b","uuid":"45157964-e582-4550-aec4-f7c8d8909fa4","timestamp":"2026-05-07T08:12:02.452Z","tool_use_result":{"type":"text","file":{"filePath":"/Users/richbarn/Projects/picoquic/rs/fq/src/socks_socket2.rs","content":"//! Default [`crate::socks::Socket`] implementation backed by\n//! [`socket2::Socket`].\n//!\n//! This is the canonical UDP-socket implementation for\n//! Linux / macOS / Windows.  Other backends (no-std embedded,\n//! the test simulator) implement the same trait against their\n//! own platform abstractions.\n//!\n//! Phase 4 wires the safe parts through `socket2`'s\n//! receive/send/option-setting calls.\n\nuse core::net::SocketAddr;\n\nuse crate::Error;\nuse crate::socks::{OsError, RecvInfo, Socket};\n\n/// Newtype around [`socket2::Socket`] so we can implement\n/// the [`crate::socks::Socket`] trait on it locally (the\n/// orphan-rules forbid `impl crate::Socket for socket2::Socket`\n/// directly, since neither type belongs to this crate before\n/// the trait moves in).\npub struct Socket2Udp(pub socket2::Socket);\n\nimpl Socket2Udp {\n    /// Open a UDP client socket on address family `af`\n    /// (`AF_INET` / `AF_INET6`).  Applies pktinfo / ECN /\n    /// PMTUD options before returning.  C:\n    /// `picoquic_open_client_socket`.\n    pub fn open_client(af: i32) -> Result<Self, Error> {\n        let domain = socket2::Domain::from(af);\n        let sock = socket2::Socket::new(domain, socket2::Type::DGRAM, Some(socket2::Protocol::UDP))\n            .map_err(|_| Error::Generic)?;\n        let mut udp = Socket2Udp(sock);\n        let _ = udp.set_pkt_info();\n        let _ = udp.set_ecn_options();\n        let _ = udp.set_pmtud_options();\n        Ok(udp)\n    }\n\n    /// Bind this socket to `port` on `af`.\n    /// C: `picoquic_bind_to_port`.\n    pub fn bind_to_port(&mut self, af: i32, port: i32) -> Result<(), Error> {\n        use core::net::{Ipv4Addr, Ipv6Addr, SocketAddrV4, SocketAddrV6};\n        let addr = if socket2::Domain::from(af) == socket2::Domain::IPV6 {\n            SocketAddr::V6(SocketAddrV6::new(Ipv6Addr::UNSPECIFIED, port as u16, 0, 0))\n        } else {\n            SocketAddr::V4(SocketAddrV4::new(Ipv4Addr::UNSPECIFIED, port as u16))\n        };\n        self.0\n            .bind(&socket2::SockAddr::from(addr))\n            .map_err(|_| Error::Generic)\n    }\n\n    fn open_bound(domain: socket2::Domain, port: i32) -> Result<Self, Error> {\n        use core::net::{Ipv4Addr, Ipv6Addr, SocketAddrV4, SocketAddrV6};\n        let sock = socket2::Socket::new(domain, socket2::Type::DGRAM, Some(socket2::Protocol::UDP))\n            .map_err(|_| Error::Generic)?;\n        let mut udp = Socket2Udp(sock);\n        let _ = udp.set_pkt_info();\n        let _ = udp.set_ecn_options();\n        let _ = udp.set_pmtud_options();\n        let addr = if domain == socket2::Domain::IPV6 {\n            SocketAddr::V6(SocketAddrV6::new(Ipv6Addr::UNSPECIFIED, port as u16, 0, 0))\n        } else {\n            SocketAddr::V4(SocketAddrV4::new(Ipv4Addr::UNSPECIFIED, port as u16))\n        };\n        udp.0\n            .bind(&socket2::SockAddr::from(addr))\n            .map_err(|_| Error::Generic)?;\n        Ok(udp)\n    }\n}\n\nimpl Socket for Socket2Udp {\n    fn local_address(&self) -> Result<SocketAddr, Error> {\n        let sa = self.0.local_addr().map_err(|_| Error::Generic)?;\n        sa.as_socket().ok_or(Error::Generic)\n    }\n\n    fn recv(&mut self, buffer: &mut [u8]) -> Result<RecvInfo, Error> {\n        use std::io::Read;\n        let bytes_recv = self.0.read(buffer).map_err(|_| Error::Generic)?;\n        Ok(RecvInfo {\n            bytes_recv,\n            ..RecvInfo::default()\n        })\n    }\n\n    fn send(\n        &mut self,\n        addr_dest: &SocketAddr,\n        _addr_from: Option<&SocketAddr>,\n        _dest_if: i32,\n        bytes: &[u8],\n        _gso_size: i32,\n    ) -> Result<usize, OsError> {\n        let sa = socket2::SockAddr::from(*addr_dest);\n        self.0\n            .send_to(bytes, &sa)\n            .map_err(|e| OsError(e.raw_os_error().unwrap_or(-1)))\n    }\n\n    fn set_pkt_info(&mut self) -> Result<(), Error> {\n        // IPV6_V6ONLY is the part socket2 exposes; IP_PKTINFO /\n        // IPV6_RECVPKTINFO require direct setsockopt (not in socket2 0.5).\n        let _ = self.0.set_only_v6(true);\n        Ok(())\n    }\n\n    fn set_ecn_options(&mut self) -> Result<(bool, bool), Error> {\n        self.set_ecn_options_ex(crate::socks::EcnCodepoint::Ect1)\n    }\n\n    fn set_ecn_options_ex(\n        &mut self,\n        ecn: crate::socks::EcnCodepoint,\n    ) -> Result<(bool, bool), Error> {\n        let ecn = ecn as u32;\n        let recv_v4 = self.0.set_recv_tos(true).is_ok();\n        let recv_v6 = self.0.set_recv_tclass_v6(true).is_ok();\n        let send_v4 = self.0.set_tos(ecn).is_ok();\n        let send_v6 = self.0.set_tclass_v6(ecn).is_ok();\n        Ok((recv_v4 || recv_v6, send_v4 || send_v6))\n    }\n\n    fn set_pmtud_options(&mut self) -> Result<(), Error> {\n        // IP_MTU_DISCOVER / IPV6_MTU_DISCOVER are Linux-only and not\n        // exposed by socket2 0.5; no-op on other platforms.\n        Ok(())\n    }\n\n    fn open_server_v4(port: i32) -> Result<Self, Error> {\n        Self::open_bound(socket2::Domain::IPV4, port)\n    }\n\n    fn open_server_v6(port: i32) -> Result<Self, Error> {\n        Self::open_bound(socket2::Domain::IPV6, port)\n    }\n}\n\n#[cfg(test)]\nmod test {}\n","numLines":143,"startLine":1,"totalLines":143}}}
