{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01FvmJCBCDipg4wdwo6h8z1M","type":"tool_result","content":"1\t//! Translation of `picoquic/bbr1.c` — BBRv1 congestion control.\n2\t//!\n3\t//! Phase 4B: initial batch (BBR1AfterOneRoundtripInFastRecovery,\n4\t//! BBR1CheckFullPipe, BBR1EnterProbeRTT, BBR1EnterStartup).\n5\t//! Phase 4B missing batch (BBR1EnterStartupLongRTT, BBR1GetBtlBW,\n6\t//! BBR1ModulateCwndForProbeRTT, BBR1ModulateCwndForRecovery, BBR1RestoreCwnd).\n7\t\n8\tuse crate::cc_common::MinMaxRtt;\n9\tuse crate::internal::{CWIN_INITIAL, MAX_PACKET_SIZE, Path, TARGET_RENO_RTT, TARGET_SATELLITE_RTT};\n10\tuse crate::utils::bytes_from_rate;\n11\t\n12\t// ---------------------------------------------------------------------------\n13\t// Constants from bbr1.c `#define`s.\n14\t\n15\tconst BBR1_HIGH_GAIN: f64 = 2.8853900817779; // C: BBR1_HIGH_GAIN (2/ln(2))\n16\tconst BBR1_BTL_BW_FILTER_LENGTH: usize = 10; // C: BBR1_BTL_BW_FILTER_LENGTH\n17\tconst BBR1_PROBE_RTT_INTERVAL: u64 = 10_000_000; // 10 sec in microseconds\n18\tconst BBR1_PACING_RATE_LOW: f64 = 150_000.0; // 1.2 Mbps in B/s\n19\tconst BBR1_PACING_RATE_MEDIUM: f64 = 3_000_000.0; // 24 Mbps in B/s\n20\t\n21\t// ---------------------------------------------------------------------------\n22\t// Algorithm-state enum.  C: `picoquic_bbr1_alg_state_t`.\n23\t\n24\t#[derive(Debug, Copy, Clone, PartialEq, Eq, Default)]\n25\tpub enum Bbr1AlgState {\n26\t    #[default]\n27\t    Startup = 0,\n28\t    Drain,\n29\t    ProbeBw,\n30\t    ProbeRtt,\n31\t    StartupLongRtt,\n32\t}\n33\t\n34\t// ---------------------------------------------------------------------------\n35\t// BBR1 state.  C: `picoquic_bbr1_state_t`.\n36\t//\n37\t// Type deviations from C:\n38\t//   * single-bit `unsigned int x : 1` bitfields → `bool`\n39\t//   * `const char* option_string` → `Option<String>` (owned copy)\n40\t//   * `picoquic_min_max_rtt_t rtt_filter` → `MinMaxRtt`\n41\t//   * `int` round/count fields → `i32` (faithfully signed)\n42\t\n43\tpub struct Bbr1State {\n44\t    pub state: Bbr1AlgState,\n45\t    pub btl_bw: u64,\n46\t    pub next_round_delivered: u64,\n47\t    pub btl_bw_filter: [u64; BBR1_BTL_BW_FILTER_LENGTH],\n48\t    pub full_bw: u64,\n49\t    pub rt_prop: u64,\n50\t    pub rt_prop_stamp: u64,\n51\t    pub cycle_stamp: u64,\n52\t    pub probe_rtt_done_stamp: u64,\n53\t    pub prior_cwnd: u64,\n54\t    pub prior_in_flight: u64,\n55\t    pub bytes_delivered: u64,\n56\t    pub send_quantum: u64,\n57\t    pub rtt_filter: MinMaxRtt,\n58\t    pub target_cwnd: u64,\n59\t    pub pacing_gain: f64,\n60\t    pub cwnd_gain: f64,\n61\t    pub pacing_rate: f64,\n62\t    pub cycle_index: u32,\n63\t    pub cycle_start: u32,\n64\t    pub round_count: i32,\n65\t    pub full_bw_count: i32,\n66\t    pub lt_rtt_cnt: i32,\n67\t    pub lt_bw: u64,\n68\t    pub lt_last_stamp: u64,\n69\t    pub previous_round_lost: u64,\n70\t    pub previous_sampling_delivered: u64,\n71\t    pub previous_sampling_lost: u64,\n72\t    pub loss_interval_start: u64,\n73\t    pub congestion_sequence: u64,\n74\t    pub cwin_before_suspension: u64,\n75\t    pub option_string: Option<String>,\n76\t    pub wifi_shadow_rtt: u64,\n77\t    pub quantum_ratio: f64,\n78\t    pub filled_pipe: bool,\n79\t    pub round_start: bool,\n80\t    pub rt_prop_expired: bool,\n81\t    pub probe_rtt_round_done: bool,\n82\t    pub idle_restart: bool,\n83\t    pub packet_conservation: bool,\n84\t    pub btl_bw_increased: bool,\n85\t    pub lt_use_bw: bool,\n86\t    pub lt_is_sampling: bool,\n87\t    pub last_loss_was_timeout: bool,\n88\t    pub cycle_on_loss: bool,\n89\t    pub is_suspended: bool,\n90\t    pub is_suspension_nearly_over: bool,\n91\t}\n92\t\n93\timpl Bbr1State {\n94\t    /// C: `BBR1EnterStartup` (picoquic/bbr1.c:327)\n95\t    ///\n96\t    /// Enter the Startup state with the high-gain pacing and cwnd multipliers.\n97\t    pub fn enter_startup(&mut self) {\n98\t        self.state = Bbr1AlgState::Startup;\n99\t        self.pacing_gain = BBR1_HIGH_GAIN;\n100\t        self.cwnd_gain = BBR1_HIGH_GAIN;\n101\t    }\n102\t\n103\t    /// C: `BBR1CheckFullPipe` (picoquic/bbr1.c:771)\n104\t    ///\n105\t    /// Detect when the pipe is full during Startup.  On each round start\n106\t    /// (unless app-limited or already detected), check whether `btl_bw`\n107\t    /// has grown by ≥ 25%.  After three consecutive rounds without\n108\t    /// sufficient growth, set `filled_pipe`.\n109\t    pub fn check_full_pipe(&mut self, rs_is_app_limited: bool) {\n110\t        if !self.filled_pipe && self.round_start && !rs_is_app_limited {\n111\t            if self.btl_bw as f64 >= self.full_bw as f64 * 1.25 {\n112\t                self.full_bw = self.btl_bw;\n113\t                self.full_bw_count = 0;\n114\t            } else {\n115\t                self.full_bw_count += 1;\n116\t                if self.full_bw_count >= 3 {\n117\t                    self.filled_pipe = true;\n118\t                }\n119\t            }\n120\t        }\n121\t    }\n122\t\n123\t    /// C: `BBR1EnterProbeRTT` (picoquic/bbr1.c:885)\n124\t    ///\n125\t    /// Enter ProbeRTT state: coast at unity gains to drain the queue and\n126\t    /// obtain a fresh minimum-RTT sample.\n127\t    pub fn enter_probe_rtt(&mut self) {\n128\t        self.state = Bbr1AlgState::ProbeRtt;\n129\t        self.pacing_gain = 1.0;\n130\t        self.cwnd_gain = 1.0;\n131\t    }\n132\t\n133\t    /// C: `BBR1AfterOneRoundtripInFastRecovery` (picoquic/bbr1.c:1107)\n134\t    ///\n135\t    /// After the first full round-trip in fast recovery, disable packet\n136\t    /// conservation so the congestion window can grow normally again.\n137\t    pub fn after_one_roundtrip_in_fast_recovery(&mut self) {\n138\t        self.packet_conservation = false;\n139\t    }\n140\t\n141\t    /// C: `BBR1GetBtlBW` (picoquic/bbr1.c:304)\n142\t    ///\n143\t    /// Return the effective bottleneck bandwidth: the long-term estimate when\n144\t    /// `lt_use_bw` is set, otherwise the filter-max `btl_bw`.\n145\t    fn get_btl_bw(&self) -> u64 {\n146\t        if self.lt_use_bw {\n147\t            self.lt_bw\n148\t        } else {\n149\t            self.btl_bw\n150\t        }\n151\t    }\n152\t\n153\t    /// C: `BBR1EnterStartupLongRTT` (picoquic/bbr1.c:309)\n154\t    ///\n155\t    /// Switch into `StartupLongRtt` state and ensure `cwin` is at least\n156\t    /// `CWIN_INITIAL` scaled by the path RTT (capped at the satellite ceiling).\n157\t    pub fn enter_startup_long_rtt(&mut self, path_x: &mut Path) {\n158\t        let mut cwnd = CWIN_INITIAL;\n159\t        self.state = Bbr1AlgState::StartupLongRtt;\n160\t        if path_x.rtt_min > TARGET_RENO_RTT {\n161\t            let rtt_cap = if path_x.rtt_min > TARGET_SATELLITE_RTT {\n162\t                TARGET_SATELLITE_RTT\n163\t            } else {\n164\t                path_x.rtt_min\n165\t            };\n166\t            cwnd = (cwnd as f64 * rtt_cap.ticks() as f64 / TARGET_RENO_RTT.ticks() as f64) as u64;\n167\t        }\n168\t        if cwnd > path_x.cwin {\n169\t            path_x.cwin = cwnd;\n170\t        }\n171\t    }\n172\t\n173\t    /// C: `BBR1RestoreCwnd` (picoquic/bbr1.c:918)\n174\t    ///\n175\t    /// Restore `cwin` to `prior_cwnd` if the current window has shrunk below it.\n176\t    pub fn restore_cwnd(&self, path_x: &mut Path) {\n177\t        if path_x.cwin < self.prior_cwnd {\n178\t            path_x.cwin = self.prior_cwnd;\n179\t        }\n180\t    }\n181\t\n182\t    /// C: `BBR1ModulateCwndForRecovery` (picoquic/bbr1.c:996)\n183\t    ///\n184\t    /// Adjust `cwin` for the recovery phase: subtract lost bytes (floored at\n185\t    /// one MTU), then enforce packet-conservation if active.\n186\t    pub fn modulate_cwnd_for_recovery(\n187\t        &mut self,\n188\t        path_x: &mut Path,\n189\t        bytes_in_transit: u64,\n190\t        bytes_lost: u64,\n191\t        bytes_delivered: u64,\n192\t    ) {\n193\t        if bytes_lost > 0 {\n194\t            if path_x.cwin > bytes_lost {\n195\t                path_x.cwin -= bytes_lost;\n196\t            } else {\n197\t                path_x.cwin = path_x.send_mtu as u64;\n198\t            }\n199\t        }\n200\t        if self.packet_conservation && path_x.cwin < bytes_in_transit + bytes_delivered {\n201\t            path_x.cwin = bytes_in_transit + bytes_delivered;\n202\t        }\n203\t    }\n204\t\n205\t    /// C: `BBR1ModulateCwndForProbeRTT` (picoquic/bbr1.c:1015)\n206\t    ///\n207\t    /// While in `ProbeRtt`, cap `cwin` at `BBR1_MIN_PIPE_CWND` (4 × MTU) so\n208\t    /// the queue drains and a fresh minimum-RTT sample can be obtained.\n209\t    pub fn modulate_cwnd_for_probe_rtt(&self, path_x: &mut Path) {\n210\t        if self.state == Bbr1AlgState::ProbeRtt {\n211\t            let min_pipe = path_x.send_mtu as u64 * 4;\n212\t            if path_x.cwin > min_pipe {\n213\t                path_x.cwin = min_pipe;\n214\t            }\n215\t        }\n216\t    }\n217\t\n218\t    /// C: `BBR1SetSendQuantum` (picoquic/bbr1.c:334)\n219\t    ///\n220\t    /// Choose the send quantum (burst size) based on current pacing rate.\n221\t    pub fn set_send_quantum(&mut self, path_x: &Path) {\n222\t        if self.pacing_rate < BBR1_PACING_RATE_LOW {\n223\t            self.send_quantum = path_x.send_mtu as u64;\n224\t        } else if self.pacing_rate < BBR1_PACING_RATE_MEDIUM {\n225\t            self.send_quantum = 2 * path_x.send_mtu as u64;\n226\t        } else {\n227\t            self.send_quantum = (self.pacing_rate * self.quantum_ratio) as u64;\n228\t            if self.send_quantum > 0x10000 {\n229\t                self.send_quantum = 0x10000;\n230\t            }\n231\t        }\n232\t    }\n233\t\n234\t    /// C: `BBR1UpdateRTprop` (picoquic/bbr1.c:679)\n235\t    ///\n236\t    /// Update the minimum RTT propagation estimate and its timestamp.\n237\t    pub fn update_rt_prop(&mut self, rtt_sample: u64, current_time: u64) {\n238\t        self.rt_prop_expired = current_time > self.rt_prop_stamp + BBR1_PROBE_RTT_INTERVAL\n239\t            && current_time > self.rt_prop_stamp + 20 * self.rt_prop;\n240\t        if rtt_sample <= self.rt_prop || self.rt_prop_expired {\n241\t            self.rt_prop = rtt_sample;\n242\t            self.rt_prop_stamp = current_time;\n243\t        } else {\n244\t            let delta = rtt_sample - self.rt_prop;\n245\t            if 20 * delta < self.rt_prop {\n246\t                self.rt_prop_stamp = current_time;\n247\t            }\n248\t        }\n249\t    }\n250\t\n251\t    /// C: `BBR1ltbwResetInterval` (picoquic/bbr1.c:494)\n252\t    ///\n253\t    /// Reset the long-term bandwidth sampling interval to the current time and\n254\t    /// delivery/loss counters.\n255\t    pub fn ltbw_reset_interval(&mut self, path_x: &Path, current_time: u64) {\n256\t        self.lt_last_stamp = current_time;\n257\t        self.previous_sampling_delivered = path_x.delivered;\n258\t        self.previous_sampling_lost = path_x.total_bytes_lost;\n259\t        self.previous_round_lost = path_x.total_bytes_lost;\n260\t        self.lt_rtt_cnt = 0;\n261\t    }\n262\t\n263\t    /// C: `BBR1SetMinimalGain` (picoquic/bbr1.c:715)\n264\t    ///\n265\t    /// Raise `pacing_gain` when the BDP is so small that 4 MTUs exceed the\n266\t    /// estimated in-flight window, ensuring we send at least that burst.\n267\t    pub fn set_minimal_gain(&mut self) {\n268\t        if self.pacing_gain > 1.0 && self.rt_prop > 0 {\n269\t            let target_cwin = bytes_from_rate(self.rt_prop, self.btl_bw);\n270\t            let min_cwin = 4 * MAX_PACKET_SIZE as u64;\n271\t            if target_cwin < min_cwin {\n272\t                let d_gain = min_cwin as f64 / target_cwin as f64;\n273\t                if d_gain > self.pacing_gain {\n274\t                    self.pacing_gain = d_gain;\n275\t                }\n276\t            }\n277\t        }\n278\t    }\n279\t\n280\t    /// C: `InLossRecovery1` (picoquic/bbr1.c:902)\n281\t    fn in_loss_recovery(&self) -> bool {\n282\t        self.packet_conservation\n283\t    }\n284\t\n285\t    /// C: `picoquic_bbr1_observe` (picoquic/bbr1.c:1323)\n286\t    ///\n287\t    /// Return the current algorithm-state tag and bottleneck-bandwidth estimate\n288\t    /// so the surrounding scheduler can inspect the congestion state.\n289\t    pub fn observe(&self) -> (u64, u64) {\n290\t        (self.state as u64, self.btl_bw)\n291\t    }\n292\t\n293\t    /// C: `picoquic_bbr1_set_options` (picoquic/bbr1.c:379)\n294\t    ///\n295\t    /// Parse `option_string` and apply recognised keys:\n296\t    /// `T<digits>` → `wifi_shadow_rtt` (microseconds);\n297\t    /// `Q<digits>[.<digits>]` → `quantum_ratio` (decimal fraction).\n298\t    /// Unknown characters and `:` separators are silently skipped.\n299\t    #[allow(dead_code)]\n300\t    fn set_options(&mut self) {\n301\t        let opt = match &self.option_string {\n302\t            Some(s) => s.clone(),\n303\t            None => return,\n304\t        };\n305\t        let mut chars = opt.chars().peekable();\n306\t        while let Some(c) = chars.next() {\n307\t            match c {\n308\t                'T' => {\n309\t                    let mut u: u64 = 0;\n310\t                    while let Some(&d) = chars.peek() {\n311\t                        if d.is_ascii_digit() {\n312\t                            u = u * 10 + (d as u64 - '0' as u64);\n313\t                            chars.next();\n314\t                        } else {\n315\t                            break;\n316\t                        }\n317\t                    }\n318\t                    self.wifi_shadow_rtt = u;\n319\t                }\n320\t                'Q' => {\n321\t                    // The C outer `while` is an `if` — executes at most once.\n322\t                    if chars.peek().is_some() {\n323\t                        let mut d: f64 = 0.0;\n324\t                        let mut div: f64 = 1.0;\n325\t                        let mut dotted = false;\n326\t                        while let Some(&ch) = chars.peek() {\n327\t                            if ch.is_ascii_digit() {\n328\t                                let digit = ch as u64 - '0' as u64;\n329\t                                if !dotted {\n330\t                                    d = d * 10.0 + digit as f64;\n331\t                                } else {\n332\t                                    div /= 10.0;\n333\t                                    d += div * digit as f64;\n334\t                                }\n335\t                                chars.next();\n336\t                            } else if ch == '.' {\n337\t                                if dotted {\n338\t                                    break;\n339\t                                } else {\n340\t                                    dotted = true;\n341\t                                    chars.next();\n342\t                                }\n343\t                            } else {\n344\t                                break;\n345\t                            }\n346\t                        }\n347\t                        self.quantum_ratio = d;\n348\t                    }\n349\t                    // C falls through to ':' (ignore) here; no extra action needed.\n350\t                }\n351\t                _ => { /* ignore separator or unknown key */ }\n352\t            }\n353\t        }\n354\t    }\n355\t\n356\t    /// C: `picoquic_bbr1_suspension_almost_over` (picoquic/bbr1.c:1162)\n357\t    ///\n358\t    /// After a spurious-repeat notification, mark the suspension as nearly\n359\t    /// over so `suspension_exit` can restore the saved window on the next\n360\t    /// acknowledgement.\n361\t    pub fn suspension_almost_over(&mut self, lost_packet_number: u64) {\n362\t        if self.is_suspended\n363\t            && self.cwin_before_suspension > 0\n364\t            && !self.is_suspension_nearly_over\n365\t            && self.congestion_sequence >= lost_packet_number\n366\t        {\n367\t            self.is_suspension_nearly_over = true;\n368\t        }\n369\t    }\n370\t}\n371\t\n372\t#[cfg(test)]\n373\tmod tests {\n374\t    use super::*;\n375\t\n376\t    fn make_state() -> Bbr1State {\n377\t        Bbr1State {\n378\t            state: Bbr1AlgState::default(),\n379\t            btl_bw: 0,\n380\t            next_round_delivered: 0,\n381\t            btl_bw_filter: [0; BBR1_BTL_BW_FILTER_LENGTH],\n382\t            full_bw: 0,\n383\t            rt_prop: 0,\n384\t            rt_prop_stamp: 0,\n385\t            cycle_stamp: 0,\n386\t            probe_rtt_done_stamp: 0,\n387\t            prior_cwnd: 0,\n388\t            prior_in_flight: 0,\n389\t            bytes_delivered: 0,\n390\t            send_quantum: 0,\n391\t            rtt_filter: MinMaxRtt::default(),\n392\t            target_cwnd: 0,\n393\t            pacing_gain: 1.0,\n394\t            cwnd_gain: 1.0,\n395\t            pacing_rate: 0.0,\n396\t            cycle_index: 0,\n397\t            cycle_start: 0,\n398\t            round_count: 0,\n399\t            full_bw_count: 0,\n400\t            lt_rtt_cnt: 0,\n401\t            lt_bw: 0,\n402\t            lt_last_stamp: 0,\n403\t            previous_round_lost: 0,\n404\t            previous_sampling_delivered: 0,\n405\t            previous_sampling_lost: 0,\n406\t            loss_interval_start: 0,\n407\t            congestion_sequence: 0,\n408\t            cwin_before_suspension: 0,\n409\t            option_string: None,\n410\t            wifi_shadow_rtt: 0,\n411\t            quantum_ratio: 0.001,\n412\t            filled_pipe: false,\n413\t            round_start: false,\n414\t            rt_prop_expired: false,\n415\t            probe_rtt_round_done: false,\n416\t            idle_restart: false,\n417\t            packet_conservation: false,\n418\t            btl_bw_increased: false,\n419\t            lt_use_bw: false,\n420\t            lt_is_sampling: false,\n421\t            last_loss_was_timeout: false,\n422\t            cycle_on_loss: false,\n423\t            is_suspended: false,\n424\t            is_suspension_nearly_over: false,\n425\t        }\n426\t    }\n427\t\n428\t    #[test]\n429\t    fn enter_startup_sets_state_and_gains() {\n430\t        let mut s = make_state();\n431\t        s.enter_startup();\n432\t        assert_eq!(s.state, Bbr1AlgState::Startup);\n433\t        assert!((s.pacing_gain - BBR1_HIGH_GAIN).abs() < f64::EPSILON);\n434\t        assert!((s.cwnd_gain - BBR1_HIGH_GAIN).abs() < f64::EPSILON);\n435\t    }\n436\t\n437\t    #[test]\n438\t    fn check_full_pipe_growing_resets_count() {\n439\t        let mut s = make_state();\n440\t        s.round_start = true;\n441\t        s.full_bw = 1000;\n442\t        s.btl_bw = 1300; // >= 1.25 * 1000\n443\t        s.check_full_pipe(false);\n444\t        assert_eq!(s.full_bw, 1300);\n445\t        assert_eq!(s.full_bw_count, 0);\n446\t        assert!(!s.filled_pipe);\n447\t    }\n448\t\n449\t    #[test]\n450\t    fn check_full_pipe_fills_after_3_stall_rounds() {\n451\t        let mut s = make_state();\n452\t        s.round_start = true;\n453\t        s.full_bw = 1000;\n454\t        s.btl_bw = 900; // < 1.25 * 1000\n455\t        s.check_full_pipe(false);\n456\t        assert_eq!(s.full_bw_count, 1);\n457\t        assert!(!s.filled_pipe);\n458\t        s.check_full_pipe(false);\n459\t        assert_eq!(s.full_bw_count, 2);\n460\t        s.check_full_pipe(false);\n461\t        assert_eq!(s.full_bw_count, 3);\n462\t        assert!(s.filled_pipe);\n463\t    }\n464\t\n465\t    #[test]\n466\t    fn check_full_pipe_skips_when_app_limited() {\n467\t        let mut s = make_state();\n468\t        s.round_start = true;\n469\t        s.full_bw = 1000;\n470\t        s.btl_bw = 900;\n471\t        s.check_full_pipe(true); // app-limited → skip\n472\t        assert_eq!(s.full_bw_count, 0);\n473\t        assert!(!s.filled_pipe);\n474\t    }\n475\t\n476\t    #[test]\n477\t    fn check_full_pipe_skips_when_already_filled() {\n478\t        let mut s = make_state();\n479\t        s.round_start = true;\n480\t        s.filled_pipe = true;\n481\t        s.full_bw = 1000;\n482\t        s.btl_bw = 900;\n483\t        s.check_full_pipe(false);\n484\t        assert_eq!(s.full_bw_count, 0); // guard skips the body\n485\t    }\n486\t\n487\t    #[test]\n488\t    fn enter_probe_rtt_sets_state_and_unity_gains() {\n489\t        let mut s = make_state();\n490\t        s.enter_probe_rtt();\n491\t        assert_eq!(s.state, Bbr1AlgState::ProbeRtt);\n492\t        assert!((s.pacing_gain - 1.0).abs() < f64::EPSILON);\n493\t        assert!((s.cwnd_gain - 1.0).abs() < f64::EPSILON);\n494\t    }\n495\t\n496\t    #[test]\n497\t    fn after_one_roundtrip_clears_packet_conservation() {\n498\t        let mut s = make_state();\n499\t        s.packet_conservation = true;\n500\t        s.after_one_roundtrip_in_fast_recovery();\n501\t        assert!(!s.packet_conservation);\n502\t    }\n503\t\n504\t    // --- BBR1GetBtlBW ---\n505\t\n506\t    #[test]\n507\t    fn get_btl_bw_uses_lt_bw_when_flag_set() {\n508\t        let mut s = make_state();\n509\t        s.btl_bw = 1_000_000;\n510\t        s.lt_bw = 500_000;\n511\t        s.lt_use_bw = true;\n512\t        assert_eq!(s.get_btl_bw(), 500_000);\n513\t    }\n514\t\n515\t    #[test]\n516\t    fn get_btl_bw_uses_btl_bw_when_flag_clear() {\n517\t        let mut s = make_state();\n518\t        s.btl_bw = 1_000_000;\n519\t        s.lt_bw = 500_000;\n520\t        s.lt_use_bw = false;\n521\t        assert_eq!(s.get_btl_bw(), 1_000_000);\n522\t    }\n523\t\n524\t    // --- BBR1UpdateRTprop ---\n525\t\n526\t    #[test]\n527\t    fn update_rt_prop_lower_sample_updates() {\n528\t        let mut s = make_state();\n529\t        s.rt_prop = 10_000;\n530\t        s.rt_prop_stamp = 0;\n531\t        s.update_rt_prop(8_000, 1_000_000);\n532\t        assert_eq!(s.rt_prop, 8_000);\n533\t        assert_eq!(s.rt_prop_stamp, 1_000_000);\n534\t    }\n535\t\n536\t    #[test]\n537\t    fn update_rt_prop_slightly_higher_refreshes_stamp() {\n538\t        let mut s = make_state();\n539\t        s.rt_prop = 10_000;\n540\t        s.rt_prop_stamp = 0;\n541\t        // delta = 500, 20*500 = 10_000 = rt_prop → not < → stamp not refreshed\n542\t        // delta = 100, 20*100 = 2000 < 10_000 → stamp refreshed\n543\t        s.update_rt_prop(10_100, 1_000_000);\n544\t        assert_eq!(s.rt_prop, 10_000); // unchanged\n545\t        assert_eq!(s.rt_prop_stamp, 1_000_000); // refreshed\n546\t    }\n547\t\n548\t    #[test]\n549\t    fn update_rt_prop_expired_replaces_value() {\n550\t        let mut s = make_state();\n551\t        s.rt_prop = 1_000;\n552\t        s.rt_prop_stamp = 0;\n553\t        // current_time > stamp + 10_000_000 AND > stamp + 20*1000 = 20_000\n554\t        s.update_rt_prop(5_000, 11_000_000);\n555\t        assert!(s.rt_prop_expired);\n556\t        assert_eq!(s.rt_prop, 5_000);\n557\t    }\n558\t\n559\t    // --- BBR1SetMinimalGain ---\n560\t\n561\t    #[test]\n562\t    fn set_minimal_gain_raises_when_bdp_too_small() {\n563\t        let mut s = make_state();\n564\t        s.pacing_gain = 1.5;\n565\t        s.rt_prop = 1_000; // 1 ms\n566\t        s.btl_bw = 100_000; // 100 KB/s → BDP = 100 bytes  << 4*1536\n567\t        s.set_minimal_gain();\n568\t        // target_cwin = 1000 * 100_000 / 1_000_000 = 100\n569\t        // d_gain = (4*1536) / 100 = 61.44\n570\t        assert!(s.pacing_gain > 1.5);\n571\t    }\n572\t\n573\t    #[test]\n574\t    fn set_minimal_gain_no_change_when_bdp_large() {\n575\t        let mut s = make_state();\n576\t        s.pacing_gain = 1.5;\n577\t        s.rt_prop = 100_000; // 100 ms\n578\t        s.btl_bw = 10_000_000; // 10 MB/s → BDP = 1_000_000 >> 4*1536\n579\t        s.set_minimal_gain();\n580\t        assert!((s.pacing_gain - 1.5).abs() < f64::EPSILON);\n581\t    }\n582\t\n583\t    #[test]\n584\t    fn set_minimal_gain_skips_when_pacing_gain_le_one() {\n585\t        let mut s = make_state();\n586\t        s.pacing_gain = 0.75;\n587\t        s.rt_prop = 1_000;\n588\t        s.btl_bw = 100_000;\n589\t        s.set_minimal_gain();\n590\t        assert!((s.pacing_gain - 0.75).abs() < f64::EPSILON);\n591\t    }\n592\t\n593\t    // --- InLossRecovery1 ---\n594\t\n595\t    #[test]\n596\t    fn in_loss_recovery_reflects_packet_conservation() {\n597\t        let mut s = make_state();\n598\t        assert!(!s.in_loss_recovery());\n599\t        s.packet_conservation = true;\n600\t        assert!(s.in_loss_recovery());\n601\t    }\n602\t\n603\t    // --- picoquic_bbr1_observe ---\n604\t\n605\t    #[test]\n606\t    fn observe_returns_state_and_btl_bw() {\n607\t        let mut s = make_state();\n608\t        s.state = Bbr1AlgState::ProbeBw;\n609\t        s.btl_bw = 5_000_000;\n610\t        let (cc_state, cc_param) = s.observe();\n611\t        assert_eq!(cc_state, Bbr1AlgState::ProbeBw as u64);\n612\t        assert_eq!(cc_param, 5_000_000);\n613\t    }\n614\t\n615\t    // --- picoquic_bbr1_suspension_almost_over ---\n616\t\n617\t    #[test]\n618\t    fn suspension_almost_over_sets_flag_when_conditions_met() {\n619\t        let mut s = make_state();\n620\t        s.is_suspended = true;\n621\t        s.cwin_before_suspension = 10_000;\n622\t        s.congestion_sequence = 100;\n623\t        s.suspension_almost_over(100);\n624\t        assert!(s.is_suspension_nearly_over);\n625\t    }\n626\t\n627\t    #[test]\n628\t    fn suspension_almost_over_no_op_when_not_suspended() {\n629\t        let mut s = make_state();\n630\t        s.is_suspended = false;\n631\t        s.cwin_before_suspension = 10_000;\n632\t        s.congestion_sequence = 100;\n633\t        s.suspension_almost_over(100);\n634\t        assert!(!s.is_suspension_nearly_over);\n635\t    }\n636\t\n637\t    #[test]\n638\t    fn suspension_almost_over_no_op_when_packet_after_sequence() {\n639\t        let mut s = make_state();\n640\t        s.is_suspended = true;\n641\t        s.cwin_before_suspension = 10_000;\n642\t        s.congestion_sequence = 50;\n643\t        s.suspension_almost_over(100); // lost_packet_number > congestion_sequence\n644\t        assert!(!s.is_suspension_nearly_over);\n645\t    }\n646\t\n647\t    // --- picoquic_bbr1_set_options ---\n648\t\n649\t    #[test]\n650\t    fn set_options_parses_t_prefix() {\n651\t        let mut s = make_state();\n652\t        s.option_string = Some(\"T123456\".to_string());\n653\t        s.set_options();\n654\t        assert_eq!(s.wifi_shadow_rtt, 123_456);\n655\t    }\n656\t\n657\t    #[test]\n658\t    fn set_options_parses_q_prefix_integer() {\n659\t        let mut s = make_state();\n660\t        s.option_string = Some(\"Q5\".to_string());\n661\t        s.set_options();\n662\t        assert!((s.quantum_ratio - 5.0).abs() < 1e-9);\n663\t    }\n664\t\n665\t    #[test]\n666\t    fn set_options_parses_q_prefix_decimal() {\n667\t        let mut s = make_state();\n668\t        s.option_string = Some(\"Q0.001\".to_string());\n669\t        s.set_options();\n670\t        assert!((s.quantum_ratio - 0.001).abs() < 1e-9);\n671\t    }\n672\t\n673\t    #[test]\n674\t    fn set_options_none_is_noop() {\n675\t        let mut s = make_state();\n676\t        s.option_string = None;\n677\t        s.wifi_shadow_rtt = 99;\n678\t        s.set_options();\n679\t        assert_eq!(s.wifi_shadow_rtt, 99); // unchanged\n680\t    }\n681\t}\n682\t"}]},"parent_tool_use_id":null,"session_id":"d20b6616-3e94-405e-9dce-5ca7b1121948","uuid":"b5b69070-b1cf-42e6-b1dc-dc15045a679d","timestamp":"2026-05-07T13:15:54.764Z","tool_use_result":{"type":"text","file":{"filePath":"/Users/richbarn/Projects/picoquic/rs/fq/src/bbr1.rs","content":"//! Translation of `picoquic/bbr1.c` — BBRv1 congestion control.\n//!\n//! Phase 4B: initial batch (BBR1AfterOneRoundtripInFastRecovery,\n//! BBR1CheckFullPipe, BBR1EnterProbeRTT, BBR1EnterStartup).\n//! Phase 4B missing batch (BBR1EnterStartupLongRTT, BBR1GetBtlBW,\n//! BBR1ModulateCwndForProbeRTT, BBR1ModulateCwndForRecovery, BBR1RestoreCwnd).\n\nuse crate::cc_common::MinMaxRtt;\nuse crate::internal::{CWIN_INITIAL, MAX_PACKET_SIZE, Path, TARGET_RENO_RTT, TARGET_SATELLITE_RTT};\nuse crate::utils::bytes_from_rate;\n\n// ---------------------------------------------------------------------------\n// Constants from bbr1.c `#define`s.\n\nconst BBR1_HIGH_GAIN: f64 = 2.8853900817779; // C: BBR1_HIGH_GAIN (2/ln(2))\nconst BBR1_BTL_BW_FILTER_LENGTH: usize = 10; // C: BBR1_BTL_BW_FILTER_LENGTH\nconst BBR1_PROBE_RTT_INTERVAL: u64 = 10_000_000; // 10 sec in microseconds\nconst BBR1_PACING_RATE_LOW: f64 = 150_000.0; // 1.2 Mbps in B/s\nconst BBR1_PACING_RATE_MEDIUM: f64 = 3_000_000.0; // 24 Mbps in B/s\n\n// ---------------------------------------------------------------------------\n// Algorithm-state enum.  C: `picoquic_bbr1_alg_state_t`.\n\n#[derive(Debug, Copy, Clone, PartialEq, Eq, Default)]\npub enum Bbr1AlgState {\n    #[default]\n    Startup = 0,\n    Drain,\n    ProbeBw,\n    ProbeRtt,\n    StartupLongRtt,\n}\n\n// ---------------------------------------------------------------------------\n// BBR1 state.  C: `picoquic_bbr1_state_t`.\n//\n// Type deviations from C:\n//   * single-bit `unsigned int x : 1` bitfields → `bool`\n//   * `const char* option_string` → `Option<String>` (owned copy)\n//   * `picoquic_min_max_rtt_t rtt_filter` → `MinMaxRtt`\n//   * `int` round/count fields → `i32` (faithfully signed)\n\npub struct Bbr1State {\n    pub state: Bbr1AlgState,\n    pub btl_bw: u64,\n    pub next_round_delivered: u64,\n    pub btl_bw_filter: [u64; BBR1_BTL_BW_FILTER_LENGTH],\n    pub full_bw: u64,\n    pub rt_prop: u64,\n    pub rt_prop_stamp: u64,\n    pub cycle_stamp: u64,\n    pub probe_rtt_done_stamp: u64,\n    pub prior_cwnd: u64,\n    pub prior_in_flight: u64,\n    pub bytes_delivered: u64,\n    pub send_quantum: u64,\n    pub rtt_filter: MinMaxRtt,\n    pub target_cwnd: u64,\n    pub pacing_gain: f64,\n    pub cwnd_gain: f64,\n    pub pacing_rate: f64,\n    pub cycle_index: u32,\n    pub cycle_start: u32,\n    pub round_count: i32,\n    pub full_bw_count: i32,\n    pub lt_rtt_cnt: i32,\n    pub lt_bw: u64,\n    pub lt_last_stamp: u64,\n    pub previous_round_lost: u64,\n    pub previous_sampling_delivered: u64,\n    pub previous_sampling_lost: u64,\n    pub loss_interval_start: u64,\n    pub congestion_sequence: u64,\n    pub cwin_before_suspension: u64,\n    pub option_string: Option<String>,\n    pub wifi_shadow_rtt: u64,\n    pub quantum_ratio: f64,\n    pub filled_pipe: bool,\n    pub round_start: bool,\n    pub rt_prop_expired: bool,\n    pub probe_rtt_round_done: bool,\n    pub idle_restart: bool,\n    pub packet_conservation: bool,\n    pub btl_bw_increased: bool,\n    pub lt_use_bw: bool,\n    pub lt_is_sampling: bool,\n    pub last_loss_was_timeout: bool,\n    pub cycle_on_loss: bool,\n    pub is_suspended: bool,\n    pub is_suspension_nearly_over: bool,\n}\n\nimpl Bbr1State {\n    /// C: `BBR1EnterStartup` (picoquic/bbr1.c:327)\n    ///\n    /// Enter the Startup state with the high-gain pacing and cwnd multipliers.\n    pub fn enter_startup(&mut self) {\n        self.state = Bbr1AlgState::Startup;\n        self.pacing_gain = BBR1_HIGH_GAIN;\n        self.cwnd_gain = BBR1_HIGH_GAIN;\n    }\n\n    /// C: `BBR1CheckFullPipe` (picoquic/bbr1.c:771)\n    ///\n    /// Detect when the pipe is full during Startup.  On each round start\n    /// (unless app-limited or already detected), check whether `btl_bw`\n    /// has grown by ≥ 25%.  After three consecutive rounds without\n    /// sufficient growth, set `filled_pipe`.\n    pub fn check_full_pipe(&mut self, rs_is_app_limited: bool) {\n        if !self.filled_pipe && self.round_start && !rs_is_app_limited {\n            if self.btl_bw as f64 >= self.full_bw as f64 * 1.25 {\n                self.full_bw = self.btl_bw;\n                self.full_bw_count = 0;\n            } else {\n                self.full_bw_count += 1;\n                if self.full_bw_count >= 3 {\n                    self.filled_pipe = true;\n                }\n            }\n        }\n    }\n\n    /// C: `BBR1EnterProbeRTT` (picoquic/bbr1.c:885)\n    ///\n    /// Enter ProbeRTT state: coast at unity gains to drain the queue and\n    /// obtain a fresh minimum-RTT sample.\n    pub fn enter_probe_rtt(&mut self) {\n        self.state = Bbr1AlgState::ProbeRtt;\n        self.pacing_gain = 1.0;\n        self.cwnd_gain = 1.0;\n    }\n\n    /// C: `BBR1AfterOneRoundtripInFastRecovery` (picoquic/bbr1.c:1107)\n    ///\n    /// After the first full round-trip in fast recovery, disable packet\n    /// conservation so the congestion window can grow normally again.\n    pub fn after_one_roundtrip_in_fast_recovery(&mut self) {\n        self.packet_conservation = false;\n    }\n\n    /// C: `BBR1GetBtlBW` (picoquic/bbr1.c:304)\n    ///\n    /// Return the effective bottleneck bandwidth: the long-term estimate when\n    /// `lt_use_bw` is set, otherwise the filter-max `btl_bw`.\n    fn get_btl_bw(&self) -> u64 {\n        if self.lt_use_bw {\n            self.lt_bw\n        } else {\n            self.btl_bw\n        }\n    }\n\n    /// C: `BBR1EnterStartupLongRTT` (picoquic/bbr1.c:309)\n    ///\n    /// Switch into `StartupLongRtt` state and ensure `cwin` is at least\n    /// `CWIN_INITIAL` scaled by the path RTT (capped at the satellite ceiling).\n    pub fn enter_startup_long_rtt(&mut self, path_x: &mut Path) {\n        let mut cwnd = CWIN_INITIAL;\n        self.state = Bbr1AlgState::StartupLongRtt;\n        if path_x.rtt_min > TARGET_RENO_RTT {\n            let rtt_cap = if path_x.rtt_min > TARGET_SATELLITE_RTT {\n                TARGET_SATELLITE_RTT\n            } else {\n                path_x.rtt_min\n            };\n            cwnd = (cwnd as f64 * rtt_cap.ticks() as f64 / TARGET_RENO_RTT.ticks() as f64) as u64;\n        }\n        if cwnd > path_x.cwin {\n            path_x.cwin = cwnd;\n        }\n    }\n\n    /// C: `BBR1RestoreCwnd` (picoquic/bbr1.c:918)\n    ///\n    /// Restore `cwin` to `prior_cwnd` if the current window has shrunk below it.\n    pub fn restore_cwnd(&self, path_x: &mut Path) {\n        if path_x.cwin < self.prior_cwnd {\n            path_x.cwin = self.prior_cwnd;\n        }\n    }\n\n    /// C: `BBR1ModulateCwndForRecovery` (picoquic/bbr1.c:996)\n    ///\n    /// Adjust `cwin` for the recovery phase: subtract lost bytes (floored at\n    /// one MTU), then enforce packet-conservation if active.\n    pub fn modulate_cwnd_for_recovery(\n        &mut self,\n        path_x: &mut Path,\n        bytes_in_transit: u64,\n        bytes_lost: u64,\n        bytes_delivered: u64,\n    ) {\n        if bytes_lost > 0 {\n            if path_x.cwin > bytes_lost {\n                path_x.cwin -= bytes_lost;\n            } else {\n                path_x.cwin = path_x.send_mtu as u64;\n            }\n        }\n        if self.packet_conservation && path_x.cwin < bytes_in_transit + bytes_delivered {\n            path_x.cwin = bytes_in_transit + bytes_delivered;\n        }\n    }\n\n    /// C: `BBR1ModulateCwndForProbeRTT` (picoquic/bbr1.c:1015)\n    ///\n    /// While in `ProbeRtt`, cap `cwin` at `BBR1_MIN_PIPE_CWND` (4 × MTU) so\n    /// the queue drains and a fresh minimum-RTT sample can be obtained.\n    pub fn modulate_cwnd_for_probe_rtt(&self, path_x: &mut Path) {\n        if self.state == Bbr1AlgState::ProbeRtt {\n            let min_pipe = path_x.send_mtu as u64 * 4;\n            if path_x.cwin > min_pipe {\n                path_x.cwin = min_pipe;\n            }\n        }\n    }\n\n    /// C: `BBR1SetSendQuantum` (picoquic/bbr1.c:334)\n    ///\n    /// Choose the send quantum (burst size) based on current pacing rate.\n    pub fn set_send_quantum(&mut self, path_x: &Path) {\n        if self.pacing_rate < BBR1_PACING_RATE_LOW {\n            self.send_quantum = path_x.send_mtu as u64;\n        } else if self.pacing_rate < BBR1_PACING_RATE_MEDIUM {\n            self.send_quantum = 2 * path_x.send_mtu as u64;\n        } else {\n            self.send_quantum = (self.pacing_rate * self.quantum_ratio) as u64;\n            if self.send_quantum > 0x10000 {\n                self.send_quantum = 0x10000;\n            }\n        }\n    }\n\n    /// C: `BBR1UpdateRTprop` (picoquic/bbr1.c:679)\n    ///\n    /// Update the minimum RTT propagation estimate and its timestamp.\n    pub fn update_rt_prop(&mut self, rtt_sample: u64, current_time: u64) {\n        self.rt_prop_expired = current_time > self.rt_prop_stamp + BBR1_PROBE_RTT_INTERVAL\n            && current_time > self.rt_prop_stamp + 20 * self.rt_prop;\n        if rtt_sample <= self.rt_prop || self.rt_prop_expired {\n            self.rt_prop = rtt_sample;\n            self.rt_prop_stamp = current_time;\n        } else {\n            let delta = rtt_sample - self.rt_prop;\n            if 20 * delta < self.rt_prop {\n                self.rt_prop_stamp = current_time;\n            }\n        }\n    }\n\n    /// C: `BBR1ltbwResetInterval` (picoquic/bbr1.c:494)\n    ///\n    /// Reset the long-term bandwidth sampling interval to the current time and\n    /// delivery/loss counters.\n    pub fn ltbw_reset_interval(&mut self, path_x: &Path, current_time: u64) {\n        self.lt_last_stamp = current_time;\n        self.previous_sampling_delivered = path_x.delivered;\n        self.previous_sampling_lost = path_x.total_bytes_lost;\n        self.previous_round_lost = path_x.total_bytes_lost;\n        self.lt_rtt_cnt = 0;\n    }\n\n    /// C: `BBR1SetMinimalGain` (picoquic/bbr1.c:715)\n    ///\n    /// Raise `pacing_gain` when the BDP is so small that 4 MTUs exceed the\n    /// estimated in-flight window, ensuring we send at least that burst.\n    pub fn set_minimal_gain(&mut self) {\n        if self.pacing_gain > 1.0 && self.rt_prop > 0 {\n            let target_cwin = bytes_from_rate(self.rt_prop, self.btl_bw);\n            let min_cwin = 4 * MAX_PACKET_SIZE as u64;\n            if target_cwin < min_cwin {\n                let d_gain = min_cwin as f64 / target_cwin as f64;\n                if d_gain > self.pacing_gain {\n                    self.pacing_gain = d_gain;\n                }\n            }\n        }\n    }\n\n    /// C: `InLossRecovery1` (picoquic/bbr1.c:902)\n    fn in_loss_recovery(&self) -> bool {\n        self.packet_conservation\n    }\n\n    /// C: `picoquic_bbr1_observe` (picoquic/bbr1.c:1323)\n    ///\n    /// Return the current algorithm-state tag and bottleneck-bandwidth estimate\n    /// so the surrounding scheduler can inspect the congestion state.\n    pub fn observe(&self) -> (u64, u64) {\n        (self.state as u64, self.btl_bw)\n    }\n\n    /// C: `picoquic_bbr1_set_options` (picoquic/bbr1.c:379)\n    ///\n    /// Parse `option_string` and apply recognised keys:\n    /// `T<digits>` → `wifi_shadow_rtt` (microseconds);\n    /// `Q<digits>[.<digits>]` → `quantum_ratio` (decimal fraction).\n    /// Unknown characters and `:` separators are silently skipped.\n    #[allow(dead_code)]\n    fn set_options(&mut self) {\n        let opt = match &self.option_string {\n            Some(s) => s.clone(),\n            None => return,\n        };\n        let mut chars = opt.chars().peekable();\n        while let Some(c) = chars.next() {\n            match c {\n                'T' => {\n                    let mut u: u64 = 0;\n                    while let Some(&d) = chars.peek() {\n                        if d.is_ascii_digit() {\n                            u = u * 10 + (d as u64 - '0' as u64);\n                            chars.next();\n                        } else {\n                            break;\n                        }\n                    }\n                    self.wifi_shadow_rtt = u;\n                }\n                'Q' => {\n                    // The C outer `while` is an `if` — executes at most once.\n                    if chars.peek().is_some() {\n                        let mut d: f64 = 0.0;\n                        let mut div: f64 = 1.0;\n                        let mut dotted = false;\n                        while let Some(&ch) = chars.peek() {\n                            if ch.is_ascii_digit() {\n                                let digit = ch as u64 - '0' as u64;\n                                if !dotted {\n                                    d = d * 10.0 + digit as f64;\n                                } else {\n                                    div /= 10.0;\n                                    d += div * digit as f64;\n                                }\n                                chars.next();\n                            } else if ch == '.' {\n                                if dotted {\n                                    break;\n                                } else {\n                                    dotted = true;\n                                    chars.next();\n                                }\n                            } else {\n                                break;\n                            }\n                        }\n                        self.quantum_ratio = d;\n                    }\n                    // C falls through to ':' (ignore) here; no extra action needed.\n                }\n                _ => { /* ignore separator or unknown key */ }\n            }\n        }\n    }\n\n    /// C: `picoquic_bbr1_suspension_almost_over` (picoquic/bbr1.c:1162)\n    ///\n    /// After a spurious-repeat notification, mark the suspension as nearly\n    /// over so `suspension_exit` can restore the saved window on the next\n    /// acknowledgement.\n    pub fn suspension_almost_over(&mut self, lost_packet_number: u64) {\n        if self.is_suspended\n            && self.cwin_before_suspension > 0\n            && !self.is_suspension_nearly_over\n            && self.congestion_sequence >= lost_packet_number\n        {\n            self.is_suspension_nearly_over = true;\n        }\n    }\n}\n\n#[cfg(test)]\nmod tests {\n    use super::*;\n\n    fn make_state() -> Bbr1State {\n        Bbr1State {\n            state: Bbr1AlgState::default(),\n            btl_bw: 0,\n            next_round_delivered: 0,\n            btl_bw_filter: [0; BBR1_BTL_BW_FILTER_LENGTH],\n            full_bw: 0,\n            rt_prop: 0,\n            rt_prop_stamp: 0,\n            cycle_stamp: 0,\n            probe_rtt_done_stamp: 0,\n            prior_cwnd: 0,\n            prior_in_flight: 0,\n            bytes_delivered: 0,\n            send_quantum: 0,\n            rtt_filter: MinMaxRtt::default(),\n            target_cwnd: 0,\n            pacing_gain: 1.0,\n            cwnd_gain: 1.0,\n            pacing_rate: 0.0,\n            cycle_index: 0,\n            cycle_start: 0,\n            round_count: 0,\n            full_bw_count: 0,\n            lt_rtt_cnt: 0,\n            lt_bw: 0,\n            lt_last_stamp: 0,\n            previous_round_lost: 0,\n            previous_sampling_delivered: 0,\n            previous_sampling_lost: 0,\n            loss_interval_start: 0,\n            congestion_sequence: 0,\n            cwin_before_suspension: 0,\n            option_string: None,\n            wifi_shadow_rtt: 0,\n            quantum_ratio: 0.001,\n            filled_pipe: false,\n            round_start: false,\n            rt_prop_expired: false,\n            probe_rtt_round_done: false,\n            idle_restart: false,\n            packet_conservation: false,\n            btl_bw_increased: false,\n            lt_use_bw: false,\n            lt_is_sampling: false,\n            last_loss_was_timeout: false,\n            cycle_on_loss: false,\n            is_suspended: false,\n            is_suspension_nearly_over: false,\n        }\n    }\n\n    #[test]\n    fn enter_startup_sets_state_and_gains() {\n        let mut s = make_state();\n        s.enter_startup();\n        assert_eq!(s.state, Bbr1AlgState::Startup);\n        assert!((s.pacing_gain - BBR1_HIGH_GAIN).abs() < f64::EPSILON);\n        assert!((s.cwnd_gain - BBR1_HIGH_GAIN).abs() < f64::EPSILON);\n    }\n\n    #[test]\n    fn check_full_pipe_growing_resets_count() {\n        let mut s = make_state();\n        s.round_start = true;\n        s.full_bw = 1000;\n        s.btl_bw = 1300; // >= 1.25 * 1000\n        s.check_full_pipe(false);\n        assert_eq!(s.full_bw, 1300);\n        assert_eq!(s.full_bw_count, 0);\n        assert!(!s.filled_pipe);\n    }\n\n    #[test]\n    fn check_full_pipe_fills_after_3_stall_rounds() {\n        let mut s = make_state();\n        s.round_start = true;\n        s.full_bw = 1000;\n        s.btl_bw = 900; // < 1.25 * 1000\n        s.check_full_pipe(false);\n        assert_eq!(s.full_bw_count, 1);\n        assert!(!s.filled_pipe);\n        s.check_full_pipe(false);\n        assert_eq!(s.full_bw_count, 2);\n        s.check_full_pipe(false);\n        assert_eq!(s.full_bw_count, 3);\n        assert!(s.filled_pipe);\n    }\n\n    #[test]\n    fn check_full_pipe_skips_when_app_limited() {\n        let mut s = make_state();\n        s.round_start = true;\n        s.full_bw = 1000;\n        s.btl_bw = 900;\n        s.check_full_pipe(true); // app-limited → skip\n        assert_eq!(s.full_bw_count, 0);\n        assert!(!s.filled_pipe);\n    }\n\n    #[test]\n    fn check_full_pipe_skips_when_already_filled() {\n        let mut s = make_state();\n        s.round_start = true;\n        s.filled_pipe = true;\n        s.full_bw = 1000;\n        s.btl_bw = 900;\n        s.check_full_pipe(false);\n        assert_eq!(s.full_bw_count, 0); // guard skips the body\n    }\n\n    #[test]\n    fn enter_probe_rtt_sets_state_and_unity_gains() {\n        let mut s = make_state();\n        s.enter_probe_rtt();\n        assert_eq!(s.state, Bbr1AlgState::ProbeRtt);\n        assert!((s.pacing_gain - 1.0).abs() < f64::EPSILON);\n        assert!((s.cwnd_gain - 1.0).abs() < f64::EPSILON);\n    }\n\n    #[test]\n    fn after_one_roundtrip_clears_packet_conservation() {\n        let mut s = make_state();\n        s.packet_conservation = true;\n        s.after_one_roundtrip_in_fast_recovery();\n        assert!(!s.packet_conservation);\n    }\n\n    // --- BBR1GetBtlBW ---\n\n    #[test]\n    fn get_btl_bw_uses_lt_bw_when_flag_set() {\n        let mut s = make_state();\n        s.btl_bw = 1_000_000;\n        s.lt_bw = 500_000;\n        s.lt_use_bw = true;\n        assert_eq!(s.get_btl_bw(), 500_000);\n    }\n\n    #[test]\n    fn get_btl_bw_uses_btl_bw_when_flag_clear() {\n        let mut s = make_state();\n        s.btl_bw = 1_000_000;\n        s.lt_bw = 500_000;\n        s.lt_use_bw = false;\n        assert_eq!(s.get_btl_bw(), 1_000_000);\n    }\n\n    // --- BBR1UpdateRTprop ---\n\n    #[test]\n    fn update_rt_prop_lower_sample_updates() {\n        let mut s = make_state();\n        s.rt_prop = 10_000;\n        s.rt_prop_stamp = 0;\n        s.update_rt_prop(8_000, 1_000_000);\n        assert_eq!(s.rt_prop, 8_000);\n        assert_eq!(s.rt_prop_stamp, 1_000_000);\n    }\n\n    #[test]\n    fn update_rt_prop_slightly_higher_refreshes_stamp() {\n        let mut s = make_state();\n        s.rt_prop = 10_000;\n        s.rt_prop_stamp = 0;\n        // delta = 500, 20*500 = 10_000 = rt_prop → not < → stamp not refreshed\n        // delta = 100, 20*100 = 2000 < 10_000 → stamp refreshed\n        s.update_rt_prop(10_100, 1_000_000);\n        assert_eq!(s.rt_prop, 10_000); // unchanged\n        assert_eq!(s.rt_prop_stamp, 1_000_000); // refreshed\n    }\n\n    #[test]\n    fn update_rt_prop_expired_replaces_value() {\n        let mut s = make_state();\n        s.rt_prop = 1_000;\n        s.rt_prop_stamp = 0;\n        // current_time > stamp + 10_000_000 AND > stamp + 20*1000 = 20_000\n        s.update_rt_prop(5_000, 11_000_000);\n        assert!(s.rt_prop_expired);\n        assert_eq!(s.rt_prop, 5_000);\n    }\n\n    // --- BBR1SetMinimalGain ---\n\n    #[test]\n    fn set_minimal_gain_raises_when_bdp_too_small() {\n        let mut s = make_state();\n        s.pacing_gain = 1.5;\n        s.rt_prop = 1_000; // 1 ms\n        s.btl_bw = 100_000; // 100 KB/s → BDP = 100 bytes  << 4*1536\n        s.set_minimal_gain();\n        // target_cwin = 1000 * 100_000 / 1_000_000 = 100\n        // d_gain = (4*1536) / 100 = 61.44\n        assert!(s.pacing_gain > 1.5);\n    }\n\n    #[test]\n    fn set_minimal_gain_no_change_when_bdp_large() {\n        let mut s = make_state();\n        s.pacing_gain = 1.5;\n        s.rt_prop = 100_000; // 100 ms\n        s.btl_bw = 10_000_000; // 10 MB/s → BDP = 1_000_000 >> 4*1536\n        s.set_minimal_gain();\n        assert!((s.pacing_gain - 1.5).abs() < f64::EPSILON);\n    }\n\n    #[test]\n    fn set_minimal_gain_skips_when_pacing_gain_le_one() {\n        let mut s = make_state();\n        s.pacing_gain = 0.75;\n        s.rt_prop = 1_000;\n        s.btl_bw = 100_000;\n        s.set_minimal_gain();\n        assert!((s.pacing_gain - 0.75).abs() < f64::EPSILON);\n    }\n\n    // --- InLossRecovery1 ---\n\n    #[test]\n    fn in_loss_recovery_reflects_packet_conservation() {\n        let mut s = make_state();\n        assert!(!s.in_loss_recovery());\n        s.packet_conservation = true;\n        assert!(s.in_loss_recovery());\n    }\n\n    // --- picoquic_bbr1_observe ---\n\n    #[test]\n    fn observe_returns_state_and_btl_bw() {\n        let mut s = make_state();\n        s.state = Bbr1AlgState::ProbeBw;\n        s.btl_bw = 5_000_000;\n        let (cc_state, cc_param) = s.observe();\n        assert_eq!(cc_state, Bbr1AlgState::ProbeBw as u64);\n        assert_eq!(cc_param, 5_000_000);\n    }\n\n    // --- picoquic_bbr1_suspension_almost_over ---\n\n    #[test]\n    fn suspension_almost_over_sets_flag_when_conditions_met() {\n        let mut s = make_state();\n        s.is_suspended = true;\n        s.cwin_before_suspension = 10_000;\n        s.congestion_sequence = 100;\n        s.suspension_almost_over(100);\n        assert!(s.is_suspension_nearly_over);\n    }\n\n    #[test]\n    fn suspension_almost_over_no_op_when_not_suspended() {\n        let mut s = make_state();\n        s.is_suspended = false;\n        s.cwin_before_suspension = 10_000;\n        s.congestion_sequence = 100;\n        s.suspension_almost_over(100);\n        assert!(!s.is_suspension_nearly_over);\n    }\n\n    #[test]\n    fn suspension_almost_over_no_op_when_packet_after_sequence() {\n        let mut s = make_state();\n        s.is_suspended = true;\n        s.cwin_before_suspension = 10_000;\n        s.congestion_sequence = 50;\n        s.suspension_almost_over(100); // lost_packet_number > congestion_sequence\n        assert!(!s.is_suspension_nearly_over);\n    }\n\n    // --- picoquic_bbr1_set_options ---\n\n    #[test]\n    fn set_options_parses_t_prefix() {\n        let mut s = make_state();\n        s.option_string = Some(\"T123456\".to_string());\n        s.set_options();\n        assert_eq!(s.wifi_shadow_rtt, 123_456);\n    }\n\n    #[test]\n    fn set_options_parses_q_prefix_integer() {\n        let mut s = make_state();\n        s.option_string = Some(\"Q5\".to_string());\n        s.set_options();\n        assert!((s.quantum_ratio - 5.0).abs() < 1e-9);\n    }\n\n    #[test]\n    fn set_options_parses_q_prefix_decimal() {\n        let mut s = make_state();\n        s.option_string = Some(\"Q0.001\".to_string());\n        s.set_options();\n        assert!((s.quantum_ratio - 0.001).abs() < 1e-9);\n    }\n\n    #[test]\n    fn set_options_none_is_noop() {\n        let mut s = make_state();\n        s.option_string = None;\n        s.wifi_shadow_rtt = 99;\n        s.set_options();\n        assert_eq!(s.wifi_shadow_rtt, 99); // unchanged\n    }\n}\n","numLines":682,"startLine":1,"totalLines":682}}}
