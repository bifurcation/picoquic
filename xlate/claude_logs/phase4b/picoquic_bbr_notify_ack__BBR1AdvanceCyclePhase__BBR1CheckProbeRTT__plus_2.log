{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_0137oF1Tv2Mn4UtKfYqxdmuv","type":"tool_result","content":"720\t        if (target_cwin < 4 * PICOQUIC_MAX_PACKET_SIZE) {\n721\t            double d_target = (double)target_cwin;\n722\t            double d_gain = ((double)(4 * PICOQUIC_MAX_PACKET_SIZE)) / d_target;\n723\t\n724\t            if (d_gain > bbr1_state->pacing_gain) {\n725\t                bbr1_state->pacing_gain = d_gain;\n726\t            }\n727\t        }\n728\t    }\n729\t}\n730\t\n731\tvoid BBR1AdvanceCyclePhase(picoquic_bbr1_state_t* bbr1_state, uint64_t current_time)\n732\t{\n733\t    bbr1_state->cycle_on_loss = 0;\n734\t    bbr1_state->cycle_stamp = current_time;\n735\t    bbr1_state->cycle_index++;\n736\t    if (bbr1_state->cycle_index >= BBR1_GAIN_CYCLE_LEN) {\n737\t        unsigned int start = bbr1_state->cycle_start;\n738\t        if (bbr1_state->btl_bw_increased) {\n739\t            bbr1_state->btl_bw_increased = 0;\n740\t            start++;\n741\t            if (start > BBR1_GAIN_CYCLE_MAX_START) {\n742\t                start = BBR1_GAIN_CYCLE_MAX_START;\n743\t            }\n744\t        }\n745\t        else if (start > 0) {\n746\t            start--;\n747\t        }\n748\t        bbr1_state->cycle_index = start;\n749\t        bbr1_state->cycle_start = start;\n750\t    }\n751\t   \n752\t    bbr1_state->pacing_gain = bbr1_pacing_gain_cycle[bbr1_state->cycle_index];\n753\t    BBR1SetMinimalGain(bbr1_state);\n754\t}\n755\t\n756\tvoid BBR1CheckCyclePhase(picoquic_bbr1_state_t* bbr1_state, uint64_t packets_lost, uint64_t current_time)\n757\t{\n758\t    if (bbr1_state->state == picoquic_bbr1_alg_probe_bw &&\n759\t        BBR1IsNextCyclePhase(bbr1_state, bbr1_state->prior_in_flight, packets_lost, current_time)) {\n760\t        BBR1AdvanceCyclePhase(bbr1_state, current_time);\n761\t    }\n762\t}\n763\t\n764\tstatic void BBR1ResetProbeBwMode(picoquic_bbr1_state_t* bbr1_state, uint64_t current_time)\n765\t{\n766\t    bbr1_state->state = picoquic_bbr1_alg_probe_bw;\n767\t    bbr1_state->cycle_index = 2;\n768\t    BBR1AdvanceCyclePhase(bbr1_state, current_time);\n769\t}\n770\t\n771\tvoid BBR1CheckFullPipe(picoquic_bbr1_state_t* bbr1_state, int rs_is_app_limited)\n772\t{\n773\t    if (!bbr1_state->filled_pipe && bbr1_state->round_start && !rs_is_app_limited) {\n774\t        if (bbr1_state->btl_bw >= bbr1_state->full_bw * 1.25) {  // BBR1.BtlBw still growing?\n775\t            bbr1_state->full_bw = bbr1_state->btl_bw;   // record new baseline level\n776\t            bbr1_state->full_bw_count = 0;\n777\t        }\n778\t        else {\n779\t            bbr1_state->full_bw_count++; // another round w/o much growth\n780\t            if (bbr1_state->full_bw_count >= 3) {\n781\t                bbr1_state->filled_pipe = 1;\n782\t            }\n783\t        }\n784\t    }\n785\t}\n786\t\n787\tvoid BBR1EnterProbeBW(picoquic_bbr1_state_t* bbr1_state, picoquic_path_t* path_x, uint64_t current_time)\n788\t{\n789\t    unsigned int start = 0;\n790\t    bbr1_state->state = picoquic_bbr1_alg_probe_bw;\n791\t    bbr1_state->pacing_gain = 1.0;\n792\t    bbr1_state->cwnd_gain = 2.0;\n793\t\n794\t    if (bbr1_state->rt_prop > PICOQUIC_TARGET_RENO_RTT) {\n795\t        uint64_t ref_rt = (bbr1_state->rt_prop > PICOQUIC_TARGET_SATELLITE_RTT) ? PICOQUIC_TARGET_SATELLITE_RTT : bbr1_state->rt_prop;\n796\t        start = (unsigned int)(ref_rt / PICOQUIC_TARGET_RENO_RTT);\n797\t        if (start > BBR1_GAIN_CYCLE_MAX_START) {\n798\t            start = BBR1_GAIN_CYCLE_MAX_START;\n799\t        }\n800\t    }\n801\t    else {\n802\t        start = 2;\n803\t    }\n804\t\n805\t    bbr1_state->cycle_index = start;\n806\t    bbr1_state->cycle_start = start;\n807\t    bbr1_state->btl_bw_increased = 1;\n808\t\n809\t    BBR1AdvanceCyclePhase(bbr1_state, current_time);\n810\t    /* Start sampling */\n811\t    BBR1ltbwSampling(bbr1_state, path_x, current_time);\n812\t}\n813\t\n814\tvoid BBR1EnterDrain(picoquic_bbr1_state_t* bbr1_state, picoquic_path_t* path_x, uint64_t current_time)\n815\t{\n816\t    path_x->is_ssthresh_initialized = 1;\n817\t    bbr1_state->state = picoquic_bbr1_alg_drain;\n818\t    bbr1_state->pacing_gain = 1.0 / BBR1_HIGH_GAIN;  /* pace slowly */\n819\t    bbr1_state->cwnd_gain = BBR1_HIGH_GAIN;   /* maintain cwnd */\n820\t    /* Start sampling */\n821\t    BBR1ltbwSampling(bbr1_state, path_x, current_time);\n822\t}\n823\t\n824\tvoid BBR1CheckDrain(picoquic_bbr1_state_t* bbr1_state, picoquic_path_t* path_x, uint64_t bytes_in_transit, uint64_t current_time)\n825\t{\n826\t    if (bbr1_state->state == picoquic_bbr1_alg_startup && bbr1_state->filled_pipe) {\n827\t        BBR1EnterDrain(bbr1_state, path_x, current_time);\n828\t    }\n829\t\n830\t    if (bbr1_state->state == picoquic_bbr1_alg_drain && bytes_in_transit <= BBR1Inflight(bbr1_state, 1.0)) {\n831\t        BBR1EnterProbeBW(bbr1_state, path_x, current_time);  /* we estimate queue is drained */\n832\t    }\n833\t}\n834\t\n835\tvoid BBR1ExitStartupLongRtt(picoquic_bbr1_state_t* bbr1_state, picoquic_path_t* path_x, uint64_t current_time)\n836\t{\n837\t    /* Reset the round filter so it will start at current time */\n838\t    bbr1_state->next_round_delivered = path_x->delivered;\n839\t    bbr1_state->round_count++;\n840\t    bbr1_state->round_start = 1;\n841\t    /* Set the filled pipe indicator */\n842\t    bbr1_state->full_bw = bbr1_state->btl_bw;\n843\t    bbr1_state->full_bw_count = 3;\n844\t    bbr1_state->filled_pipe = 1;\n845\t    /* Check the RTT measurement for pathological cases */\n846\t    if ((bbr1_state->rtt_filter.is_init || bbr1_state->rtt_filter.sample_current > 0) &&\n847\t        bbr1_state->rt_prop > 30000000 &&\n848\t        bbr1_state->rtt_filter.sample_max < bbr1_state->rt_prop) {\n849\t        bbr1_state->rt_prop = bbr1_state->rtt_filter.sample_max;\n850\t        bbr1_state->rt_prop_stamp = current_time;\n851\t    }\n852\t    /* Enter drain */\n853\t    BBR1EnterDrain(bbr1_state, path_x, current_time);\