{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01C5dEjbkFmvUN82p5ueLvFG","type":"tool_result","content":"1\t//! Test cases for `picoquictest/dualq_aqm_test.c`.\n2\t//!\n3\t//! Unit tests for the DualQ Coupled AQM (RFC 9332) implementation used\n4\t//! in the network simulator.  The test suite is structured as five\n5\t//! sequential sub-tests:\n6\t//!\n7\t//! 1. `dualq_ctx_test`   — create / release the context.\n8\t//! 2. `dualq_enqueue`    — verify the per-queue enqueue API.\n9\t//! 3. `dualq_dequeue`    — verify the dequeue scheduler.\n10\t//! 4. `dualq_submit`     — verify submit routing and drop-on-overflow.\n11\t//! 5. `dualq_sustain`    — end-to-end throughput with mixed ECN traffic.\n12\t\n13\t#![allow(non_snake_case)]\n14\t\n15\tuse crate::Instant;\n16\tuse crate::tests::dualq::{Dualq, DualqQueue};\n17\tuse crate::tests::util::{TestAqm, TestSimLink, TestSimPacket};\n18\t\n19\t// ---------------------------------------------------------------------------\n20\t// Sub-test helpers.  Each mirrors one C helper function.\n21\t\n22\tconst ECN_ECT_0: u8 = 0x02;\n23\tconst ECN_ECT_1: u8 = 0x01;\n24\tconst ECN_CE: u8 = 0x03;\n25\tconst ECN_SEQUENCE: [u8; 5] = [0, ECN_ECT_0, 0, ECN_ECT_1, ECN_CE];\n26\tconst QUEUE_ID: [u8; 5] = [0, 0, 0, 1, 1];\n27\t\n28\tstruct DualqTestCtx {\n29\t    link: TestSimLink,\n30\t    simulated_time: Instant,\n31\t}\n32\t\n33\tfn check(ok: bool) -> crate::Result<()> {\n34\t    if ok {\n35\t        Ok(())\n36\t    } else {\n37\t        Err(crate::Error::Generic)\n38\t    }\n39\t}\n40\t\n41\tfn dualq_test_get_ctx() -> crate::Result<DualqTestCtx> {\n42\t    let simulated_time = Instant::from_ticks(0);\n43\t    let mut link = TestSimLink::create(0.01, 25_000, None, 50_000, simulated_time)?;\n44\t    Dualq::install(&mut link, 5_000)?;\n45\t    Ok(DualqTestCtx {\n46\t        link,\n47\t        simulated_time,\n48\t    })\n49\t}\n50\t\n51\tfn with_dualq<R>(\n52\t    link: &mut TestSimLink,\n53\t    f: impl FnOnce(&mut Dualq, &mut TestSimLink) -> crate::Result<R>,\n54\t) -> crate::Result<R> {\n55\t    let mut aqm = link.aqm_state.take().ok_or(crate::Error::Generic)?;\n56\t    let result = match aqm.as_any_mut().downcast_mut::<Dualq>() {\n57\t        Some(dualq) => f(dualq, link),\n58\t        None => Err(crate::Error::Generic),\n59\t    };\n60\t    link.aqm_state = Some(aqm);\n61\t    result\n62\t}\n63\t\n64\tfn dualq_test_get_packet(ecn_mark: u8, length: usize) -> crate::Result<TestSimPacket> {\n65\t    let mut packet = TestSimPacket::create()?;\n66\t    packet.ecn_mark = ecn_mark;\n67\t    packet.length = length;\n68\t    Ok(packet)\n69\t}\n70\t\n71\tfn queue_for_mut(dualq: &mut Dualq, queue_id: u8) -> &mut DualqQueue {\n72\t    if queue_id == 0 {\n73\t        &mut dualq.cq\n74\t    } else {\n75\t        &mut dualq.lq\n76\t    }\n77\t}\n78\t\n79\tfn queue_bytes(dualq: &Dualq, queue_id: u8) -> u64 {\n80\t    if queue_id == 0 {\n81\t        dualq.cq.queue_bytes\n82\t    } else {\n83\t        dualq.lq.queue_bytes\n84\t    }\n85\t}\n86\t\n87\tfn packet_key(packet: &TestSimPacket) -> (u64, usize, u8, u8) {\n88\t    (\n89\t        packet.arrival_time.ticks(),\n90\t        packet.length,\n91\t        packet.ecn_mark,\n92\t        packet.bytes[0],\n93\t    )\n94\t}\n95\t\n96\tfn dualq_test_check_queue(link: &TestSimLink) -> crate::Result<()> {\n97\t    let mut previous_time = 0;\n98\t    for packet in &link.packets {\n99\t        let arrival_time = packet.arrival_time.ticks();\n100\t        check(arrival_time > previous_time)?;\n101\t        previous_time = arrival_time;\n102\t    }\n103\t    Ok(())\n104\t}\n105\t\n106\t/// Verify that `test_set_minimal_cnx_with_time` + `TestSimLink::create` +\n107\t/// `Dualq::install` complete without error.\n108\t/// C: `dualq_test_ctx_test`.\n109\tfn dualq_ctx_test() -> crate::Result<()> {\n110\t    let mut ctx = dualq_test_get_ctx()?;\n111\t    with_dualq(&mut ctx.link, |_dualq, _link| Ok(()))\n112\t}\n113\t\n114\t/// Enqueue one packet per ECN value into the matching queue and verify\n115\t/// that `queue_bytes`, head, and tail pointers update correctly.\n116\t/// C: `dualq_enqueue_test`.\n117\tfn dualq_enqueue() -> crate::Result<()> {\n118\t    let mut ctx = dualq_test_get_ctx()?;\n119\t\n120\t    with_dualq(&mut ctx.link, |dualq, link| {\n121\t        for i in 0..ECN_SEQUENCE.len() {\n122\t            let packet = dualq_test_get_packet(ECN_SEQUENCE[i], 1000)?;\n123\t            let new_key = packet_key(&packet);\n124\t            let link_queue_len = link.packets.len();\n125\t            let xq = queue_for_mut(dualq, QUEUE_ID[i]);\n126\t            let old_bytes = xq.queue_bytes;\n127\t            let old_len = xq.packets.len();\n128\t            let old_front = xq.packets.front().map(packet_key);\n129\t\n130\t            xq.enqueue(packet);\n131\t\n132\t            check(xq.packets.len() == old_len + 1)?;\n133\t            check(xq.queue_bytes == old_bytes + 1000)?;\n134\t            check(xq.packets.back().map(packet_key) == Some(new_key))?;\n135\t            if old_len == 0 {\n136\t                check(xq.packets.front().map(packet_key) == Some(new_key))?;\n137\t            } else {\n138\t                check(xq.packets.front().map(packet_key) == old_front)?;\n139\t            }\n140\t            check(link.packets.len() == link_queue_len)?;\n141\t        }\n142\t        Ok(())\n143\t    })\n144\t}\n145\t\n146\t/// Load five packets, dequeue until both queues are empty, and verify\n147\t/// all five packets are delivered within 100 ms simulated time.\n148\t/// C: `dualq_dequeue_test`.\n149\tfn dualq_dequeue() -> crate::Result<()> {\n150\t    let mut ctx = dualq_test_get_ctx()?;\n151\t\n152\t    with_dualq(&mut ctx.link, |dualq, _link| {\n153\t        for i in 0..ECN_SEQUENCE.len() {\n154\t            let packet = dualq_test_get_packet(ECN_SEQUENCE[i], 1000)?;\n155\t            queue_for_mut(dualq, QUEUE_ID[i]).enqueue(packet);\n156\t        }\n157\t\n158\t        let mut trials = 0;\n159\t        let mut received = 0;\n160\t        while dualq.lq.queue_bytes > 0 || dualq.cq.queue_bytes > 0 {\n161\t            trials += 1;\n162\t            check(trials <= 1000)?;\n163\t            if let Some((_packet, _should_drop)) = dualq.dequeue_one(ctx.simulated_time) {\n164\t                received += 1;\n165\t            } else {\n166\t                ctx.simulated_time = Instant::from_ticks(ctx.simulated_time.ticks() + 1000);\n167\t            }\n168\t        }\n169\t\n170\t        check(received == 5)?;\n171\t        check(dualq.cq.queue_bytes == 0 && dualq.cq.packets.is_empty())?;\n172\t        check(dualq.lq.queue_bytes == 0 && dualq.lq.packets.is_empty())?;\n173\t        check(ctx.simulated_time.ticks() <= 100_000)\n174\t    })\n175\t}\n176\t\n177\t/// Submit 50 packets and verify that: the first packet goes directly to\n178\t/// the link when the link queue is idle; subsequent packets go to the AQM\n179\t/// queues; and at least one packet is dropped when the combined queue\n180\t/// exceeds `dqs.limit`.\n181\t/// C: `dualq_submit_test`.\n182\tfn dualq_submit() -> crate::Result<()> {\n183\t    let mut ctx = dualq_test_get_ctx()?;\n184\t    let mut one_was_dropped = false;\n185\t\n186\t    with_dualq(&mut ctx.link, |dualq, link| {\n187\t        for i in 0..50 {\n188\t            let i_queue = i % ECN_SEQUENCE.len();\n189\t            let packet = dualq_test_get_packet(ECN_SEQUENCE[i_queue], 1000)?;\n190\t            let old_bytes = queue_bytes(dualq, QUEUE_ID[i_queue]);\n191\t            let old_queue_time = link.queue_time;\n192\t            let old_total = dualq.cq.queue_bytes + dualq.lq.queue_bytes + packet.length as u64;\n193\t\n194\t            dualq.submit(link, packet, ctx.simulated_time);\n195\t\n196\t            if old_queue_time.ticks() <= ctx.simulated_time.ticks() {\n197\t                check(link.queue_time != old_queue_time)?;\n198\t            } else {\n199\t                check(link.queue_time == old_queue_time)?;\n200\t                if old_total > dualq.limit {\n201\t                    check(queue_bytes(dualq, QUEUE_ID[i_queue]) == old_bytes)?;\n202\t                    one_was_dropped = true;\n203\t                    break;\n204\t                } else {\n205\t                    check(queue_bytes(dualq, QUEUE_ID[i_queue]) != old_bytes)?;\n206\t                    dualq_test_check_queue(link)?;\n207\t                }\n208\t            }\n209\t        }\n210\t        Ok(())\n211\t    })?;\n212\t\n213\t    check(one_was_dropped)\n214\t}\n215\t\n216\t/// Drive 100 mixed-ECN packets through the full submit→dequeue pipeline,\n217\t/// interleaving arrivals, admissions, and submissions; verify all 100 are\n218\t/// accounted for (received + dropped) within 125 ms simulated time.\n219\t/// C: `dualq_sustain_test`.\n220\tfn dualq_sustain() -> crate::Result<()> {\n221\t    #[derive(Copy, Clone)]\n222\t    enum SustainAction {\n223\t        Arrival,\n224\t        Admission,\n225\t        Submit,\n226\t    }\n227\t\n228\t    fn receive(ctx: &mut DualqTestCtx, nb_received: &mut i32) -> crate::Result<()> {\n229\t        check(ctx.link.dequeue(ctx.simulated_time).is_some())?;\n230\t        *nb_received += 1;\n231\t        dualq_test_check_queue(&ctx.link)\n232\t    }\n233\t\n234\t    fn admit(ctx: &mut DualqTestCtx) {\n235\t        ctx.link.admit_pending(ctx.simulated_time);\n236\t    }\n237\t\n238\t    fn submit(ctx: &mut DualqTestCtx, nb_sent: &mut i32) -> crate::Result<()> {\n239\t        let mut packet = dualq_test_get_packet(ECN_SEQUENCE[*nb_sent as usize % 5], 1000)?;\n240\t        packet.bytes[0] = *nb_sent as u8;\n241\t        *nb_sent += 1;\n242\t        ctx.link.submit(packet, ctx.simulated_time);\n243\t        dualq_test_check_queue(&ctx.link)\n244\t    }\n245\t\n246\t    let mut ctx = dualq_test_get_ctx()?;\n247\t    let mut submit_time = ctx.simulated_time.ticks();\n248\t    let max_time = 125_000;\n249\t    let mut nb_received = 0;\n250\t    let mut nb_sent = 0;\n251\t\n252\t    loop {\n253\t        let mut action_time = u64::MAX;\n254\t        let mut next_action = None;\n255\t        let arrival_time = ctx.link.next_arrival(Instant::from_ticks(action_time));\n256\t        if arrival_time < action_time {\n257\t            next_action = Some(SustainAction::Arrival);\n258\t            action_time = arrival_time;\n259\t        }\n260\t\n261\t        let admission_time = ctx\n262\t            .link\n263\t            .next_admission(ctx.simulated_time, Instant::from_ticks(action_time));\n264\t        if admission_time < action_time {\n265\t            next_action = Some(SustainAction::Admission);\n266\t            action_time = admission_time;\n267\t        }\n268\t\n269\t        let can_submit = with_dualq(&mut ctx.link, |dualq, _link| {\n270\t            Ok(dualq.cq.queue_bytes + dualq.lq.queue_bytes + 1000 <= dualq.limit)\n271\t        })?;\n272\t        if nb_sent < 100 && can_submit && submit_time < action_time {\n273\t            next_action = Some(SustainAction::Submit);\n274\t            action_time = submit_time;\n275\t        }\n276\t\n277\t        let Some(next_action) = next_action else {\n278\t            break;\n279\t        };\n280\t\n281\t        if ctx.simulated_time.ticks() < action_time {\n282\t            check(action_time <= ctx.simulated_time.ticks() + 4000)?;\n283\t            ctx.simulated_time = Instant::from_ticks(action_time);\n284\t        } else {\n285\t            action_time = ctx.simulated_time.ticks();\n286\t        }\n287\t\n288\t        match next_action {\n289\t            SustainAction::Submit => {\n290\t                submit(&mut ctx, &mut nb_sent)?;\n291\t                if nb_sent % 7 == 0 {\n292\t                    submit_time += 4000;\n293\t                }\n294\t            }\n295\t            SustainAction::Arrival => receive(&mut ctx, &mut nb_received)?,\n296\t            SustainAction::Admission => admit(&mut ctx),\n297\t        }\n298\t\n299\t        let _ = action_time;\n300\t    }\n301\t\n302\t    check(nb_received as u64 + ctx.link.packets_dropped == 100)?;\n303\t    check(ctx.simulated_time.ticks() <= max_time)\n304\t}\n305\t\n306\t// ---------------------------------------------------------------------------\n307\t// Test entry.\n308\t\n309\t/// Run the full DualQ AQM unit-test suite.\n310\t/// C: `dualq_aqm_test` in `picoquictest/dualq_aqm_test.c`.\n311\t#[test]\n312\tfn dualq_aqm() {\n313\t    dualq_ctx_test().expect(\"dualq_ctx_test\");\n314\t    dualq_enqueue().expect(\"dualq_enqueue\");\n315\t    dualq_dequeue().expect(\"dualq_dequeue\");\n316\t    dualq_submit().expect(\"dualq_submit\");\n317\t    dualq_sustain().expect(\"dualq_sustain\");\n318\t}\n319\t"}]},"parent_tool_use_id":null,"session_id":"6ee014d2-8ab1-405d-b719-083b25912f8b","uuid":"bd837951-2037-46ee-b2c9-90b11c7a066a","timestamp":"2026-05-07T05:45:33.414Z","tool_use_result":{"type":"text","file":{"filePath":"/Users/richbarn/Projects/picoquic/rs/fq/src/tests/dualq_aqm.rs","content":"//! Test cases for `picoquictest/dualq_aqm_test.c`.\n//!\n//! Unit tests for the DualQ Coupled AQM (RFC 9332) implementation used\n//! in the network simulator.  The test suite is structured as five\n//! sequential sub-tests:\n//!\n//! 1. `dualq_ctx_test`   — create / release the context.\n//! 2. `dualq_enqueue`    — verify the per-queue enqueue API.\n//! 3. `dualq_dequeue`    — verify the dequeue scheduler.\n//! 4. `dualq_submit`     — verify submit routing and drop-on-overflow.\n//! 5. `dualq_sustain`    — end-to-end throughput with mixed ECN traffic.\n\n#![allow(non_snake_case)]\n\nuse crate::Instant;\nuse crate::tests::dualq::{Dualq, DualqQueue};\nuse crate::tests::util::{TestAqm, TestSimLink, TestSimPacket};\n\n// ---------------------------------------------------------------------------\n// Sub-test helpers.  Each mirrors one C helper function.\n\nconst ECN_ECT_0: u8 = 0x02;\nconst ECN_ECT_1: u8 = 0x01;\nconst ECN_CE: u8 = 0x03;\nconst ECN_SEQUENCE: [u8; 5] = [0, ECN_ECT_0, 0, ECN_ECT_1, ECN_CE];\nconst QUEUE_ID: [u8; 5] = [0, 0, 0, 1, 1];\n\nstruct DualqTestCtx {\n    link: TestSimLink,\n    simulated_time: Instant,\n}\n\nfn check(ok: bool) -> crate::Result<()> {\n    if ok {\n        Ok(())\n    } else {\n        Err(crate::Error::Generic)\n    }\n}\n\nfn dualq_test_get_ctx() -> crate::Result<DualqTestCtx> {\n    let simulated_time = Instant::from_ticks(0);\n    let mut link = TestSimLink::create(0.01, 25_000, None, 50_000, simulated_time)?;\n    Dualq::install(&mut link, 5_000)?;\n    Ok(DualqTestCtx {\n        link,\n        simulated_time,\n    })\n}\n\nfn with_dualq<R>(\n    link: &mut TestSimLink,\n    f: impl FnOnce(&mut Dualq, &mut TestSimLink) -> crate::Result<R>,\n) -> crate::Result<R> {\n    let mut aqm = link.aqm_state.take().ok_or(crate::Error::Generic)?;\n    let result = match aqm.as_any_mut().downcast_mut::<Dualq>() {\n        Some(dualq) => f(dualq, link),\n        None => Err(crate::Error::Generic),\n    };\n    link.aqm_state = Some(aqm);\n    result\n}\n\nfn dualq_test_get_packet(ecn_mark: u8, length: usize) -> crate::Result<TestSimPacket> {\n    let mut packet = TestSimPacket::create()?;\n    packet.ecn_mark = ecn_mark;\n    packet.length = length;\n    Ok(packet)\n}\n\nfn queue_for_mut(dualq: &mut Dualq, queue_id: u8) -> &mut DualqQueue {\n    if queue_id == 0 {\n        &mut dualq.cq\n    } else {\n        &mut dualq.lq\n    }\n}\n\nfn queue_bytes(dualq: &Dualq, queue_id: u8) -> u64 {\n    if queue_id == 0 {\n        dualq.cq.queue_bytes\n    } else {\n        dualq.lq.queue_bytes\n    }\n}\n\nfn packet_key(packet: &TestSimPacket) -> (u64, usize, u8, u8) {\n    (\n        packet.arrival_time.ticks(),\n        packet.length,\n        packet.ecn_mark,\n        packet.bytes[0],\n    )\n}\n\nfn dualq_test_check_queue(link: &TestSimLink) -> crate::Result<()> {\n    let mut previous_time = 0;\n    for packet in &link.packets {\n        let arrival_time = packet.arrival_time.ticks();\n        check(arrival_time > previous_time)?;\n        previous_time = arrival_time;\n    }\n    Ok(())\n}\n\n/// Verify that `test_set_minimal_cnx_with_time` + `TestSimLink::create` +\n/// `Dualq::install` complete without error.\n/// C: `dualq_test_ctx_test`.\nfn dualq_ctx_test() -> crate::Result<()> {\n    let mut ctx = dualq_test_get_ctx()?;\n    with_dualq(&mut ctx.link, |_dualq, _link| Ok(()))\n}\n\n/// Enqueue one packet per ECN value into the matching queue and verify\n/// that `queue_bytes`, head, and tail pointers update correctly.\n/// C: `dualq_enqueue_test`.\nfn dualq_enqueue() -> crate::Result<()> {\n    let mut ctx = dualq_test_get_ctx()?;\n\n    with_dualq(&mut ctx.link, |dualq, link| {\n        for i in 0..ECN_SEQUENCE.len() {\n            let packet = dualq_test_get_packet(ECN_SEQUENCE[i], 1000)?;\n            let new_key = packet_key(&packet);\n            let link_queue_len = link.packets.len();\n            let xq = queue_for_mut(dualq, QUEUE_ID[i]);\n            let old_bytes = xq.queue_bytes;\n            let old_len = xq.packets.len();\n            let old_front = xq.packets.front().map(packet_key);\n\n            xq.enqueue(packet);\n\n            check(xq.packets.len() == old_len + 1)?;\n            check(xq.queue_bytes == old_bytes + 1000)?;\n            check(xq.packets.back().map(packet_key) == Some(new_key))?;\n            if old_len == 0 {\n                check(xq.packets.front().map(packet_key) == Some(new_key))?;\n            } else {\n                check(xq.packets.front().map(packet_key) == old_front)?;\n            }\n            check(link.packets.len() == link_queue_len)?;\n        }\n        Ok(())\n    })\n}\n\n/// Load five packets, dequeue until both queues are empty, and verify\n/// all five packets are delivered within 100 ms simulated time.\n/// C: `dualq_dequeue_test`.\nfn dualq_dequeue() -> crate::Result<()> {\n    let mut ctx = dualq_test_get_ctx()?;\n\n    with_dualq(&mut ctx.link, |dualq, _link| {\n        for i in 0..ECN_SEQUENCE.len() {\n            let packet = dualq_test_get_packet(ECN_SEQUENCE[i], 1000)?;\n            queue_for_mut(dualq, QUEUE_ID[i]).enqueue(packet);\n        }\n\n        let mut trials = 0;\n        let mut received = 0;\n        while dualq.lq.queue_bytes > 0 || dualq.cq.queue_bytes > 0 {\n            trials += 1;\n            check(trials <= 1000)?;\n            if let Some((_packet, _should_drop)) = dualq.dequeue_one(ctx.simulated_time) {\n                received += 1;\n            } else {\n                ctx.simulated_time = Instant::from_ticks(ctx.simulated_time.ticks() + 1000);\n            }\n        }\n\n        check(received == 5)?;\n        check(dualq.cq.queue_bytes == 0 && dualq.cq.packets.is_empty())?;\n        check(dualq.lq.queue_bytes == 0 && dualq.lq.packets.is_empty())?;\n        check(ctx.simulated_time.ticks() <= 100_000)\n    })\n}\n\n/// Submit 50 packets and verify that: the first packet goes directly to\n/// the link when the link queue is idle; subsequent packets go to the AQM\n/// queues; and at least one packet is dropped when the combined queue\n/// exceeds `dqs.limit`.\n/// C: `dualq_submit_test`.\nfn dualq_submit() -> crate::Result<()> {\n    let mut ctx = dualq_test_get_ctx()?;\n    let mut one_was_dropped = false;\n\n    with_dualq(&mut ctx.link, |dualq, link| {\n        for i in 0..50 {\n            let i_queue = i % ECN_SEQUENCE.len();\n            let packet = dualq_test_get_packet(ECN_SEQUENCE[i_queue], 1000)?;\n            let old_bytes = queue_bytes(dualq, QUEUE_ID[i_queue]);\n            let old_queue_time = link.queue_time;\n            let old_total = dualq.cq.queue_bytes + dualq.lq.queue_bytes + packet.length as u64;\n\n            dualq.submit(link, packet, ctx.simulated_time);\n\n            if old_queue_time.ticks() <= ctx.simulated_time.ticks() {\n                check(link.queue_time != old_queue_time)?;\n            } else {\n                check(link.queue_time == old_queue_time)?;\n                if old_total > dualq.limit {\n                    check(queue_bytes(dualq, QUEUE_ID[i_queue]) == old_bytes)?;\n                    one_was_dropped = true;\n                    break;\n                } else {\n                    check(queue_bytes(dualq, QUEUE_ID[i_queue]) != old_bytes)?;\n                    dualq_test_check_queue(link)?;\n                }\n            }\n        }\n        Ok(())\n    })?;\n\n    check(one_was_dropped)\n}\n\n/// Drive 100 mixed-ECN packets through the full submit→dequeue pipeline,\n/// interleaving arrivals, admissions, and submissions; verify all 100 are\n/// accounted for (received + dropped) within 125 ms simulated time.\n/// C: `dualq_sustain_test`.\nfn dualq_sustain() -> crate::Result<()> {\n    #[derive(Copy, Clone)]\n    enum SustainAction {\n        Arrival,\n        Admission,\n        Submit,\n    }\n\n    fn receive(ctx: &mut DualqTestCtx, nb_received: &mut i32) -> crate::Result<()> {\n        check(ctx.link.dequeue(ctx.simulated_time).is_some())?;\n        *nb_received += 1;\n        dualq_test_check_queue(&ctx.link)\n    }\n\n    fn admit(ctx: &mut DualqTestCtx) {\n        ctx.link.admit_pending(ctx.simulated_time);\n    }\n\n    fn submit(ctx: &mut DualqTestCtx, nb_sent: &mut i32) -> crate::Result<()> {\n        let mut packet = dualq_test_get_packet(ECN_SEQUENCE[*nb_sent as usize % 5], 1000)?;\n        packet.bytes[0] = *nb_sent as u8;\n        *nb_sent += 1;\n        ctx.link.submit(packet, ctx.simulated_time);\n        dualq_test_check_queue(&ctx.link)\n    }\n\n    let mut ctx = dualq_test_get_ctx()?;\n    let mut submit_time = ctx.simulated_time.ticks();\n    let max_time = 125_000;\n    let mut nb_received = 0;\n    let mut nb_sent = 0;\n\n    loop {\n        let mut action_time = u64::MAX;\n        let mut next_action = None;\n        let arrival_time = ctx.link.next_arrival(Instant::from_ticks(action_time));\n        if arrival_time < action_time {\n            next_action = Some(SustainAction::Arrival);\n            action_time = arrival_time;\n        }\n\n        let admission_time = ctx\n            .link\n            .next_admission(ctx.simulated_time, Instant::from_ticks(action_time));\n        if admission_time < action_time {\n            next_action = Some(SustainAction::Admission);\n            action_time = admission_time;\n        }\n\n        let can_submit = with_dualq(&mut ctx.link, |dualq, _link| {\n            Ok(dualq.cq.queue_bytes + dualq.lq.queue_bytes + 1000 <= dualq.limit)\n        })?;\n        if nb_sent < 100 && can_submit && submit_time < action_time {\n            next_action = Some(SustainAction::Submit);\n            action_time = submit_time;\n        }\n\n        let Some(next_action) = next_action else {\n            break;\n        };\n\n        if ctx.simulated_time.ticks() < action_time {\n            check(action_time <= ctx.simulated_time.ticks() + 4000)?;\n            ctx.simulated_time = Instant::from_ticks(action_time);\n        } else {\n            action_time = ctx.simulated_time.ticks();\n        }\n\n        match next_action {\n            SustainAction::Submit => {\n                submit(&mut ctx, &mut nb_sent)?;\n                if nb_sent % 7 == 0 {\n                    submit_time += 4000;\n                }\n            }\n            SustainAction::Arrival => receive(&mut ctx, &mut nb_received)?,\n            SustainAction::Admission => admit(&mut ctx),\n        }\n\n        let _ = action_time;\n    }\n\n    check(nb_received as u64 + ctx.link.packets_dropped == 100)?;\n    check(ctx.simulated_time.ticks() <= max_time)\n}\n\n// ---------------------------------------------------------------------------\n// Test entry.\n\n/// Run the full DualQ AQM unit-test suite.\n/// C: `dualq_aqm_test` in `picoquictest/dualq_aqm_test.c`.\n#[test]\nfn dualq_aqm() {\n    dualq_ctx_test().expect(\"dualq_ctx_test\");\n    dualq_enqueue().expect(\"dualq_enqueue\");\n    dualq_dequeue().expect(\"dualq_dequeue\");\n    dualq_submit().expect(\"dualq_submit\");\n    dualq_sustain().expect(\"dualq_sustain\");\n}\n","numLines":319,"startLine":1,"totalLines":319}}}
