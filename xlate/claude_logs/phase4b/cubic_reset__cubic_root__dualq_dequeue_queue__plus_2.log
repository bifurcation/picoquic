{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01UVmVnwcumUk6TEDsMXkiYR","type":"tool_result","content":"1\t//! Translation of `picoquic/cubic.c` — CUBIC congestion control.\n2\t//!\n3\t//! Phase 4: `cubic_W_cubic` (private helper) and `cubic_observe`\n4\t//! (public API method on [`CubicState`]).\n5\t\n6\tuse crate::cc_common::MinMaxRtt;\n7\t\n8\t// ---------------------------------------------------------------------------\n9\t// Constants from cubic.c `#define`s.\n10\t\n11\tconst CUBIC_C: f64 = 0.4;\n12\tconst CUBIC_BETA_ECN: f64 = 7.0 / 8.0;\n13\t#[allow(dead_code)]\n14\tconst CUBIC_BETA: f64 = 3.0 / 4.0;\n15\t\n16\t// ---------------------------------------------------------------------------\n17\t// Algorithm-state enum.  C: `picoquic_cubic_alg_state_t`.\n18\t\n19\t/// C: `picoquic_cubic_alg_state_t`\n20\t#[derive(Debug, Copy, Clone, PartialEq, Eq, Default)]\n21\tpub enum CubicAlgState {\n22\t    #[default]\n23\t    SlowStart = 0,\n24\t    Recovery,\n25\t    CongestionAvoidance,\n26\t}\n27\t\n28\t// ---------------------------------------------------------------------------\n29\t// Per-path CUBIC state.  C: `picoquic_cubic_state_t`.\n30\t\n31\t/// C: `picoquic_cubic_state_t`\n32\t///\n33\t/// Type deviations from C:\n34\t/// * `alg_state` (`picoquic_cubic_alg_state_t`) → [`CubicAlgState`]\n35\t/// * `previous_alg_state` stored as `u64` to preserve raw casts done in\n36\t///   the C body (`cubic_state->previous_alg_state = cubic_state->alg_state`)\n37\t/// * `K`, `W_max`, `W_last_max`, `W_reno` (`double`) → `f64`\n38\t/// * `rtt_filter` (`picoquic_min_max_rtt_t`) → [`MinMaxRtt`]\n39\tpub struct CubicState {\n40\t    pub alg_state: CubicAlgState,\n41\t    pub recovery_sequence: u64,\n42\t    pub start_of_epoch: u64,\n43\t    pub previous_start_of_epoch: u64,\n44\t    pub previous_alg_state: u64,\n45\t    pub previous_ssthresh: u64,\n46\t    pub previous_cwin: u64,\n47\t    pub k: f64,\n48\t    pub w_max: f64,\n49\t    pub w_last_max: f64,\n50\t    pub w_reno: f64,\n51\t    pub ssthresh: u64,\n52\t    pub rtt_filter: MinMaxRtt,\n53\t}\n54\t\n55\timpl Default for CubicState {\n56\t    fn default() -> Self {\n57\t        Self {\n58\t            alg_state: CubicAlgState::SlowStart,\n59\t            recovery_sequence: 0,\n60\t            start_of_epoch: 0,\n61\t            previous_start_of_epoch: 0,\n62\t            previous_alg_state: 0,\n63\t            previous_ssthresh: u64::MAX,\n64\t            previous_cwin: 0,\n65\t            k: 0.0,\n66\t            w_max: 0.0,\n67\t            w_last_max: 0.0,\n68\t            w_reno: 0.0,\n69\t            ssthresh: u64::MAX,\n70\t            rtt_filter: MinMaxRtt::default(),\n71\t        }\n72\t    }\n73\t}\n74\t\n75\timpl CubicState {\n76\t    /// C: `cubic_W_cubic` (picoquic/cubic.c:121)\n77\t    ///\n78\t    /// Compute `W_cubic(t) = C * (t − K)³ + W_max` where `t` is the\n79\t    /// elapsed time in seconds since `start_of_epoch`.  Returns the\n80\t    /// window size in packets (not bytes).\n81\t    ///\n82\t    /// The subtraction `current_time - start_of_epoch` mirrors the\n83\t    /// unsigned C arithmetic; wrapping is intentional for out-of-order\n84\t    /// calls (same as C `uint64_t` semantics).\n85\t    fn w_cubic(&self, current_time: u64) -> f64 {\n86\t        let delta_t_sec =\n87\t            current_time.wrapping_sub(self.start_of_epoch) as f64 / 1_000_000.0 - self.k;\n88\t        CUBIC_C * (delta_t_sec * delta_t_sec * delta_t_sec) + self.w_max\n89\t    }\n90\t\n91\t    /// C: `cubic_enter_avoidance` (picoquic/cubic.c:132)\n92\t    ///\n93\t    /// Compute the CUBIC coefficient `K` and switch to congestion\n94\t    /// avoidance at `current_time`.\n95\t    pub fn enter_avoidance(&mut self, current_time: u64) {\n96\t        self.k = cubic_root(self.w_max * (1.0 - CUBIC_BETA_ECN) / CUBIC_C);\n97\t        self.alg_state = CubicAlgState::CongestionAvoidance;\n98\t        self.start_of_epoch = current_time;\n99\t        self.previous_start_of_epoch = self.start_of_epoch;\n100\t    }\n101\t\n102\t    /// C: `cubic_observe` (picoquic/cubic.c:562)\n103\t    ///\n104\t    /// Report the current algorithm state and `W_max` to an observer.\n105\t    /// Returns `(cc_state, cc_param)` where `cc_state` is the numeric\n106\t    /// discriminant of [`CubicAlgState`] and `cc_param` is `W_max`\n107\t    /// cast to `u64` (matching the C `(uint64_t)cubic_state->W_max`).\n108\t    pub fn observe(&self) -> (u64, u64) {\n109\t        (self.alg_state as u64, self.w_max as u64)\n110\t    }\n111\t\n112\t    /// Convenience wrapper that fills the two out-parameters used by\n113\t    /// the C `cubic_observe` call-site signature\n114\t    /// `(path_x, &mut cc_state, &mut cc_param)`.\n115\t    pub fn observe_into(&self, cc_state: &mut u64, cc_param: &mut u64) {\n116\t        let (s, p) = self.observe();\n117\t        *cc_state = s;\n118\t        *cc_param = p;\n119\t    }\n120\t}\n121\t\n122\t// ---------------------------------------------------------------------------\n123\t// `cubic_root` — Newton-Raphson cube root.  C: `cubic_root` (picoquic/cubic.c:83).\n124\t\n125\tfn cubic_root(x: f64) -> f64 {\n126\t    let mut v: f64 = 1.0;\n127\t    let mut y: f64 = 1.0;\n128\t\n129\t    while v > x * 8.0 {\n130\t        v /= 8.0;\n131\t        y /= 2.0;\n132\t    }\n133\t    while v < x {\n134\t        v *= 8.0;\n135\t        y *= 2.0;\n136\t    }\n137\t    for _ in 0..3 {\n138\t        let y2 = y * y;\n139\t        let y3 = y2 * y;\n140\t        y += (x - y3) / (3.0 * y2);\n141\t    }\n142\t    y\n143\t}\n144\t\n145\t#[cfg(test)]\n146\tmod tests {\n147\t    use super::*;\n148\t\n149\t    #[test]\n150\t    fn w_cubic_at_epoch_start() {\n151\t        let state = CubicState {\n152\t            start_of_epoch: 1_000_000,\n153\t            k: 0.0,\n154\t            w_max: 10.0,\n155\t            ..Default::default()\n156\t        };\n157\t        // At t = start_of_epoch: delta_t_sec = 0 - 0 = 0; W_cubic = 0 + W_max\n158\t        let w