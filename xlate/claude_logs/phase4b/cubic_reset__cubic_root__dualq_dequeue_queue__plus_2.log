                  packet.ecn_mark = PICOQUIC_ECN_CE;\n                }\n            } else if Self::recur(&mut self.lq, self.p_c) {\n                should_drop = true;\n            } else if Self::recur(&mut self.lq, self.p_cl) {\n                packet.ecn_mark = PICOQUIC_ECN_CE;\n            }\n        } else if Self::recur(&mut self.cq, self.p_c) {\n            if packet.ecn_mark == 0 || self.p_c >= self.p_c_max {\n                should_drop = true;\n            } else {\n                packet.ecn_mark = PICOQUIC_ECN_CE;\n            }\n        }\n\n        Some((packet, should_drop))\n    }\n}\n\n#[cfg(test)]\nmod test {}\n","structuredPatch":[{"oldStart":82,"oldLines":6,"newStart":82,"newLines":10,"lines":["         self.packets.push_back(packet);","     }"," ","+    /// C: `dualq_dequeue_queue` (picoquic/dualq_aqm.c:114)","+    ///","+    /// Remove and return the head packet from this queue, updating","+    /// `queue_bytes` and the packet count.  Returns `None` when empty.","     fn dequeue(&mut self) -> Option<TestSimPacket> {","         let packet = self.packets.pop_front()?;","         if self.packets.is_empty() {"]}],"userModified":false,"replaceAll":false}}
