{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_018jqAauSXV3S8V5vvscPgTX","type":"tool_result","content":"1\t/*\n2\t* Author: Christian Huitema\n3\t* Copyright (c) 2025, Private Octopus, Inc.\n4\t* All rights reserved.\n5\t*\n6\t* Permission to use, copy, modify, and distribute this software for any\n7\t* purpose with or without fee is hereby granted, provided that the above\n8\t* copyright notice and this permission notice appear in all copies.\n9\t*\n10\t* THIS SOFTWARE IS PROVIDED BY THE COPYRIGHT HOLDERS AND CONTRIBUTORS \"AS IS\" AND\n11\t* ANY EXPRESS OR IMPLIED WARRANTIES, INCLUDING, BUT NOT LIMITED TO, THE IMPLIED\n12\t* WARRANTIES OF MERCHANTABILITY AND FITNESS FOR A PARTICULAR PURPOSE ARE\n13\t* DISCLAIMED. IN NO EVENT SHALL Private Octopus, Inc. BE LIABLE FOR ANY\n14\t* DIRECT, INDIRECT, INCIDENTAL, SPECIAL, EXEMPLARY, OR CONSEQUENTIAL DAMAGES\n15\t* (INCLUDING, BUT NOT LIMITED TO, PROCUREMENT OF SUBSTITUTE GOODS OR SERVICES;\n16\t* LOSS OF USE, DATA, OR PROFITS; OR BUSINESS INTERRUPTION) HOWEVER CAUSED AND\n17\t* ON ANY THEORY OF LIABILITY, WHETHER IN CONTRACT, STRICT LIABILITY, OR TORT\n18\t* (INCLUDING NEGLIGENCE OR OTHERWISE) ARISING IN ANY WAY OUT OF THE USE OF THIS\n19\t* SOFTWARE, EVEN IF ADVISED OF THE POSSIBILITY OF SUCH DAMAGE.\n20\t*/\n21\t\n22\t/*\n23\t* Implementation of the DualQ AQM,\n24\t* based on code sample for dualq pi2 in RFC 9332.\n25\t* The code implements the \"timestamp\" variant.\n26\t* \n27\t* The link object manages:\n28\t* \n29\t* - a queue of pending L4S packets (lq)\n30\t* - a queue of pending classic packets (cq)\n31\t* - a queue of packets in transit (default link queue).\n32\t* \n33\t* The key events are:\n34\t* - arrival of packets through the \"submit\" API. The packets are time stamped\n35\t*   (packet->arrival_time), and then added to either the L4S or the classic Queue.\n36\t* - Departure from the \"pending\" queue. This happens as soon as the arrival\n37\t*   time of the last packet in the \"transit\" queue is above the current time.\n38\t*   The L4S code is run, resulting in packet marking (ECT1 or CE) and\n39\t*   either forwarding or drop. The arrival time of the packet is set to\n40\t*   time of dequeue + transmission and transit time, including jitter.\n41\t* - Departure from the \"transit\" queue, i.e., arrival.\n42\t* \n43\t* We have an API problem because the previous queue model only supported\n44\t* arrival (submit) and departure. The first version of the code tried to\n45\t* work around these limitations by using a form of virtual time, but it\n46\t* is very complicated and error prone. It seems better to rely on\n47\t* explicit calls from the simulator.\n48\t*   \n49\t */\n50\t\n51\t#include \"picoquic_internal.h\"\n52\t#include \"picoquic_utils.h\"\n53\t#include \"picosocks.h\"\n54\t#include <stdlib.h>\n55\t#include <string.h>\n56\t#include \"picoquictest_dualq.h\"\n57\t#if 0\n58\t#define DUALQ_MAX_LINK_RATE 125000000 /* 125,000,000 Bytes/sec, i.e., 1 Gbps -- pretty much a simulation limit */\n59\t\n60\ttypedef struct st_dualq_queue_t {\n61\t    uint64_t queue_bytes;\n62\t    uint64_t queue_time;\n63\t    double count;\n64\t    picoquictest_sim_packet_t* queue_first;\n65\t    picoquictest_sim_packet_t* queue_last;\n66\t} dualq_queue_t;\n67\t\n68\ttypedef struct st_dualq_state_t {\n69\t    struct st_picoquictest_aqm_t super;\n70\t    /* Initialization parameters */\n71\t    uint64_t target; /* PI2 queue delay target for both L4S and Classic, microseconds*/\n72\t    double k; /* Coupling factor */\n73\t    double p_Cmax; /* above this drop probability, classic queue uses drops instead of marks. */\n74\t    uint64_t Tupdate; /* interval between update of pi2 parameters, microseconds */\n75\t    double pi2_alpha; /* PI integral gain in Hz */\n76\t    double pi2_beta; /* PI proportional gain in MHz (1/microsecond) */\n77\t    uint64_t maxTh; /* Above this queue size threshold, L queue behaves as classic. */\n78\t    uint64_t minTh; /* Queue size above which L queue starts CE marking */\n79\t    uint64_t range; /* maxTh - minTh */\n80\t    double p_Lmax; /* above this drop probability, L4S queue uses drops instead of marks. */\n81\t    uint64_t limit; /* Maximum size of L4S + Classic queues */\n82\t    int schedule_tick; /* Counter used for weighed fair queuing, 15 for L4S, 1 for Classic */\n83\t    dualq_queue_t lq; /* The L4S queue of packets */\n84\t    dualq_queue_t cq; /* The classic queue of packets */\n85\t    int64_t curq; /* Current length of the classic queue, in microsecond */\n86\t    int64_t prevq; /* Previous length of the classic queue, in microsecond */\n87\t    uint64_t update_next; /* last time the pi2 parameters should be updated */\n88\t    double pprime; /* the p' coefficent in RFC9332, nominal mark rate of L4S queue derived from length of classic queue */\n89\t    double pprime_L; /* the p'_L coefficient in RFC9332, mark rate of L4S queue computed from L4S queue length, before coupling */\n90\t    double p_L; /* actual mark rate of L4S queue, after combining with \"p_CL\" */\n91\t    double p_CL; /* Coupled L4S prob = base prob pprime_L * coupling factor k */\n92\t    double p_C; /* Nominal drop rate of classic queue, equal to pprime_L^2 */\n93\t} dualq_state_t;\n94\t#endif\n95\t\n96\t/* Add a packet to a queue. Maintain counters, etc. \n97\t */\n98\t\n99\tvoid dualq_enqueue_queue(dualq_queue_t* xq, picoquictest_sim_packet_t* packet)\n100\t{\n101\t    if (xq->queue_first == NULL) {\n102\t        xq->queue_first = packet;\n103\t        xq->queue_last = packet;\n104\t    }\n105\t    else {\n106\t        xq->queue_last->next_packet = packet;\n107\t        xq->queue_last = packet;\n108\t    }\n109\t    packet->next_packet = 0;\n110\t    xq->count += 1;\n111\t    xq->queue_bytes += packet->length;\n112\t}\n113\t\n114\tpicoquictest_sim_packet_t* dualq_dequeue_queue(dualq_queue_t* xq)\n115\t{\n116\t    picoquictest_sim_packet_t* packet = xq->queue_first;\n117\t\n118\t    if (packet != NULL) {\n119\t        xq->queue_first = packet->next_packet;\n120\t        packet->next_packet = NULL;\n121\t        if (xq->queue_first == NULL) {\n122\t            xq->queue_last = NULL;\n123\t            xq->queue_bytes = 0;\n124\t            xq->count = 0;\n125\t        }\n126\t        else\n127\t        {\n128\t            if (packet->length < xq->queue_bytes) {\n129\t                xq->queue_bytes -= packet->length;\n130\t            }\n131\t            else {\n132\t                /* error case. do not use 0, as that would stop dequeuing */\n133\t                xq->queue_bytes = 1;\n134\t            }\n135\t            xq->count -= 1;\n136\t        }\n137\t    }\n138\t    return packet;\n139\t}\n140\t\n141\t\n142\t/* Process the packet that was just submitted. \n143\t */\n144\tvoid dualq_enqueue(dualq_state_t* dualq, picoquictest_sim_link_t* link, picoquictest_sim_packet_t* packet, uint64_t current_time)\n145\t{\n146\t    /* Test limit and classify lq or cq */\n147\t    if (dualq->cq.queue_bytes + dualq->lq.queue_bytes + packet->length > dualq->limit)\n148\t    {\n149\t        /* drop packet if buffer is full */\n150\t        picoquictest_sim_link_enqueue(link, packet, 0, 1);\n151\t    }\n152\t    else {\n153\t        /* 4 : timestamp(pkt) % only needed if using the sojourn technique */\n154\t        packet->arrival_time = current_time;\n155\t        /* Packet classifier */\n156\t        if (packet->ecn_mark == PICOQUIC_ECN_ECT_1 ||\n157\t            packet->ecn_mark == PICOQUIC_ECN_CE) {\n158\t            /* Add to L4S queue */\n159\t            dualq_enqueue_queue(&dualq->lq, packet);\n160\t        }\n161\t        else\n162\t        {\n163\t            /* add to classic queue */\n164\t            dualq_enqueue_queue(&dualq->cq, packet);\n165\t        }\n166\t    }\n167\t}\n168\t\n169\t\n170\t/* Dequeue.\n171\t* The packets are first queued in the L4S or plain queue.\n172\t* If there is room in the main queue, add them there.\n173\t* \n174\t* The last packet in 