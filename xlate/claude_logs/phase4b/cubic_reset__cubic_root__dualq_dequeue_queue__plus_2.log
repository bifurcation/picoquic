{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01KpogAyLfNEE5vyv97Fg4a2","type":"tool_result","content":"1\t//! Translation of `picoquic/picoquictest_dualq.h` (with bodies in\n2\t//! `picoquictest/dualq_aqm.c`).\n3\t//!\n4\t//! DualQ-Coupled AQM used by the test suite (RFC 9332 timestamp\n5\t//! variant).  Sits behind a [`TestSimLink`]'s `aqm_state` slot and\n6\t//! classifies arriving packets into an L4S queue ([`Dualq::lq`]) or\n7\t//! a Classic queue ([`Dualq::cq`]); marks/drops on dequeue using the\n8\t//! PI2 controller; and feeds admitted packets back into the link's\n9\t//! transit queue.\n10\t//!\n11\t//! The implementation mirrors `picoquic/dualq_aqm.c`.\n12\t//!\n13\t//! Translation policy notes for this module:\n14\t//!\n15\t//! * The C vtable struct `picoquictest_aqm_t` is already a Rust\n16\t//!   trait ([`TestAqm`](crate::tests::util::TestAqm)) in\n17\t//!   [`crate::utils`].  The C \"embed `super` and cast pointer\"\n18\t//!   inheritance pattern collapses to `impl TestAqm for Dualq`; the\n19\t//!   C `super` field is dropped.\n20\t//! * The C dualq pair of `queue_first` / `queue_last` raw\n21\t//!   `*mut TestSimPacket` heads (the intrusive-linked-list shape\n22\t//!   used by the parent sim-link) is replaced by an owning\n23\t//!   `VecDeque<TestSimPacket>` per queue.  Submit pushes;\n24\t//!   dequeue pops.  No raw pointers, no `unsafe`.\n25\t//! * The C `dualq_dequeue_one`'s `int* should_drop` out-parameter\n26\t//!   folds into a tuple return — `Option<(Box<...>, bool)>`\n27\t//!   represents \"no packet ready\" / \"(packet, drop?)\".\n28\t//! * The C `dualq_release` self-frees with `free(self)` and clears\n29\t//!   `link->aqm_state`.  In Rust the trait method takes\n30\t//!   `&mut self`; the actual deallocation rides on the\n31\t//!   `Option<Box<dyn TestAqm>>` slot in the link being reset to\n32\t//!   `None` by the caller after `release` drains the queues —\n33\t//!   `release` itself only handles the queue drain.\n34\t\n35\tuse crate::Error;\n36\tuse crate::Instant;\n37\tuse crate::tests::util::{TestAqm, TestSimLink, TestSimPacket};\n38\t\n39\t// ---------------------------------------------------------------------------\n40\t// Tunables.\n41\t\n42\t/// Simulation link-rate ceiling: 125,000,000 bytes/sec ≈ 1 Gbps.\n43\t/// C: `#define DUALQ_MAX_LINK_RATE 125000000`.\n44\tpub const DUALQ_MAX_LINK_RATE: u64 = 125_000_000;\n45\tconst PICOQUIC_ECN_ECT_1: u8 = 0x01;\n46\tconst PICOQUIC_ECN_CE: u8 = 0x03;\n47\t\n48\t// ---------------------------------------------------------------------------\n49\t// Per-queue state.\n50\t\n51\t/// One classified queue (L4S or Classic) inside a [`Dualq`].\n52\t/// C: `dualq_queue_t`.\n53\t///\n54\t/// Storage shape:\n55\t///\n56\t/// * The C `queue_first` / `queue_last` pair (intrusive linked\n57\t///   list, same pattern as [`crate::tests::util::TestSimLink`])\n58\t///   is replaced by an owning `VecDeque<TestSimPacket>`.  Submit\n59\t///   pushes to the back; dequeue pops from the front and hands\n60\t///   ownership to the caller via [`Dualq::dequeue_one`].\n61\t/// * `count` mirrors the C `int`, kept as `i32` for ABI parity with\n62\t///   the dualq tests that inspect it directly.\n63\t#[derive(Default)]\n64\tpub struct DualqQueue {\n65\t    pub queue_bytes: u64,\n66\t    /// Running sum of drop probability — when it crosses 1.0 the\n67\t    /// `dualq_recur` helper \"fires\" and the head packet is\n68\t    /// dropped/marked.  C: `double sum_p`.\n69\t    pub sum_p: f64,\n70\t    /// Packets in the queue.  Replaces the C `queue_first` /\n71\t    /// `queue_last` head/tail pair.  `count` is `packets.len()`\n72\t    /// (the C field is gone).\n73\t    pub packets: std::collections::VecDeque<TestSimPacket>,\n74\t}\n75\t\n76\timpl DualqQueue {\n77\t    /// Append `packet` to the tail of this queue.\n78\t    /// C: `dualq_enqueue_queue(dualq_queue_t* xq,\n79\t    /// picoquictest_sim_packet_t* packet)`.\n80\t    pub fn enqueue(&mut self, packet: TestSimPacket) {\n81\t        self.queue_bytes += packet.length as u64;\n82\t        self.packets.push_back(packet);\n83\t    }\n84\t\n85\t    fn dequeue(&mut self) -> Option<TestSimPacket> {\n86\t        let packet = self.packets.pop_front()?;\n87\t        if self.packets.is_empty() {\n88\t            self.queue_bytes = 0;\n89\t        } else if (packet.length as u64) < self.queue_bytes {\n90\t            self.queue_bytes -= packet.length as u64;\n91\t        } else {\n92\t            self.queue_bytes = 1;\n93\t        }\n94\t        Some(packet)\n95\t    }\n96\t}\n97\t\n98\t// ---------------------------------------------------------------------------\n99\t// AQM state.\n100\t\n101\t/// DualQ Coupled AQM state attached to a sim link.  C:\n102\t/// `dualq_state_t`.\n103\t///\n104\t/// The C struct embedded a `picoquictest_aqm_t` vtable in its first\n105\t/// field (`super`); in Rust the equivalent is `impl TestAqm for\n106\t/// Dualq`, so the explicit `super` field is dropped.  All other\n107\t/// fields mirror the C layout one-for-one.  Field names follow Rust\n108\t/// conventions: the RFC 9332 symbols `p_Cmax`, `p'_L`, etc., become\n109\t/// `p_c_max`, `p_prime_l`, and so on.\n110\tpub struct Dualq {\n111\t    // -- Initialization parameters -----------------------------------\n112\t    /// PI2 queue-delay target for both L4S and Classic, in\n113\t    /// microseconds.\n114\t    pub target: u64,\n115\t    /// Coupling factor `k`.\n116\t    pub k: f64,\n117\t    /// Above this drop probability, the classic queue uses drops\n118\t    /// instead of marks.  C: `p_Cmax`.\n119\t    pub p_c_max: f64,\n120\t    /// Interval between PI2 parameter updates, in microseconds.\n121\t    /// C: `Tupdate`.\n122\t    pub t_update: u64,\n123\t    /// PI integral gain in Hz.\n124\t    pub pi2_alpha: f64,\n125\t    /// PI proportional gain in MHz (1 / microsecond).\n126\t    pub pi2_beta: f64,\n127\t    /// Above this queue-size threshold, the L queue behaves as\n128\t    /// classic.  C: `maxTh`.\n129\t    pub max_th: u64,\n130\t    /// Queue size above which the L queue starts CE marking.\n131\t    /// C: `minTh`.\n132\t    pub min_th: u64,\n133\t    /// `max_th - min_th`.\n134\t    pub range: u64,\n135\t    /// Above this drop probability, the L4S queue uses drops\n136\t    /// instead of marks.  C: `p_Lmax`.\n137\t    pub p_l_max: f64,\n138\t    /// Maximum size of L4S + Classic queues, in bytes.\n139\t    pub limit: u64,\n140\t    /// Counter used for weighted fair queuing — 15 ticks for L4S,\n141\t    /// 1 tick for Classic.  C: `int schedule_tick`.\n142\t    pub schedule_tick: i32,\n143\t\n144\t    // -- Queues ------------------------------------------------------\n145\t    /// L4S queue of pending packets.\n146\t    pub lq: DualqQueue,\n147\t    /// Classic queue of pending packets.\n148\t    pub cq: DualqQueue,\n149\t\n150\t    // -- PI2 controller scratch space --------------------------------\n151\t    /// Current length of the classic queue, in microseconds.\n152\t    pub curq: i64,\n153\t    /// Previous length of the classic queue, in microseconds.\n154\t    pub prevq: i64,\n155\t    /// Time at which the PI2 parameters should next be updated.\n156\t    pub update_next: Instant,\n157\t    pub lq_average_queue: u64,\n158\t    /// `p'` coefficient (RFC 9332): nominal mark rate of the L4S\n159\t    /// queue derived from the classic queue length.  C: `pprime`.\n160\t    pub p_prime: f64,\n161\t    /// `p'_L`: mark rate of the L4S queue computed from L4S queue\n162\t    /// length, before coupling.  C: `pprime_L`.\n163\t    pub p_prime_l: f64,\n164\t    /// Actual mark rate of the L4S queue, after combining with\n165\t    /// `p_cl`.  C: `p_L`.\n166\t    pub p_l: f64,\n167\t    /// Coupled L4S probability: `p_prime_l * k`.  C: `p_CL`.\n168\t    pub p_cl: f64,\n169\t    /// Nominal drop rate of the classic queue (`p_prime_l^2`).\n170\t    /// C: `p_C`.\n171\t    pub p_c: f64,\n172\t\n173\t    // -- Picoquic NS data --------------------------------------------\n174\t    /// Time of the last `submit` call (microseconds).\n175\t    pub last_input_time: Instant,\n176\t}\n177\t\n178\timpl Default for Dualq {\n179\t    fn default() -> Self {\n180\t        Self {\n181\t            target: 0,\n182\t            k: 0.0,\n183\t            p_c_max: 0.0,\n184\t            t_update: 0,\n185\t            pi2_alpha: 0.0,\n186\t            pi2_beta: 0.0,\n187\t            max_th: 0,\n188\t            min_th: 0,\n189\t            range: 0,\n190\t            p_l_max: 0.0,\n191\t            limit: 0,\n192\t            schedule_tick: 0,\n193\t            lq: DualqQueue::default(),\n194\t            cq: DualqQueue::default(),\n195\t            curq: 0,\n196\t            prevq: 0,\n197\t            update_next: Instant::from_ticks(0),\n198\t            lq_average_queue: 0,\n199\t            p_prime: 0.0,\n200\t            p_prime_l: 0.0,\n201\t            p_l: 0.0,\n202\t            p_cl: 0.0,\n203\t            p_c: 0.0,\n204\t            last_input_time: Instant::from_ticks(0),\n205\t        }\n206\t    }\n207\t}\n208\t\n209\t// ---------------------------------------------------------------------------\n210\t// Trait impl — replaces the C \"embedded vtable + cast\" inheritance.\n211\t\n212\timpl TestAqm for Dualq {\n213\t    /// C: `dualq_submit`.  Queues the packet, updates\n214\t    /// `last_input_time`, and runs the dequeue/PI2 update pass.\n215\t    fn submit(&mut self, link: &mut TestSimLink, packet: TestSimPacket, current_time: Instant) {\n216\t        self.enqueue(link, packet, current_time);\n217\t        self.last_input_time = current_time;\n218\t        self.update_it(link, current_time);\n219\t    }\n220\t\n221\t    /// C: `dualq_reset` — runs the dequeue/PI2 update pass at\n222\t    /// `current_time`.\n223\t    fn reset(&mut self, link: &mut TestSimLink, current_time: Instant) {\n224\t        self.update_it(link, current_time);\n225\t    }\n226\t\n227\t    /// C: `dualq_release` — drains both queues onto the link as\n228\t    /// dropped packets.  The C body also `free(self)`s and nulls\n229\t    /// `link->aqm_state`; in Rust the caller drops the\n230\t    /// `Option<Box<dyn TestAqm>>` slot to do the same.\n231\t    fn release(&mut self, link: &mut TestSimLink) {\n232\t        while let Some(packet) = self.lq.dequeue() {\n233\t            link.enqueue(packet, Instant::from_ticks(0), true);\n234\t        }\n235\t        while let Some(packet) = self.cq.dequeue() {\n236\t            link.enqueue(packet, Instant::from_ticks(0), true);\n237\t        }\n238\t    }\n239\t\n240\t    /// C: `dualq_has_pending` — true iff either queue has at least\n241\t    /// one packet ready to admit.\n242\t    fn has_pending(&mut self) -> bool {\n243\t        !self.lq.packets.is_empty() || !self.cq.packets.is_empty()\n244\t    }\n245\t\n246\t    /// C: `dualq_admit_pending` — runs the dequeue/PI2 update pass\n247\t    /// at `current_time`.\n248\t    fn admit_pending(&mut self, link: &mut TestSimLink, current_time: Instant) {\n249\t        self.update_it(link, current_time);\n250\t    }\n251\t\n252\t    fn as_any_mut(&mut self) -> &mut dyn core::any::Any {\n253\t        self\n254\t    }\n255\t}\n256\t\n257\timpl Dualq {\n258\t    fn total_queue_bytes(&self) -> u64 {\n259\t        self.cq.queue_bytes + self.lq.queue_bytes\n260\t    }\n261\t\n262\t    fn enqueue(\n263\t        &mut self,\n264\t        link: &mut TestSimLink,\n265\t        mut packet: TestSimPacket,\n266\t        current_time: Instant,\n267\t    ) {\n268\t        if self.total_queue_bytes() + packet.length as u64 > self.limit {\n269\t            link.enqueue(packet, Instant::from_ticks(0), true);\n270\t        } else {\n271\t            packet.arrival_time = current_time;\n272\t            if packet.ecn_mark == PICOQUIC_ECN_ECT_1 || packet.ecn_mark == PICOQUIC_ECN_CE {\n273\t                self.lq.enqueue(packet);\n274\t            } else {\n275\t                self.cq.enqueue(packet);\n276\t            }\n277\t        }\n278\t    }\n279\t\n280\t    fn recur(queue: &mut DualqQueue, likelihood: f64) -> bool {\n281\t        queue.sum_p += likelihood;\n282\t        if queue.sum_p > 1.0 {\n283\t            queue.sum_p -= 1.0;\n284\t            true\n285\t        } else {\n286\t            false\n287\t        }\n288\t    }\n289\t\n290\t    fn scheduler(&mut self) -> Option<(TestSimPacket, bool)> {\n291\t        let mut is_lq = (self.schedule_tick & 0x0f) != 0;\n292\t        let mut packet = if is_lq {\n293\t            self.lq.dequeue()\n294\t        } else {\n295\t            self.cq.dequeue()\n296\t        };\n297\t        if packet.is_none() {\n298\t            is_lq = !is_lq;\n299\t            packet = if is_lq {\n300\t                self.lq.dequeue()\n301\t            } else {\n302\t                self.cq.dequeue()\n303\t            };\n304\t        }\n305\t\n306\t        self.schedule_tick = (self.schedule_tick + 1) & 0x0f;\n307\t        packet.map(|packet| (packet, is_lq))\n308\t    }\n309\t\n310\t    fn laqm(&self, current_time: Instant) -> f64 {\n311\t        let mut p_prime = 0.0;\n312\t        let mut lq_time = 0;\n313\t        if self.lq.packets.len() > 1\n314\t            && let Some(packet) = self.lq.packets.front()\n315\t            && packet.arrival_time.ticks() < current_time.ticks()\n316\t        {\n317\t            lq_time = current_time.ticks() - packet.arrival_time.ticks();\n318\t        }\n319\t        if lq_time >= self.max_th {\n320\t            p_prime = 1.0;\n321\t        } else if lq_time > self.min_th {\n322\t            p_prime = (lq_time - self.min_th) as f64 / self.range as f64;\n323\t        }\n324\t        p_prime\n325\t    }\n326\t\n327\t    fn pi2_update(&mut self, current_time: Instant) {\n328\t        let current_ticks = current_time.ticks();\n329\t        let cq_time = self\n330\t            .cq\n331\t            .packets\n332\t            .front()\n333\t            .filter(|packet| packet.arrival_time.ticks() < current_ticks)\n334\t            .map(|packet| current_ticks - packet.arrival_time.ticks())\n335\t            .unwrap_or(0);\n336\t        let lq_time = self\n337\t            .lq\n338\t            .packets\n339\t            .front()\n340\t            .filter(|packet| packet.arrival_time.ticks() < current_ticks)\n341\t            .map(|packet| current_ticks - packet.arrival_time.ticks())\n342\t            .unwrap_or(0);\n343\t\n344\t        self.curq = cq_time.max(lq_time) as i64;\n345\t        let target_delta = self.curq - self.target as i64;\n346\t        let delta_q = self.curq - self.prevq;\n347\t\n348\t        self.p_prime += self.pi2_alpha * target_delta as f64 + self.pi2_beta * delta_q as f64;\n349\t        self.p_prime = self.p_prime.clamp(0.0, 1.0);\n350\t\n351\t        self.p_cl = self.p_prime * self.k;\n352\t        if self.p_cl > 1.0 {\n353\t            self.p_cl = 1.0;\n354\t        }\n355\t        self.p_c = self.p_prime * self.p_prime_l;\n356\t        self.prevq = self.curq;\n357\t    }\n358\t\n359\t    fn update_it(&mut self, link: &mut TestSimLink, current_time: Instant) {\n360\t        while link.queue_time.ticks() <= current_time.ticks() {\n361\t            if let Some((packet, should_drop)) = self.dequeue_one(current_time) {\n362\t                link.enqueue(packet, current_time, should_drop);\n363\t            } else {\n364\t                break;\n365\t            }\n366\t        }\n367\t\n368\t        if current_time.ticks() >= self.update_next.ticks() {\n369\t            self.pi2_update(current_time);\n370\t            self.update_next = Instant::from_ticks(current_time.ticks() + self.t_update);\n371\t        }\n372\t    }\n373\t\n374\t    fn params_init(&mut self, l4s_max: u64, link: &TestSimLink) {\n375\t        self.limit = if link.queue_delay_max <= link.microsec_latency || link.picosec_per_byte == 0\n376\t        {\n377\t            (250u64 * DUALQ_MAX_LINK_RATE) / 1_000_000\n378\t        } else {\n379\t            let queue_delay = link.queue_delay_max - link.microsec_latency;\n380\t            (queue_delay * 1_000_000) / link.picosec_per_byte\n381\t        };\n382\t        self.k = 2.0;\n383\t        self.target = 15_000;\n384\t        let rtt_max = 100_000u64;\n385\t        self.p_c_max = 1.0 / (self.k * self.k);\n386\t        if self.p_c_max > 1.0 {\n387\t            self.p_c_max = 1.0;\n388\t        }\n389\t        self.t_update = rtt_max / 3;\n390\t        if self.t_update > self.target {\n391\t            self.t_update = self.target;\n392\t        }\n393\t        self.pi2_alpha = (0.1 * self.t_update as f64) / (rtt_max as f64 * rtt_max as f64);\n394\t        self.pi2_beta = 0.3 / rtt_max as f64;\n395\t\n396\t        if l4s_max == 0 {\n397\t            self.max_th = 1200;\n398\t            self.min_th = 800;\n399\t        } else {\n400\t            self.max_th = l4s_max;\n401\t            self.min_th = if l4s_max > 1200 { 800 } else { l4s_max / 3 };\n402\t        }\n403\t        self.range = self.max_th - self.min_th;\n404\t        self.p_l_max = 1.0;\n405\t    }\n406\t\n407\t    /// Install a fresh DualQ AQM on `link`, sized for an L4S queue\n408\t    /// of at most `l4s_max` bytes.  C: `int\n409\t    /// dualq_configure(picoquictest_sim_link_t* link, uint64_t\n410\t    /// l4s_max)`.\n411\t    ///\n412\t    /// Returns [`Error::Memory`] on the C `ERROR_MEMORY`\n413\t    /// allocation-failure path.\n414\t    pub fn install(link: &mut TestSimLink, l4s_max: u64) -> Result<(), Error> {\n415\t        if let Some(mut aqm) = link.aqm_state.take() {\n416\t            if let Some(dualq) = aqm.as_any_mut().downcast_mut::<Dualq>() {\n417\t                dualq.params_init(l4s_max, link);\n418\t                link.aqm_state = Some(aqm);\n419\t                return Ok(());\n420\t            }\n421\t            aqm.release(link);\n422\t        }\n423\t\n424\t        let mut dualq = Dualq::default();\n425\t        dualq.params_init(l4s_max, link);\n426\t        link.aqm_state = Some(Box::new(dualq));\n427\t        Ok(())\n428\t    }\n429\t\n430\t    /// Run the scheduler / mark / drop logic for one packet,\n431\t    /// returning the chosen packet (if any) along with the\n432\t    /// should-drop flag.  C: `picoquictest_sim_packet_t*\n433\t    /// dualq_dequeue_one(dualq_state_t* dualq, uint64_t\n434\t    /// current_time, int* should_drop)`.\n435\t    ///\n436\t    /// The C `should_drop` out-parameter folds into the tuple\n437\t    /// return.  `None` mirrors the C `NULL` \"no packet ready\" path;\n438\t    /// the C body always sets `*should_drop = 0` before returning\n439\t    /// `NULL`, so no flag survives that branch.\n440\t    ///\n441\t    /// Exposed publicly to mirror the C surface used by the\n442\t    /// `dualq_aqm_test.c` unit tests; Phase 2 translates those\n443\t    /// tests directly.\n444\t    pub fn dequeue_one(&mut self, current_time: Instant) -> Option<(TestSimPacket, bool)> {\n445\t        let (mut packet, is_lq) = self.scheduler()?;\n446\t        let mut should_drop = false;\n447\t\n448\t        if is_lq {\n449\t            if self.p_cl < self.p_l_max {\n450\t                self.p_prime_l = self.laqm(current_time);\n451\t                self.p_l = self.p_prime_l.max(self.p_cl);\n452\t                if Self::recur(&mut self.lq, self.p_prime_l) {\n453\t                    packet.ecn_mark = PICOQUIC_ECN_CE;\n454\t                }\n455\t            } else if Self::recur(&mut self.lq, self.p_c) {\n456\t                should_drop = true;\n457\t            } else if Self::recur(&mut self.lq, self.p_cl) {\n458\t                packet.ecn_mark = PICOQUIC_ECN_CE;\n459\t            }\n460\t        } else if Self::recur(&mut self.cq, self.p_c) {\n461\t            if packet.ecn_mark == 0 || self.p_c >= self.p_c_max {\n462\t                should_drop = true;\n463\t            } else {\n464\t                packet.ecn_mark = PICOQUIC_ECN_CE;\n465\t            }\n466\t        }\n467\t\n468\t        Some((packet, should_drop))\n469\t    }\n470\t}\n471\t\n472\t#[cfg(test)]\n473\tmod test {}\n474\t"}]},"parent_tool_use_id":null,"session_id":"6ee014d2-8ab1-405d-b719-083b25912f8b","uuid":"f9c3bdb2-877d-474c-8459-6aa851570e6e","timestamp":"2026-05-07T05:45:37.349Z","tool_use_result":{"type":"text","file":{"filePath":"/Users/richbarn/Projects/picoquic/rs/fq/src/tests/dualq.rs","content":"//! Translation of `picoquic/picoquictest_dualq.h` (with bodies in\n//! `picoquictest/dualq_aqm.c`).\n//!\n//! DualQ-Coupled AQM used by the test suite (RFC 9332 timestamp\n//! variant).  Sits behind a [`TestSimLink`]'s `aqm_state` slot and\n//! classifies arriving packets into an L4S queue ([`Dualq::lq`]) or\n//! a Classic queue ([`Dualq::cq`]); marks/drops on dequeue using the\n//! PI2 controller; and feeds admitted packets back into the link's\n//! transit queue.\n//!\n//! The implementation mirrors `picoquic/dualq_aqm.c`.\n//!\n//! Translation policy notes for this module:\n//!\n//! * The C vtable struct `picoquictest_aqm_t` is already a Rust\n//!   trait ([`TestAqm`](crate::tests::util::TestAqm)) in\n//!   [`crate::utils`].  The C \"embed `super` and cast pointer\"\n//!   inheritance pattern collapses to `impl TestAqm for Dualq`; the\n//!   C `super` field is dropped.\n//! * The C dualq pair of `queue_first` / `queue_last` raw\n//!   `*mut TestSimPacket` heads (the intrusive-linked-list shape\n//!   used by the parent sim-link) is replaced by an owning\n//!   `VecDeque<TestSimPacket>` per queue.  Submit pushes;\n//!   dequeue pops.  No raw pointers, no `unsafe`.\n//! * The C `dualq_dequeue_one`'s `int* should_drop` out-parameter\n//!   folds into a tuple return — `Option<(Box<...>, bool)>`\n//!   represents \"no packet ready\" / \"(packet, drop?)\".\n//! * The C `dualq_release` self-frees with `free(self)` and clears\n//!   `link->aqm_state`.  In Rust the trait method takes\n//!   `&mut self`; the actual deallocation rides on the\n//!   `Option<Box<dyn TestAqm>>` slot in the link being reset to\n//!   `None` by the caller after `release` drains the queues —\n//!   `release` itself only handles the queue drain.\n\nuse crate::Error;\nuse crate::Instant;\nuse crate::tests::util::{TestAqm, TestSimLink, TestSimPacket};\n\n// ---------------------------------------------------------------------------\n// Tunables.\n\n/// Simulation link-rate ceiling: 125,000,000 bytes/sec ≈ 1 Gbps.\n/// C: `#define DUALQ_MAX_LINK_RATE 125000000`.\npub const DUALQ_MAX_LINK_RATE: u64 = 125_000_000;\nconst PICOQUIC_ECN_ECT_1: u8 = 0x01;\nconst PICOQUIC_ECN_CE: u8 = 0x03;\n\n// ---------------------------------------------------------------------------\n// Per-queue state.\n\n/// One classified queue (L4S or Classic) inside a [`Dualq`].\n/// C: `dualq_queue_t`.\n///\n/// Storage shape:\n///\n/// * The C `queue_first` / `queue_last` pair (intrusive linked\n///   list, same pattern as [`crate::tests::util::TestSimLink`])\n///   is replaced by an owning `VecDeque<TestSimPacket>`.  Submit\n///   pushes to the back; dequeue pops from the front and hands\n///   ownership to the caller via [`Dualq::dequeue_one`].\n/// * `count` mirrors the C `int`, kept as `i32` for ABI parity with\n///   the dualq tests that inspect it directly.\n#[derive(Default)]\npub struct DualqQueue {\n    pub queue_bytes: u64,\n    /// Running sum of drop probability — when it crosses 1.0 the\n    /// `dualq_recur` helper \"fires\" and the head packet is\n    /// dropped/marked.  C: `double sum_p`.\n    pub sum_p: f64,\n    /// Packets in the queue.  Replaces the C `queue_first` /\n    /// `queue_last` head/tail pair.  `count` is `packets.len()`\n    /// (the C field is gone).\n    pub packets: std::collections::VecDeque<TestSimPacket>,\n}\n\nimpl DualqQueue {\n    /// Append `packet` to the tail of this queue.\n    /// C: `dualq_enqueue_queue(dualq_queue_t* xq,\n    /// picoquictest_sim_packet_t* packet)`.\n    pub fn enqueue(&mut self, packet: TestSimPacket) {\n        self.queue_bytes += packet.length as u64;\n        self.packets.push_back(packet);\n    }\n\n    fn dequeue(&mut self) -> Option<TestSimPacket> {\n        let packet = self.packets.pop_front()?;\n        if self.packets.is_empty() {\n            self.queue_bytes = 0;\n        } else if (packet.length as u64) < self.queue_bytes {\n            self.queue_bytes -= packet.length as u64;\n        } else {\n            self.queue_bytes = 1;\n        }\n        Some(packet)\n    }\n}\n\n// ---------------------------------------------------------------------------\n// AQM state.\n\n/// DualQ Coupled AQM state attached to a sim link.  C:\n/// `dualq_state_t`.\n///\n/// The C struct embedded a `picoquictest_aqm_t` vtable in its first\n/// field (`super`); in Rust the equivalent is `impl TestAqm for\n/// Dualq`, so the explicit `super` field is dropped.  All other\n/// fields mirror the C layout one-for-one.  Field names follow Rust\n/// conventions: the RFC 9332 symbols `p_Cmax`, `p'_L`, etc., become\n/// `p_c_max`, `p_prime_l`, and so on.\npub struct Dualq {\n    // -- Initialization parameters -----------------------------------\n    /// PI2 queue-delay target for both L4S and Classic, in\n    /// microseconds.\n    pub target: u64,\n    /// Coupling factor `k`.\n    pub k: f64,\n    /// Above this drop probability, the classic queue uses drops\n    /// instead of marks.  C: `p_Cmax`.\n    pub p_c_max: f64,\n    /// Interval between PI2 parameter updates, in microseconds.\n    /// C: `Tupdate`.\n    pub t_update: u64,\n    /// PI integral gain in Hz.\n    pub pi2_alpha: f64,\n    /// PI proportional gain in MHz (1 / microsecond).\n    pub pi2_beta: f64,\n    /// Above this queue-size threshold, the L queue behaves as\n    /// classic.  C: `maxTh`.\n    pub max_th: u64,\n    /// Queue size above which the L queue starts CE marking.\n    /// C: `minTh`.\n    pub min_th: u64,\n    /// `max_th - min_th`.\n    pub range: u64,\n    /// Above this drop probability, the L4S queue uses drops\n    /// instead of marks.  C: `p_Lmax`.\n    pub p_l_max: f64,\n    /// Maximum size of L4S + Classic queues, in bytes.\n    pub limit: u64,\n    /// Counter used for weighted fair queuing — 15 ticks for L4S,\n    /// 1 tick for Classic.  C: `int schedule_tick`.\n    pub schedule_tick: i32,\n\n    // -- Queues ------------------------------------------------------\n    /// L4S queue of pending packets.\n    pub lq: DualqQueue,\n    /// Classic queue of pending packets.\n    pub cq: DualqQueue,\n\n    // -- PI2 controller scratch space --------------------------------\n    /// Current length of the classic queue, in microseconds.\n    pub curq: i64,\n    /// Previous length of the classic queue, in microseconds.\n    pub prevq: i64,\n    /// Time at which the PI2 parameters should next be updated.\n    pub update_next: Instant,\n    pub lq_average_queue: u64,\n    /// `p'` coefficient (RFC 9332): nominal mark rate of the L4S\n    /// queue derived from the classic queue length.  C: `pprime`.\n    pub p_prime: f64,\n    /// `p'_L`: mark rate of the L4S queue computed from L4S queue\n    /// length, before coupling.  C: `pprime_L`.\n    pub p_prime_l: f64,\n    /// Actual mark rate of the L4S queue, after combining with\n    /// `p_cl`.  C: `p_L`.\n    pub p_l: f64,\n    /// Coupled L4S probability: `p_prime_l * k`.  C: `p_CL`.\n    pub p_cl: f64,\n    /// Nominal drop rate of the classic queue (`p_prime_l^2`).\n    /// C: `p_C`.\n    pub p_c: f64,\n\n    // -- Picoquic NS data --------------------------------------------\n    /// Time of the last `submit` call (microseconds).\n    pub last_input_time: Instant,\n}\n\nimpl Default for Dualq {\n    fn default() -> Self {\n        Self {\n            target: 0,\n            k: 0.0,\n            p_c_max: 0.0,\n            t_update: 0,\n            pi2_alpha: 0.0,\n            pi2_beta: 0.0,\n            max_th: 0,\n            min_th: 0,\n            range: 0,\n            p_l_max: 0.0,\n            limit: 0,\n            schedule_tick: 0,\n            lq: DualqQueue::default(),\n            cq: DualqQueue::default(),\n            curq: 0,\n            prevq: 0,\n            update_next: Instant::from_ticks(0),\n            lq_average_queue: 0,\n            p_prime: 0.0,\n            p_prime_l: 0.0,\n            p_l: 0.0,\n            p_cl: 0.0,\n            p_c: 0.0,\n            last_input_time: Instant::from_ticks(0),\n        }\n    }\n}\n\n// ---------------------------------------------------------------------------\n// Trait impl — replaces the C \"embedded vtable + cast\" inheritance.\n\nimpl TestAqm for Dualq {\n    /// C: `dualq_submit`.  Queues the packet, updates\n    /// `last_input_time`, and runs the dequeue/PI2 update pass.\n    fn submit(&mut self, link: &mut TestSimLink, packet: TestSimPacket, current_time: Instant) {\n        self.enqueue(link, packet, current_time);\n        self.last_input_time = current_time;\n        self.update_it(link, current_time);\n    }\n\n    /// C: `dualq_reset` — runs the dequeue/PI2 update pass at\n    /// `current_time`.\n    fn reset(&mut self, link: &mut TestSimLink, current_time: Instant) {\n        self.update_it(link, current_time);\n    }\n\n    /// C: `dualq_release` — drains both queues onto the link as\n    /// dropped packets.  The C body also `free(self)`s and nulls\n    /// `link->aqm_state`; in Rust the caller drops the\n    /// `Option<Box<dyn TestAqm>>` slot to do the same.\n    fn release(&mut self, link: &mut TestSimLink) {\n        while let Some(packet) = self.lq.dequeue() {\n            link.enqueue(packet, Instant::from_ticks(0), true);\n        }\n        while let Some(packet) = self.cq.dequeue() {\n            link.enqueue(packet, Instant::from_ticks(0), true);\n        }\n    }\n\n    /// C: `dualq_has_pending` — true iff either queue has at least\n    /// one packet ready to admit.\n    fn has_pending(&mut self) -> bool {\n        !self.lq.packets.is_empty() || !self.cq.packets.is_empty()\n    }\n\n    /// C: `dualq_admit_pending` — runs the dequeue/PI2 update pass\n    /// at `current_time`.\n    fn admit_pending(&mut self, link: &mut TestSimLink, current_time: Instant) {\n        self.update_it(link, current_time);\n    }\n\n    fn as_any_mut(&mut self) -> &mut dyn core::any::Any {\n        self\n    }\n}\n\nimpl Dualq {\n    fn total_queue_bytes(&self) -> u64 {\n        self.cq.queue_bytes + self.lq.queue_bytes\n    }\n\n    fn enqueue(\n        &mut self,\n        link: &mut TestSimLink,\n        mut packet: TestSimPacket,\n        current_time: Instant,\n    ) {\n        if self.total_queue_bytes() + packet.length as u64 > self.limit {\n            link.enqueue(packet, Instant::from_ticks(0), true);\n        } else {\n            packet.arrival_time = current_time;\n            if packet.ecn_mark == PICOQUIC_ECN_ECT_1 || packet.ecn_mark == PICOQUIC_ECN_CE {\n                self.lq.enqueue(packet);\n            } else {\n                self.cq.enqueue(packet);\n            }\n        }\n    }\n\n    fn recur(queue: &mut DualqQueue, likelihood: f64) -> bool {\n        queue.sum_p += likelihood;\n        if queue.sum_p > 1.0 {\n            queue.sum_p -= 1.0;\n            true\n        } else {\n            false\n        }\n    }\n\n    fn scheduler(&mut self) -> Option<(TestSimPacket, bool)> {\n        let mut is_lq = (self.schedule_tick & 0x0f) != 0;\n        let mut packet = if is_lq {\n            self.lq.dequeue()\n        } else {\n            self.cq.dequeue()\n        };\n        if packet.is_none() {\n            is_lq = !is_lq;\n            packet = if is_lq {\n                self.lq.dequeue()\n            } else {\n                self.cq.dequeue()\n            };\n        }\n\n        self.schedule_tick = (self.schedule_tick + 1) & 0x0f;\n        packet.map(|packet| (packet, is_lq))\n    }\n\n    fn laqm(&self, current_time: Instant) -> f64 {\n        let mut p_prime = 0.0;\n        let mut lq_time = 0;\n        if self.lq.packets.len() > 1\n            && let Some(packet) = self.lq.packets.front()\n            && packet.arrival_time.ticks() < current_time.ticks()\n        {\n            lq_time = current_time.ticks() - packet.arrival_time.ticks();\n        }\n        if lq_time >= self.max_th {\n            p_prime = 1.0;\n        } else if lq_time > self.min_th {\n            p_prime = (lq_time - self.min_th) as f64 / self.range as f64;\n        }\n        p_prime\n    }\n\n    fn pi2_update(&mut self, current_time: Instant) {\n        let current_ticks = current_time.ticks();\n        let cq_time = self\n            .cq\n            .packets\n            .front()\n            .filter(|packet| packet.arrival_time.ticks() < current_ticks)\n            .map(|packet| current_ticks - packet.arrival_time.ticks())\n            .unwrap_or(0);\n        let lq_time = self\n            .lq\n            .packets\n            .front()\n            .filter(|packet| packet.arrival_time.ticks() < current_ticks)\n            .map(|packet| current_ticks - packet.arrival_time.ticks())\n            .unwrap_or(0);\n\n        self.curq = cq_time.max(lq_time) as i64;\n        let target_delta = self.curq - self.target as i64;\n        let delta_q = self.curq - self.prevq;\n\n        self.p_prime += self.pi2_alpha * target_delta as f64 + self.pi2_beta * delta_q as f64;\n        self.p_prime = self.p_prime.clamp(0.0, 1.0);\n\n        self.p_cl = self.p_prime * self.k;\n        if self.p_cl > 1.0 {\n            self.p_cl = 1.0;\n        }\n        self.p_c = self.p_prime * self.p_prime_l;\n        self.prevq = self.curq;\n    }\n\n    fn update_it(&mut self, link: &mut TestSimLink, current_time: Instant) {\n        while link.queue_time.ticks() <= current_time.ticks() {\n            if let Some((packet, should_drop)) = self.dequeue_one(current_time) {\n                link.enqueue(packet, current_time, should_drop);\n            } else {\n                break;\n            }\n        }\n\n        if current_time.ticks() >= self.update_next.ticks() {\n            self.pi2_update(current_time);\n            self.update_next = Instant::from_ticks(current_time.ticks() + self.t_update);\n        }\n    }\n\n    fn params_init(&mut self, l4s_max: u64, link: &TestSimLink) {\n        self.limit = if link.queue_delay_max <= link.microsec_latency || link.picosec_per_byte == 0\n        {\n            (250u64 * DUALQ_MAX_LINK_RATE) / 1_000_000\n        } else {\n            let queue_delay = link.queue_delay_max - link.microsec_latency;\n            (queue_delay * 1_000_000) / link.picosec_per_byte\n        };\n        self.k = 2.0;\n        self.target = 15_000;\n        let rtt_max = 100_000u64;\n        self.p_c_max = 1.0 / (self.k * self.k);\n        if self.p_c_max > 1.0 {\n            self.p_c_max = 1.0;\n        }\n        self.t_update = rtt_max / 3;\n        if self.t_update > self.target {\n            self.t_update = self.target;\n        }\n        self.pi2_alpha = (0.1 * self.t_update as f64) / (rtt_max as f64 * rtt_max as f64);\n        self.pi2_beta = 0.3 / rtt_max as f64;\n\n        if l4s_max == 0 {\n            self.max_th = 1200;\n            self.min_th = 800;\n        } else {\n            self.max_th = l4s_max;\n            self.min_th = if l4s_max > 1200 { 800 } else { l4s_max / 3 };\n        }\n        self.range = self.max_th - self.min_th;\n        self.p_l_max = 1.0;\n    }\n\n    /// Install a fresh DualQ AQM on `link`, sized for an L4S queue\n    /// of at most `l4s_max` bytes.  C: `int\n    /// dualq_configure(picoquictest_sim_link_t* link, uint64_t\n    /// l4s_max)`.\n    ///\n    /// Returns [`Error::Memory`] on the C `ERROR_MEMORY`\n    /// allocation-failure path.\n    pub fn install(link: &mut TestSimLink, l4s_max: u64) -> Result<(), Error> {\n        if let Some(mut aqm) = link.aqm_state.take() {\n            if let Some(dualq) = aqm.as_any_mut().downcast_mut::<Dualq>() {\n                dualq.params_init(l4s_max, link);\n                link.aqm_state = Some(aqm);\n                return Ok(());\n            }\n            aqm.release(link);\n        }\n\n        let mut dualq = Dualq::default();\n        dualq.params_init(l4s_max, link);\n        link.aqm_state = Some(Box::new(dualq));\n        Ok(())\n    }\n\n    /// Run the scheduler / mark / drop logic for one packet,\n    /// returning the chosen packet (if any) along with the\n    /// should-drop flag.  C: `picoquictest_sim_packet_t*\n    /// dualq_dequeue_one(dualq_state_t* dualq, uint64_t\n    /// current_time, int* should_drop)`.\n    ///\n    /// The C `should_drop` out-parameter folds into the tuple\n    /// return.  `None` mirrors the C `NULL` \"no packet ready\" path;\n    /// the C body always sets `*should_drop = 0` before returning\n    /// `NULL`, so no flag survives that branch.\n    ///\n    /// Exposed publicly to mirror the C surface used by the\n    /// `dualq_aqm_test.c` unit tests; Phase 2 translates those\n    /// tests directly.\n    pub fn dequeue_one(&mut self, current_time: Instant) -> Option<(TestSimPacket, bool)> {\n        let (mut packet, is_lq) = self.scheduler()?;\n        let mut should_drop = false;\n\n        if is_lq {\n            if self.p_cl < self.p_l_max {\n                self.p_prime_l = self.laqm(current_time);\n                self.p_l = self.p_prime_l.max(self.p_cl);\n                if Self::recur(&mut self.lq, self.p_prime_l) {\n                    packet.ecn_mark = PICOQUIC_ECN_CE;\n                }\n            } else if Self::recur(&mut self.lq, self.p_c) {\n                should_drop = true;\n            } else if Self::recur(&mut self.lq, self.p_cl) {\n                packet.ecn_mark = PICOQUIC_ECN_CE;\n            }\n        } else if Self::recur(&mut self.cq, self.p_c) {\n            if packet.ecn_mark == 0 || self.p_c >= self.p_c_max {\n                should_drop = true;\n            } else {\n                packet.ecn_mark = PICOQUIC_ECN_CE;\n            }\n        }\n\n        Some((packet, should_drop))\n    }\n}\n\n#[cfg(test)]\nmod test {}\n","numLines":474,"startLine":1,"totalLines":474}}}
