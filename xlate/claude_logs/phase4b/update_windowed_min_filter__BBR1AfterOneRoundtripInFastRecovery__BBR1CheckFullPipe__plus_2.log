{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01BwRChk9ak3CnmC3bpqDNTD","type":"tool_result","content":"1\t//! Translation of `quic/cc_common.h`.\n2\t//!\n3\t//! Shared helpers used by every congestion-control module: RTT\n4\t//! filtering, HyStart / HyStart++ slow-start exit tests, slow-start\n5\t//! window-growth helpers, and the standalone New Reno simulator that\n6\t//! several other algorithms run as a lower-bound estimator.\n7\t//!\n8\t//! Phase 4: all function bodies are implemented.\n9\t\n10\tuse crate::internal::{\n11\t    CWIN_INITIAL, CWIN_MINIMUM, Connection, Path, TARGET_RENO_RTT, TARGET_SATELLITE_RTT,\n12\t};\n13\tuse crate::{CongestionNotification, Duration, Instant, PerAckState};\n14\t\n15\t// ---------------------------------------------------------------------------\n16\t// Tunable constants (`#define`s in the header).\n17\t\n18\t/// Window size of the min/max RTT filter, counted in RTT\n19\t/// measurements.  Doubles as the threshold of consecutive\n20\t/// RTT-excess measurements that trigger slow-start exit.  Used as\n21\t/// an array dimension below, hence `usize`.\n22\tpub const MIN_MAX_RTT_SCOPE: usize = 7;\n23\t\n24\t/// Lookback window for the smoothed packet-loss filter, in packets.\n25\tpub const SMOOTHED_LOSS_SCOPE: u64 = 32;\n26\t\n27\t/// Per-step decay factor for the smoothed loss-rate EMA.  Equivalent\n28\t/// to `1.0 / 16.0`, written explicitly for parity with the C macro.\n29\tpub const SMOOTHED_LOSS_FACTOR: f64 = 1.0 / 16.0;\n30\t\n31\t/// Drop-rate threshold above which the volume-based HyStart loss\n32\t/// test triggers slow-start exit.\n33\tpub const SMOOTHED_LOSS_THRESHOLD: f64 = 0.15;\n34\t\n35\t// HyStart++ tuning constants.  Values come from the IETF HyStart++\n36\t// draft (RFC 9406-equivalent); see the C header for the full\n37\t// rationale, including why `L` is omitted (quic is always paced).\n38\t\n39\tpub const HYSTART_PP_MIN_RTT_THRESH: u64 = 4_000;\n40\tpub const HYSTART_PP_MAX_RTT_THRESH: u64 = 16_000;\n41\tpub const HYSTART_PP_MIN_RTT_DIVISOR: u64 = 8;\n42\tpub const HYSTART_PP_N_RTT_SAMPLE: u64 = 8;\n43\tpub const HYSTART_PP_CSS_GROWTH_DIVISOR: u64 = 4;\n44\tpub const HYSTART_PP_CSS_ROUNDS: u64 = 5;\n45\t\n46\t// ---------------------------------------------------------------------------\n47\t// RTT filter and HyStart-related state.\n48\t\n49\t/// Rolling min/max RTT filter plus smoothed-loss bookkeeping shared\n50\t/// by HyStart exit tests.  C: `picoquic_min_max_rtt_t`.\n51\t///\n52\t/// Type deviations from C: `is_init` (`int` → `bool`);\n53\t/// `sample_current` (`int` → `usize`, used as array index);\n54\t/// `nb_rtt_excess` (`int` → `u32`, always non-negative; safety wins).\n55\t#[derive(Debug, Clone)]\n56\tpub struct MinMaxRtt {\n57\t    /// `None` until the first RTT measurement arrives.\n58\t    pub last_rtt_sample_time: Option<Instant>,\n59\t    pub rtt_filtered_min: Duration,\n60\t    pub nb_rtt_excess: u32,"}]},"parent_tool_use_id":null,"session_id":"21720fc3-624d-41d8-98fd-db8edd436134","uuid":"1c9d1ef9-02d7-431e-9834-de80c4a3d5ae","timestamp":"2026-05-07T05:07:42.974Z","tool_use_result":{"type":"text","file":{"filePath":"/Users/richbarn/Projects/picoquic/rs/fq/src/cc_common.rs","content":"//! Translation of `quic/cc_common.h`.\n//!\n//! Shared helpers used by every congestion-control module: RTT\n//! filtering, HyStart / HyStart++ slow-start exit tests, slow-start\n//! window-growth helpers, and the standalone New Reno simulator that\n//! several other algorithms run as a lower-bound estimator.\n//!\n//! Phase 4: all function bodies are implemented.\n\nuse crate::internal::{\n    CWIN_INITIAL, CWIN_MINIMUM, Connection, Path, TARGET_RENO_RTT, TARGET_SATELLITE_RTT,\n};\nuse crate::{CongestionNotification, Duration, Instant, PerAckState};\n\n// ---------------------------------------------------------------------------\n// Tunable constants (`#define`s in the header).\n\n/// Window size of the min/max RTT filter, counted in RTT\n/// measurements.  Doubles as the threshold of consecutive\n/// RTT-excess measurements that trigger slow-start exit.  Used as\n/// an array dimension below, hence `usize`.\npub const MIN_MAX_RTT_SCOPE: usize = 7;\n\n/// Lookback window for the smoothed packet-loss filter, in packets.\npub const SMOOTHED_LOSS_SCOPE: u64 = 32;\n\n/// Per-step decay factor for the smoothed loss-rate EMA.  Equivalent\n/// to `1.0 / 16.0`, written explicitly for parity with the C macro.\npub const SMOOTHED_LOSS_FACTOR: f64 = 1.0 / 16.0;\n\n/// Drop-rate threshold above which the volume-based HyStart loss\n/// test triggers slow-start exit.\npub const SMOOTHED_LOSS_THRESHOLD: f64 = 0.15;\n\n// HyStart++ tuning constants.  Values come from the IETF HyStart++\n// draft (RFC 9406-equivalent); see the C header for the full\n// rationale, including why `L` is omitted (quic is always paced).\n\npub const HYSTART_PP_MIN_RTT_THRESH: u64 = 4_000;\npub const HYSTART_PP_MAX_RTT_THRESH: u64 = 16_000;\npub const HYSTART_PP_MIN_RTT_DIVISOR: u64 = 8;\npub const HYSTART_PP_N_RTT_SAMPLE: u64 = 8;\npub const HYSTART_PP_CSS_GROWTH_DIVISOR: u64 = 4;\npub const HYSTART_PP_CSS_ROUNDS: u64 = 5;\n\n// ---------------------------------------------------------------------------\n// RTT filter and HyStart-related state.\n\n/// Rolling min/max RTT filter plus smoothed-loss bookkeeping shared\n/// by HyStart exit tests.  C: `picoquic_min_max_rtt_t`.\n///\n/// Type deviations from C: `is_init` (`int` → `bool`);\n/// `sample_current` (`int` → `usize`, used as array index);\n/// `nb_rtt_excess` (`int` → `u32`, always non-negative; safety wins).\n#[derive(Debug, Clone)]\npub struct MinMaxRtt {\n    /// `None` until the first RTT measurement arrives.\n    pub last_rtt_sample_time: Option<Instant>,\n    pub rtt_filtered_min: Duration,\n    pub nb_rtt_excess: u32,","numLines":60,"startLine":1,"totalLines":563}}}
