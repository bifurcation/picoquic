{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01Q7yfbUYa7cBcj2We3JFniq","type":"tool_result","content":"1095\t}\n1096\t\n1097\tvoid BBR1OnEnterFastRecovery(picoquic_bbr1_state_t* bbr1_state, picoquic_path_t* path_x, uint64_t bytes_in_transit, uint64_t bytes_delivered )\n1098\t{\n1099\t    if (bytes_delivered < path_x->send_mtu) {\n1100\t        bytes_delivered = path_x->send_mtu;\n1101\t    }\n1102\t    bbr1_state->prior_cwnd = BBR1SaveCwnd(bbr1_state, path_x);\n1103\t    path_x->cwin = bytes_in_transit + bytes_delivered;\n1104\t    bbr1_state->packet_conservation = 1;\n1105\t}\n1106\t\n1107\tvoid BBR1AfterOneRoundtripInFastRecovery(picoquic_bbr1_state_t* bbr1_state)\n1108\t{\n1109\t    bbr1_state->packet_conservation = 0;\n1110\t}\n1111\t\n1112\tvoid BBR1ExitFastRecovery(picoquic_bbr1_state_t* bbr1_state, picoquic_path_t* path_x)\n1113\t{\n1114\t    bbr1_state->packet_conservation = 0;\n1115\t    BBR1RestoreCwnd(bbr1_state, path_x);\n1116\t}\n1117\t\n1118\t/* Reaction to ECN or sustained losses\n1119\t */\n1120\tvoid picoquic_bbr1_notify_congestion(\n1121\t    picoquic_bbr1_state_t* bbr1_state,\n1122\t    picoquic_cnx_t* cnx,\n1123\t    picoquic_path_t* path_x,\n1124\t    uint64_t current_time,"}]},"parent_tool_use_id":null,"session_id":"21720fc3-624d-41d8-98fd-db8edd436134","uuid":"20e394a4-b669-4f18-9e69-f24e414d4bc5","timestamp":"2026-05-07T05:07:09.979Z","tool_use_result":{"type":"text","file":{"filePath":"/Users/richbarn/Projects/picoquic/picoquic/bbr1.c","content":"}\n\nvoid BBR1OnEnterFastRecovery(picoquic_bbr1_state_t* bbr1_state, picoquic_path_t* path_x, uint64_t bytes_in_transit, uint64_t bytes_delivered )\n{\n    if (bytes_delivered < path_x->send_mtu) {\n        bytes_delivered = path_x->send_mtu;\n    }\n    bbr1_state->prior_cwnd = BBR1SaveCwnd(bbr1_state, path_x);\n    path_x->cwin = bytes_in_transit + bytes_delivered;\n    bbr1_state->packet_conservation = 1;\n}\n\nvoid BBR1AfterOneRoundtripInFastRecovery(picoquic_bbr1_state_t* bbr1_state)\n{\n    bbr1_state->packet_conservation = 0;\n}\n\nvoid BBR1ExitFastRecovery(picoquic_bbr1_state_t* bbr1_state, picoquic_path_t* path_x)\n{\n    bbr1_state->packet_conservation = 0;\n    BBR1RestoreCwnd(bbr1_state, path_x);\n}\n\n/* Reaction to ECN or sustained losses\n */\nvoid picoquic_bbr1_notify_congestion(\n    picoquic_bbr1_state_t* bbr1_state,\n    picoquic_cnx_t* cnx,\n    picoquic_path_t* path_x,\n    uint64_t current_time,","numLines":30,"startLine":1095,"totalLines":1341}}}
