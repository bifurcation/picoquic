te->cycle_index = start;\n806\t    bbr1_state->cycle_start = start;\n807\t    bbr1_state->btl_bw_increased = 1;\n808\t\n809\t    BBR1AdvanceCyclePhase(bbr1_state, current_time);\n810\t    /* Start sampling */\n811\t    BBR1ltbwSampling(bbr1_state, path_x, current_time);\n812\t}\n813\t\n814\tvoid BBR1EnterDrain(picoquic_bbr1_state_t* bbr1_state, picoquic_path_t* path_x, uint64_t current_time)\n815\t{\n816\t    path_x->is_ssthresh_initialized = 1;\n817\t    bbr1_state->state = picoquic_bbr1_alg_drain;\n818\t    bbr1_state->pacing_gain = 1.0 / BBR1_HIGH_GAIN;  /* pace slowly */\n819\t    bbr1_state->cwnd_gain = BBR1_HIGH_GAIN;   /* maintain cwnd */\n820\t    /* Start sampling */\n821\t    BBR1ltbwSampling(bbr1_state, path_x, current_time);\n822\t}\n823\t\n824\tvoid BBR1CheckDrain(picoquic_bbr1_state_t* bbr1_state, picoquic_path_t* path_x, uint64_t bytes_in_transit, uint64_t current_time)\n825\t{\n826\t    if (bbr1_state->state == picoquic_bbr1_alg_startup && bbr1_state->filled_pipe) {\n827\t        BBR1EnterDrain(bbr1_state, path_x, current_time);\n828\t    }\n829\t\n830\t    if (bbr1_state->state == picoquic_bbr1_alg_drain && bytes_in_transit <= BBR1Inflight(bbr1_state, 1.0)) {\n831\t        BBR1EnterProbeBW(bbr1_state, path_x, current_time);  /* we estimate queue is drained */\n832\t    }\n833\t}\n834\t\n835\tvoid BBR1ExitStartupLongRtt(picoquic_bbr1_state_t* bbr1_state, picoquic_path_t* path_x, uint64_t current_time)\n836\t{\n837\t    /* Reset the round filter so it will start at current time */\n838\t    bbr1_state->next_round_delivered = path_x->delivered;\n839\t    bbr1_state->round_count++;\n840\t    bbr1_state->round_start = 1;\n841\t    /* Set the filled pipe indicator */\n842\t    bbr1_state->full_bw = bbr1_state->btl_bw;\n843\t    bbr1_state->full_bw_count = 3;\n844\t    bbr1_state->filled_pipe = 1;\n845\t    /* Check the RTT measurement for pathological cases */\n846\t    if ((bbr1_state->rtt_filter.is_init || bbr1_state->rtt_filter.sample_current > 0) &&\n