{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01K3gzqTZq2sKPcaM5N9E16k","type":"tool_result","content":"160\ttypedef struct st_picoquic_bbr_state_t {\n161\t    /* Algorithm state: */\n162\t    picoquic_bbr_alg_state_t state;\n163\t    uint64_t round_start_pn;\n164\t    int round_count;\n165\t    int rounds_since_probe;\n166\t    unsigned int round_start : 1;\n167\t    uint64_t next_round_delivered; /* packet delivered value at end of round trip */\n168\t    /* Output */\n169\t    //uint64_t cwnd; /* new in BBRv3 */\n170\t    double pacing_rate;\n171\t    uint64_t send_quantum;\n172\t    uint64_t prior_cwnd;\n173\t    /* Pacing state */\n174\t    double pacing_gain;\n175\t    uint64_t next_departure_time; /* earliest departure time of next packet, per pacing conditions -- new in BBRv3 */\n176\t    /* CWND state */\n177\t    double cwnd_gain;\n178\t    unsigned int packet_conservation : 1; /* whether BBR is using conservation dynamics */\n179\t    /*  Data Rate parameters: */\n180\t    uint64_t max_bw; /* windowed maximum recent bandwidth sample -- new in BBRv3 */\n181\t    uint64_t bw_hi; /* long term maximum -- new in BBRv3 */\n182\t    uint64_t bw_lo; /* short term maximum -- new in BBRv3 */\n183\t    uint64_t bw; /* max bw for current cycle, min(max_bw, bw_hi, bw_lo) -- new in BBRv3 */\n184\t\n185\t    /* RTT parameters */\n186\t    uint64_t min_rtt; /* minimum RTT measured over last 10sec */\n187\t#ifdef RTTJitterBuffer\n188\t    uint64_t rtt_jitter_buffer[BBRRTTJitterBufferLen];\n189\t    uint64_t rtt_jitter_cycle;\n190\t    uint64_t rtt_short_term_min;\n191\t    uint64_t rtt_short_term_max;\n192\t    uint64_t last_rtt_sample_stamp;\n193\t    int nb_rtt_excess;\n194\t#endif\n195\t    /* Data volume parameters:*/\n196\t    uint64_t bdp; /* estimate of path BDP, bw* min_rtt  -- new part of state in BBRv3 */\n197\t    uint64_t extra_acked; /* estimate of ack aggregation on path -- new in BBRv3 */\n198\t    uint64_t offload_budget; /* data necessary for using TSO / GSO(or LRO, GRO) -- new in BBRv3 */\n199\t    uint64_t max_inflight; /* data necessary to fully use link, f(bdp, extra_acked, offload_budget, BBRMinPipeCwnd)  -- new in BBRv3 */\n200\t    uint64_t inflight_hi; /* long term maximum inflight -- when packet losses are observed -- new in BBRv3 */\n201\t    uint64_t inflight_lo; /* short term maximum, generally lower than inflight_hi -- new in BBRv3 */\n202\t\n203\t    /* State for responding to congestion: */\n204\t    uint64_t bw_latest; /* 1 roundtrip max of delivered bw  -- new in BBRv3 */\n205\t    uint64_t inflight_latest; /* 1 roundtrip max of delivered volume -- new in BBRv3 */\n206\t\n207\t    /* Estimate max_bw */\n208\t    uint64_t MaxBwFilter[BBRMaxBwFilterLen]; /* filter tracking maximum of ack.delivery_rate, for estimate max_bw -- new in BBRv3 */\n209\t    unsigned int cycle_count; /* for estimating max_bw filter, rotating it. */\n210\t\n211\t    /* estimate extra acked */\n212\t    uint64_t extra_acked_interval_start; /* start of interval for which extra acked is tracked,  -- new in BBRv3 */\n213\t    uint64_t extra_acked_delivered; /* data delivered since BBR.extra_acked_interval_start,  -- new in BBRv3 */\n214\t    uint64_t ExtraACKedFilter[BBRExtraAckedFilterLen]; /* max filter tracking aggregation, -- new in BBRv3 */\n215\t\n216\t    /* startup parameters (only used in startup state) */\n217\t    unsigned int filled_pipe : 1;\n218\t    uint64_t full_bw; /* baseline max_bw if filled_pipe is true */\n219\t    int full_bw_count; /* nb non-app-limited round trips without large increase of full_bw */\n220\t\n221\t    /* probertt parameters */\n222\t    uint64_t min_rtt_stamp; /* when last min_rtt was obtained. -- new name in BBRv3 */\n223\t    uint64_t probe_rtt_min_delay; /* rtt sample in last interval */\n224\t    uint64_t probe_rtt_min_stamp; /* time when probe_rtt_min_delay was obtained */\n225\t    uint64_t probe_rtt_done_stamp;\n226\t    uint64_t min_rtt_margin; /* Margin of error for min RTT, to avoid spurious expiry of probe RTT timer. */\n227\t    unsigned int probe_rtt_expired; /* indicates whether min rtt is due for a refresh */\n228\t    unsigned int probe_rtt_round_done;\n229\t    unsigned int idle_restart : 1;\n230\t    unsigned int path_is_app_limited : 1;\n231\t\n232\t    /* probe BW parameters */\n233\t    unsigned int probe_probe_bw_quickly : 1;\n234\t    uint64_t bw_probe_wait;\n235\t    uint64_t bw_probe_ceiling; /* If bandwidth grows more than ceiling in probe_bw states, redo startup */\n236\t    uint64_t cycle_stamp;\n237\t    uint32_t rounds_since_bw_probe;\n238\t    uint32_t bw_probe_up_cnt;\n239\t    uint32_t bw_probe_up_rounds;\n240\t    uint32_t bw_probe_samples;\n241\t    uint64_t bw_probe_up_acks;\n242\t    picoquic_bbr_ack_phase_t ack_phase;\n243\t#ifdef RTTJitterBuffer\n244\t    /* Management of RTT checks */\n245\t    unsigned int rtt_too_high_in_round : 1;\n246\t#endif\n247\t    /* Management of packet losses and recovery */\n248\t    unsigned int loss_in_round : 1;\n249\t    unsigned int loss_round_start : 1;\n250\t    uint64_t loss_round_delivered;\n251\t\n252\t    unsigned int is_in_recovery;\n253\t    unsigned int is_pto_recovery;\n254\t    uint64_t recovery_packet_number;\n255\t    uint64_t recovery_delivered;\n256\t\n257\t    /* Management of lost feedback */\n258\t    unsigned int is_handling_lost_feedback : 1;\n259\t    uint64_t cwin_before_lost_feedback;\n260\t\n261\t    /* Management of App limited and transition */\n262\t    int app_limited_round_count;\n263\t    int app_limited_this_round;\n264\t\n265\t    /* Management of ECN marks */\n266\t    uint64_t ecn_ect1_last_round;\n267\t    uint64_t ecn_ce_last_round;\n268\t    double ecn_alpha;\n269\t\n270\t    /* Per connection random state.*/\n271\t    uint64_t random_context;\n272\t\n273\t    /* manage startup long_rtt */\n274\t    picoquic_min_max_rtt_t rtt_filter;\n275\t    uint64_t bdp_seed;\n276\t    unsigned int probe_bdp_seed;\n277\t    \n278\t    /* Experimental extensions, may or maynot be a good idea. */\n279\t    char const* option_string;\n280\t    uint64_t wifi_shadow_rtt; /* Shadow RTT used for wifi connections. */\n281\t    double quantum_ratio; /* allow application to use a different default than 0.1% of bandwidth (or 1ms of traffic) */\n282\t#ifdef BBRExperiment\n283\t    /* Control flags for BBR improvements */\n284\t    bbr_exp exp_flags;\n285\t#endif\n286\t} picoquic_bbr_state_t;\n287\t\n288\t/* BBR v3 assumes that there is state associated with the acknowledgements.\n289\t * BBR assumes that upon reception of an ACK the code immediately\n290\t * schedule transmission of packets that are deemed lost (code was\n291\t * modifed to do that).\n292\t * \n293\t * From draft-cheng-iccrg-delivery-rate-estimation:\n294\t * data_acked = C.delivered - P.delivered\n295\t *            = path->delivered - packet->delivered_prior;\n296\t * ack_elapsed = C.delivered_time - P.delivered_time\n297\t *            = current_time - packet->delivered_time_prior\n298\t * ack_rate = data_acked / ack_elapsed\n299\t * \n300\t * ack_elapsed is NOT equal to rtt_sample, because packet->delivered_time_prior\n301\t * may be lower than packet->send_time.\n302\t * \n303\t * The ack rate is imprecise, because of ACK compression, etc. The Cheng draft\n304\t * suggests:\n305\t * - Define \"P.first_sent_time\" as the time of the first send in a flight of data,\n306\t * - and \"P.sent_time\" as the time the final send in that flight of data\n307\t *   (the send that transmits packet \"P\").\n308\t * The elapsed time for sending the flight is:\n309\t * send_elapsed = (P.sent_time - P.first_sent_time)\n310\t *               = packet->send_time - packet->delivered_sent_prior\n311\t * The delay to receive packets should never be larger than the send rate,\n312\t * so we can use a filter:\n313\t *   delivery_elapsed = max(ack_elapsed, send_elapsed)\n314\t *   delivery_rate = data_acked / delivery_elapsed\n315\t *\n316\t */\n317\ttypedef struct st_bbr_per_ack_state_t {\n318\t    uint64_t delivered; /* volume delivered between acked packet and current time */\n319\t    uint64_t delivery_rate;  /* delivery rate sample when packet was just acked. */\n320\t    uint64_t rtt_sample;\n321\t    uint64_t newly_acked; /* volume of data acked by current ack */\n322\t    uint64_t newly_lost; /* volume of data marked lost on ack received */\n323\t    uint64_t tx_in_flight; /* estimate of in flight data at the time the packet was sent. */\n324\t    uint64_t lost; /* volume lost between transmission of packet and arrival of ACK */\n325\t    /* Tracking of ECN */\n326\t    uint64_t ecn_ce;\n327\t    double ecn_frac;\n328\t    double ecn_alpha;\n329\t    /* Part of \"RS\" struct */\n330\t    unsigned int is_app_limited : 1; /* App marked limited at time of ACK? */\n331\t    unsigned int is_cwnd_limited : 1;\n332\t} bbr_per_ack_state_t;\n333\t\n334\t/* Forward definition of key functions */\n335\tstatic int IsInAProbeBWState(picoquic_bbr_state_t* bbr_state);\n336\tstatic int BBRIsProbingBW(picoquic_bbr_state_t* bbr_state);\n337\tstatic void BBREnterProbeBW(picoquic_bbr_state_t* bbr_state, picoquic_path_t* path_x, uint64_t current_time);\n338\tstatic void BBREnterDrain(picoquic_bbr_state_t* bbr_state, picoquic_path_t* path_x);\n339\t#if 0"}]},"parent_tool_use_id":null,"session_id":"336f6a29-aee9-490b-87cc-68086106e801","uuid":"bfbf4099-c45f-482e-8c01-f999512a1eb0","timestamp":"2026-05-07T02:57:27.946Z","tool_use_result":{"type":"text","file":{"filePath":"/Users/richbarn/Projects/picoquic/picoquic/bbr.c","content":"typedef struct st_picoquic_bbr_state_t {\n    /* Algorithm state: */\n    picoquic_bbr_alg_state_t state;\n    uint64_t round_start_pn;\n    int round_count;\n    int rounds_since_probe;\n    unsigned int round_start : 1;\n    uint64_t next_round_delivered; /* packet delivered value at end of round trip */\n    /* Output */\n    //uint64_t cwnd; /* new in BBRv3 */\n    double pacing_rate;\n    uint64_t send_quantum;\n    uint64_t prior_cwnd;\n    /* Pacing state */\n    double pacing_gain;\n    uint64_t next_departure_time; /* earliest departure time of next packet, per pacing conditions -- new in BBRv3 */\n    /* CWND state */\n    double cwnd_gain;\n    unsigned int packet_conservation : 1; /* whether BBR is using conservation dynamics */\n    /*  Data Rate parameters: */\n    uint64_t max_bw; /* windowed maximum recent bandwidth sample -- new in BBRv3 */\n    uint64_t bw_hi; /* long term maximum -- new in BBRv3 */\n    uint64_t bw_lo; /* short term maximum -- new in BBRv3 */\n    uint64_t bw; /* max bw for current cycle, min(max_bw, bw_hi, bw_lo) -- new in BBRv3 */\n\n    /* RTT parameters */\n    uint64_t min_rtt; /* minimum RTT measured over last 10sec */\n#ifdef RTTJitterBuffer\n    uint64_t rtt_jitter_buffer[BBRRTTJitterBufferLen];\n    uint64_t rtt_jitter_cycle;\n    uint64_t rtt_short_term_min;\n    uint64_t rtt_short_term_max;\n    uint64_t last_rtt_sample_stamp;\n    int nb_rtt_excess;\n#endif\n    /* Data volume parameters:*/\n    uint64_t bdp; /* estimate of path BDP, bw* min_rtt  -- new part of state in BBRv3 */\n    uint64_t extra_acked; /* estimate of ack aggregation on path -- new in BBRv3 */\n    uint64_t offload_budget; /* data necessary for using TSO / GSO(or LRO, GRO) -- new in BBRv3 */\n    uint64_t max_inflight; /* data necessary to fully use link, f(bdp, extra_acked, offload_budget, BBRMinPipeCwnd)  -- new in BBRv3 */\n    uint64_t inflight_hi; /* long term maximum inflight -- when packet losses are observed -- new in BBRv3 */\n    uint64_t inflight_lo; /* short term maximum, generally lower than inflight_hi -- new in BBRv3 */\n\n    /* State for responding to congestion: */\n    uint64_t bw_latest; /* 1 roundtrip max of delivered bw  -- new in BBRv3 */\n    uint64_t inflight_latest; /* 1 roundtrip max of delivered volume -- new in BBRv3 */\n\n    /* Estimate max_bw */\n    uint64_t MaxBwFilter[BBRMaxBwFilterLen]; /* filter tracking maximum of ack.delivery_rate, for estimate max_bw -- new in BBRv3 */\n    unsigned int cycle_count; /* for estimating max_bw filter, rotating it. */\n\n    /* estimate extra acked */\n    uint64_t extra_acked_interval_start; /* start of interval for which extra acked is tracked,  -- new in BBRv3 */\n    uint64_t extra_acked_delivered; /* data delivered since BBR.extra_acked_interval_start,  -- new in BBRv3 */\n    uint64_t ExtraACKedFilter[BBRExtraAckedFilterLen]; /* max filter tracking aggregation, -- new in BBRv3 */\n\n    /* startup parameters (only used in startup state) */\n    unsigned int filled_pipe : 1;\n    uint64_t full_bw; /* baseline max_bw if filled_pipe is true */\n    int full_bw_count; /* nb non-app-limited round trips without large increase of full_bw */\n\n    /* probertt parameters */\n    uint64_t min_rtt_stamp; /* when last min_rtt was obtained. -- new name in BBRv3 */\n    uint64_t probe_rtt_min_delay; /* rtt sample in last interval */\n    uint64_t probe_rtt_min_stamp; /* time when probe_rtt_min_delay was obtained */\n    uint64_t probe_rtt_done_stamp;\n    uint64_t min_rtt_margin; /* Margin of error for min RTT, to avoid spurious expiry of probe RTT timer. */\n    unsigned int probe_rtt_expired; /* indicates whether min rtt is due for a refresh */\n    unsigned int probe_rtt_round_done;\n    unsigned int idle_restart : 1;\n    unsigned int path_is_app_limited : 1;\n\n    /* probe BW parameters */\n    unsigned int probe_probe_bw_quickly : 1;\n    uint64_t bw_probe_wait;\n    uint64_t bw_probe_ceiling; /* If bandwidth grows more than ceiling in probe_bw states, redo startup */\n    uint64_t cycle_stamp;\n    uint32_t rounds_since_bw_probe;\n    uint32_t bw_probe_up_cnt;\n    uint32_t bw_probe_up_rounds;\n    uint32_t bw_probe_samples;\n    uint64_t bw_probe_up_acks;\n    picoquic_bbr_ack_phase_t ack_phase;\n#ifdef RTTJitterBuffer\n    /* Management of RTT checks */\n    unsigned int rtt_too_high_in_round : 1;\n#endif\n    /* Management of packet losses and recovery */\n    unsigned int loss_in_round : 1;\n    unsigned int loss_round_start : 1;\n    uint64_t loss_round_delivered;\n\n    unsigned int is_in_recovery;\n    unsigned int is_pto_recovery;\n    uint64_t recovery_packet_number;\n    uint64_t recovery_delivered;\n\n    /* Management of lost feedback */\n    unsigned int is_handling_lost_feedback : 1;\n    uint64_t cwin_before_lost_feedback;\n\n    /* Management of App limited and transition */\n    int app_limited_round_count;\n    int app_limited_this_round;\n\n    /* Management of ECN marks */\n    uint64_t ecn_ect1_last_round;\n    uint64_t ecn_ce_last_round;\n    double ecn_alpha;\n\n    /* Per connection random state.*/\n    uint64_t random_context;\n\n    /* manage startup long_rtt */\n    picoquic_min_max_rtt_t rtt_filter;\n    uint64_t bdp_seed;\n    unsigned int probe_bdp_seed;\n    \n    /* Experimental extensions, may or maynot be a good idea. */\n    char const* option_string;\n    uint64_t wifi_shadow_rtt; /* Shadow RTT used for wifi connections. */\n    double quantum_ratio; /* allow application to use a different default than 0.1% of bandwidth (or 1ms of traffic) */\n#ifdef BBRExperiment\n    /* Control flags for BBR improvements */\n    bbr_exp exp_flags;\n#endif\n} picoquic_bbr_state_t;\n\n/* BBR v3 assumes that there is state associated with the acknowledgements.\n * BBR assumes that upon reception of an ACK the code immediately\n * schedule transmission of packets that are deemed lost (code was\n * modifed to do that).\n * \n * From draft-cheng-iccrg-delivery-rate-estimation:\n * data_acked = C.delivered - P.delivered\n *            = path->delivered - packet->delivered_prior;\n * ack_elapsed = C.delivered_time - P.delivered_time\n *            = current_time - packet->delivered_time_prior\n * ack_rate = data_acked / ack_elapsed\n * \n * ack_elapsed is NOT equal to rtt_sample, because packet->delivered_time_prior\n * may be lower than packet->send_time.\n * \n * The ack rate is imprecise, because of ACK compression, etc. The Cheng draft\n * suggests:\n * - Define \"P.first_sent_time\" as the time of the first send in a flight of data,\n * - and \"P.sent_time\" as the time the final send in that flight of data\n *   (the send that transmits packet \"P\").\n * The elapsed time for sending the flight is:\n * send_elapsed = (P.sent_time - P.first_sent_time)\n *               = packet->send_time - packet->delivered_sent_prior\n * The delay to receive packets should never be larger than the send rate,\n * so we can use a filter:\n *   delivery_elapsed = max(ack_elapsed, send_elapsed)\n *   delivery_rate = data_acked / delivery_elapsed\n *\n */\ntypedef struct st_bbr_per_ack_state_t {\n    uint64_t delivered; /* volume delivered between acked packet and current time */\n    uint64_t delivery_rate;  /* delivery rate sample when packet was just acked. */\n    uint64_t rtt_sample;\n    uint64_t newly_acked; /* volume of data acked by current ack */\n    uint64_t newly_lost; /* volume of data marked lost on ack received */\n    uint64_t tx_in_flight; /* estimate of in flight data at the time the packet was sent. */\n    uint64_t lost; /* volume lost between transmission of packet and arrival of ACK */\n    /* Tracking of ECN */\n    uint64_t ecn_ce;\n    double ecn_frac;\n    double ecn_alpha;\n    /* Part of \"RS\" struct */\n    unsigned int is_app_limited : 1; /* App marked limited at time of ACK? */\n    unsigned int is_cwnd_limited : 1;\n} bbr_per_ack_state_t;\n\n/* Forward definition of key functions */\nstatic int IsInAProbeBWState(picoquic_bbr_state_t* bbr_state);\nstatic int BBRIsProbingBW(picoquic_bbr_state_t* bbr_state);\nstatic void BBREnterProbeBW(picoquic_bbr_state_t* bbr_state, picoquic_path_t* path_x, uint64_t current_time);\nstatic void BBREnterDrain(picoquic_bbr_state_t* bbr_state, picoquic_path_t* path_x);\n#if 0","numLines":180,"startLine":160,"totalLines":2486}}}
