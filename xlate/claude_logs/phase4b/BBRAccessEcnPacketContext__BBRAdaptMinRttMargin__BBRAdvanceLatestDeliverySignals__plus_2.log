{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01A2FSqzaCPvYx5B8S9FLXgA","type":"tool_result","content":"1\t//! Translation of `quic/cc_common.h`.\n2\t//!\n3\t//! Shared helpers used by every congestion-control module: RTT\n4\t//! filtering, HyStart / HyStart++ slow-start exit tests, slow-start\n5\t//! window-growth helpers, and the standalone New Reno simulator that\n6\t//! several other algorithms run as a lower-bound estimator.\n7\t//!\n8\t//! Phase 4: all function bodies are implemented.\n9\t\n10\tuse crate::internal::{\n11\t    CWIN_INITIAL, CWIN_MINIMUM, Connection, Path, TARGET_RENO_RTT, TARGET_SATELLITE_RTT,\n12\t};\n13\tuse crate::{CongestionNotification, Duration, Instant, PerAckState};\n14\t\n15\t// ---------------------------------------------------------------------------\n16\t// Tunable constants (`#define`s in the header).\n17\t\n18\t/// Window size of the min/max RTT filter, counted in RTT\n19\t/// measurements.  Doubles as the threshold of consecutive\n20\t/// RTT-excess measurements that trigger slow-start exit.  Used as\n21\t/// an array dimension below, hence `usize`.\n22\tpub const MIN_MAX_RTT_SCOPE: usize = 7;\n23\t\n24\t/// Lookback window for the smoothed packet-loss filter, in packets.\n25\tpub const SMOOTHED_LOSS_SCOPE: u64 = 32;\n26\t\n27\t/// Per-step decay factor for the smoothed loss-rate EMA.  Equivalent\n28\t/// to `1.0 / 16.0`, written explicitly for parity with the C macro.\n29\tpub const SMOOTHED_LOSS_FACTOR: f64 = 1.0 / 16.0;\n30\t\n31\t/// Drop-rate threshold above which the volume-based HyStart loss\n32\t/// test triggers slow-start exit.\n33\tpub const SMOOTHED_LOSS_THRESHOLD: f64 = 0.15;\n34\t\n35\t// HyStart++ tuning constants.  Values come from the IETF HyStart++\n36\t// draft (RFC 9406-equivalent); see the C header for the full\n37\t// rationale, including why `L` is omitted (quic is always paced).\n38\t\n39\tpub const HYSTART_PP_MIN_RTT_THRESH: u64 = 4_000;\n40\tpub const HYSTART_PP_MAX_RTT_THRESH: u64 = 16_000;\n41\tpub const HYSTART_PP_MIN_RTT_DIVISOR: u64 = 8;\n42\tpub const HYSTART_PP_N_RTT_SAMPLE: u64 = 8;\n43\tpub const HYSTART_PP_CSS_GROWTH_DIVISOR: u64 = 4;\n44\tpub const HYSTART_PP_CSS_ROUNDS: u64 = 5;\n45\t\n46\t// ---------------------------------------------------------------------------\n47\t// RTT filter and HyStart-related state.\n48\t\n49\t/// Rolling min/max RTT filter plus smoothed-loss bookkeeping shared\n50\t/// by HyStart exit tests.  C: `picoquic_min_max_rtt_t`.\n51\t///\n52\t/// Type deviations from C: `is_init` (`int` → `bool`);\n53\t/// `sample_current` (`int` → `usize`, used as array index);\n54\t/// `nb_rtt_excess` (`int` → `u32`, always non-negative; safety wins).\n55\t#[derive(Debug, Clone)]\n56\tpub struct MinMaxRtt {\n57\t    /// `None` until the first RTT measurement arrives.\n58\t    pub last_rtt_sample_time: Option<Instant>,\n59\t    pub rtt_filtered_min: Duration,\n60\t    pub nb_rtt_excess: u32,\n61\t    pub sample_current: usize,\n62\t    pub is_init: bool,\n63\t    pub smoothed_drop_rate: f64,\n64\t    /// Smoothed byte-count EMA stored in fixed-point with an\n65\t    /// implicit ×16 multiplier (each step is `prev - prev/16 + new`,\n66\t    /// see `picoquic_cc_hystart_loss_volume_test`); the extra range\n67\t    /// avoids precision loss in integer EMA arithmetic.\n68\t    pub smoothed_bytes_sent_16: u64,\n69\t    /// Same fixed-point convention as [`Self::smoothed_bytes_sent_16`].\n70\t    pub smoothed_bytes_lost_16: u64,\n71\t    pub last_lost_packet_number: u64,\n72\t    pub sample_min: Duration,\n73\t    pub sample_max: Duration,\n74\t    pub samples: [Duration; MIN_MAX_RTT_SCOPE],\n75\t}\n76\t\n77\timpl Default for MinMaxRtt {\n78\t    fn default() -> Self {\n79\t        Self {\n80\t            last_rtt_sample_time: None,\n81\t            rtt_filtered_min: Duration::from_ticks(0),\n82\t            nb_rtt_excess: 0,\n83\t            sample_current: 0,\n84\t            is_init: false,\n85\t            smoothed_drop_rate: 0.0,\n86\t            smoothed_bytes_sent_16: 0,\n87\t            smoothed_bytes_lost_16: 0,\n88\t            last_lost_packet_number: 0,\n89\t            sample_min: Duration::from_ticks(0),\n90\t            sample_max: Duration::from_ticks(0),\n91\t            samples: [Duration::from_ticks(0); MIN_MAX_RTT_SCOPE],\n92\t        }\n93\t    }\n94\t}\n95\t\n96\timpl MinMaxRtt {\n97\t    /// Append `rtt` to the rolling sample window and recompute\n98\t    /// `sample_min` / `sample_max`.  C: `picoquic_cc_filter_rtt_min_max`.\n99\t    pub fn filter_rtt_min_max(&mut self, rtt: Duration) {\n100\t        let x = self.sample_current;\n101\t        self.samples[x] = rtt;\n102\t        self.sample_current = x + 1;\n103\t        if self.sample_current >= MIN_MAX_RTT_SCOPE {\n104\t            self.is_init = true;\n105\t            self.sample_current = 0;\n106\t        }\n107\t        let x_max = if self.is_init {\n108\t            MIN_MAX_RTT_SCOPE\n109\t        } else {\n110\t            x + 1\n111\t        };\n112\t        self.sample_min = self.samples[0];\n113\t        self.sample_max = self.samples[0];\n114\t        for i in 1..x_max {\n115\t            if self.samples[i] < self.sample_min {\n116\t                self.sample_min = self.samples[i];\n117\t            } else if self.samples[i] > self.sample_max {\n118\t                self.sample_max = self.samples[i];\n119\t            }\n120\t        }\n121\t    }\n122\t\n123\t    /// HyStart loss-count test: `true` when the smoothed loss rate\n124\t    /// has exceeded `error_rate_max` (or a timeout was observed),\n125\t    /// signalling that slow start should end.  C:\n126\t    /// `picoquic_cc_hystart_loss_test` — the C `int` return is\n127\t    /// purely boolean here.\n128\t    pub fn hystart_loss_test(\n129\t        &mut self,\n130\t        event: CongestionNotification,\n131\t        lost_packet_number: u64,\n132\t        error_rate_max: f64,\n133\t    ) -> bool {\n134\t        let mut ret = false;\n135\t        let mut next_number = self.last_lost_packet_number;\n136\t\n137\t        if lost_packet_number > next_number {\n138\t            if next_number + SMOOTHED_LOSS_SCOPE < lost_packet_number {\n139\t                next_number = lost_packet_number - SMOOTHED_LOSS_SCOPE;\n140\t            }\n141\t            while next_number < lost_packet_number {\n142\t                self.smoothed_drop_rate *= 1.0 - SMOOTHED_LOSS_FACTOR;\n143\t                next_number += 1;\n144\t            }\n145\t            self.smoothed_drop_rate += (1.0 - self.smoothed_drop_rate) * SMOOTHED_LOSS_FACTOR;\n146\t            self.last_lost_packet_number = lost_packet_number;\n147\t\n148\t            match event {\n149\t                CongestionNotification::Repeat => {\n150\t                    ret = self.smoothed_drop_rate > error_rate_max;\n151\t                }\n152\t                CongestionNotification::Timeout => {\n153\t                    ret = true;\n154\t                }\n155\t                _ => {}\n156\t            }\n157\t        }\n158\t        ret\n159\t    }\n160\t\n161\t    /// HyStart loss-volume test, parallel to [`Self::hystart_loss_test`]\n162\t    /// but driven by byte counts rather than packet sequence numbers.\n163\t    /// C: `picoquic_cc_hystart_loss_volume_test`.\n164\t    pub fn hystart_loss_volume_test(\n165\t        &mut self,\n166\t        event: CongestionNotification,\n167\t        nb_bytes_newly_acked: u64,\n168\t        nb_bytes_newly_lost: u64,\n169\t    ) -> bool {\n170\t        self.smoothed_bytes_lost_16 -= self.smoothed_bytes_lost_16 / 16;\n171\t        self.smoothed_bytes_lost_16 += nb_bytes_newly_lost;\n172\t        self.smoothed_bytes_sent_16 -= self.smoothed_bytes_sent_16 / 16;\n173\t        self.smoothed_bytes_sent_16 += nb_bytes_newly_acked + nb_bytes_newly_lost;\n174\t\n175\t        if self.smoothed_bytes_sent_16 > 0 {\n176\t            self.smoothed_drop_rate =\n177\t                self.smoothed_bytes_lost_16 as f64 / self.smoothed_bytes_sent_16 as f64;\n178\t        } else {\n179\t            self.smoothed_drop_rate = 0.0;\n180\t        }\n181\t\n182\t        match event {\n183\t            CongestionNotification::Acknowledgement => {\n184\t                self.smoothed_drop_rate > SMOOTHED_LOSS_THRESHOLD\n185\t            }\n186\t            CongestionNotification::Timeout => true,\n187\t            _ => false,\n188\t        }\n189\t    }\n190\t\n191\t    /// HyStart RTT-rise test: `true` when the filtered RTT has grown\n192\t    /// enough above its minimum to call slow-start over.\n193\t    /// C: `picoquic_cc_hystart_test`.  `is_one_way_delay_enabled`\n194\t    /// was an `int` in C; promoted to `bool`.\n195\t    pub fn hystart_test(\n196\t        &mut self,\n197\t        rtt_measurement: Duration,\n198\t        packet_time: Instant,\n199\t        current_time: Instant,\n200\t        is_one_way_delay_enabled: bool,\n201\t    ) -> bool {\n202\t        if is_one_way_delay_enabled && rtt_measurement == Duration::from_ticks(0) {\n203\t            return false;\n204\t        }\n205\t\n206\t        let threshold = match self.last_rtt_sample_time {\n207\t            None => true,\n208\t            Some(t) => current_time > t + Duration::from_ticks(1000),\n209\t        };\n210\t\n211\t        if !threshold {\n212\t            return false;\n213\t        }\n214\t\n215\t        self.filter_rtt_min_max(rtt_measurement);\n216\t        self.last_rtt_sample_time = Some(current_time);\n217\t\n218\t        if !self.is_init {\n219\t            return false;\n220\t        }\n221\t\n222\t        let mut ret = false;\n223\t        if self.rtt_filtered_min == Duration::from_ticks(0)\n224\t            || self.rtt_filtered_min > self.sample_max\n225\t        {\n226\t            self.rtt_filtered_min = self.sample_max;\n227\t        }\n228\t\n229\t        let delta_max = {\n230\t            let q = self.rtt_filtered_min / 4;\n231\t            // packet_time is an Instant; treat it as a Duration value\n232\t            // for the comparison (both are ticks-based u64 wrappers)\n233\t            let pt = Duration::from_ticks(packet_time.ticks());\n234\t            if q < pt { pt } else { q }\n235\t        };\n236\t\n237\t        if self.sample_min > self.rtt_filtered_min {\n238\t            if self.sample_min > self.rtt_filtered_min + delta_max {\n239\t                self.nb_rtt_excess += 1;\n240\t                if self.nb_rtt_excess >= MIN_MAX_RTT_SCOPE as u32 {\n241\t                    ret = true;\n242\t                }\n243\t            }\n244\t        } else {\n245\t            self.nb_rtt_excess = 0;\n246\t        }\n247\t\n248\t        ret\n249\t    }\n250\t}\n251\t\n252\t// ---------------------------------------------------------------------------\n253\t// Helpers that read QUIC connection and path state.\n254\t//\n255\t// These are pure reads in the C source, so the receivers are `&self`\n256\t// rather than `&mut self`.  Each was a free function whose primary\n257\t// argument is a connection or path; the surface lifts into two\n258\t// capability traits (one rooted on `Connection`, one on `Path`) so\n259\t// callers opt into them with `use crate::cc_common::{ConnectionCc,\n260\t// PathCc}` and the `cc_*` prefix on the C names drops — the trait\n261\t// names already say \"this is the cc surface\".\n262\t\n263\t/// Connection-rooted congestion-control read accessors.  C: the\n264\t/// `picoquic_cc_get_*` family that takes a connection plus a path.\n265\tpub trait ConnectionCc {\n266\t    /// Next-to-send packet sequence number for the relevant packet\n267\t    /// context — per-path under multipath, otherwise the connection's\n268\t    /// application context.  C: `picoquic_cc_get_sequence_number`.\n269\t    fn sequence_number(&self, path_x: &Path) -> u64;\n270\t\n271\t    /// Highest acknowledged packet sequence number for the relevant\n272\t    /// packet context.  C: `picoquic_cc_get_ack_number`.\n273\t    fn ack_number(&self, path_x: &Path) -> u64;\n274\t\n275\t    /// Wall-clock time at which the most recent ACK was received for\n276\t    /// the relevant packet context.  C: `picoquic_cc_get_ack_sent_time`.\n277\t    fn ack_sent_time(&self, path_x: &Path) -> Instant;\n278\t}\n279\t\n280\timpl ConnectionCc for Connection {\n281\t    fn sequence_number(&self, path_x: &Path) -> u64 {\n282\t        if self.is_multipath_enabled {\n283\t            path_x.pkt_ctx.send_sequence\n284\t        } else {\n285\t            self.pkt_ctx[crate::PacketContext::Application as usize].send_sequence\n286\t        }\n287\t    }\n288\t\n289\t    fn ack_number(&self, path_x: &Path) -> u64 {\n290\t        if self.is_multipath_enabled {\n291\t            path_x.pkt_ctx.highest_acknowledged\n292\t        } else {\n293\t            self.pkt_ctx[crate::PacketContext::Application as usize].highest_acknowledged\n294\t        }\n295\t    }\n296\t\n297\t    fn ack_sent_time(&self, path_x: &Path) -> Instant {\n298\t        if self.is_multipath_enabled {\n299\t            path_x.pkt_ctx.latest_time_acknowledged\n300\t        } else {\n301\t            self.pkt_ctx[crate::PacketContext::Application as usize].latest_time_acknowledged\n302\t        }\n303\t    }\n304\t}\n305\t\n306\t/// Path-rooted congestion-control read accessors.  C: the\n307\t/// `picoquic_cc_*` family that takes a path (and reaches the\n308\t/// connection through the path's back-pointer when needed).\n309\tpub trait PathCc {\n310\t    /// Lowest sequence number not yet acknowledged on this path: the\n311\t    /// pending-list head if any, else `highest_acknowledged + 1`.\n312\t    /// C: `picoquic_cc_get_lowest_not_ack`.\n313\t    fn lowest_not_ack(&self) -> u64;\n314\t\n315\t    /// Bytes to add to CWIN while in classic slow start.  Returns\n316\t    /// `nb_delivered` if the path is currently CWIN-blocked, else\n317\t    /// zero (no growth without back-pressure).\n318\t    /// C: `picoquic_cc_slow_start_increase`.\n319\t    fn slow_start_increase(&self, nb_delivered: u64) -> u64;\n320\t\n321\t    /// Bytes to add to CWIN, with HyStart++ Conservative Slow Start\n322\t    /// support: when `in_css` is true, growth is divided by\n323\t    /// [`HYSTART_PP_CSS_GROWTH_DIVISOR`].\n324\t    /// C: `picoquic_cc_slow_start_increase_ex`.\n325\t    fn slow_start_increase_ex(&self, nb_delivered: u64, in_css: bool) -> u64;\n326\t\n327\t    /// Bytes to add to CWIN, with Prague-style ECN damping.\n328\t    /// `prague_alpha` is an integer fraction over 1024 (so `0` means\n329\t    /// no ECN signal and the call falls back to\n330\t    /// [`Self::slow_start_increase_ex`]).\n331\t    /// C: `picoquic_cc_slow_start_increase_ex2`.\n332\t    fn slow_start_increase_ex2(&self, nb_delivered: u64, in_css: bool, prague_alpha: u64) -> u64;\n333\t\n334\t    /// Bandwidth-derived target CWIN: returns the half-BDP estimate\n335\t    /// if it exceeds the current CWIN, otherwise the current CWIN.\n336\t    /// C: `picoquic_cc_update_target_cwin_estimation`.\n337\t    fn update_target_cwin_estimation(&self) -> u64;\n338\t\n339\t    /// CWIN floor for long-RTT paths: scales `CWIN_INITIAL` by the\n340\t    /// path's `rtt_min` (capped at the satellite RTT target).\n341\t    /// Returns the floor if it exceeds the current CWIN, otherwise\n342\t    /// the current CWIN.  C: `picoquic_cc_update_cwin_for_long_rtt`.\n343\t    fn update_cwin_for_long_rtt(&self) -> u64;\n344\t}\n345\t\n346\timpl PathCc for Path {\n347\t    fn lowest_not_ack(&self) -> u64 {\n348\t        // C reads cnx->pkt_ctx[app] for single-path, path->pkt_ctx for multipath.\n349\t        // Path has no back-pointer to Connection, so we always use path->pkt_ctx\n350\t        // (exact for multipath; conservative approximation for single-path).\n351\t        self.pkt_ctx\n352\t            .pending\n353\t            .keys()\n354\t            .next()\n355\t            .copied()\n356\t            .unwrap_or(self.pkt_ctx.highest_acknowledged + 1)\n357\t    }\n358\t\n359\t    fn slow_start_increase(&self, nb_delivered: u64) -> u64 {\n360\t        // C body checks cnx->cwin_blocked.  Path has no back-pointer to\n361\t        // Connection, so approximate with bytes_in_transit >= cwin, which is\n362\t        // the condition that sets cwin_blocked in the C library.\n363\t        if self.bytes_in_transit < self.cwin {\n364\t            0\n365\t        } else {\n366\t            nb_delivered\n367\t        }\n368\t    }\n369\t\n370\t    fn slow_start_increase_ex(&self, nb_delivered: u64, in_css: bool) -> u64 {\n371\t        if in_css {\n372\t            self.slow_start_increase(nb_delivered / HYSTART_PP_CSS_GROWTH_DIVISOR)\n373\t        } else {\n374\t            self.slow_start_increase(nb_delivered)\n375\t        }\n376\t    }\n377\t\n378\t    fn slow_start_increase_ex2(&self, nb_delivered: u64, in_css: bool, prague_alpha: u64) -> u64 {\n379\t        if prague_alpha != 0 {\n380\t            let delta = if self.smoothed_rtt <= TARGET_RENO_RTT {\n381\t                nb_delivered * (1024 - prague_alpha) / 1024\n382\t            } else {\n383\t                nb_delivered * self.smoothed_rtt.ticks() * (1024 - prague_alpha)\n384\t                    / TARGET_RENO_RTT.ticks()\n385\t                    / 1024\n386\t            };\n387\t            self.slow_start_increase_ex(delta, in_css)\n388\t        } else {\n389\t            self.slow_start_increase_ex(nb_delivered, in_css)\n390\t        }\n391\t    }\n392\t\n393\t    fn update_target_cwin_estimation(&self) -> u64 {\n394\t        // BYTES_FROM_RATE(smoothed_rtt, peak_bandwidth_estimate) = rtt_us * bps / 1_000_000\n395\t        let max_win = self.smoothed_rtt.ticks() * self.peak_bandwidth_estimate / 1_000_000;\n396\t        let min_win = max_win / 2;\n397\t        if min_win > self.cwin {\n398\t            min_win\n399\t        } else {\n400\t            self.cwin\n401\t        }\n402\t    }\n403\t\n404\t    fn update_cwin_for_long_rtt(&self) -> u64 {\n405\t        let rtt_cap = if self.rtt_min > TARGET_SATELLITE_RTT {\n406\t            TARGET_SATELLITE_RTT\n407\t        } else {\n408\t            self.rtt_min\n409\t        };\n410\t        let min_cwnd =\n411\t            (CWIN_INITIAL as f64 * rtt_cap.ticks() as f64 / TARGET_RENO_RTT.ticks() as f64) as u64;\n412\t        if min_cwnd > self.cwin {\n413\t            min_cwnd\n414\t        } else {\n415\t            self.cwin\n416\t        }\n417\t    }\n418\t}\n419\t\n420\t// ---------------------------------------------------------------------------\n421\t// Embedded New Reno simulator.\n422\t//\n423\t// Several congestion controllers run a parallel New Reno instance to\n424\t// derive a lower bound on the congestion window or minimum\n425\t// bandwidth.  This simulator does not touch the connection or path\n426\t// state directly; everything lives in `NewRenoSimState`.\n427\t\n428\t/// Internal phase of the embedded New Reno simulator.\n429\t/// C: `picoquic_newreno_alg_state_t`.\n430\t#[derive(Debug, Copy, Clone, PartialEq, Eq, Default)]\n431\tpub enum NewRenoAlgState {\n432\t    #[default]\n433\t    SlowStart,\n434\t    CongestionAvoidance,\n435\t}\n436\t\n437\t/// Simulator state for the embedded New Reno instance.\n438\t/// C: `picoquic_newreno_sim_state_t`.\n439\t#[derive(Debug, Clone, Default)]\n440\tpub struct NewRenoSimState {\n441\t    pub alg_state: NewRenoAlgState,\n442\t    pub cwin: u64,\n443\t    pub residual_ack: u64,\n444\t    pub ssthresh: u64,\n445\t    pub recovery_start: u64,\n446\t    pub recovery_sequence: u64,\n447\t}\n448\t\n449\timpl NewRenoSimState {\n450\t    /// Reset the simulator to its initial state.\n451\t    /// C: `picoquic_newreno_sim_reset`.\n452\t    pub fn reset(&mut self) {\n453\t        *self = Self::default();\n454\t        self.ssthresh = u64::MAX;\n455\t        self.cwin = CWIN_INITIAL;\n456\t    }\n457\t\n458\t    /// Drive the simulator with a congestion-control event.\n459\t    ///\n460\t    /// `connection` and `path_x` are read-only here: the C body only mutates\n461\t    /// `self`, reading the connection and path to resolve sequence\n462\t    /// numbers and timestamps via the `cc_*` accessors.  C:\n463\t    /// `picoquic_newreno_sim_notify`.\n464\t    pub fn notify(\n465\t        &mut self,\n466\t        connection: &Connection,\n467\t        path_x: &Path,\n468\t        notification: CongestionNotification,\n469\t        ack_state: &PerAckState,\n470\t        current_time: Instant,\n471\t    ) {\n472\t        match notification {\n473\t            CongestionNotification::Acknowledgement => match self.alg_state {\n474\t                NewRenoAlgState::SlowStart => {\n475\t                    self.cwin += ack_state.nb_bytes_acknowledged;\n476\t                    if self.cwin >= self.ssthresh {\n477\t                        self.alg_state = NewRenoAlgState::CongestionAvoidance;\n478\t                    }\n479\t                }\n480\t                NewRenoAlgState::CongestionAvoidance => {\n481\t                    let complete_delta = ack_state.nb_bytes_acknowledged * path_x.send_mtu as u64\n482\t                        + self.residual_ack;\n483\t                    self.residual_ack = complete_delta % self.cwin;\n484\t                    self.cwin += complete_delta / self.cwin;\n485\t                }\n486\t            },\n487\t            CongestionNotification::EcnEc\n488\t            | CongestionNotification::Repeat\n489\t            | CongestionNotification::Timeout\n490\t                if self.recovery_sequence <= ack_state.lost_packet_number =>\n491\t            {\n492\t                self.enter_recovery(connection, path_x, notification, current_time);\n493\t            }\n494\t            CongestionNotification::EcnEc\n495\t            | CongestionNotification::Repeat\n496\t            | CongestionNotification::Timeout => {}\n497\t            CongestionNotification::SpuriousRepeat => {\n498\t                if !connection.is_multipath_enabled {\n499\t                    if current_time.ticks() - self.recovery_start < path_x.smoothed_rtt.ticks()\n500\t                        && self.recovery_sequence > connection.ack_number(path_x)\n501\t                        && self.ssthresh != u64::MAX\n502\t                        && self.cwin < 2 * self.ssthresh\n503\t                    {\n504\t                        self.cwin = 2 * self.ssthresh;\n505\t                        self.alg_state = NewRenoAlgState::CongestionAvoidance;\n506\t                    }\n507\t                } else if current_time.ticks() - self.recovery_start < path_x.smoothed_rtt.ticks()\n508\t                    && self.recovery_start > connection.ack_sent_time(path_x).ticks()\n509\t                    && self.ssthresh != u64::MAX\n510\t                    && self.cwin < 2 * self.ssthresh\n511\t                {\n512\t                    self.cwin = 2 * self.ssthresh;\n513\t                    self.alg_state = NewRenoAlgState::CongestionAvoidance;\n514\t                }\n515\t            }\n516\t            CongestionNotification::Reset => {\n517\t                self.reset();\n518\t            }\n519\t            CongestionNotification::SeedCwin => {\n520\t                self.seed_cwin(ack_state.nb_bytes_acknowledged);\n521\t            }\n522\t            _ => {}\n523\t        }\n524\t    }\n525\t\n526\t    fn enter_recovery(\n527\t        &mut self,\n528\t        connection: &Connection,\n529\t        path_x: &Path,\n530\t        notification: CongestionNotification,\n531\t        current_time: Instant,\n532\t    ) {\n533\t        self.ssthresh = self.cwin / 2;\n534\t        if self.ssthresh < CWIN_MINIMUM {\n535\t            self.ssthresh = CWIN_MINIMUM;\n536\t        }\n537\t        if notification == CongestionNotification::Timeout {\n538\t            self.cwin = CWIN_MINIMUM;\n539\t            self.alg_state = NewRenoAlgState::SlowStart;\n540\t        } else {\n541\t            self.cwin = self.ssthresh;\n542\t            self.alg_state = NewRenoAlgState::CongestionAvoidance;\n543\t        }\n544\t        self.recovery_start = current_time.ticks();\n545\t        self.recovery_sequence = connection.sequence_number(path_x);\n546\t        self.residual_ack = 0;\n547\t    }\n548\t\n549\t    fn seed_cwin(&mut self, seed_cwin: u64) {\n550\t        if self.alg_state == NewRenoAlgState::SlowStart\n551\t            && self.ssthresh == u64::MAX\n552\t            && seed_cwin > self.cwin\n553\t        {\n554\t            self.cwin = seed_cwin;\n555\t            self.ssthresh = seed_cwin;\n556\t            self.alg_state = NewRenoAlgState::CongestionAvoidance;\n557\t        }\n558\t    }\n559\t}\n560\t\n561\t#[cfg(test)]\n562\tmod test {}\n563\t"}]},"parent_tool_use_id":null,"session_id":"336f6a29-aee9-490b-87cc-68086106e801","uuid":"acf44a37-2dfd-4b11-b2d8-e4e5ea6041cb","timestamp":"2026-05-07T02:56:31.214Z","tool_use_result":{"type":"text","file":{"filePath":"/Users/richbarn/Projects/picoquic/rs/fq/src/cc_common.rs","content":"//! Translation of `quic/cc_common.h`.\n//!\n//! Shared helpers used by every congestion-control module: RTT\n//! filtering, HyStart / HyStart++ slow-start exit tests, slow-start\n//! window-growth helpers, and the standalone New Reno simulator that\n//! several other algorithms run as a lower-bound estimator.\n//!\n//! Phase 4: all function bodies are implemented.\n\nuse crate::internal::{\n    CWIN_INITIAL, CWIN_MINIMUM, Connection, Path, TARGET_RENO_RTT, TARGET_SATELLITE_RTT,\n};\nuse crate::{CongestionNotification, Duration, Instant, PerAckState};\n\n// ---------------------------------------------------------------------------\n// Tunable constants (`#define`s in the header).\n\n/// Window size of the min/max RTT filter, counted in RTT\n/// measurements.  Doubles as the threshold of consecutive\n/// RTT-excess measurements that trigger slow-start exit.  Used as\n/// an array dimension below, hence `usize`.\npub const MIN_MAX_RTT_SCOPE: usize = 7;\n\n/// Lookback window for the smoothed packet-loss filter, in packets.\npub const SMOOTHED_LOSS_SCOPE: u64 = 32;\n\n/// Per-step decay factor for the smoothed loss-rate EMA.  Equivalent\n/// to `1.0 / 16.0`, written explicitly for parity with the C macro.\npub const SMOOTHED_LOSS_FACTOR: f64 = 1.0 / 16.0;\n\n/// Drop-rate threshold above which the volume-based HyStart loss\n/// test triggers slow-start exit.\npub const SMOOTHED_LOSS_THRESHOLD: f64 = 0.15;\n\n// HyStart++ tuning constants.  Values come from the IETF HyStart++\n// draft (RFC 9406-equivalent); see the C header for the full\n// rationale, including why `L` is omitted (quic is always paced).\n\npub const HYSTART_PP_MIN_RTT_THRESH: u64 = 4_000;\npub const HYSTART_PP_MAX_RTT_THRESH: u64 = 16_000;\npub const HYSTART_PP_MIN_RTT_DIVISOR: u64 = 8;\npub const HYSTART_PP_N_RTT_SAMPLE: u64 = 8;\npub const HYSTART_PP_CSS_GROWTH_DIVISOR: u64 = 4;\npub const HYSTART_PP_CSS_ROUNDS: u64 = 5;\n\n// ---------------------------------------------------------------------------\n// RTT filter and HyStart-related state.\n\n/// Rolling min/max RTT filter plus smoothed-loss bookkeeping shared\n/// by HyStart exit tests.  C: `picoquic_min_max_rtt_t`.\n///\n/// Type deviations from C: `is_init` (`int` → `bool`);\n/// `sample_current` (`int` → `usize`, used as array index);\n/// `nb_rtt_excess` (`int` → `u32`, always non-negative; safety wins).\n#[derive(Debug, Clone)]\npub struct MinMaxRtt {\n    /// `None` until the first RTT measurement arrives.\n    pub last_rtt_sample_time: Option<Instant>,\n    pub rtt_filtered_min: Duration,\n    pub nb_rtt_excess: u32,\n    pub sample_current: usize,\n    pub is_init: bool,\n    pub smoothed_drop_rate: f64,\n    /// Smoothed byte-count EMA stored in fixed-point with an\n    /// implicit ×16 multiplier (each step is `prev - prev/16 + new`,\n    /// see `picoquic_cc_hystart_loss_volume_test`); the extra range\n    /// avoids precision loss in integer EMA arithmetic.\n    pub smoothed_bytes_sent_16: u64,\n    /// Same fixed-point convention as [`Self::smoothed_bytes_sent_16`].\n    pub smoothed_bytes_lost_16: u64,\n    pub last_lost_packet_number: u64,\n    pub sample_min: Duration,\n    pub sample_max: Duration,\n    pub samples: [Duration; MIN_MAX_RTT_SCOPE],\n}\n\nimpl Default for MinMaxRtt {\n    fn default() -> Self {\n        Self {\n            last_rtt_sample_time: None,\n            rtt_filtered_min: Duration::from_ticks(0),\n            nb_rtt_excess: 0,\n            sample_current: 0,\n            is_init: false,\n            smoothed_drop_rate: 0.0,\n            smoothed_bytes_sent_16: 0,\n            smoothed_bytes_lost_16: 0,\n            last_lost_packet_number: 0,\n            sample_min: Duration::from_ticks(0),\n            sample_max: Duration::from_ticks(0),\n            samples: [Duration::from_ticks(0); MIN_MAX_RTT_SCOPE],\n        }\n    }\n}\n\nimpl MinMaxRtt {\n    /// Append `rtt` to the rolling sample window and recompute\n    /// `sample_min` / `sample_max`.  C: `picoquic_cc_filter_rtt_min_max`.\n    pub fn filter_rtt_min_max(&mut self, rtt: Duration) {\n        let x = self.sample_current;\n        self.samples[x] = rtt;\n        self.sample_current = x + 1;\n        if self.sample_current >= MIN_MAX_RTT_SCOPE {\n            self.is_init = true;\n            self.sample_current = 0;\n        }\n        let x_max = if self.is_init {\n            MIN_MAX_RTT_SCOPE\n        } else {\n            x + 1\n        };\n        self.sample_min = self.samples[0];\n        self.sample_max = self.samples[0];\n        for i in 1..x_max {\n            if self.samples[i] < self.sample_min {\n                self.sample_min = self.samples[i];\n            } else if self.samples[i] > self.sample_max {\n                self.sample_max = self.samples[i];\n            }\n        }\n    }\n\n    /// HyStart loss-count test: `true` when the smoothed loss rate\n    /// has exceeded `error_rate_max` (or a timeout was observed),\n    /// signalling that slow start should end.  C:\n    /// `picoquic_cc_hystart_loss_test` — the C `int` return is\n    /// purely boolean here.\n    pub fn hystart_loss_test(\n        &mut self,\n        event: CongestionNotification,\n        lost_packet_number: u64,\n        error_rate_max: f64,\n    ) -> bool {\n        let mut ret = false;\n        let mut next_number = self.last_lost_packet_number;\n\n        if lost_packet_number > next_number {\n            if next_number + SMOOTHED_LOSS_SCOPE < lost_packet_number {\n                next_number = lost_packet_number - SMOOTHED_LOSS_SCOPE;\n            }\n            while next_number < lost_packet_number {\n                self.smoothed_drop_rate *= 1.0 - SMOOTHED_LOSS_FACTOR;\n                next_number += 1;\n            }\n            self.smoothed_drop_rate += (1.0 - self.smoothed_drop_rate) * SMOOTHED_LOSS_FACTOR;\n            self.last_lost_packet_number = lost_packet_number;\n\n            match event {\n                CongestionNotification::Repeat => {\n                    ret = self.smoothed_drop_rate > error_rate_max;\n                }\n                CongestionNotification::Timeout => {\n                    ret = true;\n                }\n                _ => {}\n            }\n        }\n        ret\n    }\n\n    /// HyStart loss-volume test, parallel to [`Self::hystart_loss_test`]\n    /// but driven by byte counts rather than packet sequence numbers.\n    /// C: `picoquic_cc_hystart_loss_volume_test`.\n    pub fn hystart_loss_volume_test(\n        &mut self,\n        event: CongestionNotification,\n        nb_bytes_newly_acked: u64,\n        nb_bytes_newly_lost: u64,\n    ) -> bool {\n        self.smoothed_bytes_lost_16 -= self.smoothed_bytes_lost_16 / 16;\n        self.smoothed_bytes_lost_16 += nb_bytes_newly_lost;\n        self.smoothed_bytes_sent_16 -= self.smoothed_bytes_sent_16 / 16;\n        self.smoothed_bytes_sent_16 += nb_bytes_newly_acked + nb_bytes_newly_lost;\n\n        if self.smoothed_bytes_sent_16 > 0 {\n            self.smoothed_drop_rate =\n                self.smoothed_bytes_lost_16 as f64 / self.smoothed_bytes_sent_16 as f64;\n        } else {\n            self.smoothed_drop_rate = 0.0;\n        }\n\n        match event {\n            CongestionNotification::Acknowledgement => {\n                self.smoothed_drop_rate > SMOOTHED_LOSS_THRESHOLD\n            }\n            CongestionNotification::Timeout => true,\n            _ => false,\n        }\n    }\n\n    /// HyStart RTT-rise test: `true` when the filtered RTT has grown\n    /// enough above its minimum to call slow-start over.\n    /// C: `picoquic_cc_hystart_test`.  `is_one_way_delay_enabled`\n    /// was an `int` in C; promoted to `bool`.\n    pub fn hystart_test(\n        &mut self,\n        rtt_measurement: Duration,\n        packet_time: Instant,\n        current_time: Instant,\n        is_one_way_delay_enabled: bool,\n    ) -> bool {\n        if is_one_way_delay_enabled && rtt_measurement == Duration::from_ticks(0) {\n            return false;\n        }\n\n        let threshold = match self.last_rtt_sample_time {\n            None => true,\n            Some(t) => current_time > t + Duration::from_ticks(1000),\n        };\n\n        if !threshold {\n            return false;\n        }\n\n        self.filter_rtt_min_max(rtt_measurement);\n        self.last_rtt_sample_time = Some(current_time);\n\n        if !self.is_init {\n            return false;\n        }\n\n        let mut ret = false;\n        if self.rtt_filtered_min == Duration::from_ticks(0)\n            || self.rtt_filtered_min > self.sample_max\n        {\n            self.rtt_filtered_min = self.sample_max;\n        }\n\n        let delta_max = {\n            let q = self.rtt_filtered_min / 4;\n            // packet_time is an Instant; treat it as a Duration value\n            // for the comparison (both are ticks-based u64 wrappers)\n            let pt = Duration::from_ticks(packet_time.ticks());\n            if q < pt { pt } else { q }\n        };\n\n        if self.sample_min > self.rtt_filtered_min {\n            if self.sample_min > self.rtt_filtered_min + delta_max {\n                self.nb_rtt_excess += 1;\n                if self.nb_rtt_excess >= MIN_MAX_RTT_SCOPE as u32 {\n                    ret = true;\n                }\n            }\n        } else {\n            self.nb_rtt_excess = 0;\n        }\n\n        ret\n    }\n}\n\n// ---------------------------------------------------------------------------\n// Helpers that read QUIC connection and path state.\n//\n// These are pure reads in the C source, so the receivers are `&self`\n// rather than `&mut self`.  Each was a free function whose primary\n// argument is a connection or path; the surface lifts into two\n// capability traits (one rooted on `Connection`, one on `Path`) so\n// callers opt into them with `use crate::cc_common::{ConnectionCc,\n// PathCc}` and the `cc_*` prefix on the C names drops — the trait\n// names already say \"this is the cc surface\".\n\n/// Connection-rooted congestion-control read accessors.  C: the\n/// `picoquic_cc_get_*` family that takes a connection plus a path.\npub trait ConnectionCc {\n    /// Next-to-send packet sequence number for the relevant packet\n    /// context — per-path under multipath, otherwise the connection's\n    /// application context.  C: `picoquic_cc_get_sequence_number`.\n    fn sequence_number(&self, path_x: &Path) -> u64;\n\n    /// Highest acknowledged packet sequence number for the relevant\n    /// packet context.  C: `picoquic_cc_get_ack_number`.\n    fn ack_number(&self, path_x: &Path) -> u64;\n\n    /// Wall-clock time at which the most recent ACK was received for\n    /// the relevant packet context.  C: `picoquic_cc_get_ack_sent_time`.\n    fn ack_sent_time(&self, path_x: &Path) -> Instant;\n}\n\nimpl ConnectionCc for Connection {\n    fn sequence_number(&self, path_x: &Path) -> u64 {\n        if self.is_multipath_enabled {\n            path_x.pkt_ctx.send_sequence\n        } else {\n            self.pkt_ctx[crate::PacketContext::Application as usize].send_sequence\n        }\n    }\n\n    fn ack_number(&self, path_x: &Path) -> u64 {\n        if self.is_multipath_enabled {\n            path_x.pkt_ctx.highest_acknowledged\n        } else {\n            self.pkt_ctx[crate::PacketContext::Application as usize].highest_acknowledged\n        }\n    }\n\n    fn ack_sent_time(&self, path_x: &Path) -> Instant {\n        if self.is_multipath_enabled {\n            path_x.pkt_ctx.latest_time_acknowledged\n        } else {\n            self.pkt_ctx[crate::PacketContext::Application as usize].latest_time_acknowledged\n        }\n    }\n}\n\n/// Path-rooted congestion-control read accessors.  C: the\n/// `picoquic_cc_*` family that takes a path (and reaches the\n/// connection through the path's back-pointer when needed).\npub trait PathCc {\n    /// Lowest sequence number not yet acknowledged on this path: the\n    /// pending-list head if any, else `highest_acknowledged + 1`.\n    /// C: `picoquic_cc_get_lowest_not_ack`.\n    fn lowest_not_ack(&self) -> u64;\n\n    /// Bytes to add to CWIN while in classic slow start.  Returns\n    /// `nb_delivered` if the path is currently CWIN-blocked, else\n    /// zero (no growth without back-pressure).\n    /// C: `picoquic_cc_slow_start_increase`.\n    fn slow_start_increase(&self, nb_delivered: u64) -> u64;\n\n    /// Bytes to add to CWIN, with HyStart++ Conservative Slow Start\n    /// support: when `in_css` is true, growth is divided by\n    /// [`HYSTART_PP_CSS_GROWTH_DIVISOR`].\n    /// C: `picoquic_cc_slow_start_increase_ex`.\n    fn slow_start_increase_ex(&self, nb_delivered: u64, in_css: bool) -> u64;\n\n    /// Bytes to add to CWIN, with Prague-style ECN damping.\n    /// `prague_alpha` is an integer fraction over 1024 (so `0` means\n    /// no ECN signal and the call falls back to\n    /// [`Self::slow_start_increase_ex`]).\n    /// C: `picoquic_cc_slow_start_increase_ex2`.\n    fn slow_start_increase_ex2(&self, nb_delivered: u64, in_css: bool, prague_alpha: u64) -> u64;\n\n    /// Bandwidth-derived target CWIN: returns the half-BDP estimate\n    /// if it exceeds the current CWIN, otherwise the current CWIN.\n    /// C: `picoquic_cc_update_target_cwin_estimation`.\n    fn update_target_cwin_estimation(&self) -> u64;\n\n    /// CWIN floor for long-RTT paths: scales `CWIN_INITIAL` by the\n    /// path's `rtt_min` (capped at the satellite RTT target).\n    /// Returns the floor if it exceeds the current CWIN, otherwise\n    /// the current CWIN.  C: `picoquic_cc_update_cwin_for_long_rtt`.\n    fn update_cwin_for_long_rtt(&self) -> u64;\n}\n\nimpl PathCc for Path {\n    fn lowest_not_ack(&self) -> u64 {\n        // C reads cnx->pkt_ctx[app] for single-path, path->pkt_ctx for multipath.\n        // Path has no back-pointer to Connection, so we always use path->pkt_ctx\n        // (exact for multipath; conservative approximation for single-path).\n        self.pkt_ctx\n            .pending\n            .keys()\n            .next()\n            .copied()\n            .unwrap_or(self.pkt_ctx.highest_acknowledged + 1)\n    }\n\n    fn slow_start_increase(&self, nb_delivered: u64) -> u64 {\n        // C body checks cnx->cwin_blocked.  Path has no back-pointer to\n        // Connection, so approximate with bytes_in_transit >= cwin, which is\n        // the condition that sets cwin_blocked in the C library.\n        if self.bytes_in_transit < self.cwin {\n            0\n        } else {\n            nb_delivered\n        }\n    }\n\n    fn slow_start_increase_ex(&self, nb_delivered: u64, in_css: bool) -> u64 {\n        if in_css {\n            self.slow_start_increase(nb_delivered / HYSTART_PP_CSS_GROWTH_DIVISOR)\n        } else {\n            self.slow_start_increase(nb_delivered)\n        }\n    }\n\n    fn slow_start_increase_ex2(&self, nb_delivered: u64, in_css: bool, prague_alpha: u64) -> u64 {\n        if prague_alpha != 0 {\n            let delta = if self.smoothed_rtt <= TARGET_RENO_RTT {\n                nb_delivered * (1024 - prague_alpha) / 1024\n            } else {\n                nb_delivered * self.smoothed_rtt.ticks() * (1024 - prague_alpha)\n                    / TARGET_RENO_RTT.ticks()\n                    / 1024\n            };\n            self.slow_start_increase_ex(delta, in_css)\n        } else {\n            self.slow_start_increase_ex(nb_delivered, in_css)\n        }\n    }\n\n    fn update_target_cwin_estimation(&self) -> u64 {\n        // BYTES_FROM_RATE(smoothed_rtt, peak_bandwidth_estimate) = rtt_us * bps / 1_000_000\n        let max_win = self.smoothed_rtt.ticks() * self.peak_bandwidth_estimate / 1_000_000;\n        let min_win = max_win / 2;\n        if min_win > self.cwin {\n            min_win\n        } else {\n            self.cwin\n        }\n    }\n\n    fn update_cwin_for_long_rtt(&self) -> u64 {\n        let rtt_cap = if self.rtt_min > TARGET_SATELLITE_RTT {\n            TARGET_SATELLITE_RTT\n        } else {\n            self.rtt_min\n        };\n        let min_cwnd =\n            (CWIN_INITIAL as f64 * rtt_cap.ticks() as f64 / TARGET_RENO_RTT.ticks() as f64) as u64;\n        if min_cwnd > self.cwin {\n            min_cwnd\n        } else {\n            self.cwin\n        }\n    }\n}\n\n// ---------------------------------------------------------------------------\n// Embedded New Reno simulator.\n//\n// Several congestion controllers run a parallel New Reno instance to\n// derive a lower bound on the congestion window or minimum\n// bandwidth.  This simulator does not touch the connection or path\n// state directly; everything lives in `NewRenoSimState`.\n\n/// Internal phase of the embedded New Reno simulator.\n/// C: `picoquic_newreno_alg_state_t`.\n#[derive(Debug, Copy, Clone, PartialEq, Eq, Default)]\npub enum NewRenoAlgState {\n    #[default]\n    SlowStart,\n    CongestionAvoidance,\n}\n\n/// Simulator state for the embedded New Reno instance.\n/// C: `picoquic_newreno_sim_state_t`.\n#[derive(Debug, Clone, Default)]\npub struct NewRenoSimState {\n    pub alg_state: NewRenoAlgState,\n    pub cwin: u64,\n    pub residual_ack: u64,\n    pub ssthresh: u64,\n    pub recovery_start: u64,\n    pub recovery_sequence: u64,\n}\n\nimpl NewRenoSimState {\n    /// Reset the simulator to its initial state.\n    /// C: `picoquic_newreno_sim_reset`.\n    pub fn reset(&mut self) {\n        *self = Self::default();\n        self.ssthresh = u64::MAX;\n        self.cwin = CWIN_INITIAL;\n    }\n\n    /// Drive the simulator with a congestion-control event.\n    ///\n    /// `connection` and `path_x` are read-only here: the C body only mutates\n    /// `self`, reading the connection and path to resolve sequence\n    /// numbers and timestamps via the `cc_*` accessors.  C:\n    /// `picoquic_newreno_sim_notify`.\n    pub fn notify(\n        &mut self,\n        connection: &Connection,\n        path_x: &Path,\n        notification: CongestionNotification,\n        ack_state: &PerAckState,\n        current_time: Instant,\n    ) {\n        match notification {\n            CongestionNotification::Acknowledgement => match self.alg_state {\n                NewRenoAlgState::SlowStart => {\n                    self.cwin += ack_state.nb_bytes_acknowledged;\n                    if self.cwin >= self.ssthresh {\n                        self.alg_state = NewRenoAlgState::CongestionAvoidance;\n                    }\n                }\n                NewRenoAlgState::CongestionAvoidance => {\n                    let complete_delta = ack_state.nb_bytes_acknowledged * path_x.send_mtu as u64\n                        + self.residual_ack;\n                    self.residual_ack = complete_delta % self.cwin;\n                    self.cwin += complete_delta / self.cwin;\n                }\n            },\n            CongestionNotification::EcnEc\n            | CongestionNotification::Repeat\n            | CongestionNotification::Timeout\n                if self.recovery_sequence <= ack_state.lost_packet_number =>\n            {\n                self.enter_recovery(connection, path_x, notification, current_time);\n            }\n            CongestionNotification::EcnEc\n            | CongestionNotification::Repeat\n            | CongestionNotification::Timeout => {}\n            CongestionNotification::SpuriousRepeat => {\n                if !connection.is_multipath_enabled {\n                    if current_time.ticks() - self.recovery_start < path_x.smoothed_rtt.ticks()\n                        && self.recovery_sequence > connection.ack_number(path_x)\n                        && self.ssthresh != u64::MAX\n                        && self.cwin < 2 * self.ssthresh\n                    {\n                        self.cwin = 2 * self.ssthresh;\n                        self.alg_state = NewRenoAlgState::CongestionAvoidance;\n                    }\n                } else if current_time.ticks() - self.recovery_start < path_x.smoothed_rtt.ticks()\n                    && self.recovery_start > connection.ack_sent_time(path_x).ticks()\n                    && self.ssthresh != u64::MAX\n                    && self.cwin < 2 * self.ssthresh\n                {\n                    self.cwin = 2 * self.ssthresh;\n                    self.alg_state = NewRenoAlgState::CongestionAvoidance;\n                }\n            }\n            CongestionNotification::Reset => {\n                self.reset();\n            }\n            CongestionNotification::SeedCwin => {\n                self.seed_cwin(ack_state.nb_bytes_acknowledged);\n            }\n            _ => {}\n        }\n    }\n\n    fn enter_recovery(\n        &mut self,\n        connection: &Connection,\n        path_x: &Path,\n        notification: CongestionNotification,\n        current_time: Instant,\n    ) {\n        self.ssthresh = self.cwin / 2;\n        if self.ssthresh < CWIN_MINIMUM {\n            self.ssthresh = CWIN_MINIMUM;\n        }\n        if notification == CongestionNotification::Timeout {\n            self.cwin = CWIN_MINIMUM;\n            self.alg_state = NewRenoAlgState::SlowStart;\n        } else {\n            self.cwin = self.ssthresh;\n            self.alg_state = NewRenoAlgState::CongestionAvoidance;\n        }\n        self.recovery_start = current_time.ticks();\n        self.recovery_sequence = connection.sequence_number(path_x);\n        self.residual_ack = 0;\n    }\n\n    fn seed_cwin(&mut self, seed_cwin: u64) {\n        if self.alg_state == NewRenoAlgState::SlowStart\n            && self.ssthresh == u64::MAX\n            && seed_cwin > self.cwin\n        {\n            self.cwin = seed_cwin;\n            self.ssthresh = seed_cwin;\n            self.alg_state = NewRenoAlgState::CongestionAvoidance;\n        }\n    }\n}\n\n#[cfg(test)]\nmod test {}\n","numLines":563,"startLine":1,"totalLines":563}}}
