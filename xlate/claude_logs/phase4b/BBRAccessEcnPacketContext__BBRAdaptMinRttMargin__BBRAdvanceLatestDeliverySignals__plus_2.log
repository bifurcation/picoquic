{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01GjYXQQEEswhPGZ2zP71Ewv","type":"tool_result","content":"80\t\n81\t// Re-export the TP shapes from the public crate root for backwards\n82\t// compatibility with callers that already wrote `crate::TransportParameters`.\n83\tpub use tp::{PreferredAddress, TransportParameter, TransportParameters, VersionNegotiation};\n84\t\n85\tuse core::net::SocketAddr;\n86\t\n87\t// ---------------------------------------------------------------------------\n88\t// Version string and error class.\n89\t//\n90\t// Error values come straight from `#define` and would naturally be\n91\t// untyped in C; in Rust we commit to `u64` because the application\n92\t// API takes them as `uint64_t error_code` parameters and returns\n93\t// them in `get_local_error` etc.\n94\t\n95\t/// Library version string.  C: `VERSION`.\n96\tpub const VERSION: &str = \"1.1.48.0\";\n97\t\n98\t/// Crate-level error type for fallible operations.\n99\t///\n100\t/// Phase 4 implementations return specific variants based on the C\n101\t/// control flow.  The initial variant set covers the broad failure\n102\t/// shapes; additional variants may be added as needed.  Marked\n103\t/// `#[non_exhaustive]` so adding\n104\t/// variants later isn't a breaking change.\n105\t#[derive(Debug, Clone, Copy, PartialEq, Eq)]\n106\t#[non_exhaustive]\n107\tpub enum Error {\n108\t    /// Catch-all for C paths that collapse to a generic failure.\n109\t    Generic,\n110\t    /// Allocation failed.\n111\t    Memory,\n112\t    /// Caller supplied an invalid argument.\n113\t    InvalidArgument,\n114\t    /// A buffer the caller supplied was too small.\n115\t    BufferTooSmall,\n116\t    /// Caller-supplied file does not exist.\n117\t    NoSuchFile,\n118\t    /// Caller-supplied file was malformed.\n119\t    InvalidFile,\n120\t    /// Connection has been disconnected.\n121\t    Disconnected,\n122\t    /// Connection state didn't permit the requested operation.\n123\t    InvalidState,\n124\t    /// Operation produced or received a malformed QUIC frame.\n125\t    InvalidFrame,\n126\t    /// TLS / crypto error.\n127\t    Tls,\n128\t    /// Other QUIC protocol error; the wrapped value is the\n129\t    /// numeric `ERROR_*` code defined in this module.\n130\t    Protocol(u64),\n131\t}\n132\t\n133\timpl core::fmt::Display for Error {\n134\t    fn fmt(&self, f: &mut core::fmt::Formatter<'_>) -> core::fmt::Result {\n135\t        write!(f, \"{:?}\", self)\n136\t    }\n137\t}\n138\t\n139\timpl core::error::Error for Error {}\n140\t\n141\t/// Crate-wide `Result` alias defaulting the error type to [`Error`].\n142\tpub type Result<T, E = Error> = core::result::Result<T, E>;\n143\t\n144\t/// Wall-clock instant in microseconds since some application-defined\n145\t/// epoch.  Replaces the C `uint64_t current_time` parameter that\n146\t/// threads through every API call needing \"now\".  The type is\n147\t/// `Copy`, supports arithmetic with [`Duration`], and converts to\n148\t/// `u64` cheaply via `.ticks()` when crossing wire boundaries.\n149\t///\n150\t/// Phase 2 decision: per-call `current_time: Instant` parameters\n151\t/// stay (matches the C source's design — caller decides what time\n152\t/// it is).  No `Clock` trait at the library level; applications\n153\t/// can build a clock-injecting wrapper around the calls if they\n154\t/// want that style.\n155\tpub type Instant = fugit::Instant<u64, 1, 1_000_000>;\n156\t\n157\t/// Duration in microseconds.  Companion to [`Instant`].  Use for\n158\t/// timeouts, RTTs, jitter, etc.  In the C source these are bare\n159\t/// `uint64_t` values labelled by context (`idle_timeout`,\n160\t/// `microsec_latency`, …); the typed alias makes the unit explicit.\n161\tpub type Duration = fugit::Duration<u64, 1, 1_000_000>;\n162\t\n163\t// Error codes (picoquic-internal `ERROR_*` and protocol-defined\n164\t// `TRANSPORT_*` / TLS-alert) live as enums in [`crate::errors`].\n165\tpub use errors::{InternalError, TransportError};\n166\t\n167\t// ---------------------------------------------------------------------------\n168\t// Packet sizes and miscellaneous constants.\n169\t\n170\tpub const MAX_PACKET_SIZE: usize = 1536;\n171\tpub const INITIAL_MTU_IPV4: usize = 1252;\n172\tpub const INITIAL_MTU_IPV6: usize = 1232;\n173\tpub const RESET_SECRET_SIZE: usize = 16;\n174\tpub const RESET_PACKET_PAD_SIZE: usize = 23;\n175\tpub const RESET_PACKET_MIN_SIZE: usize = RESET_PACKET_PAD_SIZE + RESET_SECRET_SIZE;\n176\tpub const MAX_CRYPTO_BUFFER_GAP: usize = 16384;\n177\t\n178\tpub const LOG_PACKET_MAX_SEQUENCE: u32 = 100;\n179\t\n180\t/// First 4 bytes of `SHA256(\"QUIC Masque\")`.  Used as a sentinel\n181\t/// interface index where no real OS interface is meaningful.\n182\tpub const RESERVED_IF_INDEX: u32 = 0x09cb8ed3;\n183\t\n184\t// TLS cipher-suite identifiers (IANA).\n185\tpub const AES_128_GCM_SHA256: u16 = 0x1301;\n186\tpub const AES_256_GCM_SHA384: u16 = 0x1302;\n187\tpub const CHACHA20_POLY1305_SHA256: u16 = 0x1303;\n188\t\n189\tpub const GROUP_SECP256R1: u16 = 23;\n190\t\n191\t// ECN code points for the IP header `tos` byte.\n192\tpub const ECN_ECT_0: u8 = 0x02;\n193\tpub const ECN_ECT_1: u8 = 0x01;\n194\tpub const ECN_CE: u8 = 0x03;\n195\t\n196\t/// C macro `FOURCC(a, b, c, d)`.  Produces a 32-bit code from four\n197\t/// bytes in little-endian order.\n198\tpub const fn fourcc(a: u8, b: u8, c: u8, d: u8) -> u32 {\n199\t    u32::from_le_bytes([a, b, c, d])\n200\t}\n201\t\n202\t// ---------------------------------------------------------------------------\n203\t// Connection state.\n204\t\n205\t/// Connection-state machine, listing the QUIC connection states a\n206\t/// `Connection` walks through from initial handshake to teardown.\n207\t/// Discriminants follow the declaration order of the C `state_enum`.\n208\t#[derive(Debug, Copy, Clone, PartialEq, Eq, PartialOrd, Ord)]\n209\tpub enum State {\n210\t    ClientInit,\n211\t    ClientInitSent,\n212\t    ClientRenegotiate,\n213\t    ClientRetryReceived,\n214\t    ClientInitResent,\n215\t    ServerInit,\n216\t    ServerHandshake,\n217\t    ClientHandshakeStart,\n218\t    HandshakeFailure,\n219\t    HandshakeFailureResend,\n220\t    ClientAlmostReady,\n221\t    ServerFalseStart,\n222\t    ServerAlmostReady,\n223\t    ClientReadyStart,\n224\t    Ready,\n225\t    Disconnecting,\n226\t    ClosingReceived,\n227\t    Closing,\n228\t    Draining,\n229\t    Disconnected,"}]},"parent_tool_use_id":null,"session_id":"336f6a29-aee9-490b-87cc-68086106e801","uuid":"40203461-23ce-4e06-84c3-edcdb6e86f34","timestamp":"2026-05-07T02:56:59.353Z","tool_use_result":{"type":"text","file":{"filePath":"/Users/richbarn/Projects/picoquic/rs/fq/src/lib.rs","content":"\n// Re-export the TP shapes from the public crate root for backwards\n// compatibility with callers that already wrote `crate::TransportParameters`.\npub use tp::{PreferredAddress, TransportParameter, TransportParameters, VersionNegotiation};\n\nuse core::net::SocketAddr;\n\n// ---------------------------------------------------------------------------\n// Version string and error class.\n//\n// Error values come straight from `#define` and would naturally be\n// untyped in C; in Rust we commit to `u64` because the application\n// API takes them as `uint64_t error_code` parameters and returns\n// them in `get_local_error` etc.\n\n/// Library version string.  C: `VERSION`.\npub const VERSION: &str = \"1.1.48.0\";\n\n/// Crate-level error type for fallible operations.\n///\n/// Phase 4 implementations return specific variants based on the C\n/// control flow.  The initial variant set covers the broad failure\n/// shapes; additional variants may be added as needed.  Marked\n/// `#[non_exhaustive]` so adding\n/// variants later isn't a breaking change.\n#[derive(Debug, Clone, Copy, PartialEq, Eq)]\n#[non_exhaustive]\npub enum Error {\n    /// Catch-all for C paths that collapse to a generic failure.\n    Generic,\n    /// Allocation failed.\n    Memory,\n    /// Caller supplied an invalid argument.\n    InvalidArgument,\n    /// A buffer the caller supplied was too small.\n    BufferTooSmall,\n    /// Caller-supplied file does not exist.\n    NoSuchFile,\n    /// Caller-supplied file was malformed.\n    InvalidFile,\n    /// Connection has been disconnected.\n    Disconnected,\n    /// Connection state didn't permit the requested operation.\n    InvalidState,\n    /// Operation produced or received a malformed QUIC frame.\n    InvalidFrame,\n    /// TLS / crypto error.\n    Tls,\n    /// Other QUIC protocol error; the wrapped value is the\n    /// numeric `ERROR_*` code defined in this module.\n    Protocol(u64),\n}\n\nimpl core::fmt::Display for Error {\n    fn fmt(&self, f: &mut core::fmt::Formatter<'_>) -> core::fmt::Result {\n        write!(f, \"{:?}\", self)\n    }\n}\n\nimpl core::error::Error for Error {}\n\n/// Crate-wide `Result` alias defaulting the error type to [`Error`].\npub type Result<T, E = Error> = core::result::Result<T, E>;\n\n/// Wall-clock instant in microseconds since some application-defined\n/// epoch.  Replaces the C `uint64_t current_time` parameter that\n/// threads through every API call needing \"now\".  The type is\n/// `Copy`, supports arithmetic with [`Duration`], and converts to\n/// `u64` cheaply via `.ticks()` when crossing wire boundaries.\n///\n/// Phase 2 decision: per-call `current_time: Instant` parameters\n/// stay (matches the C source's design — caller decides what time\n/// it is).  No `Clock` trait at the library level; applications\n/// can build a clock-injecting wrapper around the calls if they\n/// want that style.\npub type Instant = fugit::Instant<u64, 1, 1_000_000>;\n\n/// Duration in microseconds.  Companion to [`Instant`].  Use for\n/// timeouts, RTTs, jitter, etc.  In the C source these are bare\n/// `uint64_t` values labelled by context (`idle_timeout`,\n/// `microsec_latency`, …); the typed alias makes the unit explicit.\npub type Duration = fugit::Duration<u64, 1, 1_000_000>;\n\n// Error codes (picoquic-internal `ERROR_*` and protocol-defined\n// `TRANSPORT_*` / TLS-alert) live as enums in [`crate::errors`].\npub use errors::{InternalError, TransportError};\n\n// ---------------------------------------------------------------------------\n// Packet sizes and miscellaneous constants.\n\npub const MAX_PACKET_SIZE: usize = 1536;\npub const INITIAL_MTU_IPV4: usize = 1252;\npub const INITIAL_MTU_IPV6: usize = 1232;\npub const RESET_SECRET_SIZE: usize = 16;\npub const RESET_PACKET_PAD_SIZE: usize = 23;\npub const RESET_PACKET_MIN_SIZE: usize = RESET_PACKET_PAD_SIZE + RESET_SECRET_SIZE;\npub const MAX_CRYPTO_BUFFER_GAP: usize = 16384;\n\npub const LOG_PACKET_MAX_SEQUENCE: u32 = 100;\n\n/// First 4 bytes of `SHA256(\"QUIC Masque\")`.  Used as a sentinel\n/// interface index where no real OS interface is meaningful.\npub const RESERVED_IF_INDEX: u32 = 0x09cb8ed3;\n\n// TLS cipher-suite identifiers (IANA).\npub const AES_128_GCM_SHA256: u16 = 0x1301;\npub const AES_256_GCM_SHA384: u16 = 0x1302;\npub const CHACHA20_POLY1305_SHA256: u16 = 0x1303;\n\npub const GROUP_SECP256R1: u16 = 23;\n\n// ECN code points for the IP header `tos` byte.\npub const ECN_ECT_0: u8 = 0x02;\npub const ECN_ECT_1: u8 = 0x01;\npub const ECN_CE: u8 = 0x03;\n\n/// C macro `FOURCC(a, b, c, d)`.  Produces a 32-bit code from four\n/// bytes in little-endian order.\npub const fn fourcc(a: u8, b: u8, c: u8, d: u8) -> u32 {\n    u32::from_le_bytes([a, b, c, d])\n}\n\n// ---------------------------------------------------------------------------\n// Connection state.\n\n/// Connection-state machine, listing the QUIC connection states a\n/// `Connection` walks through from initial handshake to teardown.\n/// Discriminants follow the declaration order of the C `state_enum`.\n#[derive(Debug, Copy, Clone, PartialEq, Eq, PartialOrd, Ord)]\npub enum State {\n    ClientInit,\n    ClientInitSent,\n    ClientRenegotiate,\n    ClientRetryReceived,\n    ClientInitResent,\n    ServerInit,\n    ServerHandshake,\n    ClientHandshakeStart,\n    HandshakeFailure,\n    HandshakeFailureResend,\n    ClientAlmostReady,\n    ServerFalseStart,\n    ServerAlmostReady,\n    ClientReadyStart,\n    Ready,\n    Disconnecting,\n    ClosingReceived,\n    Closing,\n    Draining,\n    Disconnected,","numLines":150,"startLine":80,"totalLines":4038}}}
