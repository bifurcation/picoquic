ght_lo = max(inflight_latest, BBRBeta * bbr_state->inflight_lo) */\n1044\t    bbr_state->inflight_lo = (uint64_t)(BBRBeta * (double)bbr_state->inflight_lo);\n1045\t    if (bbr_state->inflight_lo < bbr_state->inflight_latest) {\n1046\t        bbr_state->inflight_lo = bbr_state->inflight_latest;\n1047\t    }\n1048\t}\n1049\t\n1050\t/* Once per round-trip respond to congestion */\n1051\tstatic void BBRAdaptLowerBoundsFromCongestion(picoquic_bbr_state_t* bbr_state, picoquic_path_t* path_x)\n1052\t{\n1053\t    if (BBRIsProbingBW(bbr_state)) {\n1054\t        return;\n1055\t    }\n1056\t#ifdef RTTJitterBufferAdapt\n1057\t    if (bbr_state->loss_in_round || bbr_state->rtt_too_high_in_round) {\n1058\t#else\n1059\t    if (bbr_state->loss_in_round) {\n1060\t#endif\n1061\t        BBRInitLowerBounds(bbr_state, path_x);\n1062\t        BBRLossLowerBounds(bbr_state);\n1063\t    }\n1064\t}\n1065\t\n1066\t/* Update congestion state on every ACK */\n1067\tstatic void  BBRUpdateCongestionSignals(picoquic_bbr_state_t* bbr_state, picoquic_path_t* path_x, bbr_per_ack_state_t * rs)\n1068\t{\n1069\t    BBRUpdateMaxBw(bbr_state, path_x, rs);\n1070\t    if (rs->newly_lost > 0) {\n1071\t        bbr_state->loss_in_round = 1;\n1072\t    }\n1073\t#ifdef RTTJitterBufferAdapt\n1074\t    if (IsRTTTooHigh(bbr_state)) {\n1075\t        bbr_state->rtt_too_high_in_round = 1;\n1076\t    }\n1077\t#endif\n1078\t    if (!bbr_state->loss_round_start) {\n1079\t        return;  /* wait until end of round trip */\n1080\t    }\n1081\t    BBRAdaptLowerBoundsFromCongestion(bbr_state, path_x);\n1082\t    bbr_state->loss_in_round = 0;\n1083\t#ifdef RTTJitterBufferAdapt\n1084\t    bbr_state->rtt_too_high_in_round = 0;\n1085\t#endif\n1086\t}\n1087\t\n1088\tstatic void BBRResetLowerBounds(picoquic_bbr_state_t* bbr_state)\n1089\t{\n1090\t    bbr_state->bw_lo = UINT64_MAX;\n1091\t    bbr_state->inflight_lo = UINT64_MAX;\n1092\t}\n1093\t        \n1094\tstatic void  BBRBoundBWForModel(picoquic_bbr_state_t* bbr_state) {\n1095\t    /* set bw = min(max_bw, bw_lo, bw_hi)  */\n1096\t    bbr_state->bw = bbr_state->max_bw;\n1097\t    if (bbr_state->bw > bbr_state->bw_lo) {\n1098\t        bbr_state->bw = bbr_state->bw_lo;\n1099\t    }\n1100\t    /* TODO: remove the test bw_hi != 0 once variables properly initialized. */\n1101\t    if (bbr_state->bw > bbr_state->bw_hi && bbr_state->bw_hi != 0) {\n1102\t        bbr_state->bw = bbr_state->bw_hi;\n1103\t    }\n1104\t}\n1105\t\n1106\t\n1107\t/* Path Model functions when probing for bandwidth */\n1108\tstatic void BBRUpdateMaxBw(picoquic_bbr_state_t* bbr_state, picoquic_path_t* path_x, bbr_per_ack_state_t * rs)\n1109\t{\n1110\t    BBRUpdateRound(bbr_state, path_x);\n1111\t\n1112\t    if (rs->delivery_rate >= bbr_state->MaxBwFilter[bbr_state->cycle_count%BBRMaxBwFilterLen] || !rs->is_app_limited) {\n1113\t        bbr_state->max_bw = update_windowed_max_filter(\n1114\t            bbr_state->MaxBwFilter, rs->delivery_rate, bbr_state->cycle_count, BBRMaxBwFilterLen);\n1115\t    }\n1116\t}\n1117\t\n1118\tstatic void BBRAdvanceMaxBwFilter(picoquic_bbr_state_t* bbr_state)\n1119\t{\n1120\t    bbr_state->cycle_count++;\n1121\t    bbr_state->ack_phase = picoquic_bbr_acks_probe_starting;\n1122\t\n1123\t    /* Should the current cycle value be set to zero? Or do we simply rely on the\n1124\t     * natural rythm of updates, keeping the old value if we only see app limited updates?\n1125\t     */\n1126\t    start_windowed_max_filter_period(bbr_state->MaxBwFilter, bbr_state->cycle_count, BBRMaxBwFilterLen);\n1127\t}\n1128\t\n1129\tstatic void BBRUpdateACKAggregation(picoquic_bbr_state_t* bbr_state, picoquic_path_t * path_x, bbr_per_ack_state_t* rs, uint64_t current_time)\n1130\t{\n1131\t    /* Find excess ACKed beyond expected amount over this interval */\n1132\t    uint64_t interval = (current_time - bbr_state->extra_acked_interval_start);\n1133\t    uint64_t expected_delivered = bbr_state->bw * interval;\n1134\t    /* Reset interval if ACK rate is below expected rate: */\n1135\t    if (bbr_state->extra_acked_delivered <= expected_delivered) {\n1136\t        bbr_state->extra_acked_delivered = 0;\n1137\t        bbr_state->extra_acked_interval_start = current_time;\n1138\t        expected_delivered = 0;\n1139\t    }\n1140\t    bbr_state->extra_acked_delivered += rs->newly_acked;\n1141\t    uint64_t extra = bbr_state->extra_acked_delivered - expected_delivered;\n1142\t    if (extra > path_x->cwin) {\n1143\t        extra = path_x->cwin;\n1144\t    }\n1145\t    bbr_state->extra_acked =\n1146\t        update_windowed_max_filter(bbr_state->ExtraACKedFilter, extra, bbr_state->round_count, BBRExtraAckedFilterLen);\n1147\t}\n1148\t\n1149\t/* Do loss signals suggest inflight is too high?\n1150\t* If so, react.\n1151\t* This test can trigger spuriously if there are too few packets in transit.\n1152\t* For example, if there are two packets in transit and one is lost, the\n1153\t* test assumes a loss rate of 50%, but this could be a random event that\n1154\t* happens once every 50 RTT. Decisions made because of that would be wrong.\n1155\t*/\n1156\tstatic int IsInflightTooHigh(picoquic_bbr_state_t* bbr_state, picoquic_path_t * path_x, bbr_per_ack_state_t* rs)\n1157\t{\n1158\t    if (rs->ecn_alpha > BBRExcessiveEcnCE) {\n1159\t        return 1;\n1160\t    }\n1161\t    else {\n1162\t        uint64_t rs_delivered = path_x->delivered - rs->delivered;\n1163\t        if (rs_delivered > bbr_state->recovery_delivered &&\n1164\t            rs->lost > (uint64_t)(((double)rs->tx_in_flight) * BBRLossThresh) &&\n1165\t            rs->lost > 3 * path_x->send_mtu) {\n1166\t            return 1;\n1167\t        }\n1168\t        else {\n1169\t            return 0;\n1170\t        }\n1171\t    }\n1172\t}\n1173\t\n1174\tstatic void BBRHandleInflightTooHigh(picoquic_bbr_state_t* bbr_state, picoquic_path_t * path_x, bbr_per_ack_state_t* rs, uint64_t current_time)\n1175\t{\n1176\t    /* The computation below compares the number of bytes in flight when the \n1177\t     * acked packet was sent to the current target */\n1178\t    bbr_state->bw_probe_samples = 0;  /* only react once per bw probe */\n1179\t    if (!rs->is_app_limited) {\n1180\t        uint64_t beta_target = (uint64_t)(((double)BBRTargetInflight(bbr_state, path_x)) * BBRBeta);\n1181\t        bbr_state->inflight_hi = (rs->tx_in_flight > beta_target) ? rs->tx_in_flight : beta_target;\n1182\t    }\n1183\t    if(bbr_state->state == picoquic_bbr_alg_probe_bw_up) {\n1184\t        BBRStartProbeBW_DOWN(bbr_state, path_x, current_time);\n1185\t    }\n1186\t}\n1187\t\n1188\tstatic int CheckInflightTooHigh(picoquic_bbr_state_t* bbr_state, picoquic_path_t* path_x, bbr_per_ack_state_t* rs, uint64_t current_time)\n1189\t{\n1190\t    if (IsInflightTooHigh(bbr_state, path_x, rs))\n1191\t    {\n1192\t        if (bbr_state->bw_probe_samples)\n1193\t        {\n1194\t            BBRHandleInflightTooHigh(bbr_state, path_x, rs, current_time);\n1195\t        }\n1196\t        return 1;  /* inflight too high */\n1197\t    }\n1198\t    else {\n1199\t        return 0;\n1200\t    }\n1201\t}\n1202\t\n1203\t/* BBR Round counting functions */\n1204\tstatic void BBRInitRoundCounting(picoquic_bbr_state_t* bbr_state, picoquic_path_t* path_x)\n1205\t{\n1206\t    bbr_state->next_round_delivered = 0;\n1207\t    bbr_state->round_start = 0;\n1208\t    bbr_state->round_count = 0;\n1209\t    bbr_state->round_start_pn = picoquic_cc_get_sequence_number(path_x->cnx, path_x);\n1210\t}\n1211\t\n1212\tstatic void BBRStartRound(picoquic_bbr_state_t* bbr_state, picoquic_path_t* path_x)\n1213\t{\n1214\t    bbr_state->round_start_pn = picoquic_cc_get_sequence_number(path_x->cnx, path_x);\n1215\t\n1216\t    bbr_state->next_round_delivered = path_x->delivered;\n1217\t}\n1218\t\n1219\tstatic void BBRUpdateRound(picoquic_bbr_state_t* bbr_state, picoquic_path_t * path_x)\n1220\t{\n1221\t    if (picoquic_cc_get_ack_number(path_x->cnx, path_x) >= bbr_state->round_start_pn) {\n1222\t        BBRStartRound(bbr_state, path_x);\n1223\t        bbr_state->round_count++;\n1224\t        bbr_state->rounds_since_probe++;\n1225\t        bbr_state->round_start = 1;\n1226\t        start_windowed_max_filter_period(bbr_state->ExtraACKedFilter, bbr_state->round_count, BBRExtraAckedFilterLen);\n1227\t    }\n1228\t    else {\n1229\t        bbr_state->round_start = 0;\n1230\t    }\n1231\t}\n1232\t\n1233\t\n1234\t/* End of BBR round counting functions */\n1235\t\n1236\t/* Restart from idle process\n1237\t* TODO: add a congestion callback \"restart from idle\" if sending a packet\n1238\t* after a long silence. The tests should be done in the transport loop. This\n1239\t* will need to be handled in their own way by all agorithms, and thus cannot\n1240\t* be implemented in this PR.\n1241\t* The required call back is mentioned in section 4.1. of RFC 5681,\n1242\t* Restarting Idle Connections. This is defined for TCP, but should\n1243\t* apply equally to a QUIC path. the text says \"Therefore, a TCP SHOULD\n1244\t* set cwnd to no more than RW before beginning transmission if the TCP\n1245\t* has not sent data in an interval exceeding the retransmission timeout.\"\n1246\t* For QUIC, this perhaps should be qualified as \"as not sent ack-eliciting data\".\n1247\t* The idle test checks \"no bytes in transit\"; this imply the callback\n1248\t* should happen before updating \"bytes in transit\" for the new packet.\n1249\t */\n1250\t#if 0\n1251\tstatic void BBRHandleRestartFromIdle(picoquic_bbr_state_t* bbr_state, picoquic_path_t * path_x, uint64_t current_time)\n1252\t{\n1253\t    if (path_x->bytes_in_transit == 0 && bbr_state->path_is_app_limited)\n1254\t    {\n1255\t        bbr_state->idle_restart = 1;\n1256\t        bbr_state->extra_acked_interval_start = current_time;\n1257\t        if (IsInAProbeBWState(bbr_state)) {\n1258\t            BBRSetPacingRateWithGain(bbr_state, 1);\n1259\t        }\n1260\t        else if (bbr_state->state == picoquic_bbr_alg_probe_rtt) {\n1261\t            BBRCheckProbeRTTDone(bbr_state, current_time);\n1262\t        }\n1263\t    }\n1264\t}\n1265\t\n1266\t\n1267\t/* TODO: check definition of app limited. Why is it expressed here?\n1268\t* The name should really be, check whether transmission has started.\n1269\t* It is used to differentiate \"started and then idle\" from \"has not\n1270\t* sent anything yet.\"\n1271\t */\n1272\tstatic void MarkConnectionAppLimited(picoquic_bbr_state_t* bbr_state)\n1273\t{\n1274\t    bbr_state->path_is_app_limited =\n1275\t        (C.delivered + packets_in_flight) ?  0 : 1;\n1276\t}\n1277\t\n1278\t\n1279\t/* Called when the app has sent something. */\n1280\tvoid BBROnTransmit(picoquic_bbr_state_t* bbr_state, picoquic_path_t* path_x, uint64_t current_time)\n1281\t{\n1282\t    BBRHandleRestartFromIdle(bbr_state, path_x, current_time);\n1283\t}\n1284\t#endif\n1285\t/* End of idle functions */\n1286\t\n1287\t/* ProbeRTT processes for BBv3 */\n1288\t\n1289\t/* Adapt RTT min margin based on packet transmission time */\n1290\tstatic void BBRAdaptMinRttMargin(picoquic_bbr_state_t* bbr_state, picoquic_path_t* path_x)\n1291\t{\n1292\t    uint64_t margin = ((bbr_state->min_rtt * BBRMinRttMarginPercent) * 100 / 1000000);\n1293\t    if (bbr_state->max_bw > 0) {\n1294\t        margin += 2 * path_x->send_mtu * 1000000 / bbr_state->max_bw;\n1295\t    }\n1296\t    bbr_state->min_rtt_margin = margin;\n1297\t}\n1298\t\n1299\t#ifdef RTTJitterBuffer\n1300\tstatic void BBRUpdateRTTJitterBuffer(picoquic_bbr_state_t* bbr_state, bbr_per_ack_state_t * rs, uint64_t current_time)\n1301\t{\n1302\t    if (current_time > bbr_state->last_rtt_sample_stamp + 1000) {\n1303\t        bbr_state->rtt_jitter_buffer[bbr_state->rtt_jitter_cycle % BBRRTTJitterBufferLen] = rs->rtt_sample;\n1304\t        bbr_state->rtt_jitter_cycle++;\n1305\t        bbr_state->last_rtt_sample_stamp = current_time;\n1306\t        bbr_state->rtt_short_term_min = UINT64_MAX;\n1307\t        bbr_state->rtt_short_term_max = 0;\n1308\t        for (unsigned int i = 0; i < BBRRTTJitterBufferLen; i++) {\n1309\t            if (i >= bbr_state->rtt_jitter_cycle) {"}]},"parent_tool_use_id":null,"session_id":"336f6a29-aee9-490b-87cc-68086106e801","uuid":"23000fbd-9a95-4f13-8ab9-16828f89666d","timestamp":"2026-05-07T02:56:20.565Z","tool_use_result":{"type":"text","file":{"filePath":"/Users/richbarn/Projects/picoquic/picoquic/bbr.c","content":"    else {\n        /* Enter loss recovery if new losses */\n        if (IsInflightTooHigh(bbr_state, path_x, rs)) {\n            BBROnEnterFastRecovery(bbr_state, path_x, rs);\n        }\n    }\n}\n\n/* Computing the congestion window */\nstatic uint64_t BBRBDPMultipleWithBw(picoquic_bbr_state_t* bbr_state, picoquic_path_t* path_x, double gain, uint64_t bw)\n{\n    if (bbr_state->min_rtt == UINT64_MAX) {\n        return PICOQUIC_CWIN_INITIAL*path_x->send_mtu; /* no valid RTT samples yet */\n    }\n    bbr_state->bdp = PICOQUIC_BYTES_FROM_RATE(bbr_state->min_rtt, bw);\n    return (uint64_t)(gain * (double)bbr_state->bdp);\n}\n\nstatic uint64_t BBRBDPMultiple(picoquic_bbr_state_t* bbr_state, picoquic_path_t* path_x, double gain)\n{\n    return BBRBDPMultipleWithBw(bbr_state, path_x, gain, bbr_state->bw);\n}\n\nstatic void BBRUpdateOffloadBudget(picoquic_bbr_state_t* bbr_state)\n{\n    bbr_state->offload_budget = 3 * bbr_state->send_quantum;\n}\n\nstatic uint64_t BBRQuantizationBudget(picoquic_bbr_state_t* bbr_state, picoquic_path_t* path_x, uint64_t inflight)\n{\n    BBRUpdateOffloadBudget(bbr_state);\n    if (inflight < bbr_state->offload_budget) {\n        inflight = bbr_state->offload_budget;\n    }\n    if (inflight < BBRMinPipeCwnd * path_x->send_mtu) {\n        inflight = BBRMinPipeCwnd * path_x->send_mtu;\n    }\n    if (bbr_state->state == picoquic_bbr_alg_probe_bw_up) {\n        inflight += 2*path_x->send_mtu;\n    }\n    return inflight;\n}\n\nstatic uint64_t BBRInflightWithBw(picoquic_bbr_state_t* bbr_state, picoquic_path_t* path_x, double gain, uint64_t bw)\n{\n    uint64_t inflight = BBRBDPMultipleWithBw(bbr_state, path_x, gain, bw);\n    return BBRQuantizationBudget(bbr_state, path_x, inflight);\n}\n\nstatic uint64_t BBRInflight(picoquic_bbr_state_t* bbr_state, picoquic_path_t* path_x, double gain)\n{\n    return BBRInflightWithBw(bbr_state, path_x, gain, bbr_state->bw);\n}\n\nstatic void BBRUpdateMaxInflight(picoquic_bbr_state_t* bbr_state, picoquic_path_t* path_x)\n{\n    /*  The draft mentions here a call to BBRUpdateAggregationBudget(),\n    * but does not define that function. Its purpose is apparently to set\n    * `extra_acked`, but that variable is computed in\n    * BBRUpdateACKAggregation(), which is called as part of \n    * BBRUpdateModelAndState(). There is probably no need to do an extra\n    * call here. */\n    uint64_t inflight = BBRBDPMultiple(bbr_state, path_x, bbr_state->cwnd_gain);\n\n    inflight += bbr_state->extra_acked;\n\n    if (bbr_state->min_rtt < bbr_state->wifi_shadow_rtt && bbr_state->min_rtt > 0){\n        inflight = (uint64_t)(((double)inflight) * ((double)bbr_state->wifi_shadow_rtt) / ((double)bbr_state->min_rtt));\n    }\n    bbr_state->max_inflight = BBRQuantizationBudget(bbr_state, path_x, inflight);\n}\n\n/* Pacing rate functions */\nstatic void BBRInitPacingRate(picoquic_bbr_state_t* bbr_state, picoquic_path_t* path_x)\n{\n    /* nominal_bandwidth = InitialCwnd / (SRTT ? SRTT : 1ms); */\n    uint64_t initial_rtt = PICOQUIC_INITIAL_RTT; /* 1ms */\n    if (path_x->smoothed_rtt != PICOQUIC_INITIAL_RTT || path_x->rtt_variant != 0) {\n        initial_rtt = path_x->smoothed_rtt;\n    }\n    double nominal_bandwidth = ((double)(1000000ull * PICOQUIC_CWIN_INITIAL)) / (double)initial_rtt;\n    bbr_state->pacing_rate = BBRStartupPacingGain * nominal_bandwidth;\n}\n\nstatic void BBRSetPacingRateWithGain(picoquic_bbr_state_t* bbr_state, double pacing_gain)\n{\n    double rate = pacing_gain * ((double)(bbr_state->bw * (100 - BBRPacingMarginPercent))) / (double)100;\n\n    if (bbr_state->state == picoquic_bbr_alg_startup_resume &&\n        !bbr_state->filled_pipe &&\n        bbr_state->bdp_seed > 0) {\n        double bdp_rate = (((double)bbr_state->bdp_seed*1000000.0) / (double)bbr_state->min_rtt);\n        if (bdp_rate > rate) {\n            rate = bdp_rate;\n        }\n    }\n\n    if (bbr_state->filled_pipe || rate > bbr_state->pacing_rate) {\n        bbr_state->pacing_rate = rate;\n    }\n}\n\nstatic void  BBRSetPacingRate(picoquic_bbr_state_t* bbr_state)\n{\n    BBRSetPacingRateWithGain(bbr_state, bbr_state->pacing_gain);\n}\n\nstatic void BBRSetSendQuantum(picoquic_bbr_state_t* bbr_state, picoquic_path_t* path_x)\n{\n    /* 1.2 Mbps = 150 kBps = 150000Bps  */\n    uint64_t floor = 2 * path_x->send_mtu;\n    if (bbr_state->pacing_rate < 150000) {\n        floor = 1 * path_x->send_mtu;\n    }\n    /* 1 ms = 1000000us/1000 */\n    bbr_state->send_quantum = (uint64_t)(bbr_state->pacing_rate * bbr_state->quantum_ratio); \n    if (bbr_state->send_quantum > 0x10000) {\n        bbr_state->send_quantum = 0x10000;\n    }\n    if (bbr_state->send_quantum < floor) {\n        bbr_state->send_quantum = floor;\n    }\n}\n\n\n/* Path model functions when not probing for bandwith */\n  /* Near start of ACK processing: */\nstatic void BBRUpdateLatestDeliverySignals(picoquic_bbr_state_t* bbr_state, picoquic_path_t* path_x, bbr_per_ack_state_t * rs)\n{\n    /* BBR.bw_latest = max(BBR.bw_latest, rs.delivery_rate) */\n    bbr_state->loss_round_start = 0;\n    if (bbr_state->bw_latest < rs->delivery_rate) {\n        bbr_state->bw_latest = rs->delivery_rate;\n    }\n    /* BBR.inflight_latest = max(BBR.inflight_latest, rs.delivered) */\n    if (bbr_state->inflight_latest < rs->delivered) {\n        bbr_state->inflight_latest = rs->delivered;\n    }\n    \n    uint64_t prior_delivered = path_x->delivered - rs->delivered;\n    if (prior_delivered >= bbr_state->loss_round_delivered) {\n        bbr_state->loss_round_delivered = path_x->delivered;\n        bbr_state->loss_round_start = 1;\n    }\n}\n\n  /* Near end of ACK processing: */\nstatic void BBRAdvanceLatestDeliverySignals(picoquic_bbr_state_t* bbr_state, bbr_per_ack_state_t * rs) {\n    if (bbr_state->loss_round_start) {\n        bbr_state->bw_latest = rs->delivery_rate;\n        bbr_state->inflight_latest = rs->delivered;\n    }\n}\n\nstatic void BBRResetCongestionSignals(picoquic_bbr_state_t* bbr_state)\n{\n    bbr_state->loss_in_round = 0;\n#ifdef RTTJitterBuffer\n    bbr_state->rtt_too_high_in_round = 0;\n#endif\n    bbr_state->bw_latest = 0;\n    bbr_state->inflight_latest = 0;\n}\n\n/* Handle the first congestion episode in this cycle */\nstatic void BBRInitLowerBounds(picoquic_bbr_state_t* bbr_state, picoquic_path_t* path_x)\n{\n    if (bbr_state->bw_lo == UINT64_MAX) {\n        bbr_state->bw_lo = bbr_state->max_bw;\n    }\n    if (bbr_state->inflight_lo == UINT64_MAX) {\n        bbr_state->inflight_lo = path_x->cwin;\n    }\n}\n\n/* Adjust model once per round based on loss */\nstatic void BBRLossLowerBounds(picoquic_bbr_state_t* bbr_state)\n{\n    /* set: bw_lo = max(bw_latest, bw_lo*BBRBeta) */\n    bbr_state->bw_lo = (uint64_t)(BBRBeta * (double)bbr_state->bw_lo);\n    if (bbr_state->bw_lo < bbr_state->bw_latest) {\n        bbr_state->bw_lo = bbr_state->bw_latest;\n    }\n    /* Set: inflight_lo = max(inflight_latest, BBRBeta * bbr_state->inflight_lo) */\n    bbr_state->inflight_lo = (uint64_t)(BBRBeta * (double)bbr_state->inflight_lo);\n    if (bbr_state->inflight_lo < bbr_state->inflight_latest) {\n        bbr_state->inflight_lo = bbr_state->inflight_latest;\n    }\n}\n\n/* Once per round-trip respond to congestion */\nstatic void BBRAdaptLowerBoundsFromCongestion(picoquic_bbr_state_t* bbr_state, picoquic_path_t* path_x)\n{\n    if (BBRIsProbingBW(bbr_state)) {\n        return;\n    }\n#ifdef RTTJitterBufferAdapt\n    if (bbr_state->loss_in_round || bbr_state->rtt_too_high_in_round) {\n#else\n    if (bbr_state->loss_in_round) {\n#endif\n        BBRInitLowerBounds(bbr_state, path_x);\n        BBRLossLowerBounds(bbr_state);\n    }\n}\n\n/* Update congestion state on every ACK */\nstatic void  BBRUpdateCongestionSignals(picoquic_bbr_state_t* bbr_state, picoquic_path_t* path_x, bbr_per_ack_state_t * rs)\n{\n    BBRUpdateMaxBw(bbr_state, path_x, rs);\n    if (rs->newly_lost > 0) {\n        bbr_state->loss_in_round = 1;\n    }\n#ifdef RTTJitterBufferAdapt\n    if (IsRTTTooHigh(bbr_state)) {\n        bbr_state->rtt_too_high_in_round = 1;\n    }\n#endif\n    if (!bbr_state->loss_round_start) {\n        return;  /* wait until end of round trip */\n    }\n    BBRAdaptLowerBoundsFromCongestion(bbr_state, path_x);\n    bbr_state->loss_in_round = 0;\n#ifdef RTTJitterBufferAdapt\n    bbr_state->rtt_too_high_in_round = 0;\n#endif\n}\n\nstatic void BBRResetLowerBounds(picoquic_bbr_state_t* bbr_state)\n{\n    bbr_state->bw_lo = UINT64_MAX;\n    bbr_state->inflight_lo = UINT64_MAX;\n}\n        \nstatic void  BBRBoundBWForModel(picoquic_bbr_state_t* bbr_state) {\n    /* set bw = min(max_bw, bw_lo, bw_hi)  */\n    bbr_state->bw = bbr_state->max_bw;\n    if (bbr_state->bw > bbr_state->bw_lo) {\n        bbr_state->bw = bbr_state->bw_lo;\n    }\n    /* TODO: remove the test bw_hi != 0 once variables properly initialized. */\n    if (bbr_state->bw > bbr_state->bw_hi && bbr_state->bw_hi != 0) {\n        bbr_state->bw = bbr_state->bw_hi;\n    }\n}\n\n\n/* Path Model functions when probing for bandwidth */\nstatic void BBRUpdateMaxBw(picoquic_bbr_state_t* bbr_state, picoquic_path_t* path_x, bbr_per_ack_state_t * rs)\n{\n    BBRUpdateRound(bbr_state, path_x);\n\n    if (rs->delivery_rate >= bbr_state->MaxBwFilter[bbr_state->cycle_count%BBRMaxBwFilterLen] || !rs->is_app_limited) {\n        bbr_state->max_bw = update_windowed_max_filter(\n            bbr_state->MaxBwFilter, rs->delivery_rate, bbr_state->cycle_count, BBRMaxBwFilterLen);\n    }\n}\n\nstatic void BBRAdvanceMaxBwFilter(picoquic_bbr_state_t* bbr_state)\n{\n    bbr_state->cycle_count++;\n    bbr_state->ack_phase = picoquic_bbr_acks_probe_starting;\n\n    /* Should the current cycle value be set to zero? Or do we simply rely on the\n     * natural rythm of updates, keeping the old value if we only see app limited updates?\n     */\n    start_windowed_max_filter_period(bbr_state->MaxBwFilter, bbr_state->cycle_count, BBRMaxBwFilterLen);\n}\n\nstatic void BBRUpdateACKAggregation(picoquic_bbr_state_t* bbr_state, picoquic_path_t * path_x, bbr_per_ack_state_t* rs, uint64_t current_time)\n{\n    /* Find excess ACKed beyond expected amount over this interval */\n    uint64_t interval = (current_time - bbr_state->extra_acked_interval_start);\n    uint64_t expected_delivered = bbr_state->bw * interval;\n    /* Reset interval if ACK rate is below expected rate: */\n    if (bbr_state->extra_acked_delivered <= expected_delivered) {\n        bbr_state->extra_acked_delivered = 0;\n        bbr_state->extra_acked_interval_start = current_time;\n        expected_delivered = 0;\n    }\n    bbr_state->extra_acked_delivered += rs->newly_acked;\n    uint64_t extra = bbr_state->extra_acked_delivered - expected_delivered;\n    if (extra > path_x->cwin) {\n        extra = path_x->cwin;\n    }\n    bbr_state->extra_acked =\n        update_windowed_max_filter(bbr_state->ExtraACKedFilter, extra, bbr_state->round_count, BBRExtraAckedFilterLen);\n}\n\n/* Do loss signals suggest inflight is too high?\n* If so, react.\n* This test can trigger spuriously if there are too few packets in transit.\n* For example, if there are two packets in transit and one is lost, the\n* test assumes a loss rate of 50%, but this could be a random event that\n* happens once every 50 RTT. Decisions made because of that would be wrong.\n*/\nstatic int IsInflightTooHigh(picoquic_bbr_state_t* bbr_state, picoquic_path_t * path_x, bbr_per_ack_state_t* rs)\n{\n    if (rs->ecn_alpha > BBRExcessiveEcnCE) {\n        return 1;\n    }\n    else {\n        uint64_t rs_delivered = path_x->delivered - rs->delivered;\n        if (rs_delivered > bbr_state->rec