{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01UwN3TeSceA2SvayjxWL6dH","type":"tool_result","content":"150\tpub const CWIN_MINIMUM: u64 = 2 * MAX_PACKET_SIZE as u64;\n151\t\n152\tpub const DEFAULT_CRYPTO_EPOCH_LENGTH: u64 = 1 << 22;\n153\t\n154\tpub const DEFAULT_SIMULTANEOUS_LOGS: u32 = 32;\n155\tpub const DEFAULT_HALF_OPEN_RETRY_THRESHOLD: u32 = 64;\n156\t\n157\tpub const PN_RANDOM_MIN: u32 = 0xffff;\n158\tpub const PN_RANDOM_RANGE: u32 = 0x10000;\n159\t\n160\tpub const SPIN_RESERVE_MOD_256: u8 = 17;\n161\t\n162\tpub const CHALLENGE_REPEAT_MAX: usize = 3;\n163\t\n164\tpub const ALPN_NUMBER_MAX: usize = 32;\n165\t\n166\tpub const CC_ALGO_NUMBER_NEW_RENO: u8 = 1;\n167\tpub const CC_ALGO_NUMBER_CUBIC: u8 = 2;\n168\tpub const CC_ALGO_NUMBER_DCUBIC: u8 = 3;\n169\tpub const CC_ALGO_NUMBER_FAST: u8 = 4;\n170\tpub const CC_ALGO_NUMBER_BBR: u8 = 5;\n171\tpub const CC_ALGO_NUMBER_PRAGUE: u8 = 6;\n172\tpub const CC_ALGO_NUMBER_BBR1: u8 = 7;\n173\t\n174\tpub const MAX_ACK_RANGE_REPEAT: usize = 4;\n175\tpub const MIN_ACK_RANGE_REPEAT: usize = 2;\n176\t\n177\tpub const DEFAULT_HOLE_PERIOD: u64 = 256;\n178\t\n179\tpub const LOSS_BIT_Q_HALF_PERIOD: u64 = 64;\n180\t\n181\tpub const NUMBER_OF_EPOCHS: usize = 4;\n182\tpub const NUMBER_OF_EPOCH_OFFSETS: usize = NUMBER_OF_EPOCHS + 1;\n183\t\n184\tpub use crate::tp::NB_TP_0RTT;\n185\t\n186\tfn fill_system_random(bytes: &mut [u8]) -> crate::Result<()> {\n187\t    std::fs::File::open(\"/dev/urandom\")\n188\t        .and_then(|mut file| file.read_exact(bytes))\n189\t        .map_err(|_| crate::Error::Generic)\n190\t}\n191\t\n192\t// ---------------------------------------------------------------------------\n193\t// Range / bitfield helper macros.\n194\t\n195\t/// `IN_RANGE(v, min, max)` — true when `min ≤ v ≤ max`\n196\t/// under the C macro's bitfield assumption (`min & max == min`,\n197\t/// `min & bits == 0`, `max & bits == bits`).\n198\t#[inline]\n199\tpub const fn in_range(v: u64, min: u64, max: u64) -> bool {\n200\t    (v & !(min ^ max)) == min\n201\t}\n202\t\n203\t/// `BITS_SET_IN_RANGE(v, min, max, bits)`.\n204\t#[inline]\n205\tpub const fn bits_set_in_range(v: u64, min: u64, max: u64, bits: u64) -> bool {\n206\t    (v & !(min ^ max ^ bits)) == (min ^ bits)\n207\t}\n208\t\n209\t/// `BITS_CLEAR_IN_RANGE(v, min, max, bits)`.\n210\t#[inline]\n211\tpub const fn bits_clear_in_range(v: u64, min: u64, max: u64, bits: u64) -> bool {\n212\t    (v & !(min ^ max ^ bits)) == min\n213\t}\n214\t\n215\t// ---------------------------------------------------------------------------\n216\t// Frame types.\n217\t\n218\t// `FrameType` lives in [`crate::frames`].\n219\t\n220\t// ---------------------------------------------------------------------------\n221\t// PMTU discovery requirement status.\n222\t\n223\t#[derive(Debug, Copy, Clone, PartialEq, Eq, Default)]\n224\t#[repr(u8)]\n225\tpub enum PmtuDiscoveryStatus {\n226\t    #[default]\n227\t    NotNeeded = 0,\n228\t    Optional,\n229\t    Required,\n230\t}\n231\t\n232\t// ---------------------------------------------------------------------------\n233\t// Supported QUIC versions.\n234\t\n235\t/// QUIC version codes recognised by this build.  Wire values are the\n236\t/// `u32` `Initial` packet version field; `TryFrom<u32>` converts an\n237\t/// arbitrary wire value to a [`Version`] (or fails when the version\n238\t/// isn't recognised).\n239\t#[derive(Debug, Copy, Clone, PartialEq, Eq)]\n240\t#[repr(u32)]\n241\tpub enum Version {\n242\t    SeventeenthInterop = 0xFF00001B,\n243\t    EighteenthInterop = 0xFF00001C,\n244\t    NineteenthInterop = 0xFF00001D,\n245\t    NineteenthBisInterop = 0xFF00001E,\n246\t    TwentiethPreInterop = 0xFF00001F,\n247\t    TwentiethInterop = 0xFF000020,\n248\t    TwentyFirstInterop = 0xFF000021,\n249\t    PostIesg = 0xFF000022,\n250\t    V1 = 0x00000001,\n251\t    V2 = 0x6b3343cf,\n252\t    V2Draft = 0x709a50c4,\n253\t    InternalTest1 = 0x50435130,\n254\t    InternalTest2 = 0x50435131,\n255\t}\n256\t\n257\t/// First entry in `Version`'s declaration order — the canonical\n258\t/// interop version reported by `INTEROP_VERSION_LATEST` in C.\n259\tpub const INTEROP_VERSION_LATEST: Version = Version::NineteenthInterop;\n260\t\n261\timpl Version {\n262\t    /// Resolve `proposed` to a known [`Version`] (RFC 9000 §15\n263\t    /// \"Versions\").  C: `get_version_index`.\n264\t    pub fn try_from_wire(proposed: u32) -> Option<Self> {\n265\t        match proposed {\n266\t            0x00000001 => Some(Version::V1),\n267\t            0x6b3343cf => Some(Version::V2),\n268\t            0x709a50c4 => Some(Version::V2Draft),\n269\t            0xFF00001B => Some(Version::SeventeenthInterop),\n270\t            0xFF00001C => Some(Version::EighteenthInterop),\n271\t            0xFF00001D => Some(Version::NineteenthInterop),\n272\t            0xFF00001E => Some(Version::NineteenthBisInterop),\n273\t            0xFF00001F => Some(Version::TwentiethPreInterop),\n274\t            0xFF000020 => Some(Version::TwentiethInterop),\n275\t            0xFF000021 => Some(Version::TwentyFirstInterop),\n276\t            0xFF000022 => Some(Version::PostIesg),\n277\t            0x50435130 => Some(Version::InternalTest1),\n278\t            0x50435131 => Some(Version::InternalTest2),\n279\t            _ => None,\n280\t        }\n281\t    }\n282\t\n283\t    /// Per-version cryptographic and label parameters.  C:\n284\t    /// `picoquic_supported_versions[]`'s row for this version.\n285\t    pub fn parameters(self) -> VersionParameters {\n286\t        const V1_SALT: &[u8] = &[\n287\t            0x38, 0x76, 0x2c, 0xf7, 0xf5, 0x59, 0x34, 0xb3, 0x4d, 0x17, 0x9a, 0xe6, 0xa4, 0xc8,\n288\t            0x0c, 0xad, 0xcc, 0xbb, 0x7f, 0x0a,\n289\t        ];\n290\t        const V1_RETRY_KEY: &[u8] = &[\n291\t            0xd9, 0xc9, 0x94, 0x3e, 0x61, 0x01, 0xfd, 0x20, 0x00, 0x21, 0x50, 0x6b, 0xcc, 0x02,\n292\t            0x81, 0x4c, 0x73, 0x03, 0x0f, 0x25, 0xc7, 0x9d, 0x71, 0xce, 0x87, 0x6e, 0xca, 0x87,\n293\t            0x6e, 0x6f, 0xca, 0x8e,\n294\t        ];\n295\t        const V2_SALT: &[u8] = &[\n296\t            0x0d, 0xed, 0xe3, 0xde, 0xf7, 0x00, 0xa6, 0xdb, 0x81, 0x93, 0x81, 0xbe, 0x6e, 0x26,\n297\t            0x9d, 0xcb, 0xf9, 0xbd, 0x2e, 0xd9,\n298\t        ];\n299\t        const V2_RETRY_KEY: &[u8] = &[\n300\t            0xc4, 0xdd, 0x24, 0x84, 0xd6, 0x81, 0xae, 0xfa, 0x4f, 0xf4, 0xd6, 0x9c, 0x2c, 0x20,\n301\t            0x29, 0x99, 0x84, 0xa7, 0x65, 0xa5, 0xd3, 0xc3, 0x19, 0x82, 0xf3, 0x8f, 0xc7, 0x41,\n302\t            0x62, 0x15, 0x5e, 0x9f,\n303\t        ];\n304\t        const V2_DRAFT_SALT: &[u8] = &[\n305\t            0xa7, 0x07, 0xc2, 0x03, 0xa5, 0x9b, 0x47, 0x18, 0x4a, 0x1d, 0x62, 0xca, 0x57, 0x04,\n306\t            0x06, 0xea, 0x7a, 0xe3, 0xe5, 0xd3,\n307\t        ];\n308\t        const V2_DRAFT_RETRY_KEY: &[u8] = &[\n309\t            0x34, 0x25, 0xc2, 0x0c, 0xf8, 0x87, 0x79, 0xdf, 0x2f, 0xf7, 0x1e, 0x8a, 0xbf, 0xa7,\n310\t            0x82, 0x49, 0x89, 0x1e, 0x76, 0x3b, 0xbe, 0xd2, 0xf1, 0x3c, 0x04, 0x83, 0x43, 0xd3,\n311\t            0x48, 0xc0, 0x60, 0xe2,\n312\t        ];\n313\t        const DRAFT_29_SALT: &[u8] = &[\n314\t            0xaf, 0xbf, 0xec, 0x28, 0x99, 0x93, 0xd2, 0x4c, 0x9e, 0x97, 0x86, 0xf1, 0x9c, 0x61,\n315\t            0x11, 0xe0, 0x43, 0x90, 0xa8, 0x99,\n316\t        ];\n317\t        const RETRY_KEY_29: &[u8] = &[\n318\t            0x8b, 0x0d, 0x37, 0xeb, 0x85, 0x35, 0x02, 0x2e, 0xbc, 0x8d, 0x76, 0xa2, 0x07, 0xd8,\n319\t            0x0d, 0xf2, 0x26, 0x46, 0xec, 0x06, 0xdc, 0x80, 0x96, 0x42, 0xc3, 0x0a, 0x8b, 0xaa,\n320\t            0x2b, 0xaa, 0xff, 0x4c,\n321\t        ];\n322\t        const INTERNAL_TEST_1_SALT: &[u8] = &[\n323\t            0x30, 0x67, 0x16, 0xd7, 0x63, 0x75, 0xd5, 0x55, 0x4b, 0x2f, 0x60, 0x5e, 0xef, 0x78,\n324\t            0xd8, 0x33, 0x3d, 0xc1, 0xca, 0x36,\n325\t        ];\n326\t\n327\t        const V1_PREFIX: &str = \"tls13 quic \";\n328\t        const V2_PREFIX: &str = \"tls13 quicv2 \";\n329\t        const V1_KU: &str = \"quic ku\";\n330\t        const V2_KU: &str = \"quicv2 ku\";\n331\t\n332\t        const UPGRADE_FROM_V1: &[Version] = &[Version::V1];\n333\t\n334\t        match self {\n335\t            Version::V1 => VersionParameters {\n336\t                version: self,\n337\t                version_aead_key: V1_SALT,\n338\t                version_retry_key: V1_RETRY_KEY,\n339\t                tls_prefix_label: V1_PREFIX,\n340\t                tls_traffic_update_label: V1_KU,\n341\t                packet_type_version: 0x0000_0001,\n342\t                upgrade_from: &[],\n343\t            },\n344\t            Version::V2 => VersionParameters {\n345\t                version: self,\n346\t                version_aead_key: V2_SALT,\n347\t                version_retry_key: V2_RETRY_KEY,\n348\t                tls_prefix_label: V2_PREFIX,\n349\t                tls_traffic_update_label: V2_KU,\n350\t                packet_type_version: 0x6b33_43cf,\n351\t                upgrade_from: UPGRADE_FROM_V1,\n352\t            },\n353\t            Version::V2Draft => VersionParameters {\n354\t                version: self,\n355\t                version_aead_key: V2_DRAFT_SALT,\n356\t                version_retry_key: V2_DRAFT_RETRY_KEY,\n357\t                tls_prefix_label: V2_PREFIX,\n358\t                tls_traffic_update_label: V2_KU,\n359\t                packet_type_version: 0x6b33_43cf,\n360\t                upgrade_from: UPGRADE_FROM_V1,\n361\t            },\n362\t            Version::PostIesg | Version::TwentyFirstInterop => VersionParameters {\n363\t                version: self,\n364\t                version_aead_key: V1_SALT,\n365\t                version_retry_key: V1_RETRY_KEY,\n366\t                tls_prefix_label: V1_PREFIX,\n367\t                tls_traffic_update_label: V1_KU,\n368\t                packet_type_version: 0x0000_0001,\n369\t                upgrade_from: &[],\n370\t            },\n371\t            Version::TwentiethInterop\n372\t            | Version::T