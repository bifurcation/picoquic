thBw(bbr_state, path_x, gain, bw);\n906\t    return BBRQuantizationBudget(bbr_state, path_x, inflight);\n907\t}\n908\t\n909\tstatic uint64_t BBRInflight(picoquic_bbr_state_t* bbr_state, picoquic_path_t* path_x, double gain)\n910\t{\n911\t    return BBRInflightWithBw(bbr_state, path_x, gain, bbr_state->bw);\n912\t}\n913\t\n914\tstatic void BBRUpdateMaxInflight(picoquic_bbr_state_t* bbr_state, picoquic_path_t* path_x)\n915\t{\n916\t    /*  The draft mentions here a call to BBRUpdateAggregationBudget(),\n917\t    * but does not define that function. Its purpose is apparently to set\n918\t    * `extra_acked`, but that variable is computed in\n919\t    * BBRUpdateACKAggregation(), which is called as part of \n920\t    * BBRUpdateModelAndState(). There is probably no need to do an extra\n921\t    * call here. */\n922\t    uint64_t inflight = BBRBDPMultiple(bbr_state, path_x, bbr_state->cwnd_gain);\n923\t\n924\t    inflight += bbr_state->extra_acked;\n925\t\n926\t    if (bbr_state->min_rtt < bbr_state->wifi_shadow_rtt && bbr_state->min_rtt > 0){\n927\t        inflight = (uint64_t)(((double)inflight) * ((double)bbr_state->wifi_shadow_rtt) / ((double)bbr_state->min_rtt));\n928\t    }\n929\t    bbr_state->max_inflight = BBRQuantizationBudget(bbr_state, path_x, inflight);\n930\t}\n931\t\n932\t/* Pacing rate functions */\n933\tstatic void BBRInitPacingRate(picoquic_bbr_state_t* bbr_state, picoquic_path_t* path_x)\n934\t{\n935\t    /* nominal_bandwidth = InitialCwnd / (SRTT ? SRTT : 1ms); */\n936\t    uint64_t initial_rtt = PICOQUIC_INITIAL_RTT; /* 1ms */\n937\t    if (path_x->smoothed_rtt != PICOQUIC_INITIAL_RTT || path_x->rtt_variant != 0) {\n938\t        initial_rtt = path_x->smoothed_rtt;\n939\t    }\n940\t    double nominal_bandwidth = ((double)(1000000ull * PICOQUIC_CWIN_INITIAL)) / (double)initial_rtt;\n941\t    bbr_state->pacing_rate = BBRStartupPacingGain * nominal_bandwidth;\n942\t}\n943\t\n944\tstatic void BBRSetPacingRateWithGain(picoquic_bbr_state_t* bbr_state, double pacing_gain)\n945\t{\n946\t    double rate = pacing_gain * ((double)(bbr_state->bw * (100 - BBRPacingMarginPercent))) / (double)100;\n947\t\n948\t    if (bbr_state->state == picoquic_bbr_alg_startup_resume &&\n949\t        !bbr_state->filled_pipe &&\n950\t        bbr_state->bdp_seed > 0) {\n951\t        double bdp_rate = (((double)bbr_state->bdp_seed*1000000.0) / (double)bbr_state->min_rtt);\n952\t        if (bdp_rate > rate) {\n953\t            rate = bdp_rate;\n954\t        }\n955\t    }\n956\t\n957\t    if (bbr_state->filled_pipe || rate > bbr_state->pacing_rate) {\n958\t        bbr_state->pacing_rate = rate;\n959\t    }\n960\t}\n961\t\n962\tstatic void  BBRSetPacingRate(picoquic_bbr_state_t* bbr_state)\n963\t{\n964\t    BBRSetPacingRateWithGain(bbr_state, bbr_state->pacing_gain);\n965\t}\n966\t\n967\tstatic void BBRSetSendQuantum(picoquic_bbr_state_t* bbr_state, picoquic_path_t* path_x)\n968\t{\n969\t    /* 1.2 Mbps = 150 kBps = 150000Bps  */\n970\t    uint64_t floor = 2 * path_x->send_mtu;\n971\t    if (bbr_state->pacing_rate < 150000) {\n972\t        floor = 1 * path_x->send_mtu;\n973\t    }\n974\t    /* 1 ms = 1000000us/1000 */\n975\t    bbr_state->send_quantum = (uint64_t)(bbr_state->pacing_rate * bbr_state->quantum_ratio); \n976\t    if (bbr_state->send_quantum > 0x10000) {\n977\t        bbr_state->send_quantum = 0x10000;\n978\t    }\n979\t    if (bbr_state->send_quantum < floor) {\n980\t        bbr_state->send_quantum = floor;\n981\t    }\n982\t}\n983\t\n984\t\n985\t/* Path model functions when not probing for bandwith */\n986\t  /* Near start of ACK processing: */\n987\tstatic void BBRUpdateLatestDeliverySignals(picoquic_bbr_state_t* bbr_state, picoquic_path_t* path_x, bbr_per_ack_state_t * rs)\n988\t{\n989\t    /* BBR.bw_latest = max(BBR.bw_latest, rs.delivery_rate) */\n990\t    bbr_state->loss_round_start = 0;\n991\t    if (bbr_state->bw_latest < rs->delivery_rate) {\n992\t        bbr_state->bw_latest = rs->delivery_rate;\n993\t    }\n994\t    /* BBR