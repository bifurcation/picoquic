{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_017NcKe4HMVzEJYiQ95mtkYA","type":"tool_result","content":"1150\t* If so, react.\n1151\t* This test can trigger spuriously if there are too few packets in transit.\n1152\t* For example, if there are two packets in transit and one is lost, the\n1153\t* test assumes a loss rate of 50%, but this could be a random event that\n1154\t* happens once every 50 RTT. Decisions made because of that would be wrong.\n1155\t*/\n1156\tstatic int IsInflightTooHigh(picoquic_bbr_state_t* bbr_state, picoquic_path_t * path_x, bbr_per_ack_state_t* rs)\n1157\t{\n1158\t    if (rs->ecn_alpha > BBRExcessiveEcnCE) {\n1159\t        return 1;\n1160\t    }\n1161\t    else {\n1162\t        uint64_t rs_delivered = path_x->delivered - rs->delivered;\n1163\t        if (rs_delivered > bbr_state->recovery_delivered &&\n1164\t            rs->lost > (uint64_t)(((double)rs->tx_in_flight) * BBRLossThresh) &&\n1165\t            rs->lost > 3 * path_x->send_mtu) {\n1166\t            return 1;\n1167\t        }\n1168\t        else {\n1169\t            return 0;\n1170\t        }\n1171\t    }\n1172\t}\n1173\t\n1174\tstatic void BBRHandleInflightTooHigh(picoquic_bbr_state_t* bbr_state, picoquic_path_t * path_x, bbr_per_ack_state_t* rs, uint64_t current_time)\n1175\t{\n1176\t    /* The computation below compares the number of bytes in flight when the \n1177\t     * acked packet was sent to the current target */\n1178\t    bbr_state->bw_probe_samples = 0;  /* only react once per bw probe */\n1179\t    if (!rs->is_app_limited) {\n1180\t        uint64_t beta_target = (uint64_t)(((double)BBRTargetInflight(bbr_state, path_x)) * BBRBeta);\n1181\t        bbr_state->inflight_hi = (rs->tx_in_flight > beta_target) ? rs->tx_in_flight : beta_target;\n1182\t    }\n1183\t    if(bbr_state->state == picoquic_bbr_alg_probe_bw_up) {\n1184\t        BBRStartProbeBW_DOWN(bbr_state, path_x, current_time);\n1185\t    }\n1186\t}\n1187\t\n1188\tstatic int CheckInflightTooHigh(picoquic_bbr_state_t* bbr_state, picoquic_path_t* path_x, bbr_per_ack_state_t* rs, uint64_t current_time)\n1189\t{\n1190\t    if (IsInflightTooHigh(bbr_state, path_x, rs))\n1191\t    {\n1192\t        if (bbr_state->bw_probe_samples)\n1193\t        {\n1194\t            BBRHandleInflightTooHigh(bbr_state, path_x, rs, current_time);\n1195\t        }\n1196\t        return 1;  /* inflight too high */\n1197\t    }\n1198\t    else {\n1199\t        return 0;"}]},"parent_tool_use_id":null,"session_id":"da743372-a94e-4c3a-8252-a357471bf140","uuid":"b1c3bcd6-1c2b-4d1c-978c-b31b26470fcc","timestamp":"2026-05-07T10:12:56.271Z","tool_use_result":{"type":"text","file":{"filePath":"/Users/richbarn/Projects/picoquic/picoquic/bbr.c","content":"* If so, react.\n* This test can trigger spuriously if there are too few packets in transit.\n* For example, if there are two packets in transit and one is lost, the\n* test assumes a loss rate of 50%, but this could be a random event that\n* happens once every 50 RTT. Decisions made because of that would be wrong.\n*/\nstatic int IsInflightTooHigh(picoquic_bbr_state_t* bbr_state, picoquic_path_t * path_x, bbr_per_ack_state_t* rs)\n{\n    if (rs->ecn_alpha > BBRExcessiveEcnCE) {\n        return 1;\n    }\n    else {\n        uint64_t rs_delivered = path_x->delivered - rs->delivered;\n        if (rs_delivered > bbr_state->recovery_delivered &&\n            rs->lost > (uint64_t)(((double)rs->tx_in_flight) * BBRLossThresh) &&\n            rs->lost > 3 * path_x->send_mtu) {\n            return 1;\n        }\n        else {\n            return 0;\n        }\n    }\n}\n\nstatic void BBRHandleInflightTooHigh(picoquic_bbr_state_t* bbr_state, picoquic_path_t * path_x, bbr_per_ack_state_t* rs, uint64_t current_time)\n{\n    /* The computation below compares the number of bytes in flight when the \n     * acked packet was sent to the current target */\n    bbr_state->bw_probe_samples = 0;  /* only react once per bw probe */\n    if (!rs->is_app_limited) {\n        uint64_t beta_target = (uint64_t)(((double)BBRTargetInflight(bbr_state, path_x)) * BBRBeta);\n        bbr_state->inflight_hi = (rs->tx_in_flight > beta_target) ? rs->tx_in_flight : beta_target;\n    }\n    if(bbr_state->state == picoquic_bbr_alg_probe_bw_up) {\n        BBRStartProbeBW_DOWN(bbr_state, path_x, current_time);\n    }\n}\n\nstatic int CheckInflightTooHigh(picoquic_bbr_state_t* bbr_state, picoquic_path_t* path_x, bbr_per_ack_state_t* rs, uint64_t current_time)\n{\n    if (IsInflightTooHigh(bbr_state, path_x, rs))\n    {\n        if (bbr_state->bw_probe_samples)\n        {\n            BBRHandleInflightTooHigh(bbr_state, path_x, rs, current_time);\n        }\n        return 1;  /* inflight too high */\n    }\n    else {\n        return 0;","numLines":50,"startLine":1150,"totalLines":2486}}}
