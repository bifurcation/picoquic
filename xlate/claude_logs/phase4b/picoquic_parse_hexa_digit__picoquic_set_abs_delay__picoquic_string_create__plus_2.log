{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01757hdJk6srkYZQHhtPjHdX","type":"tool_result","content":"699\t    }\n700\t\n701\t    /// C: `BBRUpdateOffloadBudget` (picoquic/bbr.c:883)\n702\t    ///\n703\t    /// Set `offload_budget` to three times the current send quantum.  The\n704\t    /// offload budget reserves headroom for segmentation-offload bursts so\n705\t    /// the cwnd computation never starves TSO/GSO paths.\n706\t    pub fn update_offload_budget(&mut self) {\n707\t        self.offload_budget = 3 * self.send_quantum;\n708\t    }\n709\t\n710\t    /// C: `BBRUpdateRTTJitterBuffer` (picoquic/bbr.c:1299)\n711\t    ///\n712\t    /// Record a new RTT sample in the circular jitter buffer when at least\n713\t    /// 1 ms has elapsed since the last entry.  After inserting, recompute\n714\t    /// `rtt_short_term_min` and `rtt_short_term_max` from all valid entries\n715\t    /// so far (up to `BBR_RTT_JITTER_BUFFER_LEN`).\n716\t    pub fn update_rtt_jitter_buffer(&mut self, rs: &BbrPerAckState, current_time: u64) {\n717\t        if current_time > self.last_rtt_sample_stamp + 1000 {\n718\t            let idx = (self.rtt_jitter_cycle as usize) % BBR_RTT_JITTER_BUFFER_LEN;\n719\t            self.rtt_jitter_buffer[idx] = rs.rtt_sample;\n720\t            self.rtt_jitter_cycle += 1;\n721\t            self.last_rtt_sample_stamp = current_time;\n722\t            self.rtt_short_term_min = u64::MAX;\n723\t            self.rtt_short_term_max = 0;\n724\t            let valid = (self.rtt_jitter_cycle as usize).min(BBR_RTT_JITTER_BUFFER_LEN);\n725\t            for i in 0..valid {\n726\t                let sample = self.rtt_jitter_buffer[i];\n727\t                if sample > self.rtt_short_term_max {\n728\t                    self.rtt_short_term_max = sample;\n729\t                }\n730\t                if sample < self.rtt_short_term_min {\n731\t                    self.rtt_short_term_min = sample;\n732\t                }\n733\t            }\n734\t        }\n735\t    }\n736\t\n737\t    /// C: `BBRUpdateRecoveryOnLoss` (picoquic/bbr.c:2206)\n738\t    ///\n739\t    /// During PTO recovery, reduce `cwin` by `newly_lost` bytes, floored at\n740\t    /// two MTUs.  Only applies when at least one retransmit has occurred and\n741\t    /// we are in PTO (not fast) recovery.\n742\t    pub fn update_recovery_on_loss(&self, path_x: &mut Path, newly_lost: u64) {\n743\t        if path_x.nb_retransmit >= 1\n744\t            && self.is_in_recovery\n745\t            && self.is_pto_recovery\n746\t            && path_x.cwin > newly_lost\n747\t        {\n748\t            path_x.cwin -= newly_lost;\n749\t            let floor = 2 * path_x.send_mtu as u64;\n750\t            if path_x.cwin < floor {\n751\t                path_x.cwin = floor;\n752\t            }\n753\t        }\n754\t    }\n755\t\n756\t    /// C: `BBRSetOptions` (picoquic/bbr.c:460)\n757\t    ///\n758\t    /// Parse `option_string` to configure experimental flags and numeric\n759\t    /// parameters.  `BBRExperiment` is always enabled in this build, so all\n760\t    /// experiment flags default to `true` before any option disables them.\n761\t    ///\n762\t    /// Single-letter flags (toggle off the corresponding experiment):\n763\t    /// `E` `R` `H` `L` `D` `A`.  Complex options terminated by a value:\n764\t    /// `T<us>` → `wifi_shadow_rtt`, `Q<float>` → `quantum_ratio`.\n765\t    pub fn set_options(&mut self) {\n766\t        // BBRExperiment is always on.\n767\t        self.exp_flags.do_early_exit = true;\n768\t        self.exp_flags.do_rapid_start = true;\n769\t        self.exp_flags.do_handle_suspension = true;\n770\t        self.exp_flags.do_control_lost = true;\n771\t        self.exp_flags.do_exit_probe_bw_up_on_delay = true;\n772\t        self.exp_flags.do_enter_probe_bw_after_limited = true;\n773\t\n774\t        let s = match self.option_string.clone() {\n775\t            Some(s) => s,\n776\t            None => return,\n777\t        };\n778\t        let mut chars = s.chars().peekable();\n779\t        while let Some(c) = chars.next() {\n780\t            match c {\n781\t                'E' => self.exp_flags.do_early_exit = false,\n782\t                'R' => self.exp_flags.do_rapid_start = false,\n783\t                'H' => self.exp_flags.do_handle_suspension = false,\n784\t                'L' => self.exp_flags.do_control_lost = false,\n785\t                'D' => self.exp_flags.do_exit_probe_bw_up_on_delay = false,\n786\t                'A' => self.exp_flags.do_enter_probe_bw_after_limited = false,\n787\t                'T' => {\n788\t                    let mut u: u64 = 0;\n789\t                    while let Some(&d) = chars.peek() {\n790\t                        if d.is_ascii_digit() {\n791\t                            u = u * 10 + (d as u64 - b'0' as u64);\n792\t                            chars.next();\n793\t                        } else {\n794\t                            break;\n795\t                        }\n796\t                    }\n797\t                    self.wifi_shadow_rtt = u;\n798\t                }\n799\t                'Q' => {\n800\t                    let mut d: f64 = 0.0;\n801\t                    let mut div: f64 = 1.0;\n802\t                    let mut dotted = false;\n803\t                    while let Some(&ch) = chars.peek() {\n804\t                        if ch.is_ascii_digit() {\n805\t                            if !dotted {\n806\t                                d = d * 10.0 + (ch as u8 - b'0') as f64;\n807\t                            } else {\n808\t                                div /= 10.0;\n809\t                                d += div * (ch as u8 - b'0') as f64;\n810\t                            }\n811\t                            chars.next();\n812\t                        } else if ch == '.' {\n813\t                            if dotted {\n814\t                                break;\n815\t                            }\n816\t                            dotted = true;\n817\t     