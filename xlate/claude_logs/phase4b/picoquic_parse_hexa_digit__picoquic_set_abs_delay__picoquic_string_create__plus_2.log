{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01XVk1X8gEiv8cvsskU7a7Mz","type":"tool_result","content":"374\t\n375\t/* Windowed max filter.\n376\t* Several parts of the BBR algorithm use \"filters\":\n377\t* MaxBwFilter[BBRMaxBwFilterLen]: max delivery rate during the last two cycles.\n378\t* In the simple case, the value is updated at the end of the cycle (?)\n379\t */\n380\t\n381\tuint64_t update_windowed_max_filter(uint64_t* filter, uint64_t v, unsigned int cycle, unsigned int filterLen)\n382\t{\n383\t    if (filter[cycle % filterLen] < v) {\n384\t        filter[cycle % filterLen] = v;\n385\t    }\n386\t    for (unsigned int i = 0; i < filterLen; i++) {\n387\t        if (filter[i] > v) {\n388\t            v = filter[i];\n389\t        }\n390\t    }\n391\t    return v;\n392\t}\n393\t\n394\tvoid start_windowed_max_filter_period(uint64_t* filter, unsigned int cycle, unsigned int filterLen)\n395\t{\n396\t    filter[cycle % filterLen] = 0;\n397\t}\n398\t\n399\tuint64_t update_windowed_min_filter(uint64_t* filter, uint64_t v, unsigned int cycle, unsigned int filterLen)\n400\t{\n401\t    filter[cycle % filterLen] = v;\n402\t    for (unsigned int i = 0; i < filterLen; i++) {\n403\t        if (filter[i] < v) {\n404\t            v = filter[i];\n405\t        }\n406\t    }\n407\t    return v;\n408\t}\n409\t\n410\t\n411\t/* Init per connection random state.\n412\t* Should be initialized to a constant when running in test, to\n413\t* something unique when running in production. We do that by\n414\t* mixing:\n415\t* - the \"current time\", which is constant in tests but varies in production,\n416\t* - the connection type, 1 for client, 0 for server, so that even in tests\n417\t*   server and clients use different seeds,\n418\t* - the path unique number, so that different paths will use different seeds,\n419\t*   even in tests.\n420\t*/\n421\tstatic void BBRInitRandom(picoquic_bbr_state_t* bbr_state, picoquic_path_t* path_x, uint64_t current_time)\n422\t{\n423\t    uint64_t random_context = 0xfedcba9876543210ull;\n424\t    random_context ^= current_time;\n425\t    if (path_x->cnx->client_mode) {\n426\t        random_context += 0x0123456789abcdefull;\n427\t    }\n428\t    if (path_x->unique_path_id > 0 && path_x->unique_path_id != UINT64_MAX) {\n429\t        random_context *= (path_x->unique_path_id + 1);\n430\t    }\n431\t    bbr_state->random_context = random_context;\n432\t}\n433\t"}]},"parent_tool_use_id":null,"session_id":"da743372-a94e-4c3a-8252-a357471bf140","uuid":"537dcae3-461b-4d28-bd13-01e6779853de","timestamp":"2026-05-07T10:13:37.165Z","tool_use_result":{"type":"text","file":{"filePath":"/Users/richbarn/Projects/picoquic/picoquic/bbr.c","content":"\n/* Windowed max filter.\n* Several parts of the BBR algorithm use \"filters\":\n* MaxBwFilter[BBRMaxBwFilterLen]: max delivery rate during the last two cycles.\n* In the simple case, the value is updated at the end of the cycle (?)\n */\n\nuint64_t update_windowed_max_filter(uint64_t* filter, uint64_t v, unsigned int cycle, unsigned int filterLen)\n{\n    if (filter[cycle % filterLen] < v) {\n        filter[cycle % filterLen] = v;\n    }\n    for (unsigned int i = 0; i < filterLen; i++) {\n        if (filter[i] > v) {\n            v = filter[i];\n        }\n    }\n    return v;\n}\n\nvoid start_windowed_max_filter_period(uint64_t* filter, unsigned int cycle, unsigned int filterLen)\n{\n    filter[cycle % filterLen] = 0;\n}\n\nuint64_t update_windowed_min_filter(uint64_t* filter, uint64_t v, unsigned int cycle, unsigned int filterLen)\n{\n    filter[cycle % filterLen] = v;\n    for (unsigned int i = 0; i < filterLen; i++) {\n        if (filter[i] < v) {\n            v = filter[i];\n        }\n    }\n    return v;\n}\n\n\n/* Init per connection random state.\n* Should be initialized to a constant when running in test, to\n* something unique when running in production. We do that by\n* mixing:\n* - the \"current time\", which is constant in tests but varies in production,\n* - the connection type, 1 for client, 0 for server, so that even in tests\n*   server and clients use different seeds,\n* - the path unique number, so that different paths will use different seeds,\n*   even in tests.\n*/\nstatic void BBRInitRandom(picoquic_bbr_state_t* bbr_state, picoquic_path_t* path_x, uint64_t current_time)\n{\n    uint64_t random_context = 0xfedcba9876543210ull;\n    random_context ^= current_time;\n    if (path_x->cnx->client_mode) {\n        random_context += 0x0123456789abcdefull;\n    }\n    if (path_x->unique_path_id > 0 && path_x->unique_path_id != UINT64_MAX) {\n        random_context *= (path_x->unique_path_id + 1);\n    }\n    bbr_state->random_context = random_context;\n}\n","numLines":60,"startLine":374,"totalLines":2486}}}
