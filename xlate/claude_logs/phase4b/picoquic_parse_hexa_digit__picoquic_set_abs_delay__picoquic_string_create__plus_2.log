e_t* bbr_state)\n1533\t{\n1534\t    picoquic_bbr_alg_state_t state = bbr_state->state;\n1535\t\n1536\t    return (state == picoquic_bbr_alg_probe_bw_down ||\n1537\t        state == picoquic_bbr_alg_probe_bw_cruise ||\n1538\t        state == picoquic_bbr_alg_drain ||\n1539\t        state == picoquic_bbr_alg_probe_rtt) ? 0 : 1;\n1540\t}\n1541\t\n1542\t/* \n1543\t* Return a volume of data that tries to leave free\n1544\t* headroom in the bottleneck buffer or link for\n1545\t* other flows, for fairness convergence and lower\n1546\t* RTTs and loss */\n1547\tstatic uint64_t BBRInflightWithHeadroom(picoquic_bbr_state_t* bbr_state, picoquic_path_t * path_x)\n1548\t{\n1549\t    if (bbr_state->inflight_hi == UINT64_MAX) {\n1550\t        return UINT64_MAX;\n1551\t    }\n1552\t\n1553\t    /* This diverges from draft-bbr-02, but is correct per feedback from BBR authors. */\n1554\t    uint64_t inflight_with_headroom = (uint64_t)((1.0-BBRHeadroom) * ((double)bbr_state->inflight_hi));\n1555\t    if (inflight_with_headroom < (BBRMinPipeCwnd*path_x->send_mtu)) {\n1556\t        inflight_with_headroom = BBRMinPipeCwnd*path_x->send_mtu;\n1557\t    }\n1558\t    return inflight_with_headroom;\n1559\t}\n1560\t\n1561\t/* Raise inflight_hi slope if appropriate. */\n1562\tstatic void BBRRaiseInflightHiSlope(picoquic_bbr_state_t* bbr_state, picoquic_path_t * path_x)\n1563\t{\n1564\t    uint64_t growth_this_round = path_x->send_mtu << bbr_state->bw_probe_up_rounds;\n1565\t    bbr_state->bw_probe_up_rounds = (bbr_state->bw_probe_up_rounds + 1 < 30) ? bbr_state->bw_probe_up_rounds + 1 : 30;\n1566\t    uint32_t up_cnt = (uint32_t)(path_x->cwin / growth_this_round);\n1567\t    bbr_state->bw_probe_up_cnt = (up_cnt > 1) ? up_cnt : 1;\n1568\t}\n1569\t\n1570\t/* Increase inflight_hi if appropriate. */\n1571\tstatic void BBRProbeInflightHiUpward(picoquic_bbr_state_t* bbr_state, picoquic_path_t * path_x, bbr_per_ack_state_t * rs)\n1572\t{\n1573\t    if (!rs->is_cwnd_limited || path_x->cwin < bbr_state->i