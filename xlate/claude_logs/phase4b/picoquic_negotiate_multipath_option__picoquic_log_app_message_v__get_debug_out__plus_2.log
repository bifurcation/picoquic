{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01S8yPdkzffd6RD4UieuWri2","type":"tool_result","content":"70\t// \"if a logging type is documented, all three functions for that\n71\t// type shall be documented as well\" by convention; the trait\n72\t// requirement makes that explicit.\n73\t//\n74\t// Method names drop the `log_` prefix from the C function-pointer\n75\t// typedefs since the trait name already conveys \"logging\".\n76\t\n77\t/// One installable logging backend.  Each method emits one record\n78\t/// of the named kind into whatever sink the backend owns (text\n79\t/// file, binary trace, qlog).\n80\tpub trait Logger {\n81\t    /// Emit a free-form application message routed by a connection-id\n82\t    /// hint rather than a live `Connection` handle.  C:\n83\t    /// `picoquic_log_quic_app_message_fn`.\n84\t    fn quic_app_message(\n85\t        &mut self,\n86\t        quic: &mut Quic,\n87\t        cid: &ConnectionId,\n88\t        args: core::fmt::Arguments<'_>,\n89\t    );\n90\t\n91\t    /// Emit a context-level UDP-datagram arrival or departure for\n92\t    /// an unknown connection.  C: `picoquic_log_quic_pdu_fn`.\n93\t    fn quic_pdu(\n94\t        &mut self,\n95\t        quic: &mut Quic,\n96\t        receiving: bool,\n97\t        current_time: Instant,\n98\t        cid64: u64,\n99\t        addr_peer: &SocketAddr,\n100\t        addr_local: &SocketAddr,\n101\t        packet_length: usize,\n102\t    );\n103\t\n104\t    /// Release any QUIC-context-level resource the backend owns\n105\t    /// (file handles, qlog buffers, …).  Invoked at context\n106\t    /// teardown.  C: `picoquic_log_quic_close`.\n107\t    fn quic_close(&mut self, quic: &mut Quic);\n108\t\n109\t    /// Emit a free-form application message attached to a live\n110\t    /// connection.  C: `picoquic_log_app_message_fn` — the `va_list`\n111\t    /// flavour collapses to [`core::fmt::Arguments`].\n112\t    fn app_message(&mut self, connection: &mut Connection, args: core::fmt::Arguments<'_>);\n113\t\n114\t    /// Emit a per-connection UDP-datagram arrival or departure\n115\t    /// record.  C: `picoquic_log_pdu_fn`.\n116\t    fn pdu(\n117\t        &mut self,\n118\t        connection: &mut Connection,\n119\t        receiving: bool,\n120\t        current_time: Instant,\n121\t        addr_peer: &SocketAddr,\n122\t        addr_local: &SocketAddr,\n123\t        packet_length: usize,\n124\t        unique_path_id: u64,\n125\t        ecn: u8,\n126\t    );\n127\t\n128\t    /// Emit a decrypted-packet record.  `receiving == true` for\n129\t    /// arrivals.  C: `picoquic_log_packet_fn`.\n130\t    fn packet(\n131\t        &mut self,\n132\t        connection: &mut Connection,\n133\t        path_x: Option<&mut Path>,\n134\t        receiving: bool,\n135\t        current_time: Instant,\n136\t        ph: &PacketHeader,\n137\t        bytes: &[u8],\n138\t    );\n139\t\n140\t    /// Emit a record that the packet was dropped due to some error.\n141\t    /// C: `picoquic_log_dropped_packet_fn`.\n142\t    fn dropped_packet(\n143\t        &mut self,\n144\t        connection: &mut Connection,\n145\t        path_x: Option<&mut Path>,\n146\t        ph: &PacketHeader,\n147\t        packet_size: usize,\n148\t        err: i32,\n149\t        current_time: Instant,\n150\t    );\n151\t\n152\t    /// Emit a record that the packet was buffered waiting for\n153\t    /// decryption.  C: `picoquic_log_buffered_packet_fn`.\n154\t    fn buffered_packet(\n155\t        &mut self,\n156\t        connection: &mut Connection,\n157\t        path_x: &mut Path,\n158\t        ptype: PacketType,\n159\t        current_time: Instant,\n160\t    );\n161\t\n162\t    /// Emit a record that a packet was formatted, ready to be sent.\n163\t    /// `bytes` is the unencrypted form (length carried in the\n164\t    /// slice); `send_buffer` is the encrypted-and-padded wire form.\n165\t    /// `pn_length` is the length of the packet-number field within\n166\t    /// `bytes`.  C: `picoquic