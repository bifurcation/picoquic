l spin bit variant\n46\t */\n47\t\n48\tvoid picoquic_spinbit_null_incoming(picoquic_cnx_t* UNUSED(cnx), picoquic_path_t* UNUSED(path_x), picoquic_packet_header* UNUSED(ph))\n49\t{\n50\t    UNREFERENCED_PARAMETER(cnx);\n51\t    UNREFERENCED_PARAMETER(path_x);\n52\t    UNREFERENCED_PARAMETER(ph);\n53\t}\n54\t\n55\tuint8_t picoquic_spinbit_null_outgoing(picoquic_cnx_t* UNUSED(cnx))\n56\t{\n57\t    UNREFERENCED_PARAMETER(cnx);\n58\t    return 0;\n59\t}\n60\t\n61\t/*\n62\t * Two procedures defining the null spin bit randomized variant\n63\t */\n64\t\n65\tvoid picoquic_spinbit_random_incoming(picoquic_cnx_t* UNUSED(cnx), picoquic_path_t* UNUSED(path_x), picoquic_packet_header* UNUSED(ph))\n66\t{\n67\t    UNREFERENCED_PARAMETER(cnx);\n68\t    UNREFERENCED_PARAMETER(path_x);\n69\t    UNREFERENCED_PARAMETER(ph);\n70\t}\n71\t\n72\tuint8_t picoquic_spinbit_random_outgoing(picoquic_cnx_t* UNUSED(cnx))\n73\t{\n74\t    UNREFERENCED_PARAMETER(cnx);\n75\t    return (uint8_t) (picoquic_public_random_64()&0x20);\n76\t}\n77\t\n78\t/*\n79\t * Table of spin bit functions\n80\t */\n81\tpicoquic_spinbit_def_t picoquic_spin_function_table[] = {\n82\t    {picoquic_spinbit_basic_incoming, picoquic_spinbit_basic_outgoing},\n83\t    {picoquic_spinbit_random_incoming, picoquic_spinbit_random_outgoing},\n84\t\t{picoquic_spinbit_null_incoming, picoquic_spinbit_null_outgoing}\n85\t};\n86\t"}]},"parent_tool_use_id":null,"session_id":"c078a458-8d27-4b1b-b12a-e775d28f8c36","uuid":"5a23734d-1826-41c8-bbe4-964ab5eab39b","timestamp":"2026-05-07T09:32:39.730Z","tool_use_result":{"type":"text","file":{"filePath":"/Users/richbarn/Projects/picoquic/picoquic/spinbit.c","content":"/*\n* Author: Christian Huitema\n* Copyright (c) 2018, Private Octopus, Inc.\n* All rights reserved.\n*\n* Permission to use, copy, modify, and distribute this software for any\n* purpose with or without fee is hereby granted, provided that the above\n* copyright notice and this permission notice appear in all copies.\n*\n* THIS SOFTWARE IS PROVIDED BY THE COPYRIGHT HOLDERS AND CONTRIBUTORS \"AS IS\" AND\n* ANY EXPRESS OR IMPLIED WARRANTIES, INCLUDING, BUT NOT LIMITED TO, THE IMPLIED\n* WARRANTIES OF MERCHANTABILITY AND FITNESS FOR A PARTICULAR PURPOSE ARE\n* DISCLAIMED. IN NO EVENT SHALL Private Octopus, Inc. BE LIABLE FOR ANY\n* DIRECT, INDIRECT, INCIDENTAL, SPECIAL, EXEMPLARY, OR CONSEQUENTIAL DAMAGES\n* (INCLUDING, BUT NOT LIMITED TO, PROCUREMENT OF SUBSTITUTE GOODS OR SERVICES;\n* LOSS OF USE, DATA, OR PROFITS; OR BUSINESS INTERRUPTION) HOWEVER CAUSED AND\n* ON ANY THEORY OF LIABILITY, WHETHER IN CONTRACT, STRICT LIABILITY, OR TORT\n* (INCLUDING NEGLIGENCE OR OTHERWISE) ARISING IN ANY WAY OUT OF THE USE OF THIS\n* SOFTWARE, EVEN IF ADVISED OF THE POSSIBILITY OF SUCH DAMAGE.\n*/\n\n#include \"picoquic_internal.h\"\n#include \"tls_api.h\"\n\n#ifndef UNREFERENCED_PARAMETER\n#define UNREFERENCED_PARAMETER(x) (void)(x)\n#endif\n\n/*\n * Two procedures defining the spin bit basic variant \n */\nvoid picoquic_spinbit_basic_incoming(picoquic_cnx_t * cnx, picoquic_path_t * path_x, picoquic_packet_header * ph)\n{\n    path_x->current_spin = ph->spin ^ cnx->client_mode;\n}\n\nuint8_t picoquic_spinbit_basic_outgoing(picoquic_cnx_t * cnx)\n{\n    uint8_t spin_bit = (uint8_t)((cnx->path[0]->current_spin) << 5);\n\n    return spin_bit;\n}\n\n/*\n * Two procedures defining the null spin bit variant\n */\n\nvoid picoquic_spinbit_null_incoming(picoquic_cnx_t* UNUSED(cnx), picoquic_path_t* UNUSED(path_x), picoquic_packet_header* UNUSED(ph))\n{\n    UNREFERENCED_PARAMETER(cnx);\n    UNREFERENCED_PARAMETER(path_x);\n    UNREFERENCED_PARAMETER(ph);\n}\n\nuint8_t picoquic_spinbit_null_outgoing(picoquic_cnx_t* UNUSED(cnx))\n{\n    UNREFERENCED_PARAMETER(cnx);\n    return 0;\n}\n\n/*\n * Two procedures defining the null spin bit randomized variant\n */\n\nvoid picoquic_spinbit_random_incoming(picoquic_cnx_t* UNUSED(cnx), picoquic_path_t* UNUSED(path_x), picoquic_packet_header* UNUSED(ph))\n{\n    UNREFERENCED_PARAMETER(cnx);\n    UNREFERENCED_PARAMETER(path_x);\n    UNREFERENCED_PARAMETER(ph);\n}\n\nuint8_t picoquic_spinbit_random_outgoing(picoquic_cnx_t* UNUSED(cnx))\n{\n    UNREFERENCED_PARAMETER(cnx);\n    return (uint8_t) (picoquic_public_random_64()&0x20);\n}\n\n/*\n * Table of spin bit functions\n */\npicoquic_spinbit_def_t picoquic_spin_function_table[] = {\n    {picoquic_spinbit_basic_incoming, picoquic_spinbit_basic_outgoing},\n    {picoquic_spinbit_random_incoming, picoquic_spinbit_random_outgoing},\n\t{picoquic_spinbit_null_incoming, picoquic_spinbit_null_outgoing}\n};\n","numLines":86,"startLine":1,"totalLines":86}}}
{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01ALrWGM63tYX4AMugwiAAEZ","type":"tool_result","content":"1\t/*\n2\t* Author: Christian Huitema\n3\t* Copyright (c) 2017, Private Octopus, Inc.\n4\t* All rights reserved.\n5\t*\n6\t* Permission to use, copy, modify, and distribute this software for any\n7\t* purpose with or without fee is hereby granted, provided that the above\n8\t* copyright notice and this permission notice appear in all copies.\n9\t*\n10\t* THIS SOFTWARE IS PROVIDED BY THE COPYRIGHT HOLDERS AND CONTRIBUTORS \"AS IS\" AND\n11\t* ANY EXPRESS OR IMPLIED WARRANTIES, INCLUDING, BUT NOT LIMITED TO, THE IMPLIED\n12\t* WARRANTIES OF MERCHANTABILITY AND FITNESS FOR A PARTICULAR PURPOSE ARE\n13\t* DISCLAIMED. IN NO EVENT SHALL Private Octopus, Inc. BE LIABLE FOR ANY\n14\t* DIRECT, INDIRECT, INCIDENTAL, SPECIAL, EXEMPLARY, OR CONSEQUENTIAL DAMAGES\n15\t* (INCLUDING, BUT NOT LIMITED TO, PROCUREMENT OF SUBSTITUTE GOODS OR SERVICES;\n16\t* LOSS OF USE, DATA, OR PROFITS; OR BUSINESS INTERRUPTION) HOWEVER CAUSED AND\n17\t* ON ANY THEORY OF LIABILITY, WHETHER IN CONTRACT, STRICT LIABILITY, OR TORT\n18\t* (INCLUDING NEGLIGENCE OR OTHERWISE) ARISING IN ANY WAY OUT OF THE USE OF THIS\n19\t* SOFTWARE, EVEN IF ADVISED OF THE POSSIBILITY OF SUCH DAMAGE.\n20\t*/\n21\t\n22\t#include \"tls_api.h\"\n23\t#include \"picoquic_internal.h\"\n24\t#include <stddef.h>\n25\t#include <stdlib.h>\n26\t#include <string.h>\n27\t#include <errno.h>\n28\t\n29\tpicoquic_stored_ticket_t* picoquic_format_ticket(uint64_t time_valid_until,\n30\t    char const* sni, uint16_t sni_length, char const* alpn, uint16_t alpn_length,\n31\t    uint32_t version, const uint8_t * ip_addr, uint8_t ip_addr_length,\n32\t    const uint8_t * ip_addr_client, uint8_t ip_addr_client_length,\n33\t    uint8_t* ticket, uint16_t ticket_length, picoquic_tp_t const * tp)\n34\t{\n35\t    size_t ticket_size = sizeof(picoquic_stored_ticket_t) + sni_length + 1 + alpn_length + 1 + ticket_length\n36\t        + 1 + 2*PICOQUIC_STORED_IP_MAX;\n37\t    picoquic_stored_ticket_t* stored = (picoquic_stored_ticket_t*)malloc(ticket_size);\n38\t    \n39\t    if (stored != NULL) {\n40\t        char* next_p = ((char*)stored) + sizeof(picoquic_stored_ticket_t);\n41\t\n42\t        memset(stored, 0, ticket_size);\n43\t        stored->time_valid_until = time_valid_until;\n44\t        stored->sni = next_p;\n45\t        stored->sni_length = sni_length;\n46\t        memcpy(next_p, sni, sni_length);\n47\t        next_p += sni_length;\n48\t        *next_p++ = 0;\n49\t\n50\t        stored->alpn = next_p;\n51\t        stored->alpn_length = alpn_length;\n52\t        memcpy(next_p, alpn, alpn_length);\n53\t        next_p += alpn_length;\n54\t        *next_p++ = 0;\n55\t\n56\t        stored->version = version;\n57\t\n58\t        stored->ip_addr = (uint8_t *)next_p;\n59\t        if (ip_addr == NULL || ip_addr_length == 0) {\n60\t            stored->ip_addr_length = 0;\n61\t        }\n62\t        else {\n63\t            if (ip_addr_length > PICOQUIC_STORED_IP_MAX) {\n64\t                ip_addr_length = PICOQUIC_STORED_IP_MAX;\n65\t            }\n66\t            stored->ip_addr_length = ip_addr_length;\n67\t            memcpy(next_p, ip_addr, ip_addr_length);\n68\t        }\n69\t        next_p += PICOQUIC_STORED_IP_MAX;\n70\t\n71\t        stored->ip_addr_client = (uint8_t*)next_p;\n72\t        if (ip_addr_client == NULL || ip_addr_client_length == 0) {\n73\t            stored->ip_addr_length = 0;\n74\t        }\n75\t        else {\n76\t            if (ip_addr_client_length > PICOQUIC_STORED_IP_MAX) {\n77\t                ip_addr_client_length = PICOQUIC_STORED_IP_MAX;\n78\t            }\n79\t            stored->ip_addr_client_length = ip_addr_client_length;\n80\t            memcpy(next_p, ip_addr_client, ip_addr_client_length);\n81\t        }\n82\t        next_p += PICOQUIC_STORED_IP_MAX;\n83\t\n84\t        if (tp != NULL) {\n85\t            stored->tp_0rtt[picoquic_tp_0rtt_max_data] = tp->in