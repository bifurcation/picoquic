{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01UTaCLk6ENoF3JXjDSu61JN","type":"tool_result","content":"100\t//\n101\t// All labels are NUL-terminated bytes in the C header because tls\n102\t// takes them as `char const*`.  The Rust shape is plain `&str`; the\n103\t// trailing NUL is reintroduced (if needed) at the tls FFI\n104\t// boundary.\n105\t\n106\t/// Initial secret label for the client direction.  C:\n107\t/// `LABEL_INITIAL_CLIENT`.\n108\tpub const LABEL_INITIAL_CLIENT: &str = \"client in\";\n109\t\n110\t/// Initial secret label for the server direction.  C:\n111\t/// `LABEL_INITIAL_SERVER`.\n112\tpub const LABEL_INITIAL_SERVER: &str = \"server in\";\n113\t\n114\t/// Traffic-update label for QUIC v1.  C:\n115\t/// `LABEL_V1_TRAFFIC_UPDATE`.\n116\tpub const LABEL_V1_TRAFFIC_UPDATE: &str = \"quic ku\";\n117\t\n118\t/// Traffic-update label for QUIC v2.  C:\n119\t/// `LABEL_V2_TRAFFIC_UPDATE`.\n120\tpub const LABEL_V2_TRAFFIC_UPDATE: &str = \"quicv2 ku\";\n121\t\n122\t/// HKDF \"key\" component label.  C: `LABEL_KEY`.\n123\tpub const LABEL_KEY: &str = \"key\";\n124\t\n125\t/// HKDF \"iv\" component label.  C: `LABEL_IV`.\n126\tpub const LABEL_IV: &str = \"iv\";\n127\t\n128\t/// HKDF \"hp\" (header protection) component label.  C:\n129\t/// `LABEL_HP`.\n130\tpub const LABEL_HP: &str = \"hp\";\n131\t\n132\t/// HKDF \"cid\" component label.  C: `LABEL_CID`.\n133\tpub const LABEL_CID: &str = \"cid\";\n134\t\n135\t/// HKDF label for the global CID encryption secret.  C:\n136\t/// `LABEL_CID_GLOBAL`.\n137\tpub const LABEL_CID_GLOBAL: &str = \"cid global\";\n138\t\n139\t/// Number of HKDF rounds run when deriving the global CID secret.\n140\t/// C: `LABEL_CID_GLOBAL_ROUNDS`.\n141\tpub const LABEL_CID_GLOBAL_ROUNDS: u32 = 4;\n142\t\n143\t/// QUIC v1 TLS key-derivation label prefix.  C:\n144\t/// `LABEL_QUIC_V1_KEY_BASE`.\n145\tpub const LABEL_QUIC_V1_KEY_BASE: &str = \"tls13 quic \";\n146\t\n147\t/// QUIC v2 TLS key-derivation label prefix.  C:\n148\t/// `LABEL_QUIC_V2_KEY_BASE`.\n149\tpub const LABEL_QUIC_V2_KEY_BASE: &str = \"tls13 quicv2 \";\n150\t\n151\tconst SHA256_SIZE: usize = 32;\n152\tconst AES128_KEY_SIZE: usize = 16;\n153\tconst AES_GCM_IV_SIZE: usize = 12;\n154\tconst TICKET_AEAD_LABEL: &str = \"random label\";\n155\tconst TLS13_LABEL_PREFIX: &str = \"tls13 \";\n156\t\n157\tfn version_from_index(version_index: i32) -> Option<Version> {\n158\t    match version_index {\n159\t        0 => Some(Version::V1),\n160\t        1 => Some(Version::V2),\n161\t        2 => Some(Version::V2Draft),\n162\t        3 => Some(Version::PostIesg),\n163\t        4 => Some(Version::TwentyFirstInterop),\n164\t        5 => Some(Version::TwentiethInterop),\n165\t        6 => Some(Version::TwentiethPreInterop),\n166\t        7 => Some(Version::NineteenthInterop),\n167\t        8 => Some(Version::NineteenthBisInterop),\n168\t        9 => Some(Version::EighteenthInterop),\n169\t        10 => Some(Version::SeventeenthInterop),\n170\t        11 => Some(Version::InternalTest2),\n171\t        12 => Some(Version::InternalTest1),\n172\t        _ => None,\n173\t    }\n174\t}\n175\t\n176\tfn connection_version(cnx: &Connection) -> Version {\n177\t    Version::try_from_wire(cnx.proposed_version)\n178\t        .or_else(|| version_from_index(cnx.version_index))\n179\t        .unwrap_or(Version::V1)\n180\t}\n181\t\n182\tfn hkdf_label_info(label: &str, base_label: &str, output_len: usize) -> Result<Vec<u8>, Error> {\n183\t    if output_len > u16::MAX as usize {\n184\t        return Err(Error::InvalidArgument);\n185\t    }\n186\t    let mut full_label = Vec::with_capacity(base_label.len() + label.len());\n187\t    full_label.extend_from_slice(base_label.as_bytes());\n188\t    full_label.extend_from_slice(label.as_bytes());\n189\t    if full_label.len() > u8::MAX as usize {\n190\t        return Err(Error::InvalidArgument);\n191\t    }\n192\t\n193\t    let mut info = Vec::with_capacity(2 + 1 + full_label.len() + 1);\n194\t    info.extend_from_slice(&(output_len as u16).to_be_bytes());\n195\t    info.push(full_label.len() as u8);\n196\t    info.extend_from_slice(&full_label);\n197\t    info.push(0);\n198\t    Ok(info)\n199\t}"}]},"parent_tool_use_id":null,"session_id":"c078a458-8d27-4b1b-b12a-e775d28f8c36","uuid":"138a658b-4f33-429e-902b-74b9eb2a03d7","timestamp":"2026-05-07T09:34:21.003Z","tool_use_result":{"type":"text","file":{"filePath":"/Users/richbarn/Projects/picoquic/rs/fq/src/tls_api.rs","content":"//\n// All labels are NUL-terminated bytes in the C header because tls\n// takes them as `char const*`.  The Rust shape is plain `&str`; the\n// trailing NUL is reintroduced (if needed) at the tls FFI\n// boundary.\n\n/// Initial secret label for the client direction.  C:\n/// `LABEL_INITIAL_CLIENT`.\npub const LABEL_INITIAL_CLIENT: &str = \"client in\";\n\n/// Initial secret label for the server direction.  C:\n/// `LABEL_INITIAL_SERVER`.\npub const LABEL_INITIAL_SERVER: &str = \"server in\";\n\n/// Traffic-update label for QUIC v1.  C:\n/// `LABEL_V1_TRAFFIC_UPDATE`.\npub const LABEL_V1_TRAFFIC_UPDATE: &str = \"quic ku\";\n\n/// Traffic-update label for QUIC v2.  C:\n/// `LABEL_V2_TRAFFIC_UPDATE`.\npub const LABEL_V2_TRAFFIC_UPDATE: &str = \"quicv2 ku\";\n\n/// HKDF \"key\" component label.  C: `LABEL_KEY`.\npub const LABEL_KEY: &str = \"key\";\n\n/// HKDF \"iv\" component label.  C: `LABEL_IV`.\npub const LABEL_IV: &str = \"iv\";\n\n/// HKDF \"hp\" (header protection) component label.  C:\n/// `LABEL_HP`.\npub const LABEL_HP: &str = \"hp\";\n\n/// HKDF \"cid\" component label.  C: `LABEL_CID`.\npub const LABEL_CID: &str = \"cid\";\n\n/// HKDF label for the global CID encryption secret.  C:\n/// `LABEL_CID_GLOBAL`.\npub const LABEL_CID_GLOBAL: &str = \"cid global\";\n\n/// Number of HKDF rounds run when deriving the global CID secret.\n/// C: `LABEL_CID_GLOBAL_ROUNDS`.\npub const LABEL_CID_GLOBAL_ROUNDS: u32 = 4;\n\n/// QUIC v1 TLS key-derivation label prefix.  C:\n/// `LABEL_QUIC_V1_KEY_BASE`.\npub const LABEL_QUIC_V1_KEY_BASE: &str = \"tls13 quic \";\n\n/// QUIC v2 TLS key-derivation label prefix.  C:\n/// `LABEL_QUIC_V2_KEY_BASE`.\npub const LABEL_QUIC_V2_KEY_BASE: &str = \"tls13 quicv2 \";\n\nconst SHA256_SIZE: usize = 32;\nconst AES128_KEY_SIZE: usize = 16;\nconst AES_GCM_IV_SIZE: usize = 12;\nconst TICKET_AEAD_LABEL: &str = \"random label\";\nconst TLS13_LABEL_PREFIX: &str = \"tls13 \";\n\nfn version_from_index(version_index: i32) -> Option<Version> {\n    match version_index {\n        0 => Some(Version::V1),\n        1 => Some(Version::V2),\n        2 => Some(Version::V2Draft),\n        3 => Some(Version::PostIesg),\n        4 => Some(Version::TwentyFirstInterop),\n        5 => Some(Version::TwentiethInterop),\n        6 => Some(Version::TwentiethPreInterop),\n        7 => Some(Version::NineteenthInterop),\n        8 => Some(Version::NineteenthBisInterop),\n        9 => Some(Version::EighteenthInterop),\n        10 => Some(Version::SeventeenthInterop),\n        11 => Some(Version::InternalTest2),\n        12 => Some(Version::InternalTest1),\n        _ => None,\n    }\n}\n\nfn connection_version(cnx: &Connection) -> Version {\n    Version::try_from_wire(cnx.proposed_version)\n        .or_else(|| version_from_index(cnx.version_index))\n        .unwrap_or(Version::V1)\n}\n\nfn hkdf_label_info(label: &str, base_label: &str, output_len: usize) -> Result<Vec<u8>, Error> {\n    if output_len > u16::MAX as usize {\n        return Err(Error::InvalidArgument);\n    }\n    let mut full_label = Vec::with_capacity(base_label.len() + label.len());\n    full_label.extend_from_slice(base_label.as_bytes());\n    full_label.extend_from_slice(label.as_bytes());\n    if full_label.len() > u8::MAX as usize {\n        return Err(Error::InvalidArgument);\n    }\n\n    let mut info = Vec::with_capacity(2 + 1 + full_label.len() + 1);\n    info.extend_from_slice(&(output_len as u16).to_be_bytes());\n    info.push(full_label.len() as u8);\n    info.extend_from_slice(&full_label);\n    info.push(0);\n    Ok(info)\n}","numLines":100,"startLine":100,"totalLines":1776}}}
