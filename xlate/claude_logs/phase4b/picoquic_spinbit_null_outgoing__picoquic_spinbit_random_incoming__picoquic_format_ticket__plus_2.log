e computation may indicate that the \"local\" value of the ack-stamping time\n139\t        * was earlier than the send time of the packet, or later than the current time.\n140\t        * This cannot happen, of course, which means that either the ack delay or\n141\t        * the phase estimate is wrong.\n142\t        */\n143\t        if (time_stamp_local < 0 || (uint64_t)time_stamp_local < send_time) {\n144\t            int64_t min_phase = send_time - time_stamp + ack_delay - cnx->start_time;\n145\t            time_stamp_local = time_stamp - ack_delay + cnx->start_time + min_phase;\n146\t            if (time_stamp_local > 0 && (uint64_t)time_stamp_local <= current_time) {\n147\t                /* looks plausible -- the computed stamp is earlier than now. */\n148\t                cnx->phase_delay = min_phase;\n149\t            }\n150\t            else {\n151\t                is_time_stamp_valid = 0;\n152\t            }\n153\t        }\n154\t        else if ((uint64_t)time_stamp_local > current_time) {\n155\t            int64_t max_phase = current_time - time_stamp + ack_delay - cnx->start_time;\n156\t            time_stamp_local = time_stamp - ack_delay + cnx->start_time + max_phase;\n157\t            if (time_stamp_local > 0 && (uint64_t)time_stamp_local >= send_time) {\n158\t                /* looks plausible -- the computed stamp is earlier than now. */\n159\t                cnx->phase_delay = max_phase;\n160\t            }\n161\t            else {\n162\t                is_time_stamp_valid = 0;\n163\t            }\n164\t        }\n165\t        if (is_time_stamp_valid) {\n166\t            old_path->one_way_delay_sample = time_stamp_local - send_time;\n167\t        }\n168\t        else {\n169\t            old_path->nb_delay_outliers++;\n170\t        }\n171\t    }\n172\t}\n173\t\n174\t\n175\t/* The RTT computation algorithm separates RTT computation from one way delay computations,\n176\t* using a straightforward averaging method even in multipath scenarios. It also t