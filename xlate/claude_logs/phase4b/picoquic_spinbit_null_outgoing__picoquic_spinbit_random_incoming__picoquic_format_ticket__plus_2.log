{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01Nm7jkSVC4ncZQ8CMVSKvau","type":"tool_result","content":"200\t\n201\tfn hkdf_expand_label_sha256(\n202\t    label: &str,\n203\t    base_label: &str,\n204\t    secret: &[u8],\n205\t    output: &mut [u8],\n206\t) -> Result<(), Error> {\n207\t    let info = hkdf_label_info(label, base_label, output.len())?;\n208\t    let hkdf = hkdf::Hkdf::<sha2::Sha256>::from_prk(secret).map_err(|_| Error::InvalidArgument)?;\n209\t    hkdf.expand(&info, output)\n210\t        .map_err(|_| Error::InvalidArgument)\n211\t}\n212\t\n213\tfn hkdf_expand_label_sha384(\n214\t    label: &str,\n215\t    base_label: &str,\n216\t    secret: &[u8],\n217\t    output: &mut [u8],\n218\t) -> Result<(), Error> {\n219\t    let info = hkdf_label_info(label, base_label, output.len())?;\n220\t    let hkdf = hkdf::Hkdf::<sha2::Sha384>::from_prk(secret).map_err(|_| Error::InvalidArgument)?;\n221\t    hkdf.expand(&info, output)\n222\t        .map_err(|_| Error::InvalidArgument)\n223\t}\n224\t\n225\tfn hkdf_expand_label_sha512(\n226\t    label: &str,\n227\t    base_label: &str,\n228\t    secret: &[u8],\n229\t    output: &mut [u8],\n230\t) -> Result<(), Error> {\n231\t    let info = hkdf_label_info(label, base_label, output.len())?;\n232\t    let hkdf = hkdf::Hkdf::<sha2::Sha512>::from_prk(secret).map_err(|_| Error::InvalidArgument)?;\n233\t    hkdf.expand(&info, output)\n234\t        .map_err(|_| Error::InvalidArgument)\n235\t}\n236\t\n237\tfn derive_aes128_gcm_key_iv(\n238\t    secret: &[u8],\n239\t    prefix_label: &str,\n240\t) -> Result<([u8; AES128_KEY_SIZE], [u8; AES_GCM_IV_SIZE]), Error> {\n241\t    let mut key = [0u8; AES128_KEY_SIZE];\n242\t    let mut iv = [0u8; AES_GCM_IV_SIZE];\n243\t    hkdf_expand_label(LABEL_KEY, prefix_label, secret, &mut key)?;\n244\t    hkdf_expand_label(LABEL_IV, prefix_label, secret, &mut iv)?;\n245\t    Ok((key, iv))\n246\t}\n247\t\n248\t#[derive(Clone)]\n249\tstruct Aes128GcmPacketKey {\n250\t    cip