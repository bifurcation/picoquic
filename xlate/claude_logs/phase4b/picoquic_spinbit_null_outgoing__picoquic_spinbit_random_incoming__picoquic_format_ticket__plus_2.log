{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_012UiNqZS8FC2n8rPTWRdygG","type":"tool_result","content":"960\t    /// Cache a session ticket alongside the transport-parameters that\n961\t    /// were in force at the time, indexed by `(sni, alpn, version)`.\n962\t    #[allow(clippy::too_many_arguments)]\n963\t    pub fn store_ticket(\n964\t        &mut self,\n965\t        sni: Option<&str>,\n966\t        alpn: Option<&str>,\n967\t        version: u32,\n968\t        ip_addr: core::net::IpAddr,\n969\t        ip_addr_client: core::net::IpAddr,\n970\t        ticket: &[u8],\n971\t        tp: &TransportParameters,\n972\t    ) -> Result<(), crate::Error> {\n973\t        let time_valid_until = ticket_valid_until(ticket)?;\n974\t        let stored = StoredTicket {\n975\t            sni: sni.map(str::to_owned),\n976\t            alpn: alpn.map(str::to_owned),\n977\t            ip_addr,\n978\t            ip_addr_client,\n979\t            tp_0rtt: {\n980\t                use crate::tp::TransportParameter0RttKind::*;\n981\t                let mut arr = [0u64; crate::tp::NB_TP_0RTT];\n982\t                arr[MaxData as usize] = tp.initial_max_data;\n983\t                arr[MaxStreamDataBidiLocal as usize] = tp.initial_max_stream_data_bidi_local;\n984\t                arr[MaxStreamDataBidiRemote as usize] = tp.initial_max_stream_data_bidi_remote;\n985\t                arr[MaxStreamDataUni as usize] = tp.initial_max_stream_data_uni;\n986\t                arr[MaxStreamsIdBidir as usize] = tp.initial_max_stream_id_bidir;\n987\t                arr[MaxStreamsIdUnidir as usize] = tp.initial_max_stream_id_unidir;\n988\t                arr\n989\t            },\n990\t            ticket: ticket.to_vec(),\n991\t            time_valid_until,\n992\t            version,\n993\t            was_used: false,\n994\t        };\n995\t        self.stored_tickets.retain(|old| {\n996\t            old.sni.as_deref() != sni\n997\t                || old.alpn.as_deref() != alpn\n998\t                || old.version != version\n999\t                || old.time_valid_until > time_valid_until\n1000\t        });\n1001\t        self.stored_tickets.insert(0, stored);\n1002\t        Ok(())\n1003\t    }\n1004\t\n1005\t    /// Retrieve a cached ticket record (without consuming it).\n1006\t    /// `need_unused` skips already-used tickets.\n1007\t    pub fn get_stored_ticket(\n1008\t        &mut self,\n1009\t        sni: Option<&str>,\n1010\t        alpn: Option<&str>,\n1011\t        version: u32,\n1012\t        need_unused: bool,\n1013\t        ticket_id: u64,\n1014\t    ) -> Option<&mut StoredTicket> {\n1015\t        self.stored_tickets.iter_mut().find(|ticket| {\n1016\t            ticket.time_valid_until.ticks() > 0\n1017\t                && ticket.sni.as_deref() == sni\n1018\t                && ticket.alpn.as_deref() == alpn\n1019\t                && (version == 0 || ticket.version == version)\n1020\t                && (!need_unused || !ticket.was_used)\n1021\t                && (ticket_id == 0 || stored_ticket_id(ticket) == ticket_id)\n1022\t        })\n1023\t    }\n1024\t\n1025\t    /// Output of [`Self::get_ticket`] / [`Self::get_ticket_and_version`].\n1026\t    /// Replaces the C trio of out-parameters\n1027\t    /// (`uint8_t** ticket`, `uint16_t* ticket_length`,\n1028\t    /// `picoquic_tp_t* tp`).  The byte slice borrows from the\n1029\t    /// cached ticket entry.\n1030\t    #[allow(clippy::too_many_arguments)]\n1031\t    pub fn get_ticket(\n1032\t        &mut self,\n1033\t        sni: Option<&str>,\n1034\t        alpn: Option<&str>,\n1035\t        version: u32,\n1036\t        mark_used: bool,\n1037\t    ) -> Result<(&[u8], TransportParameters), crate::Error> {\n1038\t        let (_, ticket, tp) = self.get_ticket_and_version(sni, alpn, version, mark_used)?;\n1039\t        Ok((ticket, tp))"}]},"parent_tool_use_id":null,"session_id":"c078a458-8d27-4b1b-b12a-e775d28f8c36","uuid":"4ee95b5e-10f3-4536-8c6b-1fd50f41745f","timestamp":"2026-05-07T09:3