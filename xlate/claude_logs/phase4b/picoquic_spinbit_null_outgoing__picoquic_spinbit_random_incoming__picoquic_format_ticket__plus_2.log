{"type":"assistant","message":{"model":"claude-sonnet-4-6","id":"msg_011exyKSUir8Vs4DrtnaPHne","type":"message","role":"assistant","content":[{"type":"tool_use","id":"toolu_01DLucTkqrPHygRsepjfhMqJ","name":"Edit","input":{"replace_all":false,"file_path":"/Users/richbarn/Projects/picoquic/rs/fq/src/internal.rs","old_string":"        old_path.retransmit_timer = Duration::from_ticks(\n            old_path\n                .smoothed_rtt\n                .ticks()\n                .saturating_add(4 * old_path.rtt_variant.ticks())\n                .saturating_add(self.max_ack_delay_remote.ticks())\n                .max(MIN_RETRANSMIT_TIMER.ticks()),\n        );\n    }\n}\n\n// ---------------------------------------------------------------------------\n// Stream management.","new_string":"        old_path.retransmit_timer = Duration::from_ticks(\n            old_path\n                .smoothed_rtt\n                .ticks()\n                .saturating_add(4 * old_path.rtt_variant.ticks())\n                .saturating_add(self.max_ack_delay_remote.ticks())\n                .max(MIN_RETRANSMIT_TIMER.ticks()),\n        );\n    }\n\n    /// Update the one-way delay sample on `old_path` using a remote\n    /// timestamp carried in an ACK frame.  Adjusts `self.phase_delay`\n    /// (the estimated clock-offset between local and remote) when the\n    /// raw sample falls outside `[send_time, current_time]`.\n    /// C: `picoquic/timing.c:picoquic_update_path_rtt_one_way` (line 122–172).\n    pub fn update_path_rtt_one_way(\n        &mut self,\n        old_path: &mut Path,\n        send_time: Instant,\n        current_time: Instant,\n        ack_delay: u64,\n        time_stamp: u64,\n    ) {\n        if time_stamp == 0 {\n            return;\n        }\n        if self.phase_delay == i64::MAX {\n            self.phase_delay = (old_path.rtt_sample.ticks() / 2) as i64;\n            if !self.client_mode {\n                self.phase_delay = -self.phase_delay;\n            }\n        }\n        let mut time_stamp_local: i64 = (time_stamp as i64)\n            .wrapping_sub(ack_delay as i64)\n            .wrapping_add(self.start_time.ticks() as i64)\n            .wrapping_add(self.phase_delay);\n        let is_valid: bool;\n        if time_stamp_local < 0 || (time_stamp_local as u64) < send_time.ticks() {\n            let min_phase: i64 = (send_time.ticks() as i64)\n                .wrapping_sub(time_stamp as i64)\n                .wrapping_add(ack_delay as i64)\n                .wrapping_sub(self.start_time.ticks() as i64);\n            time_stamp_local = (time_stamp as i64)\n                .wrapping_sub(ack_delay as i64)\n                .wrapping_add(self.start_time.ticks() as i64)\n                .wrapping_add(min_phase);\n            if time_stamp_local > 0 && (time_stamp_local as u64) <= current_time.ticks() {\n                self.phase_delay = min_phase;\n                is_valid = true;\n            } else {\n                is_valid = false;\n            }\n        } else if (time_stamp_local as u64) > current_time.ticks() {\n            let max_phase: i64 = (current_time.ticks() as i64)\n                .wrapping_sub(time_stamp as i64)\n                .wrapping_add(ack_delay as i64)\n                .wrapping_sub(self.start_time.ticks() as i64);\n            time_stamp_local = (time_stamp as i64)\n                .wrapping_sub(ack_delay as i64)\n                .wrapping_add(self.start_time.ticks() as i64)\n                .wrapping_add(max_phase);\n            if time_stamp_local > 0 && (time_stamp_local as u64) >= send_time.ticks() {\n                self.phase_delay = max_phase;\n                is_valid = true;\n            } else {\n                is_valid = false;\n            }\n        } else {\n            is_valid = true;\n        }\n        if is_valid {\n            old_path.one_way_delay_sample = Duration::from_ticks(\n                (time_stamp_local as u64).saturating_sub(send_time.ticks()),\n            );\n        } else {\n            old_path.nb_delay_outliers += 1;\n        }\n    }\n}\n\n// ---------------------------------------------------------------------------\n// Stream management."},"caller":{"type":"direct"}}],"stop_reason":null,"stop_sequence":null,"stop_details":null,"usage":{"input_tokens":1,"cache_creation_input_tokens":5926,"cache_read_input_tokens":74881,"cache_creation":{"ephemeral_5m_input_tokens":0,"ephemeral_1h_input_tokens":5926},"output_tokens":4,"service_tier":"standard","inference_geo":"not_available"},"context_management":null},"parent_tool_use_id":null,"session_id":"c078a458-8d27-4b1b-b12a-e775d28f8c36","uuid":"999762ae-6395-45a2-8d0f-860240611b40"}
