\t}\n882\t\n883\tstatic void BBRUpdateOffloadBudget(picoquic_bbr_state_t* bbr_state)\n884\t{\n885\t    bbr_state->offload_budget = 3 * bbr_state->send_quantum;\n886\t}\n887\t\n888\tstatic uint64_t BBRQuantizationBudget(picoquic_bbr_state_t* bbr_state, picoquic_path_t* path_x, uint64_t inflight)\n889\t{\n890\t    BBRUpdateOffloadBudget(bbr_state);\n891\t    if (inflight < bbr_state->offload_budget) {\n892\t        inflight = bbr_state->offload_budget;\n893\t    }\n894\t    if (inflight < BBRMinPipeCwnd * path_x->send_mtu) {\n895\t        inflight = BBRMinPipeCwnd * path_x->send_mtu;\n896\t    }\n897\t    if (bbr_state->state == picoquic_bbr_alg_probe_bw_up) {\n898\t        inflight += 2*path_x->send_mtu;\n899\t    }\n900\t    return inflight;\n901\t}\n902\t\n903\tstatic uint64_t BBRInflightWithBw(picoquic_bbr_state_t* bbr_state, picoquic_path_t* path_x, double gain, uint64_t bw)\n904\t{\n905\t    uint64_t inflight = BBRBDPMultipleWithBw(bbr_state, path_x, gain, bw);\n906\t    return BBRQuantizationBudget(bbr_state, path_x, inflight);\n907\t}\n908\t\n909\tstatic uint64_t BBRInflight(picoquic_bbr_state_t* bbr_state, picoquic_path_t* path_x, double gain)\n910\t{\n911\t    return BBRInflightWithBw(bbr_state, path_x, gain, bbr_state->bw);\n912\t}\n913\t\n914\tstatic void BBRUpdateMaxInflight(picoquic_bbr_state_t* bbr_state, picoquic_path_t* path_x)\n915\t{\n916\t    /*  The draft mentions here a call to BBRUpdateAggregationBudget(),\n917\t    * but does not define that function. Its purpose is apparently to set\n918\t    * `extra_acked`, but that variable is computed in\n919\t    * BBRUpdateACKAggregation(), which is called as part of \n920\t    * BBRUpdateModelAndState(). There is probably no need to do an extra\n921\t    * call here. */\n922\t    uint64_t inflight = BBRBDPMultiple(bbr_state, path_x, bbr_state->cwnd_gain);\n923\t\n924\t    inflight += bbr_state->extra_acked;\n925\t\n926\t    if (bbr_state->min_rtt < bbr_state->wifi_shadow_rtt && bbr_state->min_rtt > 0){\