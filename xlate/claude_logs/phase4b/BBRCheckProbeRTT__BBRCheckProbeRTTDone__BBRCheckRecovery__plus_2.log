>full_bw = bbr_state->max_bw;    /* record new baseline level */\n1963\t        bbr_state->full_bw_count = 0;\n1964\t        return;\n1965\t    }\n1966\t    bbr_state->full_bw_count++; /* another round w/o much growth */\n1967\t    if (bbr_state->full_bw_count >= 3) {\n1968\t        bbr_state->filled_pipe = 1;\n1969\t    }\n1970\t}\n1971\t\n1972\tstatic void BBREnterStartupResume(picoquic_bbr_state_t* bbr_state)\n1973\t{\n1974\t    /* This code is called either when the \"bdp seed\" is set, or\n1975\t     * upon \"Enter Startup\"\n1976\t     */\n1977\t    bbr_state->state = picoquic_bbr_alg_startup_resume;\n1978\t    bbr_state->pacing_gain = BBRStartupResumePacingGain;\n1979\t    bbr_state->cwnd_gain = BBRStartupResumeCwndGain;\n1980\t}\n1981\t\n1982\tstatic void BBRCheckStartupResume(picoquic_bbr_state_t* bbr_state, picoquic_path_t* path_x, bbr_per_ack_state_t* rs)\n1983\t{\n1984\t    if (bbr_state->state == picoquic_bbr_alg_startup_resume) {\n1985\t        BBRCheckStartupHighLoss(bbr_state, path_x, rs);\n1986\t        if (!bbr_state->filled_pipe && (double)bbr_state->max_bw > BBRStartupResumeIncreaseThreshold * bbr_state->bdp_seed) {\n1987\t            BBREnterStartup(bbr_state, path_x);\n1988\t        }\n1989\t        else {\n1990\t            BBRCheckStartupFullBandwidthGeneric(bbr_state, rs, BBRStartupResumeIncreaseThreshold);\n1991\t            if (bbr_state->filled_pipe) {\n1992\t                if (bbr_state->full_bw_count > 0) {\n1993\t                    bbr_state->probe_probe_bw_quickly = 1;\n1994\t                    bbr_state->full_bw_count = 0;\n1995\t                }\n1996\t                BBREnterDrain(bbr_state, path_x);\n1997\t            }\n1998\t        }\n1999\t    }\n2000\t}\n2001\t\n2002\t/* Startup specific processes for BBRv3 */\n2003\tstatic void BBRCheckStartupHighLoss(picoquic_bbr_state_t* bbr_state, picoquic_path_t * path_x, bbr_per_ack_state_t * rs)\n2004\t{"}]},"parent_tool_use_id":null,"session_id":"87cac919-fa51-4116-b1f6-b9ae33184f