261\t        // PICOQUIC_BYTES_FROM_RATE(min_rtt_us, bps) = min_rtt * bps / 1_000_000\n262\t        self.bdp = self.min_rtt * bw / 1_000_000;\n263\t        (gain * self.bdp as f64) as u64\n264\t    }\n265\t\n266\t    /// C: `BBRBoundBWForModel` (picoquic/bbr.c:1094)\n267\t    ///\n268\t    /// Set `self.bw = min(max_bw, bw_lo, bw_hi)`.  `bw_hi` is only\n269\t    /// applied when non-zero; the zero check preserves compatibility\n270\t    /// with states where `bw_hi` is not yet initialised (noted as a\n271\t    /// TODO in the C source).\n272\t    pub fn bound_bw_for_model(&mut self) {\n273\t        self.bw = self.max_bw;\n274\t        if self.bw > self.bw_lo {\n275\t            self.bw = self.bw_lo;\n276\t        }\n277\t        // TODO: remove the bw_hi != 0 guard once variables are properly\n278\t        // initialised (mirrors the C-side TODO at bbr.c:1100).\n279\t        if self.bw > self.bw_hi && self.bw_hi != 0 {\n280\t            self.bw = self.bw_hi;\n281\t        }\n282\t    }\n283\t\n284\t    /// C: `BBREnterProbeRTT` (picoquic/bbr.c:1487)\n285\t    pub fn enter_probe_rtt(&mut self, path_x: &mut Path) {\n286\t        self.state = BbrAlgState::ProbeRtt;\n287\t        self.pacing_gain = 1.0;\n288\t        self.cwnd_gain = BBR_PROBE_RTT_CWND_GAIN;\n289\t        path_x.is_cca_probing_up = false;\n290\t    }\n291\t\n292\t    /// C: `BBREnterDrain` (picoquic/bbr.c:1933)\n293\t    pub fn enter_drain(&mut self, path_x: &mut Path) {\n294\t        // Picoquic-specific: notify transport that the startup phase is complete.\n295\t        path_x.is_ssthresh_initialized = true;\n296\t        self.state = BbrAlgState::Drain;\n297\t        self.pacing_gain = 1.0 / BBR_STARTUP_CWND_GAIN; // pace slowly\n298\t        self.cwnd_gain = BBR_STARTUP_CWND_GAIN; // maintain cwnd\n299\t        path_x.is_cca_probing_up = false;\n300\t    }\n301\t\n302\t    /// C: `BBRCheckStartupFullBandwidthGeneric` (picoquic/bbr.c:1952)\n303\t    pub fn check_startup_full_bandwidth_generic(&mut self, rs: &BbrPerAckState, threshold: f64) {\n304\t        if self.filled_pipe || !self.round_start || rs.is_app_limited {\n305\t            return;\n306\t        }\n307\t        if self.max_bw as f64 >= threshold * self.full_bw as f64 {\n308\t            // still growing\n309\t            self.full_bw = self.max_bw;\n310\t            self.full_bw_count = 0;\n311\t            return;\n312\t        }\n313\t        self.full_bw_count += 1; // another round without much growth\n314\t        if self.full_bw_count >= 3 {\n315\t            self.filled_pipe = true;\n316\t        }\n317\t    }\n318\t\n319\t    /// C: `BBRCheckStartupFullBandwidth` (picoquic/bbr.c:2020)\n320\t    pub fn check_startup_full_bandwidth(&mut self, rs: &BbrPerAckState) {\n321\t        if self.filled_pipe || !self.round_start || rs.is_app_limited {\n322\t            return;\n323\t        }\n324\t        // 5/4 integer approximation of ×1.25 avoids floating-point drift.\n325\t        if 4 * self.max_bw >= 5 * self.full_bw {\n326\t            // still growing\n327\t            self.full_bw = self.max_bw;\n328\t            self.full_bw_count = 0;\n329\t            if rs.ecn_frac < 0.2 {\n330\t                return;\n331\t            }\n332\t        }\n333\t        self.full_bw_count += 1; // another round without much growth\n334\t        if self.full_bw_count >= 3 || rs.ecn_frac >= BBR_EXCESSIVE_ECN_CE {\n335\t            self.filled_pipe = true;\n336\t        }\n337\t    }\n338\t\n339\t    /// C: `BBRCheckAppLimitedEnded` (picoquic/bbr.c:1747)\n340\t    ///\n341\t    /// Tracks per-round app-limited state.  Returns `true` on the first\n342\t    /// round where the app is *not* limited after having been limited for\n343\t    /// more than `BBR_APP_LIMITED_ROUNDS_THRESHOLD` consecutive rounds.\n344\t    pub fn check_app_limited_ended(&mut self, rs: &BbrPerAckState) -> bool {\n345\t        let mut app_limited_ended = false;\n346\t        if self.round_start {\n347\t            if self.app_limited_this_round != 0 {\n348\t                self.app_limited_round_count += 1;\n349\t            } else {\n350\t                app_limited_ended = self.app_limited_round_count > BBR_APP_LIMITED_ROUNDS_THRESHOLD;\n351\t                self.app_limited_round_count = 0;\n352\t            }\n353\t            self.app_limited_this_round = 0;\n354\t        } else {\n355\t            self.app_limited_this_round |= rs.is_app_limited as i32;\n356\t        }\n357\t        app_limited_ended\n358\t    }\n359\t\n360\t    /// C: `BBRExitLostFeedback` (picoquic/bbr.c:782)\n361\t    ///\n362\t    /// Restore the congestion window saved by `BBREnterLostFeedback` and\n363\t    /// clear the lost-feedback flag.  No-op if the flag is not set.\n364\t    pub fn exit_lost_feedback(&mut self, path_x: &mut Path) {\n365\t        if self.is_handling_lost_feedback {\n366\t            path_x.cwin = self.cwin_before_lost_feedback;\n367\t            self.is_handling_lost_feedback = false;\n368\t        }\n369\t    }\n370\t\n371\t    /// C: `BBRHasElapsedInPhase` (picoquic/bbr.c:1776)\n372\t    ///\n373\t    /// Returns `true` when `current_time` has advanced past\n374\t    /// `cycle_stamp + interval`.  Used to decide when to transition from\n375\t    /// DOWN/CRUISE to REFILL in the probe-BW cycle.\n376\t    pub(crate) fn has_elapsed_in_phase(&self, interval: u64, current_time: u64) -> bool {\n377\t        current_time > self.cycle_stamp + interval\n378\t    }\n379\t\n380\t    /// C: `BBREnterStartupResume` (picoquic/bbr.c:1972)\n381\t    ///\n382\t    /// Enter `StartupResume` state, which uses Hystart-like pacing gains\n383\t    /// to resume quickly after a suspension.  Called either when a BDP\n384\t    /// seed is set or on the initial `EnterStartup` path when a seed\n385\t    /// exists.\n386\t    pub(crate) fn enter_startup_resume(&mut self) {\n387\t        self.state = BbrAlgState::StartupResume;\n388\t        self.pacing_gain = BBR_STARTUP_RESUME_PACING_GAIN;\n389\t        self.cwnd_gain = BBR_STARTUP_RESUME_CWND_GAIN;\n390\t    }\n391\t\n392\t    /// C: `BBREnterStartup` (picoquic/bbr.c:2061)\n393\t    ///\n394\t    /// Enter normal `Startup` state with the standard pacing and cwnd\n395\t    /// gains.  Sets `is_cca_probing_up` to inform the transport that the\n396\t    /// congestion controller is actively probing for more bandwidth.\n397\t    pub fn enter_startup(&mut self, path_x: &mut Path) {\n398\t        self.state = BbrAlgState::Startup;\n399\t        self.pacing_gain = BBR_STARTUP_PACING_GAIN;"}]},"parent_tool_use_id":null,"session_id":"87cac919-fa51-4116-b1f6-b9ae33184f52","uuid":"49f6b170-9ac2-4514-9ff9-5cc3a3348803","timestamp":"2026-05-07T10:24:42.554Z","tool_use_result":{"type":"text","file":{"filePath":"/Users/richbarn/Projects/picoquic/rs/fq/src/bbr.rs","content":"//\n// Type deviations from C:\n//   * single-bit `unsigned int x : 1` bitfields → `bool`\n//   * non-negative `int` counters → `u32`\n//   * `char const* option_string` → `Option<String>` (owned copy)\n//   * `picoquic_min_max_rtt_t rtt_filter` → `MinMaxRtt`\n//   * fixed arrays keep their C dimensions as Rust `[T; N]`\n\npub struct BbrState {\n    pub state: BbrAlgState,\n    pub round_start_pn: u64,\n    pub round_count: u32,\n    pub rounds_since_probe: u32,\n    pub round_start: bool,\n    pub next_round_delivered: u64,\n\n    pub pacing_rate: f64,\n    pub send_quantum: u64,\n    pub prior_cwnd: u64,\n\n    pub pacing_gain: f64,\n    pub next_departure_time: u64,\n\n    pub cwnd_gain: f64,\n    pub packet_conservation: bool,\n\n    pub max_bw: u64,\n    pub bw_hi: u64,\n    pub bw_lo: u64,\n    pub bw: u64,\n\n    // min_rtt uses u64::MAX as the sentinel \"no valid sample yet\".\n    pub min_rtt: u64,\n\n    // RTT jitter buffer (C: #ifdef RTTJitterBuffer, always enabled).\n    pub rtt_jitter_buffer: [u64; BBR_RTT_JITTER_BUFFER_LEN],\n    pub rtt_jitter_cycle: u64,\n    pub rtt_short_term_min: u64,\n    pub rtt_short_term_max: u64,\n    pub last_rtt_sample_stamp: u64,\n    p