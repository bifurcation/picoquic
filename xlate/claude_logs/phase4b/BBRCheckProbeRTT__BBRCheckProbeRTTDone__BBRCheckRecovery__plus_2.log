{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01GrhirHGzFY5ttqEceMUwUg","type":"tool_result","content":"999\t    /// C: `BBRBoundCwndForModel` (picoquic/bbr.c:647)\n1000\t    ///\n1001\t    /// Cap `path_x.cwin` to the model's inflight limits.  In any ProbeBW\n1002\t    /// state other than Cruise, `inflight_hi` (when non-zero) is the ceiling.\n1003\t    /// In ProbeRtt or ProbeBwCruise the ceiling is the headroom-adjusted\n1004\t    /// `inflight_hi`.  `inflight_lo` is then applied as a secondary cap,\n1005\t    /// and finally `BBRMinPipeCwnd * MTU` is enforced as a floor.\n1006\t    pub fn bound_cwnd_for_model(&mut self, path_x: &mut Path) {\n1007\t        const BBR_MIN_PIPE_CWND: u64 = 4;\n1008\t        let mut cap = u64::MAX;\n1009\t        if self.is_in_a_probe_bw_state() && self.state != BbrAlgState::ProbeBwCruise {\n1010\t            if self.inflight_hi > 0 {\n1011\t                cap = self.inflight_hi;\n1012\t            }\n1013\t        } else if self.state == BbrAlgState::ProbeRtt || self.state == BbrAlgState::ProbeBwCruise {\n1014\t            cap = self.inflight_with_headroom(path_x);\n1015\t        }\n1016\t        if cap > self.inflight_lo {\n1017\t            cap = self.inflight_lo;\n1018\t        }\n1019\t        let floor = BBR_MIN_PIPE_CWND * path_x.send_mtu as u64;\n1020\t        if cap < floor {\n1021\t            cap = floor;\n1022\t        }\n1023\t        if path_x.cwin > cap {\n1024\t            path_x.cwin = cap;\n1025\t        }\n1026\t    }\n1027\t\n1028\t    /// C: `BBRAdvanceEcnFrac` (picoquic/bbr.c:2288)\n1029\t    ///\n1030\t    /// At the start of each new round, update `ecn_alpha` from the current\n1031\t    /// ECN fraction and latch the new ECN counters.  If the remote counters\n1032\t    /// have gone backwards (counter reset or path change) we reset alpha to\n1033\t    /// zero to avoid using stale ECN feedback.  No-op outside round starts or\n1034\t    /// when no valid ECN packet-context is available for this path.\n1035\t    pub fn advance_ecn_frac(\n1036\t        &mut self,\n1037\t        connection: &Connection,\n1038\t        path_x: &Path,\n1039\t        rs: &BbrPerAckState,\n1040\t    ) {\n1041\t        if !self.round_start {\n1042\t            return;\n1043\t        }\n1044\t        if let Some(pkt_ctx) = access_ecn_packet_context(connection, path_x) {\n1045\t            if pkt_ctx.ecn_ect1_total_remote < self.ecn_ect1_last_round\n1046\t                || pkt_ctx.ecn_ce_total_remote < self.ecn_ce_last_round\n1047\t            {\n1048\t                self.ecn_alpha = 0.0;\n1049\t            } else {\n1050\t                self.ecn_alpha = (rs.ecn_frac + 15.0 * self.ecn_alpha) / 16.0;\n1051\t            }\n1052\t            self.ecn_ect1_last_round = pkt_ctx.ecn_ect1_total_remote;\n1053\t            self.ecn_ce_last_round = pkt_ctx.ecn_ce_total_remote;\n1054\t        }\n1055\t    }\n1056\t\n1057\t    /// C: `BBRCheckPathSaturated` (picoquic/bbr.c:1699, `#ifdef RTTJitterBufferProbe`)\n1058\t    ///\n1059\t    /// Detect a saturated path during a bandwidth probe: if we are in a ProbeBW\n1060\t    /// state and the RTT has more than doubled relative to `min_rtt`, the\n1061\t    /// delivery rate is well below the pacing rate, and there is no WiFi shadow\n1062\t    /// RTT, then the path is congested.  In that case reset the bandwidth filter\n1063\t    /// to the current delivery rate, enter Drain, and start a new round.\n1064\t    /// Returns `true` when saturation was detected (caller should abort the probe).\n1065\t    pub fn check_path_saturated(\n1066\t        &mut self,\n1067\t        connection: &Connection,\n1068\t        path_x: &mut Path,\n1069\t        rs: &BbrPerAckState,\n1070\t    ) -> bool {\n1071\t        if self.is_in_a_probe_bw_state()\n1072\t            && rs.rtt_sample > 2 * self.min_rtt\n1073\t            && self.rounds_since_bw_probe >= 1\n1074\t            && self.pacing_rate > 3.0 * rs.delivery_rate as f64\n1075\t            && self.wifi_shadow_rtt == 0\n1076\t        {\n1077\t            self.prior_cwnd = rs.delivered;\n1078\t            self.probe_rtt_done_stamp = 0;\n1079\t            self.ack_phase = BbrAckPhase::ProbeStopping;\n1080\t            self.max_bw_filter[0] = rs.delivery_rate;\n1081\t            self.max_bw_filter[1] = rs.delivery_rate;\n1082\t            self.max_bw = rs.delivery_rate;\n1083\t            self.full_bw = rs.delivery_rate;\n1084\t            self.enter_drain(path_x);\n1085\t            self.start_round(connection, path_x);\n1086\t            true\n1087\t        } else {\n1088\t            false\n1089\t        }\n1090\t    }\n1091\t\n1092\t    /// React to inflight being too high: record the new inflight ceiling and,\n1093\t    /// if currently in ProbeBW-UP, transition to DOWN.\n1094\t    /// C: `BBRHandleInflightTooHigh` (picoquic/bbr.c:1174).\n1095\t    fn handle_inflight_too_high(\n1096\t        &mut self,\n1097\t        connection: &Connection,\n1098\t        path_x: &mut Path,\n1099\t        rs: &BbrPerAckState,\n1100\t        current_time: u64,\n1101\t    ) {\n1102\t        self.bw_probe_samples = 0; // only react once per bw probe\n1103\t        if !rs.is_app_limited {\n1104\t            let beta_target = (self.target_inflight(path_x) as f64 * BBR_BETA) as u64;\n1105\t            self.inflight_hi = rs.tx_in_flight.max(beta_target);\n1106\t        }\n1107\t        if self.state == BbrAlgState::ProbeBwUp {\n1108\t            self.start_probe_bw_down(connection, path_x, current_time);\n1109\t        }\n1110\t    }\n1111\t\n1112\t    /// Test whether inflight is too high and respond; returns `true` when\n1113\t    /// the inflight ceiling was triggered.\n1114\t    /// C: `CheckInflightTooHigh` (picoquic/bbr.c:1188).\n1115\t    fn check_inflight_too_high(\n1116\t        &mut self,\n1117\t        connection: &Connection,\n1118\t        path_x: &mut Path,\n1119\t        rs: &BbrPerAckState,\n1120\t        current_time: u64,\n1121\t    ) -> bool {\n1122\t        if self.is_inflight_too_high(path_x, rs) {\n1123\t            if self.bw_probe_samples != 0 {\n1124\t                self.handle_inflight_too_high(connection, path_x, rs, current_time);\n1125\t            }\n1126\t            true\n1127\t        } else {\n1128\t            false\n1129\t        }\n1130\t    }\n1131\t\n1132\t    /// Increase `inflight_hi` when the congestion window is cwnd-limited and\n1133\t    /// we are in ProbeBW-UP.  Called when loss rate is safe.\n1134\t    /// C: `BBRProbeInflightHiUpward` (picoquic/bbr.c:1571).\n1135\t    pub(crate) fn probe_inflight_hi_upward(&mut self, path_x: &Path, rs: &BbrPerAckState) {\n1136\t        if !rs.is_cwnd_limited || path_x.cwin < self.inflight_hi {\n1137\t            return; // not fully using inflight_hi, so don't grow it\n1138\t        }\n1139\t        self.bw_probe_up_acks += rs.newly_acked;\n1140\t        if self.bw_probe_up_acks >= self.bw_probe_up_cnt as u64 * path_x.send_mtu as u64 {\n1141\t            let delta = self.bw_probe_up_acks / self.bw_probe_up_cnt as u64;\n1142\t            self.bw_probe_up_acks -= delta * self.bw_probe_up_cnt as u64;\n1143\t            self.inflight_hi += delta;\n1144\t        }\n1145\t        if self.round_start {\n1146\t            self.raise_inflight_hi_slope(path_x);\n1147\t        }\n1148\t    }\n1149\t\n1150\t    /// Track ACK state and adjust `inflight_hi` and `bw_hi` upper bounds.\n1151\t    /// C: `BBRAdaptUpperBounds` (picoquic/bbr.c:1589).\n1152\t    pub fn adapt_upper_bounds(\n1153\t        &mut self,\n1154\t        connection: &Connection,\n1155\t        path_x: &mut Path,\n1156\t        rs: &BbrPerAckState,\n1157\t        current_time: u64,\n1158\t    ) {\n1159\t        if self.ack_phase == BbrAckPhase::ProbeStarting && self.round_start {\n1160\t            self.ack_phase = BbrAckPhase::ProbeFeedback;\n1161\t        }\n1162\t        if self.ack_phase == BbrAckPhase::ProbeStopping\n1163\t            && self.round_start\n1164\t            && self.is_in_a_probe_bw_state()\n1165\t            && !rs.is_app_limited\n1166\t        {\n1167\t            self.advance_max_bw_filter();\n1168\t        }\n1169\t        if !self.check_inflight_too_high(connection, path_x, rs, current_time) {\n1170\t            // Loss rate is safe.  Adjust upper bounds upward.\n1171\t            if self.inflight_hi == u64::MAX || self.bw_hi == u64::MAX {\n1172\t                return; // no upper bounds to raise\n1173\t            }\n1174\t            if rs.tx_in_flight > self.inflight_hi {\n1175\t                self.inflight_hi = rs.tx_in_flight;\n1176\t            }\n1177\t            if rs.delivery_rate > self.bw_hi {\n1178\t                self.bw_hi = rs.delivery_rate;\n1179\t            }\n1180\t            if self.state == BbrAlgState::ProbeBwUp {\n1181\t                self.probe_inflight_hi_upward(path_x, rs);\n1182\t            }\n1183\t        }\n1184\t    }\n1185\t}\n1186\t\n1187\t/// C: `BBRAccessEcnPacketContext` (picoquic/bbr.c:2245)\n1188\t///\n1189\t/// Return the packet-context that carries ECN counts for `path_x`.\n1190\t///\n1191\t/// Under multipath each path has its own context; under single-path\n1192\t/// only the default path (`unique_path_id == 0`, corresponding to\n1193\t/// `cnx->path[0]` in C) participates in ECN tracking — other paths\n1194\t/// return `None`.\n1195\t///\n1196\t/// Note: in C the path held a back-pointer to its connection\n1197\t/// (`path_x->cnx`); in Rust there is no back-pointer, so the caller\n1198\t/// must supply both `connection` and `path_x`.\n1199\tpub fn access_ecn_packet_context<'a>(\n1200\t    connection: &'a Connection,\n1201\t    path_x: &'a Path,\n1202\t) -> Option<&'a PacketContextState> {\n1203\t    if connection.is_multipath_enabled {\n1204\t        Some(&path_x.pkt_ctx)\n1205\t    } else if path_x.unique_path_id != 0 {\n1206\t        // Non-default path in single-path mode: ECN counts are not\n1207\t        // tracked per-path here; the caller should use the default path.\n1208\t        None\n1209\t    } else {\n1210\t        Some(&connection.pkt_ctx[PacketContext::Application as usize])\n1211\t    }\n1212\t}\n1213\t\n1214\t/// C: `BBRSetRsFromAckState` (picoquic/bbr.c:2363)\n1215\t///\n1216\t/// Convert the `PerAckState` delivered by picoquic's ACK-processing\n1217\t/// layer into the `BbrPerAckState` (\"rs\") struct used throughout BBRv3.\n1218\t/// Delivery rate is taken from the path's bandwidth estimate when\n1219\t/// available; otherwise it is derived from bytes-delivered / RTT; as a\n1220\t/// last resort a 40 kBps floor is used.\n1221\tpub fn set_rs_from_ack_state(path_x: &Path, ack_state: &PerAckState) -> BbrPerAckState {\n1222\t    let delivery_rate = if path_x.bandwidth_estimate > 0 {\n1223\t        path_x.bandwidth_estimate\n1224\t    } else if ack_state.rtt_measurement.ticks() > 0 {\n1225\t        rate_from_bytes(\n1226\t            ack_state.nb_bytes_delivered_since_packet_sent,\n1227\t            ack_state.rtt_measurement.ticks(),\n1228\t        )\n1229\t    } else {\n1230\t        40_000\n1231\t    };\n1232\t    BbrPerAckState {\n1233\t        delivery_rate,\n1234\t        delivered: ack_state.nb_bytes_delivered_since_packet_sent,\n1235\t        rtt_sample: path_x.rtt_sample.ticks(),\n1236\t        newly_acked: ack_state.nb_bytes_acknowledged,\n1237\t        newly_lost: ack_state.nb_bytes_newly_lost,\n1238\t        lost: ack_state.nb_bytes_lost_since_packet_sent,\n1239\t        tx_in_flight: ack_state.inflight_prior,\n1240\t        is_app_limited: ack_state.is_app_limited,\n1241\t        is_cwnd_limited: ack_state.is_cwnd_limited,\n1242\t        ..BbrPerAckState::default()\n1243\t    }\n1244\t}\n1245\t\n1246\t/// C: `update_windowed_max_filter` (picoquic/bbr.c:381)\n1247\t///\n1248\t/// Update slot `cycle % filter_len` of `filter` to be the max of its\n1249\t/// current value and `v`, then return the maximum across all slots.\n1250\t/// Used to maintain the `MaxBwFilter` and `ExtraAckedFilter` windows.\n1251\tpub fn update_windowed_max_filter(\n1252\t    filter: &mut [u64],\n1253\t    v: u64,\n1254\t    cycle: u32,\n1255\t    filter_len: usize,\n1256\t) -> u64 {\n1257\t    let idx = (cycle as usize) % filter_len;\n1258\t    if filter[idx] < v {\n1259\t        filter[idx] = v;\n1260\t    }\n1261\t    let mut result = v;\n1262\t    for &slot in &filter[..filter_len] {\n1263\t        if slot > result {\n1264\t            result = slot;\n1265\t        }\n1266\t    }\n1267\t    result\n1268\t}\n1269\t\n1270\t/// C: `start_windowed_max_filter_period` (picoquic/bbr.c:394)\n1271\t///\n1272\t/// Begin a new filter period by zeroing the slot for the current cycle,\n1273\t/// so old values from `filter_len` cycles ago are overwritten.\n1274\tpub fn start_windowed_max_filter_period(filter: &mut [u64], cycle: u32, filter_len: usize) {\n1275\t    filter[(cycle as usize) % filter_len] = 0;\n1276\t}\n1277\t\n1278\t/// C: `update_windowed_min_filter` (picoquic/bbr.c:399)\n1279\t///\n1280\t/// Write `v` into slot `cycle % filter_len`, then return the minimum\n1281\t/// across all slots.  Unlike the max variant this always stores `v`\n1282\t/// (not the max of the existing slot and `v`).\n1283\tpub fn update_windowed_min_filter(\n1284\t    filter: &mut [u64],\n1285\t    v: u64,\n1286\t    cycle: u32,\n1287\t    filter_len: usize,\n1288\t) -> u64 {\n1289\t    filter[(cycle as usize) % filter_len] = v;\n1290\t    let mut result = v;\n1291\t    for &slot in &filter[..filter_len] {\n1292\t        if slot < result {\n1293\t            result = slot;\n1294\t        }\n1295\t    }\n1296\t    result\n1297\t}\n1298\t"}]},"parent_tool_use_id":null,"session_id":"87cac919-fa51-4116-b1f6-b9ae33184f52","uuid":"b239f79a-8bf5-4083-87fe-fc059071cc93","timestamp":"2026-05-07T10:25:03.318Z","tool_use_result":{"type":"text","file":{"filePath":"/Users/richbarn/Projects/picoquic/rs/fq/src/bbr.rs","content":"    /// C: `BBRBoundCwndForModel` (picoquic/bbr.c:647)\n    ///\n    /// Cap `path_x.cwin` to the model's inflight limits.  In any ProbeBW\n    /// state other than Cruise, `inflight_hi` (when non-zero) is the ceiling.\n    /// In ProbeRtt or ProbeBwCruise the ceiling is the headroom-adjusted\n    /// `inflight_hi`.  `inflight_lo` is then applied as a secondary cap,\n    /// and finally `BBRMinPipeCwnd * MTU` is enforced as a floor.\n    pub fn bound_cwnd_for_model(&mut self, path_x: &mut Path) {\n        const BBR_MIN_PIPE_CWND: u64 = 4;\n        let mut cap = u64::MAX;\n        if self.is_in_a_probe_bw_state() && self.state != BbrAlgState::ProbeBwCruise {\n            if self.inflight_hi > 0 {\n                cap = self.inflight_hi;\n            }\n        } else if self.state == BbrAlgState::ProbeRtt || self.state == BbrAlgState::ProbeBwCruise {\n            cap = self.inflight_with_headroom(path_x);\n        }\n        if cap > self.inflight_lo {\n            cap = self.inflight_lo;\n        }\n        let floor = BBR_MIN_PIPE_CWND * path_x.send_mtu as u64;\n        if cap < floor {\n            cap = floor;\n        }\n        if path_x.cwin > cap {\n            path_x.cwin = cap;\n        }\n    }\n\n    /// C: `BBRAdvanceEcnFrac` (picoquic/bbr.c:2288)\n    ///\n    /// At the start of each new round, update `ecn_alpha` from the current\n    /// ECN fraction and latch the new ECN counters.  If the remote counters\n    /// have gone backwards (counter reset or path change) we reset alpha to\n    /// zero to avoid using stale ECN feedback.  No-op outside round starts or\n    /// when no valid ECN packet-context is available for this path.\n    pub fn advance_ecn_frac(\n        &mut self,\n        connection: &Connection,\n        path_x: &Path,\n        rs: &BbrPerAckState,\n    ) {\n        if !self.round_start {\n            return;\n        }\n        if let Some(pkt_ctx) = access_ecn_packet_context(connection, path_x) {\n            if pkt_ctx.ecn_ect1_total_remote < self.ecn_ect1_last_round\n                || pkt_ctx.ecn_ce_total_remote < self.ecn_ce_last_round\n            {\n                self.ecn_alpha = 0.0;\n            } else {\n                self.ecn_alpha = (rs.ecn_frac + 15.0 * self.ecn_alpha) / 16.0;\n            }\n            self.ecn_ect1_last_round = pkt_ctx.ecn_ect1_total_remote;\n            self.ecn_ce_last_round = pkt_ctx.ecn_ce_total_remote;\n        }\n    }\n\n    /// C: `BBRCheckPathSaturated` (picoquic/bbr.c:1699, `#ifdef RTTJitterBufferProbe`)\n    ///\n    /// Detect a saturated path during a bandwidth probe: if we are in a ProbeBW\n    /// state and the RTT has more than doubled relative to `min_rtt`, the\n    /// delivery rate is well below the pacing rate, and there is no WiFi shadow\n    /// RTT, then the path is congested.  In that case reset the bandwidth filter\n    /// to the current delivery rate, enter Drain, and start a new round.\n    /// Returns `true` when saturation was detected (caller should abort the probe).\n    pub fn check_path_saturated(\n        &mut self,\n        connection: &Connection,\n        path_x: &mut Path,\n        rs: &BbrPerAckState,\n    ) -> bool {\n        if self.is_in_a_probe_bw_state()\n            && rs.rtt_sample > 2 * self.min_rtt\n            && self.rounds_since_bw_probe >= 1\n            && self.pacing_rate > 3.0 * rs.delivery_rate as f64\n            && self.wifi_shadow_rtt == 0\n        {\n            self.prior_cwnd = rs.delivered;\n            self.probe_rtt_done_stamp = 0;\n            self.ack_phase = BbrAckPhase::ProbeStopping;\n            self.max_bw_filter[0] = rs.delivery_rate;\n            self.max_bw_filter[1] = rs.delivery_rate;\n            self.max_bw = rs.delivery_rate;\n            self.full_bw = rs.delivery_rate;\n            self.enter_drain(path_x);\n            self.start_round(connection, path_x);\n            true\n        } else {\n            false\n        }\n    }\n\n    /// React to inflight being too high: record the new inflight ceiling and,\n    /// if currently in ProbeBW-UP, transition to DOWN.\n    /// C: `BBRHandleInflightTooHigh` (picoquic/bbr.c:1174).\n    fn handle_inflight_too_high(\n        &mut self,\n        connection: &Connection,\n        path_x: &mut Path,\n        rs: &BbrPerAckState,\n        current_time: u64,\n    ) {\n        self.bw_probe_samples = 0; // only react once per bw probe\n        if !rs.is_app_limited {\n            let beta_target = (self.target_inflight(path_x) as f64 * BBR_BETA) as u64;\n            self.inflight_hi = rs.tx_in_flight.max(beta_target);\n        }\n        if self.state == BbrAlgState::ProbeBwUp {\n            self.start_probe_bw_down(connection, path_x, current_time);\n        }\n    }\n\n    /// Test whether inflight is too high and respond; returns `true` when\n    /// the inflight ceiling was triggered.\n    /// C: `CheckInflightTooHigh` (picoquic/bbr.c:1188).\n    fn check_inflight_too_high(\n        &mut self,\n        connection: &Connection,\n        path_x: &mut Path,\n        rs: &BbrPerAckState,\n        current_time: u64,\n    ) -> bool {\n        if self.is_inflight_too_high(path_x, rs) {\n            if self.bw_probe_samples != 0 {\n                self.handle_inflight_too_high(connection, path_x, rs, current_time);\n            }\n            true\n        } else {\n            false\n        }\n    }\n\n    /// Increase `inflight_hi` when the congestion window is cwnd-limited and\n    /// we are in ProbeBW-UP.  Called when loss rate is safe.\n    /// C: `BBRProbeInflightHiUpward` (picoquic/bbr.c:1571).\n    pub(crate) fn probe_inflight_hi_upward(&mut self, path_x: &Path, rs: &BbrPerAckState) {\n        if !rs.is_cwnd_limited || path_x.cwin < self.inflight_hi {\n            return; // not fully using inflight_hi, so don't grow it\n        }\n        self.bw_probe_up_acks += rs.newly_acked;\n        if self.bw_probe_up_acks >= self.bw_probe_up_cnt as u64 * path_x.send_mtu as u64 {\n            let delta = self.bw_probe_up_acks / self.bw_probe_up_cnt as u64;\n            self.bw_probe_up_acks -= delta * self.bw_probe_up_cnt as u64;\n            self.inflight_hi += delta;\n        }\n        if self.round_start {\n            self.raise_inflight_hi_slope(path_x);\n        }\n    }\n\n    /// Track ACK state and adjust `inflight_hi` and `bw_hi` upper bounds.\n    /// C: `BBRAdaptUpperBounds` (picoquic/bbr.c:1589).\n    pub fn adapt_upper_bounds(\n        &mut self,\n        connection: &Connection,\n        path_x: &mut Path,\n        rs: &BbrPerAckState,\n        current_time: u64,\n    ) {\n        if self.ack_phase == BbrAckPhase::ProbeStarting && self.round_start {\n            self.ack_phase = BbrAckPhase::ProbeFeedback;\n        }\n        if self.ack_phase == BbrAckPhase::ProbeStopping\n            && self.round_start\n            && self.is_in_a_probe_bw_state()\n            && !rs.is_app_limited\n        {\n            self.advance_max_bw_filter();\n        }\n        if !self.check_inflight_too_high(connection, path_x, rs, current_time) {\n            // Loss rate is safe.  Adjust upper bounds upward.\n            if self.inflight_hi == u64::MAX || self.bw_hi == u64::MAX {\n                return; // no upper bounds to raise\n            }\n            if rs.tx_in_flight > self.inflight_hi {\n                self.inflight_hi = rs.tx_in_flight;\n            }\n            if rs.delivery_rate > self.bw_hi {\n                self.bw_hi = rs.delivery_rate;\n            }\n            if self.state == BbrAlgState::ProbeBwUp {\n                self.probe_inflight_hi_upward(path_x, rs);\n            }\n        }\n    }\n}\n\n/// C: `BBRAccessEcnPacketContext` (picoquic/bbr.c:2245)\n///\n/// Return the packet-context that carries ECN counts for `path_x`.\n///\n/// Under multipath each path has its own context; under single-path\n/// only the default path (`unique_path_id == 0`, corresponding to\n/// `cnx->path[0]` in C) participates in ECN tracking — other paths\n/// return `None`.\n///\n/// Note: in C the path held a back-pointer to its connection\n/// (`path_x->cnx`); in Rust there is no back-pointer, so the caller\n/// must supply both `connection` and `path_x`.\npub fn access_ecn_packet_context<'a>(\n    connection: &'a Connection,\n    path_x: &'a Path,\n) -> Option<&'a PacketContextState> {\n    if connection.is_multipath_enabled {\n        Some(&path_x.pkt_ctx)\n    } else if path_x.unique_path_id != 0 {\n        // Non-default path in single-path mode: ECN counts are not\n        // tracked per-path here; the caller should use the default path.\n        None\n    } else {\n        Some(&connection.pkt_ctx[PacketContext::Application as usize])\n    }\n}\n\n/// C: `BBRSetRsFromAckState` (picoquic/bbr.c:2363)\n///\n/// Convert the `PerAckState` delivered by picoquic's ACK-processing\n/// layer into the `BbrPerAckState` (\"rs\") struct used throughout BBRv3.\n/// Delivery rate is taken from the path's bandwidth estimate when\n/// available; otherwise it is derived from bytes-delivered / RTT; as a\n/// last resort a 40 kBps floor is used.\npub fn set_rs_from_ack_state(path_x: &Path, ack_state: &PerAckState) -> BbrPerAckState {\n    let delivery_rate = if path_x.bandwidth_estimate > 0 {\n        path_x.bandwidth_estimate\n    } else if ack_state.rtt_measurement.ticks() > 0 {\n        rate_from_bytes(\n            ack_state.nb_bytes_delivered_since_packet_sent,\n            ack_state.rtt_measurement.ticks(),\n        )\n    } else {\n        40_000\n    };\n    BbrPerAckState {\n        delivery_rate,\n        delivered: ack_state.nb_bytes_delivered_since_packet_sent,\n        rtt_sample: path_x.rtt_sample.ticks(),\n        newly_acked: ack_state.nb_bytes_acknowledged,\n        newly_lost: ack_state.nb_bytes_newly_lost,\n        lost: ack_state.nb_bytes_lost_since_packet_sent,\n        tx_in_flight: ack_state.inflight_prior,\n        is_app_limited: ack_state.is_app_limited,\n        is_cwnd_limited: ack_state.is_cwnd_limited,\n        ..BbrPerAckState::default()\n    }\n}\n\n/// C: `update_windowed_max_filter` (picoquic/bbr.c:381)\n///\n/// Update slot `cycle % filter_len` of `filter` to be the max of its\n/// current value and `v`, then return the maximum across all slots.\n/// Used to maintain the `MaxBwFilter` and `ExtraAckedFilter` windows.\npub fn update_windowed_max_filter(\n    filter: &mut [u64],\n    v: u64,\n    cycle: u32,\n    filter_len: usize,\n) -> u64 {\n    let idx = (cycle as usize) % filter_len;\n    if filter[idx] < v {\n        filter[idx] = v;\n    }\n    let mut result = v;\n    for &slot in &filter[..filter_len] {\n        if slot > result {\n            result = slot;\n        }\n    }\n    result\n}\n\n/// C: `start_windowed_max_filter_period` (picoquic/bbr.c:394)\n///\n/// Begin a new filter period by zeroing the slot for the current cycle,\n/// so old values from `filter_len` cycles ago are overwritten.\npub fn start_windowed_max_filter_period(filter: &mut [u64], cycle: u32, filter_len: usize) {\n    filter[(cycle as usize) % filter_len] = 0;\n}\n\n/// C: `update_windowed_min_filter` (picoquic/bbr.c:399)\n///\n/// Write `v` into slot `cycle % filter_len`, then return the minimum\n/// across all slots.  Unlike the max variant this always stores `v`\n/// (not the max of the existing slot and `v`).\npub fn update_windowed_min_filter(\n    filter: &mut [u64],\n    v: u64,\n    cycle: u32,\n    filter_len: usize,\n) -> u64 {\n    filter[(cycle as usize) % filter_len] = v;\n    let mut result = v;\n    for &slot in &filter[..filter_len] {\n        if slot < result {\n            result = slot;\n        }\n    }\n    result\n}\n","numLines":300,"startLine":999,"totalLines":1772}}}
