{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01QSBhjJddHd3rHGYk1CDZV1","type":"tool_result","content":"673\tstatic uint64_t BBRProbeRTTCwnd(picoquic_bbr_state_t* bbr_state, picoquic_path_t* path_x)\n674\t{\n675\t    uint64_t probe_rtt_cwnd = BBRBDPMultiple( bbr_state, path_x, BBRProbeRTTCwndGain);\n676\t    if (probe_rtt_cwnd < BBRMinPipeCwnd * path_x->send_mtu) {\n677\t        probe_rtt_cwnd = BBRMinPipeCwnd * path_x->send_mtu;\n678\t    }\n679\t    return probe_rtt_cwnd;\n680\t}\n681\t\n682\tstatic void BBRBoundCwndForProbeRTT(picoquic_bbr_state_t* bbr_state, picoquic_path_t* path_x)\n683\t{\n684\t    if (bbr_state->state == picoquic_bbr_alg_probe_rtt) {\n685\t        uint64_t cap = BBRProbeRTTCwnd(bbr_state, path_x);\n686\t        if (path_x->cwin > cap) {\n687\t            path_x->cwin = cap;\n688\t        }\n689\t    }\n690\t}\n691\t\n692\tstatic void BBRSetCwnd(picoquic_bbr_state_t* bbr_state, picoquic_path_t* path_x, bbr_per_ack_state_t * rs)\n693\t{\n694\t    BBRUpdateMaxInflight(bbr_state, path_x);\n695\t    /* TODO: check whether this should be done in every state */\n696\t    BBRModulateCwndForRecovery(bbr_state, path_x, rs);\n697\t    if (!bbr_state->packet_conservation) {\n698\t        if (bbr_state->filled_pipe) {\n699\t            path_x->cwin += rs->newly_acked;\n700\t            if (path_x->cwin > bbr_state->max_inflight) {\n701\t                path_x->cwin = bbr_state->max_inflight;\n702\t            }\n703\t        }\n704\t        else if (bbr_state->state == picoquic_bbr_alg_startup_resume &&\n705\t            bbr_state->bdp_seed > path_x->cwin) {\n706\t            path_x->cwin = bbr_state->bdp_seed;\n707\t        }\n708\t        else if (path_x->cwin < bbr_state->max_inflight || path_x->delivered < PICOQUIC_CWIN_INITIAL) {\n709\t            path_x->cwin = path_x->cwin+ rs->newly_acked;\n710\t        }\n711\t        if (path_x->cwin < BBRMinPipeCwnd * path_x->send_mtu) {\n712\t            path_x->cwin = BBRMinPipeCwnd * path_x->send_mtu;\n713\t        }\n714\t    }\n715\t    BBRBoundCwndForProbeRTT(bbr_state, path_x);\n716\t    BBRBoundCwndForModel(bbr_state, path_x);\n717\t}\n718\t\n719\t\n720\tstatic uint64_t BBRSaveCwnd(picoquic_bbr_state_t* bbr_state, picoquic_path_t* path_x)\n721\t{\n722\t\n723\t    if ( !InLossRecovery(bbr_state) && bbr_state->state != picoquic_bbr_alg_probe_rtt) {\n724\t        return path_x->cwin;\n725\t    }\n726\t    else {\n727\t        if (bbr_state->prior_cwnd > path_x->cwin) {\n728\t            return bbr_state->prior_cwnd;\n729\t        }\n730\t        else {\n731\t            return path_x->cwin;\n732\t        }\n733\t    }\n734\t}\n735\t\n736\tstatic uint64_t BBRRestoreCwnd(picoquic_bbr_state_t* bbr_state, picoquic_path_t* path_x)\n737\t{\n738\t    if (bbr_state->prior_cwnd > path_x->cwin) {\n739\t        return bbr_state->prior_cwnd;\n740\t    }\n741\t    else {\n742\t        return path_x->cwin;\n743\t    }\n744\t}\n745\t\n746\t/* \n747\t* Entering recovery sets the \"packet_conservation\" bit on.\n748\t* It is reset to 0 after one round trip. \n749\t */\n750\tstatic void BBROnEnterFastRecovery(picoquic_bbr_state_t* bbr_state, picoquic_path_t* path_x, bbr_per_ack_state_t * rs)\n751\t{\n752\t    bbr_state->prior_cwnd = BBRSaveCwnd(bbr_state, path_x);\n753\t    uint64_t additional_cwnd = path_x->send_mtu;\n754\t    if (rs->newly_acked > additional_cwnd) {\n755\t        additional_cwnd = rs->newly_acked;\n756\t    }\n757\t    path_x->cwin = path_x->bytes_in_transit + additional_cwnd;\n758\t    bbr_state->recovery_packet_number = picoquic_cc_get_sequence_number(path_x->cnx, path_x);\n759\t    bbr_state->packet_conservation = 1;\n760\t    bbr_state->is_in_recovery = 1;\n761\t    bbr_state->is_pto_recovery = 0;\n762\t    bbr_state->recovery_delivered = path_x->delivered;\n763\t}\n764\t\n765\t/* Handling of the \"lost feedback\" state.\n766\t */\n767\tstatic void BBREnterLostFeedback(picoquic_bbr_state_t* bbr_state, picoquic_path_t* path_x)\n768\t{\n769\t    if ((IsInAProbeBWState(bbr_state) || bbr_state->state == picoquic_bbr_alg_drain) &&\n770\t        !bbr_state->is_handling_lost_feedback &&\n771\t        path_x->cnx->cnx_state == picoquic_state_ready) {\n772\t        /* Remembering the old cwin, so the state can be restored when the\n773\t        * condition is lifted. */\n774\t        bbr_state->cwin_before_lost_feedback = path_x->cwin;\n775\t        /* setting the congestion window to exactly the bytes in transit, thus\n776\t         * preventing any further transmission until the condition is lifted */\n777\t        path_x->cwin = path_x->bytes_in_transit;\n778\t        bbr_state->is_handling_lost_feedback = 1;\n779\t    }\n780\t}\n781\t\n782\tstatic void BBRExitLostFeedback(picoquic_bbr_state_t* bbr_state, picoquic_path_t* path_x)\n783\t{\n784\t    if (bbr_state->is_handling_lost_feedback) {\n785\t        path_x->cwin = bbr_state->cwin_before_lost_feedback;\n786\t        bbr_state->is_handling_lost_feedback = 0;\n787\t    }\n788\t}\n789\t\n790\t/* In picoquic, the arrival of an RTO maps to a \"timer based\" packet loss.\n791\t* Question: do we want this on a loss signal, or simply when observing\n792\t* loss data in ack notification?\n793\t */\n794\tstatic void BBROnEnterRTO(picoquic_bbr_state_t* bbr_state, picoquic_path_t* path_x, uint64_t lost_packet_number)\n795\t{\n796\t    if (!bbr_state->is_in_recovery) {\n797\t        bbr_state->prior_cwnd = BBRSaveCwnd(bbr_state, path_x);\n798\t        bbr_state->is_in_recovery = 1;\n799\t    }\n800\t    if (!bbr_state->is_pto_recovery) {\n801\t        path_x->cwin = path_x->bytes_in_transit + path_x->send_mtu;\n802\t        bbr_state->recovery_packet_number = lost_packet_number;\n803\t        bbr_state->is_pto_recovery = 1;\n804\t        bbr_state->recovery_delivered = path_x->delivered;\n805\t    }\n806\t}\n807\t\n808\t/* Exit loss recovery\n809\t* Could be either on end of the recovery period,\n810\t* or in the case of PTO if the loss is declared spurious.\n811\t*/\n812\tstatic void BBROnExitRecovery(picoquic_bbr_state_t* bbr_state, picoquic_path_t* path_x, uint64_t current_time)\n813\t{\n814\t    if (bbr_state->is_in_recovery) {\n815\t        path_x->bandwidth_estimate_max = 0;\n816\t        path_x->cwin = BBRRestoreCwnd(bbr_state, path_x);\n817\t        bbr_state->recovery_packet_number = UINT64_MAX;\n818\t        bbr_state->packet_conservation = 0;\n819\t\n820\t        if (bbr_state->is_pto_recovery && BBRExpTest(bbr_state, do_handle_suspension)) {\n821\t            /* TODO:\n822\t             * we should try to enter startup with a high enough BW. However, \n823\t             * simple attempts to restore the BW parameters have proven ineffective.\n824\t             */\n825\t            BBRReEnterStartup(bbr_state, path_x);\n826\t        }\n827\t        else if(bbr_state->state == picoquic_bbr_alg_probe_bw_up) {\n828\t            /* Perform same processing as after encountering a high loss */\n829\t            BBRStartProbeBW_DOWN(bbr_state, path_x, current_time);\n830\t        }\n831\t        bbr_state->recovery_delivered = path_x->delivered;\n832\t        bbr_state->is_in_recovery = 0;\n833\t        bbr_state->is_pto_recovery = 0;\n834\t        /* Reset the RTT time stamp, to avoid going into probe RTT during loss events */\n835\t        bbr_state->probe_rtt_min_stamp = current_time;\n836\t        bbr_state->min_rtt_stamp = current_time;\n837\t    }\n838\t}\n839\t\n840\tstatic void BBROnSpuriousLoss(picoquic_bbr_state_t* bbr_state, picoquic_path_t* path_x, uint64_t lost_packet_number, uint64_t current_time)\n841\t{\n842\t    if (bbr_state->recovery_packet_number <= lost_packet_number && bbr_state->is_pto_recovery) {\n843\t        BBROnExitRecovery(bbr_state, path_x, current_time);\n844\t    }\n845\t}\n846\t\n847\tstatic int InLossRecovery(picoquic_bbr_state_t* bbr_state)"}]},"parent_tool_use_id":null,"session_id":"87cac919-fa51-4116-b1f6-b9ae33184f52","uuid":"bbb2b5d3-7544-4a06-8628-58bc997fbe47","timestamp":"2026-05-07T10:25:17.655Z","tool_use_result":{"type":"text","file":{"filePath":"/Users/richbarn/Projects/picoquic/picoquic/bbr.c","content":"static uint64_t BBRProbeRTTCwnd(picoquic_bbr_state_t* bbr_state, picoquic_path_t* path_x)\n{\n    uint64_t probe_rtt_cwnd = BBRBDPMultiple( bbr_state, path_x, BBRProbeRTTCwndGain);\n    if (probe_rtt_cwnd < BBRMinPipeCwnd * path_x->send_mtu) {\n        probe_rtt_cwnd = BBRMinPipeCwnd * path_x->send_mtu;\n    }\n    return probe_rtt_cwnd;\n}\n\nstatic void BBRBoundCwndForProbeRTT(picoquic_bbr_state_t* bbr_state, picoquic_path_t* path_x)\n{\n    if (bbr_state->state == picoquic_bbr_alg_probe_rtt) {\n        uint64_t cap = BBRProbeRTTCwnd(bbr_state, path_x);\n        if (path_x->cwin > cap) {\n            path_x->cwin = cap;\n        }\n    }\n}\n\nstatic void BBRSetCwnd(picoquic_bbr_state_t* bbr_state, picoquic_path_t* path_x, bbr_per_ack_state_t * rs)\n{\n    BBRUpdateMaxInflight(bbr_state, path_x);\n    /* TODO: check whether this should be done in every state */\n    BBRModulateCwndForRecovery(bbr_state, path_x, rs);\n    if (!bbr_state->packet_conservation) {\n        if (bbr_state->filled_pipe) {\n            path_x->cwin += rs->newly_acked;\n            if (path_x->cwin > bbr_state->max_inflight) {\n                path_x->cwin = bbr_state->max_inflight;\n            }\n        }\n        else if (bbr_state->state == picoquic_bbr_alg_startup_resume &&\n            bbr_state->bdp_seed > path_x->cwin) {\n            path_x->cwin = bbr_state->bdp_seed;\n        }\n        else if (path_x->cwin < bbr_state->max_inflight || path_x->delivered < PICOQUIC_CWIN_INITIAL) {\n            path_x->cwin = path_x->cwin+ rs->newly_acked;\n        }\n        if (path_x->cwin < BBRMinPipeCwnd * path_x->send_mtu) {\n            path_x->cwin = BBRMinPipeCwnd * path_x->send_mtu;\n        }\n    }\n    BBRBoundCwndForProbeRTT(bbr_state, path_x);\n    BBRBoundCwndForModel(bbr_state, path_x);\n}\n\n\nstatic uint64_t BBRSaveCwnd(picoquic_bbr_state_t* bbr_state, picoquic_path_t* path_x)\n{\n\n    if ( !InLossRecovery(bbr_state) && bbr_state->state != picoquic_bbr_alg_probe_rtt) {\n        return path_x->cwin;\n    }\n    else {\n        if (bbr_state->prior_cwnd > path_x->cwin) {\n            return bbr_state->prior_cwnd;\n        }\n        else {\n            return path_x->cwin;\n        }\n    }\n}\n\nstatic uint64_t BBRRestoreCwnd(picoquic_bbr_state_t* bbr_state, picoquic_path_t* path_x)\n{\n    if (bbr_state->prior_cwnd > path_x->cwin) {\n        return bbr_state->prior_cwnd;\n    }\n    else {\n        return path_x->cwin;\n    }\n}\n\n/* \n* Entering recovery sets the \"packet_conservation\" bit on.\n* It is reset to 0 after one round trip. \n */\nstatic void BBROnEnterFastRecovery(picoquic_bbr_state_t* bbr_state, picoquic_path_t* path_x, bbr_per_ack_state_t * rs)\n{\n    bbr_state->prior_cwnd = BBRSaveCwnd(bbr_state, path_x);\n    uint64_t additional_cwnd = path_x->send_mtu;\n    if (rs->newly_acked > additional_cwnd) {\n        additional_cwnd = rs->newly_acked;\n    }\n    path_x->cwin = path_x->bytes_in_transit + additional_cwnd;\n    bbr_state->recovery_packet_number = picoquic_cc_get_sequence_number(path_x->cnx, path_x);\n    bbr_state->packet_conservation = 1;\n    bbr_state->is_in_recovery = 1;\n    bbr_state->is_pto_recovery = 0;\n    bbr_state->recovery_delivered = path_x->delivered;\n}\n\n/* Handling of the \"lost feedback\" state.\n */\nstatic void BBREnterLostFeedback(picoquic_bbr_state_t* bbr_state, picoquic_path_t* path_x)\n{\n    if ((IsInAProbeBWState(bbr_state) || bbr_state->state == picoquic_bbr_alg_drain) &&\n        !bbr_state->is_handling_lost_feedback &&\n        path_x->cnx->cnx_state == picoquic_state_ready) {\n        /* Remembering the old cwin, so the state can be restored when the\n        * condition is lifted. */\n        bbr_state->cwin_before_lost_feedback = path_x->cwin;\n        /* setting the congestion window to exactly the bytes in transit, thus\n         * preventing any further transmission until the condition is lifted */\n        path_x->cwin = path_x->bytes_in_transit;\n        bbr_state->is_handling_lost_feedback = 1;\n    }\n}\n\nstatic void BBRExitLostFeedback(picoquic_bbr_state_t* bbr_state, picoquic_path_t* path_x)\n{\n    if (bbr_state->is_handling_lost_feedback) {\n        path_x->cwin = bbr_state->cwin_before_lost_feedback;\n        bbr_state->is_handling_lost_feedback = 0;\n    }\n}\n\n/* In picoquic, the arrival of an RTO maps to a \"timer based\" packet loss.\n* Question: do we want this on a loss signal, or simply when observing\n* loss data in ack notification?\n */\nstatic void BBROnEnterRTO(picoquic_bbr_state_t* bbr_state, picoquic_path_t* path_x, uint64_t lost_packet_number)\n{\n    if (!bbr_state->is_in_recovery) {\n        bbr_state->prior_cwnd = BBRSaveCwnd(bbr_state, path_x);\n        bbr_state->is_in_recovery = 1;\n    }\n    if (!bbr_state->is_pto_recovery) {\n        path_x->cwin = path_x->bytes_in_transit + path_x->send_mtu;\n        bbr_state->recovery_packet_number = lost_packet_number;\n        bbr_state->is_pto_recovery = 1;\n        bbr_state->recovery_delivered = path_x->delivered;\n    }\n}\n\n/* Exit loss recovery\n* Could be either on end of the recovery period,\n* or in the case of PTO if the loss is declared spurious.\n*/\nstatic void BBROnExitRecovery(picoquic_bbr_state_t* bbr_state, picoquic_path_t* path_x, uint64_t current_time)\n{\n    if (bbr_state->is_in_recovery) {\n        path_x->bandwidth_estimate_max = 0;\n        path_x->cwin = BBRRestoreCwnd(bbr_state, path_x);\n        bbr_state->recovery_packet_number = UINT64_MAX;\n        bbr_state->packet_conservation = 0;\n\n        if (bbr_state->is_pto_recovery && BBRExpTest(bbr_state, do_handle_suspension)) {\n            /* TODO:\n             * we should try to enter startup with a high enough BW. However, \n             * simple attempts to restore the BW parameters have proven ineffective.\n             */\n            BBRReEnterStartup(bbr_state, path_x);\n        }\n        else if(bbr_state->state == picoquic_bbr_alg_probe_bw_up) {\n            /* Perform same processing as after encountering a high loss */\n            BBRStartProbeBW_DOWN(bbr_state, path_x, current_time);\n        }\n        bbr_state->recovery_delivered = path_x->delivered;\n        bbr_state->is_in_recovery = 0;\n        bbr_state->is_pto_recovery = 0;\n        /* Reset the RTT time stamp, to avoid going into probe RTT during loss events */\n        bbr_state->probe_rtt_min_stamp = current_time;\n        bbr_state->min_rtt_stamp = current_time;\n    }\n}\n\nstatic void BBROnSpuriousLoss(picoquic_bbr_state_t* bbr_state, picoquic_path_t* path_x, uint64_t lost_packet_number, uint64_t current_time)\n{\n    if (bbr_state->recovery_packet_number <= lost_packet_number && bbr_state->is_pto_recovery) {\n        BBROnExitRecovery(bbr_state, path_x, current_time);\n    }\n}\n\nstatic int InLossRecovery(picoquic_bbr_state_t* bbr_state)","numLines":175,"startLine":673,"totalLines":2486}}}
