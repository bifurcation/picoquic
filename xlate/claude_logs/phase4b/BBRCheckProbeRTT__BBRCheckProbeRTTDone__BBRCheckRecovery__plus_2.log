{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01CEnJN3RCmNNaANbLyRoGky","type":"tool_result","content":"700\t\n701\t    /// C: `BBRUpdateOffloadBudget` (picoquic/bbr.c:883)\n702\t    ///\n703\t    /// Set `offload_budget` to three times the current send quantum.  The\n704\t    /// offload budget reserves headroom for segmentation-offload bursts so\n705\t    /// the cwnd computation never starves TSO/GSO paths.\n706\t    pub fn update_offload_budget(&mut self) {\n707\t        self.offload_budget = 3 * self.send_quantum;\n708\t    }\n709\t\n710\t    /// C: `BBRUpdateRTTJitterBuffer` (picoquic/bbr.c:1299)\n711\t    ///\n712\t    /// Record a new RTT sample in the circular jitter buffer when at least\n713\t    /// 1 ms has elapsed since the last entry.  After inserting, recompute\n714\t    /// `rtt_short_term_min` and `rtt_short_term_max` from all valid entries\n715\t    /// so far (up to `BBR_RTT_JITTER_BUFFER_LEN`).\n716\t    pub fn update_rtt_jitter_buffer(&mut self, rs: &BbrPerAckState, current_time: u64) {\n717\t        if current_time > self.last_rtt_sample_stamp + 1000 {\n718\t            let idx = (self.rtt_jitter_cycle as usize) % BBR_RTT_JITTER_BUFFER_LEN;\n719\t            self.rtt_jitter_buffer[idx] = rs.rtt_sample;\n720\t            self.rtt_jitter_cycle += 1;\n721\t            self.last_rtt_sample_stamp = current_time;\n722\t            self.rtt_short_term_min = u64::MAX;\n723\t            self.rtt_short_term_max = 0;\n724\t            let valid = (self.rtt_jitter_cycle as usize).min(BBR_RTT_JITTER_BUFFER_LEN);\n725\t            for i in 0..valid {\n726\t                let sample = self.rtt_jitter_buffer[i];\n727\t                if sample > self.rtt_short_term_max {\n728\t                    self.rtt_short_term_max = sample;\n729\t                }\n730\t                if sample < self.rtt_short_term_min {\n731\t                    self.rtt_short_term_min = sample;\n732\t                }\n733\t            }\n734\t        }\n735\t    }\n736\t\n737\t    /// C: `BBRUpdateRecoveryOnLoss` (picoquic/bbr.c:2206)\n738\t    ///\n739\t    /// During PTO recovery, reduce `cwin` by `newly_lost` bytes, floored at\n740\t    /// two MTUs.  Only applies when at least one retransmit has occurred and\n741\t    /// we are in PTO (not fast) recovery.\n742\t    pub fn update_recovery_on_loss(&self, path_x: &mut Path, newly_lost: u64) {\n743\t        if path_x.nb_retransmit >= 1\n744\t            && self.is_in_recovery\n745\t            && self.is_pto_recovery\n746\t            && path_x.cwin > newly_lost\n747\t        {\n748\t            path_x.cwin -= newly_lost;\n749\t            let floor = 2 * path_x.send_mtu as u64;\n750\t            if path_x.cwin < floor {\n751\t                path_x.cwin = floor;\n752\t            }\n753\t        }\n754\t    }\n755\t\n756\t    /// C: `BBRSetOptions` (picoquic/bbr.c:460)\n757\t    ///\n758\t    /// Parse `option_string` to configure experimental flags and numeric\n759\t    /// parameters.  `BBRExperiment` is always enabled in this build, so all\n760\t    /// experiment flags default to `true` before any option disables them.\n761\t    ///\n762\t    /// Single-letter flags (toggle off the corresponding experiment):\n763\t    /// `E` `R` `H` `L` `D` `A`.  Complex options terminated by a value:\n764\t    /// `T<us>` → `wifi_shadow_rtt`, `Q<float>` → `quantum_ratio`.\n765\t    pub fn set_options(&mut self) {\n766\t        // BBRExperiment is always on.\n767\t        self.exp_flags.do_early_exit = true;\n768\t        self.exp_flags.do_rapid_start = true;\n769\t        self.exp_flags.do_handle_suspension = true;\n770\t        self.exp_flags.do_control_lost = true;\n771\t        self.exp_flags.do_exit_probe_bw_up_on_delay = true;\n772\t        self.exp_flags.do_enter_probe_bw_after_limited = true;\n773\t\n774\t        let s = match self.option_string.clone() {\n775\t            Some(s) => s,\n776\t            None => return,\n777\t        };\n778\t        let mut chars = s.chars().peekable();\n779\t        while let Some(c) = chars.next() {\n780\t            match c {\n781\t                'E' => self.exp_flags.do_early_exit = false,\n782\t                'R' => self.exp_flags.do_rapid_start = false,\n783\t                'H' => self.exp_flags.do_handle_suspension = false,\n784\t                'L' => self.exp_flags.do_control_lost = false,\n785\t                'D' => self.exp_flags.do_exit_probe_bw_up_on_delay = false,\n786\t                'A' => self.exp_flags.do_enter_probe_bw_after_limited = false,\n787\t                'T' => {\n788\t                    let mut u: u64 = 0;\n789\t                    while let Some(&d) = chars.peek() {\n790\t                        if d.is_ascii_digit() {\n791\t                            u = u * 10 + (d as u64 - b'0' as u64);\n792\t                            chars.next();\n793\t                        } else {\n794\t                            break;\n795\t                        }\n796\t                    }\n797\t                    self.wifi_shadow_rtt = u;\n798\t                }\n799\t                'Q' => {\n800\t                    let mut d: f64 = 0.0;\n801\t                    let mut div: f64 = 1.0;\n802\t                    let mut dotted = false;\n803\t                    while let Some(&ch) = chars.peek() {\n804\t                        if ch.is_ascii_digit() {\n805\t                            if !dotted {\n806\t                                d = d * 10.0 + (ch as u8 - b'0') as f64;\n807\t                            } else {\n808\t                                div /= 10.0;\n809\t                                d += div * (ch as u8 - b'0') as f64;\n810\t                            }\n811\t                            chars.next();\n812\t                        } else if ch == '.' {\n813\t                            if dotted {\n814\t                                break;\n815\t                            }\n816\t                            dotted = true;\n817\t                            chars.next();\n818\t                        } else {\n819\t                            break;\n820\t                        }\n821\t                    }\n822\t                    self.quantum_ratio = d;\n823\t                }\n824\t                _ => {}\n825\t            }\n826\t        }\n827\t    }\n828\t\n829\t    /// C: `IsInflightTooHigh` (picoquic/bbr.c:1156)\n830\t    ///\n831\t    /// Returns `true` when loss signals indicate the amount of data in\n832\t    /// flight is excessive.  Triggers on either too-high ECN CE fraction\n833\t    /// or on a loss count that exceeds the loss-threshold relative to the\n834\t    /// number of bytes in flight when the affected packets were sent.\n835\t    pub fn is_inflight_too_high(&self, path_x: &Path, rs: &BbrPerAckState) -> bool {\n836\t        if rs.ecn_alpha > BBR_EXCESSIVE_ECN_CE {\n837\t            return true;\n838\t        }\n839\t        // rs_delivered = bytes delivered since the affected packets were sent.\n840\t        let rs_delivered = path_x.delivered.saturating_sub(rs.delivered);\n841\t        rs_delivered > self.recovery_delivered\n842\t            && rs.lost > (rs.tx_in_flight as f64 * BBR_LOSS_THRESH) as u64\n843\t            && rs.lost > 3 * path_x.send_mtu as u64\n844\t    }\n845\t\n846\t    /// C: `IsRTTTooHigh` (picoquic/bbr.c:1386)\n847\t    ///\n848\t    /// Returns `true` when the short-term RTT excess counter exceeds the\n849\t    /// jitter-buffer length, indicating that the measured RTT has been\n850\t    /// consistently above the short-term minimum for too long.\n851\t    pub fn is_rtt_too_high(&self) -> bool {\n852\t        self.nb_rtt_excess > BBR_RTT_JITTER_BUFFER_LEN as i32\n853\t    }\n854\t\n855\t    /// C: `picoquic_bbr_observe` (picoquic/bbr.c:2468)\n856\t    ///\n857\t    /// Report the current congestion-control state and bandwidth estimate\n858\t    /// to an observer.  Returns `(cc_state, cc_param)` where `cc_state`\n859\t    /// is the numeric value of the current `BbrAlgState` and `cc_param`\n860\t    /// is the current bandwidth estimate in bytes/s.\n861\t    pub fn observe(&self) -> (u64, u64) {\n862\t        (self.state as u64, self.bw)\n863\t    }\n864\t\n865\t    /// C: `BBRAdaptLowerBoundsFromCongestion` (picoquic/bbr.c:1051)\n866\t    ///\n867\t    /// Once per round-trip, if we are not probing for bandwidth and loss was\n868\t    /// seen this round, apply the congestion-driven reduction to the lower\n869\t    /// bounds (`bw_lo`, `inflight_lo`).\n870\t    pub fn adapt_lower_bounds_from_congestion(&mut self, path_x: &Path) {\n871\t        if self.is_probing_bw() {\n872\t            return;\n873\t        }\n874\t        // RTTJitterBufferAdapt is not defined in the C build, so only check\n875\t        // loss_in_round (not rtt_too_high_in_round).\n876\t        if self.loss_in_round {\n877\t            self.init_lower_bounds(path_x);\n878\t            self.loss_lower_bounds();\n879\t        }\n880\t    }\n881\t\n882\t    // -----------------------------------------------------------------------\n883\t    // Internal helpers for BBRAdaptUpperBounds and BBRStartProbeBW_DOWN.\n884\t    // These are `pub(crate)` so they can be tested in integration tests but\n885\t    // are not part of the public congestion-control surface.\n886\t\n887\t    /// Splitmix64 step used by BBR's internal PRNG.  C: `picoquic_test_random`.\n888\t    fn bbr_random(&mut self) -> u64 {\n889\t        self.random_context = self.random_context.wrapping_add(0x9e3779b97f4a7c15);\n890\t        let mut z = self.random_context;\n891\t        z = (z ^ (z >> 30)).wrapping_mul(0xbf58476d1ce4e5b9u64);\n892\t        z = (z ^ (z >> 27)).wrapping_mul(0x94d049bb133111ebu64);\n893\t        z ^ (z >> 31)\n894\t    }\n895\t\n896\t    /// Uniform integer in `[low, high]` from the BBR internal PRNG.\n897\t    /// C: `BBRRandomIntBetween` (picoquic/bbr.c:1644).\n898\t    fn random_int_between(&mut self, low: u64, high: u64) -> u64 {\n899\t        let range = high - low + 1;\n900\t        let rnd_min = u64::MAX % range;\n901\t        let rnd = loop {\n902\t            let v = self.bbr_random();\n903\t            if v >= rnd_min {\n904\t                break v;\n905\t            }\n906\t        };\n907\t        low + rnd % range\n908\t    }\n909\t\n910\t    /// Advance the max-BW windowed filter to the next cycle.\n911\t    /// C: `BBRAdvanceMaxBwFilter` (picoquic/bbr.c:1118).\n912\t    pub(crate) fn advance_max_bw_filter(&mut self) {\n913\t        self.cycle_count += 1;\n914\t        self.ack_phase = BbrAckPhase::ProbeStarting;\n915\t        // Clear the slot for the new cycle so stale values don't persist.\n916\t        let slot = (self.cycle_count as usize) % self.max_bw_filter.len();\n917\t        self.max_bw_filter[slot] = 0;\n918\t    }\n919\t\n920\t    /// Latch the random probe-wait intervals for a normal probe-BW DOWN phase.\n921\t    /// C: `BBRPickProbeWait` (picoquic/bbr.c:1658).\n922\t    fn pick_probe_wait(&mut self) {\n923\t        const BBR_LONG_RTT_THRESHOLD: u64 = 250_000;\n924\t        self.rounds_since_bw_probe = self.random_int_between(0, 1) as u32;\n925\t        self.bw_probe_wait = if self.min_rtt < BBR_LONG_RTT_THRESHOLD {\n926\t            2_000_000 + self.random_int_between(0, 1_000_000)\n927\t        } else {\n928\t            8 * self.min_rtt + self.random_int_between(0, 4 * self.min_rtt)\n929\t        };\n930\t    }\n931\t\n932\t    /// Latch the random probe-wait intervals for an early-exit probe-BW DOWN.\n933\t    /// C: `BBRPickProbeWaitEarly` (picoquic/bbr.c:1675).\n934\t    fn pick_probe_wait_early(&mut self) {\n935\t        const BBR_LONG_RTT_THRESHOLD: u64 = 250_000;\n936\t        self.rounds_since_bw_probe = self.random_int_between(0, 1) as u32;\n937\t        self.bw_probe_wait = if self.min_rtt < BBR_LONG_RTT_THRESHOLD {\n938\t            self.min_rtt + self.random_int_between(0, BBR_LONG_RTT_THRESHOLD)\n939\t        } else {\n940\t            self.min_rtt + self.random_int_between(0, self.min_rtt)\n941\t        };\n942\t    }\n943\t\n944\t    /// Record the packet-number watermark that ends the current round.\n945\t    /// C: `BBRStartRound` (picoquic/bbr.c:1212).\n946\t    ///\n947\t    /// In C `round_start_pn` is set via `picoquic_cc_get_sequence_number`\n948\t    /// which reads either `path_x->pkt_ctx.send_sequence` (multipath) or\n949\t    /// `cnx->pkt_ctx[application].send_sequence` (single-path).  Rust has no\n950\t    /// back-pointer from `Path` to `Connection`, so both are passed explicitly.\n951\t    pub(crate) fn start_round(&mut self, connection: &Connection, path_x: &Path) {\n952\t        self.round_start_pn = if connection.is_multipath_enabled {\n953\t            path_x.pkt_ctx.send_sequence\n954\t        } else {\n955\t            connection.pkt_ctx[PacketContext::Application as usize].send_sequence\n956\t        };\n957\t        self.next_round_delivered = path_x.delivered;\n958\t    }\n959\t\n960\t    /// Transition to ProbeBW-DOWN state.\n961\t    /// C: `BBRStartProbeBW_DOWN` (picoquic/bbr.c:1793).\n962\t    pub(crate) fn start_probe_bw_down(\n963\t        &mut self,\n964\t        connection: &Connection,\n965\t        path_x: &mut Path,\n966\t        current_time: u64,\n967\t    ) {\n968\t        const BBR_PROBE_BW_DOWN_PACING_GAIN: f64 = 0.9;\n969\t        const BBR_PROBE_BW_DOWN_CWND_GAIN: f64 = 2.0;\n970\t        self.pacing_gain = BBR_PROBE_BW_DOWN_PACING_GAIN;\n971\t        self.cwnd_gain = BBR_PROBE_BW_DOWN_CWND_GAIN;\n972\t        self.reset_congestion_signals();\n973\t        self.bw_probe_up_cnt = u32::MAX; // not growing inflight_hi\n974\t        if self.probe_probe_bw_quickly && self.exp_flags.do_rapid_start {\n975\t            self.pick_probe_wait_early();\n976\t        } else {\n977\t            self.pick_probe_wait();\n978\t        }\n979\t        self.cycle_stamp = current_time;\n980\t        self.ack_phase = BbrAckPhase::ProbeStopping;\n981\t        self.start_round(connection, path_x);\n982\t        self.state = B