{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01LHrFKeeVfkyeXt7uPKU5iT","type":"tool_result","content":"2195\t                    next = next->next_stream_data;\n2196\t                }\n2197\t\n2198\t                *pprevious = stream_data;\n2199\t            }\n2200\t        }\n2201\t    }\n2202\t\n2203\t    return ret;\n2204\t}\n2205\t\n2206\t/* Add a supported ALPN context */\n2207\tint picoquic_add_proposed_alpn(void* tls_context, const char* alpn)\n2208\t{\n2209\t    int ret = 0;\n2210\t    picoquic_tls_ctx_t* ctx = (picoquic_tls_ctx_t*)tls_context;\n2211\t    if (ctx == NULL) {\n2212\t        ret = PICOQUIC_ERROR_UNEXPECTED_ERROR;\n2213\t    }\n2214\t    else if (ctx->alpn_count >= ctx->alpn_vec_size) {\n2215\t        ret = PICOQUIC_ERROR_SEND_BUFFER_TOO_SMALL;\n2216\t    } else {\n2217\t        ctx->alpn_vec[ctx->alpn_count].base = (uint8_t*)alpn;\n2218\t        ctx->alpn_vec[ctx->alpn_count].len = strlen(alpn);\n2219\t        ctx->alpn_count++;\n2220\t    }\n2221\t\n2222\t    return ret;\n2223\t}\n2224\t\n2225\tint picoquic_export_secret(picoquic_cnx_t *cnx, const char *label, uint8_t *out, size_t outlen)\n2226\t{\n2227\t    if (cnx == NULL || label == NULL || out == NULL || outlen == 0) {\n2228\t        return -1;\n2229\t    }\n2230\t    PICOQUIC_THREAD_CHECK(cnx->quic);"}]},"parent_tool_use_id":"toolu_01NRQsm9Ma5UiUNqPq1Si6qn","session_id":"ba987d13-6cc7-465f-bc67-aa9a57ac7370","uuid":"2e60fbfc-2681-4a4e-8547-813ce54fbaec","timestamp":"2026-05-07T12:45:16.285Z"}
