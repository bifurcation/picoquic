{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_019eWoVEr25d7YVJok9bHd4j","type":"tool_result","content":"888\t    /// Splitmix64 step used by BBR's internal PRNG.  C: `picoquic_test_random`.\n889\t    fn bbr_random(&mut self) -> u64 {\n890\t        self.random_context = self.random_context.wrapping_add(0x9e3779b97f4a7c15);\n891\t        let mut z = self.random_context;\n892\t        z = (z ^ (z >> 30)).wrapping_mul(0xbf58476d1ce4e5b9u64);\n893\t        z = (z ^ (z >> 27)).wrapping_mul(0x94d049bb133111ebu64);\n894\t        z ^ (z >> 31)\n895\t    }\n896\t\n897\t    /// Uniform integer in `[low, high]` from the BBR internal PRNG.\n898\t    /// C: `BBRRandomIntBetween` (picoquic/bbr.c:1644).\n899\t    fn random_int_between(&mut self, low: u64, high: u64) -> u64 {\n900\t        let range = high - low + 1;\n901\t        let rnd_min = u64::MAX % range;\n902\t        let rnd = loop {\n903\t            let v = self.bbr_random();\n904\t            if v >= rnd_min {\n905\t                break v;\n906\t            }\n907\t        };\n908\t        low + rnd % range\n909\t    }\n910\t\n911\t    /// Advance the max-BW windowed filter to the next cycle.\n912\t    /// C: `BBRAdvanceMaxBwFilter` (picoquic/bbr.c:1118).\n913\t    pub(crate) fn advance_max_bw_filter(&mut self) {\n914\t        self.cycle_count += 1;\n915\t        self.ack_phase = BbrAckPhase::ProbeStarting;\n916\t        // Clear the slot for the new cycle so stale values don't persist.\n917\t        let slot = (self.cycle_count as usize) % self.max_bw_filter.len();\n918\t        self.max_bw_filter[slot] = 0;\n919\t    }\n920\t\n921\t    /// Latch the random probe-wait intervals for a normal probe-BW DOWN phase.\n922\t    /// C: `BBRPickProbeWait` (picoquic/bbr.c:1658).\n923\t    fn pick_probe_wait(&mut self) {\n924\t        const BBR_LONG_RTT_THRESHOLD: u64 = 250_000;\n925\t        self.rounds_since_bw_probe = self.random_int_between(0, 1) as u32;\n926\t        self.bw_probe_wait = if self.min_rtt < BBR_LONG_RTT_THRESHOLD {\n927\t            2_000_000 + self.random_int_between(0, 1_000_000)\n928\t        } else {\n929\t            8 * self.min_rtt + self.random_int_between(0, 4 * self.min_rtt)\n930\t        };\n931\t    }\n932\t\n933\t    /// Latch the random probe-wait intervals for an early-exit probe-BW DOWN.\n934\t    /// C: `BBRPickProbeWaitEarly` (picoquic/bbr.c:1675).\n935\t    fn pick_probe_wait_early(&mut self) {\n936\t        const BBR_LONG_RTT_THRESHOLD: u64 = 250_000;\n937\t        self.rounds_since_bw_probe = self.random_int_between(0, 1) as u32;\n938\t        self.bw_probe_wait = if self.min_rtt < BBR_LONG_RTT_THRESHOLD {\n939\t            self.min_rtt + self.random_int_between(0, BBR_LONG_RTT_THRESHOLD)\n940\t        } else {\n941\t            self.min_rtt + self.random_int_between(0, self.min_rtt)\n942\t        };\n943\t    }\n944\t\n945\t    /// Record the packet-number watermark that ends the current round.\n946\t    /// C: `BBRStartRound` (picoquic/bbr.c:1212).\n947\t    ///\n948\t    /// In C `round_start_pn` is set via `picoquic_cc_get_sequence_number`\n949\t    /// which reads either `path_x->pkt_ctx.send_sequence` (multipath) or\n950\t    /// `cnx->pkt_ctx[application].send_sequence` (single-path).  Rust has no\n951\t    /// back-pointer from `Path` to `Connection`, so both are passed explicitly.\n952\t    pub(crate) fn start_round(&mut self, connection: &Connection, path_x: &Path) {\n953\t        self.round_start_pn = if connection.is_multipath_enabled {\n954\t            path_x.pkt_ctx.send_sequence\n955\t        } else {\n956\t            connection.pkt_ctx[PacketContext::Application as usize].send_sequence\n957\t        };\n958\t        self.next_round_delivered = path_x.delivered;\n959\t    }\n960\t\n961\t    /// Transition to ProbeBW-DOWN state.\n962\t    /// C: `BBRStartProbeBW_DOWN` (picoquic/bbr.c:1793).\n963\t    pub(crate) fn start_probe_bw_down(\n964\t        &mut self,\n965\t        connection: &Connection,\n966\t        path_x: &mut Path,\n967\t        current_time: u64,\n968\t    ) {\n969\t        const BBR_PROBE_BW_DOWN_PACING_GAIN: f64 = 0.9;\n970\t        const BBR_PROBE_BW_DOWN_CWND_GAIN: f64 = 2.0;\n971\t        self.pacing_gain = BBR_PROBE_BW_DOWN_PACING_GAIN;\n972\t        self.cwnd_gain = BBR_PROBE_BW_DOWN_CWND_GAIN;\n973\t        self.reset_congestion_signals();\n974\t        self.bw_probe_up_cnt = u32::MAX; // not growing inflight_hi\n975\t        if self.probe_probe_bw_quickly && self.exp_flags.do_rapid_start {\n976\t            self.pick_probe_wait_early();\n977\t        } else {\n978\t            self.pick_probe_wait();\n979\t        }\n980\t        self.cycle_stamp = current_time;\n981\t        self.ack_phase = BbrAckPhase::ProbeStopping;\n982\t        self.start_round(connection, path_x);\n983\t        self.state = BbrAlgState::ProbeBwDown;\n984\t        self.nb_rtt_excess = 0;\n985\t        self.app_limited_round_count = 0;\n986\t        self.app_limited_this_round = 0;\n987\t        path_x.is_cca_probing_up = false;\n988\t    }\n989\t\n990\t    /// C: `BBRBDPMultiple` (picoquic/bbr.c:878)\n991\t    ///\n992\t    /// Returns `gain × BDP` computed at `self.bw`.  Delegates to\n993\t    /// `bdp_multiple_with_bw`; see that method for the `min_rtt` sentinel\n994\t    /// handling and the `bdp` side-effect.\n995\t    pub fn bdp_multiple(&mut self, path_x: &Path, gain: f64) -> u64 {\n996\t        let bw = self.bw;\n997\t        self.bdp_multiple_with_bw(path_x, gain, bw)\n998\t    }\n999\t\n1000\t    /// C: `BBRBoundCwndForModel` (picoquic/bbr.c:647)\n1001\t    ///\n1002\t    /// Cap `path_x.cwin` to the model's inflight limits.  In any ProbeBW\n1003\t    /// state other than Cruise, `inflight_hi` (when non-zero) is the ceiling.\n1004\t    /// In ProbeRtt or ProbeBwCruise the ceiling is the headroom-adjusted\n1005\t    /// `inflight_hi`.  `inflight_lo` is then applied as a secondary cap,\n1006\t    /// and finally `BBRMinPipeCwnd * MTU` is enforced as a floor.\n1007\t    pub fn bound_cwnd_for_model(&mut self, path_x: &mut Path) {\n1008\t        const BBR_MIN_PIPE_CWND: u64 = 4;\n1009\t        let mut cap = u64::MAX;\n1010\t        if self.is_in_a_probe_bw_state() && self.state != BbrAlgState::ProbeBwCruise {\n1011\t            if self.inflight_hi > 0 {\n1012\t                cap = self.inflight_hi;\n1013\t            }\n1014\t        } else if self.state == BbrAlgState::ProbeRtt || self.state == BbrAlgState::ProbeBwCruise {\n1015\t            cap = self.inflight_with_headroom(path_x);\n1016\t        }\n1017\t        if cap > self.inflight_lo {\n1018\t            cap = self.inflight_lo;\n1019\t        }\n1020\t        let floor = BBR_MIN_PIPE_CWND * path_x.send_mtu as u64;\n1021\t        if cap < floor {\n1022\t            cap = floor;\n1023\t        }\n1024\t        if path_x.cwin > cap {\n1025\t            path_x.cwin = cap;\n1026\t        }\n1027\t    }\n1028\t\n1029\t    /// C: `BBRAdvanceEcnFrac` (picoquic/bbr.c:2288)\n1030\t    ///\n1031\t    /// At the start of each new round, update `ecn_alpha` from the current\n1032\t    /// ECN fraction and latch the new ECN counters.  If the remote counters\n1033\t    /// have gone backwards (counter reset or path change) we reset alpha to\n1034\t    /// zero to avoid using stale ECN feedback.  No-op outside round starts or\n1035\t    /// when no valid ECN packet-context is available for this path.\n1036\t    pub fn advance_ecn_frac(\n1037\t        &mut self,\n1038\t        connection: &Connection,\n1039\t        path_x: &Path,\n1040\t        rs: &BbrPerAckState,\n1041\t    ) {\n1042\t        if !self.round_start {\n1043\t            return;\n1044\t        }\n1045\t        if let Some(pkt_ctx) = access_ecn_packet_context(connection, path_x) {\n1046\t            if pkt_ctx.ecn_ect1_total_remote < self.ecn_ect1_last_round\n1047\t                || pkt_ctx.ecn_ce_total_remote < self.ecn_ce_last_round\n1048\t            {\n1049\t                self.ecn_alpha = 0.0;\n1050\t            } e