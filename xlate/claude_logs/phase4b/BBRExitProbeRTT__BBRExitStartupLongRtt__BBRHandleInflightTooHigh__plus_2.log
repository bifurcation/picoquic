`).\n717\t    pub fn update_rtt_jitter_buffer(&mut self, rs: &BbrPerAckState, current_time: u64) {\n718\t        if current_time > self.last_rtt_sample_stamp + 1000 {\n719\t            let idx = (self.rtt_jitter_cycle as usize) % BBR_RTT_JITTER_BUFFER_LEN;\n720\t            self.rtt_jitter_buffer[idx] = rs.rtt_sample;\n721\t            self.rtt_jitter_cycle += 1;\n722\t            self.last_rtt_sample_stamp = current_time;\n723\t            self.rtt_short_term_min = u64::MAX;\n724\t            self.rtt_short_term_max = 0;\n725\t            let valid = (self.rtt_jitter_cycle as usize).min(BBR_RTT_JITTER_BUFFER_LEN);\n726\t            for i in 0..valid {\n727\t                let sample = self.rtt_jitter_buffer[i];\n728\t                if sample > self.rtt_short_term_max {\n729\t                    self.rtt_short_term_max = sample;\n730\t                }\n731\t                if sample < self.rtt_short_term_min {\n732\t                    self.rtt_short_term_min = sample;\n733\t                }\n734\t            }\n735\t        }\n736\t    }\n737\t\n738\t    /// C: `BBRUpdateRecoveryOnLoss` (picoquic/bbr.c:2206)\n739\t    ///\n740\t    /// During PTO recovery, reduce `cwin` by `newly_lost` bytes, floored at\n741\t    /// two MTUs.  Only applies when at least one retransmit has occurred and\n742\t    /// we are in PTO (not fast) recovery.\n743\t    pub fn update_recovery_on_loss(&self, path_x: &mut Path, newly_lost: u64) {\n744\t        if path_x.nb_retransmit >= 1\n745\t            && self.is_in_recovery\n746\t            && self.is_pto_recovery\n747\t            && path_x.cwin > newly_lost\n748\t        {\n749\t            path_x.cwin -= newly_lost;\n750\t            let floor = 2 * path_x.send_mtu as u64;\n751\t            if path_x.cwin < floor {\n752\t                path_x.cwin = floor;\n753\t            }\n754\t        }\n755\t    }\n756\t\n757\t    /// C: `BBRSetOptions` (picoquic/bbr.c:460)\n758\t    ///\n759\t    /// Parse `option_string` to configure experimental flags and numeric\n760\t    /// parameters.  `BBRExperiment` is always enabled in this build, so all\n761\t    /// experiment flags default to `true` before any option disables them.\n762\t    ///\n763\t    /// Single-letter flags (toggle off the corresponding experiment):\n764\t    /// `E` `R` `H` `L` `D` `A`.  Complex options terminated by a value:\n765\t    /// `T<us>` → `wifi_shadow_rtt`, `Q<float>` → `quantum_ratio`.\n766\t    pub fn set_options(&mut self) {\n767\t        // BBRExperiment is always on.\n768\t        self.exp_flags.do_early_exit = true;\n769\t        self.exp_flags.do_rapid_start = true;\n770\t        self.exp_flags.do_handle_suspension = true;\n771\t        self.exp_flags.do_control_lost = true;\n772\t        self.exp_flags.do_exit_probe_bw_up_on_delay = true;\n773\t        self.exp_flags.do_enter_probe_bw_after_limited = true;\n774\t\n775\t        let s = match self.option_string.clone() {\n776\t            Some(s) => s,\n777\t            None => return,\n778\t        };\n779\t        let mut chars = s.chars().peekable();\n780\t        while let Some(c) = chars.next() {\n781\t            match c {\n782\t                'E' => self.exp_flags.do_early_exit = false,\n783\t                'R' => self.exp_flags.do_rapid_start = false,\n784\t                'H' => self.exp_flags.do_handle_suspension = false,\n785\t                'L' => self.exp_flags.do_control_lost = false,\n786\t                'D' => self.exp_flags.do_exit_probe_bw_up_on_delay = false,\n787\t                'A' => self.exp_flags.do_enter_probe_bw_after_limited = false,\n788\t                'T' => {\n789\t                    let mut u: u64 = 0;\n790\t                    while let Some(&d) = chars.peek() {\n791\t                        if d.is_ascii_digit() {\n792\t                            u = u * 10 + (d as u64 - b'0' as u64);\n793\t                            chars.next();\n794\t                        } else {\n795\t                            break;\n796\t                        }\n797\t                    }\n798\t                    self.wifi_shadow_rtt = u;\n799\t                }\n800\t                'Q' => {\n801\t                    let mut d: f64 = 0.0;\n802\t                    let mut div: f64 = 1.0;\n803\t                    let mut dotted = false;\n804\t                    while let Some(&ch) = chars.peek() {\n805\t                        if ch.is_ascii_digit() {\n806\t                            if !dotted {\n807\t                                d = d * 10.0 + (ch as u8 - b'0') as f64;\n808\t                            } else {\n809\t                                div /= 10.0;\n810\t                                d += div * (ch as u8 - b'0') as f64;\n811\t                            }\n812\t                            chars.next();\n813\t                        } else if ch == '.' {\n814\t                            if dotted {\n815\t                                break;\n816\t                            }\n817\t                            dotted = true;\n818\t                            chars.next();\n819\t                        } else {\n820\t                            break;\n821\t                        }\n822\t                    }\n823\t                    self.quantum_ratio = d;\n824\t                }\n825\t                _ => {}\n826\t            }\n827\t        }\n828\t    }\n829\t\n830\t    /// C: `IsInflightTooHigh` (picoquic/bbr.c:1156)\n831\t    ///\n832\t    /// Returns `true` when loss signals indicate the amount of data in\n833\t    /// flight is excessive.  Triggers on either too-high ECN CE fraction\n834\t    /// or on a loss count that exceeds the loss-threshold relative to the\n835\t    /// number of bytes in flight when the affected packets were sent.\n836\t    pub fn is_inflight_too_high(&self, path_x: &Path, rs: &BbrPerAckState) -> bool {\n837\t        if rs.ecn_alpha > BBR_EXCESSIVE_ECN_CE {\n838\t            return true;\n839\t        }\n840\t        // rs_delivered = bytes delivered since the affected packets were sent.\n841\t        let rs_delivered = path_x.delivered.saturating_sub(rs.delivered);\n842\t        rs_delivered > self.recovery_delivered\n843\t            && rs.lost > (rs.tx_in_flight as f64 * BBR_LOSS_THRESH) as u64\n844\t            && rs.lost > 3 * path_x.send_mtu as u64\n845\t    }\n846\t\n847\t    /// C: `IsRTTTooHigh` (picoquic/bbr.c:1386)\n848\t    ///\n849\t    /// Returns `true` when the short-term RTT excess counter exceeds the\n850\t    /// jitter-buffer length, indicating that the measured RTT has been\n851\t    /// consistently above the short-term minimum for too long.\n852\t    pub fn is_rtt_too_high(&self) -> bool {\n853\t        self.nb_rtt_excess > BBR_RTT_JITTER_BUFFER_LEN as i32\n854\t    }\n855\t\n856\t    /// C: `picoquic_bbr_observe` (picoquic/bbr.c:2468)\n857\t    ///\n858\t    /// Report the current congestion-control state and bandwidth estimate\n859\t    /// to an observer.  Returns `(cc_state, cc_param)` where `cc_state`\n860\t    /// is the numeric value of the current `BbrAlgState` and `cc_param`\n861\t    /// is the current bandwidth estimate in bytes/s.\n862\t    pub fn observe(&self) -> (u64, u64) {\n863\t        (self.state as u64, self.bw)\n864\t    }\n865\t\n866\t    /// C: `BBRAdaptLowerBoundsFromCongestion` (picoquic/bbr.c:1051)\n867\t    ///\n868\t    /// Once per round-trip, if we are not probing for bandwidth and loss was\n869\t    /// seen this round, apply the congestion-driven reduction to the lower\n870\t    /// bounds (`bw_lo`, `inflight_lo`).\n871\t    pub fn adapt_lower_bounds_from_congestion(&mut self, path_x: &Path) {\n872\t        if self.is_probing_bw() {\n873\t            return;\n874\t        }\n875\t        // RTTJitterBufferAdapt is not defined in the C build, so only check\n876\t        // loss_in_round (not rtt_too_high_in_round).\n877\t        if self.loss_in_round {\n878\t            self.init_lower_bounds(path_x);\n879\t            self.loss_lower_bounds();\n880\t     