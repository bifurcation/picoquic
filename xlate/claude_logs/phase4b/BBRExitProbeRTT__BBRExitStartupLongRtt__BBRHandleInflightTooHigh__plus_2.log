{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01RPRLZGAjusFNsfSqn96FWn","type":"tool_result","content":"295\t        // Picoquic-specific: notify transport that the startup phase is complete.\n296\t        path_x.is_ssthresh_initialized = true;\n297\t        self.state = BbrAlgState::Drain;\n298\t        self.pacing_gain = 1.0 / BBR_STARTUP_CWND_GAIN; // pace slowly\n299\t        self.cwnd_gain = BBR_STARTUP_CWND_GAIN; // maintain cwnd\n300\t        path_x.is_cca_probing_up = false;\n301\t    }\n302\t\n303\t    /// C: `BBRCheckStartupFullBandwidthGeneric` (picoquic/bbr.c:1952)\n304\t    pub fn check_startup_full_bandwidth_generic(&mut self, rs: &BbrPerAckState, threshold: f64) {\n305\t        if self.filled_pipe || !self.round_start || rs.is_app_limited {\n306\t            return;\n307\t        }\n308\t        if self.max_bw as f64 >= threshold * self.full_bw as f64 {\n309\t            // still growing\n310\t            self.full_bw = self.max_bw;\n311\t            self.full_bw_count = 0;\n312\t            return;\n313\t        }\n314\t        self.full_bw_count += 1; // another round without much growth\n315\t        if self.full_bw_count >= 3 {\n316\t            self.filled_pipe = true;\n317\t        }\n318\t    }\n319\t\n320\t    /// C: `BBRCheckStartupFullBandwidth` (picoquic/bbr.c:2020)\n321\t    pub fn check_startup_full_bandwidth(&mut self, rs: &BbrPerAckState) {\n322\t        if self.filled_pipe || !self.round_start || rs.is_app_limited {\n323\t            return;\n324\t        }\n325\t        // 5/4 integer approximation of ×1.25 avoids floating-point drift.\n326\t        if 4 * self.max_bw >= 5 * self.full_bw {\n327\t            // still growing\n328\t            self.full_bw = self.max_bw;\n329\t            self.full_bw_count = 0;\n330\t            if rs.ecn_frac < 0.2 {\n331\t                return;\n332\t            }\n333\t        }\n334\t        self.full_bw_count += 1; // another round without much growth\n335\t        if self.full_bw_count >= 3 || rs.ecn_frac >= BBR_EXCESSIVE_ECN_CE {\n336\t            self.filled_pipe = true;\n337\t        }\n338\t    }\n339\t\n340\t    /// C: `BBRCheckAppLimitedEnded` (picoquic/bbr.c:1747)\n341\t    ///\n342\t    /// Tracks per-round app-limited state.  Returns `true` on the first\n343\t    /// round where the app is *not* limited after having been limited for\n344\t    /// more than `BBR_APP_LIMITED_ROUNDS_THRESHOLD` consecutive rounds.\n345\t    pub fn check_app_limited_ended(&mut self, rs: &BbrPerAckState) -> bool {\n346\t        let mut app_limited_ended = false;\n347\t        if self.round_start {\n348\t            if self.app_limited_this_round != 0 {\n349\t                self.app_limited_round_count += 1;\n350\t            } else {\n351\t                app_limited_ended = self.app_limited_round_count > BBR_APP_LIMITED_ROUNDS_THRESHOLD;\n352\t                self.app_limited_round_count = 0;\n353\t            }\n354\t            self.app_limited_this_round = 0;\n355\t        } else {\n356\t            self.app_limited_this_round |= rs.is_app_limited as i32;\n357\t        }\n358\t        app_limited_ended\n359\t    }\n360\t\n361\t    /// C: `BBRExitLostFeedback` (picoquic/bbr.c:782)\n362\t    ///\n363\t    /// Restore the congestion window saved by `BBREnterLostFeedback` and\n364\t    /// clear the lost-feedback flag.  No-op if the flag is not set.\n365\t    pub fn exit_lost_feedback(&mut self, path_x: &mut Path) {\n366\t        if self.is_handling_lost_feedback {\n367\t            path_x.cwin = self.cwin_before_lost_feedback;\n368\t            self.is_handling_lost_feedback = false;\n369\t        }\n370\t    }\n371\t\n372\t    /// C: `BBRHasElapsedInPhase` (picoquic/bbr.c:1776)\n373\t    ///\n374\t    /// Returns `true` when `current_time` has advanced past\n375\t    /// `cycle_stamp + interval`.  Used to decide when to transition from\n376\t    /// DOWN/CRUISE to REFILL in the probe-BW cycle.\n377\t    pub(crate) fn has_elapsed_in_phase(&self, interval: u64, current_time: u64) -> bool {\n378\t        current_time > self.cycle_stamp + interval\n379\t    }\n380\t\n381\t    /// C: `BBREnterStartupResume` (picoquic/bbr.c:1972)\n382\t    ///\n383\t    /// Enter `StartupResume` state, which uses Hystart-like pacing gains\n384\t    /// to resume quickly after a suspension.  Called either when a BDP\n385\t    /// seed is set or on the initial `EnterStartup` path when a seed\n386\t    /// exists.\n387\t    pub(crate) fn enter_startup_resume(&mut self) {\n388\t        self.state = BbrAlgState::StartupResume;\n389\t        self.pacing_gain = BBR_STARTUP_RESUME_PACING_GAIN;\n390\t        self.cwnd_gain = BBR_STARTUP_RESUME_CWND_GAIN;\n391\t    }\n392\t\n393\t    /// C: `BBREnterStartup` (picoquic/bbr.c:2061)\n394\t    ///\n395\t    /// Enter normal `Startup` state with the standard pacing and cwnd\n396\t    /// gains.  Sets `is_cca_probing_up` to inform the transport that the\n397\t    /// congestion controller is actively probing for more bandwidth.\n398\t    pub fn enter_startup(&mut self, path_x: &mut Path) {\n399\t        self.state = BbrAlgState::Startup;\n400\t        self.pacing_gain = BBR_STARTUP_PACING_GAIN;\n401\t        self.cwnd_gain = BBR_STARTUP_CWND_GAIN;\n402\t        path_x.is_cca_probing_up = true;\n403\t    }\n404\t\n405\t    /// C: `BBREnterStartupLongRTT` (picoquic/bbr.c:2080)\n406\t    ///\n407\t    /// Enter `StartupLongRTT` state, which uses Hystart rather than the\n408\t    /// normal BBR Startup algorithm.  The initial congestion window is\n409\t    /// scaled up from `CWIN_INITIAL` proportional to `rtt_min` (capped at\n410\t    /// the satellite-RTT ceiling) and then further boosted by the BDP seed\n411\t    /// when available.\n412\t    pub fn enter_startup_long_rtt(&mut self, path_x: &mut Path) {\n413\t        let mut cwnd = CWIN_INITIAL;\n414\t        self.state = BbrAlgState::StartupLongRtt;\n415\t        if path_x.rtt_min > TARGET_RENO_RTT {\n416\t            let rtt_cap = if path_x.rtt_min > TARGET_SATELLITE_RTT {\n417\t                TARGET_SATELLITE_RTT\n418\t            } else {\n419\t                path_x.rtt_min\n420\t            };\n421\t            cwnd = (cwnd as f64 * rtt_cap.ticks() as f64 / TARGET_RENO_RTT.ticks() as f64) as u64;\n422\t        }\n423\t        if cwnd < self.bdp_seed {\n424\t            cwnd = self.bdp_seed;\n425\t        }\n426\t        if cwnd > path_x.cwin {\n427\t            path_x.cwin = cwnd;\n428\t        }\n429\t        path_x.is_cca_probing_up = true;\n430\t    }\n431\t\n432\t    /// C: `BBRInitFullPipe` (picoquic/bbr.c:434)\n433\t    ///\n434\t    /// Reset the \"pipe full\" bandwidth-growth detector to its initial state.\n435\t    pub fn init_full_pipe(&mut self) {\n436\t        self.filled_pipe = false;\n437\t        self.full_bw = 0;\n438\t        self.full_bw_count = 0;\n439\t    }\n440\t\n441\t    /// C: `BBRInitLowerBounds` (picoquic/bbr.c:1025)\n442\t    ///\n443\t    /// On the first congestion episode in a cycle, latch `bw_lo` to\n444\t    /// `max_bw` and `inflight_lo` to `cwin` (the UINT64_MAX sentinel\n445\t    /// means \"not yet initialised\").\n446\t    pub fn init_lower_bounds(&mut self, path_x: &Path) {\n447\t        if self.bw_lo == u64::MAX {\n448\t            self.bw_lo = self.max_bw;\n449\t        }\n450\t        if self.inflight_lo == u64::MAX {\n451\t            self.inflight_lo = path_x.cwin;\n452\t        }\n453\t    }\n454\t\n455\t    /// C: `BBRInitPacingRate` (picoquic/bbr.c:933)\n456\t    ///\n457\t    /// Set the initial pacing rate based on the nominal bandwidth at\n458\t    /// `INITIAL_RTT` (250 ms), unless the path already has a real RTT\n459\t    /// estimate, in which case that estimate is used instead.\n460\t    pub fn init_pacing_rate(&mut self, path_x: &Path) {\n461\t        let initial_rtt = if path_x.smoothed_rtt != INITIAL_RTT || path_x.rtt_variant.ticks() != 0 {\n462\t            path_x.smoothed_rtt.ticks()\n463\t        } else {\n464\t            INITIAL_RTT.ticks()\n465\t        };\n466\t        let nominal_bandwidth = (1_000_000u64 * CWIN_INITIAL) as f64 / initial_rtt as f64;\n467\t        self.pacing_rate = BBR_STARTUP_PACING_GAIN * nominal_bandwidth;\n468\t    }\n469\t\n470\t    /// C: `BBRInitRandom` (picoquic/bbr.c:421)\n471\t    ///\n472\t    /// Seed `random_context` from the current time, connection role, and\n473\t    /// path ID so that tests remain deterministic while production runs\n474\t    /// diverge.  `connection` is passed separately because `Path` carries\n475\t    /// no back-pointer to its owning `Connection` in Rust.\n476\t    pub fn init_random(&mut self, connection: &Connection, path_x: &Path, current_time: u64) {\n477\t        let mut ctx: u64 = 0xfedcba9876543210;\n478\t        ctx ^= current_time;\n479\t        if connection.client_mode {\n480\t            ctx = ctx.wrapping_add(0x0123456789abcdef);\n481\t        }\n482\t        if path_x.unique_path_id > 0 && path_x.unique_path_id != u64::MAX {\n483\t            ctx = ctx.wrapping_mul(path_x.unique_path_id.wrapping_add(1));\n484\t        }\n485\t        self.random_context = ctx;\n486\t    }\n487\t\n488\t    /// C: `BBRInflightWithHeadroom` (picoquic/bbr.c:1547)\n489\t    ///\n490\t    /// Returns the inflight limit that leaves `BBRHeadroom` (15%) of the\n491\t    /// bottleneck buffer free for competing flows.  Returns `u64::MAX`\n492\t    /// when `inflight_hi` has not yet been measured.\n493\t    pub fn inflight_with_headroom(&self, path_x: &Path) -> u64 {\n494\t        const BBR_HEADROOM: f64 = 0.15;\n495\t        const BBR_MIN_PIPE_CWND: u64 = 4;\n496\t        if self.inflight_hi == u64::MAX {\n497\t            return u64::MAX;\n498\t        }\n499\t        let headroom = ((1.0 - BBR_HEADROOM) * self.inflight_hi as f64) as u64;\n500\t        headroom.max(BBR_MIN_PIPE_CWND * path_x.send_mtu as u64)\n501\t    }\n502\t\n503\t    /// C: `BBRIsProbingBW` (picoquic/bbr.c:1532)\n504\t    ///\n505\t    /// Returns `true` when the state is actively probing for more bandwidth\n506\t    /// (i.e. NOT in one of the non-probing states: ProbeBwDown, ProbeBwCruise,\n507\t    /// Drain, or ProbeRtt).\n508\t    pub fn is_probing_bw(&self) -> bool {\n509\t        !matches!(\n510\t            self.state,\n511\t            BbrAlgState::ProbeBwDown\n512\t                | BbrAlgState::ProbeBwCruise\n513\t                | BbrAlgState::Drain\n514\t                | BbrAlgState::ProbeRtt\n515\t        )\n516\t    }\n517\t\n518\t    /// C: `BBRLossLowerBounds` (picoquic/bbr.c:1035)\n519\t    ///\n520\t    /// Apply a `BBRBeta` (0.7) multiplicative decrease to `bw_lo` and\n521\t    /// `inflight_lo`, then floor each at the latest sample so the model\n522\t    /// cannot shrink below what was actually observed this round.\n523\t    pub fn loss_lower_bounds(&mut self) {\n524\t        self.bw_lo = ((BBR_BETA * self.bw_lo as f64) as u64).max(self.bw_latest);\n525\t        self.inflight_lo = ((BBR_BETA * self.inflight_lo as f64) as u64).max(self.inflight_latest);\n526\t    }\n527\t\n528\t    /// C: `BBRModulateCwndForRecovery` (picoquic/bbr.c:627)\n529\t    ///\n530\t    /// On packet loss, shrink `cwin` by the number of bytes lost (floored at\n531\t    /// one MTU).  When `packet_conservation` is active, ensure `cwin` is at\n532\t    /// least `bytes_in_transit + newly_acked` so the pipe stays full.\n533\t    pub fn modulate_cwnd_for_recovery(&self, path_x: &mut Path, rs: &BbrPerAckState) {\n534\t        if rs.newly_lost > 0 {\n535\t            if path_x.cwin > rs.newly_lost + path_x.send_mtu as u64 {\n536\t                path_x.cwin -= rs.newly_lost;\n537\t            } else {\n538\t                path_x.cwin = path_x.send_mtu as u64;\n539\t            }\n540\t        }\n541\t        if self.packet_conservation && path_x.cwin < path_x.bytes_in_transit + rs.newly_acked {\n542\t            path_x.cwin = path_x.bytes_in_transit + rs.newly_acked;\n543\t        }\n544\t    }\n545\t\n546\t    /// C: `BBRRaiseInflightHiSlope` (picoquic/bbr.c:1561)\n547\t    ///\n548\t    /// Recompute how aggressively `inflight_hi` is raised during ProbeBwUp.\n549\t    /// Each round the slope doubles (shift by `bw_probe_up_rounds`, capped at\n550\t    /// 30), and `bw_probe_up_cnt` is set to the number of MTU-sized ACKs\n551\t    /// required to justify a one-MTU increase (minimum 1).\n552\t    pub fn raise_inflight_hi_slope(&mut self, path_x: &Path) {\n553\t        let growth_this_round = (path_x.send_mtu as u64) << self.bw_probe_up_rounds;\n554\t        self.bw_probe_up_rounds = (self.bw_probe_up_rounds + 1).min(30);\n555\t        let up_cnt = (path_x.cwin / growth_this_round) as u32;\n556\t        self.bw_probe_up_cnt = up_cnt.max(1);\n557\t    }\n558\t\n559\t    /// C: `BBRResetCongestionSignals` (picoquic/bbr.c:1014)\n560\t    ///\n561\t    /// Clear the per-round congestion signals so the next round starts with\n562\t    /// a clean slate.  Called at the start of each new round.\n563\t    pub fn reset_congestion_signals(&mut self) {\n564\t        self.loss_in_round = false;\n565\t        self.bw_latest = 0;\n566\t        self.inflight_latest = 0;\n567\t    }\n568\t\n569\t    /// C: `BBRResetLowerBounds` (picoquic/bbr.c:1088)\n570\t    ///\n571\t    /// Reset `bw_lo` and `inflight_lo` to their uninitialized sentinel\n572\t    /// (`u64::MAX`), indicating no congestion episode has been seen yet.\n573\t    pub fn reset_lower_bounds(&mut self) {\n574\t        self.bw_lo = u64::MAX;\n575\t        self.inflight_lo = u64::MAX;\n576\t    }\n577\t\n578\t    /// C: `BBRResetRTTJitterBuffer` (picoquic/bbr.c:1322)\n579\t    ///\n580\t    /// Reinitialise the RTT jitter-buffer metadata to `rtt_init_value` and\n581\t    /// reset the cycle counter and excess counter.  The sample array itself\n582\t    /// is not cleared here (the caller's prior `memset` zeroes it on first\n583\t    /// call, and valid entries are overwritten as `rtt_jitter_cycle` advances).\n584\t    pub fn reset_rtt_jitter_buffer(&mut self, rtt_i