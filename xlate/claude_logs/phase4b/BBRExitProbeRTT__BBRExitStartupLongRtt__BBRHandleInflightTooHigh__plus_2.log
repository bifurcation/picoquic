to\n630\t    /// at most 64 KiB and floored at one MTU (pacing_rate < 1.2 Mbps) or\n631\t    /// two MTUs (otherwise).\n632\t    pub fn set_send_quantum(&mut self, path_x: &Path) {\n633\t        let floor = if self.pacing_rate < 150_000.0 {\n634\t            path_x.send_mtu as u64\n635\t        } else {\n636\t            2 * path_x.send_mtu as u64\n637\t        };\n638\t        let quantum = (self.pacing_rate * self.quantum_ratio) as u64;\n639\t        self.send_quantum = quantum.min(0x10000).max(floor);\n640\t    }\n641\t\n642\t    /// C: `BBRStartProbeBW_CRUISE` (picoquic/bbr.c:1816)\n643\t    ///\n644\t    /// Enter the ProbeBW/Cruise phase: pace at rate (gain = 1.0) while\n645\t    /// maintaining the congestion window (cwnd_gain = 2.0).\n646\t    pub fn start_probe_bw_cruise(&mut self) {\n647\t        self.pacing_gain = BBR_PROBE_BW_CRUISE_PACING_GAIN;\n648\t        self.cwnd_gain = BBR_PROBE_BW_CRUISE_CWND_GAIN;\n649\t        self.state = BbrAlgState::ProbeBwCruise;\n650\t    }\n651\t\n652\t    /// C: `BBRTargetInflight` (picoquic/bbr.c:1693)\n653\t    ///\n654\t    /// How much data do we want in flight?  Our estimated BDP, unless\n655\t    /// congestion has cut `cwin` below it.\n656\t    pub fn target_inflight(&self, path_x: &Path) -> u64 {\n657\t        self.bdp.min(path_x.cwin)\n658\t    }\n659\t\n660\t    /// C: `BBRUpdateLatestDeliverySignals` (picoquic/bbr.c:987)\n661\t    ///\n662\t    /// Near the start of ACK processing: update `bw_latest` and\n663\t    /// `inflight_latest` with the new sample maximums, and detect\n664\t    /// whether a new loss round has started.\n665\t    pub fn update_latest_delivery_signals(&mut self, path_x: &Path, rs: &BbrPerAckState) {\n666\t        self.loss_round_start = false;\n667\t        if self.bw_latest < rs.delivery_rate {\n668\t            self.bw_latest = rs.delivery_rate;\n669\t        }\n670\t        if self.inflight_latest < rs.delivered {\n671\t            self.inflight_latest = rs.delivered;\n672\t        }\