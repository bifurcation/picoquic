1_state_t* bbr1_state,\n1164\t    uint64_t lost_packet_number)\n1165\t{\n1166\t    if (bbr1_state->is_suspended &&\n1167\t        bbr1_state->cwin_before_suspension > 0 &&\n1168\t        !bbr1_state->is_suspension_nearly_over &&\n1169\t        bbr1_state->congestion_sequence >= lost_packet_number) {\n1170\t        bbr1_state->is_suspension_nearly_over = 1;\n1171\t    }\n1172\t}\n1173\t\n1174\tvoid picoquic_bbr1_suspension_exit(\n1175\t    picoquic_bbr1_state_t* bbr1_state,\n1176\t    picoquic_path_t* path_x)\n1177\t{\n1178\t    if (bbr1_state->is_suspended &&\n1179\t        bbr1_state->is_suspension_nearly_over) {\n1180\t        path_x->cwin = bbr1_state->cwin_before_suspension;\n1181\t        /* Set the pacing rate in picoquic sender */\n1182\t        picoquic_update_pacing_rate(path_x, bbr1_state->pacing_rate, bbr1_state->send_quantum);\n1183\t    }\n1184\t    bbr1_state->is_suspended = 0;\n1185\t    bbr1_state->is_suspension_nearly_over = 0;\n1186\t}\n1187\t\n1188\t\n1189\t\n1190\t\n1191\t/*\n1192\t * In order to implement BBR1, we map generic congestion notification\n1193\t * signals to the corresponding BBR1 actions.\n1194\t */\n1195\tstatic void picoquic_bbr1_notify(\n1196\t    picoquic_cnx_t* cnx,\n1197\t    picoquic_path_t* path_x,\n1198\t    picoquic_congestion_notification_t notification,\n1199\t    picoquic_per_ack_state_t* ack_state,\n1200\t    uint64_t current_time)\n1201\t{\n1202\t    picoquic_bbr1_state_t* bbr1_state = (picoquic_bbr1_state_t*)path_x->congestion_alg_state;\n1203\t    path_x->is_cc_data_updated = 1;\n1204\t\n1205\t    if (bbr1_state != NULL) {\n1206\t        switch (notification) {\n1207\t        case picoquic_congestion_notification_ecn_ec:\n1208\t            /* Non standard code to react on ECN_EC */\n1209\t            if (ack_state->lost_packet_number >= bbr1_state->congestion_sequence) {\n1210\t                picoquic_bbr1_notify_congestion(bbr1_state, cnx, path_x, current_time, 0);\n1211\t            }\n1212\t            break;\n1213\t        case picoquic_congestion_notification_repeat:\n1214\t        case picoquic_congestion_notification_timeout:\n1215\t            /* Non standard code to react to high rate of packet loss, or timeout loss */\n1216\t            if (ack_state->lost_packet_number >= bbr1_state->congestion_sequence &&\n1217\t                picoquic_cc_hystart_loss_test(&bbr1_state->rtt_filter, notification, ack_state->lost_packet_number, 0.20)) {\n1218\t                picoquic_bbr1_notify_congestion(bbr1_state, cnx, path_x, current_time,\n1219\t                    (notification == picoquic_congestion_notification_timeout) ? 1 : 0);\n1220\t            }\n1221\t            break;\n1222\t        case picoquic_congestion_notification_spurious_repeat:\n1223\t            if (bbr1_state->is_suspended) {\n1224\t                picoquic_bbr1_suspension_almost_over(bbr1_state, ack_state->lost_packet_number);\n1225\t            }\n1226\t            break;\n1227\t        case picoquic_congestion_notification_acknowledgement:\n1228\t            /* sum the amount of data acked per packet */\n1229\t            if (bbr1_state->is_suspended) {\n1230\t                picoquic_bbr1_suspension_exit(bbr1_state, path_x);\n1231\t            }\n1232\t            bbr1_state->bytes_delivered += ack_state->nb_bytes_acknowledged;\n1233\t\n1234\t            if (bbr1_state->state == picoquic_bbr1_alg_startup && path_x->rtt_min > BBR1_HYSTART_THRESHOLD_RTT) {\n1235\t                BBR1EnterStartupLongRTT(bbr1_state, path_x);\n1236\t            }\n1237\t\n1238\t            if (bbr1_state->state == picoquic_bbr1_alg_startup_long_rtt) {\n1239\t                if (picoquic_cc_hystart_test(&bbr1_state->rtt_filter, (cnx->is_time_stamp_enabled) ? ack_state->one_way_delay : ack_state->rtt_measurement,\n1240\t                    cnx->path[0]->pacing.packet_time_microsec, current_time, cnx->is_time_stamp_enabled)) {\n1241\t                    BBR1ExitStartupLongRtt(bbr1_state, path_x, current_time);\n1242\t                }\n1243\t            }\n1244\t\n1245\t            /* RTT measurements will happen after the bandwidth is estimated */\n1246\t            if (bbr1_state->state == picoquic_bbr1_alg_startup_long_rtt) {\n1247\t                uint64_t max_win;\n1248\t                uint64_t min_win;\n1249\t\n1250\t                BBR1UpdateBtlBw(bbr1_state, path_x, current_time);\n1251\t                if (ack_state->rtt_measurement <= bbr1_state->rt_prop) {\n1252\t                    bbr1_state->rt_prop = ack_state->rtt_measurement;\n1253\t                    bbr1_state->rt_prop_stamp = current_time;\n1254\t                }\n1255\t                if (path_x->last_time_acked_data_frame_sent > path_x->last_sender_limited_time) {\n1256\t                    path_x->cwin += picoquic_cc_slow_start_increase(path_x, bbr1_state->bytes_delivered);\n1257\t                }\n1258\t                bbr1_state->bytes_delivered = 0;\n1259\t\n1260\t                max_win = PICOQUIC_BYTES_FROM_RATE(bbr1_state->rt_prop, path_x->peak_bandwidth_estimate);\n1261\t                min_win = max_win /= 2;\n1262\t\n1263\t                if (path_x->cwin < min_win) {\n1264\t                    path_x->cwin = min_win;\n1265\t                }\n1266\t                else if (path_x->smoothed_rtt > PICOQUIC_TARGET_RENO_RTT) {\n1267\t                    path_x->pacing.bandwidth_pause = 1;\n1268\t                }\n1269\t\n1270\t                picoquic_update_pacing_data(path_x, 1);\n1271\t            } else {\n1272\t                BBR1UpdateOnACK(bbr1_state, path_x,\n1273\t                    ack_state->rtt_measurement, path_x->bytes_in_transit, 0 /* packets_lost */, bbr1_state->bytes_delivered,\n1274\t                    current_time);\n1275\t                /* Remember the number in flight before the next ACK -- TODO: update after send instead. */\n1276\t                bbr1_state->prior_in_flight = path_x->bytes_in_transit;\n1277\t                /* Reset the number of bytes delivered */\n1278\t                bbr1_state->bytes_delivered = 0;\n1279\t\n1280\t                if (bbr1_state->pacing_rate > 0) {\n1281\t                    /* Set the pacing rate in picoquic sender */\n1282\t                    picoquic_update_pacing_rate(path_x, bbr1_state->pacing_rate, bbr1_state->send_quantum);\n1283\t                }\n1284\t            }\n1285\t            break;\n1286\t        case picoquic_congestion_notification_cwin_blocked:\n1287\t            break;\n1288\t        case picoquic_congestion_notification_reset:\n1289\t            picoquic_bbr1_reset(bbr1_state, path_x, current_time);\n1290\t            break;\n1291\t        case picoquic_congestion_notification_seed_cwin:\n1292\t            if (bbr1_state->state == picoquic_bbr1_alg_startup_long_rtt) {\n1293\t                BBR1ExitStartupSeedBDP(bbr1_state, path_x, ack_state->nb_bytes_acknowledged, current_time);\n1294\t                picoquic_update_pacing_data(path_x, 1);\n1295\t            }\n1296\t            else if (bbr1_state->state == picoquic_bbr1_alg_startup){\n1297\t                /* If in initial startup phase, do something */\n1298\t                double seed_bw_estimate = (double)ack_state->nb_bytes_acknowledged;\n1299\t                uint64_t bwe;\n1300\t                seed_bw_estimate /= (double)path_x->smoothed_rtt;\n1301\t                seed_bw_estimate *= 1000000;\n1302\t                bwe = (uint64_t)seed_bw_estimate*2; /* Hack -- account for div by two in BBR1UpdateBtlBw */\n1303\t                if (path_x->bandwidth_estimate_max < bwe) {\n1304\t                    path_x->bandwidth_estimate_max = bwe;\n1305\t                    BBR1UpdateBtlBw(bbr1_state, path_x, current_time);\n1306\t                    BBR1SetPacingRate(bbr1_state);\n1307\t                    if (bbr1_state->pacing_rate > 0) {\n1308\t                        /* Set the pacing rate in picoquic sender */\n1309\t                        picoquic_update_pacing_rate(path_x, bbr1_state->pacing_rate, bbr1_state->send_quantum);\n1310\t                    }\n1311\t                }\n1312\t            }\n1313\t            break;\n1314\t        default:\n1315\t            /* ignore */\n1316\t            break;\n1317\t        }"}]},"parent_tool_use_id":null,"session_id":"36feb9dd-a64c-482f-8d2d-3dfde6f4c9e3","uuid":"a8385ae7-4270-46b6-a4e5-6078e7f36cbb","timestamp":"2026-05-07T13:38:35.492Z","tool_use_result":{"type":"text","file":{"filePath":"/Users/richbarn/Projects/picoquic/picoquic/bbr1.c","content":"/* Reaction to ECN or sustained losses\n */\nvoid picoquic_bbr1_notify_congestion(\n    picoquic_bbr1_state_t* bbr1_state,\n    picoquic_cnx_t* cnx,\n    picoquic_path_t* path_x,\n    uint64_t current_time,\n    int is_timeout)\n{\n    /* Apply filter of last loss */\n    if ((bbr1_state->cycle_on_loss || current_time < bbr1_state->loss_interval_start + path_x->smoothed_rtt) &&\n        (!is_timeout || bbr1_state->last_loss_was_timeout)) {\n        /* filter repeated loss events */\n        return;\n    }\n    if (is_timeout || path_x->cwin < PICOQUIC_CWIN_MINIMUM) {\n        if (!bbr1_state->is_suspended) {\n            bbr1_state->is_suspended = 1;\n            bbr1_state->cwin_before_suspension = path_x->cwin;\n        }\n        path_x->cwin = PICOQUIC_CWIN_MINIMUM;\n    } else {\n        path_x->cwin = path_x->cwin / 2;\n    }\n    bbr1_state->loss_interval_start = current_time;\n    bbr1_state->last_loss_was_timeout = is_timeout;\n    bbr1_state->congestion_sequence = picoquic_cc_get_sequence_number(cnx, path_x);\n\n    /* Update and check the packet loss rate */\n    if (bbr1_state->state == picoquic_bbr1_alg_startup_long_rtt) {\n        BBR1ExitStartupLongRtt(bbr1_state, path_x, current_time);\n    }\n    else if (bbr1_state->state == picoquic_bbr1_alg_startup) {\n        bbr1_state->filled_pipe = 1;\n        BBR1EnterDrain(bbr1_state, path_x, current_time);\n    }\n    else {\n        bbr1_state->cycle_on_loss = 1;\n    }\n}\n\n/*\n* Exit from suspension, after notification of spurious repeat.\n*/\nvoid picoquic_bbr1_suspension_almost_over(\n    picoquic_bbr1_state_t* bbr1_state,\n    uint64_t lost_packet_number)\n{\n    if (bbr1_state->is_suspended &&\n        bbr1_state->cwin_before_suspension > 0 &&\n        !bbr1_state->is_suspension_nearly_over &&\n        bbr1_state->congestion_sequence >= lost_packet_number) {\n        bbr1_state->is_suspension_nearly_over = 1;\n    }\n}\n\nvoid picoquic_bbr1_suspension_exit(\n    picoquic_bbr1_state_t* bbr1_state,\n    picoquic_path_t* path_x)\n{\n    if (bbr1_state->is_suspended &&\n        bbr1_state->is_suspension_nearly_over) {\n        path_x->cwin = bbr1_state->cwin_before_suspension;\n        /* Set the pacing rate in picoquic sender */\n        picoquic_update_pacing_rate(path_x, bbr1_state->pacing_rate, bbr1_state->send_quantum);\n    }\n    bbr1_state->is_suspended = 0;\n    bbr1_state->is_suspension_nearly_over = 0;\n}\n\n\n\n\n/*\n * In order to implement BBR1, we map generic congestion notification\n * signals to the corresponding BBR1 actions.\n */\nstatic void picoquic_bbr1_notify(\n    picoquic_cnx_t* cnx,\n    picoquic_path_t* path_x,\n    picoquic_congestion_notification_t notification,\n    picoquic_per_ack_state_t* ack_state,\n    uint64_t current_time)\n{\n    picoquic_bbr1_state_t* bbr1_state = (picoquic_bbr1_state_t*)path_x->congestion_alg_state;\n    path_x->is_cc_data_updated = 1;\n\n    if (bbr1_state != NULL) {\n        switch (notification) {\n        case picoquic_congestion_notification_ecn_ec:\n            /* Non standard code to react on ECN_EC */\n            if (ack_state->lost_packet_number >= bbr1_state->congestion_sequence) {\n                picoquic_bbr1_notify_congestion(bbr1_state, cnx, path_x, current_time, 0);\n            }\n            break;\n        case picoquic_congestion_notification_repeat:\n        case picoquic_congestion_notification_timeout:\n            /* Non standard code to react to high rate of packet loss, or timeout loss */\n            if (ack_state->lost_packet_number >= bbr1_state->congestion_sequence &&\n                picoquic_cc_hystart_loss_test(&bbr1_state->rtt_filter, notification, ack_state->lost_packet_number, 0.20)) {\n                picoquic_bbr1_notify_congestion(bbr1_state, cnx, path_x, current_time,\n                    (notification == picoquic_congestion_notification_timeout) ? 1 : 0);\n            }\n            break;\n        case picoquic_congestion_notification_spurious_repeat:\n            if (bbr1_state->is_suspended) {\n                picoquic_bbr1_suspension_almost_over(bbr1_state, ack_state->lost_packet_number);\n            }\n            break;\n        case picoquic_congestion_notification_acknowledgement:\n            /* sum the amount of data acked per packet */\n            if (bbr1_state->is_suspended) {\n                picoquic_bbr1_suspension_exit(bbr1_state, path_x);\n            }\n            bbr1_state->bytes_delivered += ack_state->nb_bytes_acknowledged;\n\n            if (bbr1_state->state == picoquic_bbr1_alg_startup && path_x->rtt_min > BBR1_HYSTART_THRESHOLD_RTT) {\n                BBR1EnterStartupLongRTT(bbr1_state, path_x);\n            }\n\n            if (bbr1_state->state == picoquic_bbr1_alg_startup_long_rtt) {\n                if (picoquic_cc_hystart_test(&bbr1_state->rtt_filter, (cnx->is_time_stamp_enabled) ? ack_state->one_way_delay : ack_state->rtt_measurement,\n                    cnx->path[0]->pacing.packet_time_microsec, current_time, cnx->is_time_stamp_enabled)) {\n                    BBR1ExitStartupLongRtt(bbr1_state, path_x, current_time);\n                }\n            }\n\n            /* RTT measurements will happen after the bandwidth is estimated */\n            if (bbr1_state->state == picoquic_bbr1_alg_startup_long_rtt) {\n                uint64_t max_win;\n                uint64_t min_win;\n\n                BBR1UpdateBtlBw(bbr1_state, path_x, current_time);\n                if (ack_state->rtt_measurement <= bbr1_state->rt_prop) {\n                    bbr1_state->rt_prop = ack_state->rtt_measurement;\n                    bbr1_state->rt_prop_stamp = current_time;\n                }\n                if (path_x->last_time_acked_data_frame_sent > path_x->last_sender_limited_time) {\n                    path_x->cwin += picoquic_cc_slow_start_increase(path_x, bbr1_state->bytes_delivered);\n                }\n                bbr1_state->bytes_delivered = 0;\n\n                max_win = PICOQUIC_BYTES_FROM_RATE(bbr1_state->rt_prop, path_x->peak_bandwidth_estimate);\n                min_win = max_win /= 2;\n\n                if (path_x->cwin < min_win) {\n                    path_x->cwin = min_win;\n                }\n                else if (path_x->smoothed_rtt > PICOQUIC_TARGET_RENO_RTT) {\n                    path_x->pacing.bandwidth_pause = 1;\n                }\n\n                picoquic_update_pacing_data(path_x, 1);\n            } else {\n                BBR1UpdateOnACK(bbr1_state, path_x,\n                    ack_state->rtt_measurement, path_x->bytes_in_transit, 0 /* packets_lost */, bbr1_state->bytes_delivered,\n                    current_time);\n                /* Remember the number in flight before the next ACK -- TODO: update after send instead. */\n                bbr1_state->prior_in_flight = path_x->bytes_in_transit;\n                /* Reset the number of bytes delivered */\n                bbr1_state->bytes_delivered = 0;\n\n                if (bbr1_state->pacing_rate > 0) {\n                    /* Set the pacing rate in picoquic sender */\n                    picoquic_update_pacing_rate(path_x, bbr1_state->pacing_rate, bbr1_state->send_quantum);\n                }\n            }\n            break;\n        case picoquic_congestion_notification_cwin_blocked:\n            break;\n        case picoquic_congestion_notification_reset:\n            picoquic_bbr1_reset(bbr1_state, path_x, current_time);\n            break;\n        case picoquic_congestion_notification_seed_cwin:\n            if (bbr1_state->state == picoquic_bbr1_alg_startup_long_rtt) {\n                BBR1ExitStartupSeedBDP(bbr1_state, path_x, ack_state->nb_bytes_acknowledged, current_time);\n                picoquic_update_pacing_data(path_x, 1);\n            }\n            else if (bbr1_state->state == picoquic_bbr1_alg_startup){\n                /* If in initial startup phase, do something */\n                double seed_bw_estimate = (double)ack_state->nb_bytes_acknowledged;\n                uint64_t bwe;\n                seed_bw_estimate /= (double)path_x->smoothed_rtt;\n                seed_bw_estimate *= 1000000;\n                bwe = (uint64_t)seed_bw_estimate*2; /* Hack -- account for div by two in BBR1UpdateBtlBw */\n                if (path_x->bandwidth_estimate_max < bwe) {\n                    path_x->bandwidth_estimate_max = bwe;\n                    BBR1UpdateBtlBw(bbr1_state, path_x, current_time);\n                    BBR1SetPacingRate(bbr1_state);\n                    if (bbr1_state->pacing_rate > 0) {\n                        /* Set the pacing rate in picoquic sender */\n                        picoquic_update_pacing_rate(path_x, bbr1_state->pacing_rate, bbr1_state->send_quantum);\n                    }\n                }\n            }\n            break;\n        default:\n            /* ignore */\n            break;\n        }","numLines":200,"startLine":1118,"totalLines":1341}}}
