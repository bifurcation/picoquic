{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01P2s1HE9ZiBRe68De9mtLQq","type":"tool_result","content":"1068\t/* This is the per ACK processing, activated upon receiving an ACK.\n1069\t * At that point, we expect the following:\n1070\t *  - delivered has been updated to reflect all the data acked on the path.\n1071\t *  - the delivery rate sample has been computed.\n1072\t */\n1073\t\n1074\tvoid  BBR1UpdateOnACK(picoquic_bbr1_state_t* bbr1_state, picoquic_path_t* path_x,\n1075\t    uint64_t rtt_sample, uint64_t bytes_in_transit, uint64_t packets_lost, uint64_t bytes_delivered,\n1076\t    uint64_t current_time)\n1077\t{\n1078\t    BBR1UpdateModelAndState(bbr1_state, path_x, rtt_sample, bytes_in_transit,\n1079\t        packets_lost, current_time);\n1080\t    BBR1UpdateControlParameters(bbr1_state, path_x, bytes_in_transit, packets_lost, bytes_delivered);\n1081\t}\n1082\t\n1083\tvoid BBR1OnTransmit(picoquic_bbr1_state_t* bbr1_state, uint64_t bytes_in_transit, int is_app_limited)\n1084\t{\n1085\t    BBR1HandleRestartFromIdle(bbr1_state, bytes_in_transit, is_app_limited);\n1086\t}\n1087\t\n1088\t/* Dealing with recovery. What happens when all\n1089\t * the packets are lost, when all packets have been retransmitted.. */\n1090\t\n1091\tvoid BBR1OnAllPacketsLost(picoquic_bbr1_state_t* bbr1_state, picoquic_path_t* path_x)\n1092\t{\n1093\t    bbr1_state->prior_cwnd = BBR1SaveCwnd(bbr1_state, path_x);\n1094\t    path_x->cwin = path_x->send_mtu;\n1095\t}\n1096\t\n1097\tvoid BBR1OnEnterFastRecovery(picoquic_bbr1_state_t* bbr1_state, picoquic_path_t* path_x, uint64_t bytes_in_transit, uint64_t bytes_delivered )\n1098\t{\n1099\t    if (bytes_delivered < path_x->send_mtu) {\n1100\t        bytes_delivered = path_x->send_mtu;\n1101\t    }\n1102\t    bbr1_state->prior_cwnd = BBR1SaveCwnd(bbr1_state, path_x);\n1103\t    path_x->cwin = bytes_in_transit + bytes_delivered;\n1104\t    bbr1_state->packet_conservation = 1;\n1105\t}\n1106\t\n1107\tvoid BBR1AfterOneRoundtripInFastRecovery(picoquic_bbr1_state_t* bbr1_state)\n1108\t{\n1109\t    bbr1_state->packet_conservation = 0;\n1110\t}\n1111\t\n1112\tvoid BBR1ExitFastRecovery(picoquic_bbr1_state_t* bbr1_state, picoquic_path_t* path_x)\n1113\t{\n1114\t    bbr1_state->packet_conservation = 0;\n1115\t    BBR1RestoreCwnd(bbr1_state, path_x);\n1116\t}\n1117\t"}]},"parent_tool_use_id":null,"session_id":"36feb9dd-a64c-482f-8d2d-3dfde6f4c9e3","uuid":"dd841d0e-348f-4c4b-a237-7e0a5ddfed4d","timestamp":"2026-05-07T13:39:28.199Z","tool_use_result":{"type":"text","file":{"filePath":"/Users/richbarn/Projects/picoquic/picoquic/bbr1.c","content":"/* This is the per ACK processing, activated upon receiving an ACK.\n * At that point, we expect the following:\n *  - delivered has been updated to reflect all the data acked on the path.\n *  - the delivery rate sample has been computed.\n */\n\nvoid  BBR1UpdateOnACK(picoquic_bbr1_state_t* bbr1_state, picoquic_path_t* path_x,\n    uint64_t rtt_sample, uint64_t bytes_in_transit, uint64_t packets_lost, uint64_t bytes_delivered,\n    uint64_t current_time)\n{\n    BBR1UpdateModelAndState(bbr1_state, path_x, rtt_sample, bytes_in_transit,\n        packets_lost, current_time);\n    BBR1UpdateControlParameters(bbr1_state, path_x, bytes_in_transit, packets_lost, bytes_delivered);\n}\n\nvoid BBR1OnTransmit(picoquic_bbr1_state_t* bbr1_state, uint64_t bytes_in_transit, int is_app_limited)\n{\n    BBR1HandleRestartFromIdle(bbr1_state, bytes_in_transit, is_app_limited);\n}\n\n/* Dealing with recovery. What happens when all\n * the packets are lost, when all packets have been retransmitted.. */\n\nvoid BBR1OnAllPacketsLost(picoquic_bbr1_state_t* bbr1_state, picoquic_path_t* path_x)\n{\n    bbr1_state->prior_cwnd = BBR1SaveCwnd(bbr1_state, path_x);\n    path_x->cwin = path_x->send_mtu;\n}\n\nvoid BBR1OnEnterFastRecovery(picoquic_bbr1_state_t* bbr1_state, picoquic_path_t* path_x, uint64_t bytes_in_transit, uint64_t bytes_delivered )\n{\n    if (bytes_delivered < path_x->send_mtu) {\n        bytes_delivered = path_x->send_mtu;\n    }\n    bbr1_state->prior_cwnd = BBR1SaveCwnd(bbr1_state, path_x);\n    path_x->cwin = bytes_in_transit + bytes_delivered;\n    bbr1_state->packet_conservation = 1;\n}\n\nvoid BBR1AfterOneRoundtripInFastRecovery(picoquic_bbr1_state_t* bbr1_state)\n{\n    bbr1_state->packet_conservation = 0;\n}\n\nvoid BBR1ExitFastRecovery(picoquic_bbr1_state_t* bbr1_state, picoquic_path_t* path_x)\n{\n    bbr1_state->packet_conservation = 0;\n    BBR1RestoreCwnd(bbr1_state, path_x);\n}\n","numLines":50,"startLine":1068,"totalLines":1341}}}
