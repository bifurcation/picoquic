{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01X7MewR5gTXGCFk5NMPCM4r","type":"tool_result","content":"1\t//! Translation of `picoquic/bytestream.h`.\n2\t//!\n3\t//! A small cursor-over-buffer helper used by `logwriter.c` /\n4\t//! `logreader.c` (binlog) and the connection-id encoding paths.\n5\t//! Three storage modes share a single [`ByteStream`] type:\n6\t//!\n7\t//! * **Borrowed** — wrap a caller-owned slice via\n8\t//!   [`ByteStream::from_slice`].  C: `bytestream_ref_init`.\n9\t//! * **Inline** — a stack-allocated [`ByteStreamBuf`] holds 2560\n10\t//!   bytes of inline storage; [`ByteStreamBuf::stream`] hands out a\n11\t//!   [`ByteStream`] borrowing from it.  C: `bytestream_buf` +\n12\t//!   `bytestream_buf_init`.\n13\t//! * **Owned** — [`ByteStream::with_capacity`] returns a\n14\t//!   `ByteStream<'static>` that owns its heap buffer.  C:\n15\t//!   `bytestream_alloc` + `bytestream_delete` (the latter folds\n16\t//!   into `Drop`).\n17\t//!\n18\t//! ## Shape choices\n19\t//!\n20\t//! C: `bytestream { uint8_t* data; size_t size; size_t ptr; }`.\n21\t//! Rust: `ByteStream<'a> { data: ByteStreamData<'a>, ptr: usize }`.\n22\t//! `data` collapses the C `(uint8_t*, size_t)` pair into one slice\n23\t//! whose `.len()` subsumes `size`; the enum variant distinguishes\n24\t//! borrowed from owned storage so all three constructors produce\n25\t//! the same type.\n26\t//!\n27\t//! C `bytestream_buf { bytestream s; uint8_t buf[2560]; }` aliased\n28\t//! `s.data` against `buf` after init — a self-referential pair.\n29\t//! The Rust shape avoids that: [`ByteStreamBuf`] is just storage,\n30\t//! and [`ByteStreamBuf::stream`] returns a `ByteStream<'_>`\n31\t//! borrowing from the inline buffer for the duration of one I/O\n32\t//! pass.\n33\t//!\n34\t//! Operations are methods on [`ByteStream`].  C `int` 0/-1 returns\n35\t//! become `Result<T, Error>`; out-parameters fold into the `Ok`\n36\t//! variant (e.g., C `int byteread_int8(bytestream*, uint8_t*)`\n37\t//! becomes `fn read_u8(&mut self) -> Result<u8, Error>`).\n38\t//!\n39\t//! Phase 4: all function bodies are implemented.\n40\t\n41\tuse core::net::SocketAddr;\n42\t\n43\tuse crate::ConnectionId;\n44\tuse crate::Error;\n45\t\n46\t/// Inline-buffer capacity carried by [`ByteStreamBuf`].  C:\n47\t/// `BYTESTREAM_MAX_BUFFER_SIZE`.\n48\tpub const BYTESTREAM_MAX_BUFFER_SIZE: usize = 2560;\n49\t\n50\t/// Wire-format family tag for IPv4 (matches Linux AF_INET = 2).\n51\tconst WIRE_AF_INET: u64 = 2;\n52\t/// Wire-format family tag for IPv6 (matches Linux AF_INET6 = 10).\n53\tconst WIRE_AF_INET6: u64 = 10;\n54\t\n55\t/// Backing storage for a [`ByteStream`].\n56\t///\n57\t/// An enum so that all three C constructors (ref / buf / alloc)\n58\t/// produce a single [`ByteStream`] type rather than splitting into\n59\t/// \"borrowed\" and \"owned\" variants.\n60\tpub enum ByteStreamData<'a> {\n61\t    /// Slice borrowed from external storage — caller-supplied\n62\t    /// buffer ([`ByteStream::from_slice`]) or the inline buffer of\n63\t    /// a [`ByteStreamBuf`] ([`ByteStreamBuf::stream`]).\n64\t    Borrowed(&'a mut [u8]),\n65\t    /// Heap-allocated buffer owned by the bytestream.  Used by\n66\t    /// [`ByteStream::with_capacity`].  Freed by the [`Drop`] impl\n67\t    /// on the vector — replaces the explicit `bytestream_delete`\n68\t    /// call in C.\n69\t    Owned(Vec<u8>),\n70\t}\n71\t\n72\t/// Cursor over a byte buffer.  C: `bytestream`.\n73\t///\n74\t/// The cursor advances monotonically as bytes are read or written.\n75\t/// `data.len()` (under whichever variant) corresponds to the C\n76\t/// `size` field; the cursor offset corresponds to the C `ptr`\n77\t/// field.\n78\t// Fields are private (encapsulated).  The dead_code allow suppresses\n79\t// warnings until all outer consumers are wired in.\n80\t#[allow(dead_code)]\n81\tpub struct ByteStream<'a> {\n82\t    data: ByteStreamData<'a>,\n83\t    ptr: usize,\n84\t}\n85\t\n86\t/// Inline 2560-byte storage for a stack-allocated bytestream.\n87\t/// C: `bytestream_buf`.\n88\t///\n89\t/// Pair with [`ByteStreamBuf::stream`] to get a usable cursor:\n90\t///\n91\t/// ```ignore\n92\t/// let mut buf = ByteStreamBuf::default();\n93\t/// let s = buf.stream(128).unwrap();\n94\t/// // …read/write through `s`…\n95\t/// ```\n96\t///\n97\t/// Unlike the C struct this does not embed a `bytestream` field;\n98\t/// the cursor lives in the [`ByteStream`] returned by\n99\t/// [`stream`](Self::stream), borrowing from this inline buffer.\n100\t// See `ByteStream` for the rationale on the dead-code allow.\n101\t#[allow(dead_code)]\n102\tpub struct ByteStreamBuf {\n103\t    buf: [u8; BYTESTREAM_MAX_BUFFER_SIZE],\n104\t}\n105\t\n106\timpl Default for ByteStreamBuf {\n107\t    fn default() -> Self {\n108\t        Self {\n109\t            buf: [0; BYTESTREAM_MAX_BUFFER_SIZE],\n110\t        }\n111\t    }\n112\t}\n113\t\n114\timpl ByteStreamBuf {\n115\t    /// Initialize a [`ByteStream`] backed by this inline buffer,\n116\t    /// with active capacity `nb_bytes`.  Returns `None` when\n117\t    /// `nb_bytes` exceeds [`BYTESTREAM_MAX_BUFFER_SIZE`] (matching\n118\t    /// the C `NULL` return).  C: `bytestream_buf_init`.\n119\t    pub fn stream(&mut self, nb_bytes: usize) -> Option<ByteStream<'_>> {\n120\t        if nb_bytes > BYTESTREAM_MAX_BUFFER_SIZE {\n121\t            return None;\n122\t        }\n123\t        Some(ByteStream {\n124\t            data: ByteStreamData::Borrowed(&mut self.buf[..nb_bytes]),\n125\t            ptr: 0,\n126\t        })\n127\t    }\n128\t}\n129\t\n130\timpl<'a> ByteStream<'a> {\n131\t    fn data_ref(&self) -> &[u8] {\n132\t        match &self.data {\n133\t            ByteStreamData::Borrowed(s) => s,\n134\t            ByteStreamData::Owned(v) => v.as_slice(),\n135\t        }\n136\t    }\n137\t\n138\t    fn data_mut(&mut self) -> &mut [u8] {\n139\t        match &mut self.data {\n140\t            ByteStreamData::Borrowed(s) => s,\n141\t            ByteStreamData::Owned(v) => v.as_mut_slice(),\n142\t        }\n143\t    }\n144\t\n145\t    /// C: `bytestream_error` (picoquic/bytestream.c:433)\n146\t    ///\n147\t    /// Sets the cursor to end-of-buffer, disabling all subsequent operations.\n148\t    /// Callers additionally return `Err(Error::BufferTooSmall)` — the Rust\n149\t    /// equivalent of the C `-1` return value.\n150\t    fn set_error(&mut self) {\n151\t        let cap = self.data_ref().len();\n152\t        self.ptr = cap;\n153\t    }\n154\t\n155\t    /// Wrap a caller-owned mutable byte slice as a bytestream\n156\t    /// cursor.  C: `bytestream_ref_init`.\n157\t    ///\n158\t    /// The C function took `const void*` and cast away the const\n159\t    /// because the same struct served read and write callers.\n160\t    /// Rust takes `&mut [u8]` for both — read-only callers can\n161\t    /// still pass `&mut` to a buffer they treat as read-only.  A\n162\t    /// read-only-only split can be revisited once the read/write\n163\t    /// callers are fully translated.\n164\t    pub fn from_slice(bytes: &'a mut [u8]) -> Self {\n165\t        ByteStream {\n166\t            data: ByteStreamData::Borrowed(bytes),\n167\t            ptr: 0,\n168\t        }\n169\t    }\n170\t\n171\t    /// Full underlying buffer (offsets `0..size`).  C:\n172\t    /// `bytestream_data` returning `const uint8_t*`.\n173\t    pub fn as_bytes(&self) -> &[u8] {\n174\t        &self.data_ref()[..self.ptr]\n175\t    }\n176\t\n177\t    /// Slice from the cursor to the end of the buffer (offsets\n178\t    /// `len()..capacity()`).  C: `bytestream_ptr` returning\n179\t    /// `const uint8_t*`.\n180\t    ///\n181\t    /// REVIEW(open): only the encrypt/decrypt helpers in\n182\t    /// `quic/quicctx.c` use this — they want a writable tail to\n183\t    /// hand to the AEAD layer.  Keep until those callers are\n184\t    /// translated; if Phase 4 finds no users, drop it.\n185\t    pub fn tail(&self) -> &[u8] {\n186\t        &self.data_ref()[self.ptr..]\n187\t    }\n188\t\n189\t    /// Total active capacity (the C `size` field).  C:\n190\t    /// `bytestream_size`.\n191\t    pub fn capacity(&self) -> usize {\n192\t        self.data_ref().len()\n193\t    }\n194\t\n195\t    /// Bytes consumed so far (the C `ptr` field).  C:\n196\t    /// `bytestream_length`.\n197\t    pub fn len(&self) -> usize {\n198\t        self.ptr\n199\t    }\n200\t\n201\t    /// `true` when no bytes have been consumed yet.\n202\t    pub fn is_empty(&self) -> bool {\n203\t        self.len() == 0\n204\t    }\n205\t\n206\t    /// Bytes left between the cursor and the end of the buffer.\n207\t    /// C: `bytestream_remain`.\n208\t    pub fn remaining(&self) -> usize {\n209\t        self.data_ref().len() - self.ptr\n210\t    }\n211\t\n212\t    /// Rewind the cursor to offset 0 without touching the buffer.\n213\t    /// C: `bytestream_reset`.\n214\t    pub fn reset(&mut self) {\n215\t        self.ptr = 0;\n216\t    }\n217\t\n218\t    /// Rewind and zero the entire buffer.  C: `bytestream_clear` —\n219\t    /// `memset(s->data, 0, s->size)` then `s->ptr = 0`.\n220\t    pub fn clear(&mut self) {\n221\t        self.ptr = 0;\n222\t        self.data_mut().fill(0);\n223\t    }\n224\t\n225\t    /// `true` when the cursor has reached the end of the buffer.\n226\t    /// C: `bytestream_finished` returning `int` (0/1).\n227\t    pub fn is_finished(&self) -> bool {\n228\t        self.ptr >= self.data_ref().len()\n229\t    }\n230\t\n231\t    /// Advance the cursor by `nb_bytes` without reading or\n232\t    /// writing.  On underflow, the C version sets `ptr = size`\n233\t    /// (forcing all subsequent operations to fail) and returns\n234\t    /// `-1`; the Rust version preserves that side effect and\n235\t    /// returns `Err`.  C: `bytestream_skip`.\n236\t    pub fn skip(&mut self, nb_bytes: usize) -> Result<(), Error> {\n237\t        if self.data_ref().len() - self.ptr < nb_bytes {\n238\t            self.set_error();\n239\t            return Err(Error::BufferTooSmall);\n240\t        }\n241\t        self.ptr += nb_bytes;\n242\t        Ok(())\n243\t    }\n244\t\n245\t    /// Write one byte.  C: `bytewrite_int8`.\n246\t    pub fn write_u8(&mut self, value: u8) -> Result<(), Error> {\n247\t        if self.ptr >= self.data_ref().len() {\n248\t            self.set_error();\n249\t            return Err(Error::BufferTooSmall);\n250\t        }\n251\t        let ptr = self.ptr;\n252\t        self.data_mut()[ptr] = value;\n253\t        self.ptr += 1;\n254\t        Ok(())\n255\t    }\n256\t\n257\t    /// Read one byte, advancing the cursor.  C: `byteread_int8`.\n258\t    pub fn read_u8(&mut self) -> Result<u8, Error> {\n259\t        if self.ptr >= self.data_ref().len() {\n260\t            self.set_error();\n261\t            return Err(Error::BufferTooSmall);\n262\t        }\n263\t        let v = self.data_ref()[self.ptr];\n264\t        self.ptr += 1;\n265\t        Ok(v)\n266\t    }\n267\t\n268\t    /// Read one byte without advancing the cursor.  C:\n269\t    /// `byteshow_int8`.\n270\t    ///\n271\t    /// The C version took a non-`const` pointer because every\n272\t    /// other function did; the Rust version takes `&self`.\n273\t    pub fn peek_u8(&self) -> Result<u8, Error> {\n274\t        if self.ptr >= self.data_ref().len() {\n275\t            return Err(Error::BufferTooSmall);\n276\t        }\n277\t        Ok(self.data_ref()[self.ptr])\n278\t    }\n279\t\n280\t    /// Write a big-endian `u16`.  C: `bytewrite_int16`.\n281\t    pub fn write_u16(&mut self, value: u16) -> Result<(), Error> {\n282\t        if self.data_ref().len() - self.ptr < 2 {\n283\t            self.set_error();\n284\t            return Err(Error::BufferTooSmall);\n285\t        }\n286\t        let ptr = self.ptr;\n287\t        self.data_mut()[ptr..ptr + 2].copy_from_slice(&value.to_be_bytes());\n288\t        self.ptr += 2;\n289\t        Ok(())\n290\t    }\n291\t\n292\t    /// Read a big-endian `u16`.  C: `byteread_int16`.\n293\t    pub fn read_u16(&mut self) -> Result<u16, Error> {\n294\t        if self.data_ref().len() - self.ptr < 2 {\n295\t            self.set_error();\n296\t            return Err(Error::BufferTooSmall);\n297\t        }\n298\t        let p = self.ptr;\n299\t        let d = self.data_ref();\n300\t        let v = u16::from_be_bytes([d[p], d[p + 1]]);\n301\t        self.ptr += 2;\n302\t        Ok(v)\n303\t    }\n304\t\n305\t    /// Write a big-endian `u32`.  C: `bytewrite_int32`.\n306\t    pub fn write_u32(&mut self, value: u32) -> Result<(), Error> {\n307\t        if self.data_ref().len() - self.ptr < 4 {\n308\t            self.set_error();\n309\t            return Err(Error::BufferTooSmall);\n310\t        }\n311\t        let ptr = self.ptr;\n312\t        self.data_mut()[ptr..ptr + 4].copy_from_slice(&value.to_be_bytes());\n313\t        self.ptr += 4;\n314\t        Ok(())\n315\t    }\n316\t\n317\t    /// Read a big-endian `u32`.  C: `byteread_int32`.\n318\t    pub fn read_u32(&mut self) -> Result<u32, Error> {\n319\t        if self.data_ref().len() - self.ptr < 4 {\n320\t            self.set_error();\n321\t            return Err(Error::BufferTooSmall);\n322\t        }\n323\t        let p = self.ptr;\n324\t        let d = self.data_ref();\n325\t        let v = u32::from_be_bytes([d[p], d[p + 1], d[p + 2], d[p + 3]]);\n326\t        self.ptr += 4;\n327\t        Ok(v)\n328\t    }\n329\t\n330\t    /// Write a big-endian `u64`.  C: `bytewrite_int64`.\n331\t    pub fn write_u64(&mut self, value: u64) -> Result<(), Error> {\n332\t        if self.data_ref().len() - self.ptr < 8 {\n333\t            self.set_error();\n334\t            return Err(Error::BufferTooSmall);\n335\t        }\n336\t        let ptr = self.ptr;\n337\t        self.data_mut()[ptr..ptr + 8].copy_from_slice(&value.to_be_bytes());\n338\t        self.ptr += 8;\n339\t        Ok(())\n340\t    }\n341\t\n342\t    /// Read a big-endian `u64`.  C: `byteread_int64`.\n343\t    pub fn read_u64(&mut self) -> Result<u64, Error> {\n344\t        if self.data_ref().len() - self.ptr < 8 {\n345\t            self.set_error();\n346\t            return Err(Error::BufferTooSmall);\n347\t        }\n348\t        let p = self.ptr;\n349\t        let d = self.data_ref();\n350\t        let v = u64::from_be_bytes([\n351\t            d[p],\n352\t            d[p + 1],\n353\t            d[p + 2],\n354\t            d[p + 3],\n355\t            d[p + 4],\n356\t            d[p + 5],\n357\t            d[p + 6],\n358\t            d[p + 7],\n359\t        ]);\n360\t        self.ptr += 8;\n361\t        Ok(v)\n362\t    }\n363\t\n364\t    /// Write a QUIC variable-length integer (RFC 9000 §16).  C:\n365\t    /// `bytewrite_vint`.\n366\t    pub fn write_varint(&mut self, value: u64) -> Result<(), Error> {\n367\t        let len = Self::varint_encoded_len(value);\n368\t        if self.data_ref().len() - self.ptr < len {\n369\t            self.set_error();\n370\t            return Err(Error::BufferTooSmall);\n371\t        }\n372\t        let ptr = self.ptr;\n373\t        let d = self.data_mut();\n374\t        match len {\n375\t            1 => d[ptr] = value as u8,\n376\t            2 => {\n377\t                d[ptr] = 0x40 | (value >> 8) as u8;\n378\t                d[ptr + 1] = value as u8;\n379\t            }\n380\t            4 => {\n381\t                d[ptr] = 0x80 | (value >> 24) as u8;\n382\t                d[ptr + 1] = (value >> 16) as u8;\n383\t                d[ptr + 2] = (value >> 8) as u8;\n384\t                d[ptr + 3] = value as u8;\n385\t            }\n386\t            _ => {\n387\t                d[ptr] = 0xC0 | (value >> 56) as u8;\n388\t                d[ptr + 1] = (value >> 48) as u8;\n389\t                d[ptr + 2] = (value >> 40) as u8;\n390\t                d[ptr + 3] = (value >> 32) as u8;\n391\t                d[ptr + 4] = (value >> 24) as u8;\n392\t                d[ptr + 5] = (value >> 16) as u8;\n393\t                d[ptr + 6] = (value >> 8) as u8;\n394\t                d[ptr + 7] = value as u8;\n395\t            }\n396\t        }\n397\t        self.ptr += len;\n398\t        Ok(())\n399\t    }\n400\t\n401\t    /// Read a QUIC variable-length integer.  C: `byteread_varint`.\n402\t    pub fn read_varint(&mut self) -> Result<u64, Error> {\n403\t        if self.ptr >= self.data_ref().len() {\n404\t            self.set_error();\n405\t            return Err(Error::BufferTooSmall);\n406\t        }\n407\t        let first = self.data_ref()[self.ptr];\n408\t        let len = 1usize << ((first >> 6) & 3);\n409\t        if self.data_ref().len() - self.ptr < len {\n410\t            self.set_error();\n411\t            return Err(Error::BufferTooSmall);\n412\t        }\n413\t        let p = self.ptr;\n414\t        let d = self.data_ref();\n415\t        let value = match len {\n416\t            1 => (first & 0x3F) as u64,\n417\t            2 => (((first & 0x3F) as u64) << 8) | (d[p + 1] as u64),\n418\t            4 => {\n419\t                (((first & 0x3F) as u64) << 24)\n420\t                    | ((d[p + 1] as u64) << 16)\n421\t                    | ((d[p + 2] as u64) << 8)\n422\t                    | (d[p + 3] as u64)\n423\t            }\n424\t            _ => {\n425\t                (((first & 0x3F) as u64) << 56)\n426\t                    | ((d[p + 1] as u64) << 48)\n427\t                    | ((d[p + 2] as u64) << 40)\n428\t                    | ((d[p + 3] as u64) << 32)\n429\t                    | ((d[p + 4] as u64) << 24)\n430\t                    | ((d[p + 5] as u64) << 16)\n431\t                    | ((d[p + 6] as u64) << 8)\n432\t                    | (d[p + 7] as u64)\n433\t            }\n434\t        };\n435\t        self.ptr += len;\n436\t        Ok(value)\n437\t    }\n438\t\n439\t    /// Skip past a QUIC variable-length integer without decoding\n440\t    /// it.  C: `byteread_skip_varint`.\n441\t    pub fn skip_varint(&mut self) -> Result<(), Error> {\n442\t        if self.ptr >= self.data_ref().len() {\n443\t            self.set_error();\n444\t            return Err(Error::BufferTooSmall);\n445\t        }\n446\t        let first = self.data_ref()[self.ptr];\n447\t        let len = 1usize << ((first >> 6) & 3);\n448\t        self.skip(len)\n449\t    }\n450\t\n451\t    /// Read a varint and downcast to `usize`.  C: `byteread_vlen`.\n452\t    /// Returns `Err` when the value doesn't fit in a `usize` on\n453\t    /// the target.  Mirrors the C check `*value != val_read`.\n454\t    pub fn read_vlen(&mut self) -> Result<usize, Error> {\n455\t        let val = self.read_varint()?;\n456\t        let as_usize = val as usize;\n457\t        if as_usize as u64 != val {\n458\t            return Err(Error::InvalidArgument);\n459\t        }\n460\t        Ok(as_usize)\n461\t    }\n462\t\n463\t    /// Copy `buffer.len()` bytes into the stream.  C:\n464\t    /// `bytewrite_buffer(s, buffer, length)` — the explicit\n465\t    /// `length` is taken from the slice.\n466\t    pub fn write_bytes(&mut self, buffer: &[u8]) -> Result<(), Error> {\n467\t        let length = buffer.len();\n468\t        if self.data_ref().len() - self.ptr < length {\n469\t            self.set_error();\n470\t            return Err(Error::BufferTooSmall);\n471\t        }\n472\t        let ptr = self.ptr;\n473\t        self.data_mut()[ptr..ptr + length].copy_from_slice(buffer);\n474\t        self.ptr += length;\n475\t        Ok(())\n476\t    }\n477\t\n478\t    /// Copy `buffer.len()` bytes out of the stream.  C:\n479\t    /// `byteread_buffer`.\n480\t    pub fn read_bytes(&mut self, buffer: &mut [u8]) -> Result<(), Error> {\n481\t        let length = buffer.len();\n482\t        if self.data_ref().len() - self.ptr < length {\n483\t            self.set_error();\n484\t            return Err(Error::BufferTooSmall);\n485\t        }\n486\t        buffer.copy_from_slice(&self.data_ref()[self.ptr..self.ptr + length]);\n487\t        self.ptr += length;\n488\t        Ok(())\n489\t    }\n490\t\n491\t    /// Encode a connection id as `u8` length + `id_len` raw bytes.\n492\t    /// C: `bytewrite_cid`.\n493\t    pub fn write_cid(&mut self, cid: &ConnectionId) -> Result<(), Error> {\n494\t        self.write_u8(cid.id_len)?;\n495\t        self.write_bytes(&cid.id[..cid.id_len as usize])\n496\t    }\n497\t\n498\t    /// Decode a connection id.  C: `byteread_cid` (the C version\n499\t    /// filled an out parameter; the Rust version returns the\n500\t    /// value).  Returns `Err` when the encoded length exceeds\n501\t    /// [`crate::CONNECTION_ID_MAX_SIZE`].\n502\t    pub fn read_cid(&mut self) -> Result<ConnectionId, Error> {\n503\t        let id_len = self.read_u8()?;\n504\t        if id_len as usize > crate::CONNECTION_ID_MAX_SIZE {\n505\t            self.set_error();\n506\t            return Err(Error::InvalidArgument);\n507\t        }\n508\t        let mut cid = ConnectionId {\n509\t            id_len,\n510\t            ..ConnectionId::default()\n511\t        };\n512\t        self.read_bytes(&mut cid.id[..id_len as usize])?;\n513\t        Ok(cid)\n514\t    }\n515\t\n516\t    /// Skip past an encoded connection id.  C: `byteskip_cid`.\n517\t    pub fn skip_cid(&mut self) -> Result<(), Error> {\n518\t        let id_len = self.read_u8()?;\n519\t        self.skip(id_len as usize)\n520\t    }\n521\t\n522\t    /// Encode a string as varint-length + raw bytes (no NUL on the\n523\t    /// wire).  C: `bytewrite_cstr` — took a `const char*` and\n524\t    /// called `strlen`; the Rust version takes a `&str` and uses\n525\t    /// its length directly.\n526\t    pub fn write_str(&mut self, s: &str) -> Result<(), Error> {\n527\t        let bytes = s.as_bytes();\n528\t        self.write_varint(bytes.len() as u64)?;\n529\t        self.write_bytes(bytes)\n530\t    }\n531\t\n532\t    /// Decode a length-prefixed string into `dst`, returning the\n533\t    /// number of bytes written.  C: `byteread_cstr(s, char* cstr,\n534\t    /// size_t max_len)` wrote a NUL-terminated string and required\n535\t    /// `length + 1 <= max_len`; the Rust version writes raw bytes\n536\t    /// (callers reconstruct a `&str`/`&CStr` themselves) and\n537\t    /// returns `Err` when `length > dst.len()`.\n538\t    pub fn read_str(&mut self, dst: &mut [u8]) -> Result<usize, Error> {\n539\t        let l_read = self.read_varint()?;\n540\t        let l = l_read as usize;\n541\t        if (l_read as usize as u64) != l_read {\n542\t            self.set_error();\n543\t            return Err(Error::InvalidArgument);\n544\t        }\n545\t        if l > dst.len() {\n546\t            self.set_error();\n547\t            return Err(Error::BufferTooSmall);\n548\t        }\n549\t        self.read_bytes(&mut dst[..l])?;\n550\t        Ok(l)\n551\t    }\n552\t\n553\t    /// Skip past a length-prefixed string.  C: `byteskip_cstr`.\n554\t    pub fn skip_str(&mut self) -> Result<(), Error> {\n555\t        let l_read = self.read_varint()?;\n556\t        let l = l_read as usize;\n557\t        if (l_read as usize as u64) != l_read {\n558\t            self.set_error();\n559\t            return Err(Error::InvalidArgument);\n560\t        }\n561\t        self.skip(l)\n562\t    }\n563\t\n564\t    /// Encode a socket address as varint(family) + 4 or 16 raw\n565\t    /// bytes (address) + big-endian `u16` (port).  C:\n566\t    /// `bytewrite_addr`, which branched on `sa_family`; the Rust\n567\t    /// version uses [`SocketAddr`].\n568\t    pub fn write_addr(&mut self, addr: &SocketAddr) -> Result<(), Error> {\n569\t        match addr {\n570\t            SocketAddr::V4(a) => {\n571\t                self.write_varint(WIRE_AF_INET)?;\n572\t                self.write_bytes(&a.ip().octets())?;\n573\t                self.write_u16(a.port())?;\n574\t            }\n575\t            SocketAddr::V6(a) => {\n576\t                self.write_varint(WIRE_AF_INET6)?;\n577\t                self.write_bytes(&a.ip().octets())?;\n578\t                self.write_u16(a.port())?;\n579\t            }\n580\t        }\n581\t        Ok(())\n582\t    }\n583\t\n584\t    /// Decode a socket address.  C: `byteread_addr` (the C version\n585\t    /// filled a `sockaddr_storage` out parameter; the Rust version\n586\t    /// returns the value).\n587\t    pub fn read_addr(&mut self) -> Result<SocketAddr, Error> {\n588\t        let family = self.read_varint()?;\n589\t        if family == WIRE_AF_INET {\n590\t            let mut octets = [0u8; 4];\n591\t            self.read_bytes(&mut octets)?;\n592\t            let port = self.read_u16()?;\n593\t            Ok(SocketAddr::from((octets, port)))\n594\t        } else {\n595\t            let mut octets = [0u8; 16];\n596\t            self.read_bytes(&mut octets)?;\n597\t            let port = self.read_u16()?;\n598\t            Ok(SocketAddr::from((octets, port)))\n599\t        }\n600\t    }\n601\t\n602\t    /// Skip past an encoded socket address.  C: `byteskip_addr`.\n603\t    pub fn skip_addr(&mut self) -> Result<(), Error> {\n604\t        let family = self.read_varint()?;\n605\t        if family == WIRE_AF_INET {\n606\t            self.skip(4 + 2)\n607\t        } else {\n608\t            self.skip(16 + 2)\n609\t        }\n610\t    }\n611\t}\n612\t\n613\timpl ByteStream<'static> {\n614\t    /// Allocate a fresh `nb_bytes`-byte heap buffer and return a\n615\t    /// bytestream that owns it.  Returns `None` on allocation\n616\t    /// failure.  C: `bytestream_alloc`.\n617\t    ///\n618\t    /// The C signature took a pre-existing `bytestream*` and only\n619\t    /// allocated `s->data`; the Rust version bundles construction\n620\t    /// and allocation, since the bytestream now owns the buffer\n621\t    /// through [`ByteStreamData::Owned`].  The matching C\n622\t    /// `bytestream_delete` has no Rust equivalent — drop the\n623\t    /// `ByteStream` to free.\n624\t    pub fn with_capacity(nb_bytes: usize) -> Option<Self> {\n625\t        let mut v = Vec::new();\n626\t        v.try_reserve_exact(nb_bytes).ok()?;\n627\t        v.resize(nb_bytes, 0);\n628\t        Some(ByteStream {\n629\t            data: ByteStreamData::Owned(v),\n630\t            ptr: 0,\n631\t        })\n632\t    }\n633\t}\n634\t\n635\timpl ByteStream<'_> {\n636\t    /// Encoded byte-length of `value` as a QUIC varint (1, 2, 4,\n637\t    /// or 8 bytes).  C: `bytestream_varint_len`.\n638\t    pub fn varint_encoded_len(value: u64) -> usize {\n639\t        if value <= 0x3F {\n640\t            1\n641\t        } else if value <= 0x3FFF {\n642\t            2\n643\t        } else if value <= 0x3FFF_FFFF {\n644\t            4\n645\t        } else {\n646\t            8\n647\t        }\n648\t    }\n649\t}\n650\t\n651\t#[cfg(test)]\n652\tmod test {}\n653\t"}]},"parent_tool_use_id":null,"session_id":"36feb9dd-a64c-482f-8d2d-3dfde6f4c9e3","uuid":"a1366b1b-33fe-4fff-97da-3b1814fd9db6","timestamp":"2026-05-07T13:38:39.525Z","tool_use_result":{"type":"text","file":{"filePath":"/Users/richbarn/Projects/picoquic/rs/fq/src/bytestream.rs","content":"//! Translation of `picoquic/bytestream.h`.\n//!\n//! A small cursor-over-buffer helper used by `logwriter.c` /\n//! `logreader.c` (binlog) and the connection-id encoding paths.\n//! Three storage modes share a single [`ByteStream`] type:\n//!\n//! * **Borrowed** — wrap a caller-owned slice via\n//!   [`ByteStream::from_slice`].  C: `bytestream_ref_init`.\n//! * **Inline** — a stack-allocated [`ByteStreamBuf`] holds 2560\n//!   bytes of inline storage; [`ByteStreamBuf::stream`] hands out a\n//!   [`ByteStream`] borrowing from it.  C: `bytestream_buf` +\n//!   `bytestream_buf_init`.\n//! * **Owned** — [`ByteStream::with_capacity`] returns a\n//!   `ByteStream<'static>` that owns its heap buffer.  C:\n//!   `bytestream_alloc` + `bytestream_delete` (the latter folds\n//!   into `Drop`).\n//!\n//! ## Shape choices\n//!\n//! C: `bytestream { uint8_t* data; size_t size; size_t ptr; }`.\n//! Rust: `ByteStream<'a> { data: ByteStreamData<'a>, ptr: usize }`.\n//! `data` collapses the C `(uint8_t*, size_t)` pair into one slice\n//! whose `.len()` subsumes `size`; the enum variant distinguishes\n//! borrowed from owned storage so all three constructors produce\n//! the same type.\n//!\n//! C `bytestream_buf { bytestream s; uint8_t buf[2560]; }` aliased\n//! `s.data` against `buf` after init — a self-referential pair.\n//! The Rust shape avoids that: [`ByteStreamBuf`] is just storage,\n//! and [`ByteStreamBuf::stream`] returns a `ByteStream<'_>`\n//! borrowing from the inline buffer for the duration of one I/O\n//! pass.\n//!\n//! Operations are methods on [`ByteStream`].  C `int` 0/-1 returns\n//! become `Result<T, Error>`; out-parameters fold into the `Ok`\n//! variant (e.g., C `int byteread_int8(bytestream*, uint8_t*)`\n//! becomes `fn read_u8(&mut self) -> Result<u8, Error>`).\n//!\n//! Phase 4: all function bodies are implemented.\n\nuse core::net::SocketAddr;\n\nuse crate::ConnectionId;\nuse crate::Error;\n\n/// Inline-buffer capacity carried by [`ByteStreamBuf`].  C:\n/// `BYTESTREAM_MAX_BUFFER_SIZE`.\npub const BYTESTREAM_MAX_BUFFER_SIZE: usize = 2560;\n\n/// Wire-format family tag for IPv4 (matches Linux AF_INET = 2).\nconst WIRE_AF_INET: u64 = 2;\n/// Wire-format family tag for IPv6 (matches Linux AF_INET6 = 10).\nconst WIRE_AF_INET6: u64 = 10;\n\n/// Backing storage for a [`ByteStream`].\n///\n/// An enum so that all three C constructors (ref / buf / alloc)\n/// produce a single [`ByteStream`] type rather than splitting into\n/// \"borrowed\" and \"owned\" variants.\npub enum ByteStreamData<'a> {\n    /// Slice borrowed from external storage — caller-supplied\n    /// buffer ([`ByteStream::from_slice`]) or the inline buffer of\n    /// a [`ByteStreamBuf`] ([`ByteStreamBuf::stream`]).\n    Borrowed(&'a mut [u8]),\n    /// Heap-allocated buffer owned by the bytestream.  Used by\n    /// [`ByteStream::with_capacity`].  Freed by the [`Drop`] impl\n    /// on the vector — replaces the explicit `bytestream_delete`\n    /// call in C.\n    Owned(Vec<u8>),\n}\n\n/// Cursor over a byte buffer.  C: `bytestream`.\n///\n/// The cursor advances monotonically as bytes are read or written.\n/// `data.len()` (under whichever variant) corresponds to the C\n/// `size` field; the cursor offset corresponds to the C `ptr`\n/// field.\n// Fields are private (encapsulated).  The dead_code allow suppresses\n// warnings until all outer consumers are wired in.\n#[allow(dead_code)]\npub struct ByteStream<'a> {\n    data: ByteStreamData<'a>,\n    ptr: usize,\n}\n\n/// Inline 2560-byte storage for a stack-allocated bytestream.\n/// C: `bytestream_buf`.\n///\n/// Pair with [`ByteStreamBuf::stream`] to get a usable cursor:\n///\n/// ```ignore\n/// let mut buf = ByteStreamBuf::default();\n/// let s = buf.stream(128).unwrap();\n/// // …read/write through `s`…\n/// ```\n///\n/// Unlike the C struct this does not embed a `bytestream` field;\n/// the cursor lives in the [`ByteStream`] returned by\n/// [`stream`](Self::stream), borrowing from this inline buffer.\n// See `ByteStream` for the rationale on the dead-code allow.\n#[allow(dead_code)]\npub struct ByteStreamBuf {\n    buf: [u8; BYTESTREAM_MAX_BUFFER_SIZE],\n}\n\nimpl Default for ByteStreamBuf {\n    fn default() -> Self {\n        Self {\n            buf: [0; BYTESTREAM_MAX_BUFFER_SIZE],\n        }\n    }\n}\n\nimpl ByteStreamBuf {\n    /// Initialize a [`ByteStream`] backed by this inline buffer,\n    /// with active capacity `nb_bytes`.  Returns `None` when\n    /// `nb_bytes` exceeds [`BYTESTREAM_MAX_BUFFER_SIZE`] (matching\n    /// the C `NULL` return).  C: `bytestream_buf_init`.\n    pub fn stream(&mut self, nb_bytes: usize) -> Option<ByteStream<'_>> {\n        if nb_bytes > BYTESTREAM_MAX_BUFFER_SIZE {\n            return None;\n        }\n        Some(ByteStream {\n            data: ByteStreamData::Borrowed(&mut self.buf[..nb_bytes]),\n            ptr: 0,\n        })\n    }\n}\n\nimpl<'a> ByteStream<'a> {\n    fn data_ref(&self) -> &[u8] {\n        match &self.data {\n            ByteStreamData::Borrowed(s) => s,\n            ByteStreamData::Owned(v) => v.as_slice(),\n        }\n    }\n\n    fn data_mut(&mut self) -> &mut [u8] {\n        match &mut self.data {\n            ByteStreamData::Borrowed(s) => s,\n            ByteStreamData::Owned(v) => v.as_mut_slice(),\n        }\n    }\n\n    /// C: `bytestream_error` (picoquic/bytestream.c:433)\n    ///\n    /// Sets the cursor to end-of-buffer, disabling all subsequent operations.\n    /// Callers additionally return `Err(Error::BufferTooSmall)` — the Rust\n    /// equivalent of the C `-1` return value.\n    fn set_error(&mut self) {\n        let cap = self.data_ref().len();\n        self.ptr = cap;\n    }\n\n    /// Wrap a caller-owned mutable byte slice as a bytestream\n    /// cursor.  C: `bytestream_ref_init`.\n    ///\n    /// The C function took `const void*` and cast away the const\n    /// because the same struct served read and write callers.\n    /// Rust takes `&mut [u8]` for both — read-only callers can\n    /// still pass `&mut` to a buffer they treat as read-only.  A\n    /// read-only-only split can be revisited once the read/write\n    /// callers are fully translated.\n    pub fn from_slice(bytes: &'a mut [u8]) -> Self {\n        ByteStream {\n            data: ByteStreamData::Borrowed(bytes),\n            ptr: 0,\n        }\n    }\n\n    /// Full underlying buffer (offsets `0..size`).  C:\n    /// `bytestream_data` returning `const uint8_t*`.\n    pub fn as_bytes(&self) -> &[u8] {\n        &self.data_ref()[..self.ptr]\n    }\n\n    /// Slice from the cursor to the end of the buffer (offsets\n    /// `len()..capacity()`).  C: `bytestream_ptr` returning\n    /// `const uint8_t*`.\n    ///\n    /// REVIEW(open): only the encrypt/decrypt helpers in\n    /// `quic/quicctx.c` use this — they want a writable tail to\n    /// hand to the AEAD layer.  Keep until those callers are\n    /// translated; if Phase 4 finds no users, drop it.\n    pub fn tail(&self) -> &[u8] {\n        &self.data_ref()[self.ptr..]\n    }\n\n    /// Total active capacity (the C `size` field).  C:\n    /// `bytestream_size`.\n    pub fn capacity(&self) -> usize {\n        self.data_ref().len()\n    }\n\n    /// Bytes consumed so far (the C `ptr` field).  C:\n    /// `bytestream_length`.\n    pub fn len(&self) -> usize {\n        self.ptr\n    }\n\n    /// `true` when no bytes have been consumed yet.\n    pub fn is_empty(&self) -> bool {\n        self.len() == 0\n    }\n\n    /// Bytes left between the cursor and the end of the buffer.\n    /// C: `bytestream_remain`.\n    pub fn remaining(&self) -> usize {\n        self.data_ref().len() - self.ptr\n    }\n\n    /// Rewind the cursor to offset 0 without touching the buffer.\n    /// C: `bytestream_reset`.\n    pub fn reset(&mut self) {\n        self.ptr = 0;\n    }\n\n    /// Rewind and zero the entire buffer.  C: `bytestream_clear` —\n    /// `memset(s->data, 0, s->size)` then `s->ptr = 0`.\n    pub fn clear(&mut self) {\n        self.ptr = 0;\n        self.data_mut().fill(0);\n    }\n\n    /// `true` when the cursor has reached the end of the buffer.\n    /// C: `bytestream_finished` returning `int` (0/1).\n    pub fn is_finished(&self) -> bool {\n        self.ptr >= self.data_ref().len()\n    }\n\n    /// Advance the cursor by `nb_bytes` without reading or\n    /// writing.  On underflow, the C version sets `ptr = size`\n    /// (forcing all subsequent operations to fail) and returns\n    /// `-1`; the Rust version preserves that side effect and\n    /// returns `Err`.  C: `bytestream_skip`.\n    pub fn skip(&mut self, nb_bytes: usize) -> Result<(), Error> {\n        if self.data_ref().len() - self.ptr < nb_bytes {\n            self.set_error();\n            return Err(Error::BufferTooSmall);\n        }\n        self.ptr += nb_bytes;\n        Ok(())\n    }\n\n    /// Write one byte.  C: `bytewrite_int8`.\n    pub fn write_u8(&mut self, value: u8) -> Result<(), Error> {\n        if self.ptr >= self.data_ref().len() {\n            self.set_error();\n            return Err(Error::BufferTooSmall);\n        }\n        let ptr = self.ptr;\n        self.data_mut()[