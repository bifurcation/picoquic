", \"Unsupported Algorithm ID\");\n639\t        ret = -1;\n640\t    }\n641\t    if (ret == 0) {\n642\t        if (public_key_bit_string.len > 1 && public_key_bit_string.base[0] == 0) {\n643\t            public_key_bits->base = public_key_bit_string.base + 1;\n644\t            public_key_bits->len = public_key_bit_string.len - 1;\n645\t            if (public_key_bits->len != expected_key_length) {\n646\t                DBG_PRINTF(\"Invalid length for curve 0x%04x: %zu, expected %zu\",\n647\t                    *group_id, public_key_bits->len, expected_key_length);\n648\t                ret = -1;\n649\t            }\n650\t        }\n651\t    }\n652\t    return ret;\n653\t}\n654\t\n655\tint picoquic_ech_get_kem_from_curve(ptls_hpke_kem_t **kem, uint16_t group_id)\n656\t{\n657\t    int ret = -1;\n658\t\n659\t    for (int i = 0; i < PICOQUIC_HPKE_KEM_NB_MAX; i++) {\n660\t        if (picoquic_hpke_kems[i] == NULL) {\n661\t            break;\n662\t        }\n663\t        else if (picoquic_hpke_kems[i]->keyex->id == group_id) {\n664\t            *kem = picoquic_hpke_kems[i];\n665\t            ret = 0;\n666\t            break;\n667\t        }\n668\t    }\n669\t    return ret;\n670\t}\n671\t\n672\tint picoquic_ech_get_ciphers_from_kem(ptls_hpke_cipher_suite_t** cipher_vec, size_t cipher_vec_nb_max, uint16_t kem_id)\n673\t{\n674\t    int ret = 0;\n675\t    size_t nb_ciphers = 0;\n676\t    uint16_t target_kdf_id = PTLS_HPKE_HKDF_SHA256;\n677\t    uint16_t target_aead_id = PTLS_HPKE_AEAD_AES_128_GCM;\n678\t    ptls_hpke_cipher_suite_t* target_cipher = NULL;\n679\t    ptls_hpke_cipher_suite_t* default_cipher = NULL;\n680\t\n681\t    if (cipher_vec_nb_max < 2) {\n682\t        return -1;\n683\t    }\n684\t\n685\t    switch (kem_id) {\n686\t    case PTLS_HPKE_KEM_P256_SHA256:\n687\t        target_kdf_id = PTLS_HPKE_HKDF_SHA256;\n688\t        target_aead_id = PTLS_HPKE_AEAD_AES_128_GCM;\n689\t        break;\n690\t    case PTLS_HPKE_KEM_P384_SHA384:\n691\t        target_kdf_id = PTLS_