{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01RLcCLyh4iXed5taUELLVqN","type":"tool_result","content":"1\t//! Encrypted ClientHello (ECH) helpers.\n2\t//!\n3\t//! Pure-Rust portion of the ECH support layer.  The HPKE key-exchange\n4\t//! operations that require ECDH primitives (DHKEM-X25519, DHKEM-P256,\n5\t//! DHKEM-P384) are currently `todo!()` pending the addition of the `hpke`\n6\t//! crate to Cargo.toml.  Everything else — the cipher-suite selector, the\n7\t//! config-ID digest, base64 encoding, and the opener-state plumbing — is\n8\t//! fully translated from `picoquic/ech.c`.\n9\t\n10\textern crate alloc;\n11\tuse alloc::vec::Vec;\n12\t\n13\tuse crate::Error;\n14\t\n15\t// ---------------------------------------------------------------------------\n16\t// HPKE constants (IANA registries, RFC 9180).\n17\t\n18\t/// HPKE KEM algorithm identifiers (RFC 9180 §7.1).\n19\tpub mod kem_id {\n20\t    /// DHKEM(P-256, HKDF-SHA256)\n21\t    pub const P256_SHA256: u16 = 0x0010;\n22\t    /// DHKEM(P-384, HKDF-SHA384)\n23\t    pub const P384_SHA384: u16 = 0x0011;\n24\t    /// DHKEM(X25519, HKDF-SHA256)\n25\t    pub const X25519_SHA256: u16 = 0x0020;\n26\t}\n27\t\n28\t/// HPKE KDF algorithm identifiers (RFC 9180 §7.2).\n29\tpub mod kdf_id {\n30\t    /// HKDF-SHA256\n31\t    pub const HKDF_SHA256: u16 = 0x0001;\n32\t    /// HKDF-SHA384\n33\t    pub const HKDF_SHA384: u16 = 0x0002;\n34\t    /// HKDF-SHA512\n35\t    pub const HKDF_SHA512: u16 = 0x0003;\n36\t}\n37\t\n38\t/// HPKE AEAD algorithm identifiers (RFC 9180 §7.3).\n39\tpub mod aead_id {\n40\t    /// AES-128-GCM\n41\t    pub const AES_128_GCM: u16 = 0x0001;\n42\t    /// AES-256-GCM\n43\t    pub const AES_256_GCM: u16 = 0x0002;\n44\t    /// ChaCha20-Poly1305\n45\t    pub const CHACHA20_POLY1305: u16 = 0x0003;\n46\t}\n47\t\n48\t// ---------------------------------------------------------------------------\n49\t// Cipher-suite identifier.\n50\t\n51\t/// HPKE symmetric cipher-suite: (KDF id, AEAD id) pair.\n52\t///\n53\t/// C: `ptls_hpke_cipher_suite_id_t`\n54\t#[derive(Debug, Clone, Copy, PartialEq, Eq)]\n55\tpub struct HpkeCipherSuiteId {\n56\t    pub kdf: u16,\n57\t    pub aead: u16,\n58\t}\n59\t\n60\t/// The three cipher suites we advertise as supported, mirroring the\n61\t/// `picoquic_hpke_cipher_suites[]` array that the C picotls backend\n62\t/// populates at startup.\n63\tconst SUPPORTED_CIPHER_SUITES: &[HpkeCipherSuiteId] = &[\n64\t    HpkeCipherSuiteId {\n65\t        kdf: kdf_id::HKDF_SHA256,\n66\t        aead: aead_id::AES_128_GCM,\n67\t    },\n68\t    HpkeCipherSuiteId {\n69\t        kdf: kdf_id::HKDF_SHA256,\n70\t        aead: aead_id::CHACHA20_POLY1305,\n71\t    },\n72\t    HpkeCipherSuiteId {\n73\t        kdf: kdf_id::HKDF_SHA384,\n74\t        aead: aead_id::AES_256_GCM,\n75\t    },\n76\t];\n77\t\n78\t// ---------------------------------------------------------------------------\n79\t// Base64 encoding.\n80\t\n81\tconst BASE64_ALPHABET: &[u8; 64] =\n82\t    b\"ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789+/\";\n83\t\n84\t/// Return the number of base64 characters needed to encode `input_len` bytes,\n85\t/// not counting a NUL terminator.  Mirrors `ptls_base64_howlong`.\n86\t#[inline]\n87\tpub fn base64_encoded_len(input_len: usize) -> usize {\n88\t    input_len.div_ceil(3) * 4\n89\t}\n90\t\n91\t/// Encode `input` as standard RFC 4648 base64 into `out`.\n92\t///\n93\t/// `out` must be at least `base64_encoded_len(input.len()) + 1` bytes long\n94\t/// (the extra byte is for the NUL terminator written to match picotls\n95\t/// convention).  Returns the number of base64 characters written (excluding\n96\t/// the NUL).  Returns `Err(Error::Generic)` when `out` is too small.\n97\t///\n98\t/// C: `picoquic_base64_encode`\n99\tpub fn base64_encode(input: &[u8], out: &mut [u8]) -> Result<usize, Error> {\n100\t    let len = base64_encoded_len(input.len());\n101\t    if len + 1 > out.len() {\n102\t        return Err(Error::Generic);\n103\t    }\n104\t    let mut pos = 0usize;\n105\t    let mut chunks = input.chunks_exact(3);\n106\t    for chunk in &mut chunks {\n107\t        let b = ((chunk[0] as u32) << 16) | ((chunk[1] as u32) << 8) | (chunk[2] as u32);\n108\t        out[pos] = BASE64_ALPHABET[((b >> 18) & 0x3f) as usize];\n109\t        out[pos + 1] = BASE64_ALPHABET[((b >> 12) & 0x3f) as usize];\n110\t        out[pos + 2] = BASE64_ALPHABET[((b >> 6) & 0x3f) as usize];\n111\t        out[pos + 3] = BASE64_ALPHABET[(b & 0x3f) as usize];\n112\t        pos += 4;\n113\t    }\n114\t    match chunks.remainder() {\n115\t        [a] => {\n116\t            let b = (*a as u32) << 16;\n117\t            out[pos] = BASE64_ALPHABET[((b >> 18) & 0x3f) as usize];\n118\t            out[pos + 1] = BASE64_ALPHABET[((b >> 12) & 0x3f) as usize];\n119\t            out[pos + 2] = b'=';\n120\t            out[pos + 3] = b'=';\n121\t            pos += 4;\n122\t        }\n123\t        [a, b] => {\n124\t            let v = ((*a as u32) << 16) | ((*b as u32) << 8);\n125\t            out[pos] = BASE64_ALPHABET[((v >> 18) & 0x3f) as usize];\n126\t            out[pos + 1] = BASE64_ALPHABET[((v >> 12) & 0x3f) as usize];\n127\t            out[pos + 2] = BASE64_ALPHABET[((v >> 6) & 0x3f) as usize];\n128\t            out[pos + 3] = b'=';\n129\t            pos += 4;\n130\t        }\n131\t        _ => {}\n132\t    }\n133\t    out[pos] = 0; // NUL terminator (mirrors ptls_base64_encode convention)\n134\t    Ok(len)\n135\t}\n136\t\n137\t// ---------------------------------------------------------------------------\n138\t// Cipher-suite selector.\n139\t\n140\t/// Fill `out` with HPKE cipher suites appropriate for `kem_id`, returning\n141\t/// the number of entries written.\n142\t///\n143\t/// The first entry is the preferred suite for the given KEM; when there is\n144\t/// also a suitable default suite (AES-128-GCM + HKDF-SHA256) that differs\n145\t/// from the preferred one and `out.len() > 2`, it is appended as the second\n146\t/// entry.\n147\t///\n148\t/// Returns `Err(Error::Generic)` if `out.len() < 2` (mirrors the C guard\n149\t/// `cipher_vec_nb_max < 2`) or if no suite can be found.\n150\t///\n151\t/// C: `picoquic_ech_get_ciphers_from_kem`\n152\tpub fn ech_get_ciphers_from_kem(\n153\t    kem_id: u16,\n154\t    out: &mut [HpkeCipherSuiteId],\n155\t) -> Result<usize, Error> {\n156\t    if out.len() < 2 {\n157\t        return Err(Error::Generic);\n158\t    }\n159\t\n160\t    let (target_kdf, target_aead) = match kem_id {\n161\t        kem_id::P256_SHA256 => (kdf_id::HKDF_SHA256, aead_id::AES_128_GCM),\n162\t        kem_id::P384_SHA384 => (kdf_id::HKDF_SHA384, aead_id::AES_256_GCM),\n163\t        kem_id::X25519_SHA256 => (kdf_id::HKDF_SHA256, aead_id::CHACHA20_POLY1305),\n164\t        _ => (kdf_id::HKDF_SHA256, aead_id::AES_128_GCM),\n165\t    };\n166\t    let target = HpkeCipherSuiteId {\n167\t        kdf: target_kdf,\n168\t        aead: target_aead,\n169\t    };\n170\t    let default_suite = HpkeCipherSuiteId {\n171\t        kdf: kdf_id::HKDF_SHA256,\n172\t        aead: aead_id::AES_128_GCM,\n173\t    };\n174\t\n175\t    let mut target_cipher: Option<HpkeCipherSuiteId> = None;\n176\t    let mut default_cipher: Option<HpkeCipherSuiteId> = None;\n177\t\n178\t    for &suite in SUPPORTED_CIPHER_SUITES {\n179\t        if target_cipher.is_none() && suite == target {\n180\t            target_cipher = Some(suite);\n181\t        }\n182\t        if default_cipher.is_none() && suite == default_suite {\n183\t            default_cipher = Some(suite);\n184\t        }\n185\t    }\n186\t\n187\t    // Mirrors the C branching: target first; fall back to default; error if neither.\n188\t    // C: `cipher_vec_nb_max > 2` guards adding the default as a second entry.\n189\t    let nb_ciphers = match (target_cipher, default_cipher) {\n190\t        (Some(t), def) => {\n191\t            out[0] = t;\n192\t            if let Some(d) = def {\n193\t                if d != t && out.len() > 2 {\n194\t                    out[1] = d;\n195\t                    2\n196\t                } else {\n197\t                    1\n198\t                }\n199\t            } else {\n200\t                1\n201\t            }\n202\t        }\n203\t        (None, Some(d)) => {\n204\t            out[0] = d;\n205\t            1\n206\t        }\n207\t        (None, None) => return Err(Error::Generic),\n208\t    };\n209\t    Ok(nb_ciphers)\n210\t}\n211\t\n212\t// ---------------------------------------------------------------------------\n213\t// Config-ID derivation (private helper).\n214\t\n215\t/// Compute the one-byte ECH config-ID from the public key material, KEM id,\n216\t/// cipher suites, and the server public name.\n217\t///\n218\t/// The algorithm accumulates all bytes into a `u64` then XOR-folds the\n219\t/// result down to a single byte.\n220\t///\n221\t/// C: `ech_config_id_from_config` (file-static)\n222\tfn ech_config_id_from_config(\n223\t    public_key_bits: &[u8],\n224\t    kem_id: u16,\n225\t    cipher_suites: &[HpkeCipherSuiteId],\n226\t    public_name: &str,\n227\t) -> u8 {\n228\t    let mut config_sum: u64 = 0;\n229\t    for &b in public_key_bits {\n230\t        config_sum = config_sum.wrapping_add(b as u64);\n231\t    }\n232\t    config_sum = config_sum.wrapping_add(kem_id as u64);\n233\t    for cs in cipher_suites {\n234\t        config_sum = config_sum.wrapping_add(cs.aead as u64);\n235\t        config_sum = config_sum.wrapping_add(cs.kdf as u64);\n236\t    }\n237\t    for b in public_name.bytes() {\n238\t        config_sum = config_sum.wrapping_add(b as u64);\n239\t    }\n240\t    let mut config_id: u8 = 0;\n241\t    while config_sum > 0 {\n242\t        config_id ^= (config_sum & 0xff) as u8;\n243\t        config_sum >>= 8;\n244\t    }\n245\t    config_id\n246\t}\n247\t\n248\t// ---------------------------------------------------------------------------\n249\t// Server-side ECH opener state.\n250\t\n251\t/// Result returned by a successful [`EchOpenerState::open`] call.\n252\t///\n253\t/// When the HPKE decapsulation step is complete, `key_material` will hold\n254\t/// the derived AEAD key bytes; callers build the concrete AEAD context from\n255\t/// it together with `cipher`.\n256\tpub struct EchOpenResult {\n257\t    /// The negotiated cipher suite.\n258\t    pub cipher: HpkeCipherSuiteId,\n259\t    /// HPKE-derived key material for the AEAD context.  Empty until the\n260\t    /// DHKEM decapsulation is implemented.\n261\t    pub key_material: Vec<u8>,\n262\t}\n263\t\n264\t/// Server-side ECH opener callback state.\n265\t///\n266\t/// Holds the KEM id, the private key bytes used for HPKE decapsulation,\n267\t/// and the serialised ECH config bytes (used to reconstruct the HPKE `info`\n268\t/// string during opening).\n269\t///\n270\t/// C: `ech_opener_callback_t`\n271\tpub struct EchOpenerState {\n272\t    /// HPKE KEM identifier, e.g. `kem_id::X25519_SHA256`.\n273\t    /// C: `kem` (`ptls_hpke_kem_t*`; we store only the numeric id).\n274\t    pub kem_id: u16,\n275\t    /// Raw private key bytes for HPKE decapsulation.\n276\t    /// C: `keyex` (`ptls_key_exchange_context_t*` loaded from a PEM file).\n277\t    pub private_key: Vec<u8>,\n278\t    /// Serialised ECH config bytes including the two-byte outer length prefix.\n279\t    /// C: `config` (`ptls_buffer_t`).\n280\t    pub config: Vec<u8>,\n281\t}\n282\t\n283\timpl EchOpenerState {\n284\t    /// Attempt to open (decapsulate) an incoming ECH extension.\n285\t    ///\n286\t    /// Finds the cipher suite matching `cipher_id` in the supported list,\n287\t    /// builds the HPKE `info` string as `info_prefix || config[2..]`, and\n288\t    /// then performs the HPKE recipient setup to derive the AEAD key.\n289\t    ///\n290\t    /// Returns `Some(EchOpenResult)` on success, `None` when `cipher_id` is\n291\t    /// not in the supported list.\n292\t    ///\n293\t    /// # Blocker\n294\t    ///\n295\t    /// The HPKE decapsulation step (`ptls_hpke_setup_base_r` equivalent)\n296\t    /// requires DHKEM primitives.  Add the `hpke` crate with the\n297\t    /// `x25519`/`p256`/`p384` features to Cargo.toml and replace the\n298\t    /// `todo!()` below with the corresponding `hpke::setup_receiver` call.\n299\t    ///\n300\t    /// C: `ech_opener_callback`\n301\t    pub fn open(\n302\t        &self,\n303\t        cipher_id: HpkeCipherSuiteId,\n304\t        enc: &[u8],\n305\t        info_prefix: &[u8],\n306\t    ) -> Option<EchOpenResult> {\n307\t        // Find the matching cipher suite in the supported list.\n308\t        let cipher = SUPPORTED_CIPHER_SUITES\n309\t            .iter()\n310\t            .copied()\n311\t            .find(|c| c.kdf == cipher_id.kdf && c.aead == cipher_id.aead)?;\n312\t\n313\t        // Build info = info_prefix || config[2..]\n314\t        // (config[0..2] is the two-byte ECHConfigList outer length prefix,\n315\t        // skipped to match the `ptls_buffer_pushv(&infobuf, config.base+2, …)`\n316\t        // call in the C implementation.)\n317\t        let config_payload = self.config.get(2..).unwrap_or(&[]);\n318\t        let mut info = Vec::with_capacity(info_prefix.len() + config_payload.len());\n319\t        info.extend_from_slice(info_prefix);\n320\t        info.extend_from_slice(config_payload);\n321\t\n322\t        // blocked: DHKEM decapsulation (ptls_hpke_setup_base_r equivalent).\n323\t        // Add `hpke` crate with x25519/p256/p384 feature to Cargo.toml, then\n324\t        // call hpke::setup_receiver(self.kem_id, cipher, &self.private_key, enc, &info)\n325\t        // to obtain the exported key material.\n326\t        let _ = (enc, &info, &self.private_key, self.kem_id, cipher);\n327\t        todo!(\n328\t            \"blocked: HPKE recipient setup for ech_opener_callback requires DHKEM — \\\n329\t             add the `hpke` crate (x25519/p256/p384 features) to Cargo.toml\"\n330\t        )\n331\t    }\n332\t}\n333\t\n334\t// ---------------------------------------------------------------------------\n335\t// Tests.\n336\t\n337\t#[cfg(test)]\n338\tmod tests {\n339\t    use super::*;\n340\t\n341\t    #[test]\n342\t    fn base64_encode_empty() {\n343\t        let mut buf = [0u8; 1];\n344\t        let n = base64_encode(&[], &mut buf).unwrap();\n345\t        assert_eq!(n, 0);\n346\t        assert_eq!(buf[0], 0);\n347\t    }\n348\t\n349\t    #[test]\n350\t    fn base64_encode_three_bytes() {\n351\t        // \"Man\" → \"TWFu\"\n352\t        let mut buf = [0u8; 5];\n353\t        let n = base64_encode(b\"Man\", &mut buf).unwrap();\n354\t        assert_eq!(n, 4);\n355\t        assert_eq!(&buf[..4], b\"TWFu\");\n356\t        assert_eq!(buf[4], 0);\n357\t    }\n358\t\n359\t    #[test]\n360\t    fn base64_encode_padding_one() {\n361\t        // \"M\" → \"TQ==\"\n362\t        let mut buf = [0u8; 5];\n363\t        let n = base64_encode(b\"M\", &mut buf).unwrap();\n364\t        assert_eq!(n, 4);\n365\t        assert_eq!(&buf[..4], b\"TQ==\");\n366\t    }\n367\t\n368\t    #[test]\n369\t    fn base64_encode_padding_two() {\n370\t        // \"Ma\" → \"TWE=\"\n371\t        let mut buf = [0u8; 5];\n372\t        let n = base64_encode(b\"Ma\", &mut buf).unwrap();\n373\t        assert_eq!(n, 4);\n374\t        assert_eq!(&buf[..4], b\"TWE=\");\n375\t    }\n376\t\n377\t    #[test]\n378\t    fn base64_encode_buffer_too_small() {\n379\t        let mut buf = [0u8; 4]; // needs 5 (4 chars + NUL)\n380\t        assert!(base64_encode(b\"Man\", &mut buf).is_err());\n381\t    }\n382\t\n383\t    #[test]\n384\t    fn base64_encoded_len_values() {\n385\t        assert_eq!(base64_encoded_len(0), 0);\n386\t        assert_eq!(base64_encoded_len(1), 4);\n387\t        assert_eq!(base64_encoded_len(2), 4);\n388\t        assert_eq!(base64_encoded_len(3), 4);\n389\t        assert_eq!(base64_encoded_len(4), 8);\n390\t        assert_eq!(base64_encoded_len(6), 8);\n391\t    }\n392\t\n393\t    #[test]\n394\t    fn ech_get_ciphers_p256() {\n395\t        let mut out = [HpkeCipherSuiteId { kdf: 0, aead: 0 }; 4];\n396\t        let n = ech_get_ciphers_from_kem(kem_id::P256_SHA256, &mut out).unwrap();\n397\t        assert!(n >= 1);\n398\t        assert_eq!(out[0].kdf, kdf_id::HKDF_SHA256);\n399\t        assert_eq!(out[0].aead, aead_id::AES_128_GCM);\n400\t    }\n401\t\n402\t    #[test]\n403\t    fn ech_get_ciphers_p384() {\n404\t        let mut out = [HpkeCipherSuiteId { kdf: 0, aead: 0 }; 4];\n405\t        let n = ech_get_ciphers_from_kem(kem_id::P384_SHA384, &mut out).unwrap();\n406\t        assert!(n >= 1);\n407\t        assert_eq!(out[0].kdf, kdf_id::HKDF_SHA384);\n408\t        assert_eq!(out[0].aead, aead_id::AES_256_GCM);\n409\t    }\n410\t\n411\t    #[test]\n412\t    fn ech_get_ciphers_x25519() {\n413\t        let mut out = [HpkeCipherSuiteId { kdf: 0, aead: 0 }; 4];\n414\t        let n = ech_get_ciphers_from_kem(kem_id::X25519_SHA256, &mut out).unwrap();\n415\t        assert!(n >= 1);\n416\t        assert_eq!(out[0].kdf, kdf_id::HKDF_SHA256);\n417\t        assert_eq!(out[0].aead, aead_id::CHACHA20_POLY1305);\n418\t    }\n419\t\n420\t    #[test]\n421\t    fn ech_get_ciphers_out_too_small() {\n422\t        let mut out = [HpkeCipherSuiteId { kdf: 0, aead: 0 }; 1];\n423\t        assert!(ech_get_ciphers_from_kem(kem_id::P256_SHA256, &mut out).is_err());\n424\t    }\n425\t\n426\t    #[test]\n427\t    fn config_id_is_deterministic() {\n428\t        let key = [1u8, 2, 3, 4];\n429\t        let suites = [HpkeCipherSuiteId {\n430\t            kdf: kdf_id::HKDF_SHA256,\n431\t            aead: aead_id::AES_128_GCM,\n432\t        }];\n433\t        let id1 = ech_config_id_from_config(&key, kem_id::X25519_SHA256, &suites, \"example.com\");\n434\t        let id2 = ech_config_id_from_config(&key, kem_id::X25519_SHA256, &suites, \"example.com\");\n435\t        assert_eq!(id1, id2);\n436\t    }\n437\t\n438\t    #[test]\n439\t    fn config_id_changes_with_key() {\n440\t        let suites = [HpkeCipherSuiteId {\n441\t            kdf: kdf_id::HKDF_SHA256,\n442\t            aead: aead_id::AES_128_GCM,\n443\t        }];\n444\t        let id1 =\n445\t            ech_config_id_from_config(&[1, 2, 3], kem_id::X25519_SHA256, &suites, \"example.com\");\n446\t        let id2 =\n447\t            ech_config_id_from_config(&[4, 5, 6], kem_id::X25519_SHA256, &suites, \"example.com\");\n448\t        assert_ne!(id1, id2);\n449\t    }\n450\t}\n451\t"}]},"parent_tool_use_id":null,"session_id":"0e5c1330-a988-493e-903c-214774c62736","uuid":"6a8e4ce4-dc68-49bb-8304-a3b8c6cf5d29","timestamp":"2026-05-07T06:05:47.244Z","tool_use_result":{"type":"text","file":{"filePath":"/Users/richbarn/Projects/picoquic/rs/fq/src/ech.rs","content":"//! Encrypted ClientHello (ECH) helpers.\n//!\n//! Pure-Rust portion of the ECH support layer.  The HPKE key-exchange\n//! operations that require ECDH primitives (DHKEM-X25519, DHKEM-P256,\n//! DHKEM-P384) are currently `todo!()` pending the addition of the `hpke`\n//! crate to Cargo.toml.  Everything else — the cipher-suite selector, the\n//! config-ID digest, base64 encoding, and the opener-state plumbing — is\n//! fully translated from `picoquic/ech.c`.\n\nextern crate alloc;\nuse alloc::vec::Vec;\n\nuse crate::Error;\n\n// ---------------------------------------------------------------------------\n// HPKE constants (IANA registries, RFC 9180).\n\n/// HPKE KEM algorithm identifiers (RFC 9180 §7.1).\npub mod kem_id {\n    /// DHKEM(P-256, HKDF-SHA256)\n    pub const P256_SHA256: u16 = 0x0010;\n    /// DHKEM(P-384, HKDF-SHA384)\n    pub const P384_SHA384: u16 = 0x0011;\n    /// DHKEM(X25519, HKDF-SHA256)\n    pub const X25519_SHA256: u16 = 0x0020;\n}\n\n/// HPKE KDF algorithm identifiers (RFC 9180 §7.2).\npub mod kdf_id {\n    /// HKDF-SHA256\n    pub const HKDF_SHA256: u16 = 0x0001;\n    /// HKDF-SHA384\n    pub const HKDF_SHA384: u16 = 0x0002;\n    /// HKDF-SHA512\n    pub const HKDF_SHA512: u16 = 0x0003;\n}\n\n/// HPKE AEAD algorithm identifiers (RFC 9180 §7.3).\npub mod aead_id {\n    /// AES-128-GCM\n    pub const AES_128_GCM: u16 = 0x0001;\n    /// AES-256-GCM\n    pub const AES_256_GCM: u16 = 0x0002;\n    /// ChaCha20-Poly1305\n    pub const CHACHA20_POLY1305: u16 = 0x0003;\n}\n\n// ---------------------------------------------------------------------------\n// Cipher-suite identifier.\n\n/// HPKE symmetric cipher-suite: (KDF id, AEAD id) pair.\n///\n/// C: `ptls_hpke_cipher_suite_id_t`\n#[derive(Debug, Clone, Copy, PartialEq, Eq)]\npub struct HpkeCipherSuiteId {\n    pub kdf: u16,\n    pub aead: u16,\n}\n\n/// The three cipher suites we advertise as supported, mirroring the\n/// `picoquic_hpke_cipher_suites[]` array that the C picotls backend\n/// populates at startup.\nconst SUPPORTED_CIPHER_SUITES: &[HpkeCipherSuiteId] = &[\n    HpkeCipherSuiteId {\n        kdf: kdf_id::HKDF_SHA256,\n        aead: aead_id::AES_128_GCM,\n    },\n    HpkeCipherSuiteId {\n        kdf: kdf_id::HKDF_SHA256,\n        aead: aead_id::CHACHA20_POLY1305,\n    },\n    HpkeCipherSuiteId {\n        kdf: kdf_id::HKDF_SHA384,\n        aead: aead_id::AES_256_GCM,\n    },\n];\n\n// ---------------------------------------------------------------------------\n// Base64 encoding.\n\nconst BASE64_ALPHABET: &[u8; 64] =\n    b\"ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789+/\";\n\n/// Return the number of base64 characters needed to encode `input_len` bytes,\n/// not counting a NUL terminator.  Mirrors `ptls_base64_howlong`.\n#[inline]\npub fn base64_encoded_len(input_len: usize) -> usize {\n    input_len.div_ceil(3) * 4\n}\n\n/// Encode `input` as standard RFC 4648 base64 into `out`.\n///\n/// `out` must be at least `base64_encoded_len(input.len()) + 1` bytes long\n/// (the extra byte is for the NUL terminator written to match picotls\n/// convention).  Returns the number of base64 characters written (excluding\n/// the NUL).  Returns `Err(Error::Generic)` when `out` is too small.\n///\n/// C: `picoquic_base64_encode`\npub fn base64_encode(input: &[u8], out: &mut [u8]) -> Result<usize, Error> {\n    let len = base64_encoded_len(input.len());\n    if len + 1 > out.len() {\n        return Err(Error::Generic);\n    }\n    let mut pos = 0usize;\n    let mut chunks = input.chunks_exact(3);\n    for chunk in &mut chunks {\n        let b = ((chunk[0] as u32) << 16) | ((chunk[1] as u32) << 8) | (chunk[2] as u32);\n        out[pos] = BASE64_ALPHABET[((b >> 18) & 0x3f) as usize];\n        out[pos + 1] = BASE64_ALPHABET[((b >> 12) & 0x3f) as usize];\n        out[pos + 2] = BASE64_ALPHABET[((b >> 6) & 0x3f) as usize];\n        out[pos + 3] = BASE64_ALPHABET[(b & 0x3f) as usize];\n        pos += 4;\n    }\n    match chunks.remainder() {\n        [a] => {\n            let b = (*a as u32) << 16;\n            out[pos] = BASE64_ALPHABET[((b >> 18) & 0x3f) as usize];\n            out[pos + 1] = BASE64_ALPHABET[((b >> 12) & 0x3f) as usize];\n            out[pos + 2] = b'=';\n            out[pos + 3] = b'=';\n            pos += 4;\n        }\n        [a, b] => {\n            let v = ((*a as u32) << 16) | ((*b as u32) << 8);\n            out[pos] = BASE64_ALPHABET[((v >> 18) & 0x3f) as usize];\n            out[pos + 1] = BASE64_ALPHABET[((v >> 12) & 0x3f) as usize];\n            out[pos + 2] = BASE64_ALPHABET[((v >> 6) & 0x3f) as usize];\n            out[pos + 3] = b'=';\n            pos += 4;\n        }\n        _ => {}\n    }\n    out[pos] = 0; // NUL terminator (mirrors ptls_base64_encode convention)\n    Ok(len)\n}\n\n// ---------------------------------------------------------------------------\n// Cipher-suite selector.\n\n/// Fill `out` with HPKE cipher suites appropriate for `kem_id`, returning\n/// the number of entries written.\n///\n/// The first entry is the preferred suite for the given KEM; when there is\n/// also a suitable default suite (AES-128-GCM + HKDF-SHA256) that differs\n/// from the preferred one and `out.len() > 2`, it is appended as the second\n/// entry.\n///\n/// Returns `Err(Error::Generic)` if `out.len() < 2` (mirrors the C guard\n/// `cipher_vec_nb_max < 2`) or if no suite can be found.\n///\n/// C: `picoquic_ech_get_ciphers_from_kem`\npub fn ech_get_ciphers_from_kem(\n    kem_id: u16,\n    out: &mut [HpkeCipherSuiteId],\n) -> Result<usize, Error> {\n    if out.len() < 2 {\n        return Err(Error::Generic);\n    }\n\n    let (target_kdf, target_aead) = match kem_id {\n        kem_id::P256_SHA256 => (kdf_id::HKDF_SHA256, aead_id::AES_128_GCM),\n        kem_id::P384_SHA384 => (kdf_id::HKDF_SHA384, aead_id::AES_256_GCM),\n        kem_id::X25519_SHA256 => (kdf_id::HKDF_SHA256, aead_id::CHACHA20_POLY1305),\n        _ => (kdf_id::HKDF_SHA256, aead_id::AES_128_GCM),\n    };\n    let target = HpkeCipherSuiteId {\n        kdf: target_kdf,\n        aead: target_aead,\n    };\n    let default_suite = HpkeCipherSuiteId {\n        kdf: kdf_id::HKDF_SHA256,\n        aead: aead_id::AES_128_GCM,\n    };\n\n    let mut target_cipher: Option<HpkeCipherSuiteId> = None;\n    let mut default_cipher: Option<HpkeCipherSuiteId> = None;\n\n    for &suite in SUPPORTED_CIPHER_SUITES {\n        if target_cipher.is_none() && suite == target {\n            target_cipher = Some(suite);\n        }\n        if default_cipher.is_none() && suite == default_suite {\n            default_cipher = Some(suite);\n        }\n    }\n\n    // Mirrors the C branching: target first; fall back to default; error if neither.\n    // C: `cipher_vec_nb_max > 2` guards adding the default as a second entry.\n    let nb_ciphers = match (target_cipher, default_cipher) {\n        (Some(t), def) => {\n            out[0] = t;\n            if let Some(d) = def {\n                if d != t && out.len() > 2 {\n                    out[1] = d;\n                    2\n                } else {\n                    1\n                }\n            } else {\n                1\n            }\n        }\n        (None, Some(d)) => {\n            out[0] = d;\n            1\n        }\n        (None, None) => return Err(Error::Generic),\n    };\n    Ok(nb_ciphers)\n}\n\n// ---------------------------------------------------------------------------\n// Config-ID derivation (private helper).\n\n/// Compute the one-byte ECH config-ID from the public key material, KEM id,\n/// cipher suites, and the server public name.\n///\n/// The algorithm accumulates all bytes into a `u64` then XOR-folds the\n/// result down to a single byte.\n///\n/// C: `ech_config_id_from_config` (file-static)\nfn ech_config_id_from_config(\n    public_key_bits: &[u8],\n    kem_id: u16,\n    cipher_suites: &[HpkeCipherSuiteId],\n    public_name: &str,\n) -> u8 {\n    let mut config_sum: u64 = 0;\n    for &b in public_key_bits {\n        config_sum = config_sum.wrapping_add(b as u64);\n    }\n    config_sum = config_sum.wrapping_add(kem_id as u64);\n    for cs in cipher_suites {\n        config_sum = config_sum.wrapping_add(cs.aead as u64);\n        config_sum = config_sum.wrapping_add(cs.kdf as u64);\n    }\n    for b in public_name.bytes() {\n        config_sum = config_sum.wrapping_add(b as u64);\n    }\n    let mut config_id: u8 = 0;\n    while config_sum > 0 {\n        config_id ^= (config_sum & 0xff) as u8;\n        config_sum >>= 8;\n    }\n    config_id\n}\n\n// ---------------------------------------------------------------------------\n// Server-side ECH opener state.\n\n/// Result returned by a successful [`EchOpenerState::open`] call.\n///\n/// When the HPKE decapsulation step is complete, `key_material` will hold\n/// the derived AEAD key bytes; callers build the concrete AEAD context from\n/// it together with `cipher`.\npub struct EchOpenResult {\n    /// The negotiated cipher suite.\n    pub cipher: HpkeCipherSuiteId,\n    /// HPKE-derived key material for the AEAD context.  Empty until the\n    /// DHKEM decapsulation is implemented.\n    pub key_material: Vec<u8>,\n}\n\n/// Server-side ECH opener callback state.\n///\n/// Holds the KEM id, the private key bytes used for HPKE decapsulation,\n/// and the serialised ECH config bytes (used to reconstruct the HPKE `info`\n/// string during opening).\n///\n/// C: `ech_opener_callback_t`\npub struct EchOpenerState {\n    /// HPKE KEM identifier, e.g. `kem_id::X25519_SHA256`.\n    /// C: `kem` (`ptls_hpke_kem_t*`; we store only the numeric id).\n    pub kem_id: u16,\n    /// Raw private key bytes for HPKE decapsulation.\n    /// C: `keyex` (`ptls_key_exchange_context_t*` loaded from a PEM file).\n    pub private_key: Vec<u8>,\n    /// Serialised ECH config bytes including the two-byte outer length prefix.\n    /// C: `config` (`ptls_buffer_t`).\n    pub config: Vec<u8>,\n}\n\nimpl EchOpenerState {\n    /// Attempt to open (decapsulate) an incoming ECH extension.\n    ///\n    /// Finds the cipher suite matching `cipher_id` in the supported list,\n    /// builds the HPKE `info` string as `info_prefix || config[2..]`, and\n    /// then performs the HPKE recipient setup to derive the AEAD key.\n    ///\n    /// Returns `Some(EchOpenResult)` on success, `None` when `cipher_id` is\n    /// not in the supported list.\n    ///\n    /// # Blocker\n    ///\n    /// The HPKE decapsulation step (`ptls_hpke_setup_base_r` equivalent)\n    /// requires DHKEM primitives.  Add the `hpke` crate with the\n    /// `x25519`/`p256`/`p384` features to Cargo.toml and replace the\n    /// `todo!()` below with the corresponding `hpke::setup_receiver` call.\n    ///\n    /// C: `ech_opener_callback`\n    pub fn open(\n        &self,\n        cipher_id: HpkeCipherSuiteId,\n        enc: &[u8],\n        info_prefix: &[u8],\n    ) -> Option<EchOpenResult> {\n        // Find the matching cipher suite in the supported list.\n        let cipher = SUPPORTED_CIPHER_SUITES\n            .iter()\n            .copied()\n            .find(|c| c.kdf == cipher_id.kdf && c.aead == cipher_id.aead)?;\n\n        // Build info = info_prefix || config[2..]\n        // (config[0..2] is the two-byte ECHConfigList outer length prefix,\n        // skipped to match the `ptls_buffer_pushv(&infobuf, config.base+2, …)`\n        // call in the C implementation.)\n        let config_payload = self.config.get(2..).unwrap_or(&[]);\n        let mut info = Vec::with_capacity(info_prefix.len() + config_payload.len());\n        info.extend_from_slice(info_prefix);\n        info.extend_from_slice(config_payload);\n\n        // blocked: DHKEM decapsulation (ptls_hpke_setup_base_r equivalent).\n        // Add `hpke` crate with x25519/p256/p384 feature to Cargo.toml, then\n        // call hpke::setup_receiver(self.kem_id, cipher, &self.private_key, enc, &info)\n        // to obtain the exported key material.\n        let _ = (enc, &info, &self.private_key, self.kem_id, cipher);\n        todo!(\n            \"blocked: HPKE recipient setup for ech_opener_callback requires DHKEM — \\\n             add the `hpke` crate (x25519/p256/p384 features) to Cargo.toml\"\n        )\n    }\n}\n\n// ---------------------------------------------------------------------------\n// Tests.\n\n#[cfg(test)]\nmod tests {\n    use super::*;\n\n    #[test]\n    fn base64_encode_empty() {\n        let mut buf = [0u8; 1];\n        let n = base64_encode(&[], &mut buf).unwrap();\n        assert_eq!(n, 0);\n        assert_eq!(buf[0], 0);\n    }\n\n    #[test]\n    fn base64_encode_three_bytes() {\n        // \"Man\" → \"TWFu\"\n        let mut buf = [0u8; 5];\n        let n = base64_encode(b\"Man\", &mut buf).unwrap();\n        assert_eq!(n, 4);\n        assert_eq!(&buf[..4], b\"TWFu\");\n        assert_eq!(buf[4], 0);\n    }\n\n    #[test]\n    fn base64_encode_padding_one() {\n        // \"M\" → \"TQ==\"\n        let mut buf = [0u8; 5];\n        let n = base64_encode(b\"M\", &mut buf).unwrap();\n        assert_eq!(n, 4);\n        assert_eq!(&buf[..4], b\"TQ==\");\n    }\n\n    #[test]\n    fn base64_encode_padding_two() {\n        // \"Ma\" → \"TWE=\"\n        let mut buf = [0u8; 5];\n        let n = base64_encode(b\"Ma\", &mut buf).unwrap();\n        assert_eq!(n, 4);\n        assert_eq!(&buf[..4], b\"TWE=\");\n    }\n\n    #[test]\n    fn base64_encode_buffer_too_small() {\n        let mut buf = [0u8; 4]; // needs 5 (4 chars + NUL)\n        assert!(base64_encode(b\"Man\", &mut buf).is_err());\n    }\n\n    #[test]\n    fn base64_encoded_len_values() {\n        assert_eq!(base64_encoded_len(0), 0);\n        assert_eq!(base64_encoded_len(1), 4);\n        assert_eq!(base64_encoded_len(2), 4);\n        assert_eq!(base64_encoded_len(3), 4);\n        assert_eq!(base64_encoded_len(4), 8);\n        assert_eq!(base64_encoded_len(6), 8);\n    }\n\n    #[test]\n    fn ech_get_ciphers_p256() {\n        let mut out = [HpkeCipherSuiteId { kdf: 0, aead: 0 }; 4];\n        let n = ech_get_ciphers_from_kem(kem_id::P256_SHA256, &mut out).unwrap();\n        assert!(n >= 1);\n        assert_eq!(out[0].kdf, kdf_id::HKDF_SHA256);\n        assert_eq!(out[0].aead, aead_id::AES_128_GCM);\n    }\n\n    #[test]\n    fn ech_get_ciphers_p384() {\n        let mut out = [HpkeCipherSuiteId { kdf: 0, aead: 0 }; 4];\n        let n = ech_get_ciphers_from_kem(kem_id::P384_SHA384, &mut out).unwrap();\n        assert!(n >= 1);\n        assert_eq!(out[0].kdf, kdf_id::HKDF_SHA384);\n        assert_eq!(out[0].aead, aead_id::AES_256_GCM);\n    }\n\n    #[test]\n    fn ech_get_ciphers_x25519() {\n        let mut out = [HpkeCipherSuiteId { kdf: 0, aead: 0 }; 4];\n        let n = ech_get_ciphers_from_kem(kem_id::X25519_SHA256, &mut out).unwrap();\n        assert!(n >= 1);\n        assert_eq!(out[0].kdf, kdf_id::HKDF_SHA256);\n        assert_eq!(out[0].aead, aead_id::CHACHA20_POLY1305);\n    }\n\n    #[test]\n    fn ech_get_ciphers_out_too_small() {\n        let mut out = [HpkeCipherSuiteId { kdf: 0, aead: 0 }; 1];\n        assert!(ech_get_ciphers_from_kem(kem_id::P256_SHA256, &mut out).is_err());\n    }\n\n    #[test]\n    fn config_id_is_deterministic() {\n        let key = [1u8, 2, 3, 4];\n        let suites = [HpkeCipherSuiteId {\n            kdf: kdf_id::HKDF_SHA256,\n            aead: aead_id::AES_128_GCM,\n        }];\n        let id1 = ech_config_id_from_config(&key, kem_id::X25519_SHA256, &suites, \"example.com\");\n        let id2 = ech_config_id_from_config(&key, kem_id::X25519_SHA256, &suites, \"example.com\");\n        assert_eq!(id1, id2);\n    }\n\n    #[test]\n    fn config_id_changes_with_key() {\n        let suites = [HpkeCipherSuiteId {\n            kdf: kdf_id::HKDF_SHA256,\n            aead: aead_id::AES_128_GCM,\n        }];\n        let id1 =\n            ech_config_id_from_config(&[1, 2, 3], kem_id::X25519_SHA256, &suites, \"example.com\");\n        let id2 =\n            ech_config_id_from_config(&[4, 5, 6], kem_id::X25519_SHA256, &suites, \"example.com\");\n        assert_ne!(id1, id2);\n    }\n}\n","numLines":451,"startLine":1,"totalLines":451}}}
