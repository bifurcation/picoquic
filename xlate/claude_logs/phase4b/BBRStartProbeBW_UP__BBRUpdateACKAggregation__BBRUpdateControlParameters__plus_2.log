{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01XE8TJ2LVLA9NBzP48cV3j8","type":"tool_result","content":"1100\t    /* TODO: remove the test bw_hi != 0 once variables properly initialized. */\n1101\t    if (bbr_state->bw > bbr_state->bw_hi && bbr_state->bw_hi != 0) {\n1102\t        bbr_state->bw = bbr_state->bw_hi;\n1103\t    }\n1104\t}\n1105\t\n1106\t\n1107\t/* Path Model functions when probing for bandwidth */\n1108\tstatic void BBRUpdateMaxBw(picoquic_bbr_state_t* bbr_state, picoquic_path_t* path_x, bbr_per_ack_state_t * rs)\n1109\t{\n1110\t    BBRUpdateRound(bbr_state, path_x);\n1111\t\n1112\t    if (rs->delivery_rate >= bbr_state->MaxBwFilter[bbr_state->cycle_count%BBRMaxBwFilterLen] || !rs->is_app_limited) {\n1113\t        bbr_state->max_bw = update_windowed_max_filter(\n1114\t            bbr_state->MaxBwFilter, rs->delivery_rate, bbr_state->cycle_count, BBRMaxBwFilterLen);\n1115\t    }\n1116\t}\n1117\t\n1118\tstatic void BBRAdvanceMaxBwFilter(picoquic_bbr_state_t* bbr_state)\n1119\t{\n1120\t    bbr_state->cycle_count++;\n1121\t    bbr_state->ack_phase = picoquic_bbr_acks_probe_starting;\n1122\t\n1123\t    /* Should the current cycle value be set to zero? Or do we simply rely on the\n1124\t     * natural rythm of updates, keeping the old value if we only see app limited updates?\n1125\t     */\n1126\t    start_windowed_max_filter_period(bbr_state->MaxBwFilter, bbr_state->cycle_count, BBRMaxBwFilterLen);\n1127\t}\n1128\t\n1129\tstatic void BBRUpdateACKAggregation(picoquic_bbr_state_t* bbr_state, picoquic_path_t * path_x, bbr_per_ack_state_t* rs, uint64_t current_time)\n1130\t{\n1131\t    /* Find excess ACKed beyond expected amount over this interval */\n1132\t    uint64_t interval = (current_time - bbr_state->extra_acked_interval_start);\n1133\t    uint64_t expected_delivered = bbr_state->bw * interval;\n1134\t    /* Reset interval if ACK rate is below expected rate: */\n1135\t    if (bbr_state->extra_acked_delivered <= expected_delivered) {\n1136\t        bbr_state->extra_acked_delivered = 0;\n1137\t        bbr_state->extra_acked_interval_start = current_time;\n1138\t        expected_delivered = 0;\n1139\t    }\n1140\t    bbr_state->extra_acked_delivered += rs->newly_acked;\n1141\t    uint64_t extra = bbr_state->extra_acked_delivered - expected_delivered;\n1142\t    if (extra > path_x->cwin) {\n1143\t        extra = path_x->cwin;\n1144\t    }\n1145\t    bbr_state->extra_acked =\n1146\t        update_windowed_max_filter(bbr_state->ExtraACKedFilter, extra, bbr_state->round_count, BBRExtraAckedFilterLen);\n1147\t}\n1148\t\n1149\t/* Do loss signals suggest inflight is too high?\n1150\t* If so, react.\n1151\t* This test can trigger spuriously if there are too few packets in transit.\n1152\t* For example, if there are two packets in transit and one is lost, the\n1153\t* test assumes a loss rate of 50%, but this could be a random event that\n1154\t* happens once every 50 RTT. Decisions made because of that would be wrong.\n1155\t*/\n1156\tstatic int IsInflightTooHigh(picoquic_bbr_state_t* bbr_state, picoquic_path_t * path_x, bbr_per_ack_state_t* rs)\n1157\t{\n1158\t    if (rs->ecn_alpha > BBRExcessiveEcnCE) {\n1159\t        return 1;\n1160\t    }\n1161\t    else {\n1162\t        uint64_t rs_delivered = path_x->delivered - rs->delivered;\n1163\t        if (rs_delivered > bbr_state->recovery_delivered &&\n1164\t            rs->lost > (uint64_t)(((double)rs->tx_in_flight) * BBRLossThresh) &&\n1165\t            rs->lost > 3 * path_x->send_mtu) {\n1166\t            return 1;\n1167\t        }\n1168\t        else {\n1169\t            return 0;\n1170\t        }\n1171\t    }\n1172\t}\n1173\t\n1174\tstatic void BBRHandleInflightTooHigh(picoquic_bbr_state_t* bbr_state, picoquic_path_t * path_x, bbr_per_ack_state_t* rs, uint64_t current_time)\n1175\t{\n1176\t    /* The computation below compares the number of bytes in flight when the \n1177\t     * acked packet was sent to the current target */\n1178\t    bbr_state->bw_probe_samples = 0;  /* only react once per bw probe */\n1179\t    if (!rs->is_app_limited) {\n1180\t        uint64_t beta_target = (uint64_t)(((double)BBRTargetInflight(bbr_state, path_x)) * BBRBeta);\n1181\t        bbr_state->inflight_hi = (rs->tx_in_flight > beta_target) ? rs->tx_in_flight : beta_target;\n1182\t    }\n1183\t    if(bbr_state->state == picoquic_bbr_alg_probe_bw_up) {\n1184\t        BBRStartProbeBW_DOWN(bbr_state, path_x, current_time);\n1185\t    }\n1186\t}\n1187\t\n1188\tstatic int CheckInflightTooHigh(picoquic_bbr_state_t* bbr_state, picoquic_path_t* path_x, bbr_per_ack_state_t* rs, uint64_t current_time)\n1189\t{\n1190\t    if (IsInflightTooHigh(bbr_state, path_x, rs))\n1191\t    {\n1192\t        if (bbr_state->bw_probe_samples)\n1193\t        {\n1194\t            BBRHandleInflightTooHigh(bbr_state, path_x, rs, current_time);\n1195\t        }\n1196\t        return 1;  /* inflight too high */\n1197\t    }\n1198\t    else {\n1199\t        return 0;\n1200\t    }\n1201\t}\n1202\t\n1203\t/* BBR Round counting functions */\n1204\tstatic void BBRInitRoundCounting(picoquic_bbr_state_t* bbr_state, picoquic_path_t* path_x)\n1205\t{\n1206\t    bbr_state->next_round_delivered = 0;\n1207\t    bbr_state->round_start = 0;\n1208\t    bbr_state->round_count = 0;\n1209\t    bbr_state->round_start_pn = picoquic_cc_get_sequence_number(path_x->cnx, path_x);\n1210\t}\n1211\t\n1212\tstatic void BBRStartRound(picoquic_bbr_state_t* bbr_state, picoquic_path_t* path_x)\n1213\t{\n1214\t    bbr_state->round_start_pn = picoquic_cc_get_sequence_number(path_x->cnx, path_x);\n1215\t\n1216\t    bbr_state->next_round_delivered = path_x->delivered;\n1217\t}\n1218\t\n1219\tstatic void BBRUpdateRound(picoquic_bbr_state_t* bbr_state, picoquic_path_t * path_x)\n1220\t{\n1221\t    if (picoquic_cc_get_ack_number(path_x->cnx, path_x) >= bbr_state->round_start_pn) {\n1222\t        BBRStartRound(bbr_state, path_x);\n1223\t        bbr_state->round_count++;\n1224\t        bbr_state->rounds_since_probe++;\n1225\t        bbr_state->round_start = 1;\n1226\t        start_windowed_max_filter_period(bbr_state->ExtraACKedFilter, bbr_state->round_count, BBRExtraAckedFilterLen);\n1227\t    }\n1228\t    else {\n1229\t        bbr_state->round_start = 0;\n1230\t    }\n1231\t}\n1232\t\n1233\t\n1234\t/* End of BBR round counting functions */\n1235\t\n1236\t/* Restart from idle process\n1237\t* TODO: add a congestion callback \"restart from idle\" if sending a packet\n1238\t* after a long silence. The tests should be done in the transport loop. This\n1239\t* will need to be handled in their own way by all agorithms, and thus cannot\n1240\t* be implemented in this PR.\n1241\t* The required call back is mentioned in section 4.1. of RFC 5681,\n1242\t* Restarting Idle Connections. This is defined for TCP, but should\n1243\t* apply equally to a QUIC path. the text says \"Therefore, a TCP SHOULD\n1244\t* set cwnd to no more than RW before beginning transmission if the TCP\n1245\t* has not sent data in an interval exceeding the retransmission timeout.\"\n1246\t* For QUIC, this perhaps should be qualified as \"as not sent ack-eliciting data\".\n1247\t* The idle test checks \"no bytes in transit\"; this imply the callback\n1248\t* should happen before updating \"bytes in transit\" for the new packet.\n1249\t */\n1250\t#if 0\n1251\tstatic void BBRHandleRestartFromIdle(picoquic_bbr_state_t* bbr_state, picoquic_path_t * path_x, uint64_t current_time)\n1252\t{\n1253\t    if (path_x->bytes_in_transit == 0 && bbr_state->path_is_app_limited)\n1254\t    {\n1255\t        bbr_state->idle_restart = 1;\n1256\t        bbr_state->extra_acked_interval_start = current_time;\n1257\t        if (IsInAProbeBWState(bbr_state)) {\n1258\t            BBRSetPacingRateWithGain(bbr_state, 1);\n1259\t        }\n1260\t        else if (bbr_state->state == picoquic_bbr_alg_probe_rtt) {\n1261\t            BBRCheckProbeRTTDone(bbr_state, current_time);\n1262\t        }\n1263\t    }\n1264\t}\n1265\t\n1266\t\n1267\t/* TODO: check definition of app limited. Why is it expressed here?\n1268\t* The name should really be, check whether transmission has started.\n1269\t* It is used to differentiate \"started and then idle\" from \"has not\n1270\t* sent anything yet.\"\n1271\t */\n1272\tstatic void MarkConnectionAppLimited(picoquic_bbr_state_t* bbr_state)\n1273\t{\n1274\t    bbr_state->path_is_app_limited =\n1275\t        (C.delivered + packets_in_flight) ?  0 : 1;\n1276\t}\n1277\t\n1278\t\n1279\t/* Called when the app has sent something. */\n1280\tvoid BBROnTransmit(picoquic_bbr_state_t* bbr_state, picoquic_path_t* path_x, uint64_t current_time)\n1281\t{\n1282\t    BBRHandleRestartFromIdle(bbr_state, path_x, current_time);\n1283\t}\n1284\t#endif\n1285\t/* End of idle functions */\n1286\t\n1287\t/* ProbeRTT processes for BBv3 */\n1288\t\n1289\t/* Adapt RTT min margin based on packet transmission time */\n1290\tstatic void BBRAdaptMinRttMargin(picoquic_bbr_state_t* bbr_state, picoquic_path_t* path_x)\n1291\t{\n1292\t    uint64_t margin = ((bbr_state->min_rtt * BBRMinRttMarginPercent) * 100 / 1000000);\n1293\t    if (bbr_state->max_bw > 0) {\n1294\t        margin += 2 * path_x->send_mtu * 1000000 / bbr_state->max_bw;\n1295\t    }\n1296\t    bbr_state->min_rtt_margin = margin;\n1297\t}\n1298\t\n1299\t#ifdef RTTJitterBuffer\n1300\tstatic void BBRUpdateRTTJitterBuffer(picoquic_bbr_state_t* bbr_state, bbr_per_ack_state_t * rs, uint64_t current_time)\n1301\t{\n1302\t    if (current_time > bbr_state->last_rtt_sample_stamp + 1000) {\n1303\t        bbr_state->rtt_jitter_buffer[bbr_state->rtt_jitter_cycle % BBRRTTJitterBufferLen] = rs->rtt_sample;\n1304\t        bbr_state->rtt_jitter_cycle++;\n1305\t        bbr_state->last_rtt_sample_stamp = current_time;\n1306\t        bbr_state->rtt_short_term_min = UINT64_MAX;\n1307\t        bbr_state->rtt_short_term_max = 0;\n1308\t        for (unsigned int i = 0; i < BBRRTTJitterBufferLen; i++) {\n1309\t            if (i >= bbr_state->rtt_jitter_cycle) {\n1310\t                break;\n1311\t            }\n1312\t            if (bbr_state->rtt_jitter_buffer[i] > bbr_state->rtt_short_term_max) {\n1313\t                bbr_state->rtt_short_term_max = bbr_state->rtt_jitter_buffer[i];\n1314\t            }\n1315\t            if (bbr_state->rtt_jitter_buffer[i] < bbr_state->rtt_short_term_min) {\n1316\t                bbr_state->rtt_short_term_min = bbr_state->rtt_jitter_buffer[i];\n1317\t            }\n1318\t        }\n1319\t    }\n1320\t}\n1321\t\n1322\tstatic void BBRResetRTTJitterBuffer(picoquic_bbr_state_t* bbr_state,  uint64_t rtt_init_value, uint64_t current_time)\n1323\t{\n1324\t    bbr_state->rtt_jitter_cycle = 0;\n1325\t    bbr_state->last_rtt_sample_stamp = current_time;\n1326\t    bbr_state->rtt_short_term_min = rtt_init_value;\n1327\t    bbr_state->rtt_short_term_max = rtt_init_value;\n1328\t    bbr_state->probe_rtt_min_delay = rtt_init_value;\n1329\t    bbr_state->nb_rtt_excess = 0;\n1330\t}\n1331\t\n1332\tstatic void BBRUpdateMinRTT(picoquic_bbr_state_t* bbr_state, picoquic_path_t* path_x, bbr_per_ack_state_t * rs, uint64_t current_time)\n1333\t{\n1334\t    BBRAdaptMinRttMargin(bbr_state, path_x);\n1335\t    /* maintain filter of last BBRRTTJitterBufferLen samples, to handle jitter */\n1336\t    BBRUpdateRTTJitterBuffer(bbr_state, rs, current_time);\n1337\t    /* Compute the BBR expired limit */\n1338\t    if (bbr_state->min_rtt < UINT64_MAX) {\n1339\t        if (bbr_state->min_rtt <= BBRLongRttThreshold) {\n1340\t            bbr_state->probe_rtt_expired =\n1341\t                current_time > bbr_state->probe_rtt_min_stamp + BBRProbeRTTInterval;\n1342\t        }\n1343\t        else {\n1344\t            bbr_state->probe_rtt_expired =\n1345\t                current_time > bbr_state->probe_rtt_min_stamp + bbr_state->min_rtt * 100;\n1346\t        }\n1347\t    }\n1348\t    /* Update min rtt */\n1349\t    if (bbr_state->rtt_short_term_max < bbr_state->probe_rtt_min_delay ||\n1350\t            bbr_state->probe_rtt_expired ||\n1351\t            bbr_state->rtt_jitter_cycle < BBRRTTJitterBufferLen) {\n1352\t        bbr_state->probe_rtt_min_delay = bbr_state->rtt_short_term_max;\n1353\t        bbr_state->probe_rtt_min_stamp = current_time;\n1354\t    }\n1355\t    else {\n1356\t        /* Deviation from BBRv3: test whether the new measurment does not differ from min_rtt\n1357\t         * by more than a \"margin of error, and in that case delay the need to reevaluate min_rtt */\n1358\t        if (bbr_state->rtt_short_term_min < (bbr_state->min_rtt + bbr_state->min_rtt_margin)) {\n1359\t            bbr_state->probe_rtt_min_stamp = current_time;\n1360\t            bbr_state->min_rtt_stamp = current_time;\n1361\t        }\n1362\t    }\n1363\t    int min_rtt_expired =\n1364\t        current_time > bbr_state->min_rtt_stamp + BBRMinRTTFilterLen;\n1365\t    if (bbr_state->probe_rtt_min_delay < bbr_state->min_rtt ||\n1366\t        min_rtt_expired ||\n1367\t        bbr_state->rtt_jitter_cycle < BBRRTTJitterBufferLen) {\n1368\t        bbr_state->min_rtt = bbr_state->probe_rtt_min_delay;\n1369\t        bbr_state->min_rtt_stamp = bbr_state->probe_rtt_min_stamp;\n1370\t    }\n1371\t\n1372\t    if (bbr_state->rtt_short_term_min > bbr_state->min_rtt && bbr_state->min_rtt > PICOQUIC_MINRTT_THRESHOLD)\n1373\t    {\n1374\t        uint64_t delta_max = PICOQUIC_MINRTT_MARGIN + bbr_state->min_rtt / 4;\n1375\t        if (bbr_state->rtt_short_term_min > bbr_state->min_rtt + delta_max) {\n1376\t            bbr_state->nb_rtt_excess++;\n1377\t        }\n1378\t    }\n1379\t    else\n1380\t    {\n1381\t        bbr_state->nb_rtt_excess = 0;\n1382\t    }\n1383\t\n1384\t}\n1385\t\n1386\tstatic int IsRTTTooHigh(picoquic_bbr_state_t* bbr_state)\n1387\t{\n1388\t    return (bbr_state->nb_rtt_excess > BBRRTTJitterBufferLen);\n1389\t}\n1390\t#else\n1391\tstatic void BBRUpdateMinRTT(picoquic_bbr_state_t* bbr_state, picoquic_path_t* path_x, bbr_per_ack_state_t * rs, uint64_t current_time)\n1392\t{\n1393\t    BBRAdaptMinRttMargin(bbr_state, path_x);\n1394\t    /* Compute the BBR expired limit */\n1395\t    if (bbr_state->min_rtt < UINT64_MAX) {\n1396\t        if (bbr_state->min_rtt <= BBRLongRttThreshold) {\n1397\t            bbr_state->probe_rtt_expired =\n1398\t                current_time > bbr_state->probe_rtt_min_stamp + BBRProbeRTTInterval;\n1399\t        }"}]},"parent_tool_use_id":null,"session_id":"e1025b2d-b029-4ba2-99e9-8a6f5fdeda25","uuid":"a3c62a55-cf5f-479b-b396-36f0eeb8ebf3","timestamp":"2026-05-07T13:03:26.678Z","tool_use_result":{"type":"text","file":{"filePath":"/Users/richbarn/Projects/picoquic/picoquic/bbr.c","content":"    /* TODO: remove the test bw_hi != 0 once variables properly initialized. */\n    if (bbr_state->bw > bbr_state->bw_hi && bbr_state->bw_hi != 0) {\n        bbr_state->bw = bbr_state->bw_hi;\n    }\n}\n\n\n/* Path Model functions when probing for bandwidth */\nstatic void BBRUpdateMaxBw(picoquic_bbr_state_t* bbr_state, picoquic_path_t* path_x, bbr_per_ack_state_t * rs)\n{\n    BBRUpdateRound(bbr_state, path_x);\n\n    if (rs->delivery_rate >= bbr_state->MaxBwFilter[bbr_state->cycle_count%BBRMaxBwFilterLen] || !rs->is_app_limited) {\n        bbr_state->max_bw = update_windowed_max_filter(\n            bbr_state->MaxBwFilter, rs->delivery_rate, bbr_state->cycle_count, BBRMaxBwFilterLen);\n    }\n}\n\nstatic void BBRAdvanceMaxBwFilter(picoquic_bbr_state_t* bbr_state)\n{\n    bbr_state->cycle_count++;\n    bbr_state->ack_phase = picoquic_bbr_acks_probe_starting;\n\n    /* Should the current cycle value be set to zero? Or do we simply rely on the\n     * natural rythm of updates, keeping the old value if we only see app limited updates?\n     */\n    start_windowed_max_filter_period(bbr_state->MaxBwFilter, bbr_state->cycle_count, BBRMaxBwFilterLen);\n}\n\nstatic void BBRUpdateACKAggregation(picoquic_bbr_state_t* bbr_state, picoquic_path_t * path_x, bbr_per_ack_state_t* rs, uint64_t current_time)\n{\n    /* Find excess ACKed beyond expected amount over this interval */\n    uint64_t interval = (current_time - bbr_state->extra_acked_interval_start);\n    uint64_t expected_delivered = bbr_state->bw * interval;\n    /* Reset interval if ACK rate is below expected rate: */\n    if (bbr_state->extra_acked_delivered <= expected_delivered) {\n        bbr_state->extra_acked_delivered = 0;\n        bbr_state->extra_acked_interval_start = current_time;\n        expected_delivered = 0;\n    }\n    bbr_state->extra_acked_delivered += rs->newly_acked;\n    uint64_t extra = bbr_state->extra_acked_delivered - expected_delivered;\n    if (extra > path_x->cwin) {\n        extra = path_x->cwin;\n    }\n    bbr_state->extra_acked =\n        update_windowed_max_filter(bbr_state->ExtraACKedFilter, extra, bbr_state->round_count, BBRExtraAckedFilterLen);\n}\n\n/* Do loss signals suggest inflight is too high?\n* If so, react.\n* This test can trigger spuriously if there are too few packets in transit.\n* For example, if there are two packets in transit and one is lost, the\n* test assumes a loss rate of 50%, but this could be a random event that\n* happens once every 50 RTT. Decisions made because of that would be wrong.\n*/\nstatic int IsInflightTooHigh(picoquic_bbr_state_t* bbr_state, picoquic_path_t * path_x, bbr_per_ack_state_t* rs)\n{\n    if (rs->ecn_alpha > BBRExcessiveEcnCE) {\n        return 1;\n    }\n    else {\n        uint64_t rs_delivered = path_x->delivered - rs->delivered;\n        if (rs_delivered > bbr_state->recovery_delivered &&\n            rs->lost > (uint64_t)(((double)rs->tx_in_flight) * BBRLossThresh) &&\n            rs->lost > 3 * path_x->send_mtu) {\n            return 1;\n        }\n        else {\n            return 0;\n        }\n    }\n}\n\nstatic void BBRHandleInflightTooHigh(picoquic_bbr_state_t* bbr_state, picoquic_path_t * path_x, bbr_per_ack_state_t* rs, uint64_t current_time)\n{\n    /* The computation below compares the number of bytes in flight when the \n     * acked packet was sent to the current target */\n    bbr_state->bw_probe_samples = 0;  /* only react once per bw probe */\n    if (!rs->is_app_limited) {\n        uint64_t beta_target = (uint64_t)(((double)BBRTargetInflight(bbr_state, path_x)) * BBRBeta);\n        bbr_state->inflight_hi = (rs->tx_in_flight > beta_target) ? rs->tx_in_flight : beta_target;\n    }\n    if(bbr_state->state == picoquic_bbr_alg_probe_bw_up) {\n        BBRStartProbeBW_DOWN(bbr_state, path_x, current_time);\n    }\n}\n\nstatic int CheckInflightTooHigh(picoquic_bbr_state_t* bbr_state, picoquic_path_t* path_x, bbr_per_ack_state_t* rs, uint64_t current_time)\n{\n    if (IsInflightTooHigh(bbr_state, path_x, rs))\n    {\n        if (bbr_state->bw_probe_samples)\n        {\n            BBRHandleInflightTooHigh(bbr_state, path_x, rs, current_time);\n        }\n        return 1;  /* inflight too high */\n    }\n    else {\n        return 0;\n    }\n}\n\n/* BBR Round counting functions */\nstatic void BBRInitRoundCounting(picoquic_bbr_state_t* bbr_state, picoquic_path_t* path_x)\n{\n    bbr_state->next_round_delivered = 0;\n    bbr_state->round_start = 0;\n    bbr_state->round_count = 0;\n    bbr_state->round_start_pn = picoquic_cc_get_sequence_number(path_x->cnx, path_x);\n}\n\nstatic void BBRStartRound(picoquic_bbr_state_t* bbr_state, picoquic_path_t* path_x)\n{\n    bbr_state->round_start_pn = picoquic_cc_get_sequence_number(path_x->cnx, path_x);\n\n    bbr_state->next_round_delivered = path_x->delivered;\n}\n\nstatic void BBRUpdateRound(picoquic_bbr_state_t* bbr_state, picoquic_path_t * path_x)\n{\n    if (picoquic_cc_get_ack_number(path_x->cnx, path_x) >= bbr_state->round_start_pn) {\n        BBRStartRound(bbr_state, path_x);\n        bbr_state->round_count++;\n        bbr_state->rounds_since_probe++;\n        bbr_state->round_start = 1;\n        start_windowed_max_filter_period(bbr_state->ExtraACKedFilter, bbr_state->round_count, BBRExtraAckedFilterLen);\n    }\n    else {\n        bbr_state->round_start = 0;\n    }\n}\n\n\n/* End of BBR round counting functions */\n\n/* Restart from idle process\n* TODO: add a congestion callback \"restart from idle\" if sending a packet\n* after a long silence. The tests should be done in the transport loop. This\n* will need to be handled in their own way by all agorithms, and thus cannot\n* be implemented in this PR.\n* The required call back is mentioned in section 4.1. of RFC 5681,\n* Restarting Idle Connections. This is defined for TCP, but should\n* apply equally to a QUIC path. the text says \"Therefore, a TCP SHOULD\n* set cwnd to no more than RW before beginning transmission if the TCP\n* has not sent data in an interval exceeding the retransmission timeout.\"\n* For QUIC, this perhaps should be qualified as \"as not sent ack-eliciting data\".\n* The idle test checks \"no bytes in transit\"; this imply the callback\n* should happen before updating \"bytes in transit\" for the new packet.\n */\n#if 0\nstatic void BBRHandleRestartFromIdle(picoquic_bbr_state_t* bbr_state, picoquic_path_t * path_x, uint64_t current_time)\n{\n    if (path_x->bytes_in_transit == 0 && bbr_state->path_is_app_limited)\n    {\n        bbr_state->idle_restart = 1;\n        bbr_state->extra_acked_interval_start = current_time;\n        if (IsInAProbeBWState(bbr_state)) {\n            BBRSetPacingRateWithGain(bbr_state, 1);\n        }\n        else if (bbr_state->state == picoquic_bbr_alg_probe_rtt) {\n            BBRCheckProbeRTTDone(bbr_state, current_time);\n        }\n    }\n}\n\n\n/* TODO: check definition of app limited. Why is it expressed here?\n* The name should really be, check whether transmission has started.\n* It is used to differentiate \"started and then idle\" from \"has not\n* sent anything yet.\"\n */\nstatic void MarkConnectionAppLimited(picoquic_bbr_state_t* bbr_state)\n{\n    bbr_state->path_is_app_limited =\n        (C.delivered + packets_in_flight) ?  0 : 1;\n}\n\n\n/* Called when the app has sent something. */\nvoid BBROnTransmit(picoquic_bbr_state_t* bbr_state, picoquic_path_t* path_x, uint64_t current_time)\n{\n    BBRHandleRestartFromIdle(bbr_state, path_x, current_time);\n}\n#endif\n/* End of idle functions */\n\n/* ProbeRTT processes for BBv3 */\n\n/* Adapt RTT min margin based on packet transmission time */\nstatic void BBRAdaptMinRttMargin(picoquic_bbr_state_t* bbr_state, picoquic_path_t* path_x)\n{\n    uint64_t margin = ((bbr_state->min_rtt * BBRMinRttMarginPercent) * 100 / 1000000);\n    if (bbr_state->max_bw > 0) {\n        margin += 2 * path_x->send_mtu * 1000000 / bbr_state->max_bw;\n    }\n    bbr_state->min_rtt_margin = margin;\n}\n\n#ifdef RTTJitterBuffer\nstatic void BBRUpdateRTTJitterBuffer(picoquic_bbr_state_t* bbr_state, bbr_per_ack_state_t * rs, uint64_t current_time)\n{\n    if (current_time > bbr_state->last_rtt_sample_stamp + 1000) {\n        bbr_state->rtt_jitter_buffer[bbr_state->rtt_jitter_cycle % BBRRTTJitterBufferLen] = rs->rtt_sample;\n        bbr_state->rtt_jitter_cycle++;\n        bbr_state->last_rtt_sample_stamp = current_time;\n        bbr_state->rtt_short_term_min = UINT64_MAX;\n        bbr_state->rtt_short_term_max = 0;\n        for (unsigned int i = 0; i < BBRRTTJitterBufferLen; i++) {\n            if (i >= bbr_state->rtt_jitter_cycle) {\n                break;\n            }\n            if (bbr_state->rtt_jitter_buffer[i] > bbr_state->rtt_short_term_max) {\n                bbr_state->rtt_short_term_max = bbr_state->rtt_jitter_buffer[i];\n            }\n            if (bbr_state->rtt_jitter_buffer[i] < bbr_state->rtt_short_term_min) {\n                bbr_state->rtt_short_term_min = bbr_state->rtt_jitter_buffer[i];\n            }\n        }\n    }\n}\n\nstatic void BBRResetRTTJitterBuffer(picoquic_bbr_state_t* bbr_state,  uint64_t rtt_init_value, uint64_t current_time)\n{\n    bbr_state->rtt_jitter_cycle = 0;\n    bbr_state->last_rtt_sample_stamp = current_time;\n    bbr_state->rtt_short_term_min = rtt_init_value;\n    bbr_state->rtt_short_term_max = rtt_init_value;\n    bbr_state->probe_rtt_min_delay = rtt_init_value;\n    bbr_state->nb_rtt_excess = 0;\n}\n\nstatic void BBRUpdateMinRTT(picoquic_bbr_state_t* bbr_state, picoquic_path_t* path_x, bbr_per_ack_state_t * rs, uint64_t current_time)\n{\n    BBRAdaptMinRttMargin(bbr_state, path_x);\n    /* maintain filter of last BBRRTTJitterBufferLen samples, to handle jitter */\n    BBRUpdateRTTJitterBuffer(bbr_state, rs, current_time);\n    /* Compute the BBR expired limit */\n    if (bbr_state->min_rtt < UINT64_MAX) {\n        if (bbr_state->min_rtt <= BBRLongRttThreshold) {\n            bbr_state->probe_rtt_expired =\n                current_time > bbr_state->probe_rtt_min_stamp + BBRProbeRTTInterval;\n        }\n        else {\n            bbr_state->probe_rtt_expired =\n                current_time > bbr_state->probe_rtt_min_stamp + bbr_state->min_rtt * 100;\n        }\n    }\n    /* Update min rtt */\n    if (bbr_state->rtt_short_term_max < bbr_state->probe_rtt_min_delay ||\n            bbr_state->probe_rtt_expired ||\n            bbr_state->rtt_jitter_cycle < BBRRTTJitterBufferLen) {\n        bbr_state->probe_rtt_min_delay = bbr_state->rtt_short_term_max;\n        bbr_state->probe_rtt_min_stamp = current_time;\n    }\n    else {\n        /* Deviation from BBRv3: test whether the new measurment does not differ from min_rtt\n         * by more than a \"margin of error, and in that case delay the need to reevaluate min_rtt */\n        if (bbr_state->rtt_short_term_min < (bbr_state->min_rtt + bbr_state->min_rtt_margin)) {\n            bbr_state->probe_rtt_min_stamp = current_time;\n            bbr_state->min_rtt_stamp = current_time;\n        }\n    }\n    int min_rtt_expired =\n        current_time > bbr_state->min_rtt_stamp + BBRMinRTTFilterLen;\n    if (bbr_state->probe_rtt_min_delay < bbr_state->min_rtt ||\n        min_rtt_expired ||\n        bbr_state->rtt_jitter_cycle < BBRRTTJitterBufferLen) {\n        bbr_state->min_rtt = bbr_state->probe_rtt_min_delay;\n        bbr_state->min_rtt_stamp = bbr_state->probe_rtt_min_stamp;\n    }\n\n    if (bbr_state->rtt_short_term_min > bbr_state->min_rtt && bbr_state->min_rtt > PICOQUIC_MINRTT_THRESHOLD)\n    {\n        uint64_t delta_max = PICOQUIC_MINRTT_MARGIN + bbr_state->min_rtt / 4;\n        if (bbr_state->rtt_short_term_min > bbr_state->min_rtt + delta_max) {\n            bbr_state->nb_rtt_excess++;\n        }\n    }\n    else\n    {\n        bbr_state->nb_rtt_excess = 0;\n    }\n\n}\n\nstatic int IsRTTTooHigh(picoquic_bbr_state_t* bbr_state)\n{\n    return (bbr_state->nb_rtt_excess > BBRRTTJitterBufferLen);\n}\n#else\nstatic void BBRUpdateMinRTT(picoquic_bbr_state_t* bbr_state, picoquic_path_t* path_x, bbr_per_ack_state_t * rs, uint64_t current_time)\n{\n    BBRAdaptMinRttMargin(bbr_state, path_x);\n    /* Compute the BBR expired limit */\n    if (bbr_state->min_rtt < UINT64_MAX) {\n        if (bbr_state->min_rtt <= BBRLongRttThreshold) {\n            bbr_state->probe_rtt_expired =\n                current_time > bbr_state->probe_rtt_min_stamp + BBRProbeRTTInterval;\n        }","numLines":300,"startLine":1100,"totalLines":2486}}}
