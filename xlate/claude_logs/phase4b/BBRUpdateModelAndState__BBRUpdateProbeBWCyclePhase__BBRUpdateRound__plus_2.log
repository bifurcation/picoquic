idth at\n547\t    /// `INITIAL_RTT` (250 ms), unless the path already has a real RTT\n548\t    /// estimate, in which case that estimate is used instead.\n549\t    pub fn init_pacing_rate(&mut self, path_x: &Path) {\n550\t        let initial_rtt = if path_x.smoothed_rtt != INITIAL_RTT || path_x.rtt_variant.ticks() != 0 {\n551\t            path_x.smoothed_rtt.ticks()\n552\t        } else {\n553\t            INITIAL_RTT.ticks()\n554\t        };\n555\t        let nominal_bandwidth = (1_000_000u64 * CWIN_INITIAL) as f64 / initial_rtt as f64;\n556\t        self.pacing_rate = BBR_STARTUP_PACING_GAIN * nominal_bandwidth;\n557\t    }\n558\t\n559\t    /// C: `BBRInitRandom` (picoquic/bbr.c:421)\n560\t    ///\n561\t    /// Seed `random_context` from the current time, connection role, and\n562\t    /// path ID so that tests remain deterministic while production runs\n563\t    /// diverge.  `connection` is passed separately because `Path` carries\n564\t    /// no back-pointer to its owning `Connection` in Rust.\n565\t    pub fn init_random(&mut self, connection: &Connection, path_x: &Path, current_time: u64) {\n566\t        let mut ctx: u64 = 0xfedcba9876543210;\n567\t        ctx ^= current_time;\n568\t        if connection.client_mode {\n569\t            ctx = ctx.wrapping_add(0x0123456789abcdef);\n570\t        }\n571\t        if path_x.unique_path_id > 0 && path_x.unique_path_id != u64::MAX {\n572\t            ctx = ctx.wrapping_mul(path_x.unique_path_id.wrapping_add(1));\n573\t        }\n574\t        self.random_context = ctx;\n575\t    }\n576\t\n577\t    /// C: `BBRInflightWithHeadroom` (picoquic/bbr.c:1547)\n578\t    ///\n579\t    /// Returns the inflight limit that leaves `BBRHeadroom` (15%) of the\n580\t    /// bottleneck buffer free for competing flows.  Returns `u64::MAX`\n581\t    /// when `inflight_hi` has not yet been measured.\n582\t    pub fn inflight_with_headroom(&self, path_x: &Path) -> u64 {\n583\t        const BBR_HEADROOM: f64 = 0.15;\n584\t        const BBR_MIN_PIPE_CWND: u64 = 4;\n585\t        if self.inflight_hi == u64::MAX {\n586\t            return u64::MAX;\n587\t        }\n588\t        let headroom = ((1.0 - BBR_HEADROOM) * self.inflight_hi as f64) as u64;\n589\t        headroom.max(BBR_MIN_PIPE_CWND * path_x.send_mtu as u64)\n590\t    }\n591\t\n592\t    /// C: `BBRIsProbingBW` (picoquic/bbr.c:1532)\n593\t    ///\n594\t    /// Returns `true` when the state is actively probing for more bandwidth\n595\t    /// (i.e. NOT in one of the non-probing states: ProbeBwDown, ProbeBwCruise,\n596\t    /// Drain, or ProbeRtt).\n597\t    pub fn is_probing_bw(&self) -> bool {\n598\t        !matches!(\n599\t            self.state,\n600\t            BbrAlgState::ProbeBwDown\n601\t                | BbrAlgState::ProbeBwCruise\n602\t                | BbrAlgState::Drain\n603\t                | BbrAlgState::ProbeRtt\n604\t        )\n605\t    }\n606\t\n607\t    /// C: `BBRLossLowerBounds` (picoquic/bbr.c:1035)\n608\t    ///\n609\t    /// Apply a `BBRBeta` (0.7) multiplicative decrease to `bw_lo` and\n610\t    /// `inflight_lo`, then floor each at the latest sample so the model\n611\t    /// cannot shrink below what was actually observed this round.\n612\t    pub fn loss_lower_bounds(&mut self) {\n613\t        self.bw_lo = ((BBR_BETA * self.bw_lo as f64) as u64).max(self.bw_latest);\n614\t        self.inflight_lo = ((BBR_BETA * self.inflight_lo as f64) as u64).max(self.inflight_latest);\n615\t    }\n616\t\n617\t    /// C: `BBRModulateCwndForRecovery` (picoquic/bbr.c:627)\n618\t    ///\n619\t    /// On packet loss, shrink `cwin` by the number of bytes lost (floored at\n620\t    /// one MTU).  When `packet_conservation` is active, ensure `cwin` is at\n621\t    /// least `bytes_in_transit + newly_acked` so the pipe stays full.\n622\t    pub fn modulate_cwnd_for_recovery(&self, path_x: &mut Path, rs: &BbrPerAckState) {\n623\t        if rs.newly_lost > 0 {\n624\t            if path_x.cwin > rs.newly_lost + path_x.send_mtu as u64 {\n625\t    