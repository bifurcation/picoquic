{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_0194Bf1Fcc8CQj8KpotwMPzn","type":"tool_result","content":"315\t    /// Bytes to add to CWIN while in classic slow start.  Returns\n316\t    /// `nb_delivered` if the path is currently CWIN-blocked, else\n317\t    /// zero (no growth without back-pressure).\n318\t    /// C: `picoquic_cc_slow_start_increase`.\n319\t    fn slow_start_increase(&self, nb_delivered: u64) -> u64;\n320\t\n321\t    /// Bytes to add to CWIN, with HyStart++ Conservative Slow Start\n322\t    /// support: when `in_css` is true, growth is divided by\n323\t    /// [`HYSTART_PP_CSS_GROWTH_DIVISOR`].\n324\t    /// C: `picoquic_cc_slow_start_increase_ex`.\n325\t    fn slow_start_increase_ex(&self, nb_delivered: u64, in_css: bool) -> u64;\n326\t\n327\t    /// Bytes to add to CWIN, with Prague-style ECN damping.\n328\t    /// `prague_alpha` is an integer fraction over 1024 (so `0` means\n329\t    /// no ECN signal and the call falls back to\n330\t    /// [`Self::slow_start_increase_ex`]).\n331\t    /// C: `picoquic_cc_slow_start_increase_ex2`.\n332\t    fn slow_start_increase_ex2(&self, nb_delivered: u64, in_css: bool, prague_alpha: u64) -> u64;\n333\t\n334\t    /// Bandwidth-derived target CWIN: returns the half-BDP estimate\n335\t    /// if it exceeds the current CWIN, otherwise the current CWIN.\n336\t    /// C: `picoquic_cc_update_target_cwin_estimation`.\n337\t    fn update_target_cwin_estimation(&self) -> u64;\n338\t\n339\t    /// CWIN floor for long-RTT paths: scales `CWIN_INITIAL` by the\n340\t    /// path's `rtt_min` (capped at the satellite RTT target).\n341\t    /// Returns the floor if it exceeds the current CWIN, otherwise\n342\t    /// the current CWIN.  C: `picoquic_cc_update_cwin_for_long_rtt`.\n343\t    fn update_cwin_for_long_rtt(&self) -> u64;\n344\t}\n345\t\n346\timpl PathCc for Path {\n347\t    fn lowest_not_ack(&self) -> u64 {\n348\t        // C reads cnx->pkt_ctx[app] for single-path, path->pkt_ctx for multi