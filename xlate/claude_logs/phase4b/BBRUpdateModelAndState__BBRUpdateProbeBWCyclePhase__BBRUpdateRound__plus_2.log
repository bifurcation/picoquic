    BBRSetSendQuantum(bbr_state, path_x);\n2332\t    BBRSetCwnd(bbr_state, path_x, rs);\n2333\t}\n2334\t\n2335\tvoid  BBRUpdateOnACK(picoquic_bbr_state_t* bbr_state, picoquic_path_t* path_x, bbr_per_ack_state_t * rs, uint64_t current_time)\n2336\t{\n2337\t    BBRUpdateModelAndState(bbr_state, path_x, rs, current_time);\n2338\t    if (bbr_state->state == picoquic_bbr_alg_startup_long_rtt) {\n2339\t        BBRUpdateStartupLongRtt(bbr_state, path_x, rs);\n2340\t    }\n2341\t    else {\n2342\t        BBRUpdateControlParameters(bbr_state, path_x, rs);\n2343\t    }\n2344\t}\n2345\t\n2346\t/* First step of BBR ACK processing:\n2347\t* convert the discrete arguments of \"picoquic_bbr_notify\"\n2348\t* into the \"rs\" structure used in the BBRv3 draft. We do\n2349\t* that so that it is easy to compare the code to the draft.\n2350\t* \n2351\t* \n2352\t * Code maintains the following counters per path\n2353\t * - total_bytes_lost -- number of bytes deemed lost from beginning of path\n2354\t * - delivered -- amount delivered so far\n2355\t * - rtt_sample -- last rtt sample\n2356\t * - bytes_in_transit -- bytes currently in flight\n2357\t * \n2358\t * It does not contain `data_lost`, but that could be inferred if\n2359\t * we keep a variable `nb_bytes_lost_since_packet_sent`.\n2360\t * The packet data contains: delivered_prior, so that the BBR variable\n2361\t * \"delivered\" can be computed = path->delivered - packet->delivered_prior.\n2362\t */\n2363\tstatic void BBRSetRsFromAckState(picoquic_path_t* path_x, picoquic_per_ack_state_t* ack_state, bbr_per_ack_state_t* rs)\n2364\t{\n2365\t    /* Need to compute the delivery rate */\n2366\t    if (path_x->bandwidth_estimate > 0) {\n2367\t        rs->delivery_rate = path_x->bandwidth_estimate;\n2368\t    }\n2369\t    else if (ack_state->rtt_measurement > 0) {\n2370\t        rs->delivery_rate = PICOQUIC_RATE_FROM_BYTES(ack_state->nb_bytes_delivered_since_packet_sent, ack_state->rtt_measurement);\n2371\t    }\n2372\t    else\n2373\t    {\n2374\t        rs->delivery_rate = 40000;\n2375\t    }\n2376\t    rs->delivered = ack_state->nb_bytes_delivered_since_packet_sent;\n2377\t    /* variable in path */\n2378\t    rs->rtt_sample = path_x->rtt_sample;\n2379\t    /* variables from call */\n2380\t    rs->newly_acked = ack_state->nb_bytes_acknowledged; /* volume of data acked by current ack */\n2381\t    rs->newly_lost = ack_state->nb_bytes_newly_lost; /* volume of data marked lost on ack received */\n2382\t    rs->lost = ack_state->nb_bytes_lost_since_packet_sent;\n2383\t    rs->tx_in_flight = ack_state->inflight_prior;\n2384\t    rs->is_app_limited = ack_state->is_app_limited; /*Checked that this is properly implemented */   \n2385\t    rs->is_cwnd_limited = ack_state->is_cwnd_limited;\n2386\t}\n2387\t\n2388\tstatic void picoquic_bbr_notify_ack(\n2389\t    picoquic_bbr_state_t* bbr_state,\n2390\t    picoquic_path_t* path_x,\n2391\t    picoquic_per_ack_state_t* ack_state,\n2392\t    uint64_t current_time)\n2393\t{\n2394\t    bbr_per_ack_state_t rs = { 0 };\n2395\t    BBRSetRsFromAckState(path_x, ack_state, &rs);\n2396\t    BBRComputeEcnFrac(bbr_state, path_x, &rs);\n2397\t    BBRUpdateOnACK(bbr_state, path_x, &rs, current_time);\n2398\t}\n2399\t\n2400\t/*\n2401\t * In order to implement BBR, we map generic congestion notification\n2402\t * signals to the corresponding BBR actions.\n2403\t */\n2404\tstatic void picoquic_bbr_notify(\n2405\t    picoquic_cnx_t* UNUSED(cnx),\n2406\t    picoquic_path_t* path_x,\n2407\t    picoquic_congestion_notification_t notification,\n2408\t    picoquic_per_ack_state_t * ack_state,\n2409\t    uint64_t current_time)\n2410\t{\n2411\t    picoquic_bbr_state_t* bbr_state = (picoquic_bbr_state_t*)path_x->congestion_alg_state;\n2412\t    path_x->is_cc_data_updated = 1;\n2413\t\n2414\t    if (bbr_state != NULL) {\n2415\t        switch (notification) {\n2416\t        case picoquic_congestion_notification_ecn_ec:\n2417\t            /* TODO */\n2418\t            break;\n2419\t        case picoquic_congestion_notification_repeat:\n2420\t            BBRUpdateRecoveryOnLoss(bbr_state, path_x, ack_state->nb_bytes_newly_lost);\n2421\t            break;\n2422\t        case picoquic_congestion_notification_timeout:\n2423\t            BBRExitLostFeedback(bbr_state, path_x);\n2424\t            /* if loss is PTO, we should start the OnPto processing */\n2425\t            BBROnEnterRTO(bbr_state, path_x, ack_state->lost_packet_number);\n2426\t            break;\n2427\t        case picoquic_congestion_notification_spurious_repeat:\n2428\t            /* handling of suspension */\n2429\t            BBROnSpuriousLoss(bbr_state, path_x, ack_state->lost_packet_number, current_time);\n2430\t            break;\n2431\t        case picoquic_congestion_notification_lost_feedback:\n2432\t            /* Feedback has been lost. It will be restored at the next notification. */\n2433\t            BBRExpGate(bbr_state, do_control_lost, break);\n2434\t            BBREnterLostFeedback(bbr_state, path_x);\n2435\t            break;\n2436\t        case picoquic_congestion_notification_rtt_measurement:\n2437\t            /* TODO: this call is subsumed by the acknowledgement notification.\n2438\t             * Consider removing it from the API once other CC algorithms are updated.  */\n2439\t            break;\n2440\t        case picoquic_congestion_notification_acknowledgement:\n2441\t            BBRExitLostFeedback(bbr_state, path_x);\n2442\t            picoquic_bbr_notify_ack(bbr_state, path_x, ack_state, current_time);\n2443\t            if (bbr_state->state == picoquic_bbr_alg_startup_long_rtt) {\n2444\t                picoquic_update_pacing_data(path_x, 1);\n2445\t            }\n2446\t            else if (bbr_state->pacing_rate > 0) {\n2447\t                /* Set the pacing rate in picoquic sender */\n2448\t                picoquic_update_pacing_rate(path_x, bbr_state->pacing_rate, bbr_state->send_quantum);\n2449\t            }\n2450\t            break;\n2451\t        case picoquic_congestion_notification_cwin_blocked:\n2452\t            break;\n2453\t        case picoquic_congestion_notification_reset:\n2454\t            picoquic_bbr_reset(bbr_state, path_x, current_time);\n2455\t            break;\n2456\t        case picoquic_congestion_notification_seed_cwin:\n2457\t            BBRSetBdpSeed(bbr_state, ack_state->nb_bytes_acknowledged);\n2458\t            break;\n2459\t        default:\n2460\t            /* ignore */\n2461\t            break;\n2462\t        }\n2463\t    }\n2464\t}\n2465\t\n2466\t/* Observe the state of congestion control */\n2467\t\n2468\tvoid picoquic_bbr_observe(picoquic_path_t* path_x, uint64_t* cc_state, uint64_t* cc_param)\n2469\t{\n2470\t    picoquic_bbr_state_t* bbr_state = (picoquic_bbr_state_t*)path_x->congestion_alg_state;\n2471\t    *cc_state = (uint64_t)bbr_state->state;\n2472\t    *cc_param = bbr_state->bw;\n2473\t}\n2474\t\n2475\t#define picoquic_bbr_ID \"bbr\" /* BBR */\n2476\t\n2477\tpicoquic_congestion_algorithm_t picoquic_bbr_algorithm_struct = {\n2478\t    picoquic_bbr_ID, PICOQUIC_CC_ALGO_NUMBER_BBR, PICOQUIC_ECN_ECT_0,\n2479\t    picoquic_bbr_init,\n2480\t    picoquic_bbr_notify,\n2481\t    picoquic_bbr_delete,\n2482\t    picoquic_bbr_observe\n2483\t};\n2484\t\n2485\tpicoquic_congestion_algorithm_t* picoquic_bbr_algorithm = &picoquic_bbr_algorithm_struct;\n2486\t"}]},"parent_tool_use_id":null,"session_id":"37a51392-c08c-4073-9b42-c60eaa9c5eb7","uuid":"88cc1956-23c3-4a8a-9e4d-a254bcdb30b7","timestamp":"2026-05-07T13:09:32.718Z","tool_use_result":{"type":"text","file":{"filePath":"/Users/richbarn/Projects/picoquic/picoquic/bbr.c","content":"                pkt_ctx->ecn_ce_total_remote < bbr_state->ecn_ce_last_round) {\n                bbr_state->ecn_alpha = 0;\n            }\n            else {\n                bbr_state->ecn_alpha = (rs->ecn_frac + 15.0 * bbr_state->ecn_alpha) / 16;\n            }\n            bbr_state->ecn_ect1_last_round = pkt_ctx->ecn_ect1_total_remote;\n            bbr_state->ecn_ce_last_round = pkt_ctx->ecn_ce_total_remote;\n        }\n    }\n}\n\n/* BBRv3 per ACK steps\n* The function BBRUpdateOnACK is executed for each ACK notification on the API \n*/\nstatic void BBRUpdateModelAndState(picoquic_bbr_state_t* bbr_state, picoquic_path_t* path_x, bbr_per_ack_state_t * rs, uint64_t current_time)\n{\n    BBRUpdateLatestDeliverySignals(bbr_state, path_x, rs);\n    BBRUpdateCongestionSignals(bbr_state, path_x, rs);\n    BBRUpdateACKAggregation(bbr_state, path_x, rs, current_time);\n    BBRCheckStartupLongRtt(bbr_state, path_x, rs, current_time);\n    BBRCheckStartupResume(bbr_state, path_x, rs);\n    BBRCheckStartupDone(bbr_state, path_x, rs);\n    BBRCheckRecovery(bbr_state, path_x, rs, current_time);\n    BBRCheckDrain(bbr_state, path_x, current_time);\n    BBRUpdateProbeBWCyclePhase(bbr_state, path_x, rs, current_time);\n    BBRUpdateMinRTT(bbr_state, path_x, rs, current_time);\n    BBRCheckProbeRTT(bbr_state, path_x, rs, current_time);\n    BBRAdvanceLatestDeliverySignals(bbr_state, rs);\n    BBRAdvanceEcnFrac(bbr_state, path_x, rs);\n    BBRBoundBWForModel(bbr_state);\n}\n\nstatic void BBRUpdateControlParameters(picoquic_bbr_state_t* bbr_state, picoquic_path_t* path_x, bbr_per_ack_state_t * rs)\n{\n    BBRSetPacingRate(bbr_state);\n    BBRSetSendQuantum(bbr_state, path_x);\n    BBRSetCwnd(bbr_state, path_x, rs);\n}\n\nvoid  BBRUpdateOnACK(picoquic_bbr_state_t* bbr_state, picoquic_path_t* path_x, bbr_per_ack_state_t * rs, uint64_t current_time)\n{\n    BBRUpdateModelAndState(bbr_state, path_x, rs, current_time);\n    if (bbr_state->state == picoquic_bbr_alg_startup_long_rtt) {\n        BBRUpdateStartupLongRtt(bbr_state, path_x, rs);\n    }\n    else {\n        BBRUpdateControlParameters(bbr_state, path_x, rs);\n    }\n}\n\n/* First step of BBR ACK processing:\n* convert the discrete arguments of \"picoquic_bbr_notify\"\n* into the \"rs\" structure used in the BBRv3 draft. We do\n* that so that it is easy to compare the code to the draft.\n* \n* \n * Code maintains the following counters per path\n * - total_bytes_lost -- number of bytes deemed lost from beginning of path\n * - delivered -- amount delivered so far\n * - rtt_sample -- last rtt sample\n * - bytes_in_transit -- bytes currently in flight\n * \n * It does not contain `data_lost`, but that could be inferred if\n * we keep a variable `nb_bytes_lost_since_packet_sent`.\n * The packet data contains: delivered_prior, so that the BBR variable\n * \"delivered\" can be computed = path->delivered - packet->delivered_prior.\n */\nstatic void BBRSetRsFromAckState(picoquic_path_t* path_x, picoquic_per_ack_state_t* ack_state, bbr_per_ack_state_t* rs)\n{\n    /* Need to compute the delivery rate */\n    if (path_x->bandwidth_estimate > 0) {\n        rs->delivery_rate = path_x->bandwidth_estimate;\n    }\n    else if (ack_state->rtt_measurement > 0) {\n        rs->delivery_rate = PICOQUIC_RATE_FROM_BYTES(ack_state->nb_bytes_delivered_since_packet_sent, ack_state->rtt_measurement);\n    }\n    else\n    {\n        rs->delivery_rate = 40000;\n    }\n    rs->delivered = ack_state->nb_bytes_delivered_since_packet_sent;\n    /* variable in path */\n    rs->rtt_sample = path_x->rtt_sample;\n    /* variables from call */\n    rs->newly_acked = ack_state->nb_bytes_acknowledged; /* volume of data acked by current ack */\n    rs->newly_lost = ack_state->nb_bytes_newly_lost; /* volume of data marked lost on ack received */\n    rs->lost = ack_state->nb_bytes_lost_since_packet_sent;\n    rs->tx_in_flight = ack_state->inflight_prior;\n    rs->is_app_limited = ack_state->is_app_limited; /*Checked that this is properly implemented */   \n    rs->is_cwnd_limited = ack_state->is_cwnd_limited;\n}\n\nstatic void picoquic_bbr_notify_ack(\n    picoquic_bbr_state_t* bbr_state,\n    picoquic_path_t* path_x,\n    picoquic_per_ack_state_t* ack_state,\n    uint64_t current_time)\n{\n    bbr_per_ack_state_t rs = { 0 };\n    BBRSetRsFromAckState(path_x, ack_state, &rs);\n    BBRComputeEcnFrac(bbr_state, path_x, &rs);\n    BBRUpdateOnACK(bbr_state, path_x, &rs, current_time);\n}\n\n/*\n * In order to implement BBR, we map generic congestion notification\n * signals to the corresponding BBR actions.\n */\nstatic void picoquic_bbr_notify(\n    picoquic_cnx_t* UNUSED(cnx),\n    picoquic_path_t* path_x,\n    picoquic_congestion_notification_t notification,\n    picoquic_per_ack_state_t * ack_state,\n    uint64_t current_time)\n{\n    picoquic_bbr_state_t* bbr_state = (picoquic_bbr_state_t*)path_x->congestion_alg_state;\n    path_x->is_cc_data_updated = 1;\n\n    if (bbr_state != NULL) {\n        switch (notification) {\n        case picoquic_congestion_notification_ecn_ec:\n            /* TODO */\n            break;\n        case picoquic_congestion_notification_repeat:\n            BBRUpdateRecoveryOnLoss(bbr_state, path_x, ack_state->nb_bytes_newly_lost);\n            break;\n        case picoquic_congestion_notification_timeout:\n            BBRExitLostFeedback(bbr_state, path_x);\n            /* if loss is PTO, we should start the OnPto processing */\n            BBROnEnterRTO(bbr_state, path_x, ack_state->lost_packet_number);\n            break;\n        case picoquic_congestion_notification_spurious_repeat:\n            /* handling of suspension */\n            BBROnSpuriousLoss(bbr_state, path_x, ack_state->lost_packet_number, current_time);\n            break;\n        case picoquic_congestion_notification_lost_feedback:\n            /* Feedback has been lost. It will be restored at the next notification. */\n            BBRExpGate(bbr_state, do_control_lost, break);\n            BBREnterLostFeedback(bbr_state, path_x);\n            break;\n        case picoquic_congestion_notification_rtt_measurement:\n            /* TODO: this call is subsumed by the acknowledgement notification.\n             * Consider removing it from the API once other CC algorithms are updated.  */\n            break;\n        case picoquic_congestion_notification_acknowledgement:\n            BBRExitLostFeedback(bbr_state, path_x);\n            picoquic_bbr_notify_ack(bbr_state, path_x, ack_state, current_time);\n            if (bbr_state->state == picoquic_bbr_alg_startup_long_rtt) {\n                picoquic_update_pacing_data(path_x, 1);\n            }\n            else if (bbr_state->pacing_rate > 0) {\n                /* Set the pacing rate in picoquic sender */\n                picoquic_update_pacing_rate(path_x, bbr_state->pacing_rate, bbr_state->send_quantum);\n            }\n            break;\n        case picoquic_congestion_notification_cwin_blocked:\n            break;\n        case picoquic_congestion_notification_reset:\n            picoquic_bbr_reset(bbr_state, path_x, current_time);\n            break;\n        case picoquic_congestion_notification_seed_cwin:\n            BBRSetBdpSeed(bbr_state, ack_state->nb_bytes_acknowledged);\n            break;\n        default:\n            /* ignore */\n            break;\n        }\n    }\n}\n\n/* Observe the state of congestion control */\n\nvoid picoquic_bbr_observe(picoquic_path_t* path_x, uint64_t* cc_state, uint64_t* cc_param)\n{\n    picoquic_bbr_state_t* bbr_state = (picoquic_bbr_state_t*)path_x->congestion_alg_state;\n    *cc_state = (uint64_t)bbr_state->state;\n    *cc_param = bbr_state->bw;\n}\n\n#define picoquic_bbr_ID \"bbr\" /* BBR */\n\npicoquic_congestion_algorithm_t picoquic_bbr_algorithm_struct = {\n    picoquic_bbr_ID, PICOQUIC_CC_ALGO_NUMBER_BBR, PICOQUIC_ECN_ECT_0,\n    picoquic_bbr_init,\n    picoquic_bbr_notify,\n    picoquic_bbr_delete,\n    picoquic_bbr_observe\n};\n\npicoquic_congestion_algorithm_t* picoquic_bbr_algorithm = &picoquic_bbr_algorithm_struct;\n","numLines":192,"startLine":2295,"totalLines":2486}}}
