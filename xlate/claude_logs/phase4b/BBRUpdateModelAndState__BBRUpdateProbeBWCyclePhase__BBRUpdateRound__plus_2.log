{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01F9M384vLk4Lb29iXxuDyom","type":"tool_result","content":"1050\t/* Once per round-trip respond to congestion */\n1051\tstatic void BBRAdaptLowerBoundsFromCongestion(picoquic_bbr_state_t* bbr_state, picoquic_path_t* path_x)\n1052\t{\n1053\t    if (BBRIsProbingBW(bbr_state)) {\n1054\t        return;\n1055\t    }\n1056\t#ifdef RTTJitterBufferAdapt\n1057\t    if (bbr_state->loss_in_round || bbr_state->rtt_too_high_in_round) {\n1058\t#else\n1059\t    if (bbr_state->loss_in_round) {\n1060\t#endif\n1061\t        BBRInitLowerBounds(bbr_state, path_x);\n1062\t        BBRLossLowerBounds(bbr_state);\n1063\t    }\n1064\t}\n1065\t\n1066\t/* Update congestion state on every ACK */\n1067\tstatic void  BBRUpdateCongestionSignals(picoquic_bbr_state_t* bbr_state, picoquic_path_t* path_x, bbr_per_ack_state_t * rs)\n1068\t{\n1069\t    BBRUpdateMaxBw(bbr_state, path_x, rs);\n1070\t    if (rs->newly_lost > 0) {\n1071\t        bbr_state->loss_in_round = 1;\n1072\t    }\n1073\t#ifdef RTTJitterBufferAdapt\n1074\t    if (IsRTTTooHigh(bbr_state)) {\n1075\t        bbr_state->rtt_too_high_in_round = 1;\n1076\t    }\n1077\t#endif\n1078\t    if (!bbr_state->loss_round_start) {\n1079\t        return;  /* wait until end of round trip */\n1080\t    }\n1081\t    BBRAdaptLowerBoundsFromCongestion(bbr_state, path_x);\n1082\t    bbr_state->loss_in_round = 0;\n1083\t#ifdef RTTJitterBufferAdapt\n1084\t    bbr_state->rtt_too_high_in_round = 0;\n1085\t#endif\n1086\t}\n1087\t\n1088\tstatic void BBRResetLowerBounds(picoquic_bbr_state_t* bbr_state)\n1089\t{\n1090\t    bbr_state->bw_lo = UINT64_MAX;\n1091\t    bbr_state->inflight_lo = UINT64_MAX;\n1092\t}\n1093\t        \n1094\tstatic void  BBRBoundBWForModel(picoquic_bbr_state_t* bbr_state) {\n1095\t    /* set bw = min(max_bw, bw_lo, bw_hi)  */\n1096\t    bbr_state->bw = bbr_state->max_bw;\n1097\t    if (bbr_state->bw > bbr_state->bw_lo) {\n1098\t        bbr_state->bw = bbr_state->bw_lo;\n1099\t    }\n1100\t    /* TODO: remove the test bw_hi != 0 once variables properly initialized. */\n1101\t    if (bbr_state->bw > bbr_state->bw_hi && bbr_state->bw_hi != 0) {\n1102\t        bbr_state->bw = bbr_state->bw_hi;\n1103\t    }\n1104\t}\n1105\t\n1106\t\n1107\t/* Path Model functions when probing for bandwidth */\n1108\tstatic void BBRUpdateMaxBw(picoquic_bbr_state_t* bbr_state, picoquic_path_t* path_x, bbr_per_ack_state_t * rs)\n1109\t{\n1110\t    BBRUpdateRound(bbr_state, path_x);\n1111\t\n1112\t    if (rs->delivery_rate >= bbr_state->MaxBwFilter[bbr_state->cycle_count%BBRMaxBwFilterLen] || !rs->is_app_limited) {\n1113\t        bbr_state->max_bw = update_windowed_max_filter(\n1114\t            bbr_state->MaxBwFilter, rs->delivery_rate, bbr_state->cycle_count, BBRMaxBwFilterLen);\n1115\t    }\n1116\t}\n1117\t\n1118\tstatic void BBRAdvanceMaxBwFilter(picoquic_bbr_state_t* bbr_state)\n1119\t{\n1120\t    bbr_state->cycle_count++;\n1121\t    bbr_state->ack_phase = picoquic_bbr_acks_probe_starting;\n1122\t\n1123\t    /* Should the current cycle value be set to zero? Or do we simply rely on the\n1124\t     * natural rythm of updates, keeping the old value if we only see app limited updates?\n1125\t     */\n1126\t    start_windowed_max_filter_period(bbr_state->MaxBwFilter, bbr_state->cycle_count, BBRMaxBwFilterLen);\n1127\t}\n1128\t\n1129\tstatic void BBRUpdateACKAggregation(picoquic_bbr_state_t* bbr_state, picoquic_path_t * path_x, bbr_per_ack_state_t* rs, uint64_t current_time)\n1130\t{\n1131\t    /* Find excess ACKed beyond expected amount over this interval */\n1132\t    uint64_t interval = (current_time - bbr_state->extra_acked_interval_start);\n1133\t    uint64_t expected_delivered = bbr_state->bw * interval;\n1134\t    /* Reset interval if ACK rate is below expected rate: */\n1135\t    if (bbr_state->extra_acked_delivered <= expected_delivered) {\n1136\t        bbr_state->extra_acked_delivered = 0;\n1137\t        bbr_state->extra_acked_interval_start = current_time;\n1138\t        expected_delivered = 0;\n1139\t    }\n1140\t    bbr_state->extra_acked_delivered += rs->newly_acked;\n1141\t    uint64_t extra = bbr_state->extra_acked_delivered - expected_delivered;\n1142\t    if (extra > path_x->cwin) {\n1143\t        extra = path_x->cwin;\n1144\t    }\n1145\t    bbr_state->extra_acked =\n1146\t        update_windowed_max_filter(bbr_state->ExtraACKedFilter, extra, bbr_state->round_count, BBRExtraAckedFilterLen);\n1147\t}\n1148\t\n1149\t/* Do loss signals suggest inflight is too high?"}]},"parent_tool_use_id":null,"session_id":"37a51392-c08c-4073-9b42-c60eaa9c5eb7","uuid":"816779cf-484b-4427-8571-4ce345f717ae","timestamp":"2026-05-07T13:10:25.403Z","tool_use_result":{"type":"text","file":{"filePath":"/Users/richbarn/Projects/picoquic/picoquic/bbr.c","content":"/* Once per round-trip respond to congestion */\nstatic void BBRAdaptLowerBoundsFromCongestion(picoquic_bbr_state_t* bbr_state, picoquic_path_t* path_x)\n{\n    if (BBRIsProbingBW(bbr_state)) {\n        return;\n    }\n#ifdef RTTJitterBufferAdapt\n    if (bbr_state->loss_in_round || bbr_state->rtt_too_high_in_round) {\n#else\n    if (bbr_state->loss_in_round) {\n#endif\n        BBRInitLowerBounds(bbr_state, path_x);\n        BBRLossLowerBounds(bbr_state);\n    }\n}\n\n/* Update congestion state on every ACK */\nstatic void  BBRUpdateCongestionSignals(picoquic_bbr_state_t* bbr_state, picoquic_path_t* path_x, bbr_per_ack_state_t * rs)\n{\n    BBRUpdateMaxBw(bbr_state, path_x, rs);\n    if (rs->newly_lost > 0) {\n        bbr_state->loss_in_round = 1;\n    }\n#ifdef RTTJitterBufferAdapt\n    if (IsRTTTooHigh(bbr_state)) {\n        bbr_state->rtt_too_high_in_round = 1;\n    }\n#endif\n    if (!bbr_state->loss_round_start) {\n        return;  /* wait until end of round trip */\n    }\n    BBRAdaptLowerBoundsFromCongestion(bbr_state, path_x);\n    bbr_state->loss_in_round = 0;\n#ifdef RTTJitterBufferAdapt\n    bbr_state->rtt_too_high_in_round = 0;\n#endif\n}\n\nstatic void BBRResetLowerBounds(picoquic_bbr_state_t* bbr_state)\n{\n    bbr_state->bw_lo = UINT64_MAX;\n    bbr_state->inflight_lo = UINT64_MAX;\n}\n        \nstatic void  BBRBoundBWForModel(picoquic_bbr_state_t* bbr_state) {\n    /* set bw = min(max_bw, bw_lo, bw_hi)  */\n    bbr_state->bw = bbr_state->max_bw;\n    if (bbr_state->bw > bbr_state->bw_lo) {\n        bbr_state->bw = bbr_state->bw_lo;\n    }\n    /* TODO: remove the test bw_hi != 0 once variables properly initialized. */\n    if (bbr_state->bw > bbr_state->bw_hi && bbr_state->bw_hi != 0) {\n        bbr_state->bw = bbr_state->bw_hi;\n    }\n}\n\n\n/* Path Model functions when probing for bandwidth */\nstatic void BBRUpdateMaxBw(picoquic_bbr_state_t* bbr_state, picoquic_path_t* path_x, bbr_per_ack_state_t * rs)\n{\n    BBRUpdateRound(bbr_state, path_x);\n\n    if (rs->delivery_rate >= bbr_state->MaxBwFilter[bbr_state->cycle_count%BBRMaxBwFilterLen] || !rs->is_app_limited) {\n        bbr_state->max_bw = update_windowed_max_filter(\n            bbr_state->MaxBwFilter, rs->delivery_rate, bbr_state->cycle_count, BBRMaxBwFilterLen);\n    }\n}\n\nstatic void BBRAdvanceMaxBwFilter(picoquic_bbr_state_t* bbr_state)\n{\n    bbr_state->cycle_count++;\n    bbr_state->ack_phase = picoquic_bbr_acks_probe_starting;\n\n    /* Should the current cycle value be set to zero? Or do we simply rely on the\n     * natural rythm of updates, keeping the old value if we only see app limited updates?\n     */\n    start_windowed_max_filter_period(bbr_state->MaxBwFilter, bbr_state->cycle_count, BBRMaxBwFilterLen);\n}\n\nstatic void BBRUpdateACKAggregation(picoquic_bbr_state_t* bbr_state, picoquic_path_t * path_x, bbr_per_ack_state_t* rs, uint64_t current_time)\n{\n    /* Find excess ACKed beyond expected amount over this interval */\n    uint64_t interval = (current_time - bbr_state->extra_acked_interval_start);\n    uint64_t expected_delivered = bbr_state->bw * interval;\n    /* Reset interval if ACK rate is below expected rate: */\n    if (bbr_state->extra_acked_delivered <= expected_delivered) {\n        bbr_state->extra_acked_delivered = 0;\n        bbr_state->extra_acked_interval_start = current_time;\n        expected_delivered = 0;\n    }\n    bbr_state->extra_acked_delivered += rs->newly_acked;\n    uint64_t extra = bbr_state->extra_acked_delivered - expected_delivered;\n    if (extra > path_x->cwin) {\n        extra = path_x->cwin;\n    }\n    bbr_state->extra_acked =\n        update_windowed_max_filter(bbr_state->ExtraACKedFilter, extra, bbr_state->round_count, BBRExtraAckedFilterLen);\n}\n\n/* Do loss signals suggest inflight is too high?","numLines":100,"startLine":1050,"totalLines":2486}}}
