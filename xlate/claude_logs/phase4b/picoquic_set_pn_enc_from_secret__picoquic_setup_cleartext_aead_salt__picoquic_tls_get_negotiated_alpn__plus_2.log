6`)\n1775\t/// and lift them through this entry point.\n1776\tpub fn hash_create(algorithm_name: &str) -> Option<Box<dyn digest::DynDigest>> {\n1777\t    use digest::Digest;\n1778\t\n1779\t    match algorithm_name {\n1780\t        \"sha256\" | \"SHA256\" | \"SHA-256\" => Some(Box::new(sha2::Sha256::new())),\n1781\t        \"sha384\" | \"SHA384\" | \"SHA-384\" => Some(Box::new(sha2::Sha384::new())),\n1782\t        \"sha512\" | \"SHA512\" | \"SHA-512\" => Some(Box::new(sha2::Sha512::new())),\n1783\t        _ => None,\n1784\t    }\n1785\t}\n1786\t\n1787\t/// Digest length (bytes) of the named hash algorithm, or 0 when\n1788\t/// the algorithm is unknown.  C: `hash_get_length`.\n1789\tpub fn hash_get_length(algorithm_name: &str) -> usize {\n1790\t    match algorithm_name {\n1791\t        \"sha256\" | \"SHA256\" | \"SHA-256\" => 32,\n1792\t        \"sha384\" | \"SHA384\" | \"SHA-384\" => 48,\n1793\t        \"sha512\" | \"SHA512\" | \"SHA-512\" => 64,\n1794\t        _ => 0,\n1795\t    }\n1796\t}\n1797\t\n1798\t/// Obtain a streaming hash context for the named algorithm by searching the\n1799\t/// cipher-suite table.  Recognized names: `\"sha256\"`, `\"sha384\"`, `\"sha512\"`\n1800\t/// (and common aliases).  Returns `None` for unknown names, matching the C\n1801\t/// `NULL` return when the name is not found in the suite table.\n1802\t/// C: `picoquic_get_hash_algorithm_by_name`\n1803\tpub fn get_hash_algorithm_by_name(hash_algorithm_name: &str) -> Option<Box<dyn digest::DynDigest>> {\n1804\t    hash_create(hash_algorithm_name)\n1805\t}\n1806\t\n1807\t// `hash_update` and `hash_finalize` are gone -- callers use\n1808\t// `digest::DynDigest`'s `update` and `finalize_into` methods on\n1809\t// the boxed trait object returned by `hash_create`.\n1810\t\n1811\t// ---------------------------------------------------------------------------\n1812\t// Private-key / certificate file loaders.\n1813\t\n1814\timpl Quic {\n1815\t    /// Load a PEM-encoded private key from `file_name` an