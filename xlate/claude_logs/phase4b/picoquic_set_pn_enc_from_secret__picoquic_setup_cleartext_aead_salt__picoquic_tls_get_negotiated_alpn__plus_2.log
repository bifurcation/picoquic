\n1013\t            }\n1014\t        }\n1015\t\n1016\t        for chunk in &chunks {\n1017\t            if session.read_handshake(chunk)?\n1018\t                && let Some(keys) = session.write_handshake(&mut self.tls_sendbuf)\n1019\t            {\n1020\t                install_key_pair(&mut self.crypto_context[3], keys);\n1021\t            }\n1022\t        }\n1023\t\n1024\t        if let Some(keys) = session.write_handshake(&mut self.tls_sendbuf) {\n1025\t            install_key_pair(&mut self.crypto_context[3], keys);\n1026\t        }\n1027\t\n1028\t        if !self.tls_sendbuf.is_empty() {\n1029\t            let out = core::mem::take(&mut self.tls_sendbuf);\n1030\t            queue_tls_bytes(self, 0, &out)?;\n1031\t        }\n1032\t\n1033\t        if !session.is_handshaking() {\n1034\t            self.ready_state_transition(current_time);\n1035\t        }\n1036\t        self.tls_ctx = Some(session);\n1037\t        Ok(consumed)\n1038\t    }\n1039\t\n1040\t    /// Report whether the TLS handshake has completed.  C signature\n1041\t    /// returned `int` (0/1); promoted to `bool`.  C:\n1042\t    /// `is_tls_complete`.\n1043\t    pub fn is_tls_complete(&self) -> bool {\n1044\t        self.tls_ctx.as_ref().is_some_and(|s| !s.is_handshaking())\n1045\t    }"}]},"parent_tool_use_id":null,"session_id":"9b264549-cec3-4800-9d6a-f061bc9f44d5","uuid":"59b38d9d-5adf-4e74-9ce9-03c98d7fcef2","timestamp":"2026-05-07T10:02:54.242Z","tool_use_result":{"type":"text","file":{"filePath":"/Users/richbarn/Projects/picoquic/rs/fq/src/tls_api.rs","content":"// ---------------------------------------------------------------------------\n// Master TLS context.\n//\n// In Phase 2 the C `*mut c_void tls_master_ctx` is replaced by\n// `Quic.tls_client_config` / `tls_server_config` (boxed\n// `DynClientConfig` / `DynServerConfig` trait objects defined in\n// [`crate::tls`]).  Both lifecycle entry points install or\n// release state on the QUIC context itself.\n\nimpl Quic {\n    /// Initialize