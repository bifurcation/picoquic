tring surface.\n2081\t\n2082\t/// Load or unload the PTLS fusion AES-GCM cipher suites.  In the C\n2083\t/// implementation this registers `ptls_fusion_aes128gcm` and\n2084\t/// `ptls_fusion_aes256gcm` into the global cipher-suite registry when\n2085\t/// the CPU supports the required instructions.  In Rust there is no\n2086\t/// global registry — the application selects a backend directly — so\n2087\t/// this is a deliberate no-op for the non-fusion case.\n2088\t/// C: `picoquic_ptls_fusion_load`.\n2089\tpub fn ptls_fusion_load(_unload: bool) {}\n2090\t\n2091\t/// Initialize the minicrypto provider.  In the current C implementation\n2092\t/// the function body is empty (`/* Nothing for now */`); the Rust\n2093\t/// translation matches.  C: `picoquic_init_minicrypto`.\n2094\tpub fn init_minicrypto() {}\n2095\t\n2096\t/// Load a PEM private key from `keypem` for the minicrypto backend.\n2097\t/// The C implementation delegates to `ptls_minicrypto_load_private_key`;\n2098\t/// in Rust the file is read and validated as a PEM private-key block.\n2099\t/// Returns `Err(NoSuchFile)` when the path is unreadable and\n2100\t/// `Err(InvalidFile)` when no private-key PEM header is found.\n2101\t/// C: `set_minicrypto_private_key_from_key_file`.\n2102\tpub fn set_minicrypto_private_key_from_key_file(keypem: &str) -> Result<(), Error> {\n2103\t    let contents = std::fs::read_to_string(keypem).map_err(|_| Error::NoSuchFile)?;\n2104\t    if contents.contains(\"-----BEGIN \") && contents.contains(\"PRIVATE KEY-----\") {\n2105\t        Ok(())\n2106\t    } else {\n2107\t        Err(Error::InvalidFile)\n2108\t    }\n2109\t}\n2110\t\n2111\t/// Tear down any state set up by `picoquic_init_minicrypto`.  In the\n2112\t/// current C implementation the function body is empty\n2113\t/// (`/* Nothing for now */`); the Rust translation matches.\n2114\t/// C: `picoquic_clear_minicrypto`.\n2115\tpub fn clear_minicrypto() {}\n2116\t\n2117\t// ----------------------------------------------------