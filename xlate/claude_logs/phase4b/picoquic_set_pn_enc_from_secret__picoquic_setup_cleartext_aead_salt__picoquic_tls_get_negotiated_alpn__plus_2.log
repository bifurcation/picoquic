\n1086\t}\n1087\t\n1088\t// ---------------------------------------------------------------------------\n1089\t// Random number generation.\n1090\t//\n1091\t// The crypto-grade RNG is the tls / OpenSSL provider; the public RNG\n1092\t// is xorshift1024* seeded from the crypto RNG.  Both take a\n1093\t// destination slice; the C `(void* buf, size_t len)` pair collapses\n1094\t// to `&mut [u8]`.\n1095\t\n1096\t// `crypto_uniform_random` / `seed_public_random` are gone -- callers\n1097\t// reach `Quic.rng` (a `Box<dyn CryptoRng>`) directly and use the\n1098\t// `rand::Rng` / `rand::RngCore` methods on it.  The public-RNG helpers\n1099\t// (`public_random_64` etc.) likewise disappear: callers use `rand::rng()`\n1100\t// for the thread-local non-secure stream.\n1101\t// `crypto_random` is exposed as [`Quic::crypto_random`] above.\n1102\t\n1103\t// ---------------------------------------------------------------------------\n1104\t// AEAD primitives.\n1105\t//\n1106\t// The C `aead_*` family wrapped opaque `void*` handles around\n1107\t// `ptls_aead_context_t*`.  Phase 2 replaced them with the\n1108\t// [`crate::tls::PacketKey`] trait — backends supply implementations,\n1109\t// the rest of the crate is generic over them.  This module\n1110\t// retains only the constant `QUIC_AEAD_TAG_LEN` (the fixed\n1111\t// 16-byte tag QUIC mandates).\n1112\t\n1113\t/// Length of the QUIC AEAD authentication tag.  All TLS 1.3\n1114\t/// cipher suites used by QUIC (RFC 9001 §5.3) produce a 16-byte\n1115\t/// tag, so the value is fixed.  Replaces the C\n1116\t/// `aead_get_checksum_length(void*)` accessor; once a\n1117\t/// [`crate::tls::PacketKey`] exists, prefer `key.tag_len()`.\n1118\tpub const QUIC_AEAD_TAG_LEN: usize = 16;\n1119\t\n1120\t/// Return the AEAD authentication tag length, capped at 16 bytes.\n1121\t/// The C function read `algo->tag_size` from a `ptls_aead_context_t`\n1122\t/// and clamped it to 16; in Rust the cap is preserved for parity even\n1123\t/// though all QUIC cipher suites already produce exactly 16 bytes.\n1124\t/// C: `picoquic_aead_get_checksum_length`\n1125\tpub fn aead_get_checksum_length(aead_ctx: &dyn crate::tls::PacketKey) -> usize {\n1126\t    aead_ctx.tag_len().min(16)\n1127\t}\n1128\t\n1129\t/// Return the confidentiality limit for the AEAD algorithm: the\n1130\t/// maximum number of packets that may be sent before a key update is\n1131\t/// required (RFC 9001 §6.6).\n1132\t/// C: `picoquic_aead_confidentiality_limit`\n1133\tpub fn aead_confidentiality_limit(aead_ctx: &dyn crate::tls::PacketKey) -> u64 {\n1134\t    aead_ctx.confidentiality_limit()\n1135\t}\n1136\t\n1137\t/// Decrypt `input` and write the plaintext to `output`, verifying the\n1138\t/// authentication tag.  Returns the number of plaintext bytes written.\n1139\t/// The C function accepted a nullable `void* aead_ctx` and returned\n1140\t/// `SIZE_MAX` when the pointer was null or decryption failed; here\n1141\t/// a missing context is represented as `None` and both failure modes\n1142\t/// become `Err(Error::Protocol(AeadCheck))`.\n1143\t/// C: `picoquic_aead_decrypt_generic`\n1144\tpub fn aead_decrypt_generic(\n1145\t    output: &mut [u8],\n1146\t    input: &[u8],\n1147\t    seq_num: u64,\n1148\t    auth_data: &[u8],\n1149\t    aead_ctx: Option<&dyn crate::tls::PacketKey>,\n1150\t) -> Result<usize, Error> {\n1151\t    let aead_ctx = aead_ctx.ok_or(Error::Protocol(\n1152\t        crate::errors::InternalError::AeadCheck as u64,\n1153\t    ))?;\n1154\t    let mut buf = input.to_vec();\n1155\t    aead_ctx.decrypt(seq_num, auth_data, &mut buf)?;\n1156\t    if buf.len() > output.len() {\n1157\t        return Err(Error::BufferTooSmall);\n1158\t    }\n1159\t    output[..buf.len()].copy_from_slice(&buf);\n1160\t    Ok(buf.len())\n1161\t}\n1162\t\n1163\t/// Encrypt `input` and write ciphertext + authentication tag to\n1164\t/// `output`.  Returns the total number of bytes written (plaintext\n1165\t/// length + tag length).\n1166\t/// C: `picoquic_aead_encrypt_generic`\n1167\tpub fn aead_encrypt_generic(\n1168\t    output: &mut [u8],\n1169\t    input: &[u8],\n1170\t    seq_num: u64,\n1171\t    auth_data: &[u8],\n1172\t    aead_ctx: &dyn crate::tls::PacketKey,\n1173\t) -> usize {\n1174\t    let mut buf = input.to_vec();\n1175\t    aead_ctx.encrypt(seq_num, auth_data, &mut buf);\n1176\t    let len = buf.len();\n1177\t    let copy_len = len.min(output.len());\n1178\t    output[..copy_len].copy_from_slice(&buf[..copy_len]);\n1179\t    len\n1180\t}\n1181\t\n1182\t// `aead_encrypt_mp` / `aead_decrypt_mp` fold into `PacketKey::encrypt_mp` /\n1183\t// `decrypt_mp` which XOR the path id into the nonce inside the implementor.\n1184\t// `aead_free` and `cipher_free` are gone -- `Drop` on the boxed trait object\n1185\t// replaces them.\n1186\t// `pn_iv_size` and `pn_encrypt` are gone -- header protection is in\n1187\t// `crate::header_protection`, exposed through `crate::tls::HeaderKey`.\n1188\t\n1189\t/// Return the integrity limit for the AEAD algorithm: the maximum number of\n1190\t/// failed decryption attempts before the key must be discarded (RFC 9001 §6.6).\n1191\t/// The C function read `algo->integrity_limit` from a `ptls_aead_context_t`;\n1192\t/// in Rust it delegates to [`crate::tls::PacketKey::integrity_limit`].\n1193\t/// C: `picoquic_aead_integrity_limit`\n1194\tpub fn aead_integrity_limit(aead_ctx: &dyn crate::tls::PacketKey) -> u64 {\n1195\t    aead_ctx.integrity_limit()\n1196\t}\n1197\t\n1198\t// ---------------------------------------------------------------------------\n1199\t// Initial-secret derivation.\n1200\t//\n1201\t// RFC 9001 fixes the initial-secret HKDF to SHA-256 (the salt is the\n1202\t// version-specific 20-byte constant).  Both helpers therefore commit\n1203\t// to SHA-256 internally — no cipher-suite parameter needed (the C\n1204\t// API took `&PtlsCipherSuite` purely for parity with later epoch\n1205\t// derivations).  `master_secret` / `client_secret` / `server_secret`\n1206\t// must be 32 byte