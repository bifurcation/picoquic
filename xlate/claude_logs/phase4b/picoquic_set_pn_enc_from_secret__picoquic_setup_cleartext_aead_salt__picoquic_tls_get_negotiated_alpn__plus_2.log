{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01A9BrKwnEwCKihJYvPd2YHz","type":"tool_result","content":"846\t// ---------------------------------------------------------------------------\n847\t// Master TLS context.\n848\t//\n849\t// In Phase 2 the C `*mut c_void tls_master_ctx` is replaced by\n850\t// `Quic.tls_client_config` / `tls_server_config` (boxed\n851\t// `DynClientConfig` / `DynServerConfig` trait objects defined in\n852\t// [`crate::tls`]).  Both lifecycle entry points install or\n853\t// release state on the QUIC context itself.\n854\t\n855\timpl Quic {\n856\t    /// Initialize this context's master TLS context.  Loads the\n857\t    /// certificate chain, the private key, the trusted-root bundle\n858\t    /// and the ticket-encryption key.  Any of the file-name / key\n859\t    /// parameters may be `NULL` in C (server-only, no roots, no\n860\t    /// ticket key); Rust models that with `Option<&str>` /\n861\t    /// `Option<&[u8]>`.  C: `master_tlscontext`.\n862\t    pub fn init_master_tls_context(\n863\t        &mut self,\n864\t        cert_file_name: Option<&str>,\n865\t        key_file_name: Option<&str>,\n866\t        cert_root_file_name: Option<&str>,\n867\t        ticket_key: Option<&[u8]>,\n868\t    ) -> Result<(), Error> {\n869\t        match (cert_file_name, key_file_name) {\n870\t            (Some(cert), Some(key)) => {\n871\t                get_certs_from_file(cert).ok_or(Error::InvalidFile)?;\n872\t                self.set_private_key_from_file(key)?;\n873\t            }\n874\t            (None, None) => {}\n875\t            _ => return Err(Error::InvalidArgument),\n876\t        }\n877\t\n878\t        if let Some(root) = cert_root_file_name {\n879\t            self.is_cert_store_not_empty = get_certs_from_file(root).is_some();\n880\t            if !self.is_cert_store_not_empty {\n881\t                return Err(Error::InvalidFile);\n882\t            }\n883\t        }\n884\t\n885\t        install_ticket_aead_contexts(self, ticket_key)\n886\t    }\n887\t\n888\t    /// Tear down the master TLS context installed by\n889\t    /// [`Quic::init_master_tls_context`].  C:\n890\t    /// `master_tlscontext_free`.\n891\t    pub fn free_master_tls_context(&mut self) {\n892\t        self.tls_client_config = None;\n893\t        self.tls_server_config = None;\n894\t    }\n895\t}\n896\t\n897\t// ---------------------------------------------------------------------------\n898\t// Per-connection TLS context.\n899\t//\n900\t// `tls_ctx_t` itself lives in `crypto_provider_api.rs`; this module\n901\t// just exposes the API surface that quic-core uses to drive it.\n902\t\n903\timpl Connection {\n904\t    /// Allocate a per-connection TLS context, attach it to this\n905\t    /// connection, and initialize the tls handshake-property slots.\n906\t    /// C: `tlscontext_create`.  C side returns 0 on success,\n907\t    /// `ERROR_TLS_SERVER_CON_WITHOUT_CERT` / `ERROR_MEMORY` / -1 on\n908\t    /// failure.\n909\t    pub fn create_tls_context(&mut self, quic: &mut Quic) -> Result<(), Error> {\n910\t        let version = connection_version(self);\n911\t        let transport_params = Vec::new();\n912\t        let session: Box<dyn crate::tls::Session> = if self.client_mode {\n913\t            if let Some(config) = quic.tls_client_config.as_ref() {\n914\t                let sni = self.sni.as_deref().unwrap_or(\"\");\n915\t                config\n916\t                    .start_session(version as u32, sni, &transport_params)\n917\t                    .map_err(|_| Error::Tls)?\n918\t            } else {\n919\t                Box::new(LocalSession::new(\n920\t                    true,\n921\t                    version.parameters().tls_prefix_label,\n922\t                ))\n923\t            }\n924\t        } else if let Some(config) = quic.tls_server_config.as_ref() {\n925\t            config\n926\t                .start_session(version as u32, &transport_params)\n927\t                .map_err(|_| Error::Tls)?\n928\t        } else {\n929\t            if quic.enforce_client_only {\n930\t                return Err(Error::Protocol(\n931\t                    InternalError::TlsServerConWithoutCert as u64,\n932\t                ));\n933\t            }\n934\t            Box::new(LocalSession::new(\n935\t                false,\n936\t                version.parameters().tls_prefix_label,\n937\t            ))\n938\t        };\n939\t\n940\t        self.tls_ctx = Some(session);\n941\t        self.tls_sendbuf.clear();\n942\t        self.app_secret_len = SHA256_SIZE;\n943\t        Ok(())\n944\t    }\n945\t\n946\t    /// Drop transient buffers (ALPN list, transport-parameter encode\n947\t    /// scratch) once the handshake is done.  C:\n948\t    /// `tlscontext_trim_after_handshake`.\n949\t    pub fn trim_tls_context_after_handshake(&mut self) {\n950\t        self.tls_sendbuf.clear();\n951\t        self.tls_sendbuf.shrink_to_fit();\n952\t    }\n953\t\n954\t    /// Forget the session ticket installed for a 0-RTT attempt.  C:\n955\t    /// `tlscontext_remove_ticket`.\n956\t    pub fn remove_tls_ticket(&mut self) {\n957\t        self.resumed_ticket_id = 0;\n958\t        self.psk_cipher_suite_id = 0;\n959\t        self.max_early_data_size = 0;\n960\t    }\n961\t}\n962\t\n963\t// `tls_context_free` is gone -- `Connection.tls_ctx` is now an\n964\t// `Option<Box<dyn Session>>`, and `Drop` on the boxed Session\n965\t// runs the backend's teardown automatically.  The C\n966\t// `client_mode` flag is unnecessary too: the `Session` impl\n967\t// knows whether it's a client or server session internally.\n968\t\n969\t// ---------------------------------------------------------------------------\n970\t// TLS stream processing.\n971\t\n972\timpl Connection {\n973\t    /// Drive the TLS handshake by feeding in any data buffered on\n974\t    /// the crypto streams and pushing produced data back out.\n975\t    /// Returns the number of bytes consumed (the C `int*\n976\t    /// data_consumed` out-parameter;