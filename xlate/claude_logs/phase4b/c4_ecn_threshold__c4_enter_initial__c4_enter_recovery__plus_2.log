ing_min_rtt; /* Rough estimate of min RTT, for buffer estimation */\n149\t    uint64_t alpha_1024_current;\n150\t    uint64_t alpha_1024_previous;\n151\t    uint64_t nb_packets_in_startup;\n152\t    uint64_t era_sequence; /* sequence number of first packet in era */\n153\t    uint64_t nb_cruise_left_before_push; /* Number of cruise periods required before push */\n154\t    uint64_t seed_cwin; /* Value of CWIN remembered from previous trials */\n155\t    uint64_t seed_rate; /* data rate remembered from seed cwin. */\n156\t\n157\t    int probe_level; /* Rate of probing, from 3.125% to 25% */\n158\t    int nb_eras_no_increase;\n159\t    uint64_t push_rate_old;\n160\t    uint64_t push_alpha;\n161\t\n162\t    uint64_t era_max_rtt;\n163\t    uint64_t era_min_rtt;\n164\t\n165\t    uint64_t delay_threshold;\n166\t    uint64_t recent_delay_excess;\n167\t\n168\t    uint64_t last_lost_packet_number; /* Used for computation of loss rate. Init to 0 */\n169\t    double smoothed_drop_rate; /* Average packet loss rate */\n170\t\n171\t    uint64_t ecn_alpha; /* average marking rate */\n172\t    uint64_t ecn_ect1; /* running total of ect1 marks */\n173\t    uint64_t ecn_ce; /* running total of ce marks */\n174\t    uint64_t ecn_threshold; /* Congestion notified if ecn_alpha > ecn_threshold */\n175\t\n176\t    unsigned int congestion_notified : 1;\n177\t    unsigned int push_was_not_limited : 1;\n178\t    unsigned int use_seed_cwin : 1;\n179\t    unsigned int initial_after_jitter : 1;\n180\t    unsigned int excess_ce_after_push : 1;\n181\t    /* Handling of options. */\n182\t    char const* option_string;\n183\t} c4_state_t;\n184\t\n185\tstatic void c4_enter_recovery(\n186\t    picoquic_path_t* path_x,\n187\t    c4_state_t* c4_state,\n188\t    c4_congestion_t c_mode);\n189\t\n190\tstatic void c4_enter_cruise(\n191\t    picoquic_path_t* path_x,\n192\t    c4_state_t* c4_state);\n193\t\n194\tstatic void c4_notify_congestion(\n195\t    picoquic_path_t* path_x,\n196\t    c4_state_t* c4_state,\n197\t    c4_congestion_t c_mode);\n198\t\n199\t#ifdef C4_WITH_LOGGING\n200\t/* Collect raw measurements for analysis */\n201\tvoid c4_logger(picoquic_path_t* path_x, uint64_t rate_measurement, c4_state_t* c4_state,\n202\t    picoquic_per_ack_state_t* ack_state, uint64_t beta, c4_congestion_t congestion_mode)\n203\t{\n204\t    picoquic_log_app_message(path_x->cnx,\n205\t        \"C4_rate, %\" PRIu64 \",%\" PRIu64 \",%\" PRIu64 \",%\" PRIu64 \",%\" PRIu64 \",%\" PRIu64 \",%d ,%\" PRIu64 \", %d, %d, %d, %d, %d, %d, %d\",\n206\t        rate_measurement, c4_state->nominal_rate,\n207\t        (ack_state == NULL) ? 0 : ack_state->nb_bytes_delivered_since_packet_sent,\n208\t        (ack_state == NULL) ? 0 : ack_state->rtt_measurement,\n209\t        (ack_state == NULL) ? 0 : ack_state->send_delay,\n210\t        c4_state->nominal_max_rtt, (int)c4_state->alg_state, path_x->bandwidth_estimate,\n211\t        (int)(path_x->bytes_in_transit),\n212\t        beta, congestion_mode, (int)c4_state->ecn_alpha,\n213\t        (int)(path_x->smoothed_rtt),\n214\t        (int)(path_x->rtt_variant),\n215\t        (int)c4_state->alpha_1024_previous);\n216\t}\n217\t#define C4_LOGGER(path_x, rate_measurement, c4_state, ack_state, beta, congestion_mode) \\\n218\t    c4_logger(path_x, rate_measurement, c4_state, ack_state, beta, congestion_mode)\n219\t#else\n220\t#define C4_LOGGER(path_x, rate_measurement, c4_state, ack_state, beta, congestion_mode)\n221\t#endif\n222\t\n223\t/* The sensitivity function provides a value from 0 to 1\n224\t* indicating how sensitive this flow is to congestion event.\n225\t* The idea is that flow consuming lots of resource should react\n226\t* faster than flow that consume little, leading eventually\n227\t* to good sharing of resource.\n228\t* \n229\t* The sensitivity will be directly translated into a packet\n230\t* loss detection threshold. We want that threshold to be very\n231\t* high at low data rates (lower than 50kB/s), about 2% at\n232\t* high data rate (matching the sensitivity of BBR), and \n233\t* about 5% at intermediate rates (1MBps), with slopes\n234\t* in between. We assume that the loss threshold is computed as:\n235\t*\n236\t* Threshold = 2% + (1-sensitivity)*50%\n237\t* \n238\t* This gives us the curve points:\n239\t* - 0 to 50kB/s: 0\n240\t* - 1MB/s: (1-0.03/0.5) = 0.94, approximate to 963/1024\n241\t* - 10MB/s: 1\n242\t*/\n243\t\n244\tstatic uint64_t c4_sensitivity_1024(c4_state_t* c4_state)"}]},"parent_tool_use_id":null,"session_id":"b0f1ef53-4722-4795-bf06-ae56109c98e1","uuid":"225cf109-081d-48cc-bb8e-93c41fa1e671","timestamp":"2026-05-07T13:48:20.974Z","tool_use_result":{"type":"text","file":{"filePath":"/Users/richbarn/Projects/picoquic/picoquic/c4.c","content":"\n#define PICOQUIC_CC_ALGO_NUMBER_C4 8\n#define C4_DELAY_THRESHOLD_MAX 25000\n#define MULT1024(c, v) (((v)*(c)) >> 10)\n#define C4_ALPHA_NEUTRAL_1024 1024 /* 100% */\n#define C4_ALPHA_RECOVER_1024 960 /* 93.75% */\n#define C4_ALPHA_RECOVER2_1024 896 /* 87.50% */\n#define C4_ALPHA_CRUISE_1024 1024 /* 100% */\n#define C4_ALPHA_PUSH_1024 1280 /* 125 % */\n#define C4_ALPHA_PUSH_LOW_1024 1088 /* 106.25 % */\n#define C4_ALPHA_PUSH_VERY_LOW_1024 1056 /* 103.125 % */\n#define C4_ALPHA_INITIAL 2048 /* 200% */\n#define C4_ALPHA_PREVIOUS_LOW 960 /* 93.75% */\n#define C4_BETA_LOSS_1024 256 /* 25%, 1/4th */\n#define C4_NB_PACKETS_BEFORE_LOSS 20\n#define C4_NB_CRUISE_BEFORE_PUSH 4\n#define C4_RTT_MARGIN_DELAY 15000\n#define C4_MAX_RTT_MIN 1000\n#define C4_MAX_JITTER 250000\n#define C4_ECN_SHIFT_G 4 /* g = 1/2^4, gain parameter for alpha EWMA */\n\n#define C4_PROBE_LEVEL_MAX 3\n#define C4_PROBE_LEVEL_DEFAULT 1\n\nuint64_t c4_push_rate_by_probe_level[C4_PROBE_LEVEL_MAX + 1] = {\n    C4_ALPHA_PUSH_VERY_LOW_1024, C4_ALPHA_PUSH_LOW_1024, C4_ALPHA_PUSH_1024, C4_ALPHA_PUSH_1024\n};\n\ntypedef enum {\n    c4_initial = 0,\n    c4_recovery,\n    c4_cruising,\n    c4_pushing\n} c4_alg_state_t;\n\n\ntypedef enum {\n    c4_congestion_none = 0,\n    c4_congestion_delay,\n    c4_congestion_ecn,\n    c4_congestion_loss\n} c4_congestion_t;\n\ntypedef struct st_c4_state_t {\n    c4_alg_state_t alg_state;\n    uint64_t nominal_rate; /* Control variable if not delay based. */\n    uint64_t nominal_max_rtt; /* Estimate of queue-free max RTT */\n    uint64_t initial_cwnd; /* CWND value used during Initial phase */\n    uint64_t running_min_rtt; /* Rough estimate of min RTT, for buffer estimation */\n    uint64_t alpha_1024_current;\n    uint64_t alpha_1024_previous;\n    uint64_t nb_packets_in_startup;\n    uint64_t era_sequence; /* sequence number of first packet in era */\n    uint64_t nb_cruise_left_before_push; /* Number of cruise periods required before push */\n    uint64_t seed_cwin; /* Value of CWIN remembered from previous trials */\n    uint64_t seed_rate; /* data rate remembered from seed cwin. */\n\n    int probe_level; /* Rate of probing, from 3.125% to 25% */\n    int nb_eras_no_increase;\n    uint64_t push_rate_old;\n    uint64_t push_alpha;\n\n    uint64_t era_max_rtt;\n    uint64_t era_min_rtt;\n\n    uint64_t delay_threshold;\n    uint64_t recent_delay_excess;\n\n    uint64_t last_lost_packet_number; /* Used for computation of loss rate. Init to 0 */\n    double smoothed_drop_rate; /* Average packet loss rate */\n\n    uint64_t ecn_alpha; /* average marking rate */\n    uint64_t ecn_ect1; /* running total of ect1 marks */\n    uint64_t ecn_ce; /* running total of ce marks */\n    uint64_t ecn_threshold; /* Congestion notified if ecn_alpha > ecn_threshold */\n\n    unsigned int congestion_notified : 1;\n    unsigned int push_was_not_limited : 1;\n    unsigned int use_seed_cwin : 1;\n    unsigned int initial_after_jitter : 1;\n    unsigned int excess_ce_after_push : 1;\n    /* Handling of options. */\n    char const* option_string;\n} c4_state_t;\n\nstatic void c4_enter_recovery(\n    picoquic_path_t* path_x,\n    c4_state_t* c4_state,\n    c4_congestion_t c_mode);\n\nstatic void c4_enter_cruise(\n    picoquic_path_t* path_x,\n    c4_state_t* c4_state);\n\nstatic void c4_notify_congestion(\n    picoquic_path_t* path_x,\n    c4_state_t* c4_state,\n    c4_congestion_t c_mode);\n\n#ifdef C4_WITH_LOGGING\n/* Collect raw measurements for analysis */\nvoid c4_logger(picoquic_path_t* path_x, uint64_t rate_measurement, c4_state_t* c4_state,\n    picoquic_per_ack_state_t* ack_state, uint64_t beta, c4_congestion_t congestion_mode)\n{\n    picoquic_log_app_message(path_x->cnx,\n        \"C4_rate, %\" PRIu64 \",%\" PRIu64 \",%\" PRIu64 \",%\" PRIu64 \",%\" PRIu64 \",%\" PRIu64 \",%d ,%\" PRIu64 \", %d, %d, %d, %d, %d, %d, %d\",\n        rate_measurement, c4_state->nominal_rate,\n        (ack_state == NULL) ? 0 : ack_state->nb_bytes_delivered_since_packet_sent,\n        (ack_state == NULL) ? 0 : ack_state->rtt_measurement,\n        (ack_state == NULL) ? 0 : ack_state->send_delay,\n        c4_state->nominal_max_rtt, (int)c4_state->alg_state, path_x->bandwidth_estimate,\n        (int)(path_x->bytes_in_transit),\n        beta, congestion_mode, (int)c4_state->ecn_alpha,\n        (int)(path_x->smoothed_rtt),\n        (int)(path_x->rtt_variant),\n        (int)c4_state->alpha_1024_previous);\n}\n#define C4_LOGGER(path_x, rate_measurement, c4_state, ack_state, beta, congestion_mode) \\\n    c4_logger(path_x, rate_measurement, c4_state, ack_state, beta, congestion_mode)\n#else\n#define C4_LOGGER(path_x, rate_measurement, c4_state, ack_state, beta, congestion_mode)\n#endif\n\n/* The sensitivity function provides a value from 0 to 1\n* indicating how sensitive this flow is to congestion event.\n* The idea is that flow consuming lots of resource should react\n* faster than flow that consume little, leading eventually\n* to good sharing of resource.\n* \n* The sensitivity will be directly translated into a packet\n* loss detection threshold. We want that threshold to be very\n* high at low data rates (lower than 50kB/s), about 2% at\n* high data rate (matching the sensitivity of BBR), and \n* about 5% at intermediate rates (1MBps), with slopes\n* in between. We assume that the loss threshold is computed as:\n*\n* Threshold = 2% + (1-sensitivity)*50%\n* \n* This gives us the curve points:\n* - 0 to 50kB/s: 0\n* - 1MB/s: (1-0.03/0.5) = 0.94, approximate to 963/1024\n* - 10MB/s: 1\n*/\n\nstatic uint64_t c4_sensitivity_1024(c4_state_t* c4_state)","numLines":145,"startLine":100,"totalLines":1140}}}
