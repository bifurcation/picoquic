{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_015e33YmzPtWkYTJrRuNrvVQ","type":"tool_result","content":"1\t//! Translation of `picoquic/c4.c` — C4 congestion control.\n2\t\n3\tuse crate::PacketContext;\n4\tuse crate::cc_common::{SMOOTHED_LOSS_FACTOR, SMOOTHED_LOSS_SCOPE};\n5\tuse crate::internal::{Connection, Path};\n6\t\n7\t// ---------------------------------------------------------------------------\n8\t// Constants from c4.c `#define`s.\n9\t\n10\tconst C4_ALPHA_PUSH_LOW_1024: u64 = 1088; // C: C4_ALPHA_PUSH_LOW_1024 (106.25%)\n11\t/// Gain parameter for the ECN alpha EWMA: g = 1/2^4.  C: `C4_ECN_SHIFT_G`.\n12\tconst C4_ECN_SHIFT_G: u32 = 4;\n13\t/// Maximum delay threshold in microseconds (25 ms).  C: `C4_DELAY_THRESHOLD_MAX`.\n14\tconst C4_DELAY_THRESHOLD_MAX: u64 = 25_000;\n15\t\n16\t// ---------------------------------------------------------------------------\n17\t// `MULT1024(c, v)` — fixed-point scale by c/1024.  C: `MULT1024`.\n18\t\n19\t#[inline]\n20\tfn mult1024(c: u64, v: u64) -> u64 {\n21\t    (v * c) >> 10\n22\t}\n23\t\n24\t// ---------------------------------------------------------------------------\n25\t// Algorithm-state enum.  C: `c4_alg_state_t`.\n26\t\n27\t#[derive(Debug, Copy, Clone, PartialEq, Eq, Default)]\n28\tpub enum C4AlgState {\n29\t    #[default]\n30\t    Initial = 0,\n31\t    Recovery,\n32\t    Cruising,\n33\t    Pushing,\n34\t}\n35\t\n36\t// ---------------------------------------------------------------------------\n37\t// Congestion-event discriminant.  C: `c4_congestion_t`.\n38\t\n39\t#[derive(Debug, Copy, Clone, PartialEq, Eq, Default)]\n40\tpub enum C4Congestion {\n41\t    #[default]\n42\t    None = 0,\n43\t    Delay,\n44\t    Ecn,\n45\t    Loss,\n46\t}\n47\t\n48\t// ---------------------------------------------------------------------------\n49\t// C4 algorithm state.  C: `c4_state_t` (picoquic/c4.c:143).\n50\t//\n51\t// Type deviations from C:\n52\t//   * single-bit `unsigned int x : 1` bitfields → `bool`\n53\t//   * `const char* option_string` → `Option<String>` (owned copy)\n54\t\n55\tpub struct C4State {\n56\t    pub alg_state: C4AlgState,\n57\t    pub nominal_rate: u64,\n58\t    pub nominal_max_rtt: u64,\n59\t    pub initial_cwnd: u64,\n60\t    pub running_min_rtt: u64,\n61\t    pub alpha_1024_current: u64,\n62\t    pub alpha_1024_previous: u64,\n63\t    pub nb_packets_in_startup: u64,\n64\t    pub era_sequence: u64,\n65\t    pub nb_cruise_left_before_push: u64,\n66\t    pub seed_cwin: u64,\n67\t    pub seed_rate: u64,\n68\t    pub probe_level: i32,\n69\t    pub nb_eras_no_increase: i32,\n70\t    pub push_rate_old: u64,\n71\t    pub push_alpha: u64,\n72\t    pub era_max_rtt: u64,\n73\t    pub era_min_rtt: u64,\n74\t    pub delay_threshold: u64,\n75\t    pub recent_delay_excess: u64,\n76\t    pub last_lost_packet_number: u64,\n77\t    pub smoothed_drop_rate: f64,\n78\t    pub ecn_alpha: u64,\n79\t    pub ecn_ect1: u64,\n80\t    pub ecn_ce: u64,\n81\t    pub ecn_threshold: u64,\n82\t    pub congestion_notified: bool,\n83\t    pub push_was_not_limited: bool,\n84\t    pub use_seed_cwin: bool,\n85\t    pub initial_after_jitter: bool,\n86\t    pub excess_ce_after_push: bool,\n87\t    pub option_string: Option<String>,\n88\t}\n89\t\n90\timpl C4State {\n91\t    /// C: `c4_sensitivity_1024` (picoquic/c4.c:244)\n92\t    ///\n93\t    /// Fixed-point sensitivity in [0, 1024] scaled to `nominal_rate`:\n94\t    /// 0 below 50 kbps, 1024 above 10 Mbps, linearly interpolated in between.\n95\t    fn sensitivity_1024(&self) -> u64 {\n96\t        if self.nominal_rate < 50_000 {\n97\t            0\n98\t        } else if self.nominal_rate > 10_000_000 {\n99\t            1024\n100\t        } else if self.nominal_rate < 1_000_000 {\n101\t            (self.nominal_rate - 50_000) * 963 / 950_000\n102\t        } else {\n103\t            963 + ((self.nominal_rate - 1_000_000) * 61 / 9_000_000)\n104\t        }\n105\t    }\n106\t\n107\t    /// C: `c4_growth_evaluate` (picoquic/c4.c:429)\n108\t    ///\n109\t    /// Returns `true` when the previous era produced meaningful throughput\n110\t    /// growth.  If `push_alpha` was large enough to measure reliably, growth\n111\t    /// is defined as exceeding the alpha-scaled old rate; otherwise it falls\n112\t    /// back to a simple rate comparison guarded by the absence of congestion.\n113\t    fn growth_evaluate(&self) -> bool {\n114\t        if self.push_alpha > C4_ALPHA_PUSH_LOW_1024 {\n115\t            let target_rate =\n116\t                (3 * self.push_rate_old + mult1024(self.push_alpha, self.push_rate_old)) / 4;\n117\t            self.nominal_rate > target_rate\n118\t        } else {\n119\t            self.nominal_rate > self.push_rate_old && !self.congestion_notified\n120\t        }\n121\t    }\n122\t\n123\t    /// C: `c4_growth_reset` (picoquic/c4.c:449)\n124\t    fn growth_reset(&mut self) {\n125\t        self.congestion_notified = false;\n126\t        self.push_was_not_limited = false;\n127\t        self.push_rate_old = self.nominal_rate;\n128\t        // push_alpha is reset to current alpha here; caller sets it to correct\n129\t        // value when entering push state.\n130\t        self.push_alpha = self.alpha_1024_current;\n131\t    }\n132\t\n133\t    /// C: `c4_set_options` (picoquic/c4.c:499)\n134\t    ///\n135\t    /// Parses `option_string` for recognized option characters.  No option\n136\t    /// characters are currently defined; the loop exits on the first unknown.\n137\t    fn set_options(&mut self) {\n138\t        if let Some(s) = self.option_string.as_deref() {\n139\t            // No recognized option characters are currently defined.  The C switch\n140\t            // hits `default: ended = 1` for every character, so the loop exits\n141\t            // immediately after consuming the first character.\n142\t            let _ = s.chars().next();\n143\t        }\n144\t    }\n145\t\n146\t    /// C: `c4_seed_cwin` (picoquic/c4.c:527)\n147\t    pub fn seed_cwin(&mut self, bytes_in_flight: u64) {\n148\t        if self.alg_state == C4AlgState::Initial {\n149\t            self.use_seed_cwin = true;\n150\t            self.seed_cwin = bytes_in_flight;\n151\t        }\n152\t    }\n153\t\n154\t    /// C: `c4_observe` (picoquic/c4.c:1121)\n155\t    ///\n156\t    /// Returns `(cc_state, cc_param)`: the algorithm-state discriminant and\n157\t    /// `nominal_max_rtt`, matching the C convention of filling two `uint64_t*`\n158\t    /// out-params.\n159\t    pub fn observe(&self) -> (u64, u64) {\n160\t        (self.alg_state as u64, self.nominal_max_rtt)\n161\t    }\n162\t\n163\t    /// C: `c4_update_loss_rate` (picoquic/c4.c:301)\n164\t    ///\n165\t    /// Advances the smoothed drop-rate EMA to account for packets up to and\n166\t    /// including `lost_packet_number`.  Each step between the last recorded\n167\t    /// loss and the new one decays the rate; the final step adds one loss\n168\t    /// event.  Steps beyond `SMOOTHED_LOSS_SCOPE` behind the new number are\n169\t    /// skipped to cap the decay loop.\n170\t    pub fn update_loss_rate(&mut self, lost_packet_number: u64) {\n171\t        let mut next_number = self.last_lost_packet_number;\n172\t\n173\t        if lost_packet_number > next_number {\n174\t            if next_number + SMOOTHED_LOSS_SCOPE < lost_packet_number {\n175\t                next_number = lost_packet_number - SMOOTHED_LOSS_SCOPE;\n176\t            }\n177\t\n178\t            while next_number < lost_packet_number {\n179\t                self.smoothed_drop_rate *= 1.0 - SMOOTHED_LOSS_FACTOR;\n180\t                next_number += 1;\n181\t            }\n182\t\n183\t            self.smoothed_drop_rate += (1.0 - self.smoothed_drop_rate) * SMOOTHED_LOSS_FACTOR;\n184\t            self.last_lost_packet_number = lost_packet_number;\n185\t        }\n186\t    }\n187\t\n188\t    /// ECN alpha EWMA core.  C: `c4_update_ecn_alpha` (picoquic/c4.c:321) body.\n189\t    ///\n190\t    /// Takes the current totals directly so the logic can be tested without\n191\t    /// constructing `Path` / `Connection`.  Called by `update_ecn_alpha`.\n192\t    fn ecn_alpha_update_counts(&mut self, ecn_ect1_remote: u64, ecn_ce_remote: u64) {\n193\t        let delta_ect1 = ecn_ect1_remote as i64 - self.ecn_ect1 as i64;\n194\t        let delta_ce = ecn_ce_remote as i64 - self.ecn_ce as i64;\n195\t\n196\t        self.ecn_ect1 = ecn_ect1_remote;\n197\t        self.ecn_ce = ecn_ce_remote;\n198\t\n199\t        if delta_ce > 0 || delta_ect1 > 0 {\n200\t            let sum = delta_ce + delta_ect1;\n201\t            let frac: u64 = if sum > 0 {\n202\t                ((delta_ce * 1024) / sum) as u64\n203\t            } else {\n204\t                0\n205\t            };\n206\t\n207\t            if frac > self.ecn_alpha && frac >= 512 {\n208\t                self.ecn_alpha = frac;\n209\t            } else {\n210\t                // EWMA: alpha = alpha*(1 - 1/2^shift) + frac*(1/2^shift)\n211\t                let alpha_shifted = (self.ecn_alpha << C4_ECN_SHIFT_G) - self.ecn_alpha + frac;\n212\t                self.ecn_alpha = alpha_shifted >> C4_ECN_SHIFT_G;\n213\t            }\n214\t        }\n215\t    }\n216\t\n217\t    /// C: `c4_delay_threshold` (picoquic/c4.c:266)\n218\t    ///\n219\t    /// Compute the delay threshold for declaring congestion.  Sensitivity\n220\t    /// is 0 at ≤ 50 kbps, 1024 at ≥ 10 Mbps, and linearly interpolated\n221\t    /// in between.  The resulting fraction scales `nominal_max_rtt`, giving\n222\t    /// a threshold in [64/1024 × rtt, 260/1024 × rtt], capped at\n223\t    /// [`C4_DELAY_THRESHOLD_MAX`] (25 ms).\n224\t    pub fn delay_threshold(&self) -> u64 {\n225\t        let sensitivity = self.sensitivity_1024();\n226\t        let fraction = 64 + mult1024(1024 - sensitivity, 196);\n227\t        let delay = mult1024(fraction, self.nominal_max_rtt);\n228\t        delay.min(C4_DELAY_THRESHOLD_MAX)\n229\t    }\n230\t\n231\t    /// C: `c4_update_ecn_alpha` (picoquic/c4.c:321)\n232\t    ///\n233\t    /// Selects the right packet context (path-scoped under multipath;\n234\t    /// connection application context otherwise) and delegates to\n235\t    /// `ecn_alpha_update_counts`.\n236\t    #[allow(dead_code)]\n237\t    pub(crate) fn update_ecn_alpha(&mut self, path_x: &Path, connection: &Connection) {\n238\t        let pkt_ctx = if connection.is_multipath_enabled {\n239\t            &path_x.pkt_ctx\n240\t        } else {\n241\t            &connection.pkt_ctx[PacketContext::Application as usize]\n242\t        };\n243\t        self.ecn_alpha_update_counts(pkt_ctx.ecn_ect1_total_remote, pkt_ctx.ecn_ce_total_remote);\n244\t    }\n245\t}\n246\t\n247\t#[cfg(test)]\n248\tmod tests {\n249\t    use super::*;\n250\t\n251\t    fn make_state() -> C4State {\n252\t        C4State {\n253\t            alg_state: C4AlgState::default(),\n254\t            nominal_rate: 0,\n255\t            nominal_max_rtt: 0,\n256\t            initial_cwnd: 0,\n257\t            running_min_rtt: 0,\n258\t            alpha_1024_current: 0,\n259\t            alpha_1024_previous: 0,\n260\t            nb_packets_in_startup: 0,\n261\t            era_sequence: 0,\n262\t            nb_cruise_left_before_push: 0,\n263\t            seed_cwin: 0,\n264\t            seed_rate: 0,\n265\t            probe_level: 0,\n266\t            nb_eras_no_increase: 0,\n267\t            push_rate_old: 0,\n268\t            push_alpha: 0,\n269\t            era_max_rtt: 0,\n270\t            era_min_rtt: 0,\n271\t            delay_threshold: 0,\n272\t            recent_delay_excess: 0,\n273\t            last_lost_packet_number: 0,\n274\t            smoothed_drop_rate: 0.0,\n275\t            ecn_alpha: 0,\n276\t            ecn_ect1: 0,\n277\t            ecn_ce: 0,\n278\t            ecn_threshold: 0,\n279\t            congestion_notified: false,\n280\t            push_was_not_limited: false,\n281\t            use_seed_cwin: false,\n282\t            initial_after_jitter: false,\n283\t            excess_ce_after_push: false,\n284\t            option_string: None,\n285\t        }\n286\t    }\n287\t\n288\t    #[test]\n289\t    fn growth_evaluate_high_alpha_growing() {\n290\t        let mut s = make_state();\n291\t        // push_alpha > 1088, push_rate_old = 1000, nominal_rate must exceed:\n292\t        // target = (3*1000 + MULT1024(1280, 1000)) / 4 = (3000 + 1250) / 4 = 1062\n293\t        s.push_alpha = 1280;\n294\t        s.push_rate_old = 1000;\n295\t        s.nominal_rate = 1100;\n296\t        assert!(s.growth_evaluate());\n297\t    }\n298\t\n299\t    #[test]\n300\t    fn growth_evaluate_high_alpha_not_growing() {\n301\t        let mut s = make_state();\n302\t        s.push_alpha = 1280;\n303\t        s.push_rate_old = 1000;\n304\t        s.nominal_rate = 1000; // equal to target_rate or below\n305\t        assert!(!s.growth_evaluate());\n306\t    }\n307\t\n308\t    #[test]\n309\t    fn growth_evaluate_low_alpha_growing_no_congestion() {\n310\t        let mut s = make_state();\n311\t        s.push_alpha = 1000; // <= 1088\n312\t        s.push_rate_old = 800;\n313\t        s.nominal_rate = 900;\n314\t        s.congestion_notified = false;\n315\t        assert!(s.growth_evaluate());\n316\t    }\n317\t\n318\t    #[test]\n319\t    fn growth_evaluate_low_alpha_congestion_blocks_growth() {\n320\t        let mut s = make_state();\n321\t        s.push_alpha = 1000;\n322\t        s.push_rate_old = 800;\n323\t        s.nominal_rate = 900;\n324\t        s.congestion_notified = true;\n325\t        assert!(!s.growth_evaluate());\n326\t    }\n327\t\n328\t    // --- sensitivity_1024 ---\n329\t\n330\t    #[test]\n331\t    fn sensitivity_below_50k() {\n332\t        let mut s = make_state();\n333\t        s.nominal_rate = 49_999;\n334\t        assert_eq!(s.sensitivity_1024(), 0);\n335\t    }\n336\t\n337\t    #[test]\n338\t    fn sensitivity_at_50k_boundary() {\n339\t        let mut s = make_state();\n340\t        s.nominal_rate = 50_000;\n341\t        // (50000 - 50000) * 963 / 950000 == 0\n342\t        assert_eq!(s.sensitivity_1024(), 0);\n343\t    }\n344\t\n345\t    #[test]\n346\t    fn sensitivity_midrange() {\n347\t        let mut s = make_state();\n348\t        s.nominal_rate = 500_000;\n349\t        // (500000 - 50000) * 963 / 950000 = 450000 * 963 / 950000 = 456\n350\t        assert_eq!(s.sensitivity_1024(), 456);\n351\t    }\n352\t\n353\t    #[test]\n354\t    fn sensitivity_at_1mbps() {\n355\t        let mut s = make_state();\n356\t        s.nominal_rate = 1_000_000;\n357\t        // hits else branch: 963 + (0 * 61 / 9000000) = 963\n358\t        assert_eq!(s.sensitivity_1024(), 963);\n359\t    }\n360\t\n361\t    #[test]\n362\t    fn sensitivity_at_10mbps() {\n363\t        let mut s = make_state();\n364\t        s.nominal_rate = 10_000_000;\n365\t        // 963 + (9000000 * 61 / 9000000) = 963 + 61 = 1024\n366\t        assert_eq!(s.sensitivity_1024(), 1024);\n367\t    }\n368\t\n369\t    #[test]\n370\t    fn sensitivity_above_10mbps() {\n371\t        let mut s = make_state();\n372\t        s.nominal_rate = 10_000_001;\n373\t        assert_eq!(s.sensitivity_1024(), 1024);\n374\t    }\n375\t\n376\t    // --- growth_reset ---\n377\t\n378\t    #[test]\n379\t    fn growth_reset_clears_flags_and_snapshots() {\n380\t        let mut s = make_state();\n381\t        s.nominal_rate = 5_000_000;\n382\t        s.alpha_1024_current = 1100;\n383\t        s.congestion_notified = true;\n384\t        s.push_was_not_limited = true;\n385\t        s.push_rate_old = 1_000_000;\n386\t        s.push_alpha = 900;\n387\t\n388\t        s.growth_reset();\n389\t\n390\t        assert!(!s.congestion_notified);\n391\t        assert!(!s.push_was_not_limited);\n392\t        assert_eq!(s.push_rate_old, 5_000_000);\n393\t        assert_eq!(s.push_alpha, 1100);\n394\t    }\n395\t\n396\t    // --- set_options ---\n397\t\n398\t    #[test]\n399\t    fn set_options_none_is_noop() {\n400\t        let mut s = make_state();\n401\t        s.option_string = None;\n402\t        s.set_options(); // must not panic\n403\t    }\n404\t\n405\t    #[test]\n406\t    fn set_options_unknown_chars_are_noop() {\n407\t        let mut s = make_state();\n408\t        s.option_string = Some(\"xyz\".to_owned());\n409\t        s.set_options(); // must not panic; no state change expected\n410\t    }\n411\t\n412\t    // --- seed_cwin ---\n413\t\n414\t    #[test]\n415\t    fn seed_cwin_sets_when_initial() {\n416\t        let mut s = make_state();\n417\t        s.alg_state = C4AlgState::Initial;\n418\t        s.seed_cwin(123_456);\n419\t        assert!(s.use_seed_cwin);\n420\t        assert_eq!(s.seed_cwin, 123_456);\n421\t    }\n422\t\n423\t    #[test]\n424\t    fn seed_cwin_ignored_when_not_initial() {\n425\t        let mut s = make_state();\n426\t        s.alg_state = C4AlgState::Cruising;\n427\t        s.seed_cwin(123_456);\n428\t        assert!(!s.use_seed_cwin);\n429\t        assert_eq!(s.seed_cwin, 0);\n430\t    }\n431\t\n432\t    // --- observe ---\n433\t\n434\t    #[test]\n435\t    fn observe_returns_state_and_rtt() {\n436\t        let mut s = make_state();\n437\t        s.alg_state = C4AlgState::Pushing;\n438\t        s.nominal_max_rtt = 42_000;\n439\t        let (cc_state, cc_param) = s.observe();\n440\t        assert_eq!(cc_state, C4AlgState::Pushing as u64);\n441\t        assert_eq!(cc_param, 42_000);\n442\t    }\n443\t\n444\t    #[test]\n445\t    fn observe_initial_state() {\n446\t        let s = make_state();\n447\t        let (cc_state, cc_param) = s.observe();\n448\t        assert_eq!(cc_state, 0); // C4AlgState::Initial == 0\n449\t        assert_eq!(cc_param, 0);\n450\t    }\n451\t\n452\t    // --- update_loss_rate ---\n453\t\n454\t    #[test]\n455\t    fn loss_rate_no_update_when_not_newer() {\n456\t        let mut s = make_state();\n457\t        s.last_lost_packet_number = 100;\n458\t        s.smoothed_drop_rate = 0.5;\n459\t        s.update_loss_rate(100); // same number → no change\n460\t        assert_eq!(s.smoothed_drop_rate, 0.5);\n461\t        assert_eq!(s.last_lost_packet_number, 100);\n462\t    }\n463\t\n464\t    #[test]\n465\t    fn loss_rate_single_step() {\n466\t        let mut s = make_state();\n467\t        s.last_lost_packet_number = 0;\n468\t        s.smoothed_drop_rate = 0.0;\n469\t        s.update_loss_rate(1);\n470\t        // one decay step: rate *= (1 - 1/16) = 0  (was 0)\n471\t        // then: rate += (1 - 0) * (1/16) = 1/16\n472\t        assert!((s.smoothed_drop_rate - 1.0 / 16.0).abs() < 1e-12);\n473\t        assert_eq!(s.last_lost_packet_number, 1);\n474\t    }\n475\t\n476\t    #[test]\n477\t    fn loss_rate_caps_scope() {\n478\t        let mut s = make_state();\n479\t        // Gap far exceeds SMOOTHED_LOSS_SCOPE=32; loop should start at\n480\t        // lost_packet_number - 32 so only 32 decays happen, not 1000.\n481\t        s.last_lost_packet_number = 0;\n482\t        s.smoothed_drop_rate = 1.0;\n483\t        s.update_loss_rate(1000);\n484\t        // After 32 decay steps: 1.0 * (15/16)^32 ≈ 0.1209\n485\t        // Then one more step adding the loss event:\n486\t        // result = decayed + (1 - decayed) * (1/16)\n487\t        let expected_decayed = (15.0f64 / 16.0).powi(32);\n488\t        let expected = expected_decayed + (1.0 - expected_decayed) * (1.0 / 16.0);\n489\t        assert!((s.smoothed_drop_rate - expected).abs() < 1e-9);\n490\t        assert_eq!(s.last_lost_packet_number, 1000);\n491\t    }\n492\t\n493\t    // --- ecn_alpha_update_counts ---\n494\t\n495\t    #[test]\n496\t    fn ecn_alpha_no_update_when_both_zero_delta() {\n497\t        let mut s = make_state();\n498\t        s.ecn_alpha = 500;\n499\t        s.ecn_ect1 = 100;\n500\t        s.ecn_ce = 50;\n501\t        // same totals → no delta → alpha unchanged\n502\t        s.ecn_alpha_update_counts(100, 50);\n503\t        assert_eq!(s.ecn_alpha, 500);\n504\t    }\n505\t\n506\t    #[test]\n507\t    fn ecn_alpha_fast_path_large_frac() {\n508\t        let mut s = make_state();\n509\t        s.ecn_alpha = 400;\n510\t        s.ecn_ect1 = 0;\n511\t        s.ecn_ce = 0;\n512\t        // delta_ce = 600, delta_ect1 = 400 → frac = 600*1024/(600+400) = 614\n513\t        // frac (614) > alpha (400) and frac >= 512 → fast path: alpha = frac\n514\t        s.ecn_alpha_update_counts(400, 600);\n515\t        assert_eq!(s.ecn_alpha, 614);\n516\t    }\n517\t\n518\t    #[test]\n519\t    fn ecn_alpha_ewma_path() {\n520\t        let mut s = make_state();\n521\t        s.ecn_alpha = 256;\n522\t        s.ecn_ect1 = 0;\n523\t        s.ecn_ce = 0;\n524\t        // delta_ce = 100, delta_ect1 = 900 → frac = 100*1024/1000 = 102\n525\t        // frac (102) < alpha (256) → EWMA path\n526\t        // alpha_shifted = 256 * 16 - 256 + 102 = 256*15 + 102 = 3840 + 102 = 3942\n527\t        // new alpha = 3942 / 16 = 246\n528\t        s.ecn_alpha_update_counts(900, 100);\n529\t        assert_eq!(s.ecn_alpha, 246);\n530\t    }\n531\t\n532\t    #[test]\n533\t    fn ecn_alpha_only_ect1_delta() {\n534\t        let mut s = make_state();\n535\t        s.ecn_alpha = 200;\n536\t        s.ecn_ect1 = 0;\n537\t        s.ecn_ce = 0;\n538\t        // delta_ect1 = 500, delta_ce = 0 → frac = 0\n539\t        // frac (0) < alpha (200) → EWMA:\n540\t        //   alpha_shifted = 200 << 4 = 3200; 3200 - 200 = 3000; 3000 + 0 = 3000\n541\t        //   new alpha = 3000 >> 4 = 187\n542\t        s.ecn_alpha_update_counts(500, 0);\n543\t        assert_eq!(s.ecn_alpha, 187);\n544\t    }\n545\t}\n546\t"}]},"parent_tool_use_id":null,"session_id":"b0f1ef53-4722-4795-bf06-ae56109c98e1","uuid":"049cf79b-6ffc-4867-8e02-2be9098a05dc","timestamp":"2026-05-07T13:48:11.609Z","tool_use_result":{"type":"text","file":{"filePath":"/Users/richbarn/Projects/picoquic/rs/fq/src/c4.rs","content":"//! Translation of `picoquic/c4.c` — C4 congestion control.\n\nuse crate::PacketContext;\nuse crate::cc_common::{SMOOTHED_LOSS_FACTOR, SMOOTHED_LOSS_SCOPE};\nuse crate::internal::{Connection, Path};\n\n// ---------------------------------------------------------------------------\n// Constants from c4.c `#define`s.\n\nconst C4_ALPHA_PUSH_LOW_1024: u64 = 1088; // C: C4_ALPHA_PUSH_LOW_1024 (106.25%)\n/// Gain parameter for the ECN alpha EWMA: g = 1/2^4.  C: `C4_ECN_SHIFT_G`.\nconst C4_ECN_SHIFT_G: u32 = 4;\n/// Maximum delay threshold in microseconds (25 ms).  C: `C4_DELAY_THRESHOLD_MAX`.\nconst C4_DELAY_THRESHOLD_MAX: u64 = 25_000;\n\n// ---------------------------------------------------------------------------\n// `MULT1024(c, v)` — fixed-point scale by c/1024.  C: `MULT1024`.\n\n#[inline]\nfn mult1024(c: u64, v: u64) -> u64 {\n    (v * c) >> 10\n}\n\n// ---------------------------------------------------------------------------\n// Algorithm-state enum.  C: `c4_alg_state_t`.\n\n#[derive(Debug, Copy, Clone, PartialEq, Eq, Default)]\npub enum C4AlgState {\n    #[default]\n    Initial = 0,\n    Recovery,\n    Cruising,\n    Pushing,\n}\n\n// ---------------------------------------------------------------------------\n// Congestion-event discriminant.  C: `c4_congestion_t`.\n\n#[derive(Debug, Copy, Clone, PartialEq, Eq, Default)]\npub enum C4Congestion {\n    #[default]\n    None = 0,\n    Delay,\n    Ecn,\n    Loss,\n}\n\n// ---------------------------------------------------------------------------\n// C4 algorithm state.  C: `c4_state_t` (picoquic/c4.c:143).\n//\n// Type deviations from C:\n//   * single-bit `unsigned int x : 1` bitfields → `bool`\n//   * `const char* option_string` → `Option<String>` (owned copy)\n\npub struct C4State {\n    pub alg_state: C4AlgState,\n    pub nominal_rate: u64,\n    pub nominal_max_rtt: u64,\n    pub initial_cwnd: u64,\n    pub running_min_rtt: u64,\n    pub alpha_1024_current: u64,\n    pub alpha_1024_previous: u64,\n    pub nb_packets_in_startup: u64,\n    pub era_sequence: u64,\n    pub nb_cruise_left_before_push: u64,\n    pub seed_cwin: u64,\n    pub seed_rate: u64,\n    pub probe_level: i32,\n    pub nb_eras_no_increase: i32,\n    pub push_rate_old: u64,\n    pub push_alpha: u64,\n    pub era_max_rtt: u64,\n    pub era_min_rtt: u64,\n    pub delay_threshold: u64,\n    pub recent_delay_excess: u64,\n    pub last_lost_packet_number: u64,\n    pub smoothed_drop_rate: f64,\n    pub ecn_alpha: u64,\n    pub ecn_ect1: u64,\n    pub ecn_ce: u64,\n    pub ecn_threshold: u64,\n    pub congestion_notified: bool,\n    pub push_was_not_limited: bool,\n    pub use_seed_cwin: bool,\n    pub initial_after_jitter: bool,\n    pub excess_ce_after_push: bool,\n    pub option_string: Option<String>,\n}\n\nimpl C4State {\n    /// C: `c4_sensitivity_1024` (picoquic/c4.c:244)\n    ///\n    /// Fixed-point sensitivity in [0, 1024] scaled to `nominal_rate`:\n    /// 0 below 50 kbps, 1024 above 10 Mbps, linearly interpolated in between.\n    fn sensitivity_1024(&self) -> u64 {\n        if self.nominal_rate < 50_000 {\n            0\n        } else if self.nominal_rate > 10_000_000 {\n            1024\n        } else if self.nominal_rate < 1_000_000 {\n            (self.nominal_rate - 50_000) * 963 / 950_000\n        } else {\n            963 + ((self.nominal_rate - 1_000_000) * 61 / 9_000_000)\n        }\n    }\n\n    /// C: `c4_growth_evaluate` (picoquic/c4.c:429)\n    ///\n    /// Returns `true` when the previous era produced meaningful throughput\n    /// growth.  If `push_alpha` was large enough to measure reliably, growth\n    /// is defined as exceeding the alpha-scaled old rate; otherwise it falls\n    /// back to a simple rate comparison guarded by the absence of congestion.\n    fn growth_evaluate(&self) -> bool {\n        if self.push_alpha > C4_ALPHA_PUSH_LOW_1024 {\n            let target_rate =\n                (3 * self.push_rate_old + mult1024(self.push_alpha, self.push_rate_old)) / 4;\n            self.nominal_rate > target_rate\n        } else {\n            self.nominal_rate > self.push_rate_old && !self.congestion_notified\n        }\n    }\n\n    /// C: `c4_growth_reset` (picoquic/c4.c:449)\n    fn growth_reset(&mut self) {\n        self.congestion_notified = false;\n        self.push_was_not_limited = false;\n        self.push_rate_old = self.nominal_rate;\n        // push_alpha is reset to current alpha here; caller sets it to correct\n        // value when entering push state.\n        self.push_alpha = self.alpha_1024_current;\n    }\n\n    /// C: `c4_set_options` (picoquic/c4.c:499)\n    ///\n    /// Parses `option_string` for recognized option characters.  No option\n    /// characters are currently defined; the loop exits on the first unknown.\n    fn set_options(&mut self) {\n        if let Some(s) = self.option_string.as_deref() {\n            // No recognized option characters are currently defined.  The C switch\n            // hits `default: ended = 1` for every character, so the loop exits\n            // immediately after consuming the first character.\n            let _ = s.chars().next();\n        }\n    }\n\n    /// C: `c4_seed_cwin` (picoquic/c4.c:527)\n    pub fn seed_cwin(&mut self, bytes_in_flight: u64) {\n        if self.alg_state == C4AlgState::Initial {\n            self.use_seed_cwin = true;\n            self.seed_cwin = bytes_in_flight;\n        }\n    }\n\n    /// C: `c4_observe` (picoquic/c4.c:1121)\n    ///\n    /// Returns `(cc_state, cc_param)`: the algorithm-state discriminant and\n    /// `nominal_max_rtt`, matching the C convention of filling two `uint64_t*`\n    /// out-params.\n    pub fn observe(&self) -> (u64, u64) {\n        (self.alg_state as u64, self.nominal_max_rtt)\n    }\n\n    /// C: `c4_update_loss_rate` (picoquic/c4.c:301)\n    ///\n    /// Advances the smoothed drop-rate EMA to account for packets up to and\n    /// including `lost_packet_number`.  Each step between the last recorded\n    /// loss and the new one decays the rate; the final step adds one loss\n    /// event.  Steps beyond `SMOOTHED_LOSS_SCOPE` behind the new number are\n    /// skipped to cap the decay loop.\n    pub fn update_loss_rate(&mut self, lost_packet_number: u64) {\n        let mut next_number = self.last_lost_packet_number;\n\n        if lost_packet_number > next_number {\n            if next_number + SMOOTHED_LOSS_SCOPE < lost_packet_number {\n                next_number = lost_packet_number - SMOOTHED_LOSS_SCOPE;\n            }\n\n            while next_number < lost_packet_number {\n                self.smoothed_drop_rate *= 1.0 - SMOOTHED_LOSS_FACTOR;\n                next_number += 1;\n            }\n\n            self.smoothed_drop_rate += (1.0 - self.smoothed_drop_rate) * SMOOTHED_LOSS_FACTOR;\n            self.last_lost_packet_number = lost_packet_number;\n        }\n    }\n\n    /// ECN alpha EWMA core.  C: `c4_update_ecn_alpha` (picoquic/c4.c:321) body.\n    ///\n    /// Takes the current totals directly so the logic can be tested without\n    /// constructing `Path` / `Connection`.  Called by `update_ecn_alpha`.\n    fn ecn_alpha_update_counts(&mut self, ecn_ect1_remote: u64, ecn_ce_remote: u64) {\n        let delta_ect1 = ecn_ect1_remote as i64 - self.ecn_ect1 as i64;\n        let delta_ce = ecn_ce_remote as i64 - self.ecn_ce as i64;\n\n        self.ecn_ect1 = ecn_ect1_remote;\n        self.ecn_ce = ecn_ce_remote;\n\n        if delta_ce > 0 || delta_ect1 > 0 {\n            let sum = delta_ce + delta_ect1;\n            let frac: u64 = if sum > 0 {\n                ((delta_ce * 1024) / sum) as u64\n            } else {\n                0\n            };\n\n            if frac > self.ecn_alpha && frac >= 512 {\n                self.ecn_alpha = frac;\n            } else {\n                // EWMA: alpha = alpha*(1 - 1/2^shift) + frac*(1/2^shift)\n                let alpha_shifted = (self.ecn_alpha << C4_ECN_SHIFT_G) - self.ecn_alpha + frac;\n                self.ecn_alpha = alpha_shifted >> C4_ECN_SHIFT_G;\n            }\n        }\n    }\n\n    /// C: `c4_delay_threshold` (picoquic/c4.c:266)\n    ///\n    /// Compute the delay threshold for declaring congestion.  Sensitivity\n    /// is 0 at ≤ 50 kbps, 1024 at ≥ 10 Mbps, and linearly interpolated\n    /// in between.  The resulting fraction scales `nominal_max_rtt`, giving\n    /// a threshold in [64/1024 × rtt, 260/1024 × rtt], capped at\n    /// [`C4_DELAY_THRESHOLD_MAX`] (25 ms).\n    pub fn delay_threshold(&self) -> u64 {\n        let sensitivity = self.sensitivity_1024();\n        let fraction = 64 + mult1024(1024 - sensitivity, 196);\n        let delay = mult1024(fraction, self.nominal_max_rtt);\n        delay.min(C4_DELAY_THRESHOLD_MAX)\n    }\n\n    /// C: `c4_update_ecn_alpha` (picoquic/c4.c:321)\n    ///\n    /// Selects the right packet context (path-scoped under multipath;\n    /// connection application context otherwise) and delegates to\n    /// `ecn_alpha_update_counts`.\n    #[allow(dead_code)]\n    pub(crate) fn update_ecn_alpha(&mut self, path_x: &Path, connection: &Connection) {\n        let pkt_ctx = if connection.is_multipath_enabled {\n            &path_x.pkt_ctx\n        } else {\n            &connection.pkt_ctx[PacketContext::Application as usize]\n        };\n        self.ecn_alpha_update_counts(pkt_ctx.ecn_ect1_total_remote, pkt_ctx.ecn_ce_total_remote);\n    }\n}\n\n#[cfg(test)]\nmod tests {\n    use super::*;\n\n    fn make_state() -> C4State {\n        C4State {\n            alg_state: C4AlgState::default(),\n            nominal_rate: 0,\n            nominal_max_rtt: 0,\n            initial_cwnd: 0,\n            running_min_rtt: 0,\n            alpha_1024_current: 0,\n            alpha_1024_previous: 0,\n            nb_packets_in_startup: 0,\n            era_sequence: 0,\n            nb_cruise_left_before_push: 0,\n            seed_cwin: 0,\n            seed_rate: 0,\n            probe_level: 0,\n            nb_eras_no_increase: 0,\n            push_rate_old: 0,\n            push_alpha: 0,\n            era_max_rtt: 0,\n            era_min_rtt: 0,\n            delay_threshold: 0,\n            recent_delay_excess: 0,\n            last_lost_packet_number: 0,\n            smoothed_drop_rate: 0.0,\n            ecn_alpha: 0,\n            ecn_ect1: 0,\n            ecn_ce: 0,\n            ecn_threshold: 0,\n            congestion_notified: false,\n            push_was_not_limited: false,\n            use_seed_cwin: false,\n            initial_after_jitter: false,\n            excess_ce_after_push: false,\n            option_string: None,\n        }\n    }\n\n    #[test]\n    fn growth_evaluate_high_alpha_growing() {\n        let mut s = make_state();\n        // push_alpha > 1088, push_rate_old = 1000, nominal_rate must exceed:\n        // target = (3*1000 + MULT1024(1280, 1000)) / 4 = (3000 + 1250) / 4 = 1062\n        s.push_alpha = 1280;\n        s.push_rate_old = 1000;\n        s.nominal_rate = 1100;\n        assert!(s.growth_evaluate());\n    }\n\n    #[test]\n    fn growth_evaluate_high_alpha_not_growing() {\n        let mut s = make_state();\n        s.push_alpha = 1280;\n        s.push_rate_old = 1000;\n        s.nominal_rate = 1000; // equal to target_rate or below\n        assert!(!s.growth_evaluate());\n    }\n\n    #[test]\n    fn growth_evaluate_low_alpha_growing_no_congestion() {\n        let mut s = make_state();\n        s.push_alpha = 1000; // <= 1088\n        s.push_rate_old = 800;\n        s.nominal_rate = 900;\n        s.congestion_notified = false;\n        assert!(s.growth_evaluate());\n    }\n\n    #[test]\n    fn growth_evaluate_low_alpha_congestion_blocks_growth() {\n        let mut s = make_state();\n        s.push_alpha = 1000;\n        s.push_rate_old = 800;\n        s.nominal_rate = 900;\n        s.congestion_notified = true;\n        assert!(!s.growth_evaluate());\n    }\n\n    // --- sensitivity_1024 ---\n\n    #[test]\n    fn sensitivity_below_50k() {\n        let mut s = make_state();\n        s.nominal_rate = 49_999;\n        assert_eq!(s.sensitivity_1024(), 0);\n    }\n\n    #[test]\n    fn sensitivity_at_50k_boundary() {\n        let mut s = make_state();\n        s.nominal_rate = 50_000;\n        // (50000 - 50000) * 963 / 950000 == 0\n        assert_eq!(s.sensitivity_1024(), 0);\n    }\n\n    #[test]\n    fn sensitivity_midrange() {\n        let mut s = make_state();\n        s.nominal_rate = 500_000;\n        // (500000 - 50000) * 963 / 950000 = 450000 * 963 / 950000 = 456\n        assert_eq!(s.sensitivity_1024(), 456);\n    }\n\n    #[test]\n    fn sensitivity_at_1mbps() {\n        let mut s = make_state();\n        s.nominal_rate = 1_000_000;\n        // hits else branch: 963 + (0 * 61 / 9000000) = 963\n        assert_eq!(s.sensitivity_1024(), 963);\n    }\n\n    #[test]\n    fn sensitivity_at_10mbps() {\n        let mut s = make_state();\n        s.nominal_rate = 10_000_000;\n        // 963 + (9000000 * 61 / 9000000) = 963 + 61 = 1024\n        assert_eq!(s.sensitivity_1024(), 1024);\n    }\n\n    #[test]\n    fn sensitivity_above_10mbps() {\n        let mut s = make_state();\n        s.nominal_rate = 10_000_001;\n        assert_eq!(s.sensitivity_1024(), 1024);\n    }\n\n    // --- growth_reset ---\n\n    #[test]\n    fn growth_reset_clears_flags_and_snapshots() {\n        let mut s = make_state();\n        s.nominal_rate = 5_000_000;\n        s.alpha_1024_current = 1100;\n        s.congestion_notified = true;\n        s.push_was_not_limited = true;\n        s.push_rate_old = 1_000_000;\n        s.push_alpha = 900;\n\n        s.growth_reset();\n\n        assert!(!s.congestion_notified);\n        assert!(!s.push_was_not_limited);\n        assert_eq!(s.push_rate_old, 5_000_000);\n        assert_eq!(s.push_alpha, 1100);\n    }\n\n    // --- set_options ---\n\n    #[test]\n    fn set_options_none_is_noop() {\n        let mut s = make_state();\n        s.option_string = None;\n        s.set_options(); // must not panic\n    }\n\n    #[test]\n    fn set_options_unknown_chars_are_noop() {\n        let mut s = make_state();\n        s.option_string = Some(\"xyz\".to_owned());\n        s.set_options(); // must not panic; no state change expected\n    }\n\n    // --- seed_cwin ---\n\n    #[test]\n    fn seed_cwin_sets_when_initial() {\n        let mut s = make_state();\n        s.alg_state = C4AlgState::Initial;\n        s.seed_cwin(123_456);\n        assert!(s.use_seed_cwin);\n        assert_eq!(s.seed_cwin, 123_456);\n    }\n\n    #[test]\n    fn seed_cwin_ignored_when_not_initial() {\n        let mut s = make_state();\n        s.alg_state = C4AlgState::Cruising;\n        s.seed_cwin(123_456);\n        assert!(!s.use_seed_cwin);\n        assert_eq!(s.seed_cwin, 0);\n    }\n\n    // --- observe ---\n\n    #[test]\n    fn observe_returns_state_and_rtt() {\n        let mut s = make_state();\n        s.alg_state = C4AlgState::Pushing;\n        s.nominal_max_rtt = 42_000;\n        let (cc_state, cc_param) = s.observe();\n        assert_eq!(cc_state, C4AlgState::Pushing as u64);\n        assert_eq!(cc_param, 42_000);\n    }\n\n    #[test]\n    fn observe_initial_state() {\n        let s = make_state();\n        let (cc_state, cc_param) = s.observe();\n        assert_eq!(cc_state, 0); // C4AlgState::Initial == 0\n        assert_eq!(cc_param, 0);\n    }\n\n    // --- update_loss_rate ---\n\n    #[test]\n    fn loss_rate_no_update_when_not_newer() {\n        let mut s = make_state();\n        s.last_lost_packet_number = 100;\n        s.smoothed_drop_rate = 0.5;\n        s.update_loss_rate(100); // same number → no change\n        assert_eq!(s.smoothed_drop_rate, 0.5);\n        assert_eq!(s.last_lost_packet_number, 100);\n    }\n\n    #[test]\n    fn loss_rate_single_step() {\n        let mut s = make_state();\n        s.last_lost_packet_number = 0;\n        s.smoothed_drop_rate = 0.0;\n        s.update_loss_rate(1);\n        // one decay step: rate *= (1 - 1/16) = 0  (was 0)\n        // then: rate += (1 - 0) * (1/16) = 1/16\n        assert!((s.smoothed_drop_rate - 1.0 / 16.0).abs() < 1e-12);\n        assert_eq!(s.last_lost_packet_number, 1);\n    }\n\n    #[test]\n    fn loss_rate_caps_scope() {\n        let mut s = make_state();\n        // Gap far exceeds SMOOTHED_LOSS_SCOPE=32; loop should start at\n        // lost_packet_number - 32 so only 32 decays happen, not 1000.\n        s.last_lost_packet_number = 0;\n        s.smoothed_drop_rate = 1.0;\n        s.update_loss_rate(1000);\n        // After 32 decay steps: 1.0 * (15/16)^32 ≈ 0.1209\n        // Then one more step adding the loss event:\n        // result = decayed + (1 - decayed) * (1/16)\n        let expected_decayed = (15.0f64 / 16.0).powi(32);\n        let expected = expected_decayed + (1.0 - expected_decayed) * (1.0 / 16.0);\n        assert!((s.smoothed_drop_rate - expected).abs() < 1e-9);\n        assert_eq!(s.last_lost_packet_number, 1000);\n    }\n\n    // --- ecn_alpha_update_counts ---\n\n    #[test]\n    fn ecn_alpha_no_update_when_both_zero_delta() {\n        let mut s = make_state();\n        s.ecn_alpha = 500;\n        s.ecn_ect1 = 100;\n        s.ecn_ce = 50;\n        // same totals → no delta → alpha unchanged\n        s.ecn_alpha_update_counts(100, 50);\n        assert_eq!(s.ecn_alpha, 500);\n    }\n\n    #[test]\n    fn ecn_alpha_fast_path_large_frac() {\n        let mut s = make_state();\n        s.ecn_alpha = 400;\n        s.ecn_ect1 = 0;\n        s.ecn_ce = 0;\n        // delta_ce = 600, delta_ect1 = 400 → frac = 600*1024/(600+400) = 614\n        // frac (614) > alpha (400) and frac >= 512 → fast path: alpha = frac\n        s.ecn_alpha_update_counts(400, 600);\n        assert_eq!(s.ecn_alpha, 614);\n    }\n\n    #[test]\n    fn ecn_alpha_ewma_path() {\n        let mut s = make_state();\n        s.ecn_alpha = 256;\n        s.ecn_ect1 = 0;\n        s.ecn_ce = 0;\n        // delta_ce = 100, delta_ect1 = 900 → frac = 100*1024/1000 = 102\n        // frac (102) < alpha (256) → EWMA path\n        // alpha_shifted = 256 * 16 - 256 + 102 = 256*15 + 102 = 3840 + 102 = 3942\n        // new alpha = 3942 / 16 = 246\n        s.ecn_alpha_update_counts(900, 100);\n        assert_eq!(s.ecn_alpha, 246);\n    }\n\n    #[test]\n    fn ecn_alpha_only_ect1_delta() {\n        let mut s = make_state();\n        s.ecn_alpha = 200;\n        s.ecn_ect1 = 0;\n        s.ecn_ce = 0;\n        // delta_ect1 = 500, delta_ce = 0 → frac = 0\n        // frac (0) < alpha (200) → EWMA:\n        //   alpha_shifted = 200 << 4 = 3200; 3200 - 200 = 3000; 3000 + 0 = 3000\n        //   new alpha = 3000 >> 4 = 187\n        s.ecn_alpha_update_counts(500, 0);\n        assert_eq!(s.ecn_alpha, 187);\n    }\n}\n","numLines":546,"startLine":1,"totalLines":546}}}
