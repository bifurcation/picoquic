{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_011ndurXNB2LuMyjfQWn5vEU","type":"tool_result","content":"260\t}\n261\t\n262\t/* Compute the delay threshold for declaring congestion,\n263\t* as the min of RTT/8 and c4_DELAY_THRESHOLD_MAX (25 ms) \n264\t */\n265\t\n266\tuint64_t c4_delay_threshold(c4_state_t* c4_state)\n267\t{\n268\t    uint64_t sensitivity = c4_sensitivity_1024(c4_state);\n269\t    uint64_t fraction = 64 + MULT1024(1024 - sensitivity, 196);\n270\t    uint64_t delay = MULT1024(fraction, c4_state->nominal_max_rtt);\n271\t    if (delay > C4_DELAY_THRESHOLD_MAX) {\n272\t        delay = C4_DELAY_THRESHOLD_MAX;\n273\t    }\n274\t    return delay;\n275\t}\n276\t\n277\t/* Compute the ECNmarking threshold for declaring a congestion event.\n278\t* The marking threshold should be large if the sensitivity is small --\n279\t* maybe 25%, and smaller if the sensitivity is large -- maybe 12.5%.\n280\t*/\n281\tuint64_t c4_ecn_threshold(c4_state_t* c4_state)\n282\t{\n283\t    uint64_t sensitivity = c4_sensitivity_1024(c4_state);\n284\t\n285\t    uint64_t ecn_threshold = 192 - MULT1024(sensitivity, 96);\n286\t\n287\t    return ecn_threshold;\n288\t}\n289\t\n290\t/* Compute the loss rate threshold for declaring a congestion event\n291\t*/\n292\tdouble c4_loss_threshold(c4_state_t* c4_state)\n293\t{\n294\t    uint64_t sensitivity = c4_sensitivity_1024(c4_state);\n295\t    double fraction = ((double)sensitivity) / 1024.0;\n296\t    double loss_threshold = 0.02 + 0.50 * (1-fraction);\n297\t\n298\t    return loss_threshold;\n299\t}\n300\t\n301\t/* Compute the loss rate */\n302\tvoid c4_update_loss_rate(c4_state_t * c4_state, uint64_t lost_packet_number)\n303\t{\n304\t    uint64_t next_number = c4_state->last_lost_packet_number;\n305\t\n306\t    if (lost_packet_number > next_number) {\n307\t        if (next_number + PICOQUIC_SMOOTHED_LOSS_SCOPE < lost_packet_number) {\n308\t            next_number = lost_packet_number - PICOQUIC_SMOOTHED_LOSS_SCOPE;\n309\t        }\n310\t\n311\t        while (next_number < lost_packet_number) {\n312\t            c4_state->smoothed_drop_rate *= (1.0 - PICOQUIC_SMOOTHED_LOSS_FACTOR);\n313\t            next_number++;\n314\t        }\n315\t\n316\t        c4_state->smoothed_drop_rate += (1.0 - c4_state->smoothed_drop_rate) * PICOQUIC_SMOOTHED_LOSS_FACTOR;\n317\t        c4_state->last_lost_packet_number = lost_packet_number;\n318\t    }\n319\t}\n320\t\n321\t/* Compute the ECN alpha\n322\t*\n323\t* This is similar the prague implementation.\n324\t*/\n325\tstatic void c4_update_ecn_alpha(picoquic_path_t* path_x, c4_state_t* c4_state)\n326\t{\n327\t    uint64_t frac = 0;\n328\t    picoquic_packet_context_t* pkt_ctx = (path_x->cnx->is_multipath_enabled)?\n329\t        &path_x->pkt_ctx : &path_x->cnx->pkt_ctx[picoquic_packet_context_application];\n330\t    int64_t delta_ect1 = pkt_ctx->ecn_ect1_total_remote - c4_state->ecn_ect1;\n331\t    int64_t delta_ce = pkt_ctx->ecn_ce_total_remote - c4_state->ecn_ce;\n332\t\n333\t    c4_state->ecn_ect1 = pkt_ctx->ecn_ect1_total_remote;\n334\t    c4_state->ecn_ce = pkt_ctx->ecn_ce_total_remote;\n335\t\n336\t    if (delta_ce > 0 || delta_ect1 > 0) {\n337\t        frac = (delta_ce * 1024) / (delta_ce + delta_ect1);\n338\t\n339\t        if (frac > c4_state->ecn_alpha && frac >= 512) {\n340\t            c4_state->ecn_alpha = frac;\n341\t        }\n342\t        else\n343\t        {\n344\t            uint64_t alpha_shifted = c4_state->ecn_alpha << C4_ECN_SHIFT_G;\n345\t            alpha_shifted -= c4_state->ecn_alpha;\n346\t            alpha_shifted += frac;\n347\t            c4_state->ecn_alpha = alpha_shifted >> C4_ECN_SHIFT_G;\n348\t        }\n349\t    }\n350\t}\n351\t\n352\t/*\n353\t* c4_apply_rate_and_cwin:\n354\t* Manage all setting of the actual cwin, pacing rate and quantum\n355\t* at a single place, based on the state parameters computed\n356\t* in the other functions.\n357\t*/\n358\t\n359\tstatic void c4_apply_rate_and_cwin("}]},"parent_tool_use_