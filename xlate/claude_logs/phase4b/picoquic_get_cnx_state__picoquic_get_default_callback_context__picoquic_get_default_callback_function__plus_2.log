{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01T8N4pgzx3F8Ji34VJAkaBN","type":"tool_result","content":"1094\t\n1095\t    /// Toggle SSL-keylog output.  Phase 1 follows the canonical\n1096\t    /// build (`WITHOUT_SSLKEYLOG` undefined); a `cfg`-gated variant\n1097\t    /// lands when build options are translated.\n1098\t    /// C: `picoquic_enable_sslkeylog` — `quic->enable_sslkeylog = (enable != 0)`.\n1099\t    pub fn set_sslkeylog_enabled(&mut self, enable_sslkeylog: bool) {\n1100\t        self.enable_sslkeylog = enable_sslkeylog;\n1101\t    }\n1102\t\n1103\t    /// Whether SSL-keylog output is enabled on this context.\n1104\t    pub fn is_sslkeylog_enabled(&self) -> bool {\n1105\t        self.enable_sslkeylog\n1106\t    }\n1107\t\n1108\t    /// Configure packet-number randomisation: `0` (no\n1109\t    /// randomisation), `1` (Initial PNs only), `2` (all PN spaces).\n1110\t    pub fn set_random_initial(&mut self, random_initial: i32) {\n1111\t        self.random_initial = random_initial as u8;\n1112\t    }\n1113\t\n1114\t    /// Toggle packet-train mode (groups outbound packets into\n1115\t    /// coalesced trains).\n1116\t    pub fn set_packet_train_mode(&mut self, train_mode: bool) {\n1117\t        self.packet_train_mode = train_mode;\n1118\t    }\n1119\t\n1120\t    /// Configure default padding policy applied to outbound packets.\n1121\t    pub fn set_padding_policy(&mut self, padding_min_size: u32, padding_multiple: u32) {\n1122\t        self.padding_minsize_default = padding_min_size;\n1123\t        self.padding_multiple_default = padding_multiple;\n1124\t    }\n1125\t\n1126\t    /// Set (or clear, with `None`) the keylog destination file.\n1127\t    pub fn set_key_log_file(&mut self, keylog_filename: Option<&str>) {\n1128\t        // Open or clear the SSL keylog file.  When a path is given, open it\n1129\t        // for appending; errors are silently ignored (matching the C behaviour\n1130\t        // of falling back to no logging rather than crashing).\n1131\t        use std::fs::OpenOptions;\n1132\t        match keylog_filename {\n1133\t            Some(path) => {\n1134\t                if let Ok(f) = OpenOptions::new().create(true).append(true).open(path) {\n1135\t                    self.f_log = Some(Box::new(f));\n1136\t                }\n1137\t            }\n1138\t            None => {\n1139\t                self.f_log = None;\n1140\t            }\n1141\t        }\n1142\t    }\n1143\t\n1144\t    /// Read `SSLKEYLOGFILE` from the process environment (gated\n1145\t    /// behind the build-time `WITHOUT_SSLKEYLOG` opt-out and the\n1146\t    /// per-context `is_sslkeylog_enabled` flag) and install it via\n1147\t    /// [`Quic::set_key_log_file`].  C:\n1148\t    /// `picoquic_set_key_log_file_from_env`.\n1149\t    ///\n1150\t    /// The environment lookup is a `std`-only operation (it goes\n1151\t    /// through `getenv`); Phase 3 will feature-gate the body.\n1152\t    pub fn set_key_log_file_from_env(&mut self) {\n1153\t        if self.enable_sslkeylog\n1154\t            && let Ok(path) = std::env::var(\"SSLKEYLOGFILE\")\n1155\t        {\n1156\t            self.set_key_log_file(Some(&path));\n1157\t        }\n1158\t    }\n1159\t\n1160\t    /// Adjust the connection-pool ceiling.  Cannot grow past the\n1161\t    /// limit chosen at context creation.\n1162\t    pub fn adjust_max_connections(&mut self, max_nb_connections: u32) -> Result<(), Error> {\n1163\t        if max_nb_connections > self.max_number_connections {\n1164\t            return Err(Error::InvalidArgument);\n1165\t        }\n1166\t        self.tentative_max_number_connections = max_nb_connections;\n1167\t        Ok(())\n1168\t    }\n1169\t\n1170\t    /// Number of connections currently registered with this context.\n1171\t    pub fn current_number_connections(&self) -> u32 {\n1172\t        self.current_number_connections\n1173\t    }\n1174\t\n1175\t    /// Set the half-open-connection threshold above which the server\n1176\t    /// switches to retry-token mode.\n1177\t    pub fn set_max_half_open_retry_threshold(&mut self, max_half_open_before_retry: u32) {\n1178\t        self.max_half_open_before_retry = max_half_open_before_retry;\n1179\t    }\n1180\t\n1181\t    /// Retrieve the configured half-open retry threshold.\n1182\t    pub fn max_half_open_retry_threshold(&self) -> u32 {\n1183\t        self.max_half_open_before_retry\n1184\t    }\n1185\t\n1186\t    /// Toggle per-context port blocking.\n1187\t    /// C: `picoquic_disable_port_blocking`.\n1188\t    pub fn set_port_blocking_disabled(&mut self, is_port_blocking_disabled: bool) {\n1189\t        self.is_port_blocking_disabled = is_port_blocking_disabled;\n1190\t    }\n1191\t}\n1192\t\n1193\t// ---------------------------------------------------------------------------\n1194\t// Free-standing port / address blocklist queries (no per-context\n1195\t// state — these consult a process-wide allowlist).\n1196\t\n1197\t/// Well-known ports blocked to prevent reflection amplification.\n1198\t/// Sourced from `picoquic/port_blocking.c`.\n1199\tconst BLOCKED_PORTS: &[u16] = &[\n1200\t    27015, // SRCDS\n1201\t    20800, // Call Of Duty\n1202\t    11211, // memcache\n1203\t    5353,  // mDNS\n1204\t    1900,  // SSDP\n1205\t    520,   // RIP\n1206\t    500,   // IKE\n1207\t    389,   // CLDAP\n1208\t    161,   // SNMP\n1209\t    138,   // NETBIOS Datagram Service\n1210\t    137,   // NETBIOS Name Service\n1211\t    123,   // NTP\n1212\t    111,   // Portmap\n1213\t    53,    // DNS\n1214\t    19,    // Chargen\n1215\t    17,    // Quote of the Day\n1216\t    7,     // Echo\n1217\t    0,     // Unusable\n1218\t];\n1219\t\n1220\t/// Returns `true` when `port` is on the QUIC well-known-port\n1221\t/// blocklist.\n1222\tpub fn check_port_blocked(port: u16) -> bool {\n1223\t    // List is sorted descending; iterate while port <= list[i].\n1224\t    for &blocked in BLOCKED_PORTS {\n1225\t        if port > blocked {\n1226\t            break;\n1227\t        }\n1228\t        if port == blocked {\n1229\t            return true;\n1230\t        }\n1231\t    }\n1232\t    false\n1233\t}\n1234\t\n1235\t/// Returns `true` when `addr_from` belongs to a blocked address\n1236\t/// range.\n1237\tpub fn check_addr_blocked(addr_from: &SocketAddr) -> bool {\n1238\t    check_port_blocked(addr_from.port())\n1239\t}\n1240\t\n1241\t// ---------------------------------------------------------------------------\n1242\t// QUIC context: construction, TLS configuration, default policies.\n1243\t//\n1244\t// `picoquic_create` is the canonical constructor in the C source;\n1245\t// here it is `Quic::new`.  The setters that follow are all on the\n1246\t// QUIC context; per-connection siblings live in `impl Connection` further\n1247\t// down.\n1248\t\n1249\timpl Quic {\n1250\t    /// Build a QUIC context with the supplied certificate paths,\n1251\t    /// default callbacks, and reset seed.\n1252\t    ///\n1253\t    /// Pointer-shape choices, derived from `quic/quicctx.c:634` and\n1254\t    /// `quic/sockloop.c:2009`:\n1255\t    ///\n1256\t    /// * Every `char const*` parameter is `Option<&str>` (the C\n1257\t    ///   source passes `NULL` to mean \"absent\").\n1258\t    /// * `default_callback_fn` + `default_callback_ctx` collapse to\n1259\t    ///   one `Option<Box<dyn StreamDataCallback>>`.\n1260\t    /// * `connection_id_callback` + `connection_id_callback_data` collapse to\n1261\t    ///   `Option<Box<dyn ConnectionIdCallback>>`.\n1262\t    /// * `reset_seed[16]` is `[u8; RESET_SECRET_SIZE]` taken by\n1263\t    ///   value (the C body deep-copies it into the context).\n1264\t    /// * `ticket_encryption_key` + `ticket_encryption_key_length`\n1265\t    ///   collapse to a borrowed `Option<&[u8]>`.\n1266\t    /// * The C `p_simulated_time: uint64_t*` parameter is dropped\n1267\t    ///   — the test simulator owns its own clock and threads the\n1268\t    ///   value through `current_time` directly.\n1269\t    ///\n1270\t    /// Returns `None` when context creation fails (the C side\n1271\t    /// returned `NULL`).\n1272\t    #[allow(clippy::too_many_arguments)]\n1273\t    pub fn new(\n1274\t        mut max_nb_connections: u32,\n1275\t        cert_file_name: Option<&str>,\n1276\t        key_file_name: Option<&str>,\n1277\t        _cert_root_file_name: Option<&str>,\n1278\t        default_alpn: Option<&str>,\n1279\t        default_callback: Option<Box<dyn StreamDataCallback>>,\n1280\t        cnx_id_callback: Option<Box<dyn ConnectionIdCallback>>,\n1281\t        reset_seed: [u8; RESET_SECRET_SIZE],\n1282\t        current_time: Instant,\n1283\t        ticket_file_name: Option<&str>,\n1284\t        _ticket_encryption_key: Option<&[u8]>,\n1285\t    ) -> Option<Box<Quic>> {\n1286\t        // C: if max_nb_connections == 0, clamp to 1.\n1287\t        if max_nb_connections == 0 {\n1288\t            max_nb_connections = 1;\n1289\t        }\n1290\t\n1291\t        // C: enforce_client_only = (cert_file_name == NULL || key_file_name == NULL)\n1292\t        // For TLS-capable server contexts, both must be present.\n1293\t        // If provided, validate that the files exist (the C code fails in"}]},"parent_tool_use_id":null,"session_id":"bc65f024-1847-48ea-8039-b3ad326afc33","uuid":"05d0a37f-4a3f-4de5-8a86-81eda19c3a62","timestamp":"2026-05-07T08:29:03.530Z","tool_use_result":{"type":"text","file":{"filePath":"/Users/richbarn/Projects/picoquic/rs/fq/src/lib.rs","content":"\n    /// Toggle SSL-keylog output.  Phase 1 follows the canonical\n    /// build (`WITHOUT_SSLKEYLOG` undefined); a `cfg`-gated variant\n    /// lands when build options are translated.\n    /// C: `picoquic_enable_sslkeylog` — `quic->enable_sslkeylog = (enable != 0)`.\n    pub fn set_sslkeylog_enabled(&mut self, enable_sslkeylog: bool) {\n        self.enable_sslkeylog = enable_sslkeylog;\n    }\n\n    /// Whether SSL-keylog output is enabled on this context.\n    pub fn is_sslkeylog_enabled(&self) -> bool {\n        self.enable_sslkeylog\n    }\n\n    /// Configure packet-number randomisation: `0` (no\n    /// randomisation), `1` (Initial PNs only), `2` (all PN spaces).\n    pub fn set_random_initial(&mut self, random_initial: i32) {\n        self.random_initial = random_initial as u8;\n    }\n\n    /// Toggle packet-train mode (groups outbound packets into\n    /// coalesced trains).\n    pub fn set_packet_train_mode(&mut self, train_mode: bool) {\n        self.packet_train_mode = train_mode;\n    }\n\n    /// Configure default padding policy applied to outbound packets.\n    pub fn set_padding_policy(&mut self, padding_min_size: u32, padding_multiple: u32) {\n        self.padding_minsize_default = padding_min_size;\n        self.padding_multiple_default = padding_multiple;\n    }\n\n    /// Set (or clear, with `None`) the keylog destination file.\n    pub fn set_key_log_file(&mut self, keylog_filename: Option<&str>) {\n        // Open or clear the SSL keylog file.  When a path is given, open it\n        // for appending; errors are silently ignored (matching the C behaviour\n        // of falling back to no logging rather than crashing).\n        use std::fs::OpenOptions;\n        match keylog_filename {\n            Some(path) => {\n                if let Ok(f) = OpenOptions::new().create(true).append(true).open(path) {\n                    self.f_log = Some(Box::new(f));\n                }\n            }\n            None => {\n                self.f_log = None;\n            }\n        }\n    }\n\n    /// Read `SSLKEYLOGFILE` from the process environment (gated\n    /// behind the build-time `WITHOUT_SSLKEYLOG` opt-out and the\n    /// per-context `is_sslkeylog_enabled` flag) and install it via\n    /// [`Quic::set_key_log_file`].  C:\n    /// `picoquic_set_key_log_file_from_env`.\n    ///\n    /// The environment lookup is a `std`-only operation (it goes\n    /// through `getenv`); Phase 3 will feature-gate the body.\n    pub fn set_key_log_file_from_env(&mut self) {\n        if self.enable_sslkeylog\n            && let Ok(path) = std::env::var(\"SSLKEYLOGFILE\")\n        {\n            self.set_key_log_file(Some(&path));\n        }\n    }\n\n    /// Adjust the connection-pool ceiling.  Cannot grow past the\n    /// limit chosen at context creation.\n    pub fn adjust_max_connections(&mut self, max_nb_connections: u32) -> Result<(), Error> {\n        if max_nb_connections > self.max_number_connections {\n            return Err(Error::InvalidArgument);\n        }\n        self.tentative_max_number_connections = max_nb_connections;\n        Ok(())\n    }\n\n    /// Number of connections currently registered with this context.\n    pub fn current_number_connections(&self) -> u32 {\n        self.current_number_connections\n    }\n\n    /// Set the half-open-connection threshold above which the server\n    /// switches to retry-token mode.\n    pub fn set_max_half_open_retry_threshold(&mut self, max_half_open_before_retry: u32) {\n        self.max_half_open_before_retry = max_half_open_before_retry;\n    }\n\n    /// Retrieve the configured half-open retry threshold.\n    pub fn max_half_open_retry_threshold(&self) -> u32 {\n        self.max_half_open_before_retry\n    }\n\n    /// Toggle per-context port blocking.\n    /// C: `picoquic_disable_port_blocking`.\n    pub fn set_port_blocking_disabled(&mut self, is_port_blocking_disabled: bool) {\n        self.is_port_blocking_disabled = is_port_blocking_disabled;\n    }\n}\n\n// ---------------------------------------------------------------------------\n// Free-standing port / address blocklist queries (no per-context\n// state — these consult a process-wide allowlist).\n\n/// Well-known ports blocked to prevent reflection amplification.\n/// Sourced from `picoquic/port_blocking.c`.\nconst BLOCKED_PORTS: &[u16] = &[\n    27015, // SRCDS\n    20800, // Call Of Duty\n    11211, // memcache\n    5353,  // mDNS\n    1900,  // SSDP\n    520,   // RIP\n    500,   // IKE\n    389,   // CLDAP\n    161,   // SNMP\n    138,   /