{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01HkdibNVEVMBccN9r5Seyvi","type":"tool_result","content":"2595\t    }\n2596\t\n2597\t    /// Borrow the connection currently advancing through its state\n2598\t    /// machine, if any (`get_cnx_in_progress` in C).\n2599\t    pub fn connection_in_progress(&mut self) -> Option<&mut Connection> {\n2600\t        let tok = self.connection_in_progress?;\n2601\t        self.connections.get_mut(tok)\n2602\t    }\n2603\t\n2604\t    /// Default PMTUD policy applied to new connections.\n2605\t    pub fn set_default_pmtud_policy(&mut self, pmtud_policy: PmtudPolicy) {\n2606\t        self.default_pmtud_policy = pmtud_policy;\n2607\t    }\n2608\t\n2609\t    /// Borrow the default stream callback installed on this context.\n2610\t    pub fn default_callback(&self) -> Option<&dyn StreamDataCallback> {\n2611\t        self.default_callback_fn.as_deref()\n2612\t    }\n2613\t}\n2614\t\n2615\t// ---------------------------------------------------------------------------\n2616\t// Packet I/O.\n2617\t\n2618\timpl Quic {\n2619\t    /// Submit a received packet to the QUIC context for dispatch.\n2620\t    /// `addr_from` and `addr_to` are borrowed for the duration of\n2621\t    /// the call; `received_ecn` carries the IP-level ECN code-point\n2622\t    /// byte.\n2623\t    #[allow(clippy::too_many_arguments)]\n2624\t    pub fn incoming_packet(\n2625\t        &mut self,\n2626\t        _bytes: &mut [u8],\n2627\t        _addr_from: &SocketAddr,\n2628\t        _addr_to: &SocketAddr,\n2629\t        _if_index_to: i32,\n2630\t        _received_ecn: u8,\n2631\t        _current_time: Instant,\n2632\t    ) -> Result<(), Error> {\n2633\t        // Complex: full packet dispatch pipeline — Phase 4 body.\n2634\t        Err(Error::Generic)\n2635\t    }\n2636\t\n2637\t    /// Same as [`Self::incoming_packet`] but additionally identifies\n2638\t    /// the connection that consumed the packet.\n2639\t    #[allow(clippy::too_many_arguments)]\n2640\t    pub fn incoming_packet_ex(\n2641\t        &mut self,\n2642\t        _bytes: &mut [u8],\n2643\t        _addr_from: &SocketAddr,\n2644\t        _addr_to: &SocketAddr,\n2645\t        _if_index_to: i32,\n2646\t        _received_ecn: u8,\n2647\t        _current_time: Instant,\n2648\t    ) -> Result<Option<&mut Connection>, Error> {\n2649\t        // Complex: full packet dispatch pipeline — Phase 4 body.\n2650\t        Err(Error::Generic)\n2651\t    }\n2652\t}\n2653\t\n2654\t/// Result of preparing a packet for transmission.  Folds the C\n2655\t/// out-parameter pile (`send_length`, `p_addr_to`, `p_addr_from`,\n2656\t/// `if_index`, `log_cid`, `send_msg_size`) into a single struct.\n2657\t#[derive(Debug)]\n2658\tpub struct PreparedPacket<'a> {\n2659\t    /// Number of bytes written into `send_buffer`.\n2660\t    pub send_length: usize,\n2661\t    /// Destination address.\n2662\t    pub addr_to: SocketAddr,\n2663\t    /// Source address.\n2664\t    pub addr_from: SocketAddr,\n2665\t    pub if_index: i32,\n2666\t    /// Connection ID that should be logged for this packet.\n2667\t    pub log_cid: ConnectionId,\n2668\t    /// Connection that produced the packet (the C\n2669\t    /// `p_last_connection`).  `None` when the QUIC context had no work to\n2670\t    /// do.\n2671\t    pub last_connection: Option<&'a mut Connection>,\n2672\t    /// Optional GSO segment size when the packet is a coalesced\n2673\t    /// train; `None` for a single-packet send.\n2674\t    pub send_msg_size: Option<usize>,\n2675\t}\n2676\t\n2677\timpl Quic {\n2678\t    /// Drive the next packet onto the wire.  Folds the seven\n2679\t    /// out-parameters of the C signature into a [`PreparedPacket`].\n2680\t    pub fn prepare_next_packet_ex(\n2681\t        &mut self,\n2682\t        _current_time: Instant,\n2683\t        _send_buffer: &mut [u8],\n2684\t    ) -> Result<PreparedPacket<'_>, Error> {\n2685\t        // Complex: full sender pipeline — Phase 4 body.\n2686\t        Err(Error::Generic)\n2687\t    }\n2688\t\n2689\t    /// Same shape as [`Self::prepare_next_packet_ex`] but without\n2690\t    /// GSO segment reporting.\n2691\t    pub fn prepare_next_packet(\n2692\t        &mut self,\n2693\t        _current_time: Instant,\n2694\t        _send_buffer: &mut [u8],"}]},"parent_tool_use_id":null,"session_id":"bc65f024-1847-48ea-8039-b3ad326afc33","uuid":"45c23101-a22b-48e2-8df7-668350d5179c","timestamp":"2026-05-07T08:33:20.982Z","tool_use_result":{"type":"text","file":{"filePath":"/Users/richbarn/Projects/picoquic/rs/fq/src/lib.rs","content":"    }\n\n    /// Borrow the connection currently advancing through its state\n    /// machine, if any (`get_cnx_in_progress` in C).\n    pub fn connection_in_progress(&mut self) -> Option<&mut Connection> {\n        let tok = self.connection_in_progress?;\n        self.connections.get_mut(tok)\n    }\n\n    /// Default PMTUD policy applied to new connections.\n    pub fn set_default_pmtud_policy(&mut self, pmtud_policy: PmtudPolicy) {\n        self.default_pmtud_policy = pmtud_policy;\n    }\n\n    /// Borrow the default stream callback installed on this context.\n    pub fn default_callback(&self) -> Option<&dyn StreamDataCallback> {\n        self.default_callback_fn.as_deref()\n    }\n}\n\n// ---------------------------------------------------------------------------\n// Packet I/O.\n\nimpl Quic {\n    /// Submit a received packet to the QUIC context for dispatch.\n    /// `addr_from` and `addr_to` are borrowed for the duration of\n    /// the call; `received_ecn` carries the IP-level ECN code-point\n    /// byte.\n    #[allow(clippy::too_many_arguments)]\n    pub fn incoming_packet(\n        &mut self,\n        _bytes: &mut [u8],\n        _addr_from: &SocketAddr,\n        _addr_to: &SocketAddr,\n        _if_index_to: i32,\n        _received_ecn: u8,\n        _current_time: Instant,\n    ) -> Result<(), Error> {\n        // Complex: full packet dispatch pipeline — Phase 4 body.\n        Err(Error::Generic)\n    }\n\n    /// Same as [`Self::incoming_packet`] but additionally identifies\n    /// the connection that consumed the packet.\n    #[allow(clippy::too_many_arguments)]\n    pub fn incoming_packet_ex(\n        &mut self,\n        _bytes: &mut [u8],\n        _addr_from: &SocketAddr,\n        _addr_to: &SocketAddr,\n        _if_index_to: i32,\n        _received_ecn: u8,\n        _current_time: Instant,\n    ) -> Result<Option<&mut Connection>, Error> {\n        // Complex: full packet dispatch pipeline — Phase 4 body.\n        Err(Error::Generic)\n    }\n}\n\n/// Result of preparing a packet for transmission.  Folds the C\n/// out-parameter pile (`send_length`, `p_addr_to`, `p_addr_from`,\n/// `if_index`, `log_cid`, `send_msg_size`) into a single struct.\n#[derive(Debug)]\npub struct PreparedPacket<'a> {\n    /// Number of bytes written into `send_buffer`.\n    pub send_length: usize,\n    /// Destination address.\n    pub addr_to: SocketAddr,\n    /// Source address.\n    pub addr_from: SocketAddr,\n    pub if_index: i32,\n    /// Connection ID that should be logged for this packet.\n    pub log_cid: ConnectionId,\n    /// Connection that produced the packet (the C\n    /// `p_last_connection`).  `None` when the QUIC context had no work to\n    /// do.\n    pub last_connection: Option<&'a mut Connection>,\n    /// Optional GSO segment size when the packet is a coalesced\n    /// train; `None` for a single-packet send.\n    pub send_msg_size: Option<usize>,\n}\n\nimpl Quic {\n    /// Drive the next packet onto the wire.  Folds the seven\n    /// out-parameters of the C signature into a [`PreparedPacket`].\n    pub fn prepare_next_packet_ex(\n        &mut self,\n        _current_time: Instant,\n        _send_buffer: &mut [u8],\n    ) -> Result<PreparedPacket<'_>, Error> {\n        // Complex: full sender pipeline — Phase 4 body.\n        Err(Error::Generic)\n    }\n\n    /// Same shape as [`Self::prepare_next_packet_ex`] but without\n    /// GSO segment reporting.\n    pub fn prepare_next_packet(\n        &mut self,\n        _current_time: Instant,\n        _send_buffer: &mut [u8],","numLines":100,"startLine":2595,"totalLines":4099}}}
