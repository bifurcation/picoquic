{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01XfrBSLpMEXe7LszqQ56pQu","type":"tool_result","content":"490\timpl Quic {\n491\t    /// Virtual time used by this QUIC context (wall-clock or\n492\t    /// simulated, depending on whether a simulated-time pointer was\n493\t    /// supplied at creation).  C: `get_quic_time`.\n494\t    pub fn time(&self) -> u64 {\n495\t        current_time()\n496\t    }\n497\t}\n498\t\n499\t// ---------------------------------------------------------------------------\n500\t// Application callbacks (function-pointer typedefs → traits).\n501\t\n502\t/// Stream/event callback installed on a QUIC context or connection.\n503\t/// Folds the C `void* callback_ctx` into the trait implementor's\n504\t/// state; `stream_ctx` is per-stream and remains a raw pointer\n505\t/// because it is produced and consumed by the application without\n506\t/// the stack interpreting it.\n507\t///\n508\t/// Returns the C `int` directly: `0` for success, or one of the\n509\t/// `_*` codes (e.g. `STREAM_RECEIVE_COMPLETE`) for\n510\t/// special signalling.  Phase 3 may refine to `Result` once the\n511\t/// crate-level error type lands.\n512\t///\n513\t/// `bytes` is `&[u8]` rather than `*const u8 + size_t`; events that\n514\t/// carry no payload pass `&[]`.\n515\tpub trait StreamDataCallback {\n516\t    fn callback(\n517\t        &mut self,\n518\t        connection: &mut Connection,\n519\t        stream_id: u64,\n520\t        bytes: &[u8],\n521\t        fin_or_event: CallbackEvent,\n522\t        stream_ctx: Option<&mut dyn core::any::Any>,\n523\t    ) -> i32;\n524\t}\n525\t\n526\t/// ALPN-selection callback.  Returns the index of the chosen ALPN\n527\t/// in `list`, or any value `>= list.len()` to signal \"none of the\n528\t/// proposed ALPNs is supported\".  C: `AlpnSelect` (the C `_v2`\n529\t/// flavour is folded in — it only differed in the iovec type, which\n530\t/// is now just `&[u8]`).\n531\t/// Application hook the TLS backend invokes to choose one of the\n532\t/// client's proposed ALPN values.  Returns the chosen index into\n533\t/// `list`, or `None` to reject the handshake.\n534\t///\n535\t/// `list` carries the raw bytes off the wire; mapping to the\n536\t/// strongly-typed [`Alpn`] enum is up to the implementor (most\n537\t/// applications keep a small whitelist by string identifier).\n538\tpub trait AlpnSelect {\n539\t    fn select(&mut self, quic: &mut Quic, list: &[&[u8]]) -> Option<usize>;\n540\t}\n541\t\n542\t/// Callback that produces a server-environment-compatible CID.\n543\t/// Folds the C `void* connection_id_cb_data` into the implementor's state.\n544\t/// C: `ConnectionIdCallback`.\n545\tpub trait ConnectionIdCallback {\n546\t    fn produce(\n547\t        &mut self,\n548\t        quic: &mut Quic,\n549\t        connection_id_local: ConnectionId,\n550\t        connection_id_remote: ConnectionId,\n551\t    ) -> ConnectionId;\n552\t}\n553\t\n554\t/// Packet-fuzzer callback.  Folds the C `void* fuzz_ctx` into the\n555\t/// implementor.  Returns the new packet length (which may equal\n556\t/// the input).  C: `Fuzz`.\n557\tpub trait Fuzz {\n558\t    fn fuzz(\n559\t        &mut self,\n560\t        connection: &mut Connection,\n561\t        bytes: &mut [u8],\n562\t        length: usize,\n563\t        header_length: usize,\n564\t    ) -> u32;\n565\t}\n566\t\n567\t/// Direct-receive callback for streams marked with\n568\t/// `mark_direct_receive_stream`.  C:\n569\t/// `StreamDirectReceive`.  Folds `direct_receive_ctx`\n570\t/// into the implementor.\n571\tpub trait StreamDirectReceive {\n572\t    fn receive(\n573\t        &mut self,\n574\t        connection: &mut Connection,\n575\t        stream_id: u64,\n576\t        fin: bool,\n577\t        bytes: &[u8],\n578\t        offset: u64,\n579\t    ) -> i32;\n580\t}\n581\t\n582\t// ---------------------------------------------------------------------------\n583\t// Path quality and per-ack state.\n584\t\n585\t/// Per-path quality snapshot reported by\n586\t/// `get_path_quality`.  C: `PathQuality`.\n587\t#[derive(Debug, Copy, Clone)]\n588\tpub struct PathQuality {\n589\t    /// Receive rate estimate in bytes per second.\n590\t    pub receive_rate_estimate: u64,\n591\t    /// Pacing rate in bytes per second.\n592\t    pub pacing_rate: u64,\n593\t    /// Number of bytes in the congestion window.\n594\t    pub cwin: u64,\n595\t    /// Smoothed RTT estimate in microseconds.\n596\t    pub rtt: Duration,\n597\t    /// Most recent RTT sample.\n598\t    pub rtt_sample: Duration,\n599\t    /// Estimated RTT variability.\n600\t    pub rtt_variant: Duration,\n601\t    /// Minimum observed RTT since path creation.\n602\t    pub rtt_min: Duration,\n603\t    /// Maximum observed RTT since path creation.\n604\t    pub rtt_max: Duration,\n605\t    pub sent: u64,\n606\t    pub lost: u64,\n607\t    pub timer_losses: u64,\n608\t    pub spurious_losses: u64,\n609\t    pub max_spurious_rtt: Duration,\n610\t    pub max_reorder_delay: Duration,\n611\t    pub max_reorder_gap: u64,\n612\t    pub bytes_in_transit: u64,\n613\t    pub bytes_sent: u64,\n614\t    pub bytes_received: u64,\n615\t}\n616\t\n617\timpl Default for PathQuality {\n618\t    fn default() -> Self {\n619\t        Self {\n620\t            receive_rate_estimate: 0,\n621\t            pacing_rate: 0,\n622\t            cwin: 0,\n623\t            rtt: Duration::from_ticks(0),\n624\t            rtt_sample: Duration::from_ticks(0),\n625\t            rtt_variant: Duration::from_ticks(0),\n626\t            rtt_min: Duration::from_ticks(0),\n627\t            rtt_max: Duration::from_ticks(0),\n628\t            sent: 0,\n629\t            lost: 0,\n630\t            timer_losses: 0,\n631\t            spurious_losses: 0,\n632\t            max_spurious_rtt: Duration::from_ticks(0),\n633\t            max_reorder_delay: Duration::from_ticks(0),\n634\t            max_reorder_gap: 0,\n635\t            bytes_in_transit: 0,\n636\t            bytes_sent: 0,\n637\t            bytes_received: 0,\n638\t        }\n639\t    }\n640\t}\n641\t\n642\t// ---------------------------------------------------------------------------\n643\t// Datagram and congestion APIs.\n644\t\n645\t/// Datagram-readiness signalling passed to\n646\t/// [`provide_datagram_buffer_ex`].\n647\t#[derive(Debug, Copy, Clone, PartialEq, Eq, Default)]\n648\t#[repr(u8)]\n649\tpub enum DatagramActive {\n650\t    /// Application has nothing more to send.\n651\t    #[default]\n652\t    NotActive = 0,\n653\t    /// Application can send on any path.\n654\t    AnyPath = 1,\n655\t    /// Application can send only on the current path.\n656\t    ThisPathOnly = 2,\n657\t    /// Application can send on the current path *and* others.\n658\t    ThisPathAndOthers = 3,\n659\t}\n660\t\n661\t/// Default stream priority used when none is set explicitly.\n662\tpub const DEFAULT_STREAM_PRIORITY: u8 = 9;\n663\t\n664\t/// Reference packet size used as the cautious upper bound when\n665\t/// queueing datagrams before path MTU is known.  In C this is\n666\t/// defined in terms of `ENFORCED_INITIAL_MTU`, which lives\n667\t/// in the internal header.  The numeric value (1252 bytes, the IPv4\n668\t/// initial MTU floor) is duplicated here to keep the public API\n669\t/// translatable in Phase 1 — the constant will be re-exported from\n670\t/// the internal module once it is translated.\n671\tpub const DATAGRAM_QUEUE_CAUTIOUS_LENGTH: usize = INITIAL_MTU_IPV4;\n672\t\n673\t/// Congestion-control event fed to a [`CongestionControl`]\n674\t/// implementation's `alg_notify` hook.\n675\t#[derive(Debug, Copy, Clone, PartialEq, Eq)]\n676\tpub enum CongestionNotification {\n677\t    /// At least one packet was acknowledged.\n678\t    Acknowledgement,\n679\t    /// A packet was retransmitted.\n680\t    Repeat,\n681\t    /// A retransmission timer expired.\n682\t    Timeout,\n683\t    /// A retransmission was found to have been spurious.\n684\t    SpuriousRepeat,\n685\t    /// A new RTT sample is available.\n686\t    RttMeasurement,\n687\t    /// ECN-marked traffic was acknowledged.\n688\t    EcnEc,\n689\t    /// The send path is blocked by the congestion window.\n690\t    CwinBlocked,\n691\t    /// Seed the congestion window from external knowledge.\n692\t    SeedCwin,\n693\t    /// Reset congestion-control state.\n694\t    Reset,\n695\t    /// Notification of lost feedback.\n696\t    LostFeedback,\n697\t}\n698\t\n699\t/// Per-ACK state passed to the congestion-control algorithm.  C:\n700\t/// `PerAckState`.\n701\t///\n702\t/// Single-bit `unsigned int : 1` bitfields collapse to `bool`.  `pc`\n703\t/// stays an `i32` (the C field used `int` instead of the enum\n704\t/// itself to avoid include dependencies; we follow suit so the\n705\t/// translation can be checked field-by-field).\n706\t#[derive(Debug, Copy, Clone)]\n707\tpub struct PerAckState {\n708\t    pub rtt_measurement: Duration,\n709\t    pub send_delay: Duration,\n710\t    pub one_way_delay: Duration,\n711\t    pub nb_bytes_acknowledged: u64,\n712\t    pub nb_bytes_newly_lost: u64,\n713\t    pub nb_bytes_lost_since_packet_sent: u64,\n714\t    pub nb_bytes_delivered_since_packet_sent: u64,\n715\t    pub inflight_prior: u64,\n716\t    pub lost_packet_number: u64,\n717\t    pub lost_packet_sent_time: Instant,\n718\t    pub pc: i32,\n719\t    pub is_app_limited: bool,\n720\t    pub is_cwnd_limited: bool,\n721\t}\n722\t\n723\timpl Default for PerAckState {\n724\t    fn default() -> Self {\n725\t        Self {\n726\t            rtt_measurement: Duration::from_ticks(0),\n727\t            send_delay: Duration::from_ticks(0),\n728\t            one_way_delay: Duration::from_ticks(0),\n729\t            nb_bytes_acknowledged: 0,\n730\t            nb_bytes_newly_lost: 0,\n731\t            nb_bytes_lost_since_packet_sent: 0,\n732\t            nb_bytes_delivered_since_packet_sent: 0,\n733\t            inflight_prior: 0,\n734\t            lost_packet_number: 0,\n735\t            lost_packet_sent_time: Instant::from_ticks(0),\n736\t    