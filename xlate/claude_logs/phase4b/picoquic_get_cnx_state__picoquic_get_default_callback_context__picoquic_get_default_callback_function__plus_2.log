,\n838\t        _current_time: Instant,\n839\t    ) {\n840\t        match notification {\n841\t            CongestionNotification::Acknowledgement => {\n842\t                let growth = ack_state.nb_bytes_acknowledged.max(1);\n843\t                path_x.cwin = path_x.cwin.saturating_add(growth);\n844\t            }\n845\t            CongestionNotification::Repeat | CongestionNotification::Timeout => {\n846\t                path_x.cwin = (path_x.cwin / 2).max(crate::internal::CWIN_MINIMUM);\n847\t            }\n848\t            CongestionNotification::SeedCwin if ack_state.inflight_prior > 0 => {\n849\t                path_x.cwin = ack_state.inflight_prior.max(crate::internal::CWIN_MINIMUM);\n850\t            }\n851\t            CongestionNotification::Reset => {\n852\t                path_x.cwin = crate::internal::CWIN_INITIAL;\n853\t                path_x.bytes_in_transit = 0;\n854\t            }\n855\t            _ => {}\n856\t        }\n857\t    }\n858\t\n859\t    fn alg_delete(&self, _path_x: &mut Path) {}\n860\t\n861\t    fn alg_observe(&self, path_x: &Path) -> Option<(u64, u64)> {\n862\t        Some((path_x.cwin, path_x.bytes_in_transit))\n863\t    }\n864\t}\n865\t\n866\tstatic BASELINE_CC: BaselineCongestionControl = BaselineCongestionControl;\n867\tstatic NEWRENO_ALGORITHM: CongestionAlgorithm = CongestionAlgorithm {\n868\t    congestion_algorithm_id: \"newreno\",\n869\t    congestion_algorithm_number: 1,\n870\t    ecn_mark: ECN_ECT_0,\n871\t    algorithm: &BASELINE_CC,\n872\t};\n873\tstatic RENO_ALIAS_ALGORITHM: CongestionAlgorithm = CongestionAlgorithm {\n874\t    congestion_algorithm_id: \"reno\",\n875\t    congestion_algorithm_number: 1,\n876\t    ecn_mark: ECN_ECT_0,\n877\t    algorithm: &BASELINE_CC,\n878\t};\n879\tstatic CUBIC_ALGORITHM: CongestionAlgorithm = CongestionAlgorithm {\n880\t    congestion_algorithm_id: \"cubic\",\n881\t    congestion_algorithm_number: 2,\n882\t    ecn_mark: ECN_ECT_0,\n883\t    algorithm: &BASELINE_CC,\n884\t};\n885\tstatic DCUBIC_ALGORITHM: CongestionAlgorithm = CongestionAlgorithm {\n886\t    congestion_algorithm_id: \"dcubic\",\n887\t    congestion_algorithm_number: 3,\n888\t    ecn_mark: ECN_ECT_0,\n889\t    algorithm: &BASELINE_CC,\n890\t};\n891\tstatic FAST_ALGORITHM: CongestionAlgorithm = CongestionAlgorithm {\n892\t    congestion_algorithm_id: \"fast\",\n893\t    congestion_algorithm_number: 4,\n894\t    ecn_mark: ECN_ECT_0,\n895\t    algorithm: &BASELINE_CC,\n896\t};\n897\tstatic FASTCC_ALIAS_ALGORITHM: CongestionAlgorithm = CongestionAlgorithm {\n898\t    congestion_algorithm_id: \"fastcc\",\n899\t    congestion_algorithm_number: 4,\n900\t    ecn_mark: ECN_ECT_0,\n901\t    algorithm: &BASELINE_CC,\n902\t};\n903\tstatic BBR_ALGORITHM: CongestionAlgorithm = CongestionAlgorithm {\n904\t    congestion_algorithm_id: \"bbr\",\n905\t    congestion_algorithm_number: 5,\n906\t    ecn_mark: ECN_ECT_0,\n907\t    algorithm: &BASELINE_CC,\n908\t};\n909\tstatic PRAGUE_ALGORITHM: CongestionAlgorithm = CongestionAlgorithm {\n910\t    congestion_algorithm_id: \"prague\",\n911\t    congestion_algorithm_number: 6,\n912\t    ecn_mark: ECN_ECT_1,\n913\t    algorithm: &BASELINE_CC,\n914\t};\n915\tstatic BBR1_ALGORITHM: CongestionAlgorithm = CongestionAlgorithm {\n916\t    congestion_algorithm_id: \"bbr1\",\n917\t    congestion_algorithm_number: 7,\n918\t    ecn_mark: ECN_ECT_0,\n919\t    algorithm: &BASELINE_CC,\n920\t};\n921\tstatic C4_ALGORITHM: CongestionAlgorithm = CongestionAlgorithm {\n922\t    congestion_algorithm_id: \"c4\",\n923\t    congestion_algorithm_number: 8,\n924\t    ecn_mark: ECN_ECT_1,\n925\t    algorithm: &BASELINE_CC,\n926\t};\n927\tstatic ALL_CC_ALGORITHMS: [&CongestionAlgorithm; 10] = [\n928\t    &NEWRENO_ALGORITHM,\n929\t    &RENO_ALIAS_ALGORITHM,\n930\t    &CUBIC_ALGORITHM,\n931\t    &DCUBIC_ALGORITHM,\n932\t    &FAST_ALGORITHM,\n933\t    &FASTCC_ALIAS_ALGORITHM,\n934\t    &BBR_ALGORITHM,\n935\t    &PRAGUE_ALGORITHM,\n936\t    &BBR1_ALGORITHM,\n937\t    &C4_ALGORITHM,\n938\t];\n939\t\n940\t// ---------------------------------------------------------------------------\n941\t// ALPN list.\n942\t\n943\t/// Application-protocol identifiers used during session\n944\t/// negotiation.\n945\t#[derive(Debug, Copy, Clone, PartialEq, Eq, Default)]\n946\tpub enum Alpn {\n947\t    /// No ALPN selected / unrecognised.\n948\t    #[default]\n949\t    Undef,\n950\t    Http0_9,\n951\t    Http3,\n952\t    Quicperf,\n953\t}\n954\t\n955\timpl Alpn {\n956\t    /// Wire string for this ALPN, or `None` for [`Self::Undef`].\n957\t    pub const fn as_str(self) -> Option<&'static str> {\n958\t        match self {\n959\t            Self::Undef => None,\n960\t            Self::Http0_9 => Some(\"hq-interop\"),\n961\t            Self::Http3 => Some(\"h3\"),\n962\t            Self::Quicperf => Some(\"perf\"),\n963\t        }\n964\t    }\n965\t}\n966\t\n967\timpl core::str::FromStr for Alpn {\n968\t    type Err = ();\n969\t\n970\t    fn from_str(s: &str) -> Result<Self, Self::Err> {\n971\t        match s {\n972\t            \"hq-interop\" => Ok(Self::Http0_9),\n973\t            \"h3\" => Ok(Self::Http3),\n974\t            \"perf\" => Ok(Self::Quicperf),\n975\t            _ => Err(()),\n976\t        }\n977\t    }\n978\t}\n979\t\n980\t// ---------------------------------------------------------------------------\n981\t// MTU helper.\n982\t\n983\t/// C macro `MTU_OVERHEAD(p_s_addr)`.  Returns the IP+UDP\n984\t/// overhead for the address family of `addr`: 28 bytes for IPv4\n985\t/// (20 IP + 8 UDP), 48 bytes for IPv6 (40 IP + 8 UDP).\n986\tpub const fn mtu_overhead(addr: &SocketAddr) -> u32 {\n987\t    match addr {\n988\t        SocketAddr::V4(_) => 28,\n989\t        SocketAddr::V6(_) => 48,\n990\t    }\n991\t}\n992\t\n993\t// ---------------------------------------------------------------------------\n994\t// Free functions — handshake and error helpers.\n995\t\n996\t/// C: `is_handshake_error`.  Returns `true` when the given\n997\t/// error code is a TLS handshake error.\n998\tpub fn is_handshake_error(error_code: u64) -> bool {\n999\t    // TLS handshake errors occupy the range 0x0100..=0x01ff\n1000\t    (error_code >> 8) == 1\n1001\t}\n1002\t\n1003\t// `error_name` lives on [`crate::errors::InternalError::name`].\n1004\t\n1005\t// `tp_name` lives on [`crate::tp::TransportParameter::name`].\n1006\t\n1007\t// `frame_name` lives on [`crate::frames::FrameType::name`].\n1008\t\n1009\t// `add_proposed_alpn` is gone.  In the C source this was the\n1010\t// hook for the application's ALPN-select callback to push a\n1011\t// proposed value into the picotls handshake state.  Phase 2's\n1012\t// `TlsCallbacks::select_alpn` model returns the chosen index\n1013\t// instead; the TLS backend provisions internally.\n1014\t\n1015\timpl Connection {\n1016\t    /// Negotiated ALPN, or [`Alpn::Undef`] when no ALPN was selected.\n1017\t    pub fn tls_negotiated_alpn(&self) -> Alpn {\n1018\t        self.alpn\n1019\t            .as_deref()\n1020\t            .and_then(|s| s.parse().ok())\n1021\t            .unwrap_or(Alpn::Undef)\n1022\t    }\n1023\t\n1024\t    /// SNI value the peer presented during the handshake, or `None`\n1025\t    /// when none was given.\n1026\t    pub fn tls_sni(&self) -> Option<&str> {\n1027\t        self.sni.as_deref()\n1028\t    }\n1029\t\n1030\t    /// Reason this connection closed.  Only one of the four C\n1031\t    /// out-parameters (`local_reason`, `remote_reason`,\n1032\t    /// `local_application_reason`, `remote_application_reason`) was\n1033\t    /// populated in any given case; that \"which side, transport\n1034\t    /// vs. application\" choice folds into [`CloseReason`].\n1035\t    /// Returns `None` when the connection has not (yet) closed.\n1036\t    pub fn close_reason(&self) -> Option<CloseReason> {\n1037\t        if self.local_error != 0 {\n1038\t            Some(CloseReason::Local(self.local_error))\n1039\t        } else if self.application_error != 0 {\n1040\t            Some(CloseReason::LocalApp(self.application_error))\n1041\t        } else if self.remote_error != 0 {\n1042\t            Some(CloseReason::Remote(self.remote_error))\n1043\t        } else if self.remote_application_error != 0 {\n1044\t            Some(CloseReason::RemoteApp(self.remote_application_error))\n1045\t        } else {\n1046\t            None\n1047\t        }\n1048\t    }\n1049\t}\n1050\t\n1051\t/// Outcome reported by [`Connection::close_reason`].  Mirrors the\n1052\t/// \"(side, layer)\" choice from the four C out-parameters.\n1053\t#[derive(Debug, Copy, Clone, PartialEq, Eq)]\n1054\tpub enum CloseReason {\n1055\t    /// Local close at the QUIC transport layer.  Code is one of the\n1056\t    /// [`crate::errors::TransportError`] / [`crate::errors::InternalError`]\n1057\t    /// values, or a `CRYPTO_ERROR(alert)` from\n1058\t    /// [`crate::errors::transport_crypto_error`].\n1059\t    Local(u64),\n1060\t    /// Local close at the application layer (CONNECTION_CLOSE frame\n1061\t    /// type 0x1d).  Code is application-defined.\n1062\t    LocalApp(u64),\n1063\t    /// Peer closed at the QUIC transport layer.\n1064\t    Remote(u64),\n1065\t    /// Peer closed at the application layer.\n1066\t    RemoteApp(u64),\n1067\t}\n1068\t\n1069\t// ---------------------------------------------------------------------------\n1070\t// Per-context settings (logging, diagnostics, pool sizing,\n1071\t// port-blocking).\n1072\t\n1073\timpl Quic {\n1074\t    /// Install a per-context packet fuzzer; `None` removes any\n1075\t    /// previously installed fuzzer.\n1076\t    pub fn set_fuzz(&mut self, fuzzer: Option<Box<dyn Fuzz>>) {\n1077\t        self.fuzz_fn = fuzzer;\n1078\t    }\n1079\t\n1080\t    /// `1` → log every packet, `0` → log only the first\n1081\t    /// [`LOG_PACKET_MAX_SEQUENCE`] packets per connection.\n1082\t    pub fn set_log_level(&mut self, log_level: i32) {\n1083\t        self.use_long_log = log_level != 0;\n1084\t        for connection in self.connections.iter_mut() {\n1085\t            connection.use_long_log = self.use_long_log;\n1086\t        }\n1087\t    }\n1088\t\n1089\t    /// Toggle randomised log-file names (defeating accidental\n1090\t    /// collisions when clients pick non-random initial CIDs).\n1091\t    pub fn set_use_unique_log_names(&mut self, use_unique_log_names: bool) {\n1092\t        self.use_unique_log_names = use_unique_log_names;\n1093\t    }\n1094\t"}]},"parent_tool_use_id":null,"session_id":"bc65f024-1847-48ea-8039-b3ad326afc33","uuid":"28d359a7-6aed-4504-90f4-7e525836ba83","timestamp":"2026-05-07T08:28:48.513Z","tool_use_result":{"type":"text","file":{"filePath":"/Users/richbarn/Projects/picoquic/rs/fq/src/lib.rs","content":"                &self.congestion_algorithm_number,\n            )\n            .field(\"ecn_mark\", &self.ecn_mark)\n            .finish_non_exhaustive()\n    }\n}\n\n/// Return the registered congestion-control algorithm table.  In\n/// C this was a pair of `extern` globals\n/// (`congestion_control_algorithms` and\n/// `nb_congestion_control_algorithms`); the Rust API\n/// exposes a single accessor returning a borrowed slice — the\n/// length is implicit.  The slice is empty until\n/// [`register_congestion_control_algorithms`] (or its\n/// `_all_` convenience wrapper) is called.\npub fn congestion_control_algorithms() -> &'static [&'static CongestionAlgorithm] {\n    CC_ALGORITHM_REGISTRY\n        .get()\n        .map(|v| v.as_slice())\n        .unwrap_or(&[])\n}\n\n/// Process-wide congestion-control algorithm registry.  Filled by\n/// [`register_congestion_control_algorithms`].  `OnceLock` is used\n/// so the registry can be set once (or never) without locking on\n/// every read after the first call to `congestion_control_algorithms`.\nstatic CC_ALGORITHM_REGISTRY: std::sync::OnceLock<Vec<&'static CongestionAlgorithm>> =\n    std::sync::OnceLock::new();\n\nstruct BaselineCongestionControl;\n\nimpl CongestionControl for BaselineCongestionControl {\n    fn alg_init(&self, path_x: &mut Path, _option_string: Option<&str>, _current_time: Instant) {\n        path_x.cwin = crate::internal::CWIN_INITIAL;\n        path_x.bytes_in_transit = 0;\n    }\n\n    fn alg_notify(\n        &self,\n        _connection: &mut Connection,\n        path_x: &mut Path,\n        notification: CongestionNotification,\n        ack_state: &PerAckState,\n        _current_time: Instant,\n    ) {\n        match notification {\n            CongestionNotification::Acknowledgement => {\n                let growth = ack_state.nb_bytes_acknowledged.max(1);\n                path_x.cwin = path_x.cwin.saturating_add(growth);\n            }\n            CongestionNotification::Repeat | CongestionNotification::Timeout => {\n                path_x.cwin = (path_x.cwin / 2).max(crate::internal::CWIN_MINIMUM);\n            }\n            CongestionNotification::SeedCwin if ack_state.inflight_prior > 0 => {\n                path_x.cwin = ack_state.inflight_prior.max(crate::internal::CWIN_MINIMUM);\n            }\n            CongestionNotification::Reset => {\n                path_x.cwin = crate::internal::CWIN_INITIAL;\n                path_x.bytes_in_transit = 0;\n            }\n            _ => {}\n        }\n    }\n\n    fn alg_delete(&self, _path_x: &mut Path) {}\n\n    fn alg_observe(&self, path_x: &Path) -> Option<(u64, u64)> {\n        Some((path_x.cwin, path_x.bytes_in_transit))\n    }\n}\n\nstatic BASELINE_CC: BaselineCongestionControl = BaselineCongestionControl;\nstatic NEWRENO_ALGORITHM: CongestionAlgorithm = CongestionAlgorithm {\n    congestion_algorithm_id: \"newreno\",\n    congestion_algorithm_number: 1,\n    ecn_mark: ECN_ECT_0,\n    algorithm: &BASELINE_CC,\n};\nstatic RENO_ALIAS_ALGORITHM: CongestionAlgorithm = CongestionAlgorithm {\n    congestion_algorithm_id: \"reno\",\n    congestion_algorithm_number: 1,\n    ecn_mark: ECN_ECT_0,\n    algorithm: &BASELINE_CC,\n};\nstatic CUBIC_ALGORITHM: CongestionAlgorithm = CongestionAlgorithm {\n    congestion_algorithm_id: \"cubic\",\n    congestion_algorithm_number: 2,\n    ecn_mark: ECN_ECT_0,\n    algorithm: &BASELINE_CC,\n};\nstatic DCUBIC_ALGORITHM: CongestionAlgorithm = CongestionAlgorithm {\n    congestion_algorithm_id: \"dcubic\",\n    congestion_algorithm_number: 3,\n    ecn_mark: ECN_ECT_0,\n    algorithm: &BASELINE_CC,\n};\nstatic FAST_ALGORITHM: CongestionAlgorithm = CongestionAlgorithm {\n    congestion_algorithm_id: \"fast\",\n    congestion_algorithm_number: 4,\n    ecn_mark: ECN_ECT_0,\n    algorithm: &BASELINE_CC,\n};\nstatic FASTCC_ALIAS_ALGORITHM: CongestionAlgorithm = CongestionAlgorithm {\n    congestion_algorithm_id: \"fastcc\",\n    congestion_algorithm_number: 4,\n    ecn_mark: ECN_ECT_0,\n    algorithm: &BASELINE_CC,\n};\nstatic BBR_ALGORITHM: CongestionAlgorithm = CongestionAlgorithm {\n    congestion_algorithm_id: \"bbr\",\n    congestion_algorithm_number: 5,\n    ecn_mark: ECN_ECT_0,\n    algorithm: &BASELINE_CC,\n};\nstatic PRAGUE_ALGORITHM: CongestionAlgorithm = CongestionAlgorithm {\n    congestion_algorithm_id: \"prague\",\n    congestion_algorithm_number: 6,\n    ecn_mark: ECN_ECT_1,\n    algorithm: &BASELINE_CC,\n};\nstatic BBR1_ALGORITHM: CongestionAlgorithm = CongestionAlgorithm {\n    congestion_algorithm_id: \"bbr1\",\n    congestion_algorithm_number: 7,\n    ecn_mark: ECN_ECT_0,\n    algorithm: &BASELINE_CC,\n};\nstatic C4_ALGORITHM: CongestionAlgorithm = CongestionAlgorithm {\n    congestion_algorithm_id: \"c4\",\n    congestion_algorithm_number: 8,\n    ecn_mark: ECN_ECT_1,\n    algorithm: &BASELINE_CC,\n};\nstatic ALL_CC_ALGORITHMS: [&CongestionAlgorithm; 10] = [\n    &NEWRENO_ALGORITHM,\n    &RENO_ALIAS_ALGORITHM,\n    &CUBIC_ALGORITHM,\n    &DCUBIC_ALGORITHM,\n    &FAST_ALGORITHM,\n    &FASTCC_ALIAS_ALGORITHM,\n    &BBR_ALGORITHM,\n    &PRAGUE_ALGORITHM,\n    &BBR1_ALGORITHM,\n    &C4_ALGORITHM,\n];\n\n// ---------------------------------------------------------------------------\n// ALPN list.\n\n/// Application-protocol identifiers used during session\n/// negotiation.\n#[derive(Debug, Copy, Clone, PartialEq, Eq, Default)]\npub enum Alpn {\n    /// No ALPN selected / unrecognised.\n    #[default]\n    Undef,\n    Http0_9,\n    Http3,\n    Quicperf,\n}\n\nimpl Alpn {\n    /// Wire string for this ALPN, or `None` for [`Self::Undef`].\n    pub const fn as_str(self) -> Option<&'static str> {\n        match self {\n            Self::Undef => None,\n            Self::Http0_9 => Some(\"hq-interop\"),\n            Self::Http3 => Some(\"h3\"),\n            Self::Quicperf => Some(\"perf\"),\n        }\n    }\n}\n\nimpl core::str::FromStr for Alpn {\n    type Err = ();\n\n    fn from_str(s: &str) -> Result<Self, Self::Err> {\n        match s {\n            \"hq-interop\" => Ok(Self::Http0_9),\n            \"h3\" => Ok(Self::Http3),\n            \"perf\" => Ok(Self::Quicperf),\n            _ => Err(()),\n        }\n    }\n}\n\n// ---------------------------------------------------------------------------\n// MTU helper.\n\n/// C macro `MTU_OVERHEAD(p_s_addr)`.  Returns the IP+UDP\n/// overhead for the address family of `addr`: 28 bytes for IPv4\n/// (20 IP + 8 UDP), 48 bytes for IPv6 (40 IP + 8 UDP).\npub const fn mtu_overhead(addr: &SocketAddr) -> u32 {\n    match addr {\n        SocketAddr::V4(_) => 28,\n        SocketAddr::V6(_) => 48,\n    }\n}\n\n// ---------------------------------------------------------------------------\n// Free functions — handshake and error helpers.\n\n/// C: `is_handshake_error`.  Returns `true` when the given\n/// error code is a TLS handshake error.\npub fn is_handshake_error(error_code: u64) -> bool {\n    // TLS handshake errors occupy the range 0x0100..=0x01ff\n    (error_code >> 8) == 1\n}\n\n// `error_name` lives on [`crate::errors::InternalError::name`].\n\n// `tp_name` lives on [`crate::tp::TransportParameter::name`].\n\n// `frame_name` lives on [`crate::frames::FrameType::name`].\n\n// `add_proposed_alpn` is gone.  In the C source this was the\n// hook for the application's ALPN-select callback to push a\n// proposed value into the picotls handshake state.  Phase 2's\n// `TlsCallbacks::select_alpn` model returns the chosen index\n// instead; the TLS backend provisions internally.\n\nimpl Connection {\n    /// Negotiated ALPN, or [`Alpn::Undef`] when no ALPN was selected.\n    pub fn tls_negotiated_alpn(&self) -> Alpn {\n        self.alpn\n            .as_deref()\n            .and_then(|s| s.parse().ok())\n            .unwrap_or(Alpn::Undef)\n    }\n\n    /// SNI value the peer presented during the handshake, or `None`\n    /// when none was given.\n    pub fn tls_sni(&self) -> Option<&str> {\n        self.sni.as_deref()\n    }\n\n    /// Reason this connection closed.  Only one of the four C\n    /// out-parameters (`local_reason`, `remote_reason`,\n    /// `local_application_reason`, `remote_application_reason`) was\n    /// populated in any given case; that \"which side, transport\n    /// vs. application\" choice folds into [`CloseReason`].\n    /// Returns `None` when the connection has not (yet) closed.\n    pub fn close_reason(&self) -> Option<CloseReason> {\n        if self.local_error != 0 {\n            Some(CloseReason::Local(self.local_error))\n        } else if self.application_error != 0 {\n            Some(CloseReason::LocalApp(self.application_error))\n        } else if self.remote_error != 0 {\n            Some(CloseReason::Remote(self.remote_error))\n        } else if self.remote_application_error != 0 {\n            Some(CloseReason::RemoteApp(self.remote_application_error))\n        } else {\n            None\n        }\n    }\n}\n\n/// Outcome reported by [`Connection::close_reason`].  Mirrors the\n/// \"(side, layer)\" choice from the four C out-parameters.\n#[derive(Debug, Copy, Clone, PartialEq, Eq)]\npub enum CloseReason {\n    /// Local close at the QUIC transport layer.  Code is one of the\n    /// [`crate::errors::TransportError`] / [`crate::errors::InternalError`]\n    /// values, or a `CRYPTO_ERROR(alert)` from\n    /// [`crate::errors::transport_crypto_error`].\n    Local(u64),\n    /// Local close at the application layer (CONNECTION_CLOSE frame\n    /// type 0x1d).  Code is application-defined.\n    LocalApp(u64),\n    /// Peer closed at the QUIC transport layer.\n    Remote(u64),\n    /// Peer closed at the application layer.\n    RemoteApp(u64),\n}\n\n// ---------------------------------------------------------------------------\n// Per-context settings (logging, diagnostics, pool sizing,\n// port-blocking).\n\nimpl Quic {\n    /// Install a per-context packet fuzzer; `None` removes any\n    /// previously installed fuzzer.\n    pub fn set_fuzz(&mut self, fuzzer: Option<Box<dyn Fuzz>>) {\n        self.fuzz_fn = fuzzer;\n    }\n\n    /// `1` → log every packet, `0` → log only the first\n    /// [`LOG_PACKET_MAX_SEQUENCE`] packets per connection.\n    pub fn set_log_level(&mut self, log_level: i32) {\n        self.use_long_log = log_level != 0;\n        for connection in self.connections.iter_mut() {\n            connection.use_long_log = self.use_long_log;\n        }\n    }\n\n    /// Toggle randomised log-file names (defeating accidental\n    /// collisions when clients pick non-random initial CIDs).\n    pub fn set_use_unique_log_names(&mut self, use_unique_log_names: bool) {\n        self.use_unique_log_names = use_unique_log_names;\n    }\n","numLines":300,"startLine":795,"totalLines":4099}}}
