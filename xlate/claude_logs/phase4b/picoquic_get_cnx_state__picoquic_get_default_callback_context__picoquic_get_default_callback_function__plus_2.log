tes.len()` exceeds [`CONNECTION_ID_MAX_SIZE`].\n346\t    pub fn clone_from_slice(bytes: &[u8]) -> Option<Self> {\n347\t        if bytes.len() > CONNECTION_ID_MAX_SIZE {\n348\t            return None;\n349\t        }\n350\t        let mut id = [0u8; CONNECTION_ID_MAX_SIZE];\n351\t        id[..bytes.len()].copy_from_slice(bytes);\n352\t        Some(Self {\n353\t            id,\n354\t            id_len: bytes.len() as u8,\n355\t        })\n356\t    }\n357\t\n358\t    /// Construct a zero-filled connection id of length `len`.\n359\t    /// Returns `None` when `len` exceeds [`CONNECTION_ID_MAX_SIZE`].\n360\t    pub fn with_size(len: usize) -> Option<Self> {\n361\t        if len > CONNECTION_ID_MAX_SIZE {\n362\t            return None;\n363\t        }\n364\t        Some(Self {\n365\t            id: [0u8; CONNECTION_ID_MAX_SIZE],\n366\t            id_len: len as u8,\n367\t        })\n368\t    }\n369\t\n370\t    /// Borrow the live id bytes (`bytes[..len]`).\n371\t    pub fn as_bytes(&self) -> &[u8] {\n372\t        &self.id[..self.id_len as usize]\n373\t    }\n374\t\n375\t    /// Mutable borrow of the live id bytes.\n376\t    pub fn as_bytes_mut(&mut self) -> &mut [u8] {\n377\t        &mut self.id[..self.id_len as usize]\n378\t    }\n379\t\n380\t    /// Number of bytes in the id.\n381\t    pub fn len(&self) -> usize {\n382\t        self.id_len as usize\n383\t    }\n384\t\n385\t    /// `true` when the id has zero length.  Mirrors the C\n386\t    /// `is_connection_id_null` sentinel check.\n387\t    pub fn is_empty(&self) -> bool {\n388\t        self.id_len == 0\n389\t    }\n390\t\n391\t    /// Hash with a 16-byte seed.  C: `connection_id_hash`.\n392\t    pub fn hash_with_seed(&self, seed: &[u8; 16]) -> u64 {\n393\t        crate::siphash::siphash(self.as_bytes(), seed)\n394\t    }\n395\t\n396\t    /// Fold the first up-to-8 bytes of the id into a `u64`.\n397\t    /// C: `val64_connection_id`.\n398\t    pub fn val64(&self) -> u64 {\n399\t        let bytes = self.as_bytes();\n400\t        let len = bytes.len().min(8);\n401\t        let mut buf = [0u8; 8];\n402\t        buf[..len].copy_from_slice(&bytes[..len]);\n403\t        u64::from_be_bytes(buf)\n404\t    }\n405\t}\n406\t\n407\t// ---------------------------------------------------------------------------\n408\t// IO vectors.\n409\t//\n410\t// The C `picoquic_iovec_t` (and the picotls-side `PtlsIovec*` that\n411\t// aliased it) are gone — every place that used to take an iovec\n412\t// pair now takes a `&[u8]` (single buffer) or `&[&[u8]]` /\n413\t// `Vec<Vec<u8>>` (list of buffers), per the project's\n414\t// \"use Rust's slice/vec types\" policy.\n415\t\n416\t// ---------------------------------------------------------------------------\n417\t// Opaque types (forward declarations).\n418\t//\n419\t// `Quic`, `Connection`, and `Path` are\n420\t// defined in `internal.h`.  Phase 1 declares them as empty\n421\t// structs so callers can refer to them; the real layout lands when\n422\t// the internal header is translated.  The `_opaque` field prevents\n423\t// callers from constructing one accidentally, and the `Debug` impl\n424\t// gives the structs a printable shape for log lines.\n425\t\n426\t// Full bodies live in `crate::internal`; pull them in for use within\n427\t// this module's signatures (no re-export — callers reach them as\n428\t// `crate::internal::*`).\n429\tuse crate::internal::{Connection, Path, Quic};\n430\t\n431\t// ---------------------------------------------------------------------------\n432\t// Application callback events.\n433\t\n434\t/// Event type passed to the application's stream / connection\n435\t/// callback (see [`StreamDataCallback`]).  Identifies which sort of\n436\t/// notification the stack is delivering — stream data, lifecycle\n437\t/// transition, datagram event, path event, etc.\n438\t#[derive(Debug, Copy, Clone, PartialEq, Eq)]\n439\tpub enum CallbackEvent {\n440\t    StreamData = 0,\n441\t    StreamFin,\n442\t    StreamReset,\n443\t    StopSending,\n444\t    StatelessReset,\n445\t    Close,\n446\t    ApplicationClose,\n447\t    StreamGap,\n448\t    PrepareToSend,\n449\t    AlmostReady,\n450\t    Ready,\n451\t    Datagram,\n452\t    VersionNegotiation,\n453\t    RequestAlpnList,\n454\t    SetAlpn,\n455\t    PacingChanged,\n456\t    PrepareDatagram,\n457\t    DatagramAcked,\n458\t    DatagramLost,\n459\t    DatagramSpurious,\n460\t    PathAvailable,\n461\t    PathSuspended,\n462\t    PathDeleted,\n463\t    PathQualityChanged,\n464\t    PathAddressObserved,\n465\t    AppWakeup,\n466\t    NextPathAllowed,\n467\t}\n468\t\n469\t// Transport-parameter shapes live in [`crate::tp`].\n470\t\n471\t// Stream-id decomposition lives on [`crate::stream::StreamId`].\n472\t\n473\t// ---------------------------------------------------------------------------\n474\t// Time management.\n475\t\n476\t/// Wall-clock microseconds since the Unix epoch.\n477\t///\n478\t/// The C body reads the OS clock; in Rust this requires the `std`\n479\t/// feature (`std::time::SystemTime`).  The `cfg`-gated split lands\n480\t/// when the crate gains its `std` feature and the rest of the\n481\t/// `no_std + alloc` plumbing.\n482\tpub fn current_time() -> u64 {\n483\t    use std::time::{SystemTime, UNIX_EPOCH};\n484\t    SystemTime::now()\n485\t        .duration_since(UNIX_EPOCH)\n486\t        .map(|d| d.as_micros() as u64)\n487\t        .unwrap_or(0)\n488\t}\n489\t\n490\timpl Quic {\n491\t    /// Virtual time used by this QUIC context (wall-clock or\n492\t    /// simulated, depending on whether a simulated-time pointer was\n493\t    /// supplied at creation).  C: `get_quic_time`.\n494\t    pub fn time(&self) -> u64 {\n495\t        current_time()\n496\t    }\n497\t}\n498\t\n499\t// ---------------------------------------------------------------------------"}]},"parent_tool_use_id":null,"session_id":"bc65f024-1847-48ea-8039-b3ad326afc33","uuid":"5cf6d87f-5aad-4ff1-9c3a-b0995bfa2e15","timestamp":"2026-05-07T08:27:46.113Z","tool_use_result":{"type":"t