{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_015CrLow1eLvTC4GC6kZPZyY","type":"tool_result","content":"100\t// API takes them as `uint64_t error_code` parameters and returns\n101\t// them in `get_local_error` etc.\n102\t\n103\t/// Library version string.  C: `VERSION`.\n104\tpub const VERSION: &str = \"1.1.48.0\";\n105\t\n106\t/// Crate-level error type for fallible operations.\n107\t///\n108\t/// Phase 4 implementations return specific variants based on the C\n109\t/// control flow.  The initial variant set covers the broad failure\n110\t/// shapes; additional variants may be added as needed.  Marked\n111\t/// `#[non_exhaustive]` so adding\n112\t/// variants later isn't a breaking change.\n113\t#[derive(Debug, Clone, Copy, PartialEq, Eq)]\n114\t#[non_exhaustive]\n115\tpub enum Error {\n116\t    /// Catch-all for C paths that collapse to a generic failure.\n117\t    Generic,\n118\t    /// Allocation failed.\n119\t    Memory,\n120\t    /// Caller supplied an invalid argument.\n121\t    InvalidArgument,\n122\t    /// A buffer the caller supplied was too small.\n123\t    BufferTooSmall,\n124\t    /// Caller-supplied file does not exist.\n125\t    NoSuchFile,\n126\t    /// Caller-supplied file was malformed.\n127\t    InvalidFile,\n128\t    /// Connection has been disconnected.\n129\t    Disconnected,\n130\t    /// Connection state didn't permit the requested operation.\n131\t    InvalidState,\n132\t    /// Operation produced or received a malformed QUIC frame.\n133\t    InvalidFrame,\n134\t    /// TLS / crypto error.\n135\t    Tls,\n136\t    /// Other QUIC protocol error; the wrapped value is the\n137\t    /// numeric `ERROR_*` code defined in this module.\n138\t    Protocol(u64),\n139\t}\n140\t\n141\timpl core::fmt::Display for Error {\n142\t    fn fmt(&self, f: &mut core::fmt::Formatter<'_>) -> core::fmt::Result {\n143\t        write!(f, \"{:?}\", self)\n144\t    }\n145\t}\n146\t\n147\timpl core::error::Error for Error {}\n148\t\n149\t/// Crate-wide `Result` alias defaulting the error type to [`Error`].\n150\tpub type Result<T, E = Error> = core::result::Result<T, E>;\n151\t\n152\t/// Wall-clock instant in microseconds since some application-defined\n153\t/// epoch.  Replaces the C `uint64_t current_time` parameter that\n154\t/// threads through every API call needing \"now\".  The type is\n155\t/// `Copy`, supports arithmetic with [`Duration`], and converts to\n156\t/// `u64` cheaply via `.ticks()` when crossing wire boundaries.\n157\t///\n158\t/// Phase 2 decision: per-call `current_time: Instant` parameters\n159\t/// stay (matches the C source's design — caller decides what time\n160\t/// it is).  No `Clock` trait at the library level; applications\n161\t/// can build a clock-injecting wrapper around the calls if they\n162\t/// want that style.\n163\tpub type Instant = fugit::Instant<u64, 1, 1_000_000>;\n164\t\n165\t/// Duration in microseconds.  Companion to [`Instant`].  Use for\n166\t/// timeouts, RTTs, jitter, etc.  In the C source these are bare\n167\t/// `uint64_t` values labelled by context (`idle_timeout`,\n168\t/// `microsec_latency`, …); the typed alias makes the unit explicit.\n169\tpub type Duration = fugit::Duration<u64, 1, 1_000_000>;\n170\t\n171\t// Error codes (picoquic-internal `ERROR_*` and protocol-defined\n172\t// `TRANSPORT_*` / TLS-alert) live as enums in [`crate::errors`].\n173\tpub use errors::{InternalError, TransportError};\n174\t\n175\t// ---------------------------------------------------------------------------\n176\t// Packet sizes and miscellaneous constants.\n177\t\n178\tpub const MAX_PACKET_SIZE: usize = 1536;\n179\tpub const INITIAL_MTU_IPV4: usize = 1252;\n180\tpub const INITIAL_MTU_IPV6: usize = 1232;\n181\tpub const RESET_SECRET_SIZE: usize = 16;\n182\tpub const RESET_PACKET_PAD_SIZE: usize = 23;\n183\tpub const RESET_PACKET_MIN_SIZE: usize = RESET_PACKET_PAD_SIZE + RESET_SECRET_SIZE;\n184\tpub const MAX_CRYPTO_BUFFER_GAP: usize = 16384;\n185\t\n186\tpub const LOG_PACKET_MAX_SEQUENCE: u32 = 100;\n187\t\n188\t/// First 4 bytes of `SHA256(\"QUIC Masque\")`.  Used as a sentinel\n189\t/// interface index where no real OS interface is meaningful.\n190\tpub const RESERVED_IF_INDEX: u32 = 0x09cb8ed3;\n191\t\n192\t// TLS cipher-suite identifiers (IANA).\n193\tpub const AES_128_GCM_SHA256: u16 = 0x1301;\n194\tpub const AES_256_GCM_SHA384: u16 = 0x1302;\n195\tpub const CHACHA20_POLY1305_SHA256: u16 = 0x1303;\n196\t\n197\tpub const GROUP_SECP256R1: u16 = 23;\n198\t\n199\t// ECN code points for the IP header `tos` byte.\n200\tpub const ECN_ECT_0: u8 = 0x02;\n201\tpub const ECN_ECT_1: u8 = 0x01;\n202\tpub const ECN_CE: u8 = 0x03;\n203\t\n204\t/// C macro `FOURCC(a, b, c, d)`.  Produces a 32-bit code from four\n205\t/// bytes in little-endian order.\n206\tpub const fn fourcc(a: u8, b: u8, c: u8, d: u8) -> u32 {\n207\t    u32::from_le_bytes([a, b, c, d])\n208\t}\n209\t\n210\t// ---------------------------------------------------------------------------\n211\t// Connection state.\n212\t\n213\t/// Connection-state machine, listing the QUIC connection states a\n214\t/// `Connection` walks through from initial handshake to teardown.\n215\t/// Discriminants follow the declaration order of the C `state_enum`.\n216\t#[derive(Debug, Copy, Clone, PartialEq, Eq, PartialOrd, Ord)]\n217\tpub enum State {\n218\t    ClientInit,\n219\t    ClientInitSent,\n220\t    ClientRenegotiate,\n221\t    ClientRetryReceived,\n222\t    ClientInitResent,\n223\t    ServerInit,\n224\t    ServerHandshake,\n225\t    ClientHandshakeStart,\n226\t    HandshakeFailure,\n227\t    HandshakeFailureResend,\n228\t    ClientAlmostReady,\n229\t    ServerFalseStart,\n230\t    ServerAlmostReady,\n231\t    ClientReadyStart,\n232\t    Ready,\n233\t    Disconnecting,\n234\t    ClosingReceived,\n235\t    Closing,\n236\t    Draining,\n237\t    Disconnected,\n238\t}\n239\t\n240\t// `TransportParameter`, `PreferredAddress`, `VersionNegotiation`,\n241\t// `TransportParameters`, and `TransportParameter0RttKind` live in\n242\t// [`crate::tp`].\n243\t\n244\t// ---------------------------------------------------------------------------\n245\t// Packet contexts and enumerated policy types.\n246\t\n247\t/// Encryption-level packet context.  Each value selects one of the\n248\t/// three QUIC packet-number spaces (Initial, Handshake, 1-RTT).\n249\t/// The C enum's trailing `nb_packet_context` count is exposed as\n250\t/// the [`NB_PACKET_CONTEXT`] constant below.\n251\t#[derive(Debug, Copy, Clone, PartialEq, Eq)]\n252\t#[repr(u8)]\n253\tpub enum PacketContext {\n254\t    Application = 0,\n255\t    Handshake = 1,\n256\t    Initial = 2,\n257\t}\n258\t\n259\t/// Number of packet contexts (matches the variant count of\n260\t/// [`PacketContext`]).\n261\tpub const NB_PACKET_CONTEXT: usize = 3;\n262\t\n263\t/// Path-MTU-discovery policy for a connection.\n264\t#[derive(Debug, Copy, Clone, PartialEq, Eq, Default)]\n265\t#[repr(u8)]\n266\tpub enum PmtudPolicy {\n267\t    /// Default opportunistic PMTUD.\n268\t    #[default]\n269\t    Basic = 0,\n270\t    /// Force PMTUD as soon as possible.\n271\t    Required = 1,\n272\t    /// Only do PMTUD if a lot of data has to be sent.\n273\t    Delayed = 2,\n274\t    /// Never do PMTUD.\n275\t    Blocked = 3,\n276\t}\n277\t\n278\t/// Spin-bit variant policy.\n279\t#[derive(Debug, Copy, Clone, PartialEq, Eq, Default)]\n280\t#[repr(u8)]\n281\tpub enum SpinbitVersion {\n282\t    /// Default behaviour, per the spin-bit draft.\n283\t    #[default]\n284\t    Basic = 0,\n285\t    /// Randomise per packet.\n286\t    Random = 1,\n287\t    /// Null behaviour, randomised per path.\n288\t    Null = 2,\n289\t    /// Test-only \"always on\" mode.  Not valid as a per-connection\n290\t    /// override (server only; see [`Quic::set_default_spinbit_policy`]).\n291\t    On = 3,\n292\t}\n293\t\n294\t/// Loss-bit support level.\n295\t#[derive(Debug, Copy, Clone, PartialEq, Eq, Default)]\n296\t#[repr(u8)]\n297\tpub enum LossbitVersion {\n298\t    /// Loss bits disabled.\n299\t    #[default]"}]},"parent_tool_use_id":null,"session_id":"bc65f024-1847-48ea-8039-b3ad326afc33","uuid":"0ce9c88b-d765-4e7b-8626-cbe8ab683791","timestamp":"2026-05-07T08:27:36.913Z","tool_use_result":{"type":"text","file":{"filePath":"/Users/richbarn/Projects/picoquic/rs/fq/src/lib.rs","content":"// API takes them as `uint64_t error_code` parameters and returns\n// them in `get_local_error` etc.\n\n/// Library version string.  C: `VERSION`.\npub const VERSION: &str = \"1.1.48.0\";\n\n/// Crate-level error type for fallible operations.\n///\n/// Phase 4 implementations return specific variants based on the C\n/// control flow.  The initial variant set covers the broad failure\n/// shapes; additional variants may be added as needed.  Marked\n/// `#[non_exhaustive]` so adding\n/// variants later isn't a breaking change.\n#[derive(Debug, Clone, Copy, PartialEq, Eq)]\n#[non_exhaustive]\npub enum Error {\n    /// Catch-all for C paths that collapse to a generic failure.\n    Generic,\n    /// Allocation failed.\n    Memory,\n    /// Caller supplied an invalid argument.\n    InvalidArgument,\n    /// A buffer the caller supplied was too small.\n    BufferTooSmall,\n    /// Caller-supplied file does not exist.\n    NoSuchFile,\n    /// Caller-supplied file was malformed.\n    InvalidFile,\n    /// Connection has been disconnected.\n    Disconnected,\n    /// Connection state didn't permit the requested operation.\n    InvalidState,\n    /// Operation produced or received a malformed QUIC frame.\n    InvalidFrame,\n    /// TLS / crypto error.\n    Tls,\n    /// Other QUIC protocol error; the wrapped value is the\n    /// numeric `ERROR_*` code defined in this module.\n    Protocol(u64),\n}\n\nimpl core::fmt::Display for Error {\n    fn fmt(&self, f: &mut core::fmt::Formatter<'_>) -> core::fmt::Result {\n        write!(f, \"{:?}\", self)\n    }\n}\n\nimpl core::error::Error for Error {}\n\n/// Crate-wide `Result` alias defaulting the error type to [`Error`].\npub type Result<T, E = Error> = core::result::Result<T, E>;\n\n/// Wall-clock instant in microseconds since some application-defined\n/// epoch.  Replaces the C `uint64_t current_time` parameter that\n/// threads through every API call needing \"now\".  The type is\n/// `Copy`, supports arithmetic with [`Duration`], and converts to\n/// `u64` cheaply via `.ticks()` when crossing wire boundaries.\n///\n/// Phase 2 decision: per-call `current_time: Instant` parameters\n/// stay (matches the C source's design — caller decides what time\n/// it is).  No `Clock` trait at the library level; applications\n/// can build a clock-injecting wrapper around the calls if they\n/// want that style.\npub type Instant = fugit::Instant<u64, 1, 1_000_000>;\n\n/// Duration in microseconds.  Companion to [`Instant`].  Use for\n/// timeouts, RTTs, jitter, etc.  In the C source these are bare\n/// `uint64_t` values labelled by context (`idle_timeout`,\n/// `microsec_latency`, …); the typed alias makes the unit explicit.\npub type Duration = fugit::Duration<u64, 1, 1_000_000>;\n\n// Error codes (picoquic-internal `ERROR_*` and protocol-defined\n// `TRANSPORT_*` / TLS-alert) live as enums in [`crate::errors`].\npub use errors::{InternalError, TransportError};\n\n// ---------------------------------------------------------------------------\n// Packet sizes and miscellaneous constants.\n\npub const MAX_PACKET_SIZE: usize = 1536;\npub const INITIAL_MTU_IPV4: usize = 1252;\npub const INITIAL_MTU_IPV6: usize = 1232;\npub const RESET_SECRET_SIZE: usize = 16;\npub const RESET_PACKET_PAD_SIZE: usize = 23;\npub const RESET_PACKET_MIN_SIZE: usize = RESET_PACKET_PAD_SIZE + RESET_SECRET_SIZE;\npub const MAX_CRYPTO_BUFFER_GAP: usize = 16384;\n\npub const LOG_PACKET_MAX_SEQUENCE: u32 = 100;\n\n/// First 4 bytes of `SHA256(\"QUIC Masque\")`.  Used as a sentinel\n/// interface index where no real OS interface is meaningful.\npub const RESERVED_IF_INDEX: u32 = 0x09cb8ed3;\n\n// TLS cipher-suite identifiers (IANA).\npub const AES_128_GCM_SHA256: u16 = 0x1301;\npub const AES_256_GCM_SHA384: u16 = 0x1302;\npub const CHACHA20_POLY1305_SHA256: u16 = 0x1303;\n\npub const GROUP_SECP256R1: u16 = 23;\n\n// ECN code points for the IP header `tos` byte.\npub const ECN_ECT_0: u8 = 0x02;\npub const ECN_ECT_1: u8 = 0x01;\npub const ECN_CE: u8 = 0x03;\n\n/// C macro `FOURCC(a, b, c, d)`.  Produces a 32-bit code from four\n/// bytes in little-endian order.\npub const fn fourcc(a: u8, b: u8, c: u8, d: u8) -> u32 {\n    u32::from_le_bytes([a, b, c, d])\n}\n\n// ---------------------------------------------------------------------------\n// Connection state.\n\n/// Connection-state machine, listing the QUIC connection states a\n/// `Connection` walks through from initial handshake to teardown.\n/// Discriminants follow the declaration order of the C `state_enum`.\n#[derive(Debug, Copy, Clone, PartialEq, Eq, PartialOrd, Ord)]\npub enum State {\n    ClientInit,\n    ClientInitSent,\n    ClientRenegotiate,\n    ClientRetryReceived,\n    ClientInitResent,\n    ServerInit,\n    ServerHandshake,\n    ClientHandshakeStart,\n    HandshakeFailure,\n    HandshakeFailureResend,\n    ClientAlmostReady,\n    ServerFalseStart,\n    ServerAlmostReady,\n    ClientReadyStart,\n    Ready,\n    Disconnecting,\n    ClosingReceived,\n    Closing,\n    Draining,\n    Disconnected,\n}\n\n// `TransportParameter`, `PreferredAddress`, `VersionNegotiation`,\n// `TransportParameters`, and `TransportParameter0RttKind` live in\n// [`crate::tp`].\n\n// ---------------------------------------------------------------------------\n// Packet contexts and enumerated policy types.\n\n/// Encryption-level packet context.  Each value selects one of the\n/// three QUIC packet-number spaces (Initial, Handshake, 1-RTT).\n/// The C enum's trailing `nb_packet_context` count is exposed as\n/// the [`NB_PACKET_CONTEXT`] constant below.\n#[derive(Debug, Copy, Clone, PartialEq, Eq)]\n#[repr(u8)]\npub enum PacketContext {\n    Application = 0,\n    Handshake = 1,\n    Initial = 2,\n}\n\n/// Number of packet contexts (matches the variant count of\n/// [`PacketContext`]).\npub const NB_PACKET_CONTEXT: usize = 3;\n\n/// Path-MTU-discovery policy for a connection.\n#[derive(Debug, Copy, Clone, PartialEq, Eq, Default)]\n#[repr(u8)]\npub enum PmtudPolicy {\n    /// Default opportunistic PMTUD.\n    #[default]\n    Basic = 0,\n    /// Force PMTUD as soon as possible.\n    Required = 1,\n    /// Only do PMTUD if a lot of data has to be sent.\n    Delayed = 2,\n    /// Never do PMTUD.\n    Blocked = 3,\n}\n\n/// Spin-bit variant policy.\n#[derive(Debug, Copy, Clone, PartialEq, Eq, Default)]\n#[repr(u8)]\npub enum SpinbitVersion {\n    /// Default behaviour, per the spin-bit draft.\n    #[default]\n    Basic = 0,\n    /// Randomise per packet.\n    Random = 1,\n    /// Null behaviour, randomised per path.\n    Null = 2,\n    /// Test-only \"always on\" mode.  Not valid as a per-connection\n    /// override (server only; see [`Quic::set_default_spinbit_policy`]).\n    On = 3,\n}\n\n/// Loss-bit support level.\n#[derive(Debug, Copy, Clone, PartialEq, Eq, Default)]\n#[repr(u8)]\npub enum LossbitVersion {\n    /// Loss bits disabled.\n    #[default]","numLines":200,"startLine":100,"totalLines":4099}}}
