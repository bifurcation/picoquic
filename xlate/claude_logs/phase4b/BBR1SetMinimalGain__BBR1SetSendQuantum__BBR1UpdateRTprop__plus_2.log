{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01YXijNGqamKxJBgteqXUB8e","type":"tool_result","content":"1\t//! Translation of `picoquic/bbr1.c` — BBRv1 congestion control.\n2\t//!\n3\t//! Phase 4B: initial batch (BBR1AfterOneRoundtripInFastRecovery,\n4\t//! BBR1CheckFullPipe, BBR1EnterProbeRTT, BBR1EnterStartup).\n5\t//! Phase 4B missing batch (BBR1EnterStartupLongRTT, BBR1GetBtlBW,\n6\t//! BBR1ModulateCwndForProbeRTT, BBR1ModulateCwndForRecovery, BBR1RestoreCwnd).\n7\t\n8\tuse crate::cc_common::MinMaxRtt;\n9\tuse crate::internal::{CWIN_INITIAL, Path, TARGET_RENO_RTT, TARGET_SATELLITE_RTT};\n10\t\n11\t// ---------------------------------------------------------------------------\n12\t// Constants from bbr1.c `#define`s.\n13\t\n14\tconst BBR1_HIGH_GAIN: f64 = 2.8853900817779; // C: BBR1_HIGH_GAIN (2/ln(2))\n15\tconst BBR1_BTL_BW_FILTER_LENGTH: usize = 10; // C: BBR1_BTL_BW_FILTER_LENGTH\n16\t\n17\t// ---------------------------------------------------------------------------\n18\t// Algorithm-state enum.  C: `picoquic_bbr1_alg_state_t`.\n19\t\n20\t#[derive(Debug, Copy, Clone, PartialEq, Eq, Default)]\n21\tpub enum Bbr1AlgState {\n22\t    #[default]\n23\t    Startup = 0,\n24\t    Drain,\n25\t    ProbeBw,\n26\t    ProbeRtt,\n27\t    StartupLongRtt,\n28\t}\n29\t\n30\t// ---------------------------------------------------------------------------\n31\t// BBR1 state.  C: `picoquic_bbr1_state_t`.\n32\t//\n33\t// Type deviations from C:\n34\t//   * single-bit `unsigned int x : 1` bitfields → `bool`\n35\t//   * `const char* option_string` → `Option<String>` (owned copy)\n36\t//   * `picoquic_min_max_rtt_t rtt_filter` → `MinMaxRtt`\n37\t//   * `int` round/count fields → `i32` (faithfully signed)\n38\t\n39\tpub struct Bbr1State {\n40\t    pub state: Bbr1AlgState,\n41\t    pub btl_bw: u64,\n42\t    pub next_round_delivered: u64,\n43\t    pub btl_bw_filter: [u64; BBR1_BTL_BW_FILTER_LENGTH],\n44\t    pub full_bw: u64,\n45\t    pub rt_prop: u64,\n46\t    pub rt_prop_stamp: u64,\n47\t    pub cycle_stamp: u64,\n48\t    pub probe_rtt_done_stamp: u64,\n49\t    pub prior_cwnd: u64,\n50\t    pub prior_in_flight: u64,\n51\t    pub bytes_delivered: u64,\n52\t    pub send_quantum: u64,\n53\t    pub rtt_filter: MinMaxRtt,\n54\t    pub target_cwnd: u64,\n55\t    pub pacing_gain: f64,\n56\t    pub cwnd_gain: f64,\n57\t    pub pacing_rate: f64,\n58\t    pub cycle_index: u32,\n59\t    pub cycle_start: u32,\n60\t    pub round_count: i32,\n61\t    pub full_bw_count: i32,\n62\t    pub lt_rtt_cnt: i32,\n63\t    pub lt_bw: u64,\n64\t    pub lt_last_stamp: u64,\n65\t    pub previous_round_lost: u64,\n66\t    pub previous_sampling_delivered: u64,\n67\t    pub previous_sampling_lost: u64,\n68\t    pub loss_interval_start: u64,\n69\t    pub congestion_sequence: u64,\n70\t    pub cwin_before_suspension: u64,\n71\t    pub option_string: Option<String>,\n72\t    pub wifi_shadow_rtt: u64,\n73\t    pub quantum_ratio: f64,\n74\t    pub filled_pipe: bool,\n75\t    pub round_start: bool,\n76\t    pub rt_prop_expired: bool,\n77\t    pub probe_rtt_round_done: bool,\n78\t    pub idle_restart: bool,\n79\t    pub packet_conservation: bool,\n80\t    pub btl_bw_increased: bool,\n81\t    pub lt_use_bw: bool,\n82\t    pub lt_is_sampling: bool,\n83\t    pub last_loss_was_timeout: bool,\n84\t    pub cycle_on_loss: bool,\n85\t    pub is_suspended: bool,\n86\t    pub is_suspension_nearly_over: bool,\n87\t}\n88\t\n89\timpl Bbr1State {\n90\t    /// C: `BBR1EnterStartup` (picoquic/bbr1.c:327)\n91\t    ///\n92\t    /// Enter the Startup state with the high-gain pacing and cwnd multipliers.\n93\t    pub fn enter_startup(&mut self) {\n94\t        self.state = Bbr1AlgState::Startup;\n95\t        self.pacing_gain = BBR1_HIGH_GAIN;\n96\t        self.cwnd_gain = BBR1_HIGH_GAIN;\n97\t    }\n98\t\n99\t    /// C: `BBR1CheckFullPipe` (picoquic/bbr1.c:771)\n100\t    ///\n101\t    /// Detect when the pipe is full during Startup.  On each round start\n102\t    /// (unless app-limited or already detected), check whether `btl_bw`\n103\t    /// has grown by ≥ 25%.  After three consecutive rounds without\n104\t    /// sufficient growth, set `filled_pipe`.\n105\t    pub fn check_full_pipe(&mut self, rs_is_app_limited: bool) {\n106\t        if !self.filled_pipe && self.round_start && !rs_is_app_limited {\n107\t            if self.btl_bw as f64 >= self.full_bw as f64 * 1.25 {\n108\t                self.full_bw = self.btl_bw;\n109\t                self.full_bw_count = 0;\n110\t            } else {\n111\t                self.full_bw_count += 1;\n112\t                if self.full_bw_count >= 3 {\n113\t                    self.filled_pipe = true;\n114\t                }\n115\t            }\n116\t        }\n117\t    }\n118\t\n119\t    /// C: `BBR1EnterProbeRTT` (picoquic/bbr1.c:885)\n120\t    ///\n121\t    /// Enter ProbeRTT state: coast at unity gains to drain the queue and\n122\t    /// obtain a fresh minimum-RTT sample.\n123\t    pub fn enter_probe_rtt(&mut self) {\n124\t        self.state = Bbr1AlgState::ProbeRtt;\n125\t        self.pacing_gain = 1.0;\n126\t        self.cwnd_gain = 1.0;\n127\t    }\n128\t\n129\t    /// C: `BBR1AfterOneRoundtripInFastRecovery` (picoquic/bbr1.c:1107)\n130\t    ///\n131\t    /// After the first full round-trip in fast recovery, disable packet\n132\t    /// conservation so the congestion window can grow normally again.\n133\t    pub fn after_one_roundtrip_in_fast_recovery(&mut self) {\n134\t        self.packet_conservation = false;\n135\t    }\n136\t\n137\t    /// C: `BBR1GetBtlBW` (picoquic/bbr1.c:304)\n138\t    ///\n139\t    /// Return the effective bottleneck bandwidth: the long-term estimate when\n140\t    /// `lt_use_bw` is set, otherwise the filter-max `btl_bw`.\n141\t    fn get_btl_bw(&self) -> u64 {\n142\t        if self.lt_use_bw {\n143\t            self.lt_bw\n144\t        } else {\n145\t            self.btl_bw\n146\t        }\n147\t    }\n148\t\n149\t    /// C: `BBR1EnterStartupLongRTT` (picoquic/bbr1.c:309)\n150\t    ///\n151\t    /// Switch into `StartupLongRtt` state and ensure `cwin` is at least\n152\t    /// `CWIN_INITIAL` scaled by the path RTT (capped at the satellite ceiling).\n153\t    pub fn enter_startup_long_rtt(&mut self, path_x: &mut Path) {\n154\t        let mut cwnd = CWIN_INITIAL;\n155\t        self.state = Bbr1AlgState::StartupLongRtt;\n156\t        if path_x.rtt_min > TARGET_RENO_RTT {\n157\t            let rtt_cap = if path_x.rtt_min > TARGET_SATELLITE_RTT {\n158\t                TARGET_SATELLITE_RTT\n159\t            } else {\n160\t                path_x.rtt_min\n161\t            };\n162\t            cwnd = (cwnd as f64 * rtt_cap.ticks() as f64 / TARGET_RENO_RTT.ticks() as f64) as u64;\n163\t        }\n164\t        if cwnd > path_x.cwin {\n165\t            path_x.cwin = cwnd;\n166\t        }\n167\t    }\n168\t\n169\t    /// C: `BBR1RestoreCwnd` (picoquic/bbr1.c:918)\n170\t    ///\n171\t    /// Restore `cwin` to `prior_cwnd` if the current window has shrunk below it.\n172\t    pub fn restore_cwnd(&self, path_x: &mut Path) {\n173\t        if path_x.cwin < self.prior_cwnd {\n174\t            path_x.cwin = self.prior_cwnd;\n175\t        }\n176\t    }\n177\t\n178\t    /// C: `BBR1ModulateCwndForRecovery` (picoquic/bbr1.c:996)\n179\t    ///\n180\t    /// Adjust `cwin` for the recovery phase: subtract lost bytes (floored at\n181\t    /// one MTU), then enforce packet-conservation if active.\n182\t    pub fn modulate_cwnd_for_recovery(\n183\t        &mut self,\n184\t        path_x: &mut Path,\n185\t        bytes_in_transit: u64,\n186\t        bytes_lost: u64,\n187\t        bytes_delivered: u64,\n188\t    ) {\n189\t        if bytes_lost > 0 {\n190\t            if path_x.cwin > bytes_lost {\n191\t                path_x.cwin -= bytes_lost;\n192\t            } else {\n193\t                path_x.cwin = path_x.send_mtu as u64;\n194\t            }\n195\t        }\n196\t        if self.packet_conservation && path_x.cwin < bytes_in_transit + bytes_delivered {\n197\t            path_x.cwin = bytes_in_transit + bytes_delivered;\n198\t        }\n199\t    }\n200\t\n201\t    /// C: `BBR1ModulateCwndForProbeRTT` (picoquic/bbr1.c:1015)\n202\t    ///\n203\t    /// While in `ProbeRtt`, cap `cwin` at `BBR1_MIN_PIPE_CWND` (4 × MTU) so\n204\t    /// the queue drains and a fresh minimum-RTT sample can be obtained.\n205\t    pub fn modulate_cwnd_for_probe_rtt(&self, path_x: &mut Path) {\n206\t        if self.state == Bbr1AlgState::ProbeRtt {\n207\t            let min_pipe = path_x.send_mtu as u64 * 4;\n208\t            if path_x.cwin > min_pipe {\n209\t                path_x.cwin = min_pipe;\n210\t            }\n211\t        }\n212\t    }\n213\t}\n214\t\n215\t#[cfg(test)]\n216\tmod tests {\n217\t    use super::*;\n218\t\n219\t    fn make_state() -> Bbr1State {\n220\t        Bbr1State {\n221\t            state: Bbr1AlgState::default(),\n222\t            btl_bw: 0,\n223\t            next_round_delivered: 0,\n224\t            btl_bw_filter: [0; BBR1_BTL_BW_FILTER_LENGTH],\n225\t            full_bw: 0,\n226\t            rt_prop: 0,\n227\t            rt_prop_stamp: 0,\n228\t            cycle_stamp: 0,\n229\t            probe_rtt_done_stamp: 0,\n230\t            prior_cwnd: 0,\n231\t            prior_in_flight: 0,\n232\t            bytes_delivered: 0,\n233\t            send_quantum: 0,\n234\t            rtt_filter: MinMaxRtt::default(),\n235\t            target_cwnd: 0,\n236\t            pacing_gain: 1.0,\n237\t            cwnd_gain: 1.0,\n238\t            pacing_rate: 0.0,\n239\t            cycle_index: 0,\n240\t            cycle_start: 0,\n241\t            round_count: 0,\n242\t            full_bw_count: 0,\n243\t            lt_rtt_cnt: 0,\n244\t            lt_bw: 0,\n245\t            lt_last_stamp: 0,\n246\t            previous_round_lost: 0,\n247\t            previous_sampling_delivered: 0,\n248\t            previous_sampling_lost: 0,\n249\t            loss_interval_start: 0,\n250\t            congestion_sequence: 0,\n251\t            cwin_before_suspension: 0,\n252\t            option_string: None,\n253\t            wifi_shadow_rtt: 0,\n254\t            quantum_ratio: 0.001,\n255\t            filled_pipe: false,\n256\t            round_start: false,\n257\t            rt_prop_expired: false,\n258\t            probe_rtt_round_done: false,\n259\t            idle_restart: false,\n260\t            packet_conservation: false,\n261\t            btl_bw_increased: false,\n262\t            lt_use_bw: false,\n263\t            lt_is_sampling: false,\n264\t            last_loss_was_timeout: false,\n265\t            cycle_on_loss: false,\n266\t            is_suspended: false,\n267\t            is_suspension_nearly_over: false,\n268\t        }\n269\t    }\n270\t\n271\t    #[test]\n272\t    fn enter_startup_sets_state_and_gains() {\n273\t        let mut s = make_state();\n274\t        s.enter_startup();\n275\t        assert_eq!(s.state, Bbr1AlgState::Startup);\n276\t        assert!((s.pacing_gain - BBR1_HIGH_GAIN).abs() < f64::EPSILON);\n277\t        assert!((s.cwnd_gain - BBR1_HIGH_GAIN).abs() < f64::EPSILON);\n278\t    }\n279\t\n280\t    #[test]\n281\t    fn check_full_pipe_growing_resets_count() {\n282\t        let mut s = make_state();\n283\t        s.round_start = true;\n284\t        s.full_bw = 1000;\n285\t        s.btl_bw = 1300; // >= 1.25 * 1000\n286\t        s.check_full_pipe(false);\n287\t        assert_eq!(s.full_bw, 1300);\n288\t        assert_eq!(s.full_bw_count, 0);\n289\t        assert!(!s.filled_pipe);\n290\t    }\n291\t\n292\t    #[test]\n293\t    fn check_full_pipe_fills_after_3_stall_rounds() {\n294\t        let mut s = make_state();\n295\t        s.round_start = true;\n296\t        s.full_bw = 1000;\n297\t        s.btl_bw = 900; // < 1.25 * 1000\n298\t        s.check_full_pipe(false);\n299\t        assert_eq!(s.full_bw_count, 1);\n300\t        assert!(!s.filled_pipe);\n301\t        s.check_full_pipe(false);\n302\t        assert_eq!(s.full_bw_count, 2);\n303\t        s.check_full_pipe(false);\n304\t        assert_eq!(s.full_bw_count, 3);\n305\t        assert!(s.filled_pipe);\n306\t    }\n307\t\n308\t    #[test]\n309\t    fn check_full_pipe_skips_when_app_limited() {\n310\t        let mut s = make_state();\n311\t        s.round_start = true;\n312\t        s.full_bw = 1000;\n313\t        s.btl_bw = 900;\n314\t        s.check_full_pipe(true); // app-limited → skip\n315\t        assert_eq!(s.full_bw_count, 0);\n316\t        assert!(!s.filled_pipe);\n317\t    }\n318\t\n319\t    #[test]\n320\t    fn check_full_pipe_skips_when_already_filled() {\n321\t        let mut s = make_state();\n322\t        s.round_start = true;\n323\t        s.filled_pipe = true;\n324\t        s.full_bw = 1000;\n325\t        s.btl_bw = 900;\n326\t        s.check_full_pipe(false);\n327\t        assert_eq!(s.full_bw_count, 0); // guard skips the body\n328\t    }\n329\t\n330\t    #[test]\n331\t    fn enter_probe_rtt_sets_state_and_unity_gains() {\n332\t        let mut s = make_state();\n333\t        s.enter_probe_rtt();\n334\t        assert_eq!(s.state, Bbr1AlgState::ProbeRtt);\n335\t        assert!((s.pacing_gain - 1.0).abs() < f64::EPSILON);\n336\t        assert!((s.cwnd_gain - 1.0).abs() < f64::EPSILON);\n337\t    }\n338\t\n339\t    #[test]\n340\t    fn after_one_roundtrip_clears_packet_conservation() {\n341\t        let mut s = make_state();\n342\t        s.packet_conservation = true;\n343\t        s.after_one_roundtrip_in_fast_recovery();\n344\t        assert!(!s.packet_conservation);\n345\t    }\n346\t\n347\t    // --- BBR1GetBtlBW ---\n348\t\n349\t    #[test]\n350\t    fn get_btl_bw_uses_lt_bw_when_flag_set() {\n351\t        let mut s = make_state();\n352\t        s.btl_bw = 1_000_000;\n353\t        s.lt_bw = 500_000;\n354\t        s.lt_use_bw = true;\n355\t        assert_eq!(s.get_btl_bw(), 500_000);\n356\t    }\n357\t\n358\t    #[test]\n359\t    fn get_btl_bw_uses_btl_bw_when_flag_clear() {\n360\t        let mut s = make_state();\n361\t        s.btl_bw = 1_000_000;\n362\t        s.lt_bw = 500_000;\n363\t        s.lt_use_bw = false;\n364\t        assert_eq!(s.get_btl_bw(), 1_000_000);\n365\t    }\n366\t}\n367\t"}]},"parent_tool_use_id":null,"session_id":"a7e13982-2be8-47de-a038-35b3593cd08a","uuid":"fd80a0b5-58fb-4154-9232-0ebd336103f7","timestamp":"2026-05-07T05:15:49.871Z","tool_use_result":{"type":"text","file":{"filePath":"/Users/richbarn/Projects/picoquic/rs/fq/src/bbr1.rs","content":"//! Translation of `picoquic/bbr1.c` — BBRv1 congestion control.\n//!\n//! Phase 4B: initial batch (BBR1AfterOneRoundtripInFastRecovery,\n//! BBR1CheckFullPipe, BBR1EnterProbeRTT, BBR1EnterStartup).\n//! Phase 4B missing batch (BBR1EnterStartupLongRTT, BBR1GetBtlBW,\n//! BBR1ModulateCwndForProbeRTT, BBR1ModulateCwndForRecovery, BBR1RestoreCwnd).\n\nuse crate::cc_common::MinMaxRtt;\nuse crate::internal::{CWIN_INITIAL, Path, TARGET_RENO_RTT, TARGET_SATELLITE_RTT};\n\n// ---------------------------------------------------------------------------\n// Constants from bbr1.c `#define`s.\n\nconst BBR1_HIGH_GAIN: f64 = 2.8853900817779; // C: BBR1_HIGH_GAIN (2/ln(2))\nconst BBR1_BTL_BW_FILTER_LENGTH: usize = 10; // C: BBR1_BTL_BW_FILTER_LENGTH\n\n// ---------------------------------------------------------------------------\n// Algorithm-state enum.  C: `picoquic_bbr1_alg_state_t`.\n\n#[derive(Debug, Copy, Clone, PartialEq, Eq, Default)]\npub enum Bbr1AlgState {\n    #[default]\n    Startup = 0,\n    Drain,\n    ProbeBw,\n    ProbeRtt,\n    StartupLongRtt,\n}\n\n// ---------------------------------------------------------------------------\n// BBR1 state.  C: `picoquic_bbr1_state_t`.\n//\n// Type deviations from C:\n//   * single-bit `unsigned int x : 1` bitfields → `bool`\n//   * `const char* option_string` → `Option<String>` (owned copy)\n//   * `picoquic_min_max_rtt_t rtt_filter` → `MinMaxRtt`\n//   * `int` round/count fields → `i32` (faithfully signed)\n\npub struct Bbr1State {\n    pub state: Bbr1AlgState,\n    pub btl_bw: u64,\n    pub next_round_delivered: u64,\n    pub btl_bw_filter: [u64; BBR1_BTL_BW_FILTER_LENGTH],\n    pub full_bw: u64,\n    pub rt_prop: u64,\n    pub rt_prop_stamp: u64,\n    pub cycle_stamp: u64,\n    pub probe_rtt_done_stamp: u64,\n    pub prior_cwnd: u64,\n    pub prior_in_flight: u64,\n    pub bytes_delivered: u64,\n    pub send_quantum: u64,\n    pub rtt_filter: MinMaxRtt,\n    pub target_cwnd: u64,\n    pub pacing_gain: f64,\n    pub cwnd_gain: f64,\n    pub pacing_rate: f64,\n    pub cycle_index: u32,\n    pub cycle_start: u32,\n    pub round_count: i32,\n    pub full_bw_count: i32,\n    pub lt_rtt_cnt: i32,\n    pub lt_bw: u64,\n    pub lt_last_stamp: u64,\n    pub previous_round_lost: u64,\n    pub previous_sampling_delivered: u64,\n    pub previous_sampling_lost: u64,\n    pub loss_interval_start: u64,\n    pub congestion_sequence: u64,\n    pub cwin_before_suspension: u64,\n    pub option_string: Option<String>,\n    pub wifi_shadow_rtt: u64,\n    pub quantum_ratio: f64,\n    pub filled_pipe: bool,\n    pub round_start: bool,\n    pub rt_prop_expired: bool,\n    pub probe_rtt_round_done: bool,\n    pub idle_restart: bool,\n    pub packet_conservation: bool,\n    pub btl_bw_increased: bool,\n    pub lt_use_bw: bool,\n    pub lt_is_sampling: bool,\n    pub last_loss_was_timeout: bool,\n    pub cycle_on_loss: bool,\n    pub is_suspended: bool,\n    pub is_suspension_nearly_over: bool,\n}\n\nimpl Bbr1State {\n    /// C: `BBR1EnterStartup` (picoquic/bbr1.c:327)\n    ///\n    /// Enter the Startup state with the high-gain pacing and cwnd multipliers.\n    pub fn enter_startup(&mut self) {\n        self.state = Bbr1AlgState::Startup;\n        self.pacing_gain = BBR1_HIGH_GAIN;\n        self.cwnd_gain = BBR1_HIGH_GAIN;\n    }\n\n    /// C: `BBR1CheckFullPipe` (picoquic/bbr1.c:771)\n    ///\n    /// Detect when the pipe is full during Startup.  On each round start\n    /// (unless app-limited or already detected), check whether `btl_bw`\n    /// has grown by ≥ 25%.  After three consecutive rounds without\n    /// sufficient growth, set `filled_pipe`.\n    pub fn check_full_pipe(&mut self, rs_is_app_limited: bool) {\n        if !self.filled_pipe && self.round_start && !rs_is_app_limited {\n            if self.btl_bw as f64 >= self.full_bw as f64 * 1.25 {\n                self.full_bw = self.btl_bw;\n                self.full_bw_count = 0;\n            } else {\n                self.full_bw_count += 1;\n                if self.full_bw_count >= 3 {\n                    self.filled_pipe = true;\n                }\n            }\n        }\n    }\n\n    /// C: `BBR1EnterProbeRTT` (picoquic/bbr1.c:885)\n    ///\n    /// Enter ProbeRTT state: coast at unity gains to drain the queue and\n    /// obtain a fresh minimum-RTT sample.\n    pub fn enter_probe_rtt(&mut self) {\n        self.state = Bbr1AlgState::ProbeRtt;\n        self.pacing_gain = 1.0;\n        self.cwnd_gain = 1.0;\n    }\n\n    /// C: `BBR1AfterOneRoundtripInFastRecovery` (picoquic/bbr1.c:1107)\n    ///\n    /// After the first full round-trip in fast recovery, disable packet\n    /// conservation so the congestion window can grow normally again.\n    pub fn after_one_roundtrip_in_fast_recovery(&mut self) {\n        self.packet_conservation = false;\n    }\n\n    /// C: `BBR1GetBtlBW` (picoquic/bbr1.c:304)\n    ///\n    /// Return the effective bottleneck bandwidth: the long-term estimate when\n    /// `lt_use_bw` is set, otherwise the filter-max `btl_bw`.\n    fn get_btl_bw(&self) -> u64 {\n        if self.lt_use_bw {\n            self.lt_bw\n        } else {\n            self.btl_bw\n        }\n    }\n\n    /// C: `BBR1EnterStartupLongRTT` (picoquic/bbr1.c:309)\n    ///\n    /// Switch into `StartupLongRtt` state and ensure `cwin` is at least\n    /// `CWIN_INITIAL` scaled by the path RTT (capped at the satellite ceiling).\n    pub fn enter_startup_long_rtt(&mut self, path_x: &mut Path) {\n        let mut cwnd = CWIN_INITIAL;\n        self.state = Bbr1AlgState::StartupLongRtt;\n        if path_x.rtt_min > TARGET_RENO_RTT {\n            let rtt_cap = if path_x.rtt_min > TARGET_SATELLITE_RTT {\n                TARGET_SATELLITE_RTT\n            } else {\n                path_x.rtt_min\n            };\n            cwnd = (cwnd as f64 * rtt_cap.ticks() as f64 / TARGET_RENO_RTT.ticks() as f64) as u64;\n        }\n        if cwnd > path_x.cwin {\n            path_x.cwin = cwnd;\n        }\n    }\n\n    /// C: `BBR1RestoreCwnd` (picoquic/bbr1.c:918)\n    ///\n    /// Restore `cwin` to `prior_cwnd` if the current window has shrunk below it.\n    pub fn restore_cwnd(&self, path_x: &mut Path) {\n        if path_x.cwin < self.prior_cwnd {\n            path_x.cwin = self.prior_cwnd;\n        }\n    }\n\n    /// C: `BBR1ModulateCwndForRecovery` (picoquic/bbr1.c:996)\n    ///\n    /// Adjust `cwin` for the recovery phase: subtract lost bytes (floored at\n    /// one MTU), then enforce packet-conservation if active.\n    pub fn modulate_cwnd_for_recovery(\n        &mut self,\n        path_x: &mut Path,\n        bytes_in_transit: u64,\n        bytes_lost: u64,\n        bytes_delivered: u64,\n    ) {\n        if bytes_lost > 0 {\n            if path_x.cwin > bytes_lost {\n                path_x.cwin -= bytes_lost;\n            } else {\n                path_x.cwin = path_x.send_mtu as u64;\n            }\n        }\n        if self.packet_conservation && path_x.cwin < bytes_in_transit + bytes_delivered {\n            path_x.cwin = bytes_in_transit + bytes_delivered;\n        }\n    }\n\n    /// C: `BBR1ModulateCwndForProbeRTT` (picoquic/bbr1.c:1015)\n    ///\n    /// While in `ProbeRtt`, cap `cwin` at `BBR1_MIN_PIPE_CWND` (4 × MTU) so\n    /// the queue drains and a fresh minimum-RTT sample can be obtained.\n    pub fn modulate_cwnd_for_probe_rtt(&self, path_x: &mut Path) {\n        if self.state == Bbr1AlgState::ProbeRtt {\n            let min_pipe = path_x.send_mtu as u64 * 4;\n            if path_x.cwin > min_pipe {\n                path_x.cwin = min_pipe;\n            }\n        }\n    }\n}\n\n#[cfg(test)]\nmod tests {\n    use super::*;\n\n    fn make_state() -> Bbr1State {\n        Bbr1State {\n            state: Bbr1AlgState::default(),\n            btl_bw: 0,\n            next_round_delivered: 0,\n            btl_bw_filter: [0; BBR1_BTL_BW_FILTER_LENGTH],\n            full_bw: 0,\n            rt_prop: 0,\n            rt_prop_stamp: 0,\n            cycle_stamp: 0,\n            probe_rtt_done_stamp: 0,\n            prior_cwnd: 0,\n            prior_in_flight: 0,\n            bytes_delivered: 0,\n            send_quantum: 0,\n            rtt_filter: MinMaxRtt::default(),\n            target_cwnd: 0,\n            pacing_gain: 1.0,\n            cwnd_gain: 1.0,\n            pacing_rate: 0.0,\n            cycle_index: 0,\n            cycle_start: 0,\n            round_count: 0,\n            full_bw_count: 0,\n            lt_rtt_cnt: 0,\n            lt_bw: 0,\n            lt_last_stamp: 0,\n            previous_round_lost: 0,\n            previous_sampling_delivered: 0,\n            previous_sampling_lost: 0,\n            loss_interval_start: 0,\n            congestion_sequence: 0,\n            cwin_before_suspension: 0,\n            option_string: None,\n            wifi_shadow_rtt: 0,\n            quantum_ratio: 0.001,\n            filled_pipe: false,\n            round_start: false,\n            rt_prop_expired: false,\n            probe_rtt_round_done: false,\n            idle_restart: false,\n            packet_conservation: false,\n            btl_bw_increased: false,\n            lt_use_bw: false,\n            lt_is_sampling: false,\n            last_loss_was_timeout: false,\n            cycle_on_loss: false,\n            is_suspended: false,\n            is_suspension_nearly_over: false,\n        }\n    }\n\n    #[test]\n    fn enter_startup_sets_state_and_gains() {\n        let mut s = make_state();\n        s.enter_startup();\n        assert_eq!(s.state, Bbr1AlgState::Startup);\n        assert!((s.pacing_gain - BBR1_HIGH_GAIN).abs() < f64::EPSILON);\n        assert!((s.cwnd_gain - BBR1_HIGH_GAIN).abs() < f64::EPSILON);\n    }\n\n    #[test]\n    fn check_full_pipe_growing_resets_count() {\n        let mut s = make_state();\n        s.round_start = true;\n        s.full_bw = 1000;\n        s.btl_bw = 1300; // >= 1.25 * 1000\n        s.check_full_pipe(false);\n        assert_eq!(s.full_bw, 1300);\n        assert_eq!(s.full_bw_count, 0);\n        assert!(!s.filled_pipe);\n    }\n\n    #[test]\n    fn check_full_pipe_fills_after_3_stall_rounds() {\n        let mut s = make_state();\n        s.round_start = true;\n        s.full_bw = 1000;\n        s.btl_bw = 900; // < 1.25 * 1000\n        s.check_full_pipe(false);\n        assert_eq!(s.full_bw_count, 1);\n        assert!(!s.filled_pipe);\n        s.check_full_pipe(false);\n        assert_eq!(s.full_bw_count, 2);\n        s.check_full_pipe(false);\n        assert_eq!(s.full_bw_count, 3);\n        assert!(s.filled_pipe);\n    }\n\n    #[test]\n    fn check_full_pipe_skips_when_app_limited() {\n        let mut s = make_state();\n        s.round_start = true;\n        s.full_bw = 1000;\n        s.btl_bw = 900;\n        s.check_full_pipe(true); // app-limited → skip\n        assert_eq!(s.full_bw_count, 0);\n        assert!(!s.filled_pipe);\n    }\n\n    #[test]\n    fn check_full_pipe_skips_when_already_filled() {\n        let mut s = make_state();\n        s.round_start = true;\n        s.filled_pipe = true;\n        s.full_bw = 1000;\n        s.btl_bw = 900;\n        s.check_full_pipe(false);\n        assert_eq!(s.full_bw_count, 0); // guard skips the body\n    }\n\n    #[test]\n    fn enter_probe_rtt_sets_state_and_unity_gains() {\n        let mut s = make_state();\n        s.enter_probe_rtt();\n        assert_eq!(s.state, Bbr1AlgState::ProbeRtt);\n        assert!((s.pacing_gain - 1.0).abs() < f64::EPSILON);\n        assert!((s.cwnd_gain - 1.0).abs() < f64::EPSILON);\n    }\n\n    #[test]\n    fn after_one_roundtrip_clears_packet_conservation() {\n        let mut s = make_state();\n        s.packet_conservation = true;\n        s.after_one_roundtrip_in_fast_recovery();\n        assert!(!s.packet_conservation);\n    }\n\n    // --- BBR1GetBtlBW ---\n\n    #[test]\n    fn get_btl_bw_uses_lt_bw_when_flag_set() {\n        let mut s = make_state();\n        s.btl_bw = 1_000_000;\n        s.lt_bw = 500_000;\n        s.lt_use_bw = true;\n        assert_eq!(s.get_btl_bw(), 500_000);\n    }\n\n    #[test]\n    fn get_btl_bw_uses_btl_bw_when_flag_clear() {\n        let mut s = make_state();\n        s.btl_bw = 1_000_000;\n        s.lt_bw = 500_000;\n        s.lt_use_bw = false;\n        assert_eq!(s.get_btl_bw(), 1_000_000);\n    }\n}\n","numLines":367,"startLine":1,"totalLines":367}}}
