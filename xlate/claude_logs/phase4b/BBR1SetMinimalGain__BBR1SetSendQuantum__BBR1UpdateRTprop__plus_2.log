{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01NZQBHLvgmGwcNVnEkfZzhV","type":"tool_result","content":"330\t    bbr1_state->pacing_gain = BBR1_HIGH_GAIN;\n331\t    bbr1_state->cwnd_gain = BBR1_HIGH_GAIN;\n332\t}\n333\t\n334\tvoid BBR1SetSendQuantum(picoquic_bbr1_state_t* bbr1_state, picoquic_path_t* path_x)\n335\t{\n336\t    if (bbr1_state->pacing_rate < BBR1_PACING_RATE_LOW) {\n337\t        bbr1_state->send_quantum = 1ull * path_x->send_mtu;\n338\t    } \n339\t    else if (bbr1_state->pacing_rate < BBR1_PACING_RATE_MEDIUM) {\n340\t        bbr1_state->send_quantum = 2ull * path_x->send_mtu;\n341\t    }\n342\t    else {\n343\t        bbr1_state->send_quantum = (uint64_t)(bbr1_state->pacing_rate * bbr1_state->quantum_ratio);\n344\t        if (bbr1_state->send_quantum > 0x10000) {\n345\t            bbr1_state->send_quantum = 0x10000;\n346\t        }\n347\t    }\n348\t}\n349\t\n350\tuint64_t BBR1Inflight(picoquic_bbr1_state_t* bbr1_state, double gain)\n351\t{\n352\t    uint64_t cwnd = PICOQUIC_CWIN_INITIAL;\n353\t    if (bbr1_state->rt_prop != UINT64_MAX){\n354\t        /* Bandwidth is estimated in bytes per second, rtt in microseconds*/\n355\t        uint64_t rt_target = bbr1_state->rt_prop;\n356\t        if (bbr1_state->rt_prop < bbr1_state->wifi_shadow_rtt) {\n357\t            rt_target = bbr1_state->wifi_shadow_rtt;\n358\t        }\n359\t        double estimated_bdp = (((double)BBR1GetBtlBW(bbr1_state) * (double)rt_target) / 1000000.0);"}]},"parent_tool_use_id":null,"session_id":"a7e13982-2be8-47de-a038-35b3593cd08a","uuid":"59881f77-0d01-4706-85e6-3edce41f3ddf","timestamp":"2026-05-07T05:15:49.639Z","tool_use_result":{"type":"text","file":{"filePath":"/Users/richbarn/Projects/picoquic/picoquic/bbr1.c","content":"    bbr1_state->pacing_gain = BBR1_HIGH_GAIN;\n    bbr1_state->cwnd_gain = BBR1_HIGH_GAIN;\n}\n\nvoid BBR1SetSendQuantum(picoquic_bbr1_state_t* bbr1_state, picoquic_path_t* path_x)\n{\n    if (bbr1_state->pacing_rate < BBR1_PACING_RATE_LOW) {\n        bbr1_state->send_quantum = 1ull * path_x->send_mtu;\n    } \n    else if (bbr1_state->pacing_rate < BBR1_PACING_RATE_MEDIUM) {\n        bbr1_state->send_quantum = 2ull * path_x->send_mtu;\n    }\n    else {\n        bbr1_state->send_quantum = (uint64_t)(bbr1_state->pacing_rate * bbr1_state->quantum_ratio);\n        if (bbr1_state->send_quantum > 0x10000) {\n            bbr1_state->send_quantum = 0x10000;\n        }\n    }\n}\n\nuint64_t BBR1Inflight(picoquic_bbr1_state_t* bbr1_state, double gain)\n{\n    uint64_t cwnd = PICOQUIC_CWIN_INITIAL;\n    if (bbr1_state->rt_prop != UINT64_MAX){\n        /* Bandwidth is estimated in bytes per second, rtt in microseconds*/\n        uint64_t rt_target = bbr1_state->rt_prop;\n        if (bbr1_state->rt_prop < bbr1_state->wifi_shadow_rtt) {\n            rt_target = bbr1_state->wifi_shadow_rtt;\n        }\n        double estimated_bdp = (((double)BBR1GetBtlBW(bbr1_state) * (double)rt_target) / 1000000.0);","numLines":30,"startLine":330,"totalLines":1341}}}
