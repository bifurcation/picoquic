{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01E7xuYcLaZeZob5mH5JUhNg","type":"tool_result","content":"675\t        }\n676\t    }\n677\t}\n678\t\n679\t/* This will use one way samples if available */\n680\t/* Should augment that with common RTT filter to suppress jitter */\n681\tvoid BBR1UpdateRTprop(picoquic_bbr1_state_t* bbr1_state, uint64_t rtt_sample, uint64_t current_time)\n682\t{\n683\t    bbr1_state->rt_prop_expired =\n684\t        current_time > bbr1_state->rt_prop_stamp + BBR1_PROBE_RTT_INTERVAL &&\n685\t        current_time > bbr1_state->rt_prop_stamp + 20 * bbr1_state->rt_prop;\n686\t    if (rtt_sample <= bbr1_state->rt_prop || bbr1_state->rt_prop_expired) {\n687\t        bbr1_state->rt_prop = rtt_sample;\n688\t        bbr1_state->rt_prop_stamp = current_time;\n689\t    }\n690\t    else {\n691\t        uint64_t delta = rtt_sample - bbr1_state->rt_prop;\n692\t        if (20 * delta < bbr1_state->rt_prop) {\n693\t            bbr1_state->rt_prop_stamp = current_time;\n694\t        }\n695\t    }\n696\t}\n697\t\n698\tint BBR1IsNextCyclePhase(picoquic_bbr1_state_t* bbr1_state, uint64_t prior_in_flight, uint64_t packets_lost, uint64_t current_time)\n699\t{\n700\t    int is_full_length = bbr1_state->cycle_on_loss || (current_time - bbr1_state->cycle_stamp) > bbr1_state->rt_prop;\n701\t    \n702\t    if (bbr1_state->pacing_gain != 1.0) {\n703\t        if (bbr1_state->pacing_gain > 1.0) {\n704\t            is_full_length &=\n705\t                (packets_lost > 0 ||\n706\t                    prior_in_flight >= BBR1Inflight(bbr1_state, bbr1_state->pacing_gain));\n707\t        }\n708\t        else {  /*  (BBR1.pacing_gain < 1) */\n709\t            is_full_length &= prior_in_flight <= BBR1Inflight(bbr1_state, 1.0);\n710\t        }\n711\t    }\n712\t    return is_full_length;\n713\t}\n714\t\n715\tvoid BBR1SetMinimalGain(picoquic_bbr1_state_t* bbr1_state)\n716\t{\n717\t    if (bbr1_state->pacing_gain > 1.0 && bbr1_state->rt_prop > 0) {\n718\t        uint64_t target_cwin = PICOQUIC_BYTES_FROM_RATE(bbr1_state->rt_prop, bbr1_state->btl_bw);\n719\t\n720\t        if (target_cwin < 4 * PICOQUIC_MAX_PACKET_SIZE) {\n721\t            double d_target = (double)target_cwin;\n722\t            double d_gain = ((double)(4 * PICOQUIC_MAX_PACKET_SIZE)) / d_target;\n723\t\n724\t            if (d_gain > bbr1_state->pacing_gain) {\n725\t                bbr1_state->pacing_gain = d_gain;\n726\t            }\n727\t        }\n728\t    }\n729\t}"}]},"parent_tool_use_id":null,"session_id":"a7e13982-2be8-47de-a038-35b3593cd08a","uuid":"eb0d0179-ee02-4d34-ac1a-0fb277ce1855","timestamp":"2026-05-07T05:15:57.615Z","tool_use_result":{"type":"text","file":{"filePath":"/Users/richbarn/Projects/picoquic/picoquic/bbr1.c","content":"        }\n    }\n}\n\n/* This will use one way samples if available */\n/* Should augment that with common RTT filter to suppress jitter */\nvoid BBR1UpdateRTprop(picoquic_bbr1_state_t* bbr1_state, uint64_t rtt_sample, uint64_t current_time)\n{\n    bbr1_state->rt_prop_expired =\n        current_time > bbr1_state->rt_prop_stamp + BBR1_PROBE_RTT_INTERVAL &&\n        current_time > bbr1_state->rt_prop_stamp + 20 * bbr1_state->rt_prop;\n    if (rtt_sample <= bbr1_state->rt_prop || bbr1_state->rt_prop_expired) {\n        bbr1_state->rt_prop = rtt_sample;\n        bbr1_state->rt_prop_stamp = current_time;\n    }\n    else {\n        uint64_t delta = rtt_sample - bbr1_state->rt_prop;\n        if (20 * delta < bbr1_state->rt_prop) {\n            bbr1_state->rt_prop_stamp = current_time;\n        }\n    }\n}\n\nint BBR1IsNextCyclePhase(picoquic_bbr1_state_t* bbr1_state, uint64_t prior_in_flight, uint64_t packets_lost, uint64_t current_time)\n{\n    int is_full_length = bbr1_state->cycle_on_loss || (current_time - bbr1_state->cycle_stamp) > bbr1_state->rt_prop;\n    \n    if (bbr1_state->pacing_gain != 1.0) {\n        if (bbr1_state->pacing_gain > 1.0) {\n            is_full_length &=\n                (packets_lost > 0 ||\n                    prior_in_flight >= BBR1Inflight(bbr1_state, bbr1_state->pacing_gain));\n        }\n        else {  /*  (BBR1.pacing_gain < 1) */\n            is_full_length &= prior_in_flight <= BBR1Inflight(bbr1_state, 1.0);\n        }\n    }\n    return is_full_length;\n}\n\nvoid BBR1SetMinimalGain(picoquic_bbr1_state_t* bbr1_state)\n{\n    if (bbr1_state->pacing_gain > 1.0 && bbr1_state->rt_prop > 0) {\n        uint64_t target_cwin = PICOQUIC_BYTES_FROM_RATE(bbr1_state->rt_prop, bbr1_state->btl_bw);\n\n        if (target_cwin < 4 * PICOQUIC_MAX_PACKET_SIZE) {\n            double d_target = (double)target_cwin;\n            double d_gain = ((double)(4 * PICOQUIC_MAX_PACKET_SIZE)) / d_target;\n\n            if (d_gain > bbr1_state->pacing_gain) {\n                bbr1_state->pacing_gain = d_gain;\n            }\n        }\n    }\n}","numLines":55,"startLine":675,"totalLines":1341}}}
