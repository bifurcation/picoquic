{"type":"item.completed","item":{"id":"item_26","type":"command_execution","command":"/bin/zsh -lc \"sed -n '1,260p' rs/fq/Cargo.toml\"","aggregated_output":"[package]\nname = \"fq\"\nversion = \"0.1.0\"\nedition = \"2024\"\n\n[features]\ndefault = []\n# Each backend lives behind its own feature so a binary only pays\n# for the implementations it actually links.  See `src/sys/`.\nsys-picotls = []\nsys-openssl = [\"dep:openssl\"]\nsys-mbedtls = []\nsys-fusion = []\n\n[dependencies]\nfugit = { version = \"0.3\", default-features = false }\nrand = { version = \"0.9\", default-features = false }\nrand_core = { version = \"0.9\", default-features = false }\n\n# Rust Crypto trait crates (no implementations -- those come from\n# the active TLS backend's crypto layer, except for header\n# protection which we implement ourselves).\naead = { version = \"0.5\", default-features = false }\ncipher = { version = \"0.4\", default-features = false }\ndigest = { version = \"0.10\", default-features = false }\n\n# Concrete cipher implementations used by header protection\n# (QUIC packet-number encryption is QUIC logic, not TLS).\naes = { version = \"0.8\", default-features = false }\nchacha20 = { version = \"0.9\", default-features = false }\n\n# Hash, HKDF, and AEAD implementations used by the QUIC initial-secret\n# derivation, retry-protection AEAD, and test-only crypto helpers in\n# `tls_api`.  These are pure-Rust algorithms not specific to any TLS\n# backend.\nsha2 = { version = \"0.10\", default-features = false }\nhkdf = { version = \"0.12\", default-features = false }\nhmac = { version = \"0.12\", default-features = false }\naes-gcm = { version = \"0.10\", default-features = false, features = [\"aes\", \"alloc\"] }\n\n# UDP socket abstraction.  std-only.\nsocket2 = { version = \"0.5\", default-features = false, features = [\"all\"] }\n\n# Optional backend implementations (gated by `sys-*` features).\nopenssl = { version = \"0.10\", optional = true }\n","exit_code":0,"status":"completed"}}
