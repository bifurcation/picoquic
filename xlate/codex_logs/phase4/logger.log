on path `path_idx` at\nrs/fq/src/internal.rs:4200:    /// Uses a path index to avoid aliasing `&self` with `&mut path`.\nrs/fq/src/internal.rs:4207:        if let Some(path) = self.paths.get_mut(path_idx) {\nrs/fq/src/internal.rs:4208:            path.pacing\nrs/fq/src/internal.rs:4776:        // Delegate to create_packet_header_at using tuple's path context.\nrs/fq/src/internal.rs:4777:        // Find tuple's path index by matching tuple's unique_path_id.\nrs/fq/src/internal.rs:4779:            .paths\nrs/fq/src/internal.rs:5235:    /// In picoquic, \"next\" means the range with the next lower PN (predecessor in our key-order).\nrs/fq/src/internal.rs:5245:    /// In picoquic, \"previous\" means the range with the next higher PN (successor in our key-order).\nrs/fq/src/internal.rs:5262:        // When multipath is enabled and this is application context, use the\nrs/fq/src/internal.rs:5263:        // per-path ACK context (looking up by the CID's path_id).\nrs/fq/src/internal.rs:5269:            let path_idx = self.paths.iter().position(|p| p.unique_path_id == path_id);\nrs/fq/src/internal.rs:5271:                return Some(&mut self.paths[idx].ack_ctx);\nrs/fq/src/internal.rs:5434:        // In C, send_sequence is randomized if quic->random_initial is set.\nrs/fq/src/internal.rs:5490:        _old_path: &mut Path,\nrs/fq/src/internal.rs:5549:            affinity_path: None,\nrs/fq/src/internal.rs:5814:    /// C: `picoquic_find_ready_stream_path`.\nrs/fq/src/internal.rs:5815:    pub fn find_ready_stream_path(\nrs/fq/src/internal.rs:5824:    /// As [`Self::find_ready_stream_path`] but path-agnostic.\nrs/fq/src/internal.rs:5864:// the `Connection::stream_tree.get(token)` path is one indirection\nrs/fq/src/internal.rs:6044:    /// Variant of [`Self::set_ack_needed`] that looks up `self.paths[path_index]`\nrs/fq/src/internal.rs:6046:    /// passes `&mut self.paths[n]` alongside `&mut self`.  C:\nrs/fq/src/internal.rs:6047:    /// `picoquic_set_ack_needed` called with `cn