 let ticket = [0xcc_u8; 48];\n                ctx.qclient\n                    .store_ticket(\n                        Some(sni),\n                        Some(alpn),\n                        version,\n                        ip_zero,\n                        ip_zero,\n                        &ticket,\n                        &tp,\n                    )\n                    .expect(\"store_ticket\");\n            }\n        }\n    }\n\n    ctx.qclient\n        .save_tickets(t, TICKET_FILE)\n        .expect(\"save_tickets\");\n\n","exit_code":0,"status":"completed"}}
