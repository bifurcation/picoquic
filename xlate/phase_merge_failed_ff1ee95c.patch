+        if !test_ctx.has_cnx_server() {
+            return Err(crate::Error::Generic);
+        }
+        false_migration_protect_packet(
+            test_ctx.cnx_server(),
+            packet_type,
+            false_pc,
+            epoch,
+            simulated_time,
+            &mut send_buffer,
