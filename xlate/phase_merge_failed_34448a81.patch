+fn submit_simulated_send_buffer(
+    link: &mut TestSimLink,
+    addr_from: SocketAddr,
+    addr_to: SocketAddr,
+    ecn_mark: u8,
+    send_buffer: &[u8],
+    segment_size: usize,
+    simulated_time: Instant,
